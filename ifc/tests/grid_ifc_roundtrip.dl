# SPDX-License-Identifier: MPL-2.0
# Grid names remain AxisTags through IFC/IFCX. Real IFC grids return as
# editable native lines, including placements, units, axis sense and undo.
import ifc/bim_ifc_native.dl
import ifc/bim_ifc.dl
import pattern/grids/bim_grid_names.dl
import exchange/ifcx/bim_file.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl

function check grid exchange {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set modelValue to an empty bim model
set target to the address of modelValue
ignore add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set firstId to add bim grid named (the string form of "7") from (a cad vector2 with x 4.0 and y 0.0) to (a cad vector2 with x 4.0 and y 8.0) reaching 0.0 to 3.0 to target
ignore add bim grid named (the string form of "A'1") from (a cad vector2 with x 0.0 and y 2.0) to (a cad vector2 with x 8.0 and y 2.0) reaching 0.0 to 3.0 to target
check grid exchange ((renumber bim grids parallel to firstId from (the string form of "27") in target) = 1) named (the string form of "the direction is renamed before export")
set stepFile to the bim step file of (the bim ifc text of modelValue)
set natives to the bim ifc natives of stepFile
check grid exchange ((the length of (natives's grids's values)) = 2) named (the string form of "IFC exports and reads both grid directions")
set documentValue to a new bim document
set made to the bim ifc natives natives made in (the address of documentValue)
check grid exchange ((made's grids = 2) and ((the length of (documentValue's undoStack's values)) = 1)) named (the string form of "a grid-only IFC import is one native undo step")
set firstGrid to the item at 0 in (documentValue's current's grids's values)
set secondGrid to the item at 1 in (documentValue's current's grids's values)
check grid exchange ((firstGrid's name = (the string form of "A'1")) and (secondGrid's name = (the string form of "27"))) named (the string form of "AxisTag preserves renamed numbers and escaped labels")
check grid exchange (((the cad distance from firstGrid's start to (a cad vector2 with x 0.0 and y 2.0)) < 0.000001) and ((the cad distance from secondGrid's finish to (a cad vector2 with x 4.0 and y 8.0)) < 0.000001)) named (the string form of "IFC retains the native grid coordinates")
set again to add bim ifc natives natives to (the address of (documentValue's current))
check grid exchange ((again's grids = 0) and ((the length of (documentValue's current's grids's values)) = 2)) named (the string form of "reimporting the same IFC does not duplicate axes")
ignore undo bim transaction in (the address of documentValue)
check grid exchange ((the length of (documentValue's current's grids's values)) = 0) named (the string form of "undo removes the imported axes")
ignore redo bim transaction in (the address of documentValue)
check grid exchange ((the length of (documentValue's current's grids's values)) = 2) named (the string form of "redo restores the imported axes")

set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "grids.ifcx") for project (the string form of "Grid test") by (the string form of "test") at (the string form of "2026-10-31T00:00:00Z"))
set reread to the bim model parsed from native's text
check grid exchange (native's valid and (reread's valid and ((the bim file text of reread's modelValue) = (the bim file text of modelValue)))) named (the string form of "IFCX preserves the complete renamed native grids")

set lines to an empty list of a string
append (the string form of "ISO-10303-21; HEADER; FILE_SCHEMA(('IFC4')); ENDSEC; DATA;") to lines
append (the string form of "#1=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.); #2=IFCUNITASSIGNMENT((#1));") to lines
append (the string form of "#3=IFCCARTESIANPOINT((1000.,2000.,3000.)); #4=IFCDIRECTION((0.,1.,0.)); #5=IFCAXIS2PLACEMENT3D(#3,$,#4); #6=IFCLOCALPLACEMENT($,#5);") to lines
append (the string form of "#7=IFCCARTESIANPOINT((0.,0.)); #8=IFCCARTESIANPOINT((5000.,0.)); #9=IFCCARTESIANPOINT((0.,6000.));") to lines
append (the string form of "#10=IFCPOLYLINE((#7,#8)); #11=IFCPOLYLINE((#7,#9)); #12=IFCPOLYLINE((#7,#8,#9));") to lines
append (the string form of "#20=IFCGRIDAXIS('Reverse',#10,.F.); #21=IFCGRIDAXIS('Across',#11,.T.); #22=IFCGRIDAXIS('Bent',#12,.T.);") to lines
append (the string form of "#30=IFCGRID('0aaaaaaaaaaaaaaaaaaaaa',$,'Grid',$,$,#6,$,(#20),(#21,#22),$,.RECTANGULAR.);") to lines
append (the string form of "#40=IFCAXIS2PLACEMENT3D(#3,#4,$); #41=IFCLOCALPLACEMENT($,#40); #42=IFCGRIDAXIS('Tilted',#11,.T.); #44=IFCGRIDAXIS('Horizontal',#10,.T.);") to lines
append (the string form of "#43=IFCGRID('0bbbbbbbbbbbbbbbbbbbbb',$,'Tilted grid',$,$,#41,$,(#44),(#42),$,.RECTANGULAR.);") to lines
append (the string form of "ENDSEC; END-ISO-10303-21;") to lines
set fixture to the bim step file of (lines joined with "\n")
set fixtureNatives to the bim ifc natives of fixture
# The second grid's horizontal U axis is valid; its tilted V axis is not.
check grid exchange ((the length of (fixtureNatives's grids's values)) = 3) named (the string form of "bent and tilted axes are not flattened")
set reversed to the item at 0 in (fixtureNatives's grids's values)
check grid exchange (((the cad distance from reversed's start to (a cad vector2 with x 1.0 and y 7.0)) < 0.000001) and ((the cad distance from reversed's finish to (a cad vector2 with x 1.0 and y 2.0)) < 0.000001)) named (the string form of "millimetres rotated placement and SameSense are applied")
check grid exchange ((the absolute value of (reversed's elevation - 3.0)) < 0.000001) named (the string form of "the grid placement height is retained")
set across to the item at 1 in (fixtureNatives's grids's values)
check grid exchange ((the cad distance from across's finish to (a cad vector2 with x -5.0 and y 2.0)) < 0.000001) named (the string form of "the second axis uses the same placed frame")
