set stepFile to the bim step file of (ifcLines joined with "\n")
set nativeSet to the bim ifc natives of stepFile
set modelValue to an empty bim model
ignore add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to (the address of modelValue)
set counts to add bim ifc natives nativeSet to (the address of modelValue)
print (the bim ifc native text of counts) as a line
loop cursor from 0 to the length of (modelValue's components's values):
    set definition to the item at cursor in (modelValue's components's values)
    set shownShape to the bim shown mesh of component definition within 0.002
    print (((((the string form of "component ") + definition's name) + ((the string form of " role ") + (the string form of definition's role))) + (((the string form of " parts ") + (the string form of (the length of (definition's solids's values)))) + ((the string form of " points ") + (the string form of (the length of ((the item at 0 in (definition's solids's values))'s points's values)))))) + ((((the string form of " triangles ") + (the string form of ((the length of (shownShape's triangles's values)) / 3))) + ((the string form of " alone ") + (the string form of (bim component definition is its meshes alone)))) + ((the string form of " volume ") + (the bim metres text of ((the bim volume of component definition) * 1000.0))))) as a line
    loop connectorCursor from 0 to the length of (definition's connectors's values):
        set localConnector to the item at connectorCursor in (definition's connectors's values)
        print ((((the string form of "  connector at ") + ((the bim metres text of localConnector's spot's x) + ((the string form of ",") + ((the bim metres text of localConnector's spot's y) + ((the string form of ",") + (the bim metres text of localConnector's spot's z)))))) + ((the string form of " role ") + (the string form of localConnector's role))) + ((the string form of " size ") + (the bim metres text of localConnector's size))) as a line
loop cursor from 0 to the length of (modelValue's instances's values):
    set placement to the item at cursor in (modelValue's instances's values)
    set placedDefinition to the item at (the bim component index of placement's componentId in modelValue)'s position in (modelValue's components's values)
    print ((((the string form of "instance of ") + placedDefinition's name) + ((the string form of " at ") + ((the bim metres text of placement's origin's x) + ((the string form of ",") + (the bim metres text of placement's origin's y))))) + (((the string form of " rise ") + (the bim metres text of (the bim rise of instance placement's id in modelValue))) + ((the string form of " turned ") + (the bim metres text of (placement's angle * 57.29577951308232))))) as a line
set servicesNetwork to the bim network of modelValue
loop cursor from 0 to the length of (servicesNetwork's nodes's values):
    set networkNode to the item at cursor in (servicesNetwork's nodes's values)
    print ((((the string form of "node at ") + ((the bim metres text of networkNode's spot's x) + ((the string form of ",") + ((the bim metres text of networkNode's spot's y) + ((the string form of ",") + (the bim metres text of networkNode's spot's z))))))) + ((the string form of " connectors ") + (the string form of (the length of (networkNode's connectors's values))))) as a line
print ((the string form of "taken over: ") + (the string form of (the bim promoted count of modelValue))) as a line
set rest to the bim ifc elements of stepFile skipping (nativeSet's skipped's values)
print ((the string form of "imported besides: ") + (the string form of (the length of (rest's labels's values)))) as a line
