set stepFile to the bim step file of (ifcLines joined with "\n")
set nativeSet to the bim ifc natives of stepFile
print (((the string form of "native segments ") + (the string form of (the length of (nativeSet's linears's values)))) + ((the string form of ", fittings taken over ") + (the string form of (the length of (nativeSet's fittingSources's values))))) as a line
set modelValue to an empty bim model
ignore add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to (the address of modelValue)
set counts to add bim ifc natives nativeSet to (the address of modelValue)
print (the bim ifc native text of counts) as a line
loop cursor from 0 to the length of (modelValue's linears's values):
    set pipeValue to the item at cursor in (modelValue's linears's values)
    set pipeType to the bim type of linear pipeValue in modelValue
    print (((the string form of "segment ") + pipeType's name) + (((the string form of " from ") + ((the bim metres text of pipeValue's start's x) + ((the string form of ",") + (the bim metres text of pipeValue's start's y)))) + ((the string form of " to ") + ((the bim metres text of pipeValue's finish's x) + ((the string form of ",") + (the bim metres text of pipeValue's finish's y)))))) as a line
set servicesNetwork to the bim network of modelValue
set derivedFittings to the bim fittings of servicesNetwork in modelValue
loop cursor from 0 to the length of (derivedFittings's values):
    set derivedFitting to the item at cursor in (derivedFittings's values)
    set fittingNode to the item at derivedFitting's nodeIndex in (servicesNetwork's nodes's values)
    print (((the string form of "derived ") + (the bim name of fitting derivedFitting's kind)) + ((the string form of " at ") + ((the bim metres text of fittingNode's spot's x) + ((the string form of ",") + (the bim metres text of fittingNode's spot's y))))) as a line
print ((the string form of "taken over: ") + (the string form of (the bim promoted count of modelValue))) as a line
set rest to the bim ifc elements of stepFile skipping (nativeSet's skipped's values)
print ((the string form of "imported besides: ") + (the string form of (the length of (rest's labels's values)))) as a line
