# SPDX-License-Identifier: MPL-2.0
# A profiled join in the IFC export: the walls of a lapped corner go out
# as extrusions of their stepped outlines, so that the lap is in the file;
# a straight join keeps four corners a wall.
import ifc/bim_ifc.dl
import exchange/ifcx/bim_file.dl
import elements/planar/bim_evaluate.dl

function the profile export points of {a string:ifcText}:
    execute:
        set pointCount to 0
        set fileLines to ifcText split at "\n"
        loop cursor from 0 to the length of fileLines:
            set fileLine to the item at cursor in fileLines
            if fileLine contains "IFCPOLYLINE(":
                set references to fileLine split at "#"
                set pointCount to pointCount + ((the length of references) - 2)
        free fileLines
        return pointCount

set cornerModel to an empty bim model
set cornerTarget to the address of cornerModel
set groundLevel to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to cornerTarget
set timberLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.2)) to timberLayers
set timberType to add bim wall type named (the string form of "CLT 200") with timberLayers to cornerTarget
set firstLeg to add bim wall typed timberType on groundLevel from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 5.0 and y 0.0) to cornerTarget
set secondLeg to add bim wall typed timberType on groundLevel from (a cad vector2 with x 5.0 and y 0.0) to (a cad vector2 with x 5.0 and y 4.0) to cornerTarget
set straightPoints to the profile export points of (the bim ifc text of cornerModel)
print ((the string form of "mitred corner, polyline points: ") + (the string form of straightPoints)) as a line
set cornerJoin to the bim join of wall firstLeg at finish true in cornerModel using (the bim join index of cornerModel)
give bim join cornerJoin profile (bim half lap join profile) in cornerTarget
set steppedPoints to the profile export points of (the bim ifc text of cornerModel)
print ((the string form of "half lap, polyline points: ") + (the string form of steppedPoints)) as a line
if steppedPoints = (straightPoints + 4):
    print "PASS: each lapped wall carries its two steps" as a line
else:
    print "FAIL: the lap is not in the export" as a line
