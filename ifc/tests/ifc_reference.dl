# SPDX-License-Identifier: MPL-2.0
# Not a test (it has no expected output): reads the IFC files named on its
# command line (reference models are kept outside the repository) and prints
# what was read, with the time; writes build/<file>.elements.txt (each
# element's label, triangles, box and area, for verify_ifc_read.py) and, up to
# a million triangles, build/<file>.obj with each element's colour.
import formats/bim_ifc_read.dl

function report ifc reference {a string:filePath}:
    execute:
        set started to @intrinsic("call", "libc", "clock", a 64 bit integer)
        set imported to the bim ifc import of filePath
        set spent to ((@intrinsic("call", "libc", "clock", a 64 bit integer)) - started) / (1000 as a 64 bit integer)
        print ((the string form of "== ") + filePath) as a line
        if imported's valid = false:
            print ((the string form of "  refused: ") + imported's message) as a line
            return nothing
        print ((((the string form of "  ") + (the string form of (the length of (imported's meshes's values)))) + (the string form of " elements, ")) + (((the string form of imported's triangleCount) + (the string form of " triangles, ")) + ((the string form of spent) + (the string form of " ms cpu")))) as a line
        print ((((the string form of "  box ") + (the string form of imported's low's x)) + (the string form of " ")) + (((the string form of imported's low's y) + (the string form of " ")) + (the string form of imported's low's z))) as a line
        print ((((the string form of "   .. ") + (the string form of imported's high's x)) + (the string form of " ")) + (((the string form of imported's high's y) + (the string form of " ")) + (the string form of imported's high's z))) as a line
        print ((the string form of "  ") + imported's message) as a line
        # Each element's label, triangles and box, for verify_ifc_read.py.
        set rows to an empty list of a string
        loop cursor from 0 to the length of (imported's meshes's values):
            set shape to (the item at cursor in (imported's meshes's values))'s shape
            set low to a cad vector3 with x 1.0e30, y 1.0e30 and z 1.0e30
            set high to a cad vector3 with x -1.0e30, y -1.0e30 and z -1.0e30
            loop corner from 0 to the length of (shape's positions's values):
                set point to the item at corner in (shape's positions's values)
                set low to a cad vector3 with x (the minimum of low's x and point's x), y (the minimum of low's y and point's y) and z (the minimum of low's z and point's z)
                set high to a cad vector3 with x (the maximum of high's x and point's x), y (the maximum of high's y and point's y) and z (the maximum of high's z and point's z)
            set row to ((the item at cursor in (imported's labels's values)) + (the string form of "|")) + (the string form of ((the length of (shape's triangles's values)) / 3))
            set row to (row + (the string form of "|")) + ((((the string form of low's x) + (the string form of "|")) + ((the string form of low's y) + (the string form of "|"))) + (the string form of low's z))
            set row to (row + (the string form of "|")) + ((((the string form of high's x) + (the string form of "|")) + ((the string form of high's y) + (the string form of "|"))) + (the string form of high's z))
            # Its surface area, which a lost or doubled triangle changes.
            set area to 0.0
            set triangleCorners to shape's triangles's values
            set face to 0
            loop while (face + 2) < (the length of triangleCorners):
                set a to the item at (the item at face in triangleCorners) in (shape's positions's values)
                set b to the item at (the item at (face + 1) in triangleCorners) in (shape's positions's values)
                set c to the item at (the item at (face + 2) in triangleCorners) in (shape's positions's values)
                set area to area + ((the cad length of (the cad cross of (the cad difference of b and a) and (the cad difference of c and a))) * 0.5)
                set face to face + 3
            set row to (row + (the string form of "|")) + (the string form of area)
            append row to rows
        set slash to the length of filePath
        loop while (slash > 0) and ((the character at (slash - 1) in filePath) != 47):
            set slash to slash - 1
        set csvPath to ((the string form of "build/") + (the substring of filePath from slash spanning ((the length of filePath) - slash) bytes)) + (the string form of ".elements.txt")
        ignore write bim text (rows joined with "\n") to file csvPath
        free rows
        # The triangles as an OBJ file with each element's colour (models of
        # up to a million triangles), for a picture.
        if imported's triangleCount <= 1000000:
            set objectRows to an empty list of a string
            set vertexCount to 0
            loop cursor from 0 to the length of (imported's meshes's values):
                set entry to the item at cursor in (imported's meshes's values)
                set shape to entry's shape
                set colour to entry's colour
                if colour's x < 0.0:
                    set colour to the bim colour of category entry's category
                set colourText to (((the string form of (colour's x / 255.0)) + (the string form of " ")) + ((the string form of (colour's y / 255.0)) + (the string form of " "))) + (the string form of (colour's z / 255.0))
                loop corner from 0 to the length of (shape's positions's values):
                    set point to the item at corner in (shape's positions's values)
                    append ((((the string form of "v ") + (the string form of point's x)) + (the string form of " ")) + ((((the string form of point's y) + (the string form of " ")) + (the string form of point's z)) + ((the string form of " ") + colourText))) to objectRows
                set triangleCorners to shape's triangles's values
                set face to 0
                loop while (face + 2) < (the length of triangleCorners):
                    append ((((the string form of "f ") + (the string form of ((vertexCount + (the item at face in triangleCorners)) + 1))) + (the string form of " ")) + (((the string form of ((vertexCount + (the item at (face + 1) in triangleCorners)) + 1)) + (the string form of " ")) + (the string form of ((vertexCount + (the item at (face + 2) in triangleCorners)) + 1)))) to objectRows
                    set face to face + 3
                set vertexCount to vertexCount + (the length of (shape's positions's values))
            ignore write bim text (objectRows joined with "\n") to file ((the substring of csvPath from 0 spanning ((the length of csvPath) - 13) bytes) + (the string form of ".obj"))
            free objectRows

# The files named on the command line.
set arguments to the command line arguments
set argumentTotal to arguments' length
if argumentTotal = 0:
    print (the string form of "usage: ifc_reference FILE.ifc...") as a line
loop argumentCursor from 0 to argumentTotal:
    report ifc reference (the argument at argumentCursor in arguments)
