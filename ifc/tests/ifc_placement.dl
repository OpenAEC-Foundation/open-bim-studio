# SPDX-License-Identifier: MPL-2.0
# IFC STEP placement and types (docs/notes/drawing-quality-plan.md, item 5):
# a two-storey model exported and read back through its own placements.
# Each opening and its window stand at the sill above their storey, whatever
# the wall's body: a plain wall on the ground floor, a plain wall on the
# upper floor raised 0.2 above it, and a gable on the upper floor (its drawn
# contour makes it a triangulated body placed in the world's heights). A
# wall's PredefinedType is its type's kept one, as its IfcWallType's is, and
# an untyped slab's exchange type carries the slab's material.
import ifc/bim_ifc.dl
import ifc/bim_ifc_read.dl

function check ifc placement {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the ifc placement millimetres of {a 64 bit floating-point number:metres}:
    execute:
        return @intrinsic("call", "libc", "round", a 64 bit floating-point number, metres * 1000.0) as an integer

# The world height, in millimetres, of the ObjectPlacement (argument 5) of
# product `productId`, its placement chain followed as an IFC reader does.
function the ifc placement height of product {integer:productId} in {a pointer to a bim ifc reader record:reader}:
    execute:
        set productValue to the bim step instance productId in (reader's stepFile)
        set placementId to the bim step reference of (the bim step argument 5 of productValue) in productValue
        free bim step instance productValue
        set placedAxes to the bim ifc object axes placementId in reader
        return the ifc placement millimetres of (placedAxes's origin's z)

# The Name (argument 2) of instance `entityId`.
function the ifc placement name of {integer:entityId} in {bim step file record:stepFile}:
    execute:
        set entityValue to the bim step instance entityId in stepFile
        set nameText to the bim step string of (the bim step argument 2 of entityValue) in entityValue
        free bim step instance entityValue
        return nameText

# The RepresentationType of the first representation of product
# `productId` (SweptSolid for an extrusion, Tessellation for triangles).
function the ifc placement body kind of {integer:productId} in {bim step file record:stepFile}:
    execute:
        set productValue to the bim step instance productId in stepFile
        set shapeId to the bim step reference of (the bim step argument 6 of productValue) in productValue
        free bim step instance productValue
        set shapeValue to the bim step instance shapeId in stepFile
        set representationId to the bim step reference of (the bim step member 0 of (the bim step argument 2 of shapeValue) in shapeValue) in shapeValue
        free bim step instance shapeValue
        set representationValue to the bim step instance representationId in stepFile
        set bodyKind to the bim step string of (the bim step argument 2 of representationValue) in representationValue
        free bim step instance representationValue
        return bodyKind

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set upper to add bim level named (the string form of "Upper") at 3.0 with height 3.0 to target
set brickLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to brickLayers
set brickType to add bim wall type named (the string form of "Brick wall") with brickLayers to target
free brickLayers
set partitionLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.1)) to partitionLayers
set partitionType to add bim wall type named (the string form of "Partition") with partitionLayers to target
free partitionLayers
set bim property (the string form of "PredefinedType") of set (the string form of "IFC attributes") of partitionType to (the string form of "PARTITIONING") typed (the string form of "IFCLABEL") in target
set floorLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "reinforced concrete", 0.25)) to floorLayers
set floorType to add bim planar type named (the string form of "Floor") as role (bim floor planar role) with floorLayers to target
free floorLayers

set groundWall to add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set upperWall to add bim wall typed brickType on upper from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
check ifc placement (set bim wall upperWall base to 0.2 and height to 2.8 in target) named (the string form of "the upper wall stands 0.2 above its storey")
set gableWall to add bim wall typed brickType on upper from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 6.0 and y 6.0) to target
set gableContour to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to gableContour
append (a cad vector2 with x 6.0 and y 0.0) to gableContour
append (a cad vector2 with x 6.0 and y 2.0) to gableContour
append (a cad vector2 with x 3.0 and y 3.0) to gableContour
append (a cad vector2 with x 0.0 and y 2.0) to gableContour
keep bim face contour gableContour of gableWall in target
free gableContour
set partitionWall to add bim wall typed partitionType on upper from (a cad vector2 with x 1.0 and y 3.0) to (a cad vector2 with x 5.0 and y 3.0) to target
set bim property (the string form of "Name") of set (the string form of "IFC attributes") of groundWall to (the string form of "Ground wall") typed (the string form of "IFCLABEL") in target
set bim property (the string form of "Name") of set (the string form of "IFC attributes") of upperWall to (the string form of "Upper wall") typed (the string form of "IFCLABEL") in target
set bim property (the string form of "Name") of set (the string form of "IFC attributes") of gableWall to (the string form of "Gable") typed (the string form of "IFCLABEL") in target
set bim property (the string form of "Name") of set (the string form of "IFC attributes") of partitionWall to (the string form of "Partition wall") typed (the string form of "IFCLABEL") in target

set windowType to add bim opening type named (the string form of "Window") sized 1.0 by 1.2 with sill 0.9 and frame 0.05 to target
ignore add bim opening typed windowType in groundWall at 1.5 to target
ignore add bim opening typed windowType in upperWall at 1.5 to target
ignore add bim opening typed windowType in gableWall at 3.0 to target

set outline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to outline
append (a cad vector2 with x 6.0 and y 0.0) to outline
append (a cad vector2 with x 6.0 and y 6.0) to outline
append (a cad vector2 with x 0.0 and y 6.0) to outline
ignore add bim plate typed floorType on upper around outline at top 0.0 to target
ignore add bim slab on ground around outline thick 0.12 to target
free outline

set exported to the bim ifc text of modelValue
set stepFile to the bim step file of exported
check ifc placement stepFile's valid named (the string form of "the exported file reads back")
set reader to a fresh bim ifc reading of stepFile
set readerAddress to the address of reader

# Walls: name, body, placement height and predefined type.
set wallNumbers to the bim step instances of type (the string form of "IFCWALL") in stepFile
loop cursor from 0 to the length of wallNumbers:
    set wallNumber to the item at cursor in wallNumbers
    set wallValue to the bim step instance wallNumber in stepFile
    set wallPredefinedText to the bim step raw text of (the bim step argument 8 of wallValue) in wallValue
    free bim step instance wallValue
    set wallText to (the ifc placement name of wallNumber in stepFile) + (the string form of ": ")
    set wallText to (wallText + (the ifc placement body kind of wallNumber in stepFile)) + (the string form of " at ")
    set wallText to ((wallText + (the string form of (the ifc placement height of product wallNumber in readerAddress))) + (the string form of " mm, ")) + wallPredefinedText
    print wallText as a line
free wallNumbers

# Openings and the windows filling them, in the walls' order.
set openingHeights to an empty list of an integer
set openingNumbers to the bim step instances of type (the string form of "IFCOPENINGELEMENT") in stepFile
loop cursor from 0 to the length of openingNumbers:
    set productHeight to the ifc placement height of product (the item at cursor in openingNumbers) in readerAddress
    append productHeight to openingHeights
    print ((the string form of "opening at ") + ((the string form of productHeight) + (the string form of " mm"))) as a line
free openingNumbers
set windowHeights to an empty list of an integer
set windowNumbers to the bim step instances of type (the string form of "IFCWINDOW") in stepFile
loop cursor from 0 to the length of windowNumbers:
    set productHeight to the ifc placement height of product (the item at cursor in windowNumbers) in readerAddress
    append productHeight to windowHeights
    print ((the string form of "window at ") + ((the string form of productHeight) + (the string form of " mm"))) as a line
free windowNumbers
check ifc placement ((the length of openingHeights) = 3) named (the string form of "three openings are exported")
check ifc placement ((the item at 0 in openingHeights) = 900) named (the string form of "the ground-floor opening stands at its sill")
check ifc placement ((the item at 1 in openingHeights) = 3900) named (the string form of "the upper opening stands at its sill above the storey, not above the raised wall foot")
check ifc placement ((the item at 2 in openingHeights) = 3900) named (the string form of "the gable's opening stays on the upper storey")
check ifc placement (((the item at 0 in windowHeights) = 900) and (((the item at 1 in windowHeights) = 3900) and ((the item at 2 in windowHeights) = 3900))) named (the string form of "each window stands in its opening")
free openingHeights
free windowHeights

# Wall types and their predefined types.
set wallTypeNumbers to the bim step instances of type (the string form of "IFCWALLTYPE") in stepFile
loop cursor from 0 to the length of wallTypeNumbers:
    set typeNumber to the item at cursor in wallTypeNumbers
    set typeValue to the bim step instance typeNumber in stepFile
    set typePredefined to the bim step raw text of (the bim step argument 9 of typeValue) in typeValue
    free bim step instance typeValue
    print (((the string form of "wall type ") + (the ifc placement name of typeNumber in stepFile)) + ((the string form of ": ") + typePredefined)) as a line
free wallTypeNumbers

# The material each slab type is associated with.
set associationNumbers to the bim step instances of type (the string form of "IFCRELASSOCIATESMATERIAL") in stepFile
loop cursor from 0 to the length of associationNumbers:
    set associationValue to the bim step instance (the item at cursor in associationNumbers) in stepFile
    set relatedList to the bim step argument 4 of associationValue
    set materialNumber to the bim step reference of (the bim step argument 5 of associationValue) in associationValue
    loop relatedCursor from 0 to the bim step count of relatedList in associationValue:
        set relatedNumber to the bim step reference of (the bim step member relatedCursor of relatedList in associationValue) in associationValue
        if bim step instance relatedNumber is a (the string form of "IFCSLABTYPE") in stepFile:
            set materialName to the string form of ""
            set materialValue to the bim step instance materialNumber in stepFile
            if materialValue's typeName = (the string form of "IFCMATERIAL"):
                set materialName to the bim step string of (the bim step argument 0 of materialValue) in materialValue
            if materialValue's typeName = (the string form of "IFCMATERIALLAYERSET"):
                set materialName to the bim step string of (the bim step argument 1 of materialValue) in materialValue
            print (((the string form of "slab type ") + (the ifc placement name of relatedNumber in stepFile)) + ((((the string form of ": ") + materialValue's typeName) + (the string form of " ")) + materialName)) as a line
            free bim step instance materialValue
    free bim step instance associationValue
free associationNumbers
