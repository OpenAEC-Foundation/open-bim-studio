# SPDX-License-Identifier: MPL-2.0
# IFC read directly (`bim_ifc_read.dl`): a small IFC4 file in millimetres
# with a wall extruded from a rectangle on a storey placement, a slab from an
# arbitrary profile with an arc (an indexed poly curve), a polygonal face set,
# a column type mapped twice (turned and scaled), a styled colour, a bar as a
# swept disk, a wall clipped by a half space, a block of three items in
# three colours, and a mapped item and a boolean styled as a whole; each
# element's storey (wall A and the block in a storey, the blue wall through
# the block it is a part of) and meshes, one per colour, with their
# triangles, box and volume (positive when their faces point outward); and
# which meshes place a shared shape: only the green column is one mapped item
# (the columns are two), so it alone is drawn as an instance.
import formats/bim_ifc_read.dl

function the ifc test millimetres of {a 64 bit floating-point number:metres}:
    execute:
        return the string form of (@intrinsic("call", "libc", "round", a 64 bit floating-point number, metres * 1000.0) as an integer)

function the ifc test volume of {fast mesh record:shape}:
    execute:
        set total to 0.0
        set corners to shape's triangles's values
        set cursor to 0
        loop while (cursor + 2) < (the length of corners):
            set a to the item at (the item at cursor in corners) in (shape's positions's values)
            set b to the item at (the item at (cursor + 1) in corners) in (shape's positions's values)
            set c to the item at (the item at (cursor + 2) in corners) in (shape's positions's values)
            set total to total + ((the cad dot of a and (the cad cross of b and c)) / 6.0)
            set cursor to cursor + 3
        return total

function show ifc test elements of {bim import record:imported}:
    execute:
        set shownId to (-1) as a 64 bit integer
        set shownStoreyId to (-1) as a 64 bit integer
        loop cursor from 0 to the length of (imported's meshes's values):
            set entry to the item at cursor in (imported's meshes's values)
            # An element in several colours is one mesh per colour.
            if entry's elementId != shownId:
                print (the item at ((entry's elementId - (the bim imported id base)) as an integer) in (imported's labels's values)) as a line
                set shownId to entry's elementId
            set shape to entry's shape
            set low to a cad vector3 with x 1.0e30, y 1.0e30 and z 1.0e30
            set high to a cad vector3 with x -1.0e30, y -1.0e30 and z -1.0e30
            loop corner from 0 to the length of (shape's positions's values):
                set point to the item at corner in (shape's positions's values)
                set low to a cad vector3 with x (the minimum of low's x and point's x), y (the minimum of low's y and point's y) and z (the minimum of low's z and point's z)
                set high to a cad vector3 with x (the maximum of high's x and point's x), y (the maximum of high's y and point's y) and z (the maximum of high's z and point's z)
            set boxText to ((((the ifc test millimetres of low's x) + (the string form of " ")) + ((the ifc test millimetres of low's y) + (the string form of " "))) + ((the ifc test millimetres of low's z) + (the string form of " .. "))) + (((the ifc test millimetres of high's x) + (the string form of " ")) + (((the ifc test millimetres of high's y) + (the string form of " ")) + (the ifc test millimetres of high's z)))
            set volumeText to the string form of ((@intrinsic("call", "libc", "round", a 64 bit floating-point number, (the ifc test volume of shape) * 1000.0) as an integer))
            set colourText to the string form of "category"
            if entry's colour's x >= 0.0:
                set colourText to ((the string form of (entry's colour's x as an integer)) + (the string form of ",")) + (((the string form of (entry's colour's y as an integer)) + (the string form of ",")) + (the string form of (entry's colour's z as an integer)))
            if entry's elementId != shownStoreyId:
                set storeyText to the string form of "none"
                set height to the bim storey elevation of imported element ((entry's elementId - (the bim imported id base)) as an integer) in imported
                if height = height:
                    set storeyText to (the string form of "at ") + (the ifc test millimetres of height)
                print ((the string form of "  storey ") + storeyText) as a line
                set shownStoreyId to entry's elementId
            print ((((the string form of "  ") + (the string form of ((the length of (shape's triangles's values)) / 3))) + (the string form of " triangles, box ")) + ((boxText + (the string form of ", litres ")) + (volumeText + ((the string form of ", colour ") + colourText)))) as a line

set lines to an empty list of a string
append (the string form of "ISO-10303-21;") to lines
append (the string form of "HEADER;FILE_DESCRIPTION((''),'2;1');FILE_NAME('t.ifc','',(''),(''),'','','');FILE_SCHEMA(('IFC4'));ENDSEC;") to lines
append (the string form of "DATA;") to lines
append (the string form of "#1=IFCPROJECT('0YvctVUKr0kugbFTf53O9L',$,'Test',$,$,$,$,$,#2);") to lines
append (the string form of "#2=IFCUNITASSIGNMENT((#3,#4));") to lines
append (the string form of "#3=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);") to lines
append (the string form of "#4=IFCSIUNIT(*,.PLANEANGLEUNIT.,$,.RADIAN.);") to lines
append (the string form of "#10=IFCCARTESIANPOINT((0.,0.,0.));") to lines
append (the string form of "#11=IFCDIRECTION((0.,0.,1.));") to lines
append (the string form of "#12=IFCDIRECTION((1.,0.,0.));") to lines
append (the string form of "#13=IFCAXIS2PLACEMENT3D(#10,$,$);") to lines
append (the string form of "#14=IFCLOCALPLACEMENT($,#13);") to lines
# The storey 3 m up.
append (the string form of "#15=IFCCARTESIANPOINT((0.,0.,3000.));") to lines
append (the string form of "#16=IFCAXIS2PLACEMENT3D(#15,$,$);") to lines
append (the string form of "#17=IFCLOCALPLACEMENT(#14,#16);") to lines
# A wall 4000 x 200 x 2700, its axis along y (turned a quarter).
append (the string form of "#20=IFCCARTESIANPOINT((1000.,0.,0.));") to lines
append (the string form of "#21=IFCDIRECTION((0.,1.,0.));") to lines
append (the string form of "#22=IFCAXIS2PLACEMENT3D(#20,#11,#21);") to lines
append (the string form of "#23=IFCLOCALPLACEMENT(#17,#22);") to lines
append (the string form of "#24=IFCCARTESIANPOINT((2000.,0.));") to lines
append (the string form of "#25=IFCAXIS2PLACEMENT2D(#24,$);") to lines
append (the string form of "#26=IFCRECTANGLEPROFILEDEF(.AREA.,$,#25,4000.,200.);") to lines
append (the string form of "#27=IFCEXTRUDEDAREASOLID(#26,#13,#11,2700.);") to lines
append (the string form of "#28=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#27));") to lines
append (the string form of "#29=IFCPRODUCTDEFINITIONSHAPE($,$,(#28));") to lines
append (the string form of "#30=IFCWALL('2O2Fr$t4X7Zf8NOew3FLOH',$,'Wall ''A''',$,$,#23,#29,$,.STANDARD.);") to lines
# A slab: 3000 x 2000 with a half-round end of radius 1000, 250 thick.
append (the string form of "#40=IFCCARTESIANPOINTLIST2D(((0.,0.),(3000.,0.),(4000.,1000.),(3000.,2000.),(0.,2000.)));") to lines
append (the string form of "#41=IFCINDEXEDPOLYCURVE(#40,(IFCLINEINDEX((1,2)),IFCARCINDEX((2,3,4)),IFCLINEINDEX((4,5,1))),$);") to lines
append (the string form of "#42=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,'Slab',#41);") to lines
append (the string form of "#43=IFCEXTRUDEDAREASOLID(#42,#13,#11,250.);") to lines
append (the string form of "#44=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#43));") to lines
append (the string form of "#45=IFCPRODUCTDEFINITIONSHAPE($,$,(#44));") to lines
append (the string form of "#46=IFCSLAB('1EgP7xZd57Gv$V0ZXLa1AK',$,'Floor',$,$,#14,#45,$,.FLOOR.);") to lines
# A tetrahedron as a polygonal face set, coloured red.
append (the string form of "#50=IFCCARTESIANPOINTLIST3D(((0.,0.,0.),(1000.,0.,0.),(0.,1000.,0.),(0.,0.,1000.)));") to lines
append (the string form of "#51=IFCINDEXEDPOLYGONALFACE((1,3,2));") to lines
append (the string form of "#52=IFCINDEXEDPOLYGONALFACE((1,2,4));") to lines
append (the string form of "#53=IFCINDEXEDPOLYGONALFACE((1,4,3));") to lines
append (the string form of "#54=IFCINDEXEDPOLYGONALFACE((2,3,4));") to lines
append (the string form of "#55=IFCPOLYGONALFACESET(#50,.T.,(#51,#52,#53,#54),$);") to lines
append (the string form of "#56=IFCSHAPEREPRESENTATION($,'Body','Tessellation',(#55));") to lines
append (the string form of "#57=IFCPRODUCTDEFINITIONSHAPE($,$,(#56));") to lines
append (the string form of "#58=IFCBUILDINGELEMENTPROXY('3vB2YO$MX4xv5uCqZZG05x',$,'Tetra',$,$,#14,#57,$,$);") to lines
append (the string form of "#59=IFCCOLOURRGB($,1.,0.,0.);") to lines
append (the string form of "#60=IFCSURFACESTYLERENDERING(#59,0.,$,$,$,$,$,$,.NOTDEFINED.);") to lines
append (the string form of "#61=IFCSURFACESTYLE('Red',.BOTH.,(#60));") to lines
append (the string form of "#62=IFCSTYLEDITEM(#55,(#61),$);") to lines
# A column type (a 300 square, 3000 high) mapped twice: at 5000,0 and,
# turned a quarter and scaled by 2, at 8000,0.
append (the string form of "#70=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,300.,300.);") to lines
append (the string form of "#71=IFCEXTRUDEDAREASOLID(#70,#13,#11,3000.);") to lines
append (the string form of "#72=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#71));") to lines
append (the string form of "#73=IFCREPRESENTATIONMAP(#13,#72);") to lines
append (the string form of "#74=IFCCARTESIANPOINT((5000.,0.,0.));") to lines
append (the string form of "#75=IFCCARTESIANTRANSFORMATIONOPERATOR3D($,$,#74,$,$);") to lines
append (the string form of "#76=IFCMAPPEDITEM(#73,#75);") to lines
append (the string form of "#77=IFCCARTESIANPOINT((8000.,0.,0.));") to lines
append (the string form of "#78=IFCCARTESIANTRANSFORMATIONOPERATOR3D(#21,$,#77,2.,$);") to lines
append (the string form of "#79=IFCMAPPEDITEM(#73,#78);") to lines
append (the string form of "#80=IFCSHAPEREPRESENTATION($,'Body','MappedRepresentation',(#76,#79));") to lines
append (the string form of "#81=IFCPRODUCTDEFINITIONSHAPE($,$,(#80));") to lines
append (the string form of "#82=IFCCOLUMN('0Lp$sq9zv5ePjNz6s8Iq3N',$,'Columns',$,$,#14,#81,$,$);") to lines
# A bar: a disk of radius 10 along a polyline 1000 long.
append (the string form of "#90=IFCCARTESIANPOINT((0.,5000.,0.));") to lines
append (the string form of "#91=IFCCARTESIANPOINT((1000.,5000.,0.));") to lines
append (the string form of "#92=IFCPOLYLINE((#90,#91));") to lines
append (the string form of "#93=IFCSWEPTDISKSOLID(#92,10.,$,$,$);") to lines
append (the string form of "#94=IFCSHAPEREPRESENTATION($,'Body','AdvancedSweptSolid',(#93));") to lines
append (the string form of "#95=IFCPRODUCTDEFINITIONSHAPE($,$,(#94));") to lines
append (the string form of "#96=IFCREINFORCINGBAR('2x9f$5hJb1QR0x0VYu5FtQ',$,'Bar',$,$,#14,#95,$,$,$,$,$,$,$,$);") to lines
# A wall 1000 x 100 x 3000 clipped by a plane 2000 up: 2000 high left.
append (the string form of "#100=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,1000.,100.);") to lines
append (the string form of "#101=IFCEXTRUDEDAREASOLID(#100,#13,#11,3000.);") to lines
append (the string form of "#102=IFCCARTESIANPOINT((0.,0.,2000.));") to lines
append (the string form of "#103=IFCAXIS2PLACEMENT3D(#102,$,$);") to lines
append (the string form of "#104=IFCPLANE(#103);") to lines
append (the string form of "#105=IFCHALFSPACESOLID(#104,.F.);") to lines
append (the string form of "#106=IFCBOOLEANCLIPPINGRESULT(.DIFFERENCE.,#101,#105);") to lines
append (the string form of "#107=IFCSHAPEREPRESENTATION($,'Body','Clipping',(#106));") to lines
append (the string form of "#108=IFCPRODUCTDEFINITIONSHAPE($,$,(#107));") to lines
append (the string form of "#109=IFCCARTESIANPOINT((0.,-5000.,0.));") to lines
append (the string form of "#110=IFCAXIS2PLACEMENT3D(#109,$,$);") to lines
append (the string form of "#111=IFCLOCALPLACEMENT(#14,#110);") to lines
append (the string form of "#112=IFCWALL('1hOSvn6df7F8_7GcBWlRGQ',$,'Clipped',$,$,#111,#108,$,$);") to lines
# An opening is left out.
append (the string form of "#120=IFCOPENINGELEMENT('2LcE70iQb51PEZynawyvuT',$,'Hole',$,$,#14,#29,$,$);") to lines
# A kitchen block of three items, 600 square: a base 900 high styled black,
# a top 40 thick styled red, and a strip 10 thick without a style of its
# own; one mesh per colour.
append (the string form of "#130=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,600.,600.);") to lines
append (the string form of "#131=IFCEXTRUDEDAREASOLID(#130,#13,#11,900.);") to lines
append (the string form of "#132=IFCCARTESIANPOINT((0.,0.,900.));") to lines
append (the string form of "#133=IFCAXIS2PLACEMENT3D(#132,$,$);") to lines
append (the string form of "#134=IFCEXTRUDEDAREASOLID(#130,#133,#11,40.);") to lines
append (the string form of "#135=IFCCARTESIANPOINT((0.,0.,940.));") to lines
append (the string form of "#136=IFCAXIS2PLACEMENT3D(#135,$,$);") to lines
append (the string form of "#137=IFCEXTRUDEDAREASOLID(#130,#136,#11,10.);") to lines
append (the string form of "#138=IFCCOLOURRGB($,0.,0.,0.);") to lines
append (the string form of "#139=IFCSURFACESTYLERENDERING(#138,0.,$,$,$,$,$,$,.NOTDEFINED.);") to lines
append (the string form of "#140=IFCSURFACESTYLE('Black',.BOTH.,(#139));") to lines
append (the string form of "#141=IFCSTYLEDITEM(#131,(#140),$);") to lines
append (the string form of "#142=IFCSTYLEDITEM(#134,(#61),$);") to lines
append (the string form of "#143=IFCSHAPEREPRESENTATION($,'Body','SweptSolid',(#131,#134,#137));") to lines
append (the string form of "#144=IFCPRODUCTDEFINITIONSHAPE($,$,(#143));") to lines
append (the string form of "#145=IFCFURNISHINGELEMENT('0kQ3dV$uX2BhJcN1yQ7p9a',$,'Kitchen',$,$,#14,#144,$,$);") to lines
# The column type mapped once more, at 11000,0, the mapped item styled
# green: its unstyled solid takes the mapped item's colour.
append (the string form of "#150=IFCCARTESIANPOINT((11000.,0.,0.));") to lines
append (the string form of "#151=IFCCARTESIANTRANSFORMATIONOPERATOR3D($,$,#150,$,$);") to lines
append (the string form of "#152=IFCMAPPEDITEM(#73,#151);") to lines
append (the string form of "#153=IFCCOLOURRGB($,0.,1.,0.);") to lines
append (the string form of "#154=IFCSURFACESTYLERENDERING(#153,0.,$,$,$,$,$,$,.NOTDEFINED.);") to lines
append (the string form of "#155=IFCSURFACESTYLE('Green',.BOTH.,(#154));") to lines
append (the string form of "#156=IFCSTYLEDITEM(#152,(#155),$);") to lines
append (the string form of "#157=IFCSHAPEREPRESENTATION($,'Body','MappedRepresentation',(#152));") to lines
append (the string form of "#158=IFCPRODUCTDEFINITIONSHAPE($,$,(#157));") to lines
append (the string form of "#159=IFCCOLUMN('3TgW8mZr1Dw9Uq$5aKx2Lf',$,'Green column',$,$,#14,#158,$,$);") to lines
# The clipped wall's boolean once more, styled blue, 8 m along -y: the
# unstyled operand and the cap on the cut take the boolean's colour.
append (the string form of "#160=IFCBOOLEANCLIPPINGRESULT(.DIFFERENCE.,#101,#105);") to lines
append (the string form of "#161=IFCCOLOURRGB($,0.,0.,1.);") to lines
append (the string form of "#162=IFCSURFACESTYLERENDERING(#161,0.,$,$,$,$,$,$,.NOTDEFINED.);") to lines
append (the string form of "#163=IFCSURFACESTYLE('Blue',.BOTH.,(#162));") to lines
append (the string form of "#164=IFCSTYLEDITEM(#160,(#163),$);") to lines
append (the string form of "#165=IFCSHAPEREPRESENTATION($,'Body','Clipping',(#160));") to lines
append (the string form of "#166=IFCPRODUCTDEFINITIONSHAPE($,$,(#165));") to lines
append (the string form of "#167=IFCCARTESIANPOINT((0.,-8000.,0.));") to lines
append (the string form of "#168=IFCAXIS2PLACEMENT3D(#167,$,$);") to lines
append (the string form of "#169=IFCLOCALPLACEMENT(#14,#168);") to lines
append (the string form of "#170=IFCWALL('1Rx7cVt3n9GQ0pY_kM4sJb',$,'Blue clipped',$,$,#169,#166,$,$);") to lines
# A storey placed 3 m up containing wall A and the kitchen block; the blue
# wall is a part of the kitchen block, so it is in the storey too. The
# other elements are in none.
append (the string form of "#180=IFCBUILDINGSTOREY('2Gd8kP0sT1xF$yQn5bWc3e',$,'First floor',$,$,#17,$,$,.ELEMENT.,3000.);") to lines
append (the string form of "#181=IFCRELCONTAINEDINSPATIALSTRUCTURE('0aT5cM7kL2vR9yP_wQ3nXh',$,$,$,(#30,#145),#180);") to lines
append (the string form of "#182=IFCRELAGGREGATES('3Hq2nW8vB6mK1tY$zR4pLs',$,$,$,#145,(#170));") to lines
append (the string form of "ENDSEC;") to lines
append (the string form of "END-ISO-10303-21;") to lines
set imported to the bim ifc elements of (the bim step file of (lines joined with "\n"))
print ((the string form of "valid: ") + (the string form of imported's valid)) as a line
print ((the string form of "elements: ") + (the string form of (the length of (imported's labels's values)))) as a line
print ((the string form of "meshes: ") + (the string form of (the length of (imported's meshes's values)))) as a line
print ((the string form of "message: ") + imported's message) as a line
loop storeyCursor from 0 to the length of (imported's storeys's names's values):
    print (((the string form of "storey ") + (the item at storeyCursor in (imported's storeys's names's values))) + ((the string form of " at ") + (the ifc test millimetres of (the item at storeyCursor in (imported's storeys's elevations's values))))) as a line
show ifc test elements of imported
print ((the string form of "shared shapes: ") + (the string form of (the length of (imported's instancing's prototypes's values)))) as a line
loop meshCursor from 0 to the length of (imported's meshes's values):
    set shapeOf to the bim prototype of imported mesh meshCursor in imported
    if shapeOf >= 0:
        set placing to imported's instancing's transforms's values
        set shiftText to ((the ifc test millimetres of (the item at ((meshCursor * 12) + 3) in placing)) + (the string form of " ")) + (((the ifc test millimetres of (the item at ((meshCursor * 12) + 7) in placing)) + (the string form of " ")) + (the ifc test millimetres of (the item at ((meshCursor * 12) + 11) in placing)))
        set shapePoints to (the item at shapeOf in (imported's instancing's prototypes's values))'s positions's values
        print ((((the string form of "mesh ") + (the string form of meshCursor)) + (the string form of " places shape ")) + (((the string form of shapeOf) + (the string form of ", shift ")) + ((shiftText + (the string form of ", corners ")) + (the string form of (the length of shapePoints))))) as a line
print ((the string form of "missing file: ") + (the bim ifc import of (the string form of "build/no-such-file.ifc"))'s message) as a line
