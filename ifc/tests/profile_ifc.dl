# SPDX-License-Identifier: MPL-2.0
# Profiles in IFC (issue #95): every linear type goes out with its profile
# definition, named after the type, in a material profile set associated
# with the type: a catalogue steel profile as its parametric IFC profile, a
# plain type as a rectangle or a circle, a parametric profile as its
# evaluated outline with its hole (IfcArbitraryProfileDefWithVoids) and its
# open property set OpenAEC_ProfileParameters among the type's
# HasPropertySets. The file reads back with the sets and their values.
import ifc/bim_ifc.dl
import ifc/bim_ifc_native.dl
import exchange/ifcx/bim_file.dl
import elements/linear/bim_profile_catalogue.dl
import elements/linear/bim_profile_parameters.dl

function check profile ifc {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the count of {a string:fragment} in {a string:fullText}:
    execute:
        set pieces to fullText split at fragment
        set total to (the length of pieces) - 1
        free pieces
        return total

# The lines of `fullText` holding `fragment`, printed.
function print lines of {a string:fullText} holding {a string:fragment}:
    execute:
        set fileLines to fullText split at "\n"
        loop cursor from 0 to the length of fileLines:
            if (the item at cursor in fileLines) contains fragment:
                print (the item at cursor in fileLines) as a line
        free fileLines

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set found to the bim catalogue profiles matching (the string form of "HEA 200")
set beamType to add bim catalogue profile (the item at 0 in found) as role (bim beam role) to target
free found
set columnType to add bim linear type named (the string form of "Column") as role (bim column role) sized 0.3 by 0.3 round true of (the string form of "concrete") to target
set frameType to add bim linear type named (the string form of "Frame") as role (bim generic linear role) sized 0.05 by 0.05 round false of (the string form of "timber") to target
set parameterList to an empty list of a bim profile parameter record
append (the bim profile parameter named (the string form of "b") valued 0.068) to parameterList
append (the bim profile parameter named (the string form of "h") valued 0.114) to parameterList
append (the bim profile parameter named (the string form of "r") following (the string form of "b/4")) to parameterList
set voidTexts to an empty list of a string
append (the string form of "b/4,h/4; b/2,h/4; b/2,h/2; b/4,h/2") to voidTexts
check profile ifc (make bim linear type frameType parametric named (the string form of "Frame 68x114") in series (the string form of "Window frames") with parameterList outline (the string form of "0,0; b,0; b,h-r; b-r,h-r; b-r,h; 0,h") voids voidTexts in target) named (the string form of "the frame is parametric")
ignore add bim linear typed beamType on ground from (a cad vector3 with x 0.0, y 0.0 and z 3.0) to (a cad vector3 with x 4.0, y 0.0 and z 3.0) turned 0.0 to target
ignore add bim linear typed columnType on ground from (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (a cad vector3 with x 0.0, y 0.0 and z 3.0) turned 0.0 to target
ignore add bim linear typed frameType on ground from (a cad vector3 with x 1.0, y 0.0 and z 1.0) to (a cad vector3 with x 2.0, y 0.0 and z 1.0) turned 0.0 to target

set exported to the bim ifc text of modelValue
print lines of exported holding (the string form of "PROFILEDEF")
print lines of exported holding (the string form of "IFCMATERIALPROFILE")
print lines of exported holding (the string form of "TYPE(")
print lines of exported holding (the string form of "'OpenAEC_ProfileParameters'")
print lines of exported holding (the string form of "IFCPROPERTYSINGLEVALUE(")
check profile ifc ((the count of (the string form of "IFCMATERIALPROFILESET(") in exported) = 3) named (the string form of "each linear type has a material profile set")
check profile ifc ((the count of (the string form of "IFCRELASSOCIATESMATERIAL(") in exported) = 3) named (the string form of "associated with its type")
check profile ifc ((the count of (the string form of "IFCRELDEFINESBYPROPERTIES(") in exported) = 1) named (the string form of "the type's set is not related as an occurrence's (only the project's settings are)")

set exportedFile to the bim step file of exported
check profile ifc ((the length of (the bim step instances of type (the string form of "IFCPROPERTYSET") in exportedFile)) = 2) named (the string form of "the file reads back with the project's and the profile's sets")
set exported43 to the bim ifc43 text of modelValue
check profile ifc ((the count of (the string form of "IFCARBITRARYPROFILEDEFWITHVOIDS(") in exported43) = 1) named (the string form of "IFC4X3 writes the same profiles")
