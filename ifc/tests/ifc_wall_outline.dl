set stepFile to the bim step file of (ifcLines joined with "\n")
set nativeSet to the bim ifc natives of stepFile
set modelValue to an empty bim model
ignore add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to (the address of modelValue)
set counts to add bim ifc natives nativeSet to (the address of modelValue)
print (the bim ifc native text of counts) as a line
set evaluation to the bim evaluation of modelValue after (an empty bim evaluation)
loop cursor from 0 to the length of (modelValue's walls's values):
    set wallValue to the item at cursor in (modelValue's walls's values)
    print ((((the string form of "wall from ") + ((the bim metres text of wallValue's start's x) + ((the string form of ",") + (the bim metres text of wallValue's start's y)))) + (((the string form of " to ") + ((the bim metres text of wallValue's finish's x) + ((the string form of ",") + (the bim metres text of wallValue's finish's y)))) + ((the string form of " base ") + (the bim metres text of wallValue's baseOffset)))) + ((the string form of " high ") + (the bim metres text of wallValue's height))) as a line
    set faceCorners to the bim face contour of wallValue's id in modelValue
    loop cornerCursor from 0 to the length of faceCorners:
        set faceCorner to the item at cornerCursor in faceCorners
        print (((the string form of "  outline ") + (the bim metres text of faceCorner's x)) + ((the string form of ",") + (the bim metres text of faceCorner's y))) as a line
    loop geometryCursor from 0 to the length of (evaluation's elements's values):
        set geometry to the item at geometryCursor in (evaluation's elements's values)
        if geometry's id = wallValue's id:
            print (((the string form of "  status ") + (the string form of geometry's status)) + ((the string form of " volume ") + (the bim metres text of (the bim volume of geometry)))) as a line
loop cursor from 0 to the length of (modelValue's openings's values):
    set openingValue to the item at cursor in (modelValue's openings's values)
    set openingType to the item at (the bim opening type index of openingValue's typeId in modelValue)'s position in (modelValue's openingTypes's values)
    print (((the string form of "opening at ") + (the bim metres text of openingValue's offset)) + (((the string form of ": ") + openingType's name) + ((the string form of " sill ") + (the bim metres text of openingType's sill)))) as a line
set rest to the bim ifc elements of stepFile skipping (nativeSet's skipped's values)
print ((the string form of "imported besides: ") + (the string form of (the length of (rest's labels's values)))) as a line
# A wall whose length is a nanometre off its outline's.
set nearModel to an empty bim model
set nearLevel to add bim level named (the string form of "Laag") at 0.094171737 with height 3.0 to (the address of nearModel)
set nearLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to nearLayers
set nearType to the bim wall type with layers nearLayers in (the address of nearModel)
set nearWall to add bim wall typed nearType on nearLevel from (a cad vector2 with x 21.0 and y 31.0) to (a cad vector2 with x 21.0 and y 40.0000000011) to (the address of nearModel)
ignore set bim wall nearWall base to 0.0 and height to 3.706 in (the address of nearModel)
set nearCorners to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to nearCorners
append (a cad vector2 with x 9.0 and y 0.0) to nearCorners
append (a cad vector2 with x 9.0 and y 3.706) to nearCorners
append (a cad vector2 with x 4.459 and y 3.706) to nearCorners
append (a cad vector2 with x 4.459 and y 3.406) to nearCorners
append (a cad vector2 with x 0.0 and y 3.406) to nearCorners
keep bim face contour nearCorners of nearWall in (the address of nearModel)
set nearEvaluation to the bim evaluation of nearModel after (an empty bim evaluation)
loop geometryCursor from 0 to the length of (nearEvaluation's elements's values):
    set geometry to the item at geometryCursor in (nearEvaluation's elements's values)
    if geometry's id = nearWall:
        print (((the string form of "a nanometre longer: status ") + (the string form of geometry's status)) + ((the string form of " volume ") + (the bim metres text of (the bim volume of geometry)))) as a line
