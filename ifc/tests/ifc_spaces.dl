# SPDX-License-Identifier: MPL-2.0
# Rooms in IFC (drawing quality plan, item 9): a two-storey model with named,
# numbered explicit spaces. The STEP export writes each explicit space as an
# IfcSpace with its number as Name, its name as LongName, its own height and
# Qto_SpaceBaseQuantities, aggregated in its own storey; a region derived from
# the walls goes out only when no explicit space claims it. IFCX writes the
# same Name, LongName and NetFloorArea.
import ifc/bim_ifc.dl
import exchange/ifcx/bim_ifcx.dl

function check ifc spaces {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# How often `fragment` occurs in `text`.
function the test occurrences of {a string:fragment} in {a string:text}:
    execute:
        set pieces to text split at fragment
        set found to (the length of pieces) - 1
        free pieces
        return found

# The instance number of the first STEP line of `text` holding every one of
# `first` and `second`, or -1.
function the test instance holding {a string:first} and {a string:second} in {a string:text}:
    execute:
        set lines to text split at "\n"
        set found to -1
        loop cursor from 0 to the length of lines:
            set line to the item at cursor in lines
            if (found < 0) and ((line contains first) and (line contains second)):
                set found to the test instance number of line
        free lines
        return found

# The instance number a STEP line `line` ("#12=…") starts with.
function the test instance number of {a string:line}:
    execute:
        set digits to 0
        set cursor to 1
        set reading to true
        loop while reading and (cursor < (the length of line)):
            set digit to (((the character at cursor in line) as an integer) bitwise and 255) - 48
            if (digit < 0) or (digit > 9):
                set reading to false
            else:
                set digits to (digits * 10) + digit
                set cursor to cursor + 1
        return digits

# `#number` as STEP writes a reference.
function the test reference to {integer:number}:
    execute:
        return (the string form of "#") + (the string form of number)

function a test rectangle from {a 64 bit floating-point number:left} to {a 64 bit floating-point number:right} by {a 64 bit floating-point number:depth}:
    execute:
        set corners to an empty list of a cad vector2
        append (a cad vector2 with x left and y 0.0) to corners
        append (a cad vector2 with x right and y 0.0) to corners
        append (a cad vector2 with x right and y depth) to corners
        append (a cad vector2 with x left and y depth) to corners
        return corners

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
set upper to add bim level named (the string form of "First floor") at 3.0 with height 3.0 to target
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to layerValues
set typeId to add bim wall type named (the string form of "Wall") with layerValues to target
# Four walls around 6 by 4 metres on each storey: one region each.
set footprint to a test rectangle from 0.0 to 6.0 by 4.0
loop corner from 0 to 4:
    ignore add bim wall typed typeId on ground from (the item at corner in footprint) to (the item at (the remainder of (corner + 1) divided by 4) in footprint) to target
    ignore add bim wall typed typeId on upper from (the item at corner in footprint) to (the item at (the remainder of (corner + 1) divided by 4) in footprint) to target
set groundRegions to the bim spaces of modelValue on level ground using (the bim join index of modelValue)
check ifc spaces ((the length of (groundRegions's values)) = 1) named (the string form of "the ground floor walls bound one region")
# The kitchen first, the living room (the walls' region, saved) second.
set kitchen to a test rectangle from 10.0 to 13.0 by 3.0
ignore add bim space object named (the string form of "Kitchen") numbered (the string form of "0.02") on ground around kitchen high 2.5 to target
ignore add bim space object named (the string form of "Living room") numbered (the string form of "0.01") on ground around ((the item at 0 in (groundRegions's values))'s outline's values) high 2.5 to target
set bedroom to a test rectangle from 10.0 to 14.0 by 3.0
set bedroomId to add bim space object named (the string form of "Bedroom") numbered (the string form of "1.01") on upper around bedroom high 2.75 to target

set stepText to the bim ifc text of modelValue
check ifc spaces ((the test occurrences of (the string form of "=IFCSPACE(") in stepText) = 4) named (the string form of "STEP: three explicit spaces and the one unsaved region")
check ifc spaces ((the test occurrences of (the string form of "'Space ") in stepText) = 1) named (the string form of "STEP: the saved region does not go out a second time")
check ifc spaces ((the test occurrences of (the string form of "'Space 22.04 m2'") in stepText) = 1) named (the string form of "STEP: the first floor's unsaved region keeps its area name")
set kitchenNumber to the test instance holding (the string form of "=IFCSPACE(") and (the string form of ",$,'0.02',$,$,") in stepText
check ifc spaces (kitchenNumber > 0) named (the string form of "STEP: Name is the number")
check ifc spaces ((the test instance holding (the string form of ",$,'0.02',$,$,") and (the string form of ",'Kitchen',.ELEMENT.,.SPACE.,$)") in stepText) = kitchenNumber) named (the string form of "STEP: LongName is the name")
check ifc spaces ((the test instance holding (the string form of ",$,'1.01',$,$,") and (the string form of ",'Bedroom',.ELEMENT.,.SPACE.,$)") in stepText) > 0) named (the string form of "STEP: the first floor's room")
check ifc spaces ((the test occurrences of (the string form of "'Qto_SpaceBaseQuantities'") in stepText) = 3) named (the string form of "STEP: one quantity set per explicit space")
check ifc spaces ((the test occurrences of (the string form of "IFCQUANTITYAREA('NetFloorArea',$,$,9.,$)") in stepText) = 1) named (the string form of "STEP: the kitchen's net floor area")
check ifc spaces ((the test occurrences of (the string form of "IFCQUANTITYAREA('GrossFloorArea',$,$,12.,$)") in stepText) = 1) named (the string form of "STEP: the bedroom's gross floor area")
check ifc spaces ((the test occurrences of (the string form of "IFCQUANTITYLENGTH('Height',$,$,2.75,$)") in stepText) = 1) named (the string form of "STEP: the bedroom's own height")
check ifc spaces ((the test occurrences of (the string form of "IFCQUANTITYVOLUME('NetVolume',$,$,33.,$)") in stepText) = 1) named (the string form of "STEP: the bedroom's net volume")
check ifc spaces ((the test occurrences of (the string form of "IFCQUANTITYLENGTH('Height',$,$,2.5,$)") in stepText) = 2) named (the string form of "STEP: the ground floor rooms' own height")
# The kitchen's quantity set is related to the kitchen.
set kitchenQuantities to the test instance holding (the string form of "IFCRELDEFINESBYPROPERTIES(") and (((the string form of ",(") + (the test reference to kitchenNumber)) + (the string form of "),")) in stepText
check ifc spaces (kitchenQuantities > 0) named (the string form of "STEP: the quantity set is the kitchen's")
# The bedroom is aggregated in the first floor, the kitchen in the ground floor.
set upperStorey to the test instance holding (the string form of "=IFCBUILDINGSTOREY(") and (the string form of "'First floor'") in stepText
set groundStorey to the test instance holding (the string form of "=IFCBUILDINGSTOREY(") and (the string form of "'Ground floor'") in stepText
set bedroomNumber to the test instance holding (the string form of "=IFCSPACE(") and (the string form of "'Bedroom'") in stepText
check ifc spaces ((the test instance holding (the string form of "IFCRELAGGREGATES(") and (((the string form of ",") + (the test reference to upperStorey)) + (the string form of ",(")) in stepText) = (the test instance holding (the string form of "IFCRELAGGREGATES(") and (((the string form of "(") + (the test reference to bedroomNumber)) + (the string form of ",")) in stepText)) named (the string form of "STEP: the bedroom is in the first floor")
check ifc spaces ((the test instance holding (the string form of "IFCRELAGGREGATES(") and (((the string form of ",") + (the test reference to groundStorey)) + (the string form of ",(")) in stepText) = (the test instance holding (the string form of "IFCRELAGGREGATES(") and (((the string form of "(") + (the test reference to kitchenNumber)) + (the string form of ",")) in stepText)) named (the string form of "STEP: the kitchen is in the ground floor")
set step43 to the bim ifc43 text of modelValue
check ifc spaces ((the test occurrences of (the string form of "'Qto_SpaceBaseQuantities'") in step43) = 3) named (the string form of "IFC4X3: the same quantity sets")

set ifcxText to the bim ifcx text of modelValue identified as (the string form of "rooms.ifcx") for project (the string form of "Rooms") by (the string form of "test") at (the string form of "2026-11-06T00:00:00Z")
check ifc spaces ((the test occurrences of (the string form of "\"IfcSpace\"") in ifcxText) = 4) named (the string form of "IFCX: three explicit spaces and the one unsaved region")
check ifc spaces ((the test occurrences of (the string form of "\"bsi::ifc::prop::Name\": \"0.01\"") in ifcxText) = 1) named (the string form of "IFCX: Name is the number")
check ifc spaces ((the test occurrences of (the string form of "\"bsi::ifc::prop::LongName\": \"Living room\"") in ifcxText) = 1) named (the string form of "IFCX: LongName is the name")
check ifc spaces ((the test occurrences of (the string form of "\"bsi::ifc::prop::NetFloorArea\": 9,") in ifcxText) = 1) named (the string form of "IFCX: the kitchen's net floor area")
check ifc spaces ((the test occurrences of (the string form of "\"bsi::ifc::prop::NetFloorArea\": 22.04") in ifcxText) = 2) named (the string form of "IFCX: the saved and the unsaved region's net floor area")
check ifc spaces ((the test occurrences of (the string form of "\"bsi::ifc::prop::NetArea\"") in ifcxText) = 0) named (the string form of "IFCX: no space writes NetArea")
