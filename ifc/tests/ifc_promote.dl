# SPDX-License-Identifier: MPL-2.0
# Imported elements made editable (bim_ifc_promote.dl): a box that the
# import cannot make native (an IfcBuildingElementProxy) becomes a mesh of
# the model's own, welded to its 8 corners and 12 triangles, with its class,
# GlobalId, name and property set as properties; the views' import leaves it
# out, it is not taken over twice, and it survives the native file.
import ifc/bim_ifc_native.dl
import ifc/bim_ifc_promote.dl

set ifcLines to an empty list of a string
append (the string form of "ISO-10303-21;") to ifcLines
append (the string form of "HEADER;") to ifcLines
append (the string form of "FILE_DESCRIPTION(('ViewDefinition [ReferenceView]'),'2;1');") to ifcLines
append (the string form of "FILE_NAME('promote.ifc','2026-10-20',(''),(''),'','','');") to ifcLines
append (the string form of "FILE_SCHEMA(('IFC4'));") to ifcLines
append (the string form of "ENDSEC;") to ifcLines
append (the string form of "DATA;") to ifcLines
append (the string form of "#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);") to ifcLines
append (the string form of "#2=IFCUNITASSIGNMENT((#1));") to ifcLines
append (the string form of "#3=IFCCARTESIANPOINT((0.,0.,0.));") to ifcLines
append (the string form of "#4=IFCAXIS2PLACEMENT3D(#3,$,$);") to ifcLines
append (the string form of "#5=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#4,$);") to ifcLines
append (the string form of "#6=IFCPROJECT('0aaaaaaaaaaaaaaaaaaaaa',$,'P',$,$,$,$,(#5),#2);") to ifcLines
append (the string form of "#10=IFCLOCALPLACEMENT($,#4);") to ifcLines
append (the string form of "#11=IFCBUILDINGSTOREY('0bbbbbbbbbbbbbbbbbbbbb',$,'00',$,$,#10,$,$,.ELEMENT.,0.);") to ifcLines
append (the string form of "#20=IFCCARTESIANPOINT((2.,1.,0.));") to ifcLines
append (the string form of "#21=IFCAXIS2PLACEMENT3D(#20,$,$);") to ifcLines
append (the string form of "#22=IFCLOCALPLACEMENT(#10,#21);") to ifcLines
append (the string form of "#23=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,1.2,0.6);") to ifcLines
append (the string form of "#24=IFCDIRECTION((0.,0.,1.));") to ifcLines
append (the string form of "#25=IFCEXTRUDEDAREASOLID(#23,#4,#24,0.9);") to ifcLines
append (the string form of "#26=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#25));") to ifcLines
append (the string form of "#27=IFCPRODUCTDEFINITIONSHAPE($,$,(#26));") to ifcLines
append (the string form of "#28=IFCBUILDINGELEMENTPROXY('0ccccccccccccccccccccc',$,'Keukenblok',$,$,#22,#27,$,$);") to ifcLines
append (the string form of "#29=IFCRELCONTAINEDINSPATIALSTRUCTURE('0ddddddddddddddddddddd',$,$,$,(#28),#11);") to ifcLines
append (the string form of "#30=IFCPROPERTYSINGLEVALUE('Leverancier',$,IFCLABEL('Bruynzeel'),$);") to ifcLines
append (the string form of "#31=IFCPROPERTYSET('0eeeeeeeeeeeeeeeeeeeee',$,'Inrichting',$,(#30));") to ifcLines
append (the string form of "#32=IFCRELDEFINESBYPROPERTIES('0fffffffffffffffffffff',$,$,$,(#28),#31);") to ifcLines
append (the string form of "ENDSEC;") to ifcLines
append (the string form of "END-ISO-10303-21;") to ifcLines
set stepFile to the bim step file of (ifcLines joined with "\n")
set nativeSet to the bim ifc natives of stepFile
set imported to the bim ifc elements of stepFile skipping (nativeSet's skipped's values)
print ((the string form of "imported elements: ") + (the string form of (the length of (imported's labels's values)))) as a line
print ((the string form of "imported label: ") + (the item at 0 in (imported's labels's values))) as a line

set modelValue to an empty bim model
ignore add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to (the address of modelValue)
set fresh to promote bim import element 0 of imported into (the address of modelValue)
print ((the string form of "promoted: ") + (the string form of (fresh != the bim refused id))) as a line
set meshValue to the item at 0 in (modelValue's meshes's values)
print ((the string form of "mesh points: ") + (the string form of (the length of (meshValue's vertices's values)))) as a line
print ((the string form of "mesh faces: ") + (the string form of (the bim face count of mesh meshValue))) as a line
set lowest to 1000.0
set highest to -1000.0
loop cursor from 0 to the length of (meshValue's vertices's values):
    set corner to the item at cursor in (meshValue's vertices's values)
    set lowest to the minimum of lowest and corner's z
    set highest to the maximum of highest and corner's z
print ((the string form of "mesh height: ") + ((the bim metres text of lowest) + ((the string form of " to ") + (the bim metres text of highest)))) as a line
set owned to the bim properties of fresh in modelValue
loop cursor from 0 to the length of (owned's values):
    set entry to the item at cursor in (owned's values)
    print ((the string form of "  ") + ((entry's setName + (the string form of ".")) + ((entry's name + (the string form of " = ")) + entry's value))) as a line

set shown to the bim import of imported without promoted in modelValue
print ((the string form of "import shown: ") + ((the string form of (the length of (shown's labels's values))) + ((the string form of " elements, ") + ((the string form of (the length of (shown's meshes's values))) + (the string form of " meshes"))))) as a line
set again to promote bim import element 0 of imported into (the address of modelValue)
print ((the string form of "promoted again: ") + (the string form of (again != the bim refused id))) as a line

set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of " ") + reread's message))) as a line
print ((the string form of "from .bim: ") + ((the string form of (the length of (reread's modelValue's meshes's values))) + ((the string form of " mesh, ") + ((the string form of (the length of (reread's modelValue's properties's values))) + (the string form of " properties"))))) as a line
