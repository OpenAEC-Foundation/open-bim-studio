# SPDX-License-Identifier: MPL-2.0
# IFC elements made native (bim_ifc_native.dl): a cavity wall (its axis,
# a vertical extrusion and a material layer set), its opening filled by a
# door, and a floor slab on the first floor, read from IFC text become the
# model's own wall (centred on its footprint, its type from the layers),
# door and plate, a column a linear element, with the first floor added as
# a level; the import leaves them out.
import ifc/bim_ifc_native.dl
import ui/editor/bim_editor.dl

set ifcLines to an empty list of a string
append (the string form of "ISO-10303-21;") to ifcLines
append (the string form of "HEADER;") to ifcLines
append (the string form of "FILE_DESCRIPTION(('ViewDefinition [ReferenceView]'),'2;1');") to ifcLines
append (the string form of "FILE_NAME('native.ifc','2026-10-16',(''),(''),'','','');") to ifcLines
append (the string form of "FILE_SCHEMA(('IFC4'));") to ifcLines
append (the string form of "ENDSEC;") to ifcLines
append (the string form of "DATA;") to ifcLines
append (the string form of "#1=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);") to ifcLines
append (the string form of "#2=IFCUNITASSIGNMENT((#1));") to ifcLines
append (the string form of "#3=IFCCARTESIANPOINT((0.,0.,0.));") to ifcLines
append (the string form of "#4=IFCAXIS2PLACEMENT3D(#3,$,$);") to ifcLines
append (the string form of "#5=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#4,$);") to ifcLines
append (the string form of "#6=IFCPROJECT('0aaaaaaaaaaaaaaaaaaaaa',$,'P',$,$,$,$,(#5),#2);") to ifcLines
append (the string form of "#10=IFCLOCALPLACEMENT($,#4);") to ifcLines
append (the string form of "#11=IFCBUILDINGSTOREY('0bbbbbbbbbbbbbbbbbbbbb',$,'Begane grond',$,$,#10,$,$,.ELEMENT.,0.);") to ifcLines
append (the string form of "#12=IFCCARTESIANPOINT((0.,0.,3000.));") to ifcLines
append (the string form of "#13=IFCAXIS2PLACEMENT3D(#12,$,$);") to ifcLines
append (the string form of "#14=IFCLOCALPLACEMENT($,#13);") to ifcLines
append (the string form of "#15=IFCBUILDINGSTOREY('0ccccccccccccccccccccc',$,'Eerste verdieping',$,$,#14,$,$,.ELEMENT.,3000.);") to ifcLines
append (the string form of "#20=IFCCARTESIANPOINT((1000.,2000.,0.));") to ifcLines
append (the string form of "#21=IFCAXIS2PLACEMENT3D(#20,$,$);") to ifcLines
append (the string form of "#22=IFCLOCALPLACEMENT(#10,#21);") to ifcLines
append (the string form of "#23=IFCCARTESIANPOINT((0.,0.));") to ifcLines
append (the string form of "#24=IFCCARTESIANPOINT((5000.,0.));") to ifcLines
append (the string form of "#25=IFCPOLYLINE((#23,#24));") to ifcLines
append (the string form of "#26=IFCSHAPEREPRESENTATION(#5,'Axis','Curve2D',(#25));") to ifcLines
append (the string form of "#27=IFCCARTESIANPOINT((0.,-150.));") to ifcLines
append (the string form of "#28=IFCCARTESIANPOINT((5000.,-150.));") to ifcLines
append (the string form of "#29=IFCCARTESIANPOINT((5000.,150.));") to ifcLines
append (the string form of "#30=IFCCARTESIANPOINT((0.,150.));") to ifcLines
append (the string form of "#31=IFCPOLYLINE((#27,#28,#29,#30,#27));") to ifcLines
append (the string form of "#32=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,$,#31);") to ifcLines
append (the string form of "#33=IFCDIRECTION((0.,0.,1.));") to ifcLines
append (the string form of "#34=IFCEXTRUDEDAREASOLID(#32,#4,#33,2800.);") to ifcLines
append (the string form of "#35=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#34));") to ifcLines
append (the string form of "#36=IFCPRODUCTDEFINITIONSHAPE($,$,(#26,#35));") to ifcLines
append (the string form of "#37=IFCWALL('0ddddddddddddddddddddd',$,'Gevel',$,$,#22,#36,$,$);") to ifcLines
append (the string form of "#40=IFCMATERIAL('Baksteen',$,$);") to ifcLines
append (the string form of "#41=IFCMATERIAL('Isolatie PIR',$,$);") to ifcLines
append (the string form of "#42=IFCMATERIAL('Kalkzandsteen',$,$);") to ifcLines
append (the string form of "#43=IFCMATERIALLAYER(#40,100.,$,$,$,$,$);") to ifcLines
append (the string form of "#44=IFCMATERIALLAYER(#41,100.,$,$,$,$,$);") to ifcLines
append (the string form of "#45=IFCMATERIALLAYER(#42,100.,$,$,$,$,$);") to ifcLines
append (the string form of "#46=IFCMATERIALLAYERSET((#43,#44,#45),'Spouwmuur',$);") to ifcLines
append (the string form of "#47=IFCMATERIALLAYERSETUSAGE(#46,.AXIS2.,.POSITIVE.,-150.,$);") to ifcLines
append (the string form of "#48=IFCRELASSOCIATESMATERIAL('0eeeeeeeeeeeeeeeeeeeee',$,$,$,(#37),#47);") to ifcLines
append (the string form of "#50=IFCCARTESIANPOINT((2000.,-300.,0.));") to ifcLines
append (the string form of "#51=IFCDIRECTION((0.,1.,0.));") to ifcLines
append (the string form of "#52=IFCDIRECTION((1.,0.,0.));") to ifcLines
append (the string form of "#53=IFCAXIS2PLACEMENT3D(#50,$,$);") to ifcLines
append (the string form of "#54=IFCLOCALPLACEMENT(#22,#53);") to ifcLines
append (the string form of "#55=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,1000.,2100.);") to ifcLines
append (the string form of "#56=IFCCARTESIANPOINT((500.,0.,1050.));") to ifcLines
append (the string form of "#57=IFCAXIS2PLACEMENT3D(#56,#51,#52);") to ifcLines
append (the string form of "#58=IFCEXTRUDEDAREASOLID(#55,#57,#33,600.);") to ifcLines
append (the string form of "#59=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#58));") to ifcLines
append (the string form of "#60=IFCPRODUCTDEFINITIONSHAPE($,$,(#59));") to ifcLines
append (the string form of "#61=IFCOPENINGELEMENT('0fffffffffffffffffffff',$,'Sparing',$,$,#54,#60,$,.OPENING.);") to ifcLines
append (the string form of "#62=IFCRELVOIDSELEMENT('0ggggggggggggggggggggg',$,$,$,#37,#61);") to ifcLines
append (the string form of "#63=IFCDOOR('0hhhhhhhhhhhhhhhhhhhhh',$,'Voordeur',$,$,#54,$,$,2100.,1000.,.DOOR.,$,$);") to ifcLines
append (the string form of "#64=IFCRELFILLSELEMENT('0iiiiiiiiiiiiiiiiiiiii',$,$,$,#61,#63);") to ifcLines
append (the string form of "#70=IFCCARTESIANPOINT((0.,0.,-250.));") to ifcLines
append (the string form of "#71=IFCAXIS2PLACEMENT3D(#70,$,$);") to ifcLines
append (the string form of "#72=IFCCARTESIANPOINT((0.,0.));") to ifcLines
append (the string form of "#73=IFCCARTESIANPOINT((6000.,0.));") to ifcLines
append (the string form of "#74=IFCCARTESIANPOINT((6000.,4000.));") to ifcLines
append (the string form of "#75=IFCCARTESIANPOINT((0.,4000.));") to ifcLines
append (the string form of "#76=IFCPOLYLINE((#72,#73,#74,#75,#72));") to ifcLines
append (the string form of "#77=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,$,#76);") to ifcLines
append (the string form of "#78=IFCEXTRUDEDAREASOLID(#77,#71,#33,250.);") to ifcLines
append (the string form of "#79=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#78));") to ifcLines
append (the string form of "#80=IFCPRODUCTDEFINITIONSHAPE($,$,(#79));") to ifcLines
append (the string form of "#81=IFCSLAB('0jjjjjjjjjjjjjjjjjjjjj',$,'Vloer',$,$,#14,#80,$,.FLOOR.);") to ifcLines
append (the string form of "#90=IFCRELCONTAINEDINSPATIALSTRUCTURE('0kkkkkkkkkkkkkkkkkkkkk',$,$,$,(#37,#63),#11);") to ifcLines
append (the string form of "#91=IFCRELCONTAINEDINSPATIALSTRUCTURE('0lllllllllllllllllllll',$,$,$,(#81),#15);") to ifcLines
append (the string form of "#100=IFCCARTESIANPOINT((8000.,0.,0.));") to ifcLines
append (the string form of "#101=IFCAXIS2PLACEMENT3D(#100,$,$);") to ifcLines
append (the string form of "#102=IFCLOCALPLACEMENT(#10,#101);") to ifcLines
append (the string form of "#103=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,300.,300.);") to ifcLines
append (the string form of "#104=IFCEXTRUDEDAREASOLID(#103,#4,#33,3000.);") to ifcLines
append (the string form of "#105=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#104));") to ifcLines
append (the string form of "#106=IFCPRODUCTDEFINITIONSHAPE($,$,(#105));") to ifcLines
append (the string form of "#107=IFCCOLUMN('0mmmmmmmmmmmmmmmmmmmmm',$,'Kolom',$,$,#102,#106,$,$);") to ifcLines
append (the string form of "#108=IFCMATERIAL('Beton C30/37',$,$);") to ifcLines
append (the string form of "#109=IFCRELASSOCIATESMATERIAL('0nnnnnnnnnnnnnnnnnnnnn',$,$,$,(#107),#108);") to ifcLines
append (the string form of "#110=IFCRELCONTAINEDINSPATIALSTRUCTURE('0ooooooooooooooooooooo',$,$,$,(#107),#11);") to ifcLines
append (the string form of "ENDSEC;") to ifcLines
append (the string form of "END-ISO-10303-21;") to ifcLines
set stepFile to the bim step file of (ifcLines joined with "\n")
set nativeSet to the bim ifc natives of stepFile
print (((the string form of "native walls ") + (the string form of (the length of (nativeSet's walls's values)))) + ((the string form of ", slabs ") + (the string form of (the length of (nativeSet's slabs's values))))) as a line
set modelValue to an empty bim model
ignore add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to (the address of modelValue)
set counts to add bim ifc natives nativeSet to (the address of modelValue)
print (the bim ifc native text of counts) as a line
loop cursor from 0 to the length of (modelValue's levels's values):
    set levelValue to the item at cursor in (modelValue's levels's values)
    print (((the string form of "level ") + levelValue's name) + ((the string form of " at ") + (the bim metres text of levelValue's elevation))) as a line
set wallValue to the item at 0 in (modelValue's walls's values)
print (((the string form of "wall from ") + ((the bim metres text of wallValue's start's x) + ((the string form of ",") + (the bim metres text of wallValue's start's y)))) + (((the string form of " to ") + ((the bim metres text of wallValue's finish's x) + ((the string form of ",") + (the bim metres text of wallValue's finish's y)))) + ((the string form of " high ") + (the bim metres text of wallValue's height)))) as a line
set wallType to the item at (the bim wall type index of wallValue's typeId in modelValue)'s position in (modelValue's wallTypes's values)
print ((the string form of "wall type ") + wallType's name) as a line
set openingValue to the item at 0 in (modelValue's openings's values)
set openingType to the item at (the bim opening type index of openingValue's typeId in modelValue)'s position in (modelValue's openingTypes's values)
print (((the string form of "opening at ") + (the bim metres text of openingValue's offset)) + ((the string form of ": ") + openingType's name)) as a line
set slabValue to the item at 0 in (modelValue's slabs's values)
print (((the string form of "slab of ") + (the string form of (the length of (slabValue's outline's values)))) + ((the string form of " corners, top ") + (the bim metres text of slabValue's top))) as a line
set rest to the bim ifc elements of stepFile skipping (nativeSet's skipped's values)
set linearValue to the item at 0 in (modelValue's linears's values)
set linearType to the item at (the bim linear type index of linearValue's typeId in modelValue)'s position in (modelValue's linearTypes's values)
print (((the string form of "column ") + linearType's name) + ((the string form of " from z ") + ((the bim metres text of linearValue's start's z) + ((the string form of " to ") + (the bim metres text of linearValue's finish's z))))) as a line
print ((the string form of "imported besides: ") + (the string form of (the length of (rest's labels's values)))) as a line
