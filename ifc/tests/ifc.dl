# SPDX-License-Identifier: MPL-2.0
# IFC4 export of the slice; the written file is checked by `verify_ifc.py`.
import ifc/bim_ifc.dl
import exchange/ifcx/bim_file.dl

function a bim test point at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y}:
    execute:
        return a cad vector2 with x x and y y

set modelValue to an empty bim model
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to (the address of modelValue)
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.12)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.1)) to layerValues
set exteriorType to add bim wall type named (the string form of "Cavity wall") with layerValues to (the address of modelValue)
free layerValues
set innerLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.1)) to innerLayers
set interiorType to add bim wall type named (the string form of "Partition") with innerLayers to (the address of modelValue)
free innerLayers
set south to add bim wall typed exteriorType on storey from (a bim test point at 0.0 and 0.0) to (a bim test point at 6.0 and 0.0) to (the address of modelValue)
set east to add bim wall typed exteriorType on storey from (a bim test point at 6.0 and 0.0) to (a bim test point at 6.0 and 4.0) to (the address of modelValue)
set north to add bim wall typed exteriorType on storey from (a bim test point at 6.0 and 4.0) to (a bim test point at 0.0 and 4.0) to (the address of modelValue)
set west to add bim wall typed exteriorType on storey from (a bim test point at 0.0 and 4.0) to (a bim test point at 0.0 and 0.0) to (the address of modelValue)
set middle to add bim wall typed interiorType on storey from (a bim test point at 3.0 and 0.0) to (a bim test point at 3.0 and 4.0) to (the address of modelValue)
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to (the address of modelValue)
set window to add bim opening typed windowType in south at 1.5 to (the address of modelValue)
set door to add bim opening typed windowType in middle at 2.0 to (the address of modelValue)
# An L-shaped slab, flush with the exterior faces, open over the north-east
# corner.
set slabOutline to an empty list of a cad vector2
append (a bim test point at -0.16 and -0.16) to slabOutline
append (a bim test point at 6.16 and -0.16) to slabOutline
append (a bim test point at 6.16 and 2.0) to slabOutline
append (a bim test point at 3.0 and 2.0) to slabOutline
append (a bim test point at 3.0 and 4.16) to slabOutline
append (a bim test point at -0.16 and 4.16) to slabOutline
set slab to add bim slab on storey around slabOutline thick 0.25 to (the address of modelValue)
free slabOutline
# A first floor with one free-standing wall over the south facade.
set upper to add bim level named (the string form of "First floor") at 3.0 with height 3.0 to (the address of modelValue)
set upperWall to add bim wall typed exteriorType on upper from (a bim test point at 0.0 and 0.0) to (a bim test point at 6.0 and 0.0) to (the address of modelValue)
# The upper wall is curved, with a window cut radially.
ignore bend bim wall upperWall by 1.0 in (the address of modelValue)
set upperWindow to add bim opening typed windowType in upperWall at 3.0 to (the address of modelValue)
# Grids: two numbered (north-south) and one lettered.
ignore add bim grid named (the string form of "1") from (a bim test point at 0.0 and -1.0) to (a bim test point at 0.0 and 5.0) reaching -1.0 to 7.0 to (the address of modelValue)
ignore add bim grid named (the string form of "2") from (a bim test point at 6.0 and -1.0) to (a bim test point at 6.0 and 5.0) reaching -1.0 to 7.0 to (the address of modelValue)
ignore add bim grid named (the string form of "A") from (a bim test point at -1.0 and 0.0) to (a bim test point at 7.0 and 0.0) reaching -1.0 to 7.0 to (the address of modelValue)
set outputPath to the argument at 0 in the command line arguments
set evaluation to the bim evaluation of modelValue after (an empty bim evaluation)
loop cursor from 0 to the length of (evaluation's elements's values):
    set geometry to the item at cursor in (evaluation's elements's values)
    set volume to the bim volume of geometry
    set elementKind to the string form of "wall "
    if (the bim slab index of geometry's id in modelValue)'s valid:
        set elementKind to the string form of "slab "
    print (((((the string form of "native ") + elementKind) + (the string form of geometry's id)) + (the string form of " ")) + (the string form of volume)) as a line
if (write bim text (the bim ifc text of modelValue) to file outputPath) = false:
    print "write failed" as a line
    @intrinsic("call", "libc", "exit", nothing, 1)
print "written" as a line
