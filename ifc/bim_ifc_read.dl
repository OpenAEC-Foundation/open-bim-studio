# SPDX-License-Identifier: MPL-2.0
# IFC read directly in DynLex (IFC2X3, IFC4 and IFC4X3, from the STEP text
# read by `bim_step.dl`): the geometry of every product with a body, in
# metres in the world, as read-only imported elements (the `bim import
# record` of `bim_import.dl`, as the BIM-MESH import gives them).
#
# What it evaluates:
#   placements     IfcLocalPlacement chains (IfcAxis2Placement3D/2D), and
#                  IfcLinearPlacement through its cartesian position
#   units          the length unit (SI prefixes, feet and inches) and the
#                  plane angle unit (radians or degrees)
#   tessellations  IfcPolygonalFaceSet (faces with voids, PnIndex),
#                  IfcTriangulatedFaceSet, IfcFacetedBrep(WithVoids),
#                  IfcShellBasedSurfaceModel, IfcFaceBasedSurfaceModel
#   swept solids   IfcExtrudedAreaSolid of arbitrary profiles (with voids),
#                  rectangles, circles, ellipses, I, L, U, T and C shapes,
#                  derived and composite profiles; IfcRevolvedAreaSolid;
#                  IfcSweptDiskSolid (a tube along its directrix)
#   curves         IfcPolyline, IfcIndexedPolyCurve (lines and arcs),
#                  IfcCompositeCurve, IfcTrimmedCurve of lines, circles and
#                  ellipses, whole circles and ellipses
#   booleans       IfcBooleanClippingResult and IfcBooleanResult cut by
#                  IfcHalfSpaceSolid and IfcPolygonalBoundedHalfSpace (the
#                  first operand's triangles clipped; other second operands
#                  are left out)
#   instancing     IfcMappedItem (IfcCartesianTransformationOperator3D,
#                  uniform and not), each mapped representation meshed once;
#                  an element made of one mapped item is marked as placing
#                  that mesh (the import's instancing), for the 3D view
#   storeys        IfcBuildingStorey at its placement's height; each
#                  element in the storey that contains it, through
#                  IfcRelContainedInSpatialStructure or the whole it is a
#                  part of (IfcRelAggregates)
#   colour         each item in its IfcStyledItem surface colour, else in
#                  the colour of the item it is part of (a mapped item, a
#                  boolean result), else the category's; an element is one
#                  mesh per colour, as a wall shown in layers is
#
# openings       IfcRelVoidsElement: a host made of extrusions has its
#                extruded openings cut away by the kernel's booleans; other
#                hosts are shown whole. Fillings (doors, windows) are
#                elements of their own.
import formats/bim_step.dl
import formats/bim_import.dl
import formats/bim_ifc_psets.dl
import kernel/planar/triangulate2.dl
import kernel/brep/brep_boolean.dl
import kernel/brep/brep_mesh.dl
import kernel/brep/brep_sweep.dl
import lib/text.dl

# ---------------------------------------------------------------- frames

# A placement: a point and three axes (which carry any scale), mapping local
# coordinates into the coordinates it is placed in.
class:
    patterns:
        [a|] bim ifc frame record
    members:
        origin as a cad vector3
        xAxis as a cad vector3
        yAxis as a cad vector3
        zAxis as a cad vector3

function the bim ifc identity axes:
    execute:
        return @intrinsic("construct", a bim ifc frame record, (a cad vector3 with x 0.0, y 0.0 and z 0.0), (a cad vector3 with x 1.0, y 0.0 and z 0.0), (a cad vector3 with x 0.0, y 1.0 and z 0.0), (a cad vector3 with x 0.0, y 0.0 and z 1.0))

function the bim ifc placed {cad vector3:local} through {bim ifc frame record:frame}:
    execute:
        return the cad sum of frame's origin and (the cad sum of (frame's xAxis scaled by local's x) and (the cad sum of (frame's yAxis scaled by local's y) and (frame's zAxis scaled by local's z)))

function the bim ifc turned {cad vector3:local} through {bim ifc frame record:frame}:
    execute:
        return the cad sum of (frame's xAxis scaled by local's x) and (the cad sum of (frame's yAxis scaled by local's y) and (frame's zAxis scaled by local's z))

# `inner` placed in `outer`: points of `inner` first through `inner`, then
# through `outer`.
function the bim ifc axes {bim ifc frame record:inner} within {bim ifc frame record:outer}:
    execute:
        return @intrinsic("construct", a bim ifc frame record, the bim ifc placed inner's origin through outer, the bim ifc turned inner's xAxis through outer, the bim ifc turned inner's yAxis through outer, the bim ifc turned inner's zAxis through outer)

function the bim ifc unit of {cad vector3:value} or {cad vector3:fallback}:
    execute:
        set size to the cad length of value
        if size < 1e-12:
            return fallback
        return value scaled by (1.0 / size)

# A frame from a z axis and an x axis near it (made square to z).
local function the bim ifc axes at {cad vector3:location} along {cad vector3:wantedZ} and {cad vector3:wantedX}:
    execute:
        set zUnit to the bim ifc unit of wantedZ or (a cad vector3 with x 0.0, y 0.0 and z 1.0)
        set xGuess to wantedX
        if (the cad length of (the cad cross of zUnit and xGuess)) < 1e-9:
            set xGuess to a cad vector3 with x 1.0, y 0.0 and z 0.0
            if (the absolute value of zUnit's x) > 0.9:
                set xGuess to a cad vector3 with x 0.0, y 1.0 and z 0.0
        set xUnit to the bim ifc unit of (the cad difference of xGuess and (zUnit scaled by (the cad dot of xGuess and zUnit))) or (a cad vector3 with x 1.0, y 0.0 and z 0.0)
        set yUnit to the cad cross of zUnit and xUnit
        return @intrinsic("construct", a bim ifc frame record, location, xUnit, yUnit, zUnit)

# ---------------------------------------------------------------- painted meshes

# Triangles grouped by surface colour: one group per colour, red, green and
# blue in 0..255 packed, or -1 for the category's colour.
class:
    patterns:
        [a|] bim ifc painted mesh record
    members:
        colours as the type of (an empty list of an integer)
        groups as the type of (an empty list of a fast mesh record)

function an empty bim ifc painted mesh:
    execute:
        return @intrinsic("construct", a bim ifc painted mesh record, an empty list of an integer, an empty list of a fast mesh record)

# The group of `painted` in `colour`, added when there is none yet. A group
# shares its lists with `painted`: triangles added to it land there.
function the bim ifc group in {integer:colour} of {a pointer to a bim ifc painted mesh record:painted}:
    execute:
        loop cursor from 0 to the length of (painted's colours):
            if (the item at cursor in (painted's colours)) = colour:
                return the item at cursor in (painted's groups)
        set colourGroup to an empty fast mesh
        append colour to (painted's colours)
        append colourGroup to (painted's groups)
        return colourGroup

function free bim ifc painted {a pointer to a bim ifc painted mesh record:painted}:
    execute:
        free (painted's colours)
        free (painted's groups)

# ---------------------------------------------------------------- the reader

class:
    patterns:
        [a|] bim ifc reader record
    members:
        stepFile as a bim step file record
        lengthScale as a 64 bit floating-point number
        angleScale as a 64 bit floating-point number
        # Placements already evaluated, by instance id.
        placementKnown as the type of (an empty list of a boolean)
        placementFrames as the type of (an empty list of a bim ifc frame record)
        # Mapped representations already meshed (in their own coordinates),
        # by representation and the colour they inherit.
        mappedIds as the type of (an empty list of an integer)
        mappedColours as the type of (an empty list of an integer)
        mappedMeshes as the type of (an empty list of a bim ifc painted mesh record)
        # The mapped representation placed last (-1: none) and how.
        lastMapped as an integer
        lastMappedAxes as a bim ifc frame record
        # The surface colour styled onto an item, by item id: red, green and
        # blue in 0..255 packed, or -1.
        itemColours as the type of (an empty list of an integer)
        skipped as the type of (an empty list of a string)

# A reader of `stepFile` that has evaluated nothing yet, in metres and
# radians until its units are gathered.
function a fresh bim ifc reading of {bim step file record:stepFile}:
    execute:
        return @intrinsic("construct", a bim ifc reader record, stepFile, 1.0, 1.0, an empty list of a boolean, an empty list of a bim ifc frame record, an empty list of an integer, an empty list of an integer, an empty list of a bim ifc painted mesh record, -1, the bim ifc identity axes, an empty list of an integer, an empty list of a string)

local function note bim ifc skipped {a string:typeName} in {a pointer to a bim ifc reader record:reader}:
    execute:
        loop cursor from 0 to the length of (reader's skipped):
            if (the item at cursor in (reader's skipped)) = typeName:
                return nothing
        append typeName to (reader's skipped)

# A cartesian point (2 or 3 coordinates) in metres; z is 0 for a 2D point.
local function the bim ifc coordinates of {integer:pointId} in {a pointer to a bim ifc reader record:reader}:
    execute:
        set pointValue to the bim step instance pointId in (reader's stepFile)
        set coordinateList to the bim step argument 0 of pointValue
        set scale to reader's lengthScale
        set result to a cad vector3 with x ((the bim step number of (the bim step member 0 of coordinateList in pointValue) in pointValue) * scale), y ((the bim step number of (the bim step member 1 of coordinateList in pointValue) in pointValue) * scale) and z ((the bim step number of (the bim step member 2 of coordinateList in pointValue) in pointValue) * scale)
        free bim step instance pointValue
        return result

# A direction (not scaled), or `fallback` when `directionId` is unset.
function the bim ifc ratios {integer:directionId} or {cad vector3:fallback} in {a pointer to a bim ifc reader record:reader}:
    execute:
        if directionId < 0:
            return fallback
        set directionValue to the bim step instance directionId in (reader's stepFile)
        set ratioList to the bim step argument 0 of directionValue
        set result to a cad vector3 with x (the bim step number of (the bim step member 0 of ratioList in directionValue) in directionValue), y (the bim step number of (the bim step member 1 of ratioList in directionValue) in directionValue) and z (the bim step number of (the bim step member 2 of ratioList in directionValue) in directionValue)
        free bim step instance directionValue
        return result

# The frame of an IfcAxis2Placement3D or IfcAxis2Placement2D (identity when
# unset).
function the bim ifc placement axes {integer:placementId} in {a pointer to a bim ifc reader record:reader}:
    execute:
        if (bim step file (reader's stepFile) holds placementId) = false:
            return the bim ifc identity axes
        set placementValue to the bim step instance placementId in (reader's stepFile)
        set location to a cad vector3 with x 0.0, y 0.0 and z 0.0
        set locationId to the bim step reference of (the bim step argument 0 of placementValue) in placementValue
        if locationId >= 0:
            set location to the bim ifc coordinates of locationId in reader
        set result to the bim ifc identity axes
        if placementValue's typeName = (the string form of "IFCAXIS2PLACEMENT2D"):
            set xDirection to the bim ifc ratios (the bim step reference of (the bim step argument 1 of placementValue) in placementValue) or (a cad vector3 with x 1.0, y 0.0 and z 0.0) in reader
            set result to the bim ifc axes at location along (a cad vector3 with x 0.0, y 0.0 and z 1.0) and xDirection
        else if placementValue's typeName = (the string form of "IFCAXIS2PLACEMENT3D"):
            set zDirection to the bim ifc ratios (the bim step reference of (the bim step argument 1 of placementValue) in placementValue) or (a cad vector3 with x 0.0, y 0.0 and z 1.0) in reader
            set xDirection to the bim ifc ratios (the bim step reference of (the bim step argument 2 of placementValue) in placementValue) or (a cad vector3 with x 1.0, y 0.0 and z 0.0) in reader
            set result to the bim ifc axes at location along zDirection and xDirection
        else:
            set result's origin to location
        free bim step instance placementValue
        return result

# The world frame of an object placement (IfcLocalPlacement relative to its
# parent; IfcLinearPlacement through its cartesian position), remembered.
function the bim ifc object axes {integer:placementId} in {a pointer to a bim ifc reader record:reader}:
    execute:
        if (bim step file (reader's stepFile) holds placementId) = false:
            return the bim ifc identity axes
        if placementId < (the length of (reader's placementKnown)):
            if the item at placementId in (reader's placementKnown):
                return the item at placementId in (reader's placementFrames)
        set placementValue to the bim step instance placementId in (reader's stepFile)
        set result to the bim ifc identity axes
        set parentId to the bim step reference of (the bim step argument 0 of placementValue) in placementValue
        set relativeId to the bim step reference of (the bim step argument 1 of placementValue) in placementValue
        if placementValue's typeName = (the string form of "IFCLINEARPLACEMENT"):
            set relativeId to the bim step reference of (the bim step argument 2 of placementValue) in placementValue
            if relativeId < 0:
                note bim ifc skipped (the string form of "IFCLINEARPLACEMENT without a cartesian position") in reader
        free bim step instance placementValue
        set local to the bim ifc placement axes relativeId in reader
        set result to local
        if (parentId >= 0) and (parentId != placementId):
            set result to the bim ifc axes local within (the bim ifc object axes parentId in reader)
        loop while (the length of (reader's placementKnown)) <= placementId:
            append false to (reader's placementKnown)
            append (the bim ifc identity axes) to (reader's placementFrames)
        replace item at index placementId in (reader's placementKnown) with true
        replace item at index placementId in (reader's placementFrames) with result
        return result

# ---------------------------------------------------------------- meshes

# Appends triangle `first`, `second`, `third` flat-shaded; degenerate ones are
# left out.
local function add bim ifc triangle {cad vector3:first} {cad vector3:second} {cad vector3:third} to {a pointer to a fast mesh record:shape}:
    execute:
        set normal to the cad cross of (the cad difference of second and first) and (the cad difference of third and first)
        set size to the cad length of normal
        if size < 1e-14:
            return nothing
        set normal to normal scaled by (1.0 / size)
        set base to the length of (shape's positions's values)
        append first to (shape's positions's values)
        append second to (shape's positions's values)
        append third to (shape's positions's values)
        append normal to (shape's normals's values)
        append normal to (shape's normals's values)
        append normal to (shape's normals's values)
        append base to (shape's triangles's values)
        append (base + 1) to (shape's triangles's values)
        append (base + 2) to (shape's triangles's values)

# `square` turned about its z axis by an angle no edge of a building takes
# (as `the fast bridge turn`), so that the triangulator, which bridges holes
# along its x axis, never meets holes whose corners line up with each other
# along that axis.
local function the bim ifc turned axes of {bim ifc frame record:square}:
    execute:
        set cosine to 0.9154331212015399
        set sine to 0.40247012386909775
        set turnedX to the cad sum of (square's xAxis scaled by cosine) and (square's yAxis scaled by sine)
        set turnedY to the cad difference of (square's yAxis scaled by cosine) and (square's xAxis scaled by sine)
        return @intrinsic("construct", a bim ifc frame record, square's origin, turnedX, turnedY, square's zAxis)

# Appends the polygon `outer` (3D points in order) with holes `voidRings`,
# triangulated in its own plane.
function add bim ifc facet {a pointer to a list:outer} with voids {a pointer to a list:voidRings} to {a pointer to a fast mesh record:shape}:
    execute:
        set count to the length of outer
        if count < 3:
            return nothing
        set holeCount to the length of voidRings
        if (count = 3) and (holeCount = 0):
            add bim ifc triangle (the item at 0 in outer) (the item at 1 in outer) (the item at 2 in outer) to shape
            return nothing
        # The plane's normal by Newell's method.
        set normal to a cad vector3 with x 0.0, y 0.0 and z 0.0
        loop cursor from 0 to count:
            set here to the item at cursor in outer
            set after to the item at (the remainder of (cursor + 1) divided by count) in outer
            set normal to the cad sum of normal and (a cad vector3 with x ((here's y - after's y) * (here's z + after's z)), y ((here's z - after's z) * (here's x + after's x)) and z ((here's x - after's x) * (here's y + after's y)))
        if (the cad length of normal) < 1e-14:
            return nothing
        if ((count = 4) and (holeCount = 0)):
            # A convex quadrilateral: two triangles on its shorter diagonal.
            set a to the item at 0 in outer
            set b to the item at 1 in outer
            set c to the item at 2 in outer
            set d to the item at 3 in outer
            set crossAC to the cad dot of (the cad cross of (the cad difference of b and a) and (the cad difference of c and a)) and normal
            set crossCA to the cad dot of (the cad cross of (the cad difference of d and c) and (the cad difference of a and c)) and normal
            set crossBD to the cad dot of (the cad cross of (the cad difference of c and b) and (the cad difference of d and b)) and normal
            set crossDB to the cad dot of (the cad cross of (the cad difference of a and d) and (the cad difference of b and d)) and normal
            if ((crossAC > 0.0) and (crossCA > 0.0)) and ((crossBD > 0.0) and (crossDB > 0.0)):
                add bim ifc triangle a b c to shape
                add bim ifc triangle a c d to shape
                return nothing
        set frame to the bim ifc turned axes of (the bim ifc axes at (the item at 0 in outer) along normal and (the cad difference of (the item at 1 in outer) and (the item at 0 in outer)))
        set flatOuter to an empty list of a cad vector2
        set lifted to an empty list of a cad vector3
        loop cursor from 0 to count:
            set offset to the cad difference of (the item at cursor in outer) and frame's origin
            append (a cad vector2 with x (the cad dot of offset and frame's xAxis) and y (the cad dot of offset and frame's yAxis)) to flatOuter
            append (the item at cursor in outer) to lifted
        set flatHoles to an empty list of the type of (an empty list of a cad vector2)
        loop holeCursor from 0 to holeCount:
            set hole to the item at holeCursor in voidRings
            set flatHole to an empty list of a cad vector2
            loop cursor from 0 to the length of hole:
                set offset to the cad difference of (the item at cursor in hole) and frame's origin
                append (a cad vector2 with x (the cad dot of offset and frame's xAxis) and y (the cad dot of offset and frame's yAxis)) to flatHole
                append (the item at cursor in hole) to lifted
            if (the length of flatHole) >= 3:
                append flatHole to flatHoles
        set flatAll to an empty list of a cad vector2
        loop cursor from 0 to the length of flatOuter:
            append (the item at cursor in flatOuter) to flatAll
        loop holeCursor from 0 to the length of flatHoles:
            set flatHole to the item at holeCursor in flatHoles
            loop cursor from 0 to the length of flatHole:
                append (the item at cursor in flatHole) to flatAll
        set mesh to the cad triangulation of flatOuter with holes flatHoles
        # Each point of the triangulation back to the 3D point it came from
        # (the nearest given point).
        set liftedPoints to an empty list of a cad vector3
        loop cursor from 0 to the length of (the points of mesh):
            set flatPoint to the item at cursor in (the points of mesh)
            set best to 0
            set bestDistance to 1.0e300
            loop candidate from 0 to the length of flatAll:
                set distance to the cad distance from flatPoint to (the item at candidate in flatAll)
                if distance < bestDistance:
                    set bestDistance to distance
                    set best to candidate
            if bestDistance < 1e-9:
                append (the item at best in lifted) to liftedPoints
            else:
                append (the bim ifc placed (a cad vector3 with x flatPoint's x, y flatPoint's y and z 0.0) through frame) to liftedPoints
        loop cursor from 0 to the length of (the triangles of mesh):
            set face to the item at cursor in (the triangles of mesh)
            add bim ifc triangle (the item at (the first of face) in liftedPoints) (the item at (the second of face) in liftedPoints) (the item at (the third of face) in liftedPoints) to shape
        free cad triangulation mesh
        free liftedPoints
        free flatAll
        free flatOuter
        free lifted
        loop holeCursor from 0 to the length of flatHoles:
            free (the item at holeCursor in flatHoles)
        free flatHoles

# Appends the triangles of `source` through `frame` to `target`.
local function add bim ifc mesh {fast mesh record:source} through {bim ifc frame record:frame} to {a pointer to a fast mesh record:target}:
    execute:
        set corners to source's triangles's values
        set cursor to 0
        loop while (cursor + 2) < (the length of corners):
            set first to the bim ifc placed (the item at (the item at cursor in corners) in (source's positions's values)) through frame
            set second to the bim ifc placed (the item at (the item at (cursor + 1) in corners) in (source's positions's values)) through frame
            set third to the bim ifc placed (the item at (the item at (cursor + 2) in corners) in (source's positions's values)) through frame
            add bim ifc triangle first second third to target
            set cursor to cursor + 3

# Appends each group of `source` through `frame` to the group of `target` in
# the same colour.
local function add bim ifc painted {bim ifc painted mesh record:source} through {bim ifc frame record:frame} to {a pointer to a bim ifc painted mesh record:target}:
    execute:
        loop cursor from 0 to the length of (source's colours):
            set colourGroup to the bim ifc group in (the item at cursor in (source's colours)) of target
            add bim ifc mesh (the item at cursor in (source's groups)) through frame to (the address of colourGroup)

# ---------------------------------------------------------------- curves

# The points of an arc from `first` through `middle` to `last` (3D), at most
# 10 degrees apart, `first` left out.
local function append bim ifc arc from {cad vector3:first} through {cad vector3:middle} to {cad vector3:last} into {a pointer to a list:points}:
    execute:
        set toMiddle to the cad difference of middle and first
        set toLast to the cad difference of last and first
        set normal to the cad cross of toMiddle and toLast
        set normalSquared to the cad dot of normal and normal
        if normalSquared < 1e-24:
            append last to points
            return nothing
        # The circle's centre: first + (|b|^2 (c x n) ... ) for b, c from first.
        set termOne to (the cad cross of normal and toMiddle) scaled by (the cad dot of toLast and toLast)
        set termTwo to (the cad cross of toLast and normal) scaled by (the cad dot of toMiddle and toMiddle)
        set centre to the cad sum of first and ((the cad sum of termOne and termTwo) scaled by (0.5 / normalSquared))
        set radiusVector to the cad difference of first and centre
        set radius to the cad length of radiusVector
        set axis to normal scaled by (1.0 / (the square root of normalSquared))
        set across to the cad cross of axis and radiusVector
        set endVector to the cad difference of last and centre
        set sweep to @intrinsic("atan2", (the cad dot of endVector and across) / (radius * radius), (the cad dot of endVector and radiusVector) / (radius * radius))
        if sweep <= 0.0:
            set sweep to sweep + 6.283185307179586
        set steps to (the ceiling of (sweep / 0.17453292519943295)) as an integer
        if steps < 2:
            set steps to 2
        loop step from 1 to steps + 1:
            set angle to (sweep * (step as a 64 bit floating-point number)) / (steps as a 64 bit floating-point number)
            append (the cad sum of centre and (the cad sum of (radiusVector scaled by (the cosine of angle)) and (across scaled by (the sine of angle)))) to points

# The points of a conic (circle or ellipse in its placement) from angle
# `fromAngle` to `toAngle` (radians), counterclockwise when `forward`.
local function append bim ifc conic {bim ifc frame record:frame} radii {a 64 bit floating-point number:radiusOne} and {a 64 bit floating-point number:radiusTwo} from {a 64 bit floating-point number:fromAngle} to {a 64 bit floating-point number:toAngle} forward {boolean:goesForward} into {a pointer to a list:points}:
    execute:
        set sweep to toAngle - fromAngle
        if goesForward:
            loop while sweep <= 0.0:
                set sweep to sweep + 6.283185307179586
        else:
            loop while sweep >= 0.0:
                set sweep to sweep - 6.283185307179586
        set steps to (the ceiling of ((the absolute value of sweep) / 0.17453292519943295)) as an integer
        if steps < 2:
            set steps to 2
        loop step from 0 to steps + 1:
            set angle to fromAngle + ((sweep * (step as a 64 bit floating-point number)) / (steps as a 64 bit floating-point number))
            append (the bim ifc placed (a cad vector3 with x (radiusOne * (the cosine of angle)), y (radiusTwo * (the sine of angle)) and z 0.0) through frame) to points

local function append bim ifc vertex {cad vector3:newVertex} to {a pointer to a list:points}:
    execute:
        set count to the length of points
        if count > 0:
            if (the cad distance from (the item at (count - 1) in points) to newVertex) < 1e-9:
                return nothing
        append newVertex to points

# The points of curve `curveId` in order (2D curves at z 0), in metres.
function the bim ifc polyline of {integer:curveId} in {a pointer to a bim ifc reader record:reader}:
    execute:
        set points to an empty list of a cad vector3
        if (bim step file (reader's stepFile) holds curveId) = false:
            return points
        set curveValue to the bim step instance curveId in (reader's stepFile)
        set typeName to curveValue's typeName
        if typeName = (the string form of "IFCPOLYLINE"):
            set pointRefs to the bim step argument 0 of curveValue
            loop cursor from 0 to the bim step count of pointRefs in curveValue:
                append bim ifc vertex (the bim ifc coordinates of (the bim step reference of (the bim step member cursor of pointRefs in curveValue) in curveValue) in reader) to points
        else if typeName = (the string form of "IFCINDEXEDPOLYCURVE"):
            set pool to the bim ifc coordinate list (the bim step reference of (the bim step argument 0 of curveValue) in curveValue) in reader
            set segments to the bim step argument 1 of curveValue
            set segmentCount to the bim step count of segments in curveValue
            if segmentCount = 0:
                loop cursor from 0 to the length of pool:
                    append bim ifc vertex (the item at cursor in pool) to points
            loop segmentCursor from 0 to segmentCount:
                set segment to the bim step member segmentCursor of segments in curveValue
                set segmentName to the bim step type name of segment in curveValue
                set segmentNode to the item at segment in (curveValue's nodes)
                set indices to the item at segmentNode's first in (curveValue's members)
                set indexCount to the bim step count of indices in curveValue
                if (segmentName = (the string form of "IFCARCINDEX")) and (indexCount = 3):
                    set firstIndex to ((the bim step number of (the bim step member 0 of indices in curveValue) in curveValue) as an integer) - 1
                    set middleIndex to ((the bim step number of (the bim step member 1 of indices in curveValue) in curveValue) as an integer) - 1
                    set lastIndex to ((the bim step number of (the bim step member 2 of indices in curveValue) in curveValue) as an integer) - 1
                    if ((firstIndex >= 0) and (lastIndex < (the length of pool))) and ((middleIndex >= 0) and (middleIndex < (the length of pool))):
                        append bim ifc vertex (the item at firstIndex in pool) to points
                        append bim ifc arc from (the item at firstIndex in pool) through (the item at middleIndex in pool) to (the item at lastIndex in pool) into points
                else:
                    loop cursor from 0 to indexCount:
                        set pointIndex to ((the bim step number of (the bim step member cursor of indices in curveValue) in curveValue) as an integer) - 1
                        if (pointIndex >= 0) and (pointIndex < (the length of pool)):
                            append bim ifc vertex (the item at pointIndex in pool) to points
            free pool
        else if ((typeName = (the string form of "IFCCOMPOSITECURVE")) or (typeName = (the string form of "IFCCOMPOSITECURVEONSURFACE"))):
            set segments to the bim step argument 0 of curveValue
            loop segmentCursor from 0 to the bim step count of segments in curveValue:
                set segmentValue to the bim step instance (the bim step reference of (the bim step member segmentCursor of segments in curveValue) in curveValue) in (reader's stepFile)
                set sameSense to (the bim step raw text of (the bim step argument 1 of segmentValue) in segmentValue) != (the string form of "F")
                set parentPoints to the bim ifc polyline of (the bim step reference of (the bim step argument 2 of segmentValue) in segmentValue) in reader
                free bim step instance segmentValue
                if sameSense:
                    loop cursor from 0 to the length of parentPoints:
                        append bim ifc vertex (the item at cursor in parentPoints) to points
                else:
                    set cursor to (the length of parentPoints) - 1
                    loop while cursor >= 0:
                        append bim ifc vertex (the item at cursor in parentPoints) to points
                        set cursor to cursor - 1
                free parentPoints
        else if typeName = (the string form of "IFCTRIMMEDCURVE"):
            append bim ifc trimmed curve curveValue to points in reader
        else if ((typeName = (the string form of "IFCCIRCLE")) or (typeName = (the string form of "IFCELLIPSE"))):
            set frame to the bim ifc placement axes (the bim step reference of (the bim step argument 0 of curveValue) in curveValue) in reader
            set radiusOne to (the bim step number of (the bim step argument 1 of curveValue) in curveValue) * reader's lengthScale
            set radiusTwo to radiusOne
            if typeName = (the string form of "IFCELLIPSE"):
                set radiusTwo to (the bim step number of (the bim step argument 2 of curveValue) in curveValue) * reader's lengthScale
            append bim ifc conic frame radii radiusOne and radiusTwo from 0.0 to 6.283185307179586 forward true into points
            # A whole conic is closed by its first point; drop the repeat.
            if (the length of points) > 1:
                remove item ((the length of points) - 1) from points
        else:
            note bim ifc skipped typeName in reader
        free bim step instance curveValue
        return points

# The points of an IfcCartesianPointList2D or 3D, in metres.
local function the bim ifc coordinate list {integer:listId} in {a pointer to a bim ifc reader record:reader}:
    execute:
        set pool to an empty list of a cad vector3
        if (bim step file (reader's stepFile) holds listId) = false:
            return pool
        set listValue to the bim step instance listId in (reader's stepFile)
        set coordinates to the bim step argument 0 of listValue
        set scale to reader's lengthScale
        loop cursor from 0 to the bim step count of coordinates in listValue:
            set entry to the bim step member cursor of coordinates in listValue
            append (a cad vector3 with x ((the bim step number of (the bim step member 0 of entry in listValue) in listValue) * scale), y ((the bim step number of (the bim step member 1 of entry in listValue) in listValue) * scale) and z ((the bim step number of (the bim step member 2 of entry in listValue) in listValue) * scale)) to pool
        free bim step instance listValue
        return pool

# An IfcTrimmedCurve: its basis line, circle or ellipse between its trims,
# taken as cartesian points when given, else as parameters.
local function append bim ifc trimmed curve {bim step instance record:curveValue} to {a pointer to a list:points} in {a pointer to a bim ifc reader record:reader}:
    execute:
        set basisId to the bim step reference of (the bim step argument 0 of curveValue) in curveValue
        set senseAgrees to (the bim step raw text of (the bim step argument 3 of curveValue) in curveValue) != (the string form of "F")
        set basisValue to the bim step instance basisId in (reader's stepFile)
        set basisName to basisValue's typeName
        set trimOne to the bim step argument 1 of curveValue
        set trimTwo to the bim step argument 2 of curveValue
        set startPoint to a cad vector3 with x 0.0, y 0.0 and z 0.0
        set endPoint to startPoint
        set startParameter to 0.0
        set endParameter to 0.0
        set hasStartPoint to false
        set hasEndPoint to false
        set hasStartParameter to false
        set hasEndParameter to false
        loop side from 0 to 2:
            set trim to trimOne
            if side = 1:
                set trim to trimTwo
            loop cursor from 0 to the bim step count of trim in curveValue:
                set trimEntry to the bim step member cursor of trim in curveValue
                set memberKind to the bim step kind of trimEntry in curveValue
                if memberKind = bim step reference:
                    set trimPoint to the bim ifc coordinates of (the bim step reference of trimEntry in curveValue) in reader
                    if side = 0:
                        set startPoint to trimPoint
                        set hasStartPoint to true
                    else:
                        set endPoint to trimPoint
                        set hasEndPoint to true
                else if memberKind = bim step typed:
                    if side = 0:
                        set startParameter to the bim step number of trimEntry in curveValue
                        set hasStartParameter to true
                    else:
                        set endParameter to the bim step number of trimEntry in curveValue
                        set hasEndParameter to true
        if basisName = (the string form of "IFCLINE"):
            set origin to the bim ifc coordinates of (the bim step reference of (the bim step argument 0 of basisValue) in basisValue) in reader
            set vectorValue to the bim step instance (the bim step reference of (the bim step argument 1 of basisValue) in basisValue) in (reader's stepFile)
            set direction to the bim ifc ratios (the bim step reference of (the bim step argument 0 of vectorValue) in vectorValue) or (a cad vector3 with x 1.0, y 0.0 and z 0.0) in reader
            set magnitude to (the bim step number of (the bim step argument 1 of vectorValue) in vectorValue) * reader's lengthScale
            free bim step instance vectorValue
            set stride to (the bim ifc unit of direction or (a cad vector3 with x 1.0, y 0.0 and z 0.0)) scaled by magnitude
            if hasStartPoint = false:
                set startPoint to the cad sum of origin and (stride scaled by startParameter)
            if hasEndPoint = false:
                set endPoint to the cad sum of origin and (stride scaled by endParameter)
            append bim ifc vertex startPoint to points
            append bim ifc vertex endPoint to points
        else if (basisName = (the string form of "IFCCIRCLE")) or (basisName = (the string form of "IFCELLIPSE")):
            set frame to the bim ifc placement axes (the bim step reference of (the bim step argument 0 of basisValue) in basisValue) in reader
            set radiusOne to (the bim step number of (the bim step argument 1 of basisValue) in basisValue) * reader's lengthScale
            set radiusTwo to radiusOne
            if basisName = (the string form of "IFCELLIPSE"):
                set radiusTwo to (the bim step number of (the bim step argument 2 of basisValue) in basisValue) * reader's lengthScale
            set fromAngle to startParameter * reader's angleScale
            set toAngle to endParameter * reader's angleScale
            if hasStartPoint:
                set offset to the cad difference of startPoint and frame's origin
                set fromAngle to @intrinsic("atan2", ((the cad dot of offset and frame's yAxis) / radiusTwo), ((the cad dot of offset and frame's xAxis) / radiusOne))
            if hasEndPoint:
                set offset to the cad difference of endPoint and frame's origin
                set toAngle to @intrinsic("atan2", ((the cad dot of offset and frame's yAxis) / radiusTwo), ((the cad dot of offset and frame's xAxis) / radiusOne))
            set conicPoints to an empty list of a cad vector3
            append bim ifc conic frame radii radiusOne and radiusTwo from fromAngle to toAngle forward senseAgrees into conicPoints
            loop cursor from 0 to the length of conicPoints:
                append bim ifc vertex (the item at cursor in conicPoints) to points
            free conicPoints
        else:
            set basisPoints to the bim ifc polyline of basisId in reader
            loop cursor from 0 to the length of basisPoints:
                append bim ifc vertex (the item at cursor in basisPoints) to points
            free basisPoints
        free bim step instance basisValue

# ---------------------------------------------------------------- profiles

local function the bim ifc ring of {a pointer to a list:points}:
    execute:
        set flatOutline to an empty list of a cad vector2
        loop cursor from 0 to the length of points:
            set point to the item at cursor in points
            append (a cad vector2 with x point's x and y point's y) to flatOutline
        # A closed curve repeats its first point at its end.
        set count to the length of flatOutline
        if count > 1:
            if (the cad distance from (the item at 0 in flatOutline) to (the item at (count - 1) in flatOutline)) < 1e-9:
                remove item (count - 1) from flatOutline
        return flatOutline

local function the bim ifc rings of box {a 64 bit floating-point number:width} by {a 64 bit floating-point number:height} through {bim ifc frame record:frame}:
    execute:
        set ring to an empty list of a cad vector2
        set halfWidth to width * 0.5
        set halfHeight to height * 0.5
        append (the bim ifc flat (0.0 - halfWidth) (0.0 - halfHeight) through frame) to ring
        append (the bim ifc flat halfWidth (0.0 - halfHeight) through frame) to ring
        append (the bim ifc flat halfWidth halfHeight through frame) to ring
        append (the bim ifc flat (0.0 - halfWidth) halfHeight through frame) to ring
        return ring

local function the bim ifc flat {a 64 bit floating-point number:x} {a 64 bit floating-point number:y} through {bim ifc frame record:frame}:
    execute:
        set placedSpot to the bim ifc placed (a cad vector3 with x x, y y and z 0.0) through frame
        return a cad vector2 with x placedSpot's x and y placedSpot's y

local function the bim ifc ellipse ring {a 64 bit floating-point number:radiusOne} by {a 64 bit floating-point number:radiusTwo} through {bim ifc frame record:frame}:
    execute:
        set ellipseOutline to an empty list of a cad vector2
        loop step from 0 to 24:
            set angle to (6.283185307179586 * (step as a 64 bit floating-point number)) / 24.0
            append (the bim ifc flat (radiusOne * (the cosine of angle)) (radiusTwo * (the sine of angle)) through frame) to ellipseOutline
        return ellipseOutline

# The outline of a parametric profile shape given by its corners (in
# order, as x and y pairs) through `frame`.
local function the bim ifc polygon ring {a pointer to a list:corners} through {bim ifc frame record:frame}:
    execute:
        set cornerOutline to an empty list of a cad vector2
        set cursor to 0
        loop while (cursor + 1) < (the length of corners):
            append (the bim ifc flat (the item at cursor in corners) (the item at (cursor + 1) in corners) through frame) to cornerOutline
            set cursor to cursor + 2
        return cornerOutline

# The rings of profile `profileId` (2D, metres): the outer ring first, then
# its holes. A composite profile gives several outer rings; `outerFlags`
# marks which rings are outer.
function append bim ifc profile {integer:profileId} outlines into {a pointer to a list:ringList} marking {a pointer to a list:outerFlags} through {bim ifc frame record:profileFrame} in {a pointer to a bim ifc reader record:reader}:
    execute:
        if (bim step file (reader's stepFile) holds profileId) = false:
            return nothing
        set profileValue to the bim step instance profileId in (reader's stepFile)
        set typeName to profileValue's typeName
        set scale to reader's lengthScale
        if ((typeName = (the string form of "IFCARBITRARYCLOSEDPROFILEDEF")) or (typeName = (the string form of "IFCARBITRARYPROFILEDEFWITHVOIDS"))):
            set outerPoints to the bim ifc polyline of (the bim step reference of (the bim step argument 2 of profileValue) in profileValue) in reader
            set outerRing to the bim ifc ring of outerPoints
            free outerPoints
            append (the bim ifc ring outerRing through profileFrame) to ringList
            append true to outerFlags
            free outerRing
            if typeName = (the string form of "IFCARBITRARYPROFILEDEFWITHVOIDS"):
                set inner to the bim step argument 3 of profileValue
                loop cursor from 0 to the bim step count of inner in profileValue:
                    set innerPoints to the bim ifc polyline of (the bim step reference of (the bim step member cursor of inner in profileValue) in profileValue) in reader
                    set innerRing to the bim ifc ring of innerPoints
                    free innerPoints
                    append (the bim ifc ring innerRing through profileFrame) to ringList
                    append false to outerFlags
                    free innerRing
        else if typeName = (the string form of "IFCDERIVEDPROFILEDEF"):
            set operatorFrame to the bim ifc operator axes (the bim step reference of (the bim step argument 3 of profileValue) in profileValue) in reader
            append bim ifc profile (the bim step reference of (the bim step argument 2 of profileValue) in profileValue) outlines into ringList marking outerFlags through (the bim ifc axes operatorFrame within profileFrame) in reader
        else if typeName = (the string form of "IFCCOMPOSITEPROFILEDEF"):
            set parts to the bim step argument 2 of profileValue
            loop cursor from 0 to the bim step count of parts in profileValue:
                append bim ifc profile (the bim step reference of (the bim step member cursor of parts in profileValue) in profileValue) outlines into ringList marking outerFlags through profileFrame in reader
        else:
            # Parametric profiles: their position, then their dimensions.
            set frame to the bim ifc axes (the bim ifc placement axes (the bim step reference of (the bim step argument 2 of profileValue) in profileValue) in reader) within profileFrame
            set first to (the bim step number of (the bim step argument 3 of profileValue) in profileValue) * scale
            set second to (the bim step number of (the bim step argument 4 of profileValue) in profileValue) * scale
            set third to (the bim step number of (the bim step argument 5 of profileValue) in profileValue) * scale
            set fourth to (the bim step number of (the bim step argument 6 of profileValue) in profileValue) * scale
            set corners to an empty list of a 64 bit floating-point number
            if ((typeName = (the string form of "IFCRECTANGLEPROFILEDEF")) or (typeName = (the string form of "IFCROUNDEDRECTANGLEPROFILEDEF"))):
                append (the bim ifc rings of box first by second through frame) to ringList
                append true to outerFlags
            else if typeName = (the string form of "IFCRECTANGLEHOLLOWPROFILEDEF"):
                append (the bim ifc rings of box first by second through frame) to ringList
                append true to outerFlags
                append (the bim ifc rings of box (first - (2.0 * third)) by (second - (2.0 * third)) through frame) to ringList
                append false to outerFlags
            else if typeName = (the string form of "IFCCIRCLEPROFILEDEF"):
                append (the bim ifc ellipse ring first by first through frame) to ringList
                append true to outerFlags
            else if typeName = (the string form of "IFCCIRCLEHOLLOWPROFILEDEF"):
                append (the bim ifc ellipse ring first by first through frame) to ringList
                append true to outerFlags
                append (the bim ifc ellipse ring (first - second) by (first - second) through frame) to ringList
                append false to outerFlags
            else if typeName = (the string form of "IFCELLIPSEPROFILEDEF"):
                append (the bim ifc ellipse ring first by second through frame) to ringList
                append true to outerFlags
            else if ((typeName = (the string form of "IFCISHAPEPROFILEDEF")) or (typeName = (the string form of "IFCASYMMETRICISHAPEPROFILEDEF"))):
                # Width, depth, web and flange thickness.
                set halfWidth to first * 0.5
                set halfDepth to second * 0.5
                set halfWeb to third * 0.5
                set flange to fourth
                append bim ifc corners (0.0 - halfWidth) (0.0 - halfDepth) halfWidth (0.0 - halfDepth) halfWidth ((0.0 - halfDepth) + flange) halfWeb ((0.0 - halfDepth) + flange) to corners
                append bim ifc corners halfWeb (halfDepth - flange) halfWidth (halfDepth - flange) halfWidth halfDepth (0.0 - halfWidth) halfDepth to corners
                append bim ifc corners (0.0 - halfWidth) (halfDepth - flange) (0.0 - halfWeb) (halfDepth - flange) (0.0 - halfWeb) ((0.0 - halfDepth) + flange) (0.0 - halfWidth) ((0.0 - halfDepth) + flange) to corners
            else if typeName = (the string form of "IFCLSHAPEPROFILEDEF"):
                # Depth, width, thickness: the corner at the origin side.
                set halfDepth to first * 0.5
                set halfWidth to second * 0.5
                if second <= 0.0:
                    set halfWidth to halfDepth
                append bim ifc corners (0.0 - halfWidth) (0.0 - halfDepth) halfWidth (0.0 - halfDepth) halfWidth ((0.0 - halfDepth) + third) ((0.0 - halfWidth) + third) ((0.0 - halfDepth) + third) to corners
                append bim ifc corners ((0.0 - halfWidth) + third) halfDepth (0.0 - halfWidth) halfDepth to corners
            else if typeName = (the string form of "IFCUSHAPEPROFILEDEF"):
                # Depth, flange width, web and flange thickness.
                set halfDepth to first * 0.5
                set halfWidth to second * 0.5
                append bim ifc corners (0.0 - halfWidth) (0.0 - halfDepth) halfWidth (0.0 - halfDepth) halfWidth ((0.0 - halfDepth) + fourth) ((0.0 - halfWidth) + third) ((0.0 - halfDepth) + fourth) to corners
                append bim ifc corners ((0.0 - halfWidth) + third) (halfDepth - fourth) halfWidth (halfDepth - fourth) halfWidth halfDepth (0.0 - halfWidth) halfDepth to corners
            else if typeName = (the string form of "IFCTSHAPEPROFILEDEF"):
                # Depth, flange width, web and flange thickness.
                set halfDepth to first * 0.5
                set halfWidth to second * 0.5
                set halfWeb to third * 0.5
                append bim ifc corners (0.0 - halfWeb) (0.0 - halfDepth) halfWeb (0.0 - halfDepth) halfWeb (halfDepth - fourth) halfWidth (halfDepth - fourth) to corners
                append bim ifc corners halfWidth halfDepth (0.0 - halfWidth) halfDepth (0.0 - halfWidth) (halfDepth - fourth) (0.0 - halfWeb) (halfDepth - fourth) to corners
            else if typeName = (the string form of "IFCCSHAPEPROFILEDEF"):
                # Depth, width, wall thickness, girth.
                set halfDepth to first * 0.5
                set halfWidth to second * 0.5
                set wall to third
                set lip to fourth
                append bim ifc corners halfWidth ((0.0 - halfDepth) + lip) halfWidth (0.0 - halfDepth) (0.0 - halfWidth) (0.0 - halfDepth) (0.0 - halfWidth) halfDepth to corners
                append bim ifc corners halfWidth halfDepth halfWidth (halfDepth - lip) (halfWidth - wall) (halfDepth - lip) (halfWidth - wall) (halfDepth - wall) to corners
                append bim ifc corners ((0.0 - halfWidth) + wall) (halfDepth - wall) ((0.0 - halfWidth) + wall) ((0.0 - halfDepth) + wall) (halfWidth - wall) ((0.0 - halfDepth) + wall) (halfWidth - wall) ((0.0 - halfDepth) + lip) to corners
            else:
                note bim ifc skipped typeName in reader
            if (the length of corners) >= 6:
                append (the bim ifc polygon ring corners through frame) to ringList
                append true to outerFlags
            free corners
        free bim step instance profileValue

local function append bim ifc corners {a 64 bit floating-point number:x1} {a 64 bit floating-point number:y1} {a 64 bit floating-point number:x2} {a 64 bit floating-point number:y2} to {a pointer to a list:cornerList}:
    execute:
        append x1 to cornerList
        append y1 to cornerList
        append x2 to cornerList
        append y2 to cornerList

local function append bim ifc corners {a 64 bit floating-point number:x1} {a 64 bit floating-point number:y1} {a 64 bit floating-point number:x2} {a 64 bit floating-point number:y2} {a 64 bit floating-point number:x3} {a 64 bit floating-point number:y3} {a 64 bit floating-point number:x4} {a 64 bit floating-point number:y4} to {a pointer to a list:cornerList}:
    execute:
        append bim ifc corners x1 y1 x2 y2 to cornerList
        append bim ifc corners x3 y3 x4 y4 to cornerList

local function the bim ifc ring {a pointer to a list:flatRing} through {bim ifc frame record:frame}:
    execute:
        set placedRing to an empty list of a cad vector2
        loop cursor from 0 to the length of flatRing:
            set ringPoint to the item at cursor in flatRing
            append (the bim ifc flat ringPoint's x ringPoint's y through frame) to placedRing
        return placedRing

# The frame of an IfcCartesianTransformationOperator (2D or 3D, uniform or
# not): its origin and axes scaled.
function the bim ifc operator axes {integer:operatorId} in {a pointer to a bim ifc reader record:reader}:
    execute:
        if (bim step file (reader's stepFile) holds operatorId) = false:
            return the bim ifc identity axes
        set operatorValue to the bim step instance operatorId in (reader's stepFile)
        set typeName to operatorValue's typeName
        set xDirection to the bim ifc ratios (the bim step reference of (the bim step argument 0 of operatorValue) in operatorValue) or (a cad vector3 with x 1.0, y 0.0 and z 0.0) in reader
        set yDirection to the bim ifc ratios (the bim step reference of (the bim step argument 1 of operatorValue) in operatorValue) or (a cad vector3 with x 0.0, y 1.0 and z 0.0) in reader
        set origin to the bim ifc coordinates of (the bim step reference of (the bim step argument 2 of operatorValue) in operatorValue) in reader
        set scale to 1.0
        if (the bim step kind of (the bim step argument 3 of operatorValue) in operatorValue) != bim step unset:
            set scale to the bim step number of (the bim step argument 3 of operatorValue) in operatorValue
        set zDirection to a cad vector3 with x 0.0, y 0.0 and z 1.0
        set scaleTwo to scale
        set scaleThree to scale
        if ((typeName = (the string form of "IFCCARTESIANTRANSFORMATIONOPERATOR3D")) or (typeName = (the string form of "IFCCARTESIANTRANSFORMATIONOPERATOR3DNONUNIFORM"))):
            set zDirection to the bim ifc ratios (the bim step reference of (the bim step argument 4 of operatorValue) in operatorValue) or (the cad cross of xDirection and yDirection) in reader
            if typeName = (the string form of "IFCCARTESIANTRANSFORMATIONOPERATOR3DNONUNIFORM"):
                if (the bim step kind of (the bim step argument 5 of operatorValue) in operatorValue) != bim step unset:
                    set scaleTwo to the bim step number of (the bim step argument 5 of operatorValue) in operatorValue
                if (the bim step kind of (the bim step argument 6 of operatorValue) in operatorValue) != bim step unset:
                    set scaleThree to the bim step number of (the bim step argument 6 of operatorValue) in operatorValue
        else if typeName = (the string form of "IFCCARTESIANTRANSFORMATIONOPERATOR2DNONUNIFORM"):
            if (the bim step kind of (the bim step argument 4 of operatorValue) in operatorValue) != bim step unset:
                set scaleTwo to the bim step number of (the bim step argument 4 of operatorValue) in operatorValue
        free bim step instance operatorValue
        # The base axes: z, then x square to it, then y.
        set zUnit to the bim ifc unit of zDirection or (a cad vector3 with x 0.0, y 0.0 and z 1.0)
        set square to the bim ifc axes at origin along zUnit and xDirection
        set yUnit to square's yAxis
        if (the cad dot of yUnit and yDirection) < 0.0:
            set yUnit to yUnit scaled by -1.0
        return @intrinsic("construct", a bim ifc frame record, origin, square's xAxis scaled by scale, yUnit scaled by scaleTwo, zUnit scaled by scaleThree)

# ---------------------------------------------------------------- solids

# Appends the prism of `rings` (outer rings marked in `outerFlags`, each with
# the holes that follow it) swept along `direction` by `depth`, through
# `frame`.
local function add bim ifc prism of {a pointer to a list:rings} marking {a pointer to a list:outerFlags} along {cad vector3:direction} by {a 64 bit floating-point number:depth} through {bim ifc frame record:frame} to {a pointer to a fast mesh record:shape}:
    execute:
        set unitDirection to the bim ifc unit of direction or (a cad vector3 with x 0.0, y 0.0 and z 1.0)
        set offset to unitDirection scaled by depth
        set flip to (unitDirection's z * depth) < 0.0
        set cursor to 0
        loop while cursor < (the length of rings):
            set outerRing to the item at cursor in rings
            set holes to an empty list of the type of (an empty list of a cad vector2)
            set following to cursor + 1
            set gathering to following < (the length of rings)
            loop while gathering:
                if (the item at following in outerFlags) = false:
                    append (the item at following in rings) to holes
                    set following to following + 1
                    set gathering to following < (the length of rings)
                else:
                    set gathering to false
            set outerBottom to an empty list of a cad vector3
            set outerTop to an empty list of a cad vector3
            set counterclockwise to (the bim ifc signed area of outerRing) > 0.0
            append bim ifc ring outerRing counterclockwise (counterclockwise != flip) lifted by offset through frame into outerBottom and outerTop
            set holeBottoms to an empty list of the type of (an empty list of a cad vector3)
            set holeTops to an empty list of the type of (an empty list of a cad vector3)
            loop holeCursor from 0 to the length of holes:
                set hole to the item at holeCursor in holes
                set holeBottom to an empty list of a cad vector3
                set holeTop to an empty list of a cad vector3
                set holeCounter to (the bim ifc signed area of hole) > 0.0
                append bim ifc ring hole counterclockwise (holeCounter = flip) lifted by offset through frame into holeBottom and holeTop
                append holeBottom to holeBottoms
                append holeTop to holeTops
            # The bottom faces down, the top up, each side outward.
            set reversedBottom to the bim ifc reversed outerBottom
            add bim ifc facet reversedBottom with voids holeBottoms to shape
            add bim ifc facet outerTop with voids holeTops to shape
            free reversedBottom
            add bim ifc sides of outerBottom and outerTop to shape
            loop holeCursor from 0 to the length of holeBottoms:
                add bim ifc sides of (the item at holeCursor in holeBottoms) and (the item at holeCursor in holeTops) to shape
                free (the item at holeCursor in holeBottoms)
                free (the item at holeCursor in holeTops)
            free holeBottoms
            free holeTops
            free outerBottom
            free outerTop
            free holes
            set cursor to following

local function the bim ifc signed area of {a pointer to a list:ring}:
    execute:
        set total to 0.0
        set count to the length of ring
        loop cursor from 0 to count:
            set here to the item at cursor in ring
            set after to the item at (the remainder of (cursor + 1) divided by count) in ring
            set total to total + ((here's x * after's y) - (after's x * here's y))
        return total * 0.5

local function the bim ifc reversed {a pointer to a list:points}:
    execute:
        set backwards to an empty list of a cad vector3
        set cursor to (the length of points) - 1
        loop while cursor >= 0:
            append (the item at cursor in points) to backwards
            set cursor to cursor - 1
        return backwards

# The ring's points at the bottom and lifted by `offset` at the top, through
# `frame`, in its order when `keepOrder`, else reversed.
local function append bim ifc ring {a pointer to a list:sourceRing} counterclockwise {boolean:keepOrder} lifted by {cad vector3:offset} through {bim ifc frame record:frame} into {a pointer to a list:bottoms} and {a pointer to a list:tops}:
    execute:
        set count to the length of sourceRing
        loop step from 0 to count:
            set cursor to step
            if keepOrder = false:
                set cursor to (count - 1) - step
            set point to the item at cursor in sourceRing
            set local to a cad vector3 with x point's x, y point's y and z 0.0
            append (the bim ifc placed local through frame) to bottoms
            append (the bim ifc placed (the cad sum of local and offset) through frame) to tops

local function add bim ifc sides of {a pointer to a list:bottoms} and {a pointer to a list:tops} to {a pointer to a fast mesh record:shape}:
    execute:
        set count to the length of bottoms
        loop cursor from 0 to count:
            set after to the remainder of (cursor + 1) divided by count
            add bim ifc triangle (the item at cursor in bottoms) (the item at after in bottoms) (the item at after in tops) to shape
            add bim ifc triangle (the item at cursor in bottoms) (the item at after in tops) (the item at cursor in tops) to shape

# A tube of `radius` along `points` (eight sides), its frames carried along
# the path without twisting.
local function add bim ifc tube along {a pointer to a list:points} sized {a 64 bit floating-point number:tubeRadius} to {a pointer to a fast mesh record:shape}:
    execute:
        set count to the length of points
        if (count < 2) or (tubeRadius <= 0.0):
            return nothing
        set sides to 8
        set firstTangent to the bim ifc unit of (the cad difference of (the item at 1 in points) and (the item at 0 in points)) or (a cad vector3 with x 0.0, y 0.0 and z 1.0)
        set startFrame to the bim ifc axes at (the item at 0 in points) along firstTangent and (a cad vector3 with x 1.0, y 0.0 and z 0.0)
        set across to startFrame's xAxis
        set previousRing to an empty list of a cad vector3
        loop cursor from 0 to count:
            set here to the item at cursor in points
            set tangent to firstTangent
            if cursor = 0:
                set tangent to firstTangent
            else if cursor = (count - 1):
                set tangent to the bim ifc unit of (the cad difference of here and (the item at (cursor - 1) in points)) or firstTangent
            else:
                set incoming to the bim ifc unit of (the cad difference of here and (the item at (cursor - 1) in points)) or firstTangent
                set outgoing to the bim ifc unit of (the cad difference of (the item at (cursor + 1) in points) and here) or incoming
                set tangent to the bim ifc unit of (the cad sum of incoming and outgoing) or incoming
            # Across kept square to the tangent (a rotation-minimising frame).
            set across to the bim ifc unit of (the cad difference of across and (tangent scaled by (the cad dot of across and tangent))) or startFrame's xAxis
            set upward to the cad cross of tangent and across
            set ring to an empty list of a cad vector3
            loop side from 0 to sides:
                set angle to (6.283185307179586 * (side as a 64 bit floating-point number)) / (sides as a 64 bit floating-point number)
                append (the cad sum of here and (the cad sum of (across scaled by (tubeRadius * (the cosine of angle))) and (upward scaled by (tubeRadius * (the sine of angle))))) to ring
            if cursor > 0:
                loop side from 0 to sides:
                    set after to the remainder of (side + 1) divided by sides
                    add bim ifc triangle (the item at side in previousRing) (the item at after in previousRing) (the item at after in ring) to shape
                    add bim ifc triangle (the item at side in previousRing) (the item at after in ring) (the item at side in ring) to shape
            else:
                set reversedCap to the bim ifc reversed ring
                set noHoles to an empty list of the type of (an empty list of a cad vector3)
                add bim ifc facet reversedCap with voids noHoles to shape
                free reversedCap
                free noHoles
            free previousRing
            set previousRing to ring
        set noHoles to an empty list of the type of (an empty list of a cad vector3)
        add bim ifc facet previousRing with voids noHoles to shape
        free noHoles
        free previousRing

# Keeps of `shape` what lies on the kept side of the plane through `point`
# with normal `normal` (the side the normal points away from is removed),
# triangles crossing it cut; when `bounded`, only what also lies over
# `boundary` (a 2D outline in `boundaryFrame`) is removed.
local function clip bim ifc mesh {a pointer to a fast mesh record:shape} by plane at {cad vector3:point} facing {cad vector3:normal} bounded {boolean:isBounded} by {a pointer to a list:boundary} in {bim ifc frame record:boundaryFrame}:
    execute:
        set kept to an empty fast mesh
        # Where triangles cross the plane: one segment each, for the cap.
        set crossings to an empty list of a cad vector3
        set corners to shape's triangles's values
        set cursor to 0
        loop while (cursor + 2) < (the length of corners):
            set faceCorners to an empty list of a cad vector3
            append (the item at (the item at cursor in corners) in (shape's positions's values)) to faceCorners
            append (the item at (the item at (cursor + 1) in corners) in (shape's positions's values)) to faceCorners
            append (the item at (the item at (cursor + 2) in corners) in (shape's positions's values)) to faceCorners
            set inside to an empty list of a cad vector3
            set outside to an empty list of a cad vector3
            loop corner from 0 to 3:
                set here to the item at corner in faceCorners
                set after to the item at (the remainder of (corner + 1) divided by 3) in faceCorners
                set hereSide to the cad dot of (the cad difference of here and point) and normal
                set afterSide to the cad dot of (the cad difference of after and point) and normal
                if hereSide <= 0.0:
                    append here to inside
                else:
                    append here to outside
                if ((hereSide <= 0.0) and (afterSide > 0.0)) or ((hereSide > 0.0) and (afterSide <= 0.0)):
                    set share to hereSide / (hereSide - afterSide)
                    set crossing to the cad sum of here and ((the cad difference of after and here) scaled by share)
                    append crossing to inside
                    append crossing to outside
                    append crossing to crossings
            if (the length of inside) >= 3:
                loop fan from 1 to (the length of inside) - 1:
                    add bim ifc triangle (the item at 0 in inside) (the item at fan in inside) (the item at (fan + 1) in inside) to (the address of kept)
            if isBounded and ((the length of outside) >= 3):
                # The removed part survives where it lies off the boundary.
                set middle to the cad sum of (the item at 0 in outside) and (the cad sum of (the item at 1 in outside) and (the item at 2 in outside))
                set middle to middle scaled by (1.0 / 3.0)
                set offset to the cad difference of middle and boundaryFrame's origin
                set flatSpot to a cad vector2 with x ((the cad dot of offset and boundaryFrame's xAxis) / (the cad dot of boundaryFrame's xAxis and boundaryFrame's xAxis)) and y ((the cad dot of offset and boundaryFrame's yAxis) / (the cad dot of boundaryFrame's yAxis and boundaryFrame's yAxis))
                if (bim ifc spot flatSpot lies in boundary) = false:
                    loop fan from 1 to (the length of outside) - 1:
                        add bim ifc triangle (the item at 0 in outside) (the item at fan in outside) (the item at (fan + 1) in outside) to (the address of kept)
            free faceCorners
            free inside
            free outside
            set cursor to cursor + 3
        # The cut closed by a cap on the plane (an unbounded half space only):
        # the crossing segments joined into loops, filled, facing the removed
        # side.
        if isBounded = false:
            add bim ifc cap of crossings on plane at point facing normal to (the address of kept)
        free crossings
        # The mesh's lists count their owners: replacing them releases the
        # old ones.
        set shape's positions to kept's positions
        set shape's normals to kept's normals
        set shape's triangles to kept's triangles

# Fills the loops that the segments `segmentEnds` (two points each, on the
# plane through `point` with normal `normal`) close, as triangles facing
# along `normal`.
local function add bim ifc cap of {a pointer to a list:segmentEnds} on plane at {cad vector3:point} facing {cad vector3:normal} to {a pointer to a fast mesh record:shape}:
    execute:
        set segmentCount to (the length of segmentEnds) / 2
        if segmentCount < 3:
            return nothing
        set capAxes to the bim ifc turned axes of (the bim ifc axes at point along normal and (a cad vector3 with x 1.0, y 0.0 and z 0.0))
        set used to an empty list of a boolean
        loop cursor from 0 to segmentCount:
            append false to used
        set loops to an empty list of the type of (an empty list of a cad vector2)
        loop start from 0 to segmentCount:
            if (the item at start in used) = false:
                replace item at index start in used with true
                set loopPoints to an empty list of a cad vector3
                append (the item at (start * 2) in segmentEnds) to loopPoints
                set tail to the item at ((start * 2) + 1) in segmentEnds
                set growing to true
                loop while growing:
                    set growing to false
                    set best to -1
                    set bestFlip to false
                    loop candidate from 0 to segmentCount:
                        if (the item at candidate in used) = false:
                            if (the cad distance from (the item at (candidate * 2) in segmentEnds) to tail) < 1e-7:
                                set best to candidate
                                set bestFlip to false
                            else if (the cad distance from (the item at ((candidate * 2) + 1) in segmentEnds) to tail) < 1e-7:
                                set best to candidate
                                set bestFlip to true
                    if best >= 0:
                        replace item at index best in used with true
                        append tail to loopPoints
                        if bestFlip:
                            set tail to the item at (best * 2) in segmentEnds
                        else:
                            set tail to the item at ((best * 2) + 1) in segmentEnds
                        set growing to true
                if ((the length of loopPoints) >= 3) and ((the cad distance from tail to (the item at 0 in loopPoints)) < 1e-7):
                    set flatPoints to an empty list of a cad vector2
                    loop cursor from 0 to the length of loopPoints:
                        set offset to the cad difference of (the item at cursor in loopPoints) and capAxes's origin
                        append (a cad vector2 with x (the cad dot of offset and capAxes's xAxis) and y (the cad dot of offset and capAxes's yAxis)) to flatPoints
                    # A point where a straight edge of the cut was split (where
                    # a face's diagonal crossed the plane) lies on its
                    # neighbours' line only up to rounding, which can leave the
                    # ring a sliver the triangulation refuses: it is left out.
                    set flatLoop to an empty list of a cad vector2
                    set pointCount to the length of flatPoints
                    loop cursor from 0 to pointCount:
                        set before to the item at (the remainder of ((cursor + pointCount) - 1) divided by pointCount) in flatPoints
                        set here to the item at cursor in flatPoints
                        set after to the item at (the remainder of (cursor + 1) divided by pointCount) in flatPoints
                        set inX to here's x - before's x
                        set inY to here's y - before's y
                        set outX to after's x - here's x
                        set outY to after's y - here's y
                        set bend to (inX * outY) - (inY * outX)
                        set reach to (the square root of ((inX * inX) + (inY * inY))) * (the square root of ((outX * outX) + (outY * outY)))
                        set straight to (the absolute value of bend) <= (1e-9 * reach)
                        if (straight and (((inX * outX) + (inY * outY)) > 0.0)) = false:
                            append here to flatLoop
                    free flatPoints
                    if (the length of flatLoop) >= 3:
                        append flatLoop to loops
                    else:
                        free flatLoop
                free loopPoints
        free used
        if (the length of loops) > 0:
            set mesh to the cad triangulation of rings loops
            loop cursor from 0 to the length of (the triangles of mesh):
                set face to the item at cursor in (the triangles of mesh)
                set first to the item at (the first of face) in (the points of mesh)
                set second to the item at (the second of face) in (the points of mesh)
                set third to the item at (the third of face) in (the points of mesh)
                # Counterclockwise seen along the normal: facing it.
                set firstPoint to the bim ifc placed (a cad vector3 with x first's x, y first's y and z 0.0) through capAxes
                set secondPoint to the bim ifc placed (a cad vector3 with x second's x, y second's y and z 0.0) through capAxes
                set thirdPoint to the bim ifc placed (a cad vector3 with x third's x, y third's y and z 0.0) through capAxes
                set turning to ((second's x - first's x) * (third's y - first's y)) - ((second's y - first's y) * (third's x - first's x))
                if turning >= 0.0:
                    add bim ifc triangle firstPoint secondPoint thirdPoint to shape
                else:
                    add bim ifc triangle firstPoint thirdPoint secondPoint to shape
            free cad triangulation mesh
        loop cursor from 0 to the length of loops:
            free (the item at cursor in loops)
        free loops

# The same hole-aware cap triangulation for temporary view cuts. Open
# chains remain unfilled; these triangles never mutate imported geometry.
function the bim closed cut face from {a pointer to a list:segmentEnds} at {cad vector3:planePoint} facing {cad vector3:planeNormal}:
    execute:
        set faceMesh to an empty fast mesh
        add bim ifc cap of segmentEnds on plane at planePoint facing planeNormal to (the address of faceMesh)
        return faceMesh

local function bim ifc spot {cad vector2:location} lies in {a pointer to a list:outline}:
    execute:
        set enclosed to false
        set count to the length of outline
        loop cursor from 0 to count:
            set here to the item at cursor in outline
            set following to the item at (the remainder of (cursor + 1) divided by count) in outline
            if (here's y > location's y) != (following's y > location's y):
                set crossingX to here's x + (((location's y - here's y) / (following's y - here's y)) * (following's x - here's x))
                if location's x < crossingX:
                    set enclosed to (enclosed = false)
        return enclosed

# The faces of an IfcConnectedFaceSet or shell (IfcFace with IfcPolyLoop
# bounds) appended through `frame`.
local function add bim ifc face set {integer:setId} through {bim ifc frame record:frame} to {a pointer to a fast mesh record:shape} in {a pointer to a bim ifc reader record:reader}:
    execute:
        set setValue to the bim step instance setId in (reader's stepFile)
        set faces to the bim step argument 0 of setValue
        loop faceCursor from 0 to the bim step count of faces in setValue:
            set faceValue to the bim step instance (the bim step reference of (the bim step member faceCursor of faces in setValue) in setValue) in (reader's stepFile)
            set bounds to the bim step argument 0 of faceValue
            set outer to an empty list of a cad vector3
            set holes to an empty list of the type of (an empty list of a cad vector3)
            loop boundCursor from 0 to the bim step count of bounds in faceValue:
                set boundValue to the bim step instance (the bim step reference of (the bim step member boundCursor of bounds in faceValue) in faceValue) in (reader's stepFile)
                set loopValue to the bim step instance (the bim step reference of (the bim step argument 0 of boundValue) in boundValue) in (reader's stepFile)
                set sameSense to (the bim step raw text of (the bim step argument 1 of boundValue) in boundValue) != (the string form of "F")
                set loopPoints to an empty list of a cad vector3
                set loopIndices to the bim step argument 0 of loopValue
                loop cursor from 0 to the bim step count of loopIndices in loopValue:
                    append (the bim ifc placed (the bim ifc coordinates of (the bim step reference of (the bim step member cursor of loopIndices in loopValue) in loopValue) in reader) through frame) to loopPoints
                if sameSense = false:
                    set flipped to the bim ifc reversed loopPoints
                    free loopPoints
                    set loopPoints to flipped
                if (boundValue's typeName = (the string form of "IFCFACEOUTERBOUND")) and ((the length of outer) = 0):
                    free outer
                    set outer to loopPoints
                else if ((the length of outer) = 0) and (boundCursor = ((the bim step count of bounds in faceValue) - 1)):
                    free outer
                    set outer to loopPoints
                else:
                    append loopPoints to holes
                free bim step instance loopValue
                free bim step instance boundValue
            add bim ifc facet outer with voids holes to shape
            free outer
            loop holeCursor from 0 to the length of holes:
                free (the item at holeCursor in holes)
            free holes
            free bim step instance faceValue
        free bim step instance setValue

# The colour item `itemId` is drawn in: its own styled colour, else
# `inherited` (the colour of the item it is part of, -1 at the top).
local function the bim ifc colour of item {integer:itemId} inheriting {integer:inherited} in {a pointer to a bim ifc reader record:reader}:
    execute:
        if (itemId >= 0) and (itemId < (the length of (reader's itemColours))):
            set own to the item at itemId in (reader's itemColours)
            if own >= 0:
                return own
        return inherited

# Appends the geometry of representation item `itemId` through `frame` to
# `painted`, in the item's colour (`inherited` when it has none of its own).
# Items made of other items pass that colour on to them.
function add bim ifc item {integer:itemId} through {bim ifc frame record:frame} coloured {integer:inherited} to {a pointer to a bim ifc painted mesh record:painted} in {a pointer to a bim ifc reader record:reader}:
    execute:
        if (bim step file (reader's stepFile) holds itemId) = false:
            return nothing
        set colour to the bim ifc colour of item itemId inheriting inherited in reader
        set itemValue to the bim step instance itemId in (reader's stepFile)
        set typeName to itemValue's typeName
        if typeName = (the string form of "IFCMAPPEDITEM"):
            add bim ifc mapped item itemValue through frame coloured colour to painted in reader
        else if ((typeName = (the string form of "IFCBOOLEANCLIPPINGRESULT")) or (typeName = (the string form of "IFCBOOLEANRESULT"))):
            add bim ifc boolean itemValue through frame coloured colour to painted in reader
        else:
            set colourGroup to the bim ifc group in colour of painted
            add bim ifc solid itemValue numbered itemId through frame to (the address of colourGroup) in reader
        free bim step instance itemValue

# Appends the triangles of item `itemValue` (number `itemId`), one not made
# of other items, through `frame`.
local function add bim ifc solid {bim step instance record:itemValue} numbered {integer:itemId} through {bim ifc frame record:frame} to {a pointer to a fast mesh record:shape} in {a pointer to a bim ifc reader record:reader}:
    execute:
        set typeName to itemValue's typeName
        if (((typeName = (the string form of "IFCPOLYGONALFACESET")) or (typeName = (the string form of "IFCTRIANGULATEDFACESET"))) or (typeName = (the string form of "IFCTRIANGULATEDIRREGULARNETWORK"))):
            set pool to the bim ifc coordinate list (the bim step reference of (the bim step argument 0 of itemValue) in itemValue) in reader
            set placedPool to an empty list of a cad vector3
            loop cursor from 0 to the length of pool:
                append (the bim ifc placed (the item at cursor in pool) through frame) to placedPool
            free pool
            if typeName = (the string form of "IFCPOLYGONALFACESET"):
                set remap to the bim step argument 3 of itemValue
                set faces to the bim step argument 2 of itemValue
                loop faceCursor from 0 to the bim step count of faces in itemValue:
                    set faceValue to the bim step instance (the bim step reference of (the bim step member faceCursor of faces in itemValue) in itemValue) in (reader's stepFile)
                    set outer to the bim ifc indexed points (the bim step argument 0 of faceValue) of faceValue from placedPool remapped by remap in itemValue
                    set holes to an empty list of the type of (an empty list of a cad vector3)
                    if faceValue's typeName = (the string form of "IFCINDEXEDPOLYGONALFACEWITHVOIDS"):
                        set inner to the bim step argument 1 of faceValue
                        loop holeCursor from 0 to the bim step count of inner in faceValue:
                            append (the bim ifc indexed points (the bim step member holeCursor of inner in faceValue) of faceValue from placedPool remapped by remap in itemValue) to holes
                    add bim ifc facet outer with voids holes to shape
                    free outer
                    loop holeCursor from 0 to the length of holes:
                        free (the item at holeCursor in holes)
                    free holes
                    free bim step instance faceValue
            else:
                # Triangles: CoordIndex is the fourth argument, PnIndex the
                # fifth.
                set triangleList to the bim step argument 3 of itemValue
                set remap to the bim step argument 4 of itemValue
                loop faceCursor from 0 to the bim step count of triangleList in itemValue:
                    set corners to the bim ifc indexed points (the bim step member faceCursor of triangleList in itemValue) of itemValue from placedPool remapped by remap in itemValue
                    if (the length of corners) = 3:
                        add bim ifc triangle (the item at 0 in corners) (the item at 1 in corners) (the item at 2 in corners) to shape
                    free corners
            free placedPool
        else if ((typeName = (the string form of "IFCEXTRUDEDAREASOLID")) or (typeName = (the string form of "IFCEXTRUDEDAREASOLIDTAPERED"))):
            set solidFrame to the bim ifc axes (the bim ifc placement axes (the bim step reference of (the bim step argument 1 of itemValue) in itemValue) in reader) within frame
            set direction to the bim ifc ratios (the bim step reference of (the bim step argument 2 of itemValue) in itemValue) or (a cad vector3 with x 0.0, y 0.0 and z 1.0) in reader
            set depth to (the bim step number of (the bim step argument 3 of itemValue) in itemValue) * reader's lengthScale
            set rings to an empty list of the type of (an empty list of a cad vector2)
            set outerFlags to an empty list of a boolean
            append bim ifc profile (the bim step reference of (the bim step argument 0 of itemValue) in itemValue) outlines into rings marking outerFlags through (the bim ifc identity axes) in reader
            add bim ifc prism of rings marking outerFlags along direction by depth through solidFrame to shape
            loop cursor from 0 to the length of rings:
                free (the item at cursor in rings)
            free rings
            free outerFlags
        else if typeName = (the string form of "IFCREVOLVEDAREASOLID"):
            add bim ifc revolution itemValue through frame to shape in reader
        else if ((typeName = (the string form of "IFCSWEPTDISKSOLID")) or (typeName = (the string form of "IFCSWEPTDISKSOLIDPOLYGONAL"))):
            set path to the bim ifc polyline of (the bim step reference of (the bim step argument 0 of itemValue) in itemValue) in reader
            set placedPath to an empty list of a cad vector3
            loop cursor from 0 to the length of path:
                append (the bim ifc placed (the item at cursor in path) through frame) to placedPath
            free path
            set radius to (the bim step number of (the bim step argument 1 of itemValue) in itemValue) * reader's lengthScale
            set placedRadius to radius * (the cad length of frame's xAxis)
            add bim ifc tube along placedPath sized placedRadius to shape
            free placedPath
        else if (((typeName = (the string form of "IFCFACETEDBREP")) or (typeName = (the string form of "IFCFACETEDBREPWITHVOIDS"))) or (typeName = (the string form of "IFCADVANCEDBREP"))):
            add bim ifc face set (the bim step reference of (the bim step argument 0 of itemValue) in itemValue) through frame to shape in reader
        else if ((typeName = (the string form of "IFCSHELLBASEDSURFACEMODEL")) or (typeName = (the string form of "IFCFACEBASEDSURFACEMODEL"))):
            set shells to the bim step argument 0 of itemValue
            loop cursor from 0 to the bim step count of shells in itemValue:
                add bim ifc face set (the bim step reference of (the bim step member cursor of shells in itemValue) in itemValue) through frame to shape in reader
        else if (((typeName = (the string form of "IFCCLOSEDSHELL")) or (typeName = (the string form of "IFCOPENSHELL"))) or (typeName = (the string form of "IFCCONNECTEDFACESET"))):
            add bim ifc face set itemId through frame to shape in reader
        else:
            note bim ifc skipped typeName in reader

# The points list node `indexNode` names (1-based), through PnIndex `remap`
# when it is set.
local function the bim ifc indexed points {integer:indexNode} of {bim step instance record:faceValue} from {a pointer to a list:pool} remapped by {integer:remap} in {bim step instance record:setValue}:
    execute:
        set pickedPoints to an empty list of a cad vector3
        set remapCount to the bim step count of remap in setValue
        loop cursor from 0 to the bim step count of indexNode in faceValue:
            set index to ((the bim step number of (the bim step member cursor of indexNode in faceValue) in faceValue) as an integer) - 1
            if (remapCount > 0) and ((index >= 0) and (index < remapCount)):
                set index to ((the bim step number of (the bim step member index of remap in setValue) in setValue) as an integer) - 1
            if (index >= 0) and (index < (the length of pool)):
                append (the item at index in pool) to pickedPoints
        return pickedPoints

# An IfcMappedItem: its representation meshed once in its own coordinates
# for each colour it inherits, then placed through MappingOrigin and
# MappingTarget.
local function add bim ifc mapped item {bim step instance record:itemValue} through {bim ifc frame record:frame} coloured {integer:colour} to {a pointer to a bim ifc painted mesh record:painted} in {a pointer to a bim ifc reader record:reader}:
    execute:
        set mapId to the bim step reference of (the bim step argument 0 of itemValue) in itemValue
        set targetFrame to the bim ifc operator axes (the bim step reference of (the bim step argument 1 of itemValue) in itemValue) in reader
        if (bim step file (reader's stepFile) holds mapId) = false:
            return nothing
        set mapValue to the bim step instance mapId in (reader's stepFile)
        set originFrame to the bim ifc placement axes (the bim step reference of (the bim step argument 0 of mapValue) in mapValue) in reader
        set representationId to the bim step reference of (the bim step argument 1 of mapValue) in mapValue
        free bim step instance mapValue
        set cached to -1
        loop cursor from 0 to the length of (reader's mappedIds):
            if ((the item at cursor in (reader's mappedIds)) = representationId) and ((the item at cursor in (reader's mappedColours)) = colour):
                set cached to cursor
        if cached < 0:
            set local to an empty bim ifc painted mesh
            add bim ifc representation representationId through (the bim ifc identity axes) coloured colour to (the address of local) in reader
            append representationId to (reader's mappedIds)
            append colour to (reader's mappedColours)
            append local to (reader's mappedMeshes)
            set cached to (the length of (reader's mappedIds)) - 1
        set mappedAxes to the bim ifc axes (the bim ifc axes originFrame within targetFrame) within frame
        add bim ifc painted (the item at cached in (reader's mappedMeshes)) through mappedAxes to painted
        set reader's lastMapped to cached
        set reader's lastMappedAxes to mappedAxes

# The items of shape representation `representationId` through `frame`, each
# in its colour (`inherited` for those without one).
function add bim ifc representation {integer:representationId} through {bim ifc frame record:frame} coloured {integer:inherited} to {a pointer to a bim ifc painted mesh record:painted} in {a pointer to a bim ifc reader record:reader}:
    execute:
        if (bim step file (reader's stepFile) holds representationId) = false:
            return nothing
        set representationValue to the bim step instance representationId in (reader's stepFile)
        set items to the bim step argument 3 of representationValue
        loop cursor from 0 to the bim step count of items in representationValue:
            add bim ifc item (the bim step reference of (the bim step member cursor of items in representationValue) in representationValue) through frame coloured inherited to painted in reader
        free bim step instance representationValue

# An IfcRevolvedAreaSolid: the profile turned about its axis in steps of at
# most 15 degrees.
local function add bim ifc revolution {bim step instance record:itemValue} through {bim ifc frame record:frame} to {a pointer to a fast mesh record:shape} in {a pointer to a bim ifc reader record:reader}:
    execute:
        set solidFrame to the bim ifc axes (the bim ifc placement axes (the bim step reference of (the bim step argument 1 of itemValue) in itemValue) in reader) within frame
        set axisValue to the bim step instance (the bim step reference of (the bim step argument 2 of itemValue) in itemValue) in (reader's stepFile)
        set axisPoint to the bim ifc coordinates of (the bim step reference of (the bim step argument 0 of axisValue) in axisValue) in reader
        set axisDirection to the bim ifc unit of (the bim ifc ratios (the bim step reference of (the bim step argument 1 of axisValue) in axisValue) or (a cad vector3 with x 0.0, y 1.0 and z 0.0) in reader) or (a cad vector3 with x 0.0, y 1.0 and z 0.0)
        free bim step instance axisValue
        set sweep to (the bim step number of (the bim step argument 3 of itemValue) in itemValue) * reader's angleScale
        set rings to an empty list of the type of (an empty list of a cad vector2)
        set outerFlags to an empty list of a boolean
        append bim ifc profile (the bim step reference of (the bim step argument 0 of itemValue) in itemValue) outlines into rings marking outerFlags through (the bim ifc identity axes) in reader
        set steps to (the ceiling of ((the absolute value of sweep) / 0.2617993877991494)) as an integer
        if steps < 1:
            set steps to 1
        loop ringCursor from 0 to the length of rings:
            set ring to the item at ringCursor in rings
            set ringSize to the length of ring
            loop stepIndex from 0 to steps:
                set fromAngle to (sweep * (stepIndex as a 64 bit floating-point number)) / (steps as a 64 bit floating-point number)
                set toAngle to (sweep * ((stepIndex + 1) as a 64 bit floating-point number)) / (steps as a 64 bit floating-point number)
                loop cursor from 0 to ringSize:
                    set here to the item at cursor in ring
                    set after to the item at (the remainder of (cursor + 1) divided by ringSize) in ring
                    set a to the bim ifc placed (the bim ifc rotation of (a cad vector3 with x here's x, y here's y and z 0.0) by fromAngle about axisPoint along axisDirection) through solidFrame
                    set b to the bim ifc placed (the bim ifc rotation of (a cad vector3 with x after's x, y after's y and z 0.0) by fromAngle about axisPoint along axisDirection) through solidFrame
                    set c to the bim ifc placed (the bim ifc rotation of (a cad vector3 with x after's x, y after's y and z 0.0) by toAngle about axisPoint along axisDirection) through solidFrame
                    set d to the bim ifc placed (the bim ifc rotation of (a cad vector3 with x here's x, y here's y and z 0.0) by toAngle about axisPoint along axisDirection) through solidFrame
                    add bim ifc triangle a b c to shape
                    add bim ifc triangle a c d to shape
            free ring
        free rings
        free outerFlags

# `point` turned by `angle` about the axis through `axisPoint` along the unit
# vector `axisDirection` (Rodrigues).
local function the bim ifc rotation of {cad vector3:pointToTurn} by {a 64 bit floating-point number:angle} about {cad vector3:axisPoint} along {cad vector3:axisDirection}:
    execute:
        set offset to the cad difference of pointToTurn and axisPoint
        set cosine to the cosine of angle
        set sine to the sine of angle
        set alongPart to axisDirection scaled by ((the cad dot of axisDirection and offset) * (1.0 - cosine))
        set rotatedOffset to the cad sum of (offset scaled by cosine) and (the cad sum of ((the cad cross of axisDirection and offset) scaled by sine) and alongPart)
        return the cad sum of axisPoint and rotatedOffset

# A boolean result: its first operand, clipped where the second is a half
# space; any other second operand is left out. The operands pass `colour` on;
# each group of the first is clipped and capped in its own colour.
local function add bim ifc boolean {bim step instance record:itemValue} through {bim ifc frame record:frame} coloured {integer:colour} to {a pointer to a bim ifc painted mesh record:painted} in {a pointer to a bim ifc reader record:reader}:
    execute:
        set operation to the bim step raw text of (the bim step argument 0 of itemValue) in itemValue
        set firstId to the bim step reference of (the bim step argument 1 of itemValue) in itemValue
        set secondId to the bim step reference of (the bim step argument 2 of itemValue) in itemValue
        set first to an empty bim ifc painted mesh
        add bim ifc item firstId through frame coloured colour to (the address of first) in reader
        set secondType to the bim step type of secondId in (reader's stepFile)
        if (operation = (the string form of "DIFFERENCE")) and (((secondType = (the string form of "IFCHALFSPACESOLID")) or (secondType = (the string form of "IFCPOLYGONALBOUNDEDHALFSPACE"))) or (secondType = (the string form of "IFCBOXEDHALFSPACE"))):
            set halfValue to the bim step instance secondId in (reader's stepFile)
            set planeValue to the bim step instance (the bim step reference of (the bim step argument 0 of halfValue) in halfValue) in (reader's stepFile)
            set planeFrame to the bim ifc axes (the bim ifc placement axes (the bim step reference of (the bim step argument 0 of planeValue) in planeValue) in reader) within frame
            free bim step instance planeValue
            # The half space is the side the plane's normal points away
            # from when its agreement flag is true; that side is removed.
            set agreement to (the bim step raw text of (the bim step argument 1 of halfValue) in halfValue) != (the string form of "F")
            set removedNormal to planeFrame's zAxis scaled by -1.0
            if agreement = false:
                set removedNormal to planeFrame's zAxis
            set boundary to an empty list of a cad vector2
            set hasBoundary to secondType = (the string form of "IFCPOLYGONALBOUNDEDHALFSPACE")
            set boundaryFrame to the bim ifc identity axes
            if hasBoundary:
                set boundaryFrame to the bim ifc axes (the bim ifc placement axes (the bim step reference of (the bim step argument 2 of halfValue) in halfValue) in reader) within frame
                set boundaryPoints to the bim ifc polyline of (the bim step reference of (the bim step argument 3 of halfValue) in halfValue) in reader
                set boundaryRing to the bim ifc ring of boundaryPoints
                loop cursor from 0 to the length of boundaryRing:
                    append (the item at cursor in boundaryRing) to boundary
                free boundaryRing
                free boundaryPoints
            free bim step instance halfValue
            # Keep the side opposite to the removed normal: clip away where
            # the removed normal points.
            # Clipping replaces a group's lists, so each group is put back.
            loop groupCursor from 0 to the length of (first's groups):
                set colourGroup to the item at groupCursor in (first's groups)
                clip bim ifc mesh (the address of colourGroup) by plane at planeFrame's origin facing removedNormal bounded hasBoundary by boundary in boundaryFrame
                replace item at index groupCursor in (first's groups) with colourGroup
            free boundary
        else if operation = (the string form of "UNION"):
            add bim ifc item secondId through frame coloured colour to (the address of first) in reader
        else:
            note bim ifc skipped ((the string form of "boolean with ") + secondType) in reader
        add bim ifc painted first through (the bim ifc identity axes) to painted
        free bim ifc painted (the address of first)

# ---------------------------------------------------------------- units and styles

local function the bim ifc prefix scale of {a string:prefixName}:
    execute:
        if prefixName = (the string form of "MILLI"):
            return 0.001
        if prefixName = (the string form of "CENTI"):
            return 0.01
        if prefixName = (the string form of "DECI"):
            return 0.1
        if prefixName = (the string form of "KILO"):
            return 1000.0
        if prefixName = (the string form of "MICRO"):
            return 0.000001
        return 1.0

# Reads the length and plane angle units of the project into `reader`.
function gather bim ifc units for {a pointer to a bim ifc reader record:reader}:
    execute:
        set stepFile to reader's stepFile
        set assignments to the bim step instances of type (the string form of "IFCUNITASSIGNMENT") in stepFile
        loop assignmentCursor from 0 to the length of assignments:
            if true:
                set assignment to the bim step instance (the item at assignmentCursor in assignments) in stepFile
                set unitRefs to the bim step argument 0 of assignment
                loop cursor from 0 to the bim step count of unitRefs in assignment:
                    set unitId to the bim step reference of (the bim step member cursor of unitRefs in assignment) in assignment
                    set unitValue to the bim step instance unitId in stepFile
                    set unitKind to the bim step raw text of (the bim step argument 1 of unitValue) in unitValue
                    if unitValue's typeName = (the string form of "IFCSIUNIT"):
                        set prefixScale to the bim ifc prefix scale of (the bim step raw text of (the bim step argument 2 of unitValue) in unitValue)
                        if unitKind = (the string form of "LENGTHUNIT"):
                            set reader's lengthScale to prefixScale
                        if unitKind = (the string form of "PLANEANGLEUNIT"):
                            set reader's angleScale to 1.0
                    else if unitValue's typeName = (the string form of "IFCCONVERSIONBASEDUNIT"):
                        # Its measure with unit: a factor and the SI unit it
                        # is a factor of.
                        set measureValue to the bim step instance (the bim step reference of (the bim step argument 3 of unitValue) in unitValue) in stepFile
                        set factor to the bim step number of (the bim step argument 0 of measureValue) in measureValue
                        set baseValue to the bim step instance (the bim step reference of (the bim step argument 1 of measureValue) in measureValue) in stepFile
                        set baseScale to 1.0
                        if baseValue's typeName = (the string form of "IFCSIUNIT"):
                            set baseScale to the bim ifc prefix scale of (the bim step raw text of (the bim step argument 2 of baseValue) in baseValue)
                        free bim step instance baseValue
                        free bim step instance measureValue
                        if unitKind = (the string form of "LENGTHUNIT"):
                            set reader's lengthScale to factor * baseScale
                        if unitKind = (the string form of "PLANEANGLEUNIT"):
                            set reader's angleScale to factor * baseScale
                    free bim step instance unitValue
                free bim step instance assignment
        free assignments

local function the bim ifc packed colour of style {integer:styleId} in {bim step file record:stepFile} at depth {integer:nesting}:
    execute:
        if (nesting > 6) or ((bim step file stepFile holds styleId) = false):
            return -1
        set styleValue to the bim step instance styleId in stepFile
        set typeName to styleValue's typeName
        set result to -1
        if typeName = (the string form of "IFCCOLOURRGB"):
            set red to ((the bim step number of (the bim step argument 1 of styleValue) in styleValue) * 255.0) + 0.5
            set green to ((the bim step number of (the bim step argument 2 of styleValue) in styleValue) * 255.0) + 0.5
            set blue to ((the bim step number of (the bim step argument 3 of styleValue) in styleValue) * 255.0) + 0.5
            set result to ((((red as an integer) * 65536) + ((green as an integer) * 256)) + (blue as an integer))
        else if ((typeName = (the string form of "IFCSURFACESTYLERENDERING")) or (typeName = (the string form of "IFCSURFACESTYLESHADING"))):
            set result to the bim ifc packed colour of style (the bim step reference of (the bim step argument 0 of styleValue) in styleValue) in stepFile at depth (nesting + 1)
        else:
            # A surface style or a style assignment: the first colour among
            # its styles (the third argument of a surface style, the first of
            # an assignment).
            set listNode to the bim step argument 0 of styleValue
            if typeName = (the string form of "IFCSURFACESTYLE"):
                set listNode to the bim step argument 2 of styleValue
            loop cursor from 0 to the bim step count of listNode in styleValue:
                if result < 0:
                    set result to the bim ifc packed colour of style (the bim step reference of (the bim step member cursor of listNode in styleValue) in styleValue) in stepFile at depth (nesting + 1)
        free bim step instance styleValue
        return result

# Reads the colour styled onto each item (IfcStyledItem) into `reader`.
local function gather bim ifc colours for {a pointer to a bim ifc reader record:reader}:
    execute:
        set stepFile to reader's stepFile
        set styledItems to the bim step instances of type (the string form of "IFCSTYLEDITEM") in stepFile
        loop styledCursor from 0 to the length of styledItems:
            if true:
                set styled to the bim step instance (the item at styledCursor in styledItems) in stepFile
                set itemId to the bim step reference of (the bim step argument 0 of styled) in styled
                set styles to the bim step argument 1 of styled
                set styledColour to -1
                loop cursor from 0 to the bim step count of styles in styled:
                    if styledColour < 0:
                        set styledColour to the bim ifc packed colour of style (the bim step reference of (the bim step member cursor of styles in styled) in styled) in stepFile at depth 0
                free bim step instance styled
                if (itemId >= 0) and (styledColour >= 0):
                    loop while (the length of (reader's itemColours)) <= itemId:
                        append -1 to (reader's itemColours)
                    replace item at index itemId in (reader's itemColours) with styledColour
        free styledItems

# A packed colour as a scene mesh's colour; -1 colours it by its category.
local function the bim ifc mesh colour of {integer:packed}:
    execute:
        if packed < 0:
            return the bim category colouring
        return a cad vector3 with x ((packed / 65536) as a 64 bit floating-point number), y ((the remainder of (packed / 256) divided by 256) as a 64 bit floating-point number) and z ((the remainder of packed divided by 256) as a 64 bit floating-point number)

# ---------------------------------------------------------------- openings

# The solids of representation `representationId` through `frame` as kernel
# bodies, appended to `bodies` and the colour of each item to `bodyColours`,
# when every item is an extrusion of a profile with one outer ring and no
# holes; false (nothing appended) otherwise.
local function append bim ifc extrusion bodies of {integer:representationId} through {bim ifc frame record:frame} to {a pointer to a list:bodyList} colouring {a pointer to a list:bodyColours} in {a pointer to a bim ifc reader record:reader}:
    execute:
        if (bim step file (reader's stepFile) holds representationId) = false:
            return false
        set representationValue to the bim step instance representationId in (reader's stepFile)
        set items to the bim step argument 3 of representationValue
        set accepted to (the bim step count of items in representationValue) > 0
        set made to an empty list of the type of (an empty cad body)
        set madeColours to an empty list of an integer
        loop cursor from 0 to the bim step count of items in representationValue:
            set itemId to the bim step reference of (the bim step member cursor of items in representationValue) in representationValue
            if accepted and (bim step instance itemId is a "IFCEXTRUDEDAREASOLID" in (reader's stepFile)):
                set itemValue to the bim step instance itemId in (reader's stepFile)
                set solidFrame to the bim ifc axes (the bim ifc placement axes (the bim step reference of (the bim step argument 1 of itemValue) in itemValue) in reader) within frame
                set direction to the bim ifc ratios (the bim step reference of (the bim step argument 2 of itemValue) in itemValue) or (a cad vector3 with x 0.0, y 0.0 and z 1.0) in reader
                set depth to (the bim step number of (the bim step argument 3 of itemValue) in itemValue) * reader's lengthScale
                set rings to an empty list of the type of (an empty list of a cad vector2)
                set outerFlags to an empty list of a boolean
                append bim ifc profile (the bim step reference of (the bim step argument 0 of itemValue) in itemValue) outlines into rings marking outerFlags through (the bim ifc identity axes) in reader
                free bim step instance itemValue
                if (the length of rings) != 1:
                    set accepted to false
                else:
                    set ring to the item at 0 in rings
                    set pieces to an empty list of the type of (the cad curve2 of (a new cad line2))
                    loop corner from 0 to the length of ring:
                        set following to the remainder of (corner + 1) divided by (the length of ring)
                        if (the cad distance from (the item at corner in ring) to (the item at following in ring)) > 1e-9:
                            append (the cad curve2 of (a cad line2 from (the item at corner in ring) to (the item at following in ring))) to pieces
                    # The profile's plane through the solid's placement; the
                    # direction through it too, its length the depth.
                    set xUnit to the bim ifc unit of solidFrame's xAxis or (a cad vector3 with x 1.0, y 0.0 and z 0.0)
                    set yUnit to the bim ifc unit of solidFrame's yAxis or (a cad vector3 with x 0.0, y 1.0 and z 0.0)
                    set sweep to (the bim ifc turned (the bim ifc unit of direction or (a cad vector3 with x 0.0, y 0.0 and z 1.0)) through solidFrame) scaled by depth
                    set extruded to the cad extrusion of pieces on (a cad plane with origin solidFrame's origin, x axis xUnit and y axis yUnit) along sweep
                    free pieces
                    if extruded's valid:
                        append extruded's value to made
                        append (the bim ifc colour of item itemId inheriting -1 in reader) to madeColours
                    else:
                        set accepted to false
                loop ringCursor from 0 to the length of rings:
                    free (the item at ringCursor in rings)
                free rings
                free outerFlags
            else:
                set accepted to false
        free bim step instance representationValue
        if accepted:
            loop cursor from 0 to the length of made:
                append (the item at cursor in made) to bodyList
                append (the item at cursor in madeColours) to bodyColours
        free made
        free madeColours
        return accepted

# Appends the body of a host (representation `bodyId` through `frame`) with
# its openings `openingIds` cut away, each item in its colour, when the host
# and each opening are extrusions the kernel can cut; false (nothing
# appended) otherwise.
local function add bim ifc voided body {integer:bodyId} through {bim ifc frame record:frame} cutting {a pointer to a list:openingIds} to {a pointer to a bim ifc painted mesh record:painted} in {a pointer to a bim ifc reader record:reader}:
    execute:
        set hostBodies to an empty list of the type of (an empty cad body)
        set hostColours to an empty list of an integer
        if (append bim ifc extrusion bodies of bodyId through frame to hostBodies colouring hostColours in reader) = false:
            free hostBodies
            free hostColours
            return false
        set cutters to an empty list of the type of (an empty cad body)
        set cutterColours to an empty list of an integer
        loop cursor from 0 to the length of openingIds:
            set openingValue to the bim step instance (the item at cursor in openingIds) in (reader's stepFile)
            set openingPlacement to the bim step reference of (the bim step argument 5 of openingValue) in openingValue
            set openingShape to the bim step reference of (the bim step argument 6 of openingValue) in openingValue
            free bim step instance openingValue
            set openingBody to the bim ifc body of shape openingShape in (reader's stepFile)
            if openingBody >= 0:
                ignore (append bim ifc extrusion bodies of openingBody through (the bim ifc object axes openingPlacement in reader) to cutters colouring cutterColours in reader)
        loop hostCursor from 0 to the length of hostBodies:
            set hostGroup to the bim ifc group in (the item at hostCursor in hostColours) of painted
            set cutBody to the item at hostCursor in hostBodies
            loop cutterCursor from 0 to the length of cutters:
                set difference to the cad combination of cutBody and (the item at cutterCursor in cutters) using cad difference operation within 1e-7
                if difference's valid:
                    set cutBody to difference's value
            set tessellated to the cad mesh of cutBody with maximum angle 0.3 within 0.0005
            loop face from 0 to the length of tessellated's triangles:
                set corners to the item at face in tessellated's triangles
                add bim ifc triangle (the item at corners's first in tessellated's positions) (the item at corners's second in tessellated's positions) (the item at corners's third in tessellated's positions) to (the address of hostGroup)
        free hostBodies
        free hostColours
        free cutters
        free cutterColours
        return true

# ---------------------------------------------------------------- products

# The slice's category of an IFC class (in capitals), as `ifc_to_mesh.py`
# maps them.
function the bim category of step class {a string:className}:
    execute:
        if ((className = (the string form of "IFCWALL")) or (className = (the string form of "IFCWALLSTANDARDCASE"))) or ((className = (the string form of "IFCCURTAINWALL")) or (className = (the string form of "IFCPLATE"))):
            return bim wall category
        if (className = (the string form of "IFCSLAB")) or (className = (the string form of "IFCCOVERING")):
            return bim slab category
        if className = (the string form of "IFCDOOR"):
            return bim door category
        if className = (the string form of "IFCWINDOW"):
            return bim window category
        if className = (the string form of "IFCSPACE"):
            return bim space category
        if className = (the string form of "IFCCOLUMN"):
            return bim column category
        if (className = (the string form of "IFCBEAM")) or (className = (the string form of "IFCMEMBER")):
            return bim beam category
        if className = (the string form of "IFCROOF"):
            return bim roof category
        if ((className = (the string form of "IFCSTAIR")) or (className = (the string form of "IFCSTAIRFLIGHT"))) or ((className = (the string form of "IFCRAMP")) or (className = (the string form of "IFCRAMPFLIGHT"))):
            return bim stair category
        if className = (the string form of "IFCRAILING"):
            return bim railing category
        if (className = (the string form of "IFCFURNISHINGELEMENT")) or (className = (the string form of "IFCFURNITURE")):
            return bim furniture category
        if (className = (the string form of "IFCPILE")) or (className = (the string form of "IFCFOOTING")):
            return bim pile category
        return bim other category

# Whether instances of `typeName` are certainly no product (the common
# geometry, property and relation instances), so that they need not be
# parsed while looking for products. Decided once per type.
local function bim ifc type {a string:typeName} is no product:
    execute:
        set prefixes to (the string form of "IFCREL IFCPROPERTY IFCPRODUCTDEFINITIONSHAPE IFCCARTESIAN IFCINDEXED IFCAXIS IFCDIRECTION IFCQUANTITY IFCPOLY IFCFACE IFCLOCALPLACEMENT IFCSHAPEREPRESENTATION IFCCOLOUR IFCMATERIAL IFCSURFACESTYLE IFCMAPPEDITEM IFCREPRESENTATION IFCEXTRUDEDAREASOLID IFCCOMPOSITECURVE IFCSTYLEDITEM IFCPRESENTATION IFCELEMENTQUANTITY") split at " "
        set listed to false
        loop cursor from 0 to the length of prefixes:
            set prefixText to the item at cursor in prefixes
            if (the length of typeName) >= (the length of prefixText):
                if (the substring of typeName from 0 spanning (the length of prefixText) bytes) = prefixText:
                    set listed to true
        free prefixes
        return listed

# Whether a product of `className` is left out: spatial structure, openings,
# annotations and virtual elements.
local function bim ifc class {a string:className} is left out:
    execute:
        return ((((className = (the string form of "IFCOPENINGELEMENT")) or (className = (the string form of "IFCOPENINGSTANDARDCASE"))) or ((className = (the string form of "IFCANNOTATION")) or (className = (the string form of "IFCVIRTUALELEMENT")))) or (((className = (the string form of "IFCBUILDING")) or (className = (the string form of "IFCBUILDINGSTOREY"))) or ((className = (the string form of "IFCPROJECT")) or (className = (the string form of "IFCGRID"))))) or (((className = (the string form of "IFCDISTRIBUTIONPORT")) or (className = (the string form of "IFCFACILITYPART"))) or ((className = (the string form of "IFCALIGNMENT")) or (className = (the string form of "IFCFACILITY"))))

# The body representation of product definition shape `shapeId`: the one
# named Body (or Facetation, or Mesh), else the first that is not an axis,
# outline or box; -1 if none.
# Whether representation `representationId` is one mapped item and nothing
# else, so that its element places the mapped representation's mesh.
local function bim ifc representation {integer:representationId} is one mapped item in {bim step file record:stepFile}:
    execute:
        if (bim step file stepFile holds representationId) = false:
            return false
        set representationValue to the bim step instance representationId in stepFile
        set items to the bim step argument 3 of representationValue
        set single to false
        if (the bim step count of items in representationValue) = 1:
            set single to bim step instance (the bim step reference of (the bim step member 0 of items in representationValue) in representationValue) is a "IFCMAPPEDITEM" in stepFile
        free bim step instance representationValue
        return single

# The twelve numbers placing a shape through `frame`, by rows: the x, y and
# z axes' parts and the shift.
local function append bim ifc rows of {bim ifc frame record:frame} to {a pointer to a list:rows}:
    execute:
        append frame's xAxis's x to rows
        append frame's yAxis's x to rows
        append frame's zAxis's x to rows
        append frame's origin's x to rows
        append frame's xAxis's y to rows
        append frame's yAxis's y to rows
        append frame's zAxis's y to rows
        append frame's origin's y to rows
        append frame's xAxis's z to rows
        append frame's yAxis's z to rows
        append frame's zAxis's z to rows
        append frame's origin's z to rows

function the bim ifc body of shape {integer:shapeId} in {bim step file record:stepFile}:
    execute:
        if (bim step instance shapeId is a "IFCPRODUCTDEFINITIONSHAPE" in stepFile) = false:
            return -1
        set shapeValue to the bim step instance shapeId in stepFile
        set representations to the bim step argument 2 of shapeValue
        set found to -1
        set fallback to -1
        loop cursor from 0 to the bim step count of representations in shapeValue:
            set representationId to the bim step reference of (the bim step member cursor of representations in shapeValue) in shapeValue
            set representationValue to the bim step instance representationId in stepFile
            set identifierText to the bim step string of (the bim step argument 1 of representationValue) in representationValue
            set kindText to the bim step string of (the bim step argument 2 of representationValue) in representationValue
            if (found < 0) and (((identifierText = (the string form of "Body")) or (identifierText = (the string form of "Facetation"))) or (identifierText = (the string form of "Mesh"))):
                set found to representationId
            set notBody to ((identifierText = (the string form of "Axis")) or (identifierText = (the string form of "FootPrint"))) or (((identifierText = (the string form of "Box")) or (identifierText = (the string form of "Annotation"))) or ((identifierText = (the string form of "Profile")) or (identifierText = (the string form of "Clearance"))))
            if ((fallback < 0) and (notBody = false)) and (((kindText != (the string form of "Curve2D")) and (kindText != (the string form of "GeometricCurveSet"))) and (kindText != (the string form of "BoundingBox"))):
                set fallback to representationId
            free bim step instance representationValue
        free bim step instance shapeValue
        if found >= 0:
            return found
        return fallback

# The slot of host `hostId` in the open-addressed table `slotHosts` (its
# length a power of two): where it is, or the free slot it would take.
local function the bim ifc slot of {integer:hostId} among {a pointer to a list:slotHosts}:
    execute:
        set mask to (the length of slotHosts) - 1
        set probe to hostId bitwise and mask
        set searching to true
        loop while searching:
            set held to the item at probe in slotHosts
            if (held = hostId) or (held < 0):
                set searching to false
            else:
                set probe to (probe + 1) bitwise and mask
        return probe

# For each relation of type `typeName`, the instances its argument
# `membersArgument` lists recorded as in the one its argument
# `containerArgument` names, in `containerOf` (by instance number), unless
# an earlier relation put them in one already.
function record bim ifc containers of type {a string:typeName} holding {integer:membersArgument} in {integer:containerArgument} in {bim step file record:stepFile} into {a pointer to a list:containerOf}:
    execute:
        set relations to the bim step instances of type typeName in stepFile
        loop relationCursor from 0 to the length of relations:
            set relation to the bim step instance (the item at relationCursor in relations) in stepFile
            set container to the bim step reference of (the bim step argument containerArgument of relation) in relation
            set members to the bim step argument membersArgument of relation
            loop memberCursor from 0 to the bim step count of members in relation:
                set member to the bim step reference of (the bim step member memberCursor of members in relation) in relation
                if (member >= 0) and (member < (the length of containerOf)):
                    if (the item at member in containerOf) < 0:
                        replace item at index member in containerOf with container
            free bim step instance relation
        free relations

# The storey (its index in `storeyAt`'s numbering) that instance
# `instanceId` is in, followed up through what contains it or what it is a
# part of; -1 when it is in none.
function the bim ifc storey of {integer:instanceId} among {a pointer to a list:containerOf} and {a pointer to a list:storeyAt}:
    execute:
        set climbed to instanceId
        loop step from 0 to 12:
            if (climbed < 0) or (climbed >= (the length of storeyAt)):
                return -1
            if (the item at climbed in storeyAt) >= 0:
                return the item at climbed in storeyAt
            set climbed to the item at climbed in containerOf
        return -1

# The IFC file at `path` as imported elements.
function the bim ifc import of {a string:path}:
    execute:
        set stepFile to the bim step file at path
        return the bim ifc elements of stepFile

# The indexed STEP file `stepFile` as imported elements, or a refusal.
function the bim ifc elements of {bim step file record:stepFile}:
    execute:
        set noneSkipped to an empty list of an integer
        set result to the bim ifc elements of stepFile skipping noneSkipped
        free noneSkipped
        return result

# The same, but for the instances `skippedIds` (made native elements of the
# model instead, see `bim_ifc_native.dl`).
function the bim ifc elements of {bim step file record:stepFile} skipping {a pointer to a list:skippedIds}:
    execute:
        return the bim ifc elements of stepFile skipping skippedIds reporting to (no bim load progress)

# The same, reporting how many of the file's instances have been looked at
# to `tracker` (see `bim_step.dl`).
function the bim ifc elements of {bim step file record:stepFile} skipping {a pointer to a list:skippedIds} reporting to {a pointer to a bim load progress record:tracker}:
    execute:
        set origin to a cad vector3 with x 0.0, y 0.0 and z 0.0
        if stepFile's valid = false:
            return @intrinsic("construct", a bim import record, false, stepFile's message, a cad topology list of a bim scene mesh record, a cad topology list of a string, 0, origin, origin, a cad topology list of a cad vector3, no bim import storeys, no bim import instancing, a cad topology list of a bim pset entry record)
        set reader to a fresh bim ifc reading of stepFile
        set r to the address of reader
        gather bim ifc units for r
        gather bim ifc colours for r
        # The openings of each host (IfcRelVoidsElement).
        set voidHosts to an empty list of an integer
        set voidOpenings to an empty list of an integer
        set relations to the bim step instances of type (the string form of "IFCRELVOIDSELEMENT") in stepFile
        loop relationCursor from 0 to the length of relations:
            set relation to the bim step instance (the item at relationCursor in relations) in stepFile
            append (the bim step reference of (the bim step argument 4 of relation) in relation) to voidHosts
            append (the bim step reference of (the bim step argument 5 of relation) in relation) to voidOpenings
            free bim step instance relation
        free relations
        # The openings of a host found through a hash table on its number:
        # each slot holds a host and its first opening, each opening the
        # next of the same host.
        set slotCount to 16
        loop while slotCount < ((the length of voidHosts) * 2):
            set slotCount to slotCount * 2
        set slotHosts to an empty list of an integer
        set slotHeads to an empty list of an integer
        loop slotCursor from 0 to slotCount:
            append -1 to slotHosts
            append -1 to slotHeads
        set voidNext to an empty list of an integer
        loop voidCursor from 0 to the length of voidHosts:
            append -1 to voidNext
            set hostSlot to the bim ifc slot of (the item at voidCursor in voidHosts) among slotHosts
            replace item at index voidCursor in voidNext with (the item at hostSlot in slotHeads)
            replace item at index hostSlot in slotHosts with (the item at voidCursor in voidHosts)
            replace item at index hostSlot in slotHeads with voidCursor
        # The storeys (IfcBuildingStorey), at the height their placement puts
        # them, and what each instance is in: the structure containing it
        # (IfcRelContainedInSpatialStructure), else the whole it is a part of
        # (IfcRelAggregates).
        set storeys to no bim import storeys
        set instanceCount to the length of (stepFile's starts)
        set storeyAt to an empty list of an integer
        set containerOf to an empty list of an integer
        set skippedAt to an empty list of a boolean
        loop instanceCursor from 0 to instanceCount:
            append -1 to storeyAt
            append -1 to containerOf
            append false to skippedAt
        loop skipCursor from 0 to the length of skippedIds:
            set skippedId to the item at skipCursor in skippedIds
            if (skippedId >= 0) and (skippedId < instanceCount):
                replace item at index skippedId in skippedAt with true
        set storeyIds to the bim step instances of type (the string form of "IFCBUILDINGSTOREY") in stepFile
        loop storeyCursor from 0 to the length of storeyIds:
            set storeyId to the item at storeyCursor in storeyIds
            set storeyValue to the bim step instance storeyId in stepFile
            set storeyFrame to the bim ifc object axes (the bim step reference of (the bim step argument 5 of storeyValue) in storeyValue) in r
            replace item at index storeyId in storeyAt with (the length of (storeys's names's values))
            append (the bim step string of (the bim step argument 2 of storeyValue) in storeyValue) to (storeys's names's values)
            append storeyFrame's origin's z to (storeys's elevations's values)
            free bim step instance storeyValue
        free storeyIds
        record bim ifc containers of type (the string form of "IFCRELCONTAINEDINSPATIALSTRUCTURE") holding 4 in 5 in stepFile into containerOf
        record bim ifc containers of type (the string form of "IFCRELAGGREGATES") holding 5 in 4 in stepFile into containerOf
        # Which types can be products with a body: decided once per type.
        set productTypes to an empty list of a boolean
        loop typeCursor from 0 to the length of (stepFile's typeNames):
            set typeText to the item at typeCursor in (stepFile's typeNames)
            append (((bim ifc type typeText is no product) = false) and ((bim ifc class typeText is left out) = false)) to productTypes
        set voidedCount to 0
        # The shapes elements of one mapped item place, and for each mapped
        # representation meshed (`mappedMeshes`) its first shape, -1 until
        # an element places it.
        set placements to no bim import instancing
        set firstPrototypes to an empty list of an integer
        set identityRows to an empty list of a 64 bit floating-point number
        append bim ifc rows of (the bim ifc identity axes) to identityRows
        set meshes to a cad topology list of a bim scene mesh record
        set labels to a cad topology list of a string
        # The STEP instance each element came from, for its property sets.
        set labelSources to an empty list of an integer
        set infinity to 1.0 / 0.0
        set low to a cad vector3 with x infinity, y infinity and z infinity
        set high to a cad vector3 with x (0.0 - infinity), y (0.0 - infinity) and z (0.0 - infinity)
        set triangles to 0
        set element to 0
        set instanceTotal to the length of (stepFile's starts)
        loop identifier from 0 to instanceTotal:
            if (the remainder of identifier divided by 4096) = 0:
                report bim load count identifier of instanceTotal to tracker
            set typeNumber to the item at identifier in (stepFile's types)
            set candidate to false
            if typeNumber >= 0:
                set candidate to the item at typeNumber in productTypes
            if candidate and (the item at identifier in skippedAt):
                set candidate to false
            if candidate:
                set className to the item at typeNumber in (stepFile's typeNames)
                if true:
                    set productValue to the bim step instance identifier in stepFile
                    # A product: ObjectPlacement (6th) and Representation
                    # (7th) after GlobalId, OwnerHistory, Name, Description
                    # and ObjectType.
                    set placementId to the bim step reference of (the bim step argument 5 of productValue) in productValue
                    set shapeId to the bim step reference of (the bim step argument 6 of productValue) in productValue
                    set bodyId to -1
                    if (the bim step argument count of productValue) >= 7:
                        set bodyId to the bim ifc body of shape shapeId in stepFile
                    if bodyId >= 0:
                        set frame to the bim ifc object axes placementId in r
                        set painted to an empty bim ifc painted mesh
                        set openingIds to an empty list of an integer
                        set voidAt to the item at (the bim ifc slot of identifier among slotHosts) in slotHeads
                        loop while voidAt >= 0:
                            append (the item at voidAt in voidOpenings) to openingIds
                            set voidAt to the item at voidAt in voidNext
                        set cut to false
                        if (the length of openingIds) > 0:
                            set cut to add bim ifc voided body bodyId through frame cutting openingIds to (the address of painted) in r
                            if cut:
                                set voidedCount to voidedCount + 1
                        set prototypeBase to -1
                        if cut = false:
                            set singleMapped to bim ifc representation bodyId is one mapped item in stepFile
                            set reader's lastMapped to -1
                            add bim ifc representation bodyId through frame coloured -1 to (the address of painted) in r
                            set placedMesh to reader's lastMapped
                            if singleMapped and (placedMesh >= 0):
                                loop while (the length of firstPrototypes) <= placedMesh:
                                    append -1 to firstPrototypes
                                set mappedPainted to the item at placedMesh in (reader's mappedMeshes)
                                if (the item at placedMesh in firstPrototypes) < 0:
                                    replace item at index placedMesh in firstPrototypes with (the length of (placements's prototypes's values))
                                    loop groupCursor from 0 to the length of (mappedPainted's groups):
                                        append (the item at groupCursor in (mappedPainted's groups)) to (placements's prototypes's values)
                                # The element's colour groups are the mapped mesh's, in order.
                                if (the length of (painted's groups)) = (the length of (mappedPainted's groups)):
                                    set prototypeBase to the item at placedMesh in firstPrototypes
                        free openingIds
                        # One scene mesh per colour, all with the element's id.
                        set elementId to (the bim imported id base) + (element as a 64 bit integer)
                        set category to the bim category of step class className
                        set cornerCount to 0
                        loop groupCursor from 0 to the length of (painted's groups):
                            set colourGroup to the item at groupCursor in (painted's groups)
                            set groupCorners to the length of (colourGroup's positions's values)
                            if groupCorners > 0:
                                loop corner from 0 to groupCorners:
                                    set point to the item at corner in (colourGroup's positions's values)
                                    set low to a cad vector3 with x (the minimum of low's x and point's x), y (the minimum of low's y and point's y) and z (the minimum of low's z and point's z)
                                    set high to a cad vector3 with x (the maximum of high's x and point's x), y (the maximum of high's y and point's y) and z (the maximum of high's z and point's z)
                                append (@intrinsic("construct", a bim scene mesh record, elementId, 0 as a 64 bit integer, colourGroup, category, the bim ifc mesh colour of (the item at groupCursor in (painted's colours)), the string form of "")) to (meshes's values)
                                if prototypeBase >= 0:
                                    append (prototypeBase + groupCursor) to (placements's prototypeOf's values)
                                    append bim ifc rows of (reader's lastMappedAxes) to (placements's transforms's values)
                                else:
                                    append -1 to (placements's prototypeOf's values)
                                    loop rowCursor from 0 to 12:
                                        append (the item at rowCursor in identityRows) to (placements's transforms's values)
                                set cornerCount to cornerCount + groupCorners
                        free bim ifc painted (the address of painted)
                        if cornerCount > 0:
                            set triangles to triangles + (cornerCount / 3)
                            set label to ((the bim ifc class name of className) + (the string form of " ")) + (((the bim step string of (the bim step argument 0 of productValue) in productValue) + (the string form of " ")) + (the bim step string of (the bim step argument 2 of productValue) in productValue))
                            append label to (labels's values)
                            append identifier to labelSources
                            append (the bim ifc storey of identifier among containerOf and storeyAt) to (storeys's ofElements's values)
                            set element to element + 1
                    free bim step instance productValue
        set message to ((the string form of "openings cut in ") + (the string form of voidedCount)) + (the string form of " hosts")
        if (the length of (reader's skipped)) > 0:
            set message to (message + (the string form of "; not read: ")) + ((reader's skipped) joined with ", ")
        free voidHosts
        free voidOpenings
        free voidNext
        free slotHosts
        free slotHeads
        free productTypes
        free storeyAt
        free containerOf
        free skippedAt
        free firstPrototypes
        free identityRows
        # The elements' property sets, keyed by their index in the import.
        set psetWanted to an empty list of a boolean
        set indexOf to an empty list of an integer
        loop identifier from 0 to instanceTotal:
            append false to psetWanted
            append -1 to indexOf
        loop elementCursor from 0 to the length of labelSources:
            set sourceId to the item at elementCursor in labelSources
            replace item at index sourceId in psetWanted with true
            replace item at index sourceId in indexOf with elementCursor
        set gathered to the bim ifc psets of stepFile wanted psetWanted scaled reader's lengthScale
        set elementPsets to a cad topology list of a bim pset entry record
        loop psetCursor from 0 to the length of gathered:
            set gatheredEntry to the item at psetCursor in gathered
            append (@intrinsic("construct", a bim pset entry record, (the item at (gatheredEntry's elementId as an integer) in indexOf) as a 64 bit integer, gatheredEntry's setName, gatheredEntry's name, gatheredEntry's valueType, gatheredEntry's value)) to (elementPsets's values)
        free gathered
        free psetWanted
        free indexOf
        free labelSources
        return @intrinsic("construct", a bim import record, true, message, meshes, labels, triangles, low, high, a cad topology list of a cad vector3, storeys, placements, elementPsets)

# IFCWALLSTANDARDCASE written as IfcWallStandardCase is not known without
# the schema; the class is shown as IfcWallstandardcase (Ifc and the rest
# lowered), which still names it.
function the bim ifc class name of {a string:className}:
    execute:
        if (the length of className) < 3:
            return className
        set result to a new string buffer containing (the length of className) bytes
        loop cursor from 0 to the length of className:
            set code to ((the character at cursor in className) as a 32 bit integer) bitwise and 255
            if ((cursor = 1) or (cursor = 2)) or (cursor > 3):
                if (code >= 65) and (code <= 90):
                    set code to code + 32
            store (code as a byte) into the data of result at cursor
        return result

# Whether `path` names an IFC STEP file (.ifc, in any case).
function bim path {a string:filePath} is step ifc:
    execute:
        set size to the length of filePath
        if size < 4:
            return false
        return (the lowercase form of (the substring of filePath from (size - 4) spanning 4 bytes)) = (the string form of ".ifc")
