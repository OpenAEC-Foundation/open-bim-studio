# SPDX-License-Identifier: MPL-2.0
# Straight, horizontal IFC grid axes made editable. AxisTag belongs to the
# axis, not to the containing IfcGrid. Curved and tilted axes are left out:
# a native straight grid must never silently flatten them.
# https://standards.buildingsmart.org/IFC/RELEASE/IFC4_3/HTML/lexical/IfcGridAxis.htm
import ifc/bim_ifc_read.dl

class:
    patterns:
        [a|] bim ifc native grid record
    members:
        sourceKey as a string
        name as a string
        start as a cad vector2
        finish as a cad vector2
        elevation as a 64 bit floating-point number

function the bim ifc native grids in {a pointer to a bim ifc reader record:reader}:
    execute:
        set found to a cad topology list of a bim ifc native grid record
        set gridIds to the bim step instances of type (the string form of "IFCGRID") in (reader's stepFile)
        loop gridCursor from 0 to the length of gridIds:
            set gridValue to the bim step instance (the item at gridCursor in gridIds) in (reader's stepFile)
            set gridGuid to the bim step string of (the bim step argument 0 of gridValue) in gridValue
            set placementId to the bim step reference of (the bim step argument 5 of gridValue) in gridValue
            set frame to the bim ifc object axes placementId in reader
            # UAxes, VAxes and optional WAxes, in file order.
            loop directionCursor from 7 to 10:
                set axes to the bim step argument directionCursor of gridValue
                loop axisCursor from 0 to the bim step count of axes in gridValue:
                    set axisId to the bim step reference of (the bim step member axisCursor of axes in gridValue) in gridValue
                    if bim step instance axisId is a "IFCGRIDAXIS" in (reader's stepFile):
                        set axisValue to the bim step instance axisId in (reader's stepFile)
                        set curveId to the bim step reference of (the bim step argument 1 of axisValue) in axisValue
                        if bim step instance curveId is a "IFCPOLYLINE" in (reader's stepFile):
                            set points to the bim ifc polyline of curveId in reader
                            if (the length of points) = 2:
                                set first to the bim ifc placed (the item at 0 in points) through frame
                                set last to the bim ifc placed (the item at 1 in points) through frame
                                if (the bim step raw text of (the bim step argument 2 of axisValue) in axisValue) = (the string form of "F"):
                                    set held to first
                                    set first to last
                                    set last to held
                                set startPoint to a cad vector2 with x first's x and y first's y
                                set finishPoint to a cad vector2 with x last's x and y last's y
                                set horizontal to (the absolute value of (first's z - last's z)) < 0.000001
                                set finite to ((the absolute value of first's z) < 1e100) and (((the absolute value of startPoint's x) < 1e100) and (((the absolute value of startPoint's y) < 1e100) and (((the absolute value of finishPoint's x) < 1e100) and ((the absolute value of finishPoint's y) < 1e100))))
                                if (horizontal and finite) and ((the cad distance from startPoint to finishPoint) > 0.000001):
                                    set axisName to the bim step string of (the bim step argument 0 of axisValue) in axisValue
                                    # IfcGridAxis has no GlobalId. This key is
                                    # import bookkeeping, never an IFC GlobalId.
                                    set sourceKey to (gridGuid + (the string form of "/axis/")) + (the string form of axisId)
                                    if (the length of gridGuid) = 0:
                                        set sourceKey to the string form of ""
                                    append (@intrinsic("construct", a bim ifc native grid record, sourceKey, axisName, startPoint, finishPoint, first's z)) to (found's values)
                            free points
                        free bim step instance axisValue
            free bim step instance gridValue
        free gridIds
        return found
