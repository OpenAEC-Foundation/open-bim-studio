# SPDX-License-Identifier: MPL-2.0
import graphics/bim_vector_reference.dl

function check vector reference {boolean:condition} named {a string:name}:
    execute:
        if condition:
            print ((the string form of "PASS ") + name) as a line
        else:
            print ((the string form of "FAIL ") + name) as a line

set canvas to a new bim canvas
set transform to @intrinsic("construct", a bim drawing transform record, a cad vector2 with x 100.0 and y 200.0, a cad vector2 with x 1.0 and y 2.0, 10.0)
check vector reference (record bim vector batch (the string form of "255 64 0 1 2 2 2 1 3") through transform on (the address of canvas)) named (the string form of "valid triangle")
set batch to the item at 0 in (canvas's batches's values)
set pixel to the item at 2 in (batch's pixels's values)
check vector reference ((pixel's x = 100.0) and (pixel's y = 190.0)) named (the string form of "model to paper transform")
check vector reference ((batch's red = 255) and (batch's green = 64)) named (the string form of "source colours")
check vector reference ((record bim vector batch (the string form of "0 0 0 1 2 3") through transform on (the address of canvas)) = false) named (the string form of "incomplete triangle rejected")
check vector reference ((record bim vector batch (the string form of "0 0 0 1 2 bad 2 1 3") through transform on (the address of canvas)) = false) named (the string form of "malformed coordinate rejected")
check vector reference ((record bim vector batch (the string form of "256 0 0 1 2 2 2 1 3") through transform on (the address of canvas)) = false) named (the string form of "invalid colour rejected")
check vector reference ((the length of (canvas's batches's values)) = 1) named (the string form of "invalid artwork is atomic")
set modelValue to an empty bim model
set bim property (the string form of "SourceArtwork") of set (the string form of "OpenBIM_Drawing") of (20 as a 64 bit integer) to (the string form of "true") typed (the string form of "IfcBoolean") in (the address of modelValue)
check vector reference (bim sheet (20 as a 64 bit integer) uses source artwork in modelValue) named (the string form of "source sheet owns its frame")
check vector reference ((bim sheet (21 as a 64 bit integer) uses source artwork in modelValue) = false) named (the string form of "normal sheet keeps its frame")
