# SPDX-License-Identifier: MPL-2.0
# Hide Element (HH) and Restore (HR) in the editor: with nothing selected or
# no view nothing is hidden; a wall hidden in the plan is cleared from the
# selection, hidden there (phases or not) but not in 3D, passed over by a
# click and by a selection box; the model is not changed; another wall hidden
# in 3D stays shown in the plan; HR in the plan shows the first again and
# keeps the second hidden in 3D; opening another model hides nothing.
import editor/bim_editor.dl

function check hide test {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set firstWall to add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to target
set secondWall to add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 0.0 and y 3.0) to (a cad vector2 with x 4.0 and y 3.0) to target
commit bim transaction in (the address of (editor's documentValue))
refresh bim editor e
prepare bim editor views in e
set planView to editor's planViewId
set modelView to the bim model view id of editor
set revisionBefore to editor's documentValue's revision
check hide test ((planView != the bim refused id) and (modelView != the bim refused id)) named (the string form of "the plan and the 3D view have ids")

hide bim editor selection in view numbered planView in e
check hide test ((the length of (editor's hiddenElements's values)) = 0) named (the string form of "nothing selected: nothing hidden")
select bim editor bim wall picked numbered firstWall in e
hide bim editor selection in view numbered (the bim refused id) in e
check hide test ((the length of (editor's hiddenElements's values)) = 0) named (the string form of "no view: nothing hidden")

hide bim editor selection in view numbered planView in e
check hide test (bim editor hides (firstWall) in plan of editor) named (the string form of "HH in the plan hides the wall there")
check hide test ((bim editor hides (firstWall) in model view of editor) = false) named (the string form of "the 3D view still shows it")
check hide test (editor's selectionKind = bim nothing picked) named (the string form of "the selection is cleared")
check hide test ((the bim phase look of element firstWall in plan of editor) = bim phase hidden look) named (the string form of "the plan draws it hidden without phases")
select bim editor bim wall picked numbered firstWall in e
hide bim editor selection in view numbered planView in e
check hide test ((the length of (editor's hiddenElements's values)) = 1) named (the string form of "HH twice hides it once")
check hide test ((editor's documentValue's revision = revisionBefore) and ((the length of (editor's documentValue's current's walls's values)) = 2)) named (the string form of "the model is not changed")

move bim editor pointer to (a cad vector2 with x 2.0 and y 0.0) within 0.1 in e
select bim editor element at (a cad vector2 with x 2.0 and y 0.0) in e
check hide test ((editor's selectionKind != bim wall picked) or (editor's selectionId != firstWall)) named (the string form of "a click passes over the hidden wall")
set outlines to the bim selection outlines of editor in plan true
set outlinedFirst to false
loop cursor from 0 to the length of outlines:
    if (the item at cursor in outlines)'s id = firstWall:
        set outlinedFirst to true
check hide test (outlinedFirst = false) named (the string form of "a selection box passes over it")

select bim editor bim wall picked numbered secondWall in e
hide bim editor selection in view numbered modelView in e
check hide test ((bim editor hides (secondWall) in model view of editor) and ((bim editor hides (secondWall) in plan of editor) = false)) named (the string form of "a wall hidden in 3D still shows in the plan")

restore bim editor hidden elements in view numbered planView in e
check hide test ((bim editor hides (firstWall) in plan of editor) = false) named (the string form of "HR in the plan shows the wall again")
check hide test (bim editor hides (secondWall) in model view of editor) named (the string form of "HR in the plan leaves 3D as it was")

load bim editor from text (the bim file text of editor's documentValue's current) named (the string form of "again.bim") in e
check hide test ((the length of (editor's hiddenElements's values)) = 0) named (the string form of "another model opened hides nothing")
