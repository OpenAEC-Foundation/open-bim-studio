# SPDX-License-Identifier: MPL-2.0
# Semantic model, formulas, references and transactions of the BIM slice.
import model/bim_model.dl

function check bim model {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print label as a line
            @intrinsic("call", "libc", "exit", nothing, 1)

function a bim test point at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y}:
    execute:
        return a cad vector2 with x x and y y

set documentValue to a new bim document
begin bim transaction in (the address of documentValue)
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to (the address of (documentValue's current))
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.12)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.1)) to layerValues
set exteriorType to add bim wall type named (the string form of "Cavity wall") with layerValues to (the address of (documentValue's current))
free layerValues
set innerLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.1)) to innerLayers
set interiorType to add bim wall type named (the string form of "Partition") with innerLayers to (the address of (documentValue's current))
free innerLayers
commit bim transaction in (the address of documentValue)
check bim model ((storey > 0) and ((exteriorType > storey) and (interiorType > exteriorType))) named "stable ids increase"

begin bim transaction in (the address of documentValue)
set south to add bim wall typed exteriorType on storey from (a bim test point at 0.0 and 0.0) to (a bim test point at 6.0 and 0.0) to (the address of (documentValue's current))
set east to add bim wall typed exteriorType on storey from (a bim test point at 6.0 and 0.0) to (a bim test point at 6.0 and 4.0) to (the address of (documentValue's current))
set north to add bim wall typed exteriorType on storey from (a bim test point at 6.0 and 4.0) to (a bim test point at 0.0 and 4.0) to (the address of (documentValue's current))
set west to add bim wall typed exteriorType on storey from (a bim test point at 0.0 and 4.0) to (a bim test point at 0.0 and 0.0) to (the address of (documentValue's current))
set middle to add bim wall typed interiorType on storey from (a bim test point at 3.0 and 0.0) to (a bim test point at 3.0 and 4.0) to (the address of (documentValue's current))
set refused to add bim wall typed exteriorType on storey from (a bim test point at 1.0 and 1.0) to (a bim test point at 1.0 and 1.0) to (the address of (documentValue's current))
check bim model (refused = the bim refused id) named "zero-length wall refused"
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to (the address of (documentValue's current))
set window to add bim opening typed windowType in south at 1.5 to (the address of (documentValue's current))
set door to add bim opening typed windowType in middle at 2.0 to (the address of (documentValue's current))
set measured to add bim dimension from (a bim reference to west feature bim wall interior feature) to (a bim reference to middle feature bim wall exterior feature) to (the address of (documentValue's current))
commit bim transaction in (the address of documentValue)

set current to documentValue's current
print ((the string form of "walls ") + (the string form of (the length of (current's walls's values)))) as a line
print ((the string form of "openings ") + (the string form of (the length of (current's openings's values)))) as a line
set cavity to the item at (the bim wall type index of exteriorType in current)'s position in (current's wallTypes's values)
print ((the string form of "cavity thickness ") + (the string form of (the bim thickness of cavity))) as a line
set windowValue to the item at (the bim opening type index of windowType in current)'s position in (current's openingTypes's values)
print ((the string form of "rough width ") + (the string form of (the bim rough width of windowValue))) as a line
print ((the string form of "head height ") + (the string form of (the bim head height of windowValue))) as a line
check bim model ((the bim wall index of (999 as a 64 bit integer) in current)'s valid = false) named "missing id"

# A refused edit leaves the model as it was.
begin bim transaction in (the address of documentValue)
set badMove to move bim wall south to (a bim test point at 2.0 and 2.0) and (a bim test point at 2.0 and 2.0) in (the address of (documentValue's current))
check bim model (badMove = false) named "degenerate move refused"
roll back bim transaction in (the address of documentValue)
check bim model ((the length of (documentValue's undoStack's values)) = 2) named "rollback restores undo depth"

# Undo and redo restore whole snapshots.
begin bim transaction in (the address of documentValue)
check bim model (move bim wall middle to (a bim test point at 2.5 and 0.0) and (a bim test point at 2.5 and 4.0) in (the address of (documentValue's current))) named "move wall"
check bim model (set bim opening type windowType sized 1.0 by 1.4 with sill 0.8 in (the address of (documentValue's current))) named "edit type"
commit bim transaction in (the address of documentValue)
set moved to the item at (the bim wall index of middle in documentValue's current)'s position in (documentValue's current's walls's values)
print ((the string form of "moved x ") + (the string form of moved's start's x)) as a line
check bim model (undo bim transaction in (the address of documentValue)) named "undo"
set restored to the item at (the bim wall index of middle in documentValue's current)'s position in (documentValue's current's walls's values)
print ((the string form of "undone x ") + (the string form of restored's start's x)) as a line
set restoredType to the item at (the bim opening type index of windowType in documentValue's current)'s position in (documentValue's current's openingTypes's values)
print ((the string form of "undone width ") + (the string form of restoredType's width)) as a line
check bim model (redo bim transaction in (the address of documentValue)) named "redo"
set redone to the item at (the bim wall index of middle in documentValue's current)'s position in (documentValue's current's walls's values)
print ((the string form of "redone x ") + (the string form of redone's start's x)) as a line

# Deleting a host removes its openings and the dimensions that refer to it.
begin bim transaction in (the address of documentValue)
check bim model (delete bim wall middle from (the address of (documentValue's current))) named "delete wall"
commit bim transaction in (the address of documentValue)
set afterLine to (the string form of "after delete walls ") + (the string form of (the length of (documentValue's current's walls's values)))
set afterLine to (afterLine + (the string form of " openings ")) + (the string form of (the length of (documentValue's current's openings's values)))
set afterLine to (afterLine + (the string form of " dimensions ")) + (the string form of (the length of (documentValue's current's dimensions's values)))
print afterLine as a line
check bim model (undo bim transaction in (the address of documentValue)) named "undo delete"
print ((the string form of "restored dimensions ") + (the string form of (the length of (documentValue's current's dimensions's values)))) as a line
check bim model (measured > door) named "dimension id"
print ((the string form of "revision ") + (the string form of documentValue's revision)) as a line
