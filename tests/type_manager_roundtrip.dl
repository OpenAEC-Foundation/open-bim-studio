# SPDX-License-Identifier: MPL-2.0
# Edited unused definitions survive the editor's real IFCX save/open route.
import editor/bim_type_manager.dl

function check type roundtrip {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set editor to a new bim editor
set editTarget to the address of editor
set editor's lengthUnit to bim millimetre unit
set typeIds to an empty list of a 64 bit integer
set originalRows to an empty list of a bim managed type record
loop tabIndex from 0 to 9:
    set typeId to add bim managed type on tab tabIndex in editTarget
    set prepared to typeId != the bim refused id
    if tabIndex = 8:
        # Profiles is a catalog-filtered view of linear types. Give the new
        # beam a real profile definition before editing it through that tab.
        give bim linear type typeId profile bim i shape profile web 0.012 flange 0.02 fillet 0.003 fourth 0.0 series 1 in (the address of (editor's documentValue's current))
    set customName to (the string form of "Edited IFC type é ") + (the string form of tabIndex)
    set prepared to (set bim managed type typeId on tab tabIndex layer 0 field 0 to customName in editTarget) and prepared
    set widthText to the string form of (350 + (tabIndex * 10))
    set prepared to (set bim managed type typeId on tab tabIndex layer 0 field 2 to widthText in editTarget) and prepared
    if tabIndex < 4:
        set prepared to (set bim managed type typeId on tab tabIndex layer 0 field 1 to (the string form of "béton") in editTarget) and prepared
        set prepared to (change bim managed type typeId layer 0 by 1 in editTarget) and prepared
        set prepared to (set bim managed type typeId on tab tabIndex layer 1 field 1 to (the string form of "insulation") in editTarget) and prepared
        set prepared to (set bim managed type typeId on tab tabIndex layer 1 field 2 to (the string form of "80") in editTarget) and prepared
    else:
        if tabIndex != 7:
            set prepared to (set bim managed type typeId on tab tabIndex layer 0 field 1 to (the string form of "steel") in editTarget) and prepared
        if tabIndex != 6:
            set depthText to the string form of (500 + (tabIndex * 10))
            set prepared to (set bim managed type typeId on tab tabIndex layer 0 field 3 to depthText in editTarget) and prepared
        if tabIndex = 7:
            set prepared to (set bim managed type typeId on tab tabIndex layer 0 field 4 to (the string form of "250") in editTarget) and prepared
    set prepared to (set bim managed type typeId on tab tabIndex layer 0 field 5 to (the string form of "22.10") in editTarget) and prepared
    set prepared to (set bim managed type typeId on tab tabIndex layer 0 field 6 to (the string form of "21-02 10 10") in editTarget) and prepared
    check type roundtrip prepared named ((the string form of "prepare edited definition on tab ") + (the string form of tabIndex))
    append typeId to typeIds
    append (the bim managed type typeId on tab tabIndex in editor's documentValue's current) to originalRows
set originalNextId to editor's documentValue's current's nextId
set noOccurrences to (((the length of (editor's documentValue's current's walls's values)) = 0) and ((the length of (editor's documentValue's current's linears's values)) = 0)) and (((the length of (editor's documentValue's current's instances's values)) = 0) and ((the length of (editor's documentValue's current's slabs's values)) = 0))
set noOccurrences to noOccurrences and (((the length of (editor's documentValue's current's openings's values)) = 0) and ((the length of (editor's documentValue's current's curtains's values)) = 0))
check type roundtrip noOccurrences named (the string form of "type editing created definitions without occurrences")
set savedPath to the string form of "type-manager-roundtrip-test.ifcx"
save bim editor to savedPath in editTarget
check type roundtrip (editor's message = ((the string form of "Saved ") + savedPath)) named (the string form of "editor saves edited type definitions as IFCX")
set reopened to a new bim editor
open bim editor from savedPath in (the address of reopened)
check type roundtrip (reopened's message = ((the string form of "Opened ") + savedPath)) named (the string form of "editor reopens the saved IFCX file")
check type roundtrip (reopened's documentValue's current's nextId = originalNextId) named (the string form of "IFCX preserves the native id allocator")
loop tabIndex from 0 to 9:
    set typeId to the item at tabIndex in typeIds
    set original to the item at tabIndex in originalRows
    set restored to the bim managed type typeId on tab tabIndex in reopened's documentValue's current
    check type roundtrip ((restored's id = typeId) and (restored's family = original's family)) named ((the string form of "stable type id and tab membership survive on tab ") + (the string form of tabIndex))
    check type roundtrip (((restored's name = original's name) and (restored's ifcClass = original's ifcClass)) and ((restored's role = original's role) and (restored's material = original's material))) named ((the string form of "edited name IFC class role and material survive on tab ") + (the string form of tabIndex))
    set sameDimensions to ((the absolute value of (restored's width - original's width)) < 1e-9) and ((the absolute value of (restored's depth - original's depth)) < 1e-9)
    set sameDimensions to sameDimensions and (((the absolute value of (restored's sill - original's sill)) < 1e-9) and (restored's round = original's round))
    check type roundtrip sameDimensions named ((the string form of "edited dimensions and shape flags survive on tab ") + (the string form of tabIndex))
    set nlsfbBefore to the bim setting (bim nlsfb setting) of typeId in editor's documentValue's current
    set nlsfbAfter to the bim setting (bim nlsfb setting) of typeId in reopened's documentValue's current
    set omniBefore to the bim setting (bim omniclass setting) of typeId in editor's documentValue's current
    set omniAfter to the bim setting (bim omniclass setting) of typeId in reopened's documentValue's current
    check type roundtrip ((nlsfbAfter's found and (nlsfbAfter's value = nlsfbBefore's value)) and (omniAfter's found and (omniAfter's value = omniBefore's value))) named ((the string form of "both edited classification settings survive on tab ") + (the string form of tabIndex))
    if tabIndex < 4:
        set originalFound to the bim wall type index of typeId in editor's documentValue's current
        set restoredFound to the bim wall type index of typeId in reopened's documentValue's current
        set oldLayers to (the item at originalFound's position in (editor's documentValue's current's wallTypes's values))'s layers
        set newLayers to (the item at restoredFound's position in (reopened's documentValue's current's wallTypes's values))'s layers
        set sameLayers to (the length of (newLayers's values)) = 2
        loop layerIndex from 0 to (the minimum of (the length of (oldLayers's values)) and (the length of (newLayers's values))):
            set oldLayer to the item at layerIndex in (oldLayers's values)
            set newLayer to the item at layerIndex in (newLayers's values)
            set sameLayers to sameLayers and ((oldLayer's material = newLayer's material) and ((the absolute value of (oldLayer's thickness - newLayer's thickness)) < 1e-9))
        check type roundtrip sameLayers named ((the string form of "ordered materials and layer thicknesses survive on tab ") + (the string form of tabIndex))
set profileId to the item at 8 in typeIds
set profileFound to the bim linear type index of profileId in reopened's documentValue's current
set profileType to the item at profileFound's position in (reopened's documentValue's current's linearTypes's values)
set restoredProfile to the bim profile of linear type profileType in reopened's documentValue's current
check type roundtrip ((restoredProfile's kind = bim i shape profile) and (((the absolute value of (restoredProfile's web - 0.012)) < 1e-9) and ((the absolute value of (restoredProfile's flange - 0.02)) < 1e-9))) named (the string form of "catalog profile kind web and flange survive IFCX")
check type roundtrip (((the absolute value of (restoredProfile's fillet - 0.003)) < 1e-9) and ((the bim setting (bim steel series setting) of profileId in reopened's documentValue's current)'s value = (1 as a 64 bit integer))) named (the string form of "catalog profile fillet and series survive IFCX")
set noOccurrences to (((the length of (reopened's documentValue's current's walls's values)) = 0) and ((the length of (reopened's documentValue's current's linears's values)) = 0)) and (((the length of (reopened's documentValue's current's instances's values)) = 0) and ((the length of (reopened's documentValue's current's slabs's values)) = 0))
set noOccurrences to noOccurrences and (((the length of (reopened's documentValue's current's openings's values)) = 0) and ((the length of (reopened's documentValue's current's curtains's values)) = 0))
check type roundtrip noOccurrences named (the string form of "reopening definitions creates no model occurrences")
check type roundtrip ((the length of (reopened's documentValue's undoStack's values)) = 0) named (the string form of "reopened editor starts with clean undo history")
free originalRows
free typeIds
ignore @intrinsic("call", "libc", "remove", integer, the data of savedPath)
