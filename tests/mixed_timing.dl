# SPDX-License-Identifier: MPL-2.0
# Timing of a mixed model of about 10,000 elements, fresh and after a
# simulated project lifetime (risk R-12). The model: a generated tower of
# walls, a grid of columns on every storey, pipe runs joined into a water
# system, stairs and railings. Measured: the full evaluation, the meshes of
# the 3D view (with the network's fittings), the clash check, the schedule,
# and one edit (a column moved; the median of twenty) with its re-evaluation
# and re-meshing. The
# lifetime: 300 edits each undone, 400 elements added and deleted, 60 views
# duplicated and 30 systems made empty. R-12 passes when the measures after
# it are within 20 % of the fresh ones.
import editor/bim_editor.dl

class:
    patterns:
        [a|] bim timing record
    members:
        evaluation as a 64 bit integer
        meshes as a 64 bit integer
        clashes as a 64 bit integer
        schedule as a 64 bit integer
        edit as a 64 bit integer

function time bim mixed model {a pointer to a bim editor record:editor} moving {a 64 bit integer:columnId}:
    execute:
        set started to the bim microseconds now
        set editor's evaluation to the bim evaluation of editor's documentValue's current after (an empty bim evaluation)
        set evaluated to the bim microseconds now
        set sceneMeshes to the bim sketch meshes of editor's documentValue's current within 0.002
        set meshed to the bim microseconds now
        set clashList to the bim clashes of editor's documentValue's current
        set clashed to the bim microseconds now
        set rows to the bim schedule of editor's documentValue's current with editor's evaluation and (editor's spaces's values)
        set scheduled to the bim microseconds now
        # The editor's own refresh once first (the plan cut and the spaces),
        # as the window has done before any edit.
        refresh bim editor editor
        # One edit: a column moved half a metre and back, twenty times, each
        # re-evaluated incrementally and re-meshed; the median of them.
        set editTimes to an empty list of a 64 bit integer
        loop step from 0 to 20:
            set found to the bim linear index of columnId in editor's documentValue's current
            set movedColumn to the item at found's position in (editor's documentValue's current's linears's values)
            set shift to 0.5
            if (the remainder of step divided by 2) = 1:
                set shift to -0.5
            set editStart to the bim microseconds now
            begin bim transaction in (the address of (editor's documentValue))
            ignore move bim linear columnId to (a cad vector3 with x (movedColumn's start's x + shift), y movedColumn's start's y and z movedColumn's start's z) and (a cad vector3 with x (movedColumn's finish's x + shift), y movedColumn's finish's y and z movedColumn's finish's z) turned movedColumn's angle in (the address of (editor's documentValue's current))
            commit bim transaction in (the address of (editor's documentValue))
            refresh bim editor editor
            set editMeshes to the bim sketch meshes of editor's documentValue's current within 0.002
            append ((the bim microseconds now) - editStart) to editTimes
        # The median: the middle of the times in order.
        loop outer from 1 to the length of editTimes:
            set pending to the item at outer in editTimes
            set slot to outer
            loop while (slot > 0) and ((the item at (the maximum of 0 and (slot - 1)) in editTimes) > pending):
                replace item at index slot in editTimes with (the item at (slot - 1) in editTimes)
                set slot to slot - 1
            replace item at index slot in editTimes with pending
        set slowest to the item at 10 in editTimes
        free editTimes
        print ((the string form of "  clashes found ") + (the string form of (the length of (clashList's values)))) as a line
        return @intrinsic("construct", a bim timing record, evaluated - started, meshed - evaluated, clashed - meshed, scheduled - clashed, slowest)

function show bim timing {bim timing record:timing} labelled {a string:title}:
    execute:
        set line to (title + (the string form of ": evaluation ")) + (the string form of (timing's evaluation / (1000 as a 64 bit integer)))
        set line to (line + (the string form of " ms, meshes ")) + (the string form of (timing's meshes / (1000 as a 64 bit integer)))
        set line to (line + (the string form of " ms, clashes ")) + (the string form of (timing's clashes / (1000 as a 64 bit integer)))
        set line to (line + (the string form of " ms, schedule ")) + (the string form of (timing's schedule / (1000 as a 64 bit integer)))
        set line to (line + (the string form of " ms, one edit ")) + (the string form of (timing's edit / (1000 as a 64 bit integer)))
        print (line + (the string form of " ms")) as a line

function the bim drift of {a 64 bit integer:aged} over {a 64 bit integer:fresh}:
    execute:
        if fresh <= (0 as a 64 bit integer):
            return 0.0
        return (((aged - fresh) as a 64 bit floating-point number) * 100.0) / (fresh as a 64 bit floating-point number)

set editor to a new bim editor
set e to the address of editor
ignore add bim generated tower of 6000 walls with 50 rooms a side to e
set target to the address of (editor's documentValue's current)
set columnType to add bim linear type named (the string form of "Kolom") as role bim column role sized 0.3 by 0.3 round false of (the string form of "concrete") to target
set pipeType to add bim linear type named (the string form of "Leiding") as role bim pipe role sized 0.05 by 0.05 round true of (the string form of "copper") to target
set water to add bim system named (the string form of "Water 1") of discipline bim water discipline to target
set firstColumn to the bim refused id
set levelList to editor's documentValue's current's levels's values
set columnCount to 0
set pipeCount to 0
loop levelCursor from 0 to the length of levelList:
    set levelId to (the item at levelCursor in levelList)'s id
    set storeyHeight to (the item at levelCursor in levelList)'s height
    loop rowIndex from 0 to 10:
        loop columnIndex from 0 to 10:
            if columnCount < 2000:
                set placed to add bim linear typed columnType on levelId from (a cad vector3 with x ((columnIndex as a 64 bit floating-point number) * 6.1), y ((rowIndex as a 64 bit floating-point number) * 6.1) and z 0.0) to (a cad vector3 with x ((columnIndex as a 64 bit floating-point number) * 6.1), y ((rowIndex as a 64 bit floating-point number) * 6.1) and z storeyHeight) turned 0.0 to target
                if firstColumn = the bim refused id:
                    set firstColumn to placed
                set columnCount to columnCount + 1
    # Pipe runs under the ceiling, each ten pipes long, joined end to end.
    loop run from 0 to 10:
        loop piece from 0 to 10:
            if pipeCount < 1000:
                set fromX to (piece as a 64 bit floating-point number) * 3.0
                set runY to ((run as a 64 bit floating-point number) * 6.1) + 3.0
                set made to add bim linear typed pipeType on levelId from (a cad vector3 with x fromX, y runY and z (storeyHeight - 0.3)) to (a cad vector3 with x (fromX + 3.0), y runY and z (storeyHeight - 0.3)) turned 0.0 to target
                ignore assign bim element made to system water in target
                set pipeCount to pipeCount + 1
set elementCount to ((the length of (editor's documentValue's current's walls's values)) + (the length of (editor's documentValue's current's linears's values))) + (the length of (editor's documentValue's current's openings's values))
print ((the string form of "elements ") + (the string form of elementCount)) as a line
set fresh to time bim mixed model e moving firstColumn
show bim timing fresh labelled (the string form of "fresh")
# A project's lifetime.
loop cycle from 0 to 300:
    set found to the bim linear index of firstColumn in editor's documentValue's current
    set movedColumn to the item at found's position in (editor's documentValue's current's linears's values)
    begin bim transaction in (the address of (editor's documentValue))
    ignore move bim linear firstColumn to (a cad vector3 with x (movedColumn's start's x + 0.1), y movedColumn's start's y and z movedColumn's start's z) and (a cad vector3 with x (movedColumn's finish's x + 0.1), y movedColumn's finish's y and z movedColumn's finish's z) turned movedColumn's angle in (the address of (editor's documentValue's current))
    commit bim transaction in (the address of (editor's documentValue))
    ignore undo bim transaction in (the address of (editor's documentValue))
loop cycle from 0 to 400:
    begin bim transaction in (the address of (editor's documentValue))
    set temporary to add bim linear typed columnType on ((the item at 0 in (editor's documentValue's current's levels's values))'s id) from (a cad vector3 with x 500.0, y 500.0 and z 0.0) to (a cad vector3 with x 500.0, y 500.0 and z 3.0) turned 0.0 to target
    commit bim transaction in (the address of (editor's documentValue))
    begin bim transaction in (the address of (editor's documentValue))
    ignore delete bim linear temporary from target
    commit bim transaction in (the address of (editor's documentValue))
loop cycle from 0 to 60:
    if (the length of (editor's documentValue's current's views's values)) = 0:
        ignore ensure bim default views in target
    ignore duplicate bim view (the item at 0 in (editor's documentValue's current's views's values))'s id named (the string form of "Kopie") in target
loop cycle from 0 to 30:
    ignore add bim system named (the string form of "Leeg") of discipline bim heating discipline to target
set aged to time bim mixed model e moving firstColumn
show bim timing aged labelled (the string form of "aged")
set driftText to (the string form of "drift: evaluation ") + (the string form of (the rounded value of (the bim drift of aged's evaluation over fresh's evaluation)))
set driftText to (driftText + (the string form of " %, meshes ")) + (the string form of (the rounded value of (the bim drift of aged's meshes over fresh's meshes)))
set driftText to (driftText + (the string form of " %, clashes ")) + (the string form of (the rounded value of (the bim drift of aged's clashes over fresh's clashes)))
set driftText to (driftText + (the string form of " %, schedule ")) + (the string form of (the rounded value of (the bim drift of aged's schedule over fresh's schedule)))
set driftText to (driftText + (the string form of " %, one edit ")) + (the string form of (the rounded value of (the bim drift of aged's edit over fresh's edit)))
print (driftText + (the string form of " %")) as a line
