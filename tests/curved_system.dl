# SPDX-License-Identifier: MPL-2.0
# A curved building system: a 6 m line bowed 1 m is an arc of radius 5 m and
# 6.435 m long, so bays of at most 1.2 m make 6. Its mullions stand on the
# arc at equal lengths along it; its transoms and panels run straight from
# mullion to mullion, faceted as a curved curtain wall is built. The bulge
# survives the file and IfcX; a bulge past a half circle is refused.
import editor/bim_editor.dl

function the curved test text of {a 64 bit floating-point number:value}:
    execute:
        return the string form of ((@intrinsic("call", "libc", "round", a 64 bit floating-point number, value * 1000.0)) / 1000.0)

function show bim curved test of {bim model record:modelValue} labelled {a string:title}:
    execute:
        set curtainValue to the item at 0 in (modelValue's curtains's values)
        set curtainParts to the bim parts of curtain wall curtainValue in modelValue
        set course to the bim system path of curtainValue
        set mullions to 0
        set transoms to 0
        set panelCount to 0
        set worst to 0.0
        loop partCursor from 0 to the length of (curtainParts's values):
            set derivedPart to the item at partCursor in (curtainParts's values)
            if derivedPart's kind's name = (the string form of "Mullion"):
                set mullions to mullions + 1
                if course's curved:
                    set foot to derivedPart's element's start
                    set drift to the absolute value of ((the cad distance from (a cad vector2 with x foot's x and y foot's y) to course's centre) - course's radius)
                    set worst to the maximum of worst and drift
            else if derivedPart's kind's name = (the string form of "Transom"):
                set transoms to transoms + 1
            else:
                set panelCount to panelCount + 1
        print ((title + (the string form of ": length ")) + ((the curved test text of course's length) + ((the string form of ", bays ") + ((the string form of (the bim bay count of curtainValue)) + ((the string form of ", mullions ") + ((the string form of mullions) + ((the string form of ", transoms ") + ((the string form of transoms) + ((the string form of ", panels ") + ((the string form of panelCount) + ((the string form of ", off the arc ") + (the curved test text of worst)))))))))))) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to target
set curtainId to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "aluminium") to target
show bim curved test of modelValue labelled (the string form of "straight")
print ((the string form of "bowed 1 m: ") + (the string form of (set bim curtain wall curtainId bulge to 1.0 in target))) as a line
set course to the bim system path of (the item at 0 in (modelValue's curtains's values))
print ((the string form of "radius ") + (the curved test text of course's radius)) as a line
show bim curved test of modelValue labelled (the string form of "curved")
set apex to the bim system point at (course's length * 0.5) of (the item at 0 in (modelValue's curtains's values))
print ((the string form of "middle at ") + ((the curved test text of apex's x) + ((the string form of ", ") + (the curved test text of apex's y)))) as a line
set stationed to the bim system station of apex on (the item at 0 in (modelValue's curtains's values))
print ((the string form of "middle along ") + (the curved test text of stationed's x)) as a line
print ((the string form of "past a half circle refused: ") + (the string form of ((set bim curtain wall curtainId bulge to 3.5 in target) = false))) as a line
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", ") + reread's message))) as a line
show bim curved test of reread's modelValue labelled (the string form of "from .bim")
set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "c.ifcx") for project (the string form of "c") by (the string form of "test") at (the string form of "2026-10-13T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of ", ") + fromIfcx's message))) as a line
show bim curved test of fromIfcx's modelValue labelled (the string form of "from .ifcx")
# Merged joints on the curved system: one closed body, bent onto the arc so
# that none of it strays from the line by more than half its depth.
set bim setting (bim joint width setting) of curtainId to (20 as a 64 bit integer) keeping true in target
set bim setting (bim joint depth setting) of curtainId to (60 as a 64 bit integer) keeping true in target
set bim setting (bim merged joints setting) of curtainId to (1 as a 64 bit integer) keeping true in target
set bentValue to the item at 0 in (modelValue's curtains's values)
set bentParts to the bim parts of curtain wall bentValue in modelValue
set bentCells to a cad topology list of a bim stair part record
loop partCursor from 0 to the length of (bentParts's values):
    set bentPart to the item at partCursor in (bentParts's values)
    if (bentPart's kind's name != (the string form of "Mullion")) and (bentPart's kind's name != (the string form of "Transom")):
        append bentPart to (bentCells's values)
set bentJoints to the bim merged joints of bentValue lifted 0.0 among (bentCells's values) in modelValue
set bentCourse to the bim system path of bentValue
set straying to 0.0
loop cornerCursor from 0 to the length of (bentJoints's positions's values):
    set corner to the item at cornerCursor in (bentJoints's positions's values)
    set straying to the maximum of straying and (the absolute value of ((the cad distance from (a cad vector2 with x corner's x and y corner's y) to bentCourse's centre) - bentCourse's radius))
print ((the string form of "curved joints closed: ") + ((the string form of ((the fast mesh flaw of bentJoints) = 0)) + ((the string form of ", within half their depth: ") + (the string form of (straying <= 0.0301))))) as a line
print ((the string form of "curved joints volume: ") + (the curved test text of (the bim volume of mesh bentJoints))) as a line
