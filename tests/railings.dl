# SPDX-License-Identifier: MPL-2.0
# Railings as generators of linear posts and rails: a free railing along two
# segments of 4 and 3 m has posts a metre apart and at its corner; railings
# on a stair stand on its nosing line, rising from the floor to 2.82 m; all
# read back from .bim and .ifcx. Deleting the stair deletes its railings.
import graphics/bim_scene.dl
import formats/bim_file.dl
import formats/bim_ifcx.dl
import formats/bim_ifcx_read.dl

function show railing test railings of {bim model record:modelValue} labelled {a string:title}:
    execute:
        print title as a line
        loop cursor from 0 to the length of (modelValue's railings's values):
            set railingValue to the item at cursor in (modelValue's railings's values)
            set railingParts to the bim parts of railing railingValue in modelValue
            set posts to 0
            set lowFoot to 1e300
            set highTop to -1e300
            loop partCursor from 0 to the length of (railingParts's values):
                set derivedPart to the item at partCursor in (railingParts's values)
                if derivedPart's kind's name = (the string form of "Post"):
                    set posts to posts + 1
                    set lowFoot to the minimum of lowFoot and derivedPart's element's start's z
                set highTop to the maximum of highTop and (the maximum of derivedPart's element's start's z and derivedPart's element's finish's z)
            set hosted to railingValue's hostId != the bim refused id
            print ((the string form of "  ") + ((the string form of (the length of (railingParts's values))) + ((the string form of " parts, ") + ((the string form of posts) + ((the string form of " posts, on a stair ") + ((the string form of hosted) + ((the string form of ", lowest foot ") + ((the string form of ((the rounded value of (lowFoot * 10000.0)) / 10000.0)) + ((the string form of ", highest top ") + (the string form of ((the rounded value of (highTop * 10000.0)) / 10000.0))))))))))) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to target
set stairId to add bim stair on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 3.6 and y 0.0) wide 1.0 in 17 risers of (the string form of "timber") to target
set path to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 5.0) to path
append (a cad vector2 with x 4.0 and y 5.0) to path
append (a cad vector2 with x 4.0 and y 8.0) to path
set freeRailing to add bim railing on ground along path hosted by (the bim refused id) rising 1.0 of (the string form of "steel") to target
set stairValue to the item at 0 in (modelValue's stairs's values)
set sidePaths to the bim railing paths of stair stairValue
loop cursor from 0 to the length of sidePaths:
    ignore add bim railing on ground along (the item at cursor in sidePaths) hosted by stairId rising 0.9 of (the string form of "steel") to target
show railing test railings of modelValue labelled (the string form of "railings:")
set railingShape to the bim railing shape of (the item at 0 in (modelValue's railings's values)) in modelValue within 0.0
print ((the string form of "free railing mesh triangles ") + (the string form of ((the length of (railingShape's triangles's values)) / 3))) as a line
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", ") + reread's message))) as a line
show railing test railings of reread's modelValue labelled (the string form of "from .bim:")
set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "r.ifcx") for project (the string form of "r") by (the string form of "test") at (the string form of "2026-10-09T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of ", ") + fromIfcx's message))) as a line
show railing test railings of fromIfcx's modelValue labelled (the string form of "from .ifcx:")
ignore delete bim stair stairId from target
print ((the string form of "railings after deleting the stair ") + (the string form of (the length of (modelValue's railings's values)))) as a line
