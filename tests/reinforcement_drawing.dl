# SPDX-License-Identifier: MPL-2.0
import graphics/bim_reinforcement_drawing.dl
import formats/bim_file.dl

function check reinforcement drawing {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set loaded to the bim model parsed from (the string form of "BIM-SLICE 1\nnext 4\nlevel 1 0 3 Ground\nreinforcement 2 1 -1 1 0 0 0 3 0 0 0.3 0.5 0.016 0.008 0.15 0.15 0.035 0.024 A\ntag 3 2 1 -1\n")
check reinforcement drawing loaded's valid named (the string form of "drawing fixture loads")
set labels to the bim reinforcement plan labels of loaded's modelValue ascii true
check reinforcement drawing labels's valid named (the string form of "tagged cage labels generated")
check reinforcement drawing ((the length of (labels's labels's values)) = 3) named (the string form of "top bottom and stirrups receive separate labels")
set upper to the item at 0 in (labels's labels's values)
set lower to the item at 1 in (labels's labels's values)
check reinforcement drawing ((upper's text = (the string form of "pos A-T: 2 D16 B")) and (lower's text = (the string form of "pos A-B: 2 D16 K"))) named (the string form of "drawing labels use Dutch project notation")
check reinforcement drawing ((upper's lineIndex = 0) and ((lower's lineIndex = 1) and (upper's place's y = -1.0))) named (the string form of "label stack follows explicit tag placement")
set spec to the item at 0 in (loaded's modelValue's reinforcements's values)
set generated to the bim reinforcement paths of spec in loaded's modelValue
set firstBar to the item at 0 in (generated's bars's values)
check reinforcement drawing ((the cad distance from upper's anchor to (the item at 0 in (firstBar's points's values))) < 1e-9) named (the string form of "leader anchors to generated bar geometry")
set target to the address of (loaded's modelValue)
set bim setting (bim drawing standard setting) of (0 as a 64 bit integer) to ((bim iso standard) as a 64 bit integer) keeping true in target
set international to the bim reinforcement plan labels of loaded's modelValue ascii true
check reinforcement drawing ((the item at 0 in (international's labels's values))'s text = (the string form of "mark A-T: 2 D16 top")) named (the string form of "drawing labels follow international project standard")
set spec's topCount to 3
set spec's start's y to 2.0
set spec's finish's y to 2.0
ignore store bim reinforcement spec in target
set edited to the bim reinforcement plan labels of loaded's modelValue ascii true
check reinforcement drawing edited's valid named (the string form of "edited cage labels regenerate")
set editedUpper to the item at 0 in (edited's labels's values)
check reinforcement drawing (editedUpper's text = (the string form of "mark A-T: 3 D16 top")) named (the string form of "parametric bar count updates drawing text")
check reinforcement drawing ((the absolute value of ((editedUpper's anchor's y - upper's anchor's y) - 2.0)) < 1e-9) named (the string form of "leader follows moved reinforcement")
set spec's finish to spec's start
replace item at index 0 in (target's reinforcements's values) with spec
set invalidLabels to the bim reinforcement plan labels of loaded's modelValue ascii true
check reinforcement drawing ((invalidLabels's valid = false) and ((the length of (invalidLabels's labels's values)) = 0)) named (the string form of "invalid geometry refuses misleading drawing quantities")
clear (target's tags's values)
set untagged to the bim reinforcement plan labels of loaded's modelValue ascii true
check reinforcement drawing (untagged's valid and ((the length of (untagged's labels's values)) = 0)) named (the string form of "untagged reinforcement does not create automatic labels")
