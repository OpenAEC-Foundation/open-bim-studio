# SPDX-License-Identifier: MPL-2.0
import model/bim_opening_detail.dl
import model/bim_system_types.dl
import formats/bim_file.dl

function check opening detail {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 2.0 with height 3.0 to target
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.20)) to layerValues
set wallType to add bim wall type named (the string form of "Wall") with layerValues to target
set wallId to add bim wall typed wallType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set windowType to add bim opening type named (the string form of "Window") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
set openingId to add bim opening typed windowType in wallId at 3.0 to target
set systemId to add bim system in opening openingId with joint (34 as a 64 bit integer) in bays of 0.6 by 0.75 of (the string form of "timber") to target
set added to add bim opening detail to systemId in target
if added = false:
    print ((the string form of "system id: ") + (the string form of systemId)) as a line
    print ((the string form of "opening id: ") + (the string form of openingId)) as a line
    print ((the string form of "resolved opening: ") + (the string form of (the bim detail opening of systemId in modelValue))) as a line
    print (the bim file text of modelValue) as a line
check opening detail added named (the string form of "hosted frame resolves to opening detail")
set parts to the bim opening detail parts of openingId in modelValue
check opening detail ((the length of (parts's values)) = 4) named (the string form of "two reveals head and sill")
set leftPart to the item at 0 in (parts's values)
check opening detail ((the absolute value of (leftPart's element's start's x - 2.369)) < 1e-9) named (the string form of "reveal sits inside rough opening")
set openingValue to the item at 0 in (target's openings's values)
set openingValue's offset to 4.0
replace item at index 0 in (target's openings's values) with openingValue
set movedParts to the bim opening detail parts of openingId in modelValue
check opening detail ((the absolute value of ((the item at 0 in (movedParts's values))'s element's start's x - 3.369)) < 1e-9) named (the string form of "detail follows moved opening")
set savedText to the bim file text of modelValue
set readback to the bim model parsed from savedText
check opening detail readback's valid named (the string form of "detail settings round trip")
check opening detail ((the length of ((the bim opening detail parts of openingId in readback's modelValue)'s values)) = 4) named (the string form of "detail regenerates after load")
set library to the bim system types
check opening detail ((the item at 3 in library)'s name = (the string form of "Kozijn hout 67x114")) named (the string form of "legacy recipe identity preserved")
check opening detail ((the length of library) = 33) named (the string form of "twelve window layouts added")
check opening detail (give bim system systemId type 32 in target) named (the string form of "three-panel layout applied")
set systemValue to the item at (the bim curtain index of systemId in modelValue)'s position in (target's curtains's values)
check opening detail ((the absolute value of (systemValue's bayWidth - (1.232001 / 3.0))) < 1e-9) named (the string form of "layout fits hosted opening")
