# SPDX-License-Identifier: MPL-2.0
# Needless decimals: a wall whose end missed its snap by a fraction of a
# millimetre and a storey typed in the wrong unit are listed; rounding puts
# them on whole millimetres as one edit, after which the check finds
# nothing, and undo brings the fractions back.
import editor/bim_editor.dl

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set wallTypeId to (the item at 0 in (editor's documentValue's current's wallTypes's values))'s id
set levelId to (the item at 0 in (editor's documentValue's current's levels's values))'s id
ignore (add bim wall typed wallTypeId on levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0004 and y 0.0) to target)
ignore (add bim wall typed wallTypeId on levelId from (a cad vector2 with x 4.0004 and y 0.0) to (a cad vector2 with x 4.0004 and y 3.0) to target)
ignore (set bim level levelId at 0.0 with height 3.0000001 in target)
commit bim transaction in (the address of (editor's documentValue))
set warnings to the bim decimal warnings of editor's documentValue's current
print ((the string form of "warnings: ") + (the string form of (the length of (warnings's values)))) as a line
loop cursor from 0 to the length of (warnings's values):
    set warning to the item at cursor in (warnings's values)
    print ((the string form of "  ") + (warning's what + ((the string form of " ") + (the string form of ((@intrinsic("call", "libc", "round", a 64 bit floating-point number, warning's value * 1000000.0)) / 1000.0))))) as a line
type bim editor key 2125 in e
print editor's message as a line
type bim editor key 2126 in e
print editor's message as a line
set after to the bim decimal warnings of editor's documentValue's current
print ((the string form of "after rounding: ") + (the string form of (the length of (after's values)))) as a line
type bim editor key 90 in e
set undone to the bim decimal warnings of editor's documentValue's current
print ((the string form of "after undo: ") + (the string form of (the length of (undone's values)))) as a line
