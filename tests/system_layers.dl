# SPDX-License-Identifier: MPL-2.0
# Layered building systems and the examples. A timber-frame wall 3.6 m long
# has 7 studs (38 x 140 at 600), top and bottom rails and 6 fields of
# insulation; its plywood layer, 79 mm out, is 3 boards of 1.2 m and no
# joints; its plasterboard layer lies 76 mm in. The hollow-core floor lies
# level 3 m up: 5 planks of 1.2 m with joints. The ceiling's 36 tiles hang
# 2.6 m up; its hanger layer has 16 rods 0.4 m up at its 1.2 m nodes. The
# masonry is in running bond, its tie layer has rods into the cavity. The
# layers follow their host when it moves, and survive the file.
import editor/bim_editor.dl

function show bim layer test of {a 64 bit integer:systemId} in {bim model record:modelValue} labelled {a string:title}:
    execute:
        set found to the bim curtain index of systemId in modelValue
        set curtainValue to the item at found's position in (modelValue's curtains's values)
        set curtainParts to the bim parts of curtain wall curtainValue in modelValue
        set mullions to 0
        set transoms to 0
        set cellCount to 0
        set rods to 0
        set lowest to 1000.0
        set highest to -1000.0
        loop partCursor from 0 to the length of (curtainParts's values):
            set derivedPart to the item at partCursor in (curtainParts's values)
            set lowest to the minimum of lowest and (the minimum of derivedPart's element's start's z and derivedPart's element's finish's z)
            set highest to the maximum of highest and (the maximum of derivedPart's element's start's z and derivedPart's element's finish's z)
            if derivedPart's kind's name = (the string form of "Mullion"):
                set mullions to mullions + 1
            else if derivedPart's kind's name = (the string form of "Transom"):
                set transoms to transoms + 1
            else if derivedPart's kind's name = (the string form of "Point"):
                set rods to rods + 1
            else:
                set cellCount to cellCount + 1
        set standing to the bim placed system curtainValue in modelValue
        set report to (title + (the string form of ": mullions ")) + ((the string form of mullions) + ((the string form of ", transoms ") + (the string form of transoms)))
        set report to (report + (the string form of ", cells ")) + ((the string form of cellCount) + ((the string form of ", points ") + (the string form of rods)))
        set report to (report + (the string form of ", z ")) + ((the bim length lowest in units 0) + ((the string form of " to ") + (the bim length highest in units 0)))
        set report to (report + (the string form of ", start y ")) + (the bim length standing's curtain's start's y in units 0)
        print report as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to target
set made to add bim system examples at (a cad vector2 with x 0.0 and y 0.0) on ground in target
print ((the string form of "examples: ") + (the string form of (the length of (made's values)))) as a line
show bim layer test of (the item at 0 in (made's values)) in modelValue labelled (the string form of "timber frame")
show bim layer test of (the item at 1 in (made's values)) in modelValue labelled (the string form of "plywood")
show bim layer test of (the item at 2 in (made's values)) in modelValue labelled (the string form of "plasterboard")
show bim layer test of (the item at 3 in (made's values)) in modelValue labelled (the string form of "hollow-core floor")
show bim layer test of (the item at 4 in (made's values)) in modelValue labelled (the string form of "ceiling")
show bim layer test of (the item at 5 in (made's values)) in modelValue labelled (the string form of "hangers")
show bim layer test of (the item at 6 in (made's values)) in modelValue labelled (the string form of "masonry")
show bim layer test of (the item at 7 in (made's values)) in modelValue labelled (the string form of "wall ties")
# The frame moves 1 m north; its layers follow.
ignore (move bim curtain wall (the item at 0 in (made's values)) to (a cad vector2 with x 0.0 and y 1.0) and (a cad vector2 with x 3.6 and y 1.0) in target)
show bim layer test of (the item at 1 in (made's values)) in modelValue labelled (the string form of "plywood after the move")
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", ") + reread's message))) as a line
show bim layer test of (the item at 1 in (made's values)) in reread's modelValue labelled (the string form of "plywood from .bim")
show bim layer test of (the item at 5 in (made's values)) in reread's modelValue labelled (the string form of "hangers from .bim")
