# SPDX-License-Identifier: MPL-2.0
import model/bim_window_placement.dl
import formats/bim_file.dl
function check window placement {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line
set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layers
set wallType to add bim wall type named (the string form of "Brick") with layers to target
set wallId to add bim wall typed wallType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set openingType to add bim opening type named (the string form of "Window") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
set openingId to add bim opening typed openingType in wallId at 3.0 to target
set windowId to ensure bim window system in opening openingId typed 34 with joint (10 as a 64 bit integer) in target
check window placement (set bim window windowId installation gap to (20 as a 64 bit integer) in target) named (the string form of "installation gap can be changed")
set placed to the bim placed system (the item at 0 in (modelValue's curtains's values)) in modelValue
check window placement (((the absolute value of ((placed's curtain's start's x - 0.045) - 2.37)) < 0.000001) and ((the absolute value of ((placed's curtain's finish's x + 0.045) - 3.63)) < 0.000001)) named (the string form of "both outer frame faces retain the requested clearance")
check window placement (((the bim bay count of placed's curtain) = 2) and ((the bim row count of placed's curtain) = 1)) named (the string form of "changing clearance preserves the cell layout")
set before to the bim file text of modelValue
check window placement (((set bim window windowId installation gap to ((-1) as a 64 bit integer) in target) = false) and ((set bim window windowId installation gap to (2000 as a 64 bit integer) in target) = false)) named (the string form of "negative and oversized gaps are refused")
check window placement ((set bim window windowId installation gap to (400 as a 64 bit integer) in target) = false) named (the string form of "gap cannot consume operable sash space")
check window placement ((the bim file text of modelValue) = before) named (the string form of "refused changes preserve geometry and settings")
check window placement (set bim window windowId installation depth to (50 as a 64 bit integer) in target) named (the string form of "frame depth in the wall can be set")
set placed to the bim placed system (the item at 0 in (modelValue's curtains's values)) in modelValue
check window placement ((the absolute value of (placed's curtain's start's y + 0.05)) < 0.000001) named (the string form of "positive depth follows the wall right side")
ignore set bim window windowId installation depth to ((-30) as a 64 bit integer) in target
set placed to the bim placed system (the item at 0 in (modelValue's curtains's values)) in modelValue
check window placement ((the absolute value of (placed's curtain's start's y - 0.03)) < 0.000001) named (the string form of "negative depth moves to the opposite side")
set reread to the bim model parsed from (the bim file text of modelValue)
check window placement (reread's valid and (((the bim setting (bim host depth setting) of windowId in reread's modelValue)'s value = ((-30) as a 64 bit integer)) and ((the absolute value of ((the bim installation gap of window windowId in reread's modelValue) - 0.02)) < 0.000001))) named (the string form of "placement parameters survive native roundtrip")
set bim setting ((bim grid line setting) + 1) of windowId to (1000 as a 64 bit integer) keeping true in target
set before to the bim file text of modelValue
check window placement ((set bim window windowId installation gap to (100 as a 64 bit integer) in target) = false) named (the string form of "moved mullion must remain inside a usable cell")
check window placement ((the bim file text of modelValue) = before) named (the string form of "refused grid change is atomic")
set slantedWall to add bim wall typed wallType on ground from (a cad vector2 with x 0.0 and y 10.0) to (a cad vector2 with x 3.0 and y 14.0) to target
set slantedOpening to add bim opening typed openingType in slantedWall at 2.5 to target
set slantedId to ensure bim window system in opening slantedOpening typed 42 with joint (10 as a 64 bit integer) in target
set slantedFound to the bim curtain index of slantedId in modelValue
set initialPlacement to the bim placed system (the item at slantedFound's position in (modelValue's curtains's values)) in modelValue
ignore set bim window slantedId installation depth to (100 as a 64 bit integer) in target
set movedPlacement to the bim placed system (the item at slantedFound's position in (modelValue's curtains's values)) in modelValue
check window placement (((the absolute value of ((movedPlacement's curtain's start's x - initialPlacement's curtain's start's x) - 0.08)) < 0.000001) and ((the absolute value of ((movedPlacement's curtain's start's y - initialPlacement's curtain's start's y) + 0.06)) < 0.000001)) named (the string form of "depth follows a rotated wall normal")
set freeId to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 20.0) to (a cad vector2 with x 2.0 and y 20.0) rising 1.5 in bays of 1.0 by 1.5 of (the string form of "timber") to target
check window placement (((set bim window freeId installation gap to (10 as a 64 bit integer) in target) = false) and ((set bim window freeId installation depth to (10 as a 64 bit integer) in target) = false)) named (the string form of "unhosted systems reject opening placement edits")
set customFrame to add bim linear type named (the string form of "Custom wide frame") as role (bim mullion role) sized 0.12 by 0.139 round false of (the string form of "timber") to target
set bim setting ((bim part type setting) + (bim frame part)) of windowId to customFrame keeping true in target
set before to the bim file text of modelValue
check window placement (((set bim window windowId installation gap to (10 as a 64 bit integer) in target) = false) and ((the bim file text of modelValue) = before)) named (the string form of "inconsistent custom profile width is refused atomically")
set outline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to outline
append (a cad vector2 with x 1.0 and y 0.0) to outline
append (a cad vector2 with x 1.0 and y 1.0) to outline
append (a cad vector2 with x 0.0 and y 1.0) to outline
keep bim face contour outline of slantedId in target
free outline
set before to the bim file text of modelValue
check window placement (((set bim window slantedId installation gap to (10 as a 64 bit integer) in target) = false) and ((the bim file text of modelValue) = before)) named (the string form of "sketched outlines remain unchanged on unsupported resize")
