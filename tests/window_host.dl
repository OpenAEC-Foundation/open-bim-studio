# SPDX-License-Identifier: MPL-2.0
# A building system standing in a wall's opening (a window): across the
# opening's rough width less the joint at either side, its foot the sill
# plus the joint, its height the rough height less two joints, on the
# wall's line and storey; it follows the wall moved, the opening made wider,
# the sill set lower and a wall at an angle; its parts stand where it does.
# Joints wider than the opening and a curved wall are refused, and with its
# opening gone it stays where it last stood.
import model/bim_stair.dl

function check window host {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# Whether `value` is `wanted` within a micrometre.
function window host {a 64 bit floating-point number:value} is near {a 64 bit floating-point number:wanted}:
    execute:
        return (the absolute value of (value - wanted)) < 0.000001

# Whether system `systemId` stands from (ax, ay) to (bx, by) in `modelValue`.
function window host system {a 64 bit integer:systemId} stands from {a 64 bit floating-point number:ax} {a 64 bit floating-point number:ay} to {a 64 bit floating-point number:bx} {a 64 bit floating-point number:by} in {bim model record:modelValue}:
    execute:
        set found to the bim curtain index of systemId in modelValue
        if found's valid = false:
            return false
        set standingNow to the bim placed system (the item at found's position in (modelValue's curtains's values)) in modelValue
        set startNear to (window host (standingNow's curtain's start's x) is near ax) and (window host (standingNow's curtain's start's y) is near ay)
        set finishNear to (window host (standingNow's curtain's finish's x) is near bx) and (window host (standingNow's curtain's finish's y) is near by)
        return startNear and finishNear

# The lift of system `systemId` as placed in `modelValue`.
function the window host lift of {a 64 bit integer:systemId} in {bim model record:modelValue}:
    execute:
        set found to the bim curtain index of systemId in modelValue
        return (the bim placed system (the item at found's position in (modelValue's curtains's values)) in modelValue)'s lift

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
set brickType to add bim wall type named (the string form of "Brick 100") with layerValues to target
set wallId to add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
set openingId to add bim opening typed windowType in wallId at 3.0 to target
# A rough opening of 1.3 by 1.55 m from 0.9 m up; a joint of 10 mm.
set systemId to add bim system in opening openingId with joint (10 as a 64 bit integer) in bays of 0.6 by 0.75 of (the string form of "wood") to target
check window host (systemId != the bim refused id) named (the string form of "a window system is added in the opening")
check window host (window host system systemId stands from 2.36 0.0 to 3.64 0.0 in modelValue) named (the string form of "it spans the rough width less a joint at either side")
check window host (window host (the window host lift of systemId in modelValue) is near 0.91) named (the string form of "its foot is the sill plus the joint")
set systemFound to the bim curtain index of systemId in modelValue
set placedWindow to the bim placed system (the item at systemFound's position in (modelValue's curtains's values)) in modelValue
check window host ((window host (placedWindow's curtain's height) is near 1.53) and (placedWindow's curtain's levelId = ground)) named (the string form of "its height is the rough height less two joints, on the wall's storey")
set stored to the item at systemFound's position in (modelValue's curtains's values)
check window host ((window host (stored's start's x) is near 2.36) and (window host (stored's height) is near 1.53)) named (the string form of "its stored line and height are where it stands")

# Its parts stand in the opening: from the foot to the head.
set lowest to 1.0 / 0.0
set highest to -1.0 / 0.0
set windowParts to the bim parts of curtain wall stored in modelValue
loop partCursor from 0 to the length of (windowParts's values):
    set windowPart to the item at partCursor in (windowParts's values)
    set lowest to the minimum of lowest and (the minimum of (windowPart's element's start's z) and (windowPart's element's finish's z))
    set highest to the maximum of highest and (the maximum of (windowPart's element's start's z) and (windowPart's element's finish's z))
check window host ((window host lowest is near 0.91) and (window host highest is near 2.44)) named (the string form of "its parts run from 0.91 to 2.44 m")

# The wall moved 2 m along and 1 m across: the window goes with it.
set wallFound to the bim wall index of wallId in modelValue
set movedWall to the item at wallFound's position in (modelValue's walls's values)
set movedWall's start to a cad vector2 with x 2.0 and y 1.0
set movedWall's finish to a cad vector2 with x 8.0 and y 1.0
replace item at index wallFound's position in (target's walls's values) with movedWall
check window host (window host system systemId stands from 4.36 1.0 to 5.64 1.0 in modelValue) named (the string form of "the wall moved, the window goes with it")

# The opening made 1.8 m wide: rough 1.9 m.
set typeFound to the bim opening type index of windowType in modelValue
set widerType to the item at typeFound's position in (modelValue's openingTypes's values)
set widerType's width to 1.8
replace item at index typeFound's position in (target's openingTypes's values) with widerType
check window host (window host system systemId stands from 4.06 1.0 to 5.94 1.0 in modelValue) named (the string form of "the opening made wider, the window widens")

# The sill set to 0.6 m.
set lowerType to the item at typeFound's position in (modelValue's openingTypes's values)
set lowerType's sill to 0.6
replace item at index typeFound's position in (target's openingTypes's values) with lowerType
check window host (window host (the window host lift of systemId in modelValue) is near 0.61) named (the string form of "the sill set lower, the window's foot follows")

# A wall at an angle, 3 by 4 m; a window 2.5 m along it, 1.3 m rough.
set slantedWall to add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 3.0 and y 4.0) to target
set slantedType to add bim opening type named (the string form of "Window 1200 b") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
set slantedOpening to add bim opening typed slantedType in slantedWall at 2.5 to target
set slantedSystem to add bim system in opening slantedOpening with joint (10 as a 64 bit integer) in bays of 0.6 by 0.75 of (the string form of "wood") to target
check window host (window host system slantedSystem stands from 1.116 1.488 to 1.884 2.512 in modelValue) named (the string form of "a wall at an angle: the window lies along it")

# No joint: the rough opening itself.
check window host (host bim system slantedSystem in opening slantedOpening with joint (0 as a 64 bit integer) in target) named (the string form of "hosted again with no joint")
check window host (window host system slantedSystem stands from 1.11 1.48 to 1.89 2.52 in modelValue) named (the string form of "no joint: the whole rough width")

# Joints wider than half the opening are refused; the joint stays as it was.
check window host ((host bim system slantedSystem in opening slantedOpening with joint (700 as a 64 bit integer) in target) = false) named (the string form of "joints wider than the opening are refused")
check window host (window host system slantedSystem stands from 1.11 1.48 to 1.89 2.52 in modelValue) named (the string form of "and the window stands as it did")

# A curved wall is refused.
set curvedWall to add bim wall typed brickType on ground from (a cad vector2 with x 10.0 and y 0.0) to (a cad vector2 with x 16.0 and y 0.0) to target
set curvedFound to the bim wall index of curvedWall in modelValue
set bentWall to the item at curvedFound's position in (modelValue's walls's values)
set bentWall's bulge to 0.5
replace item at index curvedFound's position in (target's walls's values) with bentWall
set curvedOpening to add bim opening typed slantedType in curvedWall at 3.0 to target
check window host ((add bim system in opening curvedOpening with joint (10 as a 64 bit integer) in bays of 0.6 by 0.75 of (the string form of "wood") to target) = the bim refused id) named (the string form of "a curved wall is refused")

# Its opening gone, the window stays where it last stood.
ignore delete bim opening slantedOpening from target
check window host (window host system slantedSystem stands from 1.11 1.48 to 1.89 2.52 in modelValue) named (the string form of "its opening gone, it stays where it stood")
