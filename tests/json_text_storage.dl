# SPDX-License-Identifier: MPL-2.0
# Many text fields followed by a large tail previously reserved the remaining
# document for every string. Keep this runtime check light enough for a 256 MB
# memory limit while exercising an 8 MB document.
import lib/json.dl

function check json storage {boolean:condition} named {a string:name}:
    execute:
        if condition:
            print ((the string form of "PASS ") + name) as a line
        else:
            print ((the string form of "FAIL ") + name) as a line

set chunk to a new string buffer containing 4096 bytes
loop cursor from 0 to 4096:
    store (120 as a byte) into the data of chunk at cursor
set quoted to ((the string form of "\"") + chunk) + (the string form of "\"")
set rows to an empty list of a string
loop cursor from 0 to 2000:
    append quoted to rows
set documentText to ((the string form of "[") + (rows joined with ",")) + (the string form of "]")
free rows
set parsed to the JSON document parsed from documentText
check json storage ((parsed failed) = false) named (the string form of "large text document parses")
if (parsed failed) = false:
    set root to the value of parsed
    check json storage ((the length of root) = 2000) named (the string form of "all fields retained")
    check json storage ((the text of (the JSON value at index 1999 in root)) = chunk) named (the string form of "last field remains intact")
free parsed
set escaped to the JSON document parsed from (the string form of "[\"\",\"a\\\"b\",\"\\u20ac\",\"\\ud83d\\ude00\",\"a\\\\b\"]")
check json storage ((escaped failed) = false) named (the string form of "escaped quotes and Unicode parse")
if (escaped failed) = false:
    set root to the value of escaped
    check json storage ((the text of (the JSON value at index 0 in root)) = (the string form of "")) named (the string form of "empty string")
    check json storage ((the text of (the JSON value at index 1 in root)) = (the string form of "a\"b")) named (the string form of "escaped quote does not terminate text")
    check json storage ((the length of (the text of (the JSON value at index 3 in root))) = 4) named (the string form of "surrogate pair fits storage")
free escaped
set broken to the JSON document parsed from (the string form of "[\"unterminated]")
check json storage (broken failed) named (the string form of "unterminated string rejected")
free broken
