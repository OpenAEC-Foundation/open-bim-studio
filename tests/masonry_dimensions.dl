# SPDX-License-Identifier: MPL-2.0
# Plan dimensions on a wall's masonry module (`bim_masonry.dl`): between
# two module lines, as many modules as lie between; from the last whole
# module to the face's far end, the rest; from the near end, the offset.
# They follow the wall when it moves and changes length. A line past the
# whole modules, a wall without a module and a curved one give no measure.
# The references are kept through the native file. The sizes are generic
# (a 210 mm module), not project data.
import model/bim_drawing.dl
import formats/bim_file.dl

function check masonry dimension {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# Whether dimension `dimensionId` of `modelValue` measures `wanted` within a
# micrometre.
function dimension {a 64 bit integer:dimensionId} measures {a 64 bit floating-point number:wanted} in {bim model record:modelValue}:
    execute:
        set found to the bim dimension index of dimensionId in modelValue
        set measured to the bim measure of (the item at found's position in (modelValue's dimensions's values)) in modelValue
        return measured's valid and ((the absolute value of (measured's value - wanted)) < 0.000001)

# Whether dimension `dimensionId` of `modelValue` measures nothing.
function dimension {a 64 bit integer:dimensionId} has no measure in {bim model record:modelValue}:
    execute:
        set found to the bim dimension index of dimensionId in modelValue
        return ((the bim measure of (the item at found's position in (modelValue's dimensions's values)) in modelValue)'s valid) = false

# A reference to module line `lineNumber` of wall `wallId`.
function masonry line {integer:lineNumber} of {a 64 bit integer:wallId}:
    execute:
        return a bim reference to wallId feature ((bim masonry line feature) + lineNumber)

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "block", 0.1)) to layerValues
set cavityType to add bim wall type named (the string form of "Two leaves 200") with layerValues to target
set wallId to add bim wall typed cavityType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 2.0 and y 0.0) to target
set plainWall to add bim wall typed cavityType on ground from (a cad vector2 with x 0.0 and y 5.0) to (a cad vector2 with x 2.0 and y 5.0) to target
# 50 mm in from the start: 1.95 m on, nine modules and 60 mm over.
ignore give bim wall wallId masonry module (2100 as a 64 bit integer) on layer 0 from finish false offset (500 as a 64 bit integer) in target

set fourModules to add bim dimension from (masonry line 0 of wallId) to (masonry line 4 of wallId) to target
set restDimension to add bim dimension from (masonry line 9 of wallId) to (a bim reference to wallId feature (bim masonry far end feature)) to target
set leadDimension to add bim dimension from (a bim reference to wallId feature (bim masonry near end feature)) to (masonry line 0 of wallId) to target
set pastDimension to add bim dimension from (masonry line 0 of wallId) to (masonry line 12 of wallId) to target
set plainDimension to add bim dimension from (masonry line 0 of plainWall) to (masonry line 1 of plainWall) to target
check masonry dimension (dimension fourModules measures 0.84 in modelValue) named (the string form of "four modules apart: 840 mm")
check masonry dimension (dimension restDimension measures 0.06 in modelValue) named (the string form of "the last module to the far end: the rest, 60 mm")
check masonry dimension (dimension leadDimension measures 0.05 in modelValue) named (the string form of "the near end to the first line: the offset, 50 mm")
check masonry dimension (dimension pastDimension has no measure in modelValue) named (the string form of "a line past the whole modules: no measure")
check masonry dimension (dimension plainDimension has no measure in modelValue) named (the string form of "a wall without a module: no measure")

# Made 2.2 m long and moved 3 m across: ten modules, 50 mm over.
set wallFound to the bim wall index of wallId in modelValue
set changed to the item at wallFound's position in (modelValue's walls's values)
set changed's start to a cad vector2 with x 0.0 and y 3.0
set changed's finish to a cad vector2 with x 2.2 and y 3.0
replace item at index wallFound's position in (target's walls's values) with changed
check masonry dimension ((dimension fourModules measures 0.84 in modelValue) and (dimension restDimension measures 0.26 in modelValue)) named (the string form of "made longer and moved: four modules still 840 mm, line 9 to the end 260 mm")
set restFound to the bim dimension index of restDimension in modelValue
set restLine to the bim dimension line of (the item at restFound's position in (modelValue's dimensions's values)) in modelValue using (the bim join index of modelValue)
check masonry dimension (restLine's valid and ((the absolute value of (restLine's startFoot's y - 2.9)) < 0.000001)) named (the string form of "its dimension line went with the wall")

# Kept through the native file.
set reread to the bim model parsed from (the bim file text of modelValue)
check masonry dimension (reread's valid and (dimension fourModules measures 0.84 in (reread's modelValue))) named (the string form of "the references are kept through the native file")

# A curved wall: no measure, not a straight one.
set bent to the item at wallFound's position in (modelValue's walls's values)
set bent's bulge to 0.3
replace item at index wallFound's position in (target's walls's values) with bent
check masonry dimension (dimension fourModules has no measure in modelValue) named (the string form of "the wall made curved: no measure")
