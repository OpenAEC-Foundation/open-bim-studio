# SPDX-License-Identifier: MPL-2.0
# The Model Explorer (bim_model_explorer.dl): a model of two storeys, two
# walls with a window and a floor, and an imported IFC proxy, shown as a
# tree with what is open; a wall's row selects the wall and relates to its
# type, the window's to its host; the import by storey and class; "... more"
# past the limit; and the graph's layout, parents midway over their rows.
import editor/bim_model_explorer.dl
import formats/bim_ifc_native.dl

function show bim explorer rows {a pointer to a list:rowList}:
    execute:
        loop rowCursor from 0 to the length of rowList:
            set entry to the item at rowCursor in rowList
            set marker to the string form of "  "
            if entry's branch:
                set marker to the string form of "+ "
                if entry's opened:
                    set marker to the string form of "- "
            set indentText to the string form of ""
            loop depthCursor from 0 to entry's depth:
                set indentText to indentText + (the string form of "  ")
            set pickText to the string form of ""
            if entry's pickKind >= 0:
                set pickText to the string form of " [picks]"
            print ((indentText + marker) + ((entry's label + ((the string form of " (") + (entry's detail + (the string form of ")")))) + pickText)) as a line

set modelValue to an empty bim model
set groundId to add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to (the address of modelValue)
set upperId to add bim level named (the string form of "Verdieping") at 3.0 with height 3.0 to (the address of modelValue)
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
set wallTypeId to add bim wall type named (the string form of "Spouwmuur") with layerValues to (the address of modelValue)
free layerValues
set windowTypeId to add bim opening type named (the string form of "Raam 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to (the address of modelValue)
set firstWall to add bim wall typed wallTypeId on groundId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 5.0 and y 0.0) to (the address of modelValue)
set secondWall to add bim wall typed wallTypeId on groundId from (a cad vector2 with x 5.0 and y 0.0) to (a cad vector2 with x 5.0 and y 4.0) to (the address of modelValue)
set windowId to add bim opening typed windowTypeId in firstWall at 2.0 to (the address of modelValue)
set outline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to outline
append (a cad vector2 with x 5.0 and y 0.0) to outline
append (a cad vector2 with x 5.0 and y 4.0) to outline
ignore (add bim slab on upperId around outline thick 0.2 to (the address of modelValue))
free outline

set ifcLines to an empty list of a string
append (the string form of "ISO-10303-21;") to ifcLines
append (the string form of "HEADER;") to ifcLines
append (the string form of "FILE_DESCRIPTION(('ViewDefinition [ReferenceView]'),'2;1');") to ifcLines
append (the string form of "FILE_NAME('explorer.ifc','2026-10-20',(''),(''),'','','');") to ifcLines
append (the string form of "FILE_SCHEMA(('IFC4'));") to ifcLines
append (the string form of "ENDSEC;") to ifcLines
append (the string form of "DATA;") to ifcLines
append (the string form of "#1=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);") to ifcLines
append (the string form of "#2=IFCUNITASSIGNMENT((#1));") to ifcLines
append (the string form of "#3=IFCCARTESIANPOINT((0.,0.,0.));") to ifcLines
append (the string form of "#4=IFCAXIS2PLACEMENT3D(#3,$,$);") to ifcLines
append (the string form of "#5=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#4,$);") to ifcLines
append (the string form of "#6=IFCPROJECT('0aaaaaaaaaaaaaaaaaaaaa',$,'P',$,$,$,$,(#5),#2);") to ifcLines
append (the string form of "#10=IFCLOCALPLACEMENT($,#4);") to ifcLines
append (the string form of "#11=IFCBUILDINGSTOREY('0bbbbbbbbbbbbbbbbbbbbb',$,'00',$,$,#10,$,$,.ELEMENT.,0.);") to ifcLines
append (the string form of "#20=IFCCARTESIANPOINT((2.,1.,0.));") to ifcLines
append (the string form of "#21=IFCAXIS2PLACEMENT3D(#20,$,$);") to ifcLines
append (the string form of "#22=IFCLOCALPLACEMENT(#10,#21);") to ifcLines
append (the string form of "#23=IFCRECTANGLEPROFILEDEF(.AREA.,$,$,1.2,0.6);") to ifcLines
append (the string form of "#24=IFCDIRECTION((0.,0.,1.));") to ifcLines
append (the string form of "#25=IFCEXTRUDEDAREASOLID(#23,#4,#24,0.9);") to ifcLines
append (the string form of "#26=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#25));") to ifcLines
append (the string form of "#27=IFCPRODUCTDEFINITIONSHAPE($,$,(#26));") to ifcLines
append (the string form of "#28=IFCBUILDINGELEMENTPROXY('0ccccccccccccccccccccc',$,'Keukenblok',$,$,#22,#27,$,$);") to ifcLines
append (the string form of "#29=IFCRELCONTAINEDINSPATIALSTRUCTURE('0ddddddddddddddddddddd',$,$,$,(#28),#11);") to ifcLines
append (the string form of "ENDSEC;") to ifcLines
append (the string form of "END-ISO-10303-21;") to ifcLines
set stepFile to the bim step file of (ifcLines joined with "\n")
set nativeSet to the bim ifc natives of stepFile
set importValue to the bim ifc elements of stepFile skipping (nativeSet's skipped's values)

set openKeys to the bim explorer first open keys
set rowList to the bim model explorer rows of modelValue with importValue opening openKeys
print (the string form of "first:") as a line
show bim explorer rows rowList
free rowList

toggle bim explorer key ((the string form of "p/s/") + (the string form of groundId)) in openKeys
toggle bim explorer key (((the string form of "p/s/") + (the string form of groundId)) + (the string form of "/0")) in openKeys
toggle bim explorer key (((the string form of "p/s/") + (the string form of groundId)) + (the string form of "/2")) in openKeys
toggle bim explorer key (the string form of "p/t") in openKeys
toggle bim explorer key (the string form of "p/t/w") in openKeys
toggle bim explorer key (the string form of "p/i") in openKeys
toggle bim explorer key (the string form of "p/i/0") in openKeys
toggle bim explorer key (the string form of "p/i/0/IfcBuildingElementProxy") in openKeys
set rowList to the bim model explorer rows of modelValue with importValue opening openKeys
print (the string form of "opened:") as a line
show bim explorer rows rowList
set wallRow to the bim explorer row of element firstWall among rowList
set wallEntry to the item at wallRow in rowList
print ((the string form of "wall picks its own id: ") + (the string form of ((wallEntry's elementId = firstWall) and (wallEntry's pickKind = bim wall picked)))) as a line
print ((the string form of "wall relates to its type: ") + (the string form of (wallEntry's relatedKey = ((the string form of "t/") + (the string form of wallTypeId))))) as a line
set windowEntry to the item at (the bim explorer row of element windowId among rowList) in rowList
print ((the string form of "window relates to its wall: ") + (the string form of (windowEntry's relatedKey = ((the string form of "e/") + (the string form of firstWall))))) as a line
set proxyEntry to the item at ((the length of rowList) - 1) in rowList
print ((the string form of "imported row picks: ") + (the string form of ((proxyEntry's pickKind = bim imported picked) and (proxyEntry's elementId = the bim imported id base)))) as a line

set placement to the bim explorer graph layout of rowList
set levelsRow to 1
set firstLevelRow to 2
print ((the string form of "graph: depth 2 at x ") + ((the bim metres text of (the item at firstLevelRow in (placement's xs's values))) + ((the string form of ", storeys midway: ") + (the string form of ((the item at levelsRow in (placement's ys's values)) > 0.0))))) as a line
print ((the string form of "graph height: ") + (the bim metres text of placement's tall)) as a line
free rowList

loop wallCursor from 0 to 450:
    ignore (add bim wall typed wallTypeId on upperId from (a cad vector2 with x 0.0 and y (wallCursor as a 64 bit floating-point number)) to (a cad vector2 with x 1.0 and y (wallCursor as a 64 bit floating-point number)) to (the address of modelValue))
toggle bim explorer key ((the string form of "p/s/") + (the string form of upperId)) in openKeys
toggle bim explorer key (((the string form of "p/s/") + (the string form of upperId)) + (the string form of "/0")) in openKeys
set rowList to the bim model explorer rows of modelValue with importValue opening openKeys
set moreText to the string form of "none"
loop rowCursor from 0 to the length of rowList:
    if (the index of (the string form of " more") in ((the item at rowCursor in rowList)'s label)) >= 0:
        set moreText to (the item at rowCursor in rowList)'s label
print ((the string form of "limited: ") + moreText) as a line
free rowList

# Saved Spaces are real selectable rows under their own storey's category.
set spaceOutline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to spaceOutline
append (a cad vector2 with x 4.0 and y 0.0) to spaceOutline
append (a cad vector2 with x 4.0 and y 3.0) to spaceOutline
append (a cad vector2 with x 0.0 and y 3.0) to spaceOutline
set spaceId to add bim space object named (the string form of "Living room") numbered (the string form of "0.01") on groundId around spaceOutline high 2.8 to (the address of modelValue)
free spaceOutline
toggle bim explorer key (((the string form of "p/s/") + (the string form of groundId)) + (the string form of "/9")) in openKeys
set spaceRows to the bim model explorer rows of modelValue with importValue opening openKeys
set spaceRow to the bim explorer row of element spaceId among spaceRows
set spacePicks to false
set spaceNamed to false
set spaceGrouped to false
if spaceRow >= 0:
    set spaceEntry to the item at spaceRow in spaceRows
    set spacePicks to (spaceEntry's elementId = spaceId) and (spaceEntry's pickKind = bim space object picked)
    set spaceNamed to (spaceEntry's label = (the string form of "Living room")) and (spaceEntry's detail = (the string form of "0.01"))
    set spaceGrouped to (the item at spaceEntry's parentRow in spaceRows)'s label = (the string form of "Spaces")
print ((the string form of "space picks its saved id: ") + (the string form of spacePicks)) as a line
print ((the string form of "space shows name and number: ") + (the string form of spaceNamed)) as a line
print ((the string form of "space belongs to Spaces: ") + (the string form of spaceGrouped)) as a line
free spaceRows
