# SPDX-License-Identifier: MPL-2.0
import model/bim_point_input.dl

function check scalar entry {boolean:accepted} named {a string:captionText}:
    execute:
        if accepted = false:
            print ((the string form of "FAIL: ") + captionText) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + captionText) as a line

function accept scalar entry {a string:givenText} yielding {a 64 bit floating-point number:wantedValue}:
    execute:
        set parsedEntry to the bim scalar input of givenText
        check scalar entry (parsedEntry's valid and ((the absolute value of (parsedEntry's value - wantedValue)) < 1e-9)) named (((the string form of "accept [") + givenText) + (the string form of "]"))

function refuse scalar entry {a string:givenText}:
    execute:
        set parsedEntry to the bim scalar input of givenText
        check scalar entry (parsedEntry's valid = false) named (((the string form of "refuse [") + givenText) + (the string form of "]"))

accept scalar entry (the string form of "=2*(1200+300)/3") yielding 1000.0
accept scalar entry (the string form of "2+3*4") yielding 14.0
accept scalar entry (the string form of "8/4/2") yielding 1.0
accept scalar entry (the string form of "  -(2 + .5) * +4 ") yielding -10.0
accept scalar entry (the string form of "2/-4") yielding -0.5
accept scalar entry (the string form of "--2") yielding 2.0
accept scalar entry (the string form of "1.-.25") yielding 0.75
refuse scalar entry (the string form of "2/")
refuse scalar entry (the string form of "1/0")
refuse scalar entry (the string form of "1/(2-2)")
refuse scalar entry (the string form of "(2+3")
refuse scalar entry (the string form of "2+3)")
refuse scalar entry (the string form of "2(3)")
refuse scalar entry (the string form of "1..2")
refuse scalar entry (the string form of "()")
refuse scalar entry (the string form of "1 2")
refuse scalar entry (the string form of "2**3")
refuse scalar entry (the string form of "=")
refuse scalar entry (the string form of "NaN")
refuse scalar entry (the string form of "1e309")
refuse scalar entry (the string form of "1000000000000*2")
refuse scalar entry (the string form of "1/0.0000000000001")
set parsedEntry to the bim point input of (the string form of "=2*(1200+300)/3") relative to (a cad vector2 with x 1.0 and y 2.0) along (a cad vector2 with x 4.0 and y 6.0) metres per unit 0.001
check scalar entry (parsedEntry's valid and ((the cad distance from parsedEntry's point to (a cad vector2 with x 1.6 and y 2.8)) < 1e-9)) named (the string form of "point scalar evaluates expression in current units")
set parsedEntry to the bim point input of (the string form of "2/") relative to (a cad vector2 with x 1.0 and y 2.0) along (a cad vector2 with x 4.0 and y 6.0) metres per unit 0.001
check scalar entry ((parsedEntry's valid = false) and ((the cad distance from parsedEntry's point to (a cad vector2 with x 1.0 and y 2.0)) < 1e-9)) named (the string form of "point scalar refuses incomplete expression without movement")
set parsedEntry to the bim point input of (the string form of "2+3,4") relative to (a cad vector2 with x 1.0 and y 2.0) along (a cad vector2 with x 4.0 and y 6.0) metres per unit 1.0
check scalar entry (parsedEntry's valid = false) named (the string form of "coordinate components remain literal numbers")
