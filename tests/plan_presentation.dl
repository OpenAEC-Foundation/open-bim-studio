# SPDX-License-Identifier: MPL-2.0
import app/bim_plan_panel.dl

function check plan presentation {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set firstView to add bim view of kind (bim plan view) named (the string form of "Review") on editor's levelId to target
set secondView to add bim view of kind (bim plan view) named (the string form of "Drawing") on editor's levelId to target
set corners to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to corners
append (a cad vector2 with x 4.0 and y 0.0) to corners
append (a cad vector2 with x 4.0 and y 3.0) to corners
append (a cad vector2 with x 0.0 and y 3.0) to corners
ignore add bim space object named (the string form of "Room") numbered (the string form of "01") on editor's levelId around corners high 2.7 to target
set transform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 100.0)
set editor's planViewId to firstView
set review to a new bim canvas
draw bim spaces of editor through transform on (the address of review)
check plan presentation ((the length of (review's batches's values)) > 0) named (the string form of "review retains room fills")
set reviewKey to the bim plan key of editor at 100.0
set bim setting (bim technical plan setting) of secondView to (1 as a 64 bit integer) keeping true in target
set editor's planViewId to secondView
set technical to a new bim canvas
draw bim spaces of editor through transform on (the address of technical)
check plan presentation ((the length of (technical's batches's values)) = 0) named (the string form of "technical plan has white room interiors")
check plan presentation ((the length of (technical's texts's values)) = 2) named (the string form of "room name and area remain model annotations")
set label to the item at 0 in (technical's texts's values)
check plan presentation (((label's red = 0) and (label's green = 0)) and (label's blue = 0)) named (the string form of "technical room labels are black")
check plan presentation ((the bim plan key of editor at 100.0) != reviewKey) named (the string form of "switching views invalidates plan recording")
set gridCanvas to a new bim canvas
draw bim grid head (the string form of "A") at (a cad vector2 with x 0.0 and y 0.0) faint false blue true on (the address of gridCanvas)
set batch to the item at 0 in (gridCanvas's batches's values)
check plan presentation (((batch's red = 0) and (batch's green = 0)) and (batch's blue = 255)) named (the string form of "technical grid uses blue linework")
