# SPDX-License-Identifier: MPL-2.0
# 2D detail components: a face made a component with DC belongs to the plan
# view shown; it is drawn there, not in a duplicate of that view and not in
# 3D, while a model instance of a component shows everywhere. The view it
# belongs to survives .bim and .ifcx.
import editor/bim_editor.dl

function count detail test parts of {bim model record:modelValue} in view {a 64 bit integer:viewId}:
    execute:
        set drawn to the bim drawn sketches of modelValue seen from view viewId
        return the length of (drawn's values)

set editor to a new bim editor
set e to the address of editor
prepare bim editor views in e
set firstView to editor's planViewId
set target to the address of (editor's documentValue's current)
set square to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to square
append (a cad vector2 with x 1.0 and y 0.0) to square
append (a cad vector2 with x 1.0 and y 1.0) to square
append (a cad vector2 with x 0.0 and y 1.0) to square
begin bim transaction in (the address of (editor's documentValue))
set detailFace to add bim face on editor's levelId around square to target
set symbolFace to add bim face on editor's levelId around square to target
commit bim transaction in (the address of (editor's documentValue))
select bim editor bim sketch picked numbered detailFace in e
type bim editor key 2116 in e
print editor's message as a line
set detailInstance to editor's selectionId
select bim editor bim sketch picked numbered symbolFace in e
type bim editor key 1071 in e
type bim editor key 2092 in e
set secondView to editor's planViewId
print ((the string form of "parts in the first view ") + (the string form of (count detail test parts of editor's documentValue's current in view firstView))) as a line
print ((the string form of "parts in its duplicate ") + (the string form of (count detail test parts of editor's documentValue's current in view secondView))) as a line
print ((the string form of "parts in 3D ") + (the string form of (count detail test parts of editor's documentValue's current in view (the bim refused id)))) as a line
set reread to the bim model parsed from (the bim file text of editor's documentValue's current)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", parts in the first view ") + (the string form of (count detail test parts of reread's modelValue in view firstView))))) as a line
set native to the bim native text of ifcx (the bim ifcx text of editor's documentValue's current identified as (the string form of "d.ifcx") for project (the string form of "d") by (the string form of "test") at (the string form of "2026-10-10T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of ", parts in 3D ") + (the string form of (count detail test parts of fromIfcx's modelValue in view (the bim refused id)))))) as a line
