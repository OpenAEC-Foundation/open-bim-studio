# SPDX-License-Identifier: MPL-2.0
# GUI type duplication gives concrete beams independent rectangular sizes.
import editor/bim_editor.dl

function check linear copy {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function type copied width {a string:inputValue} in {a pointer to a bim editor record:editTarget}:
    execute:
        start bim editor property bim linear width property in editTarget
        set editTarget's propertyText to inputValue
        apply bim editor property in editTarget

set copyEditor to a new bim editor
set ep to the address of copyEditor
set modelTarget to the address of (copyEditor's documentValue's current)
set concreteType to add bim linear type named (the string form of "Concrete 300x500") as role (bim beam role) sized 0.3 by 0.5 round false of (the string form of "concrete") to modelTarget
set bim setting (bim nlsfb setting) of concreteType to (1620 as a 64 bit integer) keeping true in modelTarget
set bim property (the string form of "Reference") of set (the string form of "Source") of concreteType to (the string form of "Foundation plan") typed (the string form of "IfcText") in modelTarget
set bim property (the string form of "GlobalId") of set (the string form of "IFC attributes") of concreteType to (the string form of "original-id") typed (the string form of "IfcText") in modelTarget
set firstBeam to add bim linear typed concreteType on copyEditor's levelId from (a cad vector3 with x 0.0, y 0.0 and z -1.55) to (a cad vector3 with x 4.0, y 0.0 and z -1.55) turned 0.0 to modelTarget
set secondBeam to add bim linear typed concreteType on copyEditor's levelId from (a cad vector3 with x 0.0, y 2.0 and z -1.55) to (a cad vector3 with x 4.0, y 2.0 and z -1.55) turned 0.0 to modelTarget
set thirdBeam to add bim linear typed concreteType on copyEditor's levelId from (a cad vector3 with x 0.0, y 4.0 and z -1.55) to (a cad vector3 with x 4.0, y 4.0 and z -1.55) turned 0.0 to modelTarget
set initialTypeCount to the length of (modelTarget's linearTypes's values)
select bim editor bim linear picked numbered firstBeam in ep
set shownProperties to the bim property rows of copyEditor
set duplicateVisible to false
loop rowCursor from 0 to the length of shownProperties:
    if (the item at rowCursor in shownProperties)'s code = bim duplicate linear type property:
        set duplicateVisible to true
check linear copy duplicateVisible named (the string form of "selected beam exposes Duplicate type")
free shownProperties
start bim editor property bim duplicate linear type property in ep
set copiedTypeId to (the item at 0 in (modelTarget's linears's values))'s typeId
check linear copy ((copiedTypeId != concreteType) and ((the length of (modelTarget's linearTypes's values)) = (initialTypeCount + 1))) named (the string form of "one click makes and assigns one separate type")
check linear copy (((the item at 1 in (modelTarget's linears's values))'s typeId = concreteType) and ((the item at 2 in (modelTarget's linears's values))'s typeId = concreteType)) named (the string form of "other beams retain original type")
check linear copy (((the bim setting (bim nlsfb setting) of copiedTypeId in copyEditor's documentValue's current)'s value) = (1620 as a 64 bit integer)) named (the string form of "classification settings copied")
check linear copy ((the bim property value (the string form of "Reference") of set (the string form of "Source") of copiedTypeId in copyEditor's documentValue's current) = (the string form of "Foundation plan")) named (the string form of "source reference copied")
check linear copy ((the bim property value (the string form of "GlobalId") of set (the string form of "IFC attributes") of copiedTypeId in copyEditor's documentValue's current) = (the string form of "")) named (the string form of "copy does not reuse imported GlobalId")
ignore undo bim transaction in (the address of (copyEditor's documentValue))
check linear copy (((the item at 0 in (modelTarget's linears's values))'s typeId = concreteType) and ((the length of (modelTarget's linearTypes's values)) = initialTypeCount)) named (the string form of "undo restores assignment and removes new type")
ignore redo bim transaction in (the address of (copyEditor's documentValue))
check linear copy ((the item at 0 in (modelTarget's linears's values))'s typeId = copiedTypeId) named (the string form of "redo restores same copied type identity")
set copyEditor's lengthUnit to bim millimetre unit
type copied width (the string form of "400") in ep
select bim editor bim linear picked numbered secondBeam in ep
type bim editor key 2197 in ep
type copied width (the string form of "450") in ep
select bim editor bim linear picked numbered thirdBeam in ep
start bim editor property bim duplicate linear type property in ep
type copied width (the string form of "500") in ep
set firstKind to the bim type of linear (the item at 0 in (modelTarget's linears's values)) in copyEditor's documentValue's current
set secondKind to the bim type of linear (the item at 1 in (modelTarget's linears's values)) in copyEditor's documentValue's current
set thirdKind to the bim type of linear (the item at 2 in (modelTarget's linears's values)) in copyEditor's documentValue's current
check linear copy (((the absolute value of (firstKind's width - 0.4)) < 1e-9) and (((the absolute value of (secondKind's width - 0.45)) < 1e-9) and ((the absolute value of (thirdKind's width - 0.5)) < 1e-9))) named (the string form of "400 450 and 500 mm widths coexist")
check linear copy ((firstKind's depth = 0.5) and ((secondKind's depth = 0.5) and (thirdKind's depth = 0.5))) named (the string form of "all copied rectangular profiles remain 500 mm deep")
set originalLookup to the bim linear type index of concreteType in copyEditor's documentValue's current
check linear copy ((the item at originalLookup's position in (modelTarget's linearTypes's values))'s width = 0.3) named (the string form of "original 300 mm type unchanged")
set savedText to the bim file text of copyEditor's documentValue's current
set nativeReading to the bim model parsed from savedText
check linear copy (nativeReading's valid and ((the bim file text of nativeReading's modelValue) = savedText)) named (the string form of "type identities and properties survive native roundtrip")
set beforeRefusal to the length of (modelTarget's linearTypes's values)
set copyEditor's selectionId to 999999 as a 64 bit integer
start bim editor property bim duplicate linear type property in ep
check linear copy ((the length of (modelTarget's linearTypes's values)) = beforeRefusal) named (the string form of "stale selection creates no orphan type")
