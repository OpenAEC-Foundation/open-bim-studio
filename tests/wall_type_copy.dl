# SPDX-License-Identifier: MPL-2.0
# Lightweight type copy contract; editor actions are covered separately.
import formats/bim_file.dl
import lib/std.dl

function check wall type copy {boolean:passed} named {a string:caption}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set layerList to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.09)) to layerList
set originalType to add bim wall type named (the string form of "Brick") with layerList to target
set bim setting 7777 of originalType to (250 as a 64 bit integer) keeping true in target
set bim property (the string form of "Reference") of set (the string form of "Source") of originalType to (the string form of "detail-A") typed (the string form of "IfcText") in target
set bim property (the string form of "GlobalId") of set (the string form of "IFC attributes") of originalType to (the string form of "original-guid") typed (the string form of "IfcText") in target
set copyType to copy bim wall type originalType in target
check wall type copy (copyType != originalType) named (the string form of "copy has separate identity")
check wall type copy ((the bim property value (the string form of "Reference") of set (the string form of "Source") of copyType in modelValue) = (the string form of "detail-A")) named (the string form of "copy retains source properties")
check wall type copy ((the bim property value (the string form of "GlobalId") of set (the string form of "IFC attributes") of copyType in modelValue) = (the string form of "")) named (the string form of "copy does not inherit IFC identity")
set copySettings to the bim settings text of copyType from 7777 below 7778 in modelValue
check wall type copy (copySettings = (the string form of "1 0 250")) named (the string form of "copy retains type settings")
append (@intrinsic("construct", a bim layer record, the string form of "block", 0.14)) to layerList
ignore set bim wall type copyType layers to layerList in target
free layerList
set oldType to the item at (the bim wall type index of originalType in modelValue)'s position in (modelValue's wallTypes's values)
set newType to the item at (the bim wall type index of copyType in modelValue)'s position in (modelValue's wallTypes's values)
check wall type copy (((the length of (oldType's layers's values)) = 1) and ((the length of (newType's layers's values)) = 2)) named (the string form of "copied layers edit independently")
set fileText to the bim file text of modelValue
set reading to the bim model parsed from fileText
check wall type copy (reading's valid and ((the bim file text of reading's modelValue) = fileText)) named (the string form of "copied type persists exactly")
