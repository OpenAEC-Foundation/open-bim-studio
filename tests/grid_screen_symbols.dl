# Native grid bubbles are screen symbols even when their model centres zoom.
import app/bim_plan_panel.dl

function check grid symbol {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the grid symbol bounds of {bim editor record:editor} through {bim drawing transform record:transform}:
    execute:
        set canvas to a new bim canvas
        draw bim grids in plan of editor through transform on (the address of canvas)
        set ring to (the item at 1 in (canvas's batches's values))'s pixels's values
        set centre to the bim pixel of (a cad vector2 with x 2.0 and y 3.0) through transform
        set extent to a cad vector2 with x 0.0 and y 0.0
        loop cursor from 0 to the length of ring:
            set point to the item at cursor in ring
            set extent's x to the maximum of extent's x and (the absolute value of (point's x - centre's x))
            set extent's y to the maximum of extent's y and (the absolute value of (point's y - centre's y))
        return extent

set editor to a new bim editor
ignore add bim grid named (the string form of "A") from (a cad vector2 with x 2.0 and y 3.0) to (a cad vector2 with x 2.0 and y 9.0) reaching -1.0 to 3.0 to (the address of (editor's documentValue's current))
set firstTransform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 200.0 and y 200.0), (a cad vector2 with x 0.0 and y 0.0), 25.0)
set secondTransform to firstTransform
set secondTransform's scale to 100.0
set firstExtent to the grid symbol bounds of editor through firstTransform
set secondExtent to the grid symbol bounds of editor through secondTransform
check grid symbol (((the absolute value of (firstExtent's x - secondExtent's x)) < 1e-8) and ((the absolute value of (firstExtent's y - secondExtent's y)) < 1e-8)) named (the string form of "native grid bubbles retain their pixel bounds at fourfold zoom")
check grid symbol (((the absolute value of (firstExtent's x - 11.5)) < 0.01) and ((the absolute value of (firstExtent's y - 11.5)) < 0.01)) named (the string form of "native grid bubbles use an 11 pixel radius and fixed stroke")
set firstCentre to the bim pixel of (a cad vector2 with x 2.0 and y 3.0) through firstTransform
set secondCentre to the bim pixel of (a cad vector2 with x 2.0 and y 3.0) through secondTransform
check grid symbol ((secondCentre's x - firstCentre's x) = 150.0) named (the string form of "grid bubble centres follow model zoom")
