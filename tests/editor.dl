# SPDX-License-Identifier: MPL-2.0
# Editor tools, snapping, numeric input, dragging, undo and evaluation driven
# by simulated events.
import editor/bim_editor.dl

function check bim editor {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print label as a line
            @intrinsic("call", "libc", "exit", nothing, 1)

function point bim editor at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor

function report bim editor {a pointer to a bim editor record:editor} labelled {a string:label}:
    execute:
        refresh bim editor editor
        set line to (label + (the string form of " walls ")) + (the string form of (the length of (editor's documentValue's current's walls's values)))
        set line to ((line + (the string form of " openings ")) + (the string form of (the length of (editor's documentValue's current's openings's values)))) + (the string form of " rebuilt ")
        set line to ((line + (the string form of editor's lastRebuilt)) + (the string form of " plan polygons ")) + (the string form of (the bim polygon count of editor's plan))
        print line as a line

set editor to a new bim editor
set e to the address of editor
type bim editor key 87 in e
point bim editor at 0.03 and -0.02 in e
print ((the string form of "first snap ") + editor's snap's label) as a line
press bim editor pointer in e
point bim editor at 6.02 and 0.04 in e
set snapLine to ((the string form of "second snap ") + editor's snap's label) + (the string form of " ")
print (snapLine + (the string form of editor's snap's point's x)) as a line
press bim editor pointer in e
point bim editor at 6.03 and 2.0 in e
print ((the string form of "third snap ") + editor's snap's label) as a line
type bim editor key 52 in e
type bim editor key bim enter key code in e
point bim editor at 0.0 and 4.0 in e
press bim editor pointer in e
point bim editor at 0.04 and 0.03 in e
print ((the string form of "closing snap ") + editor's snap's label) as a line
press bim editor pointer in e
type bim editor key bim escape key code in e
report bim editor e labelled (the string form of "drawn")

type bim editor key 79 in e
point bim editor at 1.5 and 0.03 in e
press bim editor pointer in e
point bim editor at 3.0 and 4.05 in e
press bim editor pointer in e
report bim editor e labelled (the string form of "with openings")

type bim editor key 83 in e
point bim editor at 6.02 and 0.01 in e
press bim editor pointer in e
check bim editor editor's dragging named "drag starts on an end point"
print ((the string form of "dragged ends ") + (the string form of (the length of (editor's dragEnds's values)))) as a line
point bim editor at 7.0 and 0.0 in e
report bim editor e labelled (the string form of "during drag")
point bim editor at 7.5 and -0.5 in e
report bim editor e labelled (the string form of "later in drag")
release bim editor pointer in e
set east to the item at 1 in (editor's documentValue's current's walls's values)
set eastLine to ((the string form of "east start ") + (the string form of east's start's x)) + (the string form of " ")
print (eastLine + (the string form of east's start's y)) as a line
type bim editor key 90 in e
set eastUndone to the item at 1 in (editor's documentValue's current's walls's values)
print ((the string form of "after undo ") + (the string form of eastUndone's start's x)) as a line
type bim editor key 89 in e
report bim editor e labelled (the string form of "after redo")
point bim editor at 3.0 and 4.0 in e
type bim editor key bim delete key code in e
report bim editor e labelled (the string form of "after delete")
type bim editor key 90 in e
report bim editor e labelled (the string form of "delete undone")

# Spaces follow the walls; a section line gives a second view; the window type
# is parametric and its openings follow it.
refresh bim editor e
print ((the string form of "spaces ") + (the string form of (the length of (editor's spaces's values)))) as a line
loop spaceCursor from 0 to the length of (editor's spaces's values):
    set space to the item at spaceCursor in (editor's spaces's values)
    set roundedArea to (@intrinsic("call", "libc", "round", a 64 bit floating-point number, space's area * 10000.0)) / 10000.0
    set spaceLine to ((the string form of "space area ") + (the string form of roundedArea)) + (the string form of " bounded by ")
    print (spaceLine + (the string form of (the length of (space's boundingWalls's values)))) as a line
type bim editor key 67 in e
point bim editor at 3.0 and -2.0 in e
press bim editor pointer in e
point bim editor at 3.0 and 6.0 in e
press bim editor pointer in e
refresh bim editor e
print ((the string form of "section polygons ") + (the string form of (the bim polygon count of editor's section))) as a line
type bim editor key 93 in e
print editor's message as a line
report bim editor e labelled (the string form of "wider windows")
type bim editor key 39 in e
print editor's message as a line
loop widening from 0 to 40:
    type bim editor key 93 in e
print editor's message as a line
type bim editor key 90 in e
type bim editor key 90 in e
refresh bim editor e
set windowType to the item at 0 in (editor's documentValue's current's openingTypes's values)
print ((the string form of "after undoing two resizes width ") + (the string form of windowType's width)) as a line

# The example building: three rooms, seven windows, three doors and a ground
# slab.
set house to a new bim editor
add bim example building to (the address of house)
refresh bim editor (the address of house)
print ((the string form of "example walls ") + (the string form of (the length of (house's documentValue's current's walls's values)))) as a line
print ((the string form of "example openings ") + (the string form of (the length of (house's documentValue's current's openings's values)))) as a line
loop spaceCursor from 0 to the length of (house's spaces's values):
    set roomArea to (@intrinsic("call", "libc", "round", a 64 bit floating-point number, (the item at spaceCursor in (house's spaces's values))'s area * 10000.0)) / 10000.0
    print ((the string form of "example space area ") + (the string form of roomArea)) as a line
print ((the string form of "example slabs ") + (the string form of (the length of (house's documentValue's current's slabs's values)))) as a line
set failing to 0
loop elementCursor from 0 to the length of (house's evaluation's elements's values):
    if (the item at elementCursor in (house's evaluation's elements's values))'s status != 0:
        set failing to failing + 1
print ((the string form of "example failing elements ") + (the string form of failing)) as a line

# B without a selected space is refused; with the west room selected it adds
# a slab under the room and selects it, and undo removes it.
set h to the address of house
type bim editor key 66 in h
print house's message as a line
type bim editor key 83 in h
move bim editor pointer to (a cad vector2 with x 0.0 and y 2.5) within 0.1 in h
press bim editor pointer in h
release bim editor pointer in h
type bim editor key 66 in h
refresh bim editor h
print house's message as a line
print ((the string form of "slabs after B ") + (the string form of (the length of (house's documentValue's current's slabs's values)))) as a line
set roomSlab to the item at 1 in (house's evaluation's elements's values)
set slabCount to 0
loop elementCursor from 0 to the length of (house's evaluation's elements's values):
    set candidate to the item at elementCursor in (house's evaluation's elements's values)
    if (the bim slab index of candidate's id in house's documentValue's current)'s valid:
        set slabCount to slabCount + 1
        set roomSlab to candidate
print ((the string form of "evaluated slabs ") + (the string form of slabCount)) as a line
print ((the string form of "room slab status ") + (the string form of roomSlab's status)) as a line
type bim editor key 90 in h
refresh bim editor h
print ((the string form of "slabs after undo ") + (the string form of (the length of (house's documentValue's current's slabs's values)))) as a line

# Storeys: Page Up moves to the example's first floor, whose plan cuts only
# its own walls; Page Up on the top storey adds one; undoing that leaves the
# first storey active; Page Down at the bottom is refused.
type bim editor key bim page up key code in h
refresh bim editor h
print house's message as a line
print ((the string form of "first floor plan polygons ") + (the string form of (the bim polygon count of house's plan))) as a line
print ((the string form of "first floor spaces ") + (the string form of (the length of (house's spaces's values)))) as a line
move bim editor pointer to (a cad vector2 with x 5.0 and y 2.0) within 0.1 in h
print ((the string form of "hover over the ground floor's wall from the first floor ") + (the string form of house's hoverWall)) as a line
type bim editor key bim page up key code in h
refresh bim editor h
print house's message as a line
print ((the string form of "levels ") + (the string form of (the length of (house's documentValue's current's levels's values)))) as a line
type bim editor key 90 in h
refresh bim editor h
print ((the string form of "after undo levels ") + (the string form of (the length of (house's documentValue's current's levels's values)))) as a line
print ((the string form of "active storey ") + (the bim storey name of house)) as a line
type bim editor key bim page down key code in h
print house's message as a line

# Dragging a whole wall: the wall between the two east rooms, pressed on its
# body and dropped 0.5 m north. Its ends stay on the walls it joins (T joins),
# and the two rooms change size.
type bim editor key 83 in h
move bim editor pointer to (a cad vector2 with x 5.5 and y 2.0) within 0.1 in h
press bim editor pointer in h
move bim editor pointer to (a cad vector2 with x 5.5 and y 2.5) within 0.1 in h
release bim editor pointer in h
refresh bim editor h
print house's message as a line
set betweenWall to the item at 5 in (house's documentValue's current's walls's values)
print ((((the string form of "dragged wall from ") + (the string form of betweenWall's start's x)) + (the string form of " ")) + (the string form of betweenWall's start's y)) as a line
print ((((the string form of "dragged wall to ") + (the string form of betweenWall's finish's x)) + (the string form of " ")) + (the string form of betweenWall's finish's y)) as a line
loop spaceCursor from 0 to the length of (house's spaces's values):
    set roomArea to (@intrinsic("call", "libc", "round", a 64 bit floating-point number, (the item at spaceCursor in (house's spaces's values))'s area * 10000.0)) / 10000.0
    print ((the string form of "space area after the drag ") + (the string form of roomArea)) as a line
set failing to 0
loop elementCursor from 0 to the length of (house's evaluation's elements's values):
    if (the item at elementCursor in (house's evaluation's elements's values))'s status != 0:
        set failing to failing + 1
print ((the string form of "failing elements after the drag ") + (the string form of failing)) as a line

# The ground slab's sketch: selected by clicking its west edge, a corner
# dragged, an edge pushed out by its middle and undone, a drag that would
# cross the outline refused, a corner removed with Delete, and undo.
move bim editor pointer to (a cad vector2 with x -2.16 and y 0.0) within 0.1 in h
press bim editor pointer in h
release bim editor pointer in h
print house's message as a line
move bim editor pointer to (a cad vector2 with x -2.16 and y -1.66) within 0.1 in h
press bim editor pointer in h
move bim editor pointer to (a cad vector2 with x -3.0 and y -2.5) within 0.1 in h
release bim editor pointer in h
print house's message as a line
print (the bim selection description of house) as a line
set slabNow to the bim selected slab of house
set middle to the bim middle of slab edge 0 of slabNow's slab
move bim editor pointer to middle within 0.1 in h
press bim editor pointer in h
move bim editor pointer to (a cad vector2 with x (middle's x + 0.4) and y (middle's y - 0.6)) within 0.1 in h
release bim editor pointer in h
print house's message as a line
print (the bim selection description of house) as a line
type bim editor key 90 in h
refresh bim editor h
print (the bim selection description of house) as a line
move bim editor pointer to (a cad vector2 with x -3.0 and y -2.5) within 0.1 in h
press bim editor pointer in h
move bim editor pointer to (a cad vector2 with x 5.0 and y 7.0) within 0.1 in h
release bim editor pointer in h
print (the bim selection description of house) as a line
move bim editor pointer to (a cad vector2 with x -3.0 and y -2.5) within 0.1 in h
type bim editor key bim delete key code in h
print house's message as a line
print (the bim selection description of house) as a line
type bim editor key 90 in h
refresh bim editor h
print (the bim selection description of house) as a line

# Grids: the tool draws a north-south grid, named 4 after the example's three;
# dragging its end with the select tool moves the end; undo restores it.
type bim editor key 73 in h
move bim editor pointer to (a cad vector2 with x 0.5 and y -3.0) within 0.1 in h
press bim editor pointer in h
release bim editor pointer in h
move bim editor pointer to (a cad vector2 with x 0.5 and y 7.0) within 0.1 in h
press bim editor pointer in h
release bim editor pointer in h
print house's message as a line
set gridCount to the length of (house's documentValue's current's grids's values)
print ((the string form of "grids ") + (the string form of gridCount)) as a line
type bim editor key 83 in h
move bim editor pointer to (a cad vector2 with x 0.5 and y 7.0) within 0.1 in h
press bim editor pointer in h
move bim editor pointer to (a cad vector2 with x 1.0 and y 8.0) within 0.1 in h
release bim editor pointer in h
print house's message as a line
print (the bim selection description of house) as a line
set lastGrid to the item at (gridCount - 1) in (house's documentValue's current's grids's values)
print ((((the string form of "grid end ") + (the string form of lastGrid's finish's x)) + (the string form of " ")) + (the string form of lastGrid's finish's y)) as a line
type bim editor key 90 in h
set restoredGrid to the item at (gridCount - 1) in (house's documentValue's current's grids's values)
print ((((the string form of "after undo grid end ") + (the string form of restoredGrid's finish's x)) + (the string form of " ")) + (the string form of restoredGrid's finish's y)) as a line
