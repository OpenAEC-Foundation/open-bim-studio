# SPDX-License-Identifier: MPL-2.0
# The quantity schedule: a room of four cavity walls with one window, checked
# against hand-computed quantities, then the editor's example house, and the
# schedule as comma-separated text.
import graphics/bim_schedule.dl
import editor/bim_editor.dl

function check bim schedule {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print label as a line
            @intrinsic("call", "libc", "exit", nothing, 1)

function a bim schedule point at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y}:
    execute:
        return a cad vector2 with x x and y y

function print bim schedule {a pointer to a list:rows}:
    execute:
        loop cursor from 0 to the length of rows:
            set row to the item at cursor in rows
            set line to ((row's group + (the string form of " | ")) + row's name) + (the string form of " | ")
            set line to ((line + (the string form of row's count)) + (the string form of " | ")) + (the bim schedule text of row's length)
            set line to ((line + (the string form of " | ")) + (the bim schedule text of row's area)) + (the string form of " | ")
            print (line + (the bim schedule text of row's volume)) as a line

set modelValue to an empty bim model
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to (the address of modelValue)
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.12)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.1)) to layerValues
set cavity to add bim wall type named (the string form of "Cavity wall") with layerValues to (the address of modelValue)
free layerValues
set south to add bim wall typed cavity on storey from (a bim schedule point at 0.0 and 0.0) to (a bim schedule point at 6.0 and 0.0) to (the address of modelValue)
ignore add bim wall typed cavity on storey from (a bim schedule point at 6.0 and 0.0) to (a bim schedule point at 6.0 and 4.0) to (the address of modelValue)
ignore add bim wall typed cavity on storey from (a bim schedule point at 6.0 and 4.0) to (a bim schedule point at 0.0 and 4.0) to (the address of modelValue)
ignore add bim wall typed cavity on storey from (a bim schedule point at 0.0 and 4.0) to (a bim schedule point at 0.0 and 0.0) to (the address of modelValue)
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to (the address of modelValue)
ignore add bim opening typed windowType in south at 3.0 to (the address of modelValue)
set evaluation to the bim evaluation of modelValue after (an empty bim evaluation)
set spaces to the bim spaces of modelValue on level storey using (the bim join index of modelValue)
set rows to the bim schedule of modelValue with evaluation and (spaces's values)
print "room" as a line
print bim schedule (rows's values)
set walls to the item at 0 in (rows's values)
check bim schedule ((walls's count = 4) and ((the absolute value of (walls's length - 20.0)) < 1e-9)) named "wall count and length"
check bim schedule ((the absolute value of (walls's area - ((20.0 * 3.0) - (1.3 * 1.55)))) < 1e-9) named "net wall area"
set rooms to the item at 2 in (rows's values)
check bim schedule ((the absolute value of (rooms's area - (5.68 * 3.68))) < 1e-9) named "room area"

set editor to a new bim editor
add bim example building to (the address of editor)
refresh bim editor (the address of editor)
set houseRows to the bim schedule of editor's documentValue's current with editor's evaluation and (editor's spaces's values)
print "example house" as a line
print bim schedule (houseRows's values)
print (the bim schedule csv of (houseRows's values)) as a line
