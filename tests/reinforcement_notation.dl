# SPDX-License-Identifier: MPL-2.0
import model/bim_reinforcement_schedule.dl
import formats/bim_file.dl

function check rebar notation {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set dutchText to the bim reinforcement callout marked (the string form of "3") counting 5 diameter 0.012 spaced 0.15 positioned 1 under (bim nen standard) ascii false
check rebar notation (dutchText = (the string form of "pos 3: 5 ø12-150 K")) named (the string form of "Dutch count diameter spacing and lower position")
set internationalText to the bim reinforcement callout marked (the string form of "3") counting 5 diameter 0.012 spaced 0.15 positioned 2 under (bim iso standard) ascii false
check rebar notation (internationalText = (the string form of "mark 3: 5 ø12 @ 150 top")) named (the string form of "international spacing and upper position")
set asciiText to the bim reinforcement callout marked (the string form of "3") counting 5 diameter 0.0065 spaced 0.0 positioned 2 under (bim nen standard) ascii true
check rebar notation (asciiText = (the string form of "pos 3: 5 D6,5 B")) named (the string form of "ASCII option and Dutch decimal comma")
set wallText to the bim reinforcement callout marked (the string form of "W") counting 4 diameter 0.012 spaced 0.2 positioned 4 under (bim nen standard) ascii false
check rebar notation (wallText = (the string form of "pos W: 4 ø12-200 back")) named (the string form of "wall face is not mislabeled upper reinforcement")
set loaded to the bim model parsed from (the string form of "BIM-SLICE 1\nnext 3\nlevel 1 0 3 Ground\nreinforcement 2 1 -1 1 0 0 0 3 0 0 0.3 0.5 0.016 0.008 0.15 0.15 0.035 0.024 A\n")
check rebar notation loaded's valid named (the string form of "notation fixture loads")
set scheduled to the bim reinforcing schedule of loaded's modelValue
set firstRow to the item at 0 in (scheduled's rows's values)
set lowerText to the bim reinforcing row text firstRow in loaded's modelValue ascii true
check rebar notation (lowerText = (the string form of "pos A-T: 2 D16 B")) named (the string form of "row uses project default standard")
set target to the address of (loaded's modelValue)
set bim setting (bim drawing standard setting) of (0 as a 64 bit integer) to ((bim iso standard) as a 64 bit integer) keeping true in target
set switchedText to the bim reinforcing row text firstRow in loaded's modelValue ascii true
check rebar notation (switchedText = (the string form of "mark A-T: 2 D16 top")) named (the string form of "project standard changes notation without geometry edits")
set restored to the bim model parsed from (the bim file text of loaded's modelValue)
check rebar notation restored's valid named (the string form of "standard setting round trip loads")
check rebar notation ((the bim reinforcing row text firstRow in restored's modelValue ascii true) = switchedText) named (the string form of "project notation survives save and load")
