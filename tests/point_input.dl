# SPDX-License-Identifier: MPL-2.0
import model/bim_point_input.dl

function check point entry {boolean:accepted} named {a string:captionText}:
    execute:
        if accepted = false:
            print ((the string form of "FAIL: ") + captionText) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + captionText) as a line

function accept point entry {a string:givenText} at {cad vector2:wantedPoint} using {a 64 bit floating-point number:metresPerUnit}:
    execute:
        set parsedEntry to the bim point input of givenText relative to (a cad vector2 with x 10.0 and y 20.0) along (a cad vector2 with x 13.0 and y 24.0) metres per unit metresPerUnit
        check point entry (parsedEntry's valid and ((the cad distance from parsedEntry's point to wantedPoint) < 1e-9)) named (((the string form of "accept [") + givenText) + (the string form of "]"))

function refuse point entry {a string:givenText}:
    execute:
        set parsedEntry to the bim point input of givenText relative to (a cad vector2 with x 10.0 and y 20.0) along (a cad vector2 with x 13.0 and y 24.0) metres per unit 1.0
        check point entry ((parsedEntry's valid = false) and ((the cad distance from parsedEntry's point to (a cad vector2 with x 10.0 and y 20.0)) < 1e-9)) named (((the string form of "refuse [") + givenText) + (the string form of "]"))

accept point entry (the string form of "1000,2500") at (a cad vector2 with x 1.0 and y 2.5) using 0.001
accept point entry (the string form of "#-2.5,+4") at (a cad vector2 with x -2.5 and y 4.0) using 1.0
accept point entry (the string form of "@500,-250") at (a cad vector2 with x 10.5 and y 19.75) using 0.001
accept point entry (the string form of " @ +50 , -.5 ") at (a cad vector2 with x 10.5 and y 19.995) using 0.01
accept point entry (the string form of "@5<90") at (a cad vector2 with x 10.0 and y 25.0) using 1.0
accept point entry (the string form of "@-2000<0") at (a cad vector2 with x 8.0 and y 20.0) using 0.001
accept point entry (the string form of "@2<-90") at (a cad vector2 with x 10.0 and y 18.0) using 1.0
accept point entry (the string form of "5000") at (a cad vector2 with x 13.0 and y 24.0) using 0.001
accept point entry (the string form of "-2.5") at (a cad vector2 with x 8.5 and y 18.0) using 1.0
accept point entry (the string form of "0") at (a cad vector2 with x 10.0 and y 20.0) using 1.0
refuse point entry (the string form of "")
refuse point entry (the string form of "1,2,3")
refuse point entry (the string form of "1,,2")
refuse point entry (the string form of "@1<2<3")
refuse point entry (the string form of "@1,2<3")
refuse point entry (the string form of "5<90")
refuse point entry (the string form of "@5")
refuse point entry (the string form of "#5")
refuse point entry (the string form of "1 2,3")
refuse point entry (the string form of "1,2junk")
refuse point entry (the string form of "NaN,2")
refuse point entry (the string form of "1e309,2")
refuse point entry (the string form of "999999999999999999999,0")
refuse point entry (the string form of "--2,3")
refuse point entry (the string form of ".,3")
set parsedEntry to the bim point input of (the string form of "3") relative to (a cad vector2 with x 1.0 and y 2.0) along (a cad vector2 with x 1.0 and y 2.0) metres per unit 1.0
check point entry (parsedEntry's valid = false) named (the string form of "scalar refuses a zero pointer direction")
set parsedEntry to the bim point input of (the string form of "1,2") relative to (a cad vector2 with x 0.0 and y 0.0) along (a cad vector2 with x 1.0 and y 0.0) metres per unit 0.0
check point entry (parsedEntry's valid = false) named (the string form of "zero unit scale refused")
set parsedEntry to the bim point input of (the string form of "1000000000000,0") relative to (a cad vector2 with x 0.0 and y 0.0) along (a cad vector2 with x 1.0 and y 0.0) metres per unit 10.0
check point entry (parsedEntry's valid = false) named (the string form of "converted coordinate range is bounded")
set parsedEntry to the bim point input of (the string form of "@1,0") relative to (a cad vector2 with x 1000000000000.0 and y 0.0) along (a cad vector2 with x 1.0 and y 0.0) metres per unit 1.0
check point entry (parsedEntry's valid = false) named (the string form of "relative offset cannot overflow coordinate range")
