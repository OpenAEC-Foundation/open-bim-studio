# SPDX-License-Identifier: MPL-2.0
import editor/bim_editor_core.dl

function check modify array {boolean:passed} named {a string:caption}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set editor to a new bim editor
set e to the address of editor
set lineId to add bim line on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 4.0) to (the address of (editor's documentValue's current))
select bim editor bim sketch picked numbered lineId in e
ignore start bim editor modify command 2025 in e
set editor's moveBase to a cad vector2 with x 0.0 and y 0.0
set editor's moveStage to 2
set editor's snap to the bim snap (a cad vector2 with x 8.0 and y 0.0) labelled "Free"
set beforeUndo to the length of (editor's documentValue's undoStack's values)
check modify array (apply bim editor array in e) named (the string form of "linear array creates the complete selection")
check modify array ((the length of (editor's documentValue's current's sketches's values)) = 5) named (the string form of "array count includes the original")
check modify array ((the length of (editor's documentValue's undoStack's values)) = (beforeUndo + 1)) named (the string form of "all array copies form one undo step")
set lastLine to the item at 4 in (editor's documentValue's current's sketches's values)
check modify array (((the item at 0 in (lastLine's points's values))'s x) = 8.0) named (the string form of "last linear copy reaches the indicated endpoint")
ignore undo bim transaction in (the address of (editor's documentValue))
check modify array ((the length of (editor's documentValue's current's sketches's values)) = 1) named (the string form of "one undo removes the complete array")
select bim editor bim sketch picked numbered lineId in e
set editor's moveBase to a cad vector2 with x 0.0 and y 0.0
check modify array (apply bim editor scale by 2.0 in e) named (the string form of "positive scale changes native geometry")
set scaledLine to the item at 0 in (editor's documentValue's current's sketches's values)
check modify array (((the item at 1 in (scaledLine's points's values))'s y) = 8.0) named (the string form of "scale doubles the line rather than reflecting it")
set beforeRefusal to the length of (editor's documentValue's undoStack's values)
check modify array ((apply bim editor scale by -2.0 in e) = false) named (the string form of "negative scale is refused")
check modify array ((the length of (editor's documentValue's undoStack's values)) = beforeRefusal) named (the string form of "invalid scale leaves undo history intact")
set editor's selectionKind to bim level picked
set editor's selectionId to editor's levelId
set editor's tool to bim array tool
set editor's moveStage to 2
set beforeUnsupported to the length of (editor's documentValue's undoStack's values)
check modify array ((apply bim editor array in e) = false) named (the string form of "array refuses unsupported selections as a whole")
check modify array ((the length of (editor's documentValue's undoStack's values)) = beforeUnsupported) named (the string form of "unsupported array does not change undo history")

set atomicEditor to a new bim editor
set ae to the address of atomicEditor
set atomicTarget to the address of (atomicEditor's documentValue's current)
set beamType to add bim linear type named (the string form of "Rectangular beam") as role bim beam role sized 0.2 by 0.4 round false of (the string form of "steel") to atomicTarget
set beamId to add bim linear typed beamType on atomicEditor's levelId from (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (a cad vector3 with x 1.0, y 0.0 and z 0.0) turned 0.0 to atomicTarget
set wallId to add bim wall typed atomicEditor's wallTypeId on atomicEditor's levelId from (a cad vector2 with x 0.0 and y 2.0) to (a cad vector2 with x 10.0 and y 2.0) to atomicTarget
select bim editor bim wall picked numbered wallId in ae
append beamId to (atomicEditor's chosenSketches's values)
set atomicBeforeUndo to the length of (atomicEditor's documentValue's undoStack's values)
check modify array ((apply bim editor scale by 0.0005 in ae) = false) named (the string form of "scale refuses a selection when one native axis becomes too short")
check modify array (((the item at 0 in (atomicTarget's walls's values))'s finish's x = 10.0) and ((the item at 0 in (atomicTarget's linears's values))'s finish's x = 1.0)) named (the string form of "failed scale rolls back every selected element")
check modify array ((the length of (atomicEditor's documentValue's undoStack's values)) = atomicBeforeUndo) named (the string form of "failed scale does not add an undo step")
set atomicEditor's modify's copyMode to true
check modify array ((apply bim editor scale by 0.0005 in ae) = false) named (the string form of "copy scale refuses incomplete copies")
check modify array (((the length of (atomicTarget's walls's values)) = 1) and ((the length of (atomicTarget's linears's values)) = 1)) named (the string form of "failed copy scale leaves no partial copies")
ignore add bim opening typed atomicEditor's openingTypeId in wallId at 8.0 to atomicTarget
select bim editor bim wall picked numbered wallId in ae
check modify array ((apply bim editor scale by 0.5 in ae) = false) named (the string form of "scale refuses hosted openings before changing their wall")
select bim editor bim linear picked numbered beamId in ae
ignore shape bim linear beamId twisting 0.25 tapering (a cad vector2 with x 0.8 and y 0.7) in atomicTarget
set bim property (the string form of "Mark") of set (the string form of "Identity") of beamId to (the string form of "B1") typed (the string form of "IfcLabel") in atomicTarget
set atomicEditor's modify's count to 4
set atomicEditor's modify's radial to true
set atomicEditor's modify's sweep to 360.0
set atomicEditor's tool to bim array tool
set atomicEditor's moveStage to 2
check modify array (apply bim editor array in ae) named (the string form of "radial array creates all native beam copies")
set keptRoll to true
set keptShape to true
loop beamCursor from 0 to the length of (atomicTarget's linears's values):
    set beamValue to the item at beamCursor in (atomicTarget's linears's values)
    set beamFrame to the bim frame of linear beamValue in (@intrinsic("dereference", atomicTarget))
    if (the absolute value of (beamFrame's depthAxis's z - 1.0)) > 1e-9:
        set keptRoll to false
    if ((beamValue's twist != 0.25) or (beamValue's taper's x != 0.8)) or ((the bim property value (the string form of "Mark") of set (the string form of "Identity") of beamValue's id in (@intrinsic("dereference", atomicTarget))) != (the string form of "B1")):
        set keptShape to false
check modify array keptRoll named (the string form of "radial beam copies preserve the vertical depth axis")
check modify array keptShape named (the string form of "beam copies preserve twist taper and instance properties")
