# SPDX-License-Identifier: MPL-2.0
# Edit mode, as in Blender with SketchUp's picking: Tab on a face, points and
# edges picked, grabbed with G along X, Y and Z by typed distances, a grab
# that would make the face cross itself refused, Esc back to object mode.
import editor/bim_editor.dl

function click bim edit test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function type bim edit test {a string:keys} in {a pointer to a bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of keys:
            type bim editor key ((the character at cursor in keys) as an integer) in editor

function show bim edited face of {a pointer to a bim editor record:editor} labelled {a string:label}:
    execute:
        set found to the bim sketch index of editor's editSketchId in editor's documentValue's current
        set element to the item at found's position in (editor's documentValue's current's sketches's values)
        set line to label + (the string form of ":")
        loop cursor from 0 to the length of (element's points's values):
            set point to the item at cursor in (element's points's values)
            set line to (line + (the string form of " (")) + (((the string form of point's x) + (the string form of " ")) + ((the string form of point's y) + (the string form of ")")))
        print ((line + (the string form of " height ")) + (the string form of element's height)) as a line

set editor to a new bim editor
set e to the address of editor
type bim editor key 82 in e
click bim edit test at 0.0 and 0.0 in e
click bim edit test at 4.0 and 3.0 in e
type bim editor key 83 in e
click bim edit test at 2.0 and 1.5 in e
type bim editor key 258 in e
print editor's message as a line
click bim edit test at 4.0 and 3.0 in e
print editor's message as a line
type bim editor key 71 in e
type bim editor key 88 in e
type bim edit test (the string form of "1") in e
type bim editor key bim enter key code in e
show bim edited face of e labelled (the string form of "corner 1 m along X")
click bim edit test at 2.0 and 0.0 in e
print editor's message as a line
type bim editor key 71 in e
type bim editor key 89 in e
type bim edit test (the string form of "-0.5") in e
type bim editor key bim enter key code in e
show bim edited face of e labelled (the string form of "edge 0.5 m down")
type bim editor key 65 in e
type bim editor key 71 in e
type bim editor key 90 in e
type bim edit test (the string form of "2.5") in e
type bim editor key bim enter key code in e
show bim edited face of e labelled (the string form of "all up 2.5 m")
click bim edit test at 0.0 and 3.0 in e
type bim editor key 71 in e
type bim editor key 88 in e
type bim edit test (the string form of "9") in e
type bim editor key bim enter key code in e
print editor's message as a line
show bim edited face of e labelled (the string form of "after the refused grab")
type bim editor key bim escape key code in e
print ((the string form of "edit mode after Esc: ") + (the string form of editor's editMode)) as a line
type bim editor key 90 in e
print ((the string form of "undo: ") + editor's message) as a line
