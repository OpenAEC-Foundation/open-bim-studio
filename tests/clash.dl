# SPDX-License-Identifier: MPL-2.0
# Clash detection by separating axes: a duct crossing a beam at its height
# clashes, a duct passing under it does not; two pipes joined at a node do
# not clash with each other; a pipe through a wall clashes with it, but not
# a pipe through a window's void.
import model/bim_clash.dl

function add clash test linear typed {a 64 bit integer:typeId} from {a 64 bit floating-point number:x1} and {a 64 bit floating-point number:y1} to {a 64 bit floating-point number:x2} and {a 64 bit floating-point number:y2} at {a 64 bit floating-point number:height} on {a 64 bit integer:levelId} to {a pointer to a bim model record:target}:
    execute:
        return add bim linear typed typeId on levelId from (a cad vector3 with x x1, y y1 and z height) to (a cad vector3 with x x2, y y2 and z height) turned 0.0 to target

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to target
set beamType to add bim linear type named (the string form of "Balk") as role bim beam role sized 0.3 by 0.5 round false of (the string form of "concrete") to target
set ductType to add bim linear type named (the string form of "Kanaal") as role bim duct role sized 0.4 by 0.2 round false of (the string form of "steel") to target
set pipeType to add bim linear type named (the string form of "Leiding") as role bim pipe role sized 0.05 by 0.05 round true of (the string form of "copper") to target
set beamId to add clash test linear typed beamType from 0.0 and 0.0 to 6.0 and 0.0 at 2.75 on ground to target
set crossing to add clash test linear typed ductType from 3.0 and -2.0 to 3.0 and 2.0 at 2.75 on ground to target
set underDuct to add clash test linear typed ductType from 5.0 and -2.0 to 5.0 and 2.0 at 2.2 on ground to target
set firstPipe to add clash test linear typed pipeType from 0.0 and 5.0 to 2.0 and 5.0 at 1.0 on ground to target
set secondPipe to add clash test linear typed pipeType from 2.0 and 5.0 to 2.0 and 7.0 at 1.0 on ground to target
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to layers
set wallType to add bim wall type named (the string form of "Muur") with layers to target
set wallId to add bim wall typed wallType on ground from (a cad vector2 with x 8.0 and y -1.0) to (a cad vector2 with x 8.0 and y 3.0) to target
set throughWall to add clash test linear typed pipeType from 7.0 and 1.0 to 9.0 and 1.0 at 1.0 on ground to target
# A second wall with a window (1.2 x 1.5 m, sill 0.9) centred 2 m along it:
# a pipe through the window's void does not clash, one under its sill does.
set windowWall to add bim wall typed wallType on ground from (a cad vector2 with x 12.0 and y -1.0) to (a cad vector2 with x 12.0 and y 3.0) to target
set windowType to add bim opening type named (the string form of "Raam") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
ignore add bim opening typed windowType in windowWall at 2.0 to target
set throughWindow to add clash test linear typed pipeType from 11.0 and 1.0 to 13.0 and 1.0 at 1.6 on ground to target
set underSill to add clash test linear typed pipeType from 11.0 and 1.2 to 13.0 and 1.2 at 0.5 on ground to target
set found to the bim clashes of modelValue
print ((the string form of "clashes ") + (the string form of (the length of (found's values)))) as a line
loop cursor from 0 to the length of (found's values):
    set clashValue to the item at cursor in (found's values)
    set firstName to the string form of "?"
    set secondName to the string form of "?"
    if clashValue's firstId = beamId:
        set firstName to the string form of "beam"
    if clashValue's secondId = crossing:
        set secondName to the string form of "crossing duct"
    if clashValue's firstId = throughWall:
        set firstName to the string form of "pipe"
    if clashValue's secondId = wallId:
        set secondName to the string form of "wall"
    if clashValue's firstId = wallId:
        set firstName to the string form of "wall"
    if clashValue's secondId = throughWall:
        set secondName to the string form of "pipe"
    if clashValue's firstId = throughWindow:
        set firstName to the string form of "pipe through the window"
    if clashValue's firstId = underSill:
        set firstName to the string form of "pipe under the sill"
    if clashValue's secondId = windowWall:
        set secondName to the string form of "window wall"
    print ((the string form of "  ") + ((firstName + (the string form of " with ")) + secondName)) as a line
