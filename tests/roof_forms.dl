# SPDX-License-Identifier: MPL-2.0
import model/bim_evaluate.dl
import formats/bim_file.dl

function check roof form {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the highest roof point in {fast polyhedron record:shape}:
    execute:
        set high to -1e100
        loop cursor from 0 to the length of (shape's positions's values):
            set high to the maximum of high and (the item at cursor in (shape's positions's values))'s z
        return high

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.2)) to layers
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.15)) to layers
set roofType to add bim planar type named (the string form of "Curved roof") as role bim roof planar role with layers to target
set profilePoints to an empty list of a cad vector2
append (a cad vector2 with x -2.0 and y 0.0) to profilePoints
append (a cad vector2 with x 0.0 and y 2.0) to profilePoints
append (a cad vector2 with x 2.0 and y 0.0) to profilePoints
set pathPoints to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to pathPoints
append (a cad vector2 with x 6.0 and y 0.0) to pathPoints
set roofId to add bim roof typed roofType on ground with section profilePoints along pathPoints at 2.0 in target
check roof form (roofId != the bim refused id) named (the string form of "profile creates one native roof object")
check roof form ((the length of (modelValue's slabs's values)) = 1) named (the string form of "roof is not a collection of separate plates")
set roofValue to the item at 0 in (modelValue's slabs's values)
set solid to the bim slab solid of roofValue in modelValue
check roof form (solid's status = 0) named (the string form of "normal geometry evaluation accepts the roof form")
check roof form ((the absolute value of ((the highest roof point in solid's shape) - 4.0)) < 0.00001) named (the string form of "evaluated geometry follows the profile instead of a flat prism")
check roof form ((the length of (solid's shape's positions's values)) = 12) named (the string form of "straight extrusion uses section samples without uniform triangle explosion")
set layerShapes to the bim layer solids of plate roofValue in modelValue
check roof form ((the length of (layerShapes's values)) = 2) named (the string form of "roof retains its separate material layers")
check roof form ((the absolute value of ((the highest roof point in (the item at 0 in (layerShapes's values))'s shape) - 4.0)) < 0.00001) named (the string form of "visible top layer follows the same curved form")
check roof form ((the absolute value of ((the highest roof point in (the item at 1 in (layerShapes's values))'s shape) - (4.0 - (0.2 * (the square root of 2.0))))) < 0.00001) named (the string form of "lower layer has the correct miter depth below a sharp ridge")
set topLayer to (the item at 0 in (layerShapes's values))'s shape
set innerLayer to (the item at 1 in (layerShapes's values))'s shape
set shared to true
loop cursor from 0 to 6:
    if (the cad length of (the cad difference of (the item at cursor in (topLayer's positions's values)) and (the item at (cursor + 6) in (innerLayer's positions's values)))) > 0.000001:
        set shared to false
check roof form shared named (the string form of "material layers share exactly the same curved interface")
set outerEave to the item at 6 in (topLayer's positions's values)
set innerEave to the item at 0 in (topLayer's positions's values)
check roof form (((the absolute value of ((the cad length of (the cad difference of outerEave and innerEave)) - 0.2)) < 0.000001) and ((the absolute value of (outerEave's y - innerEave's y)) > 0.1)) named (the string form of "layer thickness follows the sloping surface normal")
set denseProfile to an empty list of a cad vector2
append (a cad vector2 with x -2.0 and y 0.0) to denseProfile
append (a cad vector2 with x -0.1 and y 1.9) to denseProfile
append (a cad vector2 with x 0.0 and y 2.0) to denseProfile
append (a cad vector2 with x 0.1 and y 1.9) to denseProfile
append (a cad vector2 with x 2.0 and y 0.0) to denseProfile
set innerProfile to the bim parallel roof profile of denseProfile offset -0.35
set ordered to (the length of innerProfile) = 5
loop cursor from 1 to the length of innerProfile:
    if (the item at cursor in innerProfile)'s x <= (the item at (cursor - 1) in innerProfile)'s x:
        set ordered to false
check roof form ordered named (the string form of "short segments near the ridge do not fold the inside layer")
set beforeSignature to the bim slab signature of roofValue in modelValue
replace item at index 1 in profilePoints with (a cad vector2 with x 0.0 and y 3.0)
store bim roof points profilePoints of roofId starting at bim roof form setting in target
check roof form ((the bim slab signature of roofValue in modelValue) != beforeSignature) named (the string form of "settings-only profile edits invalidate cached roof geometry")
set reread to the bim model parsed from (the bim file text of modelValue)
set restoredRoof to the item at 0 in (reread's modelValue's slabs's values)
set restoredSolid to the bim slab solid of restoredRoof in reread's modelValue
check roof form (reread's valid and ((the absolute value of ((the highest roof point in restoredSolid's shape) - 5.0)) < 0.00001)) named (the string form of "native roundtrip preserves the editable roof profile")
set endProfile to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 3.0) to endProfile
append (a cad vector2 with x 3.0 and y 3.0) to endProfile
append (a cad vector2 with x 6.0 and y 0.5) to endProfile
store bim roof points endProfile of roofId starting at ((bim roof form setting) + 400) in target
set hipped to the bim slab solid of roofValue in modelValue
set endHigh to -1e100
loop cursor from 0 to the length of (hipped's shape's positions's values):
    set spot to the item at cursor in (hipped's shape's positions's values)
    if (the absolute value of (spot's x - 6.0)) < 0.000001:
        set endHigh to the maximum of endHigh and spot's z
check roof form ((the absolute value of (endHigh - 2.5)) < 0.000001) named (the string form of "longitudinal hip lowers the roof end without separate roof tiles")
check roof form ((the bim slab signature of roofValue in modelValue) != (the bim slab signature of restoredRoof in reread's modelValue)) named (the string form of "hip profile changes participate in geometry invalidation")
