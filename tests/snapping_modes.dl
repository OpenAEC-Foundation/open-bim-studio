import editor/bim_editor_core.dl

function check snap mode {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set editor to a new bim editor
check snap mode ((editor's snapRefused bitwise and (the bim snap bit of 4)) != 0) named (the string form of "nearest is disabled by default")
set gridId to add bim grid named (the string form of "A") from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 10.0 and y 0.0) reaching -1.0 to 4.0 to (the address of (editor's documentValue's current))
set editor's snapRefused to 0
set editor's selectionKind to bim grid picked
set editor's selectionId to gridId
set nearEdge to a cad vector2 with x 3.2 and y 0.04
set snapped to the bim snap of nearEdge in editor within 0.1
check snap mode (snapped's label != (the string form of "Nearest")) named (the string form of "selected geometry does not enable nearest during hover")
set editor's tool to bim move tool
set snapped to the bim snap of nearEdge in editor within 0.1
check snap mode ((snapped's label = (the string form of "Nearest")) and ((the absolute value of snapped's point's y) < 1e-9)) named (the string form of "enabled nearest works during move")
set editor's tool to bim select tool
set editor's dragging to true
set snapped to the bim snap of nearEdge in editor within 0.1
check snap mode (snapped's label = (the string form of "Nearest")) named (the string form of "enabled nearest works during a selection drag")
set editor's dragging to false
set editor's tool to bim grid tool
set editor's snapRefused to the bim snap bit of 4
set snapped to the bim snap of (a cad vector2 with x 11.0 and y 0.04) in editor within 0.1
check snap mode (snapped's label = (the string form of "Extension")) named (the string form of "extension remains active with nearest disabled")

set editor's gridActive to true
set editor's gridStart to a cad vector2 with x -5.0 and y -3.0
set editor's orthoHeld to true
set diagonal to a cad vector2 with x 6.2 and y 4.1
set snapped to the bim snap of diagonal in editor within 0.1
check snap mode ((snapped's label = (the string form of "Horizontal")) and ((the absolute value of (snapped's point's y + 3.0)) < 1e-9)) named (the string form of "held Shift constrains the grid direction")
check snap mode (editor's orthoOn = false) named (the string form of "Shift does not change the latched F8 setting")
set editor's orthoHeld to false
set snapped to the bim snap of diagonal in editor within 0.1
check snap mode (snapped's label != (the string form of "Horizontal")) named (the string form of "releasing Shift restores unconstrained movement")
set editor's orthoOn to true
set snapped to the bim snap of diagonal in editor within 0.1
check snap mode (snapped's label = (the string form of "Horizontal")) named (the string form of "latched F8 remains available without Shift")
