# SPDX-License-Identifier: MPL-2.0
# The solid tools of the editor: BX draws a box into a new component (two
# corners, then a typed height), CY with Cut bores a cylinder out of that
# component, and SH with nothing selected makes a sphere component; undo
# takes a part back.
import editor/bim_editor.dl

function click solid test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function type solid test {a string:keys} in {a pointer to a bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of keys:
            type bim editor key ((the character at cursor in keys) as an integer) in editor

function list solid components of {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's components's values):
            set definition to the item at cursor in (modelValue's components's values)
            set measured to the bim volume of component definition
            set rounded to (the rounded value of (measured * 10000.0)) / 10000.0
            print ((definition's name + (the string form of ": parts ")) + ((the string form of (the length of (definition's solids's values))) + ((the string form of ", volume ") + (the string form of rounded)))) as a line
        print ((the string form of "instances ") + (the string form of (the length of (modelValue's instances's values)))) as a line

set editor to a new bim editor
set e to the address of editor
type bim editor key 2100 in e
print editor's message as a line
click solid test at 0.0 and 0.0 in e
click solid test at 2.0 and 1.0 in e
print editor's message as a line
type solid test (the string form of "1") in e
type bim editor key bim enter key code in e
print editor's message as a line
list solid components of editor's documentValue's current
type bim editor key 2105 in e
type bim editor key 2101 in e
print editor's message as a line
click solid test at 1.0 and 0.5 in e
click solid test at 1.25 and 0.5 in e
click solid test at 1.25 and 1.5 in e
print editor's message as a line
list solid components of editor's documentValue's current
type bim editor key bim escape key code in e
type bim editor key 2104 in e
type bim editor key 2102 in e
print editor's message as a line
click solid test at 5.0 and 5.0 in e
click solid test at 5.5 and 5.0 in e
list solid components of editor's documentValue's current
type bim editor key bim escape key code in e
ignore undo bim transaction in (the address of (editor's documentValue))
ignore undo bim transaction in (the address of (editor's documentValue))
list solid components of editor's documentValue's current

# The properties of an instance list its component's parts; the last part's
# size is typed there (the new editor's units are metres).
set firstInstance to (the item at 0 in (editor's documentValue's current's instances's values))'s id
select bim editor bim instance picked numbered firstInstance in e
set propertyRows to the bim property rows of editor
loop cursor from 0 to the length of propertyRows:
    set propertyRow to the item at cursor in propertyRows
    print ((the string form of "  ") + ((propertyRow's label + (the string form of ": ")) + propertyRow's value)) as a line
start bim editor property bim part height property in e
type solid test (the string form of "2") in e
type bim editor key bim enter key code in e
print editor's message as a line
list solid components of editor's documentValue's current
