# SPDX-License-Identifier: MPL-2.0
# The drawing standard as it shows on the drawings (`bim_drawing_standard.dl`):
# per standard how dimensions end, how levels are written and marked, how
# section lines are headed and how decimals are written; the standard kept as
# the project's setting through the native file and IfcX.
import model/bim_drawing_standard.dl
import editor/bim_editor.dl

function the standard test point {cad vector2:spot}:
    execute:
        return ((the string form of (spot's x as an integer)) + (the string form of ",")) + (the string form of (spot's y as an integer))

loop standardCode from 0 to bim standard count:
    print ((the string form of "== ") + (the bim name of standard standardCode)) as a line
    set endKind to the bim dimension ends under standardCode
    set endName to the string form of "ticks"
    if endKind = bim arrow ends:
        set endName to the string form of "arrows"
    if endKind = bim dot ends:
        set endName to the string form of "dots"
    set ticks to an empty list of a cad vector2
    append bim dimension ends at (a cad vector2 with x 10.0 and y 50.0) and (a cad vector2 with x 110.0 and y 50.0) along 1.0 and 0.0 under standardCode into ticks
    set endLine to ((the string form of "dimension ends: ") + endName) + ((the string form of ", ") + ((the string form of ((the length of ticks) / 2)) + (the string form of " strokes, first from ")))
    set endLine to endLine + ((the standard test point (the item at 0 in ticks)) + ((the string form of " to ") + (the standard test point (the item at 1 in ticks))))
    print endLine as a line
    free ticks
    print ((the string form of "decimals: ") + (the bim decimal text (the string form of "12.5") under standardCode)) as a line
    print ((((the string form of "levels: ") + (the bim level text of 0.0 under standardCode)) + (the string form of " | ")) + (((the bim level text of 3.0 under standardCode) + (the string form of " | ")) + (the bim level text of -0.45 under standardCode))) as a line
    set filled to an empty list of a cad vector2
    set outline to an empty list of a cad vector2
    append bim level mark at (a cad vector2 with x 100.0 and y 40.0) under standardCode into filled and outline
    print ((((the string form of "level mark: ") + (the string form of ((the length of filled) / 3))) + (the string form of " filled triangles, ")) + ((the string form of ((the length of outline) / 2)) + (the string form of " strokes"))) as a line
    free filled
    free outline
    set headKind to the bim section head under standardCode
    set headName to the string form of "arrow alone"
    if headKind = bim circle section head:
        set headName to the string form of "arrow on a circle"
    if headKind = bim divided section head:
        set headName to the string form of "arrow on a divided circle"
    print ((the string form of "section head: ") + headName) as a line

# The project's standard: NEN 47 unless set, kept through .bim and the
# editor's own file (binary IfcX).
set editor to a new bim editor
set e to the address of editor
add bim example building to e
set target to the address of (editor's documentValue's current)
print ((the string form of "project: ") + (the bim name of standard (the bim drawing standard of editor's documentValue's current))) as a line
set bim setting (bim drawing standard setting) of (0 as a 64 bit integer) to ((bim ansi standard) as a 64 bit integer) keeping true in target
set native to the bim model parsed from (the bim file text of editor's documentValue's current)
print ((the string form of "from .bim: ") + (the bim name of standard (the bim drawing standard of native's modelValue))) as a line
save bim editor to (the string form of "build/bim-slice-standard-test.ifcxb") in e
set other to a new bim editor
open bim editor from (the string form of "build/bim-slice-standard-test.ifcxb") in (the address of other)
print ((the string form of "from .ifcxb: ") + (the bim name of standard (the bim drawing standard of other's documentValue's current))) as a line
