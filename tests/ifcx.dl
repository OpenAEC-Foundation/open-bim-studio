# SPDX-License-Identifier: MPL-2.0
# IFC5 (IfcX) export of the example building with a component placed twice;
# the written file is checked by `verify_ifcx.py`, which composes it.
import editor/bim_editor.dl
import formats/bim_ifcx.dl

set editor to a new bim editor
set e to the address of editor
add bim example building to e
set target to the address of (editor's documentValue's current)
set block to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to block
append (a cad vector2 with x 1.0 and y 0.0) to block
append (a cad vector2 with x 1.0 and y 0.5) to block
append (a cad vector2 with x 0.0 and y 0.5) to block
set faceId to add bim face on editor's levelId around block to target
ignore set bim face faceId height to 0.8 in target
free block
set chosen to an empty list of a 64 bit integer
append faceId to chosen
set first to make bim component named (the string form of "Desk") from chosen on editor's levelId to target
free chosen
set found to the bim instance index of first in (@intrinsic("dereference", target))
set componentId to (the item at found's position in (target's instances's values))'s componentId
set second to place bim component componentId on editor's levelId at (a cad vector2 with x 2.0 and y 1.0) turned 1.5707963267948966 to target
ignore add bim line on editor's levelId from (a cad vector2 with x 0.0 and y -2.0) to (a cad vector2 with x 5.0 and y -2.0) to target
ignore add bim text on editor's levelId at (a cad vector2 with x 1.0 and y -2.5) saying (the string form of "Entrance \"north\"") to target
set content to the bim ifcx text of editor's documentValue's current identified as (the string form of "open-bim-studio/ifcx-test@v1.ifcx") for project (the string form of "open-bim-studio/ifcx-test") by (the string form of "open-bim-studio test") at (the string form of "2026-10-07T00:00:00Z")
if write bim text content to file (the string form of "bim-slice-test.ifcx"):
    print (the string form of "written bim-slice-test.ifcx") as a line
