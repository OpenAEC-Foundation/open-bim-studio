# SPDX-License-Identifier: MPL-2.0
# Stairs and railings are built of linear elements of the model's linear
# types. A stair's stringers of a chosen 60 x 250 steel type take its size
# and material; its treads of a chosen 50 mm oak plank take that thickness.
# A railing 3 m long with balusters every 120 mm gets them between its posts,
# of the default 20 mm rod or of a chosen type. Chosen types survive the
# file.
import editor/bim_editor.dl

function show bim profile test of {a pointer to a list:partList} labelled {a string:title}:
    execute:
        set counts to an empty list of an integer
        set names to an empty list of a string
        loop partCursor from 0 to the length of partList:
            set part to the item at partCursor in partList
            set known to -1
            loop nameCursor from 0 to the length of names:
                if (the item at nameCursor in names) = ((part's kind's name + (the string form of " ")) + (the string form of ((@intrinsic("call", "libc", "round", a 64 bit floating-point number, part's kind's depth * 1000.0)) as an integer))):
                    set known to nameCursor
            if known < 0:
                append ((part's kind's name + (the string form of " ")) + (the string form of ((@intrinsic("call", "libc", "round", a 64 bit floating-point number, part's kind's depth * 1000.0)) as an integer))) to names
                append 1 to counts
            else:
                replace item at index known in counts with ((the item at known in counts) + 1)
        print title as a line
        loop nameCursor from 0 to the length of names:
            print ((the string form of "  ") + ((the item at nameCursor in names) + ((the string form of " mm deep x") + (the string form of (the item at nameCursor in counts))))) as a line
        free counts
        free names

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to target
set stairId to add bim stair on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 3.6 and y 0.0) wide 1.0 in 17 risers of (the string form of "timber") to target
set stairValue to the item at 0 in (modelValue's stairs's values)
set defaultParts to the bim parts of stair stairValue in modelValue
show bim profile test of (defaultParts's values) labelled (the string form of "default stair")
set steelType to add bim linear type named (the string form of "Staal 60x250") as role bim beam role sized 0.06 by 0.25 round false of (the string form of "steel") to target
set oakType to add bim linear type named (the string form of "Eiken plank 50") as role bim generic linear role sized 0.3 by 0.05 round false of (the string form of "oak") to target
set bim setting ((bim part type setting) + (bim stringer part)) of stairId to steelType keeping true in target
set bim setting ((bim part type setting) + (bim tread part)) of stairId to oakType keeping true in target
set chosenParts to the bim parts of stair stairValue in modelValue
show bim profile test of (chosenParts's values) labelled (the string form of "chosen profiles")
set railPath to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 5.0) to railPath
append (a cad vector2 with x 3.0 and y 5.0) to railPath
set railingId to add bim railing on ground along railPath hosted by (the bim refused id) rising 1.0 of (the string form of "steel") to target
set bim setting (bim baluster spacing setting) of railingId to (120 as a 64 bit integer) keeping true in target
set railingValue to the item at 0 in (modelValue's railings's values)
set railingParts to the bim parts of railing railingValue in modelValue
show bim profile test of (railingParts's values) labelled (the string form of "railing with balusters every 120 mm")
set reread to the bim model parsed from (the bim file text of modelValue)
set rereadParts to the bim parts of stair (the item at 0 in (reread's modelValue's stairs's values)) in reread's modelValue
show bim profile test of (rereadParts's values) labelled (the string form of "chosen profiles from .bim")
# IFC: the stair and railing as assemblies of members, each member's body
# a triangulated face set.
set ifcText to the bim ifc text of modelValue
print ((the string form of "IFC stair: ") + (the string form of ((the index of "IFCSTAIR(" in ifcText) >= 0))) as a line
print ((the string form of "IFC railing: ") + (the string form of ((the index of "IFCRAILING(" in ifcText) >= 0))) as a line
print ((the string form of "IFC members: ") + (the string form of ((the index of "IFCMEMBER(" in ifcText) >= 0))) as a line
print ((the string form of "IFC tessellation: ") + (the string form of ((the index of "IFCTRIANGULATEDFACESET(" in ifcText) >= 0))) as a line
print ((the string form of "IFC aggregates: ") + (the string form of ((the index of "IFCRELAGGREGATES(" in ifcText) >= 0))) as a line
