# SPDX-License-Identifier: MPL-2.0
# Selecting by a box, as in CAD: dragged to the right a window takes what lies
# wholly inside; dragged to the left a crossing also takes what it touches.
# The elements taken move and are deleted together; Shift adds.
import editor/bim_editor.dl

function click bim box test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function box bim test from {cad vector2:corner} to {cad vector2:opposite} in {a pointer to a bim editor record:editor}:
    execute:
        set outlines to the bim selection outlines of (@intrinsic("dereference", editor)) in plan true
        project bim selection outlines outlines from above
        ignore select bim editor in box from corner to opposite among outlines in editor
        print editor's message as a line

function count bim test elements of {a pointer to a bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        print ((the string form of "  walls ") + ((the string form of (the length of (modelValue's walls's values))) + ((the string form of ", sketches ") + (the string form of (the length of (modelValue's sketches's values)))))) as a line

set editor to a new bim editor
set e to the address of editor
type bim editor key 87 in e
click bim box test at 0.0 and 0.0 in e
click bim box test at 4.0 and 0.0 in e
type bim editor key bim escape key code in e
type bim editor key 87 in e
click bim box test at 10.0 and 0.0 in e
click bim box test at 14.0 and 0.0 in e
type bim editor key bim escape key code in e
type bim editor key 78 in e
click bim box test at 0.0 and 5.0 in e
click bim box test at 3.0 and 5.0 in e
type bim editor key bim enter key code in e
type bim editor key bim escape key code in e
count bim test elements of e
# A window around the first wall and the line.
box bim test from (a cad vector2 with x -1.0 and y -1.0) to (a cad vector2 with x 5.0 and y 6.0) in e
# A crossing over the middle: both walls touch it, the line does not.
box bim test from (a cad vector2 with x 12.0 and y -1.0) to (a cad vector2 with x 3.0 and y 1.0) in e
# The same box as a window takes nothing.
box bim test from (a cad vector2 with x 3.0 and y -1.0) to (a cad vector2 with x 12.0 and y 1.0) in e
# Shift adds the line to the crossing.
box bim test from (a cad vector2 with x 12.0 and y -1.0) to (a cad vector2 with x 3.0 and y 1.0) in e
set editor's extending to true
box bim test from (a cad vector2 with x 4.0 and y 4.0) to (a cad vector2 with x 2.0 and y 6.0) in e
set editor's extending to false
# Moved together 1 m north.
type bim editor key 77 in e
click bim box test at 0.0 and 0.0 in e
click bim box test at 0.0 and 1.0 in e
print editor's message as a line
loop cursor from 0 to the length of (editor's documentValue's current's walls's values):
    set wallValue to the item at cursor in (editor's documentValue's current's walls's values)
    print ((the string form of "  wall from y ") + (the string form of wallValue's start's y)) as a line
set lineValue to the item at 0 in (editor's documentValue's current's sketches's values)
print ((the string form of "  line at y ") + (the string form of (the item at 0 in (lineValue's points's values))'s y)) as a line
# Deleted together, and back with undo.
type bim editor key bim escape key code in e
box bim test from (a cad vector2 with x 20.0 and y -5.0) to (a cad vector2 with x -5.0 and y 10.0) in e
type bim editor key bim delete key code in e
print editor's message as a line
count bim test elements of e
type bim editor key 90 in e
count bim test elements of e
