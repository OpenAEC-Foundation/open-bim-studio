# SPDX-License-Identifier: MPL-2.0
import editor/bim_type_manager.dl

function check manager layout {boolean:accepted} named {a string:captionText}:
    execute:
        if accepted = false:
            print ((the string form of "FAIL: ") + captionText) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + captionText) as a line

set workEditor to a new bim editor
set managerState to a new bim type manager
set editorPointer to the address of workEditor
set managerPointer to the address of managerState
set chosenType to add bim managed type on tab 0 in editorPointer
ignore change bim managed type chosenType layer 0 by 1 in editorPointer
open bim type manager in managerPointer for editorPointer
set managerState's chosenId to chosenType
refresh bim type manager managerPointer for workEditor
set managerState's field to 2
set managerState's text to the string form of "999"
set managerState's replaceText to true
set layoutValue to the bim type manager layout of managerState across 1000.0 by 800.0
click bim type manager at (layoutValue's left + 420.0) and (layoutValue's top + 500.0) across 1000.0 by 800.0 in managerPointer for editorPointer
check manager layout ((managerState's layer = 1) and ((managerState's field = -1) and (((the length of managerState's text) = 0) and (managerState's replaceText = false)))) named (the string form of "next layer discards pending field text")
set originalThickness to the bim managed field 2 of (the bim managed type chosenType on tab 0 in workEditor's documentValue's current) layer 1 in workEditor
type bim type manager key (bim enter key code) in managerPointer for editorPointer
check manager layout ((the bim managed field 2 of (the bim managed type chosenType on tab 0 in workEditor's documentValue's current) layer 1 in workEditor) = originalThickness) named (the string form of "Enter after navigation never writes old input to the new layer")
set managerState's field to 1
set managerState's text to the string form of "pending material"
set managerState's replaceText to true
click bim type manager at (layoutValue's left + 350.0) and (layoutValue's top + 500.0) across 1000.0 by 800.0 in managerPointer for editorPointer
check manager layout ((managerState's layer = 0) and ((managerState's field = -1) and (((the length of managerState's text) = 0) and (managerState's replaceText = false)))) named (the string form of "previous layer discards pending material text")
set layoutValue to the bim type manager layout of managerState across 1000.0 by 400.0
check manager layout ((layoutValue's top >= 0.0) and ((layoutValue's top + layoutValue's height) <= 400.0)) named (the string form of "short manager stays inside the window")
scroll bim type manager details by 100 across 1000.0 by 400.0 in managerPointer
set layoutValue to the bim type manager layout of managerState across 1000.0 by 400.0
check manager layout ((layoutValue's detailShift = layoutValue's detailLimit) and (bim manager detail band at (486.0 - layoutValue's detailShift) tall 28.0 is visible in layoutValue)) named (the string form of "scroll reaches full size layer controls in a short window")
set managerState's field to -1
click bim type manager at (layoutValue's left + 450.0) and ((layoutValue's top + 412.0) - layoutValue's detailShift) across 1000.0 by 400.0 in managerPointer for editorPointer
check manager layout (managerState's field = 5) named (the string form of "scrolled field hit matches its visible row")
click bim type manager at (layoutValue's left + 420.0) and ((layoutValue's top + 500.0) - layoutValue's detailShift) across 1000.0 by 400.0 in managerPointer for editorPointer
check manager layout ((managerState's layer = 1) and (managerState's field = -1)) named (the string form of "scrolled layer button hit matches its visible position")
set managerState's field to -1
click bim type manager at (layoutValue's left + 450.0) and (layoutValue's top + 112.0) across 1000.0 by 400.0 in managerPointer for editorPointer
check manager layout (managerState's field = -1) named (the string form of "clipped detail rows cannot intercept toolbar clicks")
scroll bim type manager details by -100 across 1000.0 by 400.0 in managerPointer
set layoutValue to the bim type manager layout of managerState across 1000.0 by 400.0
check manager layout (layoutValue's detailShift = 0.0) named (the string form of "detail scroll clamps at the first row")
set secondType to add bim managed type on tab 0 in editorPointer
refresh bim type manager managerPointer for workEditor
set managerState's chosenId to chosenType
type bim type manager key 264 in managerPointer for editorPointer
check manager layout (managerState's chosenId = secondType) named (the string form of "Down selects the next type")
type bim type manager key 265 in managerPointer for editorPointer
check manager layout (managerState's chosenId = chosenType) named (the string form of "Up selects the previous type")
