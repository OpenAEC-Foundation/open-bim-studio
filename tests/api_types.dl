# SPDX-License-Identifier: MPL-2.0
# Native type-library API requests exercise definitions without proxy objects.
import automation/bim_api.dl

function check api types {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function api types response {a string:answer} succeeds:
    execute:
        return (the index of (the string form of "\"ok\":true") in answer) >= 0

function api type call {a string:body} for {a pointer to a bim editor record:editTarget}:
    execute:
        return the bim api answer to (((the string form of "types-test\n") + body) + (the string form of "\n")) for editTarget

set editor to a new bim editor
set editTarget to the address of editor
set editor's lengthUnit to bim millimetre unit
set beforeInstances to the length of (editor's documentValue's current's instances's values)
set wallTypeId to editor's documentValue's current's nextId
set answer to api type call (the string form of "typeadd\n0") for editTarget
check api types (api types response answer succeeds) named (the string form of "add a wall type through the native API")
set answer to api type call (the string form of "types\n0") for editTarget
check api types (((the index of (the string form of "\"ifcClass\":\"IfcWallType\"") in answer) >= 0) and ((the index of (the string form of "\"layers\":[") in answer) >= 0)) named (the string form of "list exposes IFC class material dimensions and layers")
set answer to api type call (((the string form of "typeset\n0\n") + (the string form of wallTypeId)) + (the string form of "\n0\nCustom wall")) for editTarget
check api types ((api types response answer succeeds) and ((the bim managed type wallTypeId on tab 0 in editor's documentValue's current)'s name = (the string form of "Custom wall"))) named (the string form of "set name addresses a stable type id")
set answer to api type call (((the string form of "typeset\n0\n") + (the string form of wallTypeId)) + (the string form of "\n2\n250\n0")) for editTarget
check api types ((api types response answer succeeds) and ((the bim managed type wallTypeId on tab 0 in editor's documentValue's current)'s width = 0.25)) named (the string form of "set layer thickness converts project millimetres to metres")
set answer to api type call (((the string form of "typeset\n0\n") + (the string form of wallTypeId)) + (the string form of "\n1\ntimber")) for editTarget
check api types ((api types response answer succeeds) and ((the bim managed type wallTypeId on tab 0 in editor's documentValue's current)'s material = (the string form of "timber"))) named (the string form of "set layer material updates the definition")
set duplicateId to editor's documentValue's current's nextId
set answer to api type call ((the string form of "typeduplicate\n0\n") + (the string form of wallTypeId)) for editTarget
check api types ((api types response answer succeeds) and ((the bim managed type duplicateId on tab 0 in editor's documentValue's current)'s width = 0.25)) named (the string form of "duplicate preserves definition dimensions")
set answer to api type call ((the string form of "typedelete\n0\n") + (the string form of duplicateId)) for editTarget
check api types ((api types response answer succeeds) and ((the bim managed type duplicateId on tab 0 in editor's documentValue's current)'s id = the bim refused id)) named (the string form of "delete unused type removes its definition")
set answer to api type call (the string form of "undo") for editTarget
check api types ((the bim managed type duplicateId on tab 0 in editor's documentValue's current)'s id = duplicateId) named (the string form of "undo restores the deleted type with its stable id")
set answer to api type call (the string form of "redo") for editTarget
check api types ((the bim managed type duplicateId on tab 0 in editor's documentValue's current)'s id = the bim refused id) named (the string form of "redo removes the restored unused type")
set answer to api type call ((the string form of "typeapply\n0\n") + (the string form of wallTypeId)) for editTarget
check api types ((api types response answer succeeds) and (editor's wallTypeId = wallTypeId)) named (the string form of "apply changes the drawing default without an instance")
set answer to api type call (the string form of "wall\n0\n0\n5\n0") for editTarget
set wallId to (the item at 0 in (editor's documentValue's current's walls's values))'s id
set beforeRevision to editor's documentValue's revision
set answer to api type call ((the string form of "typedelete\n0\n") + (the string form of wallTypeId)) for editTarget
check api types (((api types response answer succeeds) = false) and (editor's documentValue's revision = beforeRevision)) named (the string form of "delete used type refuses without a transaction")
set beamTypeId to editor's documentValue's current's nextId
set answer to api type call (the string form of "typeadd\n5") for editTarget
check api types ((api types response answer succeeds) and ((the bim managed type beamTypeId on tab 5 in editor's documentValue's current)'s ifcClass = (the string form of "IfcBeamType"))) named (the string form of "add beam creates the correct IFC type class")
set answer to api type call (((the string form of "typeset\n5\n") + (the string form of beamTypeId)) + (the string form of "\n3\n450")) for editTarget
check api types ((api types response answer succeeds) and ((the bim managed type beamTypeId on tab 5 in editor's documentValue's current)'s depth = 0.45)) named (the string form of "set beam depth uses the native type operation")
set openingTypeId to editor's documentValue's current's nextId
set answer to api type call (the string form of "typeadd\n7") for editTarget
check api types ((api types response answer succeeds) and ((the bim managed type openingTypeId on tab 7 in editor's documentValue's current)'s ifcClass = (the string form of "IfcWindowType"))) named (the string form of "add opening creates an unused window type")
set answer to api type call (((the string form of "typeset\n7\n") + (the string form of openingTypeId)) + (the string form of "\n4\n1100")) for editTarget
check api types ((api types response answer succeeds) and ((the bim managed type openingTypeId on tab 7 in editor's documentValue's current)'s sill = 1.1)) named (the string form of "set opening sill updates only its definition")
set beforeRevision to editor's documentValue's revision
set beforeUndo to the length of (editor's documentValue's undoStack's values)
set beforeId to editor's documentValue's current's nextId
set invalidBodies to [the string form of "types\n9", the string form of "typeadd\n1.5", the string form of "typeadd\n-1", the string form of "typeadd\n0\nextra", the string form of "typeduplicate\n0\n999999", the string form of "typeapply\n0\n1.5", the string form of "typeset\n0\n\n0\nName"]
loop invalidCursor from 0 to the length of invalidBodies:
    set answer to api type call (the item at invalidCursor in invalidBodies) for editTarget
    check api types ((api types response answer succeeds) = false) named ((the string form of "invalid tab id count or blank field refused ") + (the string form of invalidCursor))
set invalidFields to [the string form of "\n7\nName", the string form of "\n2\n-1", the string form of "\n2\nNaN", the string form of "\n2\n250\n9", the string form of "\n3\n300", the string form of "\n0\n   ", the string form of "\n0\n\n0"]
loop invalidCursor from 0 to the length of invalidFields:
    set answer to api type call (((the string form of "typeset\n0\n") + (the string form of wallTypeId)) + (the item at invalidCursor in invalidFields)) for editTarget
    check api types ((api types response answer succeeds) = false) named ((the string form of "invalid field value or layer refused ") + (the string form of invalidCursor))
check api types (((editor's documentValue's revision = beforeRevision) and (editor's documentValue's current's nextId = beforeId)) and ((the length of (editor's documentValue's undoStack's values)) = beforeUndo)) named (the string form of "invalid type requests preserve revision ids and undo")
set answer to api type call ((the string form of "typeapply\n0\n") + (the string form of beamTypeId)) for editTarget
check api types ((api types response answer succeeds) = false) named (the string form of "type id from a different tab is refused")
select bim editor bim wall picked numbered wallId in editTarget
set alternateId to editor's documentValue's current's nextId
set answer to api type call (the string form of "typeadd\n0") for editTarget
set answer to api type call ((the string form of "typeapply\n0\n") + (the string form of alternateId)) for editTarget
check api types ((api types response answer succeeds) and ((the item at 0 in (editor's documentValue's current's walls's values))'s typeId = alternateId)) named (the string form of "apply updates a compatible selected occurrence")
set answer to api type call (the string form of "undo") for editTarget
check api types ((the item at 0 in (editor's documentValue's current's walls's values))'s typeId = wallTypeId) named (the string form of "undo restores the selected occurrence type")
set editor's modify's count to 8
set editor's modify's radial to true
set editor's numeric to the string form of "2*(3+4)"
set beforeRevision to editor's documentValue's revision
set answer to api type call (the string form of "options") for editTarget
check api types (((the index of (the string form of "\"count\":8") in answer) >= 0) and ((the index of (the string form of "\"radial\":true") in answer) >= 0)) named (the string form of "options exposes actual modify controls")
check api types (((the index of (the string form of "2*(3+4)") in answer) >= 0) and (editor's documentValue's revision = beforeRevision)) named (the string form of "options preserves numeric input and revision")
check api types ((the length of (editor's documentValue's current's instances's values)) = beforeInstances) named (the string form of "type API operations create no proxy instances")

set sourceGridId to add bim grid named (the string form of "Busy source") from (a cad vector2 with x 20.0 and y 0.0) to (a cad vector2 with x 20.0 and y 10.0) reaching 0.0 to 3.0 to (the address of (editor's documentValue's current))
select bim editor bim wall picked numbered wallId in editTarget
set originalStart to (the item at 0 in (editor's documentValue's current's walls's values))'s start
set editor's tool to bim move tool
set editor's moveStage to 2
begin bim transaction in (the address of (editor's documentValue))
reposition bim editor selection by (the bim shift transform by (a cad vector2 with x 3.0 and y 0.0)) in editTarget
set provisionalStart to (the item at 0 in (editor's documentValue's current's walls's values))'s start
set beforeRevision to editor's documentValue's revision
set beforeUndo to the length of (editor's documentValue's undoStack's values)
set beforeRedo to the length of (editor's documentValue's redoStack's values)
set beforeId to editor's documentValue's current's nextId
set beforeDefault to editor's wallTypeId
set beforeSelectedId to editor's selectionId
set beforeSelectedKind to editor's selectionKind
set beforeChosenCount to the length of (editor's chosenSketches's values)
set beforePropertyCode to editor's propertyCode
set beforePropertyText to editor's propertyText
set beforeNumeric to editor's numeric
set beforeMessage to editor's message
set beforeWalls to the length of (editor's documentValue's current's walls's values)
set beforeSlabs to the length of (editor's documentValue's current's slabs's values)
set beforeSystems to the length of (editor's documentValue's current's curtains's values)
set beforeGrids to the length of (editor's documentValue's current's grids's values)
set beforeWallHeight to (the item at 0 in (editor's documentValue's current's walls's values))'s height
set busyBodies to [the string form of "grid\nBusy blocked\n30\n0\n30\n10\n0\n3", ((the string form of "gridrepeat\n") + (the string form of sourceGridId)) + (the string form of "\n1000"), the string form of "typeadd\n0", (the string form of "typeduplicate\n0\n") + (the string form of wallTypeId), ((the string form of "typeset\n0\n") + (the string form of wallTypeId)) + (the string form of "\n0\nBlocked name"), (the string form of "typeapply\n0\n") + (the string form of alternateId), (the string form of "typedelete\n0\n") + (the string form of alternateId)]
loop busyCursor from 0 to the length of busyBodies:
    set answer to api type call (the item at busyCursor in busyBodies) for editTarget
    check api types (((api types response answer succeeds) = false) and ((the index of (the string form of "active provisional gesture") in answer) >= 0)) named ((the string form of "direct write refuses a provisional move ") + (the string form of busyCursor))
set legacyBusyBodies to [the string form of "wall\n30\n0\n35\n0", the string form of "slab\n30\n0\n35\n5", the string form of "system\n30\n0\n35\n0", ((the string form of "property\n") + (the string form of bim wall height property)) + (the string form of "\n4500"), (the string form of "select\n") + (the string form of sourceGridId), the string form of "undo", the string form of "redo"]
loop legacyBusyCursor from 0 to the length of legacyBusyBodies:
    set answer to api type call (the item at legacyBusyCursor in legacyBusyBodies) for editTarget
    check api types (((api types response answer succeeds) = false) and ((the index of (the string form of "active provisional gesture") in answer) >= 0)) named ((the string form of "model selection or history request refuses a provisional move ") + (the string form of legacyBusyCursor))
check api types (((editor's documentValue's revision = beforeRevision) and (editor's documentValue's current's nextId = beforeId)) and (((the length of (editor's documentValue's undoStack's values)) = beforeUndo) and ((the length of (editor's documentValue's redoStack's values)) = beforeRedo))) named (the string form of "busy writes preserve revision ids undo and redo")
check api types ((((the item at 0 in (editor's documentValue's current's walls's values))'s start's x = provisionalStart's x) and (editor's wallTypeId = beforeDefault)) and ((editor's tool = bim move tool) and (editor's moveStage = 2))) named (the string form of "busy writes preserve provisional geometry tool stage and default")
check api types (((editor's selectionId = beforeSelectedId) and (editor's selectionKind = beforeSelectedKind)) and ((the length of (editor's chosenSketches's values)) = beforeChosenCount)) named (the string form of "busy background requests preserve the complete selection")
check api types (((editor's propertyCode = beforePropertyCode) and (editor's propertyText = beforePropertyText)) and ((editor's numeric = beforeNumeric) and (editor's message = beforeMessage))) named (the string form of "busy background requests preserve property input numeric text and message")
check api types ((((the length of (editor's documentValue's current's walls's values)) = beforeWalls) and ((the length of (editor's documentValue's current's slabs's values)) = beforeSlabs)) and (((the length of (editor's documentValue's current's curtains's values)) = beforeSystems) and ((the length of (editor's documentValue's current's grids's values)) = beforeGrids))) named (the string form of "busy background requests leave no created model elements")
check api types ((the item at 0 in (editor's documentValue's current's walls's values))'s height = beforeWallHeight) named (the string form of "busy property write leaves the original wall height intact")
set answer to api type call (the string form of "types\n0") for editTarget
check api types (api types response answer succeeds) named (the string form of "type listing remains available during a gesture")
set answer to api type call (the string form of "options") for editTarget
check api types (api types response answer succeeds) named (the string form of "tool options remain available during a gesture")
set answer to api type call (the string form of "cursor\n2\n3") for editTarget
check api types ((api types response answer succeeds) and ((editor's moveStage = 2) and ((the length of (editor's documentValue's undoStack's values)) = beforeUndo))) named (the string form of "cursor remains available without nesting a gesture transaction")
set answer to api type call (the string form of "key\n256") for editTarget
check api types ((api types response answer succeeds) and (((the item at 0 in (editor's documentValue's current's walls's values))'s start's x = originalStart's x) and ((the length of (editor's documentValue's undoStack's values)) = (beforeUndo - 1)))) named (the string form of "gesture driver escape rolls back the original move snapshot")
loop gestureCursor from 0 to 4:
    set editor's tool to bim select tool
    set editor's moveStage to 0
    set editor's dragging to gestureCursor = 0
    set editor's grabbing to gestureCursor = 1
    set editor's pushId to the bim refused id
    if gestureCursor = 2:
        set editor's pushId to wallId
    if gestureCursor = 3:
        set editor's tool to bim rotate tool
        set editor's moveStage to 3
    set answer to api type call (the string form of "typeadd\n0") for editTarget
    check api types (((api types response answer succeeds) = false) and ((the index of (the string form of "active provisional gesture") in answer) >= 0)) named ((the string form of "direct write refuses drag grab push or rotate ") + (the string form of gestureCursor))
set editor's dragging to false
set editor's grabbing to false
set editor's pushId to the bim refused id
set editor's tool to bim select tool
set editor's moveStage to 0
