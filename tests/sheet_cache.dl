import formats/bim_sheet_cache.dl

function check sheet cache {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set firstRevision to 1 as a 64 bit integer
set nextRevision to 2 as a 64 bit integer
set sheetId to 20 as a 64 bit integer
set otherSheetId to 21 as a 64 bit integer
set corner to a cad vector2 with x 20.0 and y 600.0
set key to the bim sheet recording key at revision firstRevision for sheetId density 0.7 at corner sized 1440 by 900 hiding (the string form of "")
check sheet cache (key = (the bim sheet recording key at revision firstRevision for sheetId density 0.7 at corner sized 1440 by 900 hiding (the string form of ""))) named (the string form of "unchanged sheet reuses recording")
check sheet cache (key != (the bim sheet recording key at revision nextRevision for sheetId density 0.7 at corner sized 1440 by 900 hiding (the string form of ""))) named (the string form of "model edit invalidates recording")
check sheet cache (key != (the bim sheet recording key at revision firstRevision for otherSheetId density 0.7 at corner sized 1440 by 900 hiding (the string form of ""))) named (the string form of "sheet switch invalidates recording")
check sheet cache (key != (the bim sheet recording key at revision firstRevision for sheetId density 0.700001 at corner sized 1440 by 900 hiding (the string form of ""))) named (the string form of "small density change invalidates recording")
set corner's y to 601.0
check sheet cache (key != (the bim sheet recording key at revision firstRevision for sheetId density 0.7 at corner sized 1440 by 900 hiding (the string form of ""))) named (the string form of "vertical sheet movement invalidates recording")
set corner's y to 600.0
check sheet cache (key != (the bim sheet recording key at revision firstRevision for sheetId density 0.7 at corner sized 1440 by 901 hiding (the string form of ""))) named (the string form of "framebuffer resize invalidates recording")
check sheet cache (key != (the bim sheet recording key at revision firstRevision for sheetId density 0.7 at corner sized 1440 by 900 hiding (the string form of "136:12"))) named (the string form of "session visibility invalidates recording")
