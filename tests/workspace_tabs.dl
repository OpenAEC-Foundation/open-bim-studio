import app/bim_workspace_tabs.dl

function check workspace tab {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set kinds to an empty list of an integer
set details to an empty list of a 64 bit integer
loop index from 0 to 4:
    append index to kinds
    append ((100 + index) as a 64 bit integer) to details
check workspace tab (move bim workspace tab 0 to 3 among kinds and details) named (the string form of "move first tab to last")
check workspace tab (((the item at 3 in kinds) = 0) and ((the item at 3 in details) = 100)) named (the string form of "view identity stays paired")
check workspace tab ((the bim tab index 2 after moving 0 to 3) = 1) named (the string form of "tiled pane index follows reorder")
check workspace tab ((the bim tab index -1 after moving 0 to 3) = -1) named (the string form of "absent pane stays absent")
check workspace tab (move bim workspace tab 3 to 0 among kinds and details) named (the string form of "move last tab to first")
check workspace tab (((the item at 0 in kinds) = 0) and ((the item at 3 in details) = 103)) named (the string form of "reverse move restores order")
check workspace tab ((move bim workspace tab 0 to -1 among kinds and details) = false) named (the string form of "outside drop does not reorder")
check workspace tab ((the bim workspace tab width for 900.0) = 180.0) named (the string form of "long view names leave room for other tabs")
check workspace tab ((the bim workspace tab width for 12.0) = 88.0) named (the string form of "short tabs retain a separate close target")
check workspace tab ((the bim workspace scroll 0.0 revealing 720.0 to 900.0 across 400.0 of 1080.0) = 500.0) named (the string form of "activating an overflow tab brings it into view")
check workspace tab ((the bim workspace scroll 500.0 revealing 0.0 to 180.0 across 400.0 of 1080.0) = 0.0) named (the string form of "returning to the first view restores its tab")
check workspace tab ((the bim workspace scroll 500.0 limited across 800.0 of 360.0) = 0.0) named (the string form of "two views fit without hidden overflow")
check workspace tab ((the bim workspace scroll 900.0 limited across 400.0 of 540.0) = 140.0) named (the string form of "closing tabs clamps the previous scroll position")
reset bim workspace tabs for plan (987 as a 64 bit integer) among kinds and details
check workspace tab (((the length of kinds) = 2) and ((the length of details) = 2)) named (the string form of "new document clears old sheet and view tabs")
check workspace tab (((the item at 0 in details) = 987) and ((the item at 1 in kinds) = 1)) named (the string form of "new document tabs refer to its actual plan and 3D view")
