# SPDX-License-Identifier: MPL-2.0
# Small editor actions shared by the properties panel and file/MCP API.
import editor/bim_editor_core.dl
import model/bim_window_placement.dl

function bim window host property:
    replacement:
        12613
function bim window gap property:
    replacement:
        12614
function bim window depth property:
    replacement:
        12615

function start bim editor window host property {integer:code} in {a pointer to a bim editor record:editor}:
    execute:
        if code != bim window host property:
            return false
        set editor's propertyCode to -1
        if editor's selectionKind != bim curtain picked:
            return true
        set hosting to the bim setting (bim host opening setting) of editor's selectionId in editor's documentValue's current
        if hosting's found:
            if (the bim opening index of hosting's value in editor's documentValue's current)'s valid:
                select bim editor bim opening picked numbered hosting's value in editor
                set editor's message to the string form of "Opening selected; edit its dimensions or select the window system"
                return true
        set editor's message to the string form of "This system has no valid wall opening"
        return true

function apply bim editor window placement property {integer:code} in {a pointer to a bim editor record:editor}:
    execute:
        if (code != bim window gap property) and (code != bim window depth property):
            return false
        set editor's propertyCode to -1
        if editor's selectionKind != bim curtain picked:
            set editor's message to the string form of "Select a window system in a wall opening"
            return true
        set reading to the bim real reading of editor's propertyText
        if reading's valid = false:
            set editor's message to the string form of "Enter a finite placement distance"
            return true
        set metres to reading's value * (the bim metres per editor's lengthUnit)
        if ((metres - metres) != 0.0) or ((the absolute value of metres) > 1000.0):
            set editor's message to the string form of "Placement distance is outside the supported range"
            return true
        if (code = bim window gap property) and (metres < 0.0):
            set editor's message to the string form of "The installation gap cannot be negative"
            return true
        set millimetres to (the rounded value of (metres * 1000.0)) as a 64 bit integer
        set found to the bim curtain index of editor's selectionId in editor's documentValue's current
        if found's valid = false:
            return true
        set currentValue to the item at found's position in (editor's documentValue's current's curtains's values)
        if (the bim system currentValue hosted in its opening in editor's documentValue's current)'s valid = false:
            set editor's message to the string form of "This system has no valid wall opening"
            return true
        set unchanged to false
        if code = bim window gap property:
            set unchanged to (the absolute value of ((the bim installation gap of window editor's selectionId in editor's documentValue's current) - ((millimetres as a 64 bit floating-point number) / 1000.0))) < 0.000000001
        else:
            set unchanged to (the bim setting (bim host depth setting) of editor's selectionId in editor's documentValue's current)'s value = millimetres
        if unchanged:
            set editor's message to the string form of "Window placement is unchanged"
            return true
        set previousRedo to editor's documentValue's redoStack
        begin bim transaction in (the address of (editor's documentValue))
        set changed to false
        if code = bim window gap property:
            set changed to set bim window editor's selectionId installation gap to millimetres in (the address of (editor's documentValue's current))
        else:
            set changed to set bim window editor's selectionId installation depth to millimetres in (the address of (editor's documentValue's current))
        if changed:
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Window placement changed"
        else:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's documentValue's redoStack to previousRedo
            set editor's message to the string form of "Refused: the window must fit a valid wall opening"
        return true
