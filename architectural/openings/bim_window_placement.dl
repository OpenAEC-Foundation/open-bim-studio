# SPDX-License-Identifier: MPL-2.0
# Placement edits retain the window's cell layout and semantic opening host.
import model/bim_window_actions.dl

function the bim installation gap of window {a 64 bit integer:systemId} in {bim model record:modelValue}:
    execute:
        set requested to the bim setting (bim window clearance setting) of systemId in modelValue
        if requested's found:
            return (requested's value as a 64 bit floating-point number) / 1000.0
        # Old files store the inset to the profile centre, not its outer face.
        set insetReading to the bim setting (bim host joint setting) of systemId in modelValue
        return ((insetReading's value as a 64 bit floating-point number) / 1000.0) - ((the bim joint width of system systemId in modelValue) * 0.5)

function set bim window {a 64 bit integer:systemId} installation gap to {a 64 bit integer:millimetres} in {a pointer to a bim model record:target}:
    execute:
        if (millimetres < (0 as a 64 bit integer)) or (millimetres > (1000000 as a 64 bit integer)):
            return false
        set found to the bim curtain index of systemId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set storedValue to the item at found's position in (target's curtains's values)
        if bim window systemId has a face contour in (@intrinsic("dereference", target)):
            return false
        set previousPlacement to the bim system storedValue hosted in its opening in (@intrinsic("dereference", target))
        if previousPlacement's valid = false:
            return false
        set hostReading to the bim setting (bim host opening setting) of systemId in (@intrinsic("dereference", target))
        set openingValue to the item at (the bim opening index of hostReading's value in (@intrinsic("dereference", target)))'s position in (target's openings's values)
        set openingType to the item at (the bim opening type index of openingValue's typeId in (@intrinsic("dereference", target)))'s position in (target's openingTypes's values)
        set frameWide to the bim joint width of system systemId in (@intrinsic("dereference", target))
        set profileChoice to the bim setting ((bim part type setting) + (bim frame part)) of systemId in (@intrinsic("dereference", target))
        if profileChoice's found:
            set profileFound to the bim linear type index of profileChoice's value in (@intrinsic("dereference", target))
            if profileFound's valid:
                set chosenProfile to the item at profileFound's position in (target's linearTypes's values)
                if (the absolute value of (chosenProfile's width - frameWide)) > 0.000001:
                    return false
        set halfFrame to ((((the rounded value of (frameWide * 1000.0)) + 1.0) / 2.0) as a 64 bit integer)
        set axisInset to millimetres + halfFrame
        set bothInsets to (axisInset as a 64 bit floating-point number) / 500.0
        if ((the bim rough width of openingType) - bothInsets < 0.01) or ((the bim rough height of openingType) - bothInsets < 0.01):
            return false
        set columns to the maximum of 1 and (the bim bay count of previousPlacement's curtain)
        set rows to the maximum of 1 and (the bim row count of previousPlacement's curtain)
        set proposedWidth to (the bim rough width of openingType) - bothInsets
        set proposedHeight to (the bim rough height of openingType) - bothInsets
        set requiredSpan to frameWide + 0.000001
        if (the bim window operation of systemId in (@intrinsic("dereference", target))) > 0:
            set requiredSpan to requiredSpan + (2.0 * ((the bim window sash width of systemId in (@intrinsic("dereference", target))) + 0.003))
        # Explicitly moved grid lines retain their offsets. Every resulting
        # cell must still contain its profiles and, when operable, its sash.
        set previousOffset to 0.0
        loop lineIndex from 1 to (columns + 1):
            set nextOffset to the bim system line lineIndex of columns across proposedWidth coded lineIndex for system systemId in (@intrinsic("dereference", target))
            if (nextOffset - previousOffset) < requiredSpan:
                return false
            set previousOffset to nextOffset
        set previousOffset to 0.0
        loop lineIndex from 1 to (rows + 1):
            set nextOffset to the bim system line lineIndex of rows across proposedHeight coded (1000 + lineIndex) for system systemId in (@intrinsic("dereference", target))
            if (nextOffset - previousOffset) < requiredSpan:
                return false
            set previousOffset to nextOffset
        if (host bim system systemId in opening hostReading's value with joint axisInset in target) = false:
            return false
        set bim setting (bim window clearance setting) of systemId to millimetres keeping true in target
        set updatedValue to the item at found's position in (target's curtains's values)
        set updatedValue's bayWidth to ((the bim system length of updatedValue) + 0.000001) / (columns as a 64 bit floating-point number)
        set updatedValue's rowHeight to (updatedValue's height + 0.000001) / (rows as a 64 bit floating-point number)
        replace item at index found's position in (target's curtains's values) with updatedValue
        note bim change of systemId in target
        return true

function set bim window {a 64 bit integer:systemId} installation depth to {a 64 bit integer:millimetres} in {a pointer to a bim model record:target}:
    execute:
        if (millimetres < ((-1000000) as a 64 bit integer)) or (millimetres > (1000000 as a 64 bit integer)):
            return false
        set found to the bim curtain index of systemId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set storedValue to the item at found's position in (target's curtains's values)
        if (the bim system storedValue hosted in its opening in (@intrinsic("dereference", target)))'s valid = false:
            return false
        return set bim system systemId depth in its wall to millimetres in target
