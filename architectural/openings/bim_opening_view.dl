# SPDX-License-Identifier: MPL-2.0
# A door's or window's frame (kozijn) and infill as meshes in model
# coordinates, for the views that project the model square onto a plane:
# sections beyond their cut and elevations (drawing quality plan, item 15;
# `views/drawings/bim_projection.dl`). The wall's evaluated solid has the
# rough opening cut out; this is what stands in it.
#
# As the plan symbol (`bim_opening_symbol.dl`), the frame is the opening
# type's frame width wide and `the bim symbol frame depth` deep (or the
# wall's thickness when that is less), on the wall's line: a window's two
# jambs, head and bottom rail round the rough opening, a door's jambs and
# head. The infill (the glass, or the door leaf) is one sheet on the
# frame's middle filling the frame's inside: it hides what lies behind it
# and draws no edge of its own, since its outline is the frame's inner
# edge. Sills (vensterbank, waterslag) and leaf details are not made here;
# a door or window the section line cuts gets them from its cut detail
# (`bim_opening_section.dl`).
import architectural/openings/bim_opening_symbol.dl

# The meshes of one opening; not `valid` when it makes none (a host that
# is gone, curved or leaning, or an opening drawn by its detail).
class:
    patterns:
        [a|] bim opening view record
    members:
        valid as a boolean
        frame as a fast mesh record
        infill as a fast mesh record

# The point `alongDistance` from the opening's left end along the wall,
# `acrossDistance` toward the wall's exterior side, at height `height`.
local function the bim frame corner of {bim span record:spanValue} at {a 64 bit floating-point number:alongDistance} by {a 64 bit floating-point number:acrossDistance} rising {a 64 bit floating-point number:height}:
    execute:
        return a cad vector3 with x ((spanValue's left's x + (alongDistance * spanValue's direction's x)) + (acrossDistance * spanValue's normal's x)), y ((spanValue's left's y + (alongDistance * spanValue's direction's y)) + (acrossDistance * spanValue's normal's y)) and z height

# One flat four-cornered face of `target`, its corners in order round it,
# all with normal `faceNormal`.
local function append bim view face {cad vector3:cornerA}, {cad vector3:cornerB}, {cad vector3:cornerC} and {cad vector3:cornerD} facing {cad vector3:faceNormal} to {a pointer to a fast mesh record:target}:
    execute:
        set base to the length of (target's positions's values)
        append cornerA to (target's positions's values)
        append cornerB to (target's positions's values)
        append cornerC to (target's positions's values)
        append cornerD to (target's positions's values)
        loop cornerCursor from 0 to 4:
            append faceNormal to (target's normals's values)
        append base to (target's triangles's values)
        append (base + 1) to (target's triangles's values)
        append (base + 2) to (target's triangles's values)
        append base to (target's triangles's values)
        append (base + 2) to (target's triangles's values)
        append (base + 3) to (target's triangles's values)

# The box along the opening from `lowAlong` to `highAlong`, across the wall
# from `lowAcross` to `highAcross` and from height `lowZ` to `highZ`, as six
# faces of `target`.
local function append bim view box of {bim span record:spanValue} along {a 64 bit floating-point number:lowAlong} until {a 64 bit floating-point number:highAlong} across {a 64 bit floating-point number:lowAcross} through {a 64 bit floating-point number:highAcross} rising {a 64 bit floating-point number:lowZ} up till {a 64 bit floating-point number:highZ} into {a pointer to a fast mesh record:target}:
    execute:
        if ((highAlong - lowAlong) <= 0.0) or ((highZ - lowZ) <= 0.0):
            return nothing
        set lowLowLow to the bim frame corner of spanValue at lowAlong by lowAcross rising lowZ
        set highLowLow to the bim frame corner of spanValue at highAlong by lowAcross rising lowZ
        set highHighLow to the bim frame corner of spanValue at highAlong by highAcross rising lowZ
        set lowHighLow to the bim frame corner of spanValue at lowAlong by highAcross rising lowZ
        set lowLowHigh to the bim frame corner of spanValue at lowAlong by lowAcross rising highZ
        set highLowHigh to the bim frame corner of spanValue at highAlong by lowAcross rising highZ
        set highHighHigh to the bim frame corner of spanValue at highAlong by highAcross rising highZ
        set lowHighHigh to the bim frame corner of spanValue at lowAlong by highAcross rising highZ
        set alongNormal to a cad vector3 with x (spanValue's direction's x), y (spanValue's direction's y) and z 0.0
        set acrossNormal to a cad vector3 with x (spanValue's normal's x), y (spanValue's normal's y) and z 0.0
        append bim view face lowLowLow, lowHighLow, highHighLow and highLowLow facing (a cad vector3 with x 0.0, y 0.0 and z -1.0) to target
        append bim view face lowLowHigh, highLowHigh, highHighHigh and lowHighHigh facing (a cad vector3 with x 0.0, y 0.0 and z 1.0) to target
        append bim view face lowLowLow, highLowLow, highLowHigh and lowLowHigh facing (the cad negative of acrossNormal) to target
        append bim view face lowHighLow, lowHighHigh, highHighHigh and highHighLow facing acrossNormal to target
        append bim view face lowLowLow, lowLowHigh, lowHighHigh and lowHighLow facing (the cad negative of alongNormal) to target
        append bim view face highLowLow, highHighLow, highHighHigh and highLowHigh facing alongNormal to target

# The frame and infill of opening `openingValue` in `modelValue`.
function the bim opening view of {bim opening record:openingValue} in {bim model record:modelValue}:
    execute:
        set result to @intrinsic("construct", a bim opening view record, false, an empty fast mesh, an empty fast mesh)
        set hostFound to the bim wall index of openingValue's hostId in modelValue
        set typeFound to the bim opening type index of openingValue's typeId in modelValue
        if (hostFound's valid = false) or (typeFound's valid = false):
            return result
        set hostValue to the item at hostFound's position in (modelValue's walls's values)
        if ((hostValue's bulge != 0.0) or (hostValue's lean != 0.0)) or (hostValue's rise != 0.0):
            return result
        # An opening with its detail on draws the detail's parts instead.
        if ((the bim setting 2400100 of openingValue's id in modelValue)'s value) = (1 as a 64 bit integer):
            return result
        set levelFound to the bim level index of hostValue's levelId in modelValue
        if levelFound's valid = false:
            return result
        set openingType to the item at typeFound's position in (modelValue's openingTypes's values)
        set base to ((the item at levelFound's position in (modelValue's levels's values))'s elevation) + hostValue's baseOffset
        set bottom to base + openingType's sill
        set top to base + (the bim head height of openingType)
        set roughWidth to the bim rough width of openingType
        if (roughWidth <= 0.0) or (top <= bottom):
            return result
        set spanValue to the bim span of hostValue at openingValue's offset reaching (roughWidth * 0.5)
        set jambWidth to the maximum of 0.0 and (the minimum of (openingType's frame) and (roughWidth * 0.5))
        set frameHalf to (the minimum of (the bim symbol frame depth) and (the bim wall thickness of hostValue in modelValue)) * 0.5
        set innerJamb to jambWidth
        set outerJamb to roughWidth - jambWidth
        set railTop to bottom
        if jambWidth > 0.0:
            set frameShape to an empty fast mesh
            append bim view box of spanValue along 0.0 until innerJamb across (0.0 - frameHalf) through frameHalf rising bottom up till top into (the address of frameShape)
            append bim view box of spanValue along outerJamb until roughWidth across (0.0 - frameHalf) through frameHalf rising bottom up till top into (the address of frameShape)
            append bim view box of spanValue along innerJamb until outerJamb across (0.0 - frameHalf) through frameHalf rising (top - jambWidth) up till top into (the address of frameShape)
            if openingType's isDoor = false:
                set railTop to bottom + jambWidth
                append bim view box of spanValue along innerJamb until outerJamb across (0.0 - frameHalf) through frameHalf rising bottom up till railTop into (the address of frameShape)
            set result's frame to frameShape
        set infillShape to an empty fast mesh
        set infillTop to top - jambWidth
        if (outerJamb > innerJamb) and (infillTop > railTop):
            append bim view face (the bim frame corner of spanValue at innerJamb by 0.0 rising railTop), (the bim frame corner of spanValue at outerJamb by 0.0 rising railTop), (the bim frame corner of spanValue at outerJamb by 0.0 rising infillTop) and (the bim frame corner of spanValue at innerJamb by 0.0 rising infillTop) facing (a cad vector3 with x (spanValue's normal's x), y (spanValue's normal's y) and z 0.0) to (the address of infillShape)
        set result's infill to infillShape
        set result's valid to true
        return result
