# SPDX-License-Identifier: MPL-2.0
# A window in a building system has its frame and glass in the views that
# project the model (elevations, sections beyond their cut), as a window in
# a wall has.
#
# A straight upright system 6 m long with a window 1.2 m wide (frame 50 mm:
# rough 1.3 m) at 3 m, sill 0.9 m, and a wall with the same window. Both
# openings make a frame of four boxes and one sheet of infill; the system's
# frame stands on the system's line, from 2.35 to 3.65 m along it and from
# 0.9 to 2.45 m up. A system lying level makes none.
import architectural/openings/bim_opening_view.dl

function print opening view {bim opening view record:shown} labelled {a string:label}:
    execute:
        print ((label + (the string form of ": valid ")) + ((the string form of shown's valid) + ((the string form of ", frame triangles ") + ((the string form of ((the length of (shown's frame's triangles's values)) / 3)) + ((the string form of ", infill triangles ") + (the string form of ((the length of (shown's infill's triangles's values)) / 3))))))) as a line
        if (the length of (shown's frame's positions's values)) = 0:
            return nothing
        set lowX to 1e300
        set highX to -1e300
        set lowY to 1e300
        set highY to -1e300
        set lowZ to 1e300
        set highZ to -1e300
        loop cursor from 0 to the length of (shown's frame's positions's values):
            set corner to the item at cursor in (shown's frame's positions's values)
            set lowX to the minimum of lowX and corner's x
            set highX to the maximum of highX and corner's x
            set lowY to the minimum of lowY and corner's y
            set highY to the maximum of highY and corner's y
            set lowZ to the minimum of lowZ and corner's z
            set highZ to the maximum of highZ and corner's z
        print ((the string form of "  x ") + ((the bim millimetre text of lowX) + ((the string form of " to ") + (the bim millimetre text of highX)))) as a line
        print ((the string form of "  y ") + ((the bim millimetre text of lowY) + ((the string form of " to ") + (the bim millimetre text of highY)))) as a line
        print ((the string form of "  z ") + ((the bim millimetre text of lowZ) + ((the string form of " to ") + (the bim millimetre text of highZ)))) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
set systemId to add bim curtain wall on storey from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) rising 3.0 in bays of 0.6 by 3.0 of (the string form of "timber") to target
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.16)) to layerValues
set wallType to add bim wall type named (the string form of "CLT 160") with layerValues to target
set wallId to add bim wall typed wallType on storey from (a cad vector2 with x 0.0 and y 5.0) to (a cad vector2 with x 6.0 and y 5.0) to target
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
set inSystem to add bim opening typed windowType in systemId at 3.0 to target
set inWall to add bim opening typed windowType in wallId at 3.0 to target
print opening view (the bim opening view of (the item at (the bim opening index of inSystem in modelValue)'s position in (modelValue's openings's values)) in modelValue) labelled (the string form of "in a building system")
print opening view (the bim opening view of (the item at (the bim opening index of inWall in modelValue)'s position in (modelValue's openings's values)) in modelValue) labelled (the string form of "in a wall")
set bim setting (bim system orientation setting) of systemId to ((bim horizontal orientation) as a 64 bit integer) keeping true in target
print opening view (the bim opening view of (the item at (the bim opening index of inSystem in modelValue)'s position in (modelValue's openings's values)) in modelValue) labelled (the string form of "in a system lying level")
