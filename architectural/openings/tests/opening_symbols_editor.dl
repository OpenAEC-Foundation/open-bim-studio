# SPDX-License-Identifier: MPL-2.0
# A door's hand and swing from the editor (drawing quality plan, item 12): a
# selected door shows Hand (click) and Opens (click) rows and Flip hand and
# Flip swing on its floating toolbar; Flip hand (2475) and Flip swing (2476)
# each make one undoable edit that moves the plan symbol's hinge or turns
# the side it opens to, and a click on either row does the same. A selected
# window offers neither, and the flips refuse it. Drawn in the plan, the
# symbols are black on paper (a technical drawing) and keep the glass blue
# in the model review.
import ui/panels/bim_plan_panel.dl

function check door flip {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The value the properties show in the row coded `rowCode`, or "none".
function the door flip row {integer:rowCode} of {a pointer to a bim editor record:editor}:
    execute:
        set propertyRows to the bim property rows of (@intrinsic("dereference", editor))
        set shown to the string form of "none"
        loop rowCursor from 0 to the length of propertyRows:
            set propertyRow to the item at rowCursor in propertyRows
            if propertyRow's code = rowCode:
                set shown to propertyRow's value
        return shown

# Whether the floating toolbar offers command `wanted`.
function door flip toolbar of {a pointer to a bim editor record:editor} offers {integer:wanted}:
    execute:
        set offered to false
        set actions to the bim floating toolbar buttons of (@intrinsic("dereference", editor))
        loop buttonCursor from 0 to the length of actions:
            if (the item at buttonCursor in actions)'s command = wanted:
                set offered to true
        return offered

# Whether every stroked batch of `canvas` is black, and how many there are.
function the door flip black batch count of {bim canvas record:canvas}:
    execute:
        set blackCount to 0
        loop batchCursor from 0 to the length of (canvas's batches's values):
            set recorded to the item at batchCursor in (canvas's batches's values)
            if recorded's stroked:
                if ((recorded's red = 0) and (recorded's green = 0)) and (recorded's blue = 0):
                    set blackCount to blackCount + 1
                else:
                    set blackCount to -1000
        return blackCount

# Whether `canvas` has a stroked batch coloured `red`, `green`, `blue`.
function door flip canvas {bim canvas record:canvas} has strokes coloured {integer:wantedRed} {integer:wantedGreen} {integer:wantedBlue}:
    execute:
        set found to false
        loop batchCursor from 0 to the length of (canvas's batches's values):
            set recorded to the item at batchCursor in (canvas's batches's values)
            if recorded's stroked and (((recorded's red = wantedRed) and (recorded's green = wantedGreen)) and (recorded's blue = wantedBlue)):
                set found to true
        return found

# The first point of door `doorId`'s plan swing, cut at 1.2 m.
function the door flip swing start of {a 64 bit integer:doorId} in {bim model record:modelValue}:
    execute:
        set openingValue to the item at (the bim opening index of doorId in modelValue)'s position in (modelValue's openings's values)
        set drawnSymbol to the bim plan symbol of opening openingValue in modelValue cut at 1.2 framed true
        return the item at 0 in (drawnSymbol's swings's values)

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set wallId to add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set doorType to add bim door type named (the string form of "Deur") sized 0.93 by 2.315 with frame 0.054 to target
set doorId to add bim opening typed doorType in wallId at 2.0 to target
set windowId to add bim opening typed editor's openingTypeId in wallId at 4.5 to target

select bim editor bim opening picked numbered doorId in e
check door flip (((the door flip row (bim door hand property) of e) = (the string form of "Left")) and ((the door flip row (bim door swing property) of e) = (the string form of "Inward"))) named (the string form of "a selected door shows Hand Left and Opens Inward")
check door flip ((door flip toolbar of e offers (bim flip door hand command)) and (door flip toolbar of e offers (bim flip door swing command))) named (the string form of "its floating toolbar offers Flip hand and Flip swing")
set leftStart to the door flip swing start of doorId in editor's documentValue's current
set undoBefore to the length of (editor's documentValue's undoStack's values)
type bim editor key (bim flip door hand command) in e
set rightStart to the door flip swing start of doorId in editor's documentValue's current
check door flip ((bim door doorId is right handed in editor's documentValue's current) and (editor's message = (the string form of "Door hand: Right"))) named (the string form of "Flip hand makes it right-handed")
check door flip ((the length of (editor's documentValue's undoStack's values)) = (undoBefore + 1)) named (the string form of "as one undoable edit")
check door flip (((the absolute value of (rightStart's x - leftStart's x)) > 0.8) and ((the absolute value of (rightStart's y - leftStart's y)) < 0.000001)) named (the string form of "its hinge moves to the other jamb in the plan")
check door flip ((the door flip row (bim door hand property) of e) = (the string form of "Right")) named (the string form of "the Hand row shows Right")
start bim editor property (bim door hand property) in e
check door flip ((bim door doorId is right handed in editor's documentValue's current) = false) named (the string form of "a click on the Hand row flips it back to left")
type bim editor key (bim flip door swing command) in e
set outwardStart to the door flip swing start of doorId in editor's documentValue's current
check door flip (((bim door doorId opens outward in editor's documentValue's current) and ((the door flip row (bim door swing property) of e) = (the string form of "Outward"))) and (editor's message = (the string form of "Door opens: Outward"))) named (the string form of "Flip swing makes it open outward")
check door flip ((outwardStart's y * leftStart's y) < 0.0) named (the string form of "its leaf now stands on the wall's other side")
ignore undo bim transaction in (the address of (editor's documentValue))
check door flip ((bim door doorId opens outward in editor's documentValue's current) = false) named (the string form of "undo turns it back inward")
start bim editor property (bim door swing property) in e
check door flip (bim door doorId opens outward in editor's documentValue's current) named (the string form of "a click on the Opens row turns it outward")

select bim editor bim opening picked numbered windowId in e
check door flip (((the door flip row (bim door hand property) of e) = (the string form of "none")) and ((door flip toolbar of e offers (bim flip door hand command)) = false)) named (the string form of "a selected window shows no Hand row and no Flip hand")
set windowUndo to the length of (editor's documentValue's undoStack's values)
type bim editor key (bim flip door hand command) in e
check door flip ((editor's message = (the string form of "Flip hand: select a door first")) and ((the length of (editor's documentValue's undoStack's values)) = windowUndo)) named (the string form of "Flip hand refuses a window and changes nothing")

# In the plan: the door's frame and leaf, its swing and the window's frame
# and sills each as one batch, and the glass as another.
set transform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 100.0)
set paperCanvas to a new bim canvas
set paperCanvas's paperScale to 2.0
draw bim openings in plan of editor through transform on (the address of paperCanvas)
check door flip ((the door flip black batch count of paperCanvas) = 3) named (the string form of "on paper the frames, the glass and the swing are drawn in black")
set reviewCanvas to a new bim canvas
draw bim openings in plan of editor through transform on (the address of reviewCanvas)
check door flip ((door flip canvas reviewCanvas has strokes coloured 50 110 190) and (door flip canvas reviewCanvas has strokes coloured 70 74 90)) named (the string form of "the model review keeps the glass blue")
