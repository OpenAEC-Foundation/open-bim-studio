# SPDX-License-Identifier: MPL-2.0
import pattern/common/bim_system_types.dl

function check window recipe {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set systemId to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 3.6 and y 0.0) rising 2.4 in bays of 1.2 by 1.2 of (the string form of "timber") to target
set library to the bim system types
check window recipe ((the length of library) = 43) named (the string form of "append-only library contains 43 recipes")
set allValid to true
loop typeIndex from 33 to 43:
    if (give bim system systemId type typeIndex in target) = false:
        set allValid to false
    set systemValue to the item at 0 in (modelValue's curtains's values)
    if (bim system systemValue follows its type in modelValue) = false:
        set allValid to false
check window recipe allValid named (the string form of "all new recipes apply and retain their identity")
set systemValue to the item at 0 in (modelValue's curtains's values)
check window recipe ((the absolute value of (systemValue's bayWidth - 1.2)) < 0.0001) named (the string form of "three rail layout fits opening width")
check window recipe ((the absolute value of ((the bim joint depth of system systemId in modelValue) - 0.176)) < 1e-9) named (the string form of "SlimPatio three rail depth 176 mm")
ignore give bim system systemId type 39 in target
check window recipe ((the absolute value of ((the bim joint depth of system systemId in modelValue) - 0.180)) < 1e-9) named (the string form of "MasterPatio two rail depth 180 mm")
ignore give bim system systemId type 35 in target
set systemValue to the item at 0 in (modelValue's curtains's values)
check window recipe ((the absolute value of (systemValue's rowHeight - 1.2)) < 0.0001) named (the string form of "timber transom fits height")
check window recipe (systemValue's material = (the string form of "timber")) named (the string form of "retyping aluminium to timber updates material")
