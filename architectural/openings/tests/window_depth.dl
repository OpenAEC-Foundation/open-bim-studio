# SPDX-License-Identifier: MPL-2.0
# A window in a wall's opening set across the wall's line: to the right of
# the wall's direction for a positive depth, to the left for a negative one,
# across a wall at an angle too; refused for a system not in an opening;
# unhosted and hosted again, it stands on the line.
import architectural/stairs/bim_stair.dl

function check window depth {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function window depth {a 64 bit floating-point number:value} is near {a 64 bit floating-point number:wanted}:
    execute:
        return (the absolute value of (value - wanted)) < 0.000001

# Whether system `systemId` stands from (ax, ay) to (bx, by) in `modelValue`.
function window depth system {a 64 bit integer:systemId} stands from {a 64 bit floating-point number:ax} {a 64 bit floating-point number:ay} to {a 64 bit floating-point number:bx} {a 64 bit floating-point number:by} in {bim model record:modelValue}:
    execute:
        set found to the bim curtain index of systemId in modelValue
        set standingNow to the bim placed system (the item at found's position in (modelValue's curtains's values)) in modelValue
        set startNear to (window depth (standingNow's curtain's start's x) is near ax) and (window depth (standingNow's curtain's start's y) is near ay)
        set finishNear to (window depth (standingNow's curtain's finish's x) is near bx) and (window depth (standingNow's curtain's finish's y) is near by)
        return startNear and finishNear

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
set brickType to add bim wall type named (the string form of "Brick 100") with layerValues to target
set wallId to add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
set openingId to add bim opening typed windowType in wallId at 3.0 to target
set systemId to add bim system in opening openingId with joint (10 as a 64 bit integer) in bays of 0.6 by 0.75 of (the string form of "wood") to target

check window depth (set bim system systemId depth in its wall to (50 as a 64 bit integer) in target) named (the string form of "a depth of 50 mm is set")
check window depth (window depth system systemId stands from 2.36 (-0.05) to 3.64 (-0.05) in modelValue) named (the string form of "50 mm to the right of the wall's direction")
check window depth (set bim system systemId depth in its wall to ((-30) as a 64 bit integer) in target) named (the string form of "a depth of -30 mm is set")
check window depth (window depth system systemId stands from 2.36 0.03 to 3.64 0.03 in modelValue) named (the string form of "30 mm to the left")

# A wall at an angle, 3 by 4 m; the right of its direction is (0.8, -0.6).
set slantedWall to add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 3.0 and y 4.0) to target
set slantedOpening to add bim opening typed windowType in slantedWall at 2.5 to target
set slantedSystem to add bim system in opening slantedOpening with joint (10 as a 64 bit integer) in bays of 0.6 by 0.75 of (the string form of "wood") to target
check window depth (set bim system slantedSystem depth in its wall to (100 as a 64 bit integer) in target) named (the string form of "a depth of 100 mm across a wall at an angle")
check window depth (window depth system slantedSystem stands from 1.196 1.428 to 1.964 2.452 in modelValue) named (the string form of "it lies 100 mm across the slanted wall")

# A system standing alone has no wall to stand in.
set loneSystem to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 5.0) to (a cad vector2 with x 3.0 and y 5.0) rising 2.0 in bays of 0.6 by 0.75 of (the string form of "wood") to target
check window depth ((set bim system loneSystem depth in its wall to (50 as a 64 bit integer) in target) = false) named (the string form of "refused for a system not in an opening")

# Unhosted and hosted again: on the wall's line.
unhost bim system systemId in target
check window depth (host bim system systemId in opening openingId with joint (10 as a 64 bit integer) in target) named (the string form of "hosted again")
check window depth (window depth system systemId stands from 2.36 0.0 to 3.64 0.0 in modelValue) named (the string form of "on the wall's line again")
