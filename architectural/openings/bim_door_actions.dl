# SPDX-License-Identifier: MPL-2.0
# A door's hand and swing changed from the editor (drawing quality plan, item
# 12). Flip hand (command 2475) mirrors the door along its wall: its hinges
# go to the other jamb and it still opens to the same side. Flip swing (2476)
# turns it to open to the other side of the wall with the same hand, so its
# hinges change jamb too. The floating toolbar of a selected door offers
# both; the properties' Hand and Opens rows do the same on a click. Each is
# one transaction, one undo. The plan draws the result through `the bim plan
# symbol of opening` (bim_opening_symbol.dl).
import ui/editor/bim_editor_core.dl
import architectural/openings/bim_opening_symbol.dl

function bim flip door hand command:
    replacement:
        2475
function bim flip door swing command:
    replacement:
        2476

# The id of the selected opening when it is a door, else the refused id.
function the bim selected door of {bim editor record:editor}:
    execute:
        if editor's selectionKind != bim opening picked:
            return the bim refused id
        set modelValue to editor's documentValue's current
        set found to the bim opening index of editor's selectionId in modelValue
        if found's valid = false:
            return the bim refused id
        set typeFound to the bim opening type index of ((the item at found's position in (modelValue's openings's values))'s typeId) in modelValue
        if typeFound's valid = false:
            return the bim refused id
        if (the item at typeFound's position in (modelValue's openingTypes's values))'s isDoor = false:
            return the bim refused id
        return editor's selectionId

# "Left" or "Right": door `openingId`'s hand (EN 12519).
function the bim door hand name of {a 64 bit integer:openingId} in {bim model record:modelValue}:
    execute:
        if bim door openingId is right handed in modelValue:
            return the string form of "Right"
        return the string form of "Left"

# "Inward" or "Outward": the side door `openingId` opens to.
function the bim door swing name of {a 64 bit integer:openingId} in {bim model record:modelValue}:
    execute:
        if bim door openingId opens outward in modelValue:
            return the string form of "Outward"
        return the string form of "Inward"

# The selected door's hinges go to the other jamb (left- and right-handed
# swap); it opens to the same side.
function flip bim editor selected door hand in {a pointer to a bim editor record:editor}:
    execute:
        set doorId to the bim selected door of (@intrinsic("dereference", editor))
        if doorId = the bim refused id:
            set editor's message to the string form of "Flip hand: select a door first"
            return nothing
        set turningRight to (bim door doorId is right handed in editor's documentValue's current) = false
        begin bim transaction in (the address of (editor's documentValue))
        set bim setting (bim door hand setting) of doorId to (1 as a 64 bit integer) keeping turningRight in (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to (the string form of "Door hand: ") + (the bim door hand name of doorId in editor's documentValue's current)

# The selected door opens to the other side of its wall, keeping its hand.
function flip bim editor selected door swing in {a pointer to a bim editor record:editor}:
    execute:
        set doorId to the bim selected door of (@intrinsic("dereference", editor))
        if doorId = the bim refused id:
            set editor's message to the string form of "Flip swing: select a door first"
            return nothing
        set turningOut to (bim door doorId opens outward in editor's documentValue's current) = false
        begin bim transaction in (the address of (editor's documentValue))
        set bim setting (bim door swing setting) of doorId to (1 as a 64 bit integer) keeping turningOut in (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to (the string form of "Door opens: ") + (the bim door swing name of doorId in editor's documentValue's current)
