# SPDX-License-Identifier: MPL-2.0
# The openings module's part of the scene: the detail parts of openings. Called by the
# composed dispatcher (`append bim module scene meshes of`) in layer order;
# the order does not matter, kept meshes are found by element id and part.
import viewer/bim_scene.dl

function append bim scene meshes of {bim model record:modelValue} within {a 64 bit floating-point number:tolerance} reusing {a pointer to a list:previous} keyed {a pointer to a list:keys} refreshing {a pointer to a list:remadeIds} with reinforcement detail {boolean:rebarDetail} into {a pointer to a list:result} with architectural_openings elements:
    execute:
        # Opening details, made again every time.
        loop openingCursor from 0 to the length of (modelValue's openings's values):
            set openingValue to the item at openingCursor in (modelValue's openings's values)
            set detailParts to the bim opening detail parts of openingValue's id in modelValue
            if (the length of (detailParts's values)) > 0:
                append (@intrinsic("construct", a bim scene mesh record, openingValue's id, 0 as a 64 bit integer, bim opening detail part, the bim independent shapes of (detailParts's values) in modelValue, bim other category, the bim material colour of (the string form of "timber"), the string form of "timber")) to result
