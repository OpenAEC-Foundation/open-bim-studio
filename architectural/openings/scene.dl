# SPDX-License-Identifier: MPL-2.0
# The openings module's part of the scene: the detail parts of openings, and
# else each door's and window's frame and infill (`bim_opening_view.dl`: the
# glass, or the door leaf) unless a window system stands in it. Called by the
# composed dispatcher (`append bim module scene meshes of`) in layer order;
# the order does not matter, kept meshes are found by element id and part.
import viewer/bim_scene.dl
import architectural/openings/bim_opening_view.dl
import architectural/openings/bim_window_actions.dl
import views/common/bim_view.dl

function append bim scene meshes of {bim model record:modelValue} within {a 64 bit floating-point number:tolerance} reusing {a pointer to a list:previous} keyed {a pointer to a list:keys} refreshing {a pointer to a list:remadeIds} with reinforcement detail {boolean:rebarDetail} into {a pointer to a list:result} with architectural_openings elements:
    execute:
        # Opening details, made again every time.
        loop openingCursor from 0 to the length of (modelValue's openings's values):
            set openingValue to the item at openingCursor in (modelValue's openings's values)
            set detailParts to the bim opening detail parts of openingValue's id in modelValue
            if (the length of (detailParts's values)) > 0:
                append (@intrinsic("construct", a bim scene mesh record, openingValue's id, 0 as a 64 bit integer, bim opening detail part, the bim independent shapes of (detailParts's values) in modelValue, bim other category, the bim material colour of (the string form of "timber"), the string form of "timber")) to result
            else if (the bim window system in opening openingValue's id in modelValue) = the bim refused id:
                set openingShapes to the bim opening view of openingValue in modelValue
                if openingShapes's valid:
                    set openingCategory to the bim category of element openingValue's id in modelValue
                    if (the length of (openingShapes's frame's triangles's values)) > 0:
                        append (@intrinsic("construct", a bim scene mesh record, openingValue's id, 0 as a 64 bit integer, bim opening frame part, openingShapes's frame, openingCategory, the bim material colour of (the string form of "timber"), the string form of "timber")) to result
                    # The infill is one sheet: it is given a back as well,
                    # so that it shows from the inside too, 4 mm behind it
                    # (two sheets in one place would show their diagonals
                    # as edges).
                    set paneShape to openingShapes's infill
                    set cornerCount to the length of (paneShape's positions's values)
                    if cornerCount > 0:
                        loop cornerCursor from 0 to cornerCount:
                            set backNormal to the cad negative of (the item at cornerCursor in (paneShape's normals's values))
                            append (the cad sum of (the item at cornerCursor in (paneShape's positions's values)) and (backNormal scaled by 0.004)) to (paneShape's positions's values)
                            append backNormal to (paneShape's normals's values)
                        set indexCount to the length of (paneShape's triangles's values)
                        loop sideCursor from 0 to (indexCount / 3):
                            append ((the item at ((sideCursor * 3) + 0) in (paneShape's triangles's values)) + cornerCount) to (paneShape's triangles's values)
                            append ((the item at ((sideCursor * 3) + 2) in (paneShape's triangles's values)) + cornerCount) to (paneShape's triangles's values)
                            append ((the item at ((sideCursor * 3) + 1) in (paneShape's triangles's values)) + cornerCount) to (paneShape's triangles's values)
                        set infillMaterial to the string form of "glass"
                        set typeFound to the bim opening type index of openingValue's typeId in modelValue
                        if typeFound's valid:
                            if (the item at typeFound's position in (modelValue's openingTypes's values))'s isDoor:
                                set infillMaterial to the string form of "timber"
                        append (@intrinsic("construct", a bim scene mesh record, openingValue's id, 0 as a 64 bit integer, bim opening infill part, paneShape, openingCategory, the bim material colour of infillMaterial, infillMaterial)) to result
