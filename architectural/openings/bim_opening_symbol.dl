# SPDX-License-Identifier: MPL-2.0
# The plan symbol of a door or window in its wall (drawing quality plan, item
# 12), as segments in plan metres: the plan panel and a sheet draw them
# through their transform, a test reads them as they are.
#
# A window cut by the plan: its frame (kozijn) as the outline of the rough
# opening across the frame's depth with the jambs' inner lines, the glass on
# the frame's middle between the jambs, and on an outer wall an inner sill
# (vensterbank) and an outer sill (waterslag) standing out past the wall's
# faces. A door cut by the plan: the frame's two jambs, its leaf or leaves
# standing open square to the wall, each as wide as the clear width shares
# out and with a leaf's thickness, the quarter swing of each, and on an outer
# wall the threshold's two faces between the jambs. An opening wholly above
# the cut is its frame's outline and middle line, dashed; one wholly below the
# cut lies in the wall under the cut and draws nothing.
#
# The opening type has a frame width but no frame depth or position across
# the wall: the frame is `the bim symbol frame depth` deep (a 67 x 114 mm
# timber frame's), or the wall's thickness when that is less, on the wall's
# line, where a window system hosted in the opening stands by default.
import elements/planar/bim_evaluate.dl

# A door's hand and swing are settings of the opening, not of its type, so
# that one type serves both hands.
# 2402520: 1 right-handed; absent left-handed. The hand is named as EN 12519
# names it: seen from the side the leaf opens toward, the hinges on the left
# or on the right.
function bim door hand setting:
    replacement:
        2402520
# 2402521: 1 the leaf opens to the outdoor side; absent to the indoor side.
function bim door swing setting:
    replacement:
        2402521

# The frame's depth across the wall, a leaf's thickness, and how far a sill
# stands out past the wall's face, in metres.
function the bim symbol frame depth:
    replacement:
        0.114
function the bim symbol leaf thickness:
    replacement:
        0.04
function the bim symbol sill projection:
    replacement:
        0.03

# Whether door `openingId` is right-handed.
function bim door {a 64 bit integer:openingId} is right handed in {bim model record:modelValue}:
    execute:
        return ((the bim setting (bim door hand setting) of openingId in modelValue)'s value) = (1 as a 64 bit integer)

# Whether door `openingId` opens to the outdoor side.
function bim door {a 64 bit integer:openingId} opens outward in {bim model record:modelValue}:
    execute:
        return ((the bim setting (bim door swing setting) of openingId in modelValue)'s value) = (1 as a 64 bit integer)

# The segments of a plan symbol, two points per segment, in plan metres:
# `lines` the frame, sills, threshold and leaves; `glazing` the glass;
# `swings` the leaves' quarter circles; `hidden` what the plan draws dashed.
class:
    patterns:
        [a|] bim opening symbol record
    members:
        lines as the type of (a cad topology list of a cad vector2)
        glazing as the type of (a cad topology list of a cad vector2)
        swings as the type of (a cad topology list of a cad vector2)
        hidden as the type of (a cad topology list of a cad vector2)

# The point `alongDistance` from the opening's left end along the wall and
# `acrossDistance` toward the wall's exterior side from its line.
local function the bim symbol point of {bim span record:spanValue} at {a 64 bit floating-point number:alongDistance} by {a 64 bit floating-point number:acrossDistance}:
    execute:
        return a cad vector2 with x ((spanValue's left's x + (alongDistance * spanValue's direction's x)) + (acrossDistance * spanValue's normal's x)) and y ((spanValue's left's y + (alongDistance * spanValue's direction's y)) + (acrossDistance * spanValue's normal's y))

local function append bim symbol segment from {cad vector2:firstPoint} to {cad vector2:secondPoint} into {a pointer to a list:pairs}:
    execute:
        append firstPoint to pairs
        append secondPoint to pairs

# The outline of the rectangle from `lowAlong` to `highAlong` along the wall
# and from `lowAcross` to `highAcross` across it: four segments.
local function append bim symbol box of {bim span record:spanValue} along {a 64 bit floating-point number:lowAlong} until {a 64 bit floating-point number:highAlong} across {a 64 bit floating-point number:lowAcross} through {a 64 bit floating-point number:highAcross} into {a pointer to a list:pairs}:
    execute:
        set cornerA to the bim symbol point of spanValue at lowAlong by lowAcross
        set cornerB to the bim symbol point of spanValue at highAlong by lowAcross
        set cornerC to the bim symbol point of spanValue at highAlong by highAcross
        set cornerD to the bim symbol point of spanValue at lowAlong by highAcross
        append bim symbol segment from cornerA to cornerB into pairs
        append bim symbol segment from cornerB to cornerC into pairs
        append bim symbol segment from cornerC to cornerD into pairs
        append bim symbol segment from cornerD to cornerA into pairs

# A sill from `lowAlong` to `highAlong` standing out past the wall's face
# `faceAcross` to `frontAcross`: its front edge and its two ends past the
# face (the rest lies along the frame and the reveals, drawn already).
local function append bim symbol sill of {bim span record:spanValue} along {a 64 bit floating-point number:lowAlong} until {a 64 bit floating-point number:highAlong} from face {a 64 bit floating-point number:faceAcross} to front {a 64 bit floating-point number:frontAcross} into {a pointer to a list:pairs}:
    execute:
        append bim symbol segment from (the bim symbol point of spanValue at lowAlong by frontAcross) to (the bim symbol point of spanValue at highAlong by frontAcross) into pairs
        append bim symbol segment from (the bim symbol point of spanValue at lowAlong by faceAcross) to (the bim symbol point of spanValue at lowAlong by frontAcross) into pairs
        append bim symbol segment from (the bim symbol point of spanValue at highAlong by faceAcross) to (the bim symbol point of spanValue at highAlong by frontAcross) into pairs

# A leaf hinged at `hingeAlong` on the frame's face `faceAcross`, standing
# open toward `sideSign` (1 the exterior side, -1 the other) for `reach`
# metres, its thickness toward `shutSign` (1 along the wall, -1 back), and
# its quarter swing in twelve segments to where it shuts against the frame.
local function append bim symbol leaf of {bim span record:spanValue} hinged at {a 64 bit floating-point number:hingeAlong} on {a 64 bit floating-point number:faceAcross} toward {a 64 bit floating-point number:sideSign} shutting {a 64 bit floating-point number:shutSign} reaching {a 64 bit floating-point number:reach} into {bim opening symbol record:drawnSymbol}:
    execute:
        set leafThickness to the minimum of (the bim symbol leaf thickness) and reach
        append bim symbol box of spanValue along hingeAlong until (hingeAlong + (shutSign * leafThickness)) across faceAcross through (faceAcross + (sideSign * reach)) into (drawnSymbol's lines's values)
        set previousPoint to the bim symbol point of spanValue at hingeAlong by (faceAcross + (sideSign * reach))
        loop step from 1 to 13:
            set angle to (1.5707963267948966 * (step as a 64 bit floating-point number)) / 12.0
            set swungPoint to the bim symbol point of spanValue at (hingeAlong + ((shutSign * reach) * (the sine of angle))) by (faceAcross + ((sideSign * reach) * (the cosine of angle)))
            append bim symbol segment from previousPoint to swungPoint into (drawnSymbol's swings's values)
            set previousPoint to swungPoint

# Whether the ray from `origin` along `heading` crosses wall `wallValue`'s
# centreline (its chord) within 100 m.
local function a bim symbol ray from {cad vector2:origin} along {cad vector2:heading} reaches wall {bim wall record:wallValue}:
    execute:
        set run to the cad difference of wallValue's finish and wallValue's start
        set denominator to (heading's x * run's y) - (heading's y * run's x)
        if (the absolute value of denominator) < 1e-12:
            return false
        set offsetX to wallValue's start's x - origin's x
        set offsetY to wallValue's start's y - origin's y
        set rayReach to ((offsetX * run's y) - (offsetY * run's x)) / denominator
        set segmentReach to ((offsetX * heading's y) - (offsetY * heading's x)) / denominator
        return ((rayReach > 0.0) and (rayReach < 100.0)) and ((segmentReach >= 0.0) and (segmentReach <= 1.0))

# Which side of wall `hostValue` the outdoors is at the opening `spanValue`:
# 1 the wall's exterior side, -1 the other, 0 neither (an inner wall). A side
# is outdoors when a ray from the wall's face there, square to the wall, meets
# no other wall of the storey within 100 m; a wall free on both sides stands
# alone and its exterior side counts. A wall facing another wing of the same
# building across a courtyard reads as an inner wall.
function the bim outdoor side at {bim span record:spanValue} beside {bim wall record:hostValue} in {bim model record:modelValue}:
    execute:
        set middle to a cad vector2 with x ((spanValue's left's x + spanValue's right's x) * 0.5) and y ((spanValue's left's y + spanValue's right's y) * 0.5)
        set reach to ((the bim wall thickness of hostValue in modelValue) * 0.5) + 0.01
        set outwardHeading to spanValue's normal
        set inwardHeading to a cad vector2 with x (0.0 - outwardHeading's x) and y (0.0 - outwardHeading's y)
        set outerProbe to a cad vector2 with x (middle's x + (reach * outwardHeading's x)) and y (middle's y + (reach * outwardHeading's y))
        set innerProbe to a cad vector2 with x (middle's x + (reach * inwardHeading's x)) and y (middle's y + (reach * inwardHeading's y))
        set outerFree to true
        set innerFree to true
        loop wallCursor from 0 to the length of (modelValue's walls's values):
            set otherWall to the item at wallCursor in (modelValue's walls's values)
            if (otherWall's id != hostValue's id) and (otherWall's levelId = hostValue's levelId):
                if a bim symbol ray from outerProbe along outwardHeading reaches wall otherWall:
                    set outerFree to false
                if a bim symbol ray from innerProbe along inwardHeading reaches wall otherWall:
                    set innerFree to false
        if outerFree:
            return 1
        if innerFree:
            return -1
        return 0

# The plan symbol of opening `openingValue` cut `cutHeight` above its wall's
# storey; `withFrame` false leaves out a window's frame and glass (a window
# system hosted in the opening draws its own). Empty for an opening without
# its wall or type.
function the bim plan symbol of opening {bim opening record:openingValue} in {bim model record:modelValue} cut at {a 64 bit floating-point number:cutHeight} framed {boolean:withFrame}:
    execute:
        set drawnSymbol to @intrinsic("construct", a bim opening symbol record, a cad topology list of a cad vector2, a cad topology list of a cad vector2, a cad topology list of a cad vector2, a cad topology list of a cad vector2)
        set hostFound to the bim wall index of openingValue's hostId in modelValue
        set typeFound to the bim opening type index of openingValue's typeId in modelValue
        if (hostFound's valid = false) or (typeFound's valid = false):
            return drawnSymbol
        set hostValue to the item at hostFound's position in (modelValue's walls's values)
        set openingType to the item at typeFound's position in (modelValue's openingTypes's values)
        set openingBottom to hostValue's baseOffset + openingType's sill
        set openingTop to hostValue's baseOffset + (the bim head height of openingType)
        # Wholly below the cut: inside the wall the plan cuts above it.
        if openingTop <= cutHeight:
            return drawnSymbol
        set wallThickness to the bim wall thickness of hostValue in modelValue
        set wallHalf to wallThickness * 0.5
        set roughWidth to the bim rough width of openingType
        set spanValue to the bim span of hostValue at openingValue's offset reaching (roughWidth * 0.5)
        set jambWidth to the minimum of (openingType's frame) and (roughWidth * 0.5)
        set frameHalf to (the minimum of (the bim symbol frame depth) and wallThickness) * 0.5
        set innerJamb to jambWidth
        set outerJamb to roughWidth - jambWidth
        # Wholly above the cut: the frame's outline and middle line, dashed.
        if openingBottom >= cutHeight:
            append bim symbol box of spanValue along 0.0 until roughWidth across (0.0 - frameHalf) through frameHalf into (drawnSymbol's hidden's values)
            append bim symbol segment from (the bim symbol point of spanValue at innerJamb by 0.0) to (the bim symbol point of spanValue at outerJamb by 0.0) into (drawnSymbol's hidden's values)
            return drawnSymbol
        set outdoorSide to the bim outdoor side at spanValue beside hostValue in modelValue
        # The indoor side across the wall: away from the outdoors, or the
        # wall's interior side on an inner wall.
        set indoorSign to -1.0
        if outdoorSide = -1:
            set indoorSign to 1.0
        set sillReach to the bim symbol sill projection
        if openingType's isDoor:
            # The jambs; on an outer wall the threshold's faces between them.
            if jambWidth > 0.0:
                append bim symbol box of spanValue along 0.0 until innerJamb across (0.0 - frameHalf) through frameHalf into (drawnSymbol's lines's values)
                append bim symbol box of spanValue along outerJamb until roughWidth across (0.0 - frameHalf) through frameHalf into (drawnSymbol's lines's values)
            if outdoorSide != 0:
                append bim symbol segment from (the bim symbol point of spanValue at innerJamb by frameHalf) to (the bim symbol point of spanValue at outerJamb by frameHalf) into (drawnSymbol's lines's values)
                append bim symbol segment from (the bim symbol point of spanValue at innerJamb by (0.0 - frameHalf)) to (the bim symbol point of spanValue at outerJamb by (0.0 - frameHalf)) into (drawnSymbol's lines's values)
            set swingSign to indoorSign
            if bim door (openingValue's id) opens outward in modelValue:
                set swingSign to 0.0 - indoorSign
            set clearWidth to outerJamb - innerJamb
            set faceAcross to swingSign * frameHalf
            if ((the bim setting (bim door leaves setting) of openingType's id in modelValue)'s value) = (2 as a 64 bit integer):
                append bim symbol leaf of spanValue hinged at innerJamb on faceAcross toward swingSign shutting 1.0 reaching (clearWidth * 0.5) into drawnSymbol
                append bim symbol leaf of spanValue hinged at outerJamb on faceAcross toward swingSign shutting (0.0 - 1.0) reaching (clearWidth * 0.5) into drawnSymbol
            else:
                # Seen from the side the leaf opens toward, the wall's end
                # of the opening is on the right when it opens to the
                # exterior side (swingSign 1).
                set hingedAtEnd to swingSign > 0.0
                if (bim door (openingValue's id) is right handed in modelValue) = false:
                    set hingedAtEnd to hingedAtEnd = false
                if hingedAtEnd:
                    append bim symbol leaf of spanValue hinged at outerJamb on faceAcross toward swingSign shutting (0.0 - 1.0) reaching clearWidth into drawnSymbol
                else:
                    append bim symbol leaf of spanValue hinged at innerJamb on faceAcross toward swingSign shutting 1.0 reaching clearWidth into drawnSymbol
            return drawnSymbol
        if withFrame:
            append bim symbol box of spanValue along 0.0 until roughWidth across (0.0 - frameHalf) through frameHalf into (drawnSymbol's lines's values)
            if jambWidth > 0.0:
                append bim symbol segment from (the bim symbol point of spanValue at innerJamb by (0.0 - frameHalf)) to (the bim symbol point of spanValue at innerJamb by frameHalf) into (drawnSymbol's lines's values)
                append bim symbol segment from (the bim symbol point of spanValue at outerJamb by (0.0 - frameHalf)) to (the bim symbol point of spanValue at outerJamb by frameHalf) into (drawnSymbol's lines's values)
            append bim symbol segment from (the bim symbol point of spanValue at innerJamb by 0.0) to (the bim symbol point of spanValue at outerJamb by 0.0) into (drawnSymbol's glazing's values)
        # Sills on an outer wall, unless the opening's detail has its own.
        set detailed to ((the bim setting 2400100 of openingValue's id in modelValue)'s value) = (1 as a 64 bit integer)
        if (outdoorSide != 0) and (detailed = false):
            set outdoorSign to 0.0 - indoorSign
            append bim symbol sill of spanValue along 0.0 until roughWidth from face (indoorSign * wallHalf) to front (indoorSign * (wallHalf + sillReach)) into (drawnSymbol's lines's values)
            append bim symbol sill of spanValue along 0.0 until roughWidth from face (outdoorSign * wallHalf) to front (outdoorSign * (wallHalf + sillReach)) into (drawnSymbol's lines's values)
        return drawnSymbol
