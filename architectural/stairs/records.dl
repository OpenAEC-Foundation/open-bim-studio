# SPDX-License-Identifier: MPL-2.0
# The stairs module's records: stairs and railings.
# They were in bim/bim_model.dl until the module split's phase C2.
import bim/bim_model.dl

# A straight stair on storey `levelId`, a generator (`bim_stair.dl`): it
# climbs from `start` toward `finish` (its run, in plan) to the storey above,
# `width` wide, in `riserCount` equal risers; its treads and stringers are
# linear elements of `material`, derived when it is evaluated.
class:
    patterns:
        [a|] bim stair record
    members:
        id as a 64 bit integer
        levelId as a 64 bit integer
        start as a cad vector2
        finish as a cad vector2
        width as a 64 bit floating-point number
        riserCount as an integer
        material as a string

# A railing along `points` (in plan) on storey `levelId`, `height` high, a
# generator (`bim_stair.dl`) of linear posts and rails of `material`. On a
# stair (`hostId`) its foot follows the stair's slope.
class:
    patterns:
        [a|] bim railing record
    members:
        id as a 64 bit integer
        levelId as a 64 bit integer
        hostId as a 64 bit integer
        points as the type of (a cad topology list of a cad vector2)
        height as a 64 bit floating-point number
        material as a string
