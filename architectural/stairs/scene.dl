# SPDX-License-Identifier: MPL-2.0
# The stairs module's part of the scene: stairs and railings. Called by the
# composed dispatcher (`append bim module scene meshes of`) in layer order;
# the order does not matter, kept meshes are found by element id and part.
import viewer/bim_scene.dl

function append bim scene meshes of {bim model record:modelValue} within {a 64 bit floating-point number:tolerance} reusing {a pointer to a list:previous} keyed {a pointer to a list:keys} refreshing {a pointer to a list:remadeIds} with reinforcement detail {boolean:rebarDetail} into {a pointer to a list:result} with architectural_stairs elements:
    execute:
        # Stairs: their derived treads and stringers, one mesh per stair.
        loop cursor from 0 to the length of (modelValue's stairs's values):
            set stairValue to the item at cursor in (modelValue's stairs's values)
            set stairSlot to the bim kept slot of stairValue's id part (bim stair part) among keys unless remadeIds
            if stairSlot >= 0:
                append (the item at stairSlot in previous) to result
            else:
                append (@intrinsic("construct", a bim scene mesh record, stairValue's id, 0 as a 64 bit integer, bim stair part, the bim stair shape of stairValue in modelValue within tolerance, bim stair category, the bim material colour of stairValue's material, stairValue's material)) to result
        # Railings: their posts and rails, one mesh per railing.
        loop cursor from 0 to the length of (modelValue's railings's values):
            set railingValue to the item at cursor in (modelValue's railings's values)
            set railingSlot to the bim kept slot of railingValue's id part (bim railing part) among keys unless remadeIds
            if railingSlot >= 0:
                append (the item at railingSlot in previous) to result
            else:
                append (@intrinsic("construct", a bim scene mesh record, railingValue's id, 0 as a 64 bit integer, bim railing part, the bim railing shape of railingValue in modelValue within tolerance, bim railing category, the bim material colour of railingValue's material, railingValue's material)) to result
