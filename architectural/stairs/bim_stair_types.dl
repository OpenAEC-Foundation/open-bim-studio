# SPDX-License-Identifier: MPL-2.0
# Stair and railing types: standard systems a stair or a railing can be,
# as building systems have theirs (`bim_system_types.dl`). A type is a
# recipe: the material and the linear types of the parts (a stair's treads
# and stringers, a railing's posts, rail and balusters), a railing's height
# and baluster spacing. Applying it gives the element those settings and
# remembers the type, so the properties show it under Type, with "(custom)"
# once a part was changed on its own (a custom system).
import architectural/stairs/bim_stair.dl

# One part of a recipe: a linear type by name, its profile and material.
class:
    patterns:
        [a|] bim part recipe record
    members:
        name as a string
        width as a 64 bit floating-point number
        depth as a 64 bit floating-point number
        round as a boolean
        material as a string

class:
    patterns:
        [a|] bim stair type record
    members:
        name as a string
        isRailing as a boolean
        material as a string
        # Treads and stringers, or posts, rail and balusters.
        parts as the type of (a cad topology list of a bim part recipe record)
        railHeight as a 64 bit floating-point number
        spacing as an integer

# The setting keeping the type a stair or railing was given: its index in
# `the bim stair types` plus one.
function bim stair type setting:
    replacement:
        1700001

local function the bim part recipe {a string:typeName} sized {a 64 bit floating-point number:widthValue} by {a 64 bit floating-point number:depthValue} round {boolean:isRound} of {a string:materialName}:
    execute:
        return @intrinsic("construct", a bim part recipe record, typeName, widthValue, depthValue, isRound, materialName)

local function the bim stair recipe named {a string:typeName} railing {boolean:railingKind} of {a string:materialName} rising {a 64 bit floating-point number:heightValue} spaced {integer:spacingValue}:
    execute:
        return @intrinsic("construct", a bim stair type record, typeName, railingKind, materialName, a cad topology list of a bim part recipe record, heightValue, spacingValue)

# The library: Dutch stairs (timber, hardwood, concrete, steel with timber
# treads, steel grating) and railings (steel bars, timber, stainless steel,
# steel strips); railings 1 m high (the Bouwbesluit's height by a drop).
function the bim stair types:
    execute:
        set made to an empty list of a bim stair type record
        set timberStair to the bim stair recipe named (the string form of "Houten trap vuren") railing false of (the string form of "timber") rising 0.0 spaced 0
        append (the bim part recipe (the string form of "Trede vuren 40") sized 0.25 by 0.04 round false of (the string form of "timber")) to (timberStair's parts's values)
        append (the bim part recipe (the string form of "Trapboom vuren 40x260") sized 0.04 by 0.26 round false of (the string form of "timber")) to (timberStair's parts's values)
        append timberStair to made
        set hardwoodStair to the bim stair recipe named (the string form of "Hardhouten trap") railing false of (the string form of "hardwood timber") rising 0.0 spaced 0
        append (the bim part recipe (the string form of "Trede hardhout 45") sized 0.25 by 0.045 round false of (the string form of "hardwood timber")) to (hardwoodStair's parts's values)
        append (the bim part recipe (the string form of "Trapboom hardhout 50x300") sized 0.05 by 0.3 round false of (the string form of "hardwood timber")) to (hardwoodStair's parts's values)
        append hardwoodStair to made
        set concreteStair to the bim stair recipe named (the string form of "Betontrap prefab") railing false of (the string form of "concrete") rising 0.0 spaced 0
        append (the bim part recipe (the string form of "Trede beton 60") sized 0.25 by 0.06 round false of (the string form of "concrete")) to (concreteStair's parts's values)
        append (the bim part recipe (the string form of "Trapboom beton 150x300") sized 0.15 by 0.3 round false of (the string form of "concrete")) to (concreteStair's parts's values)
        append concreteStair to made
        set steelStair to the bim stair recipe named (the string form of "Stalen trap houten treden") railing false of (the string form of "steel") rising 0.0 spaced 0
        append (the bim part recipe (the string form of "Trede eiken 40") sized 0.25 by 0.04 round false of (the string form of "timber")) to (steelStair's parts's values)
        append (the bim part recipe (the string form of "Trapboom staal 10x250") sized 0.01 by 0.25 round false of (the string form of "steel")) to (steelStair's parts's values)
        append steelStair to made
        set gratingStair to the bim stair recipe named (the string form of "Stalen roostertrap") railing false of (the string form of "steel") rising 0.0 spaced 0
        append (the bim part recipe (the string form of "Trede rooster 30") sized 0.25 by 0.03 round false of (the string form of "steel")) to (gratingStair's parts's values)
        append (the bim part recipe (the string form of "Trapboom staal 10x200") sized 0.01 by 0.2 round false of (the string form of "steel")) to (gratingStair's parts's values)
        append gratingStair to made
        set barRailing to the bim stair recipe named (the string form of "Stalen spijlenhek") railing true of (the string form of "steel") rising 1.0 spaced 100
        append (the bim part recipe (the string form of "Staander staal 40x40") sized 0.04 by 0.04 round false of (the string form of "steel")) to (barRailing's parts's values)
        append (the bim part recipe (the string form of "Leuning staal 40x10") sized 0.04 by 0.01 round false of (the string form of "steel")) to (barRailing's parts's values)
        append (the bim part recipe (the string form of "Spijl staal rond 12") sized 0.012 by 0.012 round true of (the string form of "steel")) to (barRailing's parts's values)
        append barRailing to made
        set timberRailing to the bim stair recipe named (the string form of "Houten balustrade") railing true of (the string form of "timber") rising 1.0 spaced 110
        append (the bim part recipe (the string form of "Staander hout 70x70") sized 0.07 by 0.07 round false of (the string form of "timber")) to (timberRailing's parts's values)
        append (the bim part recipe (the string form of "Leuning hout 70x40") sized 0.07 by 0.04 round false of (the string form of "timber")) to (timberRailing's parts's values)
        append (the bim part recipe (the string form of "Spijl hout 30x30") sized 0.03 by 0.03 round false of (the string form of "timber")) to (timberRailing's parts's values)
        append timberRailing to made
        set stainlessRailing to the bim stair recipe named (the string form of "RVS leuning") railing true of (the string form of "stainless steel") rising 1.0 spaced 1000
        append (the bim part recipe (the string form of "Staander RVS rond 42") sized 0.042 by 0.042 round true of (the string form of "stainless steel")) to (stainlessRailing's parts's values)
        append (the bim part recipe (the string form of "Leuning RVS rond 42") sized 0.042 by 0.042 round true of (the string form of "stainless steel")) to (stainlessRailing's parts's values)
        append (the bim part recipe (the string form of "Regel RVS rond 12") sized 0.012 by 0.012 round true of (the string form of "stainless steel")) to (stainlessRailing's parts's values)
        append stainlessRailing to made
        set stripRailing to the bim stair recipe named (the string form of "Traphek staal strip") railing true of (the string form of "steel") rising 1.0 spaced 100
        append (the bim part recipe (the string form of "Staander staal 50x10") sized 0.05 by 0.01 round false of (the string form of "steel")) to (stripRailing's parts's values)
        append (the bim part recipe (the string form of "Leuning staal 50x10") sized 0.05 by 0.01 round false of (the string form of "steel")) to (stripRailing's parts's values)
        append (the bim part recipe (the string form of "Spijl staal strip 40x8") sized 0.04 by 0.008 round false of (the string form of "steel")) to (stripRailing's parts's values)
        append stripRailing to made
        return made

# Whether linear type `candidate` is the one recipe part `partRecipe` asks
# for: its profile and material (the type's name follows the naming rules, so
# it may differ from the recipe's).
local function bim linear type {bim linear type record:candidate} fits recipe {bim part recipe record:partRecipe}:
    execute:
        if candidate's name = partRecipe's name:
            return true
        if ((the absolute value of (candidate's width - partRecipe's width)) > 0.0005) or ((the absolute value of (candidate's depth - partRecipe's depth)) > 0.0005):
            return false
        return (candidate's round = partRecipe's round) and (candidate's material = partRecipe's material)

# The linear type for a recipe's part (generic role), found or added.
local function the bim linear type for recipe {bim part recipe record:partRecipe} in {a pointer to a bim model record:target}:
    execute:
        loop cursor from 0 to the length of (target's linearTypes's values):
            set candidate to the item at cursor in (target's linearTypes's values)
            if bim linear type candidate fits recipe partRecipe:
                return candidate's id
        return add bim linear type named partRecipe's name as role (bim generic linear role) sized partRecipe's width by partRecipe's depth round partRecipe's round of partRecipe's material to target

# Stair or railing `elementId` given type `typeIndex` of `the bim stair
# types` (a stair's types to stairs, a railing's to railings); false for a
# mismatch.
function give bim stair {a 64 bit integer:elementId} type {integer:typeIndex} in {a pointer to a bim model record:target}:
    execute:
        set library to the bim stair types
        if (typeIndex < 0) or (typeIndex >= (the length of library)):
            return false
        set chosen to the item at typeIndex in library
        set firstSlot to bim tread part
        if chosen's isRailing:
            set found to the bim railing index of elementId in (@intrinsic("dereference", target))
            if found's valid = false:
                return false
            set railingValue to the item at found's position in (target's railings's values)
            set railingValue's material to chosen's material
            set railingValue's height to chosen's railHeight
            replace item at index found's position in (target's railings's values) with railingValue
            set firstSlot to bim post part
            set bim setting (bim baluster spacing setting) of elementId to (chosen's spacing as a 64 bit integer) keeping true in target
        else:
            set found to the bim stair index of elementId in (@intrinsic("dereference", target))
            if found's valid = false:
                return false
            set stairValue to the item at found's position in (target's stairs's values)
            set stairValue's material to chosen's material
            replace item at index found's position in (target's stairs's values) with stairValue
        loop partCursor from 0 to the length of (chosen's parts's values):
            set partTypeId to the bim linear type for recipe (the item at partCursor in (chosen's parts's values)) in target
            set bim setting ((bim part type setting) + (firstSlot + partCursor)) of elementId to partTypeId keeping true in target
        set bim setting (bim stair type setting) of elementId to ((typeIndex + 1) as a 64 bit integer) keeping true in target
        note bim change of elementId in target
        return true

# The name a stair's or railing's type shows: the type's, "(custom)" once a
# part's linear type differs from it; "Custom" without a type.
function the bim stair type name of {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        set reading to the bim setting (bim stair type setting) of elementId in modelValue
        set library to the bim stair types
        if reading's found = false:
            return the string form of "Custom"
        set typeIndex to (reading's value as an integer) - 1
        if (typeIndex < 0) or (typeIndex >= (the length of library)):
            return the string form of "Custom"
        set chosen to the item at typeIndex in library
        set firstSlot to bim tread part
        if chosen's isRailing:
            set firstSlot to bim post part
        set same to true
        loop partCursor from 0 to the length of (chosen's parts's values):
            set partReading to the bim setting ((bim part type setting) + (firstSlot + partCursor)) of elementId in modelValue
            set partFound to the bim linear type index of partReading's value in modelValue
            if partFound's valid = false:
                set same to false
            else if (bim linear type (the item at partFound's position in (modelValue's linearTypes's values)) fits recipe (the item at partCursor in (chosen's parts's values))) = false:
                set same to false
        if same:
            return chosen's name
        return chosen's name + (the string form of " (custom)")

# The index of the type element `elementId` was given, or -1.
function the bim stair type index of {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        set reading to the bim setting (bim stair type setting) of elementId in modelValue
        if reading's found = false:
            return -1
        return (reading's value as an integer) - 1
