# SPDX-License-Identifier: MPL-2.0
# Stair and railing types (`bim_stair_types.dl`): the library listed; a
# stair and a railing given a type (its parts' linear types, material,
# height and spacing); a part changed on its own makes it "(custom)"; a
# railing type refused for a stair.
import editor/bim_editor.dl

set editor to a new bim editor
set e to the address of editor
set library to the bim stair types
loop cursor from 0 to the length of library:
    set stairType to the item at cursor in library
    print (((the string form of cursor) + (the string form of " ")) + (stairType's name + ((the string form of ", railing ") + (the string form of stairType's isRailing)))) as a line
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set stairId to add bim stair on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 3.5 and y 0.0) wide 1.0 in 16 risers of (the string form of "timber") to target
set pathPoints to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 2.0) to pathPoints
append (a cad vector2 with x 4.0 and y 2.0) to pathPoints
set railingId to add bim railing on editor's levelId along pathPoints hosted by (the bim refused id) rising 0.9 of (the string form of "steel") to target
commit bim transaction in (the address of (editor's documentValue))
begin bim transaction in (the address of (editor's documentValue))
print ((the string form of "stair given type 3: ") + (the string form of (give bim stair stairId type 3 in target))) as a line
print ((the string form of "stair given a railing type: ") + (the string form of (give bim stair stairId type 6 in target))) as a line
print ((the string form of "railing given type 6: ") + (the string form of (give bim stair railingId type 6 in target))) as a line
commit bim transaction in (the address of (editor's documentValue))
set modelValue to editor's documentValue's current
print ((the string form of "stair: ") + (the bim stair type name of stairId in modelValue)) as a line
print ((the string form of "railing: ") + (the bim stair type name of railingId in modelValue)) as a line
set railingValue to the item at (the bim railing index of railingId in modelValue)'s position in (modelValue's railings's values)
print (((the string form of "railing height ") + (the bim metres text of railingValue's height)) + ((the string form of ", spacing ") + (the string form of ((the bim setting (bim baluster spacing setting) of railingId in modelValue)'s value)))) as a line
set stairParts to the bim parts of stair (the item at (the bim stair index of stairId in modelValue)'s position in (modelValue's stairs's values)) in modelValue
print (((the string form of "stair parts ") + (the string form of (the length of (stairParts's values)))) + ((the string form of ", first of ") + (the item at 0 in (stairParts's values))'s kind's name)) as a line
# The treads of another linear type: custom.
begin bim transaction in (the address of (editor's documentValue))
set otherTread to add bim linear type named (the string form of "Trede MDF 30") as role (bim generic linear role) sized 0.25 by 0.03 round false of (the string form of "timber") to target
set bim setting ((bim part type setting) + (bim tread part)) of stairId to otherTread keeping true in target
commit bim transaction in (the address of (editor's documentValue))
print ((the string form of "stair after its treads changed: ") + (the bim stair type name of stairId in editor's documentValue's current)) as a line
