# SPDX-License-Identifier: MPL-2.0
import architectural/stairs/bim_stair_winders.dl

function require winder layout at {integer:checkId} that {boolean:condition}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: winder layout check ") + (the string form of checkId)) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)

local function the winder area of {a pointer to a list:ring}:
    execute:
        set origin to the item at 0 in ring
        set totalCross to 0.0
        loop cursor from 1 to ((the length of ring) - 1):
            set first to the item at cursor in ring
            set second to the item at (cursor + 1) in ring
            set totalCross to totalCross + (((first's x - origin's x) * (second's y - origin's y)) - ((second's x - origin's x) * (first's y - origin's y)))
        return (the absolute value of totalCross) * 0.5

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.048 to target
set stairId to add bim stair on ground from (a cad vector2 with x 4.2672 and y 1.524) to (a cad vector2 with x 4.2672 and y 3.81) wide 0.9144 in 16 risers of (the string form of "timber") to target
require winder layout at 1 that (set bim stair stairId winders below 3 above 3 handed 1 in target)
set stairValue to the item at 0 in (modelValue's stairs's values)
set winders to the bim winder treads of stair stairValue in modelValue
require winder layout at 2 that ((the length of (winders's values)) = 6)
require winder layout at 3 that ((the bim straight tread count of stair stairValue in modelValue) = 9)
require winder layout at 4 that ((the absolute value of ((the bim going of stair stairValue in modelValue) - 0.254)) < 1e-10)
set area to 0.0
loop cursor from 0 to 6:
    set treadValue to the item at cursor in (winders's values)
    set expectedRiser to cursor + 1
    if cursor >= 3:
        set expectedRiser to cursor + 10
    require winder layout at 5 that (treadValue's riser = expectedRiser)
    set ringArea to the winder area of (treadValue's outline's values)
    require winder layout at 6 that (ringArea > 0.0)
    set area to area + ringArea
if (the absolute value of (area - (2.0 * (0.9144 * 0.9144)))) >= 1e-9:
    print ((the string form of "winder area: ") + (the string form of area)) as a line
    loop treadCursor from 0 to 6:
        set diagnosticTread to the item at treadCursor in (winders's values)
        loop pointCursor from 0 to the length of (diagnosticTread's outline's values):
            set spot to the item at pointCursor in (diagnosticTread's outline's values)
            print ((the string form of spot's x) + ((the string form of ", ") + (the string form of spot's y))) as a line
require winder layout at 7 that ((the absolute value of (area - (2.0 * (0.9144 * 0.9144)))) < 1e-9)
print "PASS: six winders tile two squares; nine 254 mm straight goings; 16 equal risers" as a line

# Mirroring and survey-coordinate placement preserve local tread areas.
require winder layout at 8 that (set bim stair stairId winders below 3 above 3 handed -1 in target)
set stairValue's start to a cad vector2 with x 500000.0 and y 500000.0
set stairValue's finish to a cad vector2 with x 500002.286 and y 500000.0
set rotated to the bim winder treads of stair stairValue in modelValue
set movedArea to 0.0
loop cursor from 0 to 6:
    set treadValue to the item at cursor in (rotated's values)
    set movedArea to movedArea + (the winder area of (treadValue's outline's values))
require winder layout at 9 that ((the absolute value of (movedArea - area)) < 1e-8)
print "PASS: mirrored winders rotate and retain area 500 km from the origin" as a line

set settingCount to the length of (modelValue's settings's values)
set journalCount to the length of (modelValue's journal's values)
require winder layout at 10 that ((set bim stair stairId winders below 8 above 8 handed 1 in target) = false)
require winder layout at 11 that ((set bim stair stairId winders below -1 above 3 handed 1 in target) = false)
require winder layout at 12 that ((set bim stair stairId winders below 3 above 3 handed 0 in target) = false)
require winder layout at 13 that ((the length of (modelValue's settings's values)) = settingCount)
require winder layout at 14 that ((the length of (modelValue's journal's values)) = journalCount)
require winder layout at 15 that (set bim stair stairId winders below 0 above 0 handed 1 in target)
set straight to the bim winder treads of stair stairValue in modelValue
require winder layout at 16 that ((the length of (straight's values)) = 0)
require winder layout at 17 that ((the bim straight tread count of stair stairValue in modelValue) = 15)
print "PASS: invalid configurations leave model and journal unchanged; zero restores straight stairs" as a line
