# SPDX-License-Identifier: MPL-2.0
# The stairs module's answer to the drawings' `feature` extension point: a
# dimension reference to a building system, or to an opening in one,
# resolves here to an anchor in plan. A system's start and finish are the
# ends of its line; its exterior and interior are the lines of its two
# faces (the box of its parts and its layers' across its line: exterior to
# the right of its run, as a tag's anchor takes it); an opening's edges are
# points on the system's line. The composer calls this through `resolve bim
# module feature of …` (generated/compose.dl).
import architectural/stairs/bim_stair.dl
import viewer/bim_scene.dl
import views/drawings/records.dl

local function write bim system anchor line {boolean:isLine} at {cad vector2:origin} along {cad vector2:direction} into {a pointer to a bim anchor record:slot}:
    execute:
        set slot's valid to true
        set slot's isLine to isLine
        set slot's origin to origin
        set slot's direction to direction

# True when the reference is to a building system or to an opening in one,
# whether or not the anchor could be resolved; false for every other, which
# another module answers.
function resolve bim feature of {bim reference record:target} in {bim model record:modelValue} using {bim join index record:index} into {a pointer to a bim anchor record:anchor} with architectural_stairs elements:
    execute:
        set featureKind to target's feature
        if (featureKind >= bim wall start feature) and (featureKind <= bim wall interior feature):
            set systemFound to the bim curtain index of target's elementId in modelValue
            if systemFound's valid = false:
                return false
            set anchor's valid to false
            set systemValue to the item at systemFound's position in (modelValue's curtains's values)
            set systemRun to the cad distance from systemValue's start to systemValue's finish
            if systemRun <= 1e-9:
                return true
            set runDirection to a cad vector2 with x ((systemValue's finish's x - systemValue's start's x) / systemRun) and y ((systemValue's finish's y - systemValue's start's y) / systemRun)
            if featureKind = bim wall start feature:
                write bim system anchor line false at systemValue's start along runDirection into anchor
                return true
            if featureKind = bim wall finish feature:
                write bim system anchor line false at systemValue's finish along runDirection into anchor
                return true
            # A face: the system's line moved across to that side of its box.
            set faceBox to the bim system wall box of systemValue in modelValue
            set faceShift to 0.0
            if faceBox's valid:
                set faceShift to faceBox's highAcross
                if featureKind = bim wall exterior feature:
                    set faceShift to faceBox's lowAcross
            write bim system anchor line true at (a cad vector2 with x (systemValue's start's x - (runDirection's y * faceShift)) and y (systemValue's start's y + (runDirection's x * faceShift))) along runDirection into anchor
            return true
        if (featureKind = bim opening left feature) or (featureKind = bim opening right feature):
            set openingFound to the bim opening index of target's elementId in modelValue
            if openingFound's valid = false:
                return false
            set openingValue to the item at openingFound's position in (modelValue's openings's values)
            set hostFound to the bim curtain index of openingValue's hostId in modelValue
            if hostFound's valid = false:
                return false
            set anchor's valid to false
            set typeFound to the bim opening type index of openingValue's typeId in modelValue
            set hostSystem to the item at hostFound's position in (modelValue's curtains's values)
            set hostRun to the cad distance from hostSystem's start to hostSystem's finish
            if (typeFound's valid = false) or (hostRun <= 1e-9):
                return true
            set hostDirection to a cad vector2 with x ((hostSystem's finish's x - hostSystem's start's x) / hostRun) and y ((hostSystem's finish's y - hostSystem's start's y) / hostRun)
            set halfWidth to (the bim rough width of (the item at typeFound's position in (modelValue's openingTypes's values))) * 0.5
            set edgeAlong to openingValue's offset - halfWidth
            if featureKind = bim opening right feature:
                set edgeAlong to openingValue's offset + halfWidth
            write bim system anchor line false at (a cad vector2 with x (hostSystem's start's x + (hostDirection's x * edgeAlong)) and y (hostSystem's start's y + (hostDirection's y * edgeAlong))) along hostDirection into anchor
            return true
        return false
