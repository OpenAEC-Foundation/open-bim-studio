# SPDX-License-Identifier: MPL-2.0
# Building systems that stand as walls bound rooms.
#
# Four curtain walls around a rectangle 6 by 5 m between their lines, no
# wall among them. They bound one room, measured between the systems'
# inner faces, and the storey has its NEN 2580 areas: BVO to the outer
# faces, GO and NVO between the inner ones. A fifth system across the
# middle (x 3) makes two rooms. A system lying level bounds nothing.
import architectural/spaces/bim_spaces.dl

function the system wall text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.2f", value)
        return the substring of buffer from 0 spanning written bytes

function print system wall rooms of {bim model record:modelValue} on level {a 64 bit integer:levelId} named {a string:label}:
    execute:
        set joinIndex to the bim join index of modelValue
        set roomList to the bim spaces of modelValue on level levelId using joinIndex
        set measured to the bim area measures of modelValue on level levelId using joinIndex
        set line to label + (the string form of ": rooms ")
        set line to line + (the string form of (the length of (roomList's values)))
        loop roomCursor from 0 to the length of (roomList's values):
            set line to (line + (the string form of ", ")) + (the system wall text of (the item at roomCursor in (roomList's values))'s area)
        set line to (line + (the string form of "; BVO ")) + (the system wall text of measured's gross)
        set line to (line + (the string form of ", GO ")) + (the system wall text of measured's usable)
        set line to (line + (the string form of ", NVO ")) + (the system wall text of measured's net)
        print line as a line

set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
print system wall rooms of modelValue on level storey named (the string form of "nothing drawn")
ignore (add bim curtain wall on storey from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target)
ignore (add bim curtain wall on storey from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 6.0 and y 5.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target)
ignore (add bim curtain wall on storey from (a cad vector2 with x 6.0 and y 5.0) to (a cad vector2 with x 0.0 and y 5.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target)
print system wall rooms of modelValue on level storey named (the string form of "three systems, open")
ignore (add bim curtain wall on storey from (a cad vector2 with x 0.0 and y 5.0) to (a cad vector2 with x 0.0 and y 0.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target)
print system wall rooms of modelValue on level storey named (the string form of "four systems")
set middleId to add bim curtain wall on storey from (a cad vector2 with x 3.0 and y 0.0) to (a cad vector2 with x 3.0 and y 5.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
print system wall rooms of modelValue on level storey named (the string form of "with one across the middle")
ignore (set bim system middleId orientation bim horizontal orientation tilted (0 as a 64 bit integer) based (0 as a 64 bit integer) in target)
print system wall rooms of modelValue on level storey named (the string form of "the middle one lying level")
