# SPDX-License-Identifier: MPL-2.0
# A void in a floor is no floor area (NEN 2580).
#
# A room 6 by 5 m between the axes of 200 mm walls (5.8 by 4.8 m inside,
# 27.84 m2; 6.2 by 5.2 m outside, 32.24 m2) on a floor with two openings: a
# hatch of 1 by 1 m and a stairwell of 2 by 2.5 m. Under NEN 2580 a
# stairwell, shaft or void of 4 m2 or more is no floor area: the stairwell's
# 5 m2 comes off the room's area and off the storey's BVO, GO and NVO; the
# hatch, under 4 m2, stays floor.
import architectural/spaces/bim_spaces.dl

function a void area point at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y}:
    execute:
        return a cad vector2 with x x and y y

function the void area text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.2f", value)
        return the substring of buffer from 0 spanning written bytes

function the void area rectangle at {a 64 bit floating-point number:originX} and {a 64 bit floating-point number:originY} wide {a 64 bit floating-point number:width} deep {a 64 bit floating-point number:depth}:
    execute:
        set corners to an empty list of a cad vector2
        append (a cad vector2 with x originX and y originY) to corners
        append (a cad vector2 with x (originX + width) and y originY) to corners
        append (a cad vector2 with x (originX + width) and y (originY + depth)) to corners
        append (a cad vector2 with x originX and y (originY + depth)) to corners
        return corners

function print void measures of {bim model record:modelValue} on level {a 64 bit integer:levelId} named {a string:label}:
    execute:
        set joinIndex to the bim join index of modelValue
        set roomList to the bim spaces of modelValue on level levelId using joinIndex
        set measured to the bim area measures of modelValue on level levelId using joinIndex
        set line to label + (the string form of ": rooms ")
        set line to line + (the string form of (the length of (roomList's values)))
        if (the length of (roomList's values)) > 0:
            set line to (line + (the string form of ", room ")) + (the void area text of (the item at 0 in (roomList's values))'s area)
        set line to (line + (the string form of ", BVO ")) + (the void area text of measured's gross)
        set line to (line + (the string form of ", GO ")) + (the void area text of measured's usable)
        set line to (line + (the string form of ", NVO ")) + (the void area text of measured's net)
        print line as a line

set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "First floor") at 3.0 with height 3.0 to target
set wallLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.2)) to wallLayers
set wallType to add bim wall type named (the string form of "CLT 200") with wallLayers to target
ignore add bim wall typed wallType on storey from (a void area point at 0.0 and 0.0) to (a void area point at 6.0 and 0.0) to target
ignore add bim wall typed wallType on storey from (a void area point at 6.0 and 0.0) to (a void area point at 6.0 and 5.0) to target
ignore add bim wall typed wallType on storey from (a void area point at 6.0 and 5.0) to (a void area point at 0.0 and 5.0) to target
ignore add bim wall typed wallType on storey from (a void area point at 0.0 and 5.0) to (a void area point at 0.0 and 0.0) to target
set floorLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.2)) to floorLayers
set floorType to add bim planar type named (the string form of "Floor") as role bim floor planar role with floorLayers to target
set floorId to add bim plate typed floorType on storey around (the void area rectangle at 0.0 and 0.0 wide 6.0 deep 5.0) at top 0.0 to target
print void measures of modelValue on level storey named (the string form of "closed floor")
ignore (add bim plate opening on floorId around (the void area rectangle at 1.0 and 1.0 wide 1.0 deep 1.0) in target)
print void measures of modelValue on level storey named (the string form of "with a hatch of 1 m2")
ignore (add bim plate opening on floorId around (the void area rectangle at 3.0 and 1.5 wide 2.0 deep 2.5) in target)
print void measures of modelValue on level storey named (the string form of "with a stairwell of 5 m2")
