# SPDX-License-Identifier: MPL-2.0
# Reinforcement quantities and drawing text. Not a fabrication approval.
# ISO 3766:2003 supersedes ISO 4066:1994. Shape-code tables are not yet mapped.
# Units: metres internally, millimetres in callouts. NL K/B are project conventions.
import model/bim_reinforcement.dl
import model/bim_drawing_standard.dl

class:
    patterns:
        [a|] bim reinforcing schedule row
    members:
        ownerId as a 64 bit integer
        mark as a string
        count as an integer
        diameter as a 64 bit floating-point number
        length as a 64 bit floating-point number
        steel as a string
        shape as a string
        # Never fabricate a standards code from an unverified shape mapping.
        shapeCode as a string
        spacing as a 64 bit floating-point number
        # 0 none, 1 lower, 2 upper, 3 front, 4 back.
        position as an integer

class:
    patterns:
        [a|] bim reinforcing schedule result
    members:
        valid as a boolean
        message as a string
        rows as the type of (a cad topology list of a bim reinforcing schedule row)

function the bim reinforcement position text {integer:positionCode} under {integer:standardCode}:
    execute:
        if standardCode = bim nen standard:
            if positionCode = 1:
                return the string form of "K"
            if positionCode = 2:
                return the string form of "B"
        if positionCode = 1:
            return the string form of "bottom"
        if positionCode = 2:
            return the string form of "top"
        if positionCode = 3:
            return the string form of "front"
        if positionCode = 4:
            return the string form of "back"
        return the string form of ""

# Explicit ASCII rendering for the current atlas; UTF-8 is available for data/export.
function the bim reinforcement callout marked {a string:barMark} counting {integer:barCount} diameter {a 64 bit floating-point number:barSize} spaced {a 64 bit floating-point number:barPitch} positioned {integer:positionCode} under {integer:standardCode} ascii {boolean:asciiOnly}:
    execute:
        set prefixText to the string form of "mark "
        if standardCode = bim nen standard:
            set prefixText to the string form of "pos "
        set diameterSymbol to the string form of "ø"
        if asciiOnly:
            set diameterSymbol to the string form of "D"
        set resultText to ((prefixText + barMark) + (the string form of ": ")) + (the string form of barCount)
        set resultText to (resultText + (the string form of " ")) + diameterSymbol
        set resultText to resultText + (the bim decimal text (the reinforcement millimetres of barSize) under standardCode)
        if barPitch > 0.0:
            set pitchSeparator to the string form of " @ "
            if standardCode = bim nen standard:
                set pitchSeparator to the string form of "-"
            set resultText to (resultText + pitchSeparator) + (the bim decimal text (the reinforcement millimetres of barPitch) under standardCode)
        set placementText to the bim reinforcement position text positionCode under standardCode
        if placementText != (the string form of ""):
            set resultText to (resultText + (the string form of " ")) + placementText
        return resultText

# Rows remain separate across owners and semantic families. Within one generated
# family, identical diameters and analytic lengths describe the same bar shape:
# straight layers, identical hoops, or parallel lines/arcs on one surface face.
# No length rounding is used to merge rows. New freeform generators must extend
# this identity before they can participate in scheduling.
function the bim reinforcing schedule of {bim model record:modelValue}:
    execute:
        set output to @intrinsic("construct", a bim reinforcing schedule result, true, the string form of "", a cad topology list of a bim reinforcing schedule row)
        loop ownerIndex from 0 to the length of (modelValue's reinforcements's values):
            set spec to the bim hostbound reinforcement (the item at ownerIndex in (modelValue's reinforcements's values)) in modelValue
            set generated to the reinforcement of spec
            if generated's valid = false:
                set output's valid to false
                set output's message to ((the string form of "Cannot schedule ") + spec's mark) + ((the string form of ": ") + generated's message)
                # Do not return a deceptively complete partial schedule.
                clear (output's rows's values)
                return output
            loop barIndex from 0 to the length of (generated's bars's values):
                set barValue to the item at barIndex in (generated's bars's values)
                set rowValue to @intrinsic("construct", a bim reinforcing schedule row, spec's id, barValue's mark, 1, barValue's diameter, barValue's length, spec's steelKey, the string form of "STRAIGHT", the string form of "UNVERIFIED", 0.0, 0)
                if spec's kind = 3:
                    set rowValue's shape to the string form of "L"
                if spec's kind = 4:
                    set rowValue's shape to the string form of "U"
                if spec's kind = 1:
                    if barValue's closed:
                        set rowValue's shape to the string form of "HOOP_NO_HOOKS"
                        set rowValue's steel to spec's secondarySteelKey
                        # A zone-varying cage has no single stirrup spacing.
                        if (spec's startZoneLength = 0.0) and (spec's endZoneLength = 0.0):
                            set rowValue's spacing to spec's spacing
                    else:
                        if (barValue's mark = (spec's mark + (the string form of "-T"))) or (barValue's mark = (spec's mark + (the string form of "-ET"))):
                            set rowValue's position to 2
                        else:
                            set rowValue's position to 1
                if (spec's kind = 2) or (spec's kind = 5):
                    loop faceIndex from 0 to 2:
                        loop directionIndex from 0 to 2:
                            set familyMark to ((spec's mark + (the string form of "-F")) + (the string form of faceIndex)) + (the string form of "-D")
                            set familyMark to familyMark + (the string form of directionIndex)
                            if barValue's mark = familyMark:
                                set rowValue's position to faceIndex + 1
                                if spec's areaMode = 1:
                                    set rowValue's position to faceIndex + 3
                                set rowValue's spacing to spec's crossSpacing
                                if faceIndex = 1:
                                    set rowValue's spacing to spec's farCrossSpacing
                                if directionIndex = 1:
                                    set rowValue's steel to spec's secondarySteelKey
                                    set rowValue's spacing to spec's spacing
                                    if faceIndex = 1:
                                        set rowValue's spacing to spec's farSpacing
                                else:
                                    if spec's curveRadius != 0.0:
                                        set rowValue's shape to the string form of "ARC"
                set foundIndex to -1
                loop rowIndex from 0 to the length of (output's rows's values):
                    set existingRow to the item at rowIndex in (output's rows's values)
                    if (existingRow's ownerId = rowValue's ownerId) and (existingRow's mark = rowValue's mark):
                        if (existingRow's diameter = rowValue's diameter) and (existingRow's length = rowValue's length):
                            set foundIndex to rowIndex
                if foundIndex < 0:
                    append rowValue to (output's rows's values)
                else:
                    set existingRow to the item at foundIndex in (output's rows's values)
                    set existingRow's count to existingRow's count + 1
                    replace item at index foundIndex in (output's rows's values) with existingRow
        return output

function the bim reinforcing row text {bim reinforcing schedule row:rowValue} in {bim model record:modelValue} ascii {boolean:asciiOnly}:
    execute:
        set resultText to the bim reinforcement callout marked rowValue's mark counting rowValue's count diameter rowValue's diameter spaced rowValue's spacing positioned rowValue's position under (the bim drawing standard of modelValue) ascii asciiOnly
        if rowValue's spacing > 0.0:
            set resultText to resultText + (the string form of " max")
        return resultText

function the bim reinforcing total length of {bim reinforcing schedule row:rowValue}:
    execute:
        return rowValue's length * (rowValue's count as a 64 bit floating-point number)

local function the bim reinforcement table cell of {a string:valueText}:
    execute:
        return ((valueText with "\t" replaced by " ") with "\n" replaced by " ") with "\r" replaced by " "

# A UTF-8 TSV quantity report for review. Shape codes explicitly remain unverified;
# lengths are generated analytic centrelines, with no added laps or anchorage.
function the bim reinforcing table of {bim model record:modelValue}:
    execute:
        set scheduled to the bim reinforcing schedule of modelValue
        if scheduled's valid = false:
            return (the string form of "ERROR\t") + (the bim reinforcement table cell of scheduled's message)
        set reportLines to an empty list of a string
        append (the string form of "Owner\tMark\tCount\tDiameter_mm\tCentreline_mm\tTotal_mm\tSteel\tShape\tShape_code\tCallout\tNominal_bend_radius_mm\tMass_kg") to reportLines
        loop rowIndex from 0 to the length of (scheduled's rows's values):
            set rowValue to the item at rowIndex in (scheduled's rows's values)
            set fields to an empty list of a string
            append (the string form of rowValue's ownerId) to fields
            append (the bim reinforcement table cell of rowValue's mark) to fields
            append (the string form of rowValue's count) to fields
            append (the string form of (rowValue's diameter * 1000.0)) to fields
            append (the string form of (rowValue's length * 1000.0)) to fields
            append (the string form of ((the bim reinforcing total length of rowValue) * 1000.0)) to fields
            append rowValue's steel to fields
            append rowValue's shape to fields
            append rowValue's shapeCode to fields
            append (the bim reinforcement table cell of (the bim reinforcing row text rowValue in modelValue ascii false)) to fields
            set bendValue to 0.0
            set ownerFound to the bim reinforcement index of rowValue's ownerId in modelValue
            if ownerFound's valid and (rowValue's shape != (the string form of "STRAIGHT")):
                set ownerSpec to the item at ownerFound's position in (modelValue's reinforcements's values)
                set bendValue to ownerSpec's bendRadius
                if rowValue's shape = (the string form of "ARC"):
                    set bendValue to -1.0
            if bendValue >= 0.0:
                append (the string form of (bendValue * 1000.0)) to fields
            else:
                append (the string form of "") to fields
            append (the string form of ((the bim reinforcing total length of rowValue) * (((rowValue's diameter * rowValue's diameter) * 0.7853981633974483) * 7850.0))) to fields
            append (fields joined with "\t") to reportLines
            free fields
        set resultText to reportLines joined with "\n"
        free reportLines
        return resultText
