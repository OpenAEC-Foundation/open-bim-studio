# SPDX-License-Identifier: MPL-2.0
# Parametric reinforcement, independent of editor, persistence and renderer.
# Dimensions are metres. Cover is measured to the OUTSIDE of the outer steel.
# Definitions are immutable; generated paths are disposable derived geometry.
import kernel/core/core.dl
import kernel/core/topology_list.dl
import lib/text.dl
import model/reinforcement_library.dl

class:
    patterns:
        [a|] reinforcement definition
    members:
        id as a 64 bit integer
        levelId as a 64 bit integer
        hostId as a 64 bit integer
        # 0 straight bar, 1 cage, 2 mesh, 3 L, 4 U, 5 area reinforcement.
        kind as an integer
        mark as a string
        start as a cad vector3
        finish as a cad vector3
        width as a 64 bit floating-point number
        depth as a 64 bit floating-point number
        diameter as a 64 bit floating-point number
        secondaryDiameter as a 64 bit floating-point number
        spacing as a 64 bit floating-point number
        crossSpacing as a 64 bit floating-point number
        cover as a 64 bit floating-point number
        bendRadius as a 64 bit floating-point number
        topCount as an integer
        bottomCount as an integer
        topDiameter as a 64 bit floating-point number
        bottomDiameter as a 64 bit floating-point number
        cageType as a string
        startZoneLength as a 64 bit floating-point number
        startZoneSpacing as a 64 bit floating-point number
        endZoneLength as a 64 bit floating-point number
        endZoneSpacing as a 64 bit floating-point number
        extraTopCount as an integer
        extraTopDiameter as a 64 bit floating-point number
        extraBottomCount as an integer
        extraBottomDiameter as a 64 bit floating-point number
        extraFrom as a 64 bit floating-point number
        extraTo as a 64 bit floating-point number
        areaMode as an integer
        faceMask as an integer
        farDiameter as a 64 bit floating-point number
        farSecondaryDiameter as a 64 bit floating-point number
        farSpacing as a 64 bit floating-point number
        farCrossSpacing as a 64 bit floating-point number
        curveRadius as a 64 bit floating-point number
        meshType as a string
        steelKey as a string
        secondarySteelKey as a string

class:
    patterns:
        [a|] reinforcement bar
    members:
        mark as a string
        diameter as a 64 bit floating-point number
        points as the type of (a cad topology list of a cad vector3)
        # Analytic centreline length, independent of drawing tessellation.
        length as a 64 bit floating-point number
        closed as a boolean

class:
    patterns:
        [a|] reinforcement result
    members:
        valid as a boolean
        message as a string
        bars as the type of (a cad topology list of a reinforcement bar)

function a reinforcement refusal saying {a string:reason}:
    execute:
        return @intrinsic("construct", a reinforcement result, false, reason, a cad topology list of a reinforcement bar)

function the reinforcement issue of {reinforcement definition:spec}:
    execute:
        if ((the reinforcement steel named spec's steelKey)'s valid = false) or ((the reinforcement steel named spec's secondarySteelKey)'s valid = false):
            return the string form of "Unknown steel library key"
        if (((the cad length of spec's start) < 10000000.0) and ((the cad length of spec's finish) < 10000000.0)) = false:
            return the string form of "Invalid reinforcement coordinates"
        if (spec's kind < 0) or (spec's kind > 5):
            return the string form of "Unknown reinforcement kind"
        set extent to the cad distance from spec's start to spec's finish
        # Comparisons also reject NaN and infinity.
        if ((extent > 0.000001) and (extent < 100000.0)) = false:
            return the string form of "A finite nonzero axis is required"
        if ((spec's diameter > 0.0) and (spec's diameter < 1.0)) = false:
            return the string form of "Invalid bar diameter"
        if ((spec's cover >= 0.0) and (spec's cover < 100.0)) = false:
            return the string form of "Invalid cover"
        if (spec's kind = 2) or (spec's kind = 5):
            return the area reinforcement issue of spec
        if spec's kind = 0:
            return the string form of ""
        if (spec's kind = 3) or (spec's kind = 4):
            if ((spec's bendRadius > spec's diameter * 0.5) and (spec's bendRadius < 100.0)) = false:
                return the string form of "Invalid centreline bend radius"
            if ((spec's width > spec's bendRadius * 2.0) and (spec's width < 100000.0)) = false:
                return the string form of "Bends do not fit the return leg"
            if extent <= (2.0 * spec's bendRadius):
                return the string form of "Bends do not fit the axis"
            return the string form of ""
        if ((spec's spacing > 0.000001) and (spec's spacing < 10000.0)) = false:
            return the string form of "Invalid spacing"
        if ((spec's secondaryDiameter > 0.0) and (spec's secondaryDiameter < 1.0)) = false:
            return the string form of "Invalid secondary diameter"
        if ((spec's width > 0.0) and (spec's width < 100000.0)) = false:
            return the string form of "Invalid width"
        if spec's kind = 1:
            if ((spec's topCount < 1) or (spec's topCount > 100)) or ((spec's bottomCount < 1) or (spec's bottomCount > 100)):
                return the string form of "Cage layers require 1 to 100 bars"
            if ((spec's topDiameter > 0.0) and (spec's topDiameter < 1.0)) = false:
                return the string form of "Invalid top diameter"
            if ((spec's bottomDiameter > 0.0) and (spec's bottomDiameter < 1.0)) = false:
                return the string form of "Invalid bottom diameter"
            set spec's diameter to the maximum of spec's topDiameter and spec's bottomDiameter
            set inset to spec's cover + (spec's secondaryDiameter * 0.5)
            if ((spec's depth > 0.0) and (spec's depth < 100000.0)) = false:
                return the string form of "Invalid cage depth"
            if ((spec's bendRadius >= spec's secondaryDiameter) and (spec's bendRadius < 100.0)) = false:
                return the string form of "Invalid centreline bend radius"
            set needed to (2.0 * inset) + (2.0 * spec's bendRadius)
            if (spec's width <= needed) or (spec's depth <= needed):
                return the string form of "Bends and cover do not fit the cage"
            set innerNeeded to 2.0 * ((spec's cover + spec's secondaryDiameter) + spec's diameter)
            set roundedInset to the maximum of ((spec's cover + spec's secondaryDiameter) + (spec's diameter * 0.5)) and (inset + spec's bendRadius)
            set innerNeeded to the maximum of innerNeeded and (2.0 * (roundedInset + spec's diameter * 0.5))
            if (spec's width <= innerNeeded) or (spec's depth <= innerNeeded):
                return the string form of "Longitudinal bars do not fit the cage"
            if ((spec's startZoneLength >= 0.0) and (spec's endZoneLength >= 0.0)) = false:
                return the string form of "Invalid stirrup zone length"
            if (spec's startZoneLength + spec's endZoneLength) >= (extent - (2.0 * inset)):
                return the string form of "Stirrup end zones overlap"
            if ((spec's startZoneSpacing > 0.000001) and (spec's endZoneSpacing > 0.000001)) = false:
                return the string form of "Invalid stirrup zone spacing"
            if ((spec's startZoneLength / spec's startZoneSpacing) + (spec's endZoneLength / spec's endZoneSpacing)) > 10000.0:
                return the string form of "Stirrup zones exceed 10000 intervals"
            loop layerCheck from 0 to 4:
                set checkCount to spec's topCount
                set checkDiameter to spec's topDiameter
                if layerCheck = 1:
                    set checkCount to spec's bottomCount
                    set checkDiameter to spec's bottomDiameter
                if layerCheck = 2:
                    set checkCount to spec's extraTopCount
                    set checkDiameter to spec's extraTopDiameter
                if layerCheck = 3:
                    set checkCount to spec's extraBottomCount
                    set checkDiameter to spec's extraBottomDiameter
                if (checkCount < 0) or (checkCount > 100):
                    return the string form of "Invalid additional bar count"
                if checkCount > 0:
                    if ((checkDiameter > 0.0) and (checkDiameter < 1.0)) = false:
                        return the string form of "Invalid layer diameter"
                    set layerInset to the maximum of ((spec's cover + spec's secondaryDiameter) + checkDiameter * 0.5) and (inset + spec's bendRadius)
                    if (spec's width - (2.0 * layerInset)) < ((checkCount - 1) as a 64 bit floating-point number) * checkDiameter:
                        return the string form of "Layer bars overlap"
                    if layerCheck >= 2:
                        if ((spec's extraFrom >= spec's cover) and (spec's extraTo <= (extent - spec's cover))) = false:
                            return the string form of "Additional bars exceed cage ends"
                        if spec's extraTo <= spec's extraFrom:
                            return the string form of "Invalid additional bar range"
                        if (spec's depth * 0.5) <= (layerInset + spec's diameter + 0.02 + checkDiameter):
                            return the string form of "Additional layer does not fit cage"
        else:
            if ((spec's crossSpacing > 0.000001) and (spec's crossSpacing < 10000.0)) = false:
                return the string form of "Invalid cross spacing"
            if (spec's width <= (2.0 * spec's cover + spec's diameter)) or (extent <= (2.0 * spec's cover + spec's secondaryDiameter)):
                return the string form of "Cover does not fit the mesh"
        if extent <= (2.0 * spec's cover + spec's secondaryDiameter):
            return the string form of "Cover does not fit the axis"
        if (extent / spec's spacing) > 10000.0:
            return the string form of "Distribution exceeds 10000 intervals"
        if spec's kind = 2:
            if (spec's width / spec's crossSpacing) > 10000.0:
                return the string form of "Cross distribution exceeds 10000 intervals"
        return the string form of ""

# Coordinate frame: x follows the axis; y is horizontal across it, or global
# x for a vertical axis. z completes the right-handed orthonormal frame.
function the reinforcement position {cad vector3:localSpot} in {reinforcement definition:spec}:
    execute:
        set delta to the cad difference of spec's finish and spec's start
        set forward to delta scaled by (1.0 / (the cad length of delta))
        set across to the cad cross of (a cad vector3 with x 0.0, y 0.0 and z 1.0) and forward
        if (the cad length of across) < 0.000001:
            set across to a cad vector3 with x 1.0, y 0.0 and z 0.0
        else:
            set across to across scaled by (1.0 / (the cad length of across))
        set upward to the cad cross of forward and across
        return the cad sum of spec's start and (the cad sum of (forward scaled by localSpot's x) and (the cad sum of (across scaled by localSpot's y) and (upward scaled by localSpot's z)))

function append reinforcement segment from {cad vector3:beginning} to {cad vector3:ending} diameter {a 64 bit floating-point number:barSize} marked {a string:label} into {a pointer to a reinforcement result:output}:
    execute:
        set vertices to a cad topology list of a cad vector3
        append beginning to (vertices's values)
        append ending to (vertices's values)
        append (@intrinsic("construct", a reinforcement bar, label, barSize, vertices, the cad distance from beginning to ending, false)) to (output's bars's values)

# Ceil(span / requested maximum). The final interval is shortened uniformly;
# both boundary bars are present and actual spacing never exceeds the request.
function the reinforcement intervals over {a 64 bit floating-point number:spanValue} at {a 64 bit floating-point number:stepValue}:
    execute:
        return (@intrinsic("call", "libc", "ceil", a 64 bit floating-point number, spanValue / stepValue)) as an integer

# A bent bar from a 3D polyline, filleted with a constant centreline radius.
# Tangency distances on neighbouring corners must fit each shared segment.
function the reinforcement bent along {a pointer to a list:corners} radius {a 64 bit floating-point number:radiusValue} diameter {a 64 bit floating-point number:barSize} marked {a string:label}:
    execute:
        set count to the length of corners
        if (count < 2) or (count > 4096):
            return a reinforcement refusal saying (the string form of "A bar path needs 2..4096 points")
        if (((radiusValue > 0.0) and (radiusValue < 10000.0)) and ((barSize > 0.0) and (barSize < 1.0))) = false:
            return a reinforcement refusal saying (the string form of "Invalid bend parameters")
        if radiusValue <= (barSize * 0.5):
            return a reinforcement refusal saying (the string form of "Centreline radius must exceed bar radius")
        set tangencies to an empty list of a 64 bit floating-point number
        set angles to an empty list of a 64 bit floating-point number
        append 0.0 to tangencies
        append 0.0 to angles
        set total to 0.0
        loop cursor from 0 to (count - 1):
            set spanValue to the cad distance from (the item at cursor in corners) to (the item at (cursor + 1) in corners)
            if ((spanValue > 0.000001) and (spanValue < 100000.0)) = false:
                free tangencies
                free angles
                return a reinforcement refusal saying (the string form of "Invalid bar segment")
            set total to total + spanValue
        loop cursor from 1 to (count - 1):
            set incoming to the cad difference of (the item at cursor in corners) and (the item at (cursor - 1) in corners)
            set outgoing to the cad difference of (the item at (cursor + 1) in corners) and (the item at cursor in corners)
            set incoming to incoming scaled by (1.0 / (the cad length of incoming))
            set outgoing to outgoing scaled by (1.0 / (the cad length of outgoing))
            set cosine to the cad dot of incoming and outgoing
            set sine to the cad length of (the cad cross of incoming and outgoing)
            if cosine < -0.999999:
                free tangencies
                free angles
                return a reinforcement refusal saying (the string form of "A reversing corner has no finite fillet")
            set turn to @intrinsic("atan2", sine, cosine)
            set tangentValue to radiusValue * (sine / (1.0 + cosine))
            append tangentValue to tangencies
            append turn to angles
            set total to (total - 2.0 * tangentValue) + (radiusValue * turn)
        append 0.0 to tangencies
        append 0.0 to angles
        loop cursor from 0 to (count - 1):
            set used to (the item at cursor in tangencies) + (the item at (cursor + 1) in tangencies)
            if used >= (the cad distance from (the item at cursor in corners) to (the item at (cursor + 1) in corners)):
                free tangencies
                free angles
                return a reinforcement refusal saying (the string form of "Bends do not fit adjacent segments")
        set vertices to a cad topology list of a cad vector3
        append (the item at 0 in corners) to (vertices's values)
        loop cursor from 1 to (count - 1):
            set turn to the item at cursor in angles
            if turn < 0.000001:
                append (the item at cursor in corners) to (vertices's values)
            else:
                set incoming to the cad difference of (the item at cursor in corners) and (the item at (cursor - 1) in corners)
                set outgoing to the cad difference of (the item at (cursor + 1) in corners) and (the item at cursor in corners)
                set incoming to incoming scaled by (1.0 / (the cad length of incoming))
                set outgoing to outgoing scaled by (1.0 / (the cad length of outgoing))
                set normalValue to the cad cross of incoming and outgoing
                set normalValue to normalValue scaled by (1.0 / (the cad length of normalValue))
                set lateral to the cad cross of normalValue and incoming
                set tangentSpot to the cad difference of (the item at cursor in corners) and (incoming scaled by (the item at cursor in tangencies))
                set centre to the cad sum of tangentSpot and (lateral scaled by radiusValue)
                set radial to lateral scaled by (0.0 - radiusValue)
                set sweep to the cad cross of normalValue and radial
                set samples to (@intrinsic("call", "libc", "ceil", a 64 bit floating-point number, turn / (3.141592653589793 / 24.0))) as an integer
                loop sample from 0 to (samples + 1):
                    set stepAngle to turn * ((sample as a 64 bit floating-point number) / (samples as a 64 bit floating-point number))
                    append (the cad sum of centre and (the cad sum of (radial scaled by (the cosine of stepAngle)) and (sweep scaled by (the sine of stepAngle)))) to (vertices's values)
        append (the item at (count - 1) in corners) to (vertices's values)
        free tangencies
        free angles
        set bars to a cad topology list of a reinforcement bar
        append (@intrinsic("construct", a reinforcement bar, label, barSize, vertices, total, false)) to (bars's values)
        return @intrinsic("construct", a reinforcement result, true, the string form of "", bars)


function the reinforcement of {reinforcement definition:spec}:
    execute:
        set issue to the reinforcement issue of spec
        if issue != (the string form of ""):
            return a reinforcement refusal saying issue
        set output to @intrinsic("construct", a reinforcement result, true, the string form of "", a cad topology list of a reinforcement bar)
        set sink to the address of output
        set extent to the cad distance from spec's start to spec's finish
        if spec's kind = 0:
            append reinforcement segment from spec's start to spec's finish diameter spec's diameter marked spec's mark into sink
            return output
        if (spec's kind = 3) or (spec's kind = 4):
            set corners to an empty list of a cad vector3
            append spec's start to corners
            append spec's finish to corners
            append (the reinforcement position (a cad vector3 with x extent, y spec's width and z 0.0) in spec) to corners
            if spec's kind = 4:
                append (the reinforcement position (a cad vector3 with x 0.0, y spec's width and z 0.0) in spec) to corners
            set bent to the reinforcement bent along corners radius spec's bendRadius diameter spec's diameter marked spec's mark
            free corners
            return bent
        if (spec's kind = 2) or (spec's kind = 5):
            return the area reinforcement of spec
        # Each layer is generated from its own count and diameter.
        set outerInset to spec's cover + spec's secondaryDiameter * 0.5
        set halfWidth to spec's width * 0.5
        set halfDepth to spec's depth * 0.5
        loop layerIndex from 0 to 4:
            set layerCount to spec's topCount
            set layerDiameter to spec's topDiameter
            set layerMark to spec's mark + (the string form of "-T")
            if layerIndex = 1:
                set layerCount to spec's bottomCount
                set layerDiameter to spec's bottomDiameter
                set layerMark to spec's mark + (the string form of "-B")
            if layerIndex = 2:
                set layerCount to spec's extraTopCount
                set layerDiameter to spec's extraTopDiameter
                set layerMark to spec's mark + (the string form of "-ET")
            if layerIndex = 3:
                set layerCount to spec's extraBottomCount
                set layerDiameter to spec's extraBottomDiameter
                set layerMark to spec's mark + (the string form of "-EB")
            set barInset to the maximum of ((spec's cover + spec's secondaryDiameter) + layerDiameter * 0.5) and (outerInset + spec's bendRadius)
            set elevation to halfDepth - barInset
            if layerIndex = 2:
                set elevation to elevation - (spec's topDiameter + 0.02)
            if layerIndex = 3:
                set elevation to elevation - (spec's bottomDiameter + 0.02)
            if (layerIndex = 1) or (layerIndex = 3):
                set elevation to 0.0 - elevation
            loop barIndex from 0 to layerCount:
                set lateral to 0.0
                if layerCount > 1:
                    set lateral to (halfWidth - barInset) * (((2.0 * (barIndex as a 64 bit floating-point number)) / ((layerCount - 1) as a 64 bit floating-point number)) - 1.0)
                set firstPoint to the reinforcement position (a cad vector3 with x spec's cover, y lateral and z elevation) in spec
                set lastPoint to the reinforcement position (a cad vector3 with x (extent - spec's cover), y lateral and z elevation) in spec
                if layerIndex >= 2:
                    set firstPoint to the reinforcement position (a cad vector3 with x spec's extraFrom, y lateral and z elevation) in spec
                    set lastPoint to the reinforcement position (a cad vector3 with x spec's extraTo, y lateral and z elevation) in spec
                append reinforcement segment from firstPoint to lastPoint diameter layerDiameter marked layerMark into sink
        set count to the reinforcement intervals over (extent - 2.0 * outerInset) at spec's spacing
        set yRadius to halfWidth - outerInset
        set zRadius to halfDepth - outerInset
        set bend to spec's bendRadius
        set perimeter to 4.0 * ((yRadius + zRadius) - (2.0 * bend)) + ((2.0 * 3.141592653589793) * bend)
        set stations to an empty list of a 64 bit floating-point number
        append outerInset to stations
        loop zoneIndex from 0 to 3:
            set zoneStart to outerInset
            set zoneEnd to outerInset + spec's startZoneLength
            set zoneSpacing to spec's startZoneSpacing
            if zoneIndex = 1:
                set zoneStart to zoneEnd
                set zoneEnd to (extent - outerInset) - spec's endZoneLength
                set zoneSpacing to spec's spacing
            if zoneIndex = 2:
                set zoneStart to (extent - outerInset) - spec's endZoneLength
                set zoneEnd to extent - outerInset
                set zoneSpacing to spec's endZoneSpacing
            if zoneEnd > zoneStart:
                set zoneCount to the reinforcement intervals over (zoneEnd - zoneStart) at zoneSpacing
                loop zoneStep from 1 to (zoneCount + 1):
                    append (zoneStart + ((zoneEnd - zoneStart) * ((zoneStep as a 64 bit floating-point number) / (zoneCount as a 64 bit floating-point number)))) to stations
        loop cursor from 0 to the length of stations:
            set station to the item at cursor in stations
            set vertices to a cad topology list of a cad vector3
            loop corner from 0 to 4:
                set centreY to yRadius - bend
                set centreZ to zRadius - bend
                if (corner = 1) or (corner = 2):
                    set centreY to 0.0 - centreY
                if corner >= 2:
                    set centreZ to 0.0 - centreZ
                loop sample from 0 to 9:
                    set turn to ((corner as a 64 bit floating-point number) + ((sample as a 64 bit floating-point number) / 8.0)) * (3.141592653589793 * 0.5)
                    set pointValue to a cad vector3 with x station, y (centreY + bend * (the cosine of turn)) and z (centreZ + bend * (the sine of turn))
                    append (the reinforcement position pointValue in spec) to (vertices's values)
            append (the item at 0 in (vertices's values)) to (vertices's values)
            append (@intrinsic("construct", a reinforcement bar, spec's mark + (the string form of "-S"), spec's secondaryDiameter, vertices, perimeter, true)) to (output's bars's values)
        free stations
        return output

function the reinforcement total length of {reinforcement result:generated}:
    execute:
        set measured to 0.0
        loop cursor from 0 to the length of (generated's bars's values):
            set itemValue to the item at cursor in (generated's bars's values)
            set measured to measured + itemValue's length
        return measured

function the reinforcement millimetres of {a 64 bit floating-point number:amount}:
    execute:
        set scaled to (@intrinsic("call", "libc", "round", a 64 bit floating-point number, amount * 1000000.0)) as a 64 bit integer
        set whole to scaled / (1000 as a 64 bit integer)
        set fraction to the remainder of scaled divided by (1000 as a 64 bit integer)
        set label to the string form of whole
        if fraction > (0 as a 64 bit integer):
            set padded to the string form of (fraction + (1000 as a 64 bit integer))
            set digits to the substring of padded from 1 spanning 3 bytes
            loop while (the character at ((the length of digits) - 1) in digits) = (48 as a byte):
                set digits to the substring of digits from 0 spanning ((the length of digits) - 1) bytes
            set label to (label + (the string form of ".")) + digits
        return label

function the reinforcement geometry annotation of {reinforcement definition:spec}:
    execute:
        if (spec's kind = 2) or (spec's kind = 5):
            return the area reinforcement annotation of spec
        set diameterMM to the reinforcement millimetres of spec's diameter
        set label to spec's mark + (the string form of " / D")
        if spec's kind = 1:
            set label to ((spec's mark + (the string form of " / ")) + (the string form of spec's topCount)) + (the string form of "D")
            set label to (label + (the reinforcement millimetres of spec's topDiameter)) + (the string form of " top + ")
            set label to (label + (the string form of spec's bottomCount)) + (the string form of "D")
            set diameterMM to (the reinforcement millimetres of spec's bottomDiameter) + (the string form of " bottom")
        if spec's kind = 2:
            set label to spec's mark + (the string form of " / X D")
        set label to label + diameterMM
        if (spec's kind = 1) or (spec's kind = 2):
            set secondaryMM to the reinforcement millimetres of spec's secondaryDiameter
            set spacingMM to the reinforcement millimetres of spec's spacing
            if spec's kind = 2:
                set crossMM to the reinforcement millimetres of spec's crossSpacing
                set label to (label + (the string form of " @ max ")) + crossMM
                set label to label + (the string form of " / Y D")
            else:
                set label to label + (the string form of " + D")
            set label to label + secondaryMM
            set label to (label + (the string form of " @ max ")) + spacingMM
        if spec's kind = 1:
            if spec's cageType != (the string form of "-"):
                set label to (((the string form of "Cage ") + spec's cageType) + (the string form of " / ")) + label
            if spec's startZoneLength > 0.0:
                set label to ((label + (the string form of " / start ")) + (the reinforcement millimetres of spec's startZoneLength)) + (the string form of " @ ")
                set label to label + (the reinforcement millimetres of spec's startZoneSpacing)
            if spec's endZoneLength > 0.0:
                set label to ((label + (the string form of " / end ")) + (the reinforcement millimetres of spec's endZoneLength)) + (the string form of " @ ")
                set label to label + (the reinforcement millimetres of spec's endZoneSpacing)
            if (spec's extraTopCount > 0) or (spec's extraBottomCount > 0):
                set label to ((label + (the string form of " / extra top ")) + (the string form of spec's extraTopCount)) + (the string form of "D")
                set label to (label + (the reinforcement millimetres of spec's extraTopDiameter)) + (the string form of " bottom ")
                set label to ((label + (the string form of spec's extraBottomCount)) + (the string form of "D")) + (the reinforcement millimetres of spec's extraBottomDiameter)
                set label to ((label + (the string form of " [")) + (the reinforcement millimetres of spec's extraFrom)) + (the string form of "..")
                set label to (label + (the reinforcement millimetres of spec's extraTo)) + (the string form of "]")
        return label

import model/reinforcement_area.dl

function the reinforcement annotation of {reinforcement definition:spec}:
    execute:
        set label to the reinforcement geometry annotation of spec
        if (spec's steelKey != (the string form of "UNKNOWN")) or (spec's secondarySteelKey != (the string form of "UNKNOWN")):
            set label to ((label + (the string form of " / steel ")) + spec's steelKey) + (the string form of " / secondary ")
            set label to label + spec's secondarySteelKey
        return label

# Library presets change geometry parameters, not placement or material identity.
# Cage copies are independent until the user explicitly assigns a shared type.
function the reinforcement {reinforcement definition:spec} applying library preset {a string:key}:
    execute:
        set result to spec
        set cagePreset to ((key = (the string form of "CAGE_A")) or (key = (the string form of "CAGE_B"))) or (key = (the string form of "CAGE_C"))
        if cagePreset and (spec's kind = 1):
            set result's cageType to the string form of "-"
            set result's topCount to 3
            set result's bottomCount to 3
            set result's topDiameter to 0.012
            set result's bottomDiameter to 0.016
            set result's secondaryDiameter to 0.008
            set result's spacing to 0.15
            if key = (the string form of "CAGE_B"):
                set result's topCount to 4
                set result's bottomCount to 4
                set result's topDiameter to 0.016
            if key = (the string form of "CAGE_C"):
                set result's topCount to 2
            set result's diameter to the maximum of result's topDiameter and result's bottomDiameter
            return result
        set meshSize to 0.0
        if key = (the string form of "MESH6_150"):
            set meshSize to 0.006
        if key = (the string form of "MESH8_150"):
            set meshSize to 0.008
        if key = (the string form of "MESH10_150"):
            set meshSize to 0.010
        if (meshSize > 0.0) and (spec's kind = 2):
            set result's diameter to meshSize
            set result's secondaryDiameter to meshSize
            set result's farDiameter to meshSize
            set result's farSecondaryDiameter to meshSize
            set result's spacing to 0.15
            set result's crossSpacing to 0.15
            set result's farSpacing to 0.15
            set result's farCrossSpacing to 0.15
            set result's meshType to key
            return result
        # Invalid metadata also rejects hosted objects whose axes are re-derived.
        set result's steelKey to the string form of "INVALID_PRESET"
        return result
