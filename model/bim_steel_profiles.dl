        append (the string form of "4 280 1 280 280 10.5 18 24 1;4 300 1 300 300 11 19 27 1;4 320 1 320 300 11.5 20.5 27 1;4 340 1 340 300 12 21.5 27 1;4 360 1 360 300 12.5 22.5 27 1;4 400 1 400 300 13.5 24 27 1;4 450 1 450 300 14 26 27 1;4 500 1 500 300 14.5 28 27 1;4 550 1 550 300 15 29 27 1;4 600 1 600 300 15.5 30 27 1;4 650 1 650 300 16 31 27 1;4 700 1 700 300 17 32 27 1") to tableLines
        append (the string form of "4 800 1 800 300 17.5 33 30 1;4 900 1 900 300 18.5 35 30 1;4 1000 1 1000 300 19 36 30 1;5 100 1 120 106 12 20 12 1;5 120 1 140 126 12.5 21 12 1;5 140 1 160 146 13 22 12 1;5 160 1 180 166 14 23 15 1;5 180 1 200 186 14.5 24 15 1;5 200 1 220 206 15 25 18 1;5 220 1 240 226 15.5 26 18 1;5 240 1 270 248 18 32 21 1;5 260 1 290 268 18 32.5 24 1") to tableLines
        append (the string form of "5 280 1 310 288 18.5 33 24 1;5 300 1 340 310 21 39 27 1;5 320 1 359 309 21 40 27 1;5 340 1 377 309 21 40 27 1;5 360 1 395 308 21 40 27 1;5 400 1 432 307 21 40 27 1;5 450 1 478 307 21 40 27 1;5 500 1 524 306 21 40 27 1;5 550 1 572 306 21 40 27 1;5 600 1 620 305 21 40 27 1;5 650 1 668 305 21 40 27 1;5 700 1 716 304 21 40 27 1") to tableLines
        append (the string form of "5 800 1 814 303 21 40 30 1;5 900 1 910 302 21 40 30 1;5 1000 1 1008 302 21 40 30 1;6 50 3 50 38 5 7 7 0;6 65 3 65 42 5.5 7.5 7.5 0;6 80 3 80 45 6 8 8 0;6 100 3 100 50 6 8.5 8.5 0;6 120 3 120 55 7 9 9 0;6 140 3 140 60 7 10 10 0;6 160 3 160 65 7.5 10.5 10.5 0;6 180 3 180 70 8 11 11 0;6 200 3 200 75 8.5 11.5 11.5 0") to tableLines
        append (the string form of "6 220 3 220 80 9 12.5 12.5 0;6 240 3 240 85 9.5 13 13 0;6 260 3 260 90 10 14 14 0;6 280 3 280 95 10 15 15 0;6 300 3 300 100 10 16 16 0;6 320 3 320 100 14 17.5 17.5 0;6 350 3 350 100 14 16 16 0;6 380 3 380 102 13.5 16 16 0;6 400 3 400 110 14 18 18 0;7 80 3 80 50 4 7 10 0;7 100 3 100 55 4.5 7.5 10 0;7 120 3 120 60 5 8 12 0") to tableLines
        append (the string form of "7 140 3 140 65 5 9 12 0;7 160 3 160 70 5.5 9.5 12 0;7 180 3 180 75 5.5 10.5 12 0;7 200 3 200 80 6 11 13 0;7 220 3 220 85 6.5 12 13 0;7 240 3 240 90 7 12.5 15 0;7 270 3 270 95 7.5 13.5 15 0;7 300 3 300 100 9.5 15 15 0;7 330 3 330 105 11 16 18 0;7 360 3 360 110 12 17 18 0;7 400 3 400 115 13.5 18 18 0;8 0 2 20 20 3 3 3.5 0") to tableLines
        append (the string form of "8 0 2 25 25 3 3 3.5 0;8 0 2 25 25 4 4 3.5 0;8 0 2 30 30 3 3 5 0;8 0 2 30 30 4 4 5 0;8 0 2 35 35 4 4 5 0;8 0 2 40 40 4 4 6 0;8 0 2 40 40 5 5 6 0;8 0 2 45 45 4.5 4.5 7 0;8 0 2 50 50 5 5 7 0;8 0 2 50 50 6 6 7 0;8 0 2 60 60 6 6 8 0;8 0 2 60 60 8 8 8 0") to tableLines
        append (the string form of "8 0 2 65 65 7 7 9 0;8 0 2 70 70 7 7 9 0;8 0 2 75 75 8 8 9 0;8 0 2 80 80 8 8 10 0;8 0 2 80 80 10 10 10 0;8 0 2 90 90 9 9 11 0;8 0 2 100 100 8 8 12 0;8 0 2 100 100 10 10 12 0;8 0 2 100 100 12 12 12 0;8 0 2 120 120 10 10 13 0;8 0 2 120 120 12 12 13 0;8 0 2 150 150 12 12 16 0") to tableLines
        append (the string form of "8 0 2 150 150 15 15 16 0;8 0 2 160 160 15 15 17 0;8 0 2 180 180 18 18 18 0;8 0 2 200 200 16 16 18 0;8 0 2 200 200 20 20 18 0;8 0 2 250 250 25 25 18 0;8 0 2 250 250 35 35 18 0;9 0 2 30 20 3 3 4 0;9 0 2 40 20 4 4 4 0;9 0 2 40 25 4 4 4 0;9 0 2 45 30 4 4 4.5 0;9 0 2 50 30 5 5 5 0") to tableLines
        append (the string form of "9 0 2 60 30 5 5 6 0;9 0 2 60 40 5 5 6 0;9 0 2 60 40 6 6 6 0;9 0 2 65 50 5 5 6 0;9 0 2 70 50 6 6 7 0;9 0 2 75 50 6 6 7 0;9 0 2 75 50 8 8 7 0;9 0 2 80 40 6 6 7 0;9 0 2 80 60 7 7 8 0;9 0 2 100 50 6 6 8 0;9 0 2 100 50 8 8 8 0;9 0 2 100 65 7 7 10 0") to tableLines
        append (the string form of "9 0 2 100 75 8 8 10 0;9 0 2 120 80 8 8 11 0;9 0 2 120 80 10 10 11 0;9 0 2 125 75 8 8 11 0;9 0 2 150 75 9 9 12 0;9 0 2 150 90 10 10 12 0;9 0 2 150 100 10 10 12 0;9 0 2 200 100 10 10 15 0;9 0 2 200 100 12 12 15 0;9 0 2 200 150 12 12 15 0;9 0 2 200 150 15 15 15 0;10 30 4 30 30 4 4 0 0") to tableLines
        append (the string form of "10 35 4 35 35 4.5 4.5 0 0;10 40 4 40 40 5 5 0 0;10 50 4 50 50 6 6 0 0;10 60 4 60 60 7 7 0 0;10 70 4 70 70 8 8 0 0;10 80 4 80 80 9 9 0 0;10 100 4 100 100 11 11 0 0;10 120 4 120 120 13 13 0 0;10 140 4 140 140 15 15 0 0;11 0 7 40 40 3 4.5 0 1;11 0 7 40 40 4 6 0 1;11 0 7 50 50 3 4.5 0 1") to tableLines
        append (the string form of "11 0 7 50 50 4 6 0 1;11 0 7 50 50 5 7.5 0 1;11 0 7 60 60 3 4.5 0 1;11 0 7 60 60 4 6 0 1;11 0 7 60 60 5 7.5 0 1;11 0 7 70 70 4 6 0 1;11 0 7 70 70 5 7.5 0 1;11 0 7 80 80 4 6 0 1;11 0 7 80 80 5 7.5 0 1;11 0 7 80 80 6 9 0 1;11 0 7 90 90 5 7.5 0 1;11 0 7 100 100 4 6 0 1") to tableLines
        append (the string form of "11 0 7 100 100 5 7.5 0 1;11 0 7 100 100 6 9 0 1;11 0 7 100 100 8 12 0 1;11 0 7 100 100 10 15 0 1;11 0 7 120 120 5 7.5 0 1;11 0 7 120 120 6 9 0 1;11 0 7 120 120 8 12 0 1;11 0 7 120 120 10 15 0 1;11 0 7 140 140 6 9 0 1;11 0 7 140 140 8 12 0 1;11 0 7 140 140 10 15 0 1;11 0 7 150 150 6 9 0 1") to tableLines
        append (the string form of "11 0 7 150 150 8 12 0 1;11 0 7 150 150 10 15 0 1;11 0 7 160 160 6 9 0 1;11 0 7 160 160 8 12 0 1;11 0 7 160 160 10 15 0 1;11 0 7 180 180 8 12 0 1;11 0 7 180 180 10 15 0 1;11 0 7 200 200 6 9 0 1;11 0 7 200 200 8 12 0 1;11 0 7 200 200 10 15 0 1;11 0 7 200 200 12.5 18.7 0 1;11 0 7 250 250 8 12 0 1") to tableLines
        append (the string form of "11 0 7 250 250 10 15 0 1;11 0 7 250 250 12.5 18.7 0 1;11 0 7 300 300 10 15 0 1;11 0 7 300 300 12.5 18.7 0 1;12 0 7 50 30 3 4.5 0 1;12 0 7 60 40 3 4.5 0 1;12 0 7 60 40 4 6 0 1;12 0 7 80 40 4 6 0 1;12 0 7 80 60 4 6 0 1;12 0 7 100 50 4 6 0 1;12 0 7 100 50 5 7.5 0 1;12 0 7 100 60 4 6 0 1") to tableLines
        append (the string form of "12 0 7 100 60 5 7.5 0 1;12 0 7 120 60 5 7.5 0 1;12 0 7 120 80 5 7.5 0 1;12 0 7 120 80 6 9 0 1;12 0 7 140 80 6 9 0 1;12 0 7 150 100 6 9 0 1;12 0 7 150 100 8 12 0 1;12 0 7 160 80 6 9 0 1;12 0 7 200 100 6 9 0 1;12 0 7 200 100 8 12 0 1;12 0 7 200 100 10 15 0 1;12 0 7 250 150 8 12 0 1") to tableLines
        append (the string form of "12 0 7 250 150 10 15 0 1;12 0 7 300 200 10 15 0 1;12 0 7 300 200 12.5 18.7 0 1;13 0 8 33.7 33.7 3.2 0 0 1;13 0 8 42.4 42.4 3.2 0 0 1;13 0 8 48.3 48.3 3.2 0 0 1;13 0 8 48.3 48.3 4 0 0 1;13 0 8 60.3 60.3 3.2 0 0 1;13 0 8 60.3 60.3 4 0 0 1;13 0 8 76.1 76.1 3.2 0 0 1;13 0 8 76.1 76.1 4 0 0 1;13 0 8 76.1 76.1 5 0 0 1") to tableLines
        append (the string form of "13 0 8 88.9 88.9 4 0 0 1;13 0 8 88.9 88.9 5 0 0 1;13 0 8 88.9 88.9 6.3 0 0 1;13 0 8 114.3 114.3 4 0 0 1;13 0 8 114.3 114.3 5 0 0 1;13 0 8 114.3 114.3 6.3 0 0 1;13 0 8 139.7 139.7 5 0 0 1;13 0 8 139.7 139.7 6.3 0 0 1;13 0 8 139.7 139.7 8 0 0 1;13 0 8 168.3 168.3 5 0 0 1;13 0 8 168.3 168.3 6.3 0 0 1;13 0 8 168.3 168.3 8 0 0 1") to tableLines
        append (the string form of "13 0 8 168.3 168.3 10 0 0 1;13 0 8 193.7 193.7 6.3 0 0 1;13 0 8 193.7 193.7 8 0 0 1;13 0 8 193.7 193.7 10 0 0 1;13 0 8 219.1 219.1 6.3 0 0 1;13 0 8 219.1 219.1 8 0 0 1;13 0 8 219.1 219.1 10 0 0 1;13 0 8 219.1 219.1 12.5 0 0 1;13 0 8 244.5 244.5 8 0 0 1;13 0 8 244.5 244.5 10 0 0 1;13 0 8 273 273 8 0 0 1;13 0 8 273 273 10 0 0 1") to tableLines
        append (the string form of "13 0 8 273 273 12.5 0 0 1;13 0 8 323.9 323.9 8 0 0 1;13 0 8 323.9 323.9 10 0 0 1;13 0 8 323.9 323.9 12.5 0 0 1;13 0 8 355.6 355.6 10 0 0 1;13 0 8 355.6 355.6 12.5 0 0 1;13 0 8 406.4 406.4 10 0 0 1;13 0 8 406.4 406.4 12.5 0 0 1;13 0 8 457 457 10 0 0 1;13 0 8 457 457 12.5 0 0 1;13 0 8 508 508 12.5 0 0 1") to tableLines
        set records to an empty list of a string
        loop cursor from 0 to the length of tableLines:
            set pieces to (the item at cursor in tableLines) split at ";"
            loop pieceCursor from 0 to the length of pieces:
                append (the item at pieceCursor in pieces) to records
            free pieces
        free tableLines
        return records

# The library loaded once: 1 at 2000100 of the project.
function bim steel library setting:
    replacement:
        2000100

# The steel profiles added to `target` as linear types, once (none when the
# library was loaded before), named by the rules once all are in. The ids
# made.
function add bim eu steel profiles to {a pointer to a bim model record:target}:
    execute:
        set made to a cad topology list of a 64 bit integer
        if (the bim setting (bim steel library setting) of (0 as a 64 bit integer) in (@intrinsic("dereference", target)))'s found:
            return made
        set records to the bim steel profile table
        loop recordCursor from 0 to the length of records:
            set fields to (the item at recordCursor in records) split at " "
            if (the length of fields) = 9:
                set values to an empty list of a 64 bit floating-point number
                loop fieldCursor from 0 to 9:
                    set reading to the bim real reading of (the item at fieldCursor in fields)
                    append reading's value to values
                set seriesCode to (the item at 0 in values) as an integer
                set kindCode to (the item at 2 in values) as an integer
                set columnToo to (the item at 8 in values) > 0.5
                loop roleCursor from 0 to 2:
                    set roleCode to bim beam role
                    if roleCursor = 1:
                        set roleCode to bim column role
                    if (roleCursor = 0) or columnToo:
                        # Appended directly; the rules name them all at the end.
                        set fresh to the bim new id in target
                        append (@intrinsic("construct", a bim linear type record, fresh, (the string form of "Staal"), roleCode, ((the item at 4 in values) / 1000.0), ((the item at 3 in values) / 1000.0), false, (the string form of "steel"))) to (target's linearTypes's values)
                        if fresh != the bim refused id:
                            give bim linear type fresh profile kindCode web ((the item at 5 in values) / 1000.0) flange ((the item at 6 in values) / 1000.0) fillet ((the item at 7 in values) / 1000.0) fourth 0.0 series seriesCode in target
                            set bim setting (bim steel designation setting) of fresh to ((the item at 1 in values) as a 64 bit integer) keeping ((the item at 1 in values) > 0.5) in target
                            set bim setting (bim nlsfb setting) of fresh to (2810 as a 64 bit integer) keeping true in target
                            append fresh to (made's values)
                free values
            free fields
        free records
        set bim setting (bim steel library setting) of (0 as a 64 bit integer) to (1 as a 64 bit integer) keeping true in target
        name bim types by the rules in target
        return made
