# SPDX-License-Identifier: MPL-2.0
# Building system types: the library of systems a building system can be,
# as Revit's curtain wall types: curtain walls, timber frame, masonry in
# its formats and bonds, sand-lime elements, standing-seam zinc, timber
# cladding, facade panels, window frames, hollow-core floors and suspended
# ceilings. A type is a recipe (pattern, bays and rows, joints, panels,
# layers); applying it to a building system gives the system those settings
# and remembers the type (`bim system type setting`), so that the
# properties show it under Type, and "custom" once the system's own
# settings differ from it.
import model/bim_stair.dl

# A layer a type adds to its system (as `add bim layer to system`):
# `offset` millimetres across its face (outward positive), its own bays and
# rows, joints and panels.
class:
    patterns:
        [a|] bim system type layer record
    members:
        offset as an integer
        bayWidth as a 64 bit floating-point number
        rowHeight as a 64 bit floating-point number
        jointWide as an integer
        jointDeep as an integer
        celled as a boolean
        panelName as a string
        panelMaterial as a string
        panelThickness as a 64 bit floating-point number

# A building system type. `frameMaterial` is the material of its joints
# (mullions and transoms, a masonry's mortar); its panels are of a planar
# type named `panelName`, one layer of `panelMaterial` `panelThickness`
# metres thick (glass when `panelName` is empty). Lying level (`levelAt`
# millimetres above its storey, -1 upright), it is a floor or ceiling.
class:
    patterns:
        [a|] bim system type record
    members:
        name as a string
        group as a string
        frameMaterial as a string
        bayWidth as a 64 bit floating-point number
        rowHeight as a 64 bit floating-point number
        pattern as an integer
        jointWide as an integer
        jointDeep as an integer
        celled as a boolean
        panelName as a string
        panelMaterial as a string
        panelThickness as a 64 bit floating-point number
        levelAt as an integer
        layers as the type of (a cad topology list of a bim system type layer record)

local function the bim system recipe named {a string:typeName} in {a string:groupName} of {a string:frameName} bays {a 64 bit floating-point number:bayValue} by {a 64 bit floating-point number:rowValue} patterned {integer:patternCode} joints {integer:wide} by {integer:deep} celled {boolean:withCells} panels {a string:panelTypeName} of {a string:panelMaterialName} {a 64 bit floating-point number:thickness} level at {integer:levelValue}:
    execute:
        return @intrinsic("construct", a bim system type record, typeName, groupName, frameName, bayValue, rowValue, patternCode, wide, deep, withCells, panelTypeName, panelMaterialName, thickness, levelValue, a cad topology list of a bim system type layer record)

local function the bim layer recipe at {integer:offsetValue} bays {a 64 bit floating-point number:bayValue} by {a 64 bit floating-point number:rowValue} joints {integer:wide} by {integer:deep} celled {boolean:withCells} panels {a string:panelTypeName} of {a string:panelMaterialName} {a 64 bit floating-point number:thickness}:
    execute:
        return @intrinsic("construct", a bim system type layer record, offsetValue, bayValue, rowValue, wide, deep, withCells, panelTypeName, panelMaterialName, thickness)

# The library, by group. Sizes are the Dutch standard ones: masonry
# formats with a 10 mm joint (waal 210 x 100 x 50, dik 210 x 100 x 65),
# sand-lime elements 897 x 643 glued, zinc trays at 430 mm, curtain walls
# in 1500 mm bays, hollow-core planks 1200 mm wide, 150 to 400 mm deep.
function the bim system types:
    execute:
        set made to an empty list of a bim system type record
        set noPanel to the string form of ""
        # Curtain walls (vliesgevels).
        append (the bim system recipe named (the string form of "Vliesgevel aluminium 1500") in (the string form of "Vliesgevel") of (the string form of "aluminium") bays 1.5 by 1.8 patterned (bim grid pattern) joints 50 by 150 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Vliesgevel structural glazing") in (the string form of "Vliesgevel") of (the string form of "aluminium") bays 1.5 by 3.0 patterned (bim grid pattern) joints 20 by 180 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Vliesgevel hout-aluminium 1200") in (the string form of "Vliesgevel") of (the string form of "timber") bays 1.2 by 1.5 patterned (bim grid pattern) joints 60 by 160 celled true panels noPanel of noPanel 0.0 level at -1) to made
        # Window frames (kozijnen): their profiles as joints, glass between.
        append (the bim system recipe named (the string form of "Kozijn hout 67x114") in (the string form of "Kozijn") of (the string form of "timber") bays 0.9 by 1.2 patterned (bim grid pattern) joints 67 by 114 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Kozijn aluminium 75") in (the string form of "Kozijn") of (the string form of "aluminium") bays 1.0 by 1.4 patterned (bim grid pattern) joints 50 by 75 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Kozijn kunststof 70") in (the string form of "Kozijn") of (the string form of "pvc") bays 1.0 by 1.4 patterned (bim grid pattern) joints 64 by 70 celled true panels noPanel of noPanel 0.0 level at -1) to made
        # Timber frame (HSB): studs at 600 with insulation, boards as layers.
        set timberFrame to the bim system recipe named (the string form of "HSB wand 38x140 h.o.h. 600") in (the string form of "HSB") of (the string form of "timber") bays 0.6 by 3.0 patterned (bim grid pattern) joints 38 by 140 celled true panels (the string form of "Isolatie 140") of (the string form of "mineral wool") 0.14 level at -1
        append (the bim layer recipe at 79 bays 1.2 by 3.0 joints 0 by 18 celled true panels (the string form of "OSB 18") of (the string form of "osb") 0.018) to (timberFrame's layers's values)
        append (the bim layer recipe at -76 bays 1.2 by 3.0 joints 0 by 13 celled true panels (the string form of "Gipsplaat 12.5") of (the string form of "gypsum") 0.0125) to (timberFrame's layers's values)
        append timberFrame to made
        set timberFrameWide to the bim system recipe named (the string form of "HSB wand 38x184 h.o.h. 600") in (the string form of "HSB") of (the string form of "timber") bays 0.6 by 3.0 patterned (bim grid pattern) joints 38 by 184 celled true panels (the string form of "Isolatie 184") of (the string form of "mineral wool") 0.184 level at -1
        append (the bim layer recipe at 101 bays 1.2 by 3.0 joints 0 by 18 celled true panels (the string form of "OSB 18") of (the string form of "osb") 0.018) to (timberFrameWide's layers's values)
        append (the bim layer recipe at -98 bays 1.2 by 3.0 joints 0 by 13 celled true panels (the string form of "Gipsplaat 12.5") of (the string form of "gypsum") 0.0125) to (timberFrameWide's layers's values)
        append timberFrameWide to made
        # Masonry (metselwerk): bricks as panels, the mortar as joints set
        # back 5 mm from either face, so that they show.
        append (the bim system recipe named (the string form of "Metselwerk waalformaat halfsteens") in (the string form of "Metselwerk") of (the string form of "mortar") bays 0.22 by 0.0625 patterned (bim running bond pattern) joints 10 by 90 celled true panels (the string form of "Baksteen waalformaat 100") of (the string form of "brick") 0.1 level at -1) to made
        append (the bim system recipe named (the string form of "Metselwerk dikformaat halfsteens") in (the string form of "Metselwerk") of (the string form of "mortar") bays 0.22 by 0.075 patterned (bim running bond pattern) joints 10 by 90 celled true panels (the string form of "Baksteen dikformaat 100") of (the string form of "brick") 0.1 level at -1) to made
        append (the bim system recipe named (the string form of "Metselwerk waalformaat stapelverband") in (the string form of "Metselwerk") of (the string form of "mortar") bays 0.22 by 0.0625 patterned (bim grid pattern) joints 10 by 90 celled true panels (the string form of "Baksteen waalformaat 100") of (the string form of "brick") 0.1 level at -1) to made
        append (the bim system recipe named (the string form of "Kalkzandsteen elementen 100") in (the string form of "Metselwerk") of (the string form of "glue") bays 0.9 by 0.6465 patterned (bim running bond pattern) joints 3 by 100 celled true panels (the string form of "Kalkzandsteen 100") of (the string form of "sand-lime") 0.1 level at -1) to made
        # Metal and panel cladding.
        append (the bim system recipe named (the string form of "Zinken felsgevel 430") in (the string form of "Gevelbekleding") of (the string form of "zinc") bays 0.43 by 6.0 patterned (bim grid pattern) joints 6 by 40 celled true panels (the string form of "Zink 0.8") of (the string form of "zinc") 0.008 level at -1) to made
        append (the bim system recipe named (the string form of "Houten rabatdelen 140") in (the string form of "Gevelbekleding") of (the string form of "timber") bays 4.0 by 0.14 patterned (bim running bond pattern) joints 4 by 12 celled true panels (the string form of "Vuren 18") of (the string form of "timber") 0.018 level at -1) to made
        append (the bim system recipe named (the string form of "Gevelplaten HPL 1200x3000") in (the string form of "Gevelbekleding") of (the string form of "aluminium") bays 1.2 by 3.0 patterned (bim grid pattern) joints 8 by 4 celled true panels (the string form of "HPL 8") of (the string form of "hpl") 0.008 level at -1) to made
        # Floors and ceilings lying level.
        # Hollow-core floors in every common depth (150 to 400 mm), planks
        # 1200 mm wide with 20 mm grouted joints.
        loop depthCursor from 0 to 5:
            set plankDepth to 150
            if depthCursor = 1:
                set plankDepth to 200
            if depthCursor = 2:
                set plankDepth to 260
            if depthCursor = 3:
                set plankDepth to 320
            if depthCursor = 4:
                set plankDepth to 400
            set depthText to the string form of plankDepth
            append (the bim system recipe named ((the string form of "Kanaalplaatvloer ") + depthText) in (the string form of "Vloer") of (the string form of "grout") bays 1.2 by 6.0 patterned (bim grid pattern) joints 20 by plankDepth celled true panels ((the string form of "Kanaalplaat ") + depthText) of (the string form of "concrete") ((plankDepth as a 64 bit floating-point number) / 1000.0) level at 3000) to made
        append (the bim system recipe named (the string form of "Systeemplafond 600x600") in (the string form of "Plafond") of (the string form of "steel") bays 0.6 by 0.6 patterned (bim grid pattern) joints 24 by 38 celled true panels (the string form of "Plafondplaat 15") of (the string form of "mineral fibre") 0.015 level at 2600) to made
        # Append-only: persisted recipe indices 0..20 keep their identities.
        append (the bim system recipe named (the string form of "Fixed timber 67x114") in (the string form of "Window frames") of (the string form of "timber") bays 1000.0 by 1000.0 patterned (bim grid pattern) joints 67 by 114 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Fixed aluminium 50x75") in (the string form of "Window frames") of (the string form of "aluminium") bays 1000.0 by 1000.0 patterned (bim grid pattern) joints 50 by 75 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Fixed PVC 64x70") in (the string form of "Window frames") of (the string form of "pvc") bays 1000.0 by 1000.0 patterned (bim grid pattern) joints 64 by 70 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Casement timber layout") in (the string form of "Window frames") of (the string form of "timber") bays 1000.0 by 1000.0 patterned (bim grid pattern) joints 67 by 114 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Tilt-turn PVC layout") in (the string form of "Window frames") of (the string form of "pvc") bays 1000.0 by 1000.0 patterned (bim grid pattern) joints 64 by 70 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Double casement timber layout") in (the string form of "Window frames") of (the string form of "timber") bays 0.9 by 1000.0 patterned (bim grid pattern) joints 67 by 114 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Timber window with transom") in (the string form of "Window frames") of (the string form of "timber") bays 1000.0 by 0.9 patterned (bim grid pattern) joints 67 by 114 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Timber door leaf") in (the string form of "Window frames") of (the string form of "timber") bays 1000.0 by 1000.0 patterned (bim grid pattern) joints 67 by 114 celled true panels (the string form of "Timber door panel 40") of (the string form of "timber") 0.04 level at -1) to made
        append (the bim system recipe named (the string form of "Timber door with sidelight") in (the string form of "Window frames") of (the string form of "timber") bays 0.9 by 1000.0 patterned (bim grid pattern) joints 67 by 114 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Double glazed timber doors") in (the string form of "Window frames") of (the string form of "timber") bays 0.9 by 1000.0 patterned (bim grid pattern) joints 67 by 114 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Two-panel sliding aluminium layout") in (the string form of "Window frames") of (the string form of "aluminium") bays 0.9 by 1000.0 patterned (bim grid pattern) joints 50 by 100 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Three-panel sliding aluminium layout") in (the string form of "Window frames") of (the string form of "aluminium") bays 0.9 by 1000.0 patterned (bim grid pattern) joints 50 by 100 celled true panels noPanel of noPanel 0.0 level at -1) to made
        # Append-only window layouts. See WINDOW-SYSTEMS.md for source and limits.
        append (the bim system recipe named (the string form of "Fixed timber 90x139") in (the string form of "Window frames") of (the string form of "timber") bays 1000.0 by 1000.0 patterned (bim grid pattern) joints 90 by 139 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Double casement timber 90x139 layout") in (the string form of "Window frames") of (the string form of "timber") bays 1000.0 by 1000.0 patterned (bim grid pattern) joints 90 by 139 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Timber 90x139 with transom") in (the string form of "Window frames") of (the string form of "timber") bays 1000.0 by 1000.0 patterned (bim grid pattern) joints 90 by 139 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Timber sliding door 67x174 layout") in (the string form of "Window frames") of (the string form of "timber") bays 1000.0 by 1000.0 patterned (bim grid pattern) joints 67 by 174 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Reynaers ConceptPatio 130 - 2 rail layout") in (the string form of "Window frames") of (the string form of "aluminium") bays 1000.0 by 1000.0 patterned (bim grid pattern) joints 50 by 130 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Reynaers ConceptPatio 130 - 3 rail layout") in (the string form of "Window frames") of (the string form of "aluminium") bays 1000.0 by 1000.0 patterned (bim grid pattern) joints 50 by 210 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Reynaers MasterPatio - 2 rail layout") in (the string form of "Window frames") of (the string form of "aluminium") bays 1000.0 by 1000.0 patterned (bim grid pattern) joints 50 by 180 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Reynaers MasterPatio - 3 rail layout") in (the string form of "Window frames") of (the string form of "aluminium") bays 1000.0 by 1000.0 patterned (bim grid pattern) joints 50 by 283 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Reynaers SlimPatio 68 - 2 rail layout") in (the string form of "Window frames") of (the string form of "aluminium") bays 1000.0 by 1000.0 patterned (bim grid pattern) joints 34 by 120 celled true panels noPanel of noPanel 0.0 level at -1) to made
        append (the bim system recipe named (the string form of "Reynaers SlimPatio 68 - 3 rail layout") in (the string form of "Window frames") of (the string form of "aluminium") bays 1000.0 by 1000.0 patterned (bim grid pattern) joints 34 by 176 celled true panels noPanel of noPanel 0.0 level at -1) to made
        return made


function bim window recipe {integer:typeIndex} has two columns:
    execute:
        return (((typeIndex = 26) or (typeIndex = 29)) or ((typeIndex = 30) or (typeIndex = 31))) or (((typeIndex = 34) or (typeIndex = 36)) or (((typeIndex = 37) or (typeIndex = 39)) or (typeIndex = 41)))

function bim window recipe {integer:typeIndex} has three columns:
    execute:
        return ((typeIndex = 32) or (typeIndex = 38)) or ((typeIndex = 40) or (typeIndex = 42))

# The planar type of a type's panels (or a layer's): found or added; the
# refused id for glass.
local function the bim recipe panel type named {a string:typeName} of {a string:materialName} {a 64 bit floating-point number:thickness} in {a pointer to a bim model record:target}:
    execute:
        if (the length of typeName) = 0:
            return the bim refused id
        return the bim example type named typeName of materialName thickness in target

# Building system `systemId` given the type at `typeIndex` of `the bim
# system types`: its material, bays and rows, pattern, joints and panels;
# the layers an earlier type added removed, the type's own added. False for
# no such system or type.
function give bim system {a 64 bit integer:systemId} type {integer:typeIndex} in {a pointer to a bim model record:target}:
    execute:
        set library to the bim system types
        if (typeIndex < 0) or (typeIndex >= (the length of library)):
            free library
            return false
        set found to the bim curtain index of systemId in (@intrinsic("dereference", target))
        if found's valid = false:
            free library
            return false
        set chosen to the item at typeIndex in library
        free library
        set systemValue to the item at found's position in (target's curtains's values)
        set systemValue's material to chosen's frameMaterial
        set systemValue's bayWidth to chosen's bayWidth
        set systemValue's rowHeight to chosen's rowHeight
        if (typeIndex >= 21) and (typeIndex <= 42):
            set clearance to the bim setting (bim window clearance setting) of systemId in (@intrinsic("dereference", target))
            set hosting to the bim setting (bim host opening setting) of systemId in (@intrinsic("dereference", target))
            if clearance's found and hosting's found:
                set axisInset to clearance's value + (((chosen's jointWide + 1) / 2) as a 64 bit integer)
                set bim setting (bim host joint setting) of systemId to axisInset keeping true in target
            set bound to the bim system systemValue hosted in its opening in (@intrinsic("dereference", target))
            set extent to the cad distance from systemValue's start to systemValue's finish
            set rise to systemValue's height
            if bound's valid:
                set extent to the cad distance from bound's curtain's start to bound's curtain's finish
                set rise to bound's curtain's height
            set columns to 1
            set rows to 1
            if bim window recipe typeIndex has two columns:
                set columns to 2
            if bim window recipe typeIndex has three columns:
                set columns to 3
            if (typeIndex = 27) or (typeIndex = 35):
                set rows to 2
            set systemValue's bayWidth to (extent + 0.000001) / (columns as a 64 bit floating-point number)
            set systemValue's rowHeight to (rise + 0.000001) / (rows as a 64 bit floating-point number)
            # Operation intent is explicit metadata; hardware is not modelled.
            set bim property (the string form of "Layout") of set (the string form of "OpenBIM_Window") of systemId to chosen's name typed (the string form of "IfcLabel") in target
            set bim property (the string form of "DetailStatus") of set (the string form of "OpenBIM_Window") of systemId to (the string form of "Nominal frame and sash profiles; generic glazing beads and seals; offset sliding tracks; supplier-specific sections and hardware not modelled") typed (the string form of "IfcText") in target
        set manufacturer to the string form of "Generic"
        set source to the string form of ""
        if (typeIndex >= 37) and (typeIndex <= 42):
            set manufacturer to the string form of "Reynaers Aluminium"
            set source to the string form of "https://www.reynaersathome.co.uk/wp-content/uploads/2026/01/REY20243-Contemporary-Brochure_Print_AW-Edited-JAN-26.pdf"
            if typeIndex >= 41:
                set source to the string form of "https://www.reynaers.com.au/sites/default/files/public/2023-01/reynaers-aluminium-product-overview-en.pdf"
        set bim property (the string form of "Manufacturer") of set (the string form of "OpenBIM_Window") of systemId to manufacturer typed (the string form of "IfcLabel") in target
        set bim property (the string form of "SourceURL") of set (the string form of "OpenBIM_Window") of systemId to source typed (the string form of "IfcText") in target
        replace item at index found's position in (target's curtains's values) with systemValue
        shape bim example system systemId patterned chosen's pattern joints chosen's jointWide by chosen's jointDeep celled chosen's celled of type (the bim recipe panel type named chosen's panelName of chosen's panelMaterial chosen's panelThickness in target) in target
        if chosen's panelName = (the string form of ""):
            set bim setting (bim panel type setting) of systemId to (0 as a 64 bit integer) keeping false in target
        if typeIndex = 29:
            set doorPanel to the bim recipe panel type named (the string form of "Timber door panel 40") of (the string form of "timber") 0.04 in target
            set bim setting ((bim panel type setting) + 1) of systemId to doorPanel keeping true in target
        else:
            set bim setting ((bim panel type setting) + 1) of systemId to (0 as a 64 bit integer) keeping false in target
        set bim setting (bim system level setting) of systemId to (chosen's levelAt as a 64 bit integer) keeping (chosen's levelAt >= 0) in target
        # The layers of an earlier type go; this type's come.
        set doomed to an empty list of a 64 bit integer
        loop cursor from 0 to the length of (target's curtains's values):
            set candidate to the item at cursor in (target's curtains's values)
            set hostReading to the bim setting (bim layer host setting) of candidate's id in (@intrinsic("dereference", target))
            if hostReading's found:
                if hostReading's value = systemId:
                    append candidate's id to doomed
        loop cursor from 0 to the length of doomed:
            ignore delete bim curtain wall (the item at cursor in doomed) from target
        free doomed
        loop layerCursor from 0 to the length of (chosen's layers's values):
            set layerRecipe to the item at layerCursor in (chosen's layers's values)
            set layerId to add bim layer to system systemId offset (layerRecipe's offset as a 64 bit integer) in target
            if layerId != the bim refused id:
                grid bim example system layerId in bays of layerRecipe's bayWidth by layerRecipe's rowHeight in target
                shape bim example system layerId patterned (bim grid pattern) joints layerRecipe's jointWide by layerRecipe's jointDeep celled layerRecipe's celled of type (the bim recipe panel type named layerRecipe's panelName of layerRecipe's panelMaterial layerRecipe's panelThickness in target) in target
        set bim setting (bim system type setting) of systemId to ((typeIndex + 1) as a 64 bit integer) keeping true in target
        note bim change of systemId in target
        return true

# Whether building system `systemValue` still has what its type gives (its
# material, bays, rows, pattern and joints); false once it was changed on
# its own (a custom system), or when it has no type.
function bim system {bim curtain record:systemValue} follows its type in {bim model record:modelValue}:
    execute:
        set typeIndex to the bim system type index of systemValue's id in modelValue
        set library to the bim system types
        if (typeIndex < 0) or (typeIndex >= (the length of library)):
            free library
            return false
        set chosen to the item at typeIndex in library
        free library
        set expectedBay to chosen's bayWidth
        set expectedRow to chosen's rowHeight
        if (typeIndex >= 21) and (typeIndex <= 42):
            set placed to the bim placed system systemValue in modelValue
            set extent to the cad distance from placed's curtain's start to placed's curtain's finish
            set columns to 1
            set rows to 1
            if bim window recipe typeIndex has two columns:
                set columns to 2
            if bim window recipe typeIndex has three columns:
                set columns to 3
            if (typeIndex = 27) or (typeIndex = 35):
                set rows to 2
            set expectedBay to (extent + 0.000001) / (columns as a 64 bit floating-point number)
            set expectedRow to (placed's curtain's height + 0.000001) / (rows as a 64 bit floating-point number)
        set same to (systemValue's material = chosen's frameMaterial) and ((the absolute value of (systemValue's bayWidth - expectedBay)) < 0.0005)
        set same to same and ((the absolute value of (systemValue's rowHeight - expectedRow)) < 0.0005)
        set same to same and ((the bim pattern of system systemValue's id in modelValue) = chosen's pattern)
        set same to same and ((the absolute value of ((the bim joint width of system systemValue's id in modelValue) - ((chosen's jointWide as a 64 bit floating-point number) / 1000.0))) < 0.0005)
        set same to same and ((the absolute value of ((the bim joint depth of system systemValue's id in modelValue) - ((chosen's jointDeep as a 64 bit floating-point number) / 1000.0))) < 0.0005)
        return same

# The name building system `systemValue`'s type shows: the type's, with
# "(custom)" once the system differs from it; "Custom" without a type.
function the bim system type name of {bim curtain record:systemValue} in {bim model record:modelValue}:
    execute:
        set typeIndex to the bim system type index of systemValue's id in modelValue
        set library to the bim system types
        if (typeIndex < 0) or (typeIndex >= (the length of library)):
            free library
            return the string form of "Custom"
        set shownName to (the item at typeIndex in library)'s name
        free library
        if (bim system systemValue follows its type in modelValue) = false:
            set shownName to shownName + (the string form of " (custom)")
        return shownName

# Every type of the library side by side from `origin` on storey
# `levelId`, 3 m long and 2.7 m high each (floors and ceilings 3 by 3 m),
# 1 m apart, to look at and compare. The ids made.
function add bim system type gallery at {cad vector2:origin} on {a 64 bit integer:levelId} in {a pointer to a bim model record:target}:
    execute:
        set made to a cad topology list of a 64 bit integer
        set library to the bim system types
        set placeX to origin's x
        loop typeCursor from 0 to the length of library:
            set chosen to the item at typeCursor in library
            set systemHeight to 2.7
            if chosen's levelAt >= 0:
                set systemHeight to 3.0
            set systemId to add bim curtain wall on levelId from (a cad vector2 with x placeX and y origin's y) to (a cad vector2 with x (placeX + 3.0) and y origin's y) rising systemHeight in bays of 1.2 by 1.5 of (the string form of "steel") to target
            if systemId != the bim refused id:
                ignore give bim system systemId type typeCursor in target
                append systemId to (made's values)
            set placeX to placeX + 4.0
        free library
        return made
