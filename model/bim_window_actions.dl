# The same hosted-system creation path is used by the GUI property action
# and automation. Existing windows are selected, never duplicated/retyped.
import model/bim_system_types.dl

function the bim window system in opening {a 64 bit integer:openingId} in {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's curtains's values):
            set candidate to the item at cursor in (modelValue's curtains's values)
            set hosting to the bim setting (bim host opening setting) of candidate's id in modelValue
            if hosting's found and (hosting's value = openingId):
                return candidate's id
        return the bim refused id

function ensure bim window system in opening {a 64 bit integer:openingId} typed {integer:recipeIndex} with joint {a 64 bit integer:jointMillimetres} in {a pointer to a bim model record:target}:
    execute:
        set existingId to the bim window system in opening openingId in (@intrinsic("dereference", target))
        if existingId != the bim refused id:
            return existingId
        if ((recipeIndex < 21) or (recipeIndex > 42)) or (jointMillimetres < (0 as a 64 bit integer)):
            return the bim refused id
        set library to the bim system types
        set recipe to the item at recipeIndex in library
        free library
        set axisInset to jointMillimetres + (((recipe's jointWide + 1) / 2) as a 64 bit integer)
        set made to add bim system in opening openingId with joint axisInset in bays of 1.0 by 1.0 of recipe's frameMaterial to target
        if made = the bim refused id:
            return made
        set bim setting (bim window clearance setting) of made to jointMillimetres keeping true in target
        ignore give bim system made type recipeIndex in target
        return made
