# SPDX-License-Identifier: MPL-2.0
# Parallel offsets of concave height profiles. A support-line envelope
# miters the inner ridge without folding short segments through each other.
import model/bim_model.dl

function the bim parallel roof profile of {a pointer to a list:points} offset {a 64 bit floating-point number:offsetValue}:
    execute:
        set result to an empty list of a cad vector2
        set lines to an empty list of a cad vector2
        set starts to an empty list of a 64 bit floating-point number
        set previousSlope to 1e100
        set firstSlope to 0.0
        set lastSlope to 0.0
        set valid to true
        loop cursor from 1 to the length of points:
            set first to the item at (cursor - 1) in points
            set last to the item at cursor in points
            set slope to (last's y - first's y) / (last's x - first's x)
            if slope > (previousSlope + 0.0001):
                set valid to false
            set previousSlope to slope
            if cursor = 1:
                set firstSlope to slope
            set lastSlope to slope
            set intercept to (first's y - (slope * first's x)) + (offsetValue * (the square root of (1.0 + (slope * slope))))
            set active to true
            set searching to true
            set entering to -1e100
            loop while ((the length of lines) > 0) and searching:
                set past to (the length of lines) - 1
                set previous to the item at past in lines
                set difference to previous's x - slope
                if (the absolute value of difference) < 0.0001:
                    if intercept >= previous's y:
                        set active to false
                        set searching to false
                    else:
                        remove item past from lines
                        remove item past from starts
                else:
                    set entering to (intercept - previous's y) / difference
                    if entering <= (the item at past in starts):
                        remove item past from lines
                        remove item past from starts
                    else:
                        set searching to false
            if active:
                if (the length of lines) = 0:
                    set entering to -1e100
                append (a cad vector2 with x slope and y intercept) to lines
                append entering to starts
        if valid and ((the length of lines) > 0):
            set first to the item at 0 in points
            set last to the item at ((the length of points) - 1) in points
            set low to first's x - ((firstSlope / (the square root of (1.0 + (firstSlope * firstSlope)))) * offsetValue)
            set high to last's x - ((lastSlope / (the square root of (1.0 + (lastSlope * lastSlope)))) * offsetValue)
            if high > (low + 0.00001):
                set activeLine to 0
                loop cursor from 0 to the length of points:
                    set fraction to ((the item at cursor in points)'s x - first's x) / (last's x - first's x)
                    set xValue to low + ((high - low) * fraction)
                    set advancing to true
                    loop while ((activeLine + 1) < (the length of lines)) and advancing:
                        if (the item at (activeLine + 1) in starts) > xValue:
                            set advancing to false
                        else:
                            set activeLine to activeLine + 1
                    set lineValue to the item at activeLine in lines
                    append (a cad vector2 with x xValue and y ((lineValue's x * xValue) + lineValue's y)) to result
        free lines
        free starts
        return result
