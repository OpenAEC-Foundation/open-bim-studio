# SPDX-License-Identifier: MPL-2.0
# A view's dimension values lettered together, so that no value stands over
# another, over a dimension or extension line, or over what the view shows
# around its dimensions (room labels, level and elevation marks, grid
# heads: the labels and kept boxes on the canvas). Each value takes the
# first place that is clear, in this order:
#
# - between its extension lines, centred, else slid along the segment;
# - the same a row further out (staggered to the outer side of the chain);
# - beside the line past its end, else before its start, on the line's
#   reading side, then in the outer row;
# - further out on the outer side, over the segment's middle or moved
#   along, with a leader to the line's middle;
# - on the line's own row further past the end or before the start, one
#   or two widths on (after the values of neighbouring short steps);
# - on the inner side with a leader, one or two rows in.
#
# Values that fit their segment go first, so that a value moved out of a
# short segment never takes the place of one that fits; then places whose
# leaders cross no line; last leaders that cross extension lines. Two
# leaders never cross. Neighbouring values keep a millimetre clear of each
# other along their lines and two millimetres across them where they
# overlap along, and two values of one line a millimetre along it in
# whatever rows they stand, so that two values never read as one number,
# neither side by side ('895 2100') nor stacked ('240' over '1460'), and
# the values of one line stand in the order of their segments. Last, a
# value moved beside its segment next to the value of a neighbouring
# segment, in its row, gets a text height clear of it where that value can
# slide along its own segment to leave it. Every value, on a leader
# too, stands at least a millimetre nearer its own line than any other
# dimension line it lies beside, a leader crossing none of those and
# rising off its line at least one in three, so that no value reads as a
# neighbouring chain's.
import viewer/bim_canvas.dl

# A dimension's value waiting to be lettered: `message` along the line from
# `first` to `last` (canvas units), `outward` the unit direction away from
# what the dimension measures (zero when it measures along its own line).
class:
    patterns:
        [a|] bim dimension value record
    members:
        message as a string
        first as a cad vector2
        last as a cad vector2
        outward as a cad vector2

function a bim dimension value {a string:message} between {cad vector2:first} and {cad vector2:last} outward {cad vector2:side}:
    execute:
        return @intrinsic("construct", a bim dimension value record, message, first, last, side)

# A place a value may take: where it would be lettered, with a leader from
# `leaderFrom` on the dimension line to `leaderTo` by the lettering when
# `leader`; `early` when it is tried in the first round, for values that fit.
class:
    patterns:
        [a|] bim dimension candidate record
    members:
        placed as a bim dimension lettering record
        leader as a boolean
        leaderFrom as a cad vector2
        leaderTo as a cad vector2
        early as a boolean

local function the bim dimension candidate {bim dimension lettering record:proposed} early {boolean:firstRound}:
    execute:
        set nowhere to a cad vector2 with x 0.0 and y 0.0
        return @intrinsic("construct", a bim dimension candidate record, proposed, false, nowhere, nowhere, firstRound)

# How many rows of lettering a value may stand off its line with a leader.
local function the bim dimension leader rows:
    replacement:
        7

# Appends the places `pending` may take to `candidates`, in the order they
# are tried.
local function append bim dimension candidates of {bim dimension value record:pending} into {a pointer to a list:candidates} on {bim canvas record:canvas}:
    execute:
        set unit to the bim symbol scale of canvas
        set message to pending's message
        set first to pending's first
        set last to pending's last
        set fitting to bim dimension text message fits between first and last on canvas
        set slack to ((the cad distance from first to last) - ((the bim dimension text width of message on canvas) + (8.0 * unit))) * 0.5
        set textTurn to the bim readable text angle from first to last
        set upX to the sine of textTurn
        set upY to 0.0 - (the cosine of textTurn)
        # The outer row: further out on the reading side when that side is
        # the outer one (or the line has none), else the first row on the
        # other side.
        set staggerRow to 1
        set rowStep to 1
        if ((pending's outward's x * upX) + (pending's outward's y * upY)) < -0.000001:
            set staggerRow to -1
            set rowStep to -1
        if fitting:
            loop rowCursor from 0 to 2:
                set rowNumber to 0
                if rowCursor = 1:
                    set rowNumber to staggerRow
                loop slideCursor from 0 to 5:
                    set slide to 0.0
                    if slideCursor = 1:
                        set slide to slack * 0.5
                    if slideCursor = 2:
                        set slide to 0.0 - (slack * 0.5)
                    if slideCursor = 3:
                        set slide to slack
                    if slideCursor = 4:
                        set slide to 0.0 - slack
                    append (the bim dimension candidate (the bim dimension text place of message between first and last at (bim dimension text inside) shifted slide in row rowNumber on canvas) early (rowNumber = 0)) to candidates
        loop rowCursor from 0 to 2:
            set rowNumber to 0
            if rowCursor = 1:
                set rowNumber to staggerRow
            append (the bim dimension candidate (the bim dimension text place of message between first and last at (bim dimension text past the end) shifted 0.0 in row rowNumber on canvas) early false) to candidates
            append (the bim dimension candidate (the bim dimension text place of message between first and last at (bim dimension text before the start) shifted 0.0 in row rowNumber on canvas) early false) to candidates
        # In the rows beyond the outer row, over the segment's middle or
        # moved along by one or two of its widths and a millimetre either
        # way, a leader from the line's middle to a symbol unit short of the
        # lettering.
        set lineMiddle to a cad vector2 with x ((first's x + last's x) * 0.5) and y ((first's y + last's y) * 0.5)
        set letterSize to the bim lettering size of canvas
        set leaderStep to (the bim dimension text width of message on canvas) + (4.0 * unit)
        loop leaderCursor from 1 to ((the bim dimension leader rows) + 1):
            set rowNumber to staggerRow + (rowStep * leaderCursor)
            loop stepCursor from 0 to 5:
                set leaderSlide to leaderStep * (((stepCursor + 1) / 2) as a 64 bit floating-point number)
                if (the remainder of stepCursor divided by 2) = 0:
                    set leaderSlide to 0.0 - leaderSlide
                set leaderPlace to the bim dimension text place of message between first and last at (bim dimension text inside) shifted leaderSlide in row rowNumber on canvas
                set nearRise to 0.0 - (((the bim lettering depth of message) * letterSize) + unit)
                if rowNumber < 0:
                    set nearRise to ((the bim lettering top) * letterSize) + unit
                set offered to the bim dimension candidate leaderPlace early false
                set offered's leader to true
                set offered's leaderFrom to lineMiddle
                set offered's leaderTo to a cad vector2 with x (leaderPlace's spot's x + (upX * nearRise)) and y (leaderPlace's spot's y + (upY * nearRise))
                append offered to candidates
        # Further past the end or before the start on the line's own row, a
        # value's width and a millimetre at a time: values written one after
        # another beside a cluster of short steps, in their segments' order.
        set sequenceStep to (the bim dimension text width of message on canvas) + (4.0 * unit)
        loop sequenceCursor from 1 to 3:
            set sequenceSlide to sequenceStep * (sequenceCursor as a 64 bit floating-point number)
            append (the bim dimension candidate (the bim dimension text place of message between first and last at (bim dimension text past the end) shifted sequenceSlide in row 0 on canvas) early false) to candidates
            append (the bim dimension candidate (the bim dimension text place of message between first and last at (bim dimension text before the start) shifted (0.0 - sequenceSlide) in row 0 on canvas) early false) to candidates
        # The same on the inner side, one or two rows in (no further, where
        # the building may stand), when the outer side is taken.
        loop innerCursor from 1 to 3:
            set rowNumber to (0 - rowStep) * innerCursor
            loop stepCursor from 0 to 5:
                set leaderSlide to leaderStep * (((stepCursor + 1) / 2) as a 64 bit floating-point number)
                if (the remainder of stepCursor divided by 2) = 0:
                    set leaderSlide to 0.0 - leaderSlide
                set leaderPlace to the bim dimension text place of message between first and last at (bim dimension text inside) shifted leaderSlide in row rowNumber on canvas
                set nearRise to 0.0 - (((the bim lettering depth of message) * letterSize) + unit)
                if rowNumber < 0:
                    set nearRise to ((the bim lettering top) * letterSize) + unit
                set offered to the bim dimension candidate leaderPlace early false
                set offered's leader to true
                set offered's leaderFrom to lineMiddle
                set offered's leaderTo to a cad vector2 with x (leaderPlace's spot's x + (upX * nearRise)) and y (leaderPlace's spot's y + (upY * nearRise))
                append offered to candidates

# The least gap, in symbol units (a quarter of a paper millimetre), between
# two values along their lines (1 mm), and across them where they overlap
# along (2 mm, more than the half millimetre between two rows, so that no
# value stands stacked over another).
local function the bim dimension value gap along:
    replacement:
        4.0
local function the bim dimension value gap across:
    replacement:
        8.0

# The least gap, in symbol units, between a value moved beside its segment
# and the value of a neighbouring segment of its line that stands in its
# own: a text height (2.5 mm), more than a word space, so that the two do
# not read as one string ('895 2100'). A value that fits its segment slides
# along it to leave this gap where it can (`letter bim dimension values`).
local function the bim dimension value gap in line:
    replacement:
        10.0

# How far `measuredSpot` stands along the line of `pending`, from its first
# end toward its last, in canvas units.
local function the bim dimension distance of {cad vector2:measuredSpot} along the line of {bim dimension value record:pending}:
    execute:
        set lineLength to the cad distance from pending's first to pending's last
        if lineLength <= 1e-9:
            return 0.0
        return (((measuredSpot's x - pending's first's x) * (pending's last's x - pending's first's x)) + ((measuredSpot's y - pending's first's y) * (pending's last's y - pending's first's y))) / lineLength

# Whether the dimension line from `otherFirst` to `otherLast` lies on the
# line of `pending`: parallel to it and less than half a symbol unit off.
local function bim dimension line from {cad vector2:otherFirst} to {cad vector2:otherLast} lies on the line of {bim dimension value record:pending} on {bim canvas record:canvas}:
    execute:
        set unit to the bim symbol scale of canvas
        set lineLength to the cad distance from pending's first to pending's last
        set otherLength to the cad distance from otherFirst to otherLast
        if (lineLength <= 1e-9) or (otherLength <= 1e-9):
            return false
        set dirX to (pending's last's x - pending's first's x) / lineLength
        set dirY to (pending's last's y - pending's first's y) / lineLength
        set otherTurn to (((otherLast's x - otherFirst's x) * dirY) - ((otherLast's y - otherFirst's y) * dirX)) / otherLength
        set otherAcross to ((otherFirst's x - pending's first's x) * dirY) - ((otherFirst's y - pending's first's y) * dirX)
        return ((the absolute value of otherTurn) < 0.01) and ((the absolute value of otherAcross) <= (0.5 * unit))

# How far apart along the line of `pending` the boxes `oneBox` and
# `otherBox` of two of its line's values stand (negative where they
# overlap along it), measured on the line's direction whatever way it runs.
local function the bim dimension gap between {bim lettering box record:oneBox} and {bim lettering box record:otherBox} along the line of {bim dimension value record:pending}:
    execute:
        set lineLength to the cad distance from pending's first to pending's last
        if lineLength <= 1e-9:
            return 0.0
        set dirX to (pending's last's x - pending's first's x) / lineLength
        set dirY to (pending's last's y - pending's first's y) / lineLength
        set oneReach to (oneBox's halfAlong * (the absolute value of (((the cosine of oneBox's angle) * dirX) + ((the sine of oneBox's angle) * dirY)))) + (oneBox's halfAcross * (the absolute value of (((the sine of oneBox's angle) * dirX) - ((the cosine of oneBox's angle) * dirY))))
        set otherReach to (otherBox's halfAlong * (the absolute value of (((the cosine of otherBox's angle) * dirX) + ((the sine of otherBox's angle) * dirY)))) + (otherBox's halfAcross * (the absolute value of (((the sine of otherBox's angle) * dirX) - ((the cosine of otherBox's angle) * dirY))))
        set centresApart to the absolute value of ((the bim dimension distance of oneBox's centre along the line of pending) - (the bim dimension distance of otherBox's centre along the line of pending))
        return centresApart - (oneReach + otherReach)

# How far apart across the line of `pending` the boxes `oneBox` and
# `otherBox` stand (negative where they overlap across it: where they stand
# in one row, so that side by side they would read as one string).
local function the bim dimension gap between {bim lettering box record:oneBox} and {bim lettering box record:otherBox} across the line of {bim dimension value record:pending}:
    execute:
        set lineLength to the cad distance from pending's first to pending's last
        if lineLength <= 1e-9:
            return 0.0
        set normalX to 0.0 - ((pending's last's y - pending's first's y) / lineLength)
        set normalY to (pending's last's x - pending's first's x) / lineLength
        set oneReach to (oneBox's halfAlong * (the absolute value of (((the cosine of oneBox's angle) * normalX) + ((the sine of oneBox's angle) * normalY)))) + (oneBox's halfAcross * (the absolute value of (((the sine of oneBox's angle) * normalX) - ((the cosine of oneBox's angle) * normalY))))
        set otherReach to (otherBox's halfAlong * (the absolute value of (((the cosine of otherBox's angle) * normalX) + ((the sine of otherBox's angle) * normalY)))) + (otherBox's halfAcross * (the absolute value of (((the sine of otherBox's angle) * normalX) - ((the cosine of otherBox's angle) * normalY))))
        set centresApart to the absolute value of (((oneBox's centre's x - otherBox's centre's x) * normalX) + ((oneBox's centre's y - otherBox's centre's y) * normalY))
        return centresApart - (oneReach + otherReach)

# Whether `trial`, a place of `pending`'s value, reads as a value of its own
# line among the stroke pairs `strokes`: beside every other dimension line
# it lies alongside (a stroke parallel to its line, off it, that it overlaps
# along) it stands at least a millimetre further off than off its own line,
# on a leader too (between two chains a value nearer the other line reads
# as that chain's, whatever leads to it). A leader crosses none of those
# lines and rises off its own at least one in three.
local function bim dimension candidate {bim dimension candidate record:trial} keeps to the line of {bim dimension value record:pending} among {a pointer to a list:strokes} on {bim canvas record:canvas}:
    execute:
        set unit to the bim symbol scale of canvas
        set lineFirst to pending's first
        set lineLast to pending's last
        set lineLength to the cad distance from lineFirst to lineLast
        if lineLength <= 1e-9:
            return true
        set dirX to (lineLast's x - lineFirst's x) / lineLength
        set dirY to (lineLast's y - lineFirst's y) / lineLength
        set placedBox to the bim lettering box of trial's placed on canvas
        set centreAlong to ((placedBox's centre's x - lineFirst's x) * dirX) + ((placedBox's centre's y - lineFirst's y) * dirY)
        set centreAcross to ((placedBox's centre's x - lineFirst's x) * dirY) - ((placedBox's centre's y - lineFirst's y) * dirX)
        set ownGap to (the absolute value of centreAcross) - placedBox's halfAcross
        set leaderFromAlong to ((trial's leaderFrom's x - lineFirst's x) * dirX) + ((trial's leaderFrom's y - lineFirst's y) * dirY)
        set leaderFromAcross to ((trial's leaderFrom's x - lineFirst's x) * dirY) - ((trial's leaderFrom's y - lineFirst's y) * dirX)
        set leaderToAlong to ((trial's leaderTo's x - lineFirst's x) * dirX) + ((trial's leaderTo's y - lineFirst's y) * dirY)
        set leaderToAcross to ((trial's leaderTo's x - lineFirst's x) * dirY) - ((trial's leaderTo's y - lineFirst's y) * dirX)
        set ownLineKept to true
        # A leader rises off its line at least one in three, so that it
        # never runs along it.
        if trial's leader:
            if ((the absolute value of (leaderToAcross - leaderFromAcross)) * 3.0) < (the absolute value of (leaderToAlong - leaderFromAlong)):
                set ownLineKept to false
        set pairCount to (the length of strokes) / 2
        loop pairCursor from 0 to pairCount:
            set strokeStart to the item at (pairCursor * 2) in strokes
            set strokeEnd to the item at ((pairCursor * 2) + 1) in strokes
            set strokeLength to the cad distance from strokeStart to strokeEnd
            if ownLineKept and (strokeLength > 1e-9):
                set strokeTurn to (((strokeEnd's x - strokeStart's x) * dirY) - ((strokeEnd's y - strokeStart's y) * dirX)) / strokeLength
                set strokeAcross to ((strokeStart's x - lineFirst's x) * dirY) - ((strokeStart's y - lineFirst's y) * dirX)
                if ((the absolute value of strokeTurn) < 0.01) and ((the absolute value of strokeAcross) > (0.5 * unit)):
                    set startAlong to ((strokeStart's x - lineFirst's x) * dirX) + ((strokeStart's y - lineFirst's y) * dirY)
                    set endAlong to ((strokeEnd's x - lineFirst's x) * dirX) + ((strokeEnd's y - lineFirst's y) * dirY)
                    set lowAlong to the minimum of startAlong and endAlong
                    set highAlong to the maximum of startAlong and endAlong
                    set otherGap to (the absolute value of (strokeAcross - centreAcross)) - placedBox's halfAcross
                    if (lowAlong < (centreAlong + placedBox's halfAlong)) and (highAlong > (centreAlong - placedBox's halfAlong)):
                        if otherGap < (ownGap + ((the bim dimension value gap along) * unit)):
                            set ownLineKept to false
                    if trial's leader:
                        if ((strokeAcross - leaderFromAcross) * (strokeAcross - leaderToAcross)) < 0.0:
                            set crossingAlong to leaderFromAlong + (((strokeAcross - leaderFromAcross) / (leaderToAcross - leaderFromAcross)) * (leaderToAlong - leaderFromAlong))
                            if (crossingAlong >= lowAlong) and (crossingAlong <= highAlong):
                                set ownLineKept to false
        return ownLineKept

# Whether the segment from `startA` to `endA` crosses the one from `startB`
# to `endB` (each end strictly on the other's far side; touching is no
# crossing).
local function bim dimension segment from {cad vector2:startA} to {cad vector2:endA} crosses the segment from {cad vector2:startB} to {cad vector2:endB}:
    execute:
        set sideStartB to ((endA's x - startA's x) * (startB's y - startA's y)) - ((endA's y - startA's y) * (startB's x - startA's x))
        set sideEndB to ((endA's x - startA's x) * (endB's y - startA's y)) - ((endA's y - startA's y) * (endB's x - startA's x))
        set sideStartA to ((endB's x - startB's x) * (startA's y - startB's y)) - ((endB's y - startB's y) * (startA's x - startB's x))
        set sideEndA to ((endB's x - startB's x) * (endA's y - startB's y)) - ((endB's y - startB's y) * (endA's x - startB's x))
        return ((sideStartB * sideEndB) < 0.0) and ((sideStartA * sideEndA) < 0.0)

# Whether `trial`, a place of `pending`'s value, keeps the order of the
# values lettered before it on the same dimension line: `placedMarks` holds
# three points for each, its line's two ends and its box's centre. Of two
# values on one line, the one whose segment comes first along it stands
# first, so that no value moved out of its segment stands beyond its
# neighbour's.
local function bim dimension candidate {bim dimension candidate record:trial} of {bim dimension value record:pending} keeps its order among {a pointer to a list:placedMarks} on {bim canvas record:canvas}:
    execute:
        set unit to the bim symbol scale of canvas
        set lineFirst to pending's first
        set lineLast to pending's last
        set lineLength to the cad distance from lineFirst to lineLast
        if lineLength <= 1e-9:
            return true
        set dirX to (lineLast's x - lineFirst's x) / lineLength
        set dirY to (lineLast's y - lineFirst's y) / lineLength
        set trialCentre to (the bim lettering box of trial's placed on canvas)'s centre
        set trialAlong to ((trialCentre's x - lineFirst's x) * dirX) + ((trialCentre's y - lineFirst's y) * dirY)
        set ownMiddleAlong to lineLength * 0.5
        set orderKept to true
        set markCount to (the length of placedMarks) / 3
        loop markCursor from 0 to markCount:
            set otherFirst to the item at (markCursor * 3) in placedMarks
            set otherLast to the item at ((markCursor * 3) + 1) in placedMarks
            set otherCentre to the item at ((markCursor * 3) + 2) in placedMarks
            set otherLength to the cad distance from otherFirst to otherLast
            if orderKept and (otherLength > 1e-9):
                set otherTurn to (((otherLast's x - otherFirst's x) * dirY) - ((otherLast's y - otherFirst's y) * dirX)) / otherLength
                set otherAcross to ((otherFirst's x - lineFirst's x) * dirY) - ((otherFirst's y - lineFirst's y) * dirX)
                if ((the absolute value of otherTurn) < 0.01) and ((the absolute value of otherAcross) <= (0.5 * unit)):
                    set otherMiddleAlong to ((((otherFirst's x + otherLast's x) * 0.5) - lineFirst's x) * dirX) + ((((otherFirst's y + otherLast's y) * 0.5) - lineFirst's y) * dirY)
                    set otherAlong to ((otherCentre's x - lineFirst's x) * dirX) + ((otherCentre's y - lineFirst's y) * dirY)
                    if ((ownMiddleAlong - otherMiddleAlong) * (trialAlong - otherAlong)) < 0.0:
                        set orderKept to false
        return orderKept

# Whether `trial`, a place of `pending`'s value, stands clear of the boxes
# `obstacles` and the stroke pairs `strokes` on `canvas`, by a millimetre
# along its line and 0.25 mm across it (four and one symbol units), of the
# boxes `valueBoxes` of the values lettered before it by a millimetre along
# and two across (by a millimetre along, in any row, for those of its own
# line), its leader clear of the boxes, keeps to its own line
# (`bim dimension candidate … keeps to the line of`) and keeps the order of
# the values on its line (`placedMarks`: `bim dimension candidate … keeps
# its order among`). Its leader crosses no leader drawn before it (the
# stroke pairs from `firstLeader` on) and, unless `crossingAllowed`, no
# extension line either.
local function bim dimension candidate {bim dimension candidate record:trial} of {bim dimension value record:pending} stands clear of {a pointer to a list:obstacles}, {a pointer to a list:valueBoxes} and {a pointer to a list:strokes} past {integer:firstLeader} keeping {a pointer to a list:placedMarks} crossing {boolean:crossingAllowed} on {bim canvas record:canvas}:
    execute:
        set unit to the bim symbol scale of canvas
        set placedBox to the bim lettering box of trial's placed on canvas
        set grown to the bim lettering box placedBox grown by ((the bim dimension value gap along) * unit) and unit
        set stackedBox to the bim lettering box placedBox grown by ((the bim dimension value gap along) * unit) and ((the bim dimension value gap across) * unit)
        set unhindered to true
        loop obstacleCursor from 0 to the length of obstacles:
            if unhindered:
                if bim lettering box grown overlaps (the item at obstacleCursor in obstacles):
                    set unhindered to false
                if trial's leader:
                    if bim lettering box (the item at obstacleCursor in obstacles) meets the segment from trial's leaderFrom to trial's leaderTo:
                        set unhindered to false
        loop valueCursor from 0 to the length of valueBoxes:
            if unhindered:
                if bim lettering box stackedBox overlaps (the item at valueCursor in valueBoxes):
                    set unhindered to false
                # A value of its own line, in whatever row: a millimetre
                # clear along the line.
                if bim dimension line from (the item at (valueCursor * 3) in placedMarks) to (the item at ((valueCursor * 3) + 1) in placedMarks) lies on the line of pending on canvas:
                    if (the bim dimension gap between placedBox and (the item at valueCursor in valueBoxes) along the line of pending) < (((the bim dimension value gap along) * unit) - 1e-9):
                        set unhindered to false
                if trial's leader:
                    if bim lettering box (the item at valueCursor in valueBoxes) meets the segment from trial's leaderFrom to trial's leaderTo:
                        set unhindered to false
        set pairCount to (the length of strokes) / 2
        loop pairCursor from 0 to pairCount:
            if unhindered:
                set strokeStart to the item at (pairCursor * 2) in strokes
                set strokeEnd to the item at ((pairCursor * 2) + 1) in strokes
                if bim lettering box grown meets the segment from strokeStart to strokeEnd:
                    set unhindered to false
                if trial's leader and ((pairCursor >= firstLeader) or (crossingAllowed = false)):
                    if bim dimension segment from trial's leaderFrom to trial's leaderTo crosses the segment from strokeStart to strokeEnd:
                        set unhindered to false
        if unhindered:
            set unhindered to bim dimension candidate trial keeps to the line of pending among strokes on canvas
        if unhindered:
            set unhindered to bim dimension candidate trial of pending keeps its order among placedMarks on canvas
        return unhindered

# Letters the dimension values `values` (`bim dimension value record`s) on
# `canvas`, each in the first place that stands clear of the labels and
# kept boxes already on it, of the values lettered before it and of the
# stroke pairs `strokes` (the dimension and extension lines); then slides a
# value standing in its segment along it, once, away from the values moved
# beside it in its row closer than a text height, where a slide clears
# that and every other rule. The leaders it draws are appended to `strokes`. A value with no
# clear place stands in its first; the number of those.
function letter bim dimension values {a pointer to a list:values} among {a pointer to a list:strokes} on {a pointer to a bim canvas record:canvas}:
    execute:
        set onCanvas to @intrinsic("dereference", canvas)
        set obstacles to an empty list of a bim lettering box record
        loop textCursor from 0 to the length of (onCanvas's texts's values):
            append (the bim lettering box of (the item at textCursor in (onCanvas's texts's values)) on onCanvas) to obstacles
        loop keptCursor from 0 to the length of (onCanvas's keepClear's values):
            append (the item at keptCursor in (onCanvas's keepClear's values)) to obstacles
        set valueBoxes to an empty list of a bim lettering box record
        set placedMarks to an empty list of a cad vector2
        set firstLeader to (the length of strokes) / 2
        set lettered to an empty list of a boolean
        # Per value, the index of its box in `valueBoxes` (and of its three
        # marks in `placedMarks`) and of its label on the canvas.
        set boxIndexOf to an empty list of an integer
        set textIndexOf to an empty list of an integer
        loop valueCursor from 0 to the length of values:
            append false to lettered
            append -1 to boxIndexOf
            append -1 to textIndexOf
        set crowded to 0
        # Each value's number of neighbours on its line (segments that meet
        # its own) that do not fit theirs either, two at most: in a cluster
        # of short steps the middle ones go first, so that the values at
        # its ends can stand beyond theirs, in order.
        set clustered to an empty list of an integer
        loop valueCursor from 0 to the length of values:
            set ownValue to the item at valueCursor in values
            set neighbours to 0
            if (bim dimension text ownValue's message fits between ownValue's first and ownValue's last on onCanvas) = false:
                loop otherCursor from 0 to the length of values:
                    set otherValue to the item at otherCursor in values
                    if otherCursor != valueCursor:
                        set touching to ((the cad distance from ownValue's first to otherValue's last) < 1e-6) or ((the cad distance from ownValue's last to otherValue's first) < 1e-6)
                        if touching and ((bim dimension text otherValue's message fits between otherValue's first and otherValue's last on onCanvas) = false):
                            set neighbours to neighbours + 1
            if neighbours > 2:
                set neighbours to 2
            append neighbours to clustered
        # Round 0 the values that fit their segments, in them; round 1 every
        # value left in a place whose leader, if any, crosses no line; round
        # 2 the rest, their leaders crossing extension lines (never another
        # leader), else in their first place. Rounds 1 and 2 take the values
        # with most such neighbours first.
        loop passIndex from 0 to 7:
            set roundIndex to 0
            set clusterWanted to 0
            if passIndex > 0:
                set roundIndex to 1 + ((passIndex - 1) / 3)
                set clusterWanted to 2 - (the remainder of (passIndex - 1) divided by 3)
            loop valueCursor from 0 to the length of values:
                if ((the item at valueCursor in lettered) = false) and ((roundIndex = 0) or ((the item at valueCursor in clustered) = clusterWanted)):
                    set pending to the item at valueCursor in values
                    set candidates to an empty list of a bim dimension candidate record
                    append bim dimension candidates of pending into candidates on onCanvas
                    set chosenIndex to -1
                    loop candidateCursor from 0 to the length of candidates:
                        if chosenIndex < 0:
                            set offered to the item at candidateCursor in candidates
                            if (roundIndex > 0) or offered's early:
                                if bim dimension candidate offered of pending stands clear of obstacles, valueBoxes and strokes past firstLeader keeping placedMarks crossing (roundIndex = 2) on onCanvas:
                                    set chosenIndex to candidateCursor
                    if (chosenIndex < 0) and (roundIndex = 2):
                        set chosenIndex to 0
                        set crowded to crowded + 1
                    if chosenIndex >= 0:
                        set chosen to the item at chosenIndex in candidates
                        replace item at index valueCursor in boxIndexOf with (the length of valueBoxes)
                        replace item at index valueCursor in textIndexOf with (the length of (canvas's texts's values))
                        record bim dimension text chosen's placed on canvas
                        set chosenBox to the bim lettering box of chosen's placed on onCanvas
                        append chosenBox to valueBoxes
                        append pending's first to placedMarks
                        append pending's last to placedMarks
                        append chosenBox's centre to placedMarks
                        if chosen's leader:
                            append chosen's leaderFrom to strokes
                            append chosen's leaderTo to strokes
                        replace item at index valueCursor in lettered with true
                    free candidates
        # A value moved beside its segment stands a text height clear along
        # its line of the value of a neighbouring segment that stands in its
        # own, in the same row (overlapping it across the line), where that
        # value can slide along its segment to leave the room clear of
        # everything else: '895' moved past its end beside '2100' read as
        # one string a millimetre from it. Each value in its segment slides
        # at most once, to the first place that widens the least gap to all
        # such moved neighbours, so that a slide away from one never gives
        # that room back to another; values a row or more apart do not read
        # as one string and leave it centred.
        set inLineGap to (the bim dimension value gap in line) * (the bim symbol scale of onCanvas)
        loop fittedCursor from 0 to the length of values:
            set fittedBoxIndex to the item at fittedCursor in boxIndexOf
            if fittedBoxIndex >= 0:
                set fittedValue to the item at fittedCursor in values
                set fittedBox to the item at fittedBoxIndex in valueBoxes
                set fittedAlong to the bim dimension distance of fittedBox's centre along the line of fittedValue
                set fittedIn to (fittedAlong >= 0.0) and (fittedAlong <= (the cad distance from fittedValue's first to fittedValue's last))
                set rowNeighbours to an empty list of a bim lettering box record
                set worstGap to inLineGap
                loop movedCursor from 0 to the length of values:
                    set movedBoxIndex to the item at movedCursor in boxIndexOf
                    if fittedIn and ((movedCursor != fittedCursor) and (movedBoxIndex >= 0)):
                        set movedValue to the item at movedCursor in values
                        set movedBox to the item at movedBoxIndex in valueBoxes
                        set movedAlong to the bim dimension distance of movedBox's centre along the line of movedValue
                        set movedOut to (movedAlong < 0.0) or (movedAlong > (the cad distance from movedValue's first to movedValue's last))
                        if movedOut and (bim dimension line from movedValue's first to movedValue's last lies on the line of fittedValue on onCanvas):
                            if (the bim dimension gap between movedBox and fittedBox across the line of fittedValue) < 0.0:
                                append movedBox to rowNeighbours
                                set neighbourGap to the bim dimension gap between movedBox and fittedBox along the line of fittedValue
                                if neighbourGap < worstGap:
                                    set worstGap to neighbourGap
                if worstGap < inLineGap:
                    set otherBoxes to an empty list of a bim lettering box record
                    set otherMarks to an empty list of a cad vector2
                    loop boxCursor from 0 to the length of valueBoxes:
                        if boxCursor != fittedBoxIndex:
                            append (the item at boxCursor in valueBoxes) to otherBoxes
                            append (the item at (boxCursor * 3) in placedMarks) to otherMarks
                            append (the item at ((boxCursor * 3) + 1) in placedMarks) to otherMarks
                            append (the item at ((boxCursor * 3) + 2) in placedMarks) to otherMarks
                    set slideOffers to an empty list of a bim dimension candidate record
                    append bim dimension candidates of fittedValue into slideOffers on onCanvas
                    set bestSlide to -1
                    set bestGap to worstGap
                    loop slideCursor from 0 to the length of slideOffers:
                        set offered to the item at slideCursor in slideOffers
                        if (bestGap < inLineGap) and (offered's early and (offered's leader = false)):
                            set offeredBox to the bim lettering box of offered's placed on onCanvas
                            set offeredGap to inLineGap
                            loop neighbourCursor from 0 to the length of rowNeighbours:
                                set neighbourGap to the bim dimension gap between (the item at neighbourCursor in rowNeighbours) and offeredBox along the line of fittedValue
                                if neighbourGap < offeredGap:
                                    set offeredGap to neighbourGap
                            if offeredGap > bestGap:
                                if bim dimension candidate offered of fittedValue stands clear of obstacles, otherBoxes and strokes past firstLeader keeping otherMarks crossing false on onCanvas:
                                    set bestSlide to slideCursor
                                    set bestGap to offeredGap
                    if bestSlide >= 0:
                        set slidPlace to (the item at bestSlide in slideOffers)'s placed
                        set slidBox to the bim lettering box of slidPlace on onCanvas
                        replace item at index fittedBoxIndex in valueBoxes with slidBox
                        replace item at index ((fittedBoxIndex * 3) + 2) in placedMarks with slidBox's centre
                        replace item at index (the item at fittedCursor in textIndexOf) in (canvas's texts's values) with (the bim dimension text label of slidPlace)
                    free slideOffers
                    free otherBoxes
                    free otherMarks
                free rowNeighbours
        free obstacles
        free valueBoxes
        free placedMarks
        free clustered
        free lettered
        free boxIndexOf
        free textIndexOf
        return crowded
