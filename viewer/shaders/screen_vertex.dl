# SPDX-License-Identifier: MPL-2.0
# Vertex shader for drawing in pixels: x right and y down from the window's
# top-left corner, and a depth where larger is nearer. Inputs: the position
# (location 0), texture coordinates ("Attribute1", location 1) and the colour
# ("Attribute2", location 2). Parameters (storage buffer, binding 0): 32 and
# 33 hold 2 / width and 2 / height, 34 the depth scale, and 35 and 36 a shift
# in pixels, for recorded drawings replayed moved.
import lib/shader.dl

set ndcX to ((the vertex x + @intrinsic("shader buffer read", 0, 35)) * @intrinsic("shader buffer read", 0, 32)) - 1.0
set ndcY to ((the vertex y + @intrinsic("shader buffer read", 0, 36)) * @intrinsic("shader buffer read", 0, 33)) - 1.0
set ndcZ to 0.5 - (the vertex z * @intrinsic("shader buffer read", 0, 34))
set the shader interpolant named "uv" with an x coordinate of (the vertex input named "Attribute1" x), a y coordinate of (the vertex input named "Attribute1" y), a z coordinate of 0.0 and a w coordinate of 0.0
set the shader interpolant named "tint" with an x coordinate of (the vertex input named "Attribute2" x), a y coordinate of (the vertex input named "Attribute2" y), a z coordinate of (the vertex input named "Attribute2" z) and a w coordinate of (the vertex input named "Attribute2" w)
set the output position with x ndcX, y ndcY, z ndcZ and w 1.0
