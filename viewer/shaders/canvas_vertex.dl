# SPDX-License-Identifier: MPL-2.0
# Retained pixel geometry transformed by a per-draw instance (scale, dx, dy).
# No vertex rewrite, shared camera uniform, or oversized Vulkan viewport.
import lib/shader.dl

set pixelX to (the vertex x * (@intrinsic("extract element", @intrinsic("shader input", "Attribute4"), 0))) + (@intrinsic("extract element", @intrinsic("shader input", "Attribute4"), 1))
set pixelY to (the vertex y * (@intrinsic("extract element", @intrinsic("shader input", "Attribute4"), 0))) + (@intrinsic("extract element", @intrinsic("shader input", "Attribute4"), 2))
# z = 1 marks a flat stroke whose UV contains an unscaled pixel offset.
# All canvas vertices are 2D overlays; this marker never changes their depth.
if the vertex z > 0.5:
    set pixelX to pixelX + (@intrinsic("extract element", @intrinsic("shader input", "Attribute1"), 0))
    set pixelY to pixelY + (@intrinsic("extract element", @intrinsic("shader input", "Attribute1"), 1))
set ndcX to (pixelX * @intrinsic("shader buffer read", 0, 32)) - 1.0
set ndcY to (pixelY * @intrinsic("shader buffer read", 0, 33)) - 1.0
set ndcZ to 0.5
set the shader interpolant named "uv" with an x coordinate of (@intrinsic("extract element", @intrinsic("shader input", "Attribute1"), 0)), a y coordinate of (@intrinsic("extract element", @intrinsic("shader input", "Attribute1"), 1)), a z coordinate of 0.0 and a w coordinate of 0.0
set the shader interpolant named "tint" with an x coordinate of (@intrinsic("extract element", @intrinsic("shader input", "Attribute2"), 0)), a y coordinate of (@intrinsic("extract element", @intrinsic("shader input", "Attribute2"), 1)), a z coordinate of (@intrinsic("extract element", @intrinsic("shader input", "Attribute2"), 2)) and a w coordinate of (@intrinsic("extract element", @intrinsic("shader input", "Attribute2"), 3))
set the output position with x ndcX, y ndcY, z ndcZ and w 1.0
