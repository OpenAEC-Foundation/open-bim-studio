# SPDX-License-Identifier: MPL-2.0
# The shading of the GPU-resident 3D view's faces and edges, shared by their
# fragment shaders: those that cut the model by the section box
# (`mesh_cut_fragment.dl`, `edge_cut_fragment.dl`) and those that do not. A
# shader that may drop fragments loses the GPU's early depth test (measured
# on Sixty5: a frame of 25 to 29 ms took 31), so the cut is drawn only while
# the section box is on.
import lib/shader.dl

# The section box: what lies outside the box from parameters 43..45 to
# 46..48, relative to the scene's origin as positions are, is cut away; the
# ground and the shadows (ordinals below -1) are not.
function cut away the fragment outside the section box:
    execute:
        set beyond to 0.0
        if shader interpolant x named "place" < @intrinsic("shader buffer read", 0, 43):
            set beyond to 1.0
        if shader interpolant y named "place" < @intrinsic("shader buffer read", 0, 44):
            set beyond to 1.0
        if shader interpolant z named "place" < @intrinsic("shader buffer read", 0, 45):
            set beyond to 1.0
        if shader interpolant x named "place" > @intrinsic("shader buffer read", 0, 46):
            set beyond to 1.0
        if shader interpolant y named "place" > @intrinsic("shader buffer read", 0, 47):
            set beyond to 1.0
        if shader interpolant z named "place" > @intrinsic("shader buffer read", 0, 48):
            set beyond to 1.0
        if shader interpolant x named "pick" < -1.5:
            set beyond to 0.0
        if beyond > 0.5:
            discard the fragment

# A face's shading: the normal is the corner
# normals interpolated across the triangle, so that a round surface is shaded
# round; where a corner carries none, the face's normal, the cross product of
# how the position changes across and down the screen. It is turned toward
# the viewer; the face is lit by the sun with a weaker
# light from the viewer, as the CPU renderer lit it. Parameters 16 to 18 hold
# the direction toward the sun, 19 to 21 the direction toward the viewer, and
# 22 to 30 the ordinals of up to nine selected elements (negative for
# none), which are drawn blue. Corners of ordinals below -1 (the ground and
# the shadows) are drawn unlit.
function shade the mesh fragment:
    execute:
        set ax to @intrinsic("shader derivative x", shader interpolant x named "place")
        set ay to @intrinsic("shader derivative x", shader interpolant y named "place")
        set az to @intrinsic("shader derivative x", shader interpolant z named "place")
        set bx to @intrinsic("shader derivative y", shader interpolant x named "place")
        set by to @intrinsic("shader derivative y", shader interpolant y named "place")
        set bz to @intrinsic("shader derivative y", shader interpolant z named "place")
        set nx to (ay * bz) - (az * by)
        set ny to (az * bx) - (ax * bz)
        set nz to (ax * by) - (ay * bx)
        set size to @intrinsic("sqrt", ((nx * nx) + (ny * ny)) + (nz * nz))
        if size > 0.0:
            set nx to nx / size
            set ny to ny / size
            set nz to nz / size
        set sx to shader interpolant x named "smooth"
        set sy to shader interpolant y named "smooth"
        set sz to shader interpolant z named "smooth"
        set smoothSize to @intrinsic("sqrt", ((sx * sx) + (sy * sy)) + (sz * sz))
        if smoothSize > 0.5:
            set nx to sx / smoothSize
            set ny to sy / smoothSize
            set nz to sz / smoothSize
        set eyeX to @intrinsic("shader buffer read", 0, 19)
        set eyeY to @intrinsic("shader buffer read", 0, 20)
        set eyeZ to @intrinsic("shader buffer read", 0, 21)
        set facing to ((nx * eyeX) + (ny * eyeY)) + (nz * eyeZ)
        if facing < 0.0:
            set nx to 0.0 - nx
            set ny to 0.0 - ny
            set nz to 0.0 - nz
            set facing to 0.0 - facing
        set lit to ((nx * @intrinsic("shader buffer read", 0, 16)) + (ny * @intrinsic("shader buffer read", 0, 17))) + (nz * @intrinsic("shader buffer read", 0, 18))
        if lit < 0.0:
            set lit to 0.0
        set brightness to (0.42 + (0.4 * lit)) + (0.18 * facing)
        set red to shader interpolant x named "tint"
        set green to shader interpolant y named "tint"
        set blue to shader interpolant z named "tint"
        set pick to shader interpolant x named "pick"
        set hit to 0.0
        set offset to pick - @intrinsic("shader buffer read", 0, 22)
        if (offset * offset) < 0.25:
            set hit to 1.0
        set offset to pick - @intrinsic("shader buffer read", 0, 23)
        if (offset * offset) < 0.25:
            set hit to 1.0
        set offset to pick - @intrinsic("shader buffer read", 0, 24)
        if (offset * offset) < 0.25:
            set hit to 1.0
        set offset to pick - @intrinsic("shader buffer read", 0, 25)
        if (offset * offset) < 0.25:
            set hit to 1.0
        set offset to pick - @intrinsic("shader buffer read", 0, 26)
        if (offset * offset) < 0.25:
            set hit to 1.0
        set offset to pick - @intrinsic("shader buffer read", 0, 27)
        if (offset * offset) < 0.25:
            set hit to 1.0
        set offset to pick - @intrinsic("shader buffer read", 0, 28)
        if (offset * offset) < 0.25:
            set hit to 1.0
        set offset to pick - @intrinsic("shader buffer read", 0, 29)
        if (offset * offset) < 0.25:
            set hit to 1.0
        set offset to pick - @intrinsic("shader buffer read", 0, 30)
        if (offset * offset) < 0.25:
            set hit to 1.0
        if hit > 0.5:
            set red to 0.2745
            set green to 0.5098
            set blue to 0.8627
        # Below -1 the ordinal marks what is no element (the ground, shadows): drawn
        # in its own colour, unlit.
        if pick < -1.5:
            set brightness to 1.0
        set the fragment color with a red channel of (red * brightness), a green channel of (green * brightness), a blue channel of (blue * brightness) and an alpha channel of 1.0

# Every edge in the colour of parameters 39 to 41 (0..1).
function colour the edge fragment:
    execute:
        set the fragment color with a red channel of (@intrinsic("shader buffer read", 0, 39)), a green channel of (@intrinsic("shader buffer read", 0, 40)), a blue channel of (@intrinsic("shader buffer read", 0, 41)) and an alpha channel of 1.0
