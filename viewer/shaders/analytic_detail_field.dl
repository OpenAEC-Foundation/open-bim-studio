# Direct implicit CSG surface rendering. The rectangle is only a screen carrier;
# no triangles, normals or sampled boundaries describe the model geometry.
import lib/shader.dl

function packet {integer:base} rounded cylinder at {a number:x} {a number:y} {a number:z} radius {a number:radius} half height {a number:height} rim {a number:rim}:
    execute:
        set radial to @intrinsic("sqrt", (x * x) + (y * y))
        set qx to radial - (radius - rim)
        set qy to (the absolute value of z) - (height - rim)
        set ox to the maximum of qx and 0.0
        set oy to the maximum of qy and 0.0
        return (@intrinsic("sqrt", (ox * ox) + (oy * oy)) + (the minimum of (the maximum of qx and qy) and 0.0)) - rim

function packet {integer:base} rounded hex at {a number:x} {a number:y} {a number:z} flats {a number:flats} half height {a number:height}:
    execute:
        set px to the absolute value of x
        set py to the absolute value of y
        set hexDistance to (the maximum of px and ((px * 0.5) + (py * 0.8660254037844386))) - (flats * 0.5)
        set reach to flats / 1.7320508075688772
        set rim to (the minimum of (reach - (flats * 0.5)) and (height * 0.8)) * (the analytic parameter at (base + 16))
        return the maximum of hexDistance and (packet base rounded cylinder at x y z radius reach half height height rim rim)

function packet {integer:base} washer at {a number:x} {a number:y} {a number:z}:
    execute:
        set thickness to (the analytic parameter at (base + 5))
        set outer to packet base rounded cylinder at x y z radius ((the analytic parameter at (base + 3))) half height (thickness * 0.5) rim (thickness * 0.15)
        set bore to (the analytic parameter at (base + 4)) - @intrinsic("sqrt", (x * x) + (y * y))
        return the maximum of outer and bore

function packet {integer:base} nut at {a number:x} {a number:y} {a number:z}:
    execute:
        set outer to packet base rounded hex at x y z flats ((the analytic parameter at (base + 0))) half height ((the analytic parameter at (base + 2)) * 0.5)
        return the maximum of outer and (0.5 - @intrinsic("sqrt", (x * x) + (y * y)))

function packet {integer:base} anchor rod at {a number:x} {a number:y} {a number:z} length {a number:length} shape {a number:shape} bend {a number:bend} tail {a number:tail}:
    execute:
        set straight to length
        if (shape = 1.0) or (shape = 2.0):
            set straight to length - bend
        set result to packet base rounded cylinder at x y (z - (straight * 0.5)) radius 0.5 half height (straight * 0.5) rim 0.0
        if (shape = 1.0) or (shape = 2.0):
            set qx to x - bend
            set qz to z - straight
            set ring to @intrinsic("sqrt", (qx * qx) + (qz * qz)) - bend
            set curve to @intrinsic("sqrt", (ring * ring) + (y * y)) - 0.5
            set curve to the maximum of curve and (0.0 - qz)
            if shape = 1.0:
                set curve to the maximum of curve and qx
                set ending to packet base rounded cylinder at (z - length) y (x - bend - (tail * 0.5)) radius 0.5 half height (tail * 0.5) rim 0.0
                set result to the minimum of result and ending
            else:
                set ending to packet base rounded cylinder at (x - (2.0 * bend)) y (z - straight + (tail * 0.5)) radius 0.5 half height (tail * 0.5) rim 0.0
                set result to the minimum of result and ending
            set result to the minimum of result and curve
        return result

function packet {integer:base} fastener field at {a number:x} {a number:y} {a number:z}:
    execute:
        set kind to the analytic parameter at (base + 10)
        set height to the analytic parameter at (base + 2)
        set thickness to the analytic parameter at (base + 5)
        if kind = 6.0:
            return packet base nut at x y (z - (height * 0.5))
        if kind = 7.0:
            return packet base washer at x y (z - (thickness * 0.5))
        set length to the analytic parameter at (base + 7)
        set lift to the analytic parameter at (base + 20)
        set headHeight to the analytic parameter at (base + 1)
        set head to packet base rounded hex at x y (z - lift + (headHeight * 0.5)) flats (the analytic parameter at (base + 0)) half height (headHeight * 0.5)
        set shaft to packet base rounded cylinder at x y (z - lift - (length * 0.5)) radius 0.5 half height (length * 0.5) rim 0.0
        set result to the minimum of head and shaft
        if kind = 3.0:
            set result to packet base anchor rod at x y z length length shape (the analytic parameter at (base + 27)) bend (the analytic parameter at (base + 28)) tail (the analytic parameter at (base + 29))
            if (the analytic parameter at (base + 27)) = 3.0:
                set endPlate to packet base rounded cylinder at x y (z - length - 0.25) radius 2.0 half height 0.25 rim 0.0
                set endPlate to the maximum of endPlate and (0.5 - @intrinsic("sqrt", (x * x) + (y * y)))
                set result to the minimum of result and endPlate
        set station to the analytic parameter at (base + 19)
        loop nutIndex from 0 to 2:
            if (nutIndex as a floating-point number) < (the analytic parameter at (base + 18)):
                set centre to station + (height * ((nutIndex as a floating-point number) + 0.5))
                set result to the minimum of result and (packet base nut at x y (z - centre))
        set washers to the analytic parameter at (base + 8)
        if (washers = 1.0) or (washers = 3.0):
            set result to the minimum of result and (packet base washer at x y (z + (thickness * 0.5)))
        if washers >= 2.0:
            set washerCentre to station - (thickness * 0.5)
            if kind = 3.0:
                set washerCentre to (station + (height * (the analytic parameter at (base + 18)))) + (thickness * 0.5)
            set result to the minimum of result and (packet base washer at x y (z - washerCentre))
        return result

function analytic washer at {a number:x} {a number:y} {a number:z}:
    execute:
        return packet 0 washer at x y z

function analytic nut at {a number:x} {a number:y} {a number:z}:
    execute:
        return packet 0 nut at x y z

function analytic fastener field at {a number:x} {a number:y} {a number:z}:
    execute:
        return packet 0 fastener field at x y z

function analytic anchor rod at {a number:x} {a number:y} {a number:z} length {a number:length} shape {a number:shape} bend {a number:bend} tail {a number:tail}:
    execute:
        return packet 0 anchor rod at x y z length length shape shape bend bend tail tail
