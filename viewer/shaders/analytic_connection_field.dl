# SPDX-License-Identifier: MPL-2.0
# A bounded assembly of analytic parts; all coordinates and distances in metres.
import viewer/shaders/analytic_detail_field.dl

function analytic box at {a number:x} {a number:y} {a number:z} half sizes {a number:width} {a number:depth} {a number:height}:
    execute:
        set qx to (the absolute value of x) - width
        set qy to (the absolute value of y) - depth
        set qz to (the absolute value of z) - height
        set ox to the maximum of qx and 0.0
        set oy to the maximum of qy and 0.0
        set oz to the maximum of qz and 0.0
        return @intrinsic("sqrt", ((ox * ox) + (oy * oy)) + (oz * oz)) + (the minimum of (the maximum of qx and (the maximum of qy and qz)) and 0.0)

function analytic part coordinate {integer:axis} of {integer:base} at {a number:x} {a number:y} {a number:z}:
    execute:
        set px to x - (the analytic parameter at (base + 32))
        set py to y - (the analytic parameter at (base + 33))
        set pz to z - (the analytic parameter at (base + 34))
        set slot to (base + 35) + (axis * 3)
        return ((px * (the analytic parameter at slot)) + (py * (the analytic parameter at (slot + 1)))) + (pz * (the analytic parameter at (slot + 2)))

function analytic part {integer:base} at {a number:x} {a number:y} {a number:z}:
    execute:
        set px to analytic part coordinate 0 of base at x y z
        set py to analytic part coordinate 1 of base at x y z
        set pz to analytic part coordinate 2 of base at x y z
        set kind to the analytic parameter at (base + 60)
        set diameter to the analytic parameter at (base + 44)
        if kind = 0.0:
            return (packet base fastener field at (px / diameter) (py / diameter) (pz / diameter)) * diameter
        set width to the analytic parameter at (base + 45)
        set depth to the analytic parameter at (base + 46)
        set length to the analytic parameter at (base + 47)
        set result to analytic box at px py pz half sizes width depth length
        if kind = 2.0:
            set result to the maximum of result and ((px + py) * 0.7071067811865476)
        if kind = 3.0:
            set web to (the analytic parameter at (base + 48)) * 0.5
            set flange to the analytic parameter at (base + 49)
            set result to the minimum of (analytic box at px py pz half sizes web depth length) and (analytic box at px ((the absolute value of py) - depth + (flange * 0.5)) pz half sizes width (flange * 0.5) length)
            set radius to the analytic parameter at base
            if radius > 0.0:
                set qx to (the absolute value of px) - web
                set qy to (depth - flange) - (the absolute value of py)
                set circle to radius - @intrinsic("sqrt", ((qx - radius) * (qx - radius)) + ((qy - radius) * (qy - radius)))
                set patch to the maximum of circle and (the maximum of (qx - radius) and (qy - radius))
                set patch to the maximum of patch and (the maximum of (0.0 - qx) and (0.0 - qy))
                set patch to the maximum of patch and ((the absolute value of pz) - length)
                set result to the minimum of result and patch
        if kind = 4.0:
            set wall to the analytic parameter at (base + 48)
            set outerRadius to the minimum of (the analytic parameter at (base + 49)) and (the minimum of width and depth)
            set innerRadius to the maximum of 0.0 and (outerRadius - wall)
            set result to (analytic box at px py 0.0 half sizes (width - outerRadius) (depth - outerRadius) 1000.0) - outerRadius
            set inner to (analytic box at px py 0.0 half sizes (width - wall - innerRadius) (depth - wall - innerRadius) 1000.0) - innerRadius
            set result to the maximum of result and (0.0 - inner)
            set result to the maximum of result and ((the absolute value of pz) - length)
        if kind = 5.0:
            set radial to @intrinsic("sqrt", (px * px) + (py * py))
            set result to the maximum of (radial - width) and ((width - (the analytic parameter at (base + 48))) - radial)
            set result to the maximum of result and ((the absolute value of pz) - length)
        # Member trims retain the positive side of their semantic cut planes.
        loop plane from 0 to 2:
            if (plane as a floating-point number) < (the analytic parameter at (base + 10)):
                set slot to (base + 2) + (plane * 4)
                set distance to (((x * (the analytic parameter at slot)) + (y * (the analytic parameter at (slot + 1)))) + (z * (the analytic parameter at (slot + 2)))) - (the analytic parameter at (slot + 3))
                set result to the maximum of result and (0.0 - distance)
        if (kind != 2.0) and (result <= 0.0):
            loop holeIndex from 0 to ((the analytic parameter at 31) as an integer):
                set hole to 64 + (holeIndex * 64)
                if (the analytic parameter at (hole + 60)) = 0.0:
                    set owner to the analytic parameter at (hole + 58)
                    if (kind = 1.0) or ((owner > 0.0) and (owner = (the analytic parameter at (base + 58)))):
                        set hx to analytic part coordinate 0 of hole at x y z
                        set hy to analytic part coordinate 1 of hole at x y z
                        set hz to analytic part coordinate 2 of hole at x y z
                        set extent to (the analytic parameter at (hole + 7)) * (the analytic parameter at (hole + 44))
                        set cutter to packet 0 rounded cylinder at hx hy (hz - (extent * 0.5)) radius (the analytic parameter at (hole + 45)) half height (extent * 0.5) rim 0.0
                        set result to the maximum of result and (0.0 - cutter)
        return result

function analytic scene field at {a number:x} {a number:y} {a number:z}:
    execute:
        if (the analytic parameter at 31) < 0.5:
            return analytic fastener field at x y z
        set result to 1000000.0
        loop index from 0 to ((the analytic parameter at 31) as an integer):
            set result to the minimum of result and (analytic part (64 + (index * 64)) at x y z)
        return result
