# SPDX-License-Identifier: MPL-2.0
# Pixel rays through an implicit CSG field, without a model triangle surface.
import viewer/shaders/analytic_connection_field.dl
import viewer/analytic_detail_contract.dl

function the analytic parameter at {integer:index}:
    execute:
        return @intrinsic("shader buffer read", 0, ((gpu analytic detail parameters start) + index))

set yaw to (the analytic parameter at 11)
set elevation to (the analytic parameter at 12)
set ca to @intrinsic("cos", yaw)
set sa to @intrinsic("sin", yaw)
set ce to @intrinsic("cos", elevation)
set se to @intrinsic("sin", elevation)
set width to (the analytic parameter at 13)
set height to (the analytic parameter at 14)
set zoom to (the analytic parameter at 15)
set u to (((the fragment x coordinate - (the analytic parameter at 23)) - (width * 0.5)) / height) * zoom
set v to (((height * 0.5) - (the fragment y coordinate - (the analytic parameter at 24))) / height) * zoom
set dx to sa * ce
set dy to ca * ce
set dz to 0.0 - se
set rayReach to ((the maximum of (the analytic parameter at 25) and 0.1) * 2.0) + (the analytic parameter at 36)
set epsilon to 0.001
if (the analytic parameter at 31) > 0.5:
    set epsilon to 0.00002
set ox to (the analytic parameter at 30) + (((ca * u) + ((sa * se) * v)) - (dx * rayReach))
set oy to (the analytic parameter at 32) + (((0.0 - (sa * u)) + ((ca * se) * v)) - (dy * rayReach))
set oz to ((the analytic parameter at 26) + (ce * v)) - (dz * rayReach)
set travel to 0.0
set hit to false
loop step from 0 to 160:
    if (hit = false) and (travel < (rayReach * 2.0)):
        set distance to analytic scene field at (ox + (dx * travel)) (oy + (dy * travel)) (oz + (dz * travel))
        if distance < epsilon:
            set hit to true
        else:
            set travel to travel + (the maximum of (epsilon * 0.5) and (distance * 0.7))
set red to 0.92
set green to 0.94
set blue to 0.96
if hit:
    set px to ox + (dx * travel)
    set py to oy + (dy * travel)
    set pz to oz + (dz * travel)
    set nx to (analytic scene field at (px + (epsilon * 2.0)) py pz) - (analytic scene field at (px - (epsilon * 2.0)) py pz)
    set ny to (analytic scene field at px (py + (epsilon * 2.0)) pz) - (analytic scene field at px (py - (epsilon * 2.0)) pz)
    set nz to (analytic scene field at px py (pz + (epsilon * 2.0))) - (analytic scene field at px py (pz - (epsilon * 2.0)))
    set magnitude to @intrinsic("sqrt", ((nx * nx) + (ny * ny)) + (nz * nz))
    set magnitude to the maximum of magnitude and 0.0000001
    set nx to nx / magnitude
    set ny to ny / magnitude
    set nz to nz / magnitude
    set lit to the maximum of 0.0 and (((nx * -0.4) + (ny * -0.5)) + (nz * 0.768))
    set facing to the maximum of 0.0 and (0.0 - (((nx * dx) + (ny * dy)) + (nz * dz)))
    set shine to 0.25
    if (the analytic parameter at 9) > 1.5:
        set shine to 0.55
    set brightness to (0.32 + (0.48 * lit)) + ((shine * facing) * facing)
    set red to brightness * 0.70
    set green to brightness * 0.74
    set blue to brightness * 0.79
    if (the analytic parameter at 9) < 0.5:
        set red to brightness * 0.55
        set green to brightness * 0.58
        set blue to brightness * 0.62
    if (the analytic parameter at 9) > 1.5:
        set red to brightness * 0.84
        set green to brightness * 0.88
        set blue to brightness * 0.92
    set selectedPart to 0
    if (the analytic parameter at 31) > 0.5:
        set best to 1000000.0
        loop partIndex from 0 to ((the analytic parameter at 31) as an integer):
            set base to 64 + (partIndex * 64)
            set distance to analytic part base at px py pz
            if distance < best:
                set best to distance
                set selectedPart to base
        set kind to the analytic parameter at (selectedPart + 60)
        # Technical Colors: blue plates, orange welds, neutral members.
        if kind = 1.0:
            set red to brightness * 0.28
            set green to brightness * 0.55
            set blue to brightness * 0.90
        if kind = 2.0:
            set red to brightness * 0.98
            set green to brightness * 0.40
            set blue to brightness * 0.16
        if kind = 0.0:
            set red to brightness * 0.93
            set green to brightness * 0.76
            set blue to brightness * 0.30
    set threadX to px
    set threadY to py
    set threadZ to pz
    set showThread to (the analytic parameter at 17) > 0.5
    if selectedPart > 0:
        set showThread to ((the analytic parameter at (selectedPart + 60)) = 0.0) and ((the analytic parameter at (selectedPart + 17)) > 0.5)
        if showThread:
            set diameter to the analytic parameter at (selectedPart + 44)
            set threadX to (analytic part coordinate 0 of selectedPart at px py pz) / diameter
            set threadY to (analytic part coordinate 1 of selectedPart at px py pz) / diameter
            set threadZ to (analytic part coordinate 2 of selectedPart at px py pz) / diameter
    set rho to @intrinsic("sqrt", (threadX * threadX) + (threadY * threadY))
    if ((the absolute value of (rho - 0.5)) < 0.012) and (((threadZ >= (the analytic parameter at (selectedPart + 21))) and (threadZ <= (the analytic parameter at (selectedPart + 22)))) and showThread):
        set helixAngle to (threadZ / (the analytic parameter at (selectedPart + 6))) * 6.283185307179586
        set helixMatch to ((@intrinsic("cos", helixAngle) * threadX) + (@intrinsic("sin", helixAngle) * threadY)) / rho
        if helixMatch > 0.9408807689:
            set red to red * 0.22
            set green to green * 0.22
            set blue to blue * 0.22
set the fragment color with a red channel of red, a green channel of green, a blue channel of blue and an alpha channel of 1.0
