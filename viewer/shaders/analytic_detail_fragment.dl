# Pixel rays through an implicit CSG field, without a model triangle surface.
import viewer/shaders/analytic_detail_field.dl
import viewer/analytic_detail_contract.dl

function the analytic parameter at {integer:index}:
    execute:
        return @intrinsic("shader buffer read", 0, ((gpu analytic detail parameters start) + index))

set yaw to (the analytic parameter at 11)
set elevation to (the analytic parameter at 12)
set ca to @intrinsic("cos", yaw)
set sa to @intrinsic("sin", yaw)
set ce to @intrinsic("cos", elevation)
set se to @intrinsic("sin", elevation)
set width to (the analytic parameter at 13)
set height to (the analytic parameter at 14)
set zoom to (the analytic parameter at 15)
set u to (((the fragment x coordinate - (the analytic parameter at 23)) - (width * 0.5)) / height) * zoom
set v to (((height * 0.5) - (the fragment y coordinate - (the analytic parameter at 24))) / height) * zoom
set dx to 0.0 - (sa * ce)
set dy to ca * ce
set dz to 0.0 - se
set rayReach to (the maximum of (the analytic parameter at 25) and 8.0) * 2.0
set ox to ((ca * u) - ((sa * se) * v)) - (dx * rayReach)
set oy to ((sa * u) + ((ca * se) * v)) - (dy * rayReach)
set oz to ((the analytic parameter at 26) + (ce * v)) - (dz * rayReach)
set travel to 0.0
set hit to false
loop step from 0 to 160:
    if (hit = false) and (travel < (rayReach * 2.0)):
        set distance to analytic fastener field at (ox + (dx * travel)) (oy + (dy * travel)) (oz + (dz * travel))
        if distance < 0.001:
            set hit to true
        else:
            set travel to travel + (the maximum of 0.0005 and (distance * 0.7))
set red to 0.92
set green to 0.94
set blue to 0.96
if hit:
    set px to ox + (dx * travel)
    set py to oy + (dy * travel)
    set pz to oz + (dz * travel)
    set nx to (analytic fastener field at (px + 0.002) py pz) - (analytic fastener field at (px - 0.002) py pz)
    set ny to (analytic fastener field at px (py + 0.002) pz) - (analytic fastener field at px (py - 0.002) pz)
    set nz to (analytic fastener field at px py (pz + 0.002)) - (analytic fastener field at px py (pz - 0.002))
    set magnitude to @intrinsic("sqrt", ((nx * nx) + (ny * ny)) + (nz * nz))
    set magnitude to the maximum of magnitude and 0.0000001
    set nx to nx / magnitude
    set ny to ny / magnitude
    set nz to nz / magnitude
    set lit to the maximum of 0.0 and (((nx * -0.4) + (ny * -0.5)) + (nz * 0.768))
    set facing to the maximum of 0.0 and (0.0 - (((nx * dx) + (ny * dy)) + (nz * dz)))
    set shine to 0.25
    if (the analytic parameter at 9) > 1.5:
        set shine to 0.55
    set brightness to (0.32 + (0.48 * lit)) + ((shine * facing) * facing)
    set red to brightness * 0.70
    set green to brightness * 0.74
    set blue to brightness * 0.79
    if (the analytic parameter at 9) < 0.5:
        set red to brightness * 0.55
        set green to brightness * 0.58
        set blue to brightness * 0.62
    if (the analytic parameter at 9) > 1.5:
        set red to brightness * 0.84
        set green to brightness * 0.88
        set blue to brightness * 0.92
    set threadX to px
    set threadZ to pz
    set rho to @intrinsic("sqrt", (threadX * threadX) + (py * py))
    if ((the absolute value of (rho - 0.5)) < 0.012) and (((pz >= (the analytic parameter at 21)) and (pz <= (the analytic parameter at 22))) and ((the analytic parameter at 17) > 0.5)):
        set helixAngle to (threadZ / (the analytic parameter at 6)) * 6.283185307179586
        set helixMatch to ((@intrinsic("cos", helixAngle) * threadX) + (@intrinsic("sin", helixAngle) * py)) / rho
        if helixMatch > 0.9408807689:
            set red to red * 0.22
            set green to green * 0.22
            set blue to blue * 0.22
set the fragment color with a red channel of red, a green channel of green, a blue channel of blue and an alpha channel of 1.0
