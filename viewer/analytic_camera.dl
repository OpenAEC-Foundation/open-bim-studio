# SPDX-License-Identifier: MPL-2.0
# Orthographic detail camera. Target and span are in units of the fitted extent.
# Pointer positions/deltas and viewport dimensions are all layout pixels.
import kernel/core/core.dl

class:
    patterns:
        [a|] analytic camera record
    members:
        yaw as a 64 bit floating-point number
        elevation as a 64 bit floating-point number
        span as a 64 bit floating-point number
        target as a cad vector3

function a new analytic camera:
    execute:
        return @intrinsic("construct", a analytic camera record, 0.4, 0.45, 1.0, the cad zero vector3)

function the fitted analytic camera {analytic camera record:camera}:
    execute:
        set result to camera
        set result's span to 1.0
        set result's target to the cad zero vector3
        return result

# Same screen basis and orbit signs as the regular BIM camera.
function the analytic across of {analytic camera record:camera}:
    execute:
        return a cad vector3 with x (the cosine of camera's yaw), y (0.0 - (the sine of camera's yaw)) and z 0.0

function the analytic up of {analytic camera record:camera}:
    execute:
        set sine to the sine of camera's elevation
        return a cad vector3 with x (sine * (the sine of camera's yaw)), y (sine * (the cosine of camera's yaw)) and z (the cosine of camera's elevation)

function the analytic camera {analytic camera record:camera} orbited by {a 64 bit floating-point number:dx} and {a 64 bit floating-point number:dy}:
    execute:
        set result to camera
        set result's yaw to camera's yaw + (dx * 0.006)
        set result's elevation to (camera's elevation + (dy * 0.006)) clamped between -1.5 and 1.5
        return result

function the analytic camera {analytic camera record:camera} panned by {a 64 bit floating-point number:dx} and {a 64 bit floating-point number:dy} over height {a 64 bit floating-point number:height}:
    execute:
        set result to camera
        if height <= 0.0:
            return result
        set units to camera's span / height
        set shift to the cad sum of ((the analytic across of camera) scaled by (0.0 - (dx * units))) and ((the analytic up of camera) scaled by (dy * units))
        set result's target to the cad sum of camera's target and shift
        return result

# x/y are offsets from the drawable centre, with y increasing downward.
# Use the applied span change, including at the zoom clamps, to keep the anchor.
function the analytic camera {analytic camera record:camera} scrolled by {a 64 bit floating-point number:wheel} at {a 64 bit floating-point number:x} {a 64 bit floating-point number:y} over height {a 64 bit floating-point number:height}:
    execute:
        set result to camera
        if height <= 0.0:
            return result
        set steps to wheel clamped between -40.0 and 40.0
        set result's span to (camera's span / (1.15 raised to the power of steps)) clamped between 0.01 and 100.0
        set units to (camera's span - result's span) / height
        set shift to the cad sum of ((the analytic across of camera) scaled by (x * units)) and ((the analytic up of camera) scaled by (0.0 - (y * units)))
        set result's target to the cad sum of camera's target and shift
        return result

# A gesture belongs to the viewport where the press started, until release.
# 1 = right/orbit; 2 = middle/pan (Shift modifies middle to orbit).
function the analytic drag {integer:held} with buttons {boolean:right} {boolean:middle} previously {boolean:previousRight} {boolean:previousMiddle} over body {boolean:overBody} enabled {boolean:enabled}:
    execute:
        if enabled = false:
            return 0
        if held = 1:
            if right:
                return 1
            return 0
        if held = 2:
            if middle:
                return 2
            return 0
        if overBody:
            if middle and (previousMiddle = false):
                return 2
            if right and (previousRight = false):
                return 1
        return 0
