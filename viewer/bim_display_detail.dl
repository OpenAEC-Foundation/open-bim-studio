# SPDX-License-Identifier: MPL-2.0
# View geometry is derived once at a nominal 0.1 mm chord target. Native round
# profiles retain their existing 12..256 segment bound; the BRep seam keeps its
# angular control. This is display detail, never the modelling tolerance or a
# replacement for exact geometry in saved/exported models (ADR-0013).
function the bim resident display tolerance:
    replacement:
        0.0001
