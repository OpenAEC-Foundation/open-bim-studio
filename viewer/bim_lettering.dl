# SPDX-License-Identifier: MPL-2.0
# How much room lettering takes on a drawing, measured from the glyphs of
# the faces a drawing is lettered in: osifont (the drawing face on screen,
# on a sheet on screen and in SVG) and Helvetica (PDF). Every size here is in
# ems, the face's font size: a dimension's value 2.5 mm high on paper is
# lettered at a font size of 2.5 mm (`the bim paper text height`). And the
# boxes lettering and symbols take, with the tests that keep them apart.
import kernel/core/core.dl
import lib/string.dl

# The advance widths of the printable ASCII characters (32 to 126), four
# digits each in thousandths of an em. Osifont's from its `hmtx` table
# (ui/shell/fonts/osifont.ttf, 2048 units to the em); Helvetica's from its
# AFM metrics (URW Nimbus Sans, metrically identical), both measured
# 6 November 2026.
local function the bim osifont advances:
    replacement:
        ""

local function the bim helvetica advances:
    replacement:
        ""

# The faces lettering is measured in: osifont, Helvetica, or the wider of
# the two glyph by glyph, which a layout that must hold in every output
# measures.
function bim osifont lettering:
    replacement:
        0
function bim helvetica lettering:
    replacement:
        1
function bim widest lettering:
    replacement:
        2

# How high digits and capitals stand above the baseline, in ems: osifont's
# are 1515 units of 2048 (0.740), Helvetica's 0.729.
function the bim lettering top:
    replacement:
        0.74

# How far g, p, y, a comma or a bracket reach below the baseline, in ems:
# osifont's g 456 units of 2048 (0.223), Helvetica's 0.218.
function the bim lettering descent:
    replacement:
        0.23

local function the bim advance at {integer:slot} of {C string:table}:
    execute:
        set total to 0
        loop digitCursor from 0 to 4:
            set digitCode to ((the character at ((slot * 4) + digitCursor) in table) as an integer) bitwise and 255
            set total to (total * 10) + (digitCode - 48)
        return total

# The advance of the printable ASCII character `code` in `faceCode`
# (`bim osifont lettering` and the others), in thousandths of an em.
function the bim lettering advance of character {integer:code} in face {integer:faceCode}:
    execute:
        if (code < 32) or (code > 126):
            return 0
        set osifontAdvance to the bim advance at (code - 32) of (the bim osifont advances)
        set helveticaAdvance to the bim advance at (code - 32) of (the bim helvetica advances)
        if faceCode = (bim osifont lettering):
            return osifontAdvance
        if faceCode = (bim helvetica lettering):
            return helveticaAdvance
        return the maximum of osifontAdvance and helveticaAdvance

# The advance of a two-byte UTF-8 character, lead byte `leadByte` and
# second byte `trailByte`: the diameter signs and the superscript two and three as
# measured; any other is taken as wide as a capital O (0.778 em).
local function the bim lettering advance of the pair {integer:leadByte} and {integer:trailByte} in face {integer:faceCode}:
    execute:
        set osifontAdvance to 778
        set helveticaAdvance to 778
        if (leadByte = 195) and (trailByte = 152):
            set osifontAdvance to 591
        if (leadByte = 195) and (trailByte = 184):
            set osifontAdvance to 545
            set helveticaAdvance to 611
        if (leadByte = 194) and ((trailByte = 178) or (trailByte = 179)):
            set osifontAdvance to 328
            set helveticaAdvance to 333
        if faceCode = (bim osifont lettering):
            return osifontAdvance
        if faceCode = (bim helvetica lettering):
            return helveticaAdvance
        return the maximum of osifontAdvance and helveticaAdvance

# How wide `message` is lettered in `faceCode`, in ems: the sum of its
# characters' advances (no kerning: neither output kerns).
function the bim lettering width of {a string:message} in face {integer:faceCode}:
    execute:
        set total to 0
        set byteCount to the length of message
        loop byteCursor from 0 to byteCount:
            set octet to ((the character at byteCursor in message) as an integer) bitwise and 255
            if octet < 128:
                set total to total + (the bim lettering advance of character octet in face faceCode)
            else if octet >= 192:
                set trailing to 0
                if (byteCursor + 1) < byteCount:
                    set trailing to ((the character at (byteCursor + 1) in message) as an integer) bitwise and 255
                set total to total + (the bim lettering advance of the pair octet and trailing in face faceCode)
        return (total as a 64 bit floating-point number) / 1000.0

# How far `message` reaches below its baseline, in ems: none for digits,
# capitals and the signs of a measure, `the bim lettering descent` when it
# holds a descending letter, a comma, a bracket or a character beyond ASCII.
function the bim lettering depth of {a string:message}:
    execute:
        set descending to false
        loop byteCursor from 0 to the length of message:
            set octet to ((the character at byteCursor in message) as an integer) bitwise and 255
            if octet >= 128:
                set descending to true
            if ((((octet = 103) or (octet = 106)) or ((octet = 112) or (octet = 113))) or ((octet = 121) or (octet = 81))) or (((octet = 44) or (octet = 59)) or ((octet = 40) or (octet = 41))):
                set descending to true
            if (((octet = 91) or (octet = 93)) or ((octet = 123) or (octet = 125))) or (((octet = 124) or (octet = 95)) or ((octet = 64) or (octet = 36))):
                set descending to true
        if descending:
            return the bim lettering descent
        return 0.0

# A box on a drawing: a rectangle around `centre`, turned `angle` (radians,
# canvas y down), reaching `halfAlong` either way along that angle and
# `halfAcross` either way square to it. Lettering stands in one, and so do
# the symbols lettering keeps clear of.
class:
    patterns:
        [a|] bim lettering box record
    members:
        centre as a cad vector2
        angle as a 64 bit floating-point number
        halfAlong as a 64 bit floating-point number
        halfAcross as a 64 bit floating-point number

function a bim lettering box around {cad vector2:middle} turned {a 64 bit floating-point number:turn} reaching {a 64 bit floating-point number:alongReach} by {a 64 bit floating-point number:acrossReach}:
    execute:
        return @intrinsic("construct", a bim lettering box record, middle, turn, alongReach, acrossReach)

# The box of a line of lettering whose baseline's middle is `spot`, turned
# `turn`: `halfWidth` either way along it, from `depth` below the baseline
# to `top` above it (above is the reading side: canvas y is down).
function the bim lettering box of a baseline at {cad vector2:spot} turned {a 64 bit floating-point number:turn} reaching {a 64 bit floating-point number:halfWidth} from {a 64 bit floating-point number:depth} below to {a 64 bit floating-point number:top} above:
    execute:
        set upX to the sine of turn
        set upY to 0.0 - (the cosine of turn)
        set rise to (top - depth) * 0.5
        return a bim lettering box around (a cad vector2 with x (spot's x + (upX * rise)) and y (spot's y + (upY * rise))) turned turn reaching halfWidth by ((top + depth) * 0.5)

# `original` grown by `alongMargin` at either end and `acrossMargin` at either side.
function the bim lettering box {bim lettering box record:original} grown by {a 64 bit floating-point number:alongMargin} and {a 64 bit floating-point number:acrossMargin}:
    execute:
        return a bim lettering box around original's centre turned original's angle reaching (original's halfAlong + alongMargin) by (original's halfAcross + acrossMargin)

# How far `measured` reaches along the unit direction `axisX`, `axisY` from its
# centre.
local function the bim reach of {bim lettering box record:measured} along {a 64 bit floating-point number:axisX} and {a 64 bit floating-point number:axisY}:
    execute:
        set alongX to the cosine of measured's angle
        set alongY to the sine of measured's angle
        set alongPart to measured's halfAlong * (the absolute value of ((alongX * axisX) + (alongY * axisY)))
        set acrossPart to measured's halfAcross * (the absolute value of ((alongY * axisX) - (alongX * axisY)))
        return alongPart + acrossPart

# Whether `placed` and `other` share any area: neither of the four axes of the
# two boxes separates them.
function bim lettering box {bim lettering box record:placed} overlaps {bim lettering box record:other}:
    execute:
        set dx to other's centre's x - placed's centre's x
        set dy to other's centre's y - placed's centre's y
        set placedRadius to (placed's halfAlong + placed's halfAcross)
        set otherRadius to (other's halfAlong + other's halfAcross)
        if (the absolute value of dx) > (placedRadius + otherRadius):
            return false
        if (the absolute value of dy) > (placedRadius + otherRadius):
            return false
        set separated to false
        loop axisCursor from 0 to 4:
            set axisTurn to placed's angle
            if axisCursor >= 2:
                set axisTurn to other's angle
            set axisX to the cosine of axisTurn
            set axisY to the sine of axisTurn
            if (the remainder of axisCursor divided by 2) = 1:
                set axisX to the sine of axisTurn
                set axisY to 0.0 - (the cosine of axisTurn)
            set apart to the absolute value of ((dx * axisX) + (dy * axisY))
            if apart >= ((the bim reach of placed along axisX and axisY) + (the bim reach of other along axisX and axisY)):
                set separated to true
        return separated = false

# Whether the segment from `first` to `last` passes through `placed`: neither
# the box's two axes nor the segment's normal separates them.
function bim lettering box {bim lettering box record:placed} meets the segment from {cad vector2:first} to {cad vector2:last}:
    execute:
        set bound to placed's halfAlong + placed's halfAcross
        if ((first's x < (placed's centre's x - bound)) and (last's x < (placed's centre's x - bound))) or ((first's x > (placed's centre's x + bound)) and (last's x > (placed's centre's x + bound))):
            return false
        if ((first's y < (placed's centre's y - bound)) and (last's y < (placed's centre's y - bound))) or ((first's y > (placed's centre's y + bound)) and (last's y > (placed's centre's y + bound))):
            return false
        set alongX to the cosine of placed's angle
        set alongY to the sine of placed's angle
        set firstX to first's x - placed's centre's x
        set firstY to first's y - placed's centre's y
        set lastX to last's x - placed's centre's x
        set lastY to last's y - placed's centre's y
        # Along the box.
        set firstAlong to (firstX * alongX) + (firstY * alongY)
        set lastAlong to (lastX * alongX) + (lastY * alongY)
        if ((the minimum of firstAlong and lastAlong) >= placed's halfAlong) or ((the maximum of firstAlong and lastAlong) <= (0.0 - placed's halfAlong)):
            return false
        # Across it.
        set firstAcross to (firstX * alongY) - (firstY * alongX)
        set lastAcross to (lastX * alongY) - (lastY * alongX)
        if ((the minimum of firstAcross and lastAcross) >= placed's halfAcross) or ((the maximum of firstAcross and lastAcross) <= (0.0 - placed's halfAcross)):
            return false
        # Square to the segment.
        set runX to last's x - first's x
        set runY to last's y - first's y
        set run to the square root of ((runX * runX) + (runY * runY))
        if run <= 1e-12:
            return true
        set normalX to (0.0 - runY) / run
        set normalY to runX / run
        set normalGap to the absolute value of ((firstX * normalX) + (firstY * normalY))
        return normalGap < (the bim reach of placed along normalX and normalY)
