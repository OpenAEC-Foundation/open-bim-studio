# SPDX-License-Identifier: MPL-2.0
# Conservative mesh candidates for repeated rays through an unchanged scene.
import viewer/bim_scene.dl

class:
    patterns:
        [a|] bim ray bounds record
    members:
        low as a cad vector3
        high as a cad vector3

function the bim ray bounds of {a pointer to a list:sceneMeshes}:
    execute:
        set result to a cad topology list of a bim ray bounds record
        set infinity to 1.0 / 0.0
        loop meshCursor from 0 to the length of sceneMeshes:
            set low to a cad vector3 with x infinity, y infinity and z infinity
            set high to a cad vector3 with x (0.0 - infinity), y (0.0 - infinity) and z (0.0 - infinity)
            set points to (the item at meshCursor in sceneMeshes)'s shape's positions's values
            loop vertexCursor from 0 to the length of points:
                set point to the item at vertexCursor in points
                set low to a cad vector3 with x (the minimum of low's x and point's x), y (the minimum of low's y and point's y) and z (the minimum of low's z and point's z)
                set high to a cad vector3 with x (the maximum of high's x and point's x), y (the maximum of high's y and point's y) and z (the maximum of high's z and point's z)
            append (@intrinsic("construct", a bim ray bounds record, low, high)) to (result's values)
        return result

# Inclusive slab intersections retain grazing and zero-thickness candidates.
# The final triangle/opening/space picker still determines the exact answer.
function bim ray {bim ray record:sight} meets {bim ray bounds record:bounds} before {a 64 bit floating-point number:limit}:
    execute:
        set entering to 0.0
        set leaving to limit
        loop axis from 0 to 3:
            set low to (the bim coordinate axis of bounds's low) - 1e-7
            set high to (the bim coordinate axis of bounds's high) + 1e-7
            if high < low:
                return false
            set origin to the bim coordinate axis of sight's origin
            set direction to the bim coordinate axis of sight's direction
            if direction = 0.0:
                if (origin < low) or (origin > high):
                    return false
            else:
                set first to (low - origin) / direction
                set second to (high - origin) / direction
                set entering to the maximum of entering and (the minimum of first and second)
                set leaving to the minimum of leaving and (the maximum of first and second)
                if leaving < entering:
                    return false
        return leaving >= entering

function the bim ray candidates along {bim ray record:sight} before {a 64 bit floating-point number:limit} among {a pointer to a list:sceneMeshes} bounded by {a pointer to a list:bounds}:
    execute:
        set result to a cad topology list of a bim scene mesh record
        # Missing bounds or a count mismatch conservatively retain the scene.
        set matched to (the length of bounds) = (the length of sceneMeshes)
        loop meshCursor from 0 to the length of sceneMeshes:
            set keep to true
            if matched:
                set keep to bim ray sight meets (the item at meshCursor in bounds) before limit
            if keep:
                append (the item at meshCursor in sceneMeshes) to (result's values)
        return result
