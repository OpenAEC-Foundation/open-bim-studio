# SPDX-License-Identifier: MPL-2.0
# Conservative mesh candidates for repeated rays through an unchanged scene.
import viewer/bim_scene.dl

class:
    patterns:
        [a|] bim ray bounds record
    members:
        low as a cad vector3
        high as a cad vector3

function the bim ray bounds of {a pointer to a list:sceneMeshes}:
    execute:
        set unmeasured to empty bim mesh extents
        return the bim ray bounds of sceneMeshes knowing (the address of unmeasured)

# The same, the bounds of the meshes `extents` holds taken from it.
function the bim ray bounds of {a pointer to a list:sceneMeshes} knowing {a pointer to a bim mesh extents record:extents}:
    execute:
        set result to a cad topology list of a bim ray bounds record
        set infinity to 1.0 / 0.0
        loop meshCursor from 0 to the length of sceneMeshes:
            set sceneMesh to the item at meshCursor in sceneMeshes
            set slot to the bim known extent of sceneMesh in extents
            if slot >= 0:
                append (@intrinsic("construct", a bim ray bounds record, the item at slot in (extents's lows's values), the item at slot in (extents's highs's values))) to (result's values)
            else:
                set lowX to infinity
                set lowY to infinity
                set lowZ to infinity
                set highX to 0.0 - infinity
                set highY to 0.0 - infinity
                set highZ to 0.0 - infinity
                set points to sceneMesh's shape's positions's values
                loop vertexCursor from 0 to the length of points:
                    set point to the item at vertexCursor in points
                    if point's x < lowX:
                        set lowX to point's x
                    if point's x > highX:
                        set highX to point's x
                    if point's y < lowY:
                        set lowY to point's y
                    if point's y > highY:
                        set highY to point's y
                    if point's z < lowZ:
                        set lowZ to point's z
                    if point's z > highZ:
                        set highZ to point's z
                set low to a cad vector3 with x lowX, y lowY and z lowZ
                set high to a cad vector3 with x highX, y highY and z highZ
                append (@intrinsic("construct", a bim ray bounds record, low, high)) to (result's values)
        return result

# Inclusive slab intersections retain grazing and zero-thickness candidates.
# The final triangle/opening/space picker still determines the exact answer.
function bim ray {bim ray record:sight} meets {bim ray bounds record:bounds} before {a 64 bit floating-point number:limit}:
    execute:
        return bim ray sight meets bounds widened by 0.0 before limit

# The same with the box `reach` wider on every side: what a ray passing
# within `reach` of a mesh of lines needs.
function bim ray {bim ray record:sight} meets {bim ray bounds record:bounds} widened by {a 64 bit floating-point number:reach} before {a 64 bit floating-point number:limit}:
    execute:
        set entering to 0.0
        set leaving to limit
        loop axis from 0 to 3:
            set low to ((the bim coordinate axis of bounds's low) - reach) - 1e-7
            set high to ((the bim coordinate axis of bounds's high) + reach) + 1e-7
            if high < low:
                return false
            set origin to the bim coordinate axis of sight's origin
            set direction to the bim coordinate axis of sight's direction
            if direction = 0.0:
                if (origin < low) or (origin > high):
                    return false
            else:
                set first to (low - origin) / direction
                set second to (high - origin) / direction
                set entering to the maximum of entering and (the minimum of first and second)
                set leaving to the minimum of leaving and (the maximum of first and second)
                if leaving < entering:
                    return false
        return leaving >= entering

function the bim ray candidates along {bim ray record:sight} before {a 64 bit floating-point number:limit} among {a pointer to a list:sceneMeshes} bounded by {a pointer to a list:bounds}:
    execute:
        set result to a cad topology list of a bim scene mesh record
        # Missing bounds or a count mismatch conservatively retain the scene.
        set matched to (the length of bounds) = (the length of sceneMeshes)
        loop meshCursor from 0 to the length of sceneMeshes:
            set keep to true
            if matched:
                set keep to bim ray sight meets (the item at meshCursor in bounds) before limit
            if keep:
                append (the item at meshCursor in sceneMeshes) to (result's values)
        return result

# A balanced hierarchy over consecutive mesh ranges. Its leaves retain scene
# order, so the exact picker keeps its existing tie behavior. Spatially coherent
# ranges can be skipped together; interleaved scenes conservatively do more work.
class:
    patterns:
        [a|] bim ray bounds node record
    members:
        bounds as a bim ray bounds record
        left as an integer
        right as an integer
        mesh as an integer

class:
    patterns:
        [a|] bim ray index record
    members:
        nodes as the type of (a cad topology list of a bim ray bounds node record)
        root as an integer
        meshCount as an integer

function an empty bim ray index:
    execute:
        return @intrinsic("construct", a bim ray index record, a cad topology list of a bim ray bounds node record, -1, 0)

function the bim ray bounds {bim ray bounds record:firstBounds} combined with {bim ray bounds record:secondBounds}:
    execute:
        set low to a cad vector3 with x (the minimum of firstBounds's low's x and secondBounds's low's x), y (the minimum of firstBounds's low's y and secondBounds's low's y) and z (the minimum of firstBounds's low's z and secondBounds's low's z)
        set high to a cad vector3 with x (the maximum of firstBounds's high's x and secondBounds's high's x), y (the maximum of firstBounds's high's y and secondBounds's high's y) and z (the maximum of firstBounds's high's z and secondBounds's high's z)
        return @intrinsic("construct", a bim ray bounds record, low, high)

function the bim ray index of {a pointer to a list:bounds}:
    execute:
        set indexValue to an empty bim ray index
        set indexValue's meshCount to the length of bounds
        set level to an empty list of an integer
        loop cursor from 0 to the length of bounds:
            append cursor to level
            append (@intrinsic("construct", a bim ray bounds node record, the item at cursor in bounds, -1, -1, cursor)) to (indexValue's nodes's values)
        loop while (the length of level) > 1:
            set nextLevel to an empty list of an integer
            set cursor to 0
            loop while cursor < (the length of level):
                set left to the item at cursor in level
                if (cursor + 1) < (the length of level):
                    set right to the item at (cursor + 1) in level
                    set leftNode to the item at left in (indexValue's nodes's values)
                    set rightNode to the item at right in (indexValue's nodes's values)
                    set joined to the bim ray bounds leftNode's bounds combined with rightNode's bounds
                    append (the length of (indexValue's nodes's values)) to nextLevel
                    append (@intrinsic("construct", a bim ray bounds node record, joined, left, right, -1)) to (indexValue's nodes's values)
                else:
                    append left to nextLevel
                set cursor to cursor + 2
            free level
            set level to nextLevel
        if (the length of level) = 1:
            set indexValue's root to the item at 0 in level
        free level
        return indexValue

function the bim ray candidates along {bim ray record:sight} before {a 64 bit floating-point number:limit} among {a pointer to a list:sceneMeshes} indexed by {bim ray index record:indexValue}:
    execute:
        return the bim ray candidates along sight before limit among sceneMeshes indexed by indexValue reaching 0.0

# The same, keeping the meshes the ray passes within `reach` of: the
# candidates of a pick that reaches lines (`the bim pick along … reaching
# lines within …`). An index of another count of meshes keeps them all.
function the bim ray candidates along {bim ray record:sight} before {a 64 bit floating-point number:limit} among {a pointer to a list:sceneMeshes} indexed by {bim ray index record:indexValue} reaching {a 64 bit floating-point number:reach}:
    execute:
        if indexValue's meshCount != (the length of sceneMeshes):
            set noBounds to a cad topology list of a bim ray bounds record
            return the bim ray candidates along sight before limit among sceneMeshes bounded by (noBounds's values)
        set result to a cad topology list of a bim scene mesh record
        set pending to an empty list of an integer
        if indexValue's root >= 0:
            append indexValue's root to pending
        loop while (the length of pending) > 0:
            set last to (the length of pending) - 1
            set nodeIndex to the item at last in pending
            remove item last from pending
            set node to the item at nodeIndex in (indexValue's nodes's values)
            if bim ray sight meets node's bounds widened by reach before limit:
                if node's mesh >= 0:
                    append (the item at node's mesh in sceneMeshes) to (result's values)
                else:
                    append node's right to pending
                    append node's left to pending
        free pending
        return result
