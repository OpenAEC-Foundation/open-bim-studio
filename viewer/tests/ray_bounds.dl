# SPDX-License-Identifier: MPL-2.0
import viewer/bim_ray_bounds.dl
import ui/editor/bim_editor.dl

function require ray bounds {boolean:condition}:
    execute:
        if condition = false:
            print (the string form of "FAIL: ray bounds") as a line
            @intrinsic("call", "libc", "exit", nothing, 1)

set bounds to @intrinsic("construct", a bim ray bounds record, (a cad vector3 with x 0.0, y 0.0 and z 0.0), (a cad vector3 with x 1.0, y 1.0 and z 1.0))
set forwardRay to @intrinsic("construct", a bim ray record, (a cad vector3 with x 0.5, y 0.5 and z 2.0), (a cad vector3 with x 0.0, y 0.0 and z -1.0))
require ray bounds (bim ray forwardRay meets bounds before 1.0)
require ray bounds ((bim ray forwardRay meets bounds before 0.5) = false)
set parallelMiss to @intrinsic("construct", a bim ray record, (a cad vector3 with x 2.0, y 0.5 and z 2.0), forwardRay's direction)
require ray bounds ((bim ray parallelMiss meets bounds before 100.0) = false)
set behindRay to @intrinsic("construct", a bim ray record, forwardRay's origin, (a cad vector3 with x 0.0, y 0.0 and z 1.0))
require ray bounds ((bim ray behindRay meets bounds before 100.0) = false)
set tangentRay to @intrinsic("construct", a bim ray record, (a cad vector3 with x 1.0, y 1.0 and z 2.0), forwardRay's direction)
require ray bounds (bim ray tangentRay meets bounds before 2.0)
set insideRay to @intrinsic("construct", a bim ray record, (a cad vector3 with x 0.5, y 0.5 and z 0.5), behindRay's direction)
require ray bounds (bim ray insideRay meets bounds before 0.25)
set flatBounds to @intrinsic("construct", a bim ray bounds record, bounds's low, (a cad vector3 with x 1.0, y 1.0 and z 0.0))
require ray bounds (bim ray forwardRay meets flatBounds before 2.0)
require ray bounds (bim ray parallelMiss meets bounds widened by 1.0 before 100.0)
require ray bounds ((bim ray parallelMiss meets bounds widened by 0.5 before 100.0) = false)
print (the string form of "PASS: parallel, grazing, inside, behind, flat, finite and widened rays") as a line

# Compare against the unchanged exact picker, including windows and room floors,
# near the origin and at survey coordinates. The index prunes only meshes.
loop shiftIndex from 0 to 2:
    set shift to (shiftIndex as a 64 bit floating-point number) * 500000.0
    set editor to a new bim editor
    add bim example building to (the address of editor) at (a cad vector2 with x shift and y shift)
    refresh bim editor (the address of editor)
    set noPrevious to a cad topology list of a bim scene mesh record
    set meshes to the bim scene meshes of editor's evaluation after (noPrevious's values)
    set indexedBounds to the bim ray bounds of (meshes's values)
    set hierarchy to the bim ray index of (indexedBounds's values)
    require ray bounds ((the length of (hierarchy's nodes's values)) = ((2 * (the length of (meshes's values))) - 1))
    set removedAny to false
    loop rayIndex from 0 to 104:
        set x to ((the remainder of rayIndex divided by 10) as a 64 bit floating-point number) - 3.0
        set y to ((rayIndex / 10) as a 64 bit floating-point number) - 3.0
        set sight to @intrinsic("construct", a bim ray record, (a cad vector3 with x (shift + x), y (shift + y) and z 10.0), forwardRay's direction)
        if rayIndex >= 100:
            set height to 1.5
            if rayIndex = 101:
                set height to 0.5
            set direction to a cad vector3 with x 0.0, y 1.0 and z 0.0
            if rayIndex = 102:
                set direction to a cad vector3 with x 0.0, y 0.6 and z 0.8
            if rayIndex = 103:
                set direction to a cad vector3 with x 0.0, y -1.0 and z 0.0
            set sight to @intrinsic("construct", a bim ray record, (a cad vector3 with x (shift + 0.5), y (shift - 10.0) and z height), direction)
        set exact to the bim pick along sight among (meshes's values) in editor's documentValue's current with (editor's spaces's values)
        set candidates to the bim ray candidates along sight before 100.0 among (meshes's values) bounded by (indexedBounds's values)
        set grouped to the bim ray candidates along sight before 100.0 among (meshes's values) indexed by hierarchy
        require ray bounds ((the length of (grouped's values)) = (the length of (candidates's values)))
        loop candidateCursor from 0 to the length of (candidates's values):
            require ray bounds ((the item at candidateCursor in (grouped's values))'s elementId = (the item at candidateCursor in (candidates's values))'s elementId)
            require ray bounds ((the item at candidateCursor in (grouped's values))'s part = (the item at candidateCursor in (candidates's values))'s part)
        if (the length of (candidates's values)) < (the length of (meshes's values)):
            set removedAny to true
        set filtered to the bim pick along sight among (grouped's values) in editor's documentValue's current with (editor's spaces's values)
        require ray bounds ((exact's kind = filtered's kind) and (exact's id = filtered's id))
        if exact's kind != bim nothing picked:
            require ray bounds ((the absolute value of (exact's distance - filtered's distance)) < 1e-7)
        # A pick reaching lines sees the same through the widened candidates.
        set reaching to the bim pick along sight among (meshes's values) in editor's documentValue's current with (editor's spaces's values) reaching lines within 0.05
        set widened to the bim ray candidates along sight before (1.0 / 0.0) among (meshes's values) indexed by hierarchy reaching 0.05
        set reached to the bim pick along sight among (widened's values) in editor's documentValue's current with (editor's spaces's values) reaching lines within 0.05
        require ray bounds ((reaching's kind = reached's kind) and (reaching's id = reached's id))
        set nearCandidates to the bim ray candidates along sight before 8.0 among (meshes's values) bounded by (indexedBounds's values)
        set nearGrouped to the bim ray candidates along sight before 8.0 among (meshes's values) indexed by hierarchy
        require ray bounds ((the length of (nearGrouped's values)) = (the length of (nearCandidates's values)))
        set nearPick to the bim pick along sight among (nearGrouped's values) in editor's documentValue's current with (editor's spaces's values)
        require ray bounds ((exact's distance < 8.0) = (nearPick's distance < 8.0))
    require ray bounds removedAny
    set noBounds to a cad topology list of a bim ray bounds record
    set fallback to the bim ray candidates along forwardRay before 1.0 among (meshes's values) bounded by (noBounds's values)
    require ray bounds ((the length of (fallback's values)) = (the length of (meshes's values)))
    set fallback to the bim ray candidates along forwardRay before 1.0 among (meshes's values) indexed by (an empty bim ray index)
    require ray bounds ((the length of (fallback's values)) = (the length of (meshes's values)))
print (the string form of "PASS: 208 exact picks agree near and 500 km away; missing bounds fall back") as a line
set noMeshes to a cad topology list of a bim scene mesh record
set emptyCandidates to the bim ray candidates along forwardRay before 1.0 among (noMeshes's values) indexed by (an empty bim ray index)
require ray bounds ((the length of (emptyCandidates's values)) = 0)
print (the string form of "PASS: bounds hierarchy preserves candidate order and finite clipping; empty and stale counts are safe") as a line
