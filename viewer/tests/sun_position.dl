# SPDX-License-Identifier: MPL-2.0
# The sun of the 3D view (issue #113): its position by the NOAA equations,
# checked against the Astronomical Almanac's low-precision formulas (worked
# out separately, to 0.01 degree), its direction, and the setting's steps.
import viewer/bim_sun.dl

function check sun {boolean:passed} named {a string:caption}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function the sun at {cad vector2:angles} is near azimuth {a 64 bit floating-point number:turn} and altitude {a 64 bit floating-point number:rise}:
    execute:
        return ((the absolute value of (angles's x - turn)) < 0.05) and ((the absolute value of (angles's y - rise)) < 0.05)

set noon to the bim sun position at latitude 52.1 longitude 5.1 for date 21 month 6 year 2026 at 820.0 offset 2.0
check sun (the sun at noon is near azimuth 179.320 and altitude 61.334) named (the string form of "midsummer noon in the Netherlands")
set afternoon to the bim sun position at latitude 52.1 longitude 5.1 for date 21 month 6 year 2026 at 840.0 offset 2.0
check sun (the sun at afternoon is near azimuth 188.845 and altitude 61.115) named (the string form of "twenty minutes later the sun has turned west")
set winter to the bim sun position at latitude 52.1 longitude 5.1 for date 21 month 12 year 2026 at 760.0 offset 1.0
check sun (the sun at winter is near azimuth 180.555 and altitude 14.464) named (the string form of "midwinter noon stands low")
set equator to the bim sun position at latitude 0.0 longitude 0.0 for date 20 month 3 year 2026 at 720.0 offset 0.0
check sun (the sun at equator is near azimuth 91.334 and altitude 88.134) named (the string form of "the equinox at the equator is near the zenith")
set night to the bim sun position at latitude 52.1 longitude 5.1 for date 21 month 6 year 2026 at 0.0 offset 2.0
check sun (the sun at night is near azimuth 336.409 and altitude -11.282) named (the string form of "midnight is below the horizon")
set south to the bim sun position at latitude -33.9 longitude 151.2 for date 15 month 1 year 2026 at 540.0 offset 11.0
check sun (the sun at south is near azimuth 93.395 and altitude 35.135) named (the string form of "a southern summer morning")
set west to the bim sun position at latitude 40.7 longitude -74.0 for date 1 month 9 year 2026 at 1020.0 offset -4.0
check sun (the sun at west is near azimuth 256.571 and altitude 27.046) named (the string form of "a western afternoon")

# The fixed sun keeps the 3D view's old direction (-0.52, -0.58, 0.62).
set setting to the bim default sun setting
set toward to the bim direction toward the sun of setting
check sun (((the absolute value of (toward's x + 0.5223)) < 0.002) and (((the absolute value of (toward's y + 0.5826)) < 0.002) and ((the absolute value of (toward's z - 0.6227)) < 0.002))) named (the string form of "the default sun is the old one")
check sun (the bim sun of setting is up) named (the string form of "the default sun is up")
print (the bim sun summary of setting) as a line

# Steps: the angles wrap or stop, the date rolls over, the time wraps.
step bim sun (bim sun azimuth field) up true in (the address of setting)
step bim sun (bim sun azimuth field) up true in (the address of setting)
check sun ((the bim sun text of field (bim sun azimuth field) in setting) = (the string form of "251.9 deg")) named (the string form of "the azimuth steps 15 degrees")
loop stepCursor from 0 to 12:
    step bim sun (bim sun altitude field) up true in (the address of setting)
check sun ((the bim sun text of field (bim sun altitude field) in setting) = (the string form of "90.0 deg")) named (the string form of "the altitude stops at the zenith")
set setting's byLocation to true
loop stepCursor from 0 to 10:
    step bim sun (bim sun day field) up true in (the address of setting)
check sun ((the bim sun text of field (bim sun month field) in setting) = (the string form of "July")) named (the string form of "the days roll into the next month")
check sun ((the bim sun text of field (bim sun day field) in setting) = (the string form of "1")) named (the string form of "June has thirty days")
step bim sun (bim sun day field) up false in (the address of setting)
check sun (((the bim sun text of field (bim sun month field) in setting) = (the string form of "June")) and ((the bim sun text of field (bim sun day field) in setting) = (the string form of "30"))) named (the string form of "and back")
loop stepCursor from 0 to 23:
    step bim sun (bim sun time field) up true in (the address of setting)
check sun ((the bim sun text of field (bim sun time field) in setting) = (the string form of "01:30")) named (the string form of "the time wraps past midnight")
check sun ((the bim sun of setting is up) = false) named (the string form of "half past one at night has no sun")
print (the bim sun summary of setting) as a line
loop stepCursor from 0 to 60:
    step bim sun (bim sun longitude field) up false in (the address of setting)
check sun ((the bim sun text of field (bim sun longitude field) in setting) = (the string form of "54.9 W")) named (the string form of "the longitude runs west")
step bim sun (bim sun offset field) up false in (the address of setting)
step bim sun (bim sun offset field) up false in (the address of setting)
step bim sun (bim sun offset field) up false in (the address of setting)
check sun ((the bim sun text of field (bim sun offset field) in setting) = (the string form of "UTC-1.0")) named (the string form of "the clock's offset steps an hour")
set setting's month to 2
set setting's day to 31
step bim sun (bim sun month field) up false in (the address of setting)
step bim sun (bim sun month field) up true in (the address of setting)
check sun ((the bim sun text of field (bim sun day field) in setting) = (the string form of "28")) named (the string form of "February keeps the day inside the month")
