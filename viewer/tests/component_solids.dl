# SPDX-License-Identifier: MPL-2.0
# Components modelled as B-reps: CSG parts (box, cylinder, sphere, extrusion)
# added, subtracted and intersected in order, together with push/pulled
# sketch faces, folded by the cadkernel's exact booleans; volumes checked
# against their closed forms, instances placed in the 3D scene, and the parts
# kept through .bim and .ifcx; then how many corners a round profile gets
# for a level of detail.
import elements/object/bim_component.dl
import viewer/bim_scene.dl
import exchange/ifcx/bim_file.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl

function show component volume {a 64 bit integer:wanted} of {bim model record:modelValue} expecting {a 64 bit floating-point number:expected} labelled {a string:title}:
    execute:
        set found to the bim component index of wanted in modelValue
        if found's valid = false:
            print (title + (the string form of ": missing")) as a line
            return nothing
        set definition to the item at found's position in (modelValue's components's values)
        set folded to the bim brep of component definition within 1e-9
        set measured to the bim volume of component definition
        set close to (the absolute value of (measured - expected)) <= (expected * 0.002)
        print ((title + (the string form of ": status ")) + ((the string form of folded's status) + ((the string form of ", parts ") + ((the string form of (the length of (definition's solids's values))) + ((the string form of ", volume as expected ") + (the string form of close)))))) as a line
        if close = false:
            print ((the string form of "  measured ") + ((the string form of measured) + ((the string form of ", expected ") + (the string form of expected)))) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground floor") at 1.0 with height 3.0 to target
set noProfile to an empty list of a cad vector2
set pi to 3.14159265358979

# A 2 x 1 x 1 block with a hole of radius 0.25 through it.
set block to add bim component named (the string form of "Blok") to target
print (the string form of (add bim solid of kind bim box solid as bim add operation at (a cad vector3 with x 0.0, y 0.0 and z 0.0) sized (a cad vector3 with x 2.0, y 1.0 and z 1.0) turned 0.0 along noProfile of (the string form of "concrete") to component block in target)) as a line
print (the string form of (add bim solid of kind bim cylinder solid as bim subtract operation at (a cad vector3 with x 1.0, y 0.5 and z 0.0) sized (a cad vector3 with x 0.25, y 0.0 and z 1.0) turned 0.0 along noProfile of (the string form of "concrete") to component block in target)) as a line
show component volume block of modelValue expecting (2.0 - (pi * 0.0625)) labelled (the string form of "block with hole")

# A triangle of 2 x 2 extruded 1 high, a 0.5 square notch cut from it.
set wedge to add bim component named (the string form of "Wig") to target
set triangle to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to triangle
append (a cad vector2 with x 2.0 and y 0.0) to triangle
append (a cad vector2 with x 0.0 and y 2.0) to triangle
ignore add bim solid of kind bim extrusion solid as bim add operation at (a cad vector3 with x 0.0, y 0.0 and z 0.0) sized (a cad vector3 with x 1.0, y 1.0 and z 1.0) turned 0.0 along triangle of (the string form of "timber") to component wedge in target
ignore add bim solid of kind bim box solid as bim subtract operation at (a cad vector3 with x 0.5, y -0.25 and z 0.0) sized (a cad vector3 with x 0.5, y 0.5 and z 1.0) turned 0.0 along noProfile of (the string form of "timber") to component wedge in target
show component volume wedge of modelValue expecting 1.875 labelled (the string form of "wedge with notch")

# Two boxes overlapping in a unit cube, kept by intersection; then a box
# turned 45 degrees.
set common to add bim component named (the string form of "Doorsnede") to target
ignore add bim solid of kind bim box solid as bim add operation at (a cad vector3 with x 0.0, y 0.0 and z 0.0) sized (a cad vector3 with x 2.0, y 2.0 and z 1.0) turned 0.0 along noProfile of (the string form of "steel") to component common in target
ignore add bim solid of kind bim box solid as bim intersect operation at (a cad vector3 with x 1.0, y 1.0 and z -0.5) sized (a cad vector3 with x 2.0, y 2.0 and z 2.0) turned 0.0 along noProfile of (the string form of "steel") to component common in target
show component volume common of modelValue expecting 1.0 labelled (the string form of "intersection")
set rotated to add bim component named (the string form of "Gedraaid") to target
ignore add bim solid of kind bim box solid as bim add operation at (a cad vector3 with x 0.0, y 0.0 and z 0.0) sized (a cad vector3 with x 1.0, y 0.5 and z 2.0) turned (pi / 4.0) along noProfile of (the string form of "steel") to component rotated in target
show component volume rotated of modelValue expecting 1.0 labelled (the string form of "turned box")

# A sphere of radius 0.5 on its own.
set ball to add bim component named (the string form of "Bol") to target
ignore add bim solid of kind bim sphere solid as bim add operation at (a cad vector3 with x 0.0, y 0.0 and z 0.5) sized (a cad vector3 with x 0.5, y 0.0 and z 0.0) turned 0.0 along noProfile of (the string form of "steel") to component ball in target
show component volume ball of modelValue expecting ((4.0 / 3.0) * (pi * 0.125)) labelled (the string form of "sphere")

# Refused: a sphere without a radius, a part of a missing component.
print (the string form of (add bim solid of kind bim sphere solid as bim add operation at (a cad vector3 with x 0.0, y 0.0 and z 0.0) sized (a cad vector3 with x 0.0, y 0.0 and z 0.0) turned 0.0 along noProfile of (the string form of "steel") to component ball in target)) as a line
print (the string form of (add bim solid of kind bim box solid as bim add operation at (a cad vector3 with x 0.0, y 0.0 and z 0.0) sized (a cad vector3 with x 1.0, y 1.0 and z 1.0) turned 0.0 along noProfile of (the string form of "steel") to component (9999 as a 64 bit integer) in target)) as a line

# SketchUp-style: a 3 x 3 face pushed up 2 m becomes a component, and a
# cylinder of radius 0.5 is cut through it.
set square to an empty list of a cad vector2
append (a cad vector2 with x 10.0 and y 0.0) to square
append (a cad vector2 with x 13.0 and y 0.0) to square
append (a cad vector2 with x 13.0 and y 3.0) to square
append (a cad vector2 with x 10.0 and y 3.0) to square
set footing to add bim face on storey around square to target
ignore set bim face footing height to 2.0 in target
set chosen to an empty list of a 64 bit integer
append footing to chosen
set footInstance to make bim component named (the string form of "Kolomvoet") from chosen on storey to target
set sketched to (the item at ((the length of (modelValue's components's values)) - 1) in (modelValue's components's values))'s id
ignore add bim solid of kind bim cylinder solid as bim subtract operation at (a cad vector3 with x 1.5, y 1.5 and z 0.0) sized (a cad vector3 with x 0.5, y 0.0 and z 2.0) turned 0.0 along noProfile of (the string form of "concrete") to component sketched in target
show component volume sketched of modelValue expecting (18.0 - (pi * 0.5)) labelled (the string form of "pushed face with hole")

# The instance in the 3D scene: one mesh, at the storey, of the same volume.
set sceneMeshes to the bim sketch meshes of modelValue
loop cursor from 0 to the length of (sceneMeshes's values):
    set entry to the item at cursor in (sceneMeshes's values)
    if entry's elementId = footInstance:
        set low to 1e300
        set lowX to 1e300
        loop corner from 0 to the length of (entry's shape's positions's values):
            set low to the minimum of low and (the item at corner in (entry's shape's positions's values))'s z
            set lowX to the minimum of lowX and (the item at corner in (entry's shape's positions's values))'s x
        set close to (the absolute value of ((the absolute value of (the bim volume of mesh entry's shape)) - (18.0 - (pi * 0.5)))) < 0.05
        print ((the string form of "instance mesh: bottom ") + ((the string form of low) + ((the string form of ", west ") + ((the string form of lowX) + ((the string form of ", volume close ") + (the string form of close)))))) as a line

# Round trips.
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", ") + reread's message))) as a line
show component volume block of reread's modelValue expecting (2.0 - (pi * 0.0625)) labelled (the string form of "block from .bim")
show component volume wedge of reread's modelValue expecting 1.875 labelled (the string form of "wedge from .bim")
show component volume sketched of reread's modelValue expecting (18.0 - (pi * 0.5)) labelled (the string form of "pushed face from .bim")
set exported to the bim ifcx text of modelValue identified as (the string form of "c.ifcx") for project (the string form of "c") by (the string form of "test") at (the string form of "2026-10-09T00:00:00Z")
set native to the bim native text of ifcx exported
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of ", ") + fromIfcx's message))) as a line
show component volume rotated of fromIfcx's modelValue expecting 1.0 labelled (the string form of "turned box from .ifcx")
show component volume ball of fromIfcx's modelValue expecting ((4.0 / 3.0) * (pi * 0.125)) labelled (the string form of "sphere from .ifcx")
show component volume sketched of fromIfcx's modelValue expecting (18.0 - (pi * 0.5)) labelled (the string form of "pushed face from .ifcx")

# Level of detail: the corners a round profile of radius 0.15 gets for a
# chord tolerance of 2 mm, 0.1 mm, and none given.
print ((the string form of "round corners: ") + ((the string form of (the bim round corners for radius 0.15 within 0.002)) + ((the string form of ", ") + ((the string form of (the bim round corners for radius 0.15 within 0.0001)) + ((the string form of ", ") + (the string form of (the bim round corners for radius 0.15 within 0.0))))))) as a line

# A closed free mesh (a unit cube) taken into a component as a solid part,
# then half of it cut away by a box: Blender-style meshes and CSG together.
set cubePoints to an empty list of a cad vector3
append (a cad vector3 with x 20.0, y 0.0 and z 0.0) to cubePoints
append (a cad vector3 with x 21.0, y 0.0 and z 0.0) to cubePoints
append (a cad vector3 with x 21.0, y 1.0 and z 0.0) to cubePoints
append (a cad vector3 with x 20.0, y 1.0 and z 0.0) to cubePoints
append (a cad vector3 with x 20.0, y 0.0 and z 1.0) to cubePoints
append (a cad vector3 with x 21.0, y 0.0 and z 1.0) to cubePoints
append (a cad vector3 with x 21.0, y 1.0 and z 1.0) to cubePoints
append (a cad vector3 with x 20.0, y 1.0 and z 1.0) to cubePoints
set cubeFaces to an empty list of an integer
append 4 to cubeFaces
append 0 to cubeFaces
append 3 to cubeFaces
append 2 to cubeFaces
append 1 to cubeFaces
append 4 to cubeFaces
append 4 to cubeFaces
append 5 to cubeFaces
append 6 to cubeFaces
append 7 to cubeFaces
append 4 to cubeFaces
append 0 to cubeFaces
append 1 to cubeFaces
append 5 to cubeFaces
append 4 to cubeFaces
append 4 to cubeFaces
append 1 to cubeFaces
append 2 to cubeFaces
append 6 to cubeFaces
append 5 to cubeFaces
append 4 to cubeFaces
append 2 to cubeFaces
append 3 to cubeFaces
append 7 to cubeFaces
append 6 to cubeFaces
append 4 to cubeFaces
append 3 to cubeFaces
append 0 to cubeFaces
append 4 to cubeFaces
append 7 to cubeFaces
set cube to add bim mesh on storey with cubePoints and cubeFaces to target
set meshed to add bim component named (the string form of "Uit mesh") to target
print (the string form of (move bim mesh cube into component meshed shifted by (a cad vector3 with x -20.0, y 0.0 and z 0.0) as bim add operation in target)) as a line
print ((the string form of "free meshes left: ") + (the string form of (the length of (modelValue's meshes's values)))) as a line
show component volume meshed of modelValue expecting 1.0 labelled (the string form of "mesh part")
ignore add bim solid of kind bim box solid as bim subtract operation at (a cad vector3 with x 0.5, y -1.0 and z -1.0) sized (a cad vector3 with x 2.0, y 3.0 and z 3.0) turned 0.0 along noProfile of (the string form of "steel") to component meshed in target
show component volume meshed of modelValue expecting 0.5 labelled (the string form of "mesh part, half cut away")
set rereadMesh to the bim model parsed from (the bim file text of modelValue)
show component volume meshed of rereadMesh's modelValue expecting 0.5 labelled (the string form of "mesh part from .bim")
set nativeMesh to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "m.ifcx") for project (the string form of "m") by (the string form of "test") at (the string form of "2026-10-09T00:00:00Z"))
set fromIfcxMesh to the bim model parsed from nativeMesh's text
show component volume meshed of fromIfcxMesh's modelValue expecting 0.5 labelled (the string form of "mesh part from .ifcx")
