# SPDX-License-Identifier: MPL-2.0
# Compare retained stroke encoding with fresh fixed-width drawing geometry.
import viewer/bim_canvas.dl

function require canvas pixels {boolean:condition}:
    execute:
        if condition = false:
            print "FAIL: retained pixel geometry" as a line
            @intrinsic("call", "libc", "exit", nothing, 1)

set first to a cad vector2 with x 100.0 and y 80.0
set last to a cad vector2 with x 180.0 and y 140.0
set recorded to an empty list of a cad vector2
append bim stroke quad from first to last wide 2.0 into recorded
loop zoom from 0 to 5:
    set factor to 0.01
    if zoom = 1:
        set factor to 0.25
    if zoom = 2:
        set factor to 1.0
    if zoom = 3:
        set factor to 7.5
    if zoom = 4:
        set factor to 50.0
    set expected to an empty list of a cad vector2
    append bim stroke quad from (a cad vector2 with x ((first's x * factor) - 600.0) and y ((first's y * factor) + 30.0)) to (a cad vector2 with x ((last's x * factor) - 600.0) and y ((last's y * factor) + 30.0)) wide 2.0 into expected
    loop corner from 0 to 6:
        set pixel to the item at corner in recorded
        set anchor to the bim stroke anchor of recorded at corner
        set transformed to a cad vector2 with x (((anchor's x * factor) - 600.0) + (pixel's x - anchor's x)) and y (((anchor's y * factor) + 30.0) + (pixel's y - anchor's y))
        require canvas pixels ((the cad distance from transformed to (the item at corner in expected)) < 1e-8)
    free expected
print "PASS: retained stroke encoding matches fresh two-pixel strokes at five zoom scales" as a line
set canvas to a new bim canvas
set pairs to an empty list of a cad vector2
append first to pairs
append last to pairs
record bim strokes pairs coloured 0, 0 and 0 wide 2.0 on (the address of canvas)
record bim triangles recorded coloured 100, 100 and 100 on (the address of canvas)
require canvas pixels ((the item at 0 in (canvas's batches's values))'s stroked)
require canvas pixels (((the item at 1 in (canvas's batches's values))'s stroked) = false)
record bim centred text (the string form of "Room") at 106.0 and 74.0 coloured 0, 0 and 0 on (the address of canvas)
anchor bim canvas text since 0 at first on (the address of canvas)
set label to the item at 0 in (canvas's texts's values)
set shifted to the bim canvas text position of label scaled by 7.5 shifted by -600.0 and 30.0
require canvas pixels (((the absolute value of (shifted's x - 156.0)) < 1e-9) and ((the absolute value of (shifted's y - 624.0)) < 1e-9))
require canvas pixels ((label's message = (the string form of "Room")) and label's centred)
print "PASS: fills stay distinct and lettering keeps its local pixel offset around the model anchor" as a line
free pairs
free recorded
