# SPDX-License-Identifier: MPL-2.0
# Free meshes, as in Blender and SketchUp: Tab on a mass makes it a mesh whose
# points move in 3D (G with X, Y and Z), push/pull of its top face moves the
# face when its sides run along, a face pushed off its sides is extruded, and
# the mesh survives saving and opening as .bim and as .ifcx.
import ui/editor/bim_editor.dl

function click bim mesh test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function type bim mesh test {a string:keys} in {a pointer to a bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of keys:
            type bim editor key ((the character at cursor in keys) as an integer) in editor

function show bim mesh of {bim model record:modelValue} labelled {a string:label}:
    execute:
        if (the length of (modelValue's meshes's values)) = 0:
            print (label + (the string form of ": no mesh")) as a line
            return nothing
        set meshValue to the item at 0 in (modelValue's meshes's values)
        set triangles to the bim mesh shape of meshValue at 0.0
        set high to 0.0
        loop cursor from 0 to the length of (meshValue's vertices's values):
            set high to the maximum of high and (the item at cursor in (meshValue's vertices's values))'s z
        set line to (label + (the string form of ": ")) + ((the string form of (the length of (meshValue's vertices's values))) + (the string form of " points, "))
        set line to line + ((the string form of (the bim face count of mesh meshValue)) + (the string form of " faces, volume "))
        set line to line + ((the string form of (the absolute value of (the bim volume of mesh triangles))) + ((the string form of ", top ") + (the string form of high)))
        print line as a line

function list bim meshes of {bim model record:modelValue} labelled {a string:label}:
    execute:
        print (label + (the string form of ":")) as a line
        loop cursor from 0 to the length of (modelValue's meshes's values):
            set meshValue to the item at cursor in (modelValue's meshes's values)
            set low to 1.0 / 0.0
            set south to 1.0 / 0.0
            loop corner from 0 to the length of (meshValue's vertices's values):
                set low to the minimum of low and (the item at corner in (meshValue's vertices's values))'s x
                set south to the minimum of south and (the item at corner in (meshValue's vertices's values))'s y
            print ((the string form of "  mesh, signed volume ") + ((the string form of (the bim signed volume of mesh meshValue)) + ((the string form of ", lowest x ") + ((the string form of low) + ((the string form of ", lowest y ") + (the string form of south)))))) as a line

set editor to a new bim editor
set e to the address of editor
# A 4 x 3 rectangle pushed up 2.5 m: a mass.
type bim editor key 82 in e
click bim mesh test at 0.0 and 0.0 in e
click bim mesh test at 4.0 and 3.0 in e
type bim editor key 80 in e
click bim mesh test at 2.0 and 1.5 in e
type bim mesh test (the string form of "2.5") in e
type bim editor key bim enter key code in e
type bim editor key bim escape key code in e
click bim mesh test at 2.0 and 1.5 in e
type bim editor key 258 in e
print editor's message as a line
show bim mesh of editor's documentValue's current labelled (the string form of "mass as mesh")
print ((the string form of "sketches left: ") + (the string form of (the length of (editor's documentValue's current's sketches's values)))) as a line
# The corner at (4, 3), seen from above its top point, up 1 m along Z.
click bim mesh test at 4.0 and 3.0 in e
print editor's message as a line
type bim editor key 71 in e
type bim editor key 90 in e
type bim mesh test (the string form of "1") in e
type bim editor key bim enter key code in e
show bim mesh of editor's documentValue's current labelled (the string form of "corner up 1 m")
# Z outside a grab leaves edit mode and undoes the corner; then the top face
# pushed up 1 m: its sides run along, so the face moves.
type bim editor key 90 in e
show bim mesh of editor's documentValue's current labelled (the string form of "undone")
type bim editor key 80 in e
click bim mesh test at 2.0 and 1.5 in e
type bim mesh test (the string form of "1") in e
type bim editor key bim enter key code in e
print editor's message as a line
show bim mesh of editor's documentValue's current labelled (the string form of "top pushed 1 m")
# Saved and read back, as .bim and as .ifcx.
set saved to the bim file text of editor's documentValue's current
set reread to the bim model parsed from saved
print ((the string form of "bim reread: ") + (the string form of reread's valid)) as a line
show bim mesh of reread's modelValue labelled (the string form of "from .bim")
set exported to the bim ifcx text of editor's documentValue's current identified as (the string form of "mesh.ifcx") for project (the string form of "mesh") by (the string form of "test") at (the string form of "2026-10-08T00:00:00Z")
set native to the bim native text of ifcx exported
print ((the string form of "ifcx native: ") + (the string form of native's valid)) as a line
set fromIfcx to the bim model parsed from native's text
print ((the string form of "ifcx reread: ") + (the string form of fromIfcx's valid)) as a line
show bim mesh of fromIfcx's modelValue labelled (the string form of "from .ifcx")
# A face turned to the side pushed out, then the mesh deleted.
set meshValue to the item at 0 in (editor's documentValue's current's meshes's values)
set sideFace to the bim face of mesh meshValue through (a cad vector3 with x 4.0, y 1.5 and z 1.0)
print ((the string form of "side face found: ") + (the string form of (sideFace >= 0))) as a line
start bim editor push of mesh meshValue's id face sideFace in e
push bim editor mesh face by 2.0 in e
type bim editor key bim enter key code in e
show bim mesh of editor's documentValue's current labelled (the string form of "side pushed 2 m")
# A top corner raised 1 m, then the top face pushed 1 m: its sides no longer
# run along it, so it is extruded with four new sides.
type bim editor key bim escape key code in e
click bim mesh test at 2.0 and 1.5 in e
print editor's message as a line
type bim editor key 258 in e
click bim mesh test at 6.0 and 3.0 in e
type bim editor key 71 in e
type bim editor key 90 in e
type bim mesh test (the string form of "1") in e
type bim editor key bim enter key code in e
show bim mesh of editor's documentValue's current labelled (the string form of "corner raised")
type bim editor key 258 in e
type bim editor key 80 in e
click bim mesh test at 3.0 and 1.5 in e
type bim mesh test (the string form of "1") in e
type bim editor key bim enter key code in e
show bim mesh of editor's documentValue's current labelled (the string form of "top extruded 1 m")
# The top pushed down through the floor: refused.
type bim editor key bim escape key code in e
type bim editor key 80 in e
click bim mesh test at 3.0 and 1.5 in e
type bim mesh test (the string form of "-9") in e
type bim editor key bim enter key code in e
print editor's message as a line
# Mirrored in the line x = 10 (a copy), then the copy moved 2 m up the plan.
type bim editor key bim escape key code in e
click bim mesh test at 3.0 and 1.5 in e
type bim editor key 2011 in e
click bim mesh test at 10.0 and 0.0 in e
click bim mesh test at 10.0 and 5.0 in e
print editor's message as a line
list bim meshes of editor's documentValue's current labelled (the string form of "mirrored")
type bim editor key bim escape key code in e
click bim mesh test at 17.0 and 1.5 in e
print editor's message as a line
type bim editor key 77 in e
click bim mesh test at 17.0 and 1.5 in e
click bim mesh test at 17.0 and 3.5 in e
print editor's message as a line
list bim meshes of editor's documentValue's current labelled (the string form of "moved")
type bim editor key bim escape key code in e
click bim mesh test at 3.0 and 1.5 in e
type bim editor key bim delete key code in e
list bim meshes of editor's documentValue's current labelled (the string form of "the first deleted")
# A line across the top of a new block cuts it in two, from the middle of
# one long edge to the middle of the other, and one half is pushed up 1 m:
# extruded, as its other half runs across, not along.
type bim editor key bim escape key code in e
type bim editor key 82 in e
click bim mesh test at 0.0 and 10.0 in e
click bim mesh test at 4.0 and 13.0 in e
type bim editor key 80 in e
click bim mesh test at 2.0 and 11.5 in e
type bim mesh test (the string form of "3") in e
type bim editor key bim enter key code in e
type bim editor key bim escape key code in e
click bim mesh test at 2.0 and 11.5 in e
type bim editor key 258 in e
type bim editor key 258 in e
set blockId to editor's selectionId
set block to the item at (the bim mesh index of blockId in editor's documentValue's current)'s position in (editor's documentValue's current's meshes's values)
set topFace to the bim top face of mesh block at (a cad vector2 with x 1.0 and y 11.5)
ignore split bim editor mesh blockId face topFace from (a cad vector3 with x 2.0, y 10.0 and z 3.0) to (a cad vector3 with x 2.0, y 13.0 and z 3.0) in e
print editor's message as a line
set block to the item at (the bim mesh index of blockId in editor's documentValue's current)'s position in (editor's documentValue's current's meshes's values)
print ((the string form of "after the cut: ") + (((the string form of (the length of (block's vertices's values))) + (the string form of " points, ")) + ((the string form of (the bim face count of mesh block)) + (the string form of " faces")))) as a line
ignore split bim editor mesh blockId face topFace from (a cad vector3 with x 0.0, y 10.0 and z 3.0) to (a cad vector3 with x 2.0, y 10.0 and z 3.0) in e
print ((the string form of "a cut along one edge: ") + editor's message) as a line
type bim editor key 80 in e
click bim mesh test at 1.0 and 11.5 in e
type bim mesh test (the string form of "1") in e
type bim editor key bim enter key code in e
print editor's message as a line
set block to the item at (the bim mesh index of blockId in editor's documentValue's current)'s position in (editor's documentValue's current's meshes's values)
print ((the string form of "half pushed up: ") + (((the string form of (the length of (block's vertices's values))) + (the string form of " points, ")) + (((the string form of (the bim face count of mesh block)) + (the string form of " faces, volume ")) + (the string form of (the bim signed volume of mesh block))))) as a line
