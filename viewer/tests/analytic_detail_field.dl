import viewer/shaders/analytic_connection_field.dl

function the analytic parameter at {integer:index}:
    execute:
        if index = 31:
            return 2.0
        if index >= 64:
            set base to 64
            if index >= 128:
                set base to 128
            set slot to index - base
            if (slot = 35) or ((slot = 39) or (slot = 43)):
                return 1.0
            if base = 64:
                if slot = 60:
                    return 1.0
                if (slot = 45) or (slot = 46):
                    return 1.0
                if slot = 47:
                    return 0.05
            else:
                if slot = 10:
                    return 3.0
                if slot = 7:
                    return 4.0
                if slot = 34:
                    return -0.2
                if slot = 44:
                    return 0.1
                if slot = 45:
                    return 0.08
            return 0.0
        if index = 0:
            return 1.5
        if index = 1:
            return 0.625
        if index = 2:
            return 0.925
        if index = 3:
            return 0.9375
        if index = 4:
            return 0.53125
        if index = 5:
            return 0.1875
        if index = 7:
            return 5.0
        if index = 8:
            return 3.0
        if index = 10:
            return 1.0
        if index = 16:
            return 1.0
        if index = 18:
            return 1.0
        if index = 19:
            return 3.6375
        if index = 20:
            return -0.1875
        return 0.0

function check analytic field {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print label as a line
check analytic field ((analytic nut at 0.0 0.0 0.0) > 0.0) named (the string form of "Nut bore is void")
check analytic field ((analytic nut at 0.65 0.0 0.0) < 0.0) named (the string form of "Nut retains solid material")
check analytic field ((analytic nut at 0.0 0.86 0.4625) > 0.03) named (the string form of "Nut rim is rounded")
check analytic field ((analytic washer at 0.0 0.0 0.0) > 0.0) named (the string form of "Washer bore is void")
check analytic field ((analytic washer at 0.75 0.0 0.0) < 0.0) named (the string form of "Washer retains solid material")
check analytic field ((analytic fastener field at 0.0 0.86 -0.8125) > 0.03) named (the string form of "Bolt rim is rounded")
check analytic field ((analytic fastener field at 0.65 0.0 -0.5) < 0.0) named (the string form of "Bolt head retains material")
check analytic field ((analytic fastener field at 0.65 0.0 4.1) < 0.0) named (the string form of "Actual nut position is occupied")
check analytic field ((analytic fastener field at 0.65 0.0 4.8) > 0.0) named (the string form of "No unrequested second nut")
check analytic field ((analytic fastener field at -2.8 0.0 1.8) > 1.0) named (the string form of "No standalone demo parts")

check analytic field ((analytic anchor rod at 0.0 0.0 3.0 length 20.0 shape 0.0 bend 3.0 tail 4.0) < 0.0) named (the string form of "Straight anchor shank")
check analytic field ((analytic anchor rod at 6.0 0.0 20.0 length 20.0 shape 1.0 bend 3.0 tail 4.0) < 0.0) named (the string form of "L anchor tail")
check analytic field ((analytic anchor rod at 6.0 0.0 15.0 length 20.0 shape 2.0 bend 3.0 tail 4.0) < 0.0) named (the string form of "J anchor return")
check analytic field ((analytic anchor rod at 3.0 0.0 17.0 length 20.0 shape 2.0 bend 3.0 tail 4.0) > 2.0) named (the string form of "J hook centre stays void")
check analytic field ((analytic anchor rod at 0.878679656 0.0 19.121320344 length 20.0 shape 1.0 bend 3.0 tail 4.0) < -0.49) named (the string form of "Circular anchor bend retains rod radius")

check analytic field ((analytic part 64 at 0.065 0.0 0.0) > 0.0) named (the string form of "Assembly plate has clearance around the anchor")
check analytic field ((analytic part 64 at 0.1 0.0 0.0) < 0.0) named (the string form of "Assembly plate retains material outside the hole")
check analytic field ((analytic scene field at 0.0 0.0 0.0) < 0.0) named (the string form of "Assembly anchor occupies the plate hole centre")
