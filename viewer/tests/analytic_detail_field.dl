import viewer/shaders/analytic_detail_field.dl

function the analytic parameter at {integer:index}:
    execute:
        if index = 0:
            return 1.5
        if index = 1:
            return 0.625
        if index = 2:
            return 0.925
        if index = 3:
            return 0.9375
        if index = 4:
            return 0.53125
        if index = 5:
            return 0.1875
        if index = 7:
            return 5.0
        if index = 8:
            return 3.0
        if index = 10:
            return 1.0
        if index = 16:
            return 1.0
        if index = 18:
            return 1.0
        if index = 19:
            return 3.6375
        if index = 20:
            return -0.1875
        return 0.0

function check analytic field {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print label as a line
check analytic field ((analytic nut at 0.0 0.0 0.0) > 0.0) named (the string form of "Nut bore is void")
check analytic field ((analytic nut at 0.65 0.0 0.0) < 0.0) named (the string form of "Nut retains solid material")
check analytic field ((analytic nut at 0.0 0.86 0.4625) > 0.03) named (the string form of "Nut rim is rounded")
check analytic field ((analytic washer at 0.0 0.0 0.0) > 0.0) named (the string form of "Washer bore is void")
check analytic field ((analytic washer at 0.75 0.0 0.0) < 0.0) named (the string form of "Washer retains solid material")
check analytic field ((analytic fastener field at 0.0 0.86 -0.8125) > 0.03) named (the string form of "Bolt rim is rounded")
check analytic field ((analytic fastener field at 0.65 0.0 -0.5) < 0.0) named (the string form of "Bolt head retains material")
check analytic field ((analytic fastener field at 0.65 0.0 4.1) < 0.0) named (the string form of "Actual nut position is occupied")
check analytic field ((analytic fastener field at 0.65 0.0 4.8) > 0.0) named (the string form of "No unrequested second nut")
check analytic field ((analytic fastener field at -2.8 0.0 1.8) > 1.0) named (the string form of "No standalone demo parts")
