# SPDX-License-Identifier: MPL-2.0
# A canvas clipped to a rectangle: strokes cut at its edges, fills clipped to
# it, lettering outside it dropped, and what was recorded before left alone.
import viewer/bim_canvas.dl

function require canvas clip {boolean:condition}:
    execute:
        if condition = false:
            print "FAIL: canvas clip" as a line
            @intrinsic("call", "libc", "exit", nothing, 1)

# Twice the area of the triangles of `pixels`.
function the doubled area of {a pointer to a list:pixels}:
    execute:
        set total to 0.0
        set corner to 0
        loop while (corner + 2) < the length of pixels:
            set a to the item at corner in pixels
            set b to the item at (corner + 1) in pixels
            set c to the item at (corner + 2) in pixels
            set total to total + (the absolute value of (((b's x - a's x) * (c's y - a's y)) - ((c's x - a's x) * (b's y - a's y))))
            set corner to corner + 3
        return total

set canvas to a new bim canvas
set pairs to an empty list of a cad vector2
# Before the mark: a stroke far outside, which stays.
append (a cad vector2 with x -500.0 and y -500.0) to pairs
append (a cad vector2 with x -400.0 and y -500.0) to pairs
record bim strokes pairs coloured 0, 0 and 0 wide 1.0 on (the address of canvas)
record bim text (the string form of "Kept") at -500.0 and -500.0 coloured 0, 0 and 0 on (the address of canvas)
free pairs
set batchMark to the length of (canvas's batches's values)
set textMark to the length of (canvas's texts's values)
# After it: a stroke across the rectangle, one inside, one outside.
set crossing to an empty list of a cad vector2
append (a cad vector2 with x -50.0 and y 50.0) to crossing
append (a cad vector2 with x 250.0 and y 50.0) to crossing
append (a cad vector2 with x 10.0 and y 10.0) to crossing
append (a cad vector2 with x 20.0 and y 30.0) to crossing
append (a cad vector2 with x 150.0 and y -20.0) to crossing
append (a cad vector2 with x 300.0 and y -10.0) to crossing
record bim strokes crossing coloured 0, 0 and 0 wide 2.0 on (the address of canvas)
free crossing
# A triangle half inside: (0,0) (200,0) (0,200) against 100 x 100 keeps the
# whole square less nothing, 10000 square pixels.
set fill to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to fill
append (a cad vector2 with x 200.0 and y 0.0) to fill
append (a cad vector2 with x 0.0 and y 200.0) to fill
record bim triangles fill coloured 200, 200 and 200 on (the address of canvas)
free fill
record bim text (the string form of "Inside") at 40.0 and 60.0 coloured 0, 0 and 0 on (the address of canvas)
record bim text (the string form of "Outside") at 140.0 and 60.0 coloured 0, 0 and 0 on (the address of canvas)
clip bim canvas (the address of canvas) past batchMark batches and textMark texts to (a cad vector2 with x 0.0 and y 0.0) and (a cad vector2 with x 100.0 and y 100.0)

set before to the item at 0 in (canvas's batches's values)
require canvas clip ((the length of (before's pixels's values)) = 6)
set strokes to the item at batchMark in (canvas's batches's values)
require canvas clip ((the length of (strokes's pixels's values)) = 12)
set cutFrom to the bim stroke anchor of (strokes's pixels's values) at 0
set cutTo to the bim stroke anchor of (strokes's pixels's values) at 2
require canvas clip (((the absolute value of cutFrom's x) < 1e-9) and ((the absolute value of (cutTo's x - 100.0)) < 1e-9))
require canvas clip (((the absolute value of (cutFrom's y - 50.0)) < 1e-9) and ((the absolute value of (cutTo's y - 50.0)) < 1e-9))
require canvas clip (strokes's stroked and ((the absolute value of (strokes's breadth - 2.0)) < 1e-9))
print "PASS: strokes are cut at the rectangle, kept inside it and dropped outside it" as a line
set filled to the item at (batchMark + 1) in (canvas's batches's values)
require canvas clip ((the absolute value of ((the doubled area of (filled's pixels's values)) - 20000.0)) < 1e-6)
loop corner from 0 to the length of (filled's pixels's values):
    set spot to the item at corner in (filled's pixels's values)
    require canvas clip (((spot's x > -1e-9) and (spot's x < 100.000001)) and ((spot's y > -1e-9) and (spot's y < 100.000001)))
print "PASS: a fill is clipped to the rectangle" as a line
require canvas clip ((the length of (canvas's texts's values)) = 2)
require canvas clip (((the item at 0 in (canvas's texts's values))'s message) = (the string form of "Kept"))
require canvas clip (((the item at 1 in (canvas's texts's values))'s message) = (the string form of "Inside"))
print "PASS: lettering outside the rectangle is dropped, earlier recordings stay" as a line
