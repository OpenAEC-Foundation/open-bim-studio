import ui/editor/bim_editor.dl
import viewer/bim_display_detail.dl

function require resident detail {boolean:ok} named {a string:caption}:
    execute:
        if ok = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set radii to an empty list of a 64 bit floating-point number
append 0.005 to radii
append 0.15 to radii
append 1.0 to radii
append 10.0 to radii
loop cursor from 0 to the length of radii:
    set radius to the item at cursor in radii
    set kindId to add bim linear type named (the string form of "Round column") as role (bim column role) sized (radius * 2.0) by (radius * 2.0) round true of (the string form of "steel") to target
    set columnId to add bim linear typed kindId on ground from (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (a cad vector3 with x 0.0, y 0.0 and z 3.0) turned 0.0 to target
    set columnValue to the item at cursor in (modelValue's linears's values)
    set kind to the bim type of linear columnValue in modelValue
    set shape to the bim linear shape of columnValue typed kind in modelValue within (the bim resident display tolerance) cut by (a bim uncut end)
    set count to the bim round corners for radius radius within (the bim resident display tolerance)
    set angle to 6.283185307179586 / (count as a 64 bit floating-point number)
    set expectedVolume to ((count as a 64 bit floating-point number) * 0.5) * ((radius * radius) * ((the sine of angle) * 3.0))
    set volumeError to the absolute value of ((the bim volume of mesh shape) - expectedVolume)
    set gap to radius * (1.0 - (the cosine of (angle * 0.5)))
    set bounded to ((count >= 12) and (count <= 256)) and ((the remainder of count divided by 4) = 0)
    set accurate to (gap <= (the bim resident display tolerance)) or (count = 256)
    require resident detail (((the fast mesh flaw of shape) = 0) and ((volumeError <= (the maximum of 1e-10 and (expectedVolume * 1e-10))) and (bounded and accurate))) named ((the string form of "closed round profile with analytic polygon volume and bounded detail: ") + (the string form of cursor))
