# SPDX-License-Identifier: MPL-2.0
# Temporary view cuts have their own GPU slot. Element ordinals remain
# those of the source scene, preserving visibility and selection flags.
import materials/bim_section_materials.dl
import ui/panels/bim_view_panel.dl

class:
    patterns:
        [a|] bim cut gpu counts record
    members:
        indexCount as an integer
        edgeCount as an integer

function the bim cut ordinal of {a 64 bit integer:wantedId} in {bim gpu scene record:sceneValue}:
    execute:
        loop entryCursor from 0 to the length of (sceneValue's importIds's values):
            if (the item at entryCursor in (sceneValue's importIds's values)) = wantedId:
                return entryCursor
        loop entryCursor from 0 to the length of (sceneValue's nativeIds's values):
            if (the item at entryCursor in (sceneValue's nativeIds's values)) = wantedId:
                return entryCursor + (the length of (sceneValue's importIds's values))
        return -1

function upload bim cut faces {a pointer to a list:capEntries} for {bim gpu scene record:sceneValue} under {integer:standardCode} on {pointer:windowValue}:
    execute:
        set gpuContext to the gpu context of windowValue
        set cornerBound to 0
        set hatchShapes to a cad topology list of a fast mesh record
        loop entryCursor from 0 to the length of capEntries:
            set cornerBound to cornerBound + (the length of ((the item at entryCursor in capEntries)'s shape's triangles's values))
            set capPattern to the bim hatch pattern of material ((the item at entryCursor in capEntries)'s material) under standardCode
            set hatchShape to the bim cut hatching of ((the item at entryCursor in capEntries)'s shape) patterned capPattern
            append hatchShape to (hatchShapes's values)
            set cornerBound to cornerBound + (the length of (hatchShape's positions's values))
        prepare gpu mesh slot 4 of cornerBound vertices and cornerBound indices in gpuContext
        set gpuTarget to the gpu mesh held in slot 4 of gpuContext
        set cutEdges to an empty list of an integer
        set vertexCursor to 0
        set indexCursor to 0
        loop entryCursor from 0 to the length of capEntries:
            set capEntry to the item at entryCursor in capEntries
            set ownerOrdinal to the bim cut ordinal of capEntry's elementId in sceneValue
            if ownerOrdinal >= 0:
                set capPattern to the bim hatch pattern of material capEntry's material under standardCode
                set fillColour to a cad vector3 with x (capPattern's fillRed as a 64 bit floating-point number), y (capPattern's fillGreen as a 64 bit floating-point number) and z (capPattern's fillBlue as a 64 bit floating-point number)
                set writtenCount to write bim gpu triangles of capEntry's shape less sceneValue's origin for element ownerOrdinal in fillColour from vertex vertexCursor and index indexCursor edged true into gpuTarget adding edges to cutEdges
                set vertexCursor to vertexCursor + writtenCount
                set indexCursor to indexCursor + (the length of (capEntry's shape's triangles's values))
                set hatchShape to the item at entryCursor in (hatchShapes's values)
                loop hatchCursor from 0 to the length of (hatchShape's positions's values):
                    set hatchSpot to the cad difference of (the item at hatchCursor in (hatchShape's positions's values)) and sceneValue's origin
                    put gpu mesh vertex vertexCursor at hatchSpot's x, hatchSpot's y and hatchSpot's z of element ownerOrdinal coloured capPattern's lineRed, capPattern's lineGreen and capPattern's lineBlue in gpuTarget
                    append vertexCursor to cutEdges
                    set vertexCursor to vertexCursor + 1
        set gpu mesh slot 4 edges to cutEdges in gpuContext
        set uploadedCounts to @intrinsic("construct", a bim cut gpu counts record, indexCursor, the length of cutEdges)
        free cutEdges
        return uploadedCounts

function draw bim cut faces {bim cut gpu counts record:cutCounts} in {bim screen layout record:panelLayout} mode {integer:modeValue} on {pointer:windowValue}:
    execute:
        if modeValue != bim wireframe view mode:
            draw gpu mesh slot 4 indices from 0 counting cutCounts's indexCount within panelLayout's planRight, panelLayout's top, (panelLayout's width - panelLayout's planRight) and (panelLayout's bottom - panelLayout's top) in (the gpu context of windowValue)

function draw bim cut edges {bim cut gpu counts record:cutCounts} in {bim screen layout record:panelLayout} mode {integer:modeValue} on {pointer:windowValue}:
    execute:
        draw gpu mesh slot 4 edges from 0 counting cutCounts's edgeCount within panelLayout's planRight, panelLayout's top, (panelLayout's width - panelLayout's planRight) and (panelLayout's bottom - panelLayout's top) coloured 28, 32 and 40 hidden (modeValue != bim wireframe view mode) in (the gpu context of windowValue)

# Boxed selections use clipped world-space edges. The ordinary selection
# overlay projects whole objects and cannot be cropped by the mesh shader.
function draw bim boxed selection of {bim editor record:editorValue} from {cad vector3:lowCorner} to {cad vector3:highCorner} in {bim screen layout record:panelLayout} with {bim camera record:viewCamera} in {graphics frame:frameValue}:
    execute:
        if editorValue's selectionKind = bim nothing picked:
            return nothing
        set modelValue to editorValue's documentValue's current
        set gridSelected to editorValue's selectionKind = bim grid picked
        set selectedShape to an empty fast mesh
        set selectedEnds to selectedShape's positions's values
        set jointEnds to the bim chosen joint edges of editorValue
        loop endCursor from 0 to the length of (jointEnds's values):
            append (the item at endCursor in (jointEnds's values)) to selectedEnds
        set chosenPart to the bim chosen part of editorValue
        set perimeter to an empty list of a cad vector3
        if ((the length of selectedEnds) = 0) and chosenPart's valid:
            set lowSpot to the bim point chosenPart's box's low's x metres along chosenPart's curtain
            set highSpot to the bim point chosenPart's box's high's x metres along chosenPart's curtain
            set lowerZ to chosenPart's elevation + chosenPart's box's low's y
            set upperZ to chosenPart's elevation + chosenPart's box's high's y
            append (a cad vector3 with x lowSpot's x, y lowSpot's y and z lowerZ) to perimeter
            append (a cad vector3 with x highSpot's x, y highSpot's y and z lowerZ) to perimeter
            append (a cad vector3 with x highSpot's x, y highSpot's y and z upperZ) to perimeter
            append (a cad vector3 with x lowSpot's x, y lowSpot's y and z upperZ) to perimeter
        if editorValue's selectionKind = bim opening picked:
            set openingFound to the bim opening index of editorValue's selectionId in modelValue
            if openingFound's valid:
                set openingValue to the item at openingFound's position in (modelValue's openings's values)
                set hostFound to the bim wall index of openingValue's hostId in modelValue
                set typeFound to the bim opening type index of openingValue's typeId in modelValue
                if hostFound's valid and typeFound's valid:
                    set hostValue to the item at hostFound's position in (modelValue's walls's values)
                    set typeValue to the item at typeFound's position in (modelValue's openingTypes's values)
                    set elevationValue to the bim elevation of level hostValue's levelId in modelValue
                    set openingSpan to the bim span of hostValue at openingValue's offset reaching ((the bim rough width of typeValue) * 0.5)
                    set lowerZ to elevationValue + typeValue's sill
                    set upperZ to elevationValue + (the bim head height of typeValue)
                    append (a cad vector3 with x openingSpan's left's x, y openingSpan's left's y and z lowerZ) to perimeter
                    append (a cad vector3 with x openingSpan's right's x, y openingSpan's right's y and z lowerZ) to perimeter
                    append (a cad vector3 with x openingSpan's right's x, y openingSpan's right's y and z upperZ) to perimeter
                    append (a cad vector3 with x openingSpan's left's x, y openingSpan's left's y and z upperZ) to perimeter
        if gridSelected:
            set gridFound to the bim grid index of editorValue's selectionId in modelValue
            if gridFound's valid:
                set gridValue to the item at gridFound's position in (modelValue's grids's values)
                append (a cad vector3 with x gridValue's start's x, y gridValue's start's y and z gridValue's low) to perimeter
                append (a cad vector3 with x gridValue's finish's x, y gridValue's finish's y and z gridValue's low) to perimeter
                append (a cad vector3 with x gridValue's finish's x, y gridValue's finish's y and z gridValue's high) to perimeter
                append (a cad vector3 with x gridValue's start's x, y gridValue's start's y and z gridValue's high) to perimeter
                # Keep the translucent selection plane inside the section box.
                set gridSurface to an empty fast mesh
                loop cornerCursor from 0 to 4:
                    append (the item at cornerCursor in perimeter) to (gridSurface's positions's values)
                    append (a cad vector3 with x 0.0, y 0.0 and z 1.0) to (gridSurface's normals's values)
                loop faceCursor from 0 to 2:
                    append 0 to (gridSurface's triangles's values)
                    append (faceCursor + 1) to (gridSurface's triangles's values)
                    append (faceCursor + 2) to (gridSurface's triangles's values)
                set clippedSurface to the bim mesh gridSurface clipped to box from lowCorner to highCorner
                start triangles in frameValue
                set gpu colour to 36, 120, 220 and 56 in (the gpu context of frameValue's window)
                loop cornerCursor from 0 to the length of (clippedSurface's triangles's values):
                    set cornerSpot to the item at (the item at cornerCursor in (clippedSurface's triangles's values)) in (clippedSurface's positions's values)
                    set cornerPixel to the bim view point cornerSpot's x cornerSpot's y cornerSpot's z in panelLayout with viewCamera
                    add a vertex at x cornerPixel's x and y cornerPixel's y to frameValue
                finish triangles in frameValue
        if editorValue's selectionKind = bim space picked:
            set selectedRegion to the bim selected space of editorValue
            if selectedRegion's valid:
                if (bim region selectedRegion's space has an explicit space in modelValue) = false:
                    set regionElevation to the bim elevation of level selectedRegion's space's levelId in modelValue
                    loop regionCursor from 0 to the length of (selectedRegion's space's outline's values):
                        set regionSpot to the item at regionCursor in (selectedRegion's space's outline's values)
                        append (a cad vector3 with x regionSpot's x, y regionSpot's y and z regionElevation) to perimeter
        loop cornerCursor from 0 to the length of perimeter:
            append (the item at cornerCursor in perimeter) to selectedEnds
            append (the item at (the remainder of (cornerCursor + 1) divided by (the length of perimeter)) in perimeter) to selectedEnds
        free perimeter
        if ((the length of (editorValue's chosenSketches's values)) > 0) and (gridSelected = false):
            set selectedOutlines to the bim selection outlines of editorValue in plan false
            loop outlineCursor from 0 to the length of selectedOutlines:
                set outlineValue to the item at outlineCursor in selectedOutlines
                if bim element outlineValue's id is chosen by editorValue:
                    loop endCursor from 0 to the length of (outlineValue's segments's values):
                        append (the item at endCursor in (outlineValue's segments's values)) to selectedEnds
            free selectedOutlines
        set clippedShape to the bim line shape selectedShape clipped to box from lowCorner to highCorner
        start triangles in frameValue
        use vertex color red 255, green 140 and blue 0 in frameValue
        if gridSelected:
            use vertex color red 0, green 120 and blue 215 in frameValue
        set edgeCursor to 0
        loop while (edgeCursor + 1) < (the length of (clippedShape's positions's values)):
            set firstSpot to the item at edgeCursor in (clippedShape's positions's values)
            set lastSpot to the item at (edgeCursor + 1) in (clippedShape's positions's values)
            set firstPixel to the bim view point firstSpot's x firstSpot's y firstSpot's z in panelLayout with viewCamera
            set lastPixel to the bim view point lastSpot's x lastSpot's y lastSpot's z in panelLayout with viewCamera
            if gridSelected:
                # Clip in model space first, then dash in screen pixels so the
                # selected grid retains its line style at every view scale.
                set onDatum to ((the absolute value of firstSpot's z) < 1e-9) and ((the absolute value of lastSpot's z) < 1e-9)
                if onDatum = false:
                    set dashes to an empty list of a cad vector2
                    append bim dash dot from firstPixel to lastPixel into dashes
                    set dashCursor to 0
                    loop while (dashCursor + 1) < (the length of dashes):
                        add bim stroke from (the item at dashCursor in dashes) to (the item at (dashCursor + 1) in dashes) wide 2.0 in frameValue
                        set dashCursor to dashCursor + 2
                    free dashes
            else:
                add bim stroke from firstPixel to lastPixel wide 2.5 in frameValue
            set edgeCursor to edgeCursor + 2
        finish triangles in frameValue
