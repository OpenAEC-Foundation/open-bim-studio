# Paper recording needs no editor, font or geometry evaluation.
import model/bim_sheet.dl
import graphics/bim_canvas.dl

function record bim sheet [paper] {bim sheet record:sheetValue} from {cad vector2:corner} at {a 64 bit floating-point number:perMillimetre} on {a pointer to a bim canvas record:canvas}:
    execute:
        set canvas's paperScale to perMillimetre
        set sheetSize to the bim size of sheet sheetValue
        # White page background.
        set paperPixels to an empty list of a cad vector2
        set topLeft to the bim sheet pixel of (a cad vector2 with x 0.0 and y (sheetSize's y)) from corner at perMillimetre
        set bottomRight to the bim sheet pixel of (a cad vector2 with x (sheetSize's x) and y 0.0) from corner at perMillimetre
        append topLeft to paperPixels
        append (a cad vector2 with x (bottomRight's x) and y (topLeft's y)) to paperPixels
        append bottomRight to paperPixels
        append topLeft to paperPixels
        append bottomRight to paperPixels
        append (a cad vector2 with x (topLeft's x) and y (bottomRight's y)) to paperPixels
        record bim triangles paperPixels coloured 255, 255 and 255 on canvas
        free paperPixels


function the bim sheet pixel of {cad vector2:spot} from {cad vector2:corner} at {a 64 bit floating-point number:perMillimetre}:
    execute:
        return a cad vector2 with x (corner's x + (spot's x * perMillimetre)) and y (corner's y - (spot's y * perMillimetre))

