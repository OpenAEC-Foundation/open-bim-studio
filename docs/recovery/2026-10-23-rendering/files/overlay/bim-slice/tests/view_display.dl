# SPDX-License-Identifier: MPL-2.0
# A view's scale and display, set from the bar at its top right: the scale
# steps through 1:1 to 1:1000, the display is colour, hidden line or
# wireframe; both survive .bim and .ifcx. A section drawn as a wireframe
# keeps its own setting beside a plan in colour.
import examples/bim-slice/bim_file.dl
import examples/bim-slice/bim_ifcx.dl
import examples/bim-slice/bim_ifcx_read.dl

function list display test views of {bim model record:modelValue} labelled {a string:title}:
    execute:
        print title as a line
        loop cursor from 0 to the length of (modelValue's views's values):
            set viewValue to the item at cursor in (modelValue's views's values)
            print ((the string form of "  ") + ((viewValue's name + (the string form of " 1:")) + ((the string form of viewValue's scale) + ((the string form of " ") + (the bim name of display viewValue's displayMode))))) as a line

print ((the string form of "after 100: ") + ((the string form of (the bim scale after 100 going up true)) + ((the string form of ", before 100: ") + (the string form of (the bim scale after 100 going up false))))) as a line
print ((the string form of "after 1000: ") + ((the string form of (the bim scale after 1000 going up true)) + ((the string form of ", before 1: ") + (the string form of (the bim scale after 1 going up false))))) as a line
print ((the string form of "after 75: ") + (the string form of (the bim scale after 75 going up true))) as a line
set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to target
set made to ensure bim default views in target
set groundPlan to the item at 0 in made
set sectionId to add bim section view from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 5.0 and y 0.0) to target
print ((the string form of "plan 1:50 hidden: ") + (the string form of (set bim view groundPlan scale to 50 and display to bim hidden line display in target))) as a line
print ((the string form of "section wire: ") + (the string form of (set bim view sectionId scale to 100 and display to bim wireframe display in target))) as a line
print ((the string form of "display 7 refused: ") + (the string form of ((set bim view sectionId scale to 100 and display to 7 in target) = false))) as a line
list display test views of modelValue labelled (the string form of "set")
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of " ") + reread's message))) as a line
list display test views of reread's modelValue labelled (the string form of "from .bim")
set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "v.ifcx") for project (the string form of "v") by (the string form of "test") at (the string form of "2026-10-13T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of " ") + fromIfcx's message))) as a line
list display test views of fromIfcx's modelValue labelled (the string form of "from .ifcx")
