# All native catalogue types, plus explicit assembled bolts, in family rows.
import elements/connection/bim_fastener_components.dl

function the bim fastener gallery:
    execute:
        set modelValue to an empty bim model
        set target to the address of modelValue
        set levelId to add bim level named (the string form of "Fastener library M8-M40") at 0.0 with height 1.0 to target
        set library to add bim metric fastener library to target
        loop metricCursor from 0 to 15:
            loop familyCursor from 0 to 8:
                set slot to (metricCursor * 8) + familyCursor
                ignore place bim component (the item at slot in (library's values)) on levelId at (a cad vector2 with x ((metricCursor as a 64 bit floating-point number) * 0.35) and y ((familyCursor as a 64 bit floating-point number) * 0.5)) turned 0.0 to target
            set settings to catalogued connection fastener parameters
            set settings's washers to 3
            set settings's nuts to 2
            set settings's coating to 2
            set diameter to the connection fastener diameter at metricCursor
            set settings's grip to diameter * 3.0
            set assemblyId to add bim fastener component of kind 1 sized diameter by (diameter * 8.0) configured settings library slot -1 in target
            ignore place bim component assemblyId on levelId at (a cad vector2 with x ((metricCursor as a 64 bit floating-point number) * 0.35) and y 4.0) turned 0.0 to target
        set layers to an empty list of a bim layer record
        append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to layers
        ignore add bim wall type named (the string form of "Default wall") with layers to target
        free layers
        ignore add bim opening type named (the string form of "Default window") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
        ignore add bim door type named (the string form of "Default door") sized 0.9 by 2.1 with frame 0.05 to target
        return modelValue
