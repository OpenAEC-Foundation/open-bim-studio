# SPDX-License-Identifier: MPL-2.0
# Parametric CSG authoring. B-rep solids are evaluated from primitive/operation
# definitions. Meshes here are transient display/export tessellations only.
import elements/connection/connections.dl
import elements/connection/fastener_csg.dl
import elements/connection/fastener_display.dl
import kernel/fast/polyhedron.dl

class:
    patterns:
        [a|] connection fastener piece
    members:
        name as a string
        kind as an integer
        construction as a connection csg definition
        placement as a cad placement
        shape as a fast mesh record

function the connection fastener placement at {cad vector3:originValue} along {cad vector3:axisValue}:
    execute:
        set forwardValue to axisValue scaled by (1.0 / (the cad length of axisValue))
        set acrossValue to the cad cross of (the cad z axis) and forwardValue
        if (the cad length of acrossValue) < 1e-9:
            set acrossValue to the cad x axis
        else:
            set acrossValue to acrossValue scaled by (1.0 / (the cad length of acrossValue))
        return a cad placement with axes acrossValue, (the cad cross of forwardValue and acrossValue) and forwardValue at originValue

# Rendering reads the constructive source without evaluating costly general
# booleans. CAD operations request the exact B-rep through the function below.
function a connection csg piece named {a string:labelValue} kind {integer:kindValue} from {connection csg definition:constructionValue} placed by {cad placement:placementValue}:
    execute:
        set localShape to the connection stock display of constructionValue
        set shapeValue to the connection fastener mesh localShape placed at placementValue's origin along placementValue's zAxis
        return @intrinsic("construct", a connection fastener piece, labelValue, kindValue, constructionValue, placementValue, shapeValue)

function the connection exact solid of {connection fastener piece:pieceValue}:
    execute:
        set evaluatedValue to the connection csg evaluation of pieceValue's construction
        if evaluatedValue's valid = false:
            return evaluatedValue
        set placedValue to the kernel transformed evaluatedValue's solid by pieceValue's placement
        return @intrinsic("construct", a connection csg result, placedValue's valid, 0, placedValue's value)

function the connection fastener mesh {fast mesh record:shapeValue} placed at {cad vector3:originValue} along {cad vector3:axisValue} rolled {a 64 bit floating-point number:rollValue}:
    execute:
        set meshValue to an empty fast mesh
        set axisLength to the cad length of axisValue
        if axisLength < 1e-9:
            return meshValue
        set forwardValue to axisValue scaled by (1.0 / axisLength)
        set acrossValue to the cad cross of (a cad vector3 with x 0.0, y 0.0 and z 1.0) and forwardValue
        if (the cad length of acrossValue) < 1e-9:
            set acrossValue to a cad vector3 with x 1.0, y 0.0 and z 0.0
        else:
            set acrossValue to acrossValue scaled by (1.0 / (the cad length of acrossValue))
        set upValue to the cad cross of forwardValue and acrossValue
        set acrossValue to the cad sum of (acrossValue scaled by (the cosine of rollValue)) and (upValue scaled by (the sine of rollValue))
        set upValue to the cad cross of forwardValue and acrossValue
        loop pointCursor from 0 to the length of (shapeValue's positions's values):
            set localPoint to the item at pointCursor in (shapeValue's positions's values)
            set localNormal to the item at pointCursor in (shapeValue's normals's values)
            append (the cad sum of originValue and (the cad sum of (acrossValue scaled by localPoint's x) and (the cad sum of (upValue scaled by localPoint's y) and (forwardValue scaled by localPoint's z)))) to (meshValue's positions's values)
            append (the cad sum of (acrossValue scaled by localNormal's x) and (the cad sum of (upValue scaled by localNormal's y) and (forwardValue scaled by localNormal's z))) to (meshValue's normals's values)
        loop indexCursor from 0 to the length of (shapeValue's triangles's values):
            append (the item at indexCursor in (shapeValue's triangles's values)) to (meshValue's triangles's values)
        return meshValue

function the connection fastener mesh {fast mesh record:shapeValue} placed at {cad vector3:originValue} along {cad vector3:axisValue}:
    execute:
        return the connection fastener mesh shapeValue placed at originValue along axisValue rolled 0.0

class:
    patterns:
        [a|] connection fastener construction
    members:
        name as a string
        kind as an integer
        definition as a connection csg definition

function a connection fastener construction named {a string:labelValue} kind {integer:kindValue} from {connection csg definition:definitionValue}:
    execute:
        return @intrinsic("construct", a connection fastener construction, labelValue, kindValue, definitionValue)

function the connection fastener constructions of {connection fastener:fastenerValue}:
    execute:
        set pieceValues to a cad topology list of a connection fastener construction
        set sizeValue to the connection metric fastener size of fastenerValue's diameter
        if sizeValue's valid = false:
            return pieceValues
        set parameters to fastenerValue's parameters
        if fastenerValue's kind = 6:
            append (a connection fastener construction named (the string form of "Nut") kind 1 from (the connection nut csg of sizeValue at 0.0 using parameters)) to (pieceValues's values)
        else if fastenerValue's kind = 7:
            append (a connection fastener construction named (the string form of "Washer") kind 2 from (the connection washer csg of sizeValue at 0.0)) to (pieceValues's values)
        else:
            if fastenerValue's kind = 1:
                append (a connection fastener construction named (the string form of "Bolt") kind 0 from (the connection bolt csg of sizeValue over fastenerValue's length using parameters)) to (pieceValues's values)
            else:
                append (a connection fastener construction named (the string form of "Anchor rod") kind 0 from (the connection anchor csg of sizeValue over fastenerValue's length using parameters)) to (pieceValues's values)
            set nutStation to the connection nut station of fastenerValue
            loop nutCursor from 0 to parameters's nuts:
                append (a connection fastener construction named ((the string form of "Nut ") + (the string form of (nutCursor + 1))) kind 1 from (the connection nut csg of sizeValue at (nutStation + (sizeValue's nutHeight * (nutCursor as a 64 bit floating-point number))) using parameters)) to (pieceValues's values)
            if (the remainder of parameters's washers divided by 2) = 1:
                append (a connection fastener construction named (the string form of "Washer under head") kind 2 from (the connection washer csg of sizeValue at (0.0 - sizeValue's washerThickness))) to (pieceValues's values)
            if parameters's washers >= 2:
                set washerStation to nutStation - sizeValue's washerThickness
                if fastenerValue's kind = 3:
                    set washerStation to nutStation + (sizeValue's nutHeight * (parameters's nuts as a 64 bit floating-point number))
                append (a connection fastener construction named (the string form of "Washer under nut") kind 2 from (the connection washer csg of sizeValue at washerStation)) to (pieceValues's values)
            if (fastenerValue's kind = 3) and (parameters's anchorShape = 3):
                set plateSize to sizeValue
                set plateSize's washerInner to sizeValue's diameter
                set plateSize's washerOuter to sizeValue's diameter * 4.0
                set plateSize's washerThickness to sizeValue's diameter * 0.5
                append (a connection fastener construction named (the string form of "Anchor end plate") kind 3 from (the connection washer csg of plateSize at fastenerValue's length)) to (pieceValues's values)
        return pieceValues

function the connection fastener pieces of {connection fastener:fastenerValue}:
    execute:
        set pieceValues to a cad topology list of a connection fastener piece
        set constructions to the connection fastener constructions of fastenerValue
        set placementValue to the connection fastener placement at fastenerValue's origin along fastenerValue's axis
        loop partCursor from 0 to the length of (constructions's values):
            set sourceValue to the item at partCursor in (constructions's values)
            append (a connection csg piece named sourceValue's name kind sourceValue's kind from sourceValue's definition placed by placementValue) to (pieceValues's values)
        return pieceValues
