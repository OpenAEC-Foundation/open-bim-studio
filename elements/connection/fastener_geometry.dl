# SPDX-License-Identifier: MPL-2.0
# Closed direct meshes, no boolean thread solids. All coordinates are local
# to the fastener: the bearing face is z=0 and the shaft runs along +z.
import elements/connection/connections.dl
import kernel/fast/polyhedron.dl

class:
    patterns:
        [a|] connection fastener ring
    members:
        x as a 64 bit floating-point number
        z as a 64 bit floating-point number
        turn as a 64 bit floating-point number
        reach as a 64 bit floating-point number
        sides as an integer

class:
    patterns:
        [a|] connection fastener piece
    members:
        name as a string
        kind as an integer
        shape as a fast mesh record

local function an axial fastener ring at {a 64 bit floating-point number:elevationValue} reaching {a 64 bit floating-point number:radiusValue} with {integer:sideCount} sides:
    execute:
        return @intrinsic("construct", a connection fastener ring, 0.0, elevationValue, 0.0, radiusValue, sideCount)

local function the fastener ring point of {connection fastener ring:ringValue} at {integer:cornerValue} among {integer:cornerCount}:
    execute:
        set phaseValue to 6.283185307179586 * ((cornerValue as a 64 bit floating-point number) / (cornerCount as a 64 bit floating-point number))
        set radialReach to ringValue's reach
        if ringValue's sides > 2:
            set sectorSize to 6.283185307179586 / (ringValue's sides as a 64 bit floating-point number)
            set sectorCentre to (the floor of ((phaseValue / sectorSize) + 0.5)) * sectorSize
            set radialReach to radialReach / (the cosine of (phaseValue - sectorCentre))
        set transverse to radialReach * (the cosine of phaseValue)
        return a cad vector3 with x (ringValue's x + (transverse * (the cosine of ringValue's turn))), y (radialReach * (the sine of phaseValue)) and z (ringValue's z - (transverse * (the sine of ringValue's turn)))

local function add fastener triangle {integer:firstIndex} {integer:secondIndex} {integer:thirdIndex} from {a pointer to a list:sourcePoints} to {a pointer to a fast mesh record:target}:
    execute:
        set firstPoint to the item at firstIndex in sourcePoints
        set secondPoint to the item at secondIndex in sourcePoints
        set thirdPoint to the item at thirdIndex in sourcePoints
        set faceNormal to the cad cross of (the cad difference of secondPoint and firstPoint) and (the cad difference of thirdPoint and firstPoint)
        set faceNormal to faceNormal scaled by (1.0 / (the cad length of faceNormal))
        set indexBase to the length of (target's positions's values)
        append firstPoint to (target's positions's values)
        append secondPoint to (target's positions's values)
        append thirdPoint to (target's positions's values)
        loop normalCursor from 0 to 3:
            append faceNormal to (target's normals's values)
            append (indexBase + normalCursor) to (target's triangles's values)

local function the fastener shell through {a pointer to a list:ringValues} closing profile {boolean:profileClosed}:
    execute:
        set sourcePoints to an empty list of a cad vector3
        set meshValue to an empty fast mesh
        set cornersPerRing to 48
        set ringCount to the length of ringValues
        loop ringCursor from 0 to ringCount:
            loop cornerCursor from 0 to cornersPerRing:
                append (the fastener ring point of (the item at ringCursor in ringValues) at cornerCursor among cornersPerRing) to sourcePoints
        set linkCount to ringCount - 1
        if profileClosed:
            set linkCount to ringCount
        loop ringCursor from 0 to linkCount:
            set followingRing to the remainder of (ringCursor + 1) divided by ringCount
            loop cornerCursor from 0 to cornersPerRing:
                set followingCorner to the remainder of (cornerCursor + 1) divided by cornersPerRing
                set firstIndex to (ringCursor * cornersPerRing) + cornerCursor
                set secondIndex to (ringCursor * cornersPerRing) + followingCorner
                set thirdIndex to (followingRing * cornersPerRing) + followingCorner
                set fourthIndex to (followingRing * cornersPerRing) + cornerCursor
                add fastener triangle firstIndex secondIndex thirdIndex from sourcePoints to (the address of meshValue)
                add fastener triangle firstIndex thirdIndex fourthIndex from sourcePoints to (the address of meshValue)
        if profileClosed = false:
            set endBase to (ringCount - 1) * cornersPerRing
            loop cornerCursor from 1 to (cornersPerRing - 1):
                add fastener triangle 0 (cornerCursor + 1) cornerCursor from sourcePoints to (the address of meshValue)
                add fastener triangle endBase (endBase + cornerCursor) ((endBase + cornerCursor) + 1) from sourcePoints to (the address of meshValue)
        free sourcePoints
        return meshValue

function the connection nut mesh of {connection fastener size:sizeValue} at {a 64 bit floating-point number:elevationValue} using {connection fastener parameters:parameters}:
    execute:
        set flatsValue to sizeValue's headFlats
        if parameters's headSeries = 1:
            set flatsValue to sizeValue's dinFlats
        set bevelValue to the minimum of (sizeValue's pitch * 0.4) and (sizeValue's nutHeight * 0.1)
        set halfFlats to flatsValue * 0.5
        # The bore is the cosmetic thread's major envelope, so it meets the
        # shaft without a spurious collision between simplified thread solids.
        set boreReach to sizeValue's diameter * 0.5
        set ringValues to an empty list of a connection fastener ring
        append (an axial fastener ring at elevationValue reaching (halfFlats * 0.9) with 6 sides) to ringValues
        append (an axial fastener ring at (elevationValue + bevelValue) reaching halfFlats with 6 sides) to ringValues
        append (an axial fastener ring at ((elevationValue + sizeValue's nutHeight) - bevelValue) reaching halfFlats with 6 sides) to ringValues
        append (an axial fastener ring at (elevationValue + sizeValue's nutHeight) reaching (halfFlats * 0.9) with 6 sides) to ringValues
        append (an axial fastener ring at (elevationValue + sizeValue's nutHeight) reaching (boreReach + bevelValue) with 0 sides) to ringValues
        append (an axial fastener ring at ((elevationValue + sizeValue's nutHeight) - bevelValue) reaching boreReach with 0 sides) to ringValues
        append (an axial fastener ring at (elevationValue + bevelValue) reaching boreReach with 0 sides) to ringValues
        append (an axial fastener ring at elevationValue reaching (boreReach + bevelValue) with 0 sides) to ringValues
        set meshValue to the fastener shell through ringValues closing profile true
        free ringValues
        return meshValue

function the connection washer mesh of {connection fastener size:sizeValue} at {a 64 bit floating-point number:elevationValue}:
    execute:
        set ringValues to an empty list of a connection fastener ring
        append (an axial fastener ring at elevationValue reaching (sizeValue's washerOuter * 0.5) with 0 sides) to ringValues
        append (an axial fastener ring at (elevationValue + sizeValue's washerThickness) reaching (sizeValue's washerOuter * 0.5) with 0 sides) to ringValues
        append (an axial fastener ring at (elevationValue + sizeValue's washerThickness) reaching (sizeValue's washerInner * 0.5) with 0 sides) to ringValues
        append (an axial fastener ring at elevationValue reaching (sizeValue's washerInner * 0.5) with 0 sides) to ringValues
        set meshValue to the fastener shell through ringValues closing profile true
        free ringValues
        return meshValue

function the connection bolt mesh of {connection fastener size:sizeValue} over {a 64 bit floating-point number:shaftLength} using {connection fastener parameters:parameters}:
    execute:
        set flatsValue to sizeValue's headFlats
        if parameters's headSeries = 1:
            set flatsValue to sizeValue's dinFlats
        set bevelValue to sizeValue's headHeight * 0.1
        set headLift to 0.0
        if (the remainder of parameters's washers divided by 2) = 1:
            set headLift to 0.0 - sizeValue's washerThickness
        set ringValues to an empty list of a connection fastener ring
        append (an axial fastener ring at (headLift - sizeValue's headHeight) reaching (flatsValue * 0.45) with 6 sides) to ringValues
        append (an axial fastener ring at ((headLift - sizeValue's headHeight) + bevelValue) reaching (flatsValue * 0.5) with 6 sides) to ringValues
        append (an axial fastener ring at headLift reaching (flatsValue * 0.5) with 6 sides) to ringValues
        append (an axial fastener ring at headLift reaching (sizeValue's diameter * 0.5) with 0 sides) to ringValues
        append (an axial fastener ring at ((headLift + shaftLength) - (sizeValue's pitch * 0.4)) reaching (sizeValue's diameter * 0.5) with 0 sides) to ringValues
        append (an axial fastener ring at (headLift + shaftLength) reaching ((sizeValue's diameter * 0.5) - (sizeValue's pitch * 0.2)) with 0 sides) to ringValues
        set meshValue to the fastener shell through ringValues closing profile false
        free ringValues
        return meshValue

function the connection anchor mesh of {connection fastener size:sizeValue} over {a 64 bit floating-point number:shaftLength} using {connection fastener parameters:parameters}:
    execute:
        set ringValues to an empty list of a connection fastener ring
        set rodReach to sizeValue's diameter * 0.5
        append (an axial fastener ring at 0.0 reaching (rodReach - (sizeValue's pitch * 0.2)) with 0 sides) to ringValues
        append (an axial fastener ring at (sizeValue's pitch * 0.4) reaching rodReach with 0 sides) to ringValues
        if (parameters's anchorShape = 1) or (parameters's anchorShape = 2):
            set bendValue to parameters's bendRadius
            if bendValue = 0.0:
                set bendValue to sizeValue's diameter * 3.0
            set tailValue to parameters's tailLength
            if tailValue = 0.0:
                set tailValue to sizeValue's diameter * 4.0
            set turnLimit to 1.5707963267948966
            set arcSteps to 12
            if parameters's anchorShape = 2:
                set turnLimit to 3.141592653589793
                set arcSteps to 24
            loop bendCursor from 0 to (arcSteps + 1):
                set bendAngle to turnLimit * ((bendCursor as a 64 bit floating-point number) / (arcSteps as a 64 bit floating-point number))
                append (@intrinsic("construct", a connection fastener ring, bendValue * (1.0 - (the cosine of bendAngle)), (shaftLength - bendValue) + (bendValue * (the sine of bendAngle)), bendAngle, rodReach, 0)) to ringValues
            set lastRing to the item at ((the length of ringValues) - 1) in ringValues
            set lastRing's x to lastRing's x + (tailValue * (the sine of turnLimit))
            set lastRing's z to lastRing's z + (tailValue * (the cosine of turnLimit))
            append lastRing to ringValues
        else:
            append (an axial fastener ring at shaftLength reaching rodReach with 0 sides) to ringValues
        set meshValue to the fastener shell through ringValues closing profile false
        free ringValues
        return meshValue

function the connection fastener mesh {fast mesh record:shapeValue} placed at {cad vector3:originValue} along {cad vector3:axisValue} rolled {a 64 bit floating-point number:rollValue}:
    execute:
        set meshValue to an empty fast mesh
        set axisLength to the cad length of axisValue
        if axisLength < 1e-9:
            return meshValue
        set forwardValue to axisValue scaled by (1.0 / axisLength)
        set acrossValue to the cad cross of (a cad vector3 with x 0.0, y 0.0 and z 1.0) and forwardValue
        if (the cad length of acrossValue) < 1e-9:
            set acrossValue to a cad vector3 with x 1.0, y 0.0 and z 0.0
        else:
            set acrossValue to acrossValue scaled by (1.0 / (the cad length of acrossValue))
        set upValue to the cad cross of forwardValue and acrossValue
        set acrossValue to the cad sum of (acrossValue scaled by (the cosine of rollValue)) and (upValue scaled by (the sine of rollValue))
        set upValue to the cad cross of forwardValue and acrossValue
        loop pointCursor from 0 to the length of (shapeValue's positions's values):
            set localPoint to the item at pointCursor in (shapeValue's positions's values)
            set localNormal to the item at pointCursor in (shapeValue's normals's values)
            append (the cad sum of originValue and (the cad sum of (acrossValue scaled by localPoint's x) and (the cad sum of (upValue scaled by localPoint's y) and (forwardValue scaled by localPoint's z)))) to (meshValue's positions's values)
            append (the cad sum of (acrossValue scaled by localNormal's x) and (the cad sum of (upValue scaled by localNormal's y) and (forwardValue scaled by localNormal's z))) to (meshValue's normals's values)
        loop indexCursor from 0 to the length of (shapeValue's triangles's values):
            append (the item at indexCursor in (shapeValue's triangles's values)) to (meshValue's triangles's values)
        return meshValue

function the connection fastener mesh {fast mesh record:shapeValue} placed at {cad vector3:originValue} along {cad vector3:axisValue}:
    execute:
        return the connection fastener mesh shapeValue placed at originValue along axisValue rolled 0.0

function the connection fastener pieces of {connection fastener:fastenerValue}:
    execute:
        set pieceValues to a cad topology list of a connection fastener piece
        set sizeValue to the connection metric fastener size of fastenerValue's diameter
        if sizeValue's valid = false:
            return pieceValues
        set parameters to fastenerValue's parameters
        if fastenerValue's kind = 6:
            append (@intrinsic("construct", a connection fastener piece, the string form of "Nut", 1, the connection nut mesh of sizeValue at 0.0 using parameters)) to (pieceValues's values)
        else if fastenerValue's kind = 7:
            append (@intrinsic("construct", a connection fastener piece, the string form of "Washer", 2, the connection washer mesh of sizeValue at 0.0)) to (pieceValues's values)
        else:
            if fastenerValue's kind = 1:
                append (@intrinsic("construct", a connection fastener piece, the string form of "Bolt", 0, the connection bolt mesh of sizeValue over fastenerValue's length using parameters)) to (pieceValues's values)
            else:
                append (@intrinsic("construct", a connection fastener piece, the string form of "Anchor rod", 0, the connection anchor mesh of sizeValue over fastenerValue's length using parameters)) to (pieceValues's values)
            set nutStation to the connection nut station of fastenerValue
            loop nutCursor from 0 to parameters's nuts:
                append (@intrinsic("construct", a connection fastener piece, (the string form of "Nut ") + (the string form of (nutCursor + 1)), 1, the connection nut mesh of sizeValue at (nutStation + (sizeValue's nutHeight * (nutCursor as a 64 bit floating-point number))) using parameters)) to (pieceValues's values)
            if (the remainder of parameters's washers divided by 2) = 1:
                append (@intrinsic("construct", a connection fastener piece, the string form of "Washer under head", 2, the connection washer mesh of sizeValue at (0.0 - sizeValue's washerThickness))) to (pieceValues's values)
            if parameters's washers >= 2:
                set washerStation to nutStation - sizeValue's washerThickness
                if fastenerValue's kind = 3:
                    set washerStation to nutStation + (sizeValue's nutHeight * (parameters's nuts as a 64 bit floating-point number))
                append (@intrinsic("construct", a connection fastener piece, the string form of "Washer under nut", 2, the connection washer mesh of sizeValue at washerStation)) to (pieceValues's values)
            if (fastenerValue's kind = 3) and (parameters's anchorShape = 3):
                set plateSize to sizeValue
                set plateSize's washerInner to sizeValue's diameter
                set plateSize's washerOuter to sizeValue's diameter * 4.0
                set plateSize's washerThickness to sizeValue's diameter * 0.5
                append (@intrinsic("construct", a connection fastener piece, the string form of "Anchor end plate", 3, the connection washer mesh of plateSize at fastenerValue's length)) to (pieceValues's values)
        loop pieceCursor from 0 to the length of (pieceValues's values):
            set pieceValue to the item at pieceCursor in (pieceValues's values)
            set pieceValue's shape to the connection fastener mesh pieceValue's shape placed at fastenerValue's origin along fastenerValue's axis
            replace item at index pieceCursor in (pieceValues's values) with pieceValue
        return pieceValues
