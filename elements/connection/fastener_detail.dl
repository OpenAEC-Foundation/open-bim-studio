import elements/connection/connections.dl

function the connection analytic detail issue of {connection fastener:value}:
    execute:
        if ((value's kind != 1) and (value's kind != 6)) and (value's kind != 7):
            return the string form of "CSG detail currently supports bolts, nuts and washers"
        return the connection catalogued fastener issue of value

function the connection analytic detail parameters of {connection fastener:value}:
    execute:
        set made to an empty list of a 64 bit floating-point number
        loop slot from 0 to 32:
            append 0.0 to made
        if (the connection analytic detail issue of value) != (the string form of ""):
            return made
        set size to the connection metric fastener size of value's diameter
        set diameter to value's diameter
        set flats to size's headFlats
        if value's parameters's headSeries = 1:
            set flats to size's dinFlats
        replace item at index 0 in made with (flats / diameter)
        replace item at index 1 in made with (size's headHeight / diameter)
        replace item at index 2 in made with (size's nutHeight / diameter)
        replace item at index 3 in made with (size's washerOuter / (2.0 * diameter))
        replace item at index 4 in made with (size's washerInner / (2.0 * diameter))
        replace item at index 5 in made with (size's washerThickness / diameter)
        replace item at index 6 in made with ((the connection thread pitch of value's parameters at diameter diameter) / diameter)
        replace item at index 7 in made with (value's length / diameter)
        replace item at index 8 in made with (value's parameters's washers as a 64 bit floating-point number)
        replace item at index 9 in made with (value's parameters's coating as a 64 bit floating-point number)
        replace item at index 10 in made with (value's kind as a 64 bit floating-point number)
        replace item at index 16 in made with (1.0)
        if value's parameters's showThread and (value's kind != 7):
            replace item at index 17 in made with (1.0)
        replace item at index 18 in made with (value's parameters's nuts as a 64 bit floating-point number)
        replace item at index 19 in made with ((the connection nut station of value) / diameter)
        set headLift to 0.0
        if (the remainder of value's parameters's washers divided by 2) = 1:
            set headLift to 0.0 - (size's washerThickness / diameter)
        replace item at index 20 in made with (headLift)
        set interval to the connection thread interval of value
        replace item at index 21 in made with (interval's x / diameter)
        replace item at index 22 in made with (interval's y / diameter)
        set low to headLift - (size's headHeight / diameter)
        set high to (value's length / diameter) + headLift
        if value's kind = 6:
            set low to 0.0
            set high to size's nutHeight / diameter
        if value's kind = 7:
            set low to 0.0
            set high to size's washerThickness / diameter
        replace item at index 25 in made with ((the maximum of (high - low) and (size's washerOuter / diameter)) * 1.4)
        replace item at index 26 in made with ((low + high) * 0.5)
        return made
