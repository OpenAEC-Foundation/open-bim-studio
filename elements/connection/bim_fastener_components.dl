# SPDX-License-Identifier: MPL-2.0
# Parametric definitions use existing reusable components and placements.
# Their solids and thread lines are derived by this module's scene point;
# the component's sketches are its selectable plan representation.
import bim/bim_model.dl
import elements/connection/fastener_geometry.dl

function the bim fastener component index of {a 64 bit integer:componentId} in {bim model record:modelValue}:
    execute:
        loop bindingCursor from 0 to the length of (modelValue's fastenerComponents's values):
            if (the item at bindingCursor in (modelValue's fastenerComponents's values))'s componentId = componentId:
                return @intrinsic("construct", a bim index result record, true, bindingCursor)
        return @intrinsic("construct", a bim index result record, false, 0)

function the bim fastener component issue of {bim fastener component record:bindingValue}:
    execute:
        if (((bindingValue's kind != 1) and (bindingValue's kind != 3)) and (bindingValue's kind != 6)) and (bindingValue's kind != 7):
            return the string form of "Unknown fastener component family"
        if bindingValue's parameters's catalogue = false:
            return the string form of "A fastener component requires a catalogue definition"
        if (bindingValue's kind = 6) or (bindingValue's kind = 7):
            if (bindingValue's parameters's nuts != 0) or (bindingValue's parameters's washers != 0):
                return the string form of "Standalone nuts and washers do not contain an assembly"
        set candidateValue to @intrinsic("construct", a connection fastener, 1, 0 as a 64 bit integer, bindingValue's kind, the cad zero vector3, (a cad vector3 with x 0.0, y 0.0 and z 1.0), bindingValue's diameter, bindingValue's length, bindingValue's parameters)
        return the connection catalogued fastener issue of candidateValue

function the bim fastener family name of {integer:familyValue} shaped {integer:anchorValue}:
    execute:
        if familyValue = 1:
            return the string form of "Hex bolt"
        if familyValue = 6:
            return the string form of "Hex nut"
        if familyValue = 7:
            return the string form of "Plain washer"
        if anchorValue = 1:
            return the string form of "L anchor"
        if anchorValue = 2:
            return the string form of "J anchor"
        if anchorValue = 3:
            return the string form of "Plate-ended anchor"
        return the string form of "Straight anchor"

function the bim fastener component name of {bim fastener component record:bindingValue}:
    execute:
        set titleValue to (the bim fastener family name of bindingValue's kind shaped bindingValue's parameters's anchorShape) + ((the string form of " M") + (the string form of ((bindingValue's diameter * 1000.0) as an integer)))
        if (bindingValue's kind = 1) or (bindingValue's kind = 3):
            set titleValue to titleValue + ((the string form of " x ") + (the string form of (bindingValue's length * 1000.0)))
        if (bindingValue's kind = 1) and (bindingValue's parameters's threadLength > 0.0):
            set titleValue to titleValue + (the string form of " partial thread")
        if (the connection metric fastener size of bindingValue's diameter)'s commercial:
            set titleValue to titleValue + (the string form of " (commercial size)")
        return titleValue

local function append fastener plan segments of {a pointer to a list:pointValues} into {a pointer to a list:partValues}:
    execute:
        loop segmentCursor from 0 to ((the length of pointValues) - 1):
            set segmentPoints to a cad topology list of a cad vector2
            append (the item at segmentCursor in pointValues) to (segmentPoints's values)
            append (the item at (segmentCursor + 1) in pointValues) to (segmentPoints's values)
            append (@intrinsic("construct", a bim sketch record, 0 as a 64 bit integer, 0 as a 64 bit integer, bim line sketch, segmentPoints, 0.0, the string form of "")) to partValues

function the bim fastener plan of {bim fastener component record:bindingValue}:
    execute:
        set planParts to an empty list of a bim sketch record
        set sizeValue to the connection metric fastener size of bindingValue's diameter
        set ringPoints to a cad topology list of a cad vector2
        set cornersValue to 6
        set reachValue to sizeValue's headFlats / 1.7320508075688772
        set phaseValue to 0.5235987755982988
        if bindingValue's parameters's headSeries = 1:
            set reachValue to sizeValue's dinFlats / 1.7320508075688772
        if bindingValue's kind = 3:
            set cornersValue to 48
            set reachValue to sizeValue's diameter * 0.5
            set phaseValue to 0.0
        if (bindingValue's kind = 7) or (bindingValue's parameters's washers > 0):
            set cornersValue to 48
            set reachValue to sizeValue's washerOuter * 0.5
            set phaseValue to 0.0
        loop pointCursor from 0 to (cornersValue + 1):
            set ringAngle to phaseValue + (6.283185307179586 * ((pointCursor as a 64 bit floating-point number) / (cornersValue as a 64 bit floating-point number)))
            append (a cad vector2 with x (reachValue * (the cosine of ringAngle)) and y (reachValue * (the sine of ringAngle))) to (ringPoints's values)
        append fastener plan segments of (ringPoints's values) into planParts
        if (bindingValue's kind = 6) or (bindingValue's kind = 7):
            set innerPoints to a cad topology list of a cad vector2
            set innerReach to sizeValue's diameter * 0.5
            if bindingValue's kind = 7:
                set innerReach to sizeValue's washerInner * 0.5
            loop pointCursor from 0 to 49:
                set ringAngle to 6.283185307179586 * ((pointCursor as a 64 bit floating-point number) / 48.0)
                append (a cad vector2 with x (innerReach * (the cosine of ringAngle)) and y (innerReach * (the sine of ringAngle))) to (innerPoints's values)
            append fastener plan segments of (innerPoints's values) into planParts
        return planParts

function store bim fastener component {bim fastener component record:bindingValue} in {a pointer to a bim model record:target}:
    execute:
        if (the bim fastener component issue of bindingValue) != (the string form of ""):
            return false
        set componentFound to the bim component index of bindingValue's componentId in (@intrinsic("dereference", target))
        if componentFound's valid = false:
            return false
        set existingFound to the bim fastener component index of bindingValue's componentId in (@intrinsic("dereference", target))
        if existingFound's valid:
            replace item at index existingFound's position in (target's fastenerComponents's values) with bindingValue
        else:
            append bindingValue to (target's fastenerComponents's values)
        set definitionValue to the item at componentFound's position in (target's components's values)
        set definitionValue's name to the bim fastener component name of bindingValue
        replace item at index componentFound's position in (target's components's values) with definitionValue
        set planParts to the bim fastener plan of bindingValue
        ignore set bim component bindingValue's componentId contents to planParts in target
        free planParts
        return true

function add bim fastener component of kind {integer:familyValue} sized {a 64 bit floating-point number:diameterValue} by {a 64 bit floating-point number:lengthValue} configured {connection fastener parameters:parameters} library slot {integer:slotValue} in {a pointer to a bim model record:target}:
    execute:
        set bindingValue to @intrinsic("construct", a bim fastener component record, 0 as a 64 bit integer, slotValue, familyValue, diameterValue, lengthValue, parameters)
        if (the bim fastener component issue of bindingValue) != (the string form of ""):
            return the bim refused id
        set bindingValue's componentId to add bim component named (the bim fastener component name of bindingValue) to target
        ignore store bim fastener component bindingValue in target
        return bindingValue's componentId

function add bim metric fastener library to {a pointer to a bim model record:target}:
    execute:
        set resultIds to a cad topology list of a 64 bit integer
        loop metricCursor from 0 to 15:
            set diameterValue to the connection fastener diameter at metricCursor
            set sizeValue to the connection metric fastener size of diameterValue
            loop familyCursor from 0 to 8:
                set slotValue to (metricCursor * 8) + familyCursor
                set existingId to the bim refused id
                loop bindingCursor from 0 to the length of (target's fastenerComponents's values):
                    set heldBinding to the item at bindingCursor in (target's fastenerComponents's values)
                    if heldBinding's librarySlot = slotValue:
                        set existingId to heldBinding's componentId
                if existingId != the bim refused id:
                    append existingId to (resultIds's values)
                else:
                    set parameters to catalogued connection fastener parameters
                    set parameters's coating to 1
                    set familyValue to 1
                    set lengthValue to diameterValue * 5.0
                    if familyCursor = 1:
                        set parameters's threadLength to diameterValue * 3.0
                    if familyCursor = 2:
                        set familyValue to 6
                        set parameters's nuts to 0
                        set lengthValue to sizeValue's nutHeight
                    if familyCursor = 3:
                        set familyValue to 7
                        set parameters's nuts to 0
                        set parameters's showThread to false
                        set lengthValue to sizeValue's washerThickness
                    if familyCursor >= 4:
                        set familyValue to 3
                        set parameters's anchorShape to familyCursor - 4
                        set parameters's washers to 2
                        set lengthValue to diameterValue * 20.0
                    set createdId to add bim fastener component of kind familyValue sized diameterValue by lengthValue configured parameters library slot slotValue in target
                    if createdId = the bim refused id:
                        return resultIds
                    append createdId to (resultIds's values)
        return resultIds

function the bim fastener instance definition {bim fastener component record:bindingValue} placed by {bim instance record:placement} at elevation {a 64 bit floating-point number:elevationValue}:
    execute:
        return @intrinsic("construct", a connection fastener, 1, placement's id, bindingValue's kind, (a cad vector3 with x placement's origin's x, y placement's origin's y and z elevationValue), (a cad vector3 with x 0.0, y 0.0 and z 1.0), bindingValue's diameter, bindingValue's length, bindingValue's parameters)
