# SPDX-License-Identifier: MPL-2.0
# One parameter set for library components and connection fastening groups.
# Zero pitch/thread length/grip/bend dimensions mean the documented size default.
import elements/connection/fastener_catalog.dl

class:
    patterns:
        [a|] connection fastener parameters
    members:
        pitch as a 64 bit floating-point number
        threadLength as a 64 bit floating-point number
        grade as an integer
        # 0 uncoated, 1 hot-dip galvanized, 2 electrolytically zinc-plated.
        coating as an integer
        # Bit 0 under the head, bit 1 under the nut.
        washers as an integer
        nuts as an integer
        nutClass as an integer
        grip as a 64 bit floating-point number
        # 0 straight, 1 L, 2 J, 3 plate-ended anchor.
        anchorShape as an integer
        bendRadius as a 64 bit floating-point number
        tailLength as a 64 bit floating-point number
        showThread as a boolean
        # 0 ISO spanner widths, 1 legacy DIN spanner widths.
        headSeries as an integer
        # Older connection records keep their schematic representation until
        # explicitly upgraded. New library components use the catalogue.
        catalogue as a boolean

# A typed definition attached to an existing reusable component. Instances,
# placement, selection and copying use the application's component mechanism.
class:
    patterns:
        [a|] bim fastener component record
    members:
        componentId as a 64 bit integer
        librarySlot as an integer
        kind as an integer
        diameter as a 64 bit floating-point number
        length as a 64 bit floating-point number
        parameters as a connection fastener parameters

function default connection fastener parameters:
    execute:
        return @intrinsic("construct", a connection fastener parameters, 0.0, 0.0, 88, 0, 0, 1, 8, 0.0, 0, 0.0, 0.0, true, 0, false)

function catalogued connection fastener parameters:
    execute:
        set defaultsValue to default connection fastener parameters
        set defaultsValue's catalogue to true
        return defaultsValue

function the connection coating name of {integer:coatingCode}:
    execute:
        if coatingCode = 0:
            return the string form of "Uncoated"
        if coatingCode = 1:
            return the string form of "Hot-dip galvanized"
        if coatingCode = 2:
            return the string form of "Electrolytically zinc-plated"
        return the string form of "Unknown coating"

function the connection fastener colour of {connection fastener parameters:parameters}:
    execute:
        if parameters's coating = 1:
            return a cad vector3 with x 166.0, y 173.0 and z 178.0
        if parameters's coating = 2:
            return a cad vector3 with x 198.0, y 209.0 and z 218.0
        return a cad vector3 with x 105.0, y 111.0 and z 119.0

function the connection grade name of {integer:gradeCode}:
    execute:
        if gradeCode = 46:
            return the string form of "4.6"
        if gradeCode = 88:
            return the string form of "8.8"
        return the string form of "Unknown grade"

function the connection washer name of {integer:washerCode}:
    execute:
        if washerCode = 0:
            return the string form of "None"
        if washerCode = 1:
            return the string form of "Under head"
        if washerCode = 2:
            return the string form of "Under nut"
        if washerCode = 3:
            return the string form of "Under head and nut"
        return the string form of "Unknown washer layout"

function the connection thread pitch of {connection fastener parameters:parameters} at diameter {a 64 bit floating-point number:diameterValue}:
    execute:
        if parameters's pitch > 0.0:
            return parameters's pitch
        return (the connection metric fastener size of diameterValue)'s pitch

function the connection threaded length of {connection fastener parameters:parameters} over {a 64 bit floating-point number:shaftLength}:
    execute:
        if parameters's threadLength > 0.0:
            return parameters's threadLength
        return shaftLength

# All checks are positive comparisons so NaN/infinity is refused too.
function the connection fastener parameter issue of {connection fastener parameters:parameters} at diameter {a 64 bit floating-point number:diameterValue} over {a 64 bit floating-point number:shaftLength} for kind {integer:kindValue}:
    execute:
        set metricSize to the connection metric fastener size of diameterValue
        if metricSize's valid = false:
            return the string form of "Choose a supported metric size M8-M40"
        if ((shaftLength > 0.0) and (shaftLength <= 10.0)) = false:
            return the string form of "Fastener length must be positive and at most 10 m"
        if (parameters's grade != 46) and (parameters's grade != 88):
            return the string form of "Fastener grade must be 4.6 or 8.8"
        if (parameters's coating < 0) or (parameters's coating > 2):
            return the string form of "Unknown fastener coating"
        if (parameters's washers < 0) or (parameters's washers > 3):
            return the string form of "Unknown fastener washer layout"
        if (parameters's nuts < 0) or (parameters's nuts > 2):
            return the string form of "Choose zero, one or two nuts"
        if (parameters's nutClass != 5) and (parameters's nutClass != 8):
            return the string form of "Nut property class must be 5 or 8"
        if (parameters's nuts > 0) and ((parameters's grade = 88) and (parameters's nutClass < 8)):
            return the string form of "Class 8.8 requires a class 8 nut"
        if ((parameters's pitch = 0.0) or ((parameters's pitch >= 0.000001) and (parameters's pitch < diameterValue))) = false:
            return the string form of "Thread pitch must be positive or Auto"
        if ((parameters's threadLength >= 0.0) and (parameters's threadLength <= shaftLength)) = false:
            return the string form of "Thread length must fit the shaft or be Auto"
        if ((parameters's grip >= 0.0) and (parameters's grip < shaftLength)) = false:
            return the string form of "Grip length must fit the shaft or be Auto"
        if (parameters's anchorShape < 0) or (parameters's anchorShape > 3):
            return the string form of "Unknown anchor shape"
        if ((parameters's bendRadius >= 0.0) and (parameters's bendRadius <= 1.0)) = false:
            return the string form of "Invalid anchor bend radius"
        if ((parameters's tailLength >= 0.0) and (parameters's tailLength <= 5.0)) = false:
            return the string form of "Invalid anchor tail length"
        if (parameters's headSeries < 0) or (parameters's headSeries > 1):
            return the string form of "Unknown head dimension series"
        set nutStack to metricSize's nutHeight * (parameters's nuts as a 64 bit floating-point number)
        if (parameters's washers >= 2) and (parameters's nuts > 0):
            set nutStack to nutStack + metricSize's washerThickness
        set pitchValue to the connection thread pitch of parameters at diameter diameterValue
        if (parameters's nuts > 0) and ((nutStack + (2.0 * pitchValue)) >= shaftLength):
            return the string form of "Fastener is too short for nuts and thread projection"
        set availableLength to shaftLength
        if (kindValue = 1) and ((the remainder of parameters's washers divided by 2) = 1):
            set availableLength to availableLength - metricSize's washerThickness
        if ((kindValue = 1) and (parameters's nuts > 0)) and (((parameters's grip + nutStack) + (2.0 * pitchValue)) > availableLength):
            return the string form of "Nuts extend beyond the available shaft"
        if ((parameters's washers >= 2) and (parameters's nuts = 0)):
            return the string form of "An under-nut washer requires a nut"
        return the string form of ""

function the connection fastener parameter issue of {connection fastener parameters:parameters} at diameter {a 64 bit floating-point number:diameterValue} over {a 64 bit floating-point number:shaftLength}:
    execute:
        return the connection fastener parameter issue of parameters at diameter diameterValue over shaftLength for kind 1
