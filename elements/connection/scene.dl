# SPDX-License-Identifier: MPL-2.0
# The connection module's part of the scene: connections: their solids and thread lines, kept whenever they are
# in `previous` (fixed modelling tolerance). Called by the
# composed dispatcher (`append bim module scene meshes of`) in layer order;
# the order does not matter, kept meshes are found by element id and part.
import viewer/bim_scene.dl

function append bim scene meshes of {bim model record:modelValue} within {a 64 bit floating-point number:tolerance} reusing {a pointer to a list:previous} keyed {a pointer to a list:keys} refreshing {a pointer to a list:remadeIds} with reinforcement detail {boolean:rebarDetail} into {a pointer to a list:result} with elements_connection elements:
    execute:
        # Connections: fixed modelling tolerance, so kept whenever they are
        # in `previous` (`the bim connection cache of` keeps those unaffected
        # by the edits since).
        loop cursor from 0 to the length of (modelValue's connections's values):
            set spec to the item at cursor in (modelValue's connections's values)
            set solidSlot to the bim kept slot of spec's id part (bim connection solid part) among keys
            if solidSlot >= 0:
                append (the item at solidSlot in previous) to result
            else:
                set derived to the bim parts of connection spec in modelValue
                append (@intrinsic("construct", a bim scene mesh record, spec's id, 0 as a 64 bit integer, bim connection solid part, the bim independent shapes of (derived's values) in modelValue, bim other category, the bim material colour of (the string form of "steel"), the string form of "steel")) to result
            set threadSlot to the bim kept slot of spec's id part (bim connection thread part) among keys
            if threadSlot >= 0:
                append (the item at threadSlot in previous) to result
            else:
                append (@intrinsic("construct", a bim scene mesh record, spec's id, 0 as a 64 bit integer, bim connection thread part, the bim thread line shape of spec in modelValue, bim other category, (a cad vector3 with x 42.0, y 46.0 and z 52.0), the string form of "")) to result
            set evaluatedValue to a connection refusal saying (the string form of "")
            set evaluationReady to false
            loop additionCursor from 0 to the length of (spec's additions's values):
                set additionValue to the item at additionCursor in (spec's additions's values)
                if ((additionValue's kind = 1) or (additionValue's kind = 3)) and additionValue's parameters's catalogue:
                    set fastenerPart to 16 + additionCursor
                    set fastenerSlot to the bim kept slot of spec's id part fastenerPart among keys
                    if fastenerSlot >= 0:
                        append (the item at fastenerSlot in previous) to result
                    else:
                        if evaluationReady = false:
                            set evaluatedValue to the bim connection evaluation of spec in modelValue
                            set evaluationReady to true
                        set groupShape to the bim catalogued fastening shape of evaluatedValue keyed additionValue's key
                        append (@intrinsic("construct", a bim scene mesh record, spec's id, 0 as a 64 bit integer, fastenerPart, groupShape, bim other category, the connection fastener colour of additionValue's parameters, the string form of "")) to result
        # Shared component geometry is made once per definition in this build,
        # then placed using existing instance ids and the same cache keys.
        loop bindingCursor from 0 to the length of (modelValue's fastenerComponents's values):
            set bindingValue to the item at bindingCursor in (modelValue's fastenerComponents's values)
            set canonicalReady to false
            set canonicalSolid to an empty fast mesh
            set canonicalThread to an empty fast mesh
            loop placementCursor from 0 to the length of (modelValue's instances's values):
                set placement to the item at placementCursor in (modelValue's instances's values)
                if placement's componentId = bindingValue's componentId:
                    set levelFound to the bim level index of placement's levelId in modelValue
                    if levelFound's valid:
                        set solidSlot to the bim kept slot of placement's id part (bim placement part) among keys unless remadeIds
                        set threadSlot to the bim kept slot of placement's id part (bim connection thread part) among keys unless remadeIds
                        if (solidSlot < 0) or (threadSlot < 0):
                            if canonicalReady = false:
                                set canonicalSolid to the bim fastener component shape of bindingValue
                                set canonicalThread to the bim fastener component thread shape of bindingValue
                                set canonicalReady to true
                        set elevationValue to (the item at levelFound's position in (modelValue's levels's values))'s elevation
                        set placementOrigin to a cad vector3 with x placement's origin's x, y placement's origin's y and z elevationValue
                        set placementAxis to a cad vector3 with x 0.0, y 0.0 and z 1.0
                        if solidSlot >= 0:
                            append (the item at solidSlot in previous) to result
                        else:
                            set placedShape to the connection fastener mesh canonicalSolid placed at placementOrigin along placementAxis rolled placement's angle
                            append (@intrinsic("construct", a bim scene mesh record, placement's id, 0 as a 64 bit integer, bim placement part, placedShape, bim mass category, the connection fastener colour of bindingValue's parameters, the string form of "")) to result
                        if threadSlot >= 0:
                            append (the item at threadSlot in previous) to result
                        else:
                            set placedThread to the connection fastener mesh canonicalThread placed at placementOrigin along placementAxis rolled placement's angle
                            append (@intrinsic("construct", a bim scene mesh record, placement's id, 0 as a 64 bit integer, bim connection thread part, placedThread, bim mass category, (a cad vector3 with x 42.0, y 46.0 and z 52.0), the string form of "")) to result
