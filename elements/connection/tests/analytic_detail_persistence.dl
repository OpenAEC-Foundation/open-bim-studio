import elements/connection/bim_fastener_components.dl
import elements/connection/fastener_detail.dl
import exchange/ifcx/bim_file.dl

function check analytic persistence {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print label as a line

function the analytic parameters of binding {bim fastener component record:binding}:
    execute:
        set fastener to @intrinsic("construct", a connection fastener, 1, binding's componentId, binding's kind, the cad zero vector3, the cad z axis, binding's diameter, binding's length, binding's parameters)
        return the connection analytic detail parameters of fastener

set detailDocument to a new bim document
set detailTarget to the address of (detailDocument's current)
set detailLevel to add bim level named (the string form of "CSG detail") at 0.0 with height 1.0 to detailTarget
# The native editor requires these basic type definitions even in a detail file.
set detailLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to detailLayers
ignore add bim wall type named (the string form of "Default wall") with detailLayers to detailTarget
free detailLayers
ignore add bim opening type named (the string form of "Default window") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to detailTarget
ignore add bim door type named (the string form of "Default door") sized 0.9 by 2.1 with frame 0.05 to detailTarget
set detailLibrary to add bim metric fastener library to detailTarget
set detailSlots to an empty list of an integer
append 0 to detailSlots
append 32 to detailSlots
append 64 to detailSlots
append 112 to detailSlots
append 34 to detailSlots
append 35 to detailSlots
loop cursor from 0 to the length of detailSlots:
    ignore place bim component (the item at (the item at cursor in detailSlots) in (detailLibrary's values)) on detailLevel at (a cad vector2 with x ((cursor as a 64 bit floating-point number) * 0.2) and y 0.0) turned 0.0 to detailTarget
set detailBinding to the item at 32 in (detailTarget's fastenerComponents's values)
set initialDetailText to the bim file text of detailDocument's current
set detailValues to the analytic parameters of binding detailBinding
check analytic persistence ((the bim file text of detailDocument's current) = initialDetailText) named (the string form of "Inspecting parameters leaves the native model unchanged")
begin bim transaction in (the address of detailDocument)
set detailBinding's parameters's washers to 3
set detailBinding's parameters's nuts to 1
set detailBinding's parameters's pitch to 0.0015
set detailBinding's parameters's coating to 2
check analytic persistence (store bim fastener component detailBinding in detailTarget) named (the string form of "Shared type edit accepted")
commit bim transaction in (the address of detailDocument)
set editedDetailText to the bim file text of detailDocument's current
set parsedDetail to the bim model parsed from editedDetailText
check analytic persistence parsedDetail's valid named (the string form of "Edited CSG detail parameters reopen")
set savedDetailValues to the analytic parameters of binding (the item at 32 in (parsedDetail's modelValue's fastenerComponents's values))
set editedDetailValues to the analytic parameters of binding detailBinding
set sameDetail to true
loop cursor from 0 to 32:
    if (the item at cursor in savedDetailValues) != (the item at cursor in editedDetailValues):
        set sameDetail to false
check analytic persistence sameDetail named (the string form of "All rendering parameters survive native roundtrip")
ignore undo bim transaction in (the address of detailDocument)
check analytic persistence ((the bim file text of detailDocument's current) = initialDetailText) named (the string form of "Undo restores the original type")
ignore redo bim transaction in (the address of detailDocument)
check analytic persistence ((the bim file text of detailDocument's current) = editedDetailText) named (the string form of "Redo restores the edited type")
ignore @intrinsic("call", "libc", "mkdir", integer, "build", 493)
ignore @intrinsic("call", "libc", "mkdir", integer, "build/analytic-obs", 493)
check analytic persistence (write bim text editedDetailText to file (the string form of "build/analytic-obs/analytic-detail-fixture.bim")) named (the string form of "Native six-component fixture saved")
free detailSlots
free detailValues
free savedDetailValues
free editedDetailValues
