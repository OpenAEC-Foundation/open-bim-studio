import elements/connection/fastener_detail.dl

function check analytic detail {boolean:valid} named {a string:name}:
    execute:
        if valid = false:
            print ((the string form of "FAIL ") + name) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print name as a line

set settings to catalogued connection fastener parameters
set fastener to @intrinsic("construct", a connection fastener, 1, 5 as a 64 bit integer, 1, the cad zero vector3, the cad z axis, 0.016, 0.08, settings)
set values to the connection analytic detail parameters of fastener
check analytic detail ((the item at 7 in values) = 5.0) named (the string form of "Actual bolt length")
check analytic detail ((the item at 6 in values) = 0.125) named (the string form of "Catalogue pitch")
set fastener's parameters's pitch to 0.0015
set fastener's parameters's washers to 3
set fastener's parameters's nuts to 2
set fastener's parameters's grip to 0.03
set changed to the connection analytic detail parameters of fastener
check analytic detail ((the item at 6 in changed) = 0.09375) named (the string form of "Edited pitch")
check analytic detail (((the item at 8 in changed) = 3.0) and ((the item at 18 in changed) = 2.0)) named (the string form of "Actual washer and nut counts")
check analytic detail ((the absolute value of ((the item at 19 in changed) - (0.033 / 0.016))) < 0.000001) named (the string form of "Grip controls nut position")
check analytic detail ((the item at 20 in changed) = -0.1875) named (the string form of "Washer shifts bolt head")
set fastener's kind to 2
check analytic detail ((the connection analytic detail issue of fastener) != (the string form of "")) named (the string form of "Unsupported screw is explicit")
set fastener's kind to 3
set fastener's length to 0.32
set fastener's parameters's washers to 2
set fastener's parameters's grip to 0.06
loop shape from 0 to 4:
    set fastener's parameters's anchorShape to shape
    check analytic detail ((the connection analytic detail issue of fastener) = (the string form of "")) named ((the string form of "Anchor supported ") + (the string form of shape))
    set anchor to the connection analytic detail parameters of fastener
    check analytic detail ((the item at 27 in anchor) = (shape as a 64 bit floating-point number)) named ((the string form of "Anchor form retained ") + (the string form of shape))
    free anchor
set fastener's parameters's anchorShape to 0
set fastener's kind to 6
set fastener's parameters's washers to 0
set fastener's parameters's nuts to 0
set fastener's parameters's grip to 0.0
set nut to the connection analytic detail parameters of fastener
check analytic detail ((the item at 10 in nut) = 6.0) named (the string form of "Standalone nut stays standalone")
set fastener's kind to 7
set washer to the connection analytic detail parameters of fastener
check analytic detail ((the item at 17 in washer) = 0.0) named (the string form of "Washer has no thread marks")
free values
free changed
free nut
free washer
