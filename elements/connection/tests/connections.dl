# SPDX-License-Identifier: MPL-2.0
import elements/connection/connections.dl

function check connection test {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set members to a cad topology list of a connection member
set additions to a cad topology list of a connection addition
set frames to an empty list of a connection member frame
set zero to a cad vector3 with x 0.0, y 0.0 and z 0.0
append (@intrinsic("construct", a connection member, 10 as a 64 bit integer, 0, 0.01, 0.0)) to (members's values)
append (@intrinsic("construct", a connection member, 20 as a 64 bit integer, 1, 0.02, 0.0)) to (members's values)
append (@intrinsic("construct", a connection member frame, 10 as a 64 bit integer, zero, (a cad vector3 with x 1.0, y 0.0 and z 0.0), 3.0)) to frames
append (@intrinsic("construct", a connection member frame, 20 as a 64 bit integer, zero, (a cad vector3 with x 0.0, y 1.0 and z 0.0), 3.0)) to frames
set spec to @intrinsic("construct", a connection definition, 1 as a 64 bit integer, 2 as a 64 bit integer, the string form of "J01", 0, 0, zero, members, additions)
set made to the connection of spec using frames
check connection test (made's valid and ((the length of (made's voids's values)) = 2)) named (the string form of "butt has separate member voids")
check connection test ((the item at 0 in (made's voids's values))'s origin's x = 0.01) named (the string form of "setback drives trim plane")
set spec's style to 1
set made to the connection of spec using frames
set normalValue to (the item at 0 in (made's voids's values))'s direction
check connection test (made's valid and ((the absolute value of (normalValue's x + normalValue's y)) < 1e-12)) named (the string form of "miter bisects a right angle")
set spec's category to 1
set spec's style to 0
set bolt to @intrinsic("construct", a connection addition, 1, 10 as a 64 bit integer, 1, zero, (a cad vector3 with x 0.0, y 0.0 and z 1.0), 0.0, 0.0, 0.0, 0.02, 0.08, 2, 2, 0.06, 0.06, 0.022, default connection fastener parameters)
append bolt to (spec's additions's values)
set screw to bolt
set screw's key to 2
set screw's kind to 2
set screw's diameter to 0.006
set screw's holeDiameter to 0.004
set screw's rows to 1
set screw's columns to 1
append screw to (spec's additions's values)
set made to the connection of spec using frames
check connection test (made's valid and ((the length of (made's fasteners's values)) = 5)) named (the string form of "four bolts plus one screw")
check connection test ((the length of (made's voids's values)) = 7) named (the string form of "two trims plus five holes")
check connection test ((the item at 4 in (made's fasteners's values))'s kind = 2) named (the string form of "screw identity retained")
set bolt's holeDiameter to 0.018
replace item at index 0 in (spec's additions's values) with bolt
check connection test ((the connection of spec using frames)'s valid = false) named (the string form of "undersized bolt hole refused")
set bolt's holeDiameter to 0.022
set bolt's axis to zero
replace item at index 0 in (spec's additions's values) with bolt
check connection test ((the connection of spec using frames)'s valid = false) named (the string form of "zero fastening axis refused")
set bolt's axis to a cad vector3 with x 0.0, y 0.0 and z 1.0
set bolt's rows to 100
set bolt's columns to 100
replace item at index 0 in (spec's additions's values) with bolt
check connection test ((the connection of spec using frames)'s valid = false) named (the string form of "oversized fastening grid refused")
set spec's additions to a cad topology list of a connection addition
loop count from 3 to 7:
    set identity to count as a 64 bit integer
    append (@intrinsic("construct", a connection member, identity, 0, 0.0, 0.0)) to (spec's members's values)
    append (@intrinsic("construct", a connection member frame, identity, zero, (a cad vector3 with x 0.0, y 0.0 and z 1.0), 2.0)) to frames
    if count = 3:
        set spec's category to 0
        check connection test ((the connection of spec using frames)'s valid = false) named (the string form of "Simple joint refuses three members")
        set spec's category to 1
    set made to the connection of spec using frames
    check connection test (made's valid and ((the length of (made's voids's values)) = count)) named ((the string form of "complex member count ") + (the string form of count))
append (@intrinsic("construct", a connection member, 99 as a 64 bit integer, 0, 0.0, 0.0)) to (spec's members's values)
append (@intrinsic("construct", a connection member frame, 99 as a 64 bit integer, zero, (a cad vector3 with x 0.0, y 0.0 and z 1.0), 2.0)) to frames
check connection test ((the connection of spec using frames)'s valid) named (the string form of "seventh member supported")
set host to the item at 0 in (spec's members's values)
set host's end to 2
set host's setback to 0.0
set host's position to 0.5
replace item at index 0 in (spec's members's values) with host
set made to the connection of spec using frames
check connection test (made's valid and ((the length of (made's voids's values)) = 6)) named (the string form of "interior host remains untrimmed")
set weld to @intrinsic("construct", a connection addition, 42, 10 as a 64 bit integer, 4, zero, (a cad vector3 with x 0.0, y 1.0 and z 0.0), 0.0, 0.0, 0.006, 0.0, 0.2, 0, 0, 0.0, 0.0, 0.0, default connection fastener parameters)
append weld to (spec's additions's values)
set made to the connection of spec using frames
check connection test (made's valid and ((the length of (made's welds's values)) = 1)) named (the string form of "fillet weld retained independently")
check connection test (((the length of (made's fasteners's values)) = 0) and ((the length of (made's voids's values)) = 6)) named (the string form of "weld creates no bolt holes")
set weld's thickness to 0.0
replace item at index 0 in (spec's additions's values) with weld
check connection test ((the connection of spec using frames)'s valid = false) named (the string form of "zero weld size refused")
set host's position to 1.01
replace item at index 0 in (spec's members's values) with host
check connection test ((the connection of spec using frames)'s valid = false) named (the string form of "position outside host refused")
free frames
