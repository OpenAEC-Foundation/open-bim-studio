# SPDX-License-Identifier: MPL-2.0
import elements/connection/bim_fastener_detail.dl

function check catalogue thread {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set threadParameters to catalogued connection fastener parameters
set threadParameters's washers to 3
set threadFastener to @intrinsic("construct", a connection fastener, 1, 1 as a 64 bit integer, 1, (a cad vector3 with x 0.0, y 0.0 and z 0.0), (a cad vector3 with x 0.0, y 0.0 and z 1.0), 0.012, 0.060, threadParameters)
set threadPoints to the bim cosmetic helix of threadFastener
set startPoint to the item at 0 in (threadPoints's values)
set oneTurn to the item at 24 in (threadPoints's values)
set endPoint to the item at ((the length of (threadPoints's values)) - 1) in (threadPoints's values)
check catalogue thread ((the absolute value of ((oneTurn's z - startPoint's z) - 0.00175)) < 1e-12) named (the string form of "M12 advances exactly 1.75 mm per turn")
check catalogue thread (((the absolute value of (oneTurn's x - startPoint's x)) < 1e-12) and ((the absolute value of (oneTurn's y - startPoint's y)) < 1e-12)) named (the string form of "one turn closes in the transverse plane")
check catalogue thread (((the absolute value of (startPoint's z + 0.0025)) < 1e-12) and ((the absolute value of (endPoint's z - 0.0575)) < 1e-12)) named (the string form of "head washer and under-head length bound the full thread")
set threadFastener's parameters's threadLength to 0.020
set threadPoints to the bim cosmetic helix of threadFastener
set startPoint to the item at 0 in (threadPoints's values)
check catalogue thread ((the absolute value of (startPoint's z - 0.0375)) < 1e-12) named (the string form of "partial thread starts at the actual shank boundary")
set threadFastener's diameter to 0.008
set threadFastener's parameters's washers to 0
set threadFastener's parameters's threadLength to 0.0
set threadFastener's axis to a cad vector3 with x 0.0, y 0.0 and z -2.0
set threadPoints to the bim cosmetic helix of threadFastener
set startPoint to the item at 0 in (threadPoints's values)
set oneTurn to the item at 24 in (threadPoints's values)
check catalogue thread ((the absolute value of ((startPoint's z - oneTurn's z) - 0.00125)) < 1e-12) named (the string form of "reversed normalized axis retains M8 pitch")
set threadFastener's parameters's showThread to false
set hiddenPoints to the bim cosmetic helix of threadFastener
check catalogue thread ((the length of (hiddenPoints's values)) = 0) named (the string form of "thread detail can be disabled without changing the solid")
