# SPDX-License-Identifier: MPL-2.0
import graphics/bim_scene.dl
import model/bim_baseplate.dl

function check thread scene {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set levelId to add bim level named (the string form of "Base") at 4.0 with height 3.0 to target
set typeId to add bim linear type named (the string form of "Column") as role bim column role sized 0.20 by 0.30 round false of (the string form of "steel") to target
set columnId to add bim linear typed typeId on levelId from (a cad vector3 with x 2.0, y 3.0 and z 0.0) to (a cad vector3 with x 2.0, y 3.0 and z 3.0) turned 0.0 to target
set nodeId to add bim base plate below columnId in target
check thread scene (nodeId != the bim refused id) named (the string form of "base plate fixture created")
set spec to the item at 0 in (modelValue's connections's values)
set shape to the bim thread line shape of spec in modelValue
check thread scene ((the length of (shape's positions's values)) = 1536) named (the string form of "four bounded helical polylines")
check thread scene ((the length of (shape's triangles's values)) = 0) named (the string form of "thread adds no solid triangles")
set firstPoint to the item at 0 in (shape's positions's values)
check thread scene ((the absolute value of (firstPoint's z - 4.04)) < 1e-9) named (the string form of "thread retains world elevation")
