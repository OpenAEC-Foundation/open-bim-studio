# SPDX-License-Identifier: MPL-2.0
import elements/connection/fastener_geometry.dl

function check fastener solids {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set geometryParameters to catalogued connection fastener parameters
set originValue to a cad vector3 with x 0.0, y 0.0 and z 0.0
set axisValue to a cad vector3 with x 0.0, y 0.0 and z 1.0
loop sizeCursor from 0 to 15:
    set metricDiameter to the connection fastener diameter at sizeCursor
    set geometryFastener to @intrinsic("construct", a connection fastener, 1, 1 as a 64 bit integer, 1, originValue, axisValue, metricDiameter, metricDiameter * 5.0, geometryParameters)
    set geometryPieces to the connection fastener pieces of geometryFastener
    if (the length of (geometryPieces's values)) != 2:
        @intrinsic("call", "libc", "exit", nothing, 1)
    loop pieceCursor from 0 to the length of (geometryPieces's values):
        set checkedMesh to (the item at pieceCursor in (geometryPieces's values))'s shape
        if (the fast mesh flaw of checkedMesh) != 0:
            print ((the string form of "Mesh flaw at diameter ") + (the string form of metricDiameter)) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        if (the fast mesh volume of checkedMesh) <= 0.0:
            @intrinsic("call", "libc", "exit", nothing, 1)
check fastener solids true named (the string form of "all 15 bolt bodies and nut bores are closed positive solids")
set geometryParameters's washers to 3
set geometryFastener to @intrinsic("construct", a connection fastener, 1, 1 as a 64 bit integer, 1, originValue, axisValue, 0.016, 0.080, geometryParameters)
set geometryPieces to the connection fastener pieces of geometryFastener
check fastener solids ((the length of (geometryPieces's values)) = 4) named (the string form of "two washers are independent assembly parts")
set highestTip to -1.0
set bodyMesh to (the item at 0 in (geometryPieces's values))'s shape
loop pointCursor from 0 to the length of (bodyMesh's positions's values):
    set highestTip to the maximum of highestTip and ((the item at pointCursor in (bodyMesh's positions's values))'s z)
check fastener solids ((the absolute value of (highestTip - 0.077)) < 1e-12) named (the string form of "head washer preserves the 80 mm under-head bolt length")
set washerMesh to (the item at 2 in (geometryPieces's values))'s shape
check fastener solids ((the fast mesh flaw of washerMesh) = 0) named (the string form of "washer through bore is a closed annular solid")
set geometryParameters's washers to 2
loop anchorCursor from 0 to 4:
    set geometryParameters's anchorShape to anchorCursor
    set geometryFastener to @intrinsic("construct", a connection fastener, 1, 1 as a 64 bit integer, 3, originValue, axisValue, 0.020, 0.400, geometryParameters)
    set geometryPieces to the connection fastener pieces of geometryFastener
    loop pieceCursor from 0 to the length of (geometryPieces's values):
        set checkedMesh to (the item at pieceCursor in (geometryPieces's values))'s shape
        if (the fast mesh flaw of checkedMesh) != 0:
            print ((the string form of "Anchor flaw at shape ") + (the string form of anchorCursor)) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
check fastener solids true named (the string form of "straight L J and plate-ended anchor pieces are closed")
set turnedMesh to the connection fastener mesh washerMesh placed at (a cad vector3 with x 2.0, y 3.0 and z 4.0) along (a cad vector3 with x -2.0, y 1.0 and z 3.0)
check fastener solids (((the fast mesh flaw of turnedMesh) = 0) and ((the absolute value of ((the fast mesh volume of turnedMesh) - (the fast mesh volume of washerMesh))) < 1e-10)) named (the string form of "arbitrary axis placement preserves closure and volume")
