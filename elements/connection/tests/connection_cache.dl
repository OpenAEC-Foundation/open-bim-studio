# SPDX-License-Identifier: MPL-2.0
import structural/steel/bim_steel_connections.dl
import viewer/bim_scene.dl

function check connection cache {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Cache test") at 0.0 with height 6.0 to target
set columnType to add bim linear type named (the string form of "Column") as role bim column role sized 0.2 by 0.2 round false of (the string form of "steel") to target
set beamType to add bim linear type named (the string form of "Beam") as role bim beam role sized 0.18 by 0.3 round false of (the string form of "steel") to target
set cached to an empty list of a bim scene mesh record
set sentinel to an empty fast mesh
set zero to a cad vector3 with x 0.0, y 0.0 and z 0.0
set firstColumn to the bim refused id
# Sentinel solids make cache tests independent of expensive booleans.
loop station from 0 to 1000:
    set xValue to (station as a 64 bit floating-point number) * 5.0
    set columnId to add bim linear typed columnType on ground from (a cad vector3 with x xValue, y 0.0 and z 0.0) to (a cad vector3 with x xValue, y 0.0 and z 6.0) turned 0.0 to target
    set beamId to add bim linear typed beamType on ground from (a cad vector3 with x xValue, y 0.0 and z 3.0) to (a cad vector3 with x (xValue + 4.0), y 0.0 and z 3.0) turned 0.0 to target
    set ids to an empty list of a 64 bit integer
    append columnId to ids
    append beamId to ids
    set nodeId to add bim steel connection among ids style 3 in target
    if station = 0:
        set firstColumn to columnId
    append (@intrinsic("construct", a bim scene mesh record, nodeId, 0 as a 64 bit integer, sentinel, bim other category, zero, the string form of "steel")) to cached
    free ids
set journal to modelValue's journal
set seen to the length of (journal's values)
set kept to the bim connection cache of modelValue following journal since seen among cached
check connection cache ((the length of (kept's values)) = 1000) named (the string form of "1000 unchanged connection solids retained")
ignore move bim linear firstColumn to (a cad vector3 with x 1.0, y 0.0 and z 0.0) and (a cad vector3 with x 1.0, y 0.0 and z 6.0) turned 0.0 in target
set kept to the bim connection cache of modelValue following journal since seen among cached
check connection cache ((the length of (kept's values)) = 999) named (the string form of "one moved host invalidates one node")
set snapshot to the bim snapshot of modelValue
set snapshot's journal to a cad topology list of a 64 bit integer
set kept to the bim connection cache of snapshot following journal since seen among cached
check connection cache ((the length of (kept's values)) = 0) named (the string form of "undo or load journal invalidates cached geometry")
free cached
