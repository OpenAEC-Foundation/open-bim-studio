# SPDX-License-Identifier: MPL-2.0
import elements/connection/fastener_csg.dl

function check fastener csg {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function check closed fastener csg {connection csg definition:sourceValue}:
    execute:
        set evaluatedValue to the connection csg evaluation of sourceValue
        if evaluatedValue's valid = false:
            print ((the string form of "CSG snag ") + (the string form of evaluatedValue's snag)) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        if (the kernel flaw count of evaluatedValue's solid) != 0:
            @intrinsic("call", "libc", "exit", nothing, 1)

set csgParameters to catalogued connection fastener parameters
loop csgMetric from 0 to 15:
    set csgSize to the connection metric fastener size of (the connection fastener diameter at csgMetric)
    check closed fastener csg (the connection bolt csg of csgSize over (csgSize's diameter * 5.0) using csgParameters)
    check closed fastener csg (the connection nut csg of csgSize at 0.0 using csgParameters)
    check closed fastener csg (the connection washer csg of csgSize at 0.0)
check fastener csg true named (the string form of "all 15 sizes evaluate bolt nut and washer CSG into valid B-reps")
set csgSize to the connection metric fastener size of 0.016
loop csgAnchorShape from 0 to 4:
    set csgParameters's anchorShape to csgAnchorShape
    check closed fastener csg (the connection anchor csg of csgSize over 0.4 using csgParameters)
check fastener csg true named (the string form of "straight L J and plate-anchor rods evaluate as analytic solids")
set csgParameters's anchorShape to 0
set shortDefinition to the connection bolt csg of csgSize over 0.080 using csgParameters
set longDefinition to the connection bolt csg of csgSize over 0.120 using csgParameters
set shortShaft to the item at 1 in (shortDefinition's terms's values)
set longShaft to the item at 1 in (longDefinition's terms's values)
check fastener csg ((the absolute value of ((longShaft's size's z - shortShaft's size's z) - 0.040)) < 1e-12) named (the string form of "changing nominal length regenerates the cylindrical CSG term")
set largerDefinition to the connection bolt csg of (the connection metric fastener size of 0.024) over 0.120 using csgParameters
check fastener csg (((the item at 0 in (largerDefinition's terms's values))'s size's x = 0.036) and ((the item at 1 in (largerDefinition's terms's values))'s size's x = 0.012)) named (the string form of "changing M16 to M24 regenerates both head and shaft dimensions")
