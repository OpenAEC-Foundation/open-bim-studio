# SPDX-License-Identifier: MPL-2.0
import elements/connection/fastener_parameters.dl

function check fastener catalogue {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set previousDiameter to 0.0
loop metricCursor from 0 to 15:
    set selectedDiameter to the connection fastener diameter at metricCursor
    set selectedSize to the connection metric fastener size of selectedDiameter
    if (selectedSize's valid = false) or (selectedDiameter <= previousDiameter):
        @intrinsic("call", "libc", "exit", nothing, 1)
    if (selectedSize's washerInner <= selectedDiameter) or (selectedSize's washerOuter <= selectedSize's washerInner):
        @intrinsic("call", "libc", "exit", nothing, 1)
    set previousDiameter to selectedDiameter
check fastener catalogue (previousDiameter = 0.040) named (the string form of "15 distinct sizes include commercial M40")
set m8Size to the connection metric fastener size of 0.008
set m10Size to the connection metric fastener size of 0.010
set m12Size to the connection metric fastener size of 0.012
set m39Size to the connection metric fastener size of 0.039
set m40Size to the connection metric fastener size of 0.040
check fastener catalogue ((m8Size's pitch = 0.00125) and (m12Size's pitch = 0.00175)) named (the string form of "M8 and M12 use tabulated coarse pitches")
check fastener catalogue ((m10Size's headFlats = 0.016) and (m10Size's dinFlats = 0.017)) named (the string form of "ISO and DIN M10 spanner widths remain distinct")
check fastener catalogue (m39Size's washerInner = 0.042) named (the string form of "ISO M39 washer has 42 mm through bore")
check fastener catalogue ((m40Size's diameter = 0.040) and (m40Size's commercial and (m40Size's nutHeight = 0.031))) named (the string form of "M40 keeps its supplier dimensions and designation")
check fastener catalogue ((the connection metric fastener size of 0.009)'s valid = false) named (the string form of "unknown stock size is refused")
set checkedParameters to default connection fastener parameters
set checkedParameters's grade to 46
set checkedParameters's nutClass to 5
set checkedParameters's coating to 1
set checkedParameters's washers to 3
check fastener catalogue ((the connection fastener parameter issue of checkedParameters at diameter 0.016 over 0.080) = (the string form of "")) named (the string form of "4.6 hot-dip assembly with two washers accepted")
set checkedParameters's grade to 88
check fastener catalogue ((the connection fastener parameter issue of checkedParameters at diameter 0.016 over 0.080) != (the string form of "")) named (the string form of "8.8 with a class 5 nut is refused")
set checkedParameters's nutClass to 8
set checkedParameters's coating to 2
check fastener catalogue ((the connection fastener parameter issue of checkedParameters at diameter 0.016 over 0.080) = (the string form of "")) named (the string form of "8.8 electrolytic zinc assembly accepted")
set checkedParameters's grade to 87
check fastener catalogue ((the connection fastener parameter issue of checkedParameters at diameter 0.016 over 0.080) != (the string form of "")) named (the string form of "unsupported grade 8.7 is refused")
set checkedParameters to default connection fastener parameters
set checkedParameters's grip to 0.075
check fastener catalogue ((the connection fastener parameter issue of checkedParameters at diameter 0.016 over 0.080) != (the string form of "")) named (the string form of "nut stack beyond bolt tip is refused")
