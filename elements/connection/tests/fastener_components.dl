# SPDX-License-Identifier: MPL-2.0
import elements/connection/bim_fastener_components.dl
import exchange/ifcx/bim_file.dl

function check fastener components {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set componentDocument to a new bim document
set componentTarget to the address of (componentDocument's current)
set componentLevel to add bim level named (the string form of "Fasteners") at 0.0 with height 1.0 to componentTarget
set libraryIds to add bim metric fastener library to componentTarget
check fastener components (((the length of (libraryIds's values)) = 120) and ((the length of (componentTarget's fastenerComponents's values)) = 120)) named (the string form of "eight component families in every M8-M40 size")
set secondLibrary to add bim metric fastener library to componentTarget
check fastener components ((the length of (componentTarget's components's values)) = 120) named (the string form of "loading the library is idempotent")
set boltComponentId to the item at 32 in (libraryIds's values)
set firstPlacement to place bim component boltComponentId on componentLevel at (a cad vector2 with x 0.0 and y 0.0) turned 0.0 to componentTarget
set secondPlacement to place bim component boltComponentId on componentLevel at (a cad vector2 with x 0.2 and y 0.0) turned 1.0 to componentTarget
check fastener components ((firstPlacement != the bim refused id) and (secondPlacement != the bim refused id)) named (the string form of "a native fastener type has reusable placements")
set initialText to the bim file text of componentDocument's current
set roundTrip to the bim model parsed from initialText
if roundTrip's valid = false:
    print roundTrip's message as a line
check fastener components roundTrip's valid named (the string form of "typed component parameters parse from native format")
check fastener components ((the bim file text of roundTrip's modelValue) = initialText) named (the string form of "native component catalogue round-trips exactly")
set bindingIndex to the bim fastener component index of boltComponentId in componentDocument's current
set editedBinding to the item at bindingIndex's position in (componentTarget's fastenerComponents's values)
begin bim transaction in (the address of componentDocument)
set editedBinding's parameters's grade to 46
set editedBinding's parameters's nutClass to 5
set editedBinding's parameters's coating to 2
set editedBinding's parameters's washers to 3
check fastener components (store bim fastener component editedBinding in componentTarget) named (the string form of "grade coating and washer layout edit the shared native type")
commit bim transaction in (the address of componentDocument)
set changedText to the bim file text of componentDocument's current
check fastener components (changedText != initialText) named (the string form of "configured properties are persisted")
ignore undo bim transaction in (the address of componentDocument)
check fastener components ((the bim file text of componentDocument's current) = initialText) named (the string form of "undo restores type and every placement")
ignore redo bim transaction in (the address of componentDocument)
check fastener components ((the bim file text of componentDocument's current) = changedText) named (the string form of "redo restores the configured assembly")
