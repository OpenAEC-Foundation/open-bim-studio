# SPDX-License-Identifier: MPL-2.0
# The connection module builds its stock through the kernel seam, as a kernel
# body held by handle; the topology checks below walk a body's faces, which
# only the library's own `cad body` allows. So the test builds the same cube
# twice: through the module, as a check that the seam delivers a valid body,
# and from the library's source for the topology checks (tests may import
# kernel/brep; application modules may not).
import elements/connection/bim_connection_geometry.dl
import kernel/brep/brep_make.dl
import kernel/brep/brep_append.dl
import kernel/brep/brep_bounds.dl

function check connection components {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The eight corners of a unit cube at x = offset: the bottom ring of four,
# then the top ring, the order `the connection stock from vertices` takes.
function the component test corners shifted {a 64 bit floating-point number:offset}:
    execute:
        set vertices to an empty list of a cad vector3
        loop endIndex from 0 to 2:
            set zValue to endIndex as a 64 bit floating-point number
            append (a cad vector3 with x offset, y 0.0 and z zValue) to vertices
            append (a cad vector3 with x (offset + 1.0), y 0.0 and z zValue) to vertices
            append (a cad vector3 with x (offset + 1.0), y 1.0 and z zValue) to vertices
            append (a cad vector3 with x offset, y 1.0 and z zValue) to vertices
        return vertices

# The same cube as a library body, with the rings the module builds: the two
# caps (the first one reversed), then one side per edge of the first ring.
function a component test cube shifted {a 64 bit floating-point number:offset}:
    execute:
        set vertices to the component test corners shifted offset
        set count to (the length of vertices) / 2
        set faces to an empty list of the type of (an empty list of an integer)
        set firstCap to an empty list of an integer
        set lastCap to an empty list of an integer
        loop cursor from 0 to count:
            append ((count - 1) - cursor) to firstCap
            append (count + cursor) to lastCap
        append firstCap to faces
        append lastCap to faces
        loop cursor from 0 to count:
            set following to the remainder of (cursor + 1) divided by count
            set ring to an empty list of an integer
            append cursor to ring
            append following to ring
            append (following + count) to ring
            append (cursor + count) to ring
            append ring to faces
        set built to the cad faceted solid with vertices vertices and faces faces within 1e-9
        loop cursor from 0 to the length of faces:
            free (the item at cursor in faces)
        free faces
        free vertices
        return built's value

# The module's stock crosses the seam; here it is checked for validity only.
set corners to the component test corners shifted 0.0
set stock to the connection stock from corners
check connection components (stock's valid and (stock's value is a valid kernel body)) named (the string form of "connection stock through the seam is valid")
free corners

set body to a component test cube shifted 0.0
set keys to the cad face keys of body
set faces to a cad topology list of a cad face key
loop cursor from 0 to the length of keys:
    append (the item at cursor in keys) to (faces's values)
set components to the cad face components of faces in body
check connection components (((the length of (components's values)) = 1) and ((the length of ((the item at 0 in (components's values))'s values)) = 6)) named (the string form of "closed box has one six-face component")
set subset to a cad topology list of a cad face key
set lowerCap to a new cad face key
set upperCap to a new cad face key
loop cursor from 0 to the length of keys:
    set candidate to the item at cursor in keys
    set bounds to the cad bounds of candidate in body
    if bounds's valid:
        if (the absolute value of (bounds's value's high's z - bounds's value's low's z)) < 1e-9:
            if bounds's value's low's z < 0.5:
                set lowerCap to candidate
            else:
                set upperCap to candidate
append upperCap to (subset's values)
append lowerCap to (subset's values)
set pieces to the cad face components of subset in body
check connection components ((the length of (pieces's values)) = 2) named (the string form of "opposite caps stay disconnected in a subset")
check connection components (((the item at 0 in ((the item at 0 in (pieces's values))'s values)) = upperCap) and ((the item at 0 in ((the item at 1 in (pieces's values))'s values)) = lowerCap)) named (the string form of "input seed order retained")
set another to a component test cube shifted 3.0
ignore append cad body another into body
set allKeys to the cad face keys of body
set allFaces to a cad topology list of a cad face key
loop cursor from 0 to the length of allKeys:
    append (the item at cursor in allKeys) to (allFaces's values)
set pieces to the cad face components of allFaces in body
check connection components (((the length of (pieces's values)) = 2) and (((the length of ((the item at 0 in (pieces's values))'s values)) = 6) and ((the length of ((the item at 1 in (pieces's values))'s values)) = 6))) named (the string form of "two disconnected solids retain both components")
append (the item at 0 in allKeys) to (allFaces's values)
set pieces to the cad face components of allFaces in body
check connection components (((the length of (pieces's values)) = 2) and ((the length of ((the item at 0 in (pieces's values))'s values)) = 6)) named (the string form of "duplicate face input is visited once")
set invalid to a cad topology list of a cad face key
set invalidKey to the item at 0 in allKeys
set invalidKey's index to ((the length of (body's faces's slots)) + 1) as a 32 bit unsigned integer
append invalidKey to (invalid's values)
set pieces to the cad face components of invalid in body
check connection components ((the length of (pieces's values)) = 0) named (the string form of "invalid face key is refused")
free keys
free allKeys
