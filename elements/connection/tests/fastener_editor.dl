# SPDX-License-Identifier: MPL-2.0
import ui/editor/bim_editor.dl
import structural/steel/bim_demo_column_bases.dl

function check fastener editor {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set fastenerEditor to a new bim editor
set fastenerEditorPointer to the address of fastenerEditor
set fastenerTarget to the address of (fastenerEditor's documentValue's current)
set fastenerLibrary to add bim metric fastener library to fastenerTarget
set fastenerType to the item at 32 in (fastenerLibrary's values)
set fastenerPlacement to place bim component fastenerType on fastenerEditor's levelId at (a cad vector2 with x 1.2 and y 0.0) turned 0.3 to fastenerTarget
set fastenerEditor's selectionKind to bim instance picked
set fastenerEditor's selectionId to fastenerPlacement
set fastenerRows to the bim own property rows of fastenerEditor
set fastenerFinishPresent to false
loop rowCursor from 0 to the length of fastenerRows:
    if (the item at rowCursor in fastenerRows)'s code = 62052:
        set fastenerFinishPresent to true
check fastener editor fastenerFinishPresent named (the string form of "selected native component exposes editable finish")
start bim editor property 62052 in fastenerEditorPointer
set fastenerEditor's propertyText to the string form of "electrolytic"
apply bim editor property in fastenerEditorPointer
set fastenerBinding to the item at 32 in (fastenerTarget's fastenerComponents's values)
check fastener editor (fastenerBinding's parameters's coating = 2) named (the string form of "property edit changes the fastener finish")
start bim editor property 62053 in fastenerEditorPointer
set fastenerEditor's propertyText to the string form of "both"
apply bim editor property in fastenerEditorPointer
set fastenerBinding to the item at 32 in (fastenerTarget's fastenerComponents's values)
check fastener editor (fastenerBinding's parameters's washers = 3) named (the string form of "optional head and nut washers are editable")
set beforeUnique to the bim file text of fastenerEditor's documentValue's current
start bim editor property 62066 in fastenerEditorPointer
set fastenerEditor's propertyText to the string form of "Yes"
apply bim editor property in fastenerEditorPointer
set uniquePlacementFound to the bim instance index of fastenerPlacement in fastenerEditor's documentValue's current
set uniqueType to (the item at uniquePlacementFound's position in (fastenerTarget's instances's values))'s componentId
check fastener editor (uniqueType != fastenerType) named (the string form of "make unique creates an independent fastener type")
start bim editor property 62051 in fastenerEditorPointer
set fastenerEditor's propertyText to the string form of "4.6"
apply bim editor property in fastenerEditorPointer
set uniqueFound to the bim fastener component index of uniqueType in fastenerEditor's documentValue's current
check fastener editor (((the item at uniqueFound's position in (fastenerTarget's fastenerComponents's values))'s parameters's grade = 46) and ((the item at 32 in (fastenerTarget's fastenerComponents's values))'s parameters's grade = 88)) named (the string form of "editing a unique placement preserves the original type")
set afterUnique to the bim file text of fastenerEditor's documentValue's current
ignore undo bim transaction in (the address of (fastenerEditor's documentValue))
ignore undo bim transaction in (the address of (fastenerEditor's documentValue))
check fastener editor ((the bim file text of fastenerEditor's documentValue's current) = beforeUnique) named (the string form of "undo restores placement identity and component bindings")
ignore redo bim transaction in (the address of (fastenerEditor's documentValue))
ignore redo bim transaction in (the address of (fastenerEditor's documentValue))
check fastener editor ((the bim file text of fastenerEditor's documentValue's current) = afterUnique) named (the string form of "redo restores the unique configured placement")
loop galleryCursor from 0 to 120:
    if galleryCursor != 32:
        set galleryMetric to galleryCursor / 8
        set galleryFamily to the remainder of galleryCursor divided by 8
        ignore place bim component (the item at galleryCursor in (fastenerLibrary's values)) on fastenerEditor's levelId at (a cad vector2 with x ((galleryMetric as a 64 bit floating-point number) * 0.3) and y ((galleryFamily as a 64 bit floating-point number) * 0.35)) turned 0.3 to fastenerTarget
set beforeInvalid to the bim file text of fastenerEditor's documentValue's current
start bim editor property 62062 in fastenerEditorPointer
set fastenerEditor's propertyText to the string form of "9"
apply bim editor property in fastenerEditorPointer
check fastener editor ((the bim file text of fastenerEditor's documentValue's current) = beforeInvalid) named (the string form of "unsupported M9 edit leaves the model unchanged")
set fastenerScene to the bim sketch meshes of fastenerEditor's documentValue's current within 0.0078125
set fastenerBodyPresent to false
set fastenerThreadPresent to false
loop meshCursor from 0 to the length of (fastenerScene's values):
    set entryValue to the item at meshCursor in (fastenerScene's values)
    if entryValue's elementId = fastenerPlacement:
        if (the length of (entryValue's shape's triangles's values)) > 0:
            set fastenerBodyPresent to true
        if ((the length of (entryValue's shape's triangles's values)) = 0) and ((the length of (entryValue's shape's positions's values)) > 0):
            set fastenerThreadPresent to true
check fastener editor (fastenerBodyPresent and fastenerThreadPresent) named (the string form of "component placements render solid bodies and cosmetic threads")
save bim editor to (the string form of "build/fastener-components/fastener-library.ifcxb") in fastenerEditorPointer
set reopenedFasteners to a new bim editor
open bim editor from (the string form of "build/fastener-components/fastener-library.ifcxb") in (the address of reopenedFasteners)
check fastener editor ((the bim file text of reopenedFasteners's documentValue's current) = beforeInvalid) named (the string form of "binary IFCX reopens the exact editable catalogue")
set columnModel to the bim demo column bases
check fastener editor (((the length of (columnModel's linears's values)) = 20) and ((the length of (columnModel's connections's values)) = 20)) named (the string form of "twenty columns have twenty native base-plate connections")
set anchorTotal to 0
set closedFasteners to true
loop columnConnectionCursor from 0 to the length of (columnModel's connections's values):
    set columnConnection to the item at columnConnectionCursor in (columnModel's connections's values)
    set evaluatedConnection to the bim connection evaluation of columnConnection in columnModel
    if evaluatedConnection's valid = false:
        set closedFasteners to false
    set anchorTotal to anchorTotal + (the length of (evaluatedConnection's fasteners's values))
    loop anchorCursor from 0 to the length of (evaluatedConnection's fasteners's values):
        set anchorParts to the connection fastener pieces of (the item at anchorCursor in (evaluatedConnection's fasteners's values))
        loop pieceCursor from 0 to the length of (anchorParts's values):
            if (the fast mesh flaw of (the item at pieceCursor in (anchorParts's values))'s shape) != 0:
                set closedFasteners to false
check fastener editor ((anchorTotal = 80) and closedFasteners) named (the string form of "all eighty M24 anchor assemblies have closed pieces")
ignore write bim text (the bim file text of columnModel) to file (the string form of "build/fastener-components/twenty-column-bases.bim")
set columnReadback to the bim model parsed from (the bim file text of columnModel)
check fastener editor (columnReadback's valid and ((the bim file text of columnReadback's modelValue) = (the bim file text of columnModel))) named (the string form of "twenty-column connection parameters round-trip exactly")
set columnEditor to a new bim editor
open bim editor from (the string form of "build/fastener-components/twenty-column-bases.bim") in (the address of columnEditor)
save bim editor to (the string form of "build/fastener-components/twenty-column-bases.ifcxb") in (the address of columnEditor)
set reopenedColumns to a new bim editor
open bim editor from (the string form of "build/fastener-components/twenty-column-bases.ifcxb") in (the address of reopenedColumns)
check fastener editor ((the bim file text of reopenedColumns's documentValue's current) = (the bim file text of columnModel)) named (the string form of "twenty-column binary IFCX reopens as the editable model")
