# SPDX-License-Identifier: MPL-2.0
# Authoring geometry: a sequence of analytic primitive volumes and CSG operations.
# Triangle meshes are derived only when displaying or exporting a solid.
import elements/connection/fastener_parameters.dl
import kernel/brep/brep_make.dl
import kernel/brep/brep_sweep.dl
import kernel/brep/brep_boolean.dl
import kernel/brep/brep_place.dl
import kernel/brep/brep_thicken_multiface_planar.dl

class:
    patterns:
        [a|] connection csg term
    members:
        # 0 hexagonal prism, 1 cylinder, 2 cone, 4 bent rod, 5 quarter-seam cylinder, 6 revolved rounded-rim void.
        primitive as an integer
        operation as an integer
        origin as a cad vector3
        axis as a cad vector3
        size as a cad vector3

class:
    patterns:
        [a|] connection csg definition
    members:
        terms as the type of (a cad topology list of a connection csg term)

class:
    patterns:
        [a|] connection csg result
    members:
        valid as a boolean
        snag as an integer
        solid as the type of (an empty cad body)

function an empty connection csg definition:
    execute:
        return @intrinsic("construct", a connection csg definition, a cad topology list of a connection csg term)

function a connection csg term of primitive {integer:kindValue} operation {integer:operationValue} at {cad vector3:originValue} along {cad vector3:axisValue} sized {cad vector3:sizeValue}:
    execute:
        return @intrinsic("construct", a connection csg term, kindValue, operationValue, originValue, axisValue, sizeValue)

function the connection csg primitive of {connection csg term:termValue}:
    execute:
        set builtValue to no cad body
        if termValue's primitive = 0:
            set profileValues to an empty list of a cad curve2
            set cornerValues to an empty list of a cad vector2
            set reachValue to termValue's size's x / 1.7320508075688772
            loop cornerCursor from 0 to 6:
                set angleValue to 0.5235987755982988 + ((cornerCursor as a 64 bit floating-point number) * 1.0471975511965976)
                append (a cad vector2 with x (reachValue * (the cosine of angleValue)) and y (reachValue * (the sine of angleValue))) to cornerValues
            loop cornerCursor from 0 to 6:
                append (the cad curve2 of (a cad line2 from (the item at cornerCursor in cornerValues) to (the item at (the remainder of (cornerCursor + 1) divided by 6) in cornerValues))) to profileValues
            set planeValue to a cad plane with origin (the cad zero vector3), x axis (the cad x axis) and y axis (the cad y axis)
            set builtValue to the cad extrusion of profileValues on planeValue along (a cad vector3 with x 0.0, y 0.0 and z termValue's size's z)
            free cornerValues
            free profileValues
        if termValue's primitive = 1:
            set builtValue to the cad cylinder body at (the cad zero vector3) with radius termValue's size's x and height termValue's size's z
        if termValue's primitive = 2:
            set builtValue to the cad cone body at (the cad zero vector3) with radius termValue's size's x and height termValue's size's z
        if (termValue's primitive = 4) or (termValue's primitive = 5):
            set arcProfile to an empty list of a cad curve2
            loop quadrantCursor from 0 to 4:
                set startAngle to (quadrantCursor as a 64 bit floating-point number) * 1.5707963267948966
                append (the cad curve2 of (a cad arc2 at (the cad zero vector2) with radius termValue's size's x from startAngle to (startAngle + 1.5707963267948966))) to arcProfile
            set arcPlane to a cad plane with origin (the cad zero vector3), x axis (the cad x axis) and y axis (the cad y axis)
            if termValue's primitive = 4:
                set builtValue to the cad revolution of arcProfile on arcPlane about (a cad vector3 with x termValue's size's y, y 0.0 and z 0.0) along (the cad y axis) by termValue's size's z
            else:
                set builtValue to the cad extrusion of arcProfile on arcPlane along (a cad vector3 with x 0.0, y 0.0 and z termValue's size's z)
            free arcProfile
        if termValue's primitive = 6:
            set rimRadius to termValue's size's x
            set rimReach to termValue's size's y
            set rimCentre to a cad vector2 with x (rimReach - rimRadius) and y (0.0 - rimRadius)
            set rimPoints to an empty list of a cad vector2
            append (a cad vector2 with x rimReach and y (0.0 - rimRadius)) to rimPoints
            append (a cad vector2 with x (rimReach + rimRadius) and y (0.0 - rimRadius)) to rimPoints
            append (a cad vector2 with x (rimReach + rimRadius) and y rimRadius) to rimPoints
            append (a cad vector2 with x (rimReach - rimRadius) and y rimRadius) to rimPoints
            append (a cad vector2 with x (rimReach - rimRadius) and y 0.0) to rimPoints
            set rimProfile to an empty list of a cad curve2
            loop rimCursor from 0 to 4:
                append (the cad curve2 of (a cad line2 from (the item at rimCursor in rimPoints) to (the item at (rimCursor + 1) in rimPoints))) to rimProfile
            append (the cad curve2 of (a cad arc2 at rimCentre with radius rimRadius from 0.0 to 1.5707963267948966)) to rimProfile
            set rimPlane to a cad plane with origin (the cad zero vector3), x axis (the cad x axis) and y axis (the cad z axis)
            set builtValue to the cad revolution of rimProfile on rimPlane about (the cad zero vector3) along (the cad z axis) by 6.283185307179586
            free rimProfile
            free rimPoints
        if builtValue's valid = false:
            return builtValue
        set forwardValue to termValue's axis scaled by (1.0 / (the cad length of termValue's axis))
        set acrossValue to the cad cross of (the cad z axis) and forwardValue
        if (the cad length of acrossValue) < 1e-9:
            set acrossValue to the cad x axis
        else:
            set acrossValue to acrossValue scaled by (1.0 / (the cad length of acrossValue))
        set upValue to the cad cross of forwardValue and acrossValue
        return the cad transformed builtValue's value by (a cad placement with axes acrossValue, upValue and forwardValue at termValue's origin)

function the connection csg evaluation of {connection csg definition:definitionValue}:
    execute:
        set solidValue to an empty cad body
        set startedValue to false
        loop termCursor from 0 to the length of (definitionValue's terms's values):
            set termValue to the item at termCursor in (definitionValue's terms's values)
            set builtValue to the connection csg primitive of termValue
            if builtValue's valid = false:
                return @intrinsic("construct", a connection csg result, false, 1, an empty cad body)
            if startedValue = false:
                set solidValue to builtValue's value
                set startedValue to true
            else:
                # Regularized union at matching tangent caps retains the exact
                # analytic faces and validates closure without a curved imprint.
                set joinedValue to no cad body
                if (termValue's operation = cad union operation) and (termValue's primitive = 5):
                    set joinedValue to the cad planar pair join of solidValue and builtValue's value within 1e-9
                if joinedValue's valid:
                    set solidValue to joinedValue's value
                else:
                    set combinedValue to the cad combination of solidValue and builtValue's value using termValue's operation within 1e-9
                    if combinedValue's valid = false:
                        return @intrinsic("construct", a connection csg result, false, combinedValue's snag, an empty cad body)
                    set solidValue to combinedValue's value
        return @intrinsic("construct", a connection csg result, startedValue, 0, solidValue)

# Circular edge relief is a pair of subtractive analytic revolved volumes.
function round connection hex rims of {a pointer to a connection csg definition:target}:
    execute:
        set stockValue to the item at 0 in (target's terms's values)
        set reachValue to stockValue's size's x / 1.7320508075688772
        set radiusValue to reachValue - (stockValue's size's x * 0.5)
        append (a connection csg term of primitive 6 operation cad difference operation at stockValue's origin along (a cad vector3 with x 0.0, y 0.0 and z -1.0) sized (a cad vector3 with x radiusValue, y reachValue and z 0.0)) to (target's terms's values)
        append (a connection csg term of primitive 6 operation cad difference operation at (the cad sum of stockValue's origin and (a cad vector3 with x 0.0, y 0.0 and z stockValue's size's z)) along (the cad z axis) sized (a cad vector3 with x radiusValue, y reachValue and z 0.0)) to (target's terms's values)

function the connection bolt csg of {connection fastener size:sizeValue} over {a 64 bit floating-point number:lengthValue} using {connection fastener parameters:parameters}:
    execute:
        set definitionValue to an empty connection csg definition
        set flatsValue to sizeValue's headFlats
        if parameters's headSeries = 1:
            set flatsValue to sizeValue's dinFlats
        set headLift to 0.0
        if (the remainder of parameters's washers divided by 2) = 1:
            set headLift to 0.0 - sizeValue's washerThickness
        set overlapValue to sizeValue's diameter * 0.01
        append (a connection csg term of primitive 0 operation cad union operation at (a cad vector3 with x 0.0, y 0.0 and z (headLift - sizeValue's headHeight)) along (the cad z axis) sized (a cad vector3 with x flatsValue, y 0.0 and z sizeValue's headHeight)) to (definitionValue's terms's values)
        append (a connection csg term of primitive 1 operation cad union operation at (a cad vector3 with x 0.0, y 0.0 and z (headLift - overlapValue)) along (the cad z axis) sized (a cad vector3 with x (sizeValue's diameter * 0.5), y 0.0 and z (lengthValue + overlapValue))) to (definitionValue's terms's values)
        return definitionValue

function the connection nut csg of {connection fastener size:sizeValue} at {a 64 bit floating-point number:elevationValue} using {connection fastener parameters:parameters}:
    execute:
        set definitionValue to an empty connection csg definition
        set flatsValue to sizeValue's headFlats
        if parameters's headSeries = 1:
            set flatsValue to sizeValue's dinFlats
        append (a connection csg term of primitive 0 operation cad union operation at (a cad vector3 with x 0.0, y 0.0 and z elevationValue) along (the cad z axis) sized (a cad vector3 with x flatsValue, y 0.0 and z sizeValue's nutHeight)) to (definitionValue's terms's values)
        append (a connection csg term of primitive 1 operation cad difference operation at (a cad vector3 with x 0.0, y 0.0 and z (elevationValue - 0.001)) along (the cad z axis) sized (a cad vector3 with x (sizeValue's diameter * 0.5), y 0.0 and z (sizeValue's nutHeight + 0.002))) to (definitionValue's terms's values)
        return definitionValue

function the connection washer csg of {connection fastener size:sizeValue} at {a 64 bit floating-point number:elevationValue}:
    execute:
        set definitionValue to an empty connection csg definition
        append (a connection csg term of primitive 1 operation cad union operation at (a cad vector3 with x 0.0, y 0.0 and z elevationValue) along (the cad z axis) sized (a cad vector3 with x (sizeValue's washerOuter * 0.5), y 0.0 and z sizeValue's washerThickness)) to (definitionValue's terms's values)
        append (a connection csg term of primitive 1 operation cad difference operation at (a cad vector3 with x 0.0, y 0.0 and z (elevationValue - 0.001)) along (the cad z axis) sized (a cad vector3 with x (sizeValue's washerInner * 0.5), y 0.0 and z (sizeValue's washerThickness + 0.002))) to (definitionValue's terms's values)
        return definitionValue

function the connection anchor csg of {connection fastener size:sizeValue} over {a 64 bit floating-point number:lengthValue} using {connection fastener parameters:parameters}:
    execute:
        set definitionValue to an empty connection csg definition
        set radiusValue to sizeValue's diameter * 0.5
        if (parameters's anchorShape = 1) or (parameters's anchorShape = 2):
            set bendValue to parameters's bendRadius
            if bendValue = 0.0:
                set bendValue to sizeValue's diameter * 3.0
            set tailValue to parameters's tailLength
            if tailValue = 0.0:
                set tailValue to sizeValue's diameter * 4.0
            set angleValue to 1.5707963267948966
            if parameters's anchorShape = 2:
                set angleValue to 3.141592653589793
            set bendStart to lengthValue - bendValue
            set overlapValue to 0.0
            append (a connection csg term of primitive 4 operation cad union operation at (a cad vector3 with x 0.0, y 0.0 and z bendStart) along (the cad z axis) sized (a cad vector3 with x radiusValue, y bendValue and z angleValue)) to (definitionValue's terms's values)
            append (a connection csg term of primitive 5 operation cad union operation at (the cad zero vector3) along (the cad z axis) sized (a cad vector3 with x radiusValue, y 0.0 and z (bendStart + overlapValue))) to (definitionValue's terms's values)
            set tailAxis to a cad vector3 with x (the sine of angleValue), y 0.0 and z (the cosine of angleValue)
            set tailOrigin to a cad vector3 with x (bendValue * (1.0 - (the cosine of angleValue))), y 0.0 and z (bendStart + (bendValue * (the sine of angleValue)))
            set tailOrigin to the cad difference of tailOrigin and (tailAxis scaled by overlapValue)
            append (a connection csg term of primitive 5 operation cad union operation at tailOrigin along tailAxis sized (a cad vector3 with x radiusValue, y 0.0 and z (tailValue + overlapValue))) to (definitionValue's terms's values)
        else:
            append (a connection csg term of primitive 5 operation cad union operation at (the cad zero vector3) along (the cad z axis) sized (a cad vector3 with x radiusValue, y 0.0 and z lengthValue)) to (definitionValue's terms's values)
        return definitionValue
