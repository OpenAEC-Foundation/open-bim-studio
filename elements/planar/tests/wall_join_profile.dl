# SPDX-License-Identifier: MPL-2.0
# Profiled joins (bim/bim_joins.dl): at a butted L corner of two walls of
# one layer the ends follow the two halves of a profile from the library,
# so that the walls lap without overlap: their outlines together cover the
# corner exactly, the solids follow, and a layered wall or a join that is
# no butt keeps straight ends. Walls are 200 mm: faces 100 mm either side.
import elements/planar/bim_evaluate.dl

function the profile test text of {a pointer to a list:ring}:
    execute:
        set written to the string form of ""
        loop cursor from 0 to the length of ring:
            set corner to the item at cursor in ring
            set cornerX to (@intrinsic("call", "libc", "round", a 64 bit floating-point number, corner's x * 10000.0)) / 10.0
            set cornerY to (@intrinsic("call", "libc", "round", a 64 bit floating-point number, corner's y * 10000.0)) / 10.0
            set written to written + ((((the string form of " (") + (the string form of cornerX)) + ((the string form of ", ") + (the string form of cornerY))) + (the string form of ")"))
        return written

function the profile test ring of {a 64 bit integer:wallId} in {bim model record:modelValue}:
    execute:
        set wallFound to the bim wall index of wallId in modelValue
        set wallValue to the item at wallFound's position in (modelValue's walls's values)
        set joinIndex to the bim join index of modelValue
        set footprint to the bim footprint of wallValue in modelValue using joinIndex
        return the bim stepped outline of wallValue with footprint wide (the bim wall thickness of wallValue in modelValue) in modelValue using joinIndex

function the profile test area of {a 64 bit integer:wallId} in {bim model record:modelValue}:
    execute:
        set ring to the profile test ring of wallId in modelValue
        set ringArea to the absolute value of (the cad signed area of ring)
        free ring
        return (@intrinsic("call", "libc", "round", a 64 bit floating-point number, ringArea * 1000000.0)) / 1000000.0

function the profile test volume of {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        set evaluation to the bim evaluation of modelValue after (an empty bim evaluation)
        loop cursor from 0 to the length of (evaluation's elements's values):
            set geometry to the item at cursor in (evaluation's elements's values)
            if geometry's id = elementId:
                if geometry's status != 0:
                    return (the string form of "status ") + (the string form of geometry's status)
                set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, (the bim volume of geometry) * 1000000.0)
                return (the string form of (scaled as a 64 bit integer)) + (the string form of " cm3")
        return the string form of "not built"

function check join profile {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set lapModel to an empty bim model
set target to the address of lapModel
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set timberLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.2)) to timberLayers
set timberType to add bim wall type named (the string form of "CLT 200") with timberLayers to target
set firstLeg to add bim wall typed timberType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 5.0 and y 0.0) to target
set secondLeg to add bim wall typed timberType on ground from (a cad vector2 with x 5.0 and y 0.0) to (a cad vector2 with x 5.0 and y 4.0) to target
set cornerJoin to the bim join of wall firstLeg at finish true in lapModel using (the bim join index of lapModel)
set mitredArea to (the profile test area of firstLeg in lapModel) + (the profile test area of secondLeg in lapModel)
print ((the string form of "mitred, both walls: ") + (the string form of mitredArea)) as a line

loop profileCode from 1 to (the bim join profile count):
    give bim join cornerJoin profile profileCode in target
    print ((the bim join profile name of profileCode) + (the string form of ":")) as a line
    set firstRing to the profile test ring of firstLeg in lapModel
    set secondRing to the profile test ring of secondLeg in lapModel
    print ((the string form of "  runs through:") + (the profile test text of firstRing)) as a line
    print ((the string form of "  stops:") + (the profile test text of secondRing)) as a line
    free firstRing
    free secondRing
    set lappedArea to (the profile test area of firstLeg in lapModel) + (the profile test area of secondLeg in lapModel)
    check join profile ((the absolute value of (lappedArea - mitredArea)) < 0.000001) named (the string form of "the two walls cover the corner exactly")
    print ((the string form of "  solids: ") + ((the profile test volume of firstLeg in lapModel) + ((the string form of ", ") + (the profile test volume of secondLeg in lapModel)))) as a line
check join profile ((the bim style of join cornerJoin in lapModel) = bim butt through join style) named (the string form of "a profile makes the join a butt, its first wall running through")

# The other wall running through: the halves change sides.
give bim join cornerJoin profile (bim half lap join profile) in target
give bim join cornerJoin style (bim butt stopped join style) in target
set swappedRing to the profile test ring of secondLeg in lapModel
print ((the string form of "half lap, second wall through:") + (the profile test text of swappedRing)) as a line
free swappedRing
set swappedArea to (the profile test area of firstLeg in lapModel) + (the profile test area of secondLeg in lapModel)
check join profile ((the absolute value of (swappedArea - mitredArea)) < 0.000001) named (the string form of "swapped, the walls still cover the corner exactly")

# A gap of 25 mm: the stopped wall draws back, the other keeps its end.
give bim join cornerJoin gap 0.025 in target
set gappedArea to (the profile test area of firstLeg in lapModel) + (the profile test area of secondLeg in lapModel)
print ((the string form of "half lap with 25 mm, area less: ") + (the string form of ((@intrinsic("call", "libc", "round", a 64 bit floating-point number, (mitredArea - gappedArea) * 1000000.0)) / 1000000.0))) as a line

# Straight again: four corners each.
give bim join cornerJoin gap 0.0 in target
give bim join cornerJoin profile (bim straight join profile) in target
set straightRing to the profile test ring of firstLeg in lapModel
check join profile ((the length of straightRing) = 4) named (the string form of "Straight leaves the end its two corners")
free straightRing

# A T join: the branch is let into the host as the profile's stopping half
# says, and the host is rebated for it; together they cover what the two
# covered with a straight butt.
set branchWall to add bim wall typed timberType on ground from (a cad vector2 with x 2.5 and y 0.0) to (a cad vector2 with x 2.5 and y 3.0) to target
set teeJoin to the bim join of wall branchWall at finish false in lapModel using (the bim join index of lapModel)
set buttedArea to (the profile test area of firstLeg in lapModel) + (the profile test area of branchWall in lapModel)
loop profileCode from 1 to (the bim join profile count):
    give bim join teeJoin profile profileCode in target
    print (((the string form of "T, ") + (the bim join profile name of profileCode)) + (the string form of ":")) as a line
    set hostRing to the profile test ring of firstLeg in lapModel
    set branchRing to the profile test ring of branchWall in lapModel
    print ((the string form of "  host:") + (the profile test text of hostRing)) as a line
    print ((the string form of "  branch:") + (the profile test text of branchRing)) as a line
    free hostRing
    free branchRing
    set housedArea to (the profile test area of firstLeg in lapModel) + (the profile test area of branchWall in lapModel)
    check join profile ((the absolute value of (housedArea - buttedArea)) < 0.000001) named (the string form of "host and branch cover the join exactly")
    print ((the string form of "  solids: ") + ((the profile test volume of firstLeg in lapModel) + ((the string form of ", ") + (the profile test volume of branchWall in lapModel)))) as a line
give bim join teeJoin profile (bim straight join profile) in target
set plainHost to the profile test ring of firstLeg in lapModel
check join profile ((the length of plainHost) = 4) named (the string form of "Straight closes the host's rebate")
free plainHost
