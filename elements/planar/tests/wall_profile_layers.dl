# SPDX-License-Identifier: MPL-2.0
# Fine detail must retain a wall's edited boundary instead of drawing its
# original rectangular layers through the roof. Until layers support profile
# clipping, the scene uses the correctly cut whole-wall solid.
import viewer/bim_scene.dl

function check profiled wall layers {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set layerList to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to layerList
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.1)) to layerList
set wallType to add bim wall type named (the string form of "Cavity wall") with layerList to target
set wallId to add bim wall typed wallType on storey from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set wallValue to the item at 0 in (modelValue's walls's values)
set indexValue to the bim join index of modelValue
set unprofiled to the bim layer solids of wallValue in modelValue using indexValue
check profiled wall layers ((the length of (unprofiled's values)) = 2) named (the string form of "ordinary walls retain their separate material layers")
set contour to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to contour
append (a cad vector2 with x 6.0 and y 0.0) to contour
append (a cad vector2 with x 6.0 and y 1.0) to contour
append (a cad vector2 with x 3.0 and y 3.0) to contour
append (a cad vector2 with x 0.0 and y 1.0) to contour
keep bim face contour contour of wallId in target
set evaluation to the bim evaluation of modelValue after (an empty bim evaluation)
set geometry to the item at 0 in (evaluation's elements's values)
check profiled wall layers (geometry's status = 0) named (the string form of "edited gable boundary evaluates successfully")
check profiled wall layers ((the absolute value of ((the bim volume of geometry) - 3.6)) < 0.00001) named (the string form of "gable volume follows its profile rather than the bounding rectangle")
set profiled to the bim layer solids of wallValue in modelValue using indexValue
check profiled wall layers ((the length of (profiled's values)) = 0) named (the string form of "uncut rectangular layers cannot override a profiled wall")
set previous to an empty list of a bim scene mesh record
set sceneValue to the bim scene meshes of evaluation after previous layered true
check profiled wall layers ((the length of (sceneValue's values)) = 1) named (the string form of "fine detail uses the correctly cut whole-wall fallback")
set contained to true
set meshValue to (the item at 0 in (sceneValue's values))'s shape
loop cursor from 0 to the length of (meshValue's positions's values):
    set spot to the item at cursor in (meshValue's positions's values)
    set allowed to 3.0 - ((2.0 * (the absolute value of (spot's x - 3.0))) / 3.0)
    if spot's z > (allowed + 0.00001):
        set contained to false
check profiled wall layers contained named (the string form of "rendered wall vertices stay below the sloped gable boundary")
