# SPDX-License-Identifier: MPL-2.0
import elements/planar/bim_editor_roof_forms.dl

function check roof editor {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.2)) to layers
set roofType to add bim planar type named (the string form of "Editable roof") as role bim roof planar role with layers to target
set outlinePoints to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y -2.0) to outlinePoints
append (a cad vector2 with x 6.0 and y -2.0) to outlinePoints
append (a cad vector2 with x 6.0 and y 2.0) to outlinePoints
append (a cad vector2 with x 0.0 and y 2.0) to outlinePoints
set roofId to add bim plate typed roofType on editor's levelId around outlinePoints at top 3.0 to target
set editor's selectionKind to bim slab picked
set editor's selectionId to roofId
set beforeUndo to the length of (editor's documentValue's undoStack's values)
check roof editor (start bim editor roof property (bim round roof property) in e) named (the string form of "GUI and MCP round-roof action is handled")
set profilePoints to the bim roof points of roofId starting at bim roof form setting in editor's documentValue's current
check roof editor (((the length of profilePoints) = 33) and ((the length of (editor's documentValue's current's slabs's values)) = 1)) named (the string form of "one click rounds one native roof without adding tiles")
check roof editor ((the length of (editor's documentValue's undoStack's values)) = (beforeUndo + 1)) named (the string form of "rounding is one undoable edit")
set beforeRevision to editor's documentValue's revision
ignore start bim editor roof property (bim round roof property) in e
check roof editor (editor's documentValue's revision = beforeRevision) named (the string form of "rounding the same roof again is a no-op")
ignore undo bim transaction in (the address of (editor's documentValue))
check roof editor (((the bim setting (bim roof form setting) of roofId in editor's documentValue's current)'s found) = false) named (the string form of "undo restores the flat roof")
set beforeRevision to editor's documentValue's revision
set beforeRedo to the length of (editor's documentValue's redoStack's values)
set editor's propertyText to the string form of "-2,0; nan,2;2,0"
ignore apply bim editor roof property (bim roof profile property) in e
check roof editor ((editor's documentValue's revision = beforeRevision) and ((the length of (editor's documentValue's redoStack's values)) = beforeRedo)) named (the string form of "invalid points preserve the model and redo history")
check roof editor (redo bim transaction in (the address of (editor's documentValue))) named (the string form of "redo survives a refused roof edit")
set editor's propertyText to the string form of "-2,0; 0,3; 2,0"
ignore apply bim editor roof property (bim roof profile property) in e
set changedPoints to the bim roof points of roofId starting at bim roof form setting in editor's documentValue's current
check roof editor (((the length of changedPoints) = 3) and ((the item at 1 in changedPoints)'s y = 3.0)) named (the string form of "section point editing uses metres and changes the native profile")
set beforeRevision to editor's documentValue's revision
ignore apply bim editor roof property (bim roof profile property) in e
check roof editor (editor's documentValue's revision = beforeRevision) named (the string form of "equivalent point input creates no undo step")
set editor's propertyText to the string form of "-2,0; -2,1;2,0"
ignore apply bim editor roof property (bim roof profile property) in e
check roof editor (editor's documentValue's revision = beforeRevision) named (the string form of "non-increasing section offsets are refused")
set editor's propertyText to the string form of "0,3;3,3;6,0.5"
ignore apply bim editor roof property (bim roof hip property) in e
check roof editor ((the bim setting ((bim roof form setting) + 400) of roofId in editor's documentValue's current)'s value = (3 as a 64 bit integer)) named (the string form of "hip profile is editable through the same property action")
set precise to the bim roof points parsed from (the string form of "-2.000001,0;0,3.123456;2,0")
set restored to the bim roof points parsed from (the bim roof point text of (precise's points's values))
check roof editor (restored's valid and (bim roof points (precise's points's values) equal (restored's points's values))) named (the string form of "property text preserves micrometre point precision")
set editor's selectionKind to bim wall picked
set beforeRevision to editor's documentValue's revision
ignore start bim editor roof property (bim round roof property) in e
check roof editor (editor's documentValue's revision = beforeRevision) named (the string form of "wrong selections cannot be rounded as roofs")
