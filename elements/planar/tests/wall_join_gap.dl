# SPDX-License-Identifier: MPL-2.0
# A gap at a wall join (bim/bim_joins.dl): a stopped end stands the gap off
# the face it butts against, the two ends of a mitre stand the gap apart
# across the mitre, an end that runs through keeps none, and no gap leaves
# the join as it was. Walls are 200 mm: their faces 100 mm either side.
import elements/planar/bim_evaluate.dl

function the gap test tenths of {a 64 bit floating-point number:value}:
    execute:
        set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, value * 10000.0)
        return the string form of ((scaled as a 64 bit floating-point number) / 10.0)

function the gap test text of {cad vector2:corner}:
    execute:
        return (((the string form of "(") + (the gap test tenths of corner's x)) + ((the string form of ", ") + (the gap test tenths of corner's y))) + (the string form of ")")

function the gap test end of {a 64 bit integer:wallId} at finish {boolean:atFinish} in {bim model record:modelValue}:
    execute:
        set found to the bim wall index of wallId in modelValue
        set footprint to the bim footprint of (the item at found's position in (modelValue's walls's values)) in modelValue
        if atFinish:
            return ((the gap test text of footprint's finishExterior) + (the string form of " ")) + (the gap test text of footprint's finishInterior)
        return ((the gap test text of footprint's startExterior) + (the string form of " ")) + (the gap test text of footprint's startInterior)

function check join gap {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set gapModel to an empty bim model
set target to the address of gapModel
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set timberLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.2)) to timberLayers
set timberType to add bim wall type named (the string form of "CLT 200") with timberLayers to target

# An L corner: mitred, then with 25 mm between the two cut faces.
set firstLeg to add bim wall typed timberType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 5.0 and y 0.0) to target
set secondLeg to add bim wall typed timberType on ground from (a cad vector2 with x 5.0 and y 0.0) to (a cad vector2 with x 5.0 and y 4.0) to target
set cornerJoin to the bim join of wall firstLeg at finish true in gapModel using (the bim join index of gapModel)
set mitreTight to the gap test end of firstLeg at finish true in gapModel
print ((the string form of "mitre, no gap: ") + mitreTight) as a line
give bim join cornerJoin gap 0.025 in target
print ((the string form of "mitre, 25 mm: ") + (the gap test end of firstLeg at finish true in gapModel)) as a line
print ((the string form of "its partner: ") + (the gap test end of secondLeg at finish false in gapModel)) as a line
check join gap ((the bim gap of join cornerJoin in gapModel) = 0.025) named (the string form of "both ends of an L join carry the gap")

# The same corner butted, the first leg running through: it keeps its
# reach, the second stops 25 mm off its face.
give bim join cornerJoin style (bim butt through join style) in target
print ((the string form of "butt, runs through: ") + (the gap test end of firstLeg at finish true in gapModel)) as a line
print ((the string form of "butt, stopped 25 mm off: ") + (the gap test end of secondLeg at finish false in gapModel)) as a line
give bim join cornerJoin gap 0.0 in target
give bim join cornerJoin style (bim automatic join style) in target
check join gap ((the gap test end of firstLeg at finish true in gapModel) = mitreTight) named (the string form of "no gap and Automatic give the mitre back")

# A T join: the branch stops at the host's face, then 25 mm off it.
set branchWall to add bim wall typed timberType on ground from (a cad vector2 with x 2.5 and y 0.0) to (a cad vector2 with x 2.5 and y 3.0) to target
set teeJoin to the bim join of wall branchWall at finish false in gapModel using (the bim join index of gapModel)
print ((the string form of "T, no gap: ") + (the gap test end of branchWall at finish false in gapModel)) as a line
give bim join teeJoin gap 0.025 in target
print ((the string form of "T, 25 mm: ") + (the gap test end of branchWall at finish false in gapModel)) as a line
check join gap ((the bim join gap after 0.025) = 0.050) named (the string form of "a click after 25 mm gives 50 mm")
check join gap ((the bim join gap after 0.050) = 0.0) named (the string form of "and after 50 mm none")
