# SPDX-License-Identifier: MPL-2.0
# Wall junctions, hosted openings, slabs and incremental re-evaluation of the
# slice, checked against a fresh evaluation.
import elements/planar/bim_evaluate.dl

function check bim evaluation {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print label as a line
            @intrinsic("call", "libc", "exit", nothing, 1)

function a bim test point at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y}:
    execute:
        return a cad vector2 with x x and y y

function the bim rounded text of {a 64 bit floating-point number:value}:
    execute:
        set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, value * 10000.0)
        return the string form of (scaled / 10000.0)

function report bim evaluation {bim evaluation record:evaluation} labelled {a string:label}:
    execute:
        set total to 0.0
        loop cursor from 0 to the length of (evaluation's elements's values):
            set geometry to the item at cursor in (evaluation's elements's values)
            set volume to the bim volume of geometry
            set total to total + volume
            set elementKind to the string form of " wall "
            if (the bim slab index of geometry's id in evaluation's modelValue)'s valid:
                set elementKind to the string form of " slab "
            set line to (label + elementKind) + (the string form of geometry's id)
            set line to ((line + (the string form of " status ")) + (the string form of geometry's status)) + (the string form of " volume ")
            print (line + (the bim rounded text of volume)) as a line
        print ((label + (the string form of " total ")) + (the bim rounded text of total)) as a line
        print ((label + (the string form of " rebuilt ")) + (the string form of evaluation's rebuilt)) as a line

set modelValue to an empty bim model
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to (the address of modelValue)
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.12)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.1)) to layerValues
set exteriorType to add bim wall type named (the string form of "Cavity wall") with layerValues to (the address of modelValue)
free layerValues
set innerLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.1)) to innerLayers
set interiorType to add bim wall type named (the string form of "Partition") with innerLayers to (the address of modelValue)
free innerLayers
set south to add bim wall typed exteriorType on storey from (a bim test point at 0.0 and 0.0) to (a bim test point at 6.0 and 0.0) to (the address of modelValue)
set east to add bim wall typed exteriorType on storey from (a bim test point at 6.0 and 0.0) to (a bim test point at 6.0 and 4.0) to (the address of modelValue)
set north to add bim wall typed exteriorType on storey from (a bim test point at 6.0 and 4.0) to (a bim test point at 0.0 and 4.0) to (the address of modelValue)
set west to add bim wall typed exteriorType on storey from (a bim test point at 0.0 and 4.0) to (a bim test point at 0.0 and 0.0) to (the address of modelValue)
set middle to add bim wall typed interiorType on storey from (a bim test point at 3.0 and 0.0) to (a bim test point at 3.0 and 4.0) to (the address of modelValue)
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to (the address of modelValue)
set window to add bim opening typed windowType in south at 1.5 to (the address of modelValue)
set door to add bim opening typed windowType in middle at 2.0 to (the address of modelValue)
check bim evaluation ((window > 0) and (door > 0)) named "openings added"

set southValue to the item at (the bim wall index of south in modelValue)'s position in (modelValue's walls's values)
set footprint to the bim footprint of southValue in modelValue
set cornerLine to (the string form of "south corner ") + (the string form of footprint's startExterior's x)
print ((cornerLine + (the string form of " ")) + (the string form of footprint's startExterior's y)) as a line

set first to the bim evaluation of modelValue after (an empty bim evaluation)
report bim evaluation first labelled (the string form of "initial")

# Moving the partition rebuilds only the partition.
check bim evaluation (move bim wall middle to (a bim test point at 2.5 and 0.0) and (a bim test point at 2.5 and 4.0) in (the address of modelValue)) named "move partition"
set second to the bim evaluation of modelValue after first
print ((the string form of "after partition move rebuilt ") + (the string form of second's rebuilt)) as a line

# Editing the opening type rebuilds the two hosts.
check bim evaluation (set bim opening type windowType sized 1.0 by 1.2 with sill 1.0 in (the address of modelValue)) named "edit opening type"
set third to the bim evaluation of modelValue after second
print ((the string form of "after type edit rebuilt ") + (the string form of third's rebuilt)) as a line

# Moving the east wall rebuilds it and the two walls it joins.
check bim evaluation (move bim wall east to (a bim test point at 7.0 and 0.0) and (a bim test point at 7.0 and 4.0) in (the address of modelValue)) named "move east"
check bim evaluation (move bim wall south to (a bim test point at 0.0 and 0.0) and (a bim test point at 7.0 and 0.0) in (the address of modelValue)) named "stretch south"
check bim evaluation (move bim wall north to (a bim test point at 7.0 and 4.0) and (a bim test point at 0.0 and 4.0) in (the address of modelValue)) named "stretch north"
set fourth to the bim evaluation of modelValue after third
report bim evaluation fourth labelled (the string form of "stretched")

# An opening that leaves its host is reported, not silently clipped.
check bim evaluation (move bim opening window to 6.9 in (the address of modelValue)) named "move opening"
set fifth to the bim evaluation of modelValue after fourth
set southGeometry to the item at 0 in (fifth's elements's values)
print ((the string form of "outside opening status ") + (the string form of southGeometry's status)) as a line
print ((the string form of "after opening move examined ") + (the string form of fifth's examined)) as a line

# A slab under the house is built on its own; outlines without an area or
# crossing themselves are refused.
set slabOutline to an empty list of a cad vector2
append (a bim test point at 0.0 and 0.0) to slabOutline
append (a bim test point at 7.0 and 0.0) to slabOutline
append (a bim test point at 7.0 and 4.0) to slabOutline
append (a bim test point at 0.0 and 4.0) to slabOutline
set groundSlab to add bim slab on storey around slabOutline thick 0.2 to (the address of modelValue)
free slabOutline
set flatOutline to an empty list of a cad vector2
append (a bim test point at 0.0 and 0.0) to flatOutline
append (a bim test point at 1.0 and 0.0) to flatOutline
append (a bim test point at 2.0 and 0.0) to flatOutline
check bim evaluation ((add bim slab on storey around flatOutline thick 0.2 to (the address of modelValue)) = the bim refused id) named "outline without area refused"
free flatOutline
set crossingOutline to an empty list of a cad vector2
append (a bim test point at 0.0 and 0.0) to crossingOutline
append (a bim test point at 2.0 and 2.0) to crossingOutline
append (a bim test point at 2.0 and 0.0) to crossingOutline
append (a bim test point at 0.0 and 2.0) to crossingOutline
check bim evaluation ((add bim slab on storey around crossingOutline thick 0.2 to (the address of modelValue)) = the bim refused id) named "crossing outline refused"
free crossingOutline
set sixth to the bim evaluation of modelValue after fifth
report bim evaluation sixth labelled (the string form of "slabs")

# Deleting the slab rebuilds nothing and reports it as changed.
check bim evaluation (delete bim slab groundSlab from (the address of modelValue)) named "delete slab"
set seventh to the bim evaluation of modelValue after sixth
print ((the string form of "after slab delete rebuilt ") + (the string form of seventh's rebuilt)) as a line
check bim evaluation (((the length of (seventh's changed's values)) = 1) and ((the item at 0 in (seventh's changed's values)) = groundSlab)) named "deleted slab changed"

# The chain of incremental evaluations must agree with a fresh one element by
# element.
set fresh to the bim evaluation of modelValue after (an empty bim evaluation)
check bim evaluation ((the length of (fresh's elements's values)) = (the length of (seventh's elements's values))) named "same element count"
loop cursor from 0 to the length of (fresh's elements's values):
    set freshGeometry to the item at cursor in (fresh's elements's values)
    set chainedGeometry to the item at cursor in (seventh's elements's values)
    check bim evaluation (freshGeometry's id = chainedGeometry's id) named "same element order"
    check bim evaluation (freshGeometry's signature = chainedGeometry's signature) named "same signature"
    check bim evaluation (freshGeometry's status = chainedGeometry's status) named "same status"
set matched to (the string form of "incremental matches fresh for ") + (the string form of (the length of (fresh's elements's values)))
print (matched + (the string form of " elements")) as a line
