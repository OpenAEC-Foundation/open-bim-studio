# SPDX-License-Identifier: MPL-2.0
# A wall's top constraint (issue #107): held at a level with a top offset,
# following the level; attached to a floor's underside, following the
# floor; attached under a sloped roof, its top a slope along the wall (its
# contour and its volume), level again when the roof is; letting go when
# the roof is deleted or a height is typed; refused when the underside lies
# below the foot. A committed edit moves attached walls, and undo brings
# them back. The constraints survive the file and IfcX.
import exchange/ifcx/bim_file.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl
import ifc/bim_ifc.dl

function the top test text of {a 64 bit floating-point number:value}:
    execute:
        set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, value * 1000.0)
        return (the string form of (scaled as a 64 bit integer)) + (the string form of " mm")

function show top test wall {a 64 bit integer:wallId} of {bim model record:modelValue} labelled {a string:label}:
    execute:
        set found to the bim wall index of wallId in modelValue
        set wallValue to the item at found's position in (modelValue's walls's values)
        set line to (label + (the string form of ": height ")) + (the top test text of wallValue's height)
        set line to (line + (the string form of ", held ")) + (the string form of (wallValue's topLevelId != the bim refused id))
        set line to (line + (the string form of ", attached ")) + (the string form of ((the bim top attachment of wall wallId in modelValue) != the bim refused id))
        set line to (line + (the string form of ", offset ")) + (the top test text of (the bim top offset of wall wallId in modelValue))
        set corners to the bim face contour of wallId in modelValue
        set line to (line + (the string form of ", contour")) + (the string form of (the length of corners))
        loop cursor from 0 to the length of corners:
            set corner to the item at cursor in corners
            set line to (line + (the string form of " (")) + ((the top test text of corner's x) + ((the string form of ", ") + ((the top test text of corner's y) + (the string form of ")"))))
        free corners
        print line as a line

function the top test volume of {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        set evaluation to the bim evaluation of modelValue after (an empty bim evaluation)
        loop cursor from 0 to the length of (evaluation's elements's values):
            set geometry to the item at cursor in (evaluation's elements's values)
            if geometry's id = elementId:
                set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, (the bim volume of geometry) * 1000.0)
                return ((the string form of "status ") + (the string form of geometry's status)) + ((the string form of ", volume ") + (the string form of (scaled / 1000.0)))
        return the string form of "not built"

function the top test outline from {a 64 bit floating-point number:lowX}, {a 64 bit floating-point number:lowY} to {a 64 bit floating-point number:highX}, {a 64 bit floating-point number:highY}:
    execute:
        set corners to an empty list of a cad vector2
        append (a cad vector2 with x lowX and y lowY) to corners
        append (a cad vector2 with x highX and y lowY) to corners
        append (a cad vector2 with x highX and y highY) to corners
        append (a cad vector2 with x lowX and y highY) to corners
        return corners

set documentValue to a new bim document
set d to the address of documentValue
set target to the address of (d's current)
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set upper to add bim level named (the string form of "Upper") at 3.0 with height 3.0 to target
set roofLevel to add bim level named (the string form of "Roof") at 6.0 with height 3.0 to target
set brickLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to brickLayers
set brickType to add bim wall type named (the string form of "Brick") with brickLayers to target
free brickLayers
set concreteLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.25)) to concreteLayers
set floorType to add bim planar type named (the string form of "Floor 250") as role (bim floor planar role) with concreteLayers to target
free concreteLayers
set roofLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.3)) to roofLayers
set roofType to add bim planar type named (the string form of "Roof 300") as role (bim roof planar role) with roofLayers to target
free roofLayers
set lower to add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to target
set higher to add bim wall typed brickType on upper from (a cad vector2 with x 0.0 and y 0.5) to (a cad vector2 with x 4.0 and y 0.5) to target

# Up to level, with a top offset kept while Unconnected.
print ((the string form of "top offset 300 unconnected: ") + (the string form of (set bim wall lower top offset to 0.3 in target))) as a line
show top test wall lower of (d's current) labelled (the string form of "unconnected")
print ((the string form of "up to Upper: ") + (the string form of (hold bim wall lower top at level upper in target))) as a line
show top test wall lower of (d's current) labelled (the string form of "up to Upper")
print ((the string form of "Upper to 3.5 m: ") + (the string form of (set bim level upper at 3.5 with height 3.0 in target))) as a line
show top test wall lower of (d's current) labelled (the string form of "level moved")
print ((the string form of "top offset -200: ") + (the string form of (set bim wall lower top offset to -0.2 in target))) as a line
show top test wall lower of (d's current) labelled (the string form of "offset below")
print ((the string form of "top offset -3450 refused: ") + (the string form of (set bim wall lower top offset to -3.45 in target))) as a line
show top test wall lower of (d's current) labelled (the string form of "kept")

# Attached to the floor of Upper: its underside 250 mm below the level.
set floorOutline to the top test outline from -1.0, -1.0 to 5.0, 1.0
set floorId to add bim plate typed floorType on upper around floorOutline at top 0.0 to target
free floorOutline
print ((the string form of "attached to the floor: ") + (the string form of (attach bim wall lower top to plate floorId in target))) as a line
show top test wall lower of (d's current) labelled (the string form of "attached")
print ((the string form of "top offset 0: ") + (the string form of (set bim wall lower top offset to 0.0 in target))) as a line
show top test wall lower of (d's current) labelled (the string form of "under the floor")
ignore (set bim plate floorId top to 0.5 pitch 0.0 heading 0.0 in target)
refresh bim wall tops in target
show top test wall lower of (d's current) labelled (the string form of "floor raised")
print ((the string form of "  ") + (the top test volume of lower in (d's current))) as a line

# Attached under a roof rising 0.2 rad toward +x from its first corner.
set roofOutline to the top test outline from -1.0, -1.0 to 5.0, 1.0
set roofId to add bim plate typed roofType on roofLevel around roofOutline at top 0.0 to target
free roofOutline
ignore (set bim plate roofId top to 0.0 pitch 0.2 heading 0.0 in target)
print ((the string form of "attached to the roof: ") + (the string form of (attach bim wall higher top to plate roofId in target))) as a line
show top test wall higher of (d's current) labelled (the string form of "under the roof")
print ((the string form of "  ") + (the top test volume of higher in (d's current))) as a line
# Refreshing a wall already in place journals nothing.
set journalled to the length of (d's current's journal's values)
refresh bim wall tops in target
print ((the string form of "refresh in place journals: ") + (the string form of ((the length of (d's current's journal's values)) - journalled))) as a line

# The file and IfcX keep both constraints.
set reread to the bim model parsed from (the bim file text of d's current)
print ((the string form of ".bim read: ") + (the string form of reread's valid)) as a line
show top test wall higher of reread's modelValue labelled (the string form of "  from .bim")
show top test wall lower of reread's modelValue labelled (the string form of "  from .bim")
set native to the bim native text of ifcx (the bim ifcx text of d's current identified as (the string form of "t.ifcx") for project (the string form of "t") by (the string form of "test") at (the string form of "2026-10-31T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + (the string form of fromIfcx's valid)) as a line
show top test wall higher of fromIfcx's modelValue labelled (the string form of "  from .ifcx")
show top test wall lower of fromIfcx's modelValue labelled (the string form of "  from .ifcx")
# IFC: the constraints as the application's own property set, the sloped
# wall as its solid.
set stepText to the bim ifc text of d's current
print ((the string form of "IFC attached set: ") + (the string form of ((the index of (the string form of "'TopConstraint',$,IFCLABEL('Attached')") in stepText) >= 0))) as a line
set constraintSets to 0
set searchFrom to the index of (the string form of "'OBS_WallTopConstraint'") in stepText
loop while searchFrom >= 0:
    set constraintSets to constraintSets + 1
    set searchFrom to the index of (the string form of "'OBS_WallTopConstraint'") in stepText starting at (searchFrom + 1)
print ((the string form of "IFC top constraint sets: ") + (the string form of constraintSets)) as a line

# A committed edit moves the walls attached; undo brings them back.
begin bim transaction in d
ignore (set bim plate roofId top to 0.0 pitch 0.0 heading 0.0 in target)
ignore (set bim plate floorId top to 0.2 pitch 0.0 heading 0.0 in target)
commit bim transaction in d
show top test wall higher of (d's current) labelled (the string form of "roof made level")
show top test wall lower of (d's current) labelled (the string form of "floor lowered")
print ((the string form of "undo: ") + (the string form of (undo bim transaction in d))) as a line
show top test wall higher of (d's current) labelled (the string form of "undone")
show top test wall lower of (d's current) labelled (the string form of "undone")

# The roof deleted: the wall keeps its last height.
begin bim transaction in d
ignore (delete bim slab roofId from target)
commit bim transaction in d
show top test wall higher of (d's current) labelled (the string form of "roof deleted")

# A typed height lets go of the floor; an underside below the foot is
# refused; Unconnected keeps the height.
print ((the string form of "typed height: ") + (the string form of (set bim wall lower height to 2.0 in target))) as a line
show top test wall lower of (d's current) labelled (the string form of "typed")
set groundOutline to the top test outline from -1.0, -1.0 to 5.0, 1.0
set groundFloor to add bim plate typed floorType on ground around groundOutline at top 0.0 to target
free groundOutline
print ((the string form of "attached below its foot: ") + (the string form of (attach bim wall lower top to plate groundFloor in target))) as a line
show top test wall lower of (d's current) labelled (the string form of "refused")
ignore (attach bim wall lower top to plate floorId in target)
print ((the string form of "unconnected: ") + (the string form of (free bim wall lower top in target))) as a line
show top test wall lower of (d's current) labelled (the string form of "unconnected")
