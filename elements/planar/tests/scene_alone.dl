# SPDX-License-Identifier: MPL-2.0
# The planar module's scene part alone gives the same meshes as the whole
# scene does for the same walls: the composed dispatcher calls the modules
# in layer order, and that order does not matter, because a kept mesh is
# found by element id and part (issue 13). The model is the masonry lines
# test's: two walls, one with a measured module.
import viewer/bim_scene.dl
import elements/planar/scene.dl

function check scene alone {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The mesh of element `elementId`, part `partIndex`, among `meshes`, or the
# first mesh when there is none (the caller checks the count first).
function the scene alone mesh of {a 64 bit integer:elementId} part {integer:partIndex} among {a pointer to a list:meshes}:
    execute:
        loop cursor from 0 to the length of meshes:
            set entry to the item at cursor in meshes
            if (entry's elementId = elementId) and (entry's part = partIndex):
                return entry
        return the item at 0 in meshes

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 1.0 with height 3.0 to target
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "block", 0.1)) to layerValues
set cavityType to add bim wall type named (the string form of "Two leaves 200") with layerValues to target
set wallId to add bim wall typed cavityType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 2.0 and y 0.0) to target
set plainWall to add bim wall typed cavityType on ground from (a cad vector2 with x 0.0 and y 5.0) to (a cad vector2 with x 2.0 and y 5.0) to target
ignore give bim wall wallId masonry module (2100 as a 64 bit integer) on layer 0 from finish false offset (0 as a 64 bit integer) in target

set whole to the bim sketch meshes of modelValue
set noPrevious to an empty list of a bim scene mesh record
set keys to the bim kept mesh keys of noPrevious
set remadeIds to an empty list of a 64 bit integer
set alone to a cad topology list of a bim scene mesh record
append bim scene meshes of modelValue within 0.0 reusing noPrevious keyed keys refreshing remadeIds with reinforcement detail true into (alone's values) with planar elements

set wholePlanar to 0
loop cursor from 0 to the length of (whole's values):
    if (the item at cursor in (whole's values))'s part = (bim masonry line part):
        set wholePlanar to wholePlanar + 1
check scene alone ((the length of (alone's values)) = 1) named (the string form of "the planar part alone yields the wall's masonry lines")
check scene alone (wholePlanar = 1) named (the string form of "the whole scene holds the same number of planar meshes")
set allRepeat to true
loop cursor from 0 to the length of (alone's values):
    set own to the item at cursor in (alone's values)
    set other to the scene alone mesh of own's elementId part own's part among (whole's values)
    if (bim scene mesh own repeats other) = false:
        set allRepeat to false
check scene alone allRepeat named (the string form of "each mesh of the part alone repeats the whole scene's, found by id and part")
