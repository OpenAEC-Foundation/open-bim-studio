# SPDX-License-Identifier: MPL-2.0
# A wall's top attached to several roof planes: a gable wall 10 m long
# under the two planes of a pitched roof (rising 1 in 2 from 3.25 m over
# its ends to a ridge at 5.75 m over its middle) is one wall whose top
# rises to the ridge and falls again. Attached to one plane it follows that
# plane over its whole length, as before; attached to the roofs above, its
# contour is a pentagon, its volume that of the pentagon, a window across
# the ridge is cut from it, and a section along it cuts one outline with
# the window's hole and no joint at the ridge. A roof raised steps the top
# at the ridge, a roof deleted leaves the wall on the other, and undo
# brings both back. The plates survive the file and IfcX, and IFC names
# them both.
import exchange/ifcx/bim_file.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl
import ifc/bim_ifc.dl
import views/drawings/bim_drawing.dl

function the gable test text of {a 64 bit floating-point number:metres}:
    execute:
        set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, metres * 1000.0)
        return the string form of (scaled as a 64 bit integer)

function the gable test corners of {a pointer to a list:cornerList}:
    execute:
        set written to the string form of ""
        loop cornerCursor from 0 to the length of cornerList:
            set corner to the item at cornerCursor in cornerList
            set written to (written + (the string form of " (")) + ((the gable test text of corner's x) + ((the string form of ", ") + ((the gable test text of corner's y) + (the string form of ")"))))
        return written

function show gable test wall {a 64 bit integer:wallId} of {bim model record:modelValue} labelled {a string:caption}:
    execute:
        set found to the bim wall index of wallId in modelValue
        set wallValue to the item at found's position in (modelValue's walls's values)
        set shown to (caption + (the string form of ": height ")) + (the gable test text of wallValue's height)
        set constraintId to the bim top constraint of wall wallValue in modelValue
        set severalShown to the string form of "one"
        if constraintId = the bim several plates id:
            set severalShown to the string form of "several"
        if constraintId = the bim refused id:
            set severalShown to the string form of "none"
        set shown to (shown + (the string form of ", constraint ")) + severalShown
        set plateIds to the bim top attachments of wall wallId in modelValue
        set shown to (shown + (the string form of ", plates ")) + (the string form of (the length of plateIds))
        free plateIds
        set corners to the bim face contour of wallId in modelValue
        set shown to ((shown + (the string form of ", contour ")) + (the string form of (the length of corners))) + (the gable test corners of corners)
        free corners
        print shown as a line

function the gable test volume of {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        set evaluation to the bim evaluation of modelValue after (an empty bim evaluation)
        loop cursor from 0 to the length of (evaluation's elements's values):
            set geometry to the item at cursor in (evaluation's elements's values)
            if geometry's id = elementId:
                set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, (the bim volume of geometry) * 1000.0)
                return ((the string form of "status ") + (the string form of geometry's status)) + ((the string form of ", volume ") + (the string form of (scaled / 1000.0)))
        return the string form of "not built"

function the gable test outline from {a 64 bit floating-point number:lowX}, {a 64 bit floating-point number:lowY} to {a 64 bit floating-point number:highX}, {a 64 bit floating-point number:highY}:
    execute:
        set corners to an empty list of a cad vector2
        append (a cad vector2 with x lowX and y lowY) to corners
        append (a cad vector2 with x highX and y lowY) to corners
        append (a cad vector2 with x highX and y highY) to corners
        append (a cad vector2 with x lowX and y highY) to corners
        return corners

# The polygons a section along the wall's line cuts from wall `wallId`:
# per polygon the corners where its outline turns, its area and its
# highest point.
function show gable test section of {a 64 bit integer:wallId} in {bim model record:modelValue}:
    execute:
        set evaluation to the bim evaluation of modelValue after (an empty bim evaluation)
        set sectionView to the bim section of evaluation from (a cad vector2 with x 0.05 and y 0.0) to (a cad vector2 with x 0.05 and y 10.0)
        set polygonTotal to 0
        loop sourceCursor from 0 to the length of (sectionView's sources's values):
            set source to the item at sourceCursor in (sectionView's sources's values)
            loop polygonCursor from 0 to the length of (source's polygons's values):
                set polygon to the item at polygonCursor in (source's polygons's values)
                if polygon's elementId = wallId:
                    set polygonTotal to polygonTotal + 1
                    set highest to -1000.0
                    loop cornerCursor from 0 to the length of (polygon's points's values):
                        set highest to the maximum of highest and (the item at cornerCursor in (polygon's points's values))'s y
                    # Corners where the outline turns; points in line
                    # with their neighbours (where the kernel split an
                    # edge) draw no joint.
                    set cornerTotal to the length of (polygon's points's values)
                    set turning to 0
                    loop cornerCursor from 0 to cornerTotal:
                        set priorCorner to the item at (the remainder of ((cornerCursor + cornerTotal) - 1) divided by cornerTotal) in (polygon's points's values)
                        set thisCorner to the item at cornerCursor in (polygon's points's values)
                        set nextCorner to the item at (the remainder of (cornerCursor + 1) divided by cornerTotal) in (polygon's points's values)
                        set bendArea to ((thisCorner's x - priorCorner's x) * (nextCorner's y - priorCorner's y)) - ((thisCorner's y - priorCorner's y) * (nextCorner's x - priorCorner's x))
                        if (the absolute value of bendArea) > 1e-6:
                            set turning to turning + 1
                    set shown to (the string form of "  cut: ") + (the string form of turning)
                    set areaScaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, (the absolute value of (the bim area of polygon)) * 1000.0)
                    set shown to (shown + (the string form of " turning corners, area ")) + (the string form of (areaScaled / 1000.0))
                    set shown to (shown + (the string form of ", highest ")) + (the gable test text of highest)
                    print shown as a line
        print ((the string form of "  section polygons of the wall: ") + (the string form of polygonTotal)) as a line

set documentValue to a new bim document
set d to the address of documentValue
set target to the address of (d's current)
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set attic to add bim level named (the string form of "Attic") at 3.0 with height 3.0 to target
set brickLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to brickLayers
set brickType to add bim wall type named (the string form of "Brick") with brickLayers to target
free brickLayers
set roofLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.3)) to roofLayers
set roofType to add bim planar type named (the string form of "Roof 300") as role (bim roof planar role) with roofLayers to target
free roofLayers
set pitchAngle to @intrinsic("call", "libc", "atan", a 64 bit floating-point number, 0.5)
# The south plane rises from its eave (y = -0.5) toward +y; the north
# plane falls from the ridge (y = 5, its first corner) toward +y.
set southOutline to the gable test outline from -1.0, -0.5 to 5.0, 5.0
set southRoof to add bim plate typed roofType on attic around southOutline at top 0.0 to target
free southOutline
ignore (set bim plate southRoof top to 0.3 pitch pitchAngle heading 1.5707963267948966 in target)
set northOutline to the gable test outline from -1.0, 5.0 to 5.0, 10.5
set northRoof to add bim plate typed roofType on attic around northOutline at top 0.0 to target
free northOutline
ignore (set bim plate northRoof top to 3.05 pitch pitchAngle heading 4.71238898038469 in target)
set gableWall to add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 10.0) to target
show gable test wall gableWall of (d's current) labelled (the string form of "unconnected")

# One plane, as before: the top follows the south plane past the ridge.
print ((the string form of "attached to the south roof: ") + (the string form of (attach bim wall gableWall top to plate southRoof in target))) as a line
show gable test wall gableWall of (d's current) labelled (the string form of "one plane")

# The roofs above: both planes, the lowest where both reach.
set roofIds to the bim roofs above wall (the item at (the bim wall index of gableWall in (d's current))'s position in (d's current's walls's values)) in (d's current)
print ((the string form of "roofs above: ") + (the string form of (the length of roofIds))) as a line
set profilePoints to the bim top profile of wall (the item at (the bim wall index of gableWall in (d's current))'s position in (d's current's walls's values)) under plates roofIds in (d's current)
print ((the string form of "top profile:") + (the gable test corners of profilePoints)) as a line
free profilePoints
free roofIds
print ((the string form of "attached to the roofs above: ") + (the string form of (attach bim wall gableWall top to roofs above in target))) as a line
show gable test wall gableWall of (d's current) labelled (the string form of "gable")
print ((the string form of "  ") + (the gable test volume of gableWall in (d's current))) as a line

# A window across the ridge line: 1.0 by 1.2 m, sill 3.5 m.
set windowType to add bim opening type named (the string form of "Gable window") sized 1.0 by 1.2 with sill 3.5 and frame 0.0 to target
set gableWindow to add bim opening typed windowType in gableWall at 5.0 to target
print ((the string form of "window across the ridge: ") + (the string form of (gableWindow != the bim refused id))) as a line
print ((the string form of "  ") + (the gable test volume of gableWall in (d's current))) as a line
show gable test section of gableWall in (d's current)

# Refreshing a wall already in place journals nothing.
set journalled to the length of (d's current's journal's values)
refresh bim wall tops in target
print ((the string form of "refresh in place journals: ") + (the string form of ((the length of (d's current's journal's values)) - journalled))) as a line

# The north plane raised 0.5 m: the top steps up at the ridge.
begin bim transaction in d
ignore (set bim plate northRoof top to 3.55 pitch pitchAngle heading 4.71238898038469 in target)
commit bim transaction in d
show gable test wall gableWall of (d's current) labelled (the string form of "north raised")
print ((the string form of "undo: ") + (the string form of (undo bim transaction in d))) as a line
show gable test wall gableWall of (d's current) labelled (the string form of "undone")

# The north plane deleted: the wall follows the south plane alone.
begin bim transaction in d
ignore (delete bim slab northRoof from target)
commit bim transaction in d
show gable test wall gableWall of (d's current) labelled (the string form of "north deleted")
print ((the string form of "undo: ") + (the string form of (undo bim transaction in d))) as a line
show gable test wall gableWall of (d's current) labelled (the string form of "undone")

# The file and IfcX keep both plates; IFC names them both.
set reread to the bim model parsed from (the bim file text of d's current)
print ((the string form of ".bim read: ") + (the string form of reread's valid)) as a line
show gable test wall gableWall of reread's modelValue labelled (the string form of "  from .bim")
print ((the string form of "  ") + (the gable test volume of gableWall in reread's modelValue)) as a line
print ((the string form of "  same text again: ") + (the string form of ((the bim file text of reread's modelValue) = (the bim file text of d's current)))) as a line
set native to the bim native text of ifcx (the bim ifcx text of d's current identified as (the string form of "t.ifcx") for project (the string form of "t") by (the string form of "test") at (the string form of "2026-11-06T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + (the string form of fromIfcx's valid)) as a line
show gable test wall gableWall of fromIfcx's modelValue labelled (the string form of "  from .ifcx")
set stepText to the bim ifc text of d's current
set wantedTarget to ((the string form of "'TopTarget',$,IFCLABEL('") + (the string form of southRoof)) + (((the string form of ",") + (the string form of northRoof)) + (the string form of "')"))
print ((the string form of "IFC names both roofs: ") + (the string form of ((the index of wantedTarget in stepText) >= 0))) as a line

# Back to one plane: the further plate goes.
print ((the string form of "attached to the north roof: ") + (the string form of (attach bim wall gableWall top to plate northRoof in target))) as a line
show gable test wall gableWall of (d's current) labelled (the string form of "one plane again")
print ((the string form of "unconnected: ") + (the string form of (free bim wall gableWall top in target))) as a line
show gable test wall gableWall of (d's current) labelled (the string form of "unconnected")
