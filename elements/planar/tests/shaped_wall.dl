# SPDX-License-Identifier: MPL-2.0
# Walls leaning and round in section: a straight wall's top shifted 0.6 m, a
# wall bowed 0.3 m at half its height, one with a window, and a wall round
# in plan and in section. Each stays a closed polyhedron of the upright
# wall's volume (the shift is sideways only), shifted where it should be,
# and survives the file and IfcX.
import exchange/ifcx/bim_file.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl

function the shaped test text of {a 64 bit floating-point number:value}:
    execute:
        set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, value * 10000.0)
        return the string form of (scaled / 10000.0)

function the shaped geometry of {a 64 bit integer:elementId} in {bim evaluation record:evaluation}:
    execute:
        set chosen to 0
        loop cursor from 0 to the length of (evaluation's elements's values):
            if (the item at cursor in (evaluation's elements's values))'s id = elementId:
                set chosen to cursor
        return the item at chosen in (evaluation's elements's values)

# The reach of `shape` across y at height `level` (its points there).
function show shaped {a 64 bit integer:elementId} of {bim model record:modelValue} labelled {a string:label} at {a 64 bit floating-point number:level}:
    execute:
        set evaluation to the bim evaluation of modelValue after (an empty bim evaluation)
        set geometry to the shaped geometry of elementId in evaluation
        set low to 1.0 / 0.0
        set high to 0.0 - (1.0 / 0.0)
        loop cursor from 0 to the length of (geometry's shape's positions's values):
            set spot to the item at cursor in (geometry's shape's positions's values)
            if (the absolute value of (spot's z - level)) < 1e-6:
                set low to the minimum of low and spot's y
                set high to the maximum of high and spot's y
        set line to (label + (the string form of ": status ")) + (the string form of geometry's status)
        set line to (line + (the string form of ", fast ")) + (the string form of geometry's fast)
        set line to (line + (the string form of ", flaw ")) + (the string form of (the fast flaw of geometry's shape within 1e-7))
        set line to (line + (the string form of ", volume ")) + (the shaped test text of (the bim volume of geometry))
        set line to (line + (the string form of ", y at ")) + ((the shaped test text of level) + (the string form of ": "))
        print ((line + (the shaped test text of low)) + ((the string form of " to ") + (the shaped test text of high))) as a line

# How many of `first`'s points at height `level` `second` shares.
function show bim joint of {a 64 bit integer:first} with {a 64 bit integer:second} in {bim model record:modelValue} at {a 64 bit floating-point number:level} labelled {a string:label}:
    execute:
        set evaluation to the bim evaluation of modelValue after (an empty bim evaluation)
        set one to (the shaped geometry of first in evaluation)'s shape's positions's values
        set other to (the shaped geometry of second in evaluation)'s shape's positions's values
        set shared to 0
        loop cursor from 0 to the length of one:
            set spot to the item at cursor in one
            if (the absolute value of (spot's z - level)) < 1e-6:
                set matched to false
                loop otherCursor from 0 to the length of other:
                    if (the cad length of (the cad difference of spot and (the item at otherCursor in other))) < 1e-6:
                        set matched to true
                if matched:
                    set shared to shared + 1
        print ((label + (the string form of ": shared corners at the top ")) + (the string form of shared)) as a line

set modelValue to an empty bim model
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to (the address of modelValue)
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to layerValues
set solid to add bim wall type named (the string form of "Concrete 200") with layerValues to (the address of modelValue)
free layerValues
set target to the address of modelValue
set upright to add bim wall typed solid on storey from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to target
show shaped upright of modelValue labelled (the string form of "upright") at 3.0
ignore set bim wall upright lean to 0.6 and rise to 0.0 in target
show shaped upright of modelValue labelled (the string form of "leaning 0.6") at 3.0
show shaped upright of modelValue labelled (the string form of "leaning 0.6") at 0.0
ignore set bim wall upright lean to 0.0 and rise to 0.3 in target
show shaped upright of modelValue labelled (the string form of "bowed 0.3") at 1.5
show shaped upright of modelValue labelled (the string form of "bowed 0.3") at 3.0
print ((the string form of "a lean as high as the wall refused: ") + (the string form of ((set bim wall upright lean to 3.0 and rise to 0.0 in target) = false))) as a line
# A window in the bowed wall.
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.2 with sill 0.9 and frame 0.05 to target
ignore add bim opening typed windowType in upright at 2.0 to target
ignore set bim wall upright lean to 0.4 and rise to 0.3 in target
show shaped upright of modelValue labelled (the string form of "leaning and bowed, with a window") at 3.0
# Round in plan (bulge 1) and bowed in section.
set round to add bim wall typed solid on storey from (a cad vector2 with x 0.0 and y 10.0) to (a cad vector2 with x 6.0 and y 10.0) to target
ignore bend bim wall round by 1.0 in target
show shaped round of modelValue labelled (the string form of "round in plan") at 3.0
ignore set bim wall round lean to 0.0 and rise to 0.25 in target
show shaped round of modelValue labelled (the string form of "round in plan and section") at 1.5
# An L corner: upright, both leaning 0.3 m, and only one leaning; the joint
# keeps its two corners shared at the top.
set south to add bim wall typed solid on storey from (a cad vector2 with x 0.0 and y 20.0) to (a cad vector2 with x 4.0 and y 20.0) to target
set east to add bim wall typed solid on storey from (a cad vector2 with x 4.0 and y 20.0) to (a cad vector2 with x 4.0 and y 24.0) to target
show bim joint of south with east in modelValue at 3.0 labelled (the string form of "upright L")
ignore set bim wall south lean to 0.3 and rise to 0.0 in target
ignore set bim wall east lean to 0.3 and rise to 0.0 in target
show bim joint of south with east in modelValue at 3.0 labelled (the string form of "both leaning")
show shaped east of modelValue labelled (the string form of "east, both leaning") at 3.0
ignore set bim wall east lean to 0.0 and rise to 0.0 in target
show bim joint of south with east in modelValue at 3.0 labelled (the string form of "south leaning")
show shaped east of modelValue labelled (the string form of "east upright, joined to the leaning south") at 3.0
ignore set bim wall south lean to 0.0 and rise to 0.2 in target
show bim joint of south with east in modelValue at 1.5 labelled (the string form of "south bowed, at half height")
# Saved and read back.
set reread to the bim model parsed from (the bim file text of modelValue)
set back to the item at (the bim wall index of round in reread's modelValue)'s position in (reread's modelValue's walls's values)
print (((the string form of ".bim: lean ") + (the shaped test text of back's lean)) + ((the string form of ", rise ") + (the shaped test text of back's rise))) as a line
set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "w.ifcx") for project (the string form of "w") by (the string form of "test") at (the string form of "2026-10-08T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
set backIfcx to the item at (the bim wall index of upright in fromIfcx's modelValue)'s position in (fromIfcx's modelValue's walls's values)
print (((the string form of ".ifcx: lean ") + (the shaped test text of backIfcx's lean)) + ((the string form of ", rise ") + (the shaped test text of backIfcx's rise))) as a line
