# SPDX-License-Identifier: MPL-2.0
# Join styles per wall end (bim/bim_joins.dl): at an L corner and at a T
# join each style moves the ends' footprint corners as it says (Automatic
# and Mitre mitre the L, Butt runs one wall through to the other's far
# face and stops the other at its near face, Square off squares a slanted
# end where its farther corner reached, Not joined leaves both ends square
# on their points), the solids follow, and the styles survive the native
# file and IfcX. Walls are 200 mm: their faces 100 mm either side.
import exchange/ifcx/bim_file.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl

function the join test millimetres of {a 64 bit floating-point number:value}:
    execute:
        set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, value * 1000.0)
        return the string form of (scaled as a 64 bit integer)

function the join test text of {cad vector2:corner}:
    execute:
        return (((the string form of "(") + (the join test millimetres of corner's x)) + ((the string form of ", ") + (the join test millimetres of corner's y))) + (the string form of ")")

# The corners of the start (or the finish) of wall `wallId`: exterior then
# interior, in millimetres.
function the join test end of {a 64 bit integer:wallId} at finish {boolean:atFinish} in {bim model record:modelValue}:
    execute:
        set found to the bim wall index of wallId in modelValue
        set footprint to the bim footprint of (the item at found's position in (modelValue's walls's values)) in modelValue
        if atFinish:
            return ((the join test text of footprint's finishExterior) + (the string form of " ")) + (the join test text of footprint's finishInterior)
        return ((the join test text of footprint's startExterior) + (the string form of " ")) + (the join test text of footprint's startInterior)

function check join style {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the join test volume of {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        set evaluation to the bim evaluation of modelValue after (an empty bim evaluation)
        loop cursor from 0 to the length of (evaluation's elements's values):
            set geometry to the item at cursor in (evaluation's elements's values)
            if geometry's id = elementId:
                set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, (the bim volume of geometry) * 1000000.0)
                return (the string form of (scaled as a 64 bit integer)) + (the string form of " cm3")
        return the string form of "not built"

# The join at an end, from that end.
function the join test join of {a 64 bit integer:wallId} at finish {boolean:atFinish} in {bim model record:modelValue}:
    execute:
        return the bim join of wall wallId at finish atFinish in modelValue using (the bim join index of modelValue)

set documentValue to a new bim document
set d to the address of documentValue
set target to the address of (d's current)
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set brickLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to brickLayers
set brickType to add bim wall type named (the string form of "Brick 200") with brickLayers to target
free brickLayers
# An L corner at (4, 0): the first wall's finish meets the second's start.
set firstLeg to add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to target
set secondLeg to add bim wall typed brickType on ground from (a cad vector2 with x 4.0 and y 0.0) to (a cad vector2 with x 4.0 and y 3.0) to target
# A T join at (13, 0): the branch's start on the host's centreline.
set hostWall to add bim wall typed brickType on ground from (a cad vector2 with x 10.0 and y 0.0) to (a cad vector2 with x 16.0 and y 0.0) to target
set branchWall to add bim wall typed brickType on ground from (a cad vector2 with x 13.0 and y 0.0) to (a cad vector2 with x 13.0 and y 3.0) to target
# A slanted T join at (20, 0), the branch at 45 degrees.
set slantHost to add bim wall typed brickType on ground from (a cad vector2 with x 17.0 and y 0.0) to (a cad vector2 with x 25.0 and y 0.0) to target
set slantBranch to add bim wall typed brickType on ground from (a cad vector2 with x 20.0 and y 0.0) to (a cad vector2 with x 22.0 and y 2.0) to target

# The joins of the storey: the L once, from the lower id, and both Ts.
set storeyJoins to the bim wall joins on level ground in d's current using (the bim join index of d's current)
print ((the string form of "joins on the storey: ") + (the string form of (the length of storeyJoins))) as a line
loop joinCursor from 0 to the length of storeyJoins:
    set listedJoin to the item at joinCursor in storeyJoins
    set listedLine to ((the string form of "  ") + (the bim join kind name of listedJoin's kind)) + (the string form of " of ")
    set listedLine to (listedLine + (the string form of listedJoin's firstId)) + ((the string form of " finish ") + (the string form of listedJoin's firstAtFinish))
    set listedLine to (listedLine + (the string form of " and ")) + (the string form of listedJoin's secondId)
    set listedLine to (listedLine + (the string form of " at ")) + (the join test text of listedJoin's place)
    print (listedLine) as a line
check join style ((the length of storeyJoins) = 3) named (the string form of "one L and two T joins")
free storeyJoins

# The L corner, style by style.
set cornerJoin to the join test join of firstLeg at finish true in d's current
check join style ((cornerJoin's kind = bim l join kind) and ((cornerJoin's secondId = secondLeg) and (cornerJoin's secondAtFinish = false))) named (the string form of "the first wall's finish joins the second's start in an L")
set automaticFirst to the join test end of firstLeg at finish true in d's current
set automaticSecond to the join test end of secondLeg at finish false in d's current
print (((the string form of "L automatic: first ") + automaticFirst) + ((the string form of ", second ") + automaticSecond)) as a line
check join style ((automaticFirst = "(4100, -100) (3900, 100)") and (automaticSecond = "(4100, -100) (3900, 100)")) named (the string form of "Automatic mitres the corner")
set automaticVolumes to ((the join test volume of firstLeg in d's current) + (the string form of " + ")) + (the join test volume of secondLeg in d's current)
print ((the string form of "  volumes ") + automaticVolumes) as a line

give bim join cornerJoin style (bim mitre join style) in target
check join style (((the join test end of firstLeg at finish true in d's current) = automaticFirst) and ((the join test end of secondLeg at finish false in d's current) = automaticSecond)) named (the string form of "Mitre is the automatic cut")
check join style ((the bim own join style of end secondLeg at finish false in d's current) = bim mitre join style) named (the string form of "both ends store the style")

give bim join cornerJoin style (bim butt through join style) in target
set throughFirst to the join test end of firstLeg at finish true in d's current
set throughSecond to the join test end of secondLeg at finish false in d's current
print (((the string form of "L butt, first runs through: first ") + throughFirst) + ((the string form of ", second ") + throughSecond)) as a line
check join style ((throughFirst = "(4100, -100) (4100, 100)") and (throughSecond = "(4100, 100) (3900, 100)")) named (the string form of "the first wall reaches the far face, the second stops at its near face")
check join style ((the bim own join style of end secondLeg at finish false in d's current) = bim butt stopped join style) named (the string form of "the second end stores the mirrored style")
print ((the string form of "  volumes ") + (((the join test volume of firstLeg in d's current) + (the string form of " + ")) + (the join test volume of secondLeg in d's current))) as a line

give bim join cornerJoin style (bim butt stopped join style) in target
set stoppedFirst to the join test end of firstLeg at finish true in d's current
set stoppedSecond to the join test end of secondLeg at finish false in d's current
print (((the string form of "L butt, second runs through: first ") + stoppedFirst) + ((the string form of ", second ") + stoppedSecond)) as a line
check join style ((stoppedFirst = "(3900, -100) (3900, 100)") and (stoppedSecond = "(4100, -100) (3900, -100)")) named (the string form of "the other way round")

give bim join cornerJoin style (bim square through join style) in target
check join style (((the join test end of firstLeg at finish true in d's current) = throughFirst) and ((the join test end of secondLeg at finish false in d's current) = throughSecond)) named (the string form of "at a right angle Square off is the butt")

give bim join cornerJoin style (bim not joined style) in target
set apartFirst to the join test end of firstLeg at finish true in d's current
set apartSecond to the join test end of secondLeg at finish false in d's current
print (((the string form of "L not joined: first ") + apartFirst) + ((the string form of ", second ") + apartSecond)) as a line
check join style ((apartFirst = "(4000, -100) (4000, 100)") and (apartSecond = "(4100, 0) (3900, 0)")) named (the string form of "Not joined leaves both ends square on their points")
print ((the string form of "  volumes ") + (((the join test volume of firstLeg in d's current) + (the string form of " + ")) + (the join test volume of secondLeg in d's current))) as a line
# Only one end giving the style is enough: the other reads it mirrored.
set bim setting (bim join style start setting) of secondLeg to (0 as a 64 bit integer) keeping false in target
check join style (((the join test end of firstLeg at finish true in d's current) = apartFirst) and ((the join test end of secondLeg at finish false in d's current) = apartSecond)) named (the string form of "one end's Not joined keeps both apart")
give bim join cornerJoin style (bim automatic join style) in target
check join style (((the join test end of firstLeg at finish true in d's current) = automaticFirst) and ((the join test end of secondLeg at finish false in d's current) = automaticSecond)) named (the string form of "Automatic again mitres as before")
check join style (((the bim setting (bim join style finish setting) of firstLeg in d's current)'s found = false) and ((the bim setting (bim join style start setting) of secondLeg in d's current)'s found = false)) named (the string form of "Automatic stores no setting")
check join style ((((the join test volume of firstLeg in d's current) + (the string form of " + ")) + (the join test volume of secondLeg in d's current)) = automaticVolumes) named (the string form of "and the solids are as before")

# The T join.
set teeJoin to the join test join of branchWall at finish false in d's current
check join style ((teeJoin's kind = bim t join kind) and (teeJoin's secondId = hostWall)) named (the string form of "the branch's start joins the host in a T")
set teeAutomatic to the join test end of branchWall at finish false in d's current
set hostAutomatic to (the join test end of hostWall at finish false in d's current) + (the join test end of hostWall at finish true in d's current)
print ((the string form of "T automatic: branch ") + teeAutomatic) as a line
check join style (teeAutomatic = "(13100, 100) (12900, 100)") named (the string form of "Automatic butts the branch against the host's near face")
give bim join teeJoin style (bim butt stopped join style) in target
check join style ((the join test end of branchWall at finish false in d's current) = teeAutomatic) named (the string form of "Butt is the automatic cut at a T")
give bim join teeJoin style (bim butt through join style) in target
set teeThrough to the join test end of branchWall at finish false in d's current
print ((the string form of "T, branch running through: ") + teeThrough) as a line
check join style (teeThrough = "(13100, -100) (12900, -100)") named (the string form of "a branch running through reaches the host's far face")
give bim join teeJoin style (bim not joined style) in target
set teeApart to the join test end of branchWall at finish false in d's current
print ((the string form of "T not joined: branch ") + teeApart) as a line
check join style (teeApart = "(13100, 0) (12900, 0)") named (the string form of "Not joined leaves the branch square on the host's centreline")
check join style (((the join test end of hostWall at finish false in d's current) + (the join test end of hostWall at finish true in d's current)) = hostAutomatic) named (the string form of "the host is never cut")
check join style ((the bim setting (bim join style start setting) of hostWall in d's current)'s found = false) named (the string form of "a T join stores its style on the branch's end only")

# Square off on the slanted T: the butt's end follows the host's face;
# squared, it stands across the branch where its interior corner reached.
set slantJoin to the join test join of slantBranch at finish false in d's current
set slantButt to the join test end of slantBranch at finish false in d's current
print ((the string form of "slanted T butt: ") + slantButt) as a line
check join style (slantButt = "(20241, 100) (19959, 100)") named (the string form of "the slanted branch's butt lies on the host's face")
give bim join slantJoin style (bim square stopped join style) in target
set slantSquare to the join test end of slantBranch at finish false in d's current
print ((the string form of "slanted T square off: ") + slantSquare) as a line
check join style (slantSquare = "(20100, -41) (19959, 100)") named (the string form of "Square off cuts it square where its interior corner reached the face")

# The styles survive the native file and IfcX.
give bim join cornerJoin style (bim butt through join style) in target
set reread to the bim model parsed from (the bim file text of d's current)
print ((the string form of ".bim read: ") + (the string form of reread's valid)) as a line
check join style (((the bim own join style of end firstLeg at finish true in reread's modelValue) = bim butt through join style) and ((the bim own join style of end secondLeg at finish false in reread's modelValue) = bim butt stopped join style)) named (the string form of "the .bim file keeps the L's styles")
check join style ((the bim own join style of end branchWall at finish false in reread's modelValue) = bim not joined style) named (the string form of "and the T's Not joined")
check join style ((the join test end of firstLeg at finish true in reread's modelValue) = throughFirst) named (the string form of "and the corners it gives")
check join style ((the join test end of slantBranch at finish false in reread's modelValue) = slantSquare) named (the string form of "and the square off")
set native to the bim native text of ifcx (the bim ifcx text of d's current identified as (the string form of "t.ifcx") for project (the string form of "t") by (the string form of "test") at (the string form of "2026-11-07T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + (the string form of fromIfcx's valid)) as a line
check join style (((the join test end of firstLeg at finish true in fromIfcx's modelValue) = throughFirst) and ((the join test end of branchWall at finish false in fromIfcx's modelValue) = teeApart)) named (the string form of "IfcX keeps them too")
