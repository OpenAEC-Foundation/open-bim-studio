# SPDX-License-Identifier: MPL-2.0
# Native roof authoring shared by property edits and automation. Coordinates
# in these advanced profile/path fields are metres, independent of UI units.
import elements/planar/bim_roof_forms.dl
import exchange/ifcx/bim_file.dl

class:
    patterns:
        [a|] bim roof point reading record
    members:
        valid as a boolean
        points as the type of (a cad topology list of a cad vector2)

function the bim roof points parsed from {a string:source}:
    execute:
        set result to @intrinsic("construct", a bim roof point reading record, true, a cad topology list of a cad vector2)
        set words to source split at " "
        set compact to words joined with ""
        free words
        if (the length of compact) = 0:
            return result
        set entries to compact split at ";"
        if ((the length of entries) < 2) or ((the length of entries) > 64):
            set result's valid to false
            free entries
            return result
        loop cursor from 0 to the length of entries:
            set pair to (the item at cursor in entries) split at ","
            if (the length of pair) != 2:
                set result's valid to false
                free pair
                free entries
                return result
            set xValue to the bim real reading of (the item at 0 in pair)
            set yValue to the bim real reading of (the item at 1 in pair)
            free pair
            if (xValue's valid and yValue's valid) = false:
                set result's valid to false
                free entries
                return result
            if ((the absolute value of xValue's value) > 100000.0) or ((the absolute value of yValue's value) > 100000.0):
                set result's valid to false
                free entries
                return result
            append (a cad vector2 with x xValue's value and y yValue's value) to (result's points's values)
        free entries
        return result

local function the bim roof coordinate text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 64 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 65 as a word sized unsigned integer, "%.6f", value)
        return the substring of buffer from 0 spanning written bytes

function the bim roof point text of {a pointer to a list:points}:
    execute:
        set entries to an empty list of a string
        loop cursor from 0 to the length of points:
            set spot to the item at cursor in points
            append (((the bim roof coordinate text of spot's x) + (the string form of ",")) + (the bim roof coordinate text of spot's y)) to entries
        set result to entries joined with "; "
        free entries
        return result

function bim roof points {a pointer to a list:first} equal {a pointer to a list:second}:
    execute:
        if (the length of first) != (the length of second):
            return false
        loop cursor from 0 to the length of first:
            set a to the item at cursor in first
            set b to the item at cursor in second
            set sameX to (the rounded value of (a's x * 1000000.0)) = (the rounded value of (b's x * 1000000.0))
            set sameY to (the rounded value of (a's y * 1000000.0)) = (the rounded value of (b's y * 1000000.0))
            if (sameX and sameY) = false:
                return false
        return true

function the bim default roof path of {bim slab record:roofValue}:
    execute:
        set result to an empty list of a cad vector2
        set lowX to 1e100
        set highX to -1e100
        set lowY to 1e100
        set highY to -1e100
        loop cursor from 0 to the length of (roofValue's outline's values):
            set spot to the item at cursor in (roofValue's outline's values)
            set lowX to the minimum of lowX and spot's x
            set highX to the maximum of highX and spot's x
            set lowY to the minimum of lowY and spot's y
            set highY to the maximum of highY and spot's y
        if (highX - lowX) >= (highY - lowY):
            append (a cad vector2 with x lowX and y ((lowY + highY) * 0.5)) to result
            append (a cad vector2 with x highX and y ((lowY + highY) * 0.5)) to result
        else:
            append (a cad vector2 with x ((lowX + highX) * 0.5) and y lowY) to result
            append (a cad vector2 with x ((lowX + highX) * 0.5) and y highY) to result
        return result

# Returns 0 refused, 1 changed, 2 unchanged. Validate everything before writes.
function set bim roof {a 64 bit integer:roofId} curve {integer:slot} to {a pointer to a list:points} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim slab index of roofId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((slot < 0) or (slot > 2)):
            return 0
        set roofValue to the item at found's position in (target's slabs's values)
        if (the bim role of plate roofValue in (@intrinsic("dereference", target))) != bim roof planar role:
            return 0
        set profilePoints to the bim roof points of roofId starting at bim roof form setting in (@intrinsic("dereference", target))
        set pathPoints to the bim roof points of roofId starting at ((bim roof form setting) + 200) in (@intrinsic("dereference", target))
        if (the length of pathPoints) = 0:
            free pathPoints
            set pathPoints to the bim default roof path of roofValue
        set valid to true
        if slot = 0:
            if (the length of points) > 0:
                set valid to bim roof profile points and path pathPoints are valid
        else if slot = 1:
            set valid to bim roof profile profilePoints and path points are valid
        else if (the length of points) > 0:
            set valid to bim roof profile points and path pathPoints are valid
        free profilePoints
        if valid = false:
            free pathPoints
            return 0
        set baseCode to (bim roof form setting) + (slot * 200)
        set currentPoints to the bim roof points of roofId starting at baseCode in (@intrinsic("dereference", target))
        set unchanged to bim roof points points equal currentPoints
        free currentPoints
        if unchanged and (roofValue's pitch = 0.0):
            free pathPoints
            return 2
        store bim roof points points of roofId starting at baseCode in target
        if slot = 0:
            store bim roof points pathPoints of roofId starting at ((bim roof form setting) + 200) in target
        free pathPoints
        set roofValue's pitch to 0.0
        replace item at index found's position in (target's slabs's values) with roofValue
        note bim change of roofId in target
        return 1

function round bim roof {a 64 bit integer:roofId} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim slab index of roofId in (@intrinsic("dereference", target))
        if found's valid = false:
            return 0
        set roofValue to the item at found's position in (target's slabs's values)
        if (the bim role of plate roofValue in (@intrinsic("dereference", target))) != bim roof planar role:
            return 0
        set pathPoints to the bim default roof path of roofValue
        set first to the item at 0 in pathPoints
        set last to the item at 1 in pathPoints
        set run to the cad distance from first to last
        if run < 0.5:
            free pathPoints
            return 0
        set nx to (0.0 - (last's y - first's y)) / run
        set ny to (last's x - first's x) / run
        set radius to 0.0
        loop cursor from 0 to the length of (roofValue's outline's values):
            set spot to the item at cursor in (roofValue's outline's values)
            set radius to the maximum of radius and (the absolute value of (((spot's x - first's x) * nx) + ((spot's y - first's y) * ny)))
        set profilePoints to an empty list of a cad vector2
        loop cursor from 0 to 33:
            set angle to ((cursor as a 64 bit floating-point number) / 32.0) * 3.141592653589793
            append (a cad vector2 with x ((0.0 - radius) * (the cosine of angle)) and y (radius * (the sine of angle))) to profilePoints
        if (bim roof profile profilePoints and path pathPoints are valid) = false:
            free pathPoints
            free profilePoints
            return 0
        set currentProfile to the bim roof points of roofId starting at bim roof form setting in (@intrinsic("dereference", target))
        set currentPath to the bim roof points of roofId starting at ((bim roof form setting) + 200) in (@intrinsic("dereference", target))
        set sameProfile to bim roof points profilePoints equal currentProfile
        set samePath to bim roof points pathPoints equal currentPath
        set noHip to (the bim setting ((bim roof form setting) + 400) of roofId in (@intrinsic("dereference", target)))'s value = (0 as a 64 bit integer)
        free currentProfile
        free currentPath
        if ((sameProfile and samePath) and noHip) and (roofValue's pitch = 0.0):
            free pathPoints
            free profilePoints
            return 2
        store bim roof points profilePoints of roofId starting at bim roof form setting in target
        store bim roof points pathPoints of roofId starting at ((bim roof form setting) + 200) in target
        set bim setting ((bim roof form setting) + 400) of roofId to (0 as a 64 bit integer) keeping false in target
        set roofValue's pitch to 0.0
        replace item at index found's position in (target's slabs's values) with roofValue
        note bim change of roofId in target
        free pathPoints
        free profilePoints
        return 1
