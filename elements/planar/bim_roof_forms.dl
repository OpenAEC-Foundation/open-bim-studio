# SPDX-License-Identifier: MPL-2.0
# A roof remains one typed plate. Its cross-section (offset,height) and plan
# path are persistent, micrometre-quantised host settings. Two path points
# describe an extrusion; more points describe a sweep. Height is single-valued
# over plan: overhanging/re-entrant sections are deliberately refused.
import bim/bim_model.dl
import kernel/fast/prism.dl
import elements/planar/bim_roof_grid.dl

function bim roof form setting:
    replacement:
        2400000

function the bim roof points of {a 64 bit integer:plateId} starting at {integer:baseCode} in {bim model record:modelValue}:
    execute:
        set result to an empty list of a cad vector2
        set countValue to ((the bim setting baseCode of plateId in modelValue)'s value) as an integer
        if (countValue < 2) or (countValue > 64):
            return result
        loop cursor from 0 to countValue:
            set xValue to ((the bim setting (baseCode + 1 + (cursor * 2)) of plateId in modelValue)'s value) as a 64 bit floating-point number
            set yValue to ((the bim setting (baseCode + 2 + (cursor * 2)) of plateId in modelValue)'s value) as a 64 bit floating-point number
            append (a cad vector2 with x (xValue / 1000000.0) and y (yValue / 1000000.0)) to result
        return result

function store bim roof points {a pointer to a list:points} of {a 64 bit integer:plateId} starting at {integer:baseCode} in {a pointer to a bim model record:target}:
    execute:
        set bim setting baseCode of plateId to ((the length of points) as a 64 bit integer) keeping true in target
        loop cursor from 0 to the length of points:
            set spot to the item at cursor in points
            set bim setting (baseCode + 1 + (cursor * 2)) of plateId to ((the rounded value of (spot's x * 1000000.0)) as a 64 bit integer) keeping true in target
            set bim setting (baseCode + 2 + (cursor * 2)) of plateId to ((the rounded value of (spot's y * 1000000.0)) as a 64 bit integer) keeping true in target

function bim roof profile {a pointer to a list:profilePoints} and path {a pointer to a list:pathPoints} are valid:
    execute:
        if ((the length of profilePoints) < 2) or ((the length of profilePoints) > 64):
            return false
        if ((the length of pathPoints) < 2) or ((the length of pathPoints) > 64):
            return false
        loop cursor from 1 to the length of profilePoints:
            set before to the item at (cursor - 1) in profilePoints
            set after to the item at cursor in profilePoints
            if (after's x - before's x) < 0.001:
                return false
        loop cursor from 1 to the length of pathPoints:
            if (the cad distance from (the item at (cursor - 1) in pathPoints) to (the item at cursor in pathPoints)) < 0.001:
                return false
        return true

function the bim roof normal at {integer:stationIndex} along {a pointer to a list:pathPoints}:
    execute:
        set beforeIndex to the maximum of 0 and (stationIndex - 1)
        set afterIndex to the minimum of ((the length of pathPoints) - 1) and (stationIndex + 1)
        set before to the item at beforeIndex in pathPoints
        set after to the item at afterIndex in pathPoints
        set dx to after's x - before's x
        set dy to after's y - before's y
        set run to the square root of ((dx * dx) + (dy * dy))
        if run <= 1e-9:
            return a cad vector2 with x 0.0 and y 0.0
        return a cad vector2 with x ((0.0 - dy) / run) and y (dx / run)

function the bim roof footprint of {a pointer to a list:profilePoints} along {a pointer to a list:pathPoints}:
    execute:
        set result to an empty list of a cad vector2
        if (bim roof profile profilePoints and path pathPoints are valid) = false:
            return result
        set low to (the item at 0 in profilePoints)'s x
        set high to (the item at ((the length of profilePoints) - 1) in profilePoints)'s x
        loop cursor from 0 to the length of pathPoints:
            set pointValue to the item at cursor in pathPoints
            set normal to the bim roof normal at cursor along pathPoints
            append (a cad vector2 with x (pointValue's x + (normal's x * low)) and y (pointValue's y + (normal's y * low))) to result
        loop cursor from 0 to the length of pathPoints:
            set stationIndex to ((the length of pathPoints) - 1) - cursor
            set pointValue to the item at stationIndex in pathPoints
            set normal to the bim roof normal at stationIndex along pathPoints
            append (a cad vector2 with x (pointValue's x + (normal's x * high)) and y (pointValue's y + (normal's y * high))) to result
        return result

function add bim roof typed {a 64 bit integer:typeId} on {a 64 bit integer:levelId} with section {a pointer to a list:profilePoints} along {a pointer to a list:pathPoints} at {a 64 bit floating-point number:baseHeight} in {a pointer to a bim model record:target}:
    execute:
        set typeFound to the bim wall type index of typeId in (@intrinsic("dereference", target))
        if typeFound's valid = false:
            return the bim refused id
        if (the item at typeFound's position in (target's wallTypes's values))'s role != bim roof planar role:
            return the bim refused id
        set outlinePoints to the bim roof footprint of profilePoints along pathPoints
        if (the length of outlinePoints) < 4:
            free outlinePoints
            return the bim refused id
        set fresh to add bim plate typed typeId on levelId around outlinePoints at top baseHeight to target
        free outlinePoints
        if fresh != the bim refused id:
            store bim roof points profilePoints of fresh starting at bim roof form setting in target
            store bim roof points pathPoints of fresh starting at ((bim roof form setting) + 200) in target
            note bim change of fresh in target
        return fresh

# Nearest path station gives the signed cross-section coordinate. This
# supports straight extrusions and sampled, gently curved plan paths.
function the bim roof rise at {cad vector2:location} using {a pointer to a list:profilePoints} along {a pointer to a list:pathPoints}:
    execute:
        set nearestGap to 1.0e30
        set across to 0.0
        loop cursor from 1 to the length of pathPoints:
            set first to the item at (cursor - 1) in pathPoints
            set last to the item at cursor in pathPoints
            set dx to last's x - first's x
            set dy to last's y - first's y
            set squared to (dx * dx) + (dy * dy)
            if squared > 1e-12:
                set alongValue to (((location's x - first's x) * dx) + ((location's y - first's y) * dy)) / squared
                set alongValue to the maximum of 0.0 and (the minimum of 1.0 and alongValue)
                set foot to a cad vector2 with x (first's x + (alongValue * dx)) and y (first's y + (alongValue * dy))
                set gap to the cad distance from location to foot
                if gap < nearestGap:
                    set nearestGap to gap
                    set across to (((location's y - foot's y) * dx) - ((location's x - foot's x) * dy)) / (the square root of squared)
        set before to the item at 0 in profilePoints
        if across <= before's x:
            return before's y
        loop cursor from 1 to the length of profilePoints:
            set after to the item at cursor in profilePoints
            if across <= after's x:
                set fraction to (across - before's x) / (after's x - before's x)
                return before's y + (fraction * (after's y - before's y))
            set before to after
        return before's y

function the bim roof warped point {cad vector3:spot} using {a pointer to a list:profilePoints} along {a pointer to a list:pathPoints}:
    execute:
        set riseValue to the bim roof rise at (a cad vector2 with x spot's x and y spot's y) using profilePoints along pathPoints
        return a cad vector3 with x spot's x, y spot's y and z (spot's z + riseValue)

# An optional longitudinal profile caps the cross-section, for a rounded hip.
function the bim roof end height at {cad vector2:location} along {a pointer to a list:pathPoints} limited by {a pointer to a list:endProfile}:
    execute:
        if (the length of endProfile) < 2:
            return 1e30
        set nearestGap to 1e30
        set reached to 0.0
        set station to 0.0
        loop cursor from 1 to the length of pathPoints:
            set first to the item at (cursor - 1) in pathPoints
            set last to the item at cursor in pathPoints
            set dx to last's x - first's x
            set dy to last's y - first's y
            set squared to (dx * dx) + (dy * dy)
            if squared > 1e-12:
                set run to the square root of squared
                set fraction to (((location's x - first's x) * dx) + ((location's y - first's y) * dy)) / squared
                set fraction to the maximum of 0.0 and (the minimum of 1.0 and fraction)
                set foot to a cad vector2 with x (first's x + (fraction * dx)) and y (first's y + (fraction * dy))
                set gap to the cad distance from location to foot
                if gap < nearestGap:
                    set nearestGap to gap
                    set station to reached + (fraction * run)
                set reached to reached + run
        set before to the item at 0 in endProfile
        if station <= before's x:
            return before's y
        loop cursor from 1 to the length of endProfile:
            set after to the item at cursor in endProfile
            if station <= after's x:
                set fraction to (station - before's x) / (after's x - before's x)
                return before's y + (fraction * (after's y - before's y))
            set before to after
        return before's y

function append bim roof triangle from {cad vector3:first} via {cad vector3:second} to {cad vector3:third} using {a pointer to a list:profilePoints} along {a pointer to a list:pathPoints} limited by {a pointer to a list:endProfile} into {a pointer to a fast polyhedron record:target}:
    execute:
        set a to the bim roof warped point first using profilePoints along pathPoints
        set b to the bim roof warped point second using profilePoints along pathPoints
        set c to the bim roof warped point third using profilePoints along pathPoints
        set a's z to first's z + (the minimum of (a's z - first's z) and (the bim roof end height at (a cad vector2 with x first's x and y first's y) along pathPoints limited by endProfile))
        set b's z to second's z + (the minimum of (b's z - second's z) and (the bim roof end height at (a cad vector2 with x second's x and y second's y) along pathPoints limited by endProfile))
        set c's z to third's z + (the minimum of (c's z - third's z) and (the bim roof end height at (a cad vector2 with x third's x and y third's y) along pathPoints limited by endProfile))
        set normal to the cad cross of (the cad difference of b and a) and (the cad difference of c and a)
        set ring to an empty list of an integer
        append (add fast position a to target) to ring
        append (add fast position b to target) to ring
        append (add fast position c to target) to ring
        set holes to an empty list of the type of (an empty list of an integer)
        add fast face ring with holes holes facing normal to target
        free holes
        free ring

# Uniform barycentric subdivision shares the same edge samples on every
# adjacent face. XY never changes: openings stay vertical through all layers.
function the bim roof shaped {fast polyhedron record:shape} using {a pointer to a list:profilePoints} along {a pointer to a list:pathPoints} limited by {a pointer to a list:endProfile}:
    execute:
        set result to an empty fast polyhedron
        set meshValue to an empty fast mesh
        append fast mesh of shape to (the address of meshValue)
        set divisions to 16
        set stepValue to 1.0 / (divisions as a 64 bit floating-point number)
        set triangleIndex to 0
        loop while (triangleIndex + 2) < (the length of (meshValue's triangles's values)):
            set first to the item at (the item at triangleIndex in (meshValue's triangles's values)) in (meshValue's positions's values)
            set second to the item at (the item at (triangleIndex + 1) in (meshValue's triangles's values)) in (meshValue's positions's values)
            set third to the item at (the item at (triangleIndex + 2) in (meshValue's triangles's values)) in (meshValue's positions's values)
            set u to (the cad difference of second and first) scaled by stepValue
            set v to (the cad difference of third and first) scaled by stepValue
            loop row from 0 to divisions:
                loop column from 0 to (divisions - row):
                    set a to the cad sum of first and (the cad sum of (u scaled by row) and (v scaled by column))
                    set b to the cad sum of a and u
                    set c to the cad sum of a and v
                    append bim roof triangle from a via b to c using profilePoints along pathPoints limited by endProfile into (the address of result)
                    if (row + column) < (divisions - 1):
                        set d to the cad sum of b and v
                        append bim roof triangle from b via d to c using profilePoints along pathPoints limited by endProfile into (the address of result)
            set triangleIndex to triangleIndex + 3
        return result

function the bim curved roof form of {fast polyhedron record:shape} for {bim slab record:plateValue} in {bim model record:modelValue}:
    execute:
        set profilePoints to the bim roof points of plateValue's id starting at bim roof form setting in modelValue
        set pathPoints to the bim roof points of plateValue's id starting at ((bim roof form setting) + 200) in modelValue
        if (bim roof profile profilePoints and path pathPoints are valid) = false:
            free profilePoints
            free pathPoints
            return shape
        set endProfile to the bim roof points of plateValue's id starting at ((bim roof form setting) + 400) in modelValue
        if (the length of endProfile) >= 2:
            if (bim roof profile endProfile and path pathPoints are valid) = false:
                free profilePoints
                free pathPoints
                free endProfile
                return shape
        set result to an empty fast polyhedron
        if plateValue's pitch = 0.0:
            set levelFound to the bim level index of plateValue's levelId in modelValue
            if levelFound's valid:
                set baseHeight to (the item at levelFound's position in (modelValue's levels's values))'s elevation + plateValue's top
                set result to the bim roof grid of shape using profilePoints along pathPoints limited by endProfile above baseHeight
        if (the length of (result's faces's values)) = 0:
            set result to the bim roof shaped shape using profilePoints along pathPoints limited by endProfile
        free profilePoints
        free pathPoints
        free endProfile
        return result
