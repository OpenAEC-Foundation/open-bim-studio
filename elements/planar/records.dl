# SPDX-License-Identifier: MPL-2.0
# The planar module's records: wall types, walls and slabs.
# They were in bim/bim_model.dl until the module split's phase C2.
import bim/bim_model.dl

class:
    patterns:
        [a|] bim wall type record
    members:
        id as a 64 bit integer
        name as a string
        layers as the type of (a cad topology list of a bim layer record)
        # The planar type's role (`bim wall planar role` and the others):
        # what its elements are, and so their IFC class.
        role as an integer

# A wall runs along its centreline from `start` to `finish` on its level; the
# exterior side is on the right when walking from start to finish. A curved
# wall's centreline is a circular arc: `bulge` is the signed distance from the
# chord's middle to the arc's middle, positive toward the exterior side. A
# straight wall has bulge 0; the arc is at most a half circle.
class:
    patterns:
        [a|] bim wall record
    members:
        id as a 64 bit integer
        typeId as a 64 bit integer
        levelId as a 64 bit integer
        start as a cad vector2
        finish as a cad vector2
        height as a 64 bit floating-point number
        bulge as a 64 bit floating-point number
        # The wall's shape over its height: its top shifted `lean` metres
        # along the exterior normal (a wall leaning out or in), and its middle
        # height bowed `rise` metres out (a wall round in section); both 0
        # for an upright wall.
        lean as a 64 bit floating-point number
        rise as a 64 bit floating-point number
        # The wall's foot above its level's elevation (below when negative);
        # `height` is measured from the foot.
        baseOffset as a 64 bit floating-point number
        # The level the wall's top is held at (its height follows when either
        # level moves), or the refused id for a free height.
        topLevelId as a 64 bit integer

# A slab on a level: its outline in plan, with its top at the level's
# elevation and its underside `thickness` lower. The outline is never changed
# after the slab is made.
class:
    patterns:
        [a|] bim slab record
    members:
        id as a 64 bit integer
        levelId as a 64 bit integer
        outline as the type of (a cad topology list of a cad vector2)
        thickness as a 64 bit floating-point number
        # What it is made of, as a wall layer's material (`bim_hatch.dl`).
        material as a string
        # A plate (floor, roof or ceiling) of planar type `typeId`, its top
        # `top` metres above its storey at the outline's first corner,
        # rising `pitch` radians toward the plan direction `heading`
        # (radians). Without a type it is the floor of `thickness` and
        # `material` above.
        typeId as a 64 bit integer
        top as a 64 bit floating-point number
        pitch as a 64 bit floating-point number
        heading as a 64 bit floating-point number
