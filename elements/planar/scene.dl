# SPDX-License-Identifier: MPL-2.0
# The planar module's part of the scene: the masonry module lines of walls whose module is measured. Called by the
# composed dispatcher (`append bim module scene meshes of`) in layer order;
# the order does not matter, kept meshes are found by element id and part.
import viewer/bim_scene.dl

function append bim scene meshes of {bim model record:modelValue} within {a 64 bit floating-point number:tolerance} reusing {a pointer to a list:previous} keyed {a pointer to a list:keys} refreshing {a pointer to a list:remadeIds} with reinforcement detail {boolean:rebarDetail} into {a pointer to a list:result} with planar elements:
    execute:
        # Masonry module lines, one line mesh for each wall whose module is
        # measured (`the bim masonry line shape of`), under the wall's id.
        set masonryWalls to an empty list of an integer
        loop cursor from 0 to the length of (modelValue's walls's values):
            if (the bim setting (bim masonry module setting) of ((the item at cursor in (modelValue's walls's values))'s id) in modelValue)'s found:
                append cursor to masonryWalls
        if (the length of masonryWalls) > 0:
            set masonryIndex to the bim join index of modelValue
            loop cursor from 0 to the length of masonryWalls:
                set masonryWallValue to the item at (the item at cursor in masonryWalls) in (modelValue's walls's values)
                set masonryValue to the bim masonry of wall masonryWallValue in modelValue using masonryIndex
                if masonryValue's status = (bim masonry measured):
                    set masonrySlot to the bim kept slot of masonryWallValue's id part (bim masonry line part) among keys unless remadeIds
                    if masonrySlot >= 0:
                        append (the item at masonrySlot in previous) to result
                    else:
                        append (@intrinsic("construct", a bim scene mesh record, masonryWallValue's id, 0 as a 64 bit integer, bim masonry line part, the bim masonry line shape of masonryValue on masonryWallValue in modelValue, bim other category, the bim material colour of (the string form of "brick"), the string form of "")) to result
        free masonryWalls
