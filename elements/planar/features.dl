# SPDX-License-Identifier: MPL-2.0
# The planar module's answer to the drawings' `feature` extension point: a
# dimension reference to a wall, to a wall's masonry or to an opening in a
# wall resolves here to an anchor in plan. A wall side is the line of that
# side of its footprint, a wall end is the middle of that end of its
# footprint, an opening edge is a point on its host's centreline, and a
# wall's masonry references are points on its masonry layer's face, as
# `the bim masonry of wall` finds them; none while it is unsupported. A wall
# end's anchor points along the wall's tangent there, a side's along its
# chord. The
# composer calls this through `resolve bim module feature of …`
# (generated/compose.dl); the drawings module never imports this file.
import elements/planar/bim_evaluate.dl
import elements/planar/bim_masonry.dl
import views/drawings/records.dl

local function the bim planar midpoint of {cad vector2:first} and {cad vector2:second}:
    execute:
        return a cad vector2 with x ((first's x + second's x) * 0.5) and y ((first's y + second's y) * 0.5)

# Writes a valid anchor: a point, or a line through `origin` along `direction`.
local function write bim anchor line {boolean:isLine} at {cad vector2:origin} along {cad vector2:direction} into {a pointer to a bim anchor record:slot}:
    execute:
        set slot's valid to true
        set slot's isLine to isLine
        set slot's origin to origin
        set slot's direction to direction

# True when the reference's kind is this module's (wall, masonry or opening
# side), whether or not the anchor could be resolved; false for every other
# kind, which another module or the drawings module answers.
function resolve bim feature of {bim reference record:target} in {bim model record:modelValue} using {bim join index record:index} into {a pointer to a bim anchor record:anchor} with planar elements:
    execute:
        set featureKind to target's feature
        set anchor's valid to false
        set nearEnd to featureKind = (bim masonry near end feature)
        set farEnd to featureKind = (bim masonry far end feature)
        if (nearEnd or farEnd) or (featureKind >= (bim masonry line feature)):
            set masonryWall to the bim wall index of (target's elementId) in modelValue
            if masonryWall's valid = false:
                return true
            set masonryValue to the bim masonry of wall (the item at masonryWall's position in (modelValue's walls's values)) in modelValue using index
            if masonryValue's status != (bim masonry measured):
                return true
            set reach to 0.0 - masonryValue's lead
            if farEnd:
                set reach to masonryValue's span
            if featureKind >= (bim masonry line feature):
                set lineNumber to featureKind - (bim masonry line feature)
                if lineNumber > masonryValue's whole:
                    return true
                set reach to (lineNumber as a 64 bit floating-point number) * masonryValue's module
            set masonrySpot to a cad vector2 with x (masonryValue's origin's x + (masonryValue's onward's x * reach)) and y (masonryValue's origin's y + (masonryValue's onward's y * reach))
            write bim anchor line false at masonrySpot along masonryValue's onward into anchor
            return true
        if featureKind <= bim wall interior feature:
            set found to the bim wall index of target's elementId in modelValue
            if found's valid = false:
                return true
            set wallValue to the item at found's position in (modelValue's walls's values)
            set footprint to the bim footprint of wallValue in modelValue using index
            set direction to the bim direction of wallValue
            if featureKind = bim wall start feature:
                write bim anchor line false at (the bim planar midpoint of footprint's startExterior and footprint's startInterior) along (the bim tangent of wallValue at finish false) into anchor
                return true
            if featureKind = bim wall finish feature:
                write bim anchor line false at (the bim planar midpoint of footprint's finishExterior and footprint's finishInterior) along (the bim tangent of wallValue at finish true) into anchor
                return true
            if featureKind = bim wall exterior feature:
                write bim anchor line true at footprint's startExterior along direction into anchor
                return true
            write bim anchor line true at footprint's startInterior along direction into anchor
            return true
        if (featureKind = bim opening left feature) or (featureKind = bim opening right feature):
            set openingFound to the bim opening index of target's elementId in modelValue
            if openingFound's valid = false:
                return true
            set openingValue to the item at openingFound's position in (modelValue's openings's values)
            set hostFound to the bim wall index of openingValue's hostId in modelValue
            set typeFound to the bim opening type index of openingValue's typeId in modelValue
            if (hostFound's valid = false) or (typeFound's valid = false):
                return true
            set host to the item at hostFound's position in (modelValue's walls's values)
            set halfWidth to (the bim rough width of (the item at typeFound's position in (modelValue's openingTypes's values))) * 0.5
            set span to the bim span of host at openingValue's offset reaching halfWidth
            set location to span's left
            if featureKind = bim opening right feature:
                set location to span's right
            write bim anchor line false at location along span's direction into anchor
            return true
        return false
