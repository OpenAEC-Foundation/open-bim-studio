# SPDX-License-Identifier: MPL-2.0
# Pile tip levels (issue #138): the Structural tab with its Piles sub-tab;
# the tip level tool (2240) places a tip level where it is clicked, at the
# level typed before (in the project's length unit, metres here), and Enter
# with a level typed moves the last one placed; piles take their toe from
# the nearest tip level or the one assigned to them, and follow when a tip
# level is moved, changed or removed. Heights are datum heights (NAP): the
# project's map position lifts the datum. The tip levels and the
# assignments survive the .bim file and IfcX; IFC writes an IfcAnnotation.
import ui/panels/bim_ui.dl
import ui/panels/bim_plan_panel.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl

function check pile tips {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function type pile tip text {a string:typed} in {a pointer to a bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of typed:
            type bim editor key ((the character at cursor in typed) as an integer) in editor

function click pile tips at {a 64 bit floating-point number:across} and {a 64 bit floating-point number:down} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x across and y down) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

# Every pile's toe as a datum height, and the tip level governing it.
function list pile toes of {bim model record:modelValue} labelled {a string:label}:
    execute:
        set shown to label + (the string form of ":")
        loop cursor from 0 to the length of (modelValue's linears's values):
            set linearValue to the item at cursor in (modelValue's linears's values)
            if bim linear linearValue is a pile in modelValue:
                set tipId to the bim pile tip level of pile linearValue in modelValue
                set tipName to the string form of "none"
                if tipId != the bim refused id:
                    set tipName to (the item at (the bim pile tip level index of tipId in modelValue)'s position in (modelValue's pileTipLevels's values))'s name
                set shown to ((shown + (the string form of " ")) + (the bim signed level text of (the bim toe datum height of pile linearValue in modelValue))) + (((the string form of " (") + tipName) + (the string form of ")"))
        print shown as a line

function list pile tip levels of {bim model record:modelValue} labelled {a string:label}:
    execute:
        loop cursor from 0 to the length of (modelValue's pileTipLevels's values):
            set tipLevel to the item at cursor in (modelValue's pileTipLevels's values)
            set shown to (label + (the string form of ": ")) + (the bim marker text of pile tip level tipLevel in modelValue)
            set shown to (shown + (the string form of " at ")) + (the string form of tipLevel's location's x)
            set shown to (shown + (the string form of ", ")) + (the string form of tipLevel's location's y)
            set shown to (shown + (the string form of " from '")) + (tipLevel's source + (the string form of "'"))
            print shown as a line

# The ribbon: Structural after Connections, its sub-tabs and groups.
set tabNames to the bim ribbon tab names
check pile tips ((the item at 9 in tabNames) = (the string form of "Structural")) named (the string form of "Structural is the tenth tab")
free tabNames
set subNames to the bim ribbon subtab names of tab 9
set subShown to the string form of "sub-tabs:"
loop subCursor from 0 to the length of subNames:
    set subShown to (subShown + (the string form of " ")) + (the item at subCursor in subNames)
print subShown as a line
free subNames
set structuralGroups to the bim ribbon groups of tab 9
loop groupCursor from 0 to the length of structuralGroups:
    set ribbonGroup to the item at groupCursor in structuralGroups
    set shown to ((ribbonGroup's title + (the string form of " (sub-tab ")) + (the string form of (the bim subtab of group ribbonGroup's title in tab 9))) + (the string form of "):")
    loop buttonCursor from 0 to the length of (ribbonGroup's buttons):
        set shown to (shown + (the string form of " ")) + (the item at buttonCursor in (ribbonGroup's buttons))'s label
    print shown as a line
set tipButton to the item at 1 in ((the item at 0 in structuralGroups)'s buttons)
check pile tips (tipButton's command = 2240) named (the string form of "Pile tip level sends 2240")
free structuralGroups

# Two piles, 12 m long, before there is any tip level.
set editor to a new bim editor
set e to the address of editor
type bim editor key 2077 in e
click pile tips at 0.0 and 0.0 in e
click pile tips at 10.0 and 0.0 in e
list pile toes of editor's documentValue's current labelled (the string form of "placed")

# The tool: a level typed (metres), then a click.
type bim editor key 2240 in e
print editor's message as a line
check pile tips (editor's tool = bim pile tip level tool) named (the string form of "2240 starts the tip level tool")
type pile tip text (the string form of "-14.5") in e
click pile tips at 1.0 and 0.0 in e
print editor's message as a line
list pile toes of editor's documentValue's current labelled (the string form of "one tip level")
type pile tip text (the string form of "-18") in e
type bim editor key (bim enter key code) in e
print editor's message as a line
list pile toes of editor's documentValue's current labelled (the string form of "changed by Enter")
type pile tip text (the string form of "-16") in e
click pile tips at 10.0 and 0.0 in e
list pile toes of editor's documentValue's current labelled (the string form of "a second, nearer the right pile")
# While the tool is on, the plan shows the tip levels' marks.
set planCanvas to a new bim canvas
draw bim annotations in plan of editor through (@intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 100.0 and y 100.0), (a cad vector2 with x 0.0 and y 0.0), 40.0)) on (the address of planCanvas)
set marksShown to (the string form of "plan marks: ") + (the string form of (the length of (planCanvas's texts's values)))
set marksShown to (marksShown + (the string form of " texts, ")) + (the string form of (the length of (planCanvas's batches's values)))
set marksShown to (marksShown + (the string form of " batches; ")) + (the item at 0 in (planCanvas's texts's values))'s message
print marksShown as a line
type bim editor key (bim escape key code) in e
check pile tips (editor's tool = bim select tool) named (the string form of "Escape leaves the tool")

# A new pile takes its toe from the nearest tip level at once.
type bim editor key 2077 in e
click pile tips at 11.0 and 0.0 in e
list pile toes of editor's documentValue's current labelled (the string form of "a third pile")

# Through the model: moving, assigning, naming, the datum, removing.
set target to the address of (editor's documentValue's current)
set firstTip to (the item at 0 in (target's pileTipLevels's values))'s id
set secondTip to (the item at 1 in (target's pileTipLevels's values))'s id
check pile tips (move bim pile tip level secondTip to (a cad vector2 with x -3.0 and y 0.0) in target) named (the string form of "the second tip level moves")
list pile toes of editor's documentValue's current labelled (the string form of "second moved away")
set rightPile to (the item at 1 in (target's linears's values))'s id
check pile tips (assign bim pile rightPile to tip level secondTip in target) named (the string form of "the right pile is assigned the second")
list pile toes of editor's documentValue's current labelled (the string form of "assigned")
check pile tips ((assign bim pile secondTip to tip level firstTip in target) = false) named (the string form of "only a pile is assigned")
check pile tips (name bim pile tip level secondTip as (the string form of "PPN zone B") from (the string form of "CPT 12, advice 2026-10") in target) named (the string form of "the second is named")
set bim project setting (bim project crs setting) to (28992 as a 64 bit integer) unless (0 as a 64 bit integer) in target
set bim project setting (bim project height setting) to (2000 as a 64 bit integer) unless (0 as a 64 bit integer) in target
print ((the string form of "piles moved for the datum: ") + (the string form of (apply bim pile tip levels in target))) as a line
list pile toes of editor's documentValue's current labelled (the string form of "datum NAP +2.00 at the origin")
set rightValue to the item at 1 in (target's linears's values)
print ((the string form of "right pile from z ") + ((the string form of rightValue's start's z) + ((the string form of " to z ") + (the string form of rightValue's finish's z)))) as a line
list pile tip levels of editor's documentValue's current labelled (the string form of "model")

# The .bim file and IfcX keep the tip levels and the assignment.
set modelValue to editor's documentValue's current
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + (the string form of reread's valid)) as a line
list pile tip levels of reread's modelValue labelled (the string form of "from .bim")
list pile toes of reread's modelValue labelled (the string form of "from .bim")
set exported to the bim ifcx text of modelValue identified as (the string form of "p.ifcx") for project (the string form of "p") by (the string form of "test") at (the string form of "2026-10-31T00:00:00Z")
set native to the bim native text of ifcx exported
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + (the string form of fromIfcx's valid)) as a line
list pile tip levels of fromIfcx's modelValue labelled (the string form of "from .ifcx")
list pile toes of fromIfcx's modelValue labelled (the string form of "from .ifcx")

# IFC: an IfcAnnotation per tip level with its OBS_PileTipLevel set.
set ifcText to the bim ifc text of modelValue
check pile tips ((the index of (the string form of "IFCANNOTATION(") in ifcText) >= 0) named (the string form of "IFC holds an IfcAnnotation")
check pile tips ((the index of (the string form of "'OBS_PileTipLevel'") in ifcText) >= 0) named (the string form of "with its OBS_PileTipLevel set")
check pile tips ((the index of (the string form of "IFCLABEL('CPT 12, advice 2026-10')") in ifcText) >= 0) named (the string form of "naming its source")

# Removing the first: its piles follow the one left; the assignment to the
# removed one would go with it.
check pile tips (remove bim pile tip level firstTip from target) named (the string form of "the first is removed")
list pile toes of editor's documentValue's current labelled (the string form of "first removed")
check pile tips (remove bim pile tip level secondTip from target) named (the string form of "the second is removed")
list pile toes of editor's documentValue's current labelled (the string form of "none left: lengths kept")
check pile tips (((the bim setting (bim pile tip level setting) of rightPile in editor's documentValue's current)'s found) = false) named (the string form of "the assignment went with it")
