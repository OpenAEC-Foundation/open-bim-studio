# SPDX-License-Identifier: MPL-2.0
# Shaped members read from IFC fitted to the profile catalogue
# (bim_ifc_profiles.dl): a column whose section's box is 220 by 220 mm and
# whose area is an I shape's becomes an HEB 220, a beam 80 by 80 mm of a
# hollow section's area an SHS 80x80x4, an I shape whose web lies along its
# width is turned a quarter, and a section no profile has stays as it was,
# as does a box of an I shape's size and area (no web: no I shape).
import elements/linear/bim_ifc_profiles.dl
import ui/editor/bim_editor.dl

set nativeSet to no bim ifc natives
append (the string form of "Begane grond") to (nativeSet's storeyNames's values)
append 0.0 to (nativeSet's storeyElevations's values)
append 1 to (nativeSet's storeySources's values)
set foot to a cad vector3 with x 1.0, y 2.0 and z 0.0
set head to a cad vector3 with x 1.0, y 2.0 and z 3.0
set far to a cad vector3 with x 5.0, y 2.0 and z 3.0
set noKey to 0 as a 64 bit integer
append (@intrinsic("construct", a bim ifc native linear record, 0, foot, head, 0.22, 0.22, false, the string form of "steel", bim column role, 0.0, 0.0085, true, false, noKey)) to (nativeSet's shaped's values)
append 10 to (nativeSet's shapedSources's values)
append (@intrinsic("construct", a bim ifc native linear record, 0, head, far, 0.08, 0.08, false, the string form of "steel", bim beam role, 0.0, 0.00122, false, true, noKey)) to (nativeSet's shaped's values)
append 11 to (nativeSet's shapedSources's values)
append (@intrinsic("construct", a bim ifc native linear record, 0, foot, head, 0.171, 0.18, false, the string form of "steel", bim column role, 0.0, 0.00433, true, true, noKey)) to (nativeSet's shaped's values)
append 12 to (nativeSet's shapedSources's values)
append (@intrinsic("construct", a bim ifc native linear record, 0, head, far, 0.0947, 0.1519, false, the string form of "steel", bim beam role, 0.0, 0.00077, true, false, noKey)) to (nativeSet's shaped's values)
append 13 to (nativeSet's shapedSources's values)
append (@intrinsic("construct", a bim ifc native linear record, 0, foot, head, 0.22, 0.22, false, the string form of "steel", bim column role, 0.0, 0.0081, false, false, noKey)) to (nativeSet's shaped's values)
append 14 to (nativeSet's shapedSources's values)
print ((the string form of "fitted ") + (the string form of (fit bim catalogue profiles to (the address of nativeSet)))) as a line
print ((the string form of "left out of the import: ") + (the string form of (the length of (nativeSet's skipped's values)))) as a line
set documentValue to a new bim document
set counts to the bim ifc landing of nativeSet in (the address of documentValue)
print ((the string form of "members made: ") + (the string form of counts's linears)) as a line
set modelValue to documentValue's current
loop cursor from 0 to the length of (modelValue's linears's values):
    set linearValue to the item at cursor in (modelValue's linears's values)
    set linearType to the item at (the bim linear type index of linearValue's typeId in modelValue)'s position in (modelValue's linearTypes's values)
    print ((((the bim name of linear role linearType's role) + (the string form of " ")) + linearType's name) + ((the string form of " turned ") + (the bim metres text of linearValue's angle))) as a line
