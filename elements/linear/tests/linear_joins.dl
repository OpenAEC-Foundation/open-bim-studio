# SPDX-License-Identifier: MPL-2.0
# One join for every linear element. Two beams meeting at a corner mitre;
# a beam ending at a column's head butts against the column's side; a beam
# ending on another beam's body butts against its side (a tee); in line,
# two beams need no cut. A column meeting a beam's end runs up to the beam's
# top. Each end's joint can be chosen instead: mitre, butt, through or
# open. A building system's transoms butt against its mullions, which run
# through: the outer two reach the top and bottom transoms' outer faces, so
# the frame's corners close. Each cut solid stays closed and its volume
# shows the cut.
import editor/bim_editor.dl
import formats/bim_ifcx.dl

function the join test text of {a 64 bit floating-point number:value}:
    execute:
        set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, value * 10000.0)
        return the string form of (scaled / 10000.0)

function show join test {a 64 bit integer:linearId} of {bim model record:modelValue} labelled {a string:label}:
    execute:
        set linearParts to the bim linear parts of modelValue
        set linearCuts to the bim end cuts of parts (linearParts's values) in modelValue
        set found to the bim linear index of linearId in modelValue
        set linearValue to the item at found's position in (modelValue's linears's values)
        set endCut to the item at found's position in (linearCuts's values)
        set shape to the bim linear shape of linearValue typed (the bim type of linear linearValue in modelValue) in modelValue within 0.0 cut by endCut
        set line to (label + (the string form of ": start cut ")) + ((the string form of endCut's startCut) + ((the string form of ", finish cut ") + (the string form of endCut's finishCut)))
        set line to (line + (the string form of ", flaw ")) + (the string form of (the fast mesh flaw of shape))
        set line to (line + (the string form of ", volume ")) + (the join test text of (the bim volume of mesh shape))
        print line as a line

set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
set columnType to add bim linear type named (the string form of "Kolom 300") as role bim column role sized 0.3 by 0.3 round false of (the string form of "concrete") to target
set beamType to add bim linear type named (the string form of "Balk 200x400") as role bim beam role sized 0.2 by 0.4 round false of (the string form of "steel") to target
# A corner: 4 m along x, then 3 m along y, mitred: each keeps its centreline
# length, the mitre adding and taking the same.
set alongX to add bim linear typed beamType on storey from (a cad vector3 with x 0.0, y 0.0 and z 2.8) to (a cad vector3 with x 4.0, y 0.0 and z 2.8) turned 0.0 to target
set alongY to add bim linear typed beamType on storey from (a cad vector3 with x 4.0, y 0.0 and z 2.8) to (a cad vector3 with x 4.0, y 3.0 and z 2.8) turned 0.0 to target
show join test alongX of modelValue labelled (the string form of "corner beam x (0.32 m3)")
show join test alongY of modelValue labelled (the string form of "corner beam y (0.24 m3)")
# A column whose head the first beam's start meets: the beam butts against
# its side, 0.15 m in, losing 0.012 m3; the column runs through to the
# beam's top (3 m, 0.27 m3).
set column to add bim linear typed columnType on storey from (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (a cad vector3 with x 0.0, y 0.0 and z 2.8) turned 0.0 to target
show join test alongX of modelValue labelled (the string form of "beam on column (0.308 m3)")
show join test column of modelValue labelled (the string form of "column (0.27 m3)")
# A tee: a beam ending on the middle of the x beam butts against its side.
set tee to add bim linear typed beamType on storey from (a cad vector3 with x 2.0, y -3.0 and z 2.8) to (a cad vector3 with x 2.0, y 0.0 and z 2.8) turned 0.0 to target
show join test tee of modelValue labelled (the string form of "tee beam (0.232 m3)")
# In line: two beams end to end along x need no cut.
set lineA to add bim linear typed beamType on storey from (a cad vector3 with x 10.0, y 0.0 and z 2.8) to (a cad vector3 with x 12.0, y 0.0 and z 2.8) turned 0.0 to target
set lineB to add bim linear typed beamType on storey from (a cad vector3 with x 12.0, y 0.0 and z 2.8) to (a cad vector3 with x 14.0, y 0.0 and z 2.8) turned 0.0 to target
show join test lineA of modelValue labelled (the string form of "in line (0.16 m3)")
# Chosen joints, per end: the x beam's finish butts against the y beam's
# side (3.75 m long, 0.3 m3); the y beam's start answers by running through
# to the x beam's far side (3.1 m, 0.248 m3).
set bim setting ((bim connection setting) + 1) of alongX to ((bim butt connection) as a 64 bit integer) keeping true in target
show join test alongX of modelValue labelled (the string form of "chosen butt x (0.3 m3)")
show join test alongY of modelValue labelled (the string form of "answering y (0.248 m3)")
# Open: both ends square at the corner (3.85 m and 3 m long).
set bim setting ((bim connection setting) + 1) of alongX to ((bim open connection) as a 64 bit integer) keeping true in target
show join test alongX of modelValue labelled (the string form of "open x (0.308 m3)")
show join test alongY of modelValue labelled (the string form of "open y (0.24 m3)")
print ((the string form of "joint names: ") + ((the bim name of connection (the bim connection at end 1 of alongX in modelValue)) + ((the string form of ", ") + (the bim name of connection (the bim connection at end 0 of alongY in modelValue))))) as a line
# Automatic again: the mitre returns.
set bim setting ((bim connection setting) + 1) of alongX to (0 as a 64 bit integer) keeping false in target
show join test alongX of modelValue labelled (the string form of "mitre again x (0.308 m3)")
# A building system: its transoms butt against its mullions.
set curtainId to add bim curtain wall on storey from (a cad vector2 with x 0.0 and y 10.0) to (a cad vector2 with x 2.4 and y 10.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "aluminium") to target
set curtainValue to the item at 0 in (modelValue's curtains's values)
set curtainParts to the bim parts of curtain wall curtainValue in modelValue
set curtainCuts to the bim end cuts of parts (curtainParts's values) in modelValue
set mullionsCut to 0
set transomsCut to 0
loop partCursor from 0 to the length of (curtainParts's values):
    set derivedPart to the item at partCursor in (curtainParts's values)
    set partCut to the item at partCursor in (curtainCuts's values)
    if partCut's startCut or partCut's finishCut:
        if derivedPart's kind's name = (the string form of "Mullion"):
            set mullionsCut to mullionsCut + 1
        if derivedPart's kind's name = (the string form of "Transom"):
            set transomsCut to transomsCut + 1
print ((the string form of "building system: mullions cut ") + ((the string form of mullionsCut) + ((the string form of ", transoms cut ") + (the string form of transomsCut)))) as a line
set combined to the bim curtain shape of curtainValue in modelValue within 0.0
print ((the string form of "building system closed: ") + (the string form of ((the fast mesh flaw of combined) = 0))) as a line
