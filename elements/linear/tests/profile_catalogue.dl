# SPDX-License-Identifier: MPL-2.0
# The profile catalogue (issue #95): its series and their profiles read from
# the compiled-in data; search by name ("HEA 2", "chs 114", "ipe200"); a
# profile found again by its key; a profile becomes a linear type only when
# it is added, once per role, with its IFC profile, series and catalogue
# key, named by the rules (steel) or by the catalogue (timber, concrete).
import elements/linear/bim_profile_catalogue.dl
import exchange/ifcx/bim_file.dl

function check catalogue case {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the names of {a pointer to a list:found}:
    execute:
        set nameList to an empty list of a string
        loop cursor from 0 to the length of found:
            append (the item at cursor in found)'s name to nameList
        set joined to nameList joined with ", "
        free nameList
        return joined

set seriesList to the bim profile catalogue series
set total to 0
set seriesNames to an empty list of a string
loop cursor from 0 to the length of seriesList:
    set seriesValue to the item at cursor in seriesList
    set seriesProfiles to the bim catalogue profiles of series (seriesValue's code)
    check catalogue case ((the length of seriesProfiles) = seriesValue's count) named ((seriesValue's name + (the string form of " holds its ")) + (the string form of seriesValue's count))
    set total to total + (the length of seriesProfiles)
    append seriesValue's name to seriesNames
    free seriesProfiles
print ((the string form of "series: ") + (seriesNames joined with " ")) as a line
print ((the string form of "profiles: ") + (the string form of total)) as a line

set found to the bim catalogue profiles matching (the string form of "HEA 2")
print ((the string form of "HEA 2: ") + (the names of found)) as a line
free found
set found to the bim catalogue profiles matching (the string form of "chs 114")
print ((the string form of "chs 114: ") + (the names of found)) as a line
free found
set found to the bim catalogue profiles matching (the string form of "ipe200")
print ((the string form of "ipe200: ") + (the names of found)) as a line
free found
set found to the bim catalogue profiles matching (the string form of "sls")
print ((the string form of "sls: ") + (the names of found)) as a line
free found
set found to the bim catalogue profiles matching (the string form of "IShape")
print ((the string form of "IShape: ") + (the names of found)) as a line
free found
set found to the bim catalogue profiles matching (the string form of "xyz")
check catalogue case ((the length of found) = 0) named (the string form of "a search without matches finds nothing")
free found

set found to the bim catalogue profiles matching (the string form of "HEA 200")
set hea to the item at 0 in found
free found
set again to the bim catalogue profile of key (the bim catalogue key of hea)
check catalogue case (again's found and ((again's value's name = hea's name) and (again's value's series = 3))) named (the string form of "a profile is found again by its key")
check catalogue case (((the bim catalogue profile of key (999 as a 64 bit integer))'s found) = false) named (the string form of "a key outside the catalogue finds none")
print ((((the string form of "HEA 200: h ") + (the bim profile number hea's depth)) + ((the string form of " b ") + (the bim profile number hea's width))) + ((((the string form of " tw ") + (the bim profile number hea's web)) + ((the string form of " tf ") + (the bim profile number hea's flange))) + ((the string form of " column ") + (the string form of hea's columnToo)))) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set before to the length of (modelValue's linearTypes's values)
check catalogue case ((the bim type of catalogue profile hea as role (bim beam role) in modelValue) = the bim refused id) named (the string form of "a catalogue profile is no type before it is used")
set beamType to add bim catalogue profile hea as role (bim beam role) to target
set beamAgain to add bim catalogue profile hea as role (bim beam role) to target
set columnType to add bim catalogue profile hea as role (bim column role) to target
check catalogue case ((beamType != the bim refused id) and (beamAgain = beamType)) named (the string form of "adding it twice gives the one type")
check catalogue case ((columnType != beamType) and ((the length of (modelValue's linearTypes's values)) = (before + 2))) named (the string form of "a column of it is a type of its own")
check catalogue case ((the bim type count of catalogue profile hea in modelValue) = 2) named (the string form of "the profile counts its two types")
set beamValue to the item at (the bim linear type index of beamType in modelValue)'s position in (modelValue's linearTypes's values)
set beamProfile to the bim profile of linear type beamValue in modelValue
print ((((the string form of "type: ") + beamValue's name) + ((the string form of ", ") + (the bim name of profile kind beamProfile's kind round beamProfile's round))) + ((((the string form of ", ") + beamValue's material) + (the string form of ", series ")) + (the string form of ((the bim setting (bim steel series setting) of beamType in modelValue)'s value)))) as a line

set found to the bim catalogue profiles matching (the string form of "SLS 38x89")
set stud to the item at 0 in found
free found
set studType to add bim catalogue profile stud as role (bim column role) to target
set studValue to the item at (the bim linear type index of studType in modelValue)'s position in (modelValue's linearTypes's values)
print ((((the string form of "type: ") + studValue's name) + ((the string form of ", ") + studValue's material)) + ((((the string form of ", ") + (the bim profile number studValue's width)) + (the string form of " x ")) + (the bim profile number studValue's depth))) as a line

set found to the bim catalogue profiles matching (the string form of "Concrete round 400")
set pier to the item at 0 in found
free found
set pierType to add bim catalogue profile pier as role (bim pile role) to target
set pierValue to the item at (the bim linear type index of pierType in modelValue)'s position in (modelValue's linearTypes's values)
set pierProfile to the bim profile of linear type pierValue in modelValue
print ((((the string form of "type: ") + pierValue's name) + ((the string form of ", ") + (the bim name of profile kind pierProfile's kind round pierProfile's round))) + ((the string form of ", diameter ") + (the bim profile number pierValue's width))) as a line

set found to the bim catalogue profiles matching (the string form of "IfcCShapeProfileDef")
set channel to the item at 0 in found
free found
set channelType to add bim catalogue profile channel as role (bim beam role) to target
set channelValue to the item at (the bim linear type index of channelType in modelValue)'s position in (modelValue's linearTypes's values)
set channelProfile to the bim profile of linear type channelValue in modelValue
print ((((the string form of "type: ") + channelValue's name) + ((the string form of ", ") + (the bim name of profile kind channelProfile's kind round channelProfile's round))) + ((the string form of ", lip ") + (the bim profile number channelProfile's fourth))) as a line

# Through the native file, the catalogue key kept: the type is found again.
set reread to the bim model parsed from (the bim file text of modelValue)
check catalogue case (reread's valid and ((the bim type of catalogue profile hea as role (bim beam role) in reread's modelValue) = beamType)) named (the string form of "the type is the profile's again after the native file")
