# SPDX-License-Identifier: MPL-2.0
# Linear elements: one element behind columns, beams and pipes, its type
# saying what it is. A concrete column standing on its storey, a steel beam
# along a line, a round pipe running at a slope: each a closed solid of its
# profile times its length, an outline seen from above, its IFC class from
# its type's role, and the same after the file and IfcX.
import exchange/ifcx/bim_file.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl

function the linear test text of {a 64 bit floating-point number:value}:
    execute:
        set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, value * 10000.0)
        return the string form of (scaled / 10000.0)

function show linear element {a 64 bit integer:linearId} of {bim model record:modelValue} labelled {a string:label}:
    execute:
        set linearValue to the item at (the bim linear index of linearId in modelValue)'s position in (modelValue's linears's values)
        set linearType to the bim type of linear linearValue in modelValue
        set shape to the bim linear shape of linearValue in modelValue
        set outline to the bim plan outline of linear linearValue in modelValue
        set heights to the bim height range of linear linearValue in modelValue
        set line to (label + (the string form of ": ")) + (the bim ifc class of linear role linearType's role)
        set line to (line + (the string form of ", flaw ")) + (the string form of (the fast mesh flaw of shape))
        set line to (line + (the string form of ", volume ")) + (the linear test text of (the bim volume of mesh shape))
        set line to (line + (the string form of ", outline corners ")) + (the string form of (the length of outline))
        set line to (line + (the string form of ", heights ")) + (((the linear test text of heights's x) + (the string form of " to ")) + (the linear test text of heights's y))
        print line as a line

set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground floor") at 1.0 with height 3.0 to target
set columnType to add bim linear type named (the string form of "Kolom beton 300x300") as role bim column role sized 0.3 by 0.3 round false of (the string form of "concrete") to target
set beamType to add bim linear type named (the string form of "Balk staal 200x400") as role bim beam role sized 0.2 by 0.4 round false of (the string form of "steel") to target
set pipeType to add bim linear type named (the string form of "Leiding 100") as role bim pipe role sized 0.1 by 0.1 round true of (the string form of "steel") to target
set column to add bim linear typed columnType on storey from (a cad vector3 with x 2.0, y 2.0 and z 0.0) to (a cad vector3 with x 2.0, y 2.0 and z 3.0) turned 0.0 to target
set beam to add bim linear typed beamType on storey from (a cad vector3 with x 2.0, y 2.0 and z 2.8) to (a cad vector3 with x 8.0, y 2.0 and z 2.8) turned 0.0 to target
set pipe to add bim linear typed pipeType on storey from (a cad vector3 with x 0.0, y 5.0 and z 0.5) to (a cad vector3 with x 4.0, y 8.0 and z 0.8) turned 0.0 to target
show linear element column of modelValue labelled (the string form of "column 0.3x0.3x3 (0.27 m3)")
show linear element beam of modelValue labelled (the string form of "beam 0.2x0.4x6 (0.48 m3)")
show linear element pipe of modelValue labelled (the string form of "pipe d0.1 over 5.009 m")
ignore move bim linear column to (a cad vector3 with x 2.0, y 2.0 and z 0.0) and (a cad vector3 with x 2.0, y 2.0 and z 3.0) turned 0.5 in target
show linear element column of modelValue labelled (the string form of "column turned 0.5 rad")
print ((the string form of "an axis of nothing refused: ") + (the string form of ((add bim linear typed columnType on storey from (a cad vector3 with x 1.0, y 1.0 and z 0.0) to (a cad vector3 with x 1.0, y 1.0 and z 0.0) turned 0.0 to target) = the bim refused id))) as a line
ignore size bim linear type beamType to 0.25 by 0.5 in target
show linear element beam of modelValue labelled (the string form of "beam type resized to 0.25x0.5")
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", ") + reread's message))) as a line
show linear element pipe of reread's modelValue labelled (the string form of "pipe from .bim")
set exported to the bim ifcx text of modelValue identified as (the string form of "l.ifcx") for project (the string form of "l") by (the string form of "test") at (the string form of "2026-10-09T00:00:00Z")
print ((the string form of "IfcX names IfcColumnType, IfcBeam and IfcPipeSegment: ") + (the string form of (((exported contains "IfcColumnType") and (exported contains "\"IfcBeam\"")) and (exported contains "IfcPipeSegment")))) as a line
set native to the bim native text of ifcx exported
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of ", ") + fromIfcx's message))) as a line
show linear element beam of fromIfcx's modelValue labelled (the string form of "beam from .ifcx")
set backType to the item at 0 in (fromIfcx's modelValue's linearTypes's values)
print ((the string form of "first type from .ifcx: ") + ((backType's name + (the string form of ", ")) + backType's material)) as a line
