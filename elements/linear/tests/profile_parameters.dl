# SPDX-License-Identifier: MPL-2.0
# Parametric profiles (issue #95): expressions in named parameters; a
# profile with an outline and a hole driven by them, kept as the open
# property set OpenAEC_ProfileParameters and evaluated into the type's
# arbitrary profile (its rings, its sweep); a parameter changed, a driven
# one following; refusals that change nothing; the set and the profile
# kept through the native file and IfcX; a drawn profile saved as a
# parametric one in its width and depth.
import elements/linear/bim_profile_parameters.dl
import exchange/ifcx/bim_file.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl

function check parameter case {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the expression check {a string:expressionText} in {a pointer to a list:parameterList}:
    execute:
        set valueReading to the bim profile expression expressionText in parameterList
        if valueReading's valid:
            return (expressionText + (the string form of " = ")) + (the bim profile number valueReading's value)
        return expressionText + (the string form of " refused")

function the ring text of {a pointer to a list:ring}:
    execute:
        set pieces to an empty list of a string
        loop cursor from 0 to the length of ring:
            set corner to the item at cursor in ring
            append (((the bim steel size text of corner's x) + (the string form of " ")) + (the bim steel size text of corner's y)) to pieces
        set joined to pieces joined with ", "
        free pieces
        return joined

function the rings text of type {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        set linearType to the item at (the bim linear type index of typeId in modelValue)'s position in (modelValue's linearTypes's values)
        set ringList to the bim rings of linear type linearType in modelValue at 24 round corners
        set pieces to an empty list of a string
        loop cursor from 0 to the length of ringList:
            append ((the string form of "[") + ((the ring text of (the item at cursor in ringList)) + (the string form of "]"))) to pieces
        set joined to pieces joined with " "
        free pieces
        return joined

function the set text of type {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        set pieces to an empty list of a string
        loop cursor from 0 to the length of (modelValue's properties's values):
            set entry to the item at cursor in (modelValue's properties's values)
            if (entry's elementId = typeId) and (entry's setName = (the bim profile parameter set)):
                append ((((entry's name + (the string form of " ")) + entry's valueType) + (the string form of " ")) + entry's value) to pieces
        set joined to pieces joined with "\n  "
        free pieces
        return joined

set knowns to an empty list of a bim profile parameter record
append (the bim profile parameter named (the string form of "b") valued 0.5) to knowns
append (the bim profile parameter named (the string form of "tf") valued 0.02) to knowns
print (the expression check (the string form of "2*(b+1)") in knowns) as a line
print (the expression check (the string form of "-b/2") in knowns) as a line
print (the expression check (the string form of "3 - 2 - 1") in knowns) as a line
print (the expression check (the string form of "2*3+4*5") in knowns) as a line
print (the expression check (the string form of "-(b+tf)*2") in knowns) as a line
print (the expression check (the string form of "b*") in knowns) as a line
print (the expression check (the string form of "c+1") in knowns) as a line
print (the expression check (the string form of "(b") in knowns) as a line
print (the expression check (the string form of "1/(b-0.5)") in knowns) as a line
print (the expression check (the string form of "b;1") in knowns) as a line
check parameter case (((bim profile parameter name (the string form of "t_2") is valid) and ((bim profile parameter name (the string form of "2t") is valid) = false)) and (((bim profile parameter name (the string form of "Outline") is valid) = false) and ((bim profile parameter name (the string form of "Void1") is valid) = false))) named (the string form of "parameter names are checked")

set modelValue to an empty bim model
set target to the address of modelValue
set frameType to add bim linear type named (the string form of "Frame") as role (bim generic linear role) sized 0.05 by 0.05 round false of (the string form of "timber") to target
# A frame section b by h with a rebate r by r at its top right and a
# groove a quarter of b wide: r follows b.
set parameterList to an empty list of a bim profile parameter record
append (the bim profile parameter named (the string form of "b") valued 0.068) to parameterList
append (the bim profile parameter named (the string form of "h") valued 0.114) to parameterList
append (the bim profile parameter named (the string form of "r") following (the string form of "b/4")) to parameterList
set voidTexts to an empty list of a string
append (the string form of "b/4,h/4; b/2,h/4; b/2,h/2; b/4,h/2") to voidTexts
set outlineText to the string form of "0,0; b,0; b,h-r; b-r,h-r; b-r,h; 0,h"
check parameter case (make bim linear type frameType parametric named (the string form of "Frame 68x114") in series (the string form of "Window frames") with parameterList outline outlineText voids voidTexts in target) named (the string form of "a type is made parametric")
check parameter case (bim linear type frameType is parametric in modelValue) named (the string form of "it is parametric")
print ((the string form of "set:\n  ") + (the set text of type frameType in modelValue)) as a line
print ((the string form of "rings: ") + (the rings text of type frameType in modelValue)) as a line
set frameValue to the item at (the bim linear type index of frameType in modelValue)'s position in (modelValue's linearTypes's values)
set frameProfile to the bim profile of linear type frameValue in modelValue
print ((((the string form of "kind ") + (the bim name of profile kind frameProfile's kind round false)) + ((the string form of ", width ") + (the bim profile number frameValue's width))) + ((the string form of ", depth ") + (the bim profile number frameValue's depth))) as a line

# A member 1 m long: outline area minus the hole, times 1 m.
# 68x114 - 17x17 = 7752 - 289 = 7463 mm2; hole 17 x 28.5 = 484.5 mm2.
# (Its closure is not checked: an end cap with a hole leaves 6 edges
# unpaired, as a rectangular hollow section's does, measured 2026-10-31.)
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set member to add bim linear typed frameType on ground from (a cad vector3 with x 0.0, y 0.0 and z 1.0) to (a cad vector3 with x 1.0, y 0.0 and z 1.0) turned 0.0 to target
set memberValue to the item at (the bim linear index of member in modelValue)'s position in (modelValue's linears's values)
set memberShape to the bim linear shape of memberValue in modelValue
check parameter case ((the absolute value of ((the absolute value of (the bim volume of mesh memberShape)) - 0.0069785)) < 0.0000001) named (the string form of "its sweep is the outline less the hole, times the length")

check parameter case (set bim profile parameter (the string form of "b") of type frameType to 0.08 in target) named (the string form of "b is changed")
print ((the string form of "rings: ") + (the rings text of type frameType in modelValue)) as a line
print ((the string form of "r follows: ") + (the bim property value (the string form of "r") of set (the bim profile parameter set) of frameType in modelValue)) as a line
check parameter case ((set bim profile parameter (the string form of "r") of type frameType to 0.01 in target) = false) named (the string form of "a driven parameter is not set by hand")
check parameter case ((set bim profile parameter (the string form of "q") of type frameType to 0.01 in target) = false) named (the string form of "an unknown parameter is refused")
set before to the rings text of type frameType in modelValue
check parameter case ((set bim profile parameter (the string form of "b") of type frameType to 0.0 in target) = false) named (the string form of "a value that breaks the profile is refused")
check parameter case ((set bim profile parameter (the string form of "r") of type frameType expression (the string form of "x/2") in target) = false) named (the string form of "an expression in an unknown name is refused")
check parameter case ((set bim profile parameter (the string form of "b") of type frameType expression (the string form of "r*5") in target) = false) named (the string form of "a cycle that does not settle is refused")
check parameter case (((the rings text of type frameType in modelValue) = before) and ((the bim property value (the string form of "r.Expression") of set (the bim profile parameter set) of frameType in modelValue) = (the string form of "b/4"))) named (the string form of "the refusals changed nothing")
check parameter case ((set bim profile parameter (the string form of "r") of type frameType expression (the string form of "") in target) and (set bim profile parameter (the string form of "r") of type frameType to 0.01 in target)) named (the string form of "r is set by hand once its expression is taken away")
print ((the string form of "rings: ") + (the rings text of type frameType in modelValue)) as a line

set reread to the bim model parsed from (the bim file text of modelValue)
check parameter case (reread's valid and (((the set text of type frameType in reread's modelValue) = (the set text of type frameType in modelValue)) and ((the rings text of type frameType in reread's modelValue) = (the rings text of type frameType in modelValue)))) named (the string form of "the set and the profile are kept through the native file")
set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "p.ifcx") for project (the string form of "p") by (the string form of "test") at (the string form of "2026-10-31T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
check parameter case (fromIfcx's valid and (((the set text of type frameType in fromIfcx's modelValue) = (the set text of type frameType in modelValue)) and ((the rings text of type frameType in fromIfcx's modelValue) = (the rings text of type frameType in modelValue)))) named (the string form of "and through IfcX")

# A drawn profile saved as a parametric one: its points scale with b and h.
set drawnType to add bim linear type named (the string form of "Drawn") as role (bim generic linear role) sized 0.06 by 0.05 round false of (the string form of "steel") to target
set lShape to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to lShape
append (a cad vector2 with x 0.06 and y 0.0) to lShape
append (a cad vector2 with x 0.06 and y 0.02) to lShape
append (a cad vector2 with x 0.02 and y 0.02) to lShape
append (a cad vector2 with x 0.02 and y 0.05) to lShape
append (a cad vector2 with x 0.0 and y 0.05) to lShape
check parameter case (give bim linear type drawnType outline lShape in target) named (the string form of "a profile is drawn")
check parameter case (save bim drawn profile of type drawnType as parametric named (the string form of "Angle") in target) named (the string form of "it is saved as a parametric profile")
print ((the string form of "outline: ") + (the bim property value (the string form of "Outline") of set (the bim profile parameter set) of drawnType in modelValue)) as a line
check parameter case (set bim profile parameter (the string form of "h") of type drawnType to 0.1 in target) named (the string form of "its depth is changed")
print ((the string form of "rings: ") + (the rings text of type drawnType in modelValue)) as a line
set plainType to add bim linear type named (the string form of "Plain") as role (bim generic linear role) sized 0.06 by 0.05 round false of (the string form of "steel") to target
check parameter case ((save bim drawn profile of type plainType as parametric named (the string form of "None") in target) = false) named (the string form of "a type without a drawn outline is not saved")
