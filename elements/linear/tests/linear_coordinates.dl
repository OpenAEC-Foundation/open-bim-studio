# SPDX-License-Identifier: MPL-2.0
# GUI endpoint fields: project units, identity, undo, refusal and stale selection.
import ui/editor/bim_editor.dl

function check linear coordinates {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function type endpoint field {integer:fieldCode} with {a string:inputValue} in {a pointer to a bim editor record:editTarget}:
    execute:
        start bim editor property fieldCode in editTarget
        set editTarget's propertyText to inputValue
        apply bim editor property in editTarget

set workEditor to a new bim editor
set editPointer to the address of workEditor
set modelPointer to the address of (workEditor's documentValue's current)
set memberType to add bim linear type named (the string form of "Foundation") as role (bim beam role) sized 0.4 by 0.5 round false of (the string form of "concrete") to modelPointer
set memberId to add bim linear typed memberType on workEditor's levelId from (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (a cad vector3 with x 2.0, y 0.0 and z 0.0) turned 0.3 to modelPointer
select bim editor bim linear picked numbered memberId in editPointer
set workEditor's lengthUnit to bim millimetre unit
set endpointRows to the bim property rows of workEditor
set endpointCount to 0
loop rowCursor from 0 to the length of endpointRows:
    set shownRow to the item at rowCursor in endpointRows
    if (shownRow's code >= 284) and (shownRow's code <= 289):
        set endpointCount to endpointCount + 1
check linear coordinates (endpointCount = 6) named (the string form of "six editable endpoint rows")
free endpointRows
# Closing an axis to zero is rejected; no corrupted element or undo edit.
type endpoint field bim linear end x property with (the string form of "0") in editPointer
check linear coordinates ((the item at 0 in (modelPointer's linears's values))'s finish's x = 2.0) named (the string form of "zero length refused")
type endpoint field bim linear start x property with (the string form of "-40") in editPointer
type endpoint field bim linear start y property with (the string form of "4094") in editPointer
type endpoint field bim linear start z property with (the string form of "-1550") in editPointer
type endpoint field bim linear end x property with (the string form of "-40") in editPointer
type endpoint field bim linear end y property with (the string form of "8547") in editPointer
type endpoint field bim linear end z property with (the string form of "-1550") in editPointer
set editedMember to the item at 0 in (modelPointer's linears's values)
check linear coordinates ((the cad distance from editedMember's start to (a cad vector3 with x -0.04, y 4.094 and z -1.55)) < 1e-9) named (the string form of "start XYZ converts millimetres")
check linear coordinates ((the cad distance from editedMember's finish to (a cad vector3 with x -0.04, y 8.547 and z -1.55)) < 1e-9) named (the string form of "finish XYZ converts millimetres")
check linear coordinates ((editedMember's id = memberId) and (editedMember's angle = 0.3)) named (the string form of "identity and profile rotation preserved")
type endpoint field bim linear start x property with (the string form of "12..3") in editPointer
type endpoint field bim linear start x property with (the string form of "abc") in editPointer
type endpoint field bim linear start x property with (the string form of "1e309") in editPointer
type endpoint field bim linear start x property with (the string form of "NaN") in editPointer
check linear coordinates ((the item at 0 in (modelPointer's linears's values))'s start's x = -0.04) named (the string form of "malformed and nonfinite inputs preserve coordinates")
ignore undo bim transaction in (the address of (workEditor's documentValue))
check linear coordinates ((the item at 0 in (modelPointer's linears's values))'s finish's z = 0.0) named (the string form of "one field is one undo")
ignore redo bim transaction in (the address of (workEditor's documentValue))
check linear coordinates ((the item at 0 in (modelPointer's linears's values))'s finish's z = -1.55) named (the string form of "redo restores endpoint")
set workEditor's lengthUnit to bim metre unit
type endpoint field bim linear end y property with (the string form of "9.25") in editPointer
check linear coordinates ((the item at 0 in (modelPointer's linears's values))'s finish's y = 9.25) named (the string form of "metre input uses project units")
set workEditor's selectionId to 999999 as a 64 bit integer
type endpoint field bim linear start x property with (the string form of "123") in editPointer
check linear coordinates ((the item at 0 in (modelPointer's linears's values))'s start's x = -0.04) named (the string form of "stale selection cannot edit another member")
set workEditor's selectionId to memberId
set workEditor's selectionKind to bim wall picked
type endpoint field bim linear start x property with (the string form of "123") in editPointer
check linear coordinates ((the item at 0 in (modelPointer's linears's values))'s start's x = -0.04) named (the string form of "wrong selection kind refused")
print "PASS: linear_coordinates" as a line
