# SPDX-License-Identifier: MPL-2.0
# Written by tools/profile_catalogue.py from elements/linear/profiles/*.json;
# do not edit: change a series file and run `python3 -I
# tools/profile_catalogue.py generate`. 17 series, 361 profiles.
#
# A series line: code|series|title|standard|material|count|named (1:
# a type made from it keeps the profile's name, 0: the naming rules name it). A profile
# record: series,nominal,kind,h,b,tw,tf,r,fourth,column,round,name in
# millimetres, records apart by ';' (`bim_profile_catalogue.dl` reads them).
import bim/bim_model.dl

function the bim profile catalogue series lines:
    execute:
        set seriesLines to an empty list of a string
        append (the string form of "1|IPE|European I-beams with parallel flanges|EN 10365|steel|18|0") to seriesLines
        append (the string form of "2|IPN|European I-beams with tapered flanges, drawn with parallel flanges|EN 10365 (DIN 1025-1)|steel|21|0") to seriesLines
        append (the string form of "3|HEA|European wide-flange beams, light series|EN 10365 (DIN 1025-3)|steel|24|0") to seriesLines
        append (the string form of "4|HEB|European wide-flange beams|EN 10365 (DIN 1025-2)|steel|24|0") to seriesLines
        append (the string form of "5|HEM|European wide-flange beams, heavy series|EN 10365 (DIN 1025-4)|steel|24|0") to seriesLines
        append (the string form of "6|UPN|European channels with tapered flanges, drawn with parallel flanges|EN 10365 (DIN 1026-1)|steel|18|0") to seriesLines
        append (the string form of "7|UPE|European channels with parallel flanges|EN 10365 (DIN 1026-2)|steel|14|0") to seriesLines
        append (the string form of "8|L|Equal-leg angles|EN 10056-1|steel|32|0") to seriesLines
        append (the string form of "9|L|Unequal-leg angles|EN 10056-1|steel|28|0") to seriesLines
        append (the string form of "10|T|T sections|EN 10055|steel|10|0") to seriesLines
        append (the string form of "11|SHS|Square hollow sections, hot finished|EN 10210|steel|43|0") to seriesLines
        append (the string form of "12|RHS|Rectangular hollow sections, hot finished|EN 10210|steel|23|0") to seriesLines
        append (the string form of "13|CHS|Circular hollow sections, hot finished|EN 10210|steel|44|0") to seriesLines
        append (the string form of "14|SLS|Planed softwood, 38 mm thick (Scandinavian Lumber Sizes)|SLS sizes as the INB template names them (SLS38x89, SLS38x184, SLS38x235)|timber|4|1") to seriesLines
        append (the string form of "15|Concrete|Rectangular concrete columns and beams, width x depth|common sizes on a 50 mm grid, not a standard (200x200, 300x300 and 400x500 are in the INB template)|concrete|15|1") to seriesLines
        append (the string form of "16|Concrete round|Round concrete columns and piles, diameter|common diameters on a 50 mm grid, not a standard|concrete|7|1") to seriesLines
        append (the string form of "17|IFC|The parametric profile definitions of IFC, one example each to start a profile of one's own|IFC 4.3 subtypes of IfcParameterizedProfileDef, the sizes examples|steel|12|0") to seriesLines
        return seriesLines

