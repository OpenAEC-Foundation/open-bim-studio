# SPDX-License-Identifier: MPL-2.0
# The linear module's part of the scene: linear elements with their end cuts. Called by the
# composed dispatcher (`append bim module scene meshes of`) in layer order;
# the order does not matter, kept meshes are found by element id and part.
import viewer/bim_scene.dl
# The pile tip levels ride along: every program with the composed scene
# (the editor, the file formats) can then reach them.
import elements/linear/pile_tip_levels.dl

function append bim scene meshes of {bim model record:modelValue} within {a 64 bit floating-point number:tolerance} reusing {a pointer to a list:previous} keyed {a pointer to a list:keys} refreshing {a pointer to a list:remadeIds} with reinforcement detail {boolean:rebarDetail} into {a pointer to a list:result} with elements_linear elements:
    execute:
        # Linear elements, coloured by their material, their ends shaped by
        # their joins (worked out only when one of them is made again). A
        # round one without perforations follows the zoom; the others keep
        # their fixed detail whenever they are in `previous`.
        set linearCount to the length of (modelValue's linears's values)
        set linearSlots to an empty list of an integer
        set anyLinearMade to false
        loop cursor from 0 to linearCount:
            set linearValue to the item at cursor in (modelValue's linears's values)
            set linearSlot to -1
            if (the length of previous) > 0:
                set linearType to the bim type of linear linearValue in modelValue
                set perforations to the bim connection perforations of linearValue's id in modelValue
                if (linearType's round = false) or ((the length of (perforations's values)) > 0):
                    set linearSlot to the bim kept slot of linearValue's id part (bim linear part) among keys
                else:
                    set linearSlot to the bim kept slot of linearValue's id part (bim linear part) among keys unless remadeIds
            append linearSlot to linearSlots
            if linearSlot < 0:
                set anyLinearMade to true
        set modelCuts to a cad topology list of a bim end cut record
        if anyLinearMade:
            set modelParts to the bim linear parts of modelValue
            set modelCuts to the bim end cuts of parts (modelParts's values) in modelValue
        loop cursor from 0 to linearCount:
            set linearValue to the item at cursor in (modelValue's linears's values)
            set linearSlot to the item at cursor in linearSlots
            if linearSlot >= 0:
                append (the item at linearSlot in previous) to result
            else:
                set linearType to the bim type of linear linearValue in modelValue
                # A system's elements in its discipline's colour.
                set linearColour to the bim material colour of linearType's material
                set systemId to the bim system of element linearValue's id in modelValue
                if systemId != the bim refused id:
                    set linearColour to the bim colour of discipline (the item at (the bim system index of systemId in modelValue)'s position in (modelValue's systems's values))'s discipline
                append (@intrinsic("construct", a bim scene mesh record, linearValue's id, 0 as a 64 bit integer, bim linear part, the bim linear shape of linearValue typed linearType in modelValue within tolerance cut by (the item at cursor in (modelCuts's values)), the bim category of linear role linearType's role, linearColour, linearType's material)) to result
        free linearSlots
