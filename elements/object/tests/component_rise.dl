# SPDX-License-Identifier: MPL-2.0
import elements/object/bim_component_benchmark.dl
import exchange/ifcx/bim_file.dl
set modelValue to the bim component benchmark with 2 placements
set target to the address of modelValue
set first to the item at 0 in modelValue's instances's values
set second to the item at 1 in modelValue's instances's values
set second's componentId to first's componentId
replace item at index 1 in modelValue's instances's values with second
set valid to set bim instance second's id rise to 0.0625 in target
if (set bim instance first's id rise to 1000001.0 in target) or (set bim instance (the bim refused id) rise to 1.0 in target):
    set valid to false
set reread to the bim model parsed from (the bim file text of modelValue)
if reread's valid = false:
    set valid to false
else:
    if (the bim rise of instance first's id in reread's modelValue) != 0.0:
        set valid to false
    if (the bim rise of instance second's id in reread's modelValue) != 0.0625:
        set valid to false
if valid = false:
    print "FAIL: shared component vertical placement" as a line
    @intrinsic("call", "libc", "exit", nothing, 1)
print "PASS: shared definition accepts independent vertical placement and survives native save" as a line
