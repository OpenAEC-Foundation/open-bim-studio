import elements/object/bim_component.dl

# The prototype goes out of scope here. Returned render arrays must stay alive.
function the component buffer test mesh turned {a 64 bit floating-point number:angle}:
    execute:
        set prototype to an empty fast mesh
        append (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (prototype's positions's values)
        append (a cad vector3 with x 0.0, y 1.0 and z 0.0) to (prototype's positions's values)
        append (a cad vector3 with x 0.0, y 0.0 and z 1.0) to (prototype's positions's values)
        loop vertex from 0 to 3:
            append (a cad vector3 with x 1.0, y 0.0 and z 0.0) to (prototype's normals's values)
            append vertex to (prototype's triangles's values)
        set pose to @intrinsic("construct", a bim instance record, 1 as a 64 bit integer, 1 as a 64 bit integer, 1 as a 64 bit integer, (a cad vector2 with x 10.0 and y 20.0), angle, the bim refused id)
        return the bim component triangles prototype placed by pose at 5.0

set translated to the component buffer test mesh turned 0.0
set rotated to the component buffer test mesh turned 1.5707963267948966
set valid to true
loop vertex from 0 to 3:
    if ((the item at vertex in (translated's triangles's values)) != vertex) or ((the item at vertex in (rotated's triangles's values)) != vertex):
        set valid to false
    set normalValue to the item at vertex in (translated's normals's values)
    if (normalValue's x != 1.0) or ((normalValue's y != 0.0) or (normalValue's z != 0.0)):
        set valid to false
    set normalValue to the item at vertex in (rotated's normals's values)
    if ((the absolute value of normalValue's x) > 1e-9) or ((the absolute value of (normalValue's y - 1.0)) > 1e-9):
        set valid to false
set translatedPoint to the item at 1 in (translated's positions's values)
set rotatedPoint to the item at 1 in (rotated's positions's values)
if (translatedPoint's x != 10.0) or ((translatedPoint's y != 21.0) or (translatedPoint's z != 5.0)):
    set valid to false
if ((the absolute value of (rotatedPoint's x - 9.0)) > 1e-9) or (((the absolute value of (rotatedPoint's y - 20.0)) > 1e-9) or (rotatedPoint's z != 5.0)):
    set valid to false
if valid = false:
    print "FAIL: component placement buffer geometry or lifetime" as a line
    @intrinsic("call", "libc", "exit", nothing, 1)
print "PASS: translated and rotated placements preserve vertices normals and winding" as a line
print "PASS: render buffers survive the local prototype lifetime" as a line
