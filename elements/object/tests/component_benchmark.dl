# SPDX-License-Identifier: MPL-2.0
import elements/object/bim_component_benchmark.dl
import exchange/ifcx/bim_file.dl
set modelValue to the bim component benchmark with 10001 placements
set reread to the bim model parsed from (the bim file text of modelValue)
set valid to reread's valid
if (the length of modelValue's instances's values) != 10001:
    set valid to false
if (the length of modelValue's components's values) != 6:
    set valid to false
if (the length of modelValue's levels's values) != 2:
    set valid to false
if reread's valid:
    if (the length of reread's modelValue's instances's values) != 10001:
        set valid to false
    set first to the item at 0 in reread's modelValue's instances's values
    set last to the last item of reread's modelValue's instances's values
    if (first's levelId = last's levelId) or (first's componentId = the bim refused id):
        set valid to false
if valid = false:
    print (the string form of "FAIL: component benchmark identity or round trip") as a line
    @intrinsic("call", "libc", "exit", nothing, 1)
print "PASS: 10001 real instances share six definitions across two storeys" as a line
print "PASS: native save and reopen preserve the instance count and storeys" as a line
