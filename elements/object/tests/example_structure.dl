# SPDX-License-Identifier: MPL-2.0
# The example project's structure: a pile under each of the nine grid
# crossings and a structural plan and a pile plan of the ground floor, the
# plan shown kept; one undo takes them away again.
import ui/editor/bim_editor.dl

set editor to a new bim editor
set e to the address of editor
add bim example building to e at (a cad vector2 with x 0.0 and y 0.0)
set viewsBefore to the length of (editor's documentValue's current's views's values)
set shownBefore to editor's planViewId
add bim example structure to e at (a cad vector2 with x 0.0 and y 0.0)
set modelValue to editor's documentValue's current
set piles to 0
loop cursor from 0 to the length of (modelValue's linears's values):
    set linearValue to the item at cursor in (modelValue's linears's values)
    if (the bim type of linear linearValue in modelValue)'s role = bim pile role:
        set piles to piles + 1
print ((the string form of "piles: ") + (the string form of piles)) as a line
loop cursor from viewsBefore to the length of (modelValue's views's values):
    print ((the string form of "view: ") + (the item at cursor in (modelValue's views's values))'s name) as a line
print ((the string form of "plan shown kept: ") + (the string form of (editor's planViewId = shownBefore))) as a line
ignore undo bim transaction in (the address of (editor's documentValue))
print ((the string form of "after undo, linears: ") + (the string form of (the length of (editor's documentValue's current's linears's values)))) as a line
