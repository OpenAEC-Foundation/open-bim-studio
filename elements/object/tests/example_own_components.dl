# SPDX-License-Identifier: MPL-2.0
# The example model "voorbeeld-eigen-componenten.bim", made from the
# modeller's own elements only: a two-storey house of cavity walls with
# windows and doors, floor plates, a pitched roof, a stair with a railing, a
# curtain wall, a steel and timber veranda of columns and beams, grids, and
# components of its own (a dining table, a chair, a kitchen unit, a bed, a
# planter and a pendant lamp, built from solids) placed as instances. Saved,
# opened again, and counted.
import editor/bim_app_files.dl

function the house point {a 64 bit floating-point number:px} {a 64 bit floating-point number:py}:
    execute:
        return a cad vector2 with x px and y py

# A box from (`ax`, `ay`, `az`), `dx` by `dy` by `dz`, added to component
# `componentId`.
function add house box to component {a 64 bit integer:componentId} from {a 64 bit floating-point number:ax} {a 64 bit floating-point number:ay} {a 64 bit floating-point number:az} measuring {a 64 bit floating-point number:dx} {a 64 bit floating-point number:dy} {a 64 bit floating-point number:dz} of {a string:materialName} in {a pointer to a bim model record:target}:
    execute:
        set noProfile to an empty list of a cad vector2
        ignore (add bim solid of kind bim box solid as bim add operation at (a cad vector3 with x ax, y ay and z az) sized (a cad vector3 with x dx, y dy and z dz) turned 0.0 along noProfile of materialName to component componentId in target)
        free noProfile

# Four legs, `legSize` square and `legHeight` high, under the corners of a
# `spanX` by `spanY` rectangle centred on the origin.
function add house legs to component {a 64 bit integer:componentId} under {a 64 bit floating-point number:spanX} by {a 64 bit floating-point number:spanY} square {a 64 bit floating-point number:legSize} high {a 64 bit floating-point number:legHeight} in {a pointer to a bim model record:target}:
    execute:
        set westX to 0.0 - (spanX * 0.5)
        set eastX to (spanX * 0.5) - legSize
        set southY to 0.0 - (spanY * 0.5)
        set northY to (spanY * 0.5) - legSize
        add house box to component componentId from westX southY 0.0 measuring legSize legSize legHeight of (the string form of "timber") in target
        add house box to component componentId from eastX southY 0.0 measuring legSize legSize legHeight of (the string form of "timber") in target
        add house box to component componentId from eastX northY 0.0 measuring legSize legSize legHeight of (the string form of "timber") in target
        add house box to component componentId from westX northY 0.0 measuring legSize legSize legHeight of (the string form of "timber") in target

set editor to a new bim editor
make new bim model from template 0 in (the address of editor)
set target to the address of (editor's documentValue's current)
set groundId to (the item at 0 in (target's levels's values))'s id
set upperId to (the item at 1 in (target's levels's values))'s id
set halfPi to 1.5707963267948966

# Types of its own.
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.12)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.1)) to layerValues
set facadeType to add bim wall type named (the string form of "Spouwmuur 320") with layerValues to target
free layerValues
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.1)) to layerValues
set partitionType to add bim wall type named (the string form of "Binnenwand 100") with layerValues to target
free layerValues
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to layerValues
set floorType to add bim planar type named (the string form of "Vloer beton 200") as role bim floor planar role with layerValues to target
free layerValues
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.05)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.15)) to layerValues
set roofType to add bim planar type named (the string form of "Dak hout 200") as role bim roof planar role with layerValues to target
free layerValues
set wideWindow to add bim opening type named (the string form of "Raam 2400") sized 2.4 by 1.6 with sill 0.6 and frame 0.06 to target
set narrowWindow to add bim opening type named (the string form of "Raam 1200") sized 1.2 by 1.4 with sill 0.9 and frame 0.06 to target
set frontDoor to add bim door type named (the string form of "Voordeur 1000") sized 1.0 by 2.3 with frame 0.07 to target
set innerDoor to add bim door type named (the string form of "Binnendeur 880") sized 0.88 by 2.3 with frame 0.05 to target
set steelColumn to add bim linear type named (the string form of "Kolom staal 150x150") as role bim column role sized 0.15 by 0.15 round false of (the string form of "steel") to target
set steelBeam to add bim linear type named (the string form of "Ligger staal 150x200") as role bim beam role sized 0.15 by 0.2 round false of (the string form of "steel") to target
set timberBeam to add bim linear type named (the string form of "Gording hout 75x225") as role bim beam role sized 0.075 by 0.225 round false of (the string form of "timber") to target

# The ground floor: facades on the axes 0 to 10 by 0 to 7, the east one
# opened up for a curtain wall, and a partition between living and kitchen.
set southWall to add bim wall typed facadeType on groundId from (the house point 0.0 0.0) to (the house point 10.0 0.0) to target
ignore (add bim wall typed facadeType on groundId from (the house point 10.0 0.0) to (the house point 10.0 1.5) to target)
ignore (add bim wall typed facadeType on groundId from (the house point 10.0 5.5) to (the house point 10.0 7.0) to target)
set northWall to add bim wall typed facadeType on groundId from (the house point 10.0 7.0) to (the house point 0.0 7.0) to target
set westWall to add bim wall typed facadeType on groundId from (the house point 0.0 7.0) to (the house point 0.0 0.0) to target
set kitchenWall to add bim wall typed partitionType on groundId from (the house point 6.0 0.0) to (the house point 6.0 7.0) to target
ignore (add bim opening typed wideWindow in southWall at 3.0 to target)
ignore (add bim opening typed frontDoor in southWall at 7.5 to target)
ignore (add bim opening typed narrowWindow in northWall at 2.0 to target)
ignore (add bim opening typed narrowWindow in northWall at 6.0 to target)
ignore (add bim opening typed narrowWindow in westWall at 1.5 to target)
ignore (add bim opening typed innerDoor in kitchenWall at 5.5 to target)
ignore (add bim curtain wall on groundId from (the house point 10.0 1.5) to (the house point 10.0 5.5) rising 3.0 in bays of 1.0 by 1.5 of (the string form of "steel") to target)

# The first floor: the facades with windows, a partition with a door.
set upperSouth to add bim wall typed facadeType on upperId from (the house point 0.0 0.0) to (the house point 10.0 0.0) to target
set upperEast to add bim wall typed facadeType on upperId from (the house point 10.0 0.0) to (the house point 10.0 7.0) to target
set upperNorth to add bim wall typed facadeType on upperId from (the house point 10.0 7.0) to (the house point 0.0 7.0) to target
set upperWest to add bim wall typed facadeType on upperId from (the house point 0.0 7.0) to (the house point 0.0 0.0) to target
set bedroomWall to add bim wall typed partitionType on upperId from (the house point 5.0 0.0) to (the house point 5.0 7.0) to target
ignore (add bim opening typed narrowWindow in upperSouth at 2.5 to target)
ignore (add bim opening typed narrowWindow in upperSouth at 7.5 to target)
ignore (add bim opening typed narrowWindow in upperEast at 3.5 to target)
ignore (add bim opening typed narrowWindow in upperNorth at 2.5 to target)
ignore (add bim opening typed narrowWindow in upperNorth at 7.5 to target)
ignore (add bim opening typed narrowWindow in upperWest at 1.5 to target)
ignore (add bim opening typed innerDoor in bedroomWall at 5.8 to target)

# Floors flush with the facades' outer faces; the first floor leaves the
# stair's well open.
set outline to an empty list of a cad vector2
append (the house point -0.16 -0.16) to outline
append (the house point 10.16 -0.16) to outline
append (the house point 10.16 7.16) to outline
append (the house point -0.16 7.16) to outline
ignore (add bim plate typed floorType on groundId around outline at top 0.0 to target)
free outline
set outline to an empty list of a cad vector2
append (the house point -0.16 -0.16) to outline
append (the house point 10.16 -0.16) to outline
append (the house point 10.16 7.16) to outline
append (the house point -0.16 7.16) to outline
append (the house point -0.16 4.6) to outline
append (the house point 1.3 4.6) to outline
append (the house point 1.3 0.8) to outline
append (the house point -0.16 0.8) to outline
ignore (add bim plate typed floorType on upperId around outline at top 0.0 to target)
free outline

# A pitched roof of two planes, 35 degrees, meeting over y = 3.5; each
# plane's first corner on its eave.
set roofPitch to 0.6108652381980153
set outline to an empty list of a cad vector2
append (the house point -0.4 -0.4) to outline
append (the house point 10.4 -0.4) to outline
append (the house point 10.4 3.5) to outline
append (the house point -0.4 3.5) to outline
set southRoof to add bim plate typed roofType on upperId around outline at top 3.0 to target
ignore (set bim plate southRoof top to 3.0 pitch roofPitch heading halfPi in target)
free outline
set outline to an empty list of a cad vector2
append (the house point -0.4 7.4) to outline
append (the house point 10.4 7.4) to outline
append (the house point 10.4 3.5) to outline
append (the house point -0.4 3.5) to outline
set northRoof to add bim plate typed roofType on upperId around outline at top 3.0 to target
ignore (set bim plate northRoof top to 3.0 pitch roofPitch heading (0.0 - halfPi) in target)
free outline

# The stair along the west facade, and a railing along its well upstairs.
ignore (add bim stair on groundId from (the house point 0.75 0.8) to (the house point 0.75 4.55) wide 1.0 in 16 risers of (the string form of "timber") to target)
set railPath to an empty list of a cad vector2
append (the house point 1.3 0.8) to railPath
append (the house point 1.3 4.6) to railPath
ignore (add bim railing on upperId along railPath hosted by (the bim refused id) rising 1.0 of (the string form of "steel") to target)
free railPath

# The veranda on the south: three steel columns, a steel beam on them, and
# timber purlins from the beam to the facade.
loop postCursor from 0 to 3:
    set postX to 2.0 + (3.0 * (postCursor as a 64 bit floating-point number))
    ignore (add bim linear typed steelColumn on groundId from (a cad vector3 with x postX, y -3.0 and z 0.0) to (a cad vector3 with x postX, y -3.0 and z 2.6) turned 0.0 to target)
ignore (add bim linear typed steelBeam on groundId from (a cad vector3 with x 1.5, y -3.0 and z 2.7) to (a cad vector3 with x 8.5, y -3.0 and z 2.7) turned 0.0 to target)
loop purlinCursor from 0 to 5:
    set purlinX to 2.0 + (1.5 * (purlinCursor as a 64 bit floating-point number))
    ignore (add bim linear typed timberBeam on groundId from (a cad vector3 with x purlinX, y -3.0 and z 2.9125) to (a cad vector3 with x purlinX, y -0.16 and z 2.9125) turned 0.0 to target)

# Grids on the facades, the partition and the veranda.
set reachValue to the bim grid reach of (@intrinsic("dereference", target))
ignore (add bim grid named (the string form of "1") from (the house point 0.0 -4.5) to (the house point 0.0 8.5) reaching reachValue's x to reachValue's y to target)
ignore (add bim grid named (the string form of "2") from (the house point 6.0 -4.5) to (the house point 6.0 8.5) reaching reachValue's x to reachValue's y to target)
ignore (add bim grid named (the string form of "3") from (the house point 10.0 -4.5) to (the house point 10.0 8.5) reaching reachValue's x to reachValue's y to target)
ignore (add bim grid named (the string form of "A") from (the house point -1.5 -3.0) to (the house point 11.5 -3.0) reaching reachValue's x to reachValue's y to target)
ignore (add bim grid named (the string form of "B") from (the house point -1.5 0.0) to (the house point 11.5 0.0) reaching reachValue's x to reachValue's y to target)
ignore (add bim grid named (the string form of "C") from (the house point -1.5 7.0) to (the house point 11.5 7.0) reaching reachValue's x to reachValue's y to target)

# Components of its own, each built from solids around its origin.
set tableId to add bim component named (the string form of "Eettafel 1800x900") to target
add house box to component tableId from -0.9 -0.45 0.71 measuring 1.8 0.9 0.04 of (the string form of "timber") in target
add house legs to component tableId under 1.7 by 0.8 square 0.06 high 0.71 in target
set chairId to add bim component named (the string form of "Stoel") to target
add house box to component chairId from -0.225 -0.225 0.43 measuring 0.45 0.45 0.04 of (the string form of "timber") in target
add house legs to component chairId under 0.42 by 0.42 square 0.035 high 0.43 in target
add house box to component chairId from -0.225 -0.225 0.47 measuring 0.45 0.035 0.45 of (the string form of "timber") in target
set kitchenId to add bim component named (the string form of "Keukenblok 3000") to target
add house box to component kitchenId from -1.5 -0.6 0.1 measuring 3.0 0.58 0.76 of (the string form of "timber") in target
add house box to component kitchenId from -1.5 -0.62 0.86 measuring 3.0 0.62 0.04 of (the string form of "concrete") in target
set noProfile to an empty list of a cad vector2
ignore (add bim solid of kind bim cylinder solid as bim subtract operation at (a cad vector3 with x 0.6, y -0.3 and z 0.72) sized (a cad vector3 with x 0.2, y 0.0 and z 0.2) turned 0.0 along noProfile of (the string form of "steel") to component kitchenId in target)
set bedId to add bim component named (the string form of "Bed 1600x2000") to target
add house box to component bedId from -0.8 -1.0 0.1 measuring 1.6 2.0 0.25 of (the string form of "timber") in target
add house box to component bedId from -0.78 -0.98 0.35 measuring 1.56 1.96 0.2 of (the string form of "generic") in target
add house box to component bedId from -0.8 0.96 0.1 measuring 1.6 0.04 0.8 of (the string form of "timber") in target
set planterId to add bim component named (the string form of "Plantenbak") to target
set hexagon to an empty list of a cad vector2
loop sideCursor from 0 to 6:
    set sideTurn to (sideCursor as a 64 bit floating-point number) * 1.0471975511965976
    append (the house point (0.3 * (the cosine of sideTurn)) (0.3 * (the sine of sideTurn))) to hexagon
ignore (add bim solid of kind bim extrusion solid as bim add operation at (a cad vector3 with x 0.0, y 0.0 and z 0.0) sized (a cad vector3 with x 1.0, y 1.0 and z 0.5) turned 0.0 along hexagon of (the string form of "concrete") to component planterId in target)
free hexagon
set lampId to add bim component named (the string form of "Hanglamp") to target
ignore (add bim solid of kind bim sphere solid as bim add operation at (a cad vector3 with x 0.0, y 0.0 and z 2.2) sized (a cad vector3 with x 0.18, y 0.0 and z 0.18) turned 0.0 along noProfile of (the string form of "generic") to component lampId in target)
ignore (add bim solid of kind bim cylinder solid as bim add operation at (a cad vector3 with x 0.0, y 0.0 and z 2.36) sized (a cad vector3 with x 0.006, y 0.0 and z 0.64) turned 0.0 along noProfile of (the string form of "steel") to component lampId in target)
free noProfile

# The instances: a dining table with six chairs and a lamp over it, the
# kitchen against the north facade, a bed upstairs, planters by the veranda.
ignore (place bim component tableId on groundId at (the house point 3.0 3.5) turned 0.0 to target)
ignore (place bim component lampId on groundId at (the house point 3.0 3.5) turned 0.0 to target)
loop seatCursor from 0 to 3:
    set seatX to 2.4 + (0.6 * (seatCursor as a 64 bit floating-point number))
    ignore (place bim component chairId on groundId at (the house point seatX 2.85) turned 0.0 to target)
    ignore (place bim component chairId on groundId at (the house point seatX 4.15) turned (2.0 * halfPi) to target)
ignore (place bim component kitchenId on groundId at (the house point 8.0 6.84) turned 0.0 to target)
ignore (place bim component bedId on upperId at (the house point 7.5 4.5) turned 0.0 to target)
ignore (place bim component planterId on groundId at (the house point 0.6 -3.6) turned 0.0 to target)
ignore (place bim component planterId on groundId at (the house point 9.4 -3.6) turned 0.0 to target)

set savedPath to the string form of "voorbeeld-eigen-componenten.bim"
save bim editor to savedPath in (the address of editor)
print editor's message as a line
set reopened to a new bim editor
open bim editor from savedPath in (the address of reopened)
set modelValue to reopened's documentValue's current
print ((the string form of "levels ") + (the string form of (the length of (modelValue's levels's values)))) as a line
print ((the string form of "walls ") + ((the string form of (the length of (modelValue's walls's values))) + ((the string form of ", openings ") + (the string form of (the length of (modelValue's openings's values)))))) as a line
print ((the string form of "plates ") + ((the string form of (the length of (modelValue's slabs's values))) + ((the string form of ", linear elements ") + (the string form of (the length of (modelValue's linears's values)))))) as a line
print ((the string form of "stairs ") + ((the string form of (the length of (modelValue's stairs's values))) + ((the string form of ", railings ") + ((the string form of (the length of (modelValue's railings's values))) + ((the string form of ", curtain walls ") + (the string form of (the length of (modelValue's curtains's values)))))))) as a line
print ((the string form of "grids ") + (the string form of (the length of (modelValue's grids's values)))) as a line
print ((the string form of "components ") + ((the string form of (the length of (modelValue's components's values))) + ((the string form of ", instances ") + (the string form of (the length of (modelValue's instances's values)))))) as a line
loop definitionCursor from 0 to the length of (modelValue's components's values):
    set definition to the item at definitionCursor in (modelValue's components's values)
    print ((the string form of "  ") + (definition's name + ((the string form of ", solids ") + (the string form of (the length of (definition's solids's values)))))) as a line
