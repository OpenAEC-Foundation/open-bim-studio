# SPDX-License-Identifier: MPL-2.0
# Real native component instances, not a single mesh containing many boxes.
# Counts are explicit so renderer measurements can distinguish objects/triangles.
import bim/bim_model.dl

function add bim benchmark box to {a 64 bit integer:definitionId} at {cad vector3:origin} sized {cad vector3:size} of {a string:materialName} in {a pointer to a bim model record:target}:
    execute:
        set profile to an empty list of a cad vector2
        ignore add bim solid of kind bim box solid as bim add operation at origin sized size turned 0.0 along profile of materialName to component definitionId in target
        free profile

function the bim component benchmark with {integer:requested} placements:
    execute:
        set modelValue to an empty bim model
        set target to the address of modelValue
        set wanted to the maximum of 0 and (the minimum of requested and 1000000)
        set levels to an empty list of a 64 bit integer
        set layers to the maximum of 1 and ((wanted + 9999) / 10000)
        loop layerCursor from 0 to layers:
            append (add bim level named ((the string form of "Benchmark ") + (the string form of layerCursor)) at ((layerCursor as a 64 bit floating-point number) * 3.6) with height 3.6 to target) to levels
        # Editor readiness types are separate from the measured component count.
        set wallLayers to an empty list of a bim layer record
        append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to wallLayers
        ignore add bim wall type named (the string form of "Reference wall") with wallLayers to target
        free wallLayers
        ignore add bim opening type named (the string form of "Reference window") sized 1.0 by 1.0 with sill 1.0 and frame 0.05 to target
        ignore add bim door type named (the string form of "Reference door") sized 0.9 by 2.1 with frame 0.05 to target
        set definitions to an empty list of a 64 bit integer
        loop variant from 0 to 6:
            set definitionId to add bim component named ((the string form of "Benchmark prototype ") + (the string form of variant)) to target
            append definitionId to definitions
            set size to a cad vector3 with x 1.0, y 1.0 and z 1.0
            set materialName to the string form of "concrete"
            if variant = 1:
                set size to a cad vector3 with x 0.21, y 0.1 and z 0.0525
                set materialName to the string form of "brick"
            else if variant = 2:
                set size to a cad vector3 with x 0.07, y 3.0 and z 0.22
                set materialName to the string form of "timber"
            else if variant = 3:
                set size to a cad vector3 with x 1.2, y 2.8 and z 0.2
            else if variant = 4:
                set size to a cad vector3 with x 0.15, y 0.15 and z 3.0
                set materialName to the string form of "steel"
            else if variant = 5:
                set size to a cad vector3 with x 1.0, y 0.1 and z 0.1
                set materialName to the string form of "aluminium"
            add bim benchmark box to definitionId at (a cad vector3 with x 0.0, y 0.0 and z 0.0) sized size of materialName in target
            if variant = 5:
                add bim benchmark box to definitionId at (a cad vector3 with x 0.0, y 0.0 and z 0.1) sized (a cad vector3 with x 0.1, y 0.1 and z 1.3) of materialName in target
                add bim benchmark box to definitionId at (a cad vector3 with x 0.9, y 0.0 and z 0.1) sized (a cad vector3 with x 0.1, y 0.1 and z 1.3) of materialName in target
                add bim benchmark box to definitionId at (a cad vector3 with x 0.0, y 0.0 and z 1.4) sized size of materialName in target
        loop placementCursor from 0 to wanted:
            set inLayer to the remainder of placementCursor divided by 10000
            set columnIndex to the remainder of inLayer divided by 100
            set rowIndex to inLayer / 100
            set levelIndex to placementCursor / 10000
            set definitionId to the item at (the remainder of placementCursor divided by 6) in definitions
            ignore place bim component definitionId on (the item at levelIndex in levels) at (a cad vector2 with x ((columnIndex as a 64 bit floating-point number) * 3.0) and y ((rowIndex as a 64 bit floating-point number) * 3.0)) turned 0.0 to target
        free definitions
        free levels
        return modelValue
