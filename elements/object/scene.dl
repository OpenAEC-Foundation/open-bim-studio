# SPDX-License-Identifier: MPL-2.0
# The object module's part of the scene: placed components (meshed once per component), the face sketches
# not folded into a component, and the free meshes on a storey. Called by the
# composed dispatcher (`append bim module scene meshes of`) in layer order;
# the order does not matter, kept meshes are found by element id and part.
import viewer/bim_scene.dl

function append bim scene meshes of {bim model record:modelValue} within {a 64 bit floating-point number:tolerance} reusing {a pointer to a list:previous} keyed {a pointer to a list:keys} refreshing {a pointer to a list:remadeIds} with reinforcement detail {boolean:rebarDetail} into {a pointer to a list:result} with elements_object elements:
    execute:
        # Components with solid parts: mesh their B-rep once per component
        # and place it per instance, when any placement is made again.
        set foldedIds to an empty list of a 64 bit integer
        set componentTolerance to 0.002
        if tolerance > 0.0:
            set componentTolerance to the maximum of tolerance and 0.0002
        loop componentCursor from 0 to the length of (modelValue's components's values):
            set definition to the item at componentCursor in (modelValue's components's values)
            if bim component definition is folded:
                set placedHere to an empty list of an integer
                set placedSlots to an empty list of an integer
                set remeshed to false
                loop placementCursor from 0 to the length of (modelValue's instances's values):
                    set placement to the item at placementCursor in (modelValue's instances's values)
                    set placementLevel to the bim level index of placement's levelId in modelValue
                    if (placement's componentId = definition's id) and placementLevel's valid:
                        append placementCursor to placedHere
                        set placedSlot to the bim kept slot of placement's id part (bim placement part) among keys unless remadeIds
                        append placedSlot to placedSlots
                        if placedSlot < 0:
                            set remeshed to true
                set componentShape to an empty fast mesh
                if remeshed:
                    set componentShape to the bim component mesh of (the bim brep of component definition within 1e-9) within componentTolerance
                loop placedCursor from 0 to the length of placedHere:
                    set placement to the item at (the item at placedCursor in placedHere) in (modelValue's instances's values)
                    append placement's id to foldedIds
                    set placedSlot to the item at placedCursor in placedSlots
                    if placedSlot >= 0:
                        append (the item at placedSlot in previous) to result
                    else:
                        set placementLevel to the bim level index of placement's levelId in modelValue
                        set placementElevation to (the item at placementLevel's position in (modelValue's levels's values))'s elevation
                        append (@intrinsic("construct", a bim scene mesh record, placement's id, 0 as a 64 bit integer, bim placement part, the bim component triangles componentShape placed by placement at placementElevation, bim mass category, the bim category colouring, the string form of "")) to result
                free placedHere
                free placedSlots
        set drawn to the bim drawn sketches of modelValue seen from view (the bim refused id)
        loop cursor from 0 to the length of (drawn's values):
            set element to the item at cursor in (drawn's values)
            set levelFound to the bim level index of element's levelId in modelValue
            set inFolded to false
            loop foldedCursor from 0 to the length of foldedIds:
                if ((the item at foldedCursor in foldedIds) = element's id) and (element's height > 0.0):
                    set inFolded to true
            if ((element's kind = bim face sketch) and levelFound's valid) and (inFolded = false):
                set sketchSlot to the bim kept slot of element's id part (bim face sketch part) among keys unless remadeIds
                if sketchSlot >= 0:
                    append (the item at sketchSlot in previous) to result
                else:
                    set elevation to (the item at levelFound's position in (modelValue's levels's values))'s elevation
                    append (@intrinsic("construct", a bim scene mesh record, element's id, 0 as a 64 bit integer, bim face sketch part, the bim sketch mesh of element at elevation, bim mass category, the bim category colouring, the string form of "")) to result
        # Free meshes.
        loop cursor from 0 to the length of (modelValue's meshes's values):
            set meshValue to the item at cursor in (modelValue's meshes's values)
            set levelFound to the bim level index of meshValue's levelId in modelValue
            if levelFound's valid:
                set meshSlot to the bim kept slot of meshValue's id part (bim free mesh part) among keys unless remadeIds
                if meshSlot >= 0:
                    append (the item at meshSlot in previous) to result
                else:
                    set elevation to (the item at levelFound's position in (modelValue's levels's values))'s elevation
                    append (@intrinsic("construct", a bim scene mesh record, meshValue's id, 0 as a 64 bit integer, bim free mesh part, the bim mesh shape of meshValue at elevation, bim mass category, the bim category colouring, the string form of "")) to result
        free foldedIds
