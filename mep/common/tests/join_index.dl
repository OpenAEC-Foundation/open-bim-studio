# SPDX-License-Identifier: MPL-2.0
# Compare indexed joins with the original complete, ordered pair traversal.
import ui/editor/bim_editor.dl
import pattern/facade/scene.dl

function require join index {boolean:ok} named {a string:caption}:
    execute:
        if ok = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function the brute force bim connections of parts {a pointer to a list:partList} framed {a pointer to a list:frameList} in {bim model record:modelValue}:
    execute:
        set connectionList to a cad topology list of a bim connection record
        loop cursor from 0 to the length of partList:
            set part to the item at cursor in partList
            set ownFrame to the item at cursor in frameList
            if ((bim role part's kind's role connects) = false) and (ownFrame's length > 1e-9):
                set ownRank to the bim join rank of role part's kind's role upright ((the absolute value of ownFrame's along's z) > 0.99)
                loop endCursor from 0 to 2:
                    set spot to ownFrame's first
                    set outward to ownFrame's along scaled by -1.0
                    if endCursor = 1:
                        set spot to ownFrame's last
                        set outward to ownFrame's along
                    set chosen to the bim connection at end endCursor of part's element's id in modelValue
                    set met to false
                    set otherCursor to 0
                    # The first matching part owns the join. Once found, stop
                    # visiting and copying all remaining part/frame records.
                    loop while (otherCursor < (the length of partList)) and (met = false):
                        set other to the item at otherCursor in partList
                        set otherFrame to the item at otherCursor in frameList
                        if ((met = false) and (otherCursor != cursor)) and ((otherFrame's length > 1e-9) and ((bim role other's kind's role connects) = false)):
                            set otherRank to the bim join rank of role other's kind's role upright ((the absolute value of otherFrame's along's z) > 0.99)
                            set atFirst to (the cad distance from spot to otherFrame's first) <= 0.001
                            set atLast to (the cad distance from spot to otherFrame's last) <= 0.001
                            set offset to the cad difference of spot and otherFrame's first
                            set alongReach to the cad dot of offset and otherFrame's along
                            set beside to the cad difference of offset and (otherFrame's along scaled by alongReach)
                            set facing to the cad difference of outward and (otherFrame's along scaled by (the cad dot of outward and otherFrame's along))
                            if atFirst or atLast:
                                # Two ends meeting: in line they need no cut.
                                set otherEnd to 0
                                set otherOutward to otherFrame's along scaled by -1.0
                                if atLast:
                                    set otherEnd to 1
                                    set otherOutward to otherFrame's along
                                if (the cad length of (the cad sum of outward and otherOutward)) > 1e-6:
                                    set met to true
                                    set otherChosen to the bim connection at end otherEnd of other's element's id in modelValue
                                    append (@intrinsic("construct", a bim connection record, cursor, endCursor, otherCursor, otherEnd, spot, the bim join of chosen against otherChosen toward end true ranked ownRank under otherRank)) to (connectionList's values)
                            else if ((alongReach > 0.001) and (alongReach < (otherFrame's length - 0.001))) and ((the cad length of facing) > 1e-6):
                                # An end on the body of another element.
                                set towardSide to facing scaled by (1.0 / (the cad length of facing))
                                if (the cad length of beside) <= ((the bim side reach of other's kind framed otherFrame toward towardSide) + 0.001):
                                    set met to true
                                    append (@intrinsic("construct", a bim connection record, cursor, endCursor, otherCursor, -1, spot, the bim join of chosen against (bim automatic connection) toward end false ranked ownRank under otherRank)) to (connectionList's values)
                        set otherCursor to otherCursor + 1
        return connectionList

loop caseCursor from 0 to 4:
    set modelValue to an empty bim model
    set target to the address of modelValue
    set offsetX to 0.0
    set offsetY to 0.0
    if caseCursor >= 2:
        set offsetX to 500000.0
        set offsetY to 450000.0
    set ground to add bim level named (the string form of "Ground") at ((caseCursor as a 64 bit floating-point number) * 3.0) with height 3.0 to target
    set beamType to add bim linear type named (the string form of "Beam") as role (bim beam role) sized 0.2 by 0.4 round false of (the string form of "steel") to target
    set columnType to add bim linear type named (the string form of "Column") as role (bim column role) sized 0.3 by 0.3 round ((the remainder of caseCursor divided by 2) = 1) of (the string form of "concrete") to target
    set pipeType to add bim linear type named (the string form of "Pipe") as role (bim pipe role) sized 0.1 by 0.1 round true of (the string form of "steel") to target
    loop cursor from 0 to 96:
        set x to offsetX + (((the remainder of cursor divided by 12) as a 64 bit floating-point number) * 4.0)
        set y to offsetY + (((cursor / 12) as a 64 bit floating-point number) * 4.0)
        set beamId to add bim linear typed beamType on ground from (a cad vector3 with x x, y y and z 2.8) to (a cad vector3 with x (x + 4.0), y y and z 2.8) turned ((caseCursor as a 64 bit floating-point number) * 0.23) to target
        ignore add bim linear typed columnType on ground from (a cad vector3 with x x, y y and z 0.0) to (a cad vector3 with x x, y y and z 2.8) turned 0.0 to target
        set bim setting ((bim connection setting) + 1) of beamId to ((the remainder of cursor divided by 5) as a 64 bit integer) keeping true in target
        if (the remainder of cursor divided by 11) = 0:
            ignore add bim linear typed pipeType on ground from (a cad vector3 with x x, y y and z 0.0) to (a cad vector3 with x x, y y and z 2.8) turned 0.0 to target
    # Multiple valid matches at one end must keep the original first match.
    loop cursor from 0 to 24:
        set angle to (cursor as a 64 bit floating-point number) * 0.27
        ignore add bim linear typed beamType on ground from (a cad vector3 with x (offsetX - 10.0), y offsetY and z 2.8) to (a cad vector3 with x ((offsetX - 10.0) + (3.0 * (the cosine of angle))), y (offsetY + (3.0 * (the sine of angle))) and z 2.8) turned angle to target
    # End hits on either side of the exact millimetre boundary.
    loop cursor from 0 to 4:
        set x to offsetX + ((cursor as a 64 bit floating-point number) * 10.0)
        set gap to 0.001 + (((cursor - 2) as a 64 bit floating-point number) * 1e-10)
        ignore add bim linear typed beamType on ground from (a cad vector3 with x x, y (offsetY - 10.0) and z 0.0) to (a cad vector3 with x (x + 3.0), y (offsetY - 10.0) and z 0.0) turned 0.0 to target
        ignore add bim linear typed beamType on ground from (a cad vector3 with x ((x + 3.0) + gap), y (offsetY - 10.0) and z 0.0) to (a cad vector3 with x ((x + 3.0) + gap), y (offsetY - 7.0) and z 0.0) turned 0.0 to target
    set hostId to add bim curtain wall on ground from (a cad vector2 with x offsetX and y (offsetY + 50.0)) to (a cad vector2 with x (offsetX + 8.0) and y (offsetY + 50.0)) rising 3.0 in bays of 1.0 by 1.5 of (the string form of "steel") to target
    if (the remainder of caseCursor divided by 2) = 1:
        ignore set bim curtain wall hostId bulge to 0.4 in target
    set members to the bim linear parts of modelValue
    set systemMembers to the bim parts of curtain wall (the item at 0 in (modelValue's curtains's values)) in modelValue
    loop cursor from 0 to the length of (systemMembers's values):
        append (the item at cursor in (systemMembers's values)) to (members's values)
    # Degenerate axes and nonfinite dimensions must not hide exact end hits.
    set degenerate to the item at 0 in (members's values)
    set degenerate's element's finish to degenerate's element's start
    append degenerate to (members's values)
    set uncertain to the item at 1 in (members's values)
    set uncertain's kind's width to 0.0 / 0.0
    append uncertain to (members's values)
    set frames to the bim frames of parts (members's values) in modelValue
    set expected to the brute force bim connections of parts (members's values) framed (frames's values) in modelValue
    set actual to the bim connections of parts (members's values) framed (frames's values) in modelValue
    set equal to ((the length of (actual's values)) = (the length of (expected's values))) and ((the length of (actual's values)) > 100)
    if equal:
        loop cursor from 0 to the length of (actual's values):
            set a to the item at cursor in (actual's values)
            set b to the item at cursor in (expected's values)
            if (((a's ownPart != b's ownPart) or (a's ownEnd != b's ownEnd)) or ((a's otherPart != b's otherPart) or (a's otherEnd != b's otherEnd))) or (a's kind != b's kind):
                set equal to false
            if ((a's point's x != b's point's x) or (a's point's y != b's point's y)) or (a's point's z != b's point's z):
                set equal to false
    require join index equal named ((the string form of "indexed joins preserve complete traversal and first-match priority: ") + (the string form of caseCursor))
    set lookup to the bim part join index of (members's values) framed (frames's values)
    set visits to 0
    set ordered to true
    loop cursor from 0 to the length of (frames's values):
        set candidates to the bim join candidates near (the item at cursor in (frames's values))'s first in lookup
        set visits to visits + (the length of candidates)
        set previous to -1
        loop at from 0 to the length of candidates:
            set position to the item at at in candidates
            if position <= previous:
                set ordered to false
            set previous to position
        free candidates
    require join index (ordered and (visits < (((the length of (frames's values)) * (the length of (frames's values))) / 4))) named ((the string form of "spatial candidates stay ordered and prune unrelated parts: ") + (the string form of caseCursor))
