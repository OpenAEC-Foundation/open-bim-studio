# SPDX-License-Identifier: MPL-2.0
# Building services as networks. Pipes, ducts and cable trays are linear
# elements; each has a connector at both ends of its axis, pointing out of
# it, as wide as its profile. Connectors that meet (within a millimetre) are
# joined into a node. A node with one connector is an open end, with two a
# bend or a straight joint (or a change of size), with three a tee; the
# fittings belong there (step 11). Nothing here is stored: the network is
# derived from the model each time.
import bim/bim_model.dl
import architectural/stairs/bim_stair.dl

# Whether linear elements of `roleCode` carry a medium and so connect.
function bim role {integer:roleCode} connects:
    execute:
        return ((roleCode = bim pipe role) or (roleCode = bim duct role)) or (roleCode = bim cable tray role)

class:
    patterns:
        [a|] bim connector record
    members:
        elementId as a 64 bit integer
        # 0 at the axis's start, 1 at its finish.
        end as an integer
        # In model coordinates (heights above the storey's base added).
        spot as a cad vector3
        # Out of the element, a unit vector.
        direction as a cad vector3
        size as a 64 bit floating-point number
        role as an integer

class:
    patterns:
        [a|] bim network node record
    members:
        spot as a cad vector3
        # Indices into the network's connectors.
        connectors as the type of (a cad topology list of an integer)

class:
    patterns:
        [a|] bim network record
    members:
        connectors as the type of (a cad topology list of a bim connector record)
        nodes as the type of (a cad topology list of a bim network node record)

function bim open end node:
    replacement:
        1
function bim joint node:
    replacement:
        2
function bim tee node:
    replacement:
        3

# The connectors of every connecting linear element of `modelValue`.
function the bim connectors of {bim model record:modelValue}:
    execute:
        set found to a cad topology list of a bim connector record
        loop cursor from 0 to the length of (modelValue's linears's values):
            set linearValue to the item at cursor in (modelValue's linears's values)
            set linearType to the bim type of linear linearValue in modelValue
            if bim role linearType's role connects:
                set lift to 0.0
                set levelFound to the bim level index of linearValue's levelId in modelValue
                if levelFound's valid:
                    set lift to (the item at levelFound's position in (modelValue's levels's values))'s elevation
                set first to a cad vector3 with x linearValue's start's x, y linearValue's start's y and z (linearValue's start's z + lift)
                set last to a cad vector3 with x linearValue's finish's x, y linearValue's finish's y and z (linearValue's finish's z + lift)
                set axis to the cad difference of last and first
                set axisLength to the cad length of axis
                if axisLength > 1e-9:
                    set outward to axis scaled by (1.0 / axisLength)
                    append (@intrinsic("construct", a bim connector record, linearValue's id, 0, first, outward scaled by -1.0, linearType's width, linearType's role)) to (found's values)
                    append (@intrinsic("construct", a bim connector record, linearValue's id, 1, last, outward, linearType's width, linearType's role)) to (found's values)
        # The connectors of placed components (terminals, equipment), moved
        # and turned with each instance.
        loop cursor from 0 to the length of (modelValue's instances's values):
            set placement to the item at cursor in (modelValue's instances's values)
            set definitionFound to the bim component index of placement's componentId in modelValue
            if definitionFound's valid:
                set definition to the item at definitionFound's position in (modelValue's components's values)
                set lift to 0.0
                set levelFound to the bim level index of placement's levelId in modelValue
                if levelFound's valid:
                    set lift to (the item at levelFound's position in (modelValue's levels's values))'s elevation
                set cosine to the cosine of placement's angle
                set sine to the sine of placement's angle
                loop connectorCursor from 0 to the length of (definition's connectors's values):
                    set localConnector to the item at connectorCursor in (definition's connectors's values)
                    set placedSpot to a cad vector3 with x (((localConnector's spot's x * cosine) - (localConnector's spot's y * sine)) + placement's origin's x), y (((localConnector's spot's x * sine) + (localConnector's spot's y * cosine)) + placement's origin's y) and z (localConnector's spot's z + lift)
                    set placedDirection to a cad vector3 with x ((localConnector's direction's x * cosine) - (localConnector's direction's y * sine)), y ((localConnector's direction's x * sine) + (localConnector's direction's y * cosine)) and z localConnector's direction's z
                    append (@intrinsic("construct", a bim connector record, placement's id, connectorCursor, placedSpot, placedDirection, localConnector's size, localConnector's role)) to (found's values)
        return found

# The network of `modelValue`: its connectors joined into nodes where they
# meet within a millimetre.
function the bim network of {bim model record:modelValue}:
    execute:
        set found to the bim connectors of modelValue
        set joined to a cad topology list of a bim network node record
        loop cursor from 0 to the length of (found's values):
            set connector to the item at cursor in (found's values)
            set placed to false
            set ownSystem to the bim system of element connector's elementId in modelValue
            loop nodeCursor from 0 to the length of (joined's values):
                if placed = false:
                    set node to the item at nodeCursor in (joined's values)
                    set representative to the item at (the item at 0 in (node's connectors's values)) in (found's values)
                    # Coincident services of different kinds are not connected.
                    # A pipe crossing a cable tray must not create a fitting.
                    set compatible to representative's role = connector's role
                    if compatible and ((the cad distance from node's spot to connector's spot) <= 0.001):
                        set otherSystem to the bim system of element representative's elementId in modelValue
                        if ownSystem = otherSystem:
                            append cursor to (node's connectors's values)
                            set placed to true
            if placed = false:
                set members to a cad topology list of an integer
                append cursor to (members's values)
                append (@intrinsic("construct", a bim network node record, connector's spot, members)) to (joined's values)
        return @intrinsic("construct", a bim network record, found, joined)

# What `networkNode` is: an open end, a joint (two connectors) or a tee
# (three or more).
function the bim kind of node {bim network node record:networkNode}:
    execute:
        set count to the length of (networkNode's connectors's values)
        if count <= 1:
            return bim open end node
        if count = 2:
            return bim joint node
        return bim tee node

# The angle in degrees a joint turns (0 for a straight joint), from its two
# connectors' directions: two connectors in line point at each other.
function the bim turn at joint {bim network node record:networkNode} in {bim network record:network}:
    execute:
        if (the length of (networkNode's connectors's values)) != 2:
            return 0.0
        set first to the item at (the item at 0 in (networkNode's connectors's values)) in (network's connectors's values)
        set second to the item at (the item at 1 in (networkNode's connectors's values)) in (network's connectors's values)
        set along to 0.0 - (the cad dot of first's direction and second's direction)
        set sideways to the cad length of (the cad cross of first's direction and second's direction)
        return (@intrinsic("atan2", sideways, along)) * (180.0 / 3.141592653589793)

# ---------------------------------------------------------------- fittings

function bim bend fitting:
    replacement:
        1
function bim transition fitting:
    replacement:
        2
function bim junction fitting:
    replacement:
        3

# A fitting derived at a node: its kind, the node, the role and system of
# the segments it joins, and its body as short stubs of their profiles (one
# per connector, from the node outward), linear elements like the segments.
class:
    patterns:
        [a|] bim fitting record
    members:
        kind as an integer
        nodeIndex as an integer
        role as an integer
        systemId as a 64 bit integer
        firstElementId as a 64 bit integer
        stubs as the type of (a cad topology list of a bim stair part record)

function the bim name of fitting {integer:fittingKind}:
    execute:
        if fittingKind = bim bend fitting:
            return the string form of "Bend"
        if fittingKind = bim transition fitting:
            return the string form of "Transition"
        return the string form of "Junction"

# IFC's class and predefined type of a fitting of `fittingKind` on segments
# of `roleCode`.
function the bim ifc class of fitting on role {integer:roleCode}:
    execute:
        if roleCode = bim duct role:
            return the string form of "IfcDuctFitting"
        if roleCode = bim cable tray role:
            return the string form of "IfcCableCarrierFitting"
        return the string form of "IfcPipeFitting"

function the bim ifc type of fitting {integer:fittingKind}:
    execute:
        if fittingKind = bim bend fitting:
            return the string form of "BEND"
        if fittingKind = bim transition fitting:
            return the string form of "TRANSITION"
        return the string form of "JUNCTION"

# The fittings of `network`: a bend where a joint turns more than a degree,
# a transition where it joins two sizes, a junction at every tee.
function the bim fittings of {bim network record:network} in {bim model record:modelValue}:
    execute:
        set made to a cad topology list of a bim fitting record
        loop nodeCursor from 0 to the length of (network's nodes's values):
            set networkNode to the item at nodeCursor in (network's nodes's values)
            set nodeKind to the bim kind of node networkNode
            set fittingKind to 0
            if nodeKind = bim tee node:
                set fittingKind to bim junction fitting
            if nodeKind = bim joint node:
                set first to the item at (the item at 0 in (networkNode's connectors's values)) in (network's connectors's values)
                set second to the item at (the item at 1 in (networkNode's connectors's values)) in (network's connectors's values)
                if (the bim turn at joint networkNode in network) > 1.0:
                    set fittingKind to bim bend fitting
                else if (the absolute value of (first's size - second's size)) > 0.0005:
                    set fittingKind to bim transition fitting
            set onComponent to false
            loop memberCursor from 0 to the length of (networkNode's connectors's values):
                set member to the item at (the item at memberCursor in (networkNode's connectors's values)) in (network's connectors's values)
                if (the bim linear index of member's elementId in modelValue)'s valid = false:
                    set onComponent to true
            if onComponent:
                set fittingKind to 0
            if fittingKind > 0:
                set stubs to a cad topology list of a bim stair part record
                set leading to the item at (the item at 0 in (networkNode's connectors's values)) in (network's connectors's values)
                loop memberCursor from 0 to the length of (networkNode's connectors's values):
                    set connector to the item at (the item at memberCursor in (networkNode's connectors's values)) in (network's connectors's values)
                    set linearFound to the bim linear index of connector's elementId in modelValue
                    if linearFound's valid:
                        set segment to the item at linearFound's position in (modelValue's linears's values)
                        set segmentType to the bim type of linear segment in modelValue
                        set stubLength to segmentType's width * 0.75
                        set lift to 0.0
                        set levelFound to the bim level index of segment's levelId in modelValue
                        if levelFound's valid:
                            set lift to (the item at levelFound's position in (modelValue's levels's values))'s elevation
                        # The stub runs back into its segment from the node,
                        # in the segment's storey coordinates.
                        set stubFrom to a cad vector3 with x connector's spot's x, y connector's spot's y and z (connector's spot's z - lift)
                        set stubTo to the cad sum of stubFrom and (connector's direction scaled by (0.0 - stubLength))
                        set stubElement to @intrinsic("construct", a bim linear record, connector's elementId, the bim refused id, segment's levelId, stubFrom, stubTo, segment's angle, 0.0, (a cad vector2 with x 1.0 and y 1.0))
                        set stubType to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Fitting", segmentType's role, segmentType's width * 1.15, segmentType's depth * 1.15, segmentType's round, segmentType's material)
                        append (@intrinsic("construct", a bim stair part record, stubElement, stubType)) to (stubs's values)
                set systemId to the bim system of element leading's elementId in modelValue
                append (@intrinsic("construct", a bim fitting record, fittingKind, nodeCursor, leading's role, systemId, leading's elementId, stubs)) to (made's values)
        return made

# ---------------------------------------------------------------- joins

# One join for every linear element, whatever its role: a mullion, transom,
# beam, column or brace meets another as a duct meets a duct, and the join
# shapes their ends. Pipes, ducts and cable trays take fittings at their
# nodes instead (above). Two ends meeting of the same rank mitre; of unequal
# rank the lower butts against the higher's side; an end on another
# element's body of at least its rank butts against its side (a tee). Rank: column, then beam,
# then the rest; between equals an upright element wins over a level one.
# Nothing is stored: the joins are derived from where the elements lie.

# The axis of a linear element in model coordinates and the directions its
# profile's width and depth lie along.
class:
    patterns:
        [a|] bim linear frame record
    members:
        first as a cad vector3
        last as a cad vector3
        along as a cad vector3
        widthAxis as a cad vector3
        depthAxis as a cad vector3
        length as a 64 bit floating-point number

function the bim frame of linear {bim linear record:linearValue} in {bim model record:modelValue}:
    execute:
        set lift to 0.0
        set levelFound to the bim level index of linearValue's levelId in modelValue
        if levelFound's valid:
            set lift to (the item at levelFound's position in (modelValue's levels's values))'s elevation
        set first to a cad vector3 with x linearValue's start's x, y linearValue's start's y and z (linearValue's start's z + lift)
        set last to a cad vector3 with x linearValue's finish's x, y linearValue's finish's y and z (linearValue's finish's z + lift)
        set axisVector to the cad difference of last and first
        set axisLength to the cad length of axisVector
        set along to a cad vector3 with x 0.0, y 0.0 and z 1.0
        if axisLength > 1e-12:
            set along to axisVector scaled by (1.0 / axisLength)
        set across to a cad vector3 with x 1.0, y 0.0 and z 0.0
        set upward to a cad vector3 with x 0.0, y 0.0 and z 1.0
        if (the absolute value of along's z) < 0.999:
            set square to the cad difference of upward and (along scaled by along's z)
            set upward to square scaled by (1.0 / (the cad length of square))
            set across to the cad cross of upward and along
        else:
            set upward to the cad cross of along and across
        set c to the cosine of linearValue's angle
        set sn to the sine of linearValue's angle
        set widthAxis to the cad sum of (across scaled by c) and (upward scaled by sn)
        set depthAxis to the cad difference of (upward scaled by c) and (across scaled by sn)
        return @intrinsic("construct", a bim linear frame record, first, last, along, widthAxis, depthAxis, axisLength)

# How an element's ends are cut: each by the plane through `point` square to
# `normal` when `cut`, else square to its axis.
class:
    patterns:
        [a|] bim end cut record
    members:
        startCut as a boolean
        startPoint as a cad vector3
        startNormal as a cad vector3
        finishCut as a boolean
        finishPoint as a cad vector3
        finishNormal as a cad vector3

function a bim uncut end:
    execute:
        set zero to a cad vector3 with x 0.0, y 0.0 and z 0.0
        return @intrinsic("construct", a bim end cut record, false, zero, zero, false, zero, zero)

# The rank of a linear element in a join: higher ranks run through.
function the bim join rank of role {integer:roleCode} upright {boolean:upright}:
    execute:
        set rankValue to 0
        if roleCode = bim column role:
            set rankValue to 4
        if roleCode = bim beam role:
            set rankValue to 2
        if upright:
            set rankValue to rankValue + 1
        return rankValue

# How far the side of a profile (`width` by `depth`, round or not) lies from
# its axis in direction `toward` (square to the axis).
function the bim side reach of {bim linear type record:linearType} framed {bim linear frame record:sideFrame} toward {cad vector3:towardSide}:
    execute:
        if linearType's round:
            return linearType's width * 0.5
        return ((the absolute value of (the cad dot of towardSide and sideFrame's widthAxis)) * (linearType's width * 0.5)) + ((the absolute value of (the cad dot of towardSide and sideFrame's depthAxis)) * (linearType's depth * 0.5))

# ---------------------------------------------------------------- connections

# How an end of a linear element meets another element. Automatic follows the
# ranks (equal ranks mitre, the lower butts against the higher); the others
# are chosen per end: mitre, butt (cut against the other's side), through
# (runs on; the other butts against it) and open (left square, no cut).
# Later kinds (plates, bolts, notches) take the next codes.
function bim automatic connection:
    replacement:
        0
function bim mitre connection:
    replacement:
        1
function bim butt connection:
    replacement:
        2
function bim through connection:
    replacement:
        3
function bim open connection:
    replacement:
        4
function bim connection kind count:
    replacement:
        5

function the bim name of connection {integer:connectionKind}:
    execute:
        if connectionKind = bim mitre connection:
            return the string form of "Mitre"
        if connectionKind = bim butt connection:
            return the string form of "Butt"
        if connectionKind = bim through connection:
            return the string form of "Through"
        if connectionKind = bim open connection:
            return the string form of "Open"
        return the string form of "Automatic"

# The connection chosen at end `endIndex` (0 start, 1 finish) of element
# `elementId`: an element setting, automatic when it has none.
function the bim connection at end {integer:endIndex} of {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        set reading to the bim setting ((bim connection setting) + endIndex) of elementId in modelValue
        if reading's found:
            return reading's value as an integer
        return bim automatic connection

# What an end chosen `chosen` does where it meets an end chosen `facing`
# (`towardEnd`) or the body: automatic answers the other's choice, else the
# ranks decide.
function the bim join of {integer:chosen} against {integer:facing} toward end {boolean:towardEnd} ranked {integer:ownRank} under {integer:otherRank}:
    execute:
        set resolved to chosen
        if resolved = bim automatic connection:
            if towardEnd and (facing = bim mitre connection):
                set resolved to bim mitre connection
            else if towardEnd and (facing = bim butt connection):
                set resolved to bim through connection
            else if towardEnd and (facing = bim through connection):
                set resolved to bim butt connection
            else if towardEnd and (facing = bim open connection):
                set resolved to bim open connection
            else if towardEnd and (otherRank = ownRank):
                set resolved to bim mitre connection
            else if otherRank >= ownRank:
                set resolved to bim butt connection
            else:
                set resolved to bim through connection
        if (towardEnd = false) and (resolved = bim mitre connection):
            set resolved to bim butt connection
        return resolved

# Where one end of a linear part meets another: part `ownPart`'s end
# `ownEnd` (0 start, 1 finish) touches part `otherPart` at its end
# `otherEnd`, or along its body when that is -1, at `point`; `kind` is
# what the end does there.
class:
    patterns:
        [a|] bim connection record
    members:
        ownPart as an integer
        ownEnd as an integer
        otherPart as an integer
        otherEnd as an integer
        point as a cad vector3
        kind as an integer

# The connections of the ends of `partList` (`bim stair part record`s: an
# element and its type), with `frameList` their frames: each end meets the
# first part it touches, end to end at an angle or on its body. Connecting
# roles (pipes, ducts, trays) have fittings instead.
function the bim connections of parts {a pointer to a list:partList} framed {a pointer to a list:frameList} in {bim model record:modelValue}:
    execute:
        set connectionList to a cad topology list of a bim connection record
        loop cursor from 0 to the length of partList:
            set part to the item at cursor in partList
            set ownFrame to the item at cursor in frameList
            if ((bim role part's kind's role connects) = false) and (ownFrame's length > 1e-9):
                set ownRank to the bim join rank of role part's kind's role upright ((the absolute value of ownFrame's along's z) > 0.99)
                loop endCursor from 0 to 2:
                    set spot to ownFrame's first
                    set outward to ownFrame's along scaled by -1.0
                    if endCursor = 1:
                        set spot to ownFrame's last
                        set outward to ownFrame's along
                    set chosen to the bim connection at end endCursor of part's element's id in modelValue
                    set met to false
                    loop otherCursor from 0 to the length of partList:
                        set other to the item at otherCursor in partList
                        set otherFrame to the item at otherCursor in frameList
                        if ((met = false) and (otherCursor != cursor)) and ((otherFrame's length > 1e-9) and ((bim role other's kind's role connects) = false)):
                            set otherRank to the bim join rank of role other's kind's role upright ((the absolute value of otherFrame's along's z) > 0.99)
                            set atFirst to (the cad distance from spot to otherFrame's first) <= 0.001
                            set atLast to (the cad distance from spot to otherFrame's last) <= 0.001
                            set offset to the cad difference of spot and otherFrame's first
                            set alongReach to the cad dot of offset and otherFrame's along
                            set beside to the cad difference of offset and (otherFrame's along scaled by alongReach)
                            set facing to the cad difference of outward and (otherFrame's along scaled by (the cad dot of outward and otherFrame's along))
                            if atFirst or atLast:
                                # Two ends meeting: in line they need no cut.
                                set otherEnd to 0
                                set otherOutward to otherFrame's along scaled by -1.0
                                if atLast:
                                    set otherEnd to 1
                                    set otherOutward to otherFrame's along
                                if (the cad length of (the cad sum of outward and otherOutward)) > 1e-6:
                                    set met to true
                                    set otherChosen to the bim connection at end otherEnd of other's element's id in modelValue
                                    append (@intrinsic("construct", a bim connection record, cursor, endCursor, otherCursor, otherEnd, spot, the bim join of chosen against otherChosen toward end true ranked ownRank under otherRank)) to (connectionList's values)
                            else if ((alongReach > 0.001) and (alongReach < (otherFrame's length - 0.001))) and ((the cad length of facing) > 1e-6):
                                # An end on the body of another element.
                                set towardSide to facing scaled by (1.0 / (the cad length of facing))
                                if (the cad length of beside) <= ((the bim side reach of other's kind framed otherFrame toward towardSide) + 0.001):
                                    set met to true
                                    append (@intrinsic("construct", a bim connection record, cursor, endCursor, otherCursor, -1, spot, the bim join of chosen against (bim automatic connection) toward end false ranked ownRank under otherRank)) to (connectionList's values)
        return connectionList

# The frames of `partList`, in order.
function the bim frames of parts {a pointer to a list:partList} in {bim model record:modelValue}:
    execute:
        set frameList to a cad topology list of a bim linear frame record
        loop cursor from 0 to the length of partList:
            append (the bim frame of linear (the item at cursor in partList)'s element in modelValue) to (frameList's values)
        return frameList

# The cuts of each of `partList`, in order, from their connections: a mitre
# halves the angle; a butt cuts against the other's near side; an end running
# through a corner reaches the other's far side; open ends stay square.
function the bim end cuts of parts {a pointer to a list:partList} in {bim model record:modelValue}:
    execute:
        set cutList to a cad topology list of a bim end cut record
        set frameList to the bim frames of parts partList in modelValue
        set connectionList to the bim connections of parts partList framed (frameList's values) in modelValue
        loop cursor from 0 to the length of partList:
            append (a bim uncut end) to (cutList's values)
        loop cursor from 0 to the length of (connectionList's values):
            set joint to the item at cursor in (connectionList's values)
            set ownFrame to the item at joint's ownPart in (frameList's values)
            set otherFrame to the item at joint's otherPart in (frameList's values)
            set outward to ownFrame's along scaled by -1.0
            if joint's ownEnd = 1:
                set outward to ownFrame's along
            set planeFound to false
            set planePoint to joint's point
            set planeNormal to outward
            if joint's kind = bim mitre connection:
                set otherOutward to otherFrame's along scaled by -1.0
                if joint's otherEnd = 1:
                    set otherOutward to otherFrame's along
                set halving to the cad difference of outward and otherOutward
                if (the cad length of halving) > 1e-9:
                    set planeFound to true
                    set planeNormal to halving scaled by (1.0 / (the cad length of halving))
            else if joint's kind = bim butt connection:
                set facing to the cad difference of outward and (otherFrame's along scaled by (the cad dot of outward and otherFrame's along))
                if (the cad length of facing) > 1e-6:
                    set towardSide to facing scaled by (1.0 / (the cad length of facing))
                    set alongReach to the cad dot of (the cad difference of joint's point and otherFrame's first) and otherFrame's along
                    set axisPoint to the cad sum of otherFrame's first and (otherFrame's along scaled by alongReach)
                    set planeFound to true
                    set planePoint to the cad difference of axisPoint and (towardSide scaled by (the bim side reach of (the item at joint's otherPart in partList)'s kind framed otherFrame toward towardSide))
                    set planeNormal to towardSide
            else if (joint's kind = bim through connection) and (joint's otherEnd >= 0):
                # At a corner the end running through reaches the other's far
                # side, so the butting end leaves no gap.
                set facing to the cad difference of outward and (otherFrame's along scaled by (the cad dot of outward and otherFrame's along))
                if (the cad length of facing) > 0.2:
                    set towardSide to facing scaled by (1.0 / (the cad length of facing))
                    set farReach to (the bim side reach of (the item at joint's otherPart in partList)'s kind framed otherFrame toward towardSide) / (the cad length of facing)
                    set planeFound to true
                    set planePoint to the cad sum of joint's point and (outward scaled by farReach)
                    set planeNormal to outward
            if planeFound:
                set endCut to the item at joint's ownPart in (cutList's values)
                if joint's ownEnd = 0:
                    set endCut's startCut to true
                    set endCut's startPoint to planePoint
                    set endCut's startNormal to planeNormal
                else:
                    set endCut's finishCut to true
                    set endCut's finishPoint to planePoint
                    set endCut's finishNormal to planeNormal
                replace item at index joint's ownPart in (cutList's values) with endCut
        return cutList

# The parts (`bim stair part record`s) of every linear element of
# `modelValue`, in order, for `the bim end cuts of parts`.
function the bim linear parts of {bim model record:modelValue}:
    execute:
        set found to a cad topology list of a bim stair part record
        loop cursor from 0 to the length of (modelValue's linears's values):
            set linearValue to the item at cursor in (modelValue's linears's values)
            append (@intrinsic("construct", a bim stair part record, linearValue, the bim type of linear linearValue in modelValue)) to (found's values)
        return found
