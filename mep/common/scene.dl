# SPDX-License-Identifier: MPL-2.0
# The common module's part of the scene: the fittings derived at the network's nodes. Called by the
# composed dispatcher (`append bim module scene meshes of`) in layer order;
# the order does not matter, kept meshes are found by element id and part.
import viewer/bim_scene.dl

function append bim scene meshes of {bim model record:modelValue} within {a 64 bit floating-point number:tolerance} reusing {a pointer to a list:previous} keyed {a pointer to a list:keys} refreshing {a pointer to a list:remadeIds} with reinforcement detail {boolean:rebarDetail} into {a pointer to a list:result} with mep_common elements:
    execute:
        # Fittings, derived at the network's nodes: each picks as the first
        # segment it joins and takes its colour. The network is derived only
        # when every element is made again, when nothing was made before, or
        # when one of the kept fittings is; otherwise the kept fittings stay
        # as they are.
        set derivingFittings to ((the length of remadeIds) = 0) or ((the length of previous) = 0)
        set keptFittings to an empty list of an integer
        loop slot from 0 to the length of previous:
            set entry to the item at slot in previous
            if entry's part >= (bim fitting part base):
                append slot to keptFittings
                if bim element entry's elementId is remade among remadeIds:
                    set derivingFittings to true
        if derivingFittings:
            set servicesNetwork to the bim network of modelValue
            set derivedFittings to the bim fittings of servicesNetwork in modelValue
            set fittingIds to an empty list of a 64 bit integer
            loop cursor from 0 to the length of (derivedFittings's values):
                set fittingValue to the item at cursor in (derivedFittings's values)
                # The part counts the fittings on the same first segment.
                set fittingPart to bim fitting part base
                loop earlier from 0 to the length of fittingIds:
                    if (the item at earlier in fittingIds) = fittingValue's firstElementId:
                        set fittingPart to fittingPart + 1
                append fittingValue's firstElementId to fittingIds
                set fittingColour to the bim material colour of (the string form of "steel")
                if fittingValue's systemId != the bim refused id:
                    set fittingColour to the bim colour of discipline (the item at (the bim system index of fittingValue's systemId in modelValue)'s position in (modelValue's systems's values))'s discipline
                append (@intrinsic("construct", a bim scene mesh record, fittingValue's firstElementId, 0 as a 64 bit integer, fittingPart, the bim shape of derived parts (fittingValue's stubs's values) in modelValue within tolerance, bim other category, fittingColour, the string form of "")) to result
            free fittingIds
        else:
            loop cursor from 0 to the length of keptFittings:
                append (the item at (the item at cursor in keptFittings) in previous) to result
        free keptFittings
