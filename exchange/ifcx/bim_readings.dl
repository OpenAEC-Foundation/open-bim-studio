# SPDX-License-Identifier: MPL-2.0
# Numbers read from text tokens, as the .bim reader, the libraries and the
# editor's fields read them: a decimal real or a whole number, refused
# otherwise.
import lib/std.dl
import lib/string.dl
import lib/text.dl

class:
    patterns:
        [a|] bim real reading record
    members:
        valid as a boolean
        value as a 64 bit floating-point number

class:
    patterns:
        [a|] bim whole reading record
    members:
        valid as a boolean
        value as a 64 bit integer

# `token` as a NUL-terminated copy, for the C number parsers.
local function the bim terminated copy of {a string:token}:
    execute:
        set buffer to a new string buffer containing (the length of token) bytes
        copy token into (the data of buffer) at offset 0
        store (0 as a byte) into the data of buffer at (the length of token)
        return buffer

local function bim token {a string:token} uses only {a string:allowed}:
    execute:
        if ((the length of token) = 0) or ((the length of token) > 40):
            return false
        loop cursor from 0 to the length of token:
            set character to the character at cursor in token
            set known to false
            loop slot from 0 to the length of allowed:
                if (the character at slot in allowed) = character:
                    set known to true
            if known = false:
                return false
        return true

# A decimal real written as C's `strtod` reads it, finite; no other text.
function the bim real reading of {a string:token}:
    execute:
        set refused to @intrinsic("construct", a bim real reading record, false, 0.0)
        if (bim token token uses only (the string form of "0123456789+-.eE")) = false:
            return refused
        set terminatedToken to the bim terminated copy of token
        set ending to (0 as a pointer to a byte)
        set value to @intrinsic("call", "libc", "strtod", a 64 bit floating-point number, the data of terminatedToken, the address of ending)
        if ending != ((the data of terminatedToken) + (the length of token)):
            return refused
        if (value - value) != 0.0:
            return refused
        return @intrinsic("construct", a bim real reading record, true, value)

# A decimal integer that fits 64 bits; no other text.
function the bim whole reading of {a string:token}:
    execute:
        set refused to @intrinsic("construct", a bim whole reading record, false, 0 as a 64 bit integer)
        if (bim token token uses only (the string form of "0123456789-")) = false:
            return refused
        if (the length of token) > 19:
            return refused
        set terminatedToken to the bim terminated copy of token
        set ending to (0 as a pointer to a byte)
        set value to @intrinsic("call", "libc", "strtoll", a 64 bit integer, the data of terminatedToken, the address of ending, 10)
        if ending != ((the data of terminatedToken) + (the length of token)):
            return refused
        return @intrinsic("construct", a bim whole reading record, true, value)
