# SPDX-License-Identifier: MPL-2.0
# The native file format of the BIM slice: the model as text, one record per
# line, keeping every id, so that a saved and reopened model is the same model.
# Numbers are written with 17 significant digits, which read back to the same
# binary64 value. The first line is `BIM-SLICE 1`; the records follow in any
# order:
#
#     next <next id>
#     level <id> <elevation> <height> <name>
#     walltype <id> <name>
#     planartype <id> <role: 1 floor, 2 roof, 3 ceiling> <name>
#                                            a planar type of another role than wall; its layers
#                                            follow it, as a walltype's do
#     layer <thickness> <material>           a layer of the walltype above it
#     wall <id> <type> <level> <start x> <start y> <finish x> <finish y> <height> [<bulge> [<lean> <rise>]]
#     wallbase <wall id> <offset>              its foot above its level
#     walltop <wall id> <level>               the level its top is held at
#     openingtype <id> <width> <height> <sill> <frame> <door: 0 or 1> <name>
#     opening <id> <type> <host> <offset>
#     spaceobject <id> <level> <height> <corner-count> <x y...> <name>
#     spacenumber <id> <number>           optional identifier of a persistent space
#     tag <id> <element> <x> <y>             a tag of the element's type, centred at (x, y)
#     view <id> <kind> <level> <detail> <cut height> <scale> <cropped: 0 or 1> <low x> <low y>
#          <high x> <high y> <line x> <line y> <line end x> <line end y>
#          <shown: one 0 or 1 per category> <halftone: the same> <name>
#     stair <id> <level> <x> <y> <end x> <end y> <width> <risers> <material>
#                                            a straight stair climbing to the storey above
#     railing <id> <level> <host stair or 0> <height> <point count> <x> <y> ... <material>
#                                            a railing along its points (on its stair when hosted)
#     curtain <id> <level> <x> <y> <end x> <end y> <height> <bay width> <row height> <material>
#                                            a curtain wall of mullions, transoms and glass
#     settings <element> <count> <code> <value> ...
#                                            an element's extra data, whole numbers (codes:
#                                            `bim_model.dl`, element settings)
#     property <element> <type length> <set length> <name length> <type><set><name><value>
#                                            a property of an element (`bim pset entry record`):
#                                            its IFC value type, set name, name and value
#                                            written one after the other, the first three
#                                            as long as the lengths (bytes) say
#     system <id> <discipline> <member count> <member> ... <name>
#                                            a building services system and its elements
#     sheet <id> <paper: 0 A0 … 4 A4> <landscape: 0 or 1> <viewport count>
#           (<view> <x> <y> <model x> <model y>) … <number> <name>
#                                            a drawing sheet, its views placed at sheet millimetres
#                                            a view kept with the model (kinds: `bim_model.dl`)
#     dimension <id> <element> <feature> <element> <feature> [<x> <y>]
#                                            the dimension line through (x, y) when given
#     slab <id> <level> <thickness> <corner count> <x> <y> ... [<material>]
#                                            (concrete when it is left out)
#     plate <id> <type> <level> <top> <pitch> <heading> <corner count> <x> <y> ...
#                                            a floor, roof or ceiling of a planar type (`slab` lines
#                                            are floors of their own thickness)
#     grid <id> <start x> <start y> <finish x> <finish y> <low> <high> <name>
#     sketch <id> <level> <kind: 0 line, 1 face, 2 text> <height> <point count> <x> <y> ... [<text>]
#     component <id> <name>
#     part <id> 0 <kind> <height> <point count> <x> <y> ... [<text>]    a sketch element of the component above it, in its coordinates
#     solid <kind> <operation> <x> <y> <z> <size x> <size y> <size z> <angle> <point count> <x> <y> ...
#           <mesh point count> <x> <y> <z> ... <face entry count> <entry> ... <material>
#                                            a solid part of the component above it (kinds and
#                                            operations: `bim_model.dl`; points: an extrusion's
#                                            profile; the mesh: a mesh part's, as in `mesh` lines)
#     connector <component role> <x> <y> <z> <dx> <dy> <dz> <size> <segment role>
#                                            a connector of the component above it, and the
#                                            component's role (terminal, equipment)
#     instance <id> <component> <level> <origin x> <origin y> <angle> [<view>]
#                                            drawn only in that view when given (a 2D detail)
#     mesh <id> <level> <point count> <x> <y> <z> ... <face entry count> <entry> ...
#                                            a free mesh: its points, then each face as its
#                                            point count followed by that many point numbers
#     lineartype <id> <role> <width> <depth> <round: 0 or 1> <material> <name>
#                                            what linear elements are (roles: `bim_model.dl`)
#     linear <id> <type> <level> <x> <y> <z> <end x> <end y> <end z> <angle>
#                                            a linear element along its axis (heights above its storey)
#     units <mm, cm or m>                    the project's length units (lengths are stored in metres)
#     viewrule <view kind> <category> <visible: 0 or 1> <halftone: 0 or 1>
#
# View kinds and categories are those of `bim_view.dl`; view rules belong to
# the editor's views, not to the model.
#
# Fields are separated by one space; a name or material is the rest of its
# line, and a line break in one is written as a space. Records of one kind
# appear in ascending id order. Reading refuses anything else, naming the
# line or the element: an unknown record, a malformed number, a missing or
# repeated `next`, an id used twice or not below `next`, a reference to a
# missing element, or a value that the model's edits would refuse, such as a
# slab outline that crosses itself.
import bim/bim_index.dl
import views/common/bim_view.dl
import lib/text.dl
import exchange/ifcx/bim_readings.dl

# ---------------------------------------------------------------- files

class:
    patterns:
        [a|] bim text reading record
    members:
        valid as a boolean
        text as a string

# Writes `content` to the file at `path`; false when the file cannot be
# written.
function write bim text {a string:content} to file {a string:path}:
    execute:
        set handle to @intrinsic("call", "libc", "fopen", a pointer to a byte, the data of path, "wb")
        if handle = (0 as a pointer to a byte):
            return false
        set written to @intrinsic("call", "libc", "fwrite", a word sized integer, the data of content, 1 as a word sized integer, (the length of content) as a word sized integer, handle)
        set closed to @intrinsic("call", "libc", "fclose", integer, handle)
        return (written = ((the length of content) as a word sized integer)) and (closed = 0)

# The whole content of the file at `path`; invalid when it cannot be read.
function the bim file content at {a string:path}:
    execute:
        set failure to @intrinsic("construct", a bim text reading record, false, the string form of "")
        set handle to @intrinsic("call", "libc", "fopen", a pointer to a byte, the data of path, "rb")
        if handle = (0 as a pointer to a byte):
            return failure
        # Its size in 64 bits on every platform (`ftell` is 32 bits on
        # Windows), read from the start again (`platform/obs_platform.c`).
        set size to @intrinsic("call", "obs_platform", "obs_platform_file_size", a 64 bit integer, handle)
        if (size < (0 as a 64 bit integer)) or (size > ((the maximum string buffer length) as a 64 bit integer)):
            ignore @intrinsic("call", "libc", "fclose", integer, handle)
            return failure
        set stored to a new string buffer containing (size as an integer) bytes
        set got to @intrinsic("call", "libc", "fread", a word sized integer, the data of stored, 1 as a word sized integer, size as a word sized integer, handle)
        ignore @intrinsic("call", "libc", "fclose", integer, handle)
        if got != (size as a word sized integer):
            return failure
        return @intrinsic("construct", a bim text reading record, true, stored)

# ---------------------------------------------------------------- writing

# `value` with 17 significant digits, enough to read back the same binary64.
function the bim exact text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.17g", value)
        return the substring of buffer from 0 spanning written bytes

local function the bim file name of {a string:label}:
    execute:
        return (label with "\n" replaced by " ") with "\r" replaced by " "

# The `property` line of `psetEntry` (see the format above). A line break
# becomes a space, one byte for one, so the lengths still hold.
function the bim pset file text of {bim pset entry record:psetEntry}:
    execute:
        set psetHead to ((the string form of "property ") + (the string form of psetEntry's elementId)) + ((the string form of " ") + (the string form of (the length of psetEntry's valueType)))
        set psetHead to (psetHead + ((the string form of " ") + (the string form of (the length of psetEntry's setName)))) + ((the string form of " ") + (the string form of (the length of psetEntry's name)))
        return (psetHead + (the string form of " ")) + ((psetEntry's valueType + (the bim file name of psetEntry's setName)) + ((the bim file name of psetEntry's name) + (the bim file name of psetEntry's value)))

# Drawing-type settings as one field: `-` inherited, else the digit; at
# least one character, so that an empty list still makes a field.
function the bim setting text of {a pointer to a list:settings}:
    execute:
        set parts to an empty list of a string
        loop cursor from 0 to the length of settings:
            set settingValue to the item at cursor in settings
            if settingValue < 0:
                append (the string form of "-") to parts
            else:
                append (the string form of settingValue) to parts
        if (the length of parts) = 0:
            append (the string form of "-") to parts
        set joined to parts joined with ""
        free parts
        return joined

# The settings of a field written by `the bim setting text of`.
function the bim settings of text {a string:field}:
    execute:
        set settingList to a cad topology list of an integer
        loop cursor from 0 to the length of field:
            set code to the character at cursor in field
            if (code >= 48) and (code <= 57):
                append (code - 48) to (settingList's values)
            else:
                append -1 to (settingList's values)
        return settingList

# Whether `text` is a field of flags: only 0 and 1, one per category.
function bim text {a string:field} is flags:
    execute:
        # Files written before the pile category have one flag fewer.
        if ((the length of field) < 18) or ((the length of field) > (the bim category count)):
            return false
        loop cursor from 0 to the length of field:
            set code to the character at cursor in field
            if (code != 48) and (code != 49):
                return false
        return true

# Flags as one field of 0 and 1, and back.
function the bim flag text of {a pointer to a list:flags}:
    execute:
        set buffer to a new string buffer containing ((the length of flags) + 1) bytes
        loop cursor from 0 to the length of flags:
            if the item at cursor in flags:
                store (49 as a byte) into the data of buffer at cursor
            else:
                store (48 as a byte) into the data of buffer at cursor
        return the substring of buffer from 0 spanning (the length of flags) bytes

local function the bim joined fields of {a pointer to a list:pieces}:
    execute:
        return pieces joined with " "

# Versioned, explicit reinforcement parameters; generated bars are never saved.
function the bim reinforcement payload of {bim model record:modelValue}:
    execute:
        set lines to an empty list of a string
        set pieces to an empty list of a string
        loop cursor from 0 to the length of (modelValue's reinforcements's values):
            set spec to the item at cursor in (modelValue's reinforcements's values)
            clear pieces
            append (the string form of "reinforcement") to pieces
            append (the string form of spec's id) to pieces
            append (the string form of spec's levelId) to pieces
            append (the string form of spec's hostId) to pieces
            append (the string form of spec's kind) to pieces
            append (the bim exact text of spec's start's x) to pieces
            append (the bim exact text of spec's start's y) to pieces
            append (the bim exact text of spec's start's z) to pieces
            append (the bim exact text of spec's finish's x) to pieces
            append (the bim exact text of spec's finish's y) to pieces
            append (the bim exact text of spec's finish's z) to pieces
            append (the bim exact text of spec's width) to pieces
            append (the bim exact text of spec's depth) to pieces
            append (the bim exact text of spec's diameter) to pieces
            append (the bim exact text of spec's secondaryDiameter) to pieces
            append (the bim exact text of spec's spacing) to pieces
            append (the bim exact text of spec's crossSpacing) to pieces
            append (the bim exact text of spec's cover) to pieces
            append (the bim exact text of spec's bendRadius) to pieces
            append ((spec's mark with " " replaced by "_") with "\n" replaced by "_") to pieces
            append (the string form of spec's topCount) to pieces
            append (the string form of spec's bottomCount) to pieces
            append (the bim exact text of spec's topDiameter) to pieces
            append (the bim exact text of spec's bottomDiameter) to pieces
            append (the string form of spec's cageType) to pieces
            append (the bim exact text of spec's startZoneLength) to pieces
            append (the bim exact text of spec's startZoneSpacing) to pieces
            append (the bim exact text of spec's endZoneLength) to pieces
            append (the bim exact text of spec's endZoneSpacing) to pieces
            append (the string form of spec's extraTopCount) to pieces
            append (the bim exact text of spec's extraTopDiameter) to pieces
            append (the string form of spec's extraBottomCount) to pieces
            append (the bim exact text of spec's extraBottomDiameter) to pieces
            append (the bim exact text of spec's extraFrom) to pieces
            append (the bim exact text of spec's extraTo) to pieces
            append (the string form of spec's areaMode) to pieces
            append (the string form of spec's faceMask) to pieces
            append (the bim exact text of spec's farDiameter) to pieces
            append (the bim exact text of spec's farSecondaryDiameter) to pieces
            append (the bim exact text of spec's farSpacing) to pieces
            append (the bim exact text of spec's farCrossSpacing) to pieces
            append (the bim exact text of spec's curveRadius) to pieces
            append (the string form of spec's meshType) to pieces
            append spec's steelKey to pieces
            append spec's secondarySteelKey to pieces
            append (pieces joined with " ") to lines
        set text to lines joined with "\n"
        free pieces
        free lines
        return text


function the bim fastener parameter text of {connection fastener parameters:parameters}:
    execute:
        set pieces to an empty list of a string
        append (the bim exact text of parameters's pitch) to pieces
        append (the bim exact text of parameters's threadLength) to pieces
        append (the string form of parameters's grade) to pieces
        append (the string form of parameters's coating) to pieces
        append (the string form of parameters's washers) to pieces
        append (the string form of parameters's nuts) to pieces
        append (the string form of parameters's nutClass) to pieces
        append (the bim exact text of parameters's grip) to pieces
        append (the string form of parameters's anchorShape) to pieces
        append (the bim exact text of parameters's bendRadius) to pieces
        append (the bim exact text of parameters's tailLength) to pieces
        set threadFlag to 0
        if parameters's showThread:
            set threadFlag to 1
        append (the string form of threadFlag) to pieces
        append (the string form of parameters's headSeries) to pieces
        set catalogueFlag to 0
        if parameters's catalogue:
            set catalogueFlag to 1
        append (the string form of catalogueFlag) to pieces
        set resultValue to pieces joined with " "
        free pieces
        return resultValue

function the bim connection records of {a pointer to a list:definitions} labelled {a string:recordKind}:
    execute:
        set lines to an empty list of a string
        set pieces to an empty list of a string
        loop cursor from 0 to the length of definitions:
            set spec to the item at cursor in definitions
            clear pieces
            append (recordKind) to pieces
            append (the string form of spec's id) to pieces
            append (the string form of spec's levelId) to pieces
            append (the string form of spec's category) to pieces
            append (the string form of spec's style) to pieces
            append (the bim exact text of spec's origin's x) to pieces
            append (the bim exact text of spec's origin's y) to pieces
            append (the bim exact text of spec's origin's z) to pieces
            append ((spec's name with " " replaced by "_") with "\n" replaced by "_") to pieces
            append (pieces joined with " ") to lines
            loop memberCursor from 0 to the length of (spec's members's values):
                set memberValue to the item at memberCursor in (spec's members's values)
                clear pieces
                append (recordKind + (the string form of "member")) to pieces
                append (the string form of spec's id) to pieces
                append (the string form of memberValue's elementId) to pieces
                append (the string form of memberValue's end) to pieces
                append (the bim exact text of memberValue's setback) to pieces
                append (the bim exact text of memberValue's position) to pieces
                append (pieces joined with " ") to lines
            loop partCursor from 0 to the length of (spec's additions's values):
                set partValue to the item at partCursor in (spec's additions's values)
                clear pieces
                append (recordKind + (the string form of "part")) to pieces
                append (the string form of spec's id) to pieces
                append (the string form of partValue's key) to pieces
                append (the string form of partValue's memberId) to pieces
                append (the string form of partValue's kind) to pieces
                append (the bim exact text of partValue's origin's x) to pieces
                append (the bim exact text of partValue's origin's y) to pieces
                append (the bim exact text of partValue's origin's z) to pieces
                append (the bim exact text of partValue's axis's x) to pieces
                append (the bim exact text of partValue's axis's y) to pieces
                append (the bim exact text of partValue's axis's z) to pieces
                append (the bim exact text of partValue's width) to pieces
                append (the bim exact text of partValue's height) to pieces
                append (the bim exact text of partValue's thickness) to pieces
                append (the bim exact text of partValue's diameter) to pieces
                append (the bim exact text of partValue's length) to pieces
                append (the string form of partValue's rows) to pieces
                append (the string form of partValue's columns) to pieces
                append (the bim exact text of partValue's rowPitch) to pieces
                append (the bim exact text of partValue's columnPitch) to pieces
                append (the bim exact text of partValue's holeDiameter) to pieces
                append (pieces joined with " ") to lines
                set parameterText to the bim fastener parameter text of partValue's parameters
                if parameterText != (the bim fastener parameter text of (default connection fastener parameters)):
                    append (((recordKind + (the string form of "fastener ")) + ((the string form of spec's id) + (the string form of " "))) + (((the string form of partValue's key) + (the string form of " ")) + parameterText)) to lines
        set text to lines joined with "\n"
        free pieces
        free lines
        return text


# The file text of `modelValue`.
function the bim connection payload of {bim model record:modelValue}:
    execute:
        set nodes to the bim connection records of (modelValue's connections's values) labelled (the string form of "connection")
        set types to the bim connection records of (modelValue's connectionTypes's values) labelled (the string form of "connectiontype")
        set payloadLines to an empty list of a string
        if nodes != (the string form of ""):
            append nodes to payloadLines
        if types != (the string form of ""):
            append types to payloadLines
        loop bindingCursor from 0 to the length of (modelValue's fastenerComponents's values):
            set bindingValue to the item at bindingCursor in (modelValue's fastenerComponents's values)
            set pieces to an empty list of a string
            append (the string form of "fastenercomponent") to pieces
            append (the string form of bindingValue's componentId) to pieces
            append (the string form of bindingValue's librarySlot) to pieces
            append (the string form of bindingValue's kind) to pieces
            append (the bim exact text of bindingValue's diameter) to pieces
            append (the bim exact text of bindingValue's length) to pieces
            append (the bim fastener parameter text of bindingValue's parameters) to pieces
            append (pieces joined with " ") to payloadLines
            free pieces
        set resultValue to payloadLines joined with "\n"
        free payloadLines
        return resultValue


function the bim file text of {bim model record:modelValue}:
    execute:
        set lines to an empty list of string
        append (the string form of "BIM-SLICE 1") to lines
        append ((the string form of "next ") + (the string form of modelValue's nextId)) to lines
        set pieces to an empty list of string
        loop cursor from 0 to the length of (modelValue's levels's values):
            set levelValue to the item at cursor in (modelValue's levels's values)
            clear pieces
            append (the string form of "level") to pieces
            append (the string form of levelValue's id) to pieces
            append (the bim exact text of levelValue's elevation) to pieces
            append (the bim exact text of levelValue's height) to pieces
            append (the bim file name of levelValue's name) to pieces
            append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's wallTypes's values):
            set wallType to the item at cursor in (modelValue's wallTypes's values)
            if wallType's role = bim wall planar role:
                append (((the string form of "walltype ") + (the string form of wallType's id)) + ((the string form of " ") + (the bim file name of wallType's name))) to lines
            else:
                append (((the string form of "planartype ") + (the string form of wallType's id)) + (((the string form of " ") + (the string form of wallType's role)) + ((the string form of " ") + (the bim file name of wallType's name)))) to lines
            loop layerCursor from 0 to the length of (wallType's layers's values):
                set layerValue to the item at layerCursor in (wallType's layers's values)
                append (((the string form of "layer ") + (the bim exact text of layerValue's thickness)) + ((the string form of " ") + (the bim file name of layerValue's material))) to lines
        loop cursor from 0 to the length of (modelValue's walls's values):
            set wallValue to the item at cursor in (modelValue's walls's values)
            clear pieces
            append (the string form of "wall") to pieces
            append (the string form of wallValue's id) to pieces
            append (the string form of wallValue's typeId) to pieces
            append (the string form of wallValue's levelId) to pieces
            append (the bim exact text of wallValue's start's x) to pieces
            append (the bim exact text of wallValue's start's y) to pieces
            append (the bim exact text of wallValue's finish's x) to pieces
            append (the bim exact text of wallValue's finish's y) to pieces
            append (the bim exact text of wallValue's height) to pieces
            set shaped to (wallValue's lean != 0.0) or (wallValue's rise != 0.0)
            if (wallValue's bulge != 0.0) or shaped:
                append (the bim exact text of wallValue's bulge) to pieces
            if shaped:
                append (the bim exact text of wallValue's lean) to pieces
                append (the bim exact text of wallValue's rise) to pieces
            append (the bim joined fields of pieces) to lines
        # A wall standing off its level: `wallbase id offset`.
        loop cursor from 0 to the length of (modelValue's walls's values):
            set wallValue to the item at cursor in (modelValue's walls's values)
            if wallValue's baseOffset != 0.0:
                append (((the string form of "wallbase ") + (the string form of wallValue's id)) + ((the string form of " ") + (the bim exact text of wallValue's baseOffset))) to lines
        # A wall whose top is held at a level: `walltop id level`.
        loop cursor from 0 to the length of (modelValue's walls's values):
            set wallValue to the item at cursor in (modelValue's walls's values)
            if wallValue's topLevelId != the bim refused id:
                append (((the string form of "walltop ") + (the string form of wallValue's id)) + ((the string form of " ") + (the string form of wallValue's topLevelId))) to lines
        loop cursor from 0 to the length of (modelValue's openingTypes's values):
            set openingType to the item at cursor in (modelValue's openingTypes's values)
            clear pieces
            append (the string form of "openingtype") to pieces
            append (the string form of openingType's id) to pieces
            append (the bim exact text of openingType's width) to pieces
            append (the bim exact text of openingType's height) to pieces
            append (the bim exact text of openingType's sill) to pieces
            append (the bim exact text of openingType's frame) to pieces
            if openingType's isDoor:
                append (the string form of "1") to pieces
            else:
                append (the string form of "0") to pieces
            append (the bim file name of openingType's name) to pieces
            append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's openings's values):
            set openingValue to the item at cursor in (modelValue's openings's values)
            clear pieces
            append (the string form of "opening") to pieces
            append (the string form of openingValue's id) to pieces
            append (the string form of openingValue's typeId) to pieces
            append (the string form of openingValue's hostId) to pieces
            append (the bim exact text of openingValue's offset) to pieces
            append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's dimensions's values):
            set dimension to the item at cursor in (modelValue's dimensions's values)
            clear pieces
            append (the string form of "dimension") to pieces
            append (the string form of dimension's id) to pieces
            append (the string form of dimension's first's elementId) to pieces
            append (the string form of dimension's first's feature) to pieces
            append (the string form of dimension's second's elementId) to pieces
            append (the string form of dimension's second's feature) to pieces
            if dimension's placed:
                append (the bim exact text of dimension's place's x) to pieces
                append (the bim exact text of dimension's place's y) to pieces
            append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's slabs's values):
            set slabValue to the item at cursor in (modelValue's slabs's values)
            clear pieces
            if (the bim wall type index of slabValue's typeId in modelValue)'s valid:
                append (the string form of "plate") to pieces
                append (the string form of slabValue's id) to pieces
                append (the string form of slabValue's typeId) to pieces
                append (the string form of slabValue's levelId) to pieces
                append (the bim exact text of slabValue's top) to pieces
                append (the bim exact text of slabValue's pitch) to pieces
                append (the bim exact text of slabValue's heading) to pieces
                append (the string form of (the length of (slabValue's outline's values))) to pieces
                loop corner from 0 to the length of (slabValue's outline's values):
                    append (the bim exact text of (the item at corner in (slabValue's outline's values))'s x) to pieces
                    append (the bim exact text of (the item at corner in (slabValue's outline's values))'s y) to pieces
                append (the bim joined fields of pieces) to lines
            else:
                append (the string form of "slab") to pieces
                append (the string form of slabValue's id) to pieces
                append (the string form of slabValue's levelId) to pieces
                append (the bim exact text of slabValue's thickness) to pieces
                append (the string form of (the length of (slabValue's outline's values))) to pieces
                loop corner from 0 to the length of (slabValue's outline's values):
                    append (the bim exact text of (the item at corner in (slabValue's outline's values))'s x) to pieces
                    append (the bim exact text of (the item at corner in (slabValue's outline's values))'s y) to pieces
                if slabValue's material != (the string form of "concrete"):
                    append (the bim file name of slabValue's material) to pieces
                append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's grids's values):
            set gridValue to the item at cursor in (modelValue's grids's values)
            clear pieces
            append (the string form of "grid") to pieces
            append (the string form of gridValue's id) to pieces
            append (the bim exact text of gridValue's start's x) to pieces
            append (the bim exact text of gridValue's start's y) to pieces
            append (the bim exact text of gridValue's finish's x) to pieces
            append (the bim exact text of gridValue's finish's y) to pieces
            append (the bim exact text of gridValue's low) to pieces
            append (the bim exact text of gridValue's high) to pieces
            append (the bim file name of gridValue's name) to pieces
            append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's sketches's values):
            append (the bim sketch line of (the item at cursor in (modelValue's sketches's values)) labelled (the string form of "sketch")) to lines
        loop cursor from 0 to the length of (modelValue's components's values):
            set definition to the item at cursor in (modelValue's components's values)
            append (((the string form of "component ") + (the string form of definition's id)) + ((the string form of " ") + (the bim file name of definition's name))) to lines
            loop part from 0 to the length of (definition's sketches's values):
                append (the bim sketch line of (the item at part in (definition's sketches's values)) labelled (the string form of "part")) to lines
            loop part from 0 to the length of (definition's connectors's values):
                set connectorValue to the item at part in (definition's connectors's values)
                clear pieces
                append (the string form of "connector") to pieces
                append (the string form of definition's role) to pieces
                append (the bim exact text of connectorValue's spot's x) to pieces
                append (the bim exact text of connectorValue's spot's y) to pieces
                append (the bim exact text of connectorValue's spot's z) to pieces
                append (the bim exact text of connectorValue's direction's x) to pieces
                append (the bim exact text of connectorValue's direction's y) to pieces
                append (the bim exact text of connectorValue's direction's z) to pieces
                append (the bim exact text of connectorValue's size) to pieces
                append (the string form of connectorValue's role) to pieces
                append (the bim joined fields of pieces) to lines
            loop part from 0 to the length of (definition's solids's values):
                set solidPart to the item at part in (definition's solids's values)
                clear pieces
                append (the string form of "solid") to pieces
                append (the string form of solidPart's kind) to pieces
                append (the string form of solidPart's operation) to pieces
                append (the bim exact text of solidPart's origin's x) to pieces
                append (the bim exact text of solidPart's origin's y) to pieces
                append (the bim exact text of solidPart's origin's z) to pieces
                append (the bim exact text of solidPart's size's x) to pieces
                append (the bim exact text of solidPart's size's y) to pieces
                append (the bim exact text of solidPart's size's z) to pieces
                append (the bim exact text of solidPart's angle) to pieces
                append (the string form of (the length of (solidPart's profile's values))) to pieces
                loop corner from 0 to the length of (solidPart's profile's values):
                    append (the bim exact text of (the item at corner in (solidPart's profile's values))'s x) to pieces
                    append (the bim exact text of (the item at corner in (solidPart's profile's values))'s y) to pieces
                append (the string form of (the length of (solidPart's points's values))) to pieces
                loop corner from 0 to the length of (solidPart's points's values):
                    append (the bim exact text of (the item at corner in (solidPart's points's values))'s x) to pieces
                    append (the bim exact text of (the item at corner in (solidPart's points's values))'s y) to pieces
                    append (the bim exact text of (the item at corner in (solidPart's points's values))'s z) to pieces
                append (the string form of (the length of (solidPart's faces's values))) to pieces
                loop corner from 0 to the length of (solidPart's faces's values):
                    append (the string form of (the item at corner in (solidPart's faces's values))) to pieces
                append (the bim file name of solidPart's material) to pieces
                append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's instances's values):
            set placement to the item at cursor in (modelValue's instances's values)
            clear pieces
            append (the string form of "instance") to pieces
            append (the string form of placement's id) to pieces
            append (the string form of placement's componentId) to pieces
            append (the string form of placement's levelId) to pieces
            append (the bim exact text of placement's origin's x) to pieces
            append (the bim exact text of placement's origin's y) to pieces
            append (the bim exact text of placement's angle) to pieces
            if placement's viewId != the bim refused id:
                append (the string form of placement's viewId) to pieces
            append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's meshes's values):
            set meshValue to the item at cursor in (modelValue's meshes's values)
            clear pieces
            append (the string form of "mesh") to pieces
            append (the string form of meshValue's id) to pieces
            append (the string form of meshValue's levelId) to pieces
            append (the string form of (the length of (meshValue's vertices's values))) to pieces
            loop corner from 0 to the length of (meshValue's vertices's values):
                set point to the item at corner in (meshValue's vertices's values)
                append (the bim exact text of point's x) to pieces
                append (the bim exact text of point's y) to pieces
                append (the bim exact text of point's z) to pieces
            append (the string form of (the length of (meshValue's faces's values))) to pieces
            loop entry from 0 to the length of (meshValue's faces's values):
                append (the string form of (the item at entry in (meshValue's faces's values))) to pieces
            append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's linearTypes's values):
            set linearType to the item at cursor in (modelValue's linearTypes's values)
            clear pieces
            append (the string form of "lineartype") to pieces
            append (the string form of linearType's id) to pieces
            append (the string form of linearType's role) to pieces
            append (the bim exact text of linearType's width) to pieces
            append (the bim exact text of linearType's depth) to pieces
            if linearType's round:
                append (the string form of "1") to pieces
            else:
                append (the string form of "0") to pieces
            append ((linearType's material with " " replaced by "_") with "\n" replaced by "_") to pieces
            append (the bim file name of linearType's name) to pieces
            append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's linears's values):
            set linearValue to the item at cursor in (modelValue's linears's values)
            clear pieces
            append (the string form of "linear") to pieces
            append (the string form of linearValue's id) to pieces
            append (the string form of linearValue's typeId) to pieces
            append (the string form of linearValue's levelId) to pieces
            append (the bim exact text of linearValue's start's x) to pieces
            append (the bim exact text of linearValue's start's y) to pieces
            append (the bim exact text of linearValue's start's z) to pieces
            append (the bim exact text of linearValue's finish's x) to pieces
            append (the bim exact text of linearValue's finish's y) to pieces
            append (the bim exact text of linearValue's finish's z) to pieces
            append (the bim exact text of linearValue's angle) to pieces
            # A twisted or tapering one adds its twist and taper.
            if ((linearValue's twist != 0.0) or (linearValue's taper's x != 1.0)) or (linearValue's taper's y != 1.0):
                append (the bim exact text of linearValue's twist) to pieces
                append (the bim exact text of linearValue's taper's x) to pieces
                append (the bim exact text of linearValue's taper's y) to pieces
            append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's phases's values):
            set phaseValue to the item at cursor in (modelValue's phases's values)
            clear pieces
            append (the string form of "phase") to pieces
            append (the string form of phaseValue's id) to pieces
            append (the bim file name of phaseValue's name) to pieces
            append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's drawingTypes's values):
            set drawingType to the item at cursor in (modelValue's drawingTypes's values)
            clear pieces
            append (the string form of "drawingtype") to pieces
            append (the string form of drawingType's id) to pieces
            append (the string form of drawingType's parentId) to pieces
            append (the string form of drawingType's phaseFilter) to pieces
            append (the bim setting text of (drawingType's shown's values)) to pieces
            append (the bim setting text of (drawingType's faint's values)) to pieces
            append (the bim setting text of (drawingType's annotations's values)) to pieces
            append (the bim file name of drawingType's name) to pieces
            append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's views's values):
            set viewValue to the item at cursor in (modelValue's views's values)
            clear pieces
            append (the string form of "view") to pieces
            append (the string form of viewValue's id) to pieces
            append (the string form of viewValue's kind) to pieces
            append (the string form of viewValue's levelId) to pieces
            append (the string form of viewValue's detail) to pieces
            append (the bim exact text of viewValue's cutHeight) to pieces
            append (the string form of viewValue's scale) to pieces
            if viewValue's cropped:
                append (the string form of "1") to pieces
            else:
                append (the string form of "0") to pieces
            append (the bim exact text of viewValue's cropLow's x) to pieces
            append (the bim exact text of viewValue's cropLow's y) to pieces
            append (the bim exact text of viewValue's cropHigh's x) to pieces
            append (the bim exact text of viewValue's cropHigh's y) to pieces
            append (the bim exact text of viewValue's lineStart's x) to pieces
            append (the bim exact text of viewValue's lineStart's y) to pieces
            append (the bim exact text of viewValue's lineFinish's x) to pieces
            append (the bim exact text of viewValue's lineFinish's y) to pieces
            append (the bim flag text of (viewValue's shown's values)) to pieces
            append (the bim flag text of (viewValue's faint's values)) to pieces
            append (the bim file name of viewValue's name) to pieces
            append (the bim joined fields of pieces) to lines
        # The drawing type each view follows, after the views.
        loop cursor from 0 to the length of (modelValue's views's values):
            set viewValue to the item at cursor in (modelValue's views's values)
            if (viewValue's drawingTypeId != the bim refused id) or (viewValue's phaseId != the bim refused id):
                clear pieces
                append (the string form of "viewtype") to pieces
                append (the string form of viewValue's id) to pieces
                append (the string form of viewValue's drawingTypeId) to pieces
                if viewValue's automatic:
                    append (the string form of "1") to pieces
                else:
                    append (the string form of "0") to pieces
                append (the string form of viewValue's phaseId) to pieces
                append (the bim joined fields of pieces) to lines
        # How each view is drawn, when not in colour: `viewdisplay id mode`.
        loop cursor from 0 to the length of (modelValue's views's values):
            set viewValue to the item at cursor in (modelValue's views's values)
            if viewValue's displayMode != 0:
                append (((the string form of "viewdisplay ") + (the string form of viewValue's id)) + ((the string form of " ") + (the string form of viewValue's displayMode))) to lines
        # Every element's settings (`bim setting record`), after every element:
        # `settings id count code value ...`, all whole numbers.
        set settingOwners to the bim setting owners of modelValue
        loop cursor from 0 to the length of (settingOwners's values):
            set settingOwner to the item at cursor in (settingOwners's values)
            append (((the string form of "settings ") + (the string form of settingOwner)) + ((the string form of " ") + (the bim settings text of settingOwner from 0 below 2147483647 in modelValue))) to lines
        # Every element's properties (`bim pset entry record`), after every
        # element.
        loop cursor from 0 to the length of (modelValue's properties's values):
            append (the bim pset file text of (the item at cursor in (modelValue's properties's values))) to lines
        # The phases elements were built and demolished in, last, after
        # every element.
        loop cursor from 0 to the length of (modelValue's phasings's values):
            set phasingValue to the item at cursor in (modelValue's phasings's values)
            clear pieces
            append (the string form of "phasing") to pieces
            append (the string form of phasingValue's id) to pieces
            append (the string form of phasingValue's createdId) to pieces
            append (the string form of phasingValue's demolishedId) to pieces
            append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's stairs's values):
            set stairValue to the item at cursor in (modelValue's stairs's values)
            clear pieces
            append (the string form of "stair") to pieces
            append (the string form of stairValue's id) to pieces
            append (the string form of stairValue's levelId) to pieces
            append (the bim exact text of stairValue's start's x) to pieces
            append (the bim exact text of stairValue's start's y) to pieces
            append (the bim exact text of stairValue's finish's x) to pieces
            append (the bim exact text of stairValue's finish's y) to pieces
            append (the bim exact text of stairValue's width) to pieces
            append (the string form of stairValue's riserCount) to pieces
            append ((stairValue's material with " " replaced by "_") with "\n" replaced by "_") to pieces
            append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's railings's values):
            set railingValue to the item at cursor in (modelValue's railings's values)
            clear pieces
            append (the string form of "railing") to pieces
            append (the string form of railingValue's id) to pieces
            append (the string form of railingValue's levelId) to pieces
            if railingValue's hostId = the bim refused id:
                append (the string form of "0") to pieces
            else:
                append (the string form of railingValue's hostId) to pieces
            append (the bim exact text of railingValue's height) to pieces
            append (the string form of (the length of (railingValue's points's values))) to pieces
            loop corner from 0 to the length of (railingValue's points's values):
                append (the bim exact text of (the item at corner in (railingValue's points's values))'s x) to pieces
                append (the bim exact text of (the item at corner in (railingValue's points's values))'s y) to pieces
            append ((railingValue's material with " " replaced by "_") with "\n" replaced by "_") to pieces
            append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's curtains's values):
            set curtainValue to the item at cursor in (modelValue's curtains's values)
            clear pieces
            append (the string form of "curtain") to pieces
            append (the string form of curtainValue's id) to pieces
            append (the string form of curtainValue's levelId) to pieces
            append (the bim exact text of curtainValue's start's x) to pieces
            append (the bim exact text of curtainValue's start's y) to pieces
            append (the bim exact text of curtainValue's finish's x) to pieces
            append (the bim exact text of curtainValue's finish's y) to pieces
            append (the bim exact text of curtainValue's height) to pieces
            append (the bim exact text of curtainValue's bayWidth) to pieces
            append (the bim exact text of curtainValue's rowHeight) to pieces
            append ((curtainValue's material with " " replaced by "_") with "\n" replaced by "_") to pieces
            # A curved one adds its bulge (straight ones keep the old line).
            if curtainValue's bulge != 0.0:
                append (the bim exact text of curtainValue's bulge) to pieces
            append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's systems's values):
            set systemValue to the item at cursor in (modelValue's systems's values)
            clear pieces
            append (the string form of "system") to pieces
            append (the string form of systemValue's id) to pieces
            append (the string form of systemValue's discipline) to pieces
            append (the string form of (the length of (systemValue's members's values))) to pieces
            loop memberCursor from 0 to the length of (systemValue's members's values):
                append (the string form of (the item at memberCursor in (systemValue's members's values))) to pieces
            append (the bim file name of systemValue's name) to pieces
            append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's sheets's values):
            set sheetValue to the item at cursor in (modelValue's sheets's values)
            clear pieces
            append (the string form of "sheet") to pieces
            append (the string form of sheetValue's id) to pieces
            append (the string form of sheetValue's paper) to pieces
            if sheetValue's landscape:
                append (the string form of "1") to pieces
            else:
                append (the string form of "0") to pieces
            append (the string form of (the length of (sheetValue's viewports's values))) to pieces
            loop placedCursor from 0 to the length of (sheetValue's viewports's values):
                set viewport to the item at placedCursor in (sheetValue's viewports's values)
                append (the string form of viewport's viewId) to pieces
                append (the bim exact text of viewport's centre's x) to pieces
                append (the bim exact text of viewport's centre's y) to pieces
                append (the bim exact text of viewport's modelCentre's x) to pieces
                append (the bim exact text of viewport's modelCentre's y) to pieces
            append ((sheetValue's number with " " replaced by "_") with "\n" replaced by "_") to pieces
            append (the bim file name of sheetValue's name) to pieces
            append (the bim joined fields of pieces) to lines
        loop cursor from 0 to the length of (modelValue's spaceObjects's values):
            set spaceValue to the item at cursor in (modelValue's spaceObjects's values)
            clear pieces
            append (the string form of "spaceobject") to pieces
            append (the string form of spaceValue's id) to pieces
            append (the string form of spaceValue's levelId) to pieces
            append (the bim exact text of spaceValue's height) to pieces
            append (the string form of (the length of (spaceValue's outline's values))) to pieces
            loop corner from 0 to the length of (spaceValue's outline's values):
                set point to the item at corner in (spaceValue's outline's values)
                append (the bim exact text of point's x) to pieces
                append (the bim exact text of point's y) to pieces
            append (the bim file name of spaceValue's name) to pieces
            append (the bim joined fields of pieces) to lines
            if (the length of spaceValue's number) > 0:
                append (((the string form of "spacenumber ") + (the string form of spaceValue's id)) + ((the string form of " ") + (the bim file name of spaceValue's number))) to lines
        # Tags last: they refer to the elements above. A tag whose element is
        # gone is left out.
        if (the length of (modelValue's reinforcements's values)) > 0:
            append (the bim reinforcement payload of modelValue) to lines
        if (((the length of (modelValue's connections's values)) + (the length of (modelValue's connectionTypes's values))) + (the length of (modelValue's fastenerComponents's values))) > 0:
            append (the bim connection payload of modelValue) to lines
        loop cursor from 0 to the length of (modelValue's tags's values):
            set tagValue to the item at cursor in (modelValue's tags's values)
            if bim element tagValue's elementId can be tagged in modelValue:
                clear pieces
                append (the string form of "tag") to pieces
                append (the string form of tagValue's id) to pieces
                append (the string form of tagValue's elementId) to pieces
                append (the bim exact text of tagValue's place's x) to pieces
                append (the bim exact text of tagValue's place's y) to pieces
                append (the bim joined fields of pieces) to lines
        free pieces
        append (the string form of "") to lines
        set result to lines joined with "\n"
        free lines
        return result

# One `sketch` or `part` line.
local function the bim sketch line of {bim sketch record:element} labelled {a string:label}:
    execute:
        set pieces to an empty list of a string
        append label to pieces
        append (the string form of element's id) to pieces
        append (the string form of element's levelId) to pieces
        append (the string form of element's kind) to pieces
        append (the bim exact text of element's height) to pieces
        append (the string form of (the length of (element's points's values))) to pieces
        loop corner from 0 to the length of (element's points's values):
            append (the bim exact text of (the item at corner in (element's points's values))'s x) to pieces
            append (the bim exact text of (the item at corner in (element's points's values))'s y) to pieces
        if (element's kind = bim text sketch) or (element's kind = bim image sketch):
            append (the bim file name of element's content) to pieces
        set joined to the bim joined fields of pieces
        free pieces
        return joined

# ---------------------------------------------------------------- reading

# One view rule read from a file.
class:
    patterns:
        [a|] bim view rule entry record
    members:
        kind as an integer
        category as an integer
        visible as a boolean
        halftone as a boolean

class:
    patterns:
        [a|] bim file result record
    members:
        valid as a boolean
        modelValue as a bim model record
        message as a string
        viewRules as the type of (a cad topology list of a bim view rule entry record)
        # The project's length units (`bim_editor.dl`), or -1 when the file
        # names none.
        unitCode as an integer

local function a bim file refusal saying {a string:reason}:
    execute:
        return @intrinsic("construct", a bim file result record, false, an empty bim model, reason, a cad topology list of a bim view rule entry record, -1)

local function a bim line refusal saying {a string:reason} on {integer:lineNumber}:
    execute:
        return a bim file refusal saying (((the string form of "line ") + (the string form of lineNumber)) + ((the string form of ": ") + reason))

# The text after the first `count` single-space separated fields of `line`:
# a name. Invalid (the line itself) when the line has fewer separators.
local function the bim remainder of {a string:line} after {integer:count} fields:
    execute:
        set seen to 0
        loop cursor from 0 to the length of line:
            if (the character at cursor in line) = 32:
                set seen to seen + 1
                if seen = count:
                    return @intrinsic("construct", a bim text reading record, true, the substring of line from (cursor + 1) spanning ((the length of line) - (cursor + 1)) bytes)
        return @intrinsic("construct", a bim text reading record, false, line)

# The fields of one line, read as numbers: `whole` lists which fields are
# integers; the others are reals. A field that does not read is refused by
# the caller from `valid`.
class:
    patterns:
        [a|] bim field reading record
    members:
        valid as a boolean
        reals as the type of (an empty list of a 64 bit floating-point number)
        wholes as the type of (an empty list of a 64 bit integer)

# Reads fields `first` to `last` (inclusive) of `tokens`, each an integer
# when its letter in `layout` is `i` and a real when it is `r`.
local function the bim fields {integer:first} to {integer:last} of {a pointer to a list:tokens} laid out as {a string:layout}:
    execute:
        set result to @intrinsic("construct", a bim field reading record, true, an empty list of a 64 bit floating-point number, an empty list of a 64 bit integer)
        if (the length of tokens) <= last:
            set result's valid to false
            return result
        loop cursor from first to last + 1:
            set token to the item at cursor in tokens
            if (the character at (cursor - first) in layout) = 105:
                set whole to the bim whole reading of token
                if whole's valid = false:
                    set result's valid to false
                append whole's value to (result's wholes)
            else:
                set real to the bim real reading of token
                if real's valid = false:
                    set result's valid to false
                append real's value to (result's reals)
        return result

local function free bim field reading {bim field reading record:reading}:
    execute:
        free reading's reals
        free reading's wholes

local function the bim fastener parameters in {bim field reading record:fieldValue} from real {integer:realBase} whole {integer:wholeBase}:
    execute:
        return @intrinsic("construct", a connection fastener parameters, the item at realBase in fieldValue's reals, the item at (realBase + 1) in fieldValue's reals, (the item at wholeBase in fieldValue's wholes) as an integer, (the item at (wholeBase + 1) in fieldValue's wholes) as an integer, (the item at (wholeBase + 2) in fieldValue's wholes) as an integer, (the item at (wholeBase + 3) in fieldValue's wholes) as an integer, (the item at (wholeBase + 4) in fieldValue's wholes) as an integer, the item at (realBase + 2) in fieldValue's reals, (the item at (wholeBase + 5) in fieldValue's wholes) as an integer, the item at (realBase + 3) in fieldValue's reals, the item at (realBase + 4) in fieldValue's reals, (the item at (wholeBase + 6) in fieldValue's wholes) = 1, (the item at (wholeBase + 7) in fieldValue's wholes) as an integer, (the item at (wholeBase + 8) in fieldValue's wholes) = 1)

local function bim fastener flags in {bim field reading record:fieldValue} from whole {integer:wholeBase} are valid:
    execute:
        loop parameterCursor from 0 to 9:
            set rawWhole to the item at (wholeBase + parameterCursor) in fieldValue's wholes
            if (rawWhole < 0) or (rawWhole > (2147483647 as a 64 bit integer)):
                return false
        set shownValue to the item at (wholeBase + 6) in fieldValue's wholes
        set catalogueValue to the item at (wholeBase + 8) in fieldValue's wholes
        return ((shownValue = 0) or (shownValue = 1)) and ((catalogueValue = 0) or (catalogueValue = 1))

# True when `wanted` is above the last id of `records`, so `records` stays in
# ascending id order.
local function bim id {a 64 bit integer:wanted} follows {a pointer to a list:records}:
    execute:
        if (the length of records) = 0:
            return true
        return (the item at ((the length of records) - 1) in records)'s id < wanted

local function the bim dimension feature {integer:featureKind} fits {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        if (the bim wall index of elementId in modelValue)'s valid:
            set ownFeature to (featureKind >= bim wall start feature) and (featureKind <= bim wall interior feature)
            set masonryEnd to (featureKind = (bim masonry near end feature)) or (featureKind = (bim masonry far end feature))
            return (ownFeature or masonryEnd) or (featureKind >= (bim masonry line feature))
        if (the bim opening index of elementId in modelValue)'s valid:
            return (featureKind = bim opening left feature) or (featureKind = bim opening right feature)
        if (the bim grid index of elementId in modelValue)'s valid:
            return featureKind = bim grid line feature
        return false

# Checks what single lines cannot: unique ids below `next`, references to
# existing elements, and walls with layers. Empty when the model is sound.
local function the bim reference fault of {bim model record:modelValue}:
    execute:
        set ids to an empty list of a 64 bit integer
        loop cursor from 0 to the length of (modelValue's connectionTypes's values):
            set spec to the item at cursor in (modelValue's connectionTypes's values)
            append spec's id to ids
            set issue to the connection issue of spec
            if issue != (the string form of ""):
                free ids
                return issue
            if (spec's category != 1) or (spec's style < 2):
                free ids
                return the string form of "Connection types require a steel recipe in local coordinates"
            loop memberCursor from 0 to the length of (spec's members's values):
                if (the item at memberCursor in (spec's members's values))'s elementId != ((memberCursor + 1) as a 64 bit integer):
                    free ids
                    return the string form of "Connection type member slots are out of order"
        loop cursor from 0 to the length of (modelValue's connections's values):
            set spec to the item at cursor in (modelValue's connections's values)
            append spec's id to ids
            set issue to the connection issue of spec
            if issue != (the string form of ""):
                free ids
                return issue
            if (the bim level index of spec's levelId in modelValue)'s valid = false:
                free ids
                return the string form of "connection refers to a missing level"
            loop memberCursor from 0 to the length of (spec's members's values):
                if (the bim linear index of (the item at memberCursor in (spec's members's values))'s elementId in modelValue)'s valid = false:
                    free ids
                    return the string form of "connection refers to a missing member"
                set memberValue to the item at memberCursor in (spec's members's values)
                loop previous from 0 to cursor:
                    set otherNode to the item at previous in (modelValue's connections's values)
                    loop otherCursor from 0 to the length of (otherNode's members's values):
                        set otherMember to the item at otherCursor in (otherNode's members's values)
                        if ((otherMember's elementId = memberValue's elementId) and (otherMember's end = memberValue's end)) and (memberValue's end != 2):
                            free ids
                            return the string form of "a member end belongs to multiple connection nodes"
        loop cursor from 0 to the length of (modelValue's reinforcements's values):
            set spec to the item at cursor in (modelValue's reinforcements's values)
            append spec's id to ids
            if (the bim level index of spec's levelId in modelValue)'s valid = false:
                free ids
                return the string form of "reinforcement refers to a missing level"
            if spec's hostId != the bim refused id:
                set hostExists to (the bim linear index of spec's hostId in modelValue)'s valid
                if (spec's kind = 2) or (spec's kind = 5):
                    set hostExists to ((the bim wall index of spec's hostId in modelValue)'s valid) or ((the bim slab index of spec's hostId in modelValue)'s valid)
                if hostExists = false:
                    free ids
                    return the string form of "reinforcement refers to a missing host"
        loop cursor from 0 to the length of (modelValue's levels's values):
            append (the item at cursor in (modelValue's levels's values))'s id to ids
        loop cursor from 0 to the length of (modelValue's wallTypes's values):
            set wallType to the item at cursor in (modelValue's wallTypes's values)
            append wallType's id to ids
            if (the length of (wallType's layers's values)) = 0:
                free ids
                return (the string form of "wall type ") + ((the string form of wallType's id) + (the string form of " has no layers"))
        loop cursor from 0 to the length of (modelValue's walls's values):
            set wallValue to the item at cursor in (modelValue's walls's values)
            append wallValue's id to ids
            if ((the bim wall type index of wallValue's typeId in modelValue)'s valid = false) or ((the bim level index of wallValue's levelId in modelValue)'s valid = false):
                free ids
                return (the string form of "wall ") + ((the string form of wallValue's id) + (the string form of " refers to a missing type or level"))
        loop cursor from 0 to the length of (modelValue's openingTypes's values):
            append (the item at cursor in (modelValue's openingTypes's values))'s id to ids
        loop cursor from 0 to the length of (modelValue's openings's values):
            set openingValue to the item at cursor in (modelValue's openings's values)
            append openingValue's id to ids
            if ((the bim opening type index of openingValue's typeId in modelValue)'s valid = false) or (((the bim wall index of openingValue's hostId in modelValue)'s valid = false) and ((the bim curtain index of openingValue's hostId in modelValue)'s valid = false)):
                free ids
                return (the string form of "opening ") + ((the string form of openingValue's id) + (the string form of " refers to a missing type or host"))
        loop cursor from 0 to the length of (modelValue's dimensions's values):
            set dimension to the item at cursor in (modelValue's dimensions's values)
            append dimension's id to ids
            set firstFits to the bim dimension feature (dimension's first's feature) fits (dimension's first's elementId) in modelValue
            set secondFits to the bim dimension feature (dimension's second's feature) fits (dimension's second's elementId) in modelValue
            if (firstFits and secondFits) = false:
                free ids
                return (the string form of "dimension ") + ((the string form of dimension's id) + (the string form of " refers to a missing element or feature"))
        loop cursor from 0 to the length of (modelValue's slabs's values):
            set slabValue to the item at cursor in (modelValue's slabs's values)
            append slabValue's id to ids
            if (bim plate openings of slabValue are valid in modelValue) = false:
                free ids
                return the string form of "slab has invalid opening settings or geometry"
            if (the bim level index of slabValue's levelId in modelValue)'s valid = false:
                free ids
                return (the string form of "slab ") + ((the string form of slabValue's id) + (the string form of " refers to a missing level"))
        loop cursor from 0 to the length of (modelValue's grids's values):
            append (the item at cursor in (modelValue's grids's values))'s id to ids
        loop cursor from 0 to the length of (modelValue's sketches's values):
            set sketch to the item at cursor in (modelValue's sketches's values)
            append sketch's id to ids
            if (the bim level index of sketch's levelId in modelValue)'s valid = false:
                free ids
                return (the string form of "sketch ") + ((the string form of sketch's id) + (the string form of " refers to a missing level"))
        loop cursor from 0 to the length of (modelValue's components's values):
            append (the item at cursor in (modelValue's components's values))'s id to ids
        loop cursor from 0 to the length of (modelValue's instances's values):
            set placement to the item at cursor in (modelValue's instances's values)
            append placement's id to ids
            if ((the bim level index of placement's levelId in modelValue)'s valid = false) or ((the bim component index of placement's componentId in modelValue)'s valid = false):
                free ids
                return (the string form of "instance ") + ((the string form of placement's id) + (the string form of " refers to a missing level or component"))
        loop cursor from 0 to the length of (modelValue's linearTypes's values):
            append (the item at cursor in (modelValue's linearTypes's values))'s id to ids
        loop cursor from 0 to the length of (modelValue's linears's values):
            set linearValue to the item at cursor in (modelValue's linears's values)
            append linearValue's id to ids
            if ((the bim level index of linearValue's levelId in modelValue)'s valid = false) or ((the bim linear type index of linearValue's typeId in modelValue)'s valid = false):
                free ids
                return (the string form of "linear ") + ((the string form of linearValue's id) + (the string form of " refers to a missing level or type"))
        loop cursor from 0 to the length of (modelValue's spaceObjects's values):
            set spaceValue to the item at cursor in (modelValue's spaceObjects's values)
            append spaceValue's id to ids
            if (the bim level index of spaceValue's levelId in modelValue)'s valid = false:
                free ids
                return the string form of "a space refers to a missing level"
        loop cursor from 0 to the length of (modelValue's tags's values):
            append (the item at cursor in (modelValue's tags's values))'s id to ids
        loop cursor from 0 to the length of (modelValue's views's values):
            append (the item at cursor in (modelValue's views's values))'s id to ids
        loop cursor from 0 to the length of (modelValue's sheets's values):
            append (the item at cursor in (modelValue's sheets's values))'s id to ids
        loop cursor from 0 to the length of (modelValue's stairs's values):
            append (the item at cursor in (modelValue's stairs's values))'s id to ids
        loop cursor from 0 to the length of (modelValue's railings's values):
            append (the item at cursor in (modelValue's railings's values))'s id to ids
        loop cursor from 0 to the length of (modelValue's curtains's values):
            append (the item at cursor in (modelValue's curtains's values))'s id to ids
        loop cursor from 0 to the length of (modelValue's systems's values):
            append (the item at cursor in (modelValue's systems's values))'s id to ids
        loop cursor from 0 to the length of (modelValue's drawingTypes's values):
            append (the item at cursor in (modelValue's drawingTypes's values))'s id to ids
        loop cursor from 0 to the length of (modelValue's phases's values):
            append (the item at cursor in (modelValue's phases's values))'s id to ids
        loop cursor from 0 to the length of (modelValue's meshes's values):
            set meshValue to the item at cursor in (modelValue's meshes's values)
            append meshValue's id to ids
            if (the bim level index of meshValue's levelId in modelValue)'s valid = false:
                free ids
                return (the string form of "mesh ") + ((the string form of meshValue's id) + (the string form of " refers to a missing level"))
        set total to the length of ids
        sort and deduplicate bim ids ids
        set problem to the string form of ""
        if (the length of ids) != total:
            set problem to the string form of "an id is used twice"
        else if (the length of ids) > 0:
            if ((the item at 0 in ids) <= (0 as a 64 bit integer)) or ((the item at ((the length of ids) - 1) in ids) >= modelValue's nextId):
                set problem to the string form of "an id is not between 1 and next"
        free ids
        return problem

# The lines of `viewRules`, one viewrule record per category, each ending in
# a line break.
function the bim view rule lines of {bim view rules record:viewRules}:
    execute:
        set written to the string form of ""
        loop code from 0 to the bim category count:
            set entry to the item at code in (viewRules's rules's values)
            set line to ((the string form of "viewrule ") + (the string form of viewRules's kind)) + ((the string form of " ") + (the string form of code))
            set shownText to the string form of " 0"
            if entry's visible:
                set shownText to the string form of " 1"
            set faintText to the string form of " 0"
            if entry's halftone:
                set faintText to the string form of " 1"
            set written to written + (((line + shownText) + faintText) + (the string form of "\n"))
        return written

# The model in `content`, or a refusal naming the first fault.
function the bim model parsed from {a string:content}:
    execute:
        set lines to content split at "\n"
        if ((the length of lines) = 0) or (((the item at 0 in lines) with "\r" replaced by "") != (the string form of "BIM-SLICE 1")):
            free lines
            return a bim file refusal saying (the string form of "not a BIM-SLICE 1 file")
        set modelValue to an empty bim model
        set ruleEntries to a cad topology list of a bim view rule entry record
        set unitCode to -1
        set nextSeen to false
        loop lineCursor from 1 to the length of lines:
            set line to (the item at lineCursor in lines) with "\r" replaced by ""
            set lineNumber to lineCursor + 1
            if (the length of line) > 0:
                set tokens to line split at " "
                set kind to the item at 0 in tokens
                set refusal to the string form of ""
                if kind = (the string form of "next"):
                    set fields to the bim fields 1 to 1 of tokens laid out as (the string form of "i")
                    if nextSeen or ((fields's valid = false) or ((the length of tokens) != 2)):
                        set refusal to the string form of "malformed or repeated next"
                    else:
                        set nextSeen to true
                        set modelValue's nextId to the item at 0 in fields's wholes
                    free bim field reading fields
                else if kind = (the string form of "level"):
                    set fields to the bim fields 1 to 3 of tokens laid out as (the string form of "irr")
                    set label to the bim remainder of line after 4 fields
                    if (fields's valid and label's valid) = false:
                        set refusal to the string form of "malformed level"
                    else if (bim id (the item at 0 in (fields's wholes)) follows (modelValue's levels's values)) = false:
                        set refusal to the string form of "level ids out of order"
                    else if (the item at 1 in (fields's reals)) <= 0.0:
                        set refusal to the string form of "a level needs a positive height"
                    else:
                        append (@intrinsic("construct", a bim level record, the item at 0 in fields's wholes, label's text, the item at 0 in fields's reals, the item at 1 in (fields's reals))) to (modelValue's levels's values)
                    free bim field reading fields
                else if kind = (the string form of "walltype"):
                    set fields to the bim fields 1 to 1 of tokens laid out as (the string form of "i")
                    set label to the bim remainder of line after 2 fields
                    if (fields's valid and label's valid) = false:
                        set refusal to the string form of "malformed walltype"
                    else if (bim id (the item at 0 in (fields's wholes)) follows (modelValue's wallTypes's values)) = false:
                        set refusal to the string form of "walltype ids out of order"
                    else:
                        append (@intrinsic("construct", a bim wall type record, the item at 0 in fields's wholes, label's text, a cad topology list of a bim layer record, bim wall planar role)) to (modelValue's wallTypes's values)
                    free bim field reading fields
                else if kind = (the string form of "planartype"):
                    set fields to the bim fields 1 to 2 of tokens laid out as (the string form of "ii")
                    set label to the bim remainder of line after 3 fields
                    if (fields's valid and label's valid) = false:
                        set refusal to the string form of "malformed planartype"
                    else if (bim id (the item at 0 in (fields's wholes)) follows (modelValue's wallTypes's values)) = false:
                        set refusal to the string form of "planartype ids out of order"
                    else if ((the item at 1 in fields's wholes) < (1 as a 64 bit integer)) or ((the item at 1 in fields's wholes) > (3 as a 64 bit integer)):
                        set refusal to the string form of "a planar type's role is 1, 2 or 3"
                    else:
                        append (@intrinsic("construct", a bim wall type record, the item at 0 in fields's wholes, label's text, a cad topology list of a bim layer record, (the item at 1 in fields's wholes) as an integer)) to (modelValue's wallTypes's values)
                    free bim field reading fields
                else if kind = (the string form of "layer"):
                    set fields to the bim fields 1 to 1 of tokens laid out as (the string form of "r")
                    set label to the bim remainder of line after 2 fields
                    if (fields's valid and label's valid) = false:
                        set refusal to the string form of "malformed layer"
                    else if (the length of (modelValue's wallTypes's values)) = 0:
                        set refusal to the string form of "a layer before any walltype"
                    else if (the item at 0 in (fields's reals)) <= 0.0:
                        set refusal to the string form of "a layer needs a positive thickness"
                    else:
                        set owner to the item at ((the length of (modelValue's wallTypes's values)) - 1) in (modelValue's wallTypes's values)
                        append (@intrinsic("construct", a bim layer record, label's text, the item at 0 in (fields's reals))) to (owner's layers's values)
                    free bim field reading fields
                else if kind = (the string form of "wall"):
                    set curved to (the length of tokens) >= 10
                    set shapedWall to (the length of tokens) = 12
                    set fields to the bim fields 1 to 8 of tokens laid out as (the string form of "iiirrrrr")
                    if shapedWall:
                        free bim field reading fields
                        set fields to the bim fields 1 to 11 of tokens laid out as (the string form of "iiirrrrrrrr")
                    else if curved:
                        free bim field reading fields
                        set fields to the bim fields 1 to 9 of tokens laid out as (the string form of "iiirrrrrr")
                    if (fields's valid = false) or (((the length of tokens) != 9) and (((the length of tokens) != 10) and (shapedWall = false))):
                        set refusal to the string form of "malformed wall"
                    else if (bim id (the item at 0 in (fields's wholes)) follows (modelValue's walls's values)) = false:
                        set refusal to the string form of "wall ids out of order"
                    else:
                        set startPoint to a cad vector2 with x (the item at 0 in (fields's reals)) and y (the item at 1 in (fields's reals))
                        set finishPoint to a cad vector2 with x (the item at 2 in (fields's reals)) and y (the item at 3 in (fields's reals))
                        if ((the cad distance from startPoint to finishPoint) <= 1e-6) or ((the item at 4 in (fields's reals)) <= 0.0):
                            set refusal to the string form of "a wall needs a length and a positive height"
                        else:
                            set bulgeValue to 0.0
                            if curved:
                                set bulgeValue to the item at 5 in (fields's reals)
                            set leanValue to 0.0
                            set riseValue to 0.0
                            if shapedWall:
                                set leanValue to the item at 6 in (fields's reals)
                                set riseValue to the item at 7 in (fields's reals)
                            if (the absolute value of bulgeValue) > ((the cad distance from startPoint to finishPoint) * 0.5):
                                set refusal to the string form of "a wall's bulge exceeds a half circle"
                            else if ((the absolute value of leanValue) >= (the item at 4 in (fields's reals))) or ((the absolute value of riseValue) >= (the item at 4 in (fields's reals))):
                                set refusal to the string form of "a wall's lean or rise reaches its height"
                            else:
                                append (@intrinsic("construct", a bim wall record, the item at 0 in fields's wholes, the item at 1 in fields's wholes, the item at 2 in fields's wholes, startPoint, finishPoint, the item at 4 in (fields's reals), bulgeValue, leanValue, riseValue, 0.0, the bim refused id)) to (modelValue's walls's values)
                    free bim field reading fields
                else if kind = (the string form of "wallbase"):
                    set fields to the bim fields 1 to 2 of tokens laid out as (the string form of "ir")
                    if (fields's valid = false) or ((the length of tokens) != 3):
                        set refusal to the string form of "malformed wallbase"
                    else:
                        set baseFound to the bim wall index of (the item at 0 in (fields's wholes)) in modelValue
                        if baseFound's valid = false:
                            set refusal to the string form of "wallbase of an unknown wall"
                        else:
                            set baseWall to the item at baseFound's position in (modelValue's walls's values)
                            replace item at index baseFound's position in (modelValue's walls's values) with (@intrinsic("construct", a bim wall record, baseWall's id, baseWall's typeId, baseWall's levelId, baseWall's start, baseWall's finish, baseWall's height, baseWall's bulge, baseWall's lean, baseWall's rise, the item at 0 in (fields's reals), baseWall's topLevelId))
                    free bim field reading fields
                else if kind = (the string form of "walltop"):
                    set fields to the bim fields 1 to 2 of tokens laid out as (the string form of "ii")
                    if (fields's valid = false) or ((the length of tokens) != 3):
                        set refusal to the string form of "malformed walltop"
                    else:
                        set topFound to the bim wall index of (the item at 0 in (fields's wholes)) in modelValue
                        if topFound's valid = false:
                            set refusal to the string form of "walltop of an unknown wall"
                        else:
                            set topWall to the item at topFound's position in (modelValue's walls's values)
                            replace item at index topFound's position in (modelValue's walls's values) with (@intrinsic("construct", a bim wall record, topWall's id, topWall's typeId, topWall's levelId, topWall's start, topWall's finish, topWall's height, topWall's bulge, topWall's lean, topWall's rise, topWall's baseOffset, the item at 1 in (fields's wholes)))
                    free bim field reading fields
                else if kind = (the string form of "openingtype"):
                    set fields to the bim fields 1 to 6 of tokens laid out as (the string form of "irrrri")
                    set label to the bim remainder of line after 7 fields
                    if (fields's valid and label's valid) = false:
                        set refusal to the string form of "malformed openingtype"
                    else if (bim id (the item at 0 in (fields's wholes)) follows (modelValue's openingTypes's values)) = false:
                        set refusal to the string form of "openingtype ids out of order"
                    else:
                        set doorFlag to the item at 1 in fields's wholes
                        set sizesValid to ((the item at 0 in (fields's reals)) > 0.0) and ((the item at 1 in (fields's reals)) > 0.0)
                        set offsetsValid to ((the item at 2 in (fields's reals)) >= 0.0) and ((the item at 3 in (fields's reals)) >= 0.0)
                        set doorValid to (doorFlag = (0 as a 64 bit integer)) or ((doorFlag = (1 as a 64 bit integer)) and ((the item at 2 in (fields's reals)) = 0.0))
                        if ((sizesValid and offsetsValid) and doorValid) = false:
                            set refusal to the string form of "an opening type needs positive sizes, and a door a sill of 0"
                        else:
                            append (@intrinsic("construct", a bim opening type record, the item at 0 in fields's wholes, label's text, the item at 0 in fields's reals, the item at 1 in fields's reals, the item at 2 in fields's reals, the item at 3 in fields's reals, doorFlag = (1 as a 64 bit integer))) to (modelValue's openingTypes's values)
                    free bim field reading fields
                else if kind = (the string form of "opening"):
                    set fields to the bim fields 1 to 4 of tokens laid out as (the string form of "iiir")
                    if (fields's valid = false) or ((the length of tokens) != 5):
                        set refusal to the string form of "malformed opening"
                    else if (bim id (the item at 0 in (fields's wholes)) follows (modelValue's openings's values)) = false:
                        set refusal to the string form of "opening ids out of order"
                    else:
                        append (@intrinsic("construct", a bim opening record, the item at 0 in fields's wholes, the item at 1 in fields's wholes, the item at 2 in fields's wholes, the item at 0 in (fields's reals))) to (modelValue's openings's values)
                    free bim field reading fields
                else if kind = (the string form of "dimension"):
                    set fields to the bim fields 1 to 5 of tokens laid out as (the string form of "iiiii")
                    set dimensionPlace to @intrinsic("construct", a bim field reading record, true, an empty list of a 64 bit floating-point number, an empty list of a 64 bit integer)
                    if (the length of tokens) = 8:
                        set dimensionPlace to the bim fields 6 to 7 of tokens laid out as (the string form of "rr")
                    if ((fields's valid = false) or (dimensionPlace's valid = false)) or (((the length of tokens) != 6) and ((the length of tokens) != 8)):
                        set refusal to the string form of "malformed dimension"
                    else if (bim id (the item at 0 in (fields's wholes)) follows (modelValue's dimensions's values)) = false:
                        set refusal to the string form of "dimension ids out of order"
                    else:
                        set firstEnd to @intrinsic("construct", a bim reference record, the item at 1 in fields's wholes, (the item at 2 in (fields's wholes)) as an integer)
                        set secondEnd to @intrinsic("construct", a bim reference record, the item at 3 in fields's wholes, (the item at 4 in (fields's wholes)) as an integer)
                        set placeGiven to (the length of tokens) = 8
                        set placePoint to a cad vector2 with x 0.0 and y 0.0
                        if placeGiven:
                            set placePoint to a cad vector2 with x (the item at 0 in (dimensionPlace's reals)) and y (the item at 1 in (dimensionPlace's reals))
                        append (@intrinsic("construct", a bim dimension record, the item at 0 in fields's wholes, firstEnd, secondEnd, placeGiven, placePoint)) to (modelValue's dimensions's values)
                    free bim field reading fields
                else if kind = (the string form of "plate"):
                    set fields to the bim fields 1 to 7 of tokens laid out as (the string form of "iiirrri")
                    if fields's valid = false:
                        set refusal to the string form of "malformed plate"
                    else:
                        set cornerCount to the item at 3 in fields's wholes
                        set plateType to the bim wall type index of (the item at 1 in fields's wholes) in modelValue
                        if (cornerCount < (3 as a 64 bit integer)) or (cornerCount > (1000000 as a 64 bit integer)):
                            set refusal to the string form of "a plate needs at least 3 corners"
                        else if (the length of tokens) != (8 + ((cornerCount as an integer) * 2)):
                            set refusal to the string form of "malformed plate"
                        else if (bim id (the item at 0 in (fields's wholes)) follows (modelValue's slabs's values)) = false:
                            set refusal to the string form of "slab ids out of order"
                        else if plateType's valid = false:
                            set refusal to the string form of "a plate refers to a missing planar type"
                        else if (the absolute value of (the item at 1 in (fields's reals))) >= 1.5:
                            set refusal to the string form of "a plate's pitch must stay below a right angle"
                        else:
                            set outline to a cad topology list of a cad vector2
                            loop corner from 0 to (cornerCount as an integer):
                                set across to the bim real reading of (the item at (8 + (corner * 2)) in tokens)
                                set upward to the bim real reading of (the item at (9 + (corner * 2)) in tokens)
                                if (across's valid and upward's valid) = false:
                                    set refusal to the string form of "malformed plate corner"
                                append (a cad vector2 with x across's value and y upward's value) to (outline's values)
                            if ((the length of refusal) = 0) and ((bim outline (outline's values) is simple) = false):
                                set refusal to the string form of "a plate outline must not cross itself"
                            if (the length of refusal) = 0:
                                set plateTypeValue to the item at plateType's position in (modelValue's wallTypes's values)
                                append (@intrinsic("construct", a bim slab record, the item at 0 in fields's wholes, the item at 2 in fields's wholes, outline, the bim thickness of plateTypeValue, the string form of "concrete", the item at 1 in fields's wholes, the item at 0 in (fields's reals), the item at 1 in (fields's reals), the item at 2 in (fields's reals))) to (modelValue's slabs's values)
                    free bim field reading fields
                else if kind = (the string form of "spaceobject"):
                    set fields to the bim fields 1 to 4 of tokens laid out as (the string form of "iiri")
                    if fields's valid = false:
                        set refusal to the string form of "malformed space"
                    else:
                        set cornerCount to the item at 2 in fields's wholes
                        if (cornerCount < (3 as a 64 bit integer)) or (cornerCount > (1000000 as a 64 bit integer)):
                            set refusal to the string form of "a space needs at least 3 corners"
                        else if (the length of tokens) < (5 + ((cornerCount as an integer) * 2)):
                            set refusal to the string form of "malformed space"
                        else if (bim id (the item at 0 in (fields's wholes)) follows (modelValue's spaceObjects's values)) = false:
                            set refusal to the string form of "space ids out of order"
                        else if (the item at 0 in (fields's reals)) <= 0.0:
                            set refusal to the string form of "a space needs a positive height"
                        else:
                            set outline to a cad topology list of a cad vector2
                            loop corner from 0 to (cornerCount as an integer):
                                set across to the bim real reading of (the item at (5 + (corner * 2)) in tokens)
                                set upward to the bim real reading of (the item at (6 + (corner * 2)) in tokens)
                                if (across's valid and upward's valid) = false:
                                    set refusal to the string form of "malformed space corner"
                                append (a cad vector2 with x across's value and y upward's value) to (outline's values)
                            if ((the length of refusal) = 0) and ((bim outline (outline's values) is simple) = false):
                                set refusal to the string form of "a space outline must not cross itself"
                            set label to the bim remainder of line after (5 + ((cornerCount as an integer) * 2)) fields
                            if (label's valid = false) or ((the length of label's text) = 0):
                                set refusal to the string form of "a space needs a name"
                            if (the length of refusal) = 0:
                                append (@intrinsic("construct", a bim space object record, the item at 0 in fields's wholes, the item at 1 in fields's wholes, label's text, the string form of "", outline, the item at 0 in (fields's reals))) to (modelValue's spaceObjects's values)
                    free bim field reading fields
                else if kind = (the string form of "spacenumber"):
                    set fields to the bim fields 1 to 1 of tokens laid out as (the string form of "i")
                    set label to the bim remainder of line after 2 fields
                    if (fields's valid and label's valid) = false:
                        set refusal to the string form of "malformed space number"
                    else:
