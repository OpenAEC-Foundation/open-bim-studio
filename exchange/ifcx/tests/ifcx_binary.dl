# SPDX-License-Identifier: MPL-2.0
# IfcX in its binary encoding (CBOR compressed with gzip,
# `bim_ifcx_binary.dl`): the bytes of a small document, the same JSON values
# read back, the editor's model saved as .ifcxb and opened again as the same
# model and much smaller than its JSON, uncompressed CBOR opened too, and
# broken files refused.
import editor/bim_editor.dl

function the bim test hex of {a string:encoded}:
    execute:
        set digits to the string form of "0123456789abcdef"
        set pieces to an empty list of a string
        loop cursor from 0 to the length of encoded:
            set code to ((the character at cursor in encoded) as a 32 bit integer) bitwise and 255
            set pair to a new string buffer containing 2 bytes
            store (the character at ((code / 16) as an integer) in digits) into the data of pair at 0
            store (the character at ((the remainder of code divided by 16) as an integer) in digits) into the data of pair at 1
            append pair to pieces
        set joined to pieces joined with " "
        free pieces
        return joined

# The JSON value `node` written out again, numbers by their text.
function the bim test json of {a pointer to a JSON value:node}:
    execute:
        set kind to the kind of node
        if kind = the JSON null kind:
            return the string form of "null"
        if kind = the JSON boolean kind:
            if the boolean of node:
                return the string form of "true"
            return the string form of "false"
        if kind = the JSON number kind:
            return the text of node
        if kind = the JSON text kind:
            return the bim json string of (the text of node)
        set pieces to an empty list of a string
        if kind = the JSON array kind:
            loop cursor from 0 to the length of node:
                append (the bim test json of (the JSON value at index cursor in node)) to pieces
            set joined to ((the string form of "[") + (pieces joined with ",")) + (the string form of "]")
            free pieces
            return joined
        loop cursor from 0 to the length of node:
            set entry to the item at cursor in (node's members)
            append (((the bim json string of entry's name) + (the string form of ":")) + (the bim test json of entry's value)) to pieces
        set joined to ((the string form of "{") + (pieces joined with ",")) + (the string form of "}")
        free pieces
        return joined

set smallEncoded to the bim cbor ifcx of (the string form of "{\"name\": \"abc\", \"list\": [1, -2, 0.5, 12.345, 0.1, 2.75e-7, \"abc\", \"list\", true, false, null], \"big\": 1e300, \"third\": 0.3333333333333333}")
print ((the string form of "encoded: ") + (the string form of smallEncoded's valid)) as a line
print (the bim test hex of smallEncoded's text) as a line
print ((the string form of "binary: ") + (the string form of (bim content smallEncoded's text is binary ifcx))) as a line
set smallBack to the bim ifcx document of smallEncoded's text
print ((the string form of "read back: ") + (the bim test json of (the value of smallBack))) as a line
free smallBack
set fromText to the bim ifcx document of (the string form of "[1.5, \"x\"]")
print ((the string form of "text still read: ") + (the bim test json of (the value of fromText))) as a line
free fromText
print ((the string form of "not JSON: ") + (the string form of (the bim cbor ifcx of (the string form of "{\"a\": "))'s valid)) as a line

# Byte strings, a reference to no text, and a document cut short.
set bytesValue to a new string buffer containing 6 bytes
store (217 as a byte) into the data of bytesValue at 0
store (217 as a byte) into the data of bytesValue at 1
store (247 as a byte) into the data of bytesValue at 2
store (66 as a byte) into the data of bytesValue at 3
store (97 as a byte) into the data of bytesValue at 4
store (98 as a byte) into the data of bytesValue at 5
set refused to the bim ifcx document of bytesValue
print ((the string form of "byte string refused at ") + (the string form of (the JSON error position in refused))) as a line
set dangling to a new string buffer containing 6 bytes
store (217 as a byte) into the data of dangling at 0
store (217 as a byte) into the data of dangling at 1
store (247 as a byte) into the data of dangling at 2
store (216 as a byte) into the data of dangling at 3
store (25 as a byte) into the data of dangling at 4
store (0 as a byte) into the data of dangling at 5
set refused to the bim ifcx document of dangling
print ((the string form of "reference to no text refused at ") + (the string form of (the JSON error position in refused))) as a line
set cutBytes to the substring of smallEncoded's text from 0 spanning 20 bytes
set refused to the bim ifcx document of cutBytes
print ((the string form of "cut short refused at ") + (the string form of (the JSON error position in refused))) as a line

# The editor's model as .ifcxb.
set editor to a new bim editor
set e to the address of editor
add bim example building to e
add bim type library to e
set target to the address of (editor's documentValue's current)
ignore bend bim wall (5 as a 64 bit integer) by 0.75 in target
ignore add bim text on editor's levelId at (a cad vector2 with x 1.0 and y -2.5) saying (the string form of "Entrance \"north\"") to target
type bim editor key 2050 in e
set original to the bim file text of editor's documentValue's current
save bim editor to (the string form of "build/bim-slice-binary-test.ifcxb") in e
print editor's message as a line
save bim editor to (the string form of "build/bim-slice-binary-test.ifcx") in e
set other to a new bim editor
open bim editor from (the string form of "build/bim-slice-binary-test.ifcxb") in (the address of other)
print other's message as a line
set reopened to the bim file text of other's documentValue's current
print ((the string form of "same model: ") + (the string form of (reopened = original))) as a line
if reopened != original:
    print original as a line
    print reopened as a line
print ((the string form of "units: ") + (the bim name of unit other's lengthUnit)) as a line
set binarySize to the length of ((the bim file content at (the string form of "build/bim-slice-binary-test.ifcxb"))'s text)
set textSize to the length of ((the bim file content at (the string form of "build/bim-slice-binary-test.ifcx"))'s text)
print ((the string form of "binary under 20% of the JSON: ") + (the string form of ((binarySize * 5) < textSize))) as a line
# The JSON .ifcx opens through the same reading.
set jsonEditor to a new bim editor
open bim editor from (the string form of "build/bim-slice-binary-test.ifcx") in (the address of jsonEditor)
print ((the string form of "JSON file the same model: ") + (the string form of ((the bim file text of jsonEditor's documentValue's current) = original))) as a line
# CBOR not compressed opens as well.
set jsonText to (the bim file content at (the string form of "build/bim-slice-binary-test.ifcx"))'s text
ignore write bim text ((the bim cbor ifcx of jsonText)'s text) to file (the string form of "build/bim-slice-binary-raw.ifcxb")
set rawEditor to a new bim editor
open bim editor from (the string form of "build/bim-slice-binary-raw.ifcxb") in (the address of rawEditor)
print ((the string form of "uncompressed CBOR the same model: ") + (the string form of ((the bim file text of rawEditor's documentValue's current) = original))) as a line
# A file cut short is refused and the model kept.
set savedBytes to (the bim file content at (the string form of "build/bim-slice-binary-test.ifcxb"))'s text
ignore write bim text (the substring of savedBytes from 0 spanning ((the length of savedBytes) / 2) bytes) to file (the string form of "build/bim-slice-binary-broken.ifcxb")
open bim editor from (the string form of "build/bim-slice-binary-broken.ifcxb") in (the address of other)
set shown to other's message
set marker to the index of " at byte " in shown
if marker > 0:
    set shown to the substring of shown from 0 spanning (marker + 8) bytes
print shown as a line
print ((the string form of "model kept: ") + (the string form of ((the bim file text of other's documentValue's current) = original))) as a line
