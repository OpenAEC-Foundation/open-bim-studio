# SPDX-License-Identifier: MPL-2.0
# A door or window in a building system survives saving.
#
# A curtain wall with a window in it and a wall with a window in it. Read
# back from .bim and from .ifcx the model has both windows, each with its
# host and its place along it. Before, the .ifcx writer wrote only the
# openings of walls, so a window in a timber frame wall was lost on save.
import exchange/ifcx/bim_file.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl

function print system openings of {bim model record:modelValue} labelled {a string:label}:
    execute:
        print ((label + (the string form of ": openings ")) + (the string form of (the length of (modelValue's openings's values)))) as a line
        loop cursor from 0 to the length of (modelValue's openings's values):
            set openingValue to the item at cursor in (modelValue's openings's values)
            set hostKind to the string form of "nothing"
            if (the bim wall index of openingValue's hostId in modelValue)'s valid:
                set hostKind to the string form of "a wall"
            if (the bim curtain index of openingValue's hostId in modelValue)'s valid:
                set hostKind to the string form of "a building system"
            print (((the string form of "  in ") + hostKind) + ((the string form of " at ") + (the bim millimetre text of openingValue's offset))) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
set systemId to add bim curtain wall on storey from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.16)) to layerValues
set wallType to add bim wall type named (the string form of "CLT 160") with layerValues to target
set wallId to add bim wall typed wallType on storey from (a cad vector2 with x 0.0 and y 5.0) to (a cad vector2 with x 6.0 and y 5.0) to target
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
ignore (add bim opening typed windowType in systemId at 3.0 to target)
ignore (add bim opening typed windowType in wallId at 2.0 to target)
print system openings of modelValue labelled (the string form of "drawn")
set reread to the bim model parsed from (the bim file text of modelValue)
print system openings of reread's modelValue labelled (the string form of "from .bim")
set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "t.ifcx") for project (the string form of "t") by (the string form of "test") at (the string form of "2026-11-24T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print system openings of fromIfcx's modelValue labelled (the string form of "from .ifcx")
