# SPDX-License-Identifier: MPL-2.0
# The evaluation's journal path against the record-by-record comparison: a
# seeded sequence of random edits through a document (walls on a 1 m grid so
# that they join often, openings, opening and wall type changes, slabs, and
# undo and redo) is evaluated after every step twice. One evaluation follows
# the model's journal; the other is given each model with a journal of its
# own, so it always compares record by record. Both must agree element by
# element after every step, and with a fresh evaluation every 50 steps.
import elements/planar/bim_evaluate.dl

class:
    patterns:
        [a|] journal test random record
    members:
        state as a 64 bit integer

local function the next journal test value from {a pointer to a journal test random record:generator}:
    execute:
        set generator's state to the remainder of ((generator's state * (1103515245 as a 64 bit integer)) + (12345 as a 64 bit integer)) divided by (2147483648 as a 64 bit integer)
        return (generator's state as a 64 bit floating-point number) / 2147483648.0

# A whole number from 0 to `count` - 1.
local function a journal test choice below {integer:count} from {a pointer to a journal test random record:generator}:
    execute:
        set chosen to ((the next journal test value from generator) * (count as a 64 bit floating-point number)) as an integer
        return the minimum of chosen and (count - 1)

local function a journal test grid point from {a pointer to a journal test random record:generator}:
    execute:
        set x to (a journal test choice below 13 from generator) as a 64 bit floating-point number
        set y to (a journal test choice below 13 from generator) as a 64 bit floating-point number
        return a cad vector2 with x x and y y

local function check journal test {boolean:condition} named {a string:label} at {integer:step}:
    execute:
        if condition = false:
            print ((label + (the string form of " at step ")) + (the string form of step)) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)

local function check journal evaluation {bim evaluation record:first} against {bim evaluation record:second} named {a string:label} at {integer:step}:
    execute:
        check journal test ((the length of (first's elements's values)) = (the length of (second's elements's values))) named (label + (the string form of ": element count")) at step
        loop cursor from 0 to the length of (first's elements's values):
            set one to the item at cursor in (first's elements's values)
            set other to the item at cursor in (second's elements's values)
            check journal test (one's id = other's id) named (label + (the string form of ": element order")) at step
            check journal test (one's signature = other's signature) named (label + (the string form of ": signature")) at step
            check journal test (one's status = other's status) named (label + (the string form of ": status")) at step

# `modelValue` with a journal of its own, so that no evaluation follows it.
local function the journal test copy of {bim model record:modelValue}:
    execute:
        set duplicate to the bim snapshot of modelValue
        set duplicate's journal to a cad topology list of a 64 bit integer
        return duplicate

# One random edit of `target`; true when the model accepted it.
local function apply journal test edit using {a pointer to a journal test random record:generator} to {a pointer to a bim model record:target} with types {a pointer to a list:typeIds}:
    execute:
        set levelId to the item at 0 in typeIds
        set cavityType to the item at 1 in typeIds
        set partitionType to the item at 2 in typeIds
        set windowType to the item at 3 in typeIds
        set doorType to the item at 4 in typeIds
        set walls to target's walls's values
        set action to a journal test choice below 13 from generator
        if (action <= 2) or ((the length of walls) = 0):
            set wallType to cavityType
            if (a journal test choice below 2 from generator) = 1:
                set wallType to partitionType
            return (add bim wall typed wallType on levelId from (a journal test grid point from generator) to (a journal test grid point from generator) to target) != the bim refused id
        set wallValue to the item at (a journal test choice below (the length of walls) from generator) in walls
        set wallLength to the cad distance from wallValue's start to wallValue's finish
        if action = 3:
            if (a journal test choice below 2 from generator) = 0:
                return move bim wall wallValue's id to (a journal test grid point from generator) and wallValue's finish in target
            return move bim wall wallValue's id to wallValue's start and (a journal test grid point from generator) in target
        if action = 4:
            return delete bim wall wallValue's id from target
        set openings to target's openings's values
        if (action <= 6) or ((action <= 8) and ((the length of openings) = 0)):
            set openingType to windowType
            if (a journal test choice below 3 from generator) = 0:
                set openingType to doorType
            return (add bim opening typed openingType in wallValue's id at (wallLength * (the next journal test value from generator)) to target) != the bim refused id
        if action = 7:
            set openingValue to the item at (a journal test choice below (the length of openings) from generator) in openings
            return move bim opening openingValue's id to (5.0 * (the next journal test value from generator)) in target
        if action = 8:
            set openingValue to the item at (a journal test choice below (the length of openings) from generator) in openings
            return delete bim opening openingValue's id from target
        if action = 9:
            set widthValue to 0.6 + (the next journal test value from generator)
            set heightValue to 0.8 + (the next journal test value from generator)
            return set bim opening type windowType sized widthValue by heightValue with sill 0.9 in target
        if action = 10:
            set layers to an empty list of a bim layer record
            append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.08 + (0.12 * (the next journal test value from generator)))) to layers
            set accepted to set bim wall type partitionType layers to layers in target
            free layers
            return accepted
        set slabs to target's slabs's values
        if (action = 11) or ((the length of slabs) = 0):
            set corner to a journal test grid point from generator
            set outline to an empty list of a cad vector2
            append corner to outline
            append (a cad vector2 with x (corner's x + 3.0) and y corner's y) to outline
            append (a cad vector2 with x (corner's x + 3.0) and y (corner's y + 2.0)) to outline
            append (a cad vector2 with x corner's x and y (corner's y + 2.0)) to outline
            set fresh to add bim slab on levelId around outline thick 0.25 to target
            free outline
            return fresh != the bim refused id
        return delete bim slab (the item at (a journal test choice below (the length of slabs) from generator) in slabs)'s id from target

set generator to @intrinsic("construct", a journal test random record, 20261005 as a 64 bit integer)
set documentValue to a new bim document
begin bim transaction in (the address of documentValue)
set target to the address of (documentValue's current)
set typeIds to an empty list of a 64 bit integer
append (add bim level named (the string form of "Level") at 0.0 with height 3.0 to target) to typeIds
set cavityLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to cavityLayers
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.12)) to cavityLayers
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.1)) to cavityLayers
append (add bim wall type named (the string form of "Cavity") with cavityLayers to target) to typeIds
free cavityLayers
set partitionLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.1)) to partitionLayers
append (add bim wall type named (the string form of "Partition") with partitionLayers to target) to typeIds
free partitionLayers
append (add bim opening type named (the string form of "Window") sized 1.0 by 1.2 with sill 0.9 and frame 0.05 to target) to typeIds
append (add bim door type named (the string form of "Door") sized 0.9 by 2.1 with frame 0.05 to target) to typeIds
commit bim transaction in (the address of documentValue)

set journalled to an empty bim evaluation
set compared to an empty bim evaluation
set applied to 0
set refused to 0
set undone to 0
set redone to 0
set mostOpenings to 0
loop step from 0 to 400:
    if ((the remainder of step divided by 7) = 6) and (undo bim transaction in (the address of documentValue)):
        set undone to undone + 1
    else if ((the remainder of step divided by 11) = 10) and (redo bim transaction in (the address of documentValue)):
        set redone to redone + 1
    else:
        begin bim transaction in (the address of documentValue)
        if apply journal test edit using (the address of generator) to (the address of (documentValue's current)) with types typeIds:
            commit bim transaction in (the address of documentValue)
            set applied to applied + 1
        else:
            roll back bim transaction in (the address of documentValue)
            set refused to refused + 1
    set mostOpenings to the maximum of mostOpenings and (the length of (documentValue's current's openings's values))
    update bim evaluation (the address of journalled) to documentValue's current
    update bim evaluation (the address of compared) to (the journal test copy of documentValue's current)
    check journal evaluation journalled against compared named (the string form of "journal against full comparison") at step
    if (the remainder of step divided by 50) = 49:
        set fresh to the bim evaluation of documentValue's current after (an empty bim evaluation)
        check journal evaluation journalled against fresh named (the string form of "journal against fresh") at step
print ((the string form of "edits applied ") + (the string form of applied)) as a line
print ((the string form of "edits refused ") + (the string form of refused)) as a line
print ((the string form of "undone ") + (the string form of undone)) as a line
print ((the string form of "redone ") + (the string form of redone)) as a line
print ((the string form of "walls ") + (the string form of (the length of (documentValue's current's walls's values)))) as a line
print ((the string form of "openings ") + (the string form of (the length of (documentValue's current's openings's values)))) as a line
print ((the string form of "most openings at once ") + (the string form of mostOpenings)) as a line
print ((the string form of "slabs ") + (the string form of (the length of (documentValue's current's slabs's values)))) as a line
print ((the string form of "journal entries ") + (the string form of (the length of (documentValue's current's journal's values)))) as a line
print "journal matches the full comparison after every step and a fresh evaluation every 50 steps" as a line
