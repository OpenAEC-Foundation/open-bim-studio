# SPDX-License-Identifier: MPL-2.0
import viewer/bim_native_instances.dl

function check native instance {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# Rotated, translated solids share a prototype across native categories.
set entries to an empty list of a bim scene mesh record
loop copyCursor from 0 to 8:
    set shape to an empty fast mesh
    set width to 1.0 + ((copyCursor / 2) as a 64 bit floating-point number)
    set points to an empty list of a cad vector3
    append (a cad vector3 with x 0.0, y 0.0 and z 0.0) to points
    append (a cad vector3 with x width, y 0.0 and z 0.0) to points
    append (a cad vector3 with x 0.0, y 2.0 and z 0.0) to points
    append (a cad vector3 with x 0.0, y 0.0 and z 3.0) to points
    loop pointCursor from 0 to 4:
        set spot to the item at pointCursor in points
        if (the remainder of copyCursor divided by 2) = 1:
            set spot to a cad vector3 with x (20.0 - spot's y), y (spot's x + 5.0) and z (spot's z + 8.0)
        append spot to (shape's positions's values)
    append 0 to (shape's triangles's values)
    append 1 to (shape's triangles's values)
    append 2 to (shape's triangles's values)
    append 0 to (shape's triangles's values)
    append 3 to (shape's triangles's values)
    append 1 to (shape's triangles's values)
    set category to bim wall category
    if copyCursor >= 2:
        set category to bim slab category
    if copyCursor >= 4:
        set category to bim beam category
    if copyCursor >= 6:
        set category to bim column category
    set testTint to a cad vector3 with x (copyCursor as a 64 bit floating-point number), y 80.0 and z 120.0
    append (@intrinsic("construct", a bim scene mesh record, (copyCursor + 1) as a 64 bit integer, 1 as a 64 bit integer, shape, category, testTint, the string form of "test")) to entries
    free points
set hidden to an empty list of a 64 bit integer
set batch to the bim native instances among entries leaving out hidden
check native instance ((the length of (batch's prototypes's values)) = 4) named (the string form of "rotated wall floor beam and column pairs share four prototypes")
set reconstructs to true
loop entryCursor from 0 to the length of entries:
    set prototype to the item at (the item at entryCursor in (batch's prototypeOf's values)) in (batch's prototypes's values)
    set placement to the item at entryCursor in (batch's placements's values)
    set original to the item at entryCursor in entries
    loop pointCursor from 0 to the length of (prototype's positions's values):
        set localSpot to the item at pointCursor in (prototype's positions's values)
        set rebuilt to the cad sum of placement's origin and (placement's u scaled by localSpot's x)
        set rebuilt to the cad sum of rebuilt and (placement's v scaled by localSpot's y)
        set rebuilt to the cad sum of rebuilt and (placement's w scaled by localSpot's z)
        if (the cad length of (the cad difference of rebuilt and (the item at pointCursor in (original's shape's positions's values)))) > 1e-7:
            set reconstructs to false
check native instance reconstructs named (the string form of "instance transforms reconstruct every original world vertex")
append (1 as a 64 bit integer) to hidden
set filtered to the bim native instances among entries leaving out hidden
check native instance ((the item at 0 in (filtered's prototypeOf's values)) = -1) named (the string form of "excluded object has no GPU placement")
check native instance ((bim native entry 1 is shared in filtered) = false) named (the string form of "a remaining unique object uses the ordinary mesh path")
set changed to the item at 1 in entries
set differentShape to an empty fast mesh
set differentShape's positions to changed's shape's positions
append 0 to (differentShape's triangles's values)
append 1 to (differentShape's triangles's values)
append 2 to (differentShape's triangles's values)
set changed's shape to differentShape
replace item at index 1 in entries with changed
clear hidden
set altered to the bim native instances among entries leaving out hidden
check native instance ((the length of (altered's prototypes's values)) = 5) named (the string form of "changed topology splits only the edited instance")
