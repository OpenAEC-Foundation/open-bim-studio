# SPDX-License-Identifier: MPL-2.0
# IFC5 (IfcX) import: composes the IfcX files named on the command line as
# layers and prints what it gathers, for `verify_ifcx_read.py` to compare
# with its own composition.
import ui/editor/bim_editor.dl
import exchange/ifcx/bim_ifcx_read.dl

set arguments to the command line arguments
set paths to an empty list of a string
loop cursor from 0 to arguments' length:
    append (the argument at cursor in arguments) to paths
set started to the bim microseconds now
set imported to the bim ifcx import of files paths
if imported's valid = false:
    print ((the string form of "refused: ") + imported's message) as a line
else:
    set counts to an empty list of an integer
    loop code from 0 to the bim category count:
        append 0 to counts
    loop cursor from 0 to the length of (imported's meshes's values):
        set entry to the item at cursor in (imported's meshes's values)
        replace item at index entry's category in counts with ((the item at entry's category in counts) + 1)
    print ((((the string form of "meshes ") + (the string form of (the length of (imported's meshes's values)))) + (the string form of " triangles ")) + (the string form of imported's triangleCount)) as a line
    print ((the string form of "curve segments ") + (the string form of ((the length of (imported's curves's values)) / 2))) as a line
    loop code from 0 to the bim category count:
        if (the item at code in counts) > 0:
            print ((the bim name of category code) + ((the string form of " ") + (the string form of (the item at code in counts)))) as a line
    loop cursor from 0 to the length of (imported's labels's values):
        if cursor < 6:
            print ((the string form of "  ") + (the item at cursor in (imported's labels's values))) as a line
    set low to imported's low
    set high to imported's high
    print ((the string form of "extent ") + (((the bim exact text of low's x) + (the string form of " ")) + ((the bim exact text of low's y) + ((the string form of " ") + (the bim exact text of low's z))))) as a line
    print ((the string form of "    to ") + (((the bim exact text of high's x) + (the string form of " ")) + ((the bim exact text of high's y) + ((the string form of " ") + (the bim exact text of high's z))))) as a line
    print ((the string form of "read in ") + ((the string form of (((the bim microseconds now) - started) / (1000 as a 64 bit integer))) + (the string form of " ms"))) as a line
