# SPDX-License-Identifier: MPL-2.0
import exchange/ifcx/bim_file.dl

function check indexed settings {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set sampleModel to an empty bim model
set target to the address of sampleModel
set firstOwner to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set secondOwner to add bim level named (the string form of "Upper") at 3.0 with height 3.0 to target
set bim setting 7 of secondOwner to (70 as a 64 bit integer) keeping true in target
set bim setting 9 of firstOwner to (90 as a 64 bit integer) keeping true in target
set bim setting 3 of firstOwner to (30 as a 64 bit integer) keeping true in target
set bim setting 7 of firstOwner to (0 as a 64 bit integer) keeping true in target
set bim setting 3 of firstOwner to (31 as a 64 bit integer) keeping true in target
set bim setting 17 of (0 as a 64 bit integer) to (17 as a 64 bit integer) keeping true in target
set largeOwner to 4294967296 as a 64 bit integer
set bim setting 2 of largeOwner to (99 as a 64 bit integer) keeping true in target
set hit to the bim setting 7 of firstOwner in sampleModel
set miss to the bim setting 99 of secondOwner in sampleModel
set owners to the bim setting owners of sampleModel
set valid to (hit's found and (hit's value = (0 as a 64 bit integer))) and ((miss's found = false) and (miss's value = (0 as a 64 bit integer)))
if ((the length of (owners's values)) != 4) or ((the last item of (owners's values)) != largeOwner):
    set valid to false
if (the bim settings text of firstOwner from 3 below 9 in sampleModel) != (the string form of "2 0 31 4 0"):
    set valid to false
check indexed settings valid named (the string form of "unordered edits preserve hits misses explicit zero range reads and 64-bit owners")

set savedModel to sampleModel
set savedModel's settings to the cad clone of sampleModel's settings
set bim setting 3 of firstOwner to (88 as a 64 bit integer) keeping true in target
set bim setting 17 of (0 as a 64 bit integer) to (0 as a 64 bit integer) keeping false in target
set bim setting 999 of firstOwner to (0 as a 64 bit integer) keeping false in target
drop bim settings of secondOwner in target
check indexed settings (((the bim setting 3 of firstOwner in savedModel)'s value = (31 as a 64 bit integer)) and (((the bim setting 17 of (0 as a 64 bit integer) in sampleModel)'s found = false) and ((the bim setting 7 of secondOwner in sampleModel)'s found = false))) named (the string form of "updates and removals keep cloned setting arrays independent")

set beforeJournal to the length of (sampleModel's journal's values)
restore bim setting 5 of firstOwner to (55 as a 64 bit integer) keeping true in target
check indexed settings ((the length of (sampleModel's journal's values)) = beforeJournal) named (the string form of "construction restores settings without journaling")

set legacy to the string form of "BIM-SLICE 1\nnext 3\nlevel 1 0 3 Ground\nlevel 2 3 3 Upper\nsettings 2 1 7 70\nsettings 1 3 9 90 3 30 3 999\n"
set parsed to the bim model parsed from legacy
if parsed's valid = false:
    print parsed's message as a line
    @intrinsic("call", "libc", "exit", nothing, 1)
set canonical to the bim file text of parsed's modelValue
set reread to the bim model parsed from canonical
set valid to reread's valid
if (the bim setting 3 of (1 as a 64 bit integer) in parsed's modelValue)'s value != (30 as a 64 bit integer):
    set valid to false
if (the length of (parsed's modelValue's settings's values)) != 3:
    set valid to false
if reread's valid:
    if (the bim file text of reread's modelValue) != canonical:
        set valid to false
check indexed settings valid named (the string form of "legacy unsorted rows and first duplicate values normalise to stable native files")
