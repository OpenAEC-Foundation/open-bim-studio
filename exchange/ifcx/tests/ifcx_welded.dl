# SPDX-License-Identifier: MPL-2.0
# The IfcX export writes each point of a mesh once. The kernel's meshes hold
# a point per triangle corner; the `usd::usdgeom::mesh` attribute of a box
# column and of a round pipe has far fewer points, the same triangles (each
# corner within the tenth of a micrometre the points are rounded to) and
# the same volume, and the file read back gives the triangles and the volume
# of the shapes it was written from.
import exchange/ifcx/bim_file.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl

function the welded test text of {a 64 bit floating-point number:value}:
    execute:
        set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, value * 1000000.0)
        return the string form of (scaled / 1000000.0)

function the welded test number at {integer:position} in {a pointer to a JSON value:values}:
    execute:
        return (the bim real reading of (the text of (the JSON value at index position in values)))'s value

function show welded mesh of {fast mesh record:shape} labelled {a string:label}:
    execute:
        set attribute to the bim ifcx mesh of shape shifted by (a cad vector3 with x 0.0, y 0.0 and z 0.0)
        set parsed to the JSON document parsed from (((the string form of "{") + attribute) + (the string form of "}"))
        if parsed failed:
            print (label + (the string form of ": the attribute is not JSON")) as a line
            return nothing
        set meshValue to the JSON member named "usd::usdgeom::mesh" in (the value of parsed)
        set pointValues to the JSON member named "points" in meshValue
        set indexValues to the JSON member named "faceVertexIndices" in meshValue
        set back to an empty fast mesh
        loop cursor from 0 to the length of pointValues:
            set coordinates to the JSON value at index cursor in pointValues
            append (a cad vector3 with x (the welded test number at 0 in coordinates), y (the welded test number at 1 in coordinates) and z (the welded test number at 2 in coordinates)) to (back's positions's values)
        loop cursor from 0 to the length of indexValues:
            append ((the welded test number at cursor in indexValues) as an integer) to (back's triangles's values)
        # No point written twice.
        set repeated to 0
        loop cursor from 0 to the length of (back's positions's values):
            set early to the item at cursor in (back's positions's values)
            loop later from (cursor + 1) to the length of (back's positions's values):
                set late to the item at later in (back's positions's values)
                if (early's x = late's x) and ((early's y = late's y) and (early's z = late's z)):
                    set repeated to repeated + 1
        # Every corner of every triangle where it was, in the same order.
        set sourceCorners to shape's triangles's values
        set furthest to 0.0
        if (the length of sourceCorners) = (the length of (back's triangles's values)):
            loop cursor from 0 to the length of sourceCorners:
                set before to the item at (the item at cursor in sourceCorners) in (shape's positions's values)
                set after to the item at (the item at cursor in (back's triangles's values)) in (back's positions's values)
                set furthest to the maximum of furthest and (the absolute value of (before's x - after's x))
                set furthest to the maximum of furthest and (the absolute value of (before's y - after's y))
                set furthest to the maximum of furthest and (the absolute value of (before's z - after's z))
        else:
            set furthest to 1.0
        set line to (label + (the string form of ": points ")) + ((the string form of (the length of (shape's positions's values))) + ((the string form of " written as ") + (the string form of (the length of pointValues))))
        set line to (line + (the string form of ", repeated ")) + (the string form of repeated)
        set line to (line + (the string form of ", triangles ")) + ((the string form of ((the length of sourceCorners) / 3)) + ((the string form of " written as ") + (the string form of ((the length of indexValues) / 3))))
        set line to (line + (the string form of ", volume ")) + ((the welded test text of (the bim volume of mesh shape)) + ((the string form of " written as ") + (the welded test text of (the bim volume of mesh back))))
        set line to (line + (the string form of ", corners within 0.1 um: ")) + (the string form of (furthest <= 0.00000010001))
        print line as a line
        free parsed

set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
set columnType to add bim linear type named (the string form of "Kolom beton 300x300") as role bim column role sized 0.3 by 0.3 round false of (the string form of "concrete") to target
set pipeType to add bim linear type named (the string form of "Leiding 100") as role bim pipe role sized 0.1 by 0.1 round true of (the string form of "steel") to target
set column to add bim linear typed columnType on storey from (a cad vector3 with x 2.0, y 2.0 and z 0.0) to (a cad vector3 with x 2.0, y 2.0 and z 3.0) turned 0.3 to target
set pipe to add bim linear typed pipeType on storey from (a cad vector3 with x 0.0, y 5.0 and z 0.5) to (a cad vector3 with x 4.0, y 8.0 and z 0.8) turned 0.0 to target
set columnShape to the bim linear shape of (the item at (the bim linear index of column in modelValue)'s position in (modelValue's linears's values)) in modelValue
set pipeShape to the bim linear shape of (the item at (the bim linear index of pipe in modelValue)'s position in (modelValue's linears's values)) in modelValue
show welded mesh of columnShape labelled (the string form of "column")
show welded mesh of pipeShape labelled (the string form of "pipe")

# A mesh of nothing, and numbers at the edges of the format.
print (the bim ifcx mesh of (an empty fast mesh) shifted by (a cad vector3 with x 0.0, y 0.0 and z 0.0)) as a line
set sample to an empty fast mesh
append (a cad vector3 with x -0.00000004, y 1234567.00000015 and z -0.5) to (sample's positions's values)
append (a cad vector3 with x 10.0, y 0.000001 and z 0.1 + 0.2) to (sample's positions's values)
append (a cad vector3 with x 0.0, y 1234567.0000002 and z -0.50000001) to (sample's positions's values)
append (a cad vector3 with x 10.00000004, y 0.00000104 and z 0.3) to (sample's positions's values)
loop corner from 0 to 4:
    append (3 - corner) to (sample's triangles's values)
append 0 to (sample's triangles's values)
append 2 to (sample's triangles's values)
print (the bim ifcx mesh of sample shifted by (a cad vector3 with x 0.0, y 0.0 and z 0.0)) as a line
print (the bim ifcx mesh of sample shifted by (a cad vector3 with x 10.0, y 0.0 and z 0.5)) as a line

# The file, read back as any reader of IfcX reads it.
set exported to the bim ifcx text of modelValue identified as (the string form of "w.ifcx") for project (the string form of "w") by (the string form of "test") at (the string form of "2026-11-11T00:00:00Z")
set filePath to the string form of "build/ifcx-welded-test.ifcx"
print ((the string form of "written: ") + (the string form of (write bim text exported to file filePath))) as a line
set imported to the bim ifcx import of file filePath
if imported's valid = false:
    print ((the string form of "refused: ") + imported's message) as a line
else:
    set readVolume to 0.0
    loop cursor from 0 to the length of (imported's meshes's values):
        set readVolume to readVolume + (the bim volume of mesh (the item at cursor in (imported's meshes's values))'s shape)
    set shapeTriangles to ((the length of (columnShape's triangles's values)) + (the length of (pipeShape's triangles's values))) / 3
    set shapeVolume to (the bim volume of mesh columnShape) + (the bim volume of mesh pipeShape)
    print ((the string form of "read back: meshes ") + (the string form of (the length of (imported's meshes's values)))) as a line
    print (((the string form of "triangles ") + (the string form of shapeTriangles)) + ((the string form of " read back as ") + (the string form of imported's triangleCount))) as a line
    print (((the string form of "volume ") + (the welded test text of shapeVolume)) + ((the string form of " read back as ") + (the welded test text of readVolume))) as a line
