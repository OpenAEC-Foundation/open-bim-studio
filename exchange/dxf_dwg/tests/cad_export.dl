# SPDX-License-Identifier: MPL-2.0
# A drawing with every kind of entity the exporters write, written as DXF
# (and DWG) into build/tests/. `tests/verify_dxf_dwg.py` reads both files
# back with cadcodec and compares what it finds with this drawing.
import exchange/dxf_dwg/bim_dxf_write.dl
import exchange/dxf_dwg/bim_dwg_write.dl
import exchange/ifcx/bim_file.dl

function add export corner {a 64 bit floating-point number:x} {a 64 bit floating-point number:y} {a 64 bit floating-point number:z} to {a pointer to a list:positions}:
    execute:
        append (a cad vector3 with x x, y y and z z) to positions

function add export ring {integer:a} {integer:b} {integer:c} {integer:d} to {a pointer to a list:loops}:
    execute:
        append 1 to loops
        append 4 to loops
        append a to loops
        append b to loops
        append c to loops
        append d to loops

# The test drawing: two layers besides 0, a line, a flat closed outline,
# a 3D polyline, two texts (one with a character outside ASCII), a mesh of
# two triangles and a box as a solid.
function the export test sample:
    execute:
        set made to a new bim cad drawing
        set walls to the bim cad layer (the string form of "Walls") coloured 1 in (the address of made)
        set floors to the bim cad layer (the string form of "Floors: ground") coloured 3 in (the address of made)
        set again to the bim cad layer (the string form of "WALLS") coloured 5 in (the address of made)
        print ((the string form of "layers ") + ((the string form of walls) + ((the string form of " ") + ((the string form of floors) + ((the string form of " ") + (the string form of again)))))) as a line
        add bim cad line from (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (a cad vector3 with x 4.0, y 0.0 and z 0.0) on walls to (the address of made)
        set outline to an empty list of a cad vector3
        add export corner 0.0 0.0 0.0 to outline
        add export corner 4.0 0.0 0.0 to outline
        add export corner 4.0 3.0 0.0 to outline
        add export corner 0.0 3.0 0.0 to outline
        add bim cad polyline through outline closed true on floors to (the address of made)
        set rising to an empty list of a cad vector3
        add export corner 0.0 0.0 0.0 to rising
        add export corner 1.0 0.0 1.0 to rising
        add export corner 2.0 0.0 1.5 to rising
        add bim cad polyline through rising closed false on walls to (the address of made)
        add bim cad text (the string form of "Kitchen 12 m²") at (a cad vector3 with x 2.0, y 1.5 and z 0.0) high 0.25 turned 0.0 centred true on 0 to (the address of made)
        add bim cad text (the string form of "A1") at (a cad vector3 with x -1.0, y 0.0 and z 0.0) high 0.5 turned 1.5707963267948966 centred false on walls to (the address of made)
        set triangles to an empty list of an integer
        append 0 to triangles
        append 1 to triangles
        append 2 to triangles
        append 0 to triangles
        append 2 to triangles
        append 3 to triangles
        add bim cad mesh of outline with triangles triangles on floors to (the address of made)
        set positions to an empty list of a cad vector3
        add export corner 5.0 0.0 0.0 to positions
        add export corner 6.0 0.0 0.0 to positions
        add export corner 6.0 1.0 0.0 to positions
        add export corner 5.0 1.0 0.0 to positions
        add export corner 5.0 0.0 2.0 to positions
        add export corner 6.0 0.0 2.0 to positions
        add export corner 6.0 1.0 2.0 to positions
        add export corner 5.0 1.0 2.0 to positions
        set loops to an empty list of an integer
        add export ring 0 3 2 1 to loops
        add export ring 4 5 6 7 to loops
        add export ring 0 1 5 4 to loops
        add export ring 1 2 6 5 to loops
        add export ring 2 3 7 6 to loops
        add export ring 3 0 4 7 to loops
        print ((the string form of "box accepted ") + (the string form of (add bim cad checked solid of positions with loops loops on walls to (the address of made)))) as a line
        # Reversed side: two loops share an edge the same way round.
        replace item at index 13 in loops with 2
        replace item at index 15 in loops with 0
        print ((the string form of "twisted box accepted ") + (the string form of (add bim cad checked solid of positions with loops loops on walls to (the address of made)))) as a line
        free outline
        free rising
        free triangles
        free positions
        free loops
        return made

set drawing to the export test sample
print ((the string form of "entities ") + (the string form of (the bim cad entity count of drawing))) as a line
print ((the string form of "handle seed ") + (the bim cad hex of (the bim cad handle seed of drawing))) as a line
print ((the string form of "text ") + (the bim cad code page text of (the string form of "Kitchen 12 m² – ok"))) as a line
set dxfText to the bim dxf of drawing
print ((the string form of "dxf written ") + (the string form of (write bim text dxfText to file (the string form of "build/tests/cad_export.dxf")))) as a line
set dwgBytes to the bim dwg of drawing
print ((the string form of "dwg written ") + (the string form of (write bim text dwgBytes to file (the string form of "build/tests/cad_export.dwg")))) as a line
