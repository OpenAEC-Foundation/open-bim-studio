# SPDX-License-Identifier: MPL-2.0
# The SAT text of a cube, of a frame (a square with a square hole through
# it, so its top and bottom have an inner loop) and of refused polyhedra.
# `tests/verify_dxf_dwg.py` reads the same texts with cadcodec and checks
# them with its own validator.
import exchange/dxf_dwg/bim_sat_text.dl

function add sat corner {a 64 bit floating-point number:x} {a 64 bit floating-point number:y} {a 64 bit floating-point number:z} to {a pointer to a list:positions}:
    execute:
        append (a cad vector3 with x x, y y and z z) to positions

function add sat ring {integer:a} {integer:b} {integer:c} {integer:d} to {a pointer to a list:loops}:
    execute:
        append 4 to loops
        append a to loops
        append b to loops
        append c to loops
        append d to loops

# A box from `low` to `high` as positions 0..7 (bottom anticlockwise from
# low, then the top above them) and its six faces, outward.
function the sat box from {cad vector3:low} to {cad vector3:high}:
    execute:
        set drawing to a new bim cad drawing
        set positions to an empty list of a cad vector3
        add sat corner low's x low's y low's z to positions
        add sat corner high's x low's y low's z to positions
        add sat corner high's x high's y low's z to positions
        add sat corner low's x high's y low's z to positions
        add sat corner low's x low's y high's z to positions
        add sat corner high's x low's y high's z to positions
        add sat corner high's x high's y high's z to positions
        add sat corner low's x high's y high's z to positions
        set loops to an empty list of an integer
        append 1 to loops
        add sat ring 0 3 2 1 to loops
        append 1 to loops
        add sat ring 4 5 6 7 to loops
        append 1 to loops
        add sat ring 0 1 5 4 to loops
        append 1 to loops
        add sat ring 1 2 6 5 to loops
        append 1 to loops
        add sat ring 2 3 7 6 to loops
        append 1 to loops
        add sat ring 3 0 4 7 to loops
        add bim cad solid of positions with loops loops on 0 to (the address of drawing)
        free positions
        free loops
        return the item at 0 in (drawing's solids's values)

# A 3 by 3 by 1 frame with a 1 by 1 hole in its middle: outer corners 0..7
# as a box, inner corners 8..15 likewise.
function the sat frame:
    execute:
        set drawing to a new bim cad drawing
        set positions to an empty list of a cad vector3
        add sat corner 0.0 0.0 0.0 to positions
        add sat corner 3.0 0.0 0.0 to positions
        add sat corner 3.0 3.0 0.0 to positions
        add sat corner 0.0 3.0 0.0 to positions
        add sat corner 0.0 0.0 1.0 to positions
        add sat corner 3.0 0.0 1.0 to positions
        add sat corner 3.0 3.0 1.0 to positions
        add sat corner 0.0 3.0 1.0 to positions
        add sat corner 1.0 1.0 0.0 to positions
        add sat corner 2.0 1.0 0.0 to positions
        add sat corner 2.0 2.0 0.0 to positions
        add sat corner 1.0 2.0 0.0 to positions
        add sat corner 1.0 1.0 1.0 to positions
        add sat corner 2.0 1.0 1.0 to positions
        add sat corner 2.0 2.0 1.0 to positions
        add sat corner 1.0 2.0 1.0 to positions
        set loops to an empty list of an integer
        # Bottom: outer seen from below, the hole the other way.
        append 2 to loops
        add sat ring 0 3 2 1 to loops
        add sat ring 8 9 10 11 to loops
        # Top.
        append 2 to loops
        add sat ring 4 5 6 7 to loops
        add sat ring 12 15 14 13 to loops
        # Outer sides.
        append 1 to loops
        add sat ring 0 1 5 4 to loops
        append 1 to loops
        add sat ring 1 2 6 5 to loops
        append 1 to loops
        add sat ring 2 3 7 6 to loops
        append 1 to loops
        add sat ring 3 0 4 7 to loops
        # Sides of the hole, facing into it.
        append 1 to loops
        add sat ring 8 12 13 9 to loops
        append 1 to loops
        add sat ring 9 13 14 10 to loops
        append 1 to loops
        add sat ring 10 14 15 11 to loops
        append 1 to loops
        add sat ring 11 15 12 8 to loops
        add bim cad solid of positions with loops loops on 0 to (the address of drawing)
        free positions
        free loops
        return the item at 0 in (drawing's solids's values)

print (the bim sat number of 0.0) as a line
print (the bim sat number of 10.0) as a line
print (the bim sat number of -2.5) as a line
print (the bim sat number of 0.1) as a line
print (the bim sat number of 0.0000009999999999999999) as a line
print (the bim sat number of 0.0000000001) as a line
print (the bim sat number of 123456.789) as a line
print (the bim sat number of 0.0001234) as a line

set cube to the sat box from (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (a cad vector3 with x 1.0, y 2.0 and z 4.0)
set cubeText to the bim sat text of cube for dwg false
print ((the string form of "cube valid ") + (the string form of cubeText's valid)) as a line
print cubeText's text

set frame to the sat frame
set frameText to the bim sat text of frame for dwg false
print ((the string form of "frame valid ") + (the string form of frameText's valid)) as a line
print frameText's text

set dwgText to the bim sat text of cube for dwg true
print ((the string form of "dwg lines end in CR LF ") + (the string form of ((the character at ((the length of dwgText's text) - 2) in dwgText's text) = 13))) as a line

# An open box (its top left out) and a face with two corners refused.
set open to the sat box from (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (a cad vector3 with x 1.0, y 1.0 and z 1.0)
# The top is the second face, the integers 6 to 11.
loop cursor from 0 to 6:
    remove item 6 from (open's loops's values)
print ((the string form of "open box valid ") + (the string form of ((the bim sat text of open for dwg false)'s valid))) as a line
set flat to the sat box from (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (a cad vector3 with x 1.0, y 1.0 and z 1.0)
replace item at index 1 in (flat's loops's values) with 2
print ((the string form of "short loop valid ") + (the string form of ((the bim sat text of flat for dwg false)'s valid))) as a line
print ((the string form of "dxf cipher ") + (the bim dxf sat cipher of (the string form of "body $-1 A"))) as a line
