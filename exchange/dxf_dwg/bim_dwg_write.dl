        put dwg handle 3 value (bim cad viewport entity control handle) into writer
        put dwg handle 5 value (bim cad group dictionary handle) into writer
        put dwg handle 5 value (bim cad multiline style dictionary handle) into writer
        put dwg handle 3 value (bim cad named objects handle) into writer
        put dwg short 1 into writer
        put dwg short 70 into writer
        put dwg text (the string form of "") into writer
        put dwg text (the string form of "") into writer
        put dwg handle 5 value (bim cad layout dictionary handle) into writer
        put dwg handle 5 value (bim cad plot settings dictionary handle) into writer
        put dwg handle 5 value (bim cad plot style dictionary handle) into writer
        put dwg long 10781 into writer
        put dwg short 6 into writer
        put dwg short 0 into writer
        put dwg text (the string form of "") into writer
        put dwg text (the string form of "") into writer
        put dwg handle 5 value (bim cad paper space handle) into writer
        put dwg handle 5 value (bim cad model space handle) into writer
        put dwg handle 5 value (bim cad by layer linetype handle) into writer
        put dwg handle 5 value (bim cad by block linetype handle) into writer
        put dwg handle 5 value (bim cad continuous linetype handle) into writer
        put dwg short -1 into writer
        put dwg short -1 into writer
        put dwg short -1 into writer
        put dwg short -1 into writer

# A section between its sentinels: its size, its data and their CRC.
local function add dwg section {a string:data} between {a string:opening} and {a string:closing} to {a pointer to a bim dwg buffer record:buffer}:
    execute:
        add dwg hex opening to buffer
        set start to buffer's size
        add dwg long (the length of data) to buffer
        add dwg bytes data to buffer
        add dwg short (the dwg crc of (the value at buffer) from start spanning (buffer's size - start) seeded (the dwg crc seed)) to buffer
        add dwg hex closing to buffer

# The object map: per handle (ascending) the change in handle and in file
# offset from the one before, in chunks of at most 2032 bytes, each with its
# size before it and its CRC after it, most significant byte first.
local function the dwg object map of {bim dwg writer record:writer} at {integer:objectsAt}:
    execute:
        set buffer to a new bim dwg buffer
        set chunkStart to 0
        add dwg byte 0 to (the address of buffer)
        add dwg byte 0 to (the address of buffer)
        set previousHandle to 0
        set previousPlace to 0
        set count to the length of (writer's handles)
        # The objects were written in handle order but for the sub-entities;
        # sort the pairs by handle.
        set order to an empty list of an integer
        loop cursor from 0 to count:
            append cursor to order
        set sorting to true
        loop while sorting:
            set sorting to false
            loop cursor from 1 to count:
                set left to the item at (cursor - 1) in order
                set right to the item at cursor in order
                if (the item at left in (writer's handles)) > (the item at right in (writer's handles)):
                    replace item at index (cursor - 1) in order with right
                    replace item at index cursor in order with left
                    set sorting to true
        loop cursor from 0 to count:
            set index to the item at cursor in order
            set handle to the item at index in (writer's handles)
            set place to (the item at index in (writer's offsets)) + objectsAt
            set entry to (the dwg modular unsigned (handle - previousHandle)) + (the dwg modular signed (place - previousPlace))
            if ((buffer's size - chunkStart) + (the length of entry)) > 2032:
                close dwg map chunk from chunkStart in (the address of buffer)
                set chunkStart to buffer's size
                add dwg byte 0 to (the address of buffer)
                add dwg byte 0 to (the address of buffer)
                set entry to (the dwg modular unsigned handle) + (the dwg modular signed place)
            add dwg bytes entry to (the address of buffer)
            set previousHandle to handle
            set previousPlace to place
        close dwg map chunk from chunkStart in (the address of buffer)
        set chunkStart to buffer's size
        add dwg byte 0 to (the address of buffer)
        add dwg byte 0 to (the address of buffer)
        close dwg map chunk from chunkStart in (the address of buffer)
        free order
        return the dwg bytes of buffer

local function close dwg map chunk from {integer:start} in {a pointer to a bim dwg buffer record:buffer}:
    execute:
        set length to buffer's size - start
        store (((length shifted right by 8) bitwise and 255) as a byte) into the data of (buffer's bytes) at start
        store ((length bitwise and 255) as a byte) into the data of (buffer's bytes) at (start + 1)
        set crc to the dwg crc of (the value at buffer) from start spanning length seeded (the dwg crc seed)
        add dwg byte (crc shifted right by 8) to buffer
        add dwg byte crc to buffer

# A modular char of `value`, seven bits to a byte, the high bit continuing.
local function the dwg modular unsigned {integer:value}:
    execute:
        set parts to a new bim dwg buffer
        set rest to value
        loop while rest >= 128:
            add dwg byte ((rest bitwise and 127) + 128) to (the address of parts)
            set rest to rest shifted right by 7
        add dwg byte rest to (the address of parts)
        return the dwg bytes of parts

# The same signed: the last byte's bit 6 is the sign.
local function the dwg modular signed {integer:value}:
    execute:
        set parts to a new bim dwg buffer
        set rest to value
        set sign to 0
        if value < 0:
            set rest to 0 - value
            set sign to 64
        loop while rest >= 64:
            add dwg byte ((rest bitwise and 127) + 128) to (the address of parts)
            set rest to rest shifted right by 7
        add dwg byte (rest + sign) to (the address of parts)
        return the dwg bytes of parts

local function the dwg auxiliary header seed {integer:seedValue}:
    execute:
        set writer to a new bim dwg bits
        put dwg byte 255 into (the address of writer)
        put dwg byte 119 into (the address of writer)
        put dwg byte 1 into (the address of writer)
        put dwg raw short 23 into (the address of writer)
        put dwg raw short 0 into (the address of writer)
        put dwg raw long 1 into (the address of writer)
        put dwg raw long -1 into (the address of writer)
        put dwg raw short 1 into (the address of writer)
        put dwg raw short 0 into (the address of writer)
        put dwg raw long 0 into (the address of writer)
        put dwg raw short 23 into (the address of writer)
        put dwg raw short 0 into (the address of writer)
        put dwg raw short 23 into (the address of writer)
        put dwg raw short 0 into (the address of writer)
        put dwg raw short 5 into (the address of writer)
        put dwg raw short 2195 into (the address of writer)
        put dwg raw short 5 into (the address of writer)
        put dwg raw short 2195 into (the address of writer)
        put dwg raw short 0 into (the address of writer)
        put dwg raw short 1 into (the address of writer)
        loop cursor from 0 to 5:
            put dwg raw long 0 into (the address of writer)
        # Created and updated: 31 October 2026, as Julian day and milliseconds.
        put dwg raw long 2461345 into (the address of writer)
        put dwg raw long 0 into (the address of writer)
        put dwg raw long 2461345 into (the address of writer)
        put dwg raw long 0 into (the address of writer)
        put dwg raw long seedValue into (the address of writer)
        put dwg raw long 0 into (the address of writer)
        put dwg raw short 0 into (the address of writer)
        put dwg raw short 1 into (the address of writer)
        put dwg raw long 0 into (the address of writer)
        put dwg raw long 0 into (the address of writer)
        put dwg raw long 0 into (the address of writer)
        put dwg raw long 1 into (the address of writer)
        loop cursor from 0 to 4:
            put dwg raw long 0 into (the address of writer)
        return the dwg bytes of writer

local function add dwg class {integer:number} named {a string:dxfName} as {a string:className} into {a pointer to a bim dwg bits record:writer}:
    execute:
        put dwg short number into writer
        put dwg short 0 into writer
        put dwg text (the string form of "ObjectDBX Classes") into writer
        put dwg text className into writer
        put dwg text dxfName into writer
        put dwg bit false into writer
        # An object, not an entity.
        put dwg short 499 into writer

local function add dwg locator {integer:number} at {integer:place} sized {integer:size} to {a pointer to a bim dwg buffer record:buffer}:
    execute:
        add dwg byte number to buffer
        add dwg long place to buffer
        add dwg long size to buffer

# The DWG bytes of `drawing`.
function the bim dwg of {bim cad drawing record:drawing}:
    execute:
        set writer to @intrinsic("construct", a bim dwg writer record, a new bim dwg buffer, an empty list of an integer, an empty list of an integer)
        write dwg controls of drawing into (the address of writer)
        write dwg tables of drawing into (the address of writer)
        set tops to the dwg top entities of drawing
        set first to 0
        set last to 0
        if (the length of tops) > 0:
            set first to the item at 0 in tops
            set last to the last item of tops
        free tops
        write dwg block record (the string form of "*Model_Space") handle (bim cad model space handle) block (bim cad model block handle) end (bim cad model block end handle) layout (bim cad model layout handle) first first last last into (the address of writer)
        write dwg block record (the string form of "*Paper_Space") handle (bim cad paper space handle) block (bim cad paper block handle) end (bim cad paper block end handle) layout (bim cad paper layout handle) first 0 last 0 into (the address of writer)
        write dwg entities of drawing into (the address of writer)
        write dwg objects into (the address of writer)
        set seed to the bim cad handle seed of drawing

        set bounds to the bim cad extents of drawing
        set low to a cad vector3 with x 100000000000000000000.0, y 100000000000000000000.0 and z 100000000000000000000.0
        set high to a cad vector3 with x -100000000000000000000.0, y -100000000000000000000.0 and z -100000000000000000000.0
        if bounds's valid:
            set low to bounds's low
            set high to bounds's high
        set headerBits to a new bim dwg bits
        put dwg header variables seed seed from low to high into (the address of headerBits)
        pad dwg bits (the address of headerBits)
        set headerSection to a new bim dwg buffer
        add dwg section (the dwg bytes of headerBits) between (the string form of "CF7B1F23FDDE38A95F7C68B84E6D335F") and (the string form of "3084E0DC0221C756A0839747B192CCA0") to (the address of headerSection)
        set classBits to a new bim dwg bits
        add dwg class (dwg default dictionary class) named (the string form of "ACDBDICTIONARYWDFLT") as (the string form of "AcDbDictionaryWithDefault") into (the address of classBits)
        add dwg class (dwg layout class) named (the string form of "LAYOUT") as (the string form of "AcDbLayout") into (the address of classBits)
        pad dwg bits (the address of classBits)
        set classSection to a new bim dwg buffer
        add dwg section (the dwg bytes of classBits) between (the string form of "8DA1C4B8C4A9F8C5C0DCF45FE7CFB68A") and (the string form of "725E3B473B56073A3F230BA018304975") to (the address of classSection)
        set freeSpace to a new bim dwg buffer
        add dwg long 0 to (the address of freeSpace)
        add dwg long (the length of (writer's handles)) to (the address of freeSpace)
        add dwg long 0 to (the address of freeSpace)
        add dwg long 0 to (the address of freeSpace)
        add dwg long 0 to (the address of freeSpace)
        add dwg byte 4 to (the address of freeSpace)
        add dwg long 50 to (the address of freeSpace)
        add dwg long 0 to (the address of freeSpace)
        add dwg long 100 to (the address of freeSpace)
        add dwg long 0 to (the address of freeSpace)
        add dwg long 512 to (the address of freeSpace)
        add dwg long 0 to (the address of freeSpace)
        add dwg long -1 to (the address of freeSpace)
        add dwg long 0 to (the address of freeSpace)
        # The template: no description, metric.
        set template to a new bim dwg buffer
        add dwg short 0 to (the address of template)
        add dwg short 1 to (the address of template)
        set auxiliary to the dwg auxiliary header seed seed
        set objects to the dwg bytes of (writer's objects)
        set preview to a new bim dwg buffer
        add dwg hex (the string form of "1F256D07D43628289D57CA3F9D44102B") to (the address of preview)
        add dwg long 1 to (the address of preview)
        add dwg byte 0 to (the address of preview)
        add dwg hex (the string form of "E0DA92F82BC9D7D762A835C062BBEFD4") to (the address of preview)

        # Where each section lands after the 0x61 bytes of file header.
        set headerAt to 97
        set classesAt to headerAt + headerSection's size
        set freeSpaceAt to classesAt + classSection's size
        set templateAt to freeSpaceAt + freeSpace's size
        set auxiliaryAt to templateAt + template's size
        set objectsAt to auxiliaryAt + (the length of auxiliary)
        set handleMap to the dwg object map of writer at objectsAt
        set mapAt to objectsAt + (the length of objects)
        set previewAt to mapAt + (the length of handleMap)

        set file to a new bim dwg buffer
        add dwg bytes (the string form of "AC1015") to (the address of file)
        loop cursor from 0 to 5:
            add dwg byte 0 to (the address of file)
        add dwg byte 15 to (the address of file)
        add dwg byte 1 to (the address of file)
        add dwg long previewAt to (the address of file)
        add dwg byte 27 to (the address of file)
        add dwg byte 25 to (the address of file)
        add dwg short 30 to (the address of file)
        add dwg long 6 to (the address of file)
        add dwg locator 0 at headerAt sized (headerSection's size) to (the address of file)
        add dwg locator 1 at classesAt sized (classSection's size) to (the address of file)
        add dwg locator 2 at mapAt sized (the length of handleMap) to (the address of file)
        add dwg locator 3 at freeSpaceAt sized (freeSpace's size) to (the address of file)
        add dwg locator 4 at templateAt sized (template's size) to (the address of file)
        add dwg locator 5 at auxiliaryAt sized (the length of auxiliary) to (the address of file)
        add dwg short (the dwg crc of file from 0 spanning (file's size) seeded (the dwg crc seed)) to (the address of file)
        add dwg hex (the string form of "95A04E2899821AE55E41E05F9D3A4D00") to (the address of file)
        add dwg bytes (the dwg bytes of headerSection) to (the address of file)
        add dwg bytes (the dwg bytes of classSection) to (the address of file)
        add dwg bytes (the dwg bytes of freeSpace) to (the address of file)
        add dwg bytes (the dwg bytes of template) to (the address of file)
        add dwg bytes auxiliary to (the address of file)
        add dwg bytes objects to (the address of file)
        add dwg bytes handleMap to (the address of file)
        add dwg bytes (the dwg bytes of preview) to (the address of file)
        free (writer's handles)
        free (writer's offsets)
        return the dwg bytes of file
