# SPDX-License-Identifier: MPL-2.0
# A `bim cad drawing record` written as an R2000 (AC1015) ASCII DXF, the
# version every CAD program still reads. The file holds what R2000 needs to
# open without repair: the header with the units (metres, $INSUNITS 6), the
# classes of the objects it writes, the tables (viewport, linetypes, the
# drawing's layers, the text style, applications, the dimension style,
# model and paper space), their blocks, the entities in model space and the
# objects (the named object dictionary, groups, the multiline style, both
# layouts and the plot style placeholder). Its handles are the drawing's
# (`bim_cad_drawing.dl`), shared with the DWG writer.
#
# The groups follow cadcodec's DXF writer (src/io/dxf/writer/
# section_writer.rs at 70ac6da7cf149cea6398a3d8829dd5e48b485b96, MPL-2.0)
# and the AutoCAD 2000 DXF reference; `tests/verify_dxf_dwg.py` reads the
# result back with cadcodec.
import exchange/dxf_dwg/bim_cad_drawing.dl
import exchange/dxf_dwg/bim_sat_text.dl

local function add dxf group {integer:code} text {a string:value} to {a pointer to a list:parts}:
    execute:
        set codeText to the string form of code
        loop while (the length of codeText) < 3:
            set codeText to (the string form of " ") + codeText
        append ((codeText + (the string form of "\r\n")) + (value + (the string form of "\r\n"))) to parts

local function add dxf group {integer:code} integer {integer:value} to {a pointer to a list:parts}:
    execute:
        add dxf group code text (the string form of value) to parts

local function add dxf group {integer:code} number {a 64 bit floating-point number:value} to {a pointer to a list:parts}:
    execute:
        add dxf group code text (the bim cad number of value) to parts

local function add dxf group {integer:code} handle {integer:value} to {a pointer to a list:parts}:
    execute:
        add dxf group code text (the bim cad hex of value) to parts

# A point as its x, y and z groups: `code`, `code` + 10 and `code` + 20.
local function add dxf point {integer:code} at {cad vector3:point} to {a pointer to a list:parts}:
    execute:
        add dxf group code number point's x to parts
        add dxf group (code + 10) number point's y to parts
        add dxf group (code + 20) number point's z to parts

local function add dxf point {integer:code} at {a 64 bit floating-point number:x} {a 64 bit floating-point number:y} {a 64 bit floating-point number:z} to {a pointer to a list:parts}:
    execute:
        add dxf point code at (a cad vector3 with x x, y y and z z) to parts

local function add dxf variable {a string:name} to {a pointer to a list:parts}:
    execute:
        add dxf group 9 text name to parts

# The start of an object: its type, handle and owner.
local function add dxf object {a string:kind} handle {integer:handle} owner {integer:owner} to {a pointer to a list:parts}:
    execute:
        add dxf group 0 text kind to parts
        if kind = "DIMSTYLE":
            add dxf group 105 handle handle to parts
        else:
            add dxf group 5 handle handle to parts
        add dxf group 330 handle owner to parts

# The start of an entity owned by `owner` on layer `layer`.
local function add dxf entity {a string:kind} handle {integer:handle} owner {integer:owner} on {integer:layer} of {bim cad drawing record:drawing} to {a pointer to a list:parts}:
    execute:
        add dxf object kind handle handle owner owner to parts
        add dxf group 100 text (the string form of "AcDbEntity") to parts
        add dxf group 8 text (the bim cad code page text of ((the item at layer in (drawing's layers's values))'s name)) to parts

local function add dxf table {a string:name} handle {integer:handle} entries {integer:count} to {a pointer to a list:parts}:
    execute:
        add dxf group 0 text (the string form of "TABLE") to parts
        add dxf group 2 text name to parts
        add dxf group 5 handle handle to parts
        add dxf group 330 text (the string form of "0") to parts
        add dxf group 100 text (the string form of "AcDbSymbolTable") to parts
        add dxf group 70 integer count to parts

local function add dxf table record {a string:kind} named {a string:name} handle {integer:handle} owner {integer:owner} subclass {a string:subclass} to {a pointer to a list:parts}:
    execute:
        add dxf object kind handle handle owner owner to parts
        add dxf group 100 text (the string form of "AcDbSymbolTableRecord") to parts
        add dxf group 100 text subclass to parts
        add dxf group 2 text name to parts
        add dxf group 70 integer 0 to parts

local function add dxf header of {bim cad drawing record:drawing} to {a pointer to a list:parts}:
    execute:
        set bounds to the bim cad extents of drawing
        if bounds's valid = false:
            set bounds's low to the cad zero vector3
            set bounds's high to the cad zero vector3
        add dxf group 0 text (the string form of "SECTION") to parts
        add dxf group 2 text (the string form of "HEADER") to parts
        add dxf variable (the string form of "$ACADVER") to parts
        add dxf group 1 text (the string form of "AC1015") to parts
        add dxf variable (the string form of "$ACADMAINTVER") to parts
        add dxf group 70 integer 6 to parts
        add dxf variable (the string form of "$DWGCODEPAGE") to parts
        add dxf group 3 text (the string form of "ANSI_1252") to parts
        add dxf variable (the string form of "$INSBASE") to parts
        add dxf point 10 at (the cad zero vector3) to parts
        add dxf variable (the string form of "$EXTMIN") to parts
        add dxf point 10 at (bounds's low) to parts
        add dxf variable (the string form of "$EXTMAX") to parts
        add dxf point 10 at (bounds's high) to parts
        add dxf variable (the string form of "$LIMMIN") to parts
        add dxf group 10 number (bounds's low's x) to parts
        add dxf group 20 number (bounds's low's y) to parts
        add dxf variable (the string form of "$LIMMAX") to parts
        add dxf group 10 number (bounds's high's x) to parts
        add dxf group 20 number (bounds's high's y) to parts
        add dxf variable (the string form of "$ORTHOMODE") to parts
        add dxf group 70 integer 0 to parts
        add dxf variable (the string form of "$LTSCALE") to parts
        add dxf group 40 number 1.0 to parts
        add dxf variable (the string form of "$TEXTSIZE") to parts
        add dxf group 40 number 0.25 to parts
        add dxf variable (the string form of "$TEXTSTYLE") to parts
        add dxf group 7 text (the string form of "Standard") to parts
        add dxf variable (the string form of "$CLAYER") to parts
        add dxf group 8 text (the string form of "0") to parts
        add dxf variable (the string form of "$CELTYPE") to parts
        add dxf group 6 text (the string form of "ByLayer") to parts
        add dxf variable (the string form of "$CECOLOR") to parts
        add dxf group 62 integer 256 to parts
        add dxf variable (the string form of "$DIMSTYLE") to parts
        add dxf group 2 text (the string form of "Standard") to parts
        add dxf variable (the string form of "$LUNITS") to parts
        add dxf group 70 integer 2 to parts
        add dxf variable (the string form of "$LUPREC") to parts
        add dxf group 70 integer 3 to parts
        add dxf variable (the string form of "$AUNITS") to parts
        add dxf group 70 integer 0 to parts
        add dxf variable (the string form of "$AUPREC") to parts
        add dxf group 70 integer 2 to parts
        add dxf variable (the string form of "$HANDSEED") to parts
        add dxf group 5 handle (the bim cad handle seed of drawing) to parts
        add dxf variable (the string form of "$CMLSTYLE") to parts
        add dxf group 2 text (the string form of "Standard") to parts
        add dxf variable (the string form of "$PUCSNAME") to parts
        add dxf group 2 text (the string form of "") to parts
        add dxf variable (the string form of "$UCSNAME") to parts
        add dxf group 2 text (the string form of "") to parts
        add dxf variable (the string form of "$INSUNITS") to parts
        add dxf group 70 integer 6 to parts
        add dxf variable (the string form of "$MEASUREMENT") to parts
        add dxf group 70 integer 1 to parts
        add dxf variable (the string form of "$CELWEIGHT") to parts
        add dxf group 370 integer -1 to parts
        add dxf variable (the string form of "$ENDCAPS") to parts
        add dxf group 280 integer 0 to parts
        add dxf variable (the string form of "$JOINSTYLE") to parts
        add dxf group 280 integer 0 to parts
        add dxf variable (the string form of "$LWDISPLAY") to parts
        add dxf group 290 integer 0 to parts
        add dxf variable (the string form of "$PSTYLEMODE") to parts
        add dxf group 290 integer 1 to parts
        add dxf group 0 text (the string form of "ENDSEC") to parts

local function add dxf class {a string:dxfName} named {a string:className} flags {integer:flags} entity {boolean:isEntity} to {a pointer to a list:parts}:
    execute:
        add dxf group 0 text (the string form of "CLASS") to parts
        add dxf group 1 text dxfName to parts
        add dxf group 2 text className to parts
        add dxf group 3 text (the string form of "ObjectDBX Classes") to parts
        add dxf group 90 integer flags to parts
        if isEntity:
            add dxf group 280 integer 0 to parts
            add dxf group 281 integer 1 to parts
        else:
            add dxf group 280 integer 0 to parts
            add dxf group 281 integer 0 to parts

local function add dxf classes to {a pointer to a list:parts}:
    execute:
        add dxf group 0 text (the string form of "SECTION") to parts
        add dxf group 2 text (the string form of "CLASSES") to parts
        add dxf class (the string form of "ACDBDICTIONARYWDFLT") named (the string form of "AcDbDictionaryWithDefault") flags 0 entity false to parts
        add dxf class (the string form of "ACDBPLACEHOLDER") named (the string form of "AcDbPlaceHolder") flags 0 entity false to parts
        add dxf class (the string form of "LAYOUT") named (the string form of "AcDbLayout") flags 0 entity false to parts
        add dxf group 0 text (the string form of "ENDSEC") to parts

local function add dxf tables of {bim cad drawing record:drawing} to {a pointer to a list:parts}:
    execute:
        add dxf group 0 text (the string form of "SECTION") to parts
        add dxf group 2 text (the string form of "TABLES") to parts
        # Viewports: the active one, looking at the drawing from above.
        add dxf table (the string form of "VPORT") handle (bim cad viewport control handle) entries 1 to parts
        add dxf table record (the string form of "VPORT") named (the string form of "*Active") handle (bim cad active viewport handle) owner (bim cad viewport control handle) subclass (the string form of "AcDbViewportTableRecord") to parts
        set bounds to the bim cad extents of drawing
        set middle to the cad zero vector3
        set span to 10.0
        if bounds's valid:
            set middle to a cad vector3 with x ((bounds's low's x + bounds's high's x) / 2.0), y ((bounds's low's y + bounds's high's y) / 2.0) and z 0.0
            set span to the maximum of (the maximum of (bounds's high's x - bounds's low's x) and (bounds's high's y - bounds's low's y)) and 1.0
        add dxf group 10 number 0.0 to parts
        add dxf group 20 number 0.0 to parts
        add dxf group 11 number 1.0 to parts
        add dxf group 21 number 1.0 to parts
        add dxf group 12 number (middle's x) to parts
        add dxf group 22 number (middle's y) to parts
        add dxf group 13 number 0.0 to parts
        add dxf group 23 number 0.0 to parts
        add dxf group 14 number 0.5 to parts
        add dxf group 24 number 0.5 to parts
        add dxf group 15 number 0.5 to parts
        add dxf group 25 number 0.5 to parts
        add dxf point 16 at 0.0 0.0 1.0 to parts
        add dxf point 17 at 0.0 0.0 0.0 to parts
        add dxf group 40 number (span * 1.1) to parts
        add dxf group 41 number 1.5 to parts
        add dxf group 42 number 50.0 to parts
        add dxf group 43 number 0.0 to parts
        add dxf group 44 number 0.0 to parts
        add dxf group 50 number 0.0 to parts
        add dxf group 51 number 0.0 to parts
        add dxf group 71 integer 0 to parts
        add dxf group 72 integer 100 to parts
        add dxf group 73 integer 1 to parts
        add dxf group 74 integer 3 to parts
        add dxf group 75 integer 0 to parts
        add dxf group 76 integer 0 to parts
        add dxf group 77 integer 0 to parts
        add dxf group 78 integer 0 to parts
        add dxf group 281 integer 0 to parts
        add dxf group 65 integer 1 to parts
        add dxf point 110 at 0.0 0.0 0.0 to parts
        add dxf point 111 at 1.0 0.0 0.0 to parts
        add dxf point 112 at 0.0 1.0 0.0 to parts
        add dxf group 79 integer 0 to parts
        add dxf group 146 number 0.0 to parts
        add dxf group 0 text (the string form of "ENDTAB") to parts
        # Linetypes.
        add dxf table (the string form of "LTYPE") handle (bim cad linetype control handle) entries 3 to parts
        add dxf table record (the string form of "LTYPE") named (the string form of "ByBlock") handle (bim cad by block linetype handle) owner (bim cad linetype control handle) subclass (the string form of "AcDbLinetypeTableRecord") to parts
        add dxf linetype tail (the string form of "") to parts
        add dxf table record (the string form of "LTYPE") named (the string form of "ByLayer") handle (bim cad by layer linetype handle) owner (bim cad linetype control handle) subclass (the string form of "AcDbLinetypeTableRecord") to parts
        add dxf linetype tail (the string form of "") to parts
        add dxf table record (the string form of "LTYPE") named (the string form of "Continuous") handle (bim cad continuous linetype handle) owner (bim cad linetype control handle) subclass (the string form of "AcDbLinetypeTableRecord") to parts
        add dxf linetype tail (the string form of "Solid line") to parts
        add dxf group 0 text (the string form of "ENDTAB") to parts
        # Layers.
        add dxf table (the string form of "LAYER") handle (bim cad layer control handle) entries (the length of (drawing's layers's values)) to parts
        loop cursor from 0 to the length of (drawing's layers's values):
            set layer to the item at cursor in (drawing's layers's values)
            add dxf table record (the string form of "LAYER") named (the bim cad code page text of layer's name) handle (the bim cad handle of layer cursor) owner (bim cad layer control handle) subclass (the string form of "AcDbLayerTableRecord") to parts
            add dxf group 62 integer (layer's colour) to parts
            add dxf group 6 text (the string form of "Continuous") to parts
            add dxf group 370 integer -3 to parts
            add dxf group 390 handle (bim cad plot style placeholder handle) to parts
        add dxf group 0 text (the string form of "ENDTAB") to parts
        # The text style.
        add dxf table (the string form of "STYLE") handle (bim cad style control handle) entries 1 to parts
        add dxf table record (the string form of "STYLE") named (the string form of "Standard") handle (bim cad standard style handle) owner (bim cad style control handle) subclass (the string form of "AcDbTextStyleTableRecord") to parts
        add dxf group 40 number 0.0 to parts
        add dxf group 41 number 1.0 to parts
        add dxf group 50 number 0.0 to parts
        add dxf group 71 integer 0 to parts
        add dxf group 42 number 0.25 to parts
        add dxf group 3 text (the string form of "txt") to parts
        add dxf group 4 text (the string form of "") to parts
        add dxf group 0 text (the string form of "ENDTAB") to parts
        # Views and coordinate systems: none.
        add dxf table (the string form of "VIEW") handle (bim cad view control handle) entries 0 to parts
        add dxf group 0 text (the string form of "ENDTAB") to parts
        add dxf table (the string form of "UCS") handle (bim cad ucs control handle) entries 0 to parts
        add dxf group 0 text (the string form of "ENDTAB") to parts
        # Applications.
        add dxf table (the string form of "APPID") handle (bim cad application control handle) entries 1 to parts
        add dxf table record (the string form of "APPID") named (the string form of "ACAD") handle (bim cad acad application handle) owner (bim cad application control handle) subclass (the string form of "AcDbRegAppTableRecord") to parts
        add dxf group 0 text (the string form of "ENDTAB") to parts
        # The dimension style, with its own subclass marker.
        add dxf table (the string form of "DIMSTYLE") handle (bim cad dimension style control handle) entries 1 to parts
        add dxf group 100 text (the string form of "AcDbDimStyleTable") to parts
        add dxf table record (the string form of "DIMSTYLE") named (the string form of "Standard") handle (bim cad standard dimension style handle) owner (bim cad dimension style control handle) subclass (the string form of "AcDbDimStyleTableRecord") to parts
        add dxf group 340 handle (bim cad standard style handle) to parts
        add dxf group 0 text (the string form of "ENDTAB") to parts
        # Model and paper space.
        add dxf table (the string form of "BLOCK_RECORD") handle (bim cad block control handle) entries 2 to parts
        add dxf table record (the string form of "BLOCK_RECORD") named (the string form of "*Model_Space") handle (bim cad model space handle) owner (bim cad block control handle) subclass (the string form of "AcDbBlockTableRecord") to parts
        add dxf group 340 handle (bim cad model layout handle) to parts
        add dxf table record (the string form of "BLOCK_RECORD") named (the string form of "*Paper_Space") handle (bim cad paper space handle) owner (bim cad block control handle) subclass (the string form of "AcDbBlockTableRecord") to parts
        add dxf group 340 handle (bim cad paper layout handle) to parts
        add dxf group 0 text (the string form of "ENDTAB") to parts
        add dxf group 0 text (the string form of "ENDSEC") to parts

# A linetype record's remaining groups: a description and no dashes.
local function add dxf linetype tail {a string:description} to {a pointer to a list:parts}:
    execute:
        add dxf group 3 text description to parts
        add dxf group 72 integer 65 to parts
        add dxf group 73 integer 0 to parts
        add dxf group 40 number 0.0 to parts

local function add dxf block {a string:name} handle {integer:handle} end {integer:ending} owner {integer:owner} to {a pointer to a list:parts}:
    execute:
        add dxf object (the string form of "BLOCK") handle handle owner owner to parts
        add dxf group 100 text (the string form of "AcDbEntity") to parts
        add dxf group 8 text (the string form of "0") to parts
        add dxf group 100 text (the string form of "AcDbBlockBegin") to parts
        add dxf group 2 text name to parts
        add dxf group 70 integer 0 to parts
        add dxf point 10 at (the cad zero vector3) to parts
        add dxf group 3 text name to parts
        add dxf group 1 text (the string form of "") to parts
        add dxf object (the string form of "ENDBLK") handle ending owner owner to parts
        add dxf group 100 text (the string form of "AcDbEntity") to parts
        add dxf group 8 text (the string form of "0") to parts
        add dxf group 100 text (the string form of "AcDbBlockEnd") to parts

local function add dxf blocks to {a pointer to a list:parts}:
    execute:
        add dxf group 0 text (the string form of "SECTION") to parts
        add dxf group 2 text (the string form of "BLOCKS") to parts
        add dxf block (the string form of "*Model_Space") handle (bim cad model block handle) end (bim cad model block end handle) owner (bim cad model space handle) to parts
        add dxf block (the string form of "*Paper_Space") handle (bim cad paper block handle) end (bim cad paper block end handle) owner (bim cad paper space handle) to parts
        add dxf group 0 text (the string form of "ENDSEC") to parts

local function add dxf entities of {bim cad drawing record:drawing} to {a pointer to a list:parts}:
    execute:
        set owner to bim cad model space handle
        set handle to the bim cad first entity handle of drawing
        add dxf group 0 text (the string form of "SECTION") to parts
        add dxf group 2 text (the string form of "ENTITIES") to parts
        loop cursor from 0 to the length of (drawing's lines's values):
            set line to the item at cursor in (drawing's lines's values)
            add dxf entity (the string form of "LINE") handle handle owner owner on line's layer of drawing to parts
            add dxf group 100 text (the string form of "AcDbLine") to parts
            add dxf point 10 at line's start to parts
            add dxf point 11 at line's finish to parts
            set handle to handle + 1
        loop cursor from 0 to the length of (drawing's polylines's values):
            set outline to the item at cursor in (drawing's polylines's values)
            set points to outline's points's values
            set flags to 0
            if outline's closed:
                set flags to 1
            if bim cad polyline outline is flat:
                add dxf entity (the string form of "LWPOLYLINE") handle handle owner owner on outline's layer of drawing to parts
                add dxf group 100 text (the string form of "AcDbPolyline") to parts
                add dxf group 90 integer (the length of points) to parts
                add dxf group 70 integer flags to parts
                add dxf group 38 number ((the item at 0 in points)'s z) to parts
                loop corner from 0 to the length of points:
                    add dxf group 10 number ((the item at corner in points)'s x) to parts
                    add dxf group 20 number ((the item at corner in points)'s y) to parts
                set handle to handle + 1
            else:
                set chainHandle to handle
                add dxf entity (the string form of "POLYLINE") handle handle owner owner on outline's layer of drawing to parts
                add dxf group 100 text (the string form of "AcDb3dPolyline") to parts
                add dxf group 66 integer 1 to parts
                add dxf point 10 at 0.0 0.0 0.0 to parts
                add dxf group 70 integer (flags + 8) to parts
                set handle to handle + 1
                loop corner from 0 to the length of points:
                    add dxf entity (the string form of "VERTEX") handle handle owner chainHandle on outline's layer of drawing to parts
                    add dxf group 100 text (the string form of "AcDbVertex") to parts
                    add dxf group 100 text (the string form of "AcDb3dPolylineVertex") to parts
                    add dxf point 10 at (the item at corner in points) to parts
                    add dxf group 70 integer 32 to parts
                    set handle to handle + 1
                add dxf entity (the string form of "SEQEND") handle handle owner chainHandle on outline's layer of drawing to parts
                set handle to handle + 1
        loop cursor from 0 to the length of (drawing's texts's values):
            set label to the item at cursor in (drawing's texts's values)
            add dxf entity (the string form of "TEXT") handle handle owner owner on label's layer of drawing to parts
            add dxf group 100 text (the string form of "AcDbText") to parts
            add dxf point 10 at label's position to parts
            add dxf group 40 number label's height to parts
            add dxf group 1 text (the bim cad code page text of label's message) to parts
            add dxf group 50 number (label's angle * (180.0 / 3.141592653589793)) to parts
            add dxf group 7 text (the string form of "Standard") to parts
            if label's centred:
                add dxf group 72 integer 1 to parts
                add dxf point 11 at label's position to parts
            add dxf group 100 text (the string form of "AcDbText") to parts
            add dxf group 73 integer 0 to parts
            set handle to handle + 1
        loop cursor from 0 to the length of (drawing's meshes's values):
            set meshValue to the item at cursor in (drawing's meshes's values)
            set faces to meshValue's faces's values
            set faceCount to 0
            set faceCursor to 0
            loop while faceCursor < (the length of faces):
                set faceCount to faceCount + 1
                set faceCursor to faceCursor + ((the item at faceCursor in faces) + 1)
            set meshHandle to handle
            add dxf entity (the string form of "POLYLINE") handle handle owner owner on meshValue's layer of drawing to parts
            add dxf group 100 text (the string form of "AcDbPolyFaceMesh") to parts
            add dxf group 66 integer 1 to parts
            add dxf point 10 at 0.0 0.0 0.0 to parts
            add dxf group 70 integer 64 to parts
            add dxf group 71 integer (the length of (meshValue's positions's values)) to parts
            add dxf group 72 integer faceCount to parts
            set handle to handle + 1
            loop corner from 0 to the length of (meshValue's positions's values):
                add dxf entity (the string form of "VERTEX") handle handle owner meshHandle on meshValue's layer of drawing to parts
                add dxf group 100 text (the string form of "AcDbVertex") to parts
                add dxf group 100 text (the string form of "AcDbPolyFaceMeshVertex") to parts
                add dxf point 10 at (the item at corner in (meshValue's positions's values)) to parts
                add dxf group 70 integer 192 to parts
                set handle to handle + 1
            set faceCursor to 0
            loop while faceCursor < (the length of faces):
                set count to the item at faceCursor in faces
                add dxf entity (the string form of "VERTEX") handle handle owner meshHandle on meshValue's layer of drawing to parts
                add dxf group 100 text (the string form of "AcDbFaceRecord") to parts
                add dxf point 10 at 0.0 0.0 0.0 to parts
                add dxf group 70 integer 128 to parts
                loop corner from 0 to count:
                    add dxf group (71 + corner) integer ((the item at (faceCursor + (corner + 1)) in faces) + 1) to parts
                set faceCursor to faceCursor + (count + 1)
                set handle to handle + 1
            add dxf entity (the string form of "SEQEND") handle handle owner meshHandle on meshValue's layer of drawing to parts
            set handle to handle + 1
        loop cursor from 0 to the length of (drawing's solids's values):
            set solid to the item at cursor in (drawing's solids's values)
            add dxf entity (the string form of "3DSOLID") handle handle owner owner on solid's layer of drawing to parts
            add dxf group 100 text (the string form of "AcDbModelerGeometry") to parts
            add dxf group 70 integer 1 to parts
            set sat to the bim sat text of solid for dwg false
            set coded to the bim dxf sat cipher of sat's text
            # One group 1 per SAT line, longer lines continued in groups 3.
            set lineStart to 0
            loop position from 0 to the length of coded:
                if (the character at position in coded) = 10:
                    add dxf sat line (the substring of coded from lineStart spanning (position - lineStart) bytes) to parts
                    set lineStart to position + 1
            set handle to handle + 1
        add dxf group 0 text (the string form of "ENDSEC") to parts

local function add dxf sat line {a string:line} to {a pointer to a list:parts}:
    execute:
        set start to 0
        set code to 1
        loop while ((the length of line) - start) > 255:
            add dxf group code text (the substring of line from start spanning 255 bytes) to parts
            set start to start + 255
            set code to 3
        add dxf group code text (the substring of line from start spanning ((the length of line) - start) bytes) to parts

local function add dxf dictionary {integer:handle} owner {integer:owner} to {a pointer to a list:parts}:
    execute:
        add dxf object (the string form of "DICTIONARY") handle handle owner owner to parts
        add dxf group 100 text (the string form of "AcDbDictionary") to parts
        add dxf group 281 integer 1 to parts

local function add dxf entry {a string:name} to {integer:handle} into {a pointer to a list:parts}:
    execute:
        add dxf group 3 text name to parts
        add dxf group 350 handle handle to parts

# A layout with default plot settings over the block record `space`.
local function add dxf layout {a string:name} handle {integer:handle} space {integer:space} order {integer:order} to {a pointer to a list:parts}:
    execute:
        add dxf object (the string form of "LAYOUT") handle handle owner (bim cad layout dictionary handle) to parts
        add dxf group 100 text (the string form of "AcDbPlotSettings") to parts
        add dxf group 1 text (the string form of "") to parts
        add dxf group 2 text (the string form of "none_device") to parts
        add dxf group 4 text (the string form of "") to parts
        add dxf group 6 text (the string form of "") to parts
        loop code from 40 to 50:
            add dxf group code number 0.0 to parts
        add dxf group 140 number 0.0 to parts
        add dxf group 141 number 0.0 to parts
        add dxf group 142 number 1.0 to parts
        add dxf group 143 number 1.0 to parts
        if order = 0:
            add dxf group 70 integer 1024 to parts
        else:
            add dxf group 70 integer 0 to parts
        add dxf group 72 integer 1 to parts
        add dxf group 73 integer 0 to parts
        add dxf group 74 integer 5 to parts
        add dxf group 7 text (the string form of "") to parts
        add dxf group 75 integer 16 to parts
        add dxf group 147 number 1.0 to parts
        add dxf group 148 number 0.0 to parts
        add dxf group 149 number 0.0 to parts
        add dxf group 100 text (the string form of "AcDbLayout") to parts
        add dxf group 1 text name to parts
        add dxf group 70 integer 1 to parts
        add dxf group 71 integer order to parts
        add dxf group 10 number 0.0 to parts
        add dxf group 20 number 0.0 to parts
        add dxf group 11 number 12.0 to parts
        add dxf group 21 number 9.0 to parts
        add dxf point 12 at 0.0 0.0 0.0 to parts
        add dxf point 14 at 0.0 0.0 0.0 to parts
        add dxf point 15 at 12.0 9.0 0.0 to parts
        add dxf group 146 number 0.0 to parts
        add dxf point 13 at 0.0 0.0 0.0 to parts
        add dxf point 16 at 1.0 0.0 0.0 to parts
        add dxf point 17 at 0.0 1.0 0.0 to parts
        add dxf group 76 integer 0 to parts
        add dxf group 330 handle space to parts

local function add dxf objects to {a pointer to a list:parts}:
    execute:
        add dxf group 0 text (the string form of "SECTION") to parts
        add dxf group 2 text (the string form of "OBJECTS") to parts
        add dxf dictionary (bim cad named objects handle) owner 0 to parts
        add dxf entry (the string form of "ACAD_GROUP") to (bim cad group dictionary handle) into parts
        add dxf entry (the string form of "ACAD_LAYOUT") to (bim cad layout dictionary handle) into parts
        add dxf entry (the string form of "ACAD_MLINESTYLE") to (bim cad multiline style dictionary handle) into parts
        add dxf entry (the string form of "ACAD_PLOTSETTINGS") to (bim cad plot settings dictionary handle) into parts
        add dxf entry (the string form of "ACAD_PLOTSTYLENAME") to (bim cad plot style dictionary handle) into parts
        add dxf dictionary (bim cad group dictionary handle) owner (bim cad named objects handle) to parts
        add dxf dictionary (bim cad layout dictionary handle) owner (bim cad named objects handle) to parts
        add dxf entry (the string form of "Layout1") to (bim cad paper layout handle) into parts
        add dxf entry (the string form of "Model") to (bim cad model layout handle) into parts
        add dxf dictionary (bim cad multiline style dictionary handle) owner (bim cad named objects handle) to parts
        add dxf entry (the string form of "Standard") to (bim cad multiline style handle) into parts
        add dxf dictionary (bim cad plot settings dictionary handle) owner (bim cad named objects handle) to parts
        add dxf object (the string form of "ACDBDICTIONARYWDFLT") handle (bim cad plot style dictionary handle) owner (bim cad named objects handle) to parts
        add dxf group 100 text (the string form of "AcDbDictionary") to parts
        add dxf group 281 integer 1 to parts
        add dxf entry (the string form of "Normal") to (bim cad plot style placeholder handle) into parts
        add dxf group 100 text (the string form of "AcDbDictionaryWithDefault") to parts
        add dxf group 340 handle (bim cad plot style placeholder handle) to parts
        add dxf object (the string form of "ACDBPLACEHOLDER") handle (bim cad plot style placeholder handle) owner (bim cad plot style dictionary handle) to parts
        add dxf object (the string form of "MLINESTYLE") handle (bim cad multiline style handle) owner (bim cad multiline style dictionary handle) to parts
        add dxf group 100 text (the string form of "AcDbMlineStyle") to parts
        add dxf group 2 text (the string form of "Standard") to parts
        add dxf group 70 integer 0 to parts
        add dxf group 3 text (the string form of "") to parts
        add dxf group 62 integer 256 to parts
        add dxf group 51 number 90.0 to parts
        add dxf group 52 number 90.0 to parts
        add dxf group 71 integer 2 to parts
        add dxf group 49 number 0.5 to parts
        add dxf group 62 integer 256 to parts
        add dxf group 6 text (the string form of "BYLAYER") to parts
        add dxf group 49 number -0.5 to parts
        add dxf group 62 integer 256 to parts
        add dxf group 6 text (the string form of "BYLAYER") to parts
        add dxf layout (the string form of "Model") handle (bim cad model layout handle) space (bim cad model space handle) order 0 to parts
        add dxf layout (the string form of "Layout1") handle (bim cad paper layout handle) space (bim cad paper space handle) order 1 to parts
        add dxf group 0 text (the string form of "ENDSEC") to parts

# The DXF text of `drawing`.
function the bim dxf of {bim cad drawing record:drawing}:
    execute:
        set parts to an empty list of a string
        add dxf header of drawing to parts
        add dxf classes to parts
        add dxf tables of drawing to parts
        add dxf blocks to parts
        add dxf entities of drawing to parts
        add dxf objects to parts
        add dxf group 0 text (the string form of "EOF") to parts
        set written to parts joined with ""
        free parts
        return written
