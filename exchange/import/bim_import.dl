# SPDX-License-Identifier: MPL-2.0
# Imported elements: read-only meshes read from a BIM-MESH file, the format
# `import/ifc_to_mesh.py` writes from an IFC file through IfcOpenShell. Each
# element becomes a scene mesh in its category, flat-shaded, with an id from
# `the bim imported id base` up and its label ("<IFC class> <GlobalId>
# <Name>") alongside. A later step reads IFC directly in DynLex.
import viewer/bim_mesh.dl
import viewer/bim_scene.dl
import exchange/ifcx/bim_file.dl

# The storeys of an import: their names and elevations (metres, in the
# world), and for each element the storey it is contained in (-1: none).
class:
    patterns:
        [a|] bim import storeys record
    members:
        names as the type of (a cad topology list of a string)
        elevations as the type of (a cad topology list of a 64 bit floating-point number)
        ofElements as the type of (a cad topology list of an integer)

function no bim import storeys:
    execute:
        return @intrinsic("construct", a bim import storeys record, a cad topology list of a string, a cad topology list of a 64 bit floating-point number, a cad topology list of an integer)

# Imported meshes that place a shape shared with others (an IFC element made
# of one mapped item), so that the 3D view draws the shape once and places it
# per mesh: the shapes in their own coordinates, and for each imported mesh
# the shape it places (-1: none, or past the list's end) and twelve numbers
# placing it, by rows: the x, y and z axes' parts and the shift.
class:
    patterns:
        [a|] bim import instancing record
    members:
        prototypes as the type of (a cad topology list of a fast mesh record)
        prototypeOf as the type of (a cad topology list of an integer)
        transforms as the type of (a cad topology list of a 64 bit floating-point number)

function no bim import instancing:
    execute:
        return @intrinsic("construct", a bim import instancing record, a cad topology list of a fast mesh record, a cad topology list of an integer, a cad topology list of a 64 bit floating-point number)

# How much of `imported` the 3D view draws as instances, for a message:
# "; 3600 meshes (1000000 triangles) as instances of 200 shapes".
function the bim instancing text of {bim import record:imported}:
    execute:
        set placedMeshes to 0
        set placedTriangles to 0
        loop cursor from 0 to the length of (imported's meshes's values):
            if (the bim prototype of imported mesh cursor in imported) >= 0:
                set placedMeshes to placedMeshes + 1
                set placedTriangles to placedTriangles + ((the length of ((the item at cursor in (imported's meshes's values))'s shape's triangles's values)) / 3)
        set written to ((the string form of "; ") + (the string form of placedMeshes)) + (the string form of " meshes (")
        set written to (written + (the string form of placedTriangles)) + (the string form of " triangles) as instances of ")
        return (written + (the string form of (the length of (imported's instancing's prototypes's values)))) + (the string form of " shapes")

# The shape imported mesh `index` places, or -1.
function the bim prototype of imported mesh {integer:index} in {bim import record:imported}:
    execute:
        set placing to imported's instancing's prototypeOf's values
        if (index >= 0) and (index < (the length of placing)):
            return the item at index in placing
        return -1

class:
    patterns:
        [a|] bim import record
    members:
        valid as a boolean
        message as a string
        meshes as the type of (a cad topology list of a bim scene mesh record)
        labels as the type of (a cad topology list of a string)
        triangleCount as an integer
        low as a cad vector3
        high as a cad vector3
        # Polylines (IfcX basiscurves) as pairs of points: space boundaries,
        # axes, alignments.
        curves as the type of (a cad topology list of a cad vector3)
        storeys as a bim import storeys record
        instancing as a bim import instancing record
        # The imported elements' property sets, keyed by element index.
        psets as the type of (a cad topology list of a bim pset entry record)

# The elevation of the storey scene mesh `entry` belongs to: its element's
# level in `modelValue`, or for an imported element the storey it is
# contained in; not a number when it has none.
function the bim storey elevation of mesh {bim scene mesh record:entry} in {bim model record:modelValue} with {bim import record:imported}:
    execute:
        if entry's elementId >= (the bim imported id base):
            return the bim storey elevation of imported element ((entry's elementId - (the bim imported id base)) as an integer) in imported
        set levelFound to the bim level index of (the bim level of element entry's elementId in modelValue) in modelValue
        if levelFound's valid:
            return (the item at levelFound's position in (modelValue's levels's values))'s elevation
        return 0.0 / 0.0

# The storeys of `modelValue`'s levels and `imported`'s storeys by
# elevation, ascending: a storey within a millimetre of one before it is
# the same storey, named by the first.
class:
    patterns:
        [a|] bim storey list record
    members:
        elevations as the type of (an empty list of a 64 bit floating-point number)
        names as the type of (an empty list of a string)

function the bim storeys of {bim model record:modelValue} with {bim import record:imported}:
    execute:
        set heights to an empty list of a 64 bit floating-point number
        set titles to an empty list of a string
        loop cursor from 0 to the length of (modelValue's levels's values):
            set levelValue to the item at cursor in (modelValue's levels's values)
            add bim storey levelValue's name at levelValue's elevation to heights and titles
        loop cursor from 0 to the length of (imported's storeys's names's values):
            add bim storey (the item at cursor in (imported's storeys's names's values)) at (the item at cursor in (imported's storeys's elevations's values)) to heights and titles
        return @intrinsic("construct", a bim storey list record, heights, titles)

local function add bim storey {a string:title} at {a 64 bit floating-point number:height} to {a pointer to a list:heights} and {a pointer to a list:titles}:
    execute:
        set place to 0
        loop while place < (the length of heights):
            set there to the item at place in heights
            if (the absolute value of (there - height)) < 0.001:
                return nothing
            if there > height:
                insert height into heights at index place
                insert title into titles at index place
                return nothing
            set place to place + 1
        append height to heights
        append title to titles

# Of `meshes`, those whose storey (`the bim storey elevation of mesh …`) is
# the one at `height`, within a millimetre; meshes in no storey are left out.
function the bim meshes of {a pointer to a list:meshes} on storey at {a 64 bit floating-point number:height} of {bim model record:modelValue} with {bim import record:imported}:
    execute:
        set result to a cad topology list of a bim scene mesh record
        loop cursor from 0 to the length of meshes:
            set entry to the item at cursor in meshes
            if (the absolute value of ((the bim storey elevation of mesh entry in modelValue with imported) - height)) < 0.001:
                append entry to (result's values)
        return result

# The elevation of the storey imported element `index` (counted from the
# first) is contained in; not a number when it is in none.
function the bim storey elevation of imported element {integer:index} in {bim import record:imported}:
    execute:
        set storeyOf to imported's storeys's ofElements's values
        if (index >= 0) and (index < (the length of storeyOf)):
            set storeyIndex to the item at index in storeyOf
            if storeyIndex >= 0:
                return the item at storeyIndex in (imported's storeys's elevations's values)
        return 0.0 / 0.0

local function a bim import refusal saying {a string:reason}:
    execute:
        set origin to a cad vector3 with x 0.0, y 0.0 and z 0.0
        return @intrinsic("construct", a bim import record, false, reason, a cad topology list of a bim scene mesh record, a cad topology list of a string, 0, origin, origin, a cad topology list of a cad vector3, no bim import storeys, no bim import instancing, a cad topology list of a bim pset entry record)

local function the bim unsigned at {integer:offset} in {a string:content}:
    execute:
        return (@intrinsic("dereference", ((the data of content) + offset) as a pointer to a 32 bit unsigned integer)) as an integer

local function the bim double at {integer:offset} in {a string:content}:
    execute:
        return @intrinsic("dereference", ((the data of content) + offset) as a pointer to a 64 bit floating-point number)

# The elements of the BIM-MESH file at `path`, or a refusal naming the fault.
function the bim import of {a string:path}:
    execute:
        set loaded to the bim file content at path
        if loaded's valid = false:
            return a bim import refusal saying ((the string form of "could not read ") + path)
        set content to loaded's text
        set size to the length of content
        if (size < 12) or ((the substring of content from 0 spanning 8 bytes) != (the string form of "BIMMESH1")):
            return a bim import refusal saying (the string form of "not a BIM-MESH file")
        set count to the bim unsigned at 8 in content
        set meshes to a cad topology list of a bim scene mesh record
        set labels to a cad topology list of a string
        set infinity to 1.0 / 0.0
        set lowX to infinity
        set lowY to infinity
        set lowZ to infinity
        set highX to 0.0 - infinity
        set highY to highX
        set highZ to highX
        set triangles to 0
        set offset to 12
        loop element from 0 to count:
            if (offset + 8) > size:
                return a bim import refusal saying (the string form of "the file ends inside an element")
            set category to the bim unsigned at offset in content
            set labelLength to the bim unsigned at (offset + 4) in content
            set offset to offset + 8
            if ((offset + labelLength) + 4) > size:
                return a bim import refusal saying (the string form of "the file ends inside a label")
            set label to the substring of content from offset spanning labelLength bytes
            set offset to offset + labelLength
            set vertexCount to the bim unsigned at offset in content
            set offset to offset + 4
            set vertexStart to offset
            if ((offset + (vertexCount * 24)) + 4) > size:
                return a bim import refusal saying (the string form of "the file ends inside the vertices")
            set offset to offset + (vertexCount * 24)
            set triangleCount to the bim unsigned at offset in content
            set offset to offset + 4
            if (offset + (triangleCount * 12)) > size:
                return a bim import refusal saying (the string form of "the file ends inside the triangles")
            # Flat shading: each triangle gets its own three corners with its
            # face normal.
            set shape to an empty fast mesh
            loop face from 0 to triangleCount:
                set corners to an empty list of a cad vector3
                loop corner from 0 to 3:
                    set index to the bim unsigned at (offset + (((face * 3) + corner) * 4)) in content
                    if (index < 0) or (index >= vertexCount):
                        free corners
                        return a bim import refusal saying (the string form of "a triangle refers to a missing vertex")
                    set vertexOffset to vertexStart + (index * 24)
                    append (a cad vector3 with x (the bim double at vertexOffset in content), y (the bim double at (vertexOffset + 8) in content) and z (the bim double at (vertexOffset + 16) in content)) to corners
                set first to the item at 0 in corners
                set second to the item at 1 in corners
                set third to the item at 2 in corners
                set normal to the cad cross of (the cad difference of second and first) and (the cad difference of third and first)
                set magnitude to the cad length of normal
                if magnitude > 0.0:
                    set normal to normal scaled by (1.0 / magnitude)
                    set base to the length of (shape's positions's values)
                    loop corner from 0 to 3:
                        set point to the item at corner in corners
                        append point to (shape's positions's values)
                        append normal to (shape's normals's values)
                        append (base + corner) to (shape's triangles's values)
                        set lowX to the minimum of lowX and point's x
                        set lowY to the minimum of lowY and point's y
                        set lowZ to the minimum of lowZ and point's z
                        set highX to the maximum of highX and point's x
                        set highY to the maximum of highY and point's y
                        set highZ to the maximum of highZ and point's z
                    set triangles to triangles + 1
                free corners
            set offset to offset + (triangleCount * 12)
            if (category < 0) or (category >= (the bim category count)):
                set category to bim other category
            set elementId to (the bim imported id base) + (element as a 64 bit integer)
            append (@intrinsic("construct", a bim scene mesh record, elementId, 0 as a 64 bit integer, 0, shape, category, the bim category colouring, the string form of "")) to (meshes's values)
            append label to (labels's values)
        return @intrinsic("construct", a bim import record, true, the string form of "", meshes, labels, triangles, (a cad vector3 with x lowX, y lowY and z lowZ), (a cad vector3 with x highX, y highY and z highZ), a cad topology list of a cad vector3, no bim import storeys, no bim import instancing, a cad topology list of a bim pset entry record)
