# SPDX-License-Identifier: MPL-2.0
import exchange/import/bim_image_data.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl

function check image {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set rgba to the bim decoded png at (the string form of "exchange/import/tests/fixtures/image-rgba.png")
check image (rgba's valid and ((rgba's width = 2) and (rgba's height = 2))) named (the string form of "RGBA PNG dimensions")
check image ((the length of rgba's rgba) = 16) named (the string form of "four bytes per pixel")
check image ((((the character at 0 in rgba's rgba) as an integer) bitwise and 255) = 255) named (the string form of "red channel retained")
check image ((((the character at 7 in rgba's rgba) as an integer) bitwise and 255) = 128) named (the string form of "partial transparency retained")
check image (((the character at 11 in rgba's rgba) as an integer) = 0) named (the string form of "transparent pixel retained")
set palette to the bim decoded png at (the string form of "exchange/import/tests/fixtures/image-palette.png")
check image (palette's valid and ((the length of palette's rgba) = 8)) named (the string form of "indexed PNG converted to RGBA")
check image ((((the character at 7 in palette's rgba) as an integer) bitwise and 255) = 128) named (the string form of "palette transparency retained")
check image ((the bim decoded png at (the string form of "exchange/import/tests/fixtures/image-too-wide.png"))'s valid = false) named (the string form of "oversized image refused before pixel allocation")
check image ((the bim decoded png at (the string form of "tests/images.dl"))'s valid = false) named (the string form of "non-image refused")
set modelValue to an empty bim model
set target to the address of modelValue
set levelId to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
set viewId to add bim view of kind bim plan view named (the string form of "Plan") on levelId to target
set otherViewId to add bim view of kind bim plan view named (the string form of "Other") on levelId to target
set imageId to add bim image linked to (the string form of "/tmp/reference with spaces.png") on levelId in view viewId at (a cad vector2 with x 2.0 and y 3.0) sized 5.0 by 2.5 to target
check image (imageId != the bim refused id) named (the string form of "view-owned image instance created")
set drawn to the bim drawn sketches of modelValue seen from view viewId
set other to the bim drawn sketches of modelValue seen from view otherViewId
check image (((the length of (drawn's values)) = 1) and ((the length of (other's values)) = 0)) named (the string form of "image is scoped to its drawing view")
set encoded to the bim file text of modelValue
set reread to the bim model parsed from encoded
check image reread's valid named (the string form of "native image roundtrip accepted")
check image ((the bim file text of reread's modelValue) = encoded) named (the string form of "image corners and linked path preserved")
check image ((add bim image linked to (the string form of "image.png") on levelId in view viewId at (a cad vector2 with x 0.0 and y 0.0) sized 0.0 by 1.0 to target) = the bim refused id) named (the string form of "invalid image dimensions refused")
set exchanged to the bim ifcx text of modelValue identified as (the string form of "images.ifcx") for project (the string form of "Images") by (the string form of "test") at (the string form of "2026-10-26T00:00:00Z")
set native to the bim native text of ifcx exchanged
check image native's valid named (the string form of "image IfcX native records accepted")
set exchangedModel to the bim model parsed from native's text
check image exchangedModel's valid named (the string form of "image IfcX roundtrip accepted")
check image ((the bim file text of exchangedModel's modelValue) = encoded) named (the string form of "IfcX preserves image link and view ownership")
