# SPDX-License-Identifier: MPL-2.0
import exchange/import/bim_vector_data.dl
function check vector cache {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line
set modelValue to an empty bim model
set cache to a new bim vector cache
set viewId to 42 as a 64 bit integer
set sourceSet to the string form of "OpenBIM_VectorTriangles"
set bim property (the string form of "0000") of set sourceSet of viewId to (the string form of "255 0 0 1 2 2 2 1 3") typed (the string form of "IfcText") in (the address of modelValue)
set bim property (the string form of "0001") of set sourceSet of viewId to (the string form of "0 0 255 3 4 4 4 3 5") typed (the string form of "IfcText") in (the address of modelValue)
check vector cache ((refresh bim vectors of modelValue at revision (1 as a 64 bit integer) in (the address of cache)) = 2) named (the string form of "initial import decoded once")
set first to the item at 0 in (cache's batches's values)
check vector cache (first's valid and ((the length of (first's corners's values)) = 3)) named (the string form of "complete model-space triangle cached")
check vector cache (((the item at 0 in (first's corners's values))'s x = 1.0) and ((the item at 0 in (first's corners's values))'s y = 2.0)) named (the string form of "coordinates remain in model space")
set original to cache's batches
check vector cache ((refresh bim vectors of modelValue at revision (1 as a 64 bit integer) in (the address of cache)) = 0) named (the string form of "camera-only frames do not decode")
set bim property (the string form of "Name") of set (the string form of "Unrelated") of viewId to (the string form of "changed") typed (the string form of "IfcText") in (the address of modelValue)
check vector cache ((refresh bim vectors of modelValue at revision (2 as a 64 bit integer) in (the address of cache)) = 0) named (the string form of "unrelated edit reuses vector data")
check vector cache ((cache's batches's values = original's values) and (cache's generation = 1)) named (the string form of "unchanged geometry retains its GPU identity")
set bim property (the string form of "0001") of set sourceSet of viewId to (the string form of "0 0 255 3 4 broken 4 3 5") typed (the string form of "IfcText") in (the address of modelValue)
check vector cache ((refresh bim vectors of modelValue at revision (3 as a 64 bit integer) in (the address of cache)) = 1) named (the string form of "only changed payload is decoded")
set second to the item at 1 in (cache's batches's values)
check vector cache ((second's valid = false) and ((the length of (second's corners's values)) = 0)) named (the string form of "invalid payload remains atomic")
check vector cache ((refresh bim vectors of modelValue at revision (4 as a 64 bit integer) in (the address of cache)) = 0) named (the string form of "invalid payload is negatively cached")
set modelValue to an empty bim model
ignore (refresh bim vectors of modelValue at revision (5 as a 64 bit integer) in (the address of cache))
check vector cache (((the length of (cache's batches's values)) = 0) and (cache's generation = 3)) named (the string form of "new document removes old artwork")
