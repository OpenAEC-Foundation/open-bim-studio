# SPDX-License-Identifier: MPL-2.0
# Manual Vulkan regression, needs a display. No editor imports or user file.
import graphics/bim_vector_gpu.dl
import lib/std.dl
function check retained vector {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line
ignore @intrinsic("call", "glfw", "glfwInit", an integer)
@intrinsic("call", "glfw", "glfwWindowHint", nothing, 131084, 0)
set window to a new window with width 640 and height 480 using shaders in (the string form of "build/shaders")
set the title of window to (the string form of "Open BIM Studio - retained vector regression")
set context to the gpu context of window
set reserved to reserve gpu canvas slots 4 in context
set modelValue to an empty bim model
set dataCache to a new bim vector cache
set cache to a new bim vector gpu cache
set sourceSet to the string form of "OpenBIM_VectorTriangles"
set viewId to 42 as a 64 bit integer
set bim property (the string form of "0000") of set sourceSet of viewId to (the string form of "255 0 0 900000 800000 900010 800000 900000 800010") typed (the string form of "IfcText") in (the address of modelValue)
ignore (refresh bim vectors of modelValue at revision (1 as a 64 bit integer) in (the address of dataCache))
set transform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 100.0 and y 300.0), (a cad vector2 with x 900000.0 and y 800000.0), 10.0)
loop tick from 0 to 120:
    set frame to a new graphics frame in window with background red 1.0, green 1.0, blue 1.0 and alpha 1.0
    use screen coordinates in frame
    set transform's scale to 10.0 + ((tick as a 64 bit floating-point number) / 10.0)
    set transform's centre's x to 100.0 + (tick as a 64 bit floating-point number)
    draw retained bim vectors of view viewId from dataCache through transform in (the address of cache) for frame
    display frame
check retained vector ((cache's uploads = 1) and (cache's slot >= (reserved + 4))) named (the string form of "120 camera frames reuse one upload and do not collide with sheet slots")
check retained vector ((cache's origin's x = 900000.0) and (cache's origin's y = 800000.0)) named (the string form of "large coordinates are relative to a local origin")
ignore (refresh bim vectors of modelValue at revision (2 as a 64 bit integer) in (the address of dataCache))
set frame to a new graphics frame in window with background red 1.0, green 1.0, blue 1.0 and alpha 1.0
use screen coordinates in frame
draw retained bim vectors of view viewId from dataCache through transform in (the address of cache) for frame
display frame
check retained vector (cache's uploads = 1) named (the string form of "unrelated revision preserves the GPU buffer")
set modelValue to an empty bim model
ignore (refresh bim vectors of modelValue at revision (3 as a 64 bit integer) in (the address of dataCache))
set frame to a new graphics frame in window with background red 1.0, green 1.0, blue 1.0 and alpha 1.0
use screen coordinates in frame
draw retained bim vectors of view viewId from dataCache through transform in (the address of cache) for frame
display frame
check retained vector ((cache's uploads = 2) and (context's canvasCount = 0)) named (the string form of "removed artwork clears the resident buffer")
close window
