# SPDX-License-Identifier: MPL-2.0
import elements/object/bim_component_benchmark.dl
import exchange/ifcx/bim_file.dl
set arguments to the command line arguments
set wanted to 100000
set output to the string form of "build/component-benchmark.bim"
if arguments' length > 0:
    set wanted to @intrinsic("call", "libc", "atoi", integer, the data of (the argument at 0 in arguments))
if arguments' length > 1:
    set output to the argument at 1 in arguments
set modelValue to the bim component benchmark with wanted placements
if (write bim text ((the bim file text of modelValue) + (the string form of "units m\n")) to file output) = false:
    @intrinsic("call", "libc", "exit", nothing, 1)
print ((the string form of "instances=") + (the string form of (the length of modelValue's instances's values))) as a line
print ((the string form of "definitions=") + (the string form of (the length of modelValue's components's values))) as a line
print output as a line
