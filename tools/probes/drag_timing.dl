# SPDX-License-Identifier: MPL-2.0
# Measures how fast the slice follows a drag: a four-wall room with two
# windows is drawn through the editor, then one corner is dragged in 200 small
# steps. Each step re-evaluates the model incrementally and re-cuts the plan
# (the editor's own measurement), then tessellates the rebuilt walls for the
# 3D view. Steps that the 0.05 m grid snap leaves on the same point change
# nothing and are reported apart. Times are medians and maxima in
# microseconds.
import ui/editor/bim_editor.dl

function point bim timing at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor

function sort bim timings {a pointer to a list:values}:
    execute:
        loop outer from 1 to the length of values:
            set moving to the item at outer in values
            set slot to outer
            set shifting to true
            loop while shifting:
                if slot = 0:
                    set shifting to false
                else if (the item at (slot - 1) in values) > moving:
                    replace item at index slot in values with (the item at (slot - 1) in values)
                    set slot to slot - 1
                else:
                    set shifting to false
            replace item at index slot in values with moving

function report bim timings {a pointer to a list:values} labelled {a string:label}:
    execute:
        sort bim timings values
        set line to (label + (the string form of " median ")) + (the string form of (the item at ((the length of values) / 2) in values))
        print ((line + (the string form of " max ")) + (the string form of (the last item of values))) as a line

set editor to a new bim editor
set e to the address of editor
type bim editor key 87 in e
point bim timing at 0.0 and 0.0 in e
press bim editor pointer in e
point bim timing at 6.0 and 0.0 in e
press bim editor pointer in e
point bim timing at 6.0 and 4.0 in e
press bim editor pointer in e
point bim timing at 0.0 and 4.0 in e
press bim editor pointer in e
point bim timing at 0.0 and 0.0 in e
press bim editor pointer in e
type bim editor key bim escape key code in e
type bim editor key 79 in e
point bim timing at 1.5 and 0.0 in e
press bim editor pointer in e
point bim timing at 4.0 and 4.0 in e
press bim editor pointer in e
refresh bim editor e
print ((the string form of "walls ") + (the string form of (the length of (editor's documentValue's current's walls's values)))) as a line
print ((the string form of "openings ") + (the string form of (the length of (editor's documentValue's current's openings's values)))) as a line

type bim editor key 83 in e
point bim timing at 6.0 and 0.0 in e
press bim editor pointer in e
set evaluations to an empty list of a 64 bit integer
set idleEvaluations to an empty list of a 64 bit integer
set tessellations to an empty list of a 64 bit integer
set rebuiltTotal to 0
set recutTotal to 0
loop stepCount from 1 to 201:
    set fraction to (stepCount as a 64 bit floating-point number) / 200.0
    point bim timing at (6.0 + (1.5 * fraction)) and (0.0 - (0.75 * fraction)) in e
    refresh bim editor e
    set changedStep to editor's lastRebuilt > 0
    if changedStep:
        append editor's lastMicroseconds to evaluations
        set rebuiltTotal to rebuiltTotal + editor's lastRebuilt
        set recutTotal to recutTotal + editor's plan's recut
    else:
        append editor's lastMicroseconds to idleEvaluations
    set started to the bim microseconds now
    loop changedCursor from 0 to the length of (editor's evaluation's changed's values):
        set found to the bim position of (the item at changedCursor in (editor's evaluation's changed's values)) among (editor's evaluation's elements's values)
        if found's valid:
            set triangles to an empty fast mesh
            append bim mesh of (the item at found's position in (editor's evaluation's elements's values)) to (the address of triangles)
    if changedStep:
        append ((the bim microseconds now) - started) to tessellations
release bim editor pointer in e
set changedSteps to the length of evaluations
print ((the string form of "drag steps 200 changing the model ") + (the string form of changedSteps)) as a line
print ((the string form of "walls rebuilt per changing step ") + (the string form of (rebuiltTotal / changedSteps))) as a line
print ((the string form of "walls re-cut per changing step ") + (the string form of (recutTotal / changedSteps))) as a line
report bim timings evaluations labelled (the string form of "changing step evaluate and plan us")
report bim timings tessellations labelled (the string form of "changing step tessellate us")
report bim timings idleEvaluations labelled (the string form of "unchanged step evaluate and plan us")
free evaluations
free idleEvaluations
free tessellations
