# SPDX-License-Identifier: MPL-2.0
# Manual GPU regression: independent canvases, distinct textures, colour
# overlays, font-atlas isolation, repeated drawing and high zoom transforms.
import graphics/vulkan/images.dl
import lib/std.dl

ignore @intrinsic("call", "glfw", "glfwInit", an integer)
@intrinsic("call", "glfw", "glfwWindowHint", nothing, 131084, 0)
set window to a new window with width 640 and height 480 using shaders in (the string form of "build/shaders")
set the title of window to (the string form of "Open BIM Studio - canvas regression")
set pixelData to a new string buffer containing 4 bytes
store (255 as a byte) into the data of pixelData at 0
store (0 as a byte) into the data of pixelData at 1
store (0 as a byte) into the data of pixelData at 2
store (255 as a byte) into the data of pixelData at 3
set redSlot to upload gpu rgba image sized 1 by 1 from (the data of pixelData) in window
store (0 as a byte) into the data of pixelData at 0
store (255 as a byte) into the data of pixelData at 1
set greenSlot to upload gpu rgba image sized 1 by 1 from (the data of pixelData) in window
set coverage to a new string buffer containing 1 bytes
store (255 as a byte) into the data of coverage at 0
set glyphAtlas to a new red texture sized 1 by 1 from (the data of coverage) for window
set context to the gpu context of window
set frame to a new graphics frame in window with background red 1.0, green 1.0, blue 1.0 and alpha 1.0
use screen coordinates in frame
begin gpu canvas recording in context
draw gpu image slot redSlot through (a cad vector2 with x 20.0 and y 20.0), (a cad vector2 with x 120.0 and y 20.0), (a cad vector2 with x 120.0 and y 120.0) and (a cad vector2 with x 20.0 and y 120.0) in frame
# Force vertex-buffer growth after an image batch. Degenerate triangles
# preserve the expected image while checking all earlier batch handles.
start triangles in frame
loop unused from 0 to 33334:
    add a vertex at x -5.0, y -5.0 and z 0.0 to frame
    add a vertex at x -5.0, y -5.0 and z 0.0 to frame
    add a vertex at x -5.0, y -5.0 and z 0.0 to frame
finish triangles in frame
end gpu canvas recording in context
select gpu canvas slot 1 in context
begin gpu canvas recording in context
draw gpu image slot greenSlot through (a cad vector2 with x 20.0 and y 20.0), (a cad vector2 with x 120.0 and y 20.0), (a cad vector2 with x 120.0 and y 120.0) and (a cad vector2 with x 20.0 and y 120.0) in frame
end gpu canvas recording in context
select gpu canvas slot 2 in context
begin gpu canvas recording in context
start triangles using glyphAtlas in frame
use vertex color red 0, green 0 and blue 255 in frame
add a vertex at x 20.0, y 300.0 and z 0.0 to frame
add a vertex at x 120.0, y 300.0 and z 0.0 to frame
add a vertex at x 20.0, y 400.0 and z 0.0 to frame
finish triangles in frame
end gpu canvas recording in context
display frame
set began to @intrinsic("call", "glfw", "glfwGetTime", a 64 bit floating-point number)
loop while ((@intrinsic("call", "glfw", "glfwGetTime", a 64 bit floating-point number)) - began) < 20.0:
    set frame to a new graphics frame in window with background red 1.0, green 1.0, blue 1.0 and alpha 1.0
    use screen coordinates in frame
    select gpu canvas slot 0 in context
    draw gpu canvas scaled by 1.0 shifted by 0.0 and 0.0 in context
    select gpu canvas slot 1 in context
    draw gpu canvas scaled by 2.0 shifted by 160.0 and 0.0 in context
    select gpu canvas slot 0 in context
    draw gpu canvas scaled by 0.5 shifted by 450.0 and 0.0 in context
    select gpu canvas slot 2 in context
    draw gpu canvas scaled by 1.0 shifted by 0.0 and 0.0 in context
    loop extra from 0 to 40:
        select gpu canvas slot 0 in context
        draw gpu canvas scaled by 0.1 shifted by (10.0 + ((extra as a 64 bit floating-point number) * 15.0)) and 440.0 in context
    set highZoomStart to the length of (context's batches)
    draw gpu canvas scaled by 100.0 shifted by -1980.0 and -1980.0 in context
    clip gpu overlays since highZoomStart within 560.0, 300.0, 620.0 and 360.0 in context
    display frame
release gpu image slot redSlot in window
release gpu image slot greenSlot in window
close window
print "GPU canvas probe completed" as a line
