# SPDX-License-Identifier: MPL-2.0
# Manual bounded UI regression. Uses the production properties renderer,
# with no main application, project data, or user file.
import app/bim_ui.dl
function check type menu UI {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line
set editor to a new bim editor
set modelTarget to the address of (editor's documentValue's current)
set systemId to add bim curtain wall on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 3.6 and y 0.0) rising 2.4 in bays of 1.2 by 2.4 of (the string form of "aluminium") to modelTarget
ignore give bim system systemId type 42 in modelTarget
set editor's selectionKind to bim curtain picked
set editor's selectionId to systemId
set editor's partCode to -1
set window to a new window with width 800 and height 720 using shaders in (the string form of "build/shaders")
set the title of window to (the string form of "Open BIM Studio - type menu regression")
set loading to the bim text atlas from regular font at (the string form of "app/fonts/LiberationMono-Regular.ttf") and bold font at (the string form of "") for window
if loading's valid = false:
    return 1
set rows to an empty list of a bim property row record
set headings to an empty list of a boolean
set offsetValue to -1
set frame to a new graphics frame in window with background red 0.15, green 0.15, blue 0.15 and alpha 1.0
use screen coordinates in frame
set hit to draw bim properties of editor listing rows scrolled 0.0 choosing true folding headings pointing at 480.0 and 660.0 from 360.0 below 300.0 down to 700.0 using loading's atlas in frame types from (the address of offsetValue)
display frame
check type menu UI (offsetValue = 31) named (the string form of "production menu centres and clamps the final selected recipe")
check type menu UI ((hit's action = bim browser system type) and (hit's actionId = (42 as a 64 bit integer))) named (the string form of "visible last row selects recipe 42")
set offsetValue to 0
set frame to a new graphics frame in window with background red 0.15, green 0.15, blue 0.15 and alpha 1.0
use screen coordinates in frame
set hit to draw bim properties of editor listing rows scrolled 0.0 choosing true folding headings pointing at 480.0 and 660.0 from 360.0 below 300.0 down to 700.0 using loading's atlas in frame types from (the address of offsetValue)
display frame
check type menu UI ((hit's action = bim browser system type) and (hit's actionId = (11 as a 64 bit integer))) named (the string form of "first page hit uses its own recipe index")
set offsetValue to 10000
set began to @intrinsic("call", "glfw", "glfwGetTime", a 64 bit floating-point number)
loop while ((@intrinsic("call", "glfw", "glfwGetTime", a 64 bit floating-point number)) - began) < 8.0:
    set frame to a new graphics frame in window with background red 0.15, green 0.15, blue 0.15 and alpha 1.0
    use screen coordinates in frame
    ignore draw bim properties of editor listing rows scrolled 0.0 choosing true folding headings pointing at 480.0 and 660.0 from 360.0 below 300.0 down to 700.0 using loading's atlas in frame types from (the address of offsetValue)
    display frame
check type menu UI (offsetValue = 31) named (the string form of "overscroll clamps within the actual rendered list")
close window
