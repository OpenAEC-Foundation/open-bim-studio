# SPDX-License-Identifier: MPL-2.0
# Native shader smoke test without the editor or a model. The left column
# retains a two-pixel stroke at three zooms; the right uses ordinary scaling.
import viewer/bim_canvas.dl
import lib/std.dl
set args to the command line arguments
set directory to the string form of "build/shaders"
if args' length > 0:
    set directory to the argument at 0 in args
set window to a new window with width 640 and height 480 using shaders in directory
set the title of window to (the string form of "Open BIM Studio - pixel stroke probe")
set context to the gpu context of window
set pairs to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to pairs
append (a cad vector2 with x 20.0 and y 0.0) to pairs
set canvas to a new bim canvas
record bim strokes pairs coloured 0, 0 and 0 wide 2.0 on (the address of canvas)
set ordinarySlot to reserve gpu canvas slots 1 in context
loop tick from 0 to 480:
    set frame to a new graphics frame in window with background red 1.0, green 1.0, blue 1.0 and alpha 1.0
    use screen coordinates in frame
    if tick = 0:
        select gpu canvas slot 0 in context
        begin gpu canvas recording in context
        replay bim canvas geometry canvas shifted by 0.0 and 0.0 keeping pixel widths true in frame
        end gpu canvas recording in context
        select gpu canvas slot ordinarySlot in context
        begin gpu canvas recording in context
        replay bim canvas geometry canvas shifted by 0.0 and 0.0 keeping pixel widths false in frame
        end gpu canvas recording in context
    select gpu canvas slot 0 in context
    draw gpu canvas scaled by 1.0 shifted by 80.0 and 80.0 in context
    draw gpu canvas scaled by 3.0 shifted by 80.0 and 140.0 in context
    draw gpu canvas scaled by 10.0 shifted by 80.0 and 200.0 in context
    select gpu canvas slot ordinarySlot in context
    draw gpu canvas scaled by 1.0 shifted by 340.0 and 80.0 in context
    draw gpu canvas scaled by 3.0 shifted by 340.0 and 140.0 in context
    draw gpu canvas scaled by 10.0 shifted by 340.0 and 200.0 in context
    display frame
    if tick = 0:
        print "READY: first native stroke frame submitted" as a line
        ignore @intrinsic("call", "libc", "fflush", integer, 0 as a pointer)
print "PASS: native retained and ordinary stroke canvases rendered" as a line
free pairs
close window
