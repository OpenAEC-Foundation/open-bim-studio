# SPDX-License-Identifier: MPL-2.0
# Review data from production CSG definitions and their derived display surfaces.
# Output is a stream: item header, CSG terms, triangle corners, and helix points.
import elements/connection/fastener_geometry.dl
import elements/connection/bim_fastener_detail.dl

function print review vector {cad vector3:pointValue}:
    execute:
        print (((the string form of pointValue's x) + (the string form of " ")) + (((the string form of pointValue's y) + (the string form of " ")) + (the string form of pointValue's z))) as a line

loop reviewMetric from 0 to 15:
    set reviewDiameter to the connection fastener diameter at reviewMetric
    set reviewSize to the connection metric fastener size of reviewDiameter
    loop reviewFamily from 0 to 8:
        set reviewParameters to catalogued connection fastener parameters
        set reviewKind to 1
        set reviewLength to reviewDiameter * 5.0
        if reviewFamily = 1:
            set reviewParameters's threadLength to reviewDiameter * 3.0
            set reviewParameters's washers to 3
        if reviewFamily = 2:
            set reviewKind to 6
            set reviewParameters's nuts to 0
            set reviewLength to reviewSize's nutHeight
        if reviewFamily = 3:
            set reviewKind to 7
            set reviewParameters's nuts to 0
            set reviewParameters's showThread to false
            set reviewLength to reviewSize's washerThickness
        if reviewFamily >= 4:
            set reviewKind to 3
            set reviewParameters's anchorShape to reviewFamily - 4
            set reviewParameters's washers to 2
            set reviewLength to reviewDiameter * 20.0
        set reviewFastener to @intrinsic("construct", a connection fastener, 1, 1 as a 64 bit integer, reviewKind, the cad zero vector3, the cad z axis, reviewDiameter, reviewLength, reviewParameters)
        print (((the string form of "ITEM ") + (the string form of reviewMetric)) + ((the string form of " ") + (the string form of reviewFamily))) as a line
        set reviewParts to the connection fastener pieces of reviewFastener
        loop reviewPart from 0 to the length of (reviewParts's values):
            set reviewPiece to the item at reviewPart in (reviewParts's values)
            if (the item at 0 in (reviewPiece's construction's terms's values))'s primitive = 0:
                round connection hex rims of (the address of (reviewPiece's construction))
                set reviewPiece's shape to the connection stock display of reviewPiece's construction
            if ((the fast mesh flaw of reviewPiece's shape) != 0) or ((the fast mesh volume of reviewPiece's shape) <= 0.0):
                print (the string form of "FAIL: rounded review surface is not a closed positive solid") as a line
                @intrinsic("call", "libc", "exit", nothing, 1)
            print ((the string form of "PART ") + reviewPiece's name) as a line
            loop reviewTerm from 0 to the length of (reviewPiece's construction's terms's values):
                set reviewPrimitive to the item at reviewTerm in (reviewPiece's construction's terms's values)
                print (((the string form of "CSG ") + (the string form of reviewPrimitive's primitive)) + ((the string form of " ") + (the string form of reviewPrimitive's operation))) as a line
                print review vector reviewPrimitive's origin
                print review vector reviewPrimitive's axis
                print review vector reviewPrimitive's size
            print ((the string form of "CORNERS ") + (the string form of (the length of (reviewPiece's shape's triangles's values)))) as a line
            loop reviewCorner from 0 to the length of (reviewPiece's shape's triangles's values):
                print review vector (the item at (the item at reviewCorner in (reviewPiece's shape's triangles's values)) in (reviewPiece's shape's positions's values))
        set reviewHelix to the bim cosmetic helix of reviewFastener
        print ((the string form of "HELIX ") + (the string form of (the length of (reviewHelix's values)))) as a line
        loop reviewPoint from 0 to the length of (reviewHelix's values):
            print review vector (the item at reviewPoint in (reviewHelix's values))
