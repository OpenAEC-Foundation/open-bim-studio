# SPDX-License-Identifier: MPL-2.0
# Manual benchmark: RGB + model-space triangles, one payload per input line.
# Extract project data outside the repo; no source drawings are embedded here.
import graphics/bim_vector_gpu.dl
import lib/std.dl
set arguments to the command line arguments
if arguments' length < 1:
    print "Usage: vector-navigation-benchmark PAYLOADS.txt" as a line
    return 1
set inputValue to the bim file content at (the argument at 0 in arguments)
if inputValue's valid = false:
    return 1
set payloads to inputValue's text split at "\n"
set dataCache to a new bim vector cache
set triangles to 0
loop cursor from 0 to the length of payloads:
    set batchValue to the bim decoded vector (the item at cursor in payloads) named (the string form of cursor) for (42 as a 64 bit integer)
    if batchValue's valid:
        set triangles to triangles + ((the length of (batchValue's corners's values)) / 3)
        append batchValue to (dataCache's batches's values)
free payloads
ignore @intrinsic("call", "glfw", "glfwInit", an integer)
@intrinsic("call", "glfw", "glfwWindowHint", nothing, 131084, 0)
set window to a new window with width 1280 and height 900 using shaders in (the string form of "build/shaders")
set the title of window to (the string form of "Open BIM Studio - vector navigation benchmark")
set cache to a new bim vector gpu cache
set transform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 640.0 and y 450.0), (a cad vector2 with x 10.0 and y 10.0), 20.0)
# Warm up upload, swapchain and pipelines before timing navigation.
loop tick from 0 to 10:
    set frame to a new graphics frame in window with background red 1.0, green 1.0, blue 1.0 and alpha 1.0
    use screen coordinates in frame
    draw retained bim vectors of view (42 as a 64 bit integer) from dataCache through transform in (the address of cache) for frame
    display frame
set started to @intrinsic("call", "glfw", "glfwGetTime", a 64 bit floating-point number)
loop tick from 0 to 240:
    set transform's scale to 20.0 + ((tick as a 64 bit floating-point number) * 0.25)
    set transform's centre's x to 640.0 + ((the sine of ((tick as a 64 bit floating-point number) * 0.05)) * 180.0)
    set frame to a new graphics frame in window with background red 1.0, green 1.0, blue 1.0 and alpha 1.0
    use screen coordinates in frame
    draw retained bim vectors of view (42 as a 64 bit integer) from dataCache through transform in (the address of cache) for frame
    display frame
set elapsed to (@intrinsic("call", "glfw", "glfwGetTime", a 64 bit floating-point number)) - started
print ((the string form of "triangles=") + (the string form of triangles)) as a line
print ((the string form of "uploads=") + (the string form of cache's uploads)) as a line
print ((the string form of "navigation_frames=240 seconds=") + (the string form of elapsed)) as a line
print ((the string form of "presented_fps=") + (the string form of (240.0 / elapsed))) as a line
close window
