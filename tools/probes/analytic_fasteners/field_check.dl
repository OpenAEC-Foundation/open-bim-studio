# SPDX-License-Identifier: MPL-2.0
import tools/probes/analytic_fasteners/field.dl

function the analytic parameter at {integer:index}:
    execute:
        if index = 0:
            return 1.5
        if index = 1:
            return 0.625
        if index = 2:
            return 0.925
        if index = 3:
            return 0.9375
        if index = 4:
            return 0.53125
        if index = 5:
            return 0.1875
        if index = 6:
            return 0.125
        if index = 7:
            return 5.0
        if index = 8:
            return 1.0
        if index = 16:
            return 1.0
        if index = 17:
            return 1.0
        return 0.0

function assert analytic condition {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS ") + label) as a line
assert analytic condition ((analytic nut at 0.0 0.0 0.0) > 0.0) named (the string form of "nut bore remains a void")
assert analytic condition ((analytic nut at 0.65 0.0 0.0) < 0.0) named (the string form of "nut material remains between bore and flats")
assert analytic condition ((analytic nut at 0.0 0.86 0.4625) > 0.03) named (the string form of "rounded rim removes the original hex corner")
assert analytic condition ((analytic nut at 0.0 0.85 0.0) < 0.0) named (the string form of "rounding preserves the middle hex corner")
assert analytic condition ((analytic washer at 0.0 0.0 0.0) > 0.0) named (the string form of "washer bore remains a void")
assert analytic condition ((analytic washer at 0.75 0.0 0.0) < 0.0) named (the string form of "washer has finite solid thickness")
assert analytic condition ((analytic fastener field at 0.4 0.0 2.0) < 0.0) named (the string form of "shaft material survives the assembly union")
assert analytic condition ((analytic fastener field at 0.0 0.0 5.5) > 0.0) named (the string form of "shaft ends at the parameterised length")

assert analytic condition ((analytic fastener field at 0.0 0.86 -0.8125) > 0.03) named (the string form of "bolt head rim removes the original hex corner")
assert analytic condition ((analytic fastener field at 0.65 0.0 -0.5) < 0.0) named (the string form of "bolt head retains its solid core")
