# SPDX-License-Identifier: MPL-2.0
# Direct implicit CSG surface rendering. The rectangle is only a screen carrier;
# no triangles, normals or sampled boundaries describe the model geometry.
import lib/shader.dl

function analytic rounded cylinder at {a number:x} {a number:y} {a number:z} radius {a number:radius} half height {a number:height} rim {a number:rim}:
    execute:
        set radial to @intrinsic("sqrt", (x * x) + (y * y))
        set qx to radial - (radius - rim)
        set qy to (the absolute value of z) - (height - rim)
        set ox to the maximum of qx and 0.0
        set oy to the maximum of qy and 0.0
        return (@intrinsic("sqrt", (ox * ox) + (oy * oy)) + (the minimum of (the maximum of qx and qy) and 0.0)) - rim

function analytic rounded hex at {a number:x} {a number:y} {a number:z} flats {a number:flats} half height {a number:height}:
    execute:
        set px to the absolute value of x
        set py to the absolute value of y
        set hexDistance to (the maximum of px and ((px * 0.5) + (py * 0.8660254037844386))) - (flats * 0.5)
        set reach to flats / 1.7320508075688772
        set rim to (the minimum of (reach - (flats * 0.5)) and (height * 0.8)) * (the analytic parameter at 16)
        return the maximum of hexDistance and (analytic rounded cylinder at x y z radius reach half height height rim rim)

function analytic washer at {a number:x} {a number:y} {a number:z}:
    execute:
        set thickness to (the analytic parameter at 5)
        set outer to analytic rounded cylinder at x y z radius ((the analytic parameter at 3)) half height (thickness * 0.5) rim (thickness * 0.15)
        set bore to (the analytic parameter at 4) - @intrinsic("sqrt", (x * x) + (y * y))
        return the maximum of outer and bore

function analytic nut at {a number:x} {a number:y} {a number:z}:
    execute:
        set outer to analytic rounded hex at x y z flats ((the analytic parameter at 0)) half height ((the analytic parameter at 2) * 0.5)
        return the maximum of outer and (0.5 - @intrinsic("sqrt", (x * x) + (y * y)))

function analytic fastener field at {a number:x} {a number:y} {a number:z}:
    execute:
        set length to (the analytic parameter at 7)
        set headHeight to (the analytic parameter at 1)
        set nutHeight to (the analytic parameter at 2)
        set washerThickness to (the analytic parameter at 5)
        set washerFlag to (the analytic parameter at 8)
        set headLift to washerThickness * washerFlag
        set head to analytic rounded hex at x y (z + headLift + (headHeight * 0.5)) flats ((the analytic parameter at 0)) half height (headHeight * 0.5)
        set shaft to analytic rounded cylinder at x y (z + headLift - (length * 0.5)) radius 0.5 half height (length * 0.5) rim 0.025
        set nutCentre to length - headLift - 0.5 - (nutHeight * 0.5)
        set nut to analytic nut at x y (z - nutCentre)
        set result to the minimum of head and (the minimum of shaft and nut)
        if washerFlag > 0.5:
            set belowHead to analytic washer at x y (z + (washerThickness * 0.5))
            set belowNut to analytic washer at x y (z - nutCentre + (nutHeight * 0.5) + (washerThickness * 0.5))
            set result to the minimum of result and (the minimum of belowHead and belowNut)
        set separateNut to analytic nut at (x + 2.8) y (z - 1.8)
        set separateWasher to analytic washer at (x - 2.6) y (z - 1.8)
        return the minimum of result and (the minimum of separateNut and separateWasher)
