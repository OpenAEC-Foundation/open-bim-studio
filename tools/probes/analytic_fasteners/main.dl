# SPDX-License-Identifier: MPL-2.0
# Isolated native analytic-solid viewer; not the application's mesh viewport.
import viewer/vulkan/graphics.dl
import elements/connection/fastener_catalog.dl

set solidWindow to a new window with width 1100 and height 800 using shaders in (the string form of "build/fastener-components/analytic/shaders")
set solidMetric to 4
set solidPitch to 0.002
set solidFinish to 0
set solidAlloy to 0
set solidWashers to 1.0
set solidRounding to 1.0
set solidThreads to 1.0
set solidArguments to the command line arguments
if solidArguments' length >= 7:
    set solidMetric to (@intrinsic("call", "libc", "atoi", integer, the data of (the argument at 0 in solidArguments))) clamped between 0 and 14
    set solidPitch to (@intrinsic("call", "libc", "strtod", a 64 bit floating-point number, the data of (the argument at 1 in solidArguments), 0 as a pointer) * 0.001) clamped between 0.0005 and 0.006
    set solidAlloy to (@intrinsic("call", "libc", "atoi", integer, the data of (the argument at 2 in solidArguments))) clamped between 0 and 2
    set solidFinish to (@intrinsic("call", "libc", "atoi", integer, the data of (the argument at 3 in solidArguments))) clamped between 0 and 2
    set solidWashers to (@intrinsic("call", "libc", "strtod", a 64 bit floating-point number, the data of (the argument at 4 in solidArguments), 0 as a pointer)) clamped between 0.0 and 1.0
    set solidRounding to (@intrinsic("call", "libc", "strtod", a 64 bit floating-point number, the data of (the argument at 5 in solidArguments), 0 as a pointer)) clamped between 0.0 and 1.0
    set solidThreads to (@intrinsic("call", "libc", "strtod", a 64 bit floating-point number, the data of (the argument at 6 in solidArguments), 0 as a pointer)) clamped between 0.0 and 1.0
set solidYaw to 0.4
set solidElevation to 0.45
set solidZoom to 8.0
set solidOldX to 0.0
set solidOldY to 0.0
set solidDragging to false
set solidChanged to true
loop while solidWindow remains open:
    set solidKeys to the characters typed into solidWindow
    loop keyCursor from 0 to the length of solidKeys:
        set typedCode to the item at keyCursor in solidKeys
        if typedCode = 93:
            set solidMetric to the minimum of 14 and (solidMetric + 1)
            set solidPitch to (the connection metric fastener size of (the connection fastener diameter at solidMetric))'s pitch
        if typedCode = 91:
            set solidMetric to the maximum of 0 and (solidMetric - 1)
            set solidPitch to (the connection metric fastener size of (the connection fastener diameter at solidMetric))'s pitch
        if (typedCode = 43) or (typedCode = 61):
            set solidPitch to the minimum of 0.006 and (solidPitch + 0.00025)
        if typedCode = 45:
            set solidPitch to the maximum of 0.0005 and (solidPitch - 0.00025)
        if (typedCode = 102) or (typedCode = 70):
            set solidFinish to the remainder of (solidFinish + 1) divided by 3
        if (typedCode = 97) or (typedCode = 65):
            set solidAlloy to the remainder of (solidAlloy + 1) divided by 3
        if (typedCode = 119) or (typedCode = 87):
            set solidWashers to 1.0 - solidWashers
        if (typedCode = 114) or (typedCode = 82):
            set solidRounding to 1.0 - solidRounding
        if (typedCode = 118) or (typedCode = 86):
            set solidThreads to 1.0 - solidThreads
        set solidChanged to true
    free solidKeys
    set solidPoint to the cursor position of solidWindow
    set solidRight to the right mouse button is pressed in solidWindow
    if solidRight and solidDragging:
        set solidYaw to solidYaw + (((solidPoint's x as a 64 bit floating-point number) - solidOldX) * 0.007)
        set solidElevation to (solidElevation + (((solidPoint's y as a 64 bit floating-point number) - solidOldY) * 0.007)) clamped between -1.4 and 1.4
    set solidDragging to solidRight
    set solidOldX to solidPoint's x as a 64 bit floating-point number
    set solidOldY to solidPoint's y as a 64 bit floating-point number
    set solidScroll to the scroll taken from solidWindow
    set solidZoom to (solidZoom - (solidScroll * 0.4)) clamped between 3.0 and 15.0
    set solidDiameter to the connection fastener diameter at solidMetric
    set solidSize to the connection metric fastener size of solidDiameter
    if solidChanged:
        set solidMaterial to the string form of "Steel"
        if solidAlloy = 1:
            set solidMaterial to the string form of "Stainless A2"
        if solidAlloy = 2:
            set solidMaterial to the string form of "Stainless A4"
        set solidFinishName to the string form of "Uncoated"
        if solidFinish = 1:
            set solidFinishName to the string form of "Hot-dip zinc"
        if solidFinish = 2:
            set solidFinishName to the string form of "Electrolytic zinc"
        set solidTitle to ((the string form of "Analytic CSG | M") + (the string form of ((solidDiameter * 1000.0) as an integer))) + ((the string form of " pitch ") + (the string form of (solidPitch * 1000.0)))
        set solidTitle to solidTitle + ((the string form of " mm | ") + (solidMaterial + ((the string form of " | ") + solidFinishName)))
        set solidTitle to solidTitle + (the string form of " | [] size  +/- pitch  W washers  R rims  V thread  A alloy  F finish")
        set the title of solidWindow to solidTitle
        print solidTitle as a line
        set solidTokens to an empty list of a string
        append (the string form of "ANALYTIC-CSG-FASTENER 1") to solidTokens
        append ((the string form of "metricIndex ") + (the string form of solidMetric)) to solidTokens
        append ((the string form of "diameterMetres ") + (the string form of solidDiameter)) to solidTokens
        append ((the string form of "pitchMetres ") + (the string form of solidPitch)) to solidTokens
        append ((the string form of "alloy ") + solidMaterial) to solidTokens
        append ((the string form of "finish ") + solidFinishName) to solidTokens
        append ((the string form of "washers ") + (the string form of solidWashers)) to solidTokens
        append ((the string form of "roundedRims ") + (the string form of solidRounding)) to solidTokens
        append ((the string form of "threadLines ") + (the string form of solidThreads)) to solidTokens
        append (the string form of "geometry HexagonalPrism INTERSECT RoundedCylinder; Nut MINUS Cylinder; Washer MINUS Cylinder; Assembly UNION") to solidTokens
        set solidText to solidTokens joined with "\n"
        set solidPath to the string form of "build/fastener-components/analytic/current-fastener.csg"
        set solidFile to @intrinsic("call", "libc", "fopen", a pointer to a byte, the data of solidPath, "wb")
        if solidFile != (0 as a pointer to a byte):
            ignore @intrinsic("call", "libc", "fwrite", a word sized integer, the data of solidText, 1 as a word sized integer, (the length of solidText) as a word sized integer, solidFile)
            ignore @intrinsic("call", "libc", "fclose", integer, solidFile)
        free solidTokens
        set solidChanged to false
    set solidFrame to a new graphics frame in solidWindow with background red 0.92, green 0.94, blue 0.96 and alpha 1.0
    set solidContext to @intrinsic("dereference", the gpu context of solidWindow)
    set gpu parameter 0 to (solidSize's headFlats / solidDiameter) in solidContext
    set gpu parameter 1 to (solidSize's headHeight / solidDiameter) in solidContext
    set gpu parameter 2 to (solidSize's nutHeight / solidDiameter) in solidContext
    set gpu parameter 3 to (solidSize's washerOuter / (2.0 * solidDiameter)) in solidContext
    set gpu parameter 4 to (solidSize's washerInner / (2.0 * solidDiameter)) in solidContext
    set gpu parameter 5 to (solidSize's washerThickness / solidDiameter) in solidContext
    set gpu parameter 6 to (solidPitch / solidDiameter) in solidContext
    set gpu parameter 7 to 5.0 in solidContext
    set gpu parameter 8 to solidWashers in solidContext
    set gpu parameter 9 to (solidFinish as a 64 bit floating-point number) in solidContext
    set gpu parameter 10 to (solidAlloy as a 64 bit floating-point number) in solidContext
    set gpu parameter 11 to solidYaw in solidContext
    set gpu parameter 12 to solidElevation in solidContext
    set gpu parameter 13 to (solidContext's width as a 64 bit floating-point number) in solidContext
    set gpu parameter 14 to (solidContext's height as a 64 bit floating-point number) in solidContext
    set gpu parameter 15 to solidZoom in solidContext
    set gpu parameter 16 to solidRounding in solidContext
    set gpu parameter 17 to solidThreads in solidContext
    draw a rectangle at x 0.0 and y 0.0 with width (the framebuffer width of solidWindow) and height (the framebuffer height of solidWindow) in color red 255, green 255 and blue 255 in solidFrame
    display solidFrame
close solidWindow
