# SPDX-License-Identifier: MPL-2.0
# Isolate grouping allocations; this is not a full-scene rendering benchmark.
import viewer/bim_native_instances.dl

import elements/object/bim_component.dl

set shape to an empty fast mesh
append (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (shape's positions's values)
append (a cad vector3 with x 1.0, y 0.0 and z 0.0) to (shape's positions's values)
append (a cad vector3 with x 0.0, y 1.0 and z 0.0) to (shape's positions's values)
append (a cad vector3 with x 0.0, y 0.0 and z 1.0) to (shape's positions's values)
append 0 to (shape's triangles's values)
append 1 to (shape's triangles's values)
append 2 to (shape's triangles's values)
loop normalCursor from 0 to 4:
    append (a cad vector3 with x 0.0, y 0.0 and z 1.0) to (shape's normals's values)
set entries to an empty list of a bim scene mesh record
loop copyCursor from 0 to 100000:
    set placement to @intrinsic("construct", a bim instance record, (copyCursor + 1) as a 64 bit integer, 1 as a 64 bit integer, 1 as a 64 bit integer, (a cad vector2 with x (copyCursor as a 64 bit floating-point number) and y 0.0), 0.0, the bim refused id)
    set placedShape to the bim component triangles shape placed by placement at 0.0
    append (@intrinsic("construct", a bim scene mesh record, (copyCursor + 1) as a 64 bit integer, 1 as a 64 bit integer, 0, placedShape, bim mass category, (a cad vector3 with x 120.0, y 120.0 and z 120.0), the string form of "memory probe")) to entries
print "source-ready" as a line
ignore @intrinsic("call", "libc", "getchar", integer)
set hidden to an empty list of a 64 bit integer
loop generation from 0 to 5:
    set batch to the bim native instances among entries leaving out hidden
    print ((the string form of "generation=") + (the string form of generation)) as a line
    ignore @intrinsic("call", "libc", "getchar", integer)
