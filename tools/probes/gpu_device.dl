# SPDX-License-Identifier: MPL-2.0
# Verify the actual surface-compatible device selected by the product context.
import viewer/vulkan/context.dl
set selectedContext to a new gpu context titled (the string form of "Open BIM Studio GPU selection probe") sized 640 by 480 with shaders in (the string form of "build/shaders")
print (the gpu device name of (the address of selectedContext)) as a line
print ((the string form of "kind=") + (the string form of (the gpu device kind of (the address of selectedContext)))) as a line
@intrinsic("call", "libc", "exit", nothing, 0)
