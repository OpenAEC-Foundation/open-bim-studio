# SPDX-License-Identifier: MPL-2.0
# Native demonstration data, using existing system recipes and boundary APIs.
# This is a showcase of the modeller, not generic generator certification.
import pattern/common/bim_system_types.dl
import ui/editor/bim_boundary_sketch.dl
import exchange/ifcx/bim_file.dl

function require showcase {boolean:ok} named {a string:caption}:
    execute:
        if ok = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "System showcase") at 0.0 with height 6.0 to target
ignore add bim opening type named (the string form of "Window") sized 1.2 by 1.2 with sill 0.9 and frame 0.05 to target
ignore add bim door type named (the string form of "Door") sized 0.9 by 2.1 with frame 0.05 to target
set library to the bim system types
require showcase ((the length of library) = 43) named (the string form of "43 existing native recipes")
loop recipeIndex from 0 to the length of library:
    set recipe to the item at recipeIndex in library
    set columnIndex to the remainder of recipeIndex divided by 8
    set rowIndex to recipeIndex / 8
    set px to (columnIndex as a 64 bit floating-point number) * 9.0
    set py to (rowIndex as a 64 bit floating-point number) * 10.0
    set systemId to add bim curtain wall on ground from (a cad vector2 with x px and y py) to (a cad vector2 with x (px + 6.0) and y py) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
    if (systemId = the bim refused id) or ((give bim system systemId type recipeIndex in target) = false):
        @intrinsic("call", "libc", "exit", nothing, 2)
    set bim property (the string form of "Station") of set (the string form of "Showcase") of systemId to ((the string form of (recipeIndex + 1)) + ((the string form of ": ") + recipe's name)) typed (the string form of "IfcText") in target
require showcase ((the length of (modelValue's curtains's values)) >= 43) named (the string form of "all recipes placed with their native layers")
set feature0 to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 64.0) to (a cad vector2 with x 8.0 and y 64.0) rising 4.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
require showcase (give bim system feature0 type 0 in target) named (the string form of "feature 1 recipe")
require showcase (set bim curtain wall feature0 bulge to 1.5 in target) named (the string form of "feature 1 curved carrier")
set bim property (the string form of "Station") of set (the string form of "Showcase") of feature0 to (the string form of "Feature 1: curve") typed (the string form of "IfcText") in target
set feature1 to add bim curtain wall on ground from (a cad vector2 with x 12.0 and y 64.0) to (a cad vector2 with x 20.0 and y 64.0) rising 4.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
require showcase (give bim system feature1 type 8 in target) named (the string form of "feature 2 recipe")
require showcase (set bim curtain wall feature1 bulge to 1.5 in target) named (the string form of "feature 2 curved carrier")
set bim property (the string form of "Station") of set (the string form of "Showcase") of feature1 to (the string form of "Feature 2: curve") typed (the string form of "IfcText") in target
set feature2 to add bim curtain wall on ground from (a cad vector2 with x 24.0 and y 64.0) to (a cad vector2 with x 32.0 and y 64.0) rising 4.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
require showcase (give bim system feature2 type 6 in target) named (the string form of "feature 3 recipe")
set boundary2 to an empty list of a bim boundary segment record
append (the bim boundary line from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 8.0 and y 0.0)) to boundary2
append (the bim boundary line from (a cad vector2 with x 8.0 and y 0.0) to (a cad vector2 with x 8.0 and y 2.5)) to boundary2
append (the bim boundary line from (a cad vector2 with x 8.0 and y 2.5) to (a cad vector2 with x 0.0 and y 4.0)) to boundary2
append (the bim boundary line from (a cad vector2 with x 0.0 and y 4.0) to (a cad vector2 with x 0.0 and y 0.0)) to boundary2
require showcase ((set bim system feature2 boundary to boundary2 in target) = (the string form of "")) named (the string form of "feature 3 authored slope contour")
free boundary2
set bim property (the string form of "Station") of set (the string form of "Showcase") of feature2 to (the string form of "Feature 3: slope") typed (the string form of "IfcText") in target
set feature3 to add bim curtain wall on ground from (a cad vector2 with x 36.0 and y 64.0) to (a cad vector2 with x 44.0 and y 64.0) rising 4.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
require showcase (give bim system feature3 type 8 in target) named (the string form of "feature 4 recipe")
set boundary3 to an empty list of a bim boundary segment record
append (the bim boundary line from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 8.0 and y 0.0)) to boundary3
append (the bim boundary line from (a cad vector2 with x 8.0 and y 0.0) to (a cad vector2 with x 8.0 and y 2.5)) to boundary3
append (the bim boundary line from (a cad vector2 with x 8.0 and y 2.5) to (a cad vector2 with x 0.0 and y 4.0)) to boundary3
append (the bim boundary line from (a cad vector2 with x 0.0 and y 4.0) to (a cad vector2 with x 0.0 and y 0.0)) to boundary3
require showcase ((set bim system feature3 boundary to boundary3 in target) = (the string form of "")) named (the string form of "feature 4 authored slope contour")
free boundary3
set bim property (the string form of "Station") of set (the string form of "Showcase") of feature3 to (the string form of "Feature 4: slope") typed (the string form of "IfcText") in target
set feature4 to add bim curtain wall on ground from (a cad vector2 with x 48.0 and y 64.0) to (a cad vector2 with x 56.0 and y 64.0) rising 4.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
require showcase (give bim system feature4 type 10 in target) named (the string form of "feature 5 recipe")
set boundary4 to an empty list of a bim boundary segment record
append (the bim boundary line from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 8.0 and y 0.0)) to boundary4
append (the bim boundary line from (a cad vector2 with x 8.0 and y 0.0) to (a cad vector2 with x 8.0 and y 3.0)) to boundary4
append (the bim boundary arc from (a cad vector2 with x 8.0 and y 3.0) to (a cad vector2 with x 0.0 and y 3.0) bulging -1.0) to boundary4
append (the bim boundary line from (a cad vector2 with x 0.0 and y 3.0) to (a cad vector2 with x 0.0 and y 0.0)) to boundary4
require showcase ((set bim system feature4 boundary to boundary4 in target) = (the string form of "")) named (the string form of "feature 5 authored round contour")
free boundary4
set bim property (the string form of "Station") of set (the string form of "Showcase") of feature4 to (the string form of "Feature 5: round") typed (the string form of "IfcText") in target
set feature5 to add bim curtain wall on ground from (a cad vector2 with x 60.0 and y 64.0) to (a cad vector2 with x 68.0 and y 64.0) rising 4.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
require showcase (give bim system feature5 type 0 in target) named (the string form of "feature 6 recipe")
set boundary5 to an empty list of a bim boundary segment record
append (the bim boundary line from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 8.0 and y 0.0)) to boundary5
append (the bim boundary line from (a cad vector2 with x 8.0 and y 0.0) to (a cad vector2 with x 8.0 and y 3.0)) to boundary5
append (the bim boundary arc from (a cad vector2 with x 8.0 and y 3.0) to (a cad vector2 with x 0.0 and y 3.0) bulging -1.0) to boundary5
append (the bim boundary line from (a cad vector2 with x 0.0 and y 3.0) to (a cad vector2 with x 0.0 and y 0.0)) to boundary5
require showcase ((set bim system feature5 boundary to boundary5 in target) = (the string form of "")) named (the string form of "feature 6 authored round contour")
free boundary5
set bim property (the string form of "Station") of set (the string form of "Showcase") of feature5 to (the string form of "Feature 6: round") typed (the string form of "IfcText") in target
set feature6 to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 78.0) to (a cad vector2 with x 8.0 and y 78.0) rising 4.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
require showcase (give bim system feature6 type 8 in target) named (the string form of "feature 7 recipe")
set bim setting (bim system pattern setting) of feature6 to ((bim diamond pattern) as a 64 bit integer) keeping true in target
set bim property (the string form of "Station") of set (the string form of "Showcase") of feature6 to (the string form of "Feature 7: diamond") typed (the string form of "IfcText") in target
set feature7 to add bim curtain wall on ground from (a cad vector2 with x 12.0 and y 78.0) to (a cad vector2 with x 20.0 and y 78.0) rising 4.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
require showcase (give bim system feature7 type 10 in target) named (the string form of "feature 8 recipe")
set bim setting (bim system pattern setting) of feature7 to ((bim diamond pattern) as a 64 bit integer) keeping true in target
set bim property (the string form of "Station") of set (the string form of "Showcase") of feature7 to (the string form of "Feature 8: diamond") typed (the string form of "IfcText") in target
set feature8 to add bim curtain wall on ground from (a cad vector2 with x 24.0 and y 78.0) to (a cad vector2 with x 32.0 and y 78.0) rising 4.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
require showcase (give bim system feature8 type 20 in target) named (the string form of "feature 9 recipe")
set bim property (the string form of "Station") of set (the string form of "Showcase") of feature8 to (the string form of "Feature 9: ceiling") typed (the string form of "IfcText") in target
set reopened to the bim model parsed from (the bim file text of modelValue)
require showcase reopened's valid named (the string form of "native model round trip")
require showcase ((the length of (reopened's modelValue's curtains's values)) = (the length of (modelValue's curtains's values))) named (the string form of "round trip preserves systems and layers")
require showcase (write bim text (the bim file text of modelValue) to file (the string form of "build/system-showcase.bim")) named (the string form of "native showcase saved")
free library
