# SPDX-License-Identifier: MPL-2.0
# Visual review of the native fastener geometry in an existing application.
# The cosmetic helix is exported as a very thin closed wire for this review
# file only; the product scene uses line vertices, not swept thread solids.
import elements/connection/fastener_geometry.dl
import elements/connection/bim_fastener_detail.dl

function append preview property {a string:propertyName} valued {a string:propertyValue} of {integer:elementNumber} into {a pointer to a list:lines}:
    execute:
        set setName to the string form of "OpenBIM_Fastener"
        set prefixValue to (((the string form of "property ") + (the string form of elementNumber)) + ((the string form of " 8 ") + (the string form of (the length of setName)))) + ((the string form of " ") + (the string form of (the length of propertyName)))
        append ((prefixValue + (the string form of " ")) + (((the string form of "IfcLabel") + setName) + (propertyName + propertyValue))) to lines

function append preview mesh {fast mesh record:shapeValue} named {a string:titleValue} numbered {integer:elementNumber} into {a pointer to a list:lines}:
    execute:
        set tokens to an empty list of a string
        append (the string form of "mesh") to tokens
        append (the string form of elementNumber) to tokens
        append (the string form of "1") to tokens
        append (the string form of (the length of (shapeValue's positions's values))) to tokens
        loop pointCursor from 0 to the length of (shapeValue's positions's values):
            set vertexValue to the item at pointCursor in (shapeValue's positions's values)
            append (the string form of vertexValue's x) to tokens
            append (the string form of vertexValue's y) to tokens
            append (the string form of vertexValue's z) to tokens
        set triangleCount to (the length of (shapeValue's triangles's values)) / 3
        append (the string form of (triangleCount * 4)) to tokens
        loop faceCursor from 0 to triangleCount:
            append (the string form of "3") to tokens
            loop cornerCursor from 0 to 3:
                append (the string form of (the item at ((faceCursor * 3) + cornerCursor) in (shapeValue's triangles's values))) to tokens
        append (tokens joined with " ") to lines
        free tokens
        append preview property (the string form of "Component") valued titleValue of elementNumber into lines

function the preview thread wire through {a pointer to a list:pointValues}:
    execute:
        set wireValue to an empty fast mesh
        set radiusValue to 0.00010
        loop pointCursor from 0 to the length of pointValues:
            set centreValue to the item at pointCursor in pointValues
            set previousValue to the item at (the maximum of 0 and (pointCursor - 1)) in pointValues
            set nextValue to the item at (the minimum of ((the length of pointValues) - 1) and (pointCursor + 1)) in pointValues
            set tangentValue to the cad difference of nextValue and previousValue
            set tangentValue to tangentValue scaled by (1.0 / (the cad length of tangentValue))
            set acrossValue to the cad cross of tangentValue and (a cad vector3 with x 0.0, y 0.0 and z 1.0)
            set acrossValue to acrossValue scaled by (1.0 / (the cad length of acrossValue))
            set upValue to the cad cross of tangentValue and acrossValue
            loop sideCursor from 0 to 3:
                set sideAngle to 6.283185307179586 * ((sideCursor as a 64 bit floating-point number) / 3.0)
                set radialOffset to the cad sum of (acrossValue scaled by (radiusValue * (the cosine of sideAngle))) and (upValue scaled by (radiusValue * (the sine of sideAngle)))
                append (the cad sum of centreValue and radialOffset) to (wireValue's positions's values)
        loop pointCursor from 0 to ((the length of pointValues) - 1):
            loop sideCursor from 0 to 3:
                set nextSide to the remainder of (sideCursor + 1) divided by 3
                set baseIndex to pointCursor * 3
                append (baseIndex + sideCursor) to (wireValue's triangles's values)
                append (baseIndex + nextSide) to (wireValue's triangles's values)
                append ((baseIndex + 3) + nextSide) to (wireValue's triangles's values)
                append (baseIndex + sideCursor) to (wireValue's triangles's values)
                append ((baseIndex + 3) + nextSide) to (wireValue's triangles's values)
                append ((baseIndex + 3) + sideCursor) to (wireValue's triangles's values)
        append 0 to (wireValue's triangles's values)
        append 2 to (wireValue's triangles's values)
        append 1 to (wireValue's triangles's values)
        set lastBase to ((the length of pointValues) - 1) * 3
        append lastBase to (wireValue's triangles's values)
        append (lastBase + 1) to (wireValue's triangles's values)
        append (lastBase + 2) to (wireValue's triangles's values)
        return wireValue

set previewLines to an empty list of a string
append (the string form of "BIM-SLICE 1") to previewLines
append (the string form of "next 1000") to previewLines
append (the string form of "level 1 0 1 Fastener geometry review") to previewLines
append (the string form of "walltype 3 Default wall") to previewLines
append (the string form of "layer 0.2 concrete") to previewLines
append (the string form of "openingtype 4 1.2 1.5 0.9 0.05 0 Window") to previewLines
append (the string form of "openingtype 5 0.9 2.1 0 0.05 1 Door") to previewLines
set elementNumber to 10
loop sampleCursor from 0 to 8:
    set parameters to catalogued connection fastener parameters
    set diameterValue to 0.016
    set shaftLength to 0.080
    set familyValue to 1
    set columnValue to the remainder of sampleCursor divided by 4
    set rowValue to sampleCursor / 4
    set originValue to a cad vector3 with x ((columnValue as a 64 bit floating-point number) * 0.22), y ((rowValue as a 64 bit floating-point number) * 0.26) and z 0.0
    if sampleCursor = 1:
        set parameters's washers to 3
        set parameters's coating to 2
    if sampleCursor = 2:
        set familyValue to 6
        set parameters's nuts to 0
        set shaftLength to 0.0148
    if sampleCursor = 3:
        set familyValue to 7
        set parameters's nuts to 0
        set parameters's showThread to false
        set shaftLength to 0.003
    if sampleCursor >= 4:
        set diameterValue to 0.020
        set shaftLength to 0.300
        set familyValue to 3
        set parameters's anchorShape to sampleCursor - 4
        set parameters's washers to 2
        set parameters's grade to 46
    set fastenerValue to @intrinsic("construct", a connection fastener, 1, 1 as a 64 bit integer, familyValue, originValue, (a cad vector3 with x 0.0, y 0.0 and z 1.0), diameterValue, shaftLength, parameters)
    set pieces to the connection fastener pieces of fastenerValue
    loop pieceCursor from 0 to the length of (pieces's values):
        set pieceValue to the item at pieceCursor in (pieces's values)
        append preview mesh pieceValue's shape named pieceValue's name numbered elementNumber into previewLines
        if pieceValue's kind = 0:
            append preview property (the string form of "Grade") valued (the connection grade name of parameters's grade) of elementNumber into previewLines
        if pieceValue's kind = 1:
            append preview property (the string form of "Nut class") valued (the string form of parameters's nutClass) of elementNumber into previewLines
        if pieceValue's kind = 2:
            append preview property (the string form of "Hardness") valued (the string form of "200 HV") of elementNumber into previewLines
        append preview property (the string form of "Finish") valued (the connection coating name of parameters's coating) of elementNumber into previewLines
        set elementNumber to elementNumber + 1
    if parameters's showThread:
        set threadPoints to the bim cosmetic helix of fastenerValue
        if (the length of (threadPoints's values)) > 1:
            append preview mesh (the preview thread wire through (threadPoints's values)) named (the string form of "Cosmetic pitch lines - review wire") numbered elementNumber into previewLines
            set elementNumber to elementNumber + 1
append (the string form of "units mm") to previewLines
set outputText to previewLines joined with "\n"
set outputPath to the string form of "build/fastener-components/fastener-preview.bim"
set outputHandle to @intrinsic("call", "libc", "fopen", a pointer to a byte, the data of outputPath, "wb")
if outputHandle = (0 as a pointer to a byte):
    @intrinsic("call", "libc", "exit", nothing, 1)
ignore @intrinsic("call", "libc", "fwrite", a word sized integer, the data of outputText, 1 as a word sized integer, (the length of outputText) as a word sized integer, outputHandle)
ignore @intrinsic("call", "libc", "fclose", integer, outputHandle)
print outputPath as a line
