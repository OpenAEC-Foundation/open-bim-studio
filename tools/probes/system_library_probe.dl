# SPDX-License-Identifier: MPL-2.0
# Repeated property/header lookups must not retain a recipe library per frame.
# Measure this process with /usr/bin/time -v; no window or project data needed.
import architectural/openings/bim_window_actions.dl
set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set systemId to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 3.6 and y 0.0) rising 2.4 in bays of 1.2 by 1.2 of (the string form of "timber") to target
ignore give bim system systemId type 34 in target
set systemValue to the item at 0 in (modelValue's curtains's values)
set expectedName to the bim system type name of systemValue in modelValue
set checksum to 0
loop cursor from 0 to 2000:
    set nameValue to the bim system type name of systemValue in modelValue
    if nameValue != expectedName:
        print "FAIL: recipe name changed during repeated lookups" as a line
        @intrinsic("call", "libc", "exit", nothing, 1)
    set checksum to checksum + (the length of nameValue)
print ((the string form of "lookups=2000 checksum=") + (the string form of checksum)) as a line
print expectedName as a line
