# SPDX-License-Identifier: MPL-2.0
# Timing of a plan's projection (drawing quality plan, item 15;
# ui/panels/bim_plan_projection.dl): generates a tower of at least N walls
# (the first argument, 312 by default) with R rooms a side (the second, 12
# by default: 312 walls a storey), then times, for the ground floor's plan,
# the cut the plan already makes, the projection worked out (below and
# above the cut), and the projection asked for again unchanged (kept); then,
# with every third wall of the ground floor lowered below the cut, the
# projection of a plan full of edges, and a frame of a drag (one wall
# changed: only it tessellated again); then a drag of a lowered wall over six
# frames as the editor drags it (the transaction open), each frame's
# projection kept and updated (`update bim kept projection`) against the
# same frame worked out whole, and the projection worked out whole once the
# drag is let go. Each frame says how many meshes had their edges worked
# out again and how many elements were tessellated again.
import ui/panels/bim_plan_projection.dl

function report bim projection step {a string:label} from {a 64 bit integer:started}:
    execute:
        set spent to (the bim microseconds now) - started
        print ((label + (the string form of " ")) + ((the string form of (spent / (1000 as a 64 bit integer))) + (the string form of " ms"))) as a line

function the bim projection microseconds since {a 64 bit integer:started}:
    execute:
        return (the bim microseconds now) - started

set arguments to the command line arguments
set wanted to 312
set roomsASide to 12
if (the length of arguments) > 0:
    set wanted to (@intrinsic("call", "libc", "atoi", integer, the data of (the argument at 0 in arguments)))
if (the length of arguments) > 1:
    set roomsASide to (@intrinsic("call", "libc", "atoi", integer, the data of (the argument at 1 in arguments)))
set editor to a new bim editor
set storeys to add bim generated tower of wanted walls with roomsASide rooms a side to (the address of editor)
set modelValue to editor's documentValue's current
print (((the string form of "walls ") + (the string form of (the length of (modelValue's walls's values)))) + ((the string form of ", openings ") + ((the string form of (the length of (modelValue's openings's values))) + ((the string form of ", slabs ") + ((the string form of (the length of (modelValue's slabs's values))) + ((the string form of ", levels ") + (the string form of (the length of (modelValue's levels's values))))))))) as a line
set started to the bim microseconds now
update bim evaluation (the address of (editor's evaluation)) to editor's documentValue's current
report bim projection step (the string form of "evaluate") from started
set editor's adopted to true
set editor's adoptedMicroseconds to 0 as a 64 bit integer
refresh bim editor (the address of editor)
set planView to add bim view of kind bim plan view named (the string form of "Ground floor") on editor's levelId to (the address of (editor's documentValue's current))
set editor's planViewId to planView
refresh bim editor (the address of editor)
set scene to an empty list of a bim scene mesh record
set started to the bim microseconds now
set recut to the bim view of editor's evaluation cut by (the bim plan plane at (the bim storey elevation of editor) cut at (the bim plan cut height of editor))
report bim projection step ((the string form of "plan cut, polygons ") + (the string form of (the bim polygon count of recut))) from started
set planProjection to an empty bim plan projection
set started to the bim microseconds now
refresh bim plan projection in (the address of planProjection) of editor among scene cut as editor's plan
report bim projection step ((the string form of "projection worked out, below ") + ((the string form of (the length of (planProjection's below's values))) + ((the string form of ", above ") + (the string form of (the length of (planProjection's above's values)))))) from started
set started to the bim microseconds now
refresh bim plan projection in (the address of planProjection) of editor among scene cut as editor's plan
report bim projection step ((the string form of "projection kept, builds ") + (the string form of planProjection's builds)) from started

# A plan full of edges: every third wall of the ground floor lowered to
# 0.8 m, below the cut, so that its top and what lies below it are drawn.
set lowered to 0
begin bim transaction in (the address of (editor's documentValue))
set wallCount to the length of (editor's documentValue's current's walls's values)
loop wallCursor from 0 to wallCount:
    set wallValue to the item at wallCursor in (editor's documentValue's current's walls's values)
    if (wallValue's levelId = editor's levelId) and ((the remainder of wallCursor divided by 3) = 0):
        ignore (set bim wall wallValue's id height to 0.8 in (the address of (editor's documentValue's current)))
        set lowered to lowered + 1
commit bim transaction in (the address of (editor's documentValue))
set started to the bim microseconds now
refresh bim editor (the address of editor)
report bim projection step ((the string form of "lowered walls ") + ((the string form of lowered) + (the string form of ", evaluated again and cut"))) from started
set started to the bim microseconds now
refresh bim plan projection in (the address of planProjection) of editor among scene cut as editor's plan
report bim projection step ((the string form of "projection with edges worked out, below ") + ((the string form of (the length of (planProjection's below's values))) + ((the string form of ", above ") + ((the string form of (the length of (planProjection's above's values))) + ((the string form of ", tessellated ") + (the string form of planProjection's tessellated)))))) from started

# A frame of a drag: one lowered wall changed, its plan worked out again.
set draggedWall to the bim refused id
loop wallCursor from 0 to wallCount:
    set wallValue to the item at wallCursor in (editor's documentValue's current's walls's values)
    if ((wallValue's levelId = editor's levelId) and ((the remainder of wallCursor divided by 3) = 0)) and (draggedWall = the bim refused id):
        set draggedWall to wallValue's id
begin bim transaction in (the address of (editor's documentValue))
ignore (set bim wall draggedWall height to 0.7 in (the address of (editor's documentValue's current)))
commit bim transaction in (the address of (editor's documentValue))
refresh bim editor (the address of editor)
set started to the bim microseconds now
refresh bim plan projection in (the address of planProjection) of editor among scene cut as editor's plan
report bim projection step ((the string form of "one wall changed, projection worked out again, below ") + ((the string form of (the length of (planProjection's below's values))) + ((the string form of ", tessellated ") + (the string form of planProjection's tessellated)))) from started

# A drag over six frames, 20 mm a frame square to itself, of a lowered
# wall the plan draws (the first edge's below the cut).
if (the length of (planProjection's below's values)) > 0:
    set draggedWall to (the item at 0 in (planProjection's below's values))'s elementId
set draggedFound to the bim wall index of draggedWall in editor's documentValue's current
set draggedValue to the item at draggedFound's position in (editor's documentValue's current's walls's values)
set dragFrom to draggedValue's start
set dragTo to draggedValue's finish
set dragLength to the cad distance from dragFrom to dragTo
set squareX to (0.0 - (dragTo's y - dragFrom's y)) / dragLength
set squareY to (dragTo's x - dragFrom's x) / dragLength
begin bim transaction in (the address of (editor's documentValue))
set editor's dragging to true
set updatedTotal to 0 as a 64 bit integer
set wholeTotal to 0 as a 64 bit integer
loop frameCursor from 1 to 7:
    set sideStep to 0.02 * (frameCursor as a 64 bit floating-point number)
    set stepX to squareX * sideStep
    set stepY to squareY * sideStep
    ignore (move bim wall draggedWall to (a cad vector2 with x (dragFrom's x + stepX) and y (dragFrom's y + stepY)) and (a cad vector2 with x (dragTo's x + stepX) and y (dragTo's y + stepY)) in (the address of (editor's documentValue's current)))
    refresh bim editor (the address of editor)
    set started to the bim microseconds now
    refresh bim plan projection in (the address of planProjection) of editor among scene cut as editor's plan
    set updatedSpent to the bim projection microseconds since started
    set wholeProjection to an empty bim plan projection
    set started to the bim microseconds now
    refresh bim plan projection in (the address of wholeProjection) of editor among scene cut as editor's plan
    set wholeSpent to the bim projection microseconds since started
    set updatedTotal to updatedTotal + updatedSpent
    set wholeTotal to wholeTotal + wholeSpent
    set sameCount to ((the length of (planProjection's below's values)) = (the length of (wholeProjection's below's values))) and ((the length of (planProjection's above's values)) = (the length of (wholeProjection's above's values)))
    set frameLine to (the string form of "drag frame ") + ((the string form of frameCursor) + ((the string form of ": updated ") + ((the string form of updatedSpent) + (the string form of " us"))))
    set frameLine to frameLine + ((the string form of " (meshes worked out ") + ((the string form of planProjection's redrawn) + ((the string form of ", tessellated ") + ((the string form of planProjection's tessellated) + (the string form of ")")))))
    set frameLine to frameLine + ((the string form of ", worked out whole ") + ((the string form of wholeSpent) + (the string form of " us")))
    set draggedEdges to 0
    loop edgeCursor from 0 to the length of (planProjection's below's values):
        if (the item at edgeCursor in (planProjection's below's values))'s elementId = draggedWall:
            set draggedEdges to draggedEdges + 1
    set frameLine to frameLine + ((the string form of ", dragged wall's edges below ") + (the string form of draggedEdges))
    if sameCount = false:
        set frameLine to frameLine + (the string form of ", EDGE COUNTS DIFFER")
    print frameLine as a line
print ((the string form of "drag of six frames: updated ") + ((the string form of (updatedTotal / (6000 as a 64 bit integer))) + ((the string form of " ms a frame, worked out whole ") + ((the string form of (wholeTotal / (6000 as a 64 bit integer))) + (the string form of " ms a frame"))))) as a line
commit bim transaction in (the address of (editor's documentValue))
set editor's dragging to false
refresh bim editor (the address of editor)
set started to the bim microseconds now
refresh bim plan projection in (the address of planProjection) of editor among scene cut as editor's plan
report bim projection step ((the string form of "drag let go, worked out whole, builds ") + ((the string form of planProjection's builds) + ((the string form of ", updates ") + (the string form of planProjection's partials)))) from started
