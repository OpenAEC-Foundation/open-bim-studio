# SPDX-License-Identifier: MPL-2.0
# Timing at scale: generates an imaginary tower of at least N walls (the first
# argument, 500,000 by default) through the editor, then times the first
# evaluation with the plan cut and the spaces of the ground floor, the scene
# meshes for the 3D view, one wall moved, and reports the peak memory.
import ui/editor/bim_editor.dl
import viewer/bim_scene.dl

function the bim peak memory in megabytes:
    execute:
        set usage to a new string buffer containing 256 bytes
        ignore @intrinsic("call", "libc", "getrusage", integer, 0, the data of usage)
        # ru_maxrss, in kilobytes, follows the two timevals (32 bytes).
        set kilobytes to @intrinsic("dereference", ((the data of usage) + 32) as a pointer to a 64 bit integer)
        return kilobytes / (1024 as a 64 bit integer)

function report bim step {a string:label} from {a 64 bit integer:started}:
    execute:
        set spent to (the bim microseconds now) - started
        print (((label + (the string form of " ")) + (the string form of (spent / (1000 as a 64 bit integer)))) + ((the string form of " ms, peak ") + ((the string form of (the bim peak memory in megabytes)) + (the string form of " MB")))) as a line

set arguments to the command line arguments
set wanted to 500000
if (the length of arguments) > 0:
    set wanted to (@intrinsic("call", "libc", "atoi", integer, the data of (the argument at 0 in arguments)))
set editor to a new bim editor
set started to the bim microseconds now
set storeys to add bim generated tower of wanted walls with 50 rooms a side to (the address of editor)
report bim step ((the string form of "generate ") + editor's message) from started
set modelValue to editor's documentValue's current
print (((the string form of "walls ") + (the string form of (the length of (modelValue's walls's values)))) + ((the string form of ", openings ") + ((the string form of (the length of (modelValue's openings's values))) + ((the string form of ", slabs ") + (the string form of (the length of (modelValue's slabs's values))))))) as a line
set started to the bim microseconds now
update bim evaluation (the address of (editor's evaluation)) to editor's documentValue's current
report bim step (the string form of "evaluate") from started
set fastCount to 0
set failed to 0
loop cursor from 0 to the length of (editor's evaluation's elements's values):
    set geometry to the item at cursor in (editor's evaluation's elements's values)
    if geometry's fast:
        set fastCount to fastCount + 1
    if geometry's status != 0:
        set failed to failed + 1
print (((the string form of "elements fast ") + (the string form of fastCount)) + ((the string form of ", failed ") + (the string form of failed))) as a line
set started to the bim microseconds now
set editor's adopted to true
set editor's adoptedMicroseconds to 0 as a 64 bit integer
refresh bim editor (the address of editor)
report bim step ((the string form of "plan and spaces of the ground floor, spaces ") + (the string form of (the length of (editor's spaces's values)))) from started
set started to the bim microseconds now
set meshes to a cad topology list of a bim scene mesh record
set meshes to the bim scene meshes of editor's evaluation after (meshes's values)
set triangles to 0
loop cursor from 0 to the length of (meshes's values):
    set triangles to triangles + ((the length of ((the item at cursor in (meshes's values))'s shape's triangles's values)) / 3)
report bim step ((the string form of "scene meshes, triangles ") + (the string form of triangles)) from started
# One edit: the first partition moved 0.5 m, then evaluated incrementally.
set wallValue to the item at 100 in (modelValue's walls's values)
set started to the bim microseconds now
begin bim transaction in (the address of (editor's documentValue))
ignore move bim wall wallValue's id to (a cad vector2 with x (wallValue's start's x) and y (wallValue's start's y + 0.5)) and (a cad vector2 with x (wallValue's finish's x) and y (wallValue's finish's y + 0.5)) in (the address of (editor's documentValue's current))
commit bim transaction in (the address of (editor's documentValue))
refresh bim editor (the address of editor)
report bim step ((the string form of "one wall moved, rebuilt ") + (the string form of editor's lastRebuilt)) from started
