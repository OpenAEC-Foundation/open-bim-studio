# SPDX-License-Identifier: MPL-2.0
# Isolate hits and misses against 8192 settings; no geometry or GPU work.
import bim/bim_model.dl
set sampleModel to an empty bim model
loop owner from 0 to 8192:
    append (@intrinsic("construct", a bim setting record, owner as a 64 bit integer, 1, owner as a 64 bit integer)) to (sampleModel's settings's values)
set checksum to 0 as a 64 bit integer
loop repetition from 0 to 2:
    loop owner from 0 to 8192:
        set reading to the bim setting 1 of (owner as a 64 bit integer) in sampleModel
        set checksum to checksum + reading's value
        if (the bim setting 2 of (owner as a 64 bit integer) in sampleModel)'s found:
            @intrinsic("call", "libc", "exit", nothing, 1)
print checksum as a line
