local function no cad silhouette source result:
    execute:
        set sourceValue to the cad owned silhouette source with sides (an empty list of a cad silhouette side), triangles (an empty list of a cad silhouette triangle), cones (an empty list of a cad cone silhouette) and precision 1e-12
        return @intrinsic("construct", a cad silhouette source result, false, sourceValue)

# Rust's saturating f64-to-i64 cast of a rounded grid coordinate.
local function the cad silhouette grid coordinate of {a 64 bit floating-point number:value} from {a 64 bit floating-point number:originValue} within {a 64 bit floating-point number:precisionValue}:
    execute:
        set roundedValue to the rounded value of ((value - originValue) / precisionValue)
        if roundedValue != roundedValue:
            return 0 as a 64 bit integer
        if roundedValue >= 9.223372036854775807e18:
            return 9223372036854775807 as a 64 bit integer
        if roundedValue <= -9.223372036854775808e18:
            set minimumValue to 0 as a 64 bit integer
            return (minimumValue - 9223372036854775807) - 1
        return roundedValue as a 64 bit integer

class:
    patterns:
        [a|] cad silhouette grid point
    members:
        x as a 64 bit integer
        y as a 64 bit integer
        z as a 64 bit integer

class:
    patterns:
        [a|] cad silhouette side tables
