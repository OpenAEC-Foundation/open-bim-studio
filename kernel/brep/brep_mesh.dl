        loop pairIndex from 1 to the length of distinctProbes:
            append (0.5 * ((the item at (pairIndex - 1) in distinctProbes) + (the item at pairIndex in distinctProbes))) to probeValues
        free distinctProbes
        set axisAngle to maxAngle * 0.7071067811865476
        if ((surfaceValue's kind = 1) or (surfaceValue's kind = 2)) and (axisIndex = 0):
            set axisAngle to maxAngle
        set outputValues to an empty list of a 64 bit floating-point number
        loop probeIndex from 0 to the length of probeValues:
            if (append cad mesh span breaks on surfaceValue along axis axisIndex at (the item at probeIndex in probeValues) from axisLow to axisHigh within angle axisAngle at depth 0 into outputValues) = false:
                free probeValues
                free outputValues
                return @intrinsic("construct", a cad mesh scalars result, false, an empty list of a 64 bit floating-point number)
        free probeValues
        if surfaceValue's kind = 5:
            set axisKnots to surfaceValue's nurbs's uKnots
            if axisIndex = 1:
                set axisKnots to surfaceValue's nurbs's vKnots
            set nurbsDomain to the cad domain of surfaceValue's nurbs
            set domainLow to nurbsDomain's u's start
            set domainHigh to nurbsDomain's u's end
            if axisIndex = 1:
                set domainLow to nurbsDomain's v's start
                set domainHigh to nurbsDomain's v's end
            set periodicValues to the cad periodicity of surfaceValue's nurbs
            set axisPeriodic to the item at axisIndex in periodicValues
            set periodValue to 0.0
            if axisPeriodic:
                set periodValue to domainHigh - domainLow
            loop knotIndex from 0 to the length of axisKnots:
                set knotValue to the item at knotIndex in axisKnots
                set firstTurn to 0
                set lastTurn to 0
                if axisPeriodic:
                    set firstTurn to -2
                    set lastTurn to 2
                loop turnIndex from firstTurn to (lastTurn + 1):
                    set turnedValue to knotValue + ((turnIndex as a 64 bit floating-point number) * periodValue)
                    if (turnedValue >= axisLow) and (turnedValue <= axisHigh):
                        append turnedValue to outputValues
        append axisHigh to outputValues
        set distinctValues to the cad mesh distinct sorted scalars from outputValues
        free outputValues
        return @intrinsic("construct", a cad mesh scalars result, true, distinctValues)

local function the cad mesh grid lines of {cad surface:surfaceValue} within {cad mesh domain:boundsValue} at angle {a 64 bit floating-point number:maxAngle}:
    execute:
        set uResult to the cad mesh grid axis values of surfaceValue along axis 0 within boundsValue at angle maxAngle
        set vResult to the cad mesh grid axis values of surfaceValue along axis 1 within boundsValue at angle maxAngle
        if (uResult's valid = false) or (vResult's valid = false):
            free uResult's values
            free vResult's values
            return no cad mesh grid lines
        return @intrinsic("construct", a cad mesh grid lines, true, uResult's values, vResult's values)

local function the cad mesh uniform grid over {cad mesh domain:domainValue} with {a 64 bit integer:uCells} by {a 64 bit integer:vCells} cells:
    execute:
        set uValues to an empty list of a 64 bit floating-point number
        set vValues to an empty list of a 64 bit floating-point number
        set uLow to the cad mesh lower limit of domainValue on axis 0
        set uHigh to the cad mesh upper limit of domainValue on axis 0
        set vLow to the cad mesh lower limit of domainValue on axis 1
        set vHigh to the cad mesh upper limit of domainValue on axis 1
        set cellIndex to 0 as a 64 bit integer
        loop while cellIndex <= uCells:
            append (uLow + (((uHigh - uLow) * (cellIndex as a 64 bit floating-point number)) / (uCells as a 64 bit floating-point number))) to uValues
            set cellIndex to cellIndex + 1
        set cellIndex to 0 as a 64 bit integer
        loop while cellIndex <= vCells:
            append (vLow + (((vHigh - vLow) * (cellIndex as a 64 bit floating-point number)) / (vCells as a 64 bit floating-point number))) to vValues
            set cellIndex to cellIndex + 1
        return @intrinsic("construct", a cad mesh grid lines, true, uValues, vValues)

local function the cad mesh whole surface fill of {cad surface:surfaceValue} over {cad mesh domain:domainValue} on face {cad face:faceValue} within angle {a 64 bit floating-point number:maxAngle} and tolerance {a 64 bit floating-point number:linearTolerance}:
    execute:
        set outputMesh to an empty cad mesh
        set analytic to (surfaceValue's kind = 3) or (surfaceValue's kind = 4)
        set stepValue to the maximum of (maxAngle / 1.4142135623730951) and 2.220446049250313e-16
        set uCells to 4 as a 64 bit integer
        set vCells to 4 as a 64 bit integer
        if analytic:
            set uCells to the cad mesh cell count of (the ceiling of (((the cad mesh upper limit of domainValue on axis 0) - (the cad mesh lower limit of domainValue on axis 0)) / stepValue))
            set vCells to the cad mesh cell count of (the ceiling of (((the cad mesh upper limit of domainValue on axis 1) - (the cad mesh lower limit of domainValue on axis 1)) / stepValue))
        else if surfaceValue's kind = 3:
            set vCells to 2 as a 64 bit integer
        if (the cad mesh saturating product of (the cad mesh saturating product of uCells and vCells) and (2 as a 64 bit integer)) > 262144:
            return @intrinsic("construct", a cad mesh result, false, outputMesh)
        # The placeholder's lists are released before each grid replaces it.
        set gridValue to no cad mesh grid lines
        if analytic:
            free cad mesh grid lines gridValue
            set gridValue to the cad mesh uniform grid over domainValue with uCells by vCells cells
        else:
            set seededGrid to the cad mesh grid lines of surfaceValue within domainValue at angle maxAngle
            set seededFits to false
            if seededGrid's valid:
                set uSpans to ((the length of seededGrid's u) - 1) as a 64 bit integer
                set vSpans to ((the length of seededGrid's v) - 1) as a 64 bit integer
                if uSpans < 0:
                    set uSpans to 0 as a 64 bit integer
                if vSpans < 0:
                    set vSpans to 0 as a 64 bit integer
                set seededFits to (the cad mesh saturating product of (the cad mesh saturating product of uSpans and vSpans) and (2 as a 64 bit integer)) <= 262144
            free cad mesh grid lines gridValue
            if seededFits:
                set gridValue to seededGrid
            else:
                free cad mesh grid lines seededGrid
                set gridValue to the cad mesh uniform grid over domainValue with uCells by vCells cells
        set noPins to an empty list of a cad mesh boundary point
        set noSegments to an empty list of a cad mesh segment2
        loop vIndex from 1 to the length of gridValue's v:
            set v0 to the item at (vIndex - 1) in gridValue's v
            set v1 to the item at vIndex in gridValue's v
            loop uIndex from 1 to the length of gridValue's u:
                set u0 to the item at (uIndex - 1) in gridValue's u
                set u1 to the item at uIndex in gridValue's u
                set lowerCorners to the cad mesh corners (a cad vector2 with x u0 and y v0), (a cad vector2 with x u1 and y v0) and (a cad vector2 with x u0 and y v1)
                set upperCorners to the cad mesh corners (a cad vector2 with x u1 and y v0), (a cad vector2 with x u1 and y v1) and (a cad vector2 with x u0 and y v1)
                if analytic:
                    emit cad mesh scheduled lowerCorners on surfaceValue of face faceValue pinned by noPins into (the address of outputMesh)
                    emit cad mesh scheduled upperCorners on surfaceValue of face faceValue pinned by noPins into (the address of outputMesh)
                else:
                    if (refine cad mesh scheduled lowerCorners on surfaceValue of face faceValue within angle maxAngle at depth 0 pinned by noPins bounded by noSegments within linearTolerance into (the address of outputMesh)) = false:
                        free cad mesh grid lines gridValue
                        free noPins
                        free noSegments
                        return @intrinsic("construct", a cad mesh result, false, outputMesh)
                    if (refine cad mesh scheduled upperCorners on surfaceValue of face faceValue within angle maxAngle at depth 0 pinned by noPins bounded by noSegments within linearTolerance into (the address of outputMesh)) = false:
                        free cad mesh grid lines gridValue
                        free noPins
                        free noSegments
                        return @intrinsic("construct", a cad mesh result, false, outputMesh)
        free cad mesh grid lines gridValue
        free noPins
        free noSegments
        return @intrinsic("construct", a cad mesh result, (the cad triangle count of outputMesh) > 0, outputMesh)

local function the cad mesh bounds of parameter rings {a pointer to a list:ringValues}:
    execute:
        set lowU to 1.7976931348623157e308 * 10.0
        set highU to -1.7976931348623157e308 * 10.0
        set lowV to lowU
        set highV to highU
        loop ringIndex from 0 to the length of ringValues:
            set ringValue to the item at ringIndex in ringValues
            loop pointIndex from 0 to the length of ringValue:
                set pointValue to the item at pointIndex in ringValue
                set lowU to the minimum of lowU and pointValue's x
                set highU to the maximum of highU and pointValue's x
                set lowV to the minimum of lowV and pointValue's y
                set highV to the maximum of highV and pointValue's y
        if (((cad mesh scalar lowU is finite) and (cad mesh scalar highU is finite)) and ((cad mesh scalar lowV is finite) and (cad mesh scalar highV is finite))) = false:
            return no cad mesh domain
        return the cad mesh domain from lowU to highU and lowV to highV

# line_intervals: inside spans of an isoparametric line through the rings.
local function the cad mesh line intervals through {a pointer to a list:ringValues} with fixed axis {integer:fixedAxis} at {a 64 bit floating-point number:fixedValue}:
    execute:
        set varyingAxis to 1 - fixedAxis
        set crossingValues to an empty list of a 64 bit floating-point number
        loop ringIndex from 0 to the length of ringValues:
            set ringValue to the item at ringIndex in ringValues
            loop pointIndex from 0 to the length of ringValue:
                set firstPoint to the item at pointIndex in ringValue
                set secondPoint to the item at (the remainder of (pointIndex + 1) divided by (the length of ringValue)) in ringValue
                set firstFixed to the cad mesh coordinate fixedAxis of firstPoint
                set secondFixed to the cad mesh coordinate fixedAxis of secondPoint
                set crosses to ((firstFixed <= fixedValue) and (secondFixed > fixedValue)) or ((secondFixed <= fixedValue) and (firstFixed > fixedValue))
                if crosses:
                    set unitValue to (fixedValue - firstFixed) / (secondFixed - firstFixed)
                    set firstVarying to the cad mesh coordinate varyingAxis of firstPoint
                    set secondVarying to the cad mesh coordinate varyingAxis of secondPoint
                    append (firstVarying + ((secondVarying - firstVarying) * unitValue)) to crossingValues
        sort cad mesh scalars crossingValues
        set distinctValues to an empty list of a 64 bit floating-point number
        loop crossingIndex from 0 to the length of crossingValues:
            set crossingValue to the item at crossingIndex in crossingValues
            if (the length of distinctValues) = 0:
                append crossingValue to distinctValues
            else if ((the absolute value of (crossingValue - (the last item of distinctValues))) <= 1e-12) = false:
                append crossingValue to distinctValues
        free crossingValues
        set intervalValues to an empty list of a cad vector2
        set pairIndex to 0
        loop while (pairIndex + 1) < (the length of distinctValues):
            set fromValue to the item at pairIndex in distinctValues
            set toValue to the item at (pairIndex + 1) in distinctValues
            if toValue > fromValue:
                append (a cad vector2 with x fromValue and y toValue) to intervalValues
            set pairIndex to pairIndex + 2
        free distinctValues
        return intervalValues

local function the cad mesh seeded grid of {a pointer to a cad constrained mesh2:domainValue} on {cad surface:surfaceValue} through {a pointer to a list:ringValues} within angle {a 64 bit floating-point number:maxAngle}:
    execute:
        set absentValue to @intrinsic("construct", a cad mesh count result, false, 0 as a 64 bit integer)
        if surfaceValue's kind = 0:
            return @intrinsic("construct", a cad mesh count result, true, 0 as a 64 bit integer)
        set boundsValue to the cad mesh bounds of parameter rings ringValues
        if boundsValue's valid = false:
            return absentValue
        set gridValue to the cad mesh grid lines of surfaceValue within boundsValue at angle maxAngle
        if gridValue's valid = false:
            free cad mesh grid lines gridValue
            return @intrinsic("construct", a cad mesh count result, true, 0 as a 64 bit integer)
        if (the cad mesh saturating product of ((the length of gridValue's u) as a 64 bit integer) and ((the length of gridValue's v) as a 64 bit integer)) > 262144:
            free cad mesh grid lines gridValue
            return absentValue
        set insertedCount to 0 as a 64 bit integer
        loop fixedAxis from 0 to 2:
            set axisValues to gridValue's u
            if fixedAxis = 1:
                set axisValues to gridValue's v
            loop valueIndex from 1 to ((the length of axisValues) - 1):
                set fixedValue to the item at valueIndex in axisValues
                set intervalValues to the cad mesh line intervals through ringValues with fixed axis fixedAxis at fixedValue
                loop intervalIndex from 0 to the length of intervalValues:
                    set intervalValue to the item at intervalIndex in intervalValues
                    set spanValue to intervalValue's y - intervalValue's x
                    set insetValue to spanValue * 1e-9
                    if ((cad mesh scalar spanValue is finite) and (spanValue > 0.0)) and (insetValue > 0.0):
                        set fromValue to intervalValue's x + insetValue
                        set toValue to intervalValue's y - insetValue
                        if fromValue < toValue:
                            set fromPoint to the cad mesh vector2 with coordinate fixedAxis at fixedValue and other fromValue
                            set toPoint to the cad mesh vector2 with coordinate fixedAxis at fixedValue and other toValue
                            set constraintResult to the cad constrained constraint from fromPoint to toPoint in domainValue
                            if constraintResult's valid = false:
                                free intervalValues
                                free cad mesh grid lines gridValue
                                return absentValue
                            set insertedCount to insertedCount + (constraintResult's added as a 64 bit integer)
                            if insertedCount > 262144:
                                free intervalValues
                                free cad mesh grid lines gridValue
                                return absentValue
                free intervalValues
        free cad mesh grid lines gridValue
        return @intrinsic("construct", a cad mesh count result, true, insertedCount)

local function the cad mesh corners of constrained {cad constrained triangle2:triangleValue}:
    execute:
        return the cad mesh corners triangleValue's first, triangleValue's second and triangleValue's third

local function cad mesh constrained {cad constrained triangle2:triangleValue} edge {integer:edgeIndex} is constrained:
    execute:
        if edgeIndex = 0:
            return triangleValue's firstConstrained
        if edgeIndex = 1:
            return triangleValue's secondConstrained
        return triangleValue's thirdConstrained

# TriangleRefinement: kind 0 complete, 1 constrained boundary, 2 interior point.
local function the cad mesh refinement of {cad constrained triangle2:triangleValue} on {cad surface:surfaceValue} within angle {a 64 bit floating-point number:maxAngle} and tolerance {a 64 bit floating-point number:linearTolerance} caching {a pointer to a cad mesh parameter cache:cacheValue}:
    execute:
        set cornerValues to the cad mesh corners of constrained triangleValue
        set completeValue to @intrinsic("construct", a cad mesh refinement, true, 0, the cad zero vector2)
        if cad mesh corners cornerValues are degenerate:
            return completeValue
        set edgeAngles to an empty list of a 64 bit floating-point number
        loop edgeIndex from 0 to 3:
            set parameterValues to the cad mesh edge parameters of cornerValues from (the cad mesh edge start edgeIndex) to (the cad mesh edge end edgeIndex)
            set angleResult to the cad mesh cached normal angle on surfaceValue through parameterValues in cacheValue
            free parameterValues
            if angleResult's valid = false:
                free edgeAngles
                return @intrinsic("construct", a cad mesh refinement, false, 0, the cad zero vector2)
            append angleResult's value to edgeAngles
        loop edgeIndex from 0 to 3:
            if (cad mesh angle (the item at edgeIndex in edgeAngles) exceeds maxAngle) and (cad mesh constrained triangleValue edge edgeIndex is constrained):
                if (the cad mesh chord of cornerValues from (the cad mesh edge start edgeIndex) to (the cad mesh edge end edgeIndex) on surfaceValue) > linearTolerance:
                    free edgeAngles
                    return @intrinsic("construct", a cad mesh refinement, true, 1, the cad zero vector2)
        set splitEdge to -1
        set splitKey to 0 as a 64 bit integer
        loop edgeIndex from 0 to 3:
            set angleValue to the item at edgeIndex in edgeAngles
            if cad mesh angle angleValue exceeds maxAngle:
                if (the cad mesh chord of cornerValues from (the cad mesh edge start edgeIndex) to (the cad mesh edge end edgeIndex) on surfaceValue) > linearTolerance:
                    set candidateKey to the cad mesh total order key of angleValue
                    if (splitEdge < 0) or (candidateKey >= splitKey):
                        set splitEdge to edgeIndex
                        set splitKey to candidateKey
        free edgeAngles
        if splitEdge >= 0:
            set fromIndex to the cad mesh edge start splitEdge
            set toIndex to the cad mesh edge end splitEdge
            set middlePoint to the cad mesh middle of cornerValues from fromIndex to toIndex
            if cad mesh uv middlePoint is near uv (the cad mesh corner ((3 - fromIndex) - toIndex) of cornerValues):
                return completeValue
            return @intrinsic("construct", a cad mesh refinement, true, 2, middlePoint)
        set triangleAngle to the cad mesh cached triangle angle on surfaceValue over cornerValues in cacheValue
        if triangleAngle's valid = false:
            return @intrinsic("construct", a cad mesh refinement, false, 0, the cad zero vector2)
        if (cad mesh angle triangleAngle's value exceeds maxAngle) = false:
            return completeValue
        return @intrinsic("construct", a cad mesh refinement, true, 2, the cad mesh centroid of cornerValues)

class:
    patterns:
        [a|] cad mesh refinement candidate
    members:
        candidatePoint as a cad vector2
        triangleCorners as a cad mesh corners

local function the cad mesh constrained fill of {a pointer to a list:ringValues} on {cad surface:surfaceValue} of face {cad face:faceValue} within angle {a 64 bit floating-point number:maxAngle} and tolerance {a 64 bit floating-point number:linearTolerance}:
    execute:
        set outputMesh to an empty cad mesh
        set parameterRings to an empty list of the type of (an empty list of a cad vector2)
        loop ringIndex from 0 to the length of ringValues:
            append (the cad mesh uv ring of (the item at ringIndex in ringValues)) to parameterRings
        set domainResult to the cad constrained mesh of rings parameterRings
        if domainResult's valid = false:
            cad mesh release parameter rings parameterRings
            free cad constrained mesh result domainResult
            return @intrinsic("construct", a cad mesh result, false, outputMesh)
        set domainValue to domainResult's value
        set seededResult to the cad mesh seeded grid of (the address of domainValue) on surfaceValue through parameterRings within angle maxAngle
        cad mesh release parameter rings parameterRings
        if seededResult's valid = false:
            free cad constrained mesh result domainResult
            return @intrinsic("construct", a cad mesh result, false, outputMesh)
        set additions to seededResult's value
        set pinValues to an empty list of a cad mesh boundary point
        loop ringIndex from 0 to the length of ringValues:
            set ringValue to the item at ringIndex in ringValues
            loop pointIndex from 0 to the length of ringValue:
                append (the item at pointIndex in ringValue) to pinValues
        set flat to surfaceValue's kind = 0
        set normalCache to an empty cad mesh parameter cache
        set completeTriangles to an empty list of a cad constrained triangle2
        set completed to false
        set failed to false
        set passIndex to 0
        loop while ((completed = false) and (failed = false)) and (passIndex < 128):
            set triangleValues to the cad constrained triangles of domainValue
            if (the length of triangleValues) = 0:
                free triangleValues
                set failed to true
            else if flat:
                free completeTriangles
                set completeTriangles to triangleValues
                set completed to true
            else:
                set candidateValues to an empty list of a cad mesh refinement candidate
                set candidatesWithinTolerance to true
                set triangleIndex to 0
                loop while (failed = false) and (triangleIndex < (the length of triangleValues)):
                    set triangleValue to the item at triangleIndex in triangleValues
                    set refinementValue to the cad mesh refinement of triangleValue on surfaceValue within angle maxAngle and tolerance linearTolerance caching (the address of normalCache)
                    if (refinementValue's valid = false) or (refinementValue's kind = 1):
                        set failed to true
                    else if refinementValue's kind = 2:
                        set cornerValues to the cad mesh corners of constrained triangleValue
                        if (cad mesh corners cornerValues on surfaceValue are within linearTolerance) = false:
                            set candidatesWithinTolerance to false
                        append (@intrinsic("construct", a cad mesh refinement candidate, refinementValue's candidatePoint, cornerValues)) to candidateValues
                    set triangleIndex to triangleIndex + 1
                if failed:
                    free triangleValues
                    free candidateValues
                else if (the length of candidateValues) = 0:
                    free completeTriangles
                    set completeTriangles to triangleValues
                    set completed to true
                    free candidateValues
                else:
                    set uniqueCandidates to an empty list of a cad mesh refinement candidate
                    set uniqueKeys to a cad pair index with room for (the length of candidateValues) entries
                    loop candidateIndex from 0 to the length of candidateValues:
                        set candidateValue to the item at candidateIndex in candidateValues
                        set firstKey to the cad mesh key bits of candidateValue's candidatePoint's x
                        set secondKey to the cad mesh key bits of candidateValue's candidatePoint's y
                        if (the cad pair value for key firstKey and secondKey in uniqueKeys) < 0:
                            put cad pair value candidateIndex for key firstKey and secondKey in uniqueKeys
                            append candidateValue to uniqueCandidates
                    free candidateValues
                    set insertedCount to 0
                    set candidateIndex to 0
                    loop while (failed = false) and (candidateIndex < (the length of uniqueCandidates)):
                        set candidateValue to the item at candidateIndex in uniqueCandidates
                        if additions >= 262144:
                            set failed to true
                        else:
                            set insertion to the cad constrained insertion of point candidateValue's candidatePoint into (the address of domainValue)
                            if insertion's valid = false:
                                set failed to true
                            else if insertion's inserted:
                                set additions to additions + 1
                                set insertedCount to insertedCount + 1
                            else:
                                set cornerValues to candidateValue's triangleCorners
                                set centrePoint to the cad mesh centroid of cornerValues
                                set added to false
                                if (cad mesh uv centrePoint is near uv candidateValue's candidatePoint) = false:
                                    set centreInsertion to the cad constrained insertion of point centrePoint into (the address of domainValue)
                                    if centreInsertion's valid = false:
                                        set failed to true
                                    else:
                                        set added to centreInsertion's inserted
                                set weightIndex to 0
                                loop while ((added = false) and (failed = false)) and (weightIndex < 3):
                                    set offCentre to the cad mesh weighted point of cornerValues with 0.2, 0.3 and 0.5
                                    if weightIndex = 1:
                                        set offCentre to the cad mesh weighted point of cornerValues with 0.2, 0.5 and 0.3
                                    if weightIndex = 2:
                                        set offCentre to the cad mesh weighted point of cornerValues with 0.5, 0.2 and 0.3
                                    set offInsertion to the cad constrained insertion of point offCentre into (the address of domainValue)
                                    if offInsertion's valid = false:
                                        set failed to true
                                    else:
                                        set added to offInsertion's inserted
                                    set weightIndex to weightIndex + 1
                                if added and (failed = false):
                                    set additions to additions + 1
                                    set insertedCount to insertedCount + 1
                        set candidateIndex to candidateIndex + 1
                    free uniqueCandidates
                    if failed:
                        free triangleValues
                    else if insertedCount = 0:
                        if candidatesWithinTolerance:
                            free completeTriangles
                            set completeTriangles to triangleValues
                            set completed to true
                        else:
                            free triangleValues
                            set failed to true
                    else:
                        free triangleValues
            set passIndex to passIndex + 1
        if completed = false:
            free completeTriangles
            free pinValues
            free cad mesh parameter cache (the address of normalCache)
            free cad constrained mesh result domainResult
            return @intrinsic("construct", a cad mesh result, false, outputMesh)
        set pointCache to an empty cad mesh parameter cache
        loop triangleIndex from 0 to the length of completeTriangles:
            set cornerValues to the cad mesh corners of constrained (the item at triangleIndex in completeTriangles)
            if (cad mesh corners cornerValues are degenerate) = false:
                emit cad mesh cached cornerValues on surfaceValue of face faceValue pinned by pinValues with normals (the address of normalCache) and points (the address of pointCache) into (the address of outputMesh)
        free completeTriangles
        free pinValues
        free cad mesh parameter cache (the address of normalCache)
        free cad mesh parameter cache (the address of pointCache)
        free cad constrained mesh result domainResult
        return @intrinsic("construct", a cad mesh result, (the cad triangle count of outputMesh) > 0, outputMesh)

local function cad mesh release parameter rings {a pointer to a list:ringValues}:
    execute:
        loop ringIndex from 0 to the length of ringValues:
            free (the item at ringIndex in ringValues)
        free ringValues


local function the cad mesh whole surface domain of {cad face:faceValue} in {cad body:bodyValue} on {cad surface:surfaceValue}:
    execute:
        set domainValue to the cad mesh surface domain of surfaceValue
        if domainValue's valid = false:
            return domainValue
        set validDomain to true
        loop axisIndex from 0 to 2:
            set lowValue to the cad mesh lower limit of domainValue on axis axisIndex
            set highValue to the cad mesh upper limit of domainValue on axis axisIndex
            if (((cad mesh scalar lowValue is finite) and (cad mesh scalar highValue is finite)) and (highValue > lowValue)) = false:
                set validDomain to false
        if validDomain = false:
            return no cad mesh domain
        set loopCount to the length of ((faceValue's loops's values))
        set firstUses to an empty list of a cad coedge key
        set hasFirstLoop to false
        if loopCount > 0:
            set loopNode to the cad node pointer for (the item at 0 in ((faceValue's loops's values))) in bodyValue
            if loopNode != (0 as the type of loopNode):
                set loopUses to (@intrinsic("dereference", loopNode))'s coedges's values
                loop useIndex from 0 to the length of loopUses:
                    append (the item at useIndex in loopUses) to firstUses
                set hasFirstLoop to true
        if (surfaceValue's kind = 5) and hasFirstLoop:
            if (loopCount = 1) and ((the length of firstUses) = 4):
                set sideCounts to an empty list of an integer
                loop sideIndex from 0 to 4:
                    append 0 to sideCounts
                set bounded to true
                set uLow to the cad mesh lower limit of domainValue on axis 0
                set uHigh to the cad mesh upper limit of domainValue on axis 0
                set vLow to the cad mesh lower limit of domainValue on axis 1
                set vHigh to the cad mesh upper limit of domainValue on axis 1
                loop coedgeIndex from 0 to 4:
                    if bounded:
                        set coedgeNode to the cad node pointer for (the item at coedgeIndex in firstUses) in bodyValue
                        if coedgeNode = (0 as the type of coedgeNode):
                            set bounded to false
                        else:
                            set coedgeValue to @intrinsic("dereference", coedgeNode)
                            if coedgeValue's pcurve's valid = false:
                                set bounded to false
                            else:
                                set sideResult to the cad rectangle side of (the cad pcurve value of coedgeValue's pcurve) with bounds [[uLow,uHigh],[vLow,vHigh]]
                                if sideResult's valid = false:
                                    set bounded to false
                                else:
                                    replace item at index sideResult's value in sideCounts with ((the item at sideResult's value in sideCounts) + 1)
                if bounded:
                    loop sideIndex from 0 to 4:
                        if (the item at sideIndex in sideCounts) != 1:
                            set bounded to false
                free sideCounts
                if bounded:
                    free firstUses
                    return domainValue
        set seamLoop to false
        if ((surfaceValue's kind = 3) or (surfaceValue's kind = 4)) and hasFirstLoop:
            set useCount to the length of firstUses
            if (loopCount = 1) and (useCount > 0):
                set seamLoop to true
                loop useIndex from 0 to useCount:
                    if seamLoop:
                        set useNode to the cad node pointer for (the item at useIndex in firstUses) in bodyValue
                        if useNode = (0 as the type of useNode):
                            set seamLoop to false
                        else:
                            set useValue to @intrinsic("dereference", useNode)
                            if useValue's pcurve's valid:
                                set seamLoop to false
                            else:
                                set matchCount to 0
                                set firstForward to false
                                set secondForward to false
                                loop candidateIndex from 0 to useCount:
                                    set candidateNode to the cad node pointer for (the item at candidateIndex in firstUses) in bodyValue
                                    if candidateNode != (0 as the type of candidateNode):
                                        set candidateValue to @intrinsic("dereference", candidateNode)
                                        if candidateValue's edge = useValue's edge:
                                            if matchCount = 0:
                                                set firstForward to candidateValue's forward
                                            else if matchCount = 1:
                                                set secondForward to candidateValue's forward
                                            set matchCount to matchCount + 1
                                if (matchCount != 2) or (firstForward = secondForward):
                                    set seamLoop to false
        free firstUses
        if (loopCount > 0) and (seamLoop = false):
            return no cad mesh domain
        set closed to (surfaceValue's kind = 3) or (surfaceValue's kind = 4)
        if surfaceValue's kind = 5:
            set periodicValues to the cad periodicity of surfaceValue's nurbs
            set closed to (the item at 0 in periodicValues) and (the item at 1 in periodicValues)
        if closed = false:
            return no cad mesh domain
        return domainValue

local function the cad mesh domain ring of {cad mesh domain:domainValue}:
    execute:
        set uLow to the cad mesh lower limit of domainValue on axis 0
        set uHigh to the cad mesh upper limit of domainValue on axis 0
        set vLow to the cad mesh lower limit of domainValue on axis 1
        set vHigh to the cad mesh upper limit of domainValue on axis 1
        set ringValue to a list containing (a cad vector2 with x uLow and y vLow)
        append (a cad vector2 with x uHigh and y vLow) to ringValue
        append (a cad vector2 with x uHigh and y vHigh) to ringValue
        append (a cad vector2 with x uLow and y vHigh) to ringValue
        return ringValue

local function the cad mesh scheduled face {cad face key:faceKey} in {cad body:bodyValue} within angle {a 64 bit floating-point number:maxAngle} and tolerance {a 64 bit floating-point number:linearTolerance} among {a pointer to a list:scheduleValues}:
    execute:
        set faceNode to the cad node pointer for faceKey in bodyValue
        if faceNode = (0 as the type of faceNode):
            return no cad mesh result
        set faceValue to @intrinsic("dereference", faceNode)
        set surfaceNode to the cad node pointer for faceValue's surface in bodyValue
        if surfaceNode = (0 as the type of surfaceNode):
            return no cad mesh result
        set surfaceValue to @intrinsic("dereference", surfaceNode)
        set wholeDomain to the cad mesh whole surface domain of faceValue in bodyValue on surfaceValue
        if wholeDomain's valid:
            return the cad mesh whole surface fill of surfaceValue over wholeDomain on face faceValue within angle maxAngle and tolerance linearTolerance
        set periodValues to the cad mesh periods of surfaceValue
        set bandValue to the cad mesh band of faceKey in bodyValue on surfaceValue among scheduleValues within linearTolerance
        if bandValue's valid:
            set holeCount to the length of bandValue's holes
            if ((bandValue's strip = false) and (holeCount = 0)) and ((surfaceValue's kind = 2) or (surfaceValue's kind = 4)):
                set capMesh to the cad mesh singular cap of bandValue on surfaceValue of face faceValue within angle maxAngle
                free cad mesh band bandValue
                return capMesh
            if bandValue's strip and (holeCount = 0):
                set openFixed to (cad mesh periodValues has period on axis (1 - bandValue's varying)) = false
                if bandValue's structured or ((surfaceValue's kind != 5) and openFixed):
                    set stripMesh to the cad mesh band fill of bandValue on surfaceValue of face faceValue within angle maxAngle and tolerance linearTolerance
                    free cad mesh band bandValue
                    return stripMesh
            set seamRing to the cad mesh ring with seams of band bandValue on surfaceValue within angle maxAngle
            if seamRing's valid = false:
                free cad mesh band bandValue
                return no cad mesh result
            set ringValues to an empty list of the type of (an empty list of a cad mesh boundary point)
            append seamRing's values to ringValues
            loop holeIndex from 0 to holeCount:
                append (the item at holeIndex in bandValue's holes) to ringValues
            free bandValue's low
            free bandValue's high
            free bandValue's holes
            align cad mesh rings ringValues with periodValues
            set filledMesh to the cad mesh constrained fill of ringValues on surfaceValue of face faceValue within angle maxAngle and tolerance linearTolerance
            cad mesh release rings ringValues
            return filledMesh
        free cad mesh band bandValue
        set ringsResult to the cad mesh face rings of faceKey in bodyValue on surfaceValue among scheduleValues within linearTolerance
        if ringsResult's valid = false:
            return no cad mesh result
        set filledMesh to the cad mesh constrained fill of ringsResult's values on surfaceValue of face faceValue within angle maxAngle and tolerance linearTolerance
        cad mesh release rings ringsResult's values
        return filledMesh

# mesh::face. The schedule uses the raw request: edge sampling applies
# tessellation::angle itself, while the face consumes the angle unchanged.
function the cad mesh result of {cad face key:faceKey} in {cad body:bodyValue} with maximum angle {a number:requestedAngle} within {a number:requestedTolerance}:
    execute:
        set maxAngle to requestedAngle as a 64 bit floating-point number
        set linearTolerance to requestedTolerance as a 64 bit floating-point number
        set rawTolerance to @intrinsic("construct", a cad tessellation tolerance, maxAngle, linearTolerance, false, 0.0, 0, 0, false)
        set scheduleValues to the cad mesh schedules of bodyValue with tolerance rawTolerance
        set meshResult to the cad mesh scheduled face faceKey in bodyValue within angle maxAngle and tolerance linearTolerance among scheduleValues
        free cad mesh schedules scheduleValues
        return meshResult

function free cad mesh result {cad mesh result:resultValue}:
    replacement:
        set resultValue to a new (the type of resultValue)

# mesh::body is the triangle mesh of tessellate under the same policy.
function the cad mesh of {cad body:bodyValue} with maximum angle {a number:requestedAngle} within {a number:requestedTolerance}:
    execute:
        set displayValue to the cad tessellation of bodyValue with tolerance (a cad tessellation tolerance with maximum angle requestedAngle within requestedTolerance)
        set meshValue to displayValue's mesh
        free cad body mesh displayValue
        return meshValue

function the cad surface properties of {cad mesh:meshValue}:
    execute:
        set absent to @intrinsic("construct", a cad mesh surface properties result, false, a new cad mesh surface properties)
        if (the length of meshValue's positions) = 0:
            return absent
        set reference to the item at 0 in meshValue's positions
        set totalArea to 0.0
        set weightedCentre to the cad zero vector3
        loop triangleIndex from 0 to the length of meshValue's triangles:
            set triangleValue to the item at triangleIndex in meshValue's triangles
            if (((triangleValue's first < 0) or (triangleValue's second < 0)) or (triangleValue's third < 0)) or (((triangleValue's first >= (the length of meshValue's positions)) or (triangleValue's second >= (the length of meshValue's positions))) or (triangleValue's third >= (the length of meshValue's positions))):
                return absent
            set firstPoint to the cad difference of (the item at triangleValue's first in meshValue's positions) and reference
            set secondPoint to the cad difference of (the item at triangleValue's second in meshValue's positions) and reference
            set thirdPoint to the cad difference of (the item at triangleValue's third in meshValue's positions) and reference
            set triangleArea to (the cad length of (the cad cross of (the cad difference of secondPoint and firstPoint) and (the cad difference of thirdPoint and firstPoint))) * 0.5
            if ((triangleArea >= 0.0) and (triangleArea <= 1.7976931348623157e308)) = false:
                return absent
            set weightedCentre to the cad sum of weightedCentre and ((the cad sum of (the cad sum of firstPoint and secondPoint) and thirdPoint) scaled by (triangleArea / 3.0))
            set totalArea to totalArea + triangleArea
        if ((totalArea > 0.0) and (totalArea <= 1.7976931348623157e308)) = false:
            return absent
        set centroidValue to the cad sum of reference and (weightedCentre cad divided by totalArea)
        set propertiesValue to @intrinsic("construct", a cad mesh surface properties, totalArea, centroidValue)
        return @intrinsic("construct", a cad mesh surface properties result, true, propertiesValue)

function the cad surface area of {cad mesh:meshValue}:
    execute:
        set propertiesResult to the cad surface properties of meshValue
        set areaValue to 0.0
        if propertiesResult's valid:
            set areaValue to propertiesResult's value's area
        return @intrinsic("construct", a cad mesh scalar result, propertiesResult's valid, areaValue)

class:
    patterns:
        [a|] cad mesh eigenpair
    members:
        moment as a 64 bit floating-point number
        direction as a cad vector3

class:
    patterns:
        [a|] cad mesh principal axes
    members:
        moments as a cad vector3
        firstDirection as a cad vector3
        secondDirection as a cad vector3
        thirdDirection as a cad vector3

local function cad mesh swap eigenpairs {cad mesh eigenpair:firstPair} and {cad mesh eigenpair:secondPair}:
    execute:
        set outputPairs to a list containing secondPair
        append firstPair to outputPairs
        return outputPairs

local function the cad mesh principal axes for tensor {a pointer to a list:sourceMatrix}:
    execute:
        set matrixValues to an empty list of a 64 bit floating-point number
        set vectorValues to an empty list of a 64 bit floating-point number
        loop matrixIndex from 0 to 9:
            append (the item at matrixIndex in sourceMatrix) to matrixValues
            set identityValue to 0.0
            if (the remainder of matrixIndex divided by 4) = 0:
                set identityValue to 1.0
            append identityValue to vectorValues
        set active to true
        loop iterationIndex from 0 to 24:
            if active:
                set p to 0
                set q to 1
                set largest to the absolute value of (the item at 1 in matrixValues)
                set candidate to the absolute value of (the item at 2 in matrixValues)
                if candidate >= largest:
                    set p to 0
                    set q to 2
                    set largest to candidate
                set candidate to the absolute value of (the item at 5 in matrixValues)
                if candidate >= largest:
                    set p to 1
                    set q to 2
                    set largest to candidate
                if largest <= 1e-12:
                    set active to false
                else:
                    set pp to (p * 3) + p
                    set pq to (p * 3) + q
                    set qq to (q * 3) + q
                    set angleValue to 0.5 * (@intrinsic("call", "libc", "atan2", a 64 bit floating-point number, 2.0 * (the item at pq in matrixValues), (the item at qq in matrixValues) - (the item at pp in matrixValues)))
                    set sineValue to the sine of angleValue
                    set cosineValue to the cosine of angleValue
                    loop rowIndex from 0 to 3:
                        set rowP to (rowIndex * 3) + p
                        set rowQ to (rowIndex * 3) + q
                        set oldP to the item at rowP in matrixValues
                        set oldQ to the item at rowQ in matrixValues
                        replace item at index rowP in matrixValues with ((cosineValue * oldP) - (sineValue * oldQ))
                        replace item at index rowQ in matrixValues with ((sineValue * oldP) + (cosineValue * oldQ))
                    loop columnIndex from 0 to 3:
                        set columnP to (p * 3) + columnIndex
                        set columnQ to (q * 3) + columnIndex
                        set oldP to the item at columnP in matrixValues
                        set oldQ to the item at columnQ in matrixValues
                        replace item at index columnP in matrixValues with ((cosineValue * oldP) - (sineValue * oldQ))
                        replace item at index columnQ in matrixValues with ((sineValue * oldP) + (cosineValue * oldQ))
                    loop rowIndex from 0 to 3:
                        set rowP to (rowIndex * 3) + p
                        set rowQ to (rowIndex * 3) + q
                        set oldP to the item at rowP in vectorValues
                        set oldQ to the item at rowQ in vectorValues
                        replace item at index rowP in vectorValues with ((cosineValue * oldP) - (sineValue * oldQ))
                        replace item at index rowQ in vectorValues with ((sineValue * oldP) + (cosineValue * oldQ))
        set firstMoment to the maximum of (the item at 0 in matrixValues) and 0.0
        set secondMoment to the maximum of (the item at 4 in matrixValues) and 0.0
        set thirdMoment to the maximum of (the item at 8 in matrixValues) and 0.0
        set firstAxis to a cad vector3 with x (the item at 0 in vectorValues), y (the item at 3 in vectorValues) and z (the item at 6 in vectorValues)
        set secondAxis to a cad vector3 with x (the item at 1 in vectorValues), y (the item at 4 in vectorValues) and z (the item at 7 in vectorValues)
        set thirdAxis to a cad vector3 with x (the item at 2 in vectorValues), y (the item at 5 in vectorValues) and z (the item at 8 in vectorValues)
        set firstPair to @intrinsic("construct", a cad mesh eigenpair, firstMoment, firstAxis)
        set secondPair to @intrinsic("construct", a cad mesh eigenpair, secondMoment, secondAxis)
        set thirdPair to @intrinsic("construct", a cad mesh eigenpair, thirdMoment, thirdAxis)
        if firstPair's moment > secondPair's moment:
            set swappedPairs to cad mesh swap eigenpairs firstPair and secondPair
            set firstPair to the item at 0 in swappedPairs
            set secondPair to the item at 1 in swappedPairs
            free swappedPairs
        if secondPair's moment > thirdPair's moment:
            set swappedPairs to cad mesh swap eigenpairs secondPair and thirdPair
            set secondPair to the item at 0 in swappedPairs
            set thirdPair to the item at 1 in swappedPairs
            free swappedPairs
        if firstPair's moment > secondPair's moment:
            set swappedPairs to cad mesh swap eigenpairs firstPair and secondPair
            set firstPair to the item at 0 in swappedPairs
            set secondPair to the item at 1 in swappedPairs
            free swappedPairs
        set momentValues to a cad vector3 with x firstPair's moment, y secondPair's moment and z thirdPair's moment
        set firstDirection to firstPair's direction
        set secondDirection to secondPair's direction
        set thirdDirection to thirdPair's direction
        if (thirdPair's moment - firstPair's moment) <= ((the maximum of (the absolute value of thirdPair's moment) and 1.0) * 1e-10):
            set firstDirection to the cad x axis
            set secondDirection to the cad y axis
            set thirdDirection to the cad z axis
        free matrixValues
        free vectorValues
        return @intrinsic("construct", a cad mesh principal axes, momentValues, firstDirection, secondDirection, thirdDirection)

local function no cad mesh mass properties:
    execute:
        return @intrinsic("construct", a cad mass properties result, false, a new cad mass properties)

function the cad inertial properties of {cad mesh:meshValue}:
    execute:
        if ((the length of meshValue's positions) = 0) or ((the length of meshValue's triangles) = 0):
            return no cad mesh mass properties
        set referencePoint to the item at 0 in meshValue's positions
        set signedVolume to 0.0
        set centroidNumerator to the cad zero vector3
        set squaredIntegrals to the cad zero vector3
        set productIntegrals to the cad zero vector3
        loop triangleIndex from 0 to the length of meshValue's triangles:
            set triangleValue to the item at triangleIndex in meshValue's triangles
            if (((triangleValue's first < 0) or (triangleValue's second < 0)) or (triangleValue's third < 0)) or (((triangleValue's first >= (the length of meshValue's positions)) or (triangleValue's second >= (the length of meshValue's positions))) or (triangleValue's third >= (the length of meshValue's positions))):
                return no cad mesh mass properties
            set firstPoint to the cad difference of (the item at triangleValue's first in meshValue's positions) and referencePoint
            set secondPoint to the cad difference of (the item at triangleValue's second in meshValue's positions) and referencePoint
            set thirdPoint to the cad difference of (the item at triangleValue's third in meshValue's positions) and referencePoint
            if ((cad firstPoint is finite) and (cad secondPoint is finite)) and (cad thirdPoint is finite) = false:
                return no cad mesh mass properties
            set tetraVolume to (the cad dot of firstPoint and (the cad cross of secondPoint and thirdPoint)) / 6.0
            set signedVolume to signedVolume + tetraVolume
            set vertexSum to the cad sum of (the cad sum of firstPoint and secondPoint) and thirdPoint
            set centroidNumerator's x to centroidNumerator's x + ((tetraVolume * vertexSum's x) / 4.0)
            set centroidNumerator's y to centroidNumerator's y + ((tetraVolume * vertexSum's y) / 4.0)
            set centroidNumerator's z to centroidNumerator's z + ((tetraVolume * vertexSum's z) / 4.0)
            set squareX to (((((firstPoint's x * firstPoint's x) + (secondPoint's x * secondPoint's x)) + (thirdPoint's x * thirdPoint's x)) + (firstPoint's x * secondPoint's x)) + (firstPoint's x * thirdPoint's x)) + (secondPoint's x * thirdPoint's x)
            set squareY to (((((firstPoint's y * firstPoint's y) + (secondPoint's y * secondPoint's y)) + (thirdPoint's y * thirdPoint's y)) + (firstPoint's y * secondPoint's y)) + (firstPoint's y * thirdPoint's y)) + (secondPoint's y * thirdPoint's y)
            set squareZ to (((((firstPoint's z * firstPoint's z) + (secondPoint's z * secondPoint's z)) + (thirdPoint's z * thirdPoint's z)) + (firstPoint's z * secondPoint's z)) + (firstPoint's z * thirdPoint's z)) + (secondPoint's z * thirdPoint's z)
            set squaredIntegrals's x to squaredIntegrals's x + ((tetraVolume * squareX) / 10.0)
            set squaredIntegrals's y to squaredIntegrals's y + ((tetraVolume * squareY) / 10.0)
            set squaredIntegrals's z to squaredIntegrals's z + ((tetraVolume * squareZ) / 10.0)
            set diagonalXY to ((firstPoint's x * firstPoint's y) + (secondPoint's x * secondPoint's y)) + (thirdPoint's x * thirdPoint's y)
            set diagonalYZ to ((firstPoint's y * firstPoint's z) + (secondPoint's y * secondPoint's z)) + (thirdPoint's y * thirdPoint's z)
            set diagonalZX to ((firstPoint's z * firstPoint's x) + (secondPoint's z * secondPoint's x)) + (thirdPoint's z * thirdPoint's x)
            set allXY to (((firstPoint's x + secondPoint's x) + thirdPoint's x) * ((firstPoint's y + secondPoint's y) + thirdPoint's y))
            set allYZ to (((firstPoint's y + secondPoint's y) + thirdPoint's y) * ((firstPoint's z + secondPoint's z) + thirdPoint's z))
            set allZX to (((firstPoint's z + secondPoint's z) + thirdPoint's z) * ((firstPoint's x + secondPoint's x) + thirdPoint's x))
            set productIntegrals's x to productIntegrals's x + ((tetraVolume * (diagonalXY + allXY)) / 20.0)
            set productIntegrals's y to productIntegrals's y + ((tetraVolume * (diagonalYZ + allYZ)) / 20.0)
            set productIntegrals's z to productIntegrals's z + ((tetraVolume * (diagonalZX + allZX)) / 20.0)
        if ((signedVolume != 0.0) and (cad mesh scalar signedVolume is finite)) = false:
            return no cad mesh mass properties
        set localCentroid to centroidNumerator cad divided by signedVolume
        set orientation to 1.0
        if signedVolume < 0.0:
            set orientation to -1.0
        set volumeValue to the absolute value of signedVolume
        set squareValues to squaredIntegrals scaled by orientation
        set productValues to productIntegrals scaled by (the negative of orientation)
        set localMoment to a cad vector3 with x (squareValues's y + squareValues's z), y (squareValues's x + squareValues's z) and z (squareValues's x + squareValues's y)
        set centralXX to localMoment's x - (volumeValue * ((localCentroid's y * localCentroid's y) + (localCentroid's z * localCentroid's z)))
        set centralYY to localMoment's y - (volumeValue * ((localCentroid's x * localCentroid's x) + (localCentroid's z * localCentroid's z)))
        set centralZZ to localMoment's z - (volumeValue * ((localCentroid's x * localCentroid's x) + (localCentroid's y * localCentroid's y)))
        set centralXY to productValues's x + ((volumeValue * localCentroid's x) * localCentroid's y)
        set centralYZ to productValues's y + ((volumeValue * localCentroid's y) * localCentroid's z)
        set centralZX to productValues's z + ((volumeValue * localCentroid's x) * localCentroid's z)
        set centralTensor to a list containing centralXX
        append centralXY to centralTensor
        append centralZX to centralTensor
        append centralXY to centralTensor
        append centralYY to centralTensor
        append centralYZ to centralTensor
        append centralZX to centralTensor
        append centralYZ to centralTensor
        append centralZZ to centralTensor
        set axesValue to the cad mesh principal axes for tensor centralTensor
        free centralTensor
        set centroidValue to the cad sum of referencePoint and localCentroid
        set squaredCentre to the cad dot of centroidValue and centroidValue
        set originXX to centralXX + (volumeValue * (squaredCentre - (centroidValue's x * centroidValue's x)))
        set originYY to centralYY + (volumeValue * (squaredCentre - (centroidValue's y * centroidValue's y)))
        set originZZ to centralZZ + (volumeValue * (squaredCentre - (centroidValue's z * centroidValue's z)))
        set originXY to centralXY + (volumeValue * (0.0 - (centroidValue's x * centroidValue's y)))
        set originYZ to centralYZ + (volumeValue * (0.0 - (centroidValue's y * centroidValue's z)))
        set originZX to centralZX + (volumeValue * (0.0 - (centroidValue's z * centroidValue's x)))
        set momentValue to a cad vector3 with x originXX, y originYY and z originZZ
        set productValue to a cad vector3 with x originXY, y originYZ and z originZX
        set radiiValue to a cad vector3 with x (the square root of ((the maximum of originXX and 0.0) / volumeValue)), y (the square root of ((the maximum of originYY and 0.0) / volumeValue)) and z (the square root of ((the maximum of originZZ and 0.0) / volumeValue))
        if (((cad centroidValue is finite) and (cad momentValue is finite)) and (cad axesValue's moments is finite)) and ((cad productValue is finite) and (cad radiiValue is finite)) = false:
            return no cad mesh mass properties
        set propertiesValue to @intrinsic("construct", a cad mass properties, volumeValue, centroidValue, momentValue, axesValue's firstDirection, axesValue's secondDirection, axesValue's thirdDirection, axesValue's moments, productValue, radiiValue)
        return @intrinsic("construct", a cad mass properties result, true, propertiesValue)

function the cad mass properties of {cad mesh:meshValue}:
    execute:
        return the cad inertial properties of meshValue


# One policy drives face, edge, construction-line and silhouette sampling.
class:
    patterns:
        [a|] cad tessellation tolerance
    members:
        angle as a 64 bit floating-point number
        linear as a 64 bit floating-point number
        chordalValid as a boolean
        chordal as a 64 bit floating-point number
        uIsolines as an integer
        vIsolines as an integer
        planarIsolines as a boolean

class:
    patterns:
        [a|] cad edge mesh
    members:
        edge as a cad edge key
        parameters
        positions
        owner as a pointer to an integer
    retain:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 2147483647:
                @intrinsic("call", "libc", "abort", nothing)
            store (references + 1) at storageOwner
    release:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 1:
                free (the parameters of @intrinsic("lifecycle value"))
                free (the positions of @intrinsic("lifecycle value"))
                @intrinsic("call", "libc", "free", nothing, storageOwner)
            else:
                store (references - 1) at storageOwner

class:
    patterns:
        [a|] cad face polyline
    members:
        face as a cad face key
        positions
        owner as a pointer to an integer
    retain:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 2147483647:
                @intrinsic("call", "libc", "abort", nothing)
            store (references + 1) at storageOwner
    release:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 1:
                free (the positions of @intrinsic("lifecycle value"))
                @intrinsic("call", "libc", "free", nothing, storageOwner)
            else:
                store (references - 1) at storageOwner

class:
    patterns:
        [a|] cad face polylines result
    members:
        valid as a boolean
        values

class:
    patterns:
        [a|] cad body wireframe
    members:
        edges
        isolines
        missingFaces
        owner as a pointer to an integer
    retain:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 2147483647:
                @intrinsic("call", "libc", "abort", nothing)
            store (references + 1) at storageOwner
    release:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 1:
                free (the edges of @intrinsic("lifecycle value"))
                free (the isolines of @intrinsic("lifecycle value"))
                free (the missingFaces of @intrinsic("lifecycle value"))
                @intrinsic("call", "libc", "free", nothing, storageOwner)
            else:
                store (references - 1) at storageOwner

class:
    patterns:
        [a|] cad cone silhouette
    members:
        origin as a cad vector3
        xAxis as a cad vector3
        yAxis as a cad vector3
        axis as a cad vector3
        radius as a 64 bit floating-point number
        slope as a 64 bit floating-point number
        lowV as a 64 bit floating-point number
        highV as a 64 bit floating-point number

class:
    patterns:
        [a|] cad analytic cone face
    members:
        face as a cad face key
        cone as a cad cone silhouette

class:
    patterns:
        [a|] cad analytic cone face result
    members:
        valid as a boolean
        value as a cad analytic cone face

class:
    patterns:
        [a|] cad body mesh
    members:
        mesh as a cad mesh
        triangleFaces
        edges
        isolines
        precision as a 64 bit floating-point number
        missingFaces
        analyticCones
        owner as a pointer to an integer
    retain:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 2147483647:
                @intrinsic("call", "libc", "abort", nothing)
            store (references + 1) at storageOwner
    release:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 1:
                set meshOwner to the owner of (the mesh of @intrinsic("lifecycle value"))
                if meshOwner != (0 as a pointer to an integer):
                    set meshReferences to the value at meshOwner
                    if meshReferences = 1:
                        free ((the mesh of @intrinsic("lifecycle value"))'s positions)
                        free ((the mesh of @intrinsic("lifecycle value"))'s normals)
                        free ((the mesh of @intrinsic("lifecycle value"))'s triangles)
                        @intrinsic("call", "libc", "free", nothing, meshOwner)
                    else:
                        store (meshReferences - 1) at meshOwner
                free (the triangleFaces of @intrinsic("lifecycle value"))
                free (the edges of @intrinsic("lifecycle value"))
                free (the isolines of @intrinsic("lifecycle value"))
                free (the missingFaces of @intrinsic("lifecycle value"))
                free (the analyticCones of @intrinsic("lifecycle value"))
                @intrinsic("call", "libc", "free", nothing, storageOwner)
            else:
                store (references - 1) at storageOwner

function a cad tessellation tolerance with maximum angle {a number:requestedAngle} within {a number:requestedLinear}:
    execute:
        set angleValue to the cad sampling angle for (requestedAngle as a 64 bit floating-point number)
        set linearValue to requestedLinear as a 64 bit floating-point number
        if ((linearValue > 0.0) and ((the absolute value of linearValue) <= 1.7976931348623157e308)) = false:
            set linearValue to 1e-9
        return @intrinsic("construct", a cad tessellation tolerance, angleValue, linearValue, false, 0.0, 0, 0, false)

function {cad tessellation tolerance:value} with chordal cad deflection {a number:requestedDeflection}:
    execute:
        set resultValue to value
        set deflectionValue to requestedDeflection as a 64 bit floating-point number
        set resultValue's chordalValid to (deflectionValue > 0.0) and ((the absolute value of deflectionValue) <= 1.7976931348623157e308)
        set resultValue's chordal to deflectionValue
        return resultValue

function {cad tessellation tolerance:value} with {integer:requestedCount} cad isolines:
    execute:
        set resultValue to value
