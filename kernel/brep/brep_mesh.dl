local function the cad silhouette grid point of {cad vector3:pointValue} relative to {cad vector3:originValue} within {a 64 bit floating-point number:precisionValue}:
    execute:
        return @intrinsic("construct", a cad silhouette grid point, the cad silhouette grid coordinate of pointValue's x from originValue's x within precisionValue, the cad silhouette grid coordinate of pointValue's y from originValue's y within precisionValue, the cad silhouette grid coordinate of pointValue's z from originValue's z within precisionValue)

local function cad silhouette grid point {cad silhouette grid point:left} follows {cad silhouette grid point:right}:
    execute:
        if left's x != right's x:
            return left's x > right's x
        if left's y != right's y:
            return left's y > right's y
        return left's z > right's z

# Exact interning of a two-word key; counter slot selects the table's id space.
local function the cad silhouette identity of {a 64 bit integer:firstKey} and {a 64 bit integer:secondKey} in {cad pair index:table} counting slot {integer:counterIndex} among {a pointer to a list:counterValues}:
    execute:
        set existing to the cad pair value for key firstKey and secondKey in table
        if existing >= 0:
            return existing
        set created to the item at counterIndex in counterValues
        put cad pair value created for key firstKey and secondKey in table
        replace item at index counterIndex in counterValues with (created + 1)
        return created

local function the cad silhouette identity of grid point {cad silhouette grid point:pointValue} in {a pointer to a cad silhouette side tables:tables}:
