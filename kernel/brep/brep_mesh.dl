# SPDX-License-Identifier: MPL-2.0
# Native import surface for src/brep/mesh.rs at
# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
# Edges are sampled once into shared schedules; every face is triangulated in
# its surface parameter domain from those schedules and lifted to world space.
# Mesh values share owned stores; explicit free releases a share.
import kernel/brep/brep_mass.dl
import kernel/planar/constrained2.dl
import kernel/planar/triangulate2.dl
import kernel/planar/arrangement2.dl
import kernel/planar/tessellation.dl
import kernel/core/pair_index.dl
import kernel/brep/brep_place.dl
import kernel/space/planar3.dl
import kernel/api/types.dl

class:
    patterns:
        [a|] cad mesh scalar result
    members:
        valid as a boolean
        value as a 64 bit floating-point number

class:
    patterns:
        [a|] cad mesh surface properties
    members:
        area as a 64 bit floating-point number
        centroid as a cad vector3

class:
    patterns:
        [a|] cad mesh surface properties result
    members:
        valid as a boolean
        value as a cad mesh surface properties


class:
    patterns:
        [a|] cad mesh result
    members:
        valid as a boolean
        value as a cad mesh


function the cad triangle count of {cad mesh:meshValue}:
    execute:
        return the length of meshValue's triangles

function cad {cad mesh:meshValue} is empty:
    execute:
        return (the length of meshValue's triangles) = 0

local function cad mesh append triangle from {cad vector3:firstPoint} through {cad vector3:secondPoint} to {cad vector3:thirdPoint} with normals {cad vector3:firstNormal} {cad vector3:secondNormal} {cad vector3:thirdNormal} into {a pointer to a cad mesh:meshValue}:
    execute:
        set baseIndex to the length of the positions of meshValue
        append firstPoint to (the positions of meshValue)
        append secondPoint to (the positions of meshValue)
        append thirdPoint to (the positions of meshValue)
        append firstNormal to (the normals of meshValue)
        append secondNormal to (the normals of meshValue)
        append thirdNormal to (the normals of meshValue)
        append (@intrinsic("construct", a cad mesh triangle, baseIndex, baseIndex + 1, baseIndex + 2)) to (the triangles of meshValue)

function absorb cad mesh {cad mesh:sourceMesh} into {a pointer to a cad mesh:destinationMesh}:
    execute:
        set offset to the length of the positions of destinationMesh
        loop positionIndex from 0 to the length of sourceMesh's positions:
            append (the item at positionIndex in sourceMesh's positions) to (the positions of destinationMesh)
        loop normalIndex from 0 to the length of sourceMesh's normals:
            append (the item at normalIndex in sourceMesh's normals) to (the normals of destinationMesh)
        loop triangleIndex from 0 to the length of sourceMesh's triangles:
            set triangleValue to the item at triangleIndex in sourceMesh's triangles
            append (@intrinsic("construct", a cad mesh triangle, triangleValue's first + offset, triangleValue's second + offset, triangleValue's third + offset)) to (the triangles of destinationMesh)


class:
    patterns:
        [a|] cad mesh boundary point
    members:
        parameters as a cad vector2
        position as a cad vector3

class:
    patterns:
        [a|] cad mesh periods
    members:
        uPeriodic as a boolean
        uPeriod as a 64 bit floating-point number
        vPeriodic as a boolean
        vPeriod as a 64 bit floating-point number

class:
    patterns:
        [a|] cad mesh flag result
    members:
        valid as a boolean
        value as a boolean

class:
    patterns:
        [a|] cad mesh coedge geometry
    members:
        valid as a boolean
        surface as the type of (the cad surface of (the cad xy plane))
        hasPcurve as a boolean
        pcurve as the type of (the cad curve2 of (a cad line2 from the cad zero vector2 to the cad zero vector2))

class:
    patterns:
        [a|] cad mesh closest parameters
    members:
        valid as a boolean
        pcurveParameter as a 64 bit floating-point number
        uv as a cad vector2
        measure as a 64 bit floating-point number

class:
    patterns:
        [a|] cad mesh samples result
    members:
        valid as a boolean
        values as the type of (an empty list of a cad edge sample)

class:
    patterns:
        [a|] cad mesh scalars result
    members:
        valid as a boolean
        values as the type of (an empty list of a 64 bit floating-point number)

class:
    patterns:
        [a|] cad mesh edge schedule
    members:
        edge as a cad edge key
        valid as a boolean
        edgeSamples as the type of (an empty list of a cad edge sample)

class:
    patterns:
        [a|] cad mesh points result
    members:
        valid as a boolean
        values as the type of (an empty list of a cad mesh boundary point)

class:
    patterns:
        [a|] cad mesh rings result
    members:
        valid as a boolean
        values as the type of (an empty list of the type of (an empty list of a cad mesh boundary point))

class:
    patterns:
        [a|] cad mesh vector2 result
    members:
        valid as a boolean
        value as a cad vector2

# Binary64 policies shared by every sampling stage of the source.
local function cad mesh scalar {a 64 bit floating-point number:value} is finite:
    execute:
        return (the absolute value of value) <= 1.7976931348623157e308

local function the cad mesh total order key of {a 64 bit floating-point number:value}:
    execute:
        set bits to the value at ((the address of value) as a pointer to a 64 bit integer)
        if bits < 0:
            return bits bitwise xor (9223372036854775807 as a 64 bit integer)
        return bits

local function cad mesh sign of {a 64 bit floating-point number:value} is positive:
    execute:
        set bits to the value at ((the address of value) as a pointer to a 64 bit integer)
        return bits >= 0

local function cad mesh {a 64 bit floating-point number:left} precedes {a 64 bit floating-point number:right}:
    execute:
        return (the cad mesh total order key of left) < (the cad mesh total order key of right)

local function cad mesh parameter {a 64 bit floating-point number:firstValue} is near {a 64 bit floating-point number:secondValue}:
    execute:
        set scaleValue to the maximum of (the maximum of (the absolute value of firstValue) and (the absolute value of secondValue)) and 1.0
        return (the absolute value of (firstValue - secondValue)) <= (2.842170943040401e-14 * scaleValue)

local function cad mesh uv {cad vector2:firstPoint} is near uv {cad vector2:secondPoint}:
    execute:
        set scaleValue to the maximum of 1.0 and (the absolute value of firstPoint's x)
        set scaleValue to the maximum of scaleValue and (the absolute value of firstPoint's y)
        set scaleValue to the maximum of scaleValue and (the absolute value of secondPoint's x)
        set scaleValue to the maximum of scaleValue and (the absolute value of secondPoint's y)
        set gapValue to @intrinsic("call", "libc", "hypot", a 64 bit floating-point number, firstPoint's x - secondPoint's x, firstPoint's y - secondPoint's y)
        return gapValue <= (1.4210854715202004e-14 * scaleValue)

local function cad mesh angle {a 64 bit floating-point number:value} exceeds {a 64 bit floating-point number:limit}:
    execute:
        if (cad mesh scalar value is finite) = false:
            return true
        set scaleValue to the maximum of (the maximum of (the absolute value of value) and (the absolute value of limit)) and 1.0
        return value > (limit + (1.4210854715202004e-14 * scaleValue))

local function the cad mesh euclidean remainder of {a 64 bit floating-point number:value} by {a 64 bit floating-point number:period}:
    execute:
        set remainderValue to the remainder of value divided by period
        if remainderValue < 0.0:
            return remainderValue + (the absolute value of period)
        return remainderValue

local function the cad mesh unwound {a 64 bit floating-point number:value} near {a 64 bit floating-point number:previous} with period {a 64 bit floating-point number:period}:
    execute:
        return value + (period * (the rounded value of ((previous - value) / period)))

# Rust saturating usize arithmetic; every guarded count is nonnegative.
local function the cad mesh saturating product of {a 64 bit integer:left} and {a 64 bit integer:right}:
    execute:
        if (left = 0) or (right = 0):
            return 0 as a 64 bit integer
        if left > (9223372036854775807 / right):
            return 9223372036854775807 as a 64 bit integer
        return left * right

local function the cad mesh cell count of {a 64 bit floating-point number:value}:
    execute:
        if (value > 0.0) = false:
            return 0 as a 64 bit integer
        if value >= 9.223372036854775807e18:
            return 9223372036854775807 as a 64 bit integer
        return value as a 64 bit integer

local function the cad mesh coordinate {integer:axisIndex} of {cad vector2:pointValue}:
    execute:
        if axisIndex = 0:
            return pointValue's x
        return pointValue's y

local function the cad mesh vector2 {cad vector2:pointValue} with coordinate {integer:axisIndex} set to {a 64 bit floating-point number:coordinateValue}:
    execute:
        set resultValue to pointValue
        if axisIndex = 0:
            set resultValue's x to coordinateValue
        else:
            set resultValue's y to coordinateValue
        return resultValue

local function the cad mesh vector2 with coordinate {integer:axisIndex} at {a 64 bit floating-point number:axisValue} and other {a 64 bit floating-point number:otherValue}:
    execute:
        if axisIndex = 0:
            return a cad vector2 with x axisValue and y otherValue
        return a cad vector2 with x otherValue and y axisValue

local function the cad mesh parameter {integer:axisIndex} of {cad mesh boundary point:pointValue}:
    execute:
        return the cad mesh coordinate axisIndex of pointValue's parameters

local function the cad mesh boundary point {cad mesh boundary point:pointValue} with parameter {integer:axisIndex} set to {a 64 bit floating-point number:coordinateValue}:
    execute:
        set resultValue to pointValue
        set resultValue's parameters to the cad mesh vector2 pointValue's parameters with coordinate axisIndex set to coordinateValue
        return resultValue

local function the cad mesh point on {cad surface:surfaceValue} at {cad vector2:parameters}:
    execute:
        return the cad point on surfaceValue at parameters parameters's x and parameters's y

local function the cad mesh periods of {cad surface:surfaceValue}:
    execute:
        set tauValue to 6.283185307179586
        if surfaceValue's kind = 0:
            return @intrinsic("construct", a cad mesh periods, false, 0.0, false, 0.0)
        if surfaceValue's kind = 4:
            return @intrinsic("construct", a cad mesh periods, true, tauValue, true, tauValue)
        if surfaceValue's kind = 5:
            set domainValue to the cad domain of surfaceValue's nurbs
            set periodicValues to the cad periodicity of surfaceValue's nurbs
            set uSpan to domainValue's u's end - domainValue's u's start
            set vSpan to domainValue's v's end - domainValue's v's start
            return @intrinsic("construct", a cad mesh periods, the item at 0 in periodicValues, uSpan, the item at 1 in periodicValues, vSpan)
        return @intrinsic("construct", a cad mesh periods, true, tauValue, false, 0.0)

local function cad mesh {cad mesh periods:periodValues} has period on axis {integer:axisIndex}:
    execute:
        if axisIndex = 0:
            return periodValues's uPeriodic
        return periodValues's vPeriodic

local function the cad mesh period of {cad mesh periods:periodValues} on axis {integer:axisIndex}:
    execute:
        if axisIndex = 0:
            return periodValues's uPeriod
        return periodValues's vPeriod

local function the cad mesh distance from {cad vector3:firstPoint} to {cad vector3:secondPoint}:
    execute:
        return the cad distance from firstPoint to secondPoint

# Stable insertion sorts reproduce slice::sort_by with f64::total_cmp.
local function sort cad mesh scalars {a pointer to a list:values}:
    execute:
        loop sourceIndex from 1 to the length of values:
            set sourceValue to the item at sourceIndex in values
            set destinationIndex to sourceIndex
            set searching to true
            loop while searching and (destinationIndex > 0):
                set previousValue to the item at (destinationIndex - 1) in values
                if cad mesh sourceValue precedes previousValue:
                    replace item at index destinationIndex in values with previousValue
                    set destinationIndex to destinationIndex - 1
                else:
                    set searching to false
            replace item at index destinationIndex in values with sourceValue

local function sort cad mesh boundary points {a pointer to a list:pointValues} along axis {integer:axisIndex}:
    execute:
        loop sourceIndex from 1 to the length of pointValues:
            set sourceValue to the item at sourceIndex in pointValues
            set sourceKey to the cad mesh parameter axisIndex of sourceValue
            set destinationIndex to sourceIndex
            set searching to true
            loop while searching and (destinationIndex > 0):
                set previousValue to the item at (destinationIndex - 1) in pointValues
                if cad mesh sourceKey precedes (the cad mesh parameter axisIndex of previousValue):
                    replace item at index destinationIndex in pointValues with previousValue
                    set destinationIndex to destinationIndex - 1
                else:
                    set searching to false
            replace item at index destinationIndex in pointValues with sourceValue

# Vec::dedup_by(parameter_value_near) after a total-order sort.
local function the cad mesh distinct sorted scalars from {a pointer to a list:sourceValues}:
    execute:
        sort cad mesh scalars sourceValues
        set outputValues to an empty list of a 64 bit floating-point number
        loop sourceIndex from 0 to the length of sourceValues:
            set sourceValue to the item at sourceIndex in sourceValues
            if (the length of outputValues) = 0:
                append sourceValue to outputValues
            else if (cad mesh parameter sourceValue is near (the last item of outputValues)) = false:
                append sourceValue to outputValues
        return outputValues

local function the cad mesh copy of boundary points {a pointer to a list:pointValues}:
    execute:
        set outputPoints to an empty list of a cad mesh boundary point
        loop pointIndex from 0 to the length of pointValues:
            append (the item at pointIndex in pointValues) to outputPoints
        return outputPoints

local function the cad mesh copy of rings {a pointer to a list:ringValues}:
    execute:
        set outputRings to an empty list of the type of (an empty list of a cad mesh boundary point)
        loop ringIndex from 0 to the length of ringValues:
            append (the cad mesh copy of boundary points (the item at ringIndex in ringValues)) to outputRings
        return outputRings

local function cad mesh release rings {a pointer to a list:ringValues}:
    execute:
        loop ringIndex from 0 to the length of ringValues:
            free (the item at ringIndex in ringValues)
        free ringValues

local function the cad mesh uv ring of {a pointer to a list:pointValues}:
    execute:
        set outputValues to an empty list of a cad vector2
        loop pointIndex from 0 to the length of pointValues:
            append (the item at pointIndex in pointValues)'s parameters to outputValues
        return outputValues

local function no cad mesh result:
    execute:
        return @intrinsic("construct", a cad mesh result, false, an empty cad mesh)

local function no cad mesh points:
    execute:
        return @intrinsic("construct", a cad mesh points result, false, an empty list of a cad mesh boundary point)

local function the cad mesh points result of {a pointer to a list:pointValues}:
    execute:
        return @intrinsic("construct", a cad mesh points result, true, pointValues)

local function no cad mesh rings:
    execute:
        return @intrinsic("construct", a cad mesh rings result, false, an empty list of the type of (an empty list of a cad mesh boundary point))

local function no cad mesh samples:
    execute:
        return @intrinsic("construct", a cad mesh samples result, false, an empty list of a cad edge sample)

# A collapsed spline boundary has no differential normal at the pole.
# Retain its parameter-dependent one-sided limit for display, without
# accepting singularities in the interior of a surface.
local function the cad mesh display normal of {cad surface:surfaceValue} at {cad vector2:parameters}:
    execute:
        set directResult to the cad normal of surfaceValue at parameters parameters's x and parameters's y
        if surfaceValue's kind != 5:
            return directResult
        set domainValue to the cad domain of surfaceValue's nurbs
        set uLow to domainValue's u's start
        set uHigh to domainValue's u's end
        set vLow to domainValue's v's start
        set vHigh to domainValue's v's end
        set onUBoundary to (cad mesh parameter parameters's x is near uLow) or (cad mesh parameter parameters's x is near uHigh)
        set onVBoundary to (cad mesh parameter parameters's y is near vLow) or (cad mesh parameter parameters's y is near vHigh)
        if (onUBoundary = false) and (onVBoundary = false):
            return directResult
        set collapsed to false
        set tangentResult to the cad tangents of surfaceValue at parameters parameters's x and parameters's y
        if tangentResult's valid:
            set uLength to (the cad length of tangentResult's u) * (uHigh - uLow)
            set vLength to (the cad length of tangentResult's v) * (vHigh - vLow)
            if onVBoundary and (uLength <= (vLength * 1e-12)):
                set collapsed to true
            if onUBoundary and (vLength <= (uLength * 1e-12)):
                set collapsed to true
        if directResult's valid and (collapsed = false):
            return directResult
        set inward to parameters
        loop axisIndex from 0 to 2:
            set lowValue to uLow
            set highValue to uHigh
            if axisIndex = 1:
                set lowValue to vLow
                set highValue to vHigh
            set spanValue to highValue - lowValue
            if (cad mesh scalar spanValue is finite) and (spanValue > 0.0):
                set stepValue to spanValue * 1e-6
                set coordinateValue to the cad mesh coordinate axisIndex of parameters
                if cad mesh parameter coordinateValue is near lowValue:
                    set inward to the cad mesh vector2 inward with coordinate axisIndex set to (lowValue + stepValue)
                else if cad mesh parameter coordinateValue is near highValue:
                    set inward to the cad mesh vector2 inward with coordinate axisIndex set to (highValue - stepValue)
        if (inward's x != parameters's x) or (inward's y != parameters's y):
            return the cad normal of surfaceValue at parameters inward's x and inward's y
        return @intrinsic("construct", a cad normalization3, false, the cad zero vector3)

# Normal spread over a parameter list; invalid when any normal is absent.
local function the cad mesh normal angle on {cad surface:surfaceValue} through {a pointer to a list:parameterValues}:
    execute:
        set normalValues to an empty list of a cad vector3
        if (the length of parameterValues) > 0:
            ensure enough capacity in normalValues for (the length of parameterValues) items
        loop parameterIndex from 0 to the length of parameterValues:
            set normalResult to the cad mesh display normal of surfaceValue at (the item at parameterIndex in parameterValues)
            if normalResult's valid = false:
                free normalValues
                return @intrinsic("construct", a cad mesh scalar result, false, 0.0)
            append normalResult's value to normalValues
        set angleValue to the cad maximum direction angle of normalValues
        free normalValues
        return @intrinsic("construct", a cad mesh scalar result, true, angleValue)

local function the cad mesh nine units:
    execute:
        set unitValues to an empty list of a 64 bit floating-point number
        loop unitIndex from 0 to 9:
            append ((unitIndex as a 64 bit floating-point number) * 0.125) to unitValues
        return unitValues

local function the cad mesh five quarter units:
    execute:
        set unitValues to an empty list of a 64 bit floating-point number
        loop unitIndex from 0 to 5:
            append ((unitIndex as a 64 bit floating-point number) * 0.25) to unitValues
        return unitValues

# Coedge geometry is the owning face surface and the optional pcurve.
local function the cad mesh geometry of {cad coedge key:coedgeKey} in {cad body:bodyValue}:
    execute:
        set absentValue to @intrinsic("construct", a cad mesh coedge geometry, false, the cad surface of (the cad xy plane), false, the cad curve2 of (a cad line2 from the cad zero vector2 to the cad zero vector2))
        set coedgeNode to the cad node pointer for coedgeKey in bodyValue
        if coedgeNode = (0 as the type of coedgeNode):
            return absentValue
        set coedgeValue to @intrinsic("dereference", coedgeNode)
        set loopNode to the cad node pointer for coedgeValue's owner in bodyValue
        if loopNode = (0 as the type of loopNode):
            return absentValue
        set loopValue to @intrinsic("dereference", loopNode)
        set faceNode to the cad node pointer for loopValue's owner in bodyValue
        if faceNode = (0 as the type of faceNode):
            return absentValue
        set faceValue to @intrinsic("dereference", faceNode)
        set surfaceNode to the cad node pointer for faceValue's surface in bodyValue
        if surfaceNode = (0 as the type of surfaceNode):
            return absentValue
        return @intrinsic("construct", a cad mesh coedge geometry, true, @intrinsic("dereference", surfaceNode), coedgeValue's pcurve's valid, the cad pcurve value of coedgeValue's pcurve)

local function the cad mesh point on {cad mesh coedge geometry:geometryValue} at pcurve parameter {a 64 bit floating-point number:parameterValue}:
    execute:
        set uvValue to the cad point on geometryValue's pcurve at parameterValue
        return the cad mesh point on geometryValue's surface at uvValue

local function the cad mesh pcurve direction of {cad coedge key:coedgeKey} on {cad edge key:edgeKey} in {cad body:bodyValue}:
    execute:
        set absentValue to @intrinsic("construct", a cad mesh flag result, false, false)
        set edgeNode to the cad node pointer for edgeKey in bodyValue
        if edgeNode = (0 as the type of edgeNode):
            return absentValue
        set edgeValue to @intrinsic("dereference", edgeNode)
        set curveNode to the cad node pointer for edgeValue's curve in bodyValue
        if curveNode = (0 as the type of curveNode):
            return absentValue
        set curveValue to @intrinsic("dereference", curveNode)
        set geometryValue to the cad mesh geometry of coedgeKey in bodyValue
        if (geometryValue's valid = false) or (geometryValue's hasPcurve = false):
            return absentValue
        set forwardDistance to 0.0
        set reversedDistance to 0.0
        set unitValues to the cad mesh five quarter units
        loop unitIndex from 0 to the length of unitValues:
            set unitValue to the item at unitIndex in unitValues
            set edgeParameter to edgeValue's startParameter + ((edgeValue's endParameter - edgeValue's startParameter) * unitValue)
            set positionValue to the cad point on curveValue at edgeParameter
            set forwardDistance to forwardDistance + (the cad mesh distance from positionValue to (the cad mesh point on geometryValue at pcurve parameter unitValue))
            set reversedDistance to reversedDistance + (the cad mesh distance from positionValue to (the cad mesh point on geometryValue at pcurve parameter (1.0 - unitValue)))
        free unitValues
        if (cad mesh scalar forwardDistance is finite) and (cad mesh scalar reversedDistance is finite):
            return @intrinsic("construct", a cad mesh flag result, true, forwardDistance <= reversedDistance)
        set coedgeNode to the cad node pointer for coedgeKey in bodyValue
        if coedgeNode = (0 as the type of coedgeNode):
            return absentValue
        return @intrinsic("construct", a cad mesh flag result, true, (@intrinsic("dereference", coedgeNode))'s forward)

local function cad mesh closest candidate {a 64 bit floating-point number:parameterValue} at {a 64 bit floating-point number:distanceValue} replaces {cad mesh closest parameters:bestValue} preferring {a 64 bit floating-point number:preferredValue}:
    execute:
        if bestValue's valid = false:
            return true
        if distanceValue < bestValue's measure:
            return true
        return (cad mesh parameter distanceValue is near bestValue's measure) and ((the absolute value of (parameterValue - preferredValue)) < (the absolute value of (bestValue's pcurveParameter - preferredValue)))

# The squared distance from a pcurve sample to the requested position.
local function the cad mesh closest sample of {cad mesh coedge geometry:geometryValue} at {a 64 bit floating-point number:parameterValue} to {cad vector3:positionValue}:
    execute:
        set uvValue to the cad point on geometryValue's pcurve at parameterValue
        set distanceValue to the cad mesh distance from positionValue to (the cad mesh point on geometryValue's surface at uvValue)
        set squaredValue to distanceValue * distanceValue
        return @intrinsic("construct", a cad mesh closest parameters, cad mesh scalar distanceValue is finite, parameterValue, uvValue, squaredValue)

local function the cad mesh closest pcurve parameters on {cad mesh coedge geometry:geometryValue} to {cad vector3:positionValue} preferring {a 64 bit floating-point number:preferredValue} within {a 64 bit floating-point number:linearTolerance}:
    execute:
        set absentValue to @intrinsic("construct", a cad mesh closest parameters, false, 0.0, the cad zero vector2, 0.0)
        set parameterValue to preferredValue
        clamp parameterValue between 0.0 and 1.0
        set projected to absentValue
        set searching to true
        set iterationIndex to 0
        loop while searching and (iterationIndex < 12):
            set sampleValue to the cad mesh closest sample of geometryValue at parameterValue to positionValue
            if sampleValue's valid = false:
                return absentValue
            set squaredValue to sampleValue's measure
            if (projected's valid = false) or (squaredValue < projected's measure):
                set projected to sampleValue
            if (the square root of squaredValue) <= linearTolerance:
                set sampleValue's measure to the square root of squaredValue
                return sampleValue
            set uvValue to sampleValue's uv
            set uvTangent to the cad tangent of geometryValue's pcurve at parameterValue
            set tangentResult to the cad tangents of geometryValue's surface at parameters uvValue's x and uvValue's y
            if tangentResult's valid = false:
                return absentValue
            set tangentValue to the cad sum of (tangentResult's u scaled by uvTangent's x) and (tangentResult's v scaled by uvTangent's y)
            set lengthSquared to the cad dot of tangentValue and tangentValue
            if ((cad mesh scalar lengthSquared is finite) = false) or (lengthSquared <= 2.2250738585072014e-308):
                set searching to false
            else:
                set pointValue to the cad mesh point on geometryValue's surface at uvValue
                set correctionValue to (the cad dot of (the cad difference of pointValue and positionValue) and tangentValue) / lengthSquared
                clamp correctionValue between -0.25 and 0.25
                set nextValue to parameterValue - correctionValue
                clamp nextValue between 0.0 and 1.0
                if cad mesh parameter nextValue is near parameterValue:
                    set searching to false
                else:
                    set parameterValue to nextValue
                    set iterationIndex to iterationIndex + 1
        set candidateValues to an empty list of a 64 bit floating-point number
        loop candidateIndex from 0 to 33:
            append ((candidateIndex as a 64 bit floating-point number) / 32.0) to candidateValues
        if geometryValue's pcurve's kind = cad nurbs curve2 kind:
            set curveDomain to the cad domain of geometryValue's pcurve's nurbs
            set spanValue to curveDomain's end - curveDomain's start
            if (cad mesh scalar spanValue is finite) and (spanValue > 0.0):
                set knotValues to the cad knots of geometryValue's pcurve's nurbs
                loop knotIndex from 0 to the length of knotValues:
                    set knotValue to the item at knotIndex in knotValues
                    if (knotValue >= curveDomain's start) and (knotValue <= curveDomain's end):
                        append ((knotValue - curveDomain's start) / spanValue) to candidateValues
        set distinctValues to the cad mesh distinct sorted scalars from candidateValues
        free candidateValues
        set candidateValues to the cad mesh copy of scalars distinctValues
        loop pairIndex from 1 to the length of distinctValues:
            append (0.5 * ((the item at (pairIndex - 1) in distinctValues) + (the item at pairIndex in distinctValues))) to candidateValues
        free distinctValues
        sort cad mesh scalars candidateValues
        set bestValue to projected
        set bestIndex to 0
        loop candidateIndex from 0 to the length of candidateValues:
            set candidateParameter to the item at candidateIndex in candidateValues
            set sampleValue to the cad mesh closest sample of geometryValue at candidateParameter to positionValue
            if sampleValue's valid = false:
                free candidateValues
                return absentValue
            if cad mesh closest candidate candidateParameter at sampleValue's measure replaces bestValue preferring preferredValue:
                set bestValue to sampleValue
                set bestIndex to candidateIndex
        set lowIndex to bestIndex - 1
        if lowIndex < 0:
            set lowIndex to 0
        set highIndex to the minimum of (bestIndex + 1) and ((the length of candidateValues) - 1)
        set lowValue to the item at lowIndex in candidateValues
        set highValue to the item at highIndex in candidateValues
        free candidateValues
        loop sectionIndex from 0 to 56:
            set leftValue to lowValue + ((highValue - lowValue) / 3.0)
            set rightValue to highValue - ((highValue - lowValue) / 3.0)
            set leftSample to the cad mesh closest sample of geometryValue at leftValue to positionValue
            if leftSample's valid = false:
                return absentValue
            set rightSample to the cad mesh closest sample of geometryValue at rightValue to positionValue
            if rightSample's valid = false:
                return absentValue
            if leftSample's measure <= rightSample's measure:
                set highValue to rightValue
            else:
                set lowValue to leftValue
        set finalValues to a list containing lowValue
        append (0.5 * (lowValue + highValue)) to finalValues
        append highValue to finalValues
        loop finalIndex from 0 to 3:
            set candidateParameter to the item at finalIndex in finalValues
            set sampleValue to the cad mesh closest sample of geometryValue at candidateParameter to positionValue
            if sampleValue's valid = false:
                free finalValues
                return absentValue
            if cad mesh closest candidate candidateParameter at sampleValue's measure replaces bestValue preferring preferredValue:
                set bestValue to sampleValue
        free finalValues
        if bestValue's valid:
            set bestValue's measure to the square root of bestValue's measure
        return bestValue

local function the cad mesh copy of scalars {a pointer to a list:sourceValues}:
    execute:
        set outputValues to an empty list of a 64 bit floating-point number
        loop sourceIndex from 0 to the length of sourceValues:
            append (the item at sourceIndex in sourceValues) to outputValues
        return outputValues

# Coedge directions are indexed like the edge's coedge adjacency.
local function the cad mesh direction at {integer:coedgeIndex} among {a pointer to a list:directionValues}:
    execute:
        return the item at coedgeIndex in directionValues

local function refine cad mesh edge {cad edge key:edgeKey} in {cad body:bodyValue} from {a 64 bit floating-point number:fromValue} to {a 64 bit floating-point number:toValue} within angle {a 64 bit floating-point number:maxAngle} and tolerance {a 64 bit floating-point number:linearTolerance} at depth {integer:depth} with directions {a pointer to a list:directionValues} into {a pointer to a list:sampleValues}:
    execute:
        set edgeNode to the cad node pointer for edgeKey in bodyValue
        if edgeNode = (0 as the type of edgeNode):
            return false
        set edgeValue to @intrinsic("dereference", edgeNode)
        set curveNode to the cad node pointer for edgeValue's curve in bodyValue
        if curveNode = (0 as the type of curveNode):
            return false
        set curveValue to @intrinsic("dereference", curveNode)
        set middleValue to 0.5 * (fromValue + toValue)
        set curvedPoint to the cad point on curveValue at middleValue
        set unitValues to the cad mesh nine units
        set tangentValues to an empty list of a cad vector3
        loop unitIndex from 0 to the length of unitValues:
            append (the cad tangent of curveValue at (fromValue + ((toValue - fromValue) * (the item at unitIndex in unitValues)))) to tangentValues
        set splitValue to cad mesh angle (the cad maximum direction angle of tangentValues) exceeds maxAngle
        free tangentValues
        loop coedgeIndex from 0 to the length of ((edgeValue's coedges's values)):
            set geometryValue to the cad mesh geometry of (the item at coedgeIndex in ((edgeValue's coedges's values))) in bodyValue
            if geometryValue's valid:
                set pcurveForward to the cad mesh direction at coedgeIndex among directionValues
                set normalValues to an empty list of a cad vector3
                loop unitIndex from 0 to the length of unitValues:
                    set parameterValue to fromValue + ((toValue - fromValue) * (the item at unitIndex in unitValues))
                    set onCurve to the cad point on curveValue at parameterValue
                    set uvValue to the cad zero vector2
                    set exactValue to false
                    if geometryValue's hasPcurve:
                        set preferredValue to (parameterValue - edgeValue's startParameter) / (edgeValue's endParameter - edgeValue's startParameter)
                        if pcurveForward = false:
                            set preferredValue to 1.0 - preferredValue
                        set directValue to the cad point on geometryValue's pcurve at preferredValue
                        set directDistance to the cad mesh distance from onCurve to (the cad mesh point on geometryValue's surface at directValue)
                        if directDistance <= linearTolerance:
                            set uvValue to directValue
                        else:
                            set closestValue to the cad mesh closest pcurve parameters on geometryValue to onCurve preferring preferredValue within linearTolerance
                            if closestValue's valid = false:
                                free normalValues
                                free unitValues
                                return false
                            set uvValue to closestValue's uv
                        set exactValue to true
                    else:
                        set parameterResult to the cad parameters on geometryValue's surface nearest onCurve
                        if parameterResult's valid = false:
                            free normalValues
                            free unitValues
                            return false
                        set uvValue to parameterResult's value
                    if exactValue:
                        if (the cad mesh distance from (the cad mesh point on geometryValue's surface at uvValue) to onCurve) > linearTolerance:
                            free normalValues
                            free unitValues
                            return false
                    set normalResult to the cad mesh display normal of geometryValue's surface at uvValue
                    if normalResult's valid = false:
                        free normalValues
                        free unitValues
                        return false
                    append normalResult's value to normalValues
                if cad mesh angle (the cad maximum direction angle of normalValues) exceeds maxAngle:
                    set splitValue to true
                free normalValues
        free unitValues
        if splitValue:
            if depth >= 32:
                return false
            if (refine cad mesh edge edgeKey in bodyValue from fromValue to middleValue within angle maxAngle and tolerance linearTolerance at depth (depth + 1) with directions directionValues into sampleValues) = false:
                return false
            append (a cad edge sample at middleValue with position curvedPoint) to sampleValues
            return refine cad mesh edge edgeKey in bodyValue from middleValue to toValue within angle maxAngle and tolerance linearTolerance at depth (depth + 1) with directions directionValues into sampleValues
        return true

local function the cad mesh source parameter of {a 64 bit floating-point number:parameterValue} forward {boolean:forwardValue}:
    execute:
        if forwardValue:
            return parameterValue
        return 1.0 - parameterValue

local function refine cad mesh pcurve edge {cad edge key:edgeKey} in {cad body:bodyValue} from coedge {integer:sourceIndex} between {a 64 bit floating-point number:fromValue} and {a 64 bit floating-point number:toValue} within angle {a 64 bit floating-point number:maxAngle} and tolerance {a 64 bit floating-point number:linearTolerance} at depth {integer:depth} with directions {a pointer to a list:directionValues} into {a pointer to a list:sampleValues}:
    execute:
        set edgeNode to the cad node pointer for edgeKey in bodyValue
        if edgeNode = (0 as the type of edgeNode):
            return false
        set edgeValue to @intrinsic("dereference", edgeNode)
        set sourceKey to the item at sourceIndex in ((edgeValue's coedges's values))
        set sourceGeometry to the cad mesh geometry of sourceKey in bodyValue
        if (sourceGeometry's valid = false) or (sourceGeometry's hasPcurve = false):
            return false
        set sourceForward to the cad mesh direction at sourceIndex among directionValues
        set unitValues to the cad mesh nine units
        set parameterValues to an empty list of a 64 bit floating-point number
        set positionValues to an empty list of a cad vector3
        loop unitIndex from 0 to the length of unitValues:
            set parameterValue to fromValue + ((toValue - fromValue) * (the item at unitIndex in unitValues))
            append parameterValue to parameterValues
            append (the cad mesh point on sourceGeometry at pcurve parameter (the cad mesh source parameter of parameterValue forward sourceForward)) to positionValues
        free unitValues
        set tangentValues to an empty list of a cad vector3
        loop unitIndex from 0 to the length of parameterValues:
            set parameterValue to the item at unitIndex in parameterValues
            set stepValue to 1e-5
            set beforeValue to the cad point on sourceGeometry's pcurve at (the cad mesh source parameter of (the maximum of (parameterValue - stepValue) and fromValue) forward sourceForward)
            set afterValue to the cad point on sourceGeometry's pcurve at (the cad mesh source parameter of (the minimum of (parameterValue + stepValue) and toValue) forward sourceForward)
            set uvValue to the cad point on sourceGeometry's pcurve at (the cad mesh source parameter of parameterValue forward sourceForward)
            set tangentResult to the cad tangents of sourceGeometry's surface at parameters uvValue's x and uvValue's y
            if tangentResult's valid = false:
                free tangentValues
                free parameterValues
                free positionValues
                return false
            append (the cad sum of (tangentResult's u scaled by (afterValue's x - beforeValue's x)) and (tangentResult's v scaled by (afterValue's y - beforeValue's y))) to tangentValues
        set splitValue to cad mesh angle (the cad maximum direction angle of tangentValues) exceeds maxAngle
        free tangentValues
        loop coedgeIndex from 0 to the length of ((edgeValue's coedges's values)):
            set coedgeKey to the item at coedgeIndex in ((edgeValue's coedges's values))
            set geometryValue to the cad mesh geometry of coedgeKey in bodyValue
            if geometryValue's valid = false:
                free parameterValues
                free positionValues
                return false
            set normalValues to an empty list of a cad vector3
            loop unitIndex from 0 to the length of parameterValues:
                set parameterValue to the item at unitIndex in parameterValues
                set positionValue to the item at unitIndex in positionValues
                set uvValue to the cad zero vector2
                if coedgeKey = sourceKey:
                    set uvValue to the cad point on sourceGeometry's pcurve at (the cad mesh source parameter of parameterValue forward sourceForward)
                else:
                    set parameterResult to the cad parameters on geometryValue's surface nearest positionValue
                    if parameterResult's valid:
                        set uvValue to parameterResult's value
                    else:
                        set pcurveForward to the cad mesh direction at coedgeIndex among directionValues
                        set preferredValue to the cad mesh source parameter of parameterValue forward pcurveForward
                        if geometryValue's hasPcurve = false:
                            free normalValues
                            free parameterValues
                            free positionValues
                            return false
                        set directValue to the cad point on geometryValue's pcurve at preferredValue
                        if (the cad mesh distance from positionValue to (the cad mesh point on geometryValue's surface at directValue)) <= linearTolerance:
                            set uvValue to directValue
                        else:
                            set closestValue to the cad mesh closest pcurve parameters on geometryValue to positionValue preferring preferredValue within linearTolerance
                            if closestValue's valid = false:
                                free normalValues
                                free parameterValues
                                free positionValues
                                return false
                            set uvValue to closestValue's uv
                if (the cad mesh distance from positionValue to (the cad mesh point on geometryValue's surface at uvValue)) > linearTolerance:
                    free normalValues
                    free parameterValues
                    free positionValues
                    return false
                set normalResult to the cad mesh display normal of geometryValue's surface at uvValue
                if normalResult's valid = false:
                    free normalValues
                    free parameterValues
                    free positionValues
                    return false
                append normalResult's value to normalValues
            if cad mesh angle (the cad maximum direction angle of normalValues) exceeds maxAngle:
                set splitValue to true
            free normalValues
        set firstPosition to the item at 0 in positionValues
        set lastPosition to the last item of positionValues
        free parameterValues
        free positionValues
        set sampleParameter to edgeValue's startParameter + ((edgeValue's endParameter - edgeValue's startParameter) * fromValue)
        if splitValue:
            if depth >= 32:
                if (the cad mesh distance from firstPosition to lastPosition) <= linearTolerance:
                    append (a cad edge sample at sampleParameter with position firstPosition) to sampleValues
                    return true
                return false
            set middleValue to 0.5 * (fromValue + toValue)
            if (refine cad mesh pcurve edge edgeKey in bodyValue from coedge sourceIndex between fromValue and middleValue within angle maxAngle and tolerance linearTolerance at depth (depth + 1) with directions directionValues into sampleValues) = false:
                return false
            return refine cad mesh pcurve edge edgeKey in bodyValue from coedge sourceIndex between middleValue and toValue within angle maxAngle and tolerance linearTolerance at depth (depth + 1) with directions directionValues into sampleValues
        append (a cad edge sample at sampleParameter with position firstPosition) to sampleValues
        return true

local function the cad mesh pcurve edge samples of {cad edge key:edgeKey} in {cad body:bodyValue} within angle {a 64 bit floating-point number:maxAngle} and tolerance {a 64 bit floating-point number:linearTolerance} with directions {a pointer to a list:directionValues}:
    execute:
        set edgeNode to the cad node pointer for edgeKey in bodyValue
        if edgeNode = (0 as the type of edgeNode):
            return no cad mesh samples
        set edgeValue to @intrinsic("dereference", edgeNode)
        loop coedgeIndex from 0 to the length of ((edgeValue's coedges's values)):
            set coedgeKey to the item at coedgeIndex in ((edgeValue's coedges's values))
            set geometryValue to the cad mesh geometry of coedgeKey in bodyValue
            if geometryValue's valid and (geometryValue's hasPcurve and (geometryValue's surface's kind = 5)):
                set sampleValues to an empty list of a cad edge sample
                set breakValues to a list containing 0.0
                append 1.0 to breakValues
                if geometryValue's pcurve's kind = cad nurbs curve2 kind:
                    set curveDomain to the cad domain of geometryValue's pcurve's nurbs
                    set spanValue to curveDomain's end - curveDomain's start
                    if (cad mesh scalar spanValue is finite) and (spanValue > 0.0):
                        set knotValues to the cad knots of geometryValue's pcurve's nurbs
                        loop knotIndex from 0 to the length of knotValues:
                            set knotValue to the item at knotIndex in knotValues
                            if (knotValue > curveDomain's start) and (knotValue < curveDomain's end):
                                append ((knotValue - curveDomain's start) / spanValue) to breakValues
                set distinctBreaks to the cad mesh distinct sorted scalars from breakValues
                free breakValues
                set resolved to true
                set pairIndex to 1
                loop while resolved and (pairIndex < (the length of distinctBreaks)):
                    set resolved to refine cad mesh pcurve edge edgeKey in bodyValue from coedge coedgeIndex between (the item at (pairIndex - 1) in distinctBreaks) and (the item at pairIndex in distinctBreaks) within angle (the cad sampling angle for maxAngle) and tolerance (the maximum of linearTolerance and 1e-12) at depth 0 with directions directionValues into sampleValues
                    set pairIndex to pairIndex + 1
                free distinctBreaks
                if resolved:
                    set directionResult to the cad mesh pcurve direction of coedgeKey on edgeKey in bodyValue
                    if directionResult's valid = false:
                        free sampleValues
                        return no cad mesh samples
                    set endUnit to 0.0
                    if directionResult's value:
                        set endUnit to 1.0
                    append (a cad edge sample at edgeValue's endParameter with position (the cad mesh point on geometryValue at pcurve parameter endUnit)) to sampleValues
                    return @intrinsic("construct", a cad mesh samples result, true, sampleValues)
                free sampleValues
        return no cad mesh samples

local function the cad mesh shared samples of {cad edge key:edgeKey} in {cad body:bodyValue} within angle {a 64 bit floating-point number:maxAngle} and tolerance {a 64 bit floating-point number:linearTolerance}:
    execute:
        set edgeNode to the cad node pointer for edgeKey in bodyValue
        if edgeNode = (0 as the type of edgeNode):
            return no cad mesh samples
        set edgeValue to @intrinsic("dereference", edgeNode)
        set curveNode to the cad node pointer for edgeValue's curve in bodyValue
        if curveNode = (0 as the type of curveNode):
            return no cad mesh samples
        set curveValue to @intrinsic("dereference", curveNode)
        set directionValues to an empty list of a boolean
        set hasNurbsPcurve to false
        loop coedgeIndex from 0 to the length of ((edgeValue's coedges's values)):
            set coedgeKey to the item at coedgeIndex in ((edgeValue's coedges's values))
            set geometryValue to the cad mesh geometry of coedgeKey in bodyValue
            if geometryValue's valid = false:
                free directionValues
                return no cad mesh samples
            if geometryValue's hasPcurve:
                set directionResult to the cad mesh pcurve direction of coedgeKey on edgeKey in bodyValue
                if directionResult's valid = false:
                    free directionValues
                    return no cad mesh samples
                append directionResult's value to directionValues
                if geometryValue's surface's kind = 5:
                    set hasNurbsPcurve to true
            else:
                append true to directionValues
        if hasNurbsPcurve:
            set pcurveSamples to the cad mesh pcurve edge samples of edgeKey in bodyValue within angle maxAngle and tolerance linearTolerance with directions directionValues
            if pcurveSamples's valid:
                free directionValues
                return pcurveSamples
        set sampleValues to a list containing (a cad edge sample at edgeValue's startParameter with position (the cad point on curveValue at edgeValue's startParameter))
        if refine cad mesh edge edgeKey in bodyValue from edgeValue's startParameter to edgeValue's endParameter within angle (the cad sampling angle for maxAngle) and tolerance (the maximum of linearTolerance and 1e-12) at depth 0 with directions directionValues into sampleValues:
            append (a cad edge sample at edgeValue's endParameter with position (the cad point on curveValue at edgeValue's endParameter)) to sampleValues
            free directionValues
            return @intrinsic("construct", a cad mesh samples result, true, sampleValues)
        free sampleValues
        set fallbackSamples to the cad mesh pcurve edge samples of edgeKey in bodyValue within angle maxAngle and tolerance linearTolerance with directions directionValues
        free directionValues
        return fallbackSamples

# Schedules are indexed by edge slot; generations reject stale keys.
local function free cad mesh schedules {a pointer to a list:scheduleValues}:
    execute:
        loop scheduleIndex from 0 to the length of scheduleValues:
            free ((the item at scheduleIndex in scheduleValues)'s edgeSamples)
        free scheduleValues

local function the cad mesh schedule slot of {cad edge key:edgeKey}:
    execute:
        return (edgeKey's index) as an integer

# body_edge_schedules; face() passes its raw angle and tolerance without a
# chordal deflection, for which edge_chordal_angle returns the cap unchanged.
local function the cad mesh schedules of {cad body:bodyValue} with tolerance {cad tessellation tolerance:toleranceValue}:
    execute:
        set edgeKeys to the cad edge keys of bodyValue
        set slotCount to 0
        loop edgeIndex from 0 to the length of edgeKeys:
            set slotCount to the maximum of slotCount and ((the cad mesh schedule slot of (the item at edgeIndex in edgeKeys)) + 1)
        set scheduleValues to an empty list of a cad mesh edge schedule
        loop slotIndex from 0 to slotCount:
            append (@intrinsic("construct", a cad mesh edge schedule, a new cad edge key, false, an empty list of a cad edge sample)) to scheduleValues
        loop edgeIndex from 0 to the length of edgeKeys:
            set edgeKey to the item at edgeIndex in edgeKeys
            set edgeAngle to the cad mesh edge angle of edgeKey in bodyValue with tolerance toleranceValue
            set samplesResult to the cad mesh shared samples of edgeKey in bodyValue within angle edgeAngle and tolerance (the linear of toleranceValue)
            if samplesResult's valid:
                set slotIndex to the cad mesh schedule slot of edgeKey
                free ((the item at slotIndex in scheduleValues)'s edgeSamples)
                replace item at index slotIndex in scheduleValues with (@intrinsic("construct", a cad mesh edge schedule, edgeKey, true, samplesResult's values))
            else:
                free samplesResult's values
        free edgeKeys
        return scheduleValues

local function the cad mesh schedule of {cad edge key:edgeKey} among {a pointer to a list:scheduleValues}:
    execute:
        set slotIndex to the cad mesh schedule slot of edgeKey
        if slotIndex < (the length of scheduleValues):
            set scheduleValue to the item at slotIndex in scheduleValues
            if scheduleValue's valid:
                if scheduleValue's edge = edgeKey:
                    return scheduleValue
        return @intrinsic("construct", a cad mesh edge schedule, edgeKey, false, an empty list of a cad edge sample)


local function the cad mesh singular parameters of {cad vector3:positionValue} on {cad surface:surfaceValue}:
    execute:
        set absentValue to @intrinsic("construct", a cad mesh vector2 result, false, the cad zero vector2)
        if surfaceValue's kind != 3:
            return absentValue
        set normalResult to the cad normal of surfaceValue's sphere's frame
        if normalResult's valid = false:
            return absentValue
        set heightValue to the cad dot of (the cad difference of positionValue and surfaceValue's sphere's frame's origin) and normalResult's value
        set notANumber to 0.0 / 0.0
        set poleValue to -1.5707963267948966
        if heightValue >= 0.0:
            set poleValue to 1.5707963267948966
        return @intrinsic("construct", a cad mesh vector2 result, true, a cad vector2 with x notANumber and y poleValue)

local function the cad mesh parameterization of positions {a pointer to a list:positionValues} on {cad surface:surfaceValue}:
    execute:
        set periodValues to the cad mesh periods of surfaceValue
        set parameterValues to an empty list of a cad vector2
        if (the length of positionValues) > 0:
            ensure enough capacity in parameterValues for (the length of positionValues) items
        loop positionIndex from 0 to the length of positionValues:
            set positionValue to the item at positionIndex in positionValues
            set parameterResult to the cad parameters on surfaceValue nearest positionValue
            if parameterResult's valid:
                append parameterResult's value to parameterValues
            else:
                set singularResult to the cad mesh singular parameters of positionValue on surfaceValue
                if singularResult's valid = false:
                    free parameterValues
                    return no cad mesh points
                append singularResult's value to parameterValues
        loop axisIndex from 0 to 2:
            if cad mesh periodValues has period on axis axisIndex:
                loop pointIndex from 0 to the length of parameterValues:
                    set currentValue to the item at pointIndex in parameterValues
                    if (cad mesh scalar (the cad mesh coordinate axisIndex of currentValue) is finite) = false:
                        set foundValue to false
                        set offsetValue to 1
                        loop while (foundValue = false) and (offsetValue < (the length of parameterValues)):
                            set beforeIndex to pointIndex - offsetValue
                            if beforeIndex >= 0:
                                set nearValue to the cad mesh coordinate axisIndex of (the item at beforeIndex in parameterValues)
                                if cad mesh scalar nearValue is finite:
                                    replace item at index pointIndex in parameterValues with (the cad mesh vector2 currentValue with coordinate axisIndex set to nearValue)
                                    set foundValue to true
                            if foundValue = false:
                                set afterIndex to pointIndex + offsetValue
                                if afterIndex < (the length of parameterValues):
                                    set nearValue to the cad mesh coordinate axisIndex of (the item at afterIndex in parameterValues)
                                    if cad mesh scalar nearValue is finite:
                                        replace item at index pointIndex in parameterValues with (the cad mesh vector2 currentValue with coordinate axisIndex set to nearValue)
                                        set foundValue to true
                            set offsetValue to offsetValue + 1
                        if foundValue = false:
                            free parameterValues
                            return no cad mesh points
        set outputPoints to an empty list of a cad mesh boundary point
        loop pointIndex from 0 to the length of parameterValues:
            set parameters to the item at pointIndex in parameterValues
            if pointIndex > 0:
                set lastParameters to the item at (pointIndex - 1) in parameterValues
                loop axisIndex from 0 to 2:
                    if cad mesh periodValues has period on axis axisIndex:
                        set parameters to the cad mesh vector2 parameters with coordinate axisIndex set to (the cad mesh unwound (the cad mesh coordinate axisIndex of parameters) near (the cad mesh coordinate axisIndex of lastParameters) with period (the cad mesh period of periodValues on axis axisIndex))
                replace item at index pointIndex in parameterValues with parameters
            append (@intrinsic("construct", a cad mesh boundary point, parameters, the item at pointIndex in positionValues)) to outputPoints
        free parameterValues
        return the cad mesh points result of outputPoints

local function the cad mesh sample unit of {cad edge sample:sampleValue} from {a 64 bit floating-point number:firstParameter} across {a 64 bit floating-point number:parameterSpan}:
    execute:
        if (the absolute value of parameterSpan) > 2.220446049250313e-16:
            return (sampleValue's parameter - firstParameter) / parameterSpan
        return 0.0

local function the cad mesh parameterization of samples {a pointer to a list:sampleValues} on {cad mesh coedge geometry:geometryValue} within {a 64 bit floating-point number:linearTolerance}:
    execute:
        set surfaceValue to geometryValue's surface
        if geometryValue's hasPcurve = false:
            set positionValues to an empty list of a cad vector3
            loop sampleIndex from 0 to the length of sampleValues:
                append (the item at sampleIndex in sampleValues)'s position to positionValues
            set parameterized to the cad mesh parameterization of positions positionValues on surfaceValue
            free positionValues
            return parameterized
        if (the length of sampleValues) = 0:
            return no cad mesh points
        set lastIndex to (the length of sampleValues) - 1
        set firstParameter to (the item at 0 in sampleValues)'s parameter
        set parameterSpan to (the item at lastIndex in sampleValues)'s parameter - firstParameter
        set forwardDeviation to 0.0
        set reversedDeviation to 0.0
        set probeIndices to a list containing 0
        append (lastIndex / 4) to probeIndices
        append (lastIndex / 2) to probeIndices
        append ((lastIndex * 3) / 4) to probeIndices
        append lastIndex to probeIndices
        loop probeIndex from 0 to 5:
            set sampleValue to the item at (the item at probeIndex in probeIndices) in sampleValues
            set preferredValue to the cad mesh sample unit of sampleValue from firstParameter across parameterSpan
            set forwardDeviation to forwardDeviation + (the cad mesh distance from sampleValue's position to (the cad mesh point on geometryValue at pcurve parameter preferredValue))
            set reversedDeviation to reversedDeviation + (the cad mesh distance from sampleValue's position to (the cad mesh point on geometryValue at pcurve parameter (1.0 - preferredValue)))
        free probeIndices
        set pcurveForward to forwardDeviation <= reversedDeviation
        set mappedParameters to an empty list of a 64 bit floating-point number
        set outputPoints to an empty list of a cad mesh boundary point
        loop sampleIndex from 0 to the length of sampleValues:
            set sampleValue to the item at sampleIndex in sampleValues
            set preferredValue to the cad mesh sample unit of sampleValue from firstParameter across parameterSpan
            if pcurveForward = false:
                set preferredValue to 1.0 - preferredValue
            set directValue to the cad point on geometryValue's pcurve at preferredValue
            set directDeviation to the cad mesh distance from sampleValue's position to (the cad mesh point on surfaceValue at directValue)
            set mappedParameter to preferredValue
            set mappedUv to directValue
            set deviationValue to directDeviation
            if directDeviation > linearTolerance:
                set closestValue to the cad mesh closest pcurve parameters on geometryValue to sampleValue's position preferring preferredValue within linearTolerance
                if closestValue's valid = false:
                    free mappedParameters
                    free outputPoints
                    return no cad mesh points
                set mappedParameter to closestValue's pcurveParameter
                set mappedUv to closestValue's uv
                set deviationValue to closestValue's measure
            if (deviationValue <= linearTolerance) = false:
                free mappedParameters
                free outputPoints
                return no cad mesh points
            append mappedParameter to mappedParameters
            append (@intrinsic("construct", a cad mesh boundary point, mappedUv, sampleValue's position)) to outputPoints
        set mappedCount to the length of outputPoints
        if mappedCount > 3:
            set startUv to the cad point on geometryValue's pcurve at 0.0
            set endUv to the cad point on geometryValue's pcurve at 1.0
            if (the cad mesh distance from (the cad mesh point on surfaceValue at startUv) to (the cad mesh point on surfaceValue at endUv)) <= linearTolerance:
                if (the item at 1 in mappedParameters) > (the item at (mappedCount - 2) in mappedParameters):
                    replace item at index 0 in outputPoints with (@intrinsic("construct", a cad mesh boundary point, endUv, (the item at 0 in sampleValues)'s position))
                    replace item at index lastIndex in outputPoints with (@intrinsic("construct", a cad mesh boundary point, startUv, (the item at lastIndex in sampleValues)'s position))
        free mappedParameters
        return the cad mesh points result of outputPoints

local function unwrap cad mesh boundary {a pointer to a list:pointValues} with {cad mesh periods:periodValues}:
    execute:
        loop pointIndex from 1 to the length of pointValues:
            set pointValue to the item at pointIndex in pointValues
            set previousValue to the item at (pointIndex - 1) in pointValues
            loop axisIndex from 0 to 2:
                if cad mesh periodValues has period on axis axisIndex:
                    set pointValue to the cad mesh boundary point pointValue with parameter axisIndex set to (the cad mesh unwound (the cad mesh parameter axisIndex of pointValue) near (the cad mesh parameter axisIndex of previousValue) with period (the cad mesh period of periodValues on axis axisIndex))
            replace item at index pointIndex in pointValues with pointValue

local function the cad mesh period shifts of {cad mesh periods:periodValues} on axis {integer:axisIndex}:
    execute:
        set shiftValues to an empty list of a 64 bit floating-point number
        set periodValue to the cad mesh period of periodValues on axis axisIndex
        if (cad mesh periodValues has period on axis axisIndex) and ((cad mesh scalar periodValue is finite) and (periodValue > 0.0)):
            loop turnIndex from -2 to 3:
                append ((turnIndex as a 64 bit floating-point number) * periodValue) to shiftValues
        else:
            append (0.0 * 0.0) to shiftValues
        return shiftValues

local function align cad mesh parameters {a pointer to a list:pointValues} after {a pointer to a list:chainValues} with {cad mesh periods:periodValues} closing {boolean:closesRing}:
    execute:
        if (the length of pointValues) = 0:
            return nothing
        set firstParameters to (the item at 0 in pointValues)'s parameters
        set previousParameters to firstParameters
        if (the length of chainValues) > 0:
            set previousParameters to (the last item of chainValues)'s parameters
        set lastParameters to (the last item of pointValues)'s parameters
        set bestGap to 1.7976931348623157e308 * 10.0
        set bestShift to the cad zero vector2
        set acrossShifts to the cad mesh period shifts of periodValues on axis 0
        set alongShifts to the cad mesh period shifts of periodValues on axis 1
        loop acrossIndex from 0 to the length of acrossShifts:
            set acrossValue to the item at acrossIndex in acrossShifts
            loop alongIndex from 0 to the length of alongShifts:
                set alongValue to the item at alongIndex in alongShifts
                set movedFirst to a cad vector2 with x (firstParameters's x + acrossValue) and y (firstParameters's y + alongValue)
                set movedLast to a cad vector2 with x (lastParameters's x + acrossValue) and y (lastParameters's y + alongValue)
                set skipShift to false
                if (closesRing = false) and (cad mesh uv movedFirst is near uv previousParameters):
                    if (the length of chainValues) > 0:
                        if cad mesh uv movedLast is near uv ((the item at 0 in chainValues)'s parameters):
                            set skipShift to true
                if skipShift = false:
                    set gapValue to @intrinsic("call", "libc", "hypot", a 64 bit floating-point number, movedFirst's x - previousParameters's x, movedFirst's y - previousParameters's y)
                    if gapValue < bestGap:
                        set bestGap to gapValue
                        set bestShift to a cad vector2 with x acrossValue and y alongValue
        free acrossShifts
        free alongShifts
        loop pointIndex from 0 to the length of pointValues:
            set pointValue to the item at pointIndex in pointValues
            set pointValue's parameters to a cad vector2 with x (pointValue's parameters's x + bestShift's x) and y (pointValue's parameters's y + bestShift's y)
            replace item at index pointIndex in pointValues with pointValue

class:
    patterns:
        [a|] cad mesh chain piece
    members:
        edgeSamples as the type of (an empty list of a cad edge sample)
        pieceGeometry as a cad mesh coedge geometry

local function the cad mesh chain of {a pointer to a list:pieceValues} on {cad surface:surfaceValue} within {a 64 bit floating-point number:linearTolerance}:
    execute:
        if (the length of pieceValues) = 0:
            return no cad mesh points
        set periodValues to the cad mesh periods of surfaceValue
        set firstPiece to the item at 0 in pieceValues
        set explicitValue to firstPiece's pieceGeometry's hasPcurve
        set allExplicit to explicitValue
        set firstResult to the cad mesh parameterization of samples firstPiece's edgeSamples on firstPiece's pieceGeometry within linearTolerance
        if firstResult's valid = false:
            return no cad mesh points
        set pointValues to firstResult's values
        unwrap cad mesh boundary pointValues with periodValues
        loop pieceIndex from 1 to the length of pieceValues:
            set pieceValue to the item at pieceIndex in pieceValues
            if (the length of pointValues) = 0:
                free pointValues
                return no cad mesh points
            set headPosition to (the last item of pointValues)'s position
            set nextExplicit to pieceValue's pieceGeometry's hasPcurve
            set nextResult to the cad mesh parameterization of samples pieceValue's edgeSamples on pieceValue's pieceGeometry within linearTolerance
            if nextResult's valid = false:
                free pointValues
                return no cad mesh points
            set nextPoints to nextResult's values
            unwrap cad mesh boundary nextPoints with periodValues
            if (explicitValue = false) or (nextExplicit = false):
                align cad mesh parameters nextPoints after pointValues with periodValues closing ((pieceIndex + 1) = (the length of pieceValues))
            if (the length of nextPoints) = 0:
                free nextPoints
                free pointValues
                return no cad mesh points
            if (the cad mesh distance from headPosition to (the item at 0 in nextPoints)'s position) > linearTolerance:
                free nextPoints
                free pointValues
                return no cad mesh points
            set skipCount to 1
            if explicitValue and nextExplicit:
                if (cad mesh uv ((the last item of pointValues)'s parameters) is near uv ((the item at 0 in nextPoints)'s parameters)) = false:
                    set skipCount to 0
            loop nextIndex from skipCount to the length of nextPoints:
                append (the item at nextIndex in nextPoints) to pointValues
            free nextPoints
            set explicitValue to nextExplicit
            set allExplicit to allExplicit and nextExplicit
        if (the length of pointValues) = 0:
            free pointValues
            return no cad mesh points
        if (the cad mesh distance from ((the item at 0 in pointValues)'s position) to ((the last item of pointValues)'s position)) > linearTolerance:
            free pointValues
            return no cad mesh points
        set firstParameters to (the item at 0 in pointValues)'s parameters
        set lastParameters to (the last item of pointValues)'s parameters
        if allExplicit and ((cad mesh uv firstParameters is near uv lastParameters) = false):
            return the cad mesh points result of pointValues
        set closingParameters to lastParameters
        set windsPeriod to false
        loop axisIndex from 0 to 2:
            if cad mesh periodValues has period on axis axisIndex:
                set periodValue to the cad mesh period of periodValues on axis axisIndex
                set traversalValue to (the cad mesh coordinate axisIndex of lastParameters) - (the cad mesh coordinate axisIndex of firstParameters)
                if ((the absolute value of traversalValue) < (periodValue * 0.5)) = false:
                    set signValue to 1.0
                    if traversalValue < 0.0:
                        set signValue to -1.0
                    if traversalValue != traversalValue:
                        set signValue to traversalValue
                    set targetValue to (the cad mesh coordinate axisIndex of firstParameters) + (signValue * periodValue)
                    set candidateParameters to the cad mesh vector2 closingParameters with coordinate axisIndex set to targetValue
                    if (the cad mesh distance from ((the last item of pointValues)'s position) to (the cad mesh point on surfaceValue at candidateParameters)) <= linearTolerance:
                        set closingParameters to candidateParameters
                        set windsPeriod to true
        if windsPeriod = false:
            remove the last item from pointValues
        else:
            set lastPoint to the last item of pointValues
            set lastPoint's parameters to closingParameters
            replace item at index ((the length of pointValues) - 1) in pointValues with lastPoint
        return the cad mesh points result of pointValues

local function free cad mesh chain pieces {a pointer to a list:pieceValues}:
    execute:
        loop pieceIndex from 0 to the length of pieceValues:
            free ((the item at pieceIndex in pieceValues)'s edgeSamples)
        free pieceValues

local function the cad mesh samples of {cad coedge:coedgeValue} among {a pointer to a list:scheduleValues}:
    execute:
        set scheduleValue to the cad mesh schedule of coedgeValue's edge among scheduleValues
        if scheduleValue's valid = false:
            return no cad mesh samples
        set sampleValues to an empty list of a cad edge sample
        set sampleCount to the length of scheduleValue's edgeSamples
        loop sampleIndex from 0 to sampleCount:
            if coedgeValue's forward:
                append (the item at sampleIndex in scheduleValue's edgeSamples) to sampleValues
            else:
                append (the item at ((sampleCount - 1) - sampleIndex) in scheduleValue's edgeSamples) to sampleValues
        return @intrinsic("construct", a cad mesh samples result, true, sampleValues)

local function the cad mesh scheduled loop {cad loop key:loopKey} in {cad body:bodyValue} on {cad surface:surfaceValue} among {a pointer to a list:scheduleValues} within {a 64 bit floating-point number:linearTolerance}:
    execute:
        set loopNode to the cad node pointer for loopKey in bodyValue
        if loopNode = (0 as the type of loopNode):
            return no cad mesh points
        set loopValue to @intrinsic("dereference", loopNode)
        set useKeys to an empty list of a cad coedge key
        if (the length of (loopValue's coedges's values)) > 0:
            ensure enough capacity in useKeys for (the length of (loopValue's coedges's values)) items
        loop coedgeIndex from 0 to the length of ((loopValue's coedges's values)):
            set coedgeKey to the item at coedgeIndex in ((loopValue's coedges's values))
            set coedgeNode to the cad node pointer for coedgeKey in bodyValue
            if coedgeNode = (0 as the type of coedgeNode):
                free useKeys
                return no cad mesh points
            set coedgeValue to @intrinsic("dereference", coedgeNode)
            set cancels to false
            if (the length of useKeys) > 0:
                set previousNode to the cad node pointer for (the last item of useKeys) in bodyValue
                if previousNode != (0 as the type of previousNode):
                    set previousValue to @intrinsic("dereference", previousNode)
                    if (previousValue's edge = coedgeValue's edge) and (previousValue's forward != coedgeValue's forward):
                        if (previousValue's pcurve's valid = false) and (coedgeValue's pcurve's valid = false):
                            set cancels to true
            if cancels:
                remove the last item from useKeys
            else:
                append coedgeKey to useKeys
        set trimming to true
        loop while trimming and ((the length of useKeys) >= 2):
            set firstNode to the cad node pointer for (the item at 0 in useKeys) in bodyValue
            if firstNode = (0 as the type of firstNode):
                free useKeys
                return no cad mesh points
            set lastNode to the cad node pointer for (the last item of useKeys) in bodyValue
            if lastNode = (0 as the type of lastNode):
                free useKeys
                return no cad mesh points
            set firstUse to @intrinsic("dereference", firstNode)
            set lastUse to @intrinsic("dereference", lastNode)
            if (firstUse's edge != lastUse's edge) or ((firstUse's forward = lastUse's forward) or (firstUse's pcurve's valid or lastUse's pcurve's valid)):
                set trimming to false
            else:
                remove item 0 from useKeys
                remove the last item from useKeys
        set pieceValues to an empty list of a cad mesh chain piece
        loop useIndex from 0 to the length of useKeys:
            set coedgeKey to the item at useIndex in useKeys
            set coedgeNode to the cad node pointer for coedgeKey in bodyValue
            if coedgeNode = (0 as the type of coedgeNode):
                free useKeys
                free cad mesh chain pieces pieceValues
                return no cad mesh points
            set coedgeValue to @intrinsic("dereference", coedgeNode)
            set samplesResult to the cad mesh samples of coedgeValue among scheduleValues
            if samplesResult's valid = false:
                free useKeys
                free cad mesh chain pieces pieceValues
                return no cad mesh points
            if (the length of samplesResult's values) >= 2:
                set geometryValue to @intrinsic("construct", a cad mesh coedge geometry, true, surfaceValue, coedgeValue's pcurve's valid, the cad pcurve value of coedgeValue's pcurve)
                append (@intrinsic("construct", a cad mesh chain piece, samplesResult's values, geometryValue)) to pieceValues
            else:
                free samplesResult's values
        free useKeys
        set chained to the cad mesh chain of pieceValues on surfaceValue within linearTolerance
        free cad mesh chain pieces pieceValues
        return chained

local function the cad mesh scheduled rings of {cad face key:faceKey} in {cad body:bodyValue} on {cad surface:surfaceValue} among {a pointer to a list:scheduleValues} within {a 64 bit floating-point number:linearTolerance}:
    execute:
        set faceNode to the cad node pointer for faceKey in bodyValue
        if faceNode = (0 as the type of faceNode):
            return no cad mesh rings
        set faceValue to @intrinsic("dereference", faceNode)
        set ringValues to an empty list of the type of (an empty list of a cad mesh boundary point)
        loop loopIndex from 0 to the length of ((faceValue's loops's values)):
            set ringResult to the cad mesh scheduled loop (the item at loopIndex in ((faceValue's loops's values))) in bodyValue on surfaceValue among scheduleValues within linearTolerance
            if ringResult's valid = false:
                cad mesh release rings ringValues
                return no cad mesh rings
            if (the length of ringResult's values) >= 3:
                append ringResult's values to ringValues
            else:
                free ringResult's values
        if (the length of ringValues) = 0:
            free ringValues
            return no cad mesh rings
        return @intrinsic("construct", a cad mesh rings result, true, ringValues)

local function the cad mesh boundary area value of {a pointer to a list:pointValues}:
    execute:
        set parameterValues to the cad mesh uv ring of pointValues
        set areaValue to the absolute value of (the cad signed area of parameterValues)
        free parameterValues
        return areaValue

local function the cad mesh parameter range of {a pointer to a list:pointValues} on axis {integer:axisIndex}:
    execute:
        set lowValue to 1.7976931348623157e308 * 10.0
        set highValue to -1.7976931348623157e308 * 10.0
        loop pointIndex from 0 to the length of pointValues:
            set coordinateValue to the cad mesh parameter axisIndex of (the item at pointIndex in pointValues)
            set lowValue to the minimum of lowValue and coordinateValue
            set highValue to the maximum of highValue and coordinateValue
        return highValue - lowValue

local function cad mesh boundary {a pointer to a list:pointValues} has area:
    execute:
        set areaValue to the cad mesh boundary area value of pointValues
        set uSpan to the cad mesh parameter range of pointValues on axis 0
        set vSpan to the cad mesh parameter range of pointValues on axis 1
        return (cad mesh scalar areaValue is finite) and (areaValue > ((1.4210854715202004e-14 * uSpan) * vSpan))

local function the cad mesh boundary centroid of {a pointer to a list:pointValues}:
    execute:
        set countValue to (the maximum of (the length of pointValues) and 1) as a 64 bit floating-point number
        set sumValue to the cad zero vector2
        loop pointIndex from 0 to the length of pointValues:
            set parameters to (the item at pointIndex in pointValues)'s parameters
            set sumValue to a cad vector2 with x (sumValue's x + (parameters's x / countValue)) and y (sumValue's y + (parameters's y / countValue))
        return sumValue

local function align cad mesh rings {a pointer to a list:ringValues} with {cad mesh periods:periodValues}:
    execute:
        if (the length of ringValues) = 0:
            return nothing
        set outerIndex to 0
        set outerKey to the cad mesh total order key of (the cad mesh boundary area value of (the item at 0 in ringValues))
        loop ringIndex from 1 to the length of ringValues:
            set candidateKey to the cad mesh total order key of (the cad mesh boundary area value of (the item at ringIndex in ringValues))
            if candidateKey >= outerKey:
                set outerIndex to ringIndex
                set outerKey to candidateKey
        set outerCentre to the cad mesh boundary centroid of (the item at outerIndex in ringValues)
        loop ringIndex from 0 to the length of ringValues:
            set ringValue to the item at ringIndex in ringValues
            set centreValue to the cad mesh boundary centroid of ringValue
            loop axisIndex from 0 to 2:
                if cad mesh periodValues has period on axis axisIndex:
                    set periodValue to the cad mesh period of periodValues on axis axisIndex
                    set shiftValue to periodValue * (the rounded value of (((the cad mesh coordinate axisIndex of outerCentre) - (the cad mesh coordinate axisIndex of centreValue)) / periodValue))
                    loop pointIndex from 0 to the length of ringValue:
                        set pointValue to the item at pointIndex in ringValue
                        replace item at index pointIndex in ringValue with (the cad mesh boundary point pointValue with parameter axisIndex set to ((the cad mesh parameter axisIndex of pointValue) + shiftValue))


class:
    patterns:
        [a|] cad mesh boundary band
    members:
        valid as a boolean
        low as the type of (an empty list of a cad mesh boundary point)
        high as the type of (an empty list of a cad mesh boundary point)
        holes as the type of (an empty list of the type of (an empty list of a cad mesh boundary point))
        varying as an integer
        strip as a boolean
        structured as a boolean

class:
    patterns:
        [a|] cad mesh domain
    members:
        valid as a boolean
        u as a cad vector2
        v as a cad vector2

local function no cad mesh band:
    execute:
        set emptyRing to an empty list of a cad mesh boundary point
        set emptyHoles to an empty list of the type of emptyRing
        return @intrinsic("construct", a cad mesh boundary band, false, emptyRing, an empty list of a cad mesh boundary point, emptyHoles, 0, false, false)

local function free cad mesh band {cad mesh boundary band:bandValue}:
    execute:
        free bandValue's low
        free bandValue's high
        cad mesh release rings bandValue's holes

local function the cad mesh lower limit of {cad mesh domain:domainValue} on axis {integer:axisIndex}:
    execute:
        if axisIndex = 0:
            return domainValue's u's x
        return domainValue's v's x

local function the cad mesh upper limit of {cad mesh domain:domainValue} on axis {integer:axisIndex}:
    execute:
        if axisIndex = 0:
            return domainValue's u's y
        return domainValue's v's y

local function the cad mesh domain from {a 64 bit floating-point number:uLow} to {a 64 bit floating-point number:uHigh} and {a 64 bit floating-point number:vLow} to {a 64 bit floating-point number:vHigh}:
    execute:
        return @intrinsic("construct", a cad mesh domain, true, a cad vector2 with x uLow and y uHigh, a cad vector2 with x vLow and y vHigh)

local function no cad mesh domain:
    execute:
        return @intrinsic("construct", a cad mesh domain, false, the cad zero vector2, the cad zero vector2)

local function the cad mesh surface domain of {cad surface:surfaceValue}:
    execute:
        set tauValue to 6.283185307179586
        if surfaceValue's kind = 3:
            return the cad mesh domain from 0.0 to tauValue and -1.5707963267948966 to 1.5707963267948966
        if surfaceValue's kind = 2:
            set slopeValue to @intrinsic("call", "libc", "tan", a 64 bit floating-point number, surfaceValue's cone's halfAngle)
            if (the absolute value of slopeValue) > 1e-15:
                set apexValue to surfaceValue's cone's radius / slopeValue
                return the cad mesh domain from 0.0 to tauValue and (the minimum of 0.0 and apexValue) to (the maximum of 0.0 and apexValue)
            return no cad mesh domain
        if surfaceValue's kind = 4:
            return the cad mesh domain from 0.0 to tauValue and 0.0 to tauValue
        if surfaceValue's kind = 5:
            set nurbsDomain to the cad domain of surfaceValue's nurbs
            return the cad mesh domain from nurbsDomain's u's start to nurbsDomain's u's end and nurbsDomain's v's start to nurbsDomain's v's end
        return no cad mesh domain

local function the cad mesh average parameter of {a pointer to a list:pointValues} on axis {integer:axisIndex}:
    execute:
        # Rust's f64 Sum starts from negative zero.
        set sumValue to the negative of 0.0
        loop pointIndex from 0 to the length of pointValues:
            set sumValue to sumValue + (the cad mesh parameter axisIndex of (the item at pointIndex in pointValues))
        return sumValue / ((the length of pointValues) as a 64 bit floating-point number)

local function cad mesh rim {a pointer to a list:pointValues} on {cad surface:surfaceValue} is isoparametric along axis {integer:varyingAxis} within {a 64 bit floating-point number:linearTolerance}:
    execute:
        set fixedAxis to 1 - varyingAxis
        set fixedValue to the cad mesh average parameter of pointValues on axis fixedAxis
        loop pointIndex from 0 to the length of pointValues:
            set pointValue to the item at pointIndex in pointValues
            set parameters to the cad mesh vector2 pointValue's parameters with coordinate fixedAxis set to fixedValue
            if ((the cad mesh distance from pointValue's position to (the cad mesh point on surfaceValue at parameters)) <= linearTolerance) = false:
                return false
        return true

local function cad mesh boundary on {cad surface:surfaceValue} along axis {integer:varyingAxis} from {a 64 bit floating-point number:fromValue} over {a 64 bit floating-point number:periodValue} is collapsed at {a 64 bit floating-point number:fixedValue} within {a 64 bit floating-point number:linearTolerance}:
    execute:
        set firstParameters to the cad mesh vector2 with coordinate varyingAxis at fromValue and other fixedValue
        set originValue to the cad mesh point on surfaceValue at firstParameters
        loop stepIndex from 1 to 5:
            set parameters to the cad mesh vector2 firstParameters with coordinate varyingAxis set to (fromValue + ((periodValue * (stepIndex as a 64 bit floating-point number)) / 4.0))
            if ((the cad mesh distance from originValue to (the cad mesh point on surfaceValue at parameters)) <= linearTolerance) = false:
                return false
        return true

local function cad mesh rim {a pointer to a list:pointValues} winds monotonically along axis {integer:varyingAxis} over {a 64 bit floating-point number:periodValue}:
    execute:
        if (the length of pointValues) = 0:
            return false
        set traversalValue to (the cad mesh parameter varyingAxis of (the last item of pointValues)) - (the cad mesh parameter varyingAxis of (the item at 0 in pointValues))
        if ((the absolute value of traversalValue) < (periodValue * (1.0 - 1e-9))) or ((the absolute value of traversalValue) > (periodValue * (1.0 + 1e-9))):
            return false
        set increasing to traversalValue > 0.0
        set scaleValue to the maximum of periodValue and 1.0
        loop pointIndex from 0 to the length of pointValues:
            set scaleValue to the maximum of scaleValue and (the absolute value of (the cad mesh parameter varyingAxis of (the item at pointIndex in pointValues)))
        set epsilonValue to 2.842170943040401e-14 * scaleValue
        loop pointIndex from 1 to the length of pointValues:
            set deltaValue to (the cad mesh parameter varyingAxis of (the item at pointIndex in pointValues)) - (the cad mesh parameter varyingAxis of (the item at (pointIndex - 1) in pointValues))
            if increasing:
                if (deltaValue >= (the negative of epsilonValue)) = false:
                    return false
            else:
                if (deltaValue <= epsilonValue) = false:
                    return false
        return true

local function the cad mesh fixed parameter of rim {a pointer to a list:pointValues} along axis {integer:varyingAxis} at {a 64 bit floating-point number:value}:
    execute:
        set fixedAxis to 1 - varyingAxis
        loop pointIndex from 1 to the length of pointValues:
            set firstPoint to the item at (pointIndex - 1) in pointValues
            set secondPoint to the item at pointIndex in pointValues
            set fromValue to the cad mesh parameter varyingAxis of firstPoint
            set toValue to the cad mesh parameter varyingAxis of secondPoint
            set beforeRange to (value < fromValue) and ((cad mesh parameter value is near fromValue) = false)
            set afterRange to (value > toValue) and ((cad mesh parameter value is near toValue) = false)
            if (beforeRange or afterRange) = false:
                set spanValue to toValue - fromValue
                set firstFixed to the cad mesh parameter fixedAxis of firstPoint
                set secondFixed to the cad mesh parameter fixedAxis of secondPoint
                if cad mesh parameter spanValue is near 0.0:
                    return @intrinsic("construct", a cad mesh scalar result, true, 0.5 * (firstFixed + secondFixed))
                set unitValue to (value - fromValue) / spanValue
                clamp unitValue between 0.0 and 1.0
                return @intrinsic("construct", a cad mesh scalar result, true, firstFixed + ((secondFixed - firstFixed) * unitValue))
        return @intrinsic("construct", a cad mesh scalar result, false, 0.0)

# separated_rim_order: true when the first rim is below the second.
local function the cad mesh separated order of {a pointer to a list:firstRim} and {a pointer to a list:secondRim} along axis {integer:varyingAxis}:
    execute:
        set absentValue to @intrinsic("construct", a cad mesh flag result, false, false)
        set fixedAxis to 1 - varyingAxis
        set varyingValues to an empty list of a 64 bit floating-point number
        set scaleValue to 1.0
        loop pointIndex from 0 to the length of firstRim:
            append (the cad mesh parameter varyingAxis of (the item at pointIndex in firstRim)) to varyingValues
        loop pointIndex from 0 to the length of secondRim:
            append (the cad mesh parameter varyingAxis of (the item at pointIndex in secondRim)) to varyingValues
        loop pointIndex from 0 to the length of firstRim:
            set scaleValue to the maximum of scaleValue and (the absolute value of (the cad mesh parameter fixedAxis of (the item at pointIndex in firstRim)))
        loop pointIndex from 0 to the length of secondRim:
            set scaleValue to the maximum of scaleValue and (the absolute value of (the cad mesh parameter fixedAxis of (the item at pointIndex in secondRim)))
        set distinctValues to the cad mesh distinct sorted scalars from varyingValues
        free varyingValues
        set epsilonValue to 2.842170943040401e-14 * scaleValue
        set orderValue to absentValue
        loop valueIndex from 0 to the length of distinctValues:
            set probeValue to the item at valueIndex in distinctValues
            set secondFixed to the cad mesh fixed parameter of rim secondRim along axis varyingAxis at probeValue
            if secondFixed's valid = false:
                free distinctValues
                return absentValue
            set firstFixed to the cad mesh fixed parameter of rim firstRim along axis varyingAxis at probeValue
            if firstFixed's valid = false:
                free distinctValues
                return absentValue
            set deltaValue to secondFixed's value - firstFixed's value
            if (the absolute value of deltaValue) <= epsilonValue:
                free distinctValues
                return absentValue
            set currentValue to deltaValue > 0.0
            if orderValue's valid and (orderValue's value != currentValue):
                free distinctValues
                return absentValue
            set orderValue to @intrinsic("construct", a cad mesh flag result, true, currentValue)
        free distinctValues
        return orderValue

local function the cad mesh rotation of periodic rim {a pointer to a list:pointValues} along axis {integer:varyingAxis} from seam {a 64 bit floating-point number:seamValue} over {a 64 bit floating-point number:periodValue}:
    execute:
        set rotatedPoints to an empty list of a cad mesh boundary point
        set seamScale to the maximum of (the maximum of (the absolute value of seamValue) and (the absolute value of (seamValue + periodValue))) and 1.0
        loop pointIndex from 0 to the length of pointValues:
            set pointValue to the item at pointIndex in pointValues
            set rotatedValue to seamValue + (the cad mesh euclidean remainder of ((the cad mesh parameter varyingAxis of pointValue) - seamValue) by periodValue)
            if (the absolute value of ((rotatedValue - seamValue) - periodValue)) <= (2.842170943040401e-14 * seamScale):
                set rotatedValue to seamValue
            append (the cad mesh boundary point pointValue with parameter varyingAxis set to rotatedValue) to rotatedPoints
        sort cad mesh boundary points rotatedPoints along axis varyingAxis
        set outputPoints to an empty list of a cad mesh boundary point
        loop pointIndex from 0 to the length of rotatedPoints:
            set pointValue to the item at pointIndex in rotatedPoints
            set keepPoint to true
            if (the length of outputPoints) > 0:
                set currentValue to the cad mesh parameter varyingAxis of pointValue
                set keptValue to the cad mesh parameter varyingAxis of (the last item of outputPoints)
                set pairScale to the maximum of (the maximum of (the absolute value of currentValue) and (the absolute value of keptValue)) and 1.0
                if (the absolute value of (currentValue - keptValue)) <= (2.842170943040401e-14 * pairScale):
                    set keepPoint to false
            if keepPoint:
                append pointValue to outputPoints
        free rotatedPoints
        if (the length of outputPoints) = 0:
            free outputPoints
            return no cad mesh points
        set closingPoint to the item at 0 in outputPoints
        append (the cad mesh boundary point closingPoint with parameter varyingAxis set to ((the cad mesh parameter varyingAxis of closingPoint) + periodValue)) to outputPoints
        return the cad mesh points result of outputPoints

# fit_periodic_band rotates every rim to the first seam leaving all holes
# strictly inside one period. Rims and holes are replaced in place.
local function cad mesh fit periodic band of rims {a pointer to a list:rimValues} and holes {a pointer to a list:holeValues} along axis {integer:varyingAxis} over {a 64 bit floating-point number:periodValue}:
    execute:
        if (the length of rimValues) = 0:
            return false
        set firstRim to the item at 0 in rimValues
        set chosen to false
        set chosenSeam to 0.0
        set chosenShifts to an empty list of a 64 bit floating-point number
        set pointIndex to 0
        loop while (chosen = false) and (pointIndex < (the length of firstRim)):
            set seamValue to the cad mesh parameter varyingAxis of (the item at pointIndex in firstRim)
            set centreValue to seamValue + (periodValue * 0.5)
            set shiftValues to an empty list of a 64 bit floating-point number
            loop holeIndex from 0 to the length of holeValues:
                set middleValue to the cad mesh average parameter of (the item at holeIndex in holeValues) on axis varyingAxis
                append (periodValue * (the rounded value of ((centreValue - middleValue) / periodValue))) to shiftValues
            set fits to true
            loop holeIndex from 0 to the length of holeValues:
                if fits:
                    set holeValue to the item at holeIndex in holeValues
                    set shiftValue to the item at holeIndex in shiftValues
                    set lowValue to 1.7976931348623157e308 * 10.0
                    set highValue to -1.7976931348623157e308 * 10.0
                    loop holePoint from 0 to the length of holeValue:
                        set shiftedValue to (the cad mesh parameter varyingAxis of (the item at holePoint in holeValue)) + shiftValue
                        set lowValue to the minimum of lowValue and shiftedValue
                        set highValue to the maximum of highValue and shiftedValue
                    set seamScale to the maximum of (the maximum of (the absolute value of seamValue) and (the absolute value of (seamValue + periodValue))) and 1.0
                    set epsilonValue to 2.842170943040401e-14 * seamScale
                    set fits to (lowValue > (seamValue + epsilonValue)) and (highValue < ((seamValue + periodValue) - epsilonValue))
            if fits:
                set chosen to true
                set chosenSeam to seamValue
                free chosenShifts
                set chosenShifts to shiftValues
            else:
                free shiftValues
            set pointIndex to pointIndex + 1
        if chosen = false:
            free chosenShifts
            return false
        loop holeIndex from 0 to the length of holeValues:
            set holeValue to the item at holeIndex in holeValues
            set shiftValue to the item at holeIndex in chosenShifts
