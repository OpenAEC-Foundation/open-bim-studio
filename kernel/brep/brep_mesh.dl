        set singularRim to a list containing (@intrinsic("construct", a cad mesh boundary point, a cad vector2 with x baseValue and y apexValue, singularPosition))
        append (@intrinsic("construct", a cad mesh boundary point, a cad vector2 with x (baseValue + periodValue) and y apexValue, singularPosition)) to singularRim
        set rimFixed to the cad mesh average parameter of rimValue on axis fixedAxis
        set holeValues to an empty list of the type of (an empty list of a cad mesh boundary point)
        if rimFixed < apexValue:
            return the cad mesh band with low rimValue, high singularRim, holes holeValues, varying varyingAxis, strip false and structured false
        return the cad mesh band with low singularRim, high rimValue, holes holeValues, varying varyingAxis, strip false and structured false

local function the cad mesh scheduled winding band of {cad face key:faceKey} in {cad body:bodyValue} on {cad surface:surfaceValue} among {a pointer to a list:scheduleValues} within {a 64 bit floating-point number:linearTolerance}:
    execute:
        set faceNode to the cad node pointer for faceKey in bodyValue
        if faceNode = (0 as the type of faceNode):
            return no cad mesh band
        set faceValue to @intrinsic("dereference", faceNode)
        if (the length of ((faceValue's loops's values))) != 2:
            return no cad mesh band
        set ringValues to an empty list of the type of (an empty list of a cad mesh boundary point)
        loop loopIndex from 0 to 2:
            set loopKey to the item at loopIndex in ((faceValue's loops's values))
            set loopNode to the cad node pointer for loopKey in bodyValue
            if loopNode = (0 as the type of loopNode):
                cad mesh release rings ringValues
                return no cad mesh band
            if (the length of ((@intrinsic("dereference", loopNode))'s coedges's values)) = 0:
                cad mesh release rings ringValues
                return no cad mesh band
            set ringResult to the cad mesh scheduled loop loopKey in bodyValue on surfaceValue among scheduleValues within linearTolerance
            if ringResult's valid = false:
                cad mesh release rings ringValues
                return no cad mesh band
            append ringResult's values to ringValues
        set periodValues to the cad mesh periods of surfaceValue
        loop varyingAxis from 0 to 2:
            if cad mesh periodValues has period on axis varyingAxis:
                set periodValue to the cad mesh period of periodValues on axis varyingAxis
                set eligible to (cad mesh periodValues has period on axis (1 - varyingAxis)) = false
                if eligible:
                    loop ringIndex from 0 to 2:
                        if (cad mesh rim (the item at ringIndex in ringValues) winds monotonically along axis varyingAxis over periodValue) = false:
                            set eligible to false
                if eligible:
                    set firstRing to the item at 0 in ringValues
                    set secondRing to the item at 1 in ringValues
                    set firstTraversal to (the cad mesh parameter varyingAxis of (the last item of firstRing)) - (the cad mesh parameter varyingAxis of (the item at 0 in firstRing))
                    set secondTraversal to (the cad mesh parameter varyingAxis of (the last item of secondRing)) - (the cad mesh parameter varyingAxis of (the item at 0 in secondRing))
                    if (cad mesh sign of firstTraversal is positive) != (cad mesh sign of secondTraversal is positive):
                        set rimValues to the cad mesh copy of rings ringValues
                        cad mesh release rings ringValues
                        set noHoles to an empty list of the type of (an empty list of a cad mesh boundary point)
                        if (cad mesh fit periodic band of rims rimValues and holes noHoles along axis varyingAxis over periodValue) = false:
                            free noHoles
                            cad mesh release rings rimValues
                            return no cad mesh band
                        set orderResult to the cad mesh separated order of (the item at 0 in rimValues) and (the item at 1 in rimValues) along axis varyingAxis
                        if orderResult's valid = false:
                            free noHoles
                            cad mesh release rings rimValues
                            return no cad mesh band
                        set firstRim to the item at 0 in rimValues
                        set secondRim to the item at 1 in rimValues
                        free rimValues
                        if orderResult's value:
                            return the cad mesh band with low firstRim, high secondRim, holes noHoles, varying varyingAxis, strip true and structured false
                        return the cad mesh band with low secondRim, high firstRim, holes noHoles, varying varyingAxis, strip true and structured false
        cad mesh release rings ringValues
        return no cad mesh band

local function the cad mesh band of {cad face key:faceKey} in {cad body:bodyValue} on {cad surface:surfaceValue} among {a pointer to a list:scheduleValues} within {a 64 bit floating-point number:linearTolerance}:
    execute:
        # A refused attempt still owns its empty lists; release them before
        # the next attempt replaces it.
        set bandValue to the cad mesh scheduled band of faceKey in bodyValue on surfaceValue among scheduleValues within linearTolerance
        if bandValue's valid:
            return bandValue
        free cad mesh band bandValue
        set bandValue to the cad mesh scheduled periodic band of faceKey in bodyValue on surfaceValue among scheduleValues within linearTolerance
        if bandValue's valid:
            return bandValue
        free cad mesh band bandValue
        set bandValue to the cad mesh scheduled winding band of faceKey in bodyValue on surfaceValue among scheduleValues within linearTolerance
        if bandValue's valid:
            return bandValue
        free cad mesh band bandValue
        return the cad mesh scheduled singular band of faceKey in bodyValue on surfaceValue among scheduleValues within linearTolerance

# BoundaryBand::ring: the low rim followed by the reversed high rim.
local function the cad mesh ring of band {cad mesh boundary band:bandValue}:
    execute:
        set ringValue to the cad mesh copy of boundary points bandValue's low
        set highCount to the length of bandValue's high
        loop pointIndex from 0 to highCount:
            append (the item at ((highCount - 1) - pointIndex) in bandValue's high) to ringValue
        return ringValue

local function sample cad mesh parameter seam on {cad surface:surfaceValue} with fixed axis {integer:fixedAxis} at {a 64 bit floating-point number:fixedValue} from {a 64 bit floating-point number:fromValue} to {a 64 bit floating-point number:toValue} within angle {a 64 bit floating-point number:maxAngle} at depth {integer:depth} into {a pointer to a list:pointValues}:
    execute:
        set varyingAxis to 1 - fixedAxis
        set unitValues to the cad mesh nine units
        set parameterValues to an empty list of a cad vector2
        loop unitIndex from 0 to the length of unitValues:
            append (the cad mesh vector2 with coordinate varyingAxis at (fromValue + ((toValue - fromValue) * (the item at unitIndex in unitValues))) and other fixedValue) to parameterValues
        free unitValues
        set pathAngle to the cad mesh path angle on surfaceValue through parameterValues
        free parameterValues
        set splitValue to true
        if pathAngle's valid:
            set splitValue to cad mesh angle pathAngle's value exceeds maxAngle
        if splitValue:
            if depth >= 32:
                return false
            set middleValue to 0.5 * (fromValue + toValue)
            if (sample cad mesh parameter seam on surfaceValue with fixed axis fixedAxis at fixedValue from fromValue to middleValue within angle maxAngle at depth (depth + 1) into pointValues) = false:
                return false
            return sample cad mesh parameter seam on surfaceValue with fixed axis fixedAxis at fixedValue from middleValue to toValue within angle maxAngle at depth (depth + 1) into pointValues
        set parameters to the cad mesh vector2 with coordinate varyingAxis at fromValue and other fixedValue
        append (@intrinsic("construct", a cad mesh boundary point, parameters, the cad mesh point on surfaceValue at parameters)) to pointValues
        return true

local function the cad mesh parameter seam on {cad surface:surfaceValue} with fixed axis {integer:fixedAxis} from {cad mesh boundary point:fromPoint} to {cad mesh boundary point:toPoint} within angle {a 64 bit floating-point number:maxAngle}:
    execute:
        set fixedValue to 0.5 * ((the cad mesh parameter fixedAxis of fromPoint) + (the cad mesh parameter fixedAxis of toPoint))
        set varyingAxis to 1 - fixedAxis
        set pointValues to an empty list of a cad mesh boundary point
        if (sample cad mesh parameter seam on surfaceValue with fixed axis fixedAxis at fixedValue from (the cad mesh parameter varyingAxis of fromPoint) to (the cad mesh parameter varyingAxis of toPoint) within angle maxAngle at depth 0 into pointValues) = false:
            free pointValues
            return no cad mesh points
        set parameters to the cad mesh vector2 with coordinate varyingAxis at (the cad mesh parameter varyingAxis of toPoint) and other fixedValue
        append (@intrinsic("construct", a cad mesh boundary point, parameters, the cad mesh point on surfaceValue at parameters)) to pointValues
        return the cad mesh points result of pointValues

local function the cad mesh ring with seams of band {cad mesh boundary band:bandValue} on {cad surface:surfaceValue} within angle {a 64 bit floating-point number:maxAngle}:
    execute:
        if ((the length of bandValue's low) = 0) or ((the length of bandValue's high) = 0):
            return no cad mesh points
        set ringValue to the cad mesh copy of boundary points bandValue's low
        set endResult to the cad mesh parameter seam on surfaceValue with fixed axis bandValue's varying from (the last item of bandValue's low) to (the last item of bandValue's high) within angle maxAngle
        if endResult's valid = false:
            free ringValue
            return no cad mesh points
        loop pointIndex from 1 to ((the length of endResult's values) - 1):
            append (the item at pointIndex in endResult's values) to ringValue
        free endResult's values
        set highCount to the length of bandValue's high
        loop pointIndex from 0 to highCount:
            append (the item at ((highCount - 1) - pointIndex) in bandValue's high) to ringValue
        set startResult to the cad mesh parameter seam on surfaceValue with fixed axis bandValue's varying from (the item at 0 in bandValue's high) to (the item at 0 in bandValue's low) within angle maxAngle
        if startResult's valid = false:
            free ringValue
            return no cad mesh points
        loop pointIndex from 1 to ((the length of startResult's values) - 1):
            append (the item at pointIndex in startResult's values) to ringValue
        free startResult's values
        return the cad mesh points result of ringValue

local function the cad mesh face rings of {cad face key:faceKey} in {cad body:bodyValue} on {cad surface:surfaceValue} among {a pointer to a list:scheduleValues} within {a 64 bit floating-point number:linearTolerance}:
    execute:
        set periodValues to the cad mesh periods of surfaceValue
        set bandValue to the cad mesh band of faceKey in bodyValue on surfaceValue among scheduleValues within linearTolerance
        if bandValue's valid:
            set ringValues to an empty list of the type of (an empty list of a cad mesh boundary point)
            append (the cad mesh ring of band bandValue) to ringValues
            loop holeIndex from 0 to the length of bandValue's holes:
                append (the item at holeIndex in bandValue's holes) to ringValues
            free bandValue's low
            free bandValue's high
            free bandValue's holes
            align cad mesh rings ringValues with periodValues
            return @intrinsic("construct", a cad mesh rings result, true, ringValues)
        free cad mesh band bandValue
        set ringsResult to the cad mesh scheduled rings of faceKey in bodyValue on surfaceValue among scheduleValues within linearTolerance
        if ringsResult's valid:
            set hasArea to false
            loop ringIndex from 0 to the length of ringsResult's values:
                if cad mesh boundary (the item at ringIndex in ringsResult's values) has area:
                    set hasArea to true
            if hasArea:
                align cad mesh rings ringsResult's values with periodValues
                return ringsResult
            cad mesh release rings ringsResult's values
        return no cad mesh rings


class:
    patterns:
        [a|] cad mesh parameter cache
    members:
        table as a cad pair index
        room as an integer
        firstKeys as the type of (an empty list of a 64 bit integer)
        secondKeys as the type of (an empty list of a 64 bit integer)
        values as the type of (an empty list of a cad vector3)
        present as the type of (an empty list of a boolean)

class:
    patterns:
        [a|] cad mesh refinement
    members:
        valid as a boolean
        kind as an integer
        candidatePoint as a cad vector2

class:
    patterns:
        [a|] cad mesh grid lines
    members:
        valid as a boolean
        u as the type of (an empty list of a 64 bit floating-point number)
        v as the type of (an empty list of a 64 bit floating-point number)

class:
    patterns:
        [a|] cad mesh corners
    members:
        first as a cad vector2
        second as a cad vector2
        third as a cad vector2

class:
    patterns:
        [a|] cad mesh segment2
    members:
        start as a cad vector2
        end as a cad vector2

class:
    patterns:
        [a|] cad mesh count result
    members:
        valid as a boolean
        value as a 64 bit integer

# ParameterMap keys are the exact coordinate bit patterns.
local function the cad mesh key bits of {a 64 bit floating-point number:value}:
    execute:
        return the value at ((the address of value) as a pointer to a 64 bit integer)

local function an empty cad mesh parameter cache:
    execute:
        return @intrinsic("construct", a cad mesh parameter cache, a cad pair index with room for 64 entries, 64, an empty list of a 64 bit integer, an empty list of a 64 bit integer, an empty list of a cad vector3, an empty list of a boolean)

local function free cad mesh parameter cache {a pointer to a cad mesh parameter cache:cacheValue}:
    execute:
        free (the firstKeys of cacheValue)
        free (the secondKeys of cacheValue)
        free (the values of cacheValue)
        free (the present of cacheValue)

local function the cad mesh cached slot of {cad vector2:parameters} in {a pointer to a cad mesh parameter cache:cacheValue}:
    execute:
        return the cad pair value for key (the cad mesh key bits of parameters's x) and (the cad mesh key bits of parameters's y) in (the table of cacheValue)

local function remember cad mesh cached {cad vector3:value} present {boolean:presentValue} at {cad vector2:parameters} in {a pointer to a cad mesh parameter cache:cacheValue}:
    execute:
        set entryCount to the length of (the values of cacheValue)
        if entryCount >= (the room of cacheValue):
            set grownRoom to (the room of cacheValue) * 2
            set grownTable to a cad pair index with room for grownRoom entries
            loop entryIndex from 0 to entryCount:
                put cad pair value entryIndex for key (the item at entryIndex in (the firstKeys of cacheValue)) and (the item at entryIndex in (the secondKeys of cacheValue)) in grownTable
            set (the table of cacheValue) to grownTable
            set (the room of cacheValue) to grownRoom
        set firstKey to the cad mesh key bits of parameters's x
        set secondKey to the cad mesh key bits of parameters's y
        put cad pair value entryCount for key firstKey and secondKey in (the table of cacheValue)
        append firstKey to (the firstKeys of cacheValue)
        append secondKey to (the secondKeys of cacheValue)
        append value to (the values of cacheValue)
        append presentValue to (the present of cacheValue)

local function the cad mesh cached normal on {cad surface:surfaceValue} at {cad vector2:parameters} in {a pointer to a cad mesh parameter cache:cacheValue}:
    execute:
        set slotIndex to the cad mesh cached slot of parameters in cacheValue
        if slotIndex >= 0:
            return @intrinsic("construct", a cad normalization3, the item at slotIndex in (the present of cacheValue), the item at slotIndex in (the values of cacheValue))
        set normalResult to the cad mesh display normal of surfaceValue at parameters
        remember cad mesh cached normalResult's value present normalResult's valid at parameters in cacheValue
        return normalResult

local function the cad mesh cached normal angle on {cad surface:surfaceValue} through {a pointer to a list:parameterValues} in {a pointer to a cad mesh parameter cache:cacheValue}:
    execute:
        set normalValues to an empty list of a cad vector3
        if (the length of parameterValues) > 0:
            ensure enough capacity in normalValues for (the length of parameterValues) items
        loop parameterIndex from 0 to the length of parameterValues:
            set normalResult to the cad mesh cached normal on surfaceValue at (the item at parameterIndex in parameterValues) in cacheValue
            if normalResult's valid = false:
                free normalValues
                return @intrinsic("construct", a cad mesh scalar result, false, 0.0)
            append normalResult's value to normalValues
        set angleValue to the cad maximum direction angle of normalValues
        free normalValues
        return @intrinsic("construct", a cad mesh scalar result, true, angleValue)

local function the cad mesh corner {integer:cornerIndex} of {cad mesh corners:cornerValues}:
    execute:
        if cornerIndex = 0:
            return cornerValues's first
        if cornerIndex = 1:
            return cornerValues's second
        return cornerValues's third

local function the cad mesh corners {cad vector2:firstPoint}, {cad vector2:secondPoint} and {cad vector2:thirdPoint}:
    execute:
        return @intrinsic("construct", a cad mesh corners, firstPoint, secondPoint, thirdPoint)

local function the cad mesh edge parameters of {cad mesh corners:cornerValues} from {integer:fromIndex} to {integer:toIndex}:
    execute:
        set fromPoint to the cad mesh corner fromIndex of cornerValues
        set toPoint to the cad mesh corner toIndex of cornerValues
        set unitValues to the cad mesh five quarter units
        set parameterValues to an empty list of a cad vector2
        loop unitIndex from 0 to the length of unitValues:
            set unitValue to the item at unitIndex in unitValues
            append (a cad vector2 with x (fromPoint's x + ((toPoint's x - fromPoint's x) * unitValue)) and y (fromPoint's y + ((toPoint's y - fromPoint's y) * unitValue))) to parameterValues
        free unitValues
        return parameterValues

local function the cad mesh weighted point of {cad mesh corners:cornerValues} with {a 64 bit floating-point number:firstWeight}, {a 64 bit floating-point number:secondWeight} and {a 64 bit floating-point number:thirdWeight}:
    execute:
        set xValue to ((cornerValues's first's x * firstWeight) + (cornerValues's second's x * secondWeight)) + (cornerValues's third's x * thirdWeight)
        set yValue to ((cornerValues's first's y * firstWeight) + (cornerValues's second's y * secondWeight)) + (cornerValues's third's y * thirdWeight)
        return a cad vector2 with x xValue and y yValue

local function the cad mesh triangle samples of {cad mesh corners:cornerValues}:
    execute:
        set thirdValue to 1.0 / 3.0
        set parameterValues to a list containing (the cad mesh weighted point of cornerValues with 1.0, 0.0 and 0.0)
        append (the cad mesh weighted point of cornerValues with 0.0, 1.0 and 0.0) to parameterValues
        append (the cad mesh weighted point of cornerValues with 0.0, 0.0 and 1.0) to parameterValues
        append (the cad mesh weighted point of cornerValues with 0.5, 0.5 and 0.0) to parameterValues
        append (the cad mesh weighted point of cornerValues with 0.0, 0.5 and 0.5) to parameterValues
        append (the cad mesh weighted point of cornerValues with 0.5, 0.0 and 0.5) to parameterValues
        append (the cad mesh weighted point of cornerValues with thirdValue, thirdValue and thirdValue) to parameterValues
        append (the cad mesh weighted point of cornerValues with 0.5, 0.25 and 0.25) to parameterValues
        append (the cad mesh weighted point of cornerValues with 0.25, 0.5 and 0.25) to parameterValues
        append (the cad mesh weighted point of cornerValues with 0.25, 0.25 and 0.5) to parameterValues
        return parameterValues

local function the cad mesh triangle angle on {cad surface:surfaceValue} over {cad mesh corners:cornerValues}:
    execute:
        set parameterValues to the cad mesh triangle samples of cornerValues
        set angleResult to the cad mesh normal angle on surfaceValue through parameterValues
        free parameterValues
        return angleResult

local function the cad mesh cached triangle angle on {cad surface:surfaceValue} over {cad mesh corners:cornerValues} in {a pointer to a cad mesh parameter cache:cacheValue}:
    execute:
        set parameterValues to the cad mesh triangle samples of cornerValues
        set angleResult to the cad mesh cached normal angle on surfaceValue through parameterValues in cacheValue
        free parameterValues
        return angleResult

local function the cad mesh centroid of {cad mesh corners:cornerValues}:
    execute:
        return a cad vector2 with x (((cornerValues's first's x + cornerValues's second's x) + cornerValues's third's x) / 3.0) and y (((cornerValues's first's y + cornerValues's second's y) + cornerValues's third's y) / 3.0)

local function the cad mesh middle of {cad mesh corners:cornerValues} from {integer:fromIndex} to {integer:toIndex}:
    execute:
        set fromPoint to the cad mesh corner fromIndex of cornerValues
        set toPoint to the cad mesh corner toIndex of cornerValues
        return a cad vector2 with x (0.5 * (fromPoint's x + toPoint's x)) and y (0.5 * (fromPoint's y + toPoint's y))

local function the cad mesh chord of {cad mesh corners:cornerValues} from {integer:fromIndex} to {integer:toIndex} on {cad surface:surfaceValue}:
    execute:
        return the cad mesh distance from (the cad mesh point on surfaceValue at (the cad mesh corner fromIndex of cornerValues)) to (the cad mesh point on surfaceValue at (the cad mesh corner toIndex of cornerValues))

local function the cad mesh edge start {integer:edgeIndex}:
    execute:
        return edgeIndex

local function the cad mesh edge end {integer:edgeIndex}:
    execute:
        if edgeIndex = 2:
            return 0
        return edgeIndex + 1

local function cad mesh corners {cad mesh corners:cornerValues} are degenerate:
    execute:
        set coordinateScale to 1.0
        loop cornerIndex from 0 to 3:
            set cornerValue to the cad mesh corner cornerIndex of cornerValues
            set coordinateScale to the maximum of coordinateScale and (the absolute value of cornerValue's x)
            set coordinateScale to the maximum of coordinateScale and (the absolute value of cornerValue's y)
        loop axisIndex from 0 to 2:
            set lowValue to 1.7976931348623157e308 * 10.0
            set highValue to -1.7976931348623157e308 * 10.0
            loop cornerIndex from 0 to 3:
                set coordinateValue to the cad mesh coordinate axisIndex of (the cad mesh corner cornerIndex of cornerValues)
                set lowValue to the minimum of lowValue and coordinateValue
                set highValue to the maximum of highValue and coordinateValue
            if (highValue - lowValue) <= (2.842170943040401e-14 * coordinateScale):
                return true
        set abValue to the cad difference of cornerValues's second and cornerValues's first
        set acValue to the cad difference of cornerValues's third and cornerValues's first
        set scaleValue to 0.0
        set scaleValue to the maximum of scaleValue and (the absolute value of abValue's x)
        set scaleValue to the maximum of scaleValue and (the absolute value of abValue's y)
        set scaleValue to the maximum of scaleValue and (the absolute value of acValue's x)
        set scaleValue to the maximum of scaleValue and (the absolute value of acValue's y)
        return (the absolute value of ((abValue's x * acValue's y) - (abValue's y * acValue's x))) <= ((2.842170943040401e-14 * scaleValue) * scaleValue)

local function cad mesh corners {cad mesh corners:cornerValues} on {cad surface:surfaceValue} are within {a 64 bit floating-point number:linearTolerance}:
    execute:
        loop edgeIndex from 0 to 3:
            if (the cad mesh chord of cornerValues from (the cad mesh edge start edgeIndex) to (the cad mesh edge end edgeIndex) on surfaceValue) > linearTolerance:
                return false
        return true

local function the cad mesh path angle on {cad surface:surfaceValue} through {a pointer to a list:parameterValues}:
    execute:
        set absentValue to @intrinsic("construct", a cad mesh scalar result, false, 0.0)
        set positionValues to an empty list of a cad vector3
        set positionScale to 1.0
        loop parameterIndex from 0 to the length of parameterValues:
            set positionValue to the cad mesh point on surfaceValue at (the item at parameterIndex in parameterValues)
            append positionValue to positionValues
            set positionScale to the maximum of positionScale and (the absolute value of positionValue's x)
            set positionScale to the maximum of positionScale and (the absolute value of positionValue's y)
            set positionScale to the maximum of positionScale and (the absolute value of positionValue's z)
        set pathSpan to 0.0
        loop parameterIndex from 0 to the length of positionValues:
            set pathSpan to the maximum of pathSpan and (the cad mesh distance from (the item at 0 in positionValues) to (the item at parameterIndex in positionValues))
        free positionValues
        if pathSpan <= (2.2737367544323206e-13 * positionScale):
            return @intrinsic("construct", a cad mesh scalar result, true, 0.0)
        if (the length of parameterValues) = 0:
            return absentValue
        set firstParameters to the item at 0 in parameterValues
        set lastParameters to the last item of parameterValues
        set deltaValue to the cad difference of lastParameters and firstParameters
        set lengthValue to @intrinsic("call", "libc", "hypot", a 64 bit floating-point number, deltaValue's x, deltaValue's y)
        set uTangents to an empty list of a cad vector3
        set vTangents to an empty list of a cad vector3
        loop parameterIndex from 0 to the length of parameterValues:
            set parameters to the item at parameterIndex in parameterValues
            set tangentResult to the cad tangents of surfaceValue at parameters parameters's x and parameters's y
            if tangentResult's valid = false:
                free uTangents
                free vTangents
                return absentValue
            append tangentResult's u to uTangents
            append tangentResult's v to vTangents
        set normalAngle to the cad mesh normal angle on surfaceValue through parameterValues
        if normalAngle's valid = false:
            free uTangents
            free vTangents
            return absentValue
        set largestValue to normalAngle's value
        if lengthValue <= 2.2250738585072014e-308:
            free uTangents
            free vTangents
            return @intrinsic("construct", a cad mesh scalar result, true, largestValue)
        set directionX to deltaValue's x / lengthValue
        set directionY to deltaValue's y / lengthValue
        set tangentScale to 0.0
        loop parameterIndex from 0 to the length of uTangents:
            set tangentScale to the maximum of tangentScale and (the cad dot of (the item at parameterIndex in uTangents) and (the item at parameterIndex in uTangents))
            set tangentScale to the maximum of tangentScale and (the cad dot of (the item at parameterIndex in vTangents) and (the item at parameterIndex in vTangents))
        set tangentCutoff to tangentScale * 1e-28
        set directionValues to an empty list of a cad vector3
        loop parameterIndex from 0 to the length of uTangents:
            set directionValue to the cad sum of ((the item at parameterIndex in uTangents) scaled by directionX) and ((the item at parameterIndex in vTangents) scaled by directionY)
            if (cad directionValue is finite) and ((the cad dot of directionValue and directionValue) > tangentCutoff):
                append directionValue to directionValues
        set largestValue to the maximum of largestValue and (the cad maximum direction angle of directionValues)
        free directionValues
        free uTangents
        free vTangents
        return @intrinsic("construct", a cad mesh scalar result, true, largestValue)

# The surface point for a parameter, preferring an exact pinned boundary sample.
local function the cad mesh canonical point on {cad surface:surfaceValue} at {cad vector2:parameters} among {a pointer to a list:pinValues}:
    execute:
        loop pinIndex from 0 to the length of pinValues:
            set pinValue to the item at pinIndex in pinValues
            if (pinValue's parameters's x = parameters's x) and (pinValue's parameters's y = parameters's y):
                return pinValue's position
        return the cad mesh point on surfaceValue at parameters

local function the cad mesh cached point on {cad surface:surfaceValue} at {cad vector2:parameters} among {a pointer to a list:pinValues} in {a pointer to a cad mesh parameter cache:cacheValue}:
    execute:
        loop pinIndex from 0 to the length of pinValues:
            set pinValue to the item at pinIndex in pinValues
            if (pinValue's parameters's x = parameters's x) and (pinValue's parameters's y = parameters's y):
                return pinValue's position
        set slotIndex to the cad mesh cached slot of parameters in cacheValue
        if slotIndex >= 0:
            return the item at slotIndex in (the values of cacheValue)
        set pointValue to the cad mesh point on surfaceValue at parameters
        remember cad mesh cached pointValue present true at parameters in cacheValue
        return pointValue

local function emit cad mesh points {cad vector3:firstPoint}, {cad vector3:secondPoint} and {cad vector3:thirdPoint} with normals {cad normalization3:firstStored}, {cad normalization3:secondStored} and {cad normalization3:thirdStored} on face {cad face:faceValue} into {a pointer to a cad mesh:meshValue}:
    execute:
        set faceNormal to the cad normalization of (the cad cross of (the cad difference of secondPoint and firstPoint) and (the cad difference of thirdPoint and firstPoint))
        if faceNormal's valid = false:
            return nothing
        set storedValues to a list containing firstStored
        append secondStored to storedValues
        append thirdStored to storedValues
        set normalValues to an empty list of a cad vector3
        loop cornerIndex from 0 to 3:
            set normalValue to faceNormal's value
            set storedValue to the item at cornerIndex in storedValues
            if storedValue's valid:
                set unitNormal to the cad normalization of storedValue's value
                if unitNormal's valid:
                    set normalValue to unitNormal's value
            if faceValue's forward = false:
                set normalValue to the cad negative of normalValue
            append normalValue to normalValues
        free storedValues
        if faceValue's forward:
            cad mesh append triangle from firstPoint through secondPoint to thirdPoint with normals (the item at 0 in normalValues) (the item at 1 in normalValues) (the item at 2 in normalValues) into meshValue
        else:
