            set wantedDistance to (totalLength * (sampleIndex as a 64 bit floating-point number)) / (divisorValue as a 64 bit floating-point number)
            set segmentIndex to 0
            loop while ((segmentIndex + 1) < (the length of walkedValues)) and ((the item at (segmentIndex + 1) in walkedValues) <= wantedDistance):
                set segmentIndex to segmentIndex + 1
            if segmentIndex >= ((the length of chainPoints) - 1):
                set segmentIndex to (the length of chainPoints) - 2
            set segmentLength to (the item at (segmentIndex + 1) in walkedValues) - (the item at segmentIndex in walkedValues)
            set segmentUnit to 0.0
            if segmentLength > 0.0:
                set segmentUnit to (wantedDistance - (the item at segmentIndex in walkedValues)) / segmentLength
            append (the cad lerp from (the item at segmentIndex in chainPoints) to (the item at (segmentIndex + 1) in chainPoints) at segmentUnit) to outputPoints
        free chainPoints
        free walkedValues
        return outputPoints

local function the cad surface mesh from {a pointer to a list:sectionValues} closed {boolean:closedValue}:
    execute:
        set outputMesh to an empty cad mesh
        set edgeValues to an empty list of the type of (an empty list of a cad vector3)
        loop sectionIndex from 1 to the length of sectionValues:
            append cad surface mesh band from (the item at (sectionIndex - 1) in sectionValues) to (the item at sectionIndex in sectionValues) closed closedValue into (the address of outputMesh)
        if (the length of sectionValues) = 0:
            return the cad owned surface mesh from outputMesh with edges edgeValues
        set firstSection to the cad surface mesh copy of (the item at 0 in sectionValues)
        set lastSection to the cad surface mesh copy of (the last item of sectionValues)
        if closedValue and ((the length of firstSection) > 0):
            append (the item at 0 in firstSection) to firstSection
            append (the item at 0 in lastSection) to lastSection
        append firstSection to edgeValues
        append lastSection to edgeValues
        if closedValue = false:
            set firstSide to an empty list of a cad vector3
            set lastSide to an empty list of a cad vector3
            loop sectionIndex from 0 to the length of sectionValues:
                set sectionValue to the item at sectionIndex in sectionValues
                if (the length of sectionValue) > 0:
                    append (the item at 0 in sectionValue) to firstSide
                    append (the last item of sectionValue) to lastSide
            if (the length of firstSide) >= 2:
                append firstSide to edgeValues
            else:
                free firstSide
            if (the length of lastSide) >= 2:
                append lastSide to edgeValues
            else:
                free lastSide
        return the cad owned surface mesh from outputMesh with edges edgeValues

local function free cad surface mesh sections {a pointer to a list:sectionValues}:
    execute:
        loop sectionIndex from 0 to the length of sectionValues:
            free (the item at sectionIndex in sectionValues)
        free sectionValues

function the cad swept surface of {cad planar curve3:profileValue} along {cad planar curve3:pathValue} with maximum angle {a number:requestedAngle}:
    execute:
        if pathValue is cad closed:
            return no cad surface mesh result
        set maxAngle to the cad sampling angle for (requestedAngle as a 64 bit floating-point number)
        set closedValue to profileValue is cad closed
        set outlinePoints to cad surface mesh open samples of profileValue within angle maxAngle
        set trackPoints to cad surface mesh open samples of pathValue within angle maxAngle
        if ((the length of outlinePoints) < 2) or ((the length of trackPoints) < 2):
            free outlinePoints
            free trackPoints
            return no cad surface mesh result
        set trackOrigin to the item at 0 in trackPoints
        set sectionValues to an empty list of the type of (an empty list of a cad vector3)
        loop trackIndex from 0 to the length of trackPoints:
            set shiftValue to the cad difference of (the item at trackIndex in trackPoints) and trackOrigin
            set sectionPoints to an empty list of a cad vector3
            loop outlineIndex from 0 to the length of outlinePoints:
                append (the cad sum of (the item at outlineIndex in outlinePoints) and shiftValue) to sectionPoints
            append sectionPoints to sectionValues
        set surfaceValue to the cad surface mesh from sectionValues closed closedValue
        if closedValue:
            append cad surface mesh cap on profileValue's plane around (the item at 0 in sectionValues) reversed true into (the address of surfaceValue's mesh)
            set farOrigin to the cad sum of profileValue's plane's origin and (the cad difference of (the item at 0 in (the last item of sectionValues)) and (the item at 0 in (the item at 0 in sectionValues)))
            set farPlane to a cad plane with origin farOrigin, x axis profileValue's plane's xAxis and y axis profileValue's plane's yAxis
            append cad surface mesh cap on farPlane around (the last item of sectionValues) reversed false into (the address of surfaceValue's mesh)
        free outlinePoints
        free trackPoints
        free cad surface mesh sections sectionValues
        return @intrinsic("construct", a cad surface mesh result, true, surfaceValue)

function the cad lofted surface through {a pointer to a list:profileValues} with maximum angle {a number:requestedAngle}:
    execute:
        if (the length of profileValues) < 2:
            return no cad surface mesh result
        set maxAngle to the cad sampling angle for (requestedAngle as a 64 bit floating-point number)
        set closedValue to true
        set sampledValues to an empty list of the type of (an empty list of a cad vector3)
        set largestCount to 0
        loop profileIndex from 0 to the length of profileValues:
            set profileValue to the item at profileIndex in profileValues
            if (profileValue is cad closed) = false:
                set closedValue to false
            set sampledPoints to cad surface mesh open samples of profileValue within angle maxAngle
            set largestCount to the maximum of largestCount and (the length of sampledPoints)
            append sampledPoints to sampledValues
        if largestCount < 2:
            free cad surface mesh sections sampledValues
            return no cad surface mesh result
        loop sampledIndex from 0 to the length of sampledValues:
            if (the length of (the item at sampledIndex in sampledValues)) < 2:
                free cad surface mesh sections sampledValues
                return no cad surface mesh result
        set sectionValues to an empty list of the type of (an empty list of a cad vector3)
        loop sampledIndex from 0 to the length of sampledValues:
            append (the cad surface mesh resampling of (the item at sampledIndex in sampledValues) to largestCount points closed closedValue) to sectionValues
        set surfaceValue to the cad surface mesh from sectionValues closed closedValue
        if closedValue:
            set firstProfile to the item at 0 in profileValues
            set lastProfile to the last item of profileValues
            append cad surface mesh cap on firstProfile's plane around (the item at 0 in sectionValues) reversed true into (the address of surfaceValue's mesh)
            append cad surface mesh cap on lastProfile's plane around (the last item of sectionValues) reversed false into (the address of surfaceValue's mesh)
        free cad surface mesh sections sampledValues
        free cad surface mesh sections sectionValues
        return @intrinsic("construct", a cad surface mesh result, true, surfaceValue)

class:
    patterns:
        [a|] cad silhouette side
