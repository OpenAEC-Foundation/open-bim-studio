            set previousSecond to the cad mesh vector2 apexPoint's parameters with coordinate varyingAxis set to (the cad mesh coordinate varyingAxis of secondRim)
            set rimFixed to 0.5 * ((the cad mesh coordinate fixedAxis of firstRim) + (the cad mesh coordinate fixedAxis of secondRim))
