            set firstPoint to secondPoint
            set secondPoint to pointSwap
            set positionSwap to storedFirst
            set storedFirst to storedSecond
            set storedSecond to positionSwap
        set firstIdentity to the cad silhouette identity of grid point firstPoint in tables
        set secondIdentity to the cad silhouette identity of grid point secondPoint in tables
        set segmentIdentity to the cad silhouette identity of (firstIdentity as a 64 bit integer) and (secondIdentity as a 64 bit integer) in (the segments of tables) counting slot 2 among (the counts of tables)
        set previousIndex to the cad pair value for key groupValue and (segmentIdentity as a 64 bit integer) in (the grouped of tables)
        if previousIndex >= 0:
            set previousValue to the item at previousIndex in openValues
            if previousValue's active:
                append (@intrinsic("construct", a cad silhouette side, previousValue's firstPosition, previousValue's secondPosition, previousValue's normal, normalValue)) to sideValues
                set previousValue's active to false
                replace item at index previousIndex in openValues with previousValue
