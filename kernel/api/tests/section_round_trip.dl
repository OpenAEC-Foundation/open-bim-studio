# SPDX-License-Identifier: MPL-2.0
# The planar section and the plane slice across the kernel seam (module split
# plan, phase E, step 3): a 1 by 2 by 3 box cut by the plane at height 1.5
# gives one section loop of four points, and a slice into two sides whose
# volumes add up to the box's.
import lib/std.dl
import lib/string.dl
import kernel/core/core.dl
import kernel/core/plane.dl
import kernel/core/curve2.dl
import kernel/api/kernel.dl

function the test volume of {kernel body:body}:
    execute:
        set meshValue to the kernel mesh of body with maximum angle 0.3 within 0.001
        set properties to the kernel mass properties of meshValue
        if properties's valid = false:
            return 0.0 - 1.0
        return properties's value's volume

function {a 64 bit floating-point number:value} is near {a 64 bit floating-point number:expected}:
    execute:
        return ((value - expected) < 0.000001) and ((value - expected) > (0.0 - 0.000001))

set a to a cad vector2 with x 0.0 and y 0.0
set b to a cad vector2 with x 1.0 and y 0.0
set c to a cad vector2 with x 1.0 and y 2.0
set d to a cad vector2 with x 0.0 and y 2.0
set chain to an empty list of a cad curve2
append (the cad curve2 of (a cad line2 from a to b)) to chain
append (the cad curve2 of (a cad line2 from b to c)) to chain
append (the cad curve2 of (a cad line2 from c to d)) to chain
append (the cad curve2 of (a cad line2 from d to a)) to chain
set box to (the kernel extrusion of chain on (the cad xy plane) along (a cad vector3 with x 0.0, y 0.0 and z 3.0))'s value
set cut to the cad xy plane
set cut's origin to a cad vector3 with x 0.0, y 0.0 and z 1.5

set sectioned to the kernel plane section of box by cut
if sectioned's valid:
    print ((the string form of "section loops: ") + (the string form of (the length of (sectioned's loops's values)))) as a line
    if (the length of (sectioned's loops's values)) > 0:
        print ((the string form of "first loop points: ") + (the string form of (the length of ((the item at 0 in (sectioned's loops's values))'s values)))) as a line
else:
    print (the string form of "section refused") as a line

set sliced to the kernel plane slice of box by cut
if sliced's valid and sliced's divided:
    print (the string form of "slice divided: yes") as a line
    if ((the test volume of sliced's negative) + (the test volume of sliced's positive)) is near 6.0:
        print (the string form of "slice volumes add up: yes") as a line
    else:
        print (the string form of "slice volumes add up: no") as a line
else:
    print (the string form of "slice divided: no") as a line
