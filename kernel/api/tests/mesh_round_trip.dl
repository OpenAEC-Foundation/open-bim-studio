# SPDX-License-Identifier: MPL-2.0
# The mesh round trip of the kernel seam (module split plan, phase E, step
# 2): the library fills a unit cube's mesh into this program's storage through
# the C ABI; the same cube made here from the shared source must agree on the
# counts, and the mesh must weigh one cubic metre, which proves that both
# units lower the shared `cad mesh` (kernel/api/types.dl) to one layout. The
# symbol is the compiler's for the exposed function in kernel/api/exposed.dl.
import lib/std.dl
import lib/string.dl
import kernel/api/types.dl
import kernel/brep/brep_make.dl
import kernel/brep/brep_mesh.dl

set theirs to an empty cad mesh
@intrinsic("destroy at", the address of theirs)
@intrinsic("call", "obskernel", "initialize_obskernel_unit_cube_mesh_at_3a_pointer_to_a_cad_mesh8target5_with_maximum_angle_3a_64_bit_floating5point_number8angle5_within_3a_64_bit_floating5point_number8tolerance5_callable_cad_20_mesh_2a__f64_f64", nothing, the address of theirs, 0.3, 0.001)

set made to the cad cuboid at (a cad vector3 with x 0.0, y 0.0 and z 0.0) with size (a cad vector3 with x 1.0, y 1.0 and z 1.0)
set mine to the cad mesh of made's value with maximum angle 0.3 within 0.001

if (the length of theirs's triangles) = (the length of mine's triangles):
    print (the string form of "triangles equal: yes") as a line
else:
    print (the string form of "triangles equal: no") as a line
if (the length of theirs's positions) = (the length of mine's positions):
    print (the string form of "positions equal: yes") as a line
else:
    print (the string form of "positions equal: no") as a line
if (the length of theirs's triangles) > 0:
    print (the string form of "triangles present: yes") as a line
else:
    print (the string form of "triangles present: no") as a line

set properties to the cad mass properties of theirs
if properties's valid:
    set volume to properties's value's volume
    if ((volume - 1.0) < 0.000000001) and ((volume - 1.0) > (0.0 - 0.000000001)):
        print (the string form of "volume: 1") as a line
    else:
        print (the string form of "volume: other") as a line
else:
    print (the string form of "volume: invalid") as a line
