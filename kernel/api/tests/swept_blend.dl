# SPDX-License-Identifier: MPL-2.0
# The swept blend across the kernel seam (issue #115): one profile per path
# vertex. Two squares along one line give the frustum; three squares along
# an L blend segment by segment through the mitered middle section, with the
# end faces in the start and end frames; equal profiles give the mitered
# sweep; four circles along a U (the path turns away from its chord) blend
# per segment and join. Every body is closed (no flaws); the volumes are
# analytic because each profile has its centroid on the path. Mismatched
# profile counts, open profiles, profiles of different curve counts and arcs
# in the path are refused with their reason.
import lib/std.dl
import lib/string.dl
import kernel/core/core.dl
import kernel/core/plane.dl
import kernel/core/curve2.dl
import kernel/api/kernel.dl

function the test square {a 64 bit floating-point number:side}:
    execute:
        set half to side / 2.0
        set a to a cad vector2 with x (0.0 - half) and y (0.0 - half)
        set b to a cad vector2 with x half and y (0.0 - half)
        set c to a cad vector2 with x half and y half
        set d to a cad vector2 with x (0.0 - half) and y half
        set chain to an empty list of a cad curve2
        append (the cad curve2 of (a cad line2 from a to b)) to chain
        append (the cad curve2 of (a cad line2 from b to c)) to chain
        append (the cad curve2 of (a cad line2 from c to d)) to chain
        append (the cad curve2 of (a cad line2 from d to a)) to chain
        return chain

# A circle of four quarter arcs about the frame's origin.
function the test circle {a 64 bit floating-point number:radius}:
    execute:
        set centre to the cad zero vector2
        set quarter to 1.5707963267948966
        set chain to an empty list of a cad curve2
        loop step from 0 to 4:
            set turnStart to (step as a 64 bit floating-point number) * quarter
            append (the cad curve2 of (a cad arc2 at centre with radius radius from turnStart to (turnStart + quarter))) to chain
        return chain

function the test volume of {kernel body:body}:
    execute:
        set meshValue to the kernel mesh of body with maximum angle 0.05 within 0.0001
        set properties to the kernel mass properties of meshValue
        if properties's valid = false:
            return 0.0 - 1.0
        return properties's value's volume

function {a 64 bit floating-point number:value} is within {a 64 bit floating-point number:fraction} of {a 64 bit floating-point number:expected}:
    execute:
        return (the absolute value of (value - expected)) <= (fraction * (the absolute value of expected))

function report {kernel sweep result:made} as {a string:label} weighing {a 64 bit floating-point number:expected} within {a 64 bit floating-point number:fraction}:
    execute:
        if made's valid = false:
            print ((label + (the string form of ": refused, snag ")) + (the string form of made's snag)) as a line
            return nothing
        print ((label + (the string form of ": flaws ")) + (the string form of (the kernel flaw count of made's value))) as a line
        set volume to the test volume of made's value
        if volume is within fraction of expected:
            print (label + (the string form of ": volume as expected")) as a line
        else:
            print ((((label + (the string form of ": volume ")) + (the string form of volume)) + (the string form of " instead of ")) + (the string form of expected)) as a line

function report refusal {kernel sweep result:made} as {a string:label} expecting {integer:reason}:
    execute:
        if made's valid:
            print (label + (the string form of ": built, expected a refusal")) as a line
        else if made's snag = reason:
            print (label + (the string form of ": refused for the expected reason")) as a line
        else:
            print ((label + (the string form of ": refused, snag ")) + (the string form of made's snag)) as a line

# The area of the body's face lying on `plane`, when exactly one does.
function the test end face area of {kernel body:body} on {cad plane:plane}:
    execute:
        set capped to the kernel coplanar face loops of body on plane
        if (capped's valid = false) or ((the length of (capped's loops's values)) != 1):
            return 0.0 - 1.0
        set loopPoints to (the item at 0 in (capped's loops's values))'s values
        set twice to the cad zero vector3
        loop cursor from 0 to the length of loopPoints:
            set next to the remainder of (cursor + 1) divided by (the length of loopPoints)
            set twice to the cad sum of twice and (the cad cross of (the item at cursor in loopPoints) and (the item at next in loopPoints))
        return (the cad length of twice) / 2.0

set plane to the cad xy plane
set beginning to the cad zero vector2
set corner to a cad vector2 with x 4.0 and y 0.0
set far to a cad vector2 with x 4.0 and y 3.0

# Two profiles along one line of 4 m: 1 by 1 to 0.5 by 0.5, the frustum
# h / 3 (A1 + A2 + sqrt(A1 A2)) = 4 / 3 x 1.75.
set straight to an empty list of a cad curve2
append (the cad curve2 of (a cad line2 from beginning to corner)) to straight
set pair to an empty list of the type of (an empty list of a cad curve2)
append (the test square 1.0) to pair
append (the test square 0.5) to pair
report (the kernel swept blend of pair along straight on plane) as (the string form of "two squares along a line") weighing ((4.0 / 3.0) * 1.75) within 0.000001

# Three profiles along an L (4 m along x, 3 m along y): 1 to 0.5 to 0.25.
# Each segment weighs its frustum: 4 / 3 x 1.75 + 3 / 3 x 0.4375.
set bend to an empty list of a cad curve2
append (the cad curve2 of (a cad line2 from beginning to corner)) to bend
append (the cad curve2 of (a cad line2 from corner to far)) to bend
set three to an empty list of the type of (an empty list of a cad curve2)
append (the test square 1.0) to three
append (the test square 0.5) to three
append (the test square 0.25) to three
set blended to the kernel swept blend of three along bend on plane
report blended as (the string form of "three squares along an L") weighing (((4.0 / 3.0) * 1.75) + 0.4375) within 0.000001
set startPlane to a cad plane with origin (the cad zero vector3), x axis (the cad y axis) and y axis (the cad z axis)
set endPlane to a cad plane with origin (a cad vector3 with x 4.0, y 3.0 and z 0.0), x axis (the cad x axis) and y axis (the cad z axis)
if blended's valid:
    if ((the test end face area of blended's value on startPlane) is within 0.000001 of 1.0) and ((the test end face area of blended's value on endPlane) is within 0.000001 of 0.0625):
        print (the string form of "three squares along an L: end faces 1 by 1 at the start, 0.25 by 0.25 at the end") as a line
    else:
        print (the string form of "three squares along an L: end faces misplaced") as a line

# Equal profiles give the mitered sweep of that profile.
set equal to an empty list of the type of (an empty list of a cad curve2)
append (the test square 0.5) to equal
append (the test square 0.5) to equal
append (the test square 0.5) to equal
set equalBlend to the kernel swept blend of equal along bend on plane
set equalSquare to the test square 0.5
set swept to the kernel sweep of equalSquare on ((the kernel sweep frame of bend on plane)'s value) following bend on plane
if (equalBlend's valid and swept's valid) and ((the test volume of equalBlend's value) is within 0.000001 of (the test volume of swept's value)):
    print (the string form of "equal squares along an L: the mitered sweep's volume") as a line
else:
    print (the string form of "equal squares along an L: differs from the sweep") as a line

# Four circles along a U (4, 3 and 4 m): radius 0.5, 0.4, 0.3, 0.2. The
# segments weigh pi h / 3 (R^2 + R r + r^2) each.
set u to an empty list of a cad curve2
append (the cad curve2 of (a cad line2 from beginning to corner)) to u
append (the cad curve2 of (a cad line2 from corner to far)) to u
append (the cad curve2 of (a cad line2 from far to (a cad vector2 with x 0.0 and y 3.0))) to u
set circles to an empty list of the type of (an empty list of a cad curve2)
append (the test circle 0.5) to circles
append (the test circle 0.4) to circles
append (the test circle 0.3) to circles
append (the test circle 0.2) to circles
set frusta to ((4.0 / 3.0) * 0.61) + (0.37 + ((4.0 / 3.0) * 0.19))
report (the kernel swept blend of circles along u on plane) as (the string form of "four circles along a U") weighing (3.141592653589793 * frusta) within 0.001

# Refusals.
report refusal (the kernel swept blend of pair along bend on plane) as (the string form of "two profiles on a two-segment path") expecting (kernel sweep snag section count)
set openThree to an empty list of the type of (an empty list of a cad curve2)
append (the test square 1.0) to openThree
set gap to the test square 0.5
remove item 3 from gap
append gap to openThree
append (the test square 0.25) to openThree
report refusal (the kernel swept blend of openThree along bend on plane) as (the string form of "an open middle profile") expecting (kernel sweep snag open profile)
set mixed to an empty list of a cad curve2
append (the cad curve2 of (a cad line2 from (a cad vector2 with x (0.0 - 0.5) and y (0.0 - 0.5)) to (a cad vector2 with x 0.5 and y (0.0 - 0.5)))) to mixed
append (the cad curve2 of (a cad line2 from (a cad vector2 with x 0.5 and y (0.0 - 0.5)) to (a cad vector2 with x 0.0 and y 0.5))) to mixed
append (the cad curve2 of (a cad line2 from (a cad vector2 with x 0.0 and y 0.5) to (a cad vector2 with x (0.0 - 0.5) and y (0.0 - 0.5)))) to mixed
set squareAndTriangle to an empty list of the type of (an empty list of a cad curve2)
append (the test square 1.0) to squareAndTriangle
append mixed to squareAndTriangle
report refusal (the kernel swept blend of squareAndTriangle along straight on plane) as (the string form of "a square and a triangle") expecting (kernel sweep snag profile mismatch)
set arced to an empty list of a cad curve2
append (the cad curve2 of (a cad line2 from beginning to corner)) to arced
append (the cad curve2 of (a cad arc2 at (a cad vector2 with x 4.0 and y 2.0) with radius 2.0 from 4.71238898038469 to 6.283185307179586)) to arced
report refusal (the kernel swept blend of three along arced on plane) as (the string form of "an arc in the path") expecting (kernel sweep snag path curve)
