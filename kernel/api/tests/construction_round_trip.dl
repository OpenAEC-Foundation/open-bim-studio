# SPDX-License-Identifier: MPL-2.0
# The constructions across the kernel seam (module split plan, phase E, step
# 3): a sphere, a cylinder and a faceted solid made in the library and held by
# handle must weigh what the same constructions weigh when made from the
# shared source in this program, at the same mesh tolerance.
import lib/std.dl
import lib/string.dl
import kernel/core/core.dl
import kernel/api/kernel.dl
import kernel/brep/brep_make.dl
import kernel/brep/brep_mesh.dl

function the test volume of {kernel body:body}:
    execute:
        set meshValue to the kernel mesh of body with maximum angle 0.3 within 0.001
        set properties to the kernel mass properties of meshValue
        if properties's valid = false:
            return 0.0 - 1.0
        return properties's value's volume

function the shared volume of {cad body result:made}:
    execute:
        if made's valid = false:
            return 0.0 - 2.0
        set properties to the cad mass properties of (the cad mesh of made's value with maximum angle 0.3 within 0.001)
        if properties's valid = false:
            return 0.0 - 3.0
        return properties's value's volume

function {a 64 bit floating-point number:value} is near {a 64 bit floating-point number:expected}:
    execute:
        return ((value - expected) < 0.000001) and ((value - expected) > (0.0 - 0.000001))

function report {a string:label} comparing {a 64 bit floating-point number:ours} with {a 64 bit floating-point number:theirs}:
    execute:
        if ours is near theirs:
            print (label + (the string form of ": equal")) as a line
        else:
            print (((label + (the string form of ": differ ")) + (the string form of ours)) + ((the string form of " vs ") + (the string form of theirs))) as a line

set centre to a cad vector3 with x 1.0, y 2.0 and z 3.0
report (the string form of "sphere") comparing (the test volume of (the kernel sphere body at centre with radius 1.0)) with (the shared volume of (the cad sphere body at centre with radius 1.0))
report (the string form of "cylinder") comparing (the test volume of (the kernel cylinder body at centre with radius 1.0 and height 2.0)) with (the shared volume of (the cad cylinder body at centre with radius 1.0 and height 2.0))

# A unit cube as a faceted solid: eight corners, six quads in the flat
# encoding (count, then indices), outward winding.
set corners to an empty list of a cad vector3
append (a cad vector3 with x 0.0, y 0.0 and z 0.0) to corners
append (a cad vector3 with x 1.0, y 0.0 and z 0.0) to corners
append (a cad vector3 with x 1.0, y 1.0 and z 0.0) to corners
append (a cad vector3 with x 0.0, y 1.0 and z 0.0) to corners
append (a cad vector3 with x 0.0, y 0.0 and z 1.0) to corners
append (a cad vector3 with x 1.0, y 0.0 and z 1.0) to corners
append (a cad vector3 with x 1.0, y 1.0 and z 1.0) to corners
append (a cad vector3 with x 0.0, y 1.0 and z 1.0) to corners
set faces to an empty list of an integer
loop cursor from 0 to 36:
    append 0 to faces
set encoding to an empty list of an integer
append 4 to encoding
append 0 to encoding
append 3 to encoding
append 2 to encoding
append 1 to encoding
append 4 to encoding
append 4 to encoding
append 5 to encoding
append 6 to encoding
append 7 to encoding
append 4 to encoding
append 0 to encoding
append 1 to encoding
append 5 to encoding
append 4 to encoding
append 4 to encoding
append 1 to encoding
append 2 to encoding
append 6 to encoding
append 5 to encoding
append 4 to encoding
append 2 to encoding
append 3 to encoding
append 7 to encoding
append 6 to encoding
append 4 to encoding
append 3 to encoding
append 0 to encoding
append 4 to encoding
append 7 to encoding
set cube to the kernel faceted solid with vertices corners and faces encoding within 0.000000001
if cube is a valid kernel body:
    print (the string form of "faceted valid: yes") as a line
else:
    print (the string form of "faceted valid: no") as a line
if (the test volume of cube) is near 1.0:
    print (the string form of "faceted volume: 1") as a line
else:
    print ((the string form of "faceted volume: ") + (the string form of (the test volume of cube))) as a line
