# SPDX-License-Identifier: MPL-2.0
# Bodies across the kernel seam (module split plan, phase E, step 3): a box
# extruded in the library and held by handle, meshed and weighed through the
# seam; a second box cut from it with a boolean; and handles retained and
# released in a loop. The volumes are checked against the shared-source
# result of the same operations.
import lib/std.dl
import lib/string.dl
import kernel/core/core.dl
import kernel/core/plane.dl
import kernel/core/curve2.dl
import kernel/api/kernel.dl
import kernel/brep/brep_make.dl
import kernel/brep/brep_sweep.dl
import kernel/brep/brep_boolean.dl
import kernel/brep/brep_mesh.dl

function the test rectangle {a 64 bit floating-point number:width} by {a 64 bit floating-point number:depth} at {a 64 bit floating-point number:x}:
    execute:
        set a to a cad vector2 with x x and y 0.0
        set b to a cad vector2 with x (x + width) and y 0.0
        set c to a cad vector2 with x (x + width) and y depth
        set d to a cad vector2 with x x and y depth
        set chain to an empty list of a cad curve2
        append (the cad curve2 of (a cad line2 from a to b)) to chain
        append (the cad curve2 of (a cad line2 from b to c)) to chain
        append (the cad curve2 of (a cad line2 from c to d)) to chain
        append (the cad curve2 of (a cad line2 from d to a)) to chain
        return chain

function the test volume of {kernel body:body}:
    execute:
        set meshValue to the kernel mesh of body with maximum angle 0.3 within 0.001
        set properties to the kernel mass properties of meshValue
        if properties's valid = false:
            return 0.0 - 1.0
        return properties's value's volume

function {a 64 bit floating-point number:value} is near {a 64 bit floating-point number:expected}:
    execute:
        return ((value - expected) < 0.000001) and ((value - expected) > (0.0 - 0.000001))

set plane to the cad xy plane
set up to a cad vector3 with x 0.0, y 0.0 and z 3.0

# One box of 1 by 2 by 3 through the seam.
set outline to the test rectangle 1.0 by 2.0 at 0.0
set box to the kernel extrusion of outline on plane along up
if box is a valid kernel body:
    print (the string form of "extrusion valid: yes") as a line
else:
    print (the string form of "extrusion valid: no") as a line
if (the test volume of box) is near 6.0:
    print (the string form of "volume: 6") as a line
else:
    print ((the string form of "volume: ") + (the string form of (the test volume of box))) as a line

# The same box minus a 0.5 by 2 by 3 slab from its middle, through the seam
# and in this program, must weigh the same.
set cutter to the kernel extrusion of (the test rectangle 0.5 by 2.0 at 0.25) on plane along up
set difference to the kernel combination of box and cutter using cad difference operation within 0.000000001
set mine to the cad combination of (the cad extrusion of outline on plane along up)'s value and (the cad extrusion of (the test rectangle 0.5 by 2.0 at 0.25) on plane along up)'s value using cad difference operation within 0.000000001
set mineProperties to the cad mass properties of (the cad mesh of mine's value with maximum angle 0.3 within 0.001)
if (the test volume of difference) is near (mineProperties's value's volume):
    print (the string form of "difference volume equal: yes") as a line
else:
    print ((the string form of "difference volume equal: no ") + (the string form of (the test volume of difference))) as a line

# Handles survive copies and releases.
set kept to an empty kernel body
loop round from 0 to 50:
    set copy to box
    set kept to copy
if (the test volume of kept) is near 6.0:
    print (the string form of "copies released: yes") as a line
else:
    print (the string form of "copies released: no") as a line
