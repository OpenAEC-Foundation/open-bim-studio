# SPDX-License-Identifier: MPL-2.0
# The sweep across the kernel seam (issue #115): a closed profile on the
# start frame of a planar path, swept along lines (mitered at the corner) and
# along a line and a tangent arc. Every body is closed (no flaws) and weighs
# the profile's area times the path's centreline length: exactly for the
# mitered L (the rectangle and the triangle both have their centroid on the
# path), within the tessellation for the arc. Open profiles and profiles off
# the start frame are refused with their reason.
import lib/std.dl
import lib/string.dl
import kernel/core/core.dl
import kernel/core/plane.dl
import kernel/core/curve2.dl
import kernel/api/kernel.dl

function the test polygon through {a pointer to a list:points}:
    execute:
        set chain to an empty list of a cad curve2
        loop cursor from 0 to the length of points:
            set next to the remainder of (cursor + 1) divided by (the length of points)
            append (the cad curve2 of (a cad line2 from (the item at cursor in points) to (the item at next in points))) to chain
        return chain

# A width by height rectangle centred on the frame's origin.
function the test rectangle {a 64 bit floating-point number:width} by {a 64 bit floating-point number:height}:
    execute:
        set points to a list containing (a cad vector2 with x (0.0 - (width / 2.0)) and y (0.0 - (height / 2.0)))
        append (a cad vector2 with x (width / 2.0) and y (0.0 - (height / 2.0))) to points
        append (a cad vector2 with x (width / 2.0) and y (height / 2.0)) to points
        append (a cad vector2 with x (0.0 - (width / 2.0)) and y (height / 2.0)) to points
        set chain to the test polygon through points
        free points
        return chain

function the test volume of {kernel body:body}:
    execute:
        set meshValue to the kernel mesh of body with maximum angle 0.05 within 0.0001
        set properties to the kernel mass properties of meshValue
        if properties's valid = false:
            return 0.0 - 1.0
        return properties's value's volume

function {a 64 bit floating-point number:value} is within {a 64 bit floating-point number:fraction} of {a 64 bit floating-point number:expected}:
    execute:
        return (the absolute value of (value - expected)) <= (fraction * (the absolute value of expected))

function report {kernel sweep result:made} as {a string:label} weighing {a 64 bit floating-point number:expected} within {a 64 bit floating-point number:fraction}:
    execute:
        if made's valid = false:
            print ((label + (the string form of ": refused, snag ")) + (the string form of made's snag)) as a line
            return nothing
        print ((label + (the string form of ": flaws ")) + (the string form of (the kernel flaw count of made's value))) as a line
        set volume to the test volume of made's value
        if volume is within fraction of expected:
            print (label + (the string form of ": volume is area x centreline length")) as a line
        else:
            print ((((label + (the string form of ": volume ")) + (the string form of volume)) + (the string form of " instead of ")) + (the string form of expected)) as a line

function report refusal {kernel sweep result:made} as {a string:label} expecting {integer:reason}:
    execute:
        if made's valid:
            print (label + (the string form of ": built, expected a refusal")) as a line
        else if made's snag = reason:
            print (label + (the string form of ": refused for the expected reason")) as a line
        else:
            print ((label + (the string form of ": refused, snag ")) + (the string form of made's snag)) as a line

set plane to the cad xy plane
set beginning to the cad zero vector2
set corner to a cad vector2 with x 4.0 and y 0.0

# An L of two lines: 4 m along x, then 3 m along y.
set bend to an empty list of a cad curve2
append (the cad curve2 of (a cad line2 from beginning to corner)) to bend
append (the cad curve2 of (a cad line2 from corner to (a cad vector2 with x 4.0 and y 3.0))) to bend
set frame to the kernel sweep frame of bend on plane
set frameRight to (frame's valid and ((the cad distance from (frame's value's origin) to (the cad zero vector3)) <= 0.000000001)) and (((the cad distance from (frame's value's xAxis) to (the cad y axis)) <= 0.000000001) and ((the cad distance from (frame's value's yAxis) to (the cad z axis)) <= 0.000000001))
if frameRight:
    print (the string form of "start frame: origin on the path, x across it, y up") as a line
else:
    print (the string form of "start frame: wrong") as a line

set bar to the test rectangle 0.6 by 0.4
report (the kernel sweep of bar on (frame's value) following bend on plane) as (the string form of "rectangle along an L") weighing (0.24 * 7.0) within 0.000001

set trianglePoints to a list containing (a cad vector2 with x (0.0 - 0.5) and y (0.0 - 0.5))
append (a cad vector2 with x 0.5 and y (0.0 - 0.5)) to trianglePoints
append (a cad vector2 with x 0.0 and y 1.0) to trianglePoints
set triangle to the test polygon through trianglePoints
report (the kernel sweep of triangle on (frame's value) following bend on plane) as (the string form of "triangle along an L") weighing (0.75 * 7.0) within 0.000001

# A line of 4 m, then a quarter arc of radius 2 turning left, tangent.
set curved to an empty list of a cad curve2
append (the cad curve2 of (a cad line2 from beginning to corner)) to curved
append (the cad curve2 of (a cad arc2 at (a cad vector2 with x 4.0 and y 2.0) with radius 2.0 from 4.71238898038469 to 6.283185307179586)) to curved
set curvedFrame to the kernel sweep frame of curved on plane
report (the kernel sweep of bar on (curvedFrame's value) following curved on plane) as (the string form of "rectangle along a line and an arc") weighing (0.24 * (4.0 + 3.141592653589793)) within 0.001

# Refusals: a profile that does not close, and a profile plane that is not
# perpendicular to the path at its start.
set openProfile to the test rectangle 0.6 by 0.4
remove item 3 from openProfile
report refusal (the kernel sweep of openProfile on (frame's value) following bend on plane) as (the string form of "open profile") expecting (kernel sweep snag open profile)
report refusal (the kernel sweep of bar on plane following bend on plane) as (the string form of "profile off the start frame") expecting (kernel sweep snag profile placement)
