# SPDX-License-Identifier: MPL-2.0
# The wireframe across the kernel seam (module split plan, phase E, step 3):
# the visible edges of a box, as polylines in a shared wire set, must count
# what the shared-source wireframe of the same box counts.
import lib/std.dl
import lib/string.dl
import kernel/core/core.dl
import kernel/core/plane.dl
import kernel/core/curve2.dl
import kernel/api/kernel.dl
import kernel/brep/brep_sweep.dl
import kernel/brep/brep_mesh.dl

set a to a cad vector2 with x 0.0 and y 0.0
set b to a cad vector2 with x 2.0 and y 0.0
set c to a cad vector2 with x 2.0 and y 1.0
set d to a cad vector2 with x 0.0 and y 1.0
set chain to an empty list of a cad curve2
append (the cad curve2 of (a cad line2 from a to b)) to chain
append (the cad curve2 of (a cad line2 from b to c)) to chain
append (the cad curve2 of (a cad line2 from c to d)) to chain
append (the cad curve2 of (a cad line2 from d to a)) to chain
set up to a cad vector3 with x 0.0, y 0.0 and z 3.0

set box to (the kernel extrusion of chain on (the cad xy plane) along up)'s value
set wires to the kernel wire set of box with maximum angle 0.3 within 0.001
set mine to the cad wireframe of (the cad extrusion of chain on (the cad xy plane) along up)'s value with tolerance (a cad tessellation tolerance with maximum angle 0.3 within 0.001)
set minePositions to 0
loop edgeCursor from 0 to the length of mine's edges:
    set minePositions to minePositions + (the length of (the item at edgeCursor in mine's edges)'s positions)

print ((the string form of "wires: ") + (the string form of (the cad wire count of wires))) as a line
if (the cad wire count of wires) = (the length of mine's edges):
    print (the string form of "wire count equal: yes") as a line
else:
    print (the string form of "wire count equal: no") as a line
if (the length of wires's positions) = minePositions:
    print (the string form of "position count equal: yes") as a line
else:
    print (the string form of "position count equal: no") as a line
if (the item at (the cad wire count of wires) in wires's starts) = (the length of wires's positions):
    print (the string form of "starts closed: yes") as a line
else:
    print (the string form of "starts closed: no") as a line
