# SPDX-License-Identifier: MPL-2.0
# The link test of the kernel seam: the library's version read through the
# C ABI from libobskernel.a (module split plan, phase E, step 1). The symbol
# is the compiler's: the pattern's words joined by underscores and
# `_callable`, with no suffix for a function without arguments.
import lib/std.dl
import lib/string.dl

print (the string form of @intrinsic("call", "obskernel", "the_obskernel_version_callable", integer)) as a line
