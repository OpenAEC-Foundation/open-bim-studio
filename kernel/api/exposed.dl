# SPDX-License-Identifier: MPL-2.0
# The kernel library's entry: every function the application reaches across
# the C-ABI seam is defined here as an exposed function with concrete scalar
# and pointer types (module split plan, phase E). The library is compiled
# with --emit-object --no-main into libobskernel.a; kernel/api/client.dl is
# generated from this file.
import lib/std.dl
import kernel/api/types.dl
import kernel/brep/brep_make.dl
import kernel/brep/brep_section.dl
import kernel/brep/brep_slice.dl
import kernel/brep/brep_mesh.dl
import kernel/brep/brep_boolean.dl
import kernel/brep/brep_sweep.dl
import kernel/brep/brep_mass.dl
import kernel/brep/brep_place.dl
import kernel/brep/brep_thicken_multiface_planar.dl
import kernel/brep/brep_topology.dl

# The library's version, the first symbol across the seam: the link test.
# returns: integer
exposed function the obskernel version:
    execute:
        return 1

# The mesh round trip (phase E, step 2): a unit cube made inside the library,
# tessellated and written as a retained value into the caller's storage.
# `target` points at memory the caller has not initialised (or has destroyed).
exposed function initialize obskernel unit cube mesh at {a pointer to a cad mesh:target} with maximum angle {a 64 bit floating-point number:angle} within {a 64 bit floating-point number:tolerance}:
    execute:
        set made to the cad cuboid at (a cad vector3 with x 0.0, y 0.0 and z 0.0) with size (a cad vector3 with x 1.0, y 1.0 and z 1.0)
        set meshValue to the cad mesh of made's value with maximum angle angle within tolerance
        @intrinsic("initialize at", target, meshValue)

# A body across the seam (phase E, step 3): boxed on the heap with a reference
# count; the handle is the box's address as a plain pointer. The client's
# `kernel body` (kernel/api/kernel.dl) retains and releases through the two
# functions below; a null handle means the operation produced no body.
class:
    patterns:
        [an|] obskernel body box
    members:
        references as an integer
        # `cad body` has members whose types an instance decides, so the
        # member's type is taken from one.
        body as the type of (an empty cad body)

local function the obskernel handle of {cad body result:made}:
    execute:
        if made's valid = false:
            return 0 as a pointer
        set box to @intrinsic("construct", an obskernel body box, 1, made's value)
        set block to the checked allocation from (0 as a pointer) resized to 1 items of the type of box
        @intrinsic("initialize at", block, box)
        return block as a pointer

# A boolean's result carries a snag code besides `valid`; across the seam a
# failed boolean is a null handle like any other failure.
local function the obskernel handle of {cad boolean result:made}:
    execute:
        if made's valid = false:
            return 0 as a pointer
        set box to @intrinsic("construct", an obskernel body box, 1, made's value)
        set block to the checked allocation from (0 as a pointer) resized to 1 items of the type of box
        @intrinsic("initialize at", block, box)
        return block as a pointer

local function the obskernel body of {pointer:handle}:
    execute:
        set box to handle as a pointer to an obskernel body box
        return box's body

exposed function retain obskernel body {pointer:handle}:
    execute:
        set box to handle as a pointer to an obskernel body box
        set box's references to box's references + 1

exposed function release obskernel body {pointer:handle}:
    execute:
        set box to handle as a pointer to an obskernel body box
        if box's references = 1:
            @intrinsic("destroy at", box)
            @intrinsic("call", "libc", "free", nothing, handle)
        else:
            set box's references to box's references - 1

# The profile is `count` curves at `curves` (`cad curve2`, shared source),
# a closed chain in the plane's coordinates; the direction is in world
# coordinates.
# returns: pointer
exposed function the obskernel extrusion of {a pointer to a cad curve2:curves} counting {integer:count} on {a pointer to a cad plane:plane} along {a pointer to a cad vector3:direction}:
    execute:
        set profile to an empty list of a cad curve2
        loop cursor from 0 to count:
            append (the value at (curves + cursor)) to profile
        set made to the cad extrusion of profile on (the value at plane) along (the value at direction)
        free profile
        return the obskernel handle of made

# `operation` is cad union, difference or intersection operation.
# returns: pointer
exposed function the obskernel combination of {pointer:first} and {pointer:second} using {integer:operation} within {a 64 bit floating-point number:tolerance}:
    execute:
        set made to the cad combination of (the obskernel body of first) and (the obskernel body of second) using operation within tolerance
        return the obskernel handle of made

exposed function initialize obskernel mesh of {pointer:handle} with maximum angle {a 64 bit floating-point number:angle} within {a 64 bit floating-point number:tolerance} at {a pointer to a cad mesh:target}:
    execute:
        set meshValue to the cad mesh of (the obskernel body of handle) with maximum angle angle within tolerance
        @intrinsic("initialize at", target, meshValue)

exposed function initialize obskernel mass properties of {a pointer to a cad mesh:meshValue} at {a pointer to a cad mass properties result:target}:
    execute:
        @intrinsic("initialize at", target, the cad mass properties of (the value at meshValue))

# returns: pointer
exposed function the obskernel sphere body at {a pointer to a cad vector3:centre} with radius {a 64 bit floating-point number:radius}:
    execute:
        return the obskernel handle of (the cad sphere body at (the value at centre) with radius radius)

# returns: pointer
exposed function the obskernel cone body at {a pointer to a cad vector3:base} with radius {a 64 bit floating-point number:radius} and height {a 64 bit floating-point number:height}:
    execute:
        return the obskernel handle of (the cad cone body at (the value at base) with radius radius and height height)

# The profile as for the extrusion; `pivot` and `axis` in world coordinates,
# `angle` in radians (a full turn is 2 pi).
# returns: pointer
exposed function the obskernel revolution of {a pointer to a cad curve2:curves} counting {integer:count} on {a pointer to a cad plane:plane} about {a pointer to a cad vector3:pivot} along {a pointer to a cad vector3:axis} by {a 64 bit floating-point number:angle}:
    execute:
        set profile to an empty list of a cad curve2
        loop cursor from 0 to count:
            append (the value at (curves + cursor)) to profile
        set made to the cad revolution of profile on (the value at plane) about (the value at pivot) along (the value at axis) by angle
        free profile
        return the obskernel handle of made

# The body moved by `place` (kernel/api/types.dl); a new body, the given one kept.
# returns: pointer
exposed function the obskernel transformed {pointer:handle} by {a pointer to a cad placement:place}:
    execute:
        return the obskernel handle of (the cad transformed (the obskernel body of handle) by (the value at place))

# A regularised union of two bodies meeting on a planar face pair (the
# fasteners' rods); a null handle when they do not meet that way.
# returns: pointer
exposed function the obskernel planar pair join of {pointer:first} and {pointer:second} within {a 64 bit floating-point number:tolerance}:
    execute:
        return the obskernel handle of (the cad planar pair join of (the obskernel body of first) and (the obskernel body of second) within tolerance)

# The number of topology flaws of a body: zero for a closed, well-formed one.
# returns: integer
exposed function the obskernel flaw count of {pointer:handle}:
    execute:
        set flaws to the cad flaws of (the obskernel body of handle)
        set flawCount to the length of flaws
        free flaws
        return flawCount

# returns: pointer
exposed function the obskernel cylinder body at {a pointer to a cad vector3:base} with radius {a 64 bit floating-point number:radius} and height {a 64 bit floating-point number:height}:
    execute:
        return the obskernel handle of (the cad cylinder body at (the value at base) with radius radius and height height)

# `faces` is the flat encoding the application stores: for each face its
# corner count, then that many vertex indices; `faceCount` is the flat
# length. Every face is a closed ring.
# returns: pointer
exposed function the obskernel faceted solid with vertices {a pointer to a cad vector3:vertices} counting {integer:vertexCount} and faces {a pointer to an integer:faces} counting {integer:faceCount} within {a 64 bit floating-point number:tolerance}:
    execute:
        set points to an empty list of a cad vector3
        loop cursor from 0 to vertexCount:
            append (the value at (vertices + cursor)) to points
        set rings to an empty list of the type of (an empty list of an integer)
        set start to 0
        loop while start < faceCount:
            set count to the value at (faces + start)
            set ring to an empty list of an integer
            loop corner from 0 to count:
                append (the value at (faces + ((start + 1) + corner))) to ring
            append ring to rings
            set start to start + (count + 1)
        set made to the cad faceted solid with vertices points and faces rings within tolerance
        loop cursor from 0 to the length of rings:
            free (the item at cursor in rings)
        free rings
        free points
        return the obskernel handle of made

# The body's visible edges as polylines, the only wireframe query the
# application makes (the modify preview).
exposed function initialize obskernel wire set of {pointer:handle} with maximum angle {a 64 bit floating-point number:angle} within {a 64 bit floating-point number:tolerance} at {a pointer to a cad wire set:target}:
    execute:
        # Not `wire`: that word is literal in this function's pattern, and a
        # variable of the same name would make it a parameter.
        set frame to the cad wireframe of (the obskernel body of handle) with tolerance (a cad tessellation tolerance with maximum angle angle within tolerance)
        set collected to an empty cad wire set
        loop edgeCursor from 0 to the length of frame's edges:
            set edgeValue to the item at edgeCursor in frame's edges
            loop cornerCursor from 0 to the length of edgeValue's positions:
                append (the item at cornerCursor in edgeValue's positions) to collected's positions
            append (the length of collected's positions) to collected's starts
        free cad body wireframe frame
        @intrinsic("initialize at", target, collected)

# The planar section of a body: the record is the planar kernel's, shared
# source on both sides.
exposed function initialize obskernel plane section of {pointer:handle} by {a pointer to a cad plane:plane} at {a pointer to a cad section result:target}:
    execute:
        @intrinsic("initialize at", target, the cad plane section of (the obskernel body of handle) by (the value at plane))

# The plane slice of a body: both sides come back as handles.
exposed function initialize obskernel plane slice of {pointer:handle} by {a pointer to a cad plane:plane} at {a pointer to an obskernel slice:target}:
    execute:
        set sliced to the cad plane slice of (the obskernel body of handle) by (the value at plane)
        set negative to 0 as a pointer
        set positive to 0 as a pointer
        if sliced's valid:
            set negative to the obskernel handle of (the cad body result of sliced's negative)
            set positive to the obskernel handle of (the cad body result of sliced's positive)
        @intrinsic("initialize at", target, @intrinsic("construct", an obskernel slice, sliced's valid, sliced's divided, sliced's snag, negative, positive))

# The loops of the faces lying on a plane: the cap of a slice, for drawings.
exposed function initialize obskernel coplanar face loops of {pointer:handle} on {a pointer to a cad plane:plane} at {a pointer to a cad section result:target}:
    execute:
        @intrinsic("initialize at", target, the cad coplanar face loops of (the obskernel body of handle) on (the value at plane))
