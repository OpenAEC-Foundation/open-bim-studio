# SPDX-License-Identifier: MPL-2.0
# The kernel library's entry: every function the application reaches across
# the C-ABI seam is defined here as an exposed function with concrete scalar
# and pointer types (module split plan, phase E). The library is compiled
# with --emit-object --no-main into libobskernel.a; kernel/api/client.dl is
# generated from this file.
import lib/std.dl
import kernel/api/types.dl
import kernel/brep/brep_make.dl
import kernel/brep/brep_mesh.dl

# The library's version, the first symbol across the seam: the link test.
# returns: integer
exposed function the obskernel version:
    execute:
        return 1

# The mesh round trip (phase E, step 2): a unit cube made inside the library,
# tessellated and written as a retained value into the caller's storage.
# `target` points at memory the caller has not initialised (or has destroyed).
exposed function initialize obskernel unit cube mesh at {a pointer to a cad mesh:target} with maximum angle {a 64 bit floating-point number:angle} within {a 64 bit floating-point number:tolerance}:
    execute:
        set made to the cad cuboid at (a cad vector3 with x 0.0, y 0.0 and z 0.0) with size (a cad vector3 with x 1.0, y 1.0 and z 1.0)
        set meshValue to the cad mesh of made's value with maximum angle angle within tolerance
        @intrinsic("initialize at", target, meshValue)
