# SPDX-License-Identifier: MPL-2.0
# The kernel library as the application sees it (module split plan, phase E):
# bodies by handle, the operations the application uses, in the sentences it
# already uses, with `kernel body` where it had `cad body`. Everything here is
# shared source over the generated client (kernel/api/client.dl) and the
# shared records (kernel/api/types.dl); nothing here imports kernel/brep.
import lib/std.dl
import lib/list.dl
import kernel/core/core.dl
import kernel/core/plane.dl
import kernel/core/curve2.dl
import kernel/api/types.dl
import kernel/api/client.dl
import kernel/planar/section_loops.dl

# A body held by handle. Copies retain the library's box, the last release
# frees it; a null handle is the empty body, which no operation produced.
class:
    patterns:
        [a|] kernel body
    members:
        handle as a pointer
    retain:
        set owned to the handle of @intrinsic("lifecycle value")
        if owned != (0 as a pointer):
            retain obskernel body owned
    release:
        set owned to the handle of @intrinsic("lifecycle value")
        if owned != (0 as a pointer):
            release obskernel body owned

function an empty kernel body:
    execute:
        return @intrinsic("construct", a kernel body, 0 as a pointer)

function {kernel body:value} is a valid kernel body:
    execute:
        return value's handle != (0 as a pointer)

# What a construction or a boolean returns: `valid` when the library produced
# a body. The shape of the kernel's own result records, so call sites keep
# their `'s valid` and `'s value`.
class:
    patterns:
        [a|] kernel body result
    members:
        valid as a boolean
        value as a kernel body

local function the kernel body result for {pointer:handle}:
    execute:
        return @intrinsic("construct", a kernel body result, handle != (0 as a pointer), @intrinsic("construct", a kernel body, handle))

# A body is immutable behind its handle: a clone is another holder of it.
# Returning the value copies it, and the copy retains the library's box, so
# clone and original share one body and the last release frees it.
function the cad clone of {kernel body:value}:
    execute:
        return value

# The prism over `profile`, a closed chain of `cad curve2` in the plane's own
# coordinates, swept along `direction` (world coordinates).
function the kernel extrusion of {a pointer to a list:profile} on {cad plane:plane} along {cad vector3:direction}:
    execute:
        set handle to the obskernel extrusion of ((the data of profile) as a pointer to a cad curve2) counting (the length of profile) on (the address of plane) along (the address of direction)
        return the kernel body result for handle

# `operation` is cad union, difference or intersection operation.
function the kernel combination of {kernel body:first} and {kernel body:second} using {integer:operation} within {a number:tolerance}:
    execute:
        set handle to the obskernel combination of first's handle and second's handle using operation within (tolerance as a 64 bit floating-point number)
        return the kernel body result for handle

function the kernel mesh of {kernel body:body} with maximum angle {a number:angle} within {a number:tolerance}:
    execute:
        set meshValue to an empty cad mesh
        @intrinsic("destroy at", the address of meshValue)
        initialize obskernel mesh of body's handle with maximum angle (angle as a 64 bit floating-point number) within (tolerance as a 64 bit floating-point number) at (the address of meshValue)
        return meshValue

function the kernel mass properties of {cad mesh:meshValue}:
    execute:
        set result to a new cad mass properties result
        initialize obskernel mass properties of (the address of meshValue) at (the address of result)
        return result

function the kernel sphere body at {cad vector3:centre} with radius {a number:radius}:
    execute:
        set handle to the obskernel sphere body at (the address of centre) with radius (radius as a 64 bit floating-point number)
        return the kernel body result for handle

function the kernel cylinder body at {cad vector3:base} with radius {a number:radius} and height {a number:height}:
    execute:
        set handle to the obskernel cylinder body at (the address of base) with radius (radius as a 64 bit floating-point number) and height (height as a 64 bit floating-point number)
        return the kernel body result for handle

# `vertices` is a list of cad vector3; `faces` the flat list the application
# stores: for each face its corner count, then that many vertex indices.
function the kernel faceted solid with vertices {a pointer to a list:vertices} and faces {a pointer to a list:faces} within {a number:tolerance}:
    execute:
        set handle to the obskernel faceted solid with vertices ((the data of vertices) as a pointer to a cad vector3) counting (the length of vertices) and faces ((the data of faces) as a pointer to an integer) counting (the length of faces) within (tolerance as a 64 bit floating-point number)
        return the kernel body result for handle

# The body's visible edges as polylines; `the cad wire count of` counts them,
# polyline `i` runs from `starts[i]` to `starts[i + 1]` in `positions`.
function the kernel wire set of {kernel body:body} with maximum angle {a number:angle} within {a number:tolerance}:
    execute:
        set wires to an empty cad wire set
        @intrinsic("destroy at", the address of wires)
        initialize obskernel wire set of body's handle with maximum angle (angle as a 64 bit floating-point number) within (tolerance as a 64 bit floating-point number) at (the address of wires)
        return wires

# The same solid from faces given as rings (a list of lists of indices), as
# the connection module builds them.
function the kernel faceted solid with vertices {a pointer to a list:vertices} and face rings {a pointer to a list:rings} within {a number:tolerance}:
    execute:
        set encoding to an empty list of an integer
        loop ringCursor from 0 to the length of rings:
            set ring to the item at ringCursor in rings
            append (the length of ring) to encoding
            loop cornerCursor from 0 to the length of ring:
                append (the item at cornerCursor in ring) to encoding
        set made to the kernel faceted solid with vertices vertices and faces encoding within tolerance
        free encoding
        return made

# The planar section of a body by a plane: the planar kernel's record.
function the kernel plane section of {kernel body:body} by {cad plane:plane}:
    execute:
        set sectioned to an empty cad section
        @intrinsic("destroy at", the address of sectioned)
        initialize obskernel plane section of body's handle by (the address of plane) at (the address of sectioned)
        return sectioned

# The two sides of a body cut by a plane.
class:
    patterns:
        [a|] kernel slice result
    members:
        valid as a boolean
        divided as a boolean
        snag as an integer
        negative as a kernel body
        positive as a kernel body

function the kernel plane slice of {kernel body:body} by {cad plane:plane}:
    execute:
        set crossing to a new obskernel slice
        initialize obskernel plane slice of body's handle by (the address of plane) at (the address of crossing)
        return @intrinsic("construct", a kernel slice result, crossing's valid, crossing's divided, crossing's snag, @intrinsic("construct", a kernel body, crossing's negative), @intrinsic("construct", a kernel body, crossing's positive))

# The loops of the body's faces that lie on the plane, as 3D points: the cap
# faces a slice leaves.
function the kernel coplanar face loops of {kernel body:body} on {cad plane:plane}:
    execute:
        set capped to an empty cad section
        @intrinsic("destroy at", the address of capped)
        initialize obskernel coplanar face loops of body's handle on (the address of plane) at (the address of capped)
        return capped
