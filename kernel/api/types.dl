# SPDX-License-Identifier: MPL-2.0
# The records that cross the kernel seam by pointer (module split plan, phase
# E; restructuring design §6.2). This file is shared source: the library and
# every program that uses it compile the same class, so both lower it to the
# same layout and the same retain and release code. The members are typed
# explicitly for that reason; a member whose type an instantiation decides
# would not be one layout.
import lib/std.dl
import kernel/core/core.dl

class:
    patterns:
        [a|] cad mesh triangle
    members:
        first as an integer
        second as an integer
        third as an integer

# A triangle mesh with one normal per position. Values share the stores;
# the owner counts the shares, and the last release frees them.
class:
    patterns:
        [a|] cad mesh
    members:
        positions as the type of (an empty list of a cad vector3)
        normals as the type of (an empty list of a cad vector3)
        triangles as the type of (an empty list of a cad mesh triangle)
        owner as a pointer to an integer
    retain:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 2147483647:
                @intrinsic("call", "libc", "abort", nothing)
            store (references + 1) at storageOwner
    release:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 1:
                free (the positions of @intrinsic("lifecycle value"))
                free (the normals of @intrinsic("lifecycle value"))
                free (the triangles of @intrinsic("lifecycle value"))
                @intrinsic("call", "libc", "free", nothing, storageOwner)
            else:
                store (references - 1) at storageOwner

function an empty cad mesh:
    execute:
        set storedPositions to an empty list of a cad vector3
        set storedNormals to an empty list of a cad vector3
        set storedTriangles to an empty list of a cad mesh triangle
        allocate one slot of 0 and set storageOwner to it
        return @intrinsic("construct", a cad mesh, storedPositions, storedNormals, storedTriangles, storageOwner)

function free cad mesh {cad mesh:meshValue}:
    replacement:
        set meshValue to a new (the type of meshValue)
