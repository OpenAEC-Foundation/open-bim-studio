# SPDX-License-Identifier: MPL-2.0
# The records that cross the kernel seam by pointer (module split plan, phase
# E; restructuring design §6.2). This file is shared source: the library and
# every program that uses it compile the same class, so both lower it to the
# same layout and the same retain and release code. The members are typed
# explicitly for that reason; a member whose type an instantiation decides
# would not be one layout.
import lib/std.dl
import lib/list.dl
import kernel/core/core.dl
import kernel/core/plane.dl
import kernel/core/curve2.dl
# The planar section record crosses the seam as it is: the planar kernel is
# shared source.
import kernel/planar/section_loops.dl

class:
    patterns:
        [a|] cad mesh triangle
    members:
        first as an integer
        second as an integer
        third as an integer

# A triangle mesh with one normal per position. Values share the stores;
# the owner counts the shares, and the last release frees them.
class:
    patterns:
        [a|] cad mesh
    members:
        positions as the type of (an empty list of a cad vector3)
        normals as the type of (an empty list of a cad vector3)
        triangles as the type of (an empty list of a cad mesh triangle)
        owner as a pointer to an integer
    retain:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 2147483647:
                @intrinsic("call", "libc", "abort", nothing)
            store (references + 1) at storageOwner
    release:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 1:
                free (the positions of @intrinsic("lifecycle value"))
                free (the normals of @intrinsic("lifecycle value"))
                free (the triangles of @intrinsic("lifecycle value"))
                @intrinsic("call", "libc", "free", nothing, storageOwner)
            else:
                store (references - 1) at storageOwner

function an empty cad mesh:
    execute:
        set storedPositions to an empty list of a cad vector3
        set storedNormals to an empty list of a cad vector3
        set storedTriangles to an empty list of a cad mesh triangle
        allocate one slot of 0 and set storageOwner to it
        return @intrinsic("construct", a cad mesh, storedPositions, storedNormals, storedTriangles, storageOwner)

function free cad mesh {cad mesh:meshValue}:
    replacement:
        set meshValue to a new (the type of meshValue)

# The mass properties of a mesh or a body: plain data, written by the library
# into the caller's storage.
class:
    patterns:
        [a|] cad mass properties
    members:
        volume as a 64 bit floating-point number
        centroid as a cad vector3
        momentOfInertia as a cad vector3
        principalDirectionX as a cad vector3
        principalDirectionY as a cad vector3
        principalDirectionZ as a cad vector3
        principalMoments as a cad vector3
        productOfInertia as a cad vector3
        radiiOfGyration as a cad vector3
class:
    patterns:
        [a|] cad mass properties result
    members:
        valid as a boolean
        value as a cad mass properties

# A set of polylines, as the library returns a body's visible edges: the
# positions of all polylines in one list, and for each polyline the index of
# its first position, with one more entry holding the total. Values share the
# stores; the owner counts the shares.
class:
    patterns:
        [a|] cad wire set
    members:
        positions as the type of (an empty list of a cad vector3)
        starts as the type of (an empty list of an integer)
        owner as a pointer to an integer
    retain:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 2147483647:
                @intrinsic("call", "libc", "abort", nothing)
            store (references + 1) at storageOwner
    release:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 1:
                free (the positions of @intrinsic("lifecycle value"))
                free (the starts of @intrinsic("lifecycle value"))
                @intrinsic("call", "libc", "free", nothing, storageOwner)
            else:
                store (references - 1) at storageOwner

function an empty cad wire set:
    execute:
        set storedPositions to an empty list of a cad vector3
        set storedStarts to an empty list of an integer
        append 0 to storedStarts
        allocate one slot of 0 and set storageOwner to it
        return @intrinsic("construct", a cad wire set, storedPositions, storedStarts, storageOwner)

function the cad wire count of {cad wire set:wires}:
    execute:
        return (the length of wires's starts) - 1

# The boolean operations, by code; shared by the library and its clients.
function cad union operation:
    replacement:
        0
function cad intersection operation:
    replacement:
        1
function cad difference operation:
    replacement:
        2

# A plane slice across the seam: the two sides as body handles (null when the
# slice refused or did not divide), written by the library into the caller's
# storage; the client wraps the handles into kernel bodies.
class:
    patterns:
        [an|] obskernel slice
    members:
        valid as a boolean
        divided as a boolean
        snag as an integer
        negative as a pointer
        positive as a pointer
