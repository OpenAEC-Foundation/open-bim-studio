# SPDX-License-Identifier: MPL-2.0
import ui/panels/bim_ui.dl
import ui/panels/bim_plan_panel.dl
import pattern/grids/bim_grid_pattern.dl

# The plus handles of the selected grid line (#59): one on each side of the
# line beside its bubble; clicking one adds parallel lines on its side
# (Q14, #117). `point` and `other` are pixels; `side` is the side of
# `point` as `add bim grid copies of … toward side …` takes it (1.0 or
# -1.0), `other` lies on the opposite side.
class:
    patterns:
        [a|] bim grid add control record
    members:
        visible as a boolean
        point as a cad vector2
        side as a 64 bit floating-point number
        otherVisible as a boolean
        other as a cad vector2

function no bim grid add control:
    execute:
        set origin to a cad vector2 with x 0.0 and y 0.0
        return @intrinsic("construct", a bim grid add control record, false, origin, 1.0, false, origin)

# Where the plus on side `sideSign` (1.0 left of the line from `firstPixel`
# to `lastPixel` as the screen shows it, -1.0 right of it) stands: beside
# the last head when that head is in the viewport, else beside the first,
# else nowhere; moved inside the viewport near its edge, and kept clear of
# both heads. `visible` false when it fits nowhere.
local function the bim grid add spot from {cad vector2:firstPixel} to {cad vector2:lastPixel} toward {a 64 bit floating-point number:sideSign} between {cad vector2:lowPixel} and {cad vector2:highPixel}:
    execute:
        set none to no bim grid add control
        set controlRadius to 12.0
        set innerLow to a cad vector2 with x (lowPixel's x + controlRadius) and y (lowPixel's y + controlRadius)
        set innerHigh to a cad vector2 with x (highPixel's x - controlRadius) and y (highPixel's y - controlRadius)
        set spanLength to the cad distance from firstPixel to lastPixel
        set acrossX to (0.0 - ((lastPixel's y - firstPixel's y) / spanLength)) * sideSign
        set acrossY to ((lastPixel's x - firstPixel's x) / spanLength) * sideSign
        set headRadius to bim grid screen head radius
        set reachLength to headRadius + 26.0
        set minimumGap to (headRadius + controlRadius) + 3.0
        loop headCursor from 0 to 2:
            set headPoint to lastPixel
            if headCursor = 1:
                set headPoint to firstPixel
            set closestX to the maximum of lowPixel's x and headPoint's x
            set closestY to the maximum of lowPixel's y and headPoint's y
            set closestX to the minimum of highPixel's x and closestX
            set closestY to the minimum of highPixel's y and closestY
            set closestPixel to a cad vector2 with x closestX and y closestY
            if (the cad distance from headPoint to closestPixel) <= headRadius:
                loop candidateCursor from 0 to 2:
                    set candidateSpot to a cad vector2 with x (headPoint's x + (acrossX * reachLength)) and y (headPoint's y + (acrossY * reachLength))
                    if candidateCursor = 1:
                        set boundedX to the maximum of innerLow's x and candidateSpot's x
                        set boundedY to the maximum of innerLow's y and candidateSpot's y
                        set boundedX to the minimum of innerHigh's x and boundedX
                        set boundedY to the minimum of innerHigh's y and boundedY
                        set candidateSpot to a cad vector2 with x boundedX and y boundedY
                    set fitsX to (candidateSpot's x >= innerLow's x) and (candidateSpot's x <= innerHigh's x)
                    set fitsY to (candidateSpot's y >= innerLow's y) and (candidateSpot's y <= innerHigh's y)
                    set firstGap to the cad distance from candidateSpot to firstPixel
                    set lastGap to the cad distance from candidateSpot to lastPixel
                    set clearsHeads to (firstGap >= minimumGap) and (lastGap >= minimumGap)
                    if (fitsX and fitsY) and clearsHeads:
                        return @intrinsic("construct", a bim grid add control record, true, candidateSpot, sideSign, false, candidateSpot)
        return none

# The two plus handles of a grid line running from `firstPixel` to
# `lastPixel` in a viewport from `lowPixel` to `highPixel`: `point` on the
# left of the line as the screen shows it (`side` 1.0), `other` on its
# right. A plus that fits nowhere is not shown; when the two would overlap
# (a line across a corner of the viewport) only the first is kept.
function the bim grid add placement from {cad vector2:firstPixel} to {cad vector2:lastPixel} between {cad vector2:lowPixel} and {cad vector2:highPixel}:
    execute:
        set none to no bim grid add control
        if (((the absolute value of firstPixel's x) <= 1e100) and ((the absolute value of firstPixel's y) <= 1e100)) = false:
            return none
        if (((the absolute value of lastPixel's x) <= 1e100) and ((the absolute value of lastPixel's y) <= 1e100)) = false:
            return none
        set controlRadius to 12.0
        if ((highPixel's x - lowPixel's x) < (controlRadius * 2.0)) or ((highPixel's y - lowPixel's y) < (controlRadius * 2.0)):
            return none
        if (the cad distance from firstPixel to lastPixel) < 1e-6:
            return none
        set leftSpot to the bim grid add spot from firstPixel to lastPixel toward 1.0 between lowPixel and highPixel
        set rightSpot to the bim grid add spot from firstPixel to lastPixel toward -1.0 between lowPixel and highPixel
        if leftSpot's visible = false:
            if rightSpot's visible:
                return @intrinsic("construct", a bim grid add control record, true, rightSpot's point, -1.0, false, rightSpot's point)
            return none
        set keepsRight to rightSpot's visible and ((the cad distance from leftSpot's point to rightSpot's point) >= ((controlRadius * 2.0) + 2.0))
        return @intrinsic("construct", a bim grid add control record, true, leftSpot's point, 1.0, keepsRight, rightSpot's point)

# The side of the model, as `add bim grid copies of … toward side …` takes
# it, that lies on the screen's left of the line from `firstPixel` to
# `lastPixel`, where `aheadPixel` shows the point one metre from the line's
# start (at `firstPixel`) the way `the bim grid pattern direction from … to
# …` gives.
function the bim grid add side from {cad vector2:firstPixel} to {cad vector2:lastPixel} ahead at {cad vector2:aheadPixel}:
    execute:
        set acrossX to 0.0 - (lastPixel's y - firstPixel's y)
        set acrossY to lastPixel's x - firstPixel's x
        set aheadX to aheadPixel's x - firstPixel's x
        set aheadY to aheadPixel's y - firstPixel's y
        if ((acrossX * aheadX) + (acrossY * aheadY)) < 0.0:
            return -1.0
        return 1.0

# `control` with its sides told in the model's terms, for a screen whose
# left of the line is the model's side `leftSide`; its points unchanged.
function the bim grid add control placed as {bim grid add control record:control} with left side {a 64 bit floating-point number:leftSide}:
    execute:
        set told to control
        set told's side to control's side * leftSide
        return told

function the bim grid add control of {bim editor record:editor} in view {boolean:inView} in {bim screen layout record:layout} with {bim camera record:camera}:
    execute:
        set none to no bim grid add control
        if (editor's selectionKind != bim grid picked) or ((the length of (editor's chosenSketches's values)) > 1):
            return none
        if (editor's tool != bim select tool) or editor's editMode:
            return none
        set found to the bim grid index of editor's selectionId in editor's documentValue's current
        if found's valid = false:
            return none
        set gridValue to the item at found's position in (editor's documentValue's current's grids's values)
        set aheadUnit to the bim grid pattern direction from gridValue's start to gridValue's finish
        set aheadPoint to a cad vector2 with x (gridValue's start's x + aheadUnit's x) and y (gridValue's start's y + aheadUnit's y)
        set first to the bim plan pixel of gridValue's start in layout with camera
        set last to the bim plan pixel of gridValue's finish in layout with camera
        set aheadPixel to the bim plan pixel of aheadPoint in layout with camera
        set left to layout's planLeft
        set right to layout's planRight
        if inView:
            set first to the bim view point gridValue's start's x gridValue's start's y gridValue's high in layout with camera
            set last to the bim view point gridValue's finish's x gridValue's finish's y gridValue's high in layout with camera
            set aheadPixel to the bim view point aheadPoint's x aheadPoint's y gridValue's high in layout with camera
            set left to layout's planRight
            set right to layout's width
        set viewportLow to a cad vector2 with x left and y layout's top
        set viewportHigh to a cad vector2 with x right and y layout's bottom
        set placedControl to the bim grid add placement from first to last between viewportLow and viewportHigh
        return the bim grid add control placed as placedControl with left side (the bim grid add side from first to last ahead at aheadPixel)

# The side, as `add bim grid copies of … toward side …` takes it, of the plus
# of `control` under `pixel`; 0.0 when neither is.
function the bim grid add side of {bim grid add control record:control} at {cad vector2:pixel}:
    execute:
        if control's visible and ((the cad distance from pixel to control's point) <= 12.0):
            return control's side
        if control's otherVisible and ((the cad distance from pixel to control's other) <= 12.0):
            return 0.0 - control's side
        return 0.0

local function draw bim grid add button at {cad vector2:centre} pointing at {cad vector2:hoverPixel} in {graphics frame:frame}:
    execute:
        set palette to the bim ui palette
        set buttonPaint to palette's accent
        if (the cad distance from hoverPixel to centre) <= 12.0:
            set buttonPaint to palette's accentHover
        start triangles in frame
        use vertex color red buttonPaint's red, green buttonPaint's green and blue buttonPaint's blue in frame
        loop step from 0 to 24:
            set a to (6.283185307179586 * (step as a 64 bit floating-point number)) / 24.0
            set b to (6.283185307179586 * ((step + 1) as a 64 bit floating-point number)) / 24.0
            add a vertex at x centre's x and y centre's y to frame
            add a vertex at x (centre's x + (12.0 * (the cosine of a))) and y (centre's y + (12.0 * (the sine of a))) to frame
            add a vertex at x (centre's x + (12.0 * (the cosine of b))) and y (centre's y + (12.0 * (the sine of b))) to frame
        use vertex color red palette's onAccent's red, green palette's onAccent's green and blue palette's onAccent's blue in frame
        add bim stroke from (a cad vector2 with x (centre's x - 5.0) and y centre's y) to (a cad vector2 with x (centre's x + 5.0) and y centre's y) wide 2.0 in frame
        add bim stroke from (a cad vector2 with x centre's x and y (centre's y - 5.0)) to (a cad vector2 with x centre's x and y (centre's y + 5.0)) wide 2.0 in frame
        finish triangles in frame

function draw bim grid add control {bim grid add control record:control} pointing at {cad vector2:hoverPixel} in {graphics frame:frame}:
    execute:
        if control's visible:
            draw bim grid add button at control's point pointing at hoverPixel in frame
        if control's otherVisible:
            draw bim grid add button at control's other pointing at hoverPixel in frame

function draw bim grid spacing popup at {cad vector2:corner} text {a string:inputValue} units {integer:unitCode} invalid {boolean:invalid} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set x to corner's x
        set y to corner's y
        set palette to the bim ui palette
        draw bim ui rectangle x y 240.0 154.0 painted palette's panel in frame
        draw bim ui frame x y 240.0 154.0 coloured palette's strong's red, palette's strong's green and palette's strong's blue in frame
        draw bim ui text (the string form of "Add parallel grids") at (x + 12.0) and (y + 24.0) in face (bim text bold) with atlas painted palette's ink in frame
        draw bim ui text ((the string form of "Spacing (") + ((the bim name of length unit unitCode) + (the string form of ")"))) at (x + 12.0) and (y + 46.0) in face (bim text small) with atlas painted palette's inkSecondary in frame
        draw bim ui rectangle (x + 12.0) (y + 54.0) 216.0 30.0 painted palette's raised in frame
        draw bim ui frame (x + 12.0) (y + 54.0) 216.0 30.0 coloured palette's focus's red, palette's focus's green and palette's focus's blue in frame
        if invalid:
            draw bim ui frame (x + 12.0) (y + 54.0) 216.0 30.0 coloured 230, 90 and 80 in frame
        draw bim text inputValue at (x + 19.0) and (y + 75.0) in face (bim text body) with atlas coloured palette's ink's red, palette's ink's green and palette's ink's blue cut at (x + 223.0) in frame
        set example to the string form of "4x5400  or  5400 6000 5400"
        if unitCode = 1:
            set example to the string form of "4x540  or  540 600 540"
        if unitCode = 2:
            set example to the string form of "4x5.4  or  5.4 6 5.4"
        draw bim ui text example at (x + 12.0) and (y + 103.0) in face (bim text small) with atlas painted palette's inkSecondary in frame
        draw bim ui rectangle (x + 58.0) (y + 114.0) 80.0 28.0 painted palette's hover in frame
        draw bim ui rectangle (x + 146.0) (y + 114.0) 82.0 28.0 painted palette's accent in frame
        draw bim ui text (the string form of "Cancel") at (x + 72.0) and (y + 134.0) in face (bim text small) with atlas painted palette's ink in frame
        draw bim ui text (the string form of "Add grids") at (x + 157.0) and (y + 134.0) in face (bim text small) with atlas painted palette's onAccent in frame
