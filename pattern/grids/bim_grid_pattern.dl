# SPDX-License-Identifier: MPL-2.0
# Bounded spacing patterns and atomic batches of parallel structural grids.
import bim/bim_model.dl
import bim/bim_grid_height.dl
import pattern/grids/bim_grid_names.dl

class:
    patterns:
        [a|] bim grid spacing pattern record
    members:
        valid as a boolean
        offsets as the type of (an empty list of a 64 bit floating-point number)

function a refused bim grid spacing pattern:
    execute:
        return @intrinsic("construct", a bim grid spacing pattern record, false, an empty list of a 64 bit floating-point number)

local function bim grid pattern byte {integer:code} is whitespace:
    execute:
        return (code = 32) or ((code >= 9) and (code <= 13))

# The repeat signs: `4x5400`, `4X5400` and `4*5400` (Q14, #117).
local function bim grid pattern byte {integer:code} is a repeat sign:
    execute:
        return ((code = 120) or (code = 88)) or (code = 42)

# `4 x 5400` reads as `4x5400`: whitespace beside a repeat sign is dropped.
local function the bim grid pattern text joined at repeat signs of {a string:patternText}:
    execute:
        set joinedText to the string form of ""
        set count to the length of patternText
        set keptCode to 0
        loop cursor from 0 to count:
            set code to (the character at cursor in patternText) as an integer
            if bim grid pattern byte code is whitespace:
                set aheadCode to 0
                set ahead to cursor + 1
                loop while (ahead < count) and (aheadCode = 0):
                    set scanned to (the character at ahead in patternText) as an integer
                    if bim grid pattern byte scanned is whitespace:
                        set ahead to ahead + 1
                    else:
                        set aheadCode to scanned
                if ((bim grid pattern byte keptCode is a repeat sign) or (bim grid pattern byte aheadCode is a repeat sign)) = false:
                    set joinedText to joinedText + (the substring of patternText from cursor spanning 1 bytes)
            else:
                set joinedText to joinedText + (the substring of patternText from cursor spanning 1 bytes)
                set keptCode to code
        return joinedText

# Positive decimal only, consuming the whole token. Zero denotes refusal.
local function the bim grid pattern decimal of {a string:token}:
    execute:
        set value to 0.0
        set fraction to 0.1
        set dotted to false
        set digits to 0
        loop cursor from 0 to the length of token:
            set code to (the character at cursor in token) as an integer
            if code = 46:
                if dotted:
                    return 0.0
                set dotted to true
            else:
                if (code < 48) or (code > 57):
                    return 0.0
                set digits to digits + 1
                if dotted:
                    set value to value + (((code - 48) as a 64 bit floating-point number) * fraction)
                    set fraction to fraction * 0.1
                else:
                    set value to (value * 10.0) + ((code - 48) as a 64 bit floating-point number)
                if value > 1000000000000.0:
                    return 0.0
        if (digits = 0) or (value <= 0.0):
            return 0.0
        return value

local function the bim grid pattern repeats of {a string:token}:
    execute:
        set count to 0
        if (the length of token) = 0:
            return 0
        loop cursor from 0 to the length of token:
            set code to (the character at cursor in token) as an integer
            if (code < 48) or (code > 57):
                return 0
            set count to (count * 10) + (code - 48)
            if count > 1000:
                return 0
        return count

# Caller supplies the current length unit's metres per unit (mm = 0.001).
# At most 4096 input bytes, 1000 copies and 1000000 metres total spacing.
# Spacings separate by whitespace; a repeat reads `4x5400` or `4*5400`,
# with or without spaces around the sign.
# Invalid input always returns an empty offsets list; callers own that list.
function the bim grid spacing pattern of {a string:rawText} metres per unit {a 64 bit floating-point number:unitScale}:
    execute:
        if (((the length of rawText) = 0) or ((the length of rawText) > 4096)) or (((unitScale > 0.0) and (unitScale <= 1000000.0)) = false):
            return a refused bim grid spacing pattern
        set patternText to the bim grid pattern text joined at repeat signs of rawText
        set offsets to an empty list of a 64 bit floating-point number
        set cumulative to 0.0
        set cursor to 0
        loop while cursor < (the length of patternText):
            set code to (the character at cursor in patternText) as an integer
            if bim grid pattern byte code is whitespace:
                set cursor to cursor + 1
            else:
                set tokenStart to cursor
                set separator to -1
                set tokenOpen to true
                set tokenValid to true
                loop while (cursor < (the length of patternText)) and tokenOpen:
                    set code to (the character at cursor in patternText) as an integer
                    if bim grid pattern byte code is whitespace:
                        set tokenOpen to false
                    else:
                        if bim grid pattern byte code is a repeat sign:
                            if separator >= 0:
                                set tokenValid to false
                            set separator to cursor
                        set cursor to cursor + 1
                set repeatCount to 1
                set distanceStart to tokenStart
                if separator >= 0:
                    set repeatCount to the bim grid pattern repeats of (the substring of patternText from tokenStart spanning (separator - tokenStart) bytes)
                    set distanceStart to separator + 1
                set stepLength to (the bim grid pattern decimal of (the substring of patternText from distanceStart spanning (cursor - distanceStart) bytes)) * unitScale
                if (((tokenValid = false) or (repeatCount <= 0)) or (stepLength <= 0.0)) or (((the length of offsets) + repeatCount) > 1000):
                    free offsets
                    return a refused bim grid spacing pattern
                loop repeatCursor from 0 to repeatCount:
                    set nextOffset to cumulative + stepLength
                    if ((nextOffset > cumulative) and (nextOffset <= 1000000.0)) = false:
                        free offsets
                        return a refused bim grid spacing pattern
                    set cumulative to nextOffset
                    append cumulative to offsets
        if (the length of offsets) = 0:
            free offsets
            return a refused bim grid spacing pattern
        return @intrinsic("construct", a bim grid spacing pattern record, true, offsets)

# Endpoint order does not change the side: vertical and slanted lines go
# towards positive X; horizontal lines go towards negative Y.
function the bim grid pattern direction from {cad vector2:startPoint} to {cad vector2:finishPoint}:
    execute:
        set lengthValue to the cad distance from startPoint to finishPoint
        if lengthValue <= 1e-6:
            return a cad vector2 with x 0.0 and y 0.0
        set px to (finishPoint's y - startPoint's y) / lengthValue
        set py to (startPoint's x - finishPoint's x) / lengthValue
        if (the absolute value of px) < 1e-9:
            if py > 0.0:
                set px to 0.0 - px
                set py to 0.0 - py
        else:
            if px < 0.0:
                set px to 0.0 - px
                set py to 0.0 - py
        return a cad vector2 with x px and y py

local function bim grid pattern name {a string:label} occurs in {a pointer to a list:grids}:
    execute:
        loop cursor from 0 to the length of grids:
            if (the item at cursor in grids)'s name = label:
                return true
        return false

local function bim grid pattern point {cad vector2:point} is bounded:
    execute:
        return ((the absolute value of point's x) <= 1000000000000.0) and ((the absolute value of point's y) <= 1000000000000.0)

# This helper owns no document transaction. It validates and prepares every
# copy before the first mutation, then performs only prevalidated additions.
# Zero means refusal with the model untouched; positive is the batch count.
# The caller can wrap one successful batch in one existing BIM transaction.
# The copies go the way `the bim grid pattern direction from … to …` gives.
function add bim grid copies of {a 64 bit integer:gridId} spaced {a string:patternText} metres per unit {a 64 bit floating-point number:unitScale} in {a pointer to a bim model record:target}:
    execute:
        return add bim grid copies of gridId toward side 1.0 spaced patternText metres per unit unitScale in target

# The same, toward the side `sideSign` gives: 1.0 the way `the bim grid
# pattern direction from … to …` gives, -1.0 the other way (the side of the
# plus handle clicked, Q14 of #117). The names continue from the source
# line's, past names the model holds and, when the project skips them, past
# I and O.
function add bim grid copies of {a 64 bit integer:gridId} toward side {a 64 bit floating-point number:sideSign} spaced {a string:patternText} metres per unit {a 64 bit floating-point number:unitScale} in {a pointer to a bim model record:target}:
    execute:
        set parsed to the bim grid spacing pattern of patternText metres per unit unitScale
        if parsed's valid = false:
            free parsed's offsets
            return 0
        set found to the bim grid index of gridId in (@intrinsic("dereference", target))
        if found's valid = false:
            free parsed's offsets
            return 0
        set source to the item at found's position in (target's grids's values)
        if ((bim grid pattern point source's start is bounded) and (bim grid pattern point source's finish is bounded)) = false:
            free parsed's offsets
            return 0
        if (((source's high > source's low) and ((the absolute value of source's high) <= 1000000000000.0)) and ((the absolute value of source's low) <= 1000000000000.0)) = false:
            free parsed's offsets
            return 0
        set direction to the bim grid pattern direction from source's start to source's finish
        if sideSign < 0.0:
            set direction to a cad vector2 with x (0.0 - direction's x) and y (0.0 - direction's y)
        set skipsLetters to bim grid names skip letters in (@intrinsic("dereference", target))
        set preparedGrids to an empty list of a bim grid record
        set label to source's name
        loop cursor from 0 to the length of parsed's offsets:
            set offset to the item at cursor in parsed's offsets
            set startPoint to a cad vector2 with x (source's start's x + (direction's x * offset)) and y (source's start's y + (direction's y * offset))
            set finishPoint to a cad vector2 with x (source's finish's x + (direction's x * offset)) and y (source's finish's y + (direction's y * offset))
            if (the cad distance from startPoint to finishPoint) <= 1e-6:
                free preparedGrids
                free parsed's offsets
                return 0
            set label to the next bim grid name after label skipping letters skipsLetters
            loop while (bim grid pattern name label occurs in (target's grids's values)) or (bim grid pattern name label occurs in preparedGrids):
                set label to the next bim grid name after label skipping letters skipsLetters
            append (@intrinsic("construct", a bim grid record, the bim refused id, label, startPoint, finishPoint, source's low, source's high)) to preparedGrids
        set added to the length of preparedGrids
        loop cursor from 0 to added:
            set copy to the item at cursor in preparedGrids
            set freshCopy to add bim grid named copy's name from copy's start to copy's finish reaching copy's low to copy's high to target
            ignore set bim grid freshCopy height from copy's low to copy's high sharing common (bim grid source shares the common height in (@intrinsic("dereference", target))) in target
        free preparedGrids
        free parsed's offsets
        return added
