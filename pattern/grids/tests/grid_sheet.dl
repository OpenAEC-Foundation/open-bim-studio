# SPDX-License-Identifier: MPL-2.0
import ui/shell/bim_app_parts.dl

function check grid sheet {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set head to a new bim canvas
set head's paperScale to 1.0
draw bim grid head (the string form of "A") at (a cad vector2 with x 0.0 and y 0.0) faint false on (the address of head)
set ring to (the item at 0 in (head's batches's values))'s pixels's values
set highX to 0.0
loop cursor from 0 to the length of ring:
    set highX to the maximum of highX and (the item at cursor in ring)'s x
check grid sheet ((the absolute value of (highX - 3.125)) < 0.01) named (the string form of "sheet grid head has 6 mm diameter plus stroke")
set label to the item at 0 in (head's texts's values)
check grid sheet (label's y = 1.25) named (the string form of "grid label baseline uses paper millimetres")
set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set gridId to add bim grid named (the string form of "A") from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 10.0) reaching -1.0 to 3.0 to target
check grid sheet ((the bim head mask of grid gridId in editor's documentValue's current) = 3) named (the string form of "existing grids retain both heads")
select bim editor bim grid picked numbered gridId in (the address of editor)
start bim editor property bim grid head property in (the address of editor)
check grid sheet ((the bim head mask of grid gridId in editor's documentValue's current) = 0) named (the string form of "heads property changes both to none")
start bim editor property bim grid head property in (the address of editor)
check grid sheet ((the bim head mask of grid gridId in editor's documentValue's current) = 1) named (the string form of "heads property selects start only")
set transform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 40.0)
set gridCanvas to a new bim canvas
set gridCanvas's paperScale to 1.0
draw bim grids in plan of editor through transform on (the address of gridCanvas)
check grid sheet ((the length of (gridCanvas's texts's values)) = 1) named (the string form of "single head grid draws one label")
set dashes to an empty list of a cad vector2
append bim paper dash dot from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 100.0 and y 0.0) at 1.0 into dashes
check grid sheet ((the item at 1 in dashes)'s x = 4.5) named (the string form of "paper grid dash is 4.5 mm")
check grid sheet ((the item at 2 in dashes)'s x = 8.5) named (the string form of "paper grid gap is 4 mm")
set sheetId to add bim sheet numbered (the string form of "T-01") named (the string form of "Custom frame") on paper 0 landscape true to target
set bim property (the string form of "CustomFrame") of set (the string form of "OpenBIM_Drawing") of sheetId to (the string form of "true") typed (the string form of "IfcBoolean") in target
check grid sheet (bim sheet sheetId has a custom frame in editor's documentValue's current) named (the string form of "custom frame supported on model sheets")
set referenceId to add bim view of kind (bim plan view) named (the string form of "Frame") on editor's levelId to target
set viewFound to the bim view index of referenceId in editor's documentValue's current
set referenceView to the item at viewFound's position in (target's views's values)
loop cursor from 0 to the length of (referenceView's shown's values):
    replace item at index cursor in (referenceView's shown's values) with false
store bim view referenceView in target
set bim property (the string form of "Batch00000") of set (the string form of "OpenBIM_VectorTriangles") of referenceId to (the string form of "20 40 60 0 0 1 0 0 1") typed (the string form of "IfcText") in target
ignore place bim view referenceId on sheet sheetId at (a cad vector2 with x 100.0 and y 100.0) looking at (a cad vector2 with x 0.0 and y 0.0) in target
set sheetValue to the item at (the bim sheet index of sheetId in editor's documentValue's current)'s position in (target's sheets's values)
set emptyAtlas to @intrinsic("construct", a bim text atlas record, @intrinsic("construct", a graphics texture, 0 as a pointer to a byte, 0, 0), an empty list of a bim text face record, 0, 0, an empty list of a bim icon cell record)
set scene to an empty list of a bim scene mesh record
set referenceCanvas to a new bim canvas
record bim sheet sheetValue of editor among scene from (a cad vector2 with x 0.0 and y 841.0) at 1.0 using emptyAtlas on (the address of referenceCanvas)
check grid sheet ((the length of (referenceCanvas's batches's values)) = 2) named (the string form of "reference sheet records paper and artwork once")
check grid sheet ((the length of (referenceCanvas's texts's values)) = 0) named (the string form of "hidden reference view excludes model annotations")
replace item at index (bim grid category) in (referenceView's shown's values) with true
store bim view referenceView in target
set mixedCanvas to a new bim canvas
record bim sheet sheetValue of editor among scene from (a cad vector2 with x 0.0 and y 841.0) at 1.0 using emptyAtlas on (the address of mixedCanvas)
set referenceCount to 0
loop cursor from 0 to the length of (mixedCanvas's batches's values):
    set recorded to the item at cursor in (mixedCanvas's batches's values)
    if ((recorded's red = 20) and (recorded's green = 40)) and (recorded's blue = 60):
        set referenceCount to referenceCount + 1
check grid sheet (referenceCount = 1) named (the string form of "mixed model view records reference artwork once")
