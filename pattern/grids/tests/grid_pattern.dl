# SPDX-License-Identifier: MPL-2.0
# Strict spacing, stable perpendicular directions and one atomic grid batch.
import pattern/grids/bim_grid_pattern.dl

function check grid pattern {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function reject grid pattern {a string:patternText}:
    execute:
        set parsed to the bim grid spacing pattern of patternText metres per unit 0.001
        check grid pattern ((parsed's valid = false) and ((the length of parsed's offsets) = 0)) named (((the string form of "reject [") + patternText) + (the string form of "]"))
        free parsed's offsets

set parsed to the bim grid spacing pattern of (the string form of "5000 3000 3x5400") metres per unit 0.001
check grid pattern (parsed's valid and ((the length of parsed's offsets) = 5)) named (the string form of "millimetre repeats produce five offsets")
check grid pattern (((the item at 0 in parsed's offsets) = 5.0) and (((the item at 1 in parsed's offsets) = 8.0) and ((the absolute value of ((the item at 4 in parsed's offsets) - 24.2)) < 1e-9))) named (the string form of "offsets are cumulative metres")
free parsed's offsets
set parsed to the bim grid spacing pattern of (the string form of "  25.5   2X50  ") metres per unit 0.01
check grid pattern (parsed's valid and ((the absolute value of ((the item at 2 in parsed's offsets) - 1.255)) < 1e-9)) named (the string form of "centimetres decimals uppercase repeats and whitespace")
free parsed's offsets
set parsed to the bim grid spacing pattern of (the string form of "0.5 2x1.25") metres per unit 1.0
check grid pattern (parsed's valid and ((the item at 2 in parsed's offsets) = 3.0)) named (the string form of "metre spacing retains decimals")
free parsed's offsets
reject grid pattern (the string form of "")
reject grid pattern (the string form of "0")
reject grid pattern (the string form of "-5")
reject grid pattern (the string form of "5junk")
reject grid pattern (the string form of "2.5x3")
reject grid pattern (the string form of "2xx3")
reject grid pattern (the string form of "2x")
reject grid pattern (the string form of "0x5")
reject grid pattern (the string form of "2x0")
reject grid pattern (the string form of "5.2.3")
reject grid pattern (the string form of "3x5mm")
reject grid pattern (the string form of "1e309")
reject grid pattern (the string form of "500x1 501x1")
reject grid pattern (the string form of "999999999999999999999x1")
reject grid pattern (the string form of "1000000000 1")
set parsed to the bim grid spacing pattern of (the string form of "1000x1") metres per unit 0.001
check grid pattern (parsed's valid and ((the length of parsed's offsets) = 1000)) named (the string form of "bounded repeat limit remains usable")
free parsed's offsets
set oversized to a new string buffer containing 4097 bytes
loop cursor from 0 to 4097:
    store (32 as a byte) into the data of oversized at cursor
set parsed to the bim grid spacing pattern of oversized metres per unit 0.001
check grid pattern ((parsed's valid = false) and ((the length of parsed's offsets) = 0)) named (the string form of "oversized pattern rejected before scanning")
free parsed's offsets
set whitePattern to a new string buffer containing 7 bytes
copy (the string form of "1 2X3  ") into (the data of whitePattern) at offset 0
store (9 as a byte) into the data of whitePattern at 1
store (10 as a byte) into the data of whitePattern at 5
set parsed to the bim grid spacing pattern of whitePattern metres per unit 1.0
check grid pattern (parsed's valid and ((the item at 2 in parsed's offsets) = 7.0)) named (the string form of "tabs and newlines separate complete tokens")
free parsed's offsets
set parsed to the bim grid spacing pattern of (the string form of "1") metres per unit 0.0
check grid pattern (parsed's valid = false) named (the string form of "invalid unit scale refused")
free parsed's offsets
check grid pattern ((the next bim grid pattern name after (the string form of "Z")) = (the string form of "AA")) named (the string form of "letters continue beyond Z")
check grid pattern ((the next bim grid pattern name after (the string form of "AZ")) = (the string form of "BA")) named (the string form of "letter carry preserves prefix")
check grid pattern ((the next bim grid pattern name after (the string form of "zz")) = (the string form of "aaa")) named (the string form of "lowercase labels carry")
check grid pattern ((the next bim grid pattern name after (the string form of "A99")) = (the string form of "A100")) named (the string form of "number suffix carries without integer overflow")

set forward to the bim grid pattern direction from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 10.0)
set reverse to the bim grid pattern direction from (a cad vector2 with x 0.0 and y 10.0) to (a cad vector2 with x 0.0 and y 0.0)
check grid pattern ((forward's x = 1.0) and ((the cad distance from forward to reverse) < 1e-9)) named (the string form of "vertical copies go right independent of endpoint order")
set horizontal to the bim grid pattern direction from (a cad vector2 with x 10.0 and y 0.0) to (a cad vector2 with x 0.0 and y 0.0)
check grid pattern ((horizontal's x = 0.0) and (horizontal's y = -1.0)) named (the string form of "horizontal copies go down independent of endpoint order")
set diagonal to the bim grid pattern direction from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 3.0 and y 4.0)
check grid pattern (((the absolute value of (diagonal's x - 0.8)) < 1e-9) and ((the absolute value of (diagonal's y + 0.6)) < 1e-9)) named (the string form of "slanted copies use a unit perpendicular")

set documentValue to a new bim document
set target to the address of (documentValue's current)
set source to add bim grid named (the string form of "Z") from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 10.0) reaching -2.0 to 12.0 to target
ignore add bim grid named (the string form of "AA") from (a cad vector2 with x -5.0 and y 0.0) to (a cad vector2 with x -5.0 and y 10.0) reaching 0.0 to 3.0 to target
set beforeId to target's nextId
set refused to add bim grid copies of source spaced (the string form of "5000 bad") metres per unit 0.001 in target
check grid pattern ((refused = 0) and (((the length of (target's grids's values)) = 2) and (target's nextId = beforeId))) named (the string form of "late invalid token leaves grids and next id untouched")
set refused to add bim grid copies of (999999 as a 64 bit integer) spaced (the string form of "5000") metres per unit 0.001 in target
check grid pattern ((refused = 0) and (target's nextId = beforeId)) named (the string form of "stale grid id leaves model untouched")
set refused to add bim grid copies of source spaced (the string form of "5000 1000000001") metres per unit 0.001 in target
check grid pattern ((refused = 0) and (((the length of (target's grids's values)) = 2) and (target's nextId = beforeId))) named (the string form of "late oversized extent leaves model untouched")
begin bim transaction in (the address of documentValue)
set added to add bim grid copies of source spaced (the string form of "5000 2x3000") metres per unit 0.001 in target
commit bim transaction in (the address of documentValue)
check grid pattern ((added = 3) and ((the length of (target's grids's values)) = 5)) named (the string form of "one batch creates all parallel grids")
set first to the item at 2 in (target's grids's values)
set last to the item at 4 in (target's grids's values)
check grid pattern ((first's name = (the string form of "AB")) and (last's name = (the string form of "AD"))) named (the string form of "batch labels skip names already in the model")
check grid pattern ((first's start's x = 5.0) and ((last's start's x = 11.0) and (last's finish's y = 10.0))) named (the string form of "copies translate both endpoints by cumulative spacing")
check grid pattern ((last's low = -2.0) and (last's high = 12.0)) named (the string form of "copies retain vertical extents")
ignore undo bim transaction in (the address of documentValue)
check grid pattern ((the length of (documentValue's current's grids's values)) = 2) named (the string form of "one undo removes the entire batch")
ignore redo bim transaction in (the address of documentValue)
check grid pattern ((the length of (documentValue's current's grids's values)) = 5) named (the string form of "one redo restores the entire batch")
