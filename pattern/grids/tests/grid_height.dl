# SPDX-License-Identifier: MPL-2.0
# Grid height defaults, line overrides and native Properties transactions.
import ui/editor/bim_editor.dl
import bim/bim_grid_height.dl
import pattern/grids/bim_grid_pattern.dl

function check grid height {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the height test grid {a 64 bit integer:gridId} in {bim model record:modelValue}:
    execute:
        return the item at (the bim grid index of gridId in modelValue)'s position in (modelValue's grids's values)

function type grid height field {integer:code} text {a string:textValue} in {a pointer to a bim editor record:editor}:
    execute:
        start bim editor property code in editor
        set editor's propertyText to textValue
        apply bim editor property in editor

set modelValue to an empty bim model
set target to the address of modelValue
ignore add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
ignore add bim level named (the string form of "Upper") at 3.0 with height 3.0 to target
set rangeValue to the bim common grid height of modelValue
check grid height ((rangeValue's x = 0.0) and (rangeValue's y = 6.0)) named (the string form of "the initial common height is the full storey range")
set sharedId to add bim grid named (the string form of "1") from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 10.0) reaching 0.0 to 6.0 to target
set ownId to add bim grid named (the string form of "2") from (a cad vector2 with x 5.0 and y 0.0) to (a cad vector2 with x 5.0 and y 10.0) reaching 0.0 to 6.0 to target
set legacyId to add bim grid named (the string form of "3") from (a cad vector2 with x 10.0 and y 0.0) to (a cad vector2 with x 10.0 and y 10.0) reaching -1.0 to 4.0 to target
ignore set bim grid ownId height from 0.0 to 7.0 sharing common false in target
check grid height (bim grid (the height test grid sharedId in modelValue) shares the common height in modelValue) named (the string form of "a matching old line uses the common height")
check grid height ((bim grid (the height test grid legacyId in modelValue) shares the common height in modelValue) = false) named (the string form of "an old differing range remains a line override")
check grid height (set bim common grid height from -2.0 to 9.0 in target) named (the string form of "the common height accepts a basement range")
set sharedGrid to the height test grid sharedId in modelValue
check grid height ((sharedGrid's low = -2.0) and (sharedGrid's high = 9.0)) named (the string form of "the common edit changes the shared line")
check grid height (((the height test grid ownId in modelValue)'s high = 7.0) and ((the height test grid legacyId in modelValue)'s low = -1.0)) named (the string form of "explicit and legacy overrides retain their ranges")
ignore set bim grid sharedId height from -2.0 to 9.0 sharing common false in target
ignore set bim common grid height from 0.0 to 10.0 in target
check grid height ((the height test grid sharedId in modelValue)'s high = 9.0) named (the string form of "an explicit override can equal the former common range")
ignore set bim grid sharedId height from 0.0 to 10.0 sharing common true in target
check grid height ((set bim common grid height from 4.0 to 4.0 in target) = false) named (the string form of "a zero-height plane is refused")
check grid height ((set bim common grid height from 0.0 to 0.0000001 in target) = false) named (the string form of "a range that collapses in persisted precision is refused")

set editor to a new bim editor
set editor's documentValue's current to the bim snapshot of modelValue
set editor's lengthUnit to 0
select bim editor bim grid picked numbered sharedId in (the address of editor)
set baselineUndo to the length of (editor's documentValue's undoStack's values)
type grid height field (bim grid common top property) text (the string form of "12000") in (the address of editor)
if ((the height test grid sharedId in editor's documentValue's current)'s high != 12.0) or ((the length of (editor's documentValue's undoStack's values)) != (baselineUndo + 1)):
    print ((the string form of "Height property diagnostic: ") + editor's message) as a line
    print ((the string form of "Selection kind: ") + (the string form of editor's selectionKind)) as a line
    print ((the string form of "Stored high: ") + (the string form of (the height test grid sharedId in editor's documentValue's current)'s high)) as a line
    print ((the string form of "Undo count: ") + (the string form of (the length of (editor's documentValue's undoStack's values)))) as a line
check grid height (((the height test grid sharedId in editor's documentValue's current)'s high = 12.0) and ((the length of (editor's documentValue's undoStack's values)) = (baselineUndo + 1))) named (the string form of "typing the common top in millimetres is one undo step")
check grid height ((the height test grid ownId in editor's documentValue's current)'s high = 7.0) named (the string form of "the property leaves another line override unchanged")
ignore undo bim transaction in (the address of (editor's documentValue))
set savedNext to editor's documentValue's current's nextId
type grid height field (bim grid common top property) text (the string form of "NaN") in (the address of editor)
type grid height field (bim grid common base property) text (the string form of "15000") in (the address of editor)
check grid height (((the length of (editor's documentValue's undoStack's values)) = baselineUndo) and (((the length of (editor's documentValue's redoStack's values)) = 1) and (editor's documentValue's current's nextId = savedNext))) named (the string form of "invalid heights preserve undo redo and IDs")
ignore redo bim transaction in (the address of (editor's documentValue))
type grid height field (bim grid line base property) text (the string form of "-250") in (the address of editor)
set lineGrid to the height test grid sharedId in editor's documentValue's current
check grid height ((lineGrid's low = -0.25) and ((bim grid lineGrid shares the common height in editor's documentValue's current) = false)) named (the string form of "typing a line base creates a per-line override")
check grid height ((the bim common grid height of editor's documentValue's current)'s x = 0.0) named (the string form of "a line override does not change the common base")
start bim editor property (bim grid shared height property) in (the address of editor)
check grid height ((the height test grid sharedId in editor's documentValue's current)'s low = 0.0) named (the string form of "the common-height toggle restores the common range")
ignore undo bim transaction in (the address of (editor's documentValue))
check grid height ((the height test grid sharedId in editor's documentValue's current)'s low = -0.25) named (the string form of "undo restores the override")
ignore redo bim transaction in (the address of (editor's documentValue))
set rows to the bim property rows of editor
set axisClass to false
set heightRows to 0
loop cursor from 0 to the length of rows:
    set rowValue to the item at cursor in rows
    if (rowValue's label = (the string form of "IFC class")) and (rowValue's value = (the string form of "IfcGridAxis")):
        set axisClass to true
    if (rowValue's code >= bim grid common base property) and (rowValue's code <= bim grid shared height property):
        set heightRows to heightRows + 1
free rows
check grid height (axisClass and (heightRows = 5)) named (the string form of "Properties identifies the axis and exposes the five height controls")
set editorTarget to the address of (editor's documentValue's current)
ignore add bim grid copies of sharedId spaced (the string form of "1000") metres per unit 0.001 in editorTarget
set copied to the last item of (editorTarget's grids's values)
check grid height (bim grid copied shares the common height in (@intrinsic("dereference", editorTarget))) named (the string form of "spacing copies keep the common-height mode")
ignore set bim common grid height from -1.0 to 14.0 in editorTarget
check grid height (((the height test grid copied's id in (@intrinsic("dereference", editorTarget)))'s high = 14.0) and ((the height test grid sharedId in (@intrinsic("dereference", editorTarget)))'s high = 14.0)) named (the string form of "a later common edit changes the source and its copy")

set automaticModel to an empty bim model
set automaticTarget to the address of automaticModel
ignore add bim level named (the string form of "Ground") at 0.0 with height 3.0 to automaticTarget
set automaticId to add bim grid named (the string form of "A") from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 5.0 and y 0.0) reaching 0.0 to 3.0 to automaticTarget
ignore set bim grid automaticId height from 0.0 to 3.0 sharing common true in automaticTarget
ignore add bim level named (the string form of "Upper") at 3.0 with height 4.0 to automaticTarget
refresh bim shared grid heights in automaticTarget
check grid height ((the height test grid automaticId in automaticModel)'s high = 7.0) named (the string form of "explicitly shared heights refresh after storey edits")
set native to the bim native text of ifcx (the bim ifcx text of editor's documentValue's current identified as (the string form of "height.ifcx") for project (the string form of "Heights") by (the string form of "test") at (the string form of "2026-10-31T00:00:00Z"))
set reread to the bim model parsed from native's text
check grid height (native's valid and (reread's valid and ((the bim file text of reread's modelValue) = (the bim file text of editor's documentValue's current)))) named (the string form of "IFCX retains common heights and per-line modes")
