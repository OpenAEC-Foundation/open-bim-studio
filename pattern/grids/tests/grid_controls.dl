# SPDX-License-Identifier: MPL-2.0
# The plus handles of a selected grid line (#59): one on each side beside a
# visible head, kept inside the viewport and clear of the heads; the side
# each adds on, in the model's terms.
import pattern/grids/bim_grid_controls.dl

function check grid control {boolean:accepted} named {a string:captionText}:
    execute:
        if accepted = false:
            print ((the string form of "FAIL: ") + captionText) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + captionText) as a line

function grid control {cad vector2:spot} is inside:
    execute:
        return ((spot's x >= 12.0) and (spot's x <= 88.0)) and ((spot's y >= 12.0) and (spot's y <= 88.0))

set lowPixel to a cad vector2 with x 0.0 and y 0.0
set highPixel to a cad vector2 with x 100.0 and y 100.0
set controlValue to the bim grid add placement from (a cad vector2 with x 100.0 and y 60.0) to (a cad vector2 with x 100.0 and y 100.0) between lowPixel and (a cad vector2 with x 200.0 and y 200.0)
check grid control (controlValue's visible and ((the cad distance from controlValue's point to (a cad vector2 with x 63.0 and y 100.0)) < 1e-9)) named (the string form of "a plus left of the last head")
check grid control (controlValue's otherVisible and ((the cad distance from controlValue's other to (a cad vector2 with x 137.0 and y 100.0)) < 1e-9)) named (the string form of "a plus right of the last head")
check grid control (controlValue's side = 1.0) named (the string form of "the first plus is on the screen's left")
set controlValue to the bim grid add placement from (a cad vector2 with x 50.0 and y 80.0) to (a cad vector2 with x 50.0 and y -30.0) between lowPixel and highPixel
check grid control ((controlValue's visible and controlValue's otherVisible) and ((the cad distance from controlValue's point to (a cad vector2 with x 87.0 and y 80.0)) < 1e-9)) named (the string form of "the other visible head carries both pluses")
check grid control ((the cad distance from controlValue's other to (a cad vector2 with x 13.0 and y 80.0)) < 1e-9) named (the string form of "the second plus mirrors the first")
set controlValue to the bim grid add placement from (a cad vector2 with x -30.0 and y -30.0) to (a cad vector2 with x -30.0 and y 130.0) between lowPixel and highPixel
check grid control ((controlValue's visible = false) and (controlValue's otherVisible = false)) named (the string form of "fully invisible grid has no detached button")
set controlValue to the bim grid add placement from (a cad vector2 with x -30.0 and y 50.0) to (a cad vector2 with x 130.0 and y 50.0) between lowPixel and highPixel
check grid control ((controlValue's visible = false) and (controlValue's otherVisible = false)) named (the string form of "a crossing line without visible heads has no detached button")
set controlValue to the bim grid add placement from (a cad vector2 with x 3.0 and y 60.0) to (a cad vector2 with x 3.0 and y 3.0) between lowPixel and highPixel
check grid control (controlValue's visible and (grid control controlValue's point is inside)) named (the string form of "corner fallback keeps the entire fixed size button visible")
check grid control (controlValue's otherVisible = false) named (the string form of "a plus that fits nowhere clear of the heads is left out")

# The model's side: model x runs right on the screen, so left of a line
# drawn downwards on the screen is the model's -1 side.
set leftSide to the bim grid add side from (a cad vector2 with x 100.0 and y 60.0) to (a cad vector2 with x 100.0 and y 100.0) ahead at (a cad vector2 with x 110.0 and y 60.0)
check grid control (leftSide = -1.0) named (the string form of "the screen's left is told in the model's terms")
set controlValue to the bim grid add placement from (a cad vector2 with x 100.0 and y 60.0) to (a cad vector2 with x 100.0 and y 100.0) between lowPixel and (a cad vector2 with x 200.0 and y 200.0)
set controlValue to the bim grid add control placed as controlValue with left side leftSide
check grid control ((the bim grid add side of controlValue at (a cad vector2 with x 65.0 and y 101.0)) = -1.0) named (the string form of "the left plus adds on the model's -1 side")
check grid control ((the bim grid add side of controlValue at (a cad vector2 with x 137.0 and y 100.0)) = 1.0) named (the string form of "the right plus adds on the model's 1 side")
check grid control ((the bim grid add side of controlValue at (a cad vector2 with x 100.0 and y 130.0)) = 0.0) named (the string form of "a click beside both pluses adds nothing")
