# SPDX-License-Identifier: MPL-2.0
# Renumbering one direction of a grid in order across it, names unique per
# direction, and skipping I and O (#60).
import pattern/grids/bim_grid_names.dl

function check grid names {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function the grid name of {a 64 bit integer:gridId} in {bim model record:modelValue}:
    execute:
        set found to the bim grid index of gridId in modelValue
        return (the item at found's position in (modelValue's grids's values))'s name

set documentValue to a new bim document
set target to the address of (documentValue's current)
# Three north-south lines out of order, and three west-east lines, one
# drawn from east to west.
set eastLine to add bim grid named (the string form of "x") from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 6.0 and y 10.0) reaching 0.0 to 3.0 to target
set westLine to add bim grid named (the string form of "y") from (a cad vector2 with x 0.0 and y 10.0) to (a cad vector2 with x 0.0 and y 0.0) reaching 0.0 to 3.0 to target
set middleLine to add bim grid named (the string form of "z") from (a cad vector2 with x 3.0 and y 0.0) to (a cad vector2 with x 3.0 and y 10.0) reaching 0.0 to 3.0 to target
set topLine to add bim grid named (the string form of "C") from (a cad vector2 with x -1.0 and y 10.0) to (a cad vector2 with x 7.0 and y 10.0) reaching 0.0 to 3.0 to target
set bottomLine to add bim grid named (the string form of "A") from (a cad vector2 with x 7.0 and y 0.0) to (a cad vector2 with x -1.0 and y 0.0) reaching 0.0 to 3.0 to target
set centreLine to add bim grid named (the string form of "B") from (a cad vector2 with x -1.0 and y 5.0) to (a cad vector2 with x 7.0 and y 5.0) reaching 0.0 to 3.0 to target

set placeList to the bim grid places across lines parallel to middleLine in documentValue's current
check grid names ((the length of placeList) = 3) named (the string form of "a direction holds its parallel lines only")
check grid names ((((the item at 0 in placeList) = 1) and ((the item at 1 in placeList) = 2)) and ((the item at 2 in placeList) = 0)) named (the string form of "north-south lines are ordered left to right")
free placeList
set placeList to the bim grid places across lines parallel to topLine in documentValue's current
check grid names ((((the item at 0 in placeList) = 4) and ((the item at 1 in placeList) = 5)) and ((the item at 2 in placeList) = 3)) named (the string form of "west-east lines are ordered bottom to top, whichever way they run")
free placeList

begin bim transaction in (the address of documentValue)
set renumbered to renumber bim grids parallel to eastLine from (the string form of "1") in target
commit bim transaction in (the address of documentValue)
check grid names (renumbered = 3) named (the string form of "renumbering counts the lines of the direction")
check grid names ((((the grid name of westLine in documentValue's current) = (the string form of "1")) and ((the grid name of middleLine in documentValue's current) = (the string form of "2"))) and ((the grid name of eastLine in documentValue's current) = (the string form of "3"))) named (the string form of "numbers follow the order across")
check grid names ((the grid name of bottomLine in documentValue's current) = (the string form of "A")) named (the string form of "the other direction keeps its names")
check grid names ((the first bim grid name across lines parallel to eastLine in documentValue's current) = (the string form of "1")) named (the string form of "the first name of a direction")
ignore undo bim transaction in (the address of documentValue)
check grid names ((the grid name of westLine in documentValue's current) = (the string form of "y")) named (the string form of "one undo restores every name")
ignore redo bim transaction in (the address of documentValue)

check grid names (bim grid name (the string form of "2") is taken across lines parallel to westLine in documentValue's current) named (the string form of "a name of the same direction is taken")
check grid names ((bim grid name (the string form of "1") is taken across lines parallel to westLine in documentValue's current) = false) named (the string form of "a line's own name is not taken")
check grid names ((bim grid name (the string form of "A") is taken across lines parallel to westLine in documentValue's current) = false) named (the string form of "names are unique per direction only")

check grid names ((bim grid names skip letters in documentValue's current) = false) named (the string form of "every letter by default")
set bim setting (bim grid names skip setting) of (0 as a 64 bit integer) to (1 as a 64 bit integer) keeping true in target
ignore renumber bim grids parallel to centreLine from (the string form of "H") in target
check grid names ((((the grid name of bottomLine in documentValue's current) = (the string form of "H")) and ((the grid name of centreLine in documentValue's current) = (the string form of "J"))) and ((the grid name of topLine in documentValue's current) = (the string form of "K"))) named (the string form of "renumbering skips I when the project says so")
ignore renumber bim grids parallel to centreLine from (the string form of "a") in target
check grid names ((the grid name of topLine in documentValue's current) = (the string form of "c")) named (the string form of "lowercase letters continue as lowercase")

check grid names ((renumber bim grids parallel to centreLine from (the string form of "") in target) = 0) named (the string form of "an empty first name is refused")
check grid names ((renumber bim grids parallel to (999999 as a 64 bit integer) from (the string form of "1") in target) = 0) named (the string form of "a stale id is refused")
check grid names ((the grid name of topLine in documentValue's current) = (the string form of "c")) named (the string form of "a refusal leaves the names")
