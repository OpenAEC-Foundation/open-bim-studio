# SPDX-License-Identifier: MPL-2.0
# Grid placement uses the exact cursor position before and after its first click.
import ui/editor/bim_editor_core.dl

function check grid cursor snap {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set editor to a new bim editor
set editor's tool to bim grid tool
place bim editor cursor at (a cad vector2 with x 3.013 and y 5.027) in (the address of editor)
set nearby to a cad vector2 with x 3.043 and y 5.047
set snapped to the bim snap of nearby in editor within 0.1
check grid cursor snap (snapped's label = (the string form of "3D cursor")) named (the string form of "grid start recognises the 3D cursor")
check grid cursor snap ((the cad distance from snapped's point to (a cad vector2 with x 3.013 and y 5.027)) < 1e-9) named (the string form of "cursor coordinates are not rounded to the grid")

set editor's gridActive to true
set editor's gridStart to a cad vector2 with x 0.0 and y 5.0
set snapped to the bim snap of nearby in editor within 0.1
check grid cursor snap (snapped's label = (the string form of "3D cursor")) named (the string form of "grid end snaps before horizontal tracking")
place bim editor cursor at (a cad vector2 with x 7.013 and y 8.027) in (the address of editor)
set snapped to the bim snap of (a cad vector2 with x 7.043 and y 8.047) in editor within 0.1
check grid cursor snap ((the cad distance from snapped's point to (a cad vector2 with x 7.013 and y 8.027)) < 1e-9) named (the string form of "moving the cursor updates the snap target")
set snapped to the bim snap of nearby in editor within 0.1
check grid cursor snap (snapped's label != (the string form of "3D cursor")) named (the string form of "cursor outside the tolerance does not attract the pointer")

place bim editor cursor at (a cad vector2 with x 3.013 and y 5.027) in (the address of editor)
set editor's snapOff to true
set snapped to the bim snap of nearby in editor within 0.1
check grid cursor snap ((snapped's label = (the string form of "Free")) and ((the cad distance from snapped's point to nearby) < 1e-9)) named (the string form of "F3 keeps cursor snapping disabled")
set editor's snapOff to false
set editor's snapRefused to the bim snap bit of 0
set snapped to the bim snap of nearby in editor within 0.1
check grid cursor snap (snapped's label != (the string form of "3D cursor")) named (the string form of "endpoint snap toggle also controls the cursor")
set editor's snapRefused to 0
set editor's tool to bim select tool
set snapped to the bim snap of nearby in editor within 0.1
check grid cursor snap (snapped's label != (the string form of "3D cursor")) named (the string form of "other tools retain their existing snap behaviour")
