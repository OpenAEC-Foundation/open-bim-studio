# SPDX-License-Identifier: MPL-2.0
# Renaming and renumbering grid lines from the properties (and so from the
# context menu, which lists them) (#60), and the grid's drag toggle (#61).
import ui/editor/bim_editor.dl

function check grid renumber {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function type grid field {integer:fieldCode} with {a string:inputValue} in {a pointer to a bim editor record:editTarget}:
    execute:
        start bim editor property fieldCode in editTarget
        set editTarget's propertyText to inputValue
        apply bim editor property in editTarget

function the test name of grid {a 64 bit integer:gridId} in {bim editor record:editor}:
    execute:
        set found to the bim grid index of gridId in editor's documentValue's current
        return (the item at found's position in (editor's documentValue's current's grids's values))'s name

set gridEditor to a new bim editor
set ep to the address of gridEditor
set modelTarget to the address of (gridEditor's documentValue's current)
set lineOne to add bim grid named (the string form of "7") from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 10.0) reaching -2.0 to 12.0 to modelTarget
set lineTwo to add bim grid named (the string form of "8") from (a cad vector2 with x 4.0 and y 0.0) to (a cad vector2 with x 4.0 and y 10.0) reaching -2.0 to 12.0 to modelTarget
set lineThree to add bim grid named (the string form of "9") from (a cad vector2 with x 8.0 and y 0.0) to (a cad vector2 with x 8.0 and y 10.0) reaching -2.0 to 12.0 to modelTarget
set crossLine to add bim grid named (the string form of "A") from (a cad vector2 with x -1.0 and y 5.0) to (a cad vector2 with x 9.0 and y 5.0) reaching -2.0 to 12.0 to modelTarget
select bim editor bim grid picked numbered lineTwo in ep

set rowsShown to the bim property rows of gridEditor
set directionRows to 0
loop rowCursor from 0 to the length of rowsShown:
    set rowValue to the item at rowCursor in rowsShown
    if (rowValue's code = bim grid renumber property) and (rowValue's value = (the string form of "7")):
        set directionRows to directionRows + 1
    if (rowValue's code = bim grid skip letters property) or (rowValue's code = bim grid ends drag property):
        set directionRows to directionRows + 1
check grid renumber (directionRows = 3) named (the string form of "the direction's rows show its first name and the toggles")
free rowsShown

# One line: a name the direction holds already is refused.
type grid field bim grid name property with (the string form of "9") in ep
check grid renumber ((the test name of grid lineTwo in gridEditor) = (the string form of "8")) named (the string form of "a name taken in the direction is refused")
type grid field bim grid name property with (the string form of "A") in ep
check grid renumber ((the test name of grid lineTwo in gridEditor) = (the string form of "A")) named (the string form of "a name of the other direction is allowed")

# The whole direction, from its first line on.
start bim editor property bim grid renumber property in ep
check grid renumber (bim editor edits reinforcement text gridEditor) named (the string form of "the first name is typed as text")
set gridEditor's propertyText to the string form of " 1 "
apply bim editor property in ep
check grid renumber ((((the test name of grid lineOne in gridEditor) = (the string form of "1")) and ((the test name of grid lineTwo in gridEditor) = (the string form of "2"))) and ((the test name of grid lineThree in gridEditor) = (the string form of "3"))) named (the string form of "the direction renumbers in order")
check grid renumber ((the test name of grid crossLine in gridEditor) = (the string form of "A")) named (the string form of "the other direction keeps its names")
ignore undo bim transaction in (the address of (gridEditor's documentValue))
check grid renumber ((the test name of grid lineThree in gridEditor) = (the string form of "9")) named (the string form of "one undo restores the direction")
ignore redo bim transaction in (the address of (gridEditor's documentValue))

# Letters past I and O, once the project skips them.
start bim editor property bim grid skip letters property in ep
check grid renumber (bim grid names skip letters in gridEditor's documentValue's current) named (the string form of "a click skips I and O")
type grid field bim grid renumber property with (the string form of "H") in ep
check grid renumber ((the test name of grid lineThree in gridEditor) = (the string form of "K")) named (the string form of "renumbering letters passes I")
type grid field bim grid renumber property with (the string form of "   ") in ep
check grid renumber ((the test name of grid lineOne in gridEditor) = (the string form of "H")) named (the string form of "a blank first name is refused")

start bim editor property bim grid ends drag property in ep
check grid renumber gridEditor's gridEndsAlone named (the string form of "a click lets the ends drag alone")
