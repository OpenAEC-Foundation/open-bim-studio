# SPDX-License-Identifier: MPL-2.0
# A grid's head stands beyond its end by the head extension.
#
# A grid from (0, 0) to (0, 5) keeps its ends; as it is drawn in plan its
# line runs on 1000 mm past each end that carries a head, and the head
# stands there: a click 1 m beyond the end takes the head, a click on the
# bare end does not. With a head at the start only, only the start runs
# on. The extension goes by the drawing's scale (1500 mm at 1:50, 3000 at
# 1:5; a scale between takes the nearest); the model keeps another for a
# scale (500 mm at 1:100), or none (0).
import ui/editor/bim_editor.dl
import bim/bim_grid_height.dl

function show headed grid {bim grid record:shown} labelled {a string:caption}:
    execute:
        print (caption + ((the string form of ": y ") + ((the bim millimetre text of shown's start's y) + ((the string form of " to ") + (the bim millimetre text of shown's finish's y))))) as a line

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set gridId to add bim grid named (the string form of "1") from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 5.0) reaching 0.0 to 3.0 to target
refresh bim editor (the address of editor)
set ownGrid to the item at 0 in (target's grids's values)
show headed grid ownGrid labelled (the string form of "as drawn")
show headed grid (the bim headed grid ownGrid drawn at 1 to 100.0 in editor's documentValue's current) labelled (the string form of "with its heads")
set atHead to the bim grid head near (a cad vector2 with x 0.0 and y 6.0) in editor within 0.1
set atEnd to the bim grid head near (a cad vector2 with x 0.0 and y 5.0) in editor within 0.1
print ((the string form of "a click at the head takes it: ") + (the string form of (atHead = gridId))) as a line
print ((the string form of "a click at the bare end takes it: ") + (the string form of (atEnd = gridId))) as a line
print ((the string form of "a click on the line past the end takes the grid: ") + (the string form of ((the bim grid near (a cad vector2 with x 0.0 and y 5.5) in editor within 0.05) = gridId))) as a line
set bim setting 2400410 of gridId to (1 as a 64 bit integer) keeping true in target
show headed grid (the bim headed grid ownGrid drawn at 1 to 100.0 in editor's documentValue's current) labelled (the string form of "a head at the start only")
set bim setting 2400410 of gridId to (3 as a 64 bit integer) keeping true in target
keep bim grid head extension 0.5 drawn at 1 to 100.0 in target
show headed grid (the bim headed grid ownGrid drawn at 1 to 100.0 in editor's documentValue's current) labelled (the string form of "extension 500 at 1:100")
show headed grid (the bim headed grid ownGrid drawn at 1 to 50.0 in editor's documentValue's current) labelled (the string form of "at 1:50, still its own")
show headed grid (the bim headed grid ownGrid drawn at 1 to 75.0 in editor's documentValue's current) labelled (the string form of "at 1:75, the nearest scale (1:100)")
show headed grid (the bim headed grid ownGrid drawn at 1 to 5.0 in editor's documentValue's current) labelled (the string form of "at 1:5")
keep bim grid head extension 0.0 drawn at 1 to 100.0 in target
show headed grid (the bim headed grid ownGrid drawn at 1 to 100.0 in editor's documentValue's current) labelled (the string form of "extension 0 at 1:100")
