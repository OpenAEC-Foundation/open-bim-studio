# SPDX-License-Identifier: MPL-2.0
# The facade module's part of the scene: curtain walls, in pieces of one material each. Called by the
# composed dispatcher (`append bim module scene meshes of`) in layer order;
# the order does not matter, kept meshes are found by element id and part.
import viewer/bim_scene.dl

function append bim scene meshes of {bim model record:modelValue} within {a 64 bit floating-point number:tolerance} reusing {a pointer to a list:previous} keyed {a pointer to a list:keys} refreshing {a pointer to a list:remadeIds} with reinforcement detail {boolean:rebarDetail} into {a pointer to a list:result} with pattern_facade elements:
    execute:
        # Curtain walls, in pieces of one material each: a masonry's bricks
        # apart from its joints, glass apart from its frame. Kept, they are
        # the pieces of `previous` with the wall's id, counted from the
        # piece base.
        loop cursor from 0 to the length of (modelValue's curtains's values):
            set curtainValue to the item at cursor in (modelValue's curtains's values)
            set keptPieces to 0
            loop while (the bim kept slot of curtainValue's id part ((bim curtain piece part base) + keptPieces) among keys unless remadeIds) >= 0:
                set keptPieces to keptPieces + 1
            if keptPieces > 0:
                loop pieceCursor from 0 to keptPieces:
                    append (the item at (the bim kept slot of curtainValue's id part ((bim curtain piece part base) + pieceCursor) among keys) in previous) to result
            else:
                set curtainPieces to the bim curtain pieces of curtainValue in modelValue within tolerance
                loop pieceCursor from 0 to the length of (curtainPieces's values):
                    set curtainPiece to the item at pieceCursor in (curtainPieces's values)
                    append (@intrinsic("construct", a bim scene mesh record, curtainValue's id, 0 as a 64 bit integer, (bim curtain piece part base) + pieceCursor, curtainPiece's shape, bim wall category, the bim material colour of curtainPiece's material, curtainPiece's material)) to result
