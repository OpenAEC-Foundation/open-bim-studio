# SPDX-License-Identifier: MPL-2.0
# A curtain wall as a generator of linear elements: 6 m long and 3 m high in
# bays of at most 1.2 m and rows of at most 1.5 m gives 6 mullions, 3
# transoms and 10 glass panels, the glass 1.15 x 1.45 m each and 24 mm thick,
# its volume exact; it reads back from .bim and .ifcx.
import graphics/bim_scene.dl
import formats/bim_file.dl
import formats/bim_ifcx.dl
import formats/bim_ifcx_read.dl

function show curtain test walls of {bim model record:modelValue} labelled {a string:title}:
    execute:
        print title as a line
        loop cursor from 0 to the length of (modelValue's curtains's values):
            set curtainValue to the item at cursor in (modelValue's curtains's values)
            set curtainParts to the bim parts of curtain wall curtainValue in modelValue
            set mullions to 0
            set transoms to 0
            set panels to 0
            set glass to 0.0
            loop partCursor from 0 to the length of (curtainParts's values):
                set derivedPart to the item at partCursor in (curtainParts's values)
                if derivedPart's kind's name = (the string form of "Mullion"):
                    set mullions to mullions + 1
                if derivedPart's kind's name = (the string form of "Transom"):
                    set transoms to transoms + 1
                if derivedPart's kind's name = (the string form of "Panel"):
                    set panels to panels + 1
                    set glass to glass + (the absolute value of (the bim volume of mesh (the bim linear shape of derivedPart's element typed derivedPart's kind in modelValue within 0.0)))
            set expectedGlass to 10.0 * ((1.15 * 1.45) * 0.024)
            print ((the string form of "  mullions ") + ((the string form of mullions) + ((the string form of ", transoms ") + ((the string form of transoms) + ((the string form of ", panels ") + ((the string form of panels) + ((the string form of ", glass volume as expected ") + (the string form of ((the absolute value of (glass - expectedGlass)) < 1e-9))))))))) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to target
set curtainId to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
print ((the string form of "refused short: ") + (the string form of ((add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.2 and y 0.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target) = the bim refused id))) as a line
show curtain test walls of modelValue labelled (the string form of "curtain wall:")
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", ") + reread's message))) as a line
show curtain test walls of reread's modelValue labelled (the string form of "from .bim:")
set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "c.ifcx") for project (the string form of "c") by (the string form of "test") at (the string form of "2026-10-09T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of ", ") + fromIfcx's message))) as a line
show curtain test walls of fromIfcx's modelValue labelled (the string form of "from .ifcx:")
