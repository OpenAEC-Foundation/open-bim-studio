# SPDX-License-Identifier: MPL-2.0
# Pure planning primitives. Lengths use the same unit within each call;
# no model mutation, stock allocation or connection resolution occurs here.
import lib/std.dl

class:
    patterns:
        [a|] bim equal unit plan record
    members:
        valid as a boolean
        count as an integer
        unitLength as a 64 bit floating-point number

# Equal zero-gap units, without opening exclusions or support constraints.
# This is a candidate for the prefab solver, not a complete prefab plan.
# Explicit limits bound input magnitude, work and output count.
function the bim equal unit plan for length {a 64 bit floating-point number:totalLength} maximum {a 64 bit floating-point number:maximumLength} limited to {integer:unitLimit}:
    execute:
        if (((totalLength > 0.0) and (totalLength <= 1000000000.0)) and ((maximumLength > 0.0) and (maximumLength <= 1000000000.0))) = false:
            return @intrinsic("construct", a bim equal unit plan record, false, 0, 0.0)
        if (unitLimit < 1) or (unitLimit > 10000):
            return @intrinsic("construct", a bim equal unit plan record, false, 0, 0.0)
        set unitCount to 1
        loop while ((totalLength / (unitCount as a 64 bit floating-point number)) > maximumLength) and (unitCount < unitLimit):
            set unitCount to unitCount + 1
        set candidateLength to totalLength / (unitCount as a 64 bit floating-point number)
        if candidateLength > maximumLength:
            return @intrinsic("construct", a bim equal unit plan record, false, 0, 0.0)
        return @intrinsic("construct", a bim equal unit plan record, true, unitCount, candidateLength)

class:
    patterns:
        [a|] bim strip cut record
    members:
        valid as a boolean
        installedWidth as a 64 bit floating-point number
        kerfWidth as a 64 bit floating-point number
        residualWidth as a 64 bit floating-point number

# One full-length guillotine strip cut. Exact stock fit needs no cut.
# Otherwise the kerf consumes min(kerf, stock-required); a blade can overrun
# the free stock edge. Residual reuse compatibility is checked separately.
function the bim strip cut from width {a 64 bit floating-point number:stockWidth} requiring {a 64 bit floating-point number:requiredWidth} kerf {a 64 bit floating-point number:kerfValue}:
    execute:
        if (((stockWidth > 0.0) and (stockWidth <= 1000000000.0)) and ((requiredWidth > 0.0) and (requiredWidth <= stockWidth))) = false:
            return @intrinsic("construct", a bim strip cut record, false, 0.0, 0.0, 0.0)
        if ((kerfValue >= 0.0) and (kerfValue <= 1000000000.0)) = false:
            return @intrinsic("construct", a bim strip cut record, false, 0.0, 0.0, 0.0)
        set availableWidth to stockWidth - requiredWidth
        set lostWidth to kerfValue
        if lostWidth > availableWidth:
            set lostWidth to availableWidth
        return @intrinsic("construct", a bim strip cut record, true, requiredWidth, lostWidth, availableWidth - lostWidth)

# Feasibility for a rectangular remnant in its existing orientation, no
# further cuts: caller supplies actual dimensions and edge/direction checks.
# Stock identity, batch, reservation and rotation belong to the ledger.
function bim rectangular remnant width {a 64 bit floating-point number:availableWidth} length {a 64 bit floating-point number:availableLength} fits width {a 64 bit floating-point number:neededWidth} length {a 64 bit floating-point number:neededLength} with compatible edges {boolean:edgesMatch} and direction {boolean:directionMatches}:
    execute:
        if (edgesMatch and directionMatches) = false:
            return false
        if (((availableWidth > 0.0) and (availableWidth <= 1000000000.0)) and ((availableLength > 0.0) and (availableLength <= 1000000000.0))) = false:
            return false
        return ((neededWidth > 0.0) and (neededWidth <= availableWidth)) and ((neededLength > 0.0) and (neededLength <= availableLength))
