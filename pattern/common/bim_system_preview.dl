# SPDX-License-Identifier: MPL-2.0
# Builds a separate proposal document. Never updates the inspected source host.
import pattern/common/bim_system_inspection.dl

class:
    patterns:
        [a|] bim rectangular preview record
    members:
        valid as a boolean
        diagnostic as a string
        modelValue as a bim model record
        systemId as a 64 bit integer
        retainedOverrides as an integer
        addedOverrides as an integer

local function the bim rectangle preview refusal saying {a string:reasonText}:
    execute:
        return @intrinsic("construct", a bim rectangular preview record, false, reasonText, an empty bim model, the bim refused id, 0, 0)

local function bim rectangle pinned definition {bim rectangular definition record:firstValue} agrees with {bim rectangular definition record:secondValue}:
    execute:
        if (firstValue's identity != secondValue's identity) or (firstValue's version != secondValue's version):
            return false
        if (firstValue's pitchU != secondValue's pitchU) or (firstValue's pitchV != secondValue's pitchV):
            return false
        if ((firstValue's jointWidth != secondValue's jointWidth) or (firstValue's frameDepth != secondValue's frameDepth)) or (firstValue's panelThickness != secondValue's panelThickness):
            return false
        if (firstValue's frameMaterial != secondValue's frameMaterial) or (firstValue's panelMaterial != secondValue's panelMaterial):
            return false
        return (firstValue's frameBinding = secondValue's frameBinding) and (firstValue's panelBinding = secondValue's panelBinding)

local function the bim rectangle retention diagnostic from {bim rectangular input record:previousInput} to {bim rectangular input record:proposedInput}:
    execute:
        if previousInput's occurrenceValue's identity != proposedInput's occurrenceValue's identity:
            return the string form of "preview: occurrence identity must remain unchanged"
        if (bim rectangle pinned definition previousInput's definitionValue agrees with proposedInput's definitionValue) = false:
            return the string form of "preview: pinned definition cannot be redefined or migrated"
        loop oldCursor from 0 to the length of previousInput's replacements:
            set previousOverride to the item at oldCursor in previousInput's replacements
            set retained to false
            loop newCursor from 0 to the length of proposedInput's replacements:
                set proposedOverride to the item at newCursor in proposedInput's replacements
                if (previousOverride's ordinalU = proposedOverride's ordinalU) and (previousOverride's ordinalV = proposedOverride's ordinalV):
                    set retained to true
                    if (previousOverride's componentKey != proposedOverride's componentKey) or (previousOverride's material != proposedOverride's material):
                        return the string form of "preview: changing an existing replacement needs an explicit policy"
                    if ((previousOverride's thickness != proposedOverride's thickness) or (previousOverride's nominalU != proposedOverride's nominalU)) or ((previousOverride's nominalV != proposedOverride's nominalV) or (previousOverride's supportCompatible != proposedOverride's supportCompatible)):
                        return the string form of "preview: changing an existing replacement needs an explicit policy"
            if retained = false:
                return the string form of "preview: an existing semantic replacement was omitted"
        return the string form of ""

function the bim rectangle preview of {a 64 bit integer:sourceId} in {bim model record:sourceModel} proposing {a string:proposedText} with capabilities {boolean:canGenerate} bindings {boolean:canBind}:
    execute:
        if (canGenerate = false) or (canBind = false):
            return the bim rectangle preview refusal saying (the string form of "preview: runtime generation capability and bindings are required")
        set sourceInspection to inspect bim rectangle sourceId in sourceModel
        if sourceInspection's matches = false:
            return the bim rectangle preview refusal saying ((the string form of "source: ") + sourceInspection's diagnostic)
        set proposedInput to the bim rectangle input parsed from proposedText with capabilities canGenerate bindings canBind
        if proposedInput's valid = false:
            free proposedInput's replacements
            return the bim rectangle preview refusal saying proposedInput's diagnostic
        set storedText to the bim property value (the string form of "InputV1") of set (the string form of "OpenBIM_RectangularGeneration") of sourceId in sourceModel
        set previousInput to the bim rectangle input parsed from storedText with capabilities true bindings true
        if previousInput's valid = false:
            free previousInput's replacements
            free proposedInput's replacements
            return the bim rectangle preview refusal saying previousInput's diagnostic
        set retainedCount to the length of previousInput's replacements
        set addedCount to (the length of proposedInput's replacements) - retainedCount
        set retentionMessage to the bim rectangle retention diagnostic from previousInput to proposedInput
        free previousInput's replacements
        if (the length of retentionMessage) > 0:
            free proposedInput's replacements
            return the bim rectangle preview refusal saying retentionMessage
        set proposalEncoding to the bim rectangle input encoding of proposedInput's definitionValue for proposedInput's occurrenceValue replacing proposedInput's replacements
        free proposedInput's replacements
        if proposalEncoding's valid = false:
            return the bim rectangle preview refusal saying proposalEncoding's diagnostic
        set sourceHost to the item at (the bim curtain index of sourceId in sourceModel)'s position in (sourceModel's curtains's values)
        set sourceLevel to the item at (the bim level index of sourceHost's levelId in sourceModel)'s position in (sourceModel's levels's values)
        set previewModel to an empty bim model
        set previewLevel to add bim level named sourceLevel's name at sourceLevel's elevation with height sourceLevel's height to (the address of previewModel)
        # Minimum native authoring defaults required by the current app loader.
        ignore add bim opening type named (the string form of "Window") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to (the address of previewModel)
        ignore add bim door type named (the string form of "Door") sized 0.9 by 2.1 with frame 0.05 to (the address of previewModel)
        set previewPlacement to place bim input proposalEncoding's text with capabilities canGenerate bindings canBind on previewLevel to (the address of previewModel)
        if previewPlacement's valid = false:
            return the bim rectangle preview refusal saying previewPlacement's diagnostic
        return @intrinsic("construct", a bim rectangular preview record, true, the string form of "independent proposal document; source host was not regenerated", previewModel, previewPlacement's systemId, retainedCount, addedCount)
