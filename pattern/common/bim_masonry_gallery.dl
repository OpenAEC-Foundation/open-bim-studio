# SPDX-License-Identifier: MPL-2.0
# Facing-leaf bond specimens. Shared bricks, independent corner objects.
# These are explicit component assemblies, not structural design validation.
import bim/bim_model.dl

function add bim gallery box to {a 64 bit integer:definitionId} at {cad vector3:origin} sized {cad vector3:size} of {a string:materialName} in {a pointer to a bim model record:target}:
    execute:
        set profile to an empty list of a cad vector2
        ignore add bim solid of kind bim box solid as bim add operation at origin sized size turned 0.0 along profile of materialName to component definitionId in target
        free profile

function the bim gallery bond name {integer:bond}:
    execute:
        if bond = 0:
            return the string form of "Stack"
        if bond = 1:
            return the string form of "Half running"
        if bond = 2:
            return the string form of "Quarter standing"
        if bond = 3:
            return the string form of "Quarter right"
        if bond = 4:
            return the string form of "Quarter left"
        if bond = 5:
            return the string form of "English"
        if bond = 6:
            return the string form of "English cross"
        if bond = 7:
            return the string form of "Flemish"
        if bond = 8:
            return the string form of "Monk"
        if bond = 9:
            return the string form of "Header"
        if bond = 10:
            return the string form of "Block"
        if bond = 11:
            return the string form of "Mixed deterministic"
        if bond = 12:
            return the string form of "English garden"
        return the string form of "Flemish garden"

# Module lengths in units of 55 mm, including a 10 mm perp joint.
function the bim gallery module of bond {integer:bond} course {integer:course} cell {integer:cell}:
    execute:
        if ((bond = 5) or (bond = 6)) and ((the remainder of course divided by 2) = 1):
            return 2
        if bond = 9:
            return 2
        if (bond = 7) and ((the remainder of cell divided by 2) = 1):
            return 2
        if (bond = 8) and ((the remainder of cell divided by 3) = 2):
            return 2
        if (bond = 11) and ((the remainder of (cell + (course * 3)) divided by 7) = 3):
            return 2
        if (bond = 12) and ((the remainder of course divided by 4) = 3):
            return 2
        if (bond = 13) and ((the remainder of cell divided by 4) = 3):
            return 2
        return 4

function the bim gallery phase of bond {integer:bond} course {integer:course}:
    execute:
        set odd to the remainder of course divided by 2
        if bond = 0:
            return 0
        if bond = 2:
            return odd
        if bond = 3:
            return the remainder of course divided by 4
        if bond = 4:
            return the remainder of (4 - (the remainder of course divided by 4)) divided by 4
        if bond = 6:
            if odd = 1:
                return 1
            return (the remainder of (course / 2) divided by 2) * 2
        if bond = 7:
            return odd * 3
        if bond = 8:
            return odd * 5
        if bond = 9:
            return odd
        if bond = 10:
            return (the remainder of (course / 2) divided by 2) * 2
        return odd * 2

function add bim masonry gallery on {a 64 bit integer:levelId} in {a pointer to a bim model record:target}:
    execute:
        set bricks to an empty list of a 64 bit integer
        loop cut from 1 to 5:
            set brickLength to ((cut as a 64 bit floating-point number) * 0.055) - 0.01
            set definitionId to add bim component named ((the string form of "Facing brick ") + (the string form of cut)) to target
            add bim gallery box to definitionId at (a cad vector3 with x 0.0, y 0.0 and z 0.0) sized (a cad vector3 with x brickLength, y 0.1 and z 0.0525) of (the string form of "brick") in target
            append definitionId to bricks
        loop bond from 0 to 14:
            set originX to ((the remainder of bond divided by 4) as a 64 bit floating-point number) * 4.0
            set originY to 17.0 + ((bond / 4) as a 64 bit floating-point number) * 4.0
            set label to the bim gallery bond name bond
            set cornerId to add bim component named (label + (the string form of " corner")) to target
            loop course from 0 to 24:
                set turn to the remainder of course divided by 2
                if bond = 0:
                    set turn to 0
                if bond = 10:
                    set turn to the remainder of (course / 2) divided by 2
                set width to 0.21
                set depth to 0.1
                if turn = 1:
                    set width to 0.1
                    set depth to 0.21
                set rise to (course as a 64 bit floating-point number) * 0.0625
                add bim gallery box to cornerId at (a cad vector3 with x 0.0, y 0.0 and z rise) sized (a cad vector3 with x width, y depth and z 0.0525) of (the string form of "brick") in target
                loop face from 0 to 2:
                    set lower to width + 0.01
                    if face = 1:
                        set lower to depth + 0.01
                    set phase to the bim gallery phase of bond bond course course
                    if (face = 1) and (bond = 1):
                        set phase to 2 - phase
                    # Begin at an entire pattern period before the corner.
                    set period to 4
                    if bond = 7:
                        set period to 6
                    if bond = 8:
                        set period to 10
                    if bond = 11:
                        set period to 26
                    if bond = 13:
                        set period to 14
                    set position to phase - (period * 2)
                    set cell to 0
                    loop while position < 40:
                        set module to the bim gallery module of bond bond course course cell cell
                        set startValue to the maximum of lower and ((position as a 64 bit floating-point number) * 0.055)
                        set finishValue to the minimum of 2.19 and ((((position + module) as a 64 bit floating-point number) * 0.055) - 0.01)
                        if finishValue > (startValue + 0.005):
                            set cutIndex to ((the rounded value of (((finishValue - startValue) + 0.01) / 0.055)) as an integer) - 1
                            set cutIndex to the maximum of 0 and (the minimum of 3 and cutIndex)
                            set x to originX + startValue
                            set y to originY
                            set angle to 0.0
                            if face = 1:
                                set x to originX + 0.1
                                set y to originY + startValue
                                set angle to 1.5707963267948966
                            set placed to place bim component (the item at cutIndex in bricks) on levelId at (a cad vector2 with x x and y y) turned angle to target
                            ignore set bim instance placed rise to rise in target
                        set position to position + module
                        set cell to cell + 1
            set cornerPlacement to place bim component cornerId on levelId at (a cad vector2 with x originX and y originY) turned 0.0 to target
            set bim property (the string form of "Bond") of set (the string form of "OpenAEC_Masonry") of cornerPlacement to label typed (the string form of "IfcLabel") in target
            set bim property (the string form of "ObjectRole") of set (the string form of "OpenAEC_Masonry") of cornerPlacement to (the string form of "MasonryCorner") typed (the string form of "IfcLabel") in target
        free bricks
