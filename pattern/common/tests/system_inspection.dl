# SPDX-License-Identifier: MPL-2.0
import pattern/common/bim_system_inspection.dl
import exchange/ifcx/bim_file.dl
import lib/filesystem.dl

function check rectangle inspection {boolean:conditionValue} named {a string:captionText}:
    execute:
        if conditionValue = false:
            print ((the string form of "FAIL: ") + captionText) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + captionText) as a line

read the file at "pattern/common/examples/ceiling-input-v1.json" and set exampleReading to it
check rectangle inspection (exampleReading succeeded) named (the string form of "authoring example is readable")
set exampleText to the contents of exampleReading
set baselineModel to an empty bim model
set baseLevel to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to (the address of baselineModel)
# Allocation deliberately differs from the scratch model's native IDs.
ignore add bim level named (the string form of "Unrelated") at 3.0 with height 3.0 to (the address of baselineModel)
set baselinePlacement to place bim input exampleText with capabilities true bindings true on baseLevel to (the address of baselineModel)
set hostId to baselinePlacement's systemId
set baselineText to the bim file text of baselineModel
set baseInspection to inspect bim rectangle hostId in baselineModel
check rectangle inspection (baselinePlacement's valid and baseInspection's matches) named (the string form of "fresh native host agrees despite independent type and host IDs")
check rectangle inspection ((the bim file text of baselineModel) = baselineText) named (the string form of "inspection leaves every native model byte unchanged")
set reopenedReading to the bim model parsed from baselineText
check rectangle inspection (reopenedReading's valid and (inspect bim rectangle hostId in reopenedReading's modelValue)'s matches) named (the string form of "native save parse roundtrip preserves agreement")
check rectangle inspection ((inspect bim rectangle (99999 as a 64 bit integer) in baselineModel)'s matches = false) named (the string form of "missing host is refused without list indexing")
set candidateModel to baselineModel
set candidateHost to the item at 0 in (candidateModel's curtains's values)
set candidateHost's levelId to 99999 as a 64 bit integer
replace item at index 0 in (candidateModel's curtains's values) with candidateHost
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "missing storey is refused")
set candidateModel to baselineModel
set bim property (the string form of "InputV1") of set (the string form of "OpenBIM_RectangularGeneration") of hostId to (the string form of "{]") typed (the string form of "IfcText") in (the address of candidateModel)
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "malformed creation input is refused")
set candidateModel to baselineModel
set candidateHost to the item at 0 in (candidateModel's curtains's values)
set candidateHost's height to 4.2
replace item at index 0 in (candidateModel's curtains's values) with candidateHost
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "manual span edit is detected")
set candidateModel to baselineModel
set candidateHost to the item at 0 in (candidateModel's curtains's values)
set candidateHost's start to (a cad vector2 with x 0.2 and y 0.0)
replace item at index 0 in (candidateModel's curtains's values) with candidateHost
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "manual start edit is detected")
set candidateModel to baselineModel
set candidateHost to the item at 0 in (candidateModel's curtains's values)
set candidateHost's finish to (a cad vector2 with x 5.4 and y 0.0)
replace item at index 0 in (candidateModel's curtains's values) with candidateHost
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "manual finish edit is detected")
set candidateModel to baselineModel
set candidateHost to the item at 0 in (candidateModel's curtains's values)
set candidateHost's bayWidth to 0.8
replace item at index 0 in (candidateModel's curtains's values) with candidateHost
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "U pitch drift is detected")
set candidateModel to baselineModel
set candidateHost to the item at 0 in (candidateModel's curtains's values)
set candidateHost's rowHeight to 0.9
replace item at index 0 in (candidateModel's curtains's values) with candidateHost
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "V pitch drift is detected")
set candidateModel to baselineModel
set candidateHost to the item at 0 in (candidateModel's curtains's values)
set candidateHost's material to (the string form of "wood")
replace item at index 0 in (candidateModel's curtains's values) with candidateHost
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "frame material drift is detected")
set candidateModel to baselineModel
set candidateHost to the item at 0 in (candidateModel's curtains's values)
set candidateHost's bulge to 0.1
replace item at index 0 in (candidateModel's curtains's values) with candidateHost
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "unsupported curved geometry is detected")
set candidateModel to baselineModel
set bim setting (bim joint width setting) of hostId to (30 as a 64 bit integer) keeping true in (the address of candidateModel)
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "joint width drift is detected")
set candidateModel to baselineModel
set bim setting (bim system level setting) of hostId to (2800 as a 64 bit integer) keeping true in (the address of candidateModel)
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "local ceiling elevation drift is detected")
set candidateModel to baselineModel
set bim setting ((bim grid line setting) + 1) of hostId to (650 as a 64 bit integer) keeping true in (the address of candidateModel)
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "additional moved grid line is conservatively refused")
set candidateModel to baselineModel
set panelSetting to the bim setting (bim panel type setting) of hostId in candidateModel
set changedTypeIndex to the bim wall type index of panelSetting's value in candidateModel
set changedType to the item at changedTypeIndex's position in (candidateModel's wallTypes's values)
set changedLayer to the item at 0 in (changedType's layers's values)
set changedLayer's thickness to 0.025
replace item at index 0 in (changedType's layers's values) with changedLayer
replace item at index changedTypeIndex's position in (candidateModel's wallTypes's values) with changedType
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "shared panel type layer edits are detected")
set candidateModel to baselineModel
set bim panel 7 of system hostId to type (99999 as a 64 bit integer) in (the address of candidateModel)
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "unresolved panel binding is refused")
set candidateModel to baselineModel
set bim property (the string form of "CellU1V1") of set (the string form of "OpenBIM_RectangularGeneration") of hostId to (the string form of "wrong/cell") typed (the string form of "IfcIdentifier") in (the address of candidateModel)
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "semantic cell mapping drift is detected")
set candidateModel to baselineModel
set bim property (the string form of "Note") of set (the string form of "UserNotes") of hostId to (the string form of "Keep this") typed (the string form of "IfcText") in (the address of candidateModel)
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches) named (the string form of "unrelated user metadata is outside the generator footprint")
set candidateModel to baselineModel
set bim property (the string form of "Extra") of set (the string form of "OpenBIM_RectangularGeneration") of hostId to (the string form of "unrecognized") typed (the string form of "IfcText") in (the address of candidateModel)
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "unrecognized generator metadata is refused")
set candidateModel to baselineModel
append (the item at 0 in (candidateModel's properties's values)) to (candidateModel's properties's values)
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "duplicate generator property is refused")
set candidateModel to baselineModel
set bim setting (bim joint width setting) of hostId to (0 as a 64 bit integer) keeping false in (the address of candidateModel)
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "missing explicit creation setting is detected")
set candidateModel to baselineModel
set childId to add bim curtain wall on baseLevel from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 1.0 and y 0.0) rising 1.0 in bays of 1.0 by 1.0 of (the string form of "wood") to (the address of candidateModel)
set bim setting (bim layer host setting) of childId to hostId keeping true in (the address of candidateModel)
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "new dependent layer blocks isolated host agreement")
set candidateModel to baselineModel
append (@intrinsic("construct", a bim opening record, 99999 as a 64 bit integer, the bim refused id, hostId, 1.0)) to (candidateModel's openings's values)
check rectangle inspection ((inspect bim rectangle hostId in candidateModel)'s matches = false) named (the string form of "hosted opening blocks isolated host agreement")
check rectangle inspection ((inspect bim rectangle hostId in baselineModel)'s matches and ((the bim file text of baselineModel) = baselineText)) named (the string form of "all candidate checks preserve the original model")
# Two native files make the accepted footprint and a refused manual span edit
# inspectable without adding a shared editor command.
set manualModel to baselineModel
set manualHost to the item at 0 in (manualModel's curtains's values)
set manualHost's height to 4.2
replace item at index 0 in (manualModel's curtains's values) with manualHost
set manualText to the bim file text of manualModel
set manualInspection to inspect bim rectangle hostId in manualModel
check rectangle inspection (((manualInspection's matches = false) and (manualInspection's diagnostic = (the string form of "shape: span differs from creation input"))) and ((the bim file text of manualModel) = manualText)) named (the string form of "manual edit refusal explains drift without repairing or overwriting it")
check rectangle inspection ((write bim text baselineText to file (the string form of "build/inspection-baseline.bim")) and (write bim text manualText to file (the string form of "build/inspection-manual-span.bim"))) named (the string form of "baseline and refused manual native demonstrators are written")
