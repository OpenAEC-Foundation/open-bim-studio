# SPDX-License-Identifier: MPL-2.0
# Editing building systems and aligning faces. A click on a building system
# picks its part at once (Esc: the whole system). Its grips stand on its own
# storey, its transoms' over the middle of its line, and a transom's grip
# dragged up sets its height. A panel unpinned becomes a wall of its type,
# pinned back it is a panel again. Tab opens its contour as a boundary
# sketch, the same as a floor's; a sloped top, drawn on its face, cuts its
# grid lines and panels and adds a sloped frame member; its rectangle again
# leaves it without a contour. Moved, it follows; mirrored, it runs the
# other way and its contour turns round; copied, it keeps its contour. AL
# in the plan brings a wall's face onto another's; in 3D a face into
# another face's plane, across or up.
import ui/editor/bim_editor.dl

function require system editing {boolean:condition} because {a string:reason}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + reason) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)

function show system test parts of {bim model record:modelValue} labelled {a string:title}:
    execute:
        require system editing ((the length of (modelValue's curtains's values)) > 0) because (the string form of "the edited system must still exist before inspecting its parts")
        set curtainValue to the item at 0 in (modelValue's curtains's values)
        set curtainParts to the bim parts of curtain wall curtainValue in modelValue
        set mullions to 0
        set transoms to 0
        set panels to 0
        set highest to 0.0
        loop partCursor from 0 to the length of (curtainParts's values):
            set derivedPart to the item at partCursor in (curtainParts's values)
            if derivedPart's kind's name = (the string form of "Mullion"):
                set mullions to mullions + 1
            else if derivedPart's kind's name = (the string form of "Transom"):
                set transoms to transoms + 1
            else:
                set panels to panels + 1
            set highest to the maximum of highest and (the maximum of derivedPart's element's start's z and derivedPart's element's finish's z)
        set cutPanels to the bim contour panels of curtainValue in modelValue
        print (((title + (the string form of ": mullions ")) + ((the string form of mullions) + ((the string form of ", transoms ") + ((the string form of transoms) + ((the string form of ", panels ") + (the string form of panels)))))) + (((the string form of ", cut panels ") + (the string form of (the length of (cutPanels's values)))) + ((the string form of ", top ") + (the bim length highest in units 0)))) as a line

function click system test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        refresh bim editor editor
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function sketch system test at {a 64 bit floating-point number:along} and {a 64 bit floating-point number:up} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor sketch pointer to (a cad vector2 with x along and y up) within 0.05 in editor
        press bim editor pointer in editor

function show system test line of {a 64 bit integer:systemId} in {bim model record:modelValue} labelled {a string:title}:
    execute:
        set found to the bim curtain index of systemId in modelValue
        set curtainValue to the item at found's position in (modelValue's curtains's values)
        set contourList to the bim face contour of systemId in modelValue
        set cornerText to an empty list of a string
        loop cornerCursor from 0 to the length of contourList:
            set corner to the item at cornerCursor in contourList
            append ((the bim length corner's x in units 0) + ((the string form of ",") + (the bim length corner's y in units 0))) to cornerText
        print (((title + (the string form of ": from ")) + ((the bim length curtainValue's start's x in units 0) + ((the string form of ",") + (the bim length curtainValue's start's y in units 0)))) + (((the string form of " to ") + ((the bim length curtainValue's finish's x in units 0) + ((the string form of ",") + (the bim length curtainValue's finish's y in units 0)))) + ((the string form of ", contour ") + (cornerText joined with " ")))) as a line
        free cornerText
        free contourList

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set upper to add bim level named (the string form of "First floor") at 3.0 with height 3.0 to target
set curtainId to add bim curtain wall on upper from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
commit bim transaction in (the address of (editor's documentValue))
set groundLevel to editor's levelId
set editor's levelId to upper
refresh bim editor e
show system test parts of editor's documentValue's current labelled (the string form of "system")
# In 3D in pieces of one material each: the steel frame, the glass.
set curtainPieces to the bim curtain pieces of (the item at 0 in (editor's documentValue's current's curtains's values)) in editor's documentValue's current within 0.001
set pieceNames to an empty list of a string
loop pieceCursor from 0 to the length of (curtainPieces's values):
    set curtainPiece to the item at pieceCursor in (curtainPieces's values)
    append ((curtainPiece's material + (the string form of " ")) + (the string form of ((the length of (curtainPiece's shape's triangles's values)) > 0))) to pieceNames
print ((the string form of "pieces: ") + (pieceNames joined with ", ")) as a line

# A click picks the part under it at once: the panel of bay 2 at the
# plan's cut height; Esc then chooses the whole system.
click system test at 1.8 and 0.0 in e
print ((the string form of "clicked: kind ") + ((the string form of editor's selectionKind) + ((the string form of ", part ") + (the string form of editor's partCode)))) as a line
print editor's message as a line
type bim editor key bim escape key code in e
print ((the string form of "Esc: part ") + (the string form of editor's partCode)) as a line
# Face places: back from the model to the face, also on a curved system.
set placeValue to the bim face place of (a cad vector3 with x 2.5, y 0.3 and z 1.25) on (the item at 0 in (editor's documentValue's current's curtains's values)) in editor's documentValue's current
print ((the string form of "face place: ") + ((the bim length placeValue's x in units 0) + ((the string form of ", ") + (the bim length placeValue's y in units 0)))) as a line

# The grips stand on the system's storey (3 m up), the transom's over the
# middle of the line; dragged up 0.4 m it sets the transom's height.
select bim editor bim curtain picked numbered curtainId in e
set grips to the bim grips of editor
loop gripCursor from 0 to the length of (grips's values):
    set grip to the item at gripCursor in (grips's values)
    print ((the string form of "grip: ") + ((the bim length grip's location's x in units 0) + ((the string form of ", ") + ((the bim length grip's location's y in units 0) + ((the string form of ", ") + (the bim length grip's location's z in units 0)))))) as a line
set transomGrip to the item at ((the length of (grips's values)) - 2) in (grips's values)
start bim editor drag of transomGrip in e
print ((the string form of "drags upright: ") + (the string form of (bim editor drags a handle upright editor))) as a line
raise bim editor handle drag to (transomGrip's location's z + 0.4) in e
release bim editor pointer in e
set curtainValue to the item at 0 in (editor's documentValue's current's curtains's values)
print ((the string form of "transom at ") + (the bim length (the bim transom 1 along curtainValue in editor's documentValue's current) in units 0)) as a line

# Panel 3 (bay 2, row 2) unpinned: a wall of glass in its place; the system
# leaves the panel out. Pinned back, the wall goes and the panel returns.
select bim editor bim curtain picked numbered curtainId in e
set editor's partCode to 2003
unpin bim editor system line in e
print editor's message as a line
print ((the string form of "selected a wall: ") + (the string form of (editor's selectionKind = bim wall picked))) as a line
set freeWall to the item at 0 in (editor's documentValue's current's walls's values)
print ((the string form of "panel wall: ") + ((the bim length freeWall's start's x in units 0) + ((the string form of " to ") + ((the bim length freeWall's finish's x in units 0) + ((the string form of ", base ") + ((the bim length freeWall's baseOffset in units 0) + ((the string form of ", height ") + (the bim length freeWall's height in units 0)))))))) as a line
show system test parts of editor's documentValue's current labelled (the string form of "panel unpinned")
print ((the string form of "pinned back: ") + (the string form of (pin bim element freeWall's id back in target))) as a line
show system test parts of editor's documentValue's current labelled (the string form of "pinned back")
print ((the string form of "walls left: ") + (the string form of (the length of (editor's documentValue's current's walls's values)))) as a line

# Tab: the contour as a sketch of its rectangle, on its face.
select bim editor bim curtain picked numbered curtainId in e
type bim editor key 258 in e
print editor's message as a line
print ((the string form of "upright: ") + (the string form of (bim editor sketches upright editor))) as a line
print ((the string form of "segments: ") + (the string form of (the length of (editor's sketchSegments's values)))) as a line
require system editing ((bim editor sketches a boundary editor) and (editor's sketchTool = bim sketch pick tool)) because (the string form of "Tab opens the contour in point or edge selection mode")
# A click from the plan is refused: the contour is drawn in 3D.
click system test at 3.0 and 0.0 in e
print editor's message as a line
# The top side picked and removed; two sloped lines to a ridge at 4 m
# over the middle, their ends caught on the corners.
# Tab already chose Pick. Escape here would leave the boundary sketch and
# the following Delete would remove the whole system instead of its edge.
sketch system test at 3.0 and 3.02 in e
print ((the string form of "picked: ") + (the string form of editor's sketchPicked)) as a line
require system editing (editor's sketchPicked = 2) because (the string form of "the top contour edge must be selected before Delete")
type bim editor key bim delete key code in e
require system editing (((the bim curtain index of curtainId in (editor's documentValue's current))'s valid) and ((the length of (editor's sketchSegments's values)) = 3)) because (the string form of "Delete removes one sketch edge and preserves the host system")
type bim editor key 76 in e
sketch system test at 0.02 and 3.01 in e
sketch system test at 3.0 and 4.0 in e
sketch system test at 5.99 and 2.98 in e
type bim editor key 258 in e
print editor's message as a line
require system editing (((the bim curtain index of curtainId in (editor's documentValue's current))'s valid) and ((bim editor sketches a boundary editor) = false)) because (the string form of "the gable edit commits to the same host system")
show system test parts of editor's documentValue's current labelled (the string form of "gable")
set contour to the bim face contour of curtainId in editor's documentValue's current
print ((the string form of "contour corners: ") + (the string form of (the length of contour))) as a line
# Its rectangle again: no contour.
set rectangle to an empty list of a bim boundary segment record
append (the bim boundary line from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0)) to rectangle
append (the bim boundary line from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 6.0 and y 4.0)) to rectangle
append (the bim boundary line from (a cad vector2 with x 6.0 and y 4.0) to (a cad vector2 with x 0.0 and y 4.0)) to rectangle
append (the bim boundary line from (a cad vector2 with x 0.0 and y 4.0) to (a cad vector2 with x 0.0 and y 0.0)) to rectangle
print ((the string form of "rectangle: '") + ((set bim system curtainId boundary to rectangle in target) + (the string form of "'"))) as a line
print ((the string form of "contour corners: ") + (the string form of (the length of (the bim face contour of curtainId in editor's documentValue's current)))) as a line
# Refused: a contour past the system's end.
set past to an empty list of a bim boundary segment record
append (the bim boundary line from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 7.0 and y 0.0)) to past
append (the bim boundary line from (a cad vector2 with x 7.0 and y 0.0) to (a cad vector2 with x 0.0 and y 3.0)) to past
append (the bim boundary line from (a cad vector2 with x 0.0 and y 3.0) to (a cad vector2 with x 0.0 and y 0.0)) to past
print ((the string form of "past the end: ") + (set bim system curtainId boundary to past in target)) as a line

# Moved 5 m: the system follows. With a sloped top as its contour,
# mirrored across x = 0: it runs from -6 back to 0, its contour turned
# round. Copied 10 m on: a second system with the same contour.
select bim editor bim curtain picked numbered curtainId in e
begin bim transaction in (the address of (editor's documentValue))
apply bim editor move by (a cad vector2 with x 0.0 and y 5.0) in e
commit bim transaction in (the address of (editor's documentValue))
show system test line of curtainId in editor's documentValue's current labelled (the string form of "moved")
set slope to an empty list of a bim boundary segment record
append (the bim boundary line from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0)) to slope
append (the bim boundary line from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 6.0 and y 2.0)) to slope
append (the bim boundary line from (a cad vector2 with x 6.0 and y 2.0) to (a cad vector2 with x 0.0 and y 3.0)) to slope
append (the bim boundary line from (a cad vector2 with x 0.0 and y 3.0) to (a cad vector2 with x 0.0 and y 0.0)) to slope
begin bim transaction in (the address of (editor's documentValue))
print ((the string form of "sloped: ") + (set bim system curtainId boundary to slope in target)) as a line
commit bim transaction in (the address of (editor's documentValue))
begin bim transaction in (the address of (editor's documentValue))
reposition bim editor selection by (the bim mirror transform from (a cad vector2 with x 0.0 and y 0.0) through (a cad vector2 with x 0.0 and y 1.0)) in e
commit bim transaction in (the address of (editor's documentValue))
show system test line of curtainId in editor's documentValue's current labelled (the string form of "mirrored")
copy bim editor selection by (a cad vector2 with x 10.0 and y 0.0) in e
print ((the string form of "systems after the copy: ") + (the string form of (the length of (editor's documentValue's current's curtains's values)))) as a line
set copied to the item at 1 in (editor's documentValue's current's curtains's values)
show system test line of copied's id in editor's documentValue's current labelled (the string form of "copied")

# AL in the plan: wall B's face brought onto wall A's face: B's line
# moves to a wall's thickness off A's.
set editor's levelId to groundLevel
begin bim transaction in (the address of (editor's documentValue))
set wallA to add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 0.0 and y 10.0) to (a cad vector2 with x 5.0 and y 10.0) to target
set wallB to add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 6.0 and y 11.0) to (a cad vector2 with x 9.0 and y 11.0) to target
commit bim transaction in (the address of (editor's documentValue))
set wallFound to the bim wall index of wallA in editor's documentValue's current
set halfWall to (the bim wall thickness of (the item at wallFound's position in (editor's documentValue's current's walls's values)) in editor's documentValue's current) * 0.5
type bim editor key 2024 in e
click system test at 2.0 and (10.0 + halfWall) in e
click system test at 7.0 and (11.0 - halfWall) in e
print editor's message as a line
set wallFound to the bim wall index of wallB in editor's documentValue's current
print ((the string form of "wall B's line at y ") + (the bim length (the item at wallFound's position in (editor's documentValue's current's walls's values))'s start's y in units 0)) as a line

# AL in 3D: wall B's top brought to 2 m (a level face at 2 m as the
# reference), then wall B's side face brought into a plane at y = 12.
type bim editor key 2024 in e
set wallFound to the bim wall index of wallB in editor's documentValue's current
set wallBefore to the item at wallFound's position in (editor's documentValue's current's walls's values)
align bim editor face (@intrinsic("construct", a bim face pick record, true, bim wall picked, wallA, (a cad vector3 with x 1.0, y 10.0 and z 2.0), (a cad vector3 with x 0.0, y 0.0 and z 1.0))) in e
align bim editor face (@intrinsic("construct", a bim face pick record, true, bim wall picked, wallB, (a cad vector3 with x 7.0, y wallBefore's start's y and z wallBefore's height), (a cad vector3 with x 0.0, y 0.0 and z 1.0))) in e
print editor's message as a line
set wallFound to the bim wall index of wallB in editor's documentValue's current
set wallAfter to the item at wallFound's position in (editor's documentValue's current's walls's values)
print ((the string form of "wall B base ") + ((the bim length wallAfter's baseOffset in units 0) + ((the string form of ", top ") + (the bim length (wallAfter's baseOffset + wallAfter's height) in units 0)))) as a line
type bim editor key 2024 in e
align bim editor face (@intrinsic("construct", a bim face pick record, true, bim wall picked, wallA, (a cad vector3 with x 1.0, y 12.0 and z 1.0), (a cad vector3 with x 0.0, y 1.0 and z 0.0))) in e
align bim editor face (@intrinsic("construct", a bim face pick record, true, bim wall picked, wallB, (a cad vector3 with x 7.0, y (wallAfter's start's y + halfWall) and z 1.0), (a cad vector3 with x 0.0, y -1.0 and z 0.0))) in e
print editor's message as a line
set wallFound to the bim wall index of wallB in editor's documentValue's current
print ((the string form of "wall B's line at y ") + (the bim length (the item at wallFound's position in (editor's documentValue's current's walls's values))'s start's y in units 0)) as a line
align bim editor face (@intrinsic("construct", a bim face pick record, true, bim wall picked, wallB, (a cad vector3 with x 7.0, y 12.0 and z 1.0), (a cad vector3 with x 0.7, y 0.7 and z 0.0))) in e
print editor's message as a line

# Context commands affect one part and preserve the system itself.
set partEditor to a new bim editor
set pe to the address of partEditor
set partTarget to the address of (partEditor's documentValue's current)
set partSystem to add bim curtain wall on partEditor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to partTarget
select bim editor bim curtain picked numbered partSystem in pe
set partEditor's partCode to 2000
type bim editor key 2387 in pe
print ((the string form of "removed panel suppressed: ") + (the string form of ((bim system line 2000 of partSystem is pinned in partEditor's documentValue's current) = false))) as a line
ignore undo bim transaction in (the address of (partEditor's documentValue))
print ((the string form of "panel undo restores: ") + (the string form of (bim system line 2000 of partSystem is pinned in partEditor's documentValue's current))) as a line
select bim editor bim curtain picked numbered partSystem in pe
set partEditor's partCode to 1
type bim editor key bim delete key code in pe
print ((the string form of "removed frame suppressed: ") + (the string form of ((bim system line 1 of partSystem is pinned in partEditor's documentValue's current) = false))) as a line
print ((the string form of "system retained: ") + (the string form of ((the bim curtain index of partSystem in partEditor's documentValue's current)'s valid))) as a line
ignore undo bim transaction in (the address of (partEditor's documentValue))
select bim editor bim curtain picked numbered partSystem in pe
set partEditor's partCode to 1
type bim editor key 2388 in pe
print ((the string form of "replace frame selects independent member: ") + (the string form of (partEditor's selectionKind = bim linear picked))) as a line
ignore undo bim transaction in (the address of (partEditor's documentValue))
select bim editor bim curtain picked numbered partSystem in pe
set partEditor's partCode to 2000
type bim editor key 2386 in pe
print ((the string form of "unpin panel selects independent wall: ") + (the string form of (partEditor's selectionKind = bim wall picked))) as a line
