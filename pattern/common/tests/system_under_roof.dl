# SPDX-License-Identifier: MPL-2.0
# An upright building system fitted under the roofs above it.
#
# A timber frame system 10 m long and 3 m high stands as a gable under the
# two planes of a pitched roof (rising 1 in 2 from 3.25 m over its ends to
# a ridge at 5.75 m over its middle). Fitted, it is 5.75 m high and its
# contour is the pentagon a wall's top takes there; its layer of sheets,
# which keeps no contour of its own, follows it; its parts reach the ridge
# and none stands above the roofs' undersides; no stub of a member is left
# where the top row only touches the ridge. A system lying level, and
# one with no roof above it, are refused and left as they were.
import ui/editor/bim_editor.dl

function the roof fit text of {a 64 bit floating-point number:metres}:
    execute:
        return the string form of ((@intrinsic("call", "libc", "round", a 64 bit floating-point number, metres * 1000.0)) as a 64 bit integer)

function show roof fit of system {a 64 bit integer:shownId} in {bim model record:modelValue} labelled {a string:caption}:
    execute:
        set shownFound to the bim curtain index of shownId in modelValue
        set shownValue to the item at shownFound's position in (modelValue's curtains's values)
        set written to (caption + (the string form of ": height ")) + (the roof fit text of shownValue's height)
        set cornerList to the bim face contour of shownId in modelValue
        set written to (written + (the string form of ", contour ")) + (the string form of (the length of cornerList))
        loop cornerCursor from 0 to the length of cornerList:
            set corner to the item at cornerCursor in cornerList
            set written to (written + (the string form of " (")) + ((the roof fit text of corner's x) + ((the string form of ", ") + ((the roof fit text of corner's y) + (the string form of ")"))))
        free cornerList
        set shownParts to the bim parts of curtain wall shownValue in modelValue
        set highestPart to 0.0
        set stubs to 0
        loop partCursor from 0 to the length of (shownParts's values):
            set shownPart to the item at partCursor in (shownParts's values)
            if (the cad distance from shownPart's element's start to shownPart's element's finish) < 0.05:
                set stubs to stubs + 1
            set highestPart to the maximum of highestPart and (the maximum of shownPart's element's start's z and shownPart's element's finish's z)
        print written as a line
        print ((the string form of "  parts ") + ((the string form of (the length of (shownParts's values))) + ((the string form of ", highest at ") + ((the roof fit text of highestPart) + ((the string form of ", shorter than 50 mm: ") + (the string form of stubs)))))) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set attic to add bim level named (the string form of "Attic") at 3.0 with height 3.0 to target
set roofLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.3)) to roofLayers
set roofType to add bim planar type named (the string form of "Roof 300") as role (bim roof planar role) with roofLayers to target
free roofLayers
set pitchAngle to @intrinsic("call", "libc", "atan", a 64 bit floating-point number, 0.5)
set southOutline to an empty list of a cad vector2
append (a cad vector2 with x -1.0 and y -0.5) to southOutline
append (a cad vector2 with x 5.0 and y -0.5) to southOutline
append (a cad vector2 with x 5.0 and y 5.0) to southOutline
append (a cad vector2 with x -1.0 and y 5.0) to southOutline
set southRoof to add bim plate typed roofType on attic around southOutline at top 0.0 to target
ignore (set bim plate southRoof top to 0.3 pitch pitchAngle heading 1.5707963267948966 in target)
set northOutline to an empty list of a cad vector2
append (a cad vector2 with x -1.0 and y 5.0) to northOutline
append (a cad vector2 with x 5.0 and y 5.0) to northOutline
append (a cad vector2 with x 5.0 and y 10.5) to northOutline
append (a cad vector2 with x -1.0 and y 10.5) to northOutline
set northRoof to add bim plate typed roofType on attic around northOutline at top 0.0 to target
ignore (set bim plate northRoof top to 3.05 pitch pitchAngle heading 4.71238898038469 in target)

set gableId to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 10.0) rising 3.0 in bays of 0.6 by 3.0 of (the string form of "timber") to target
set sheetId to add bim layer to system gableId offset (80 as a 64 bit integer) in target
set bim setting (bim joint width setting) of sheetId to (0 as a 64 bit integer) keeping true in target
show roof fit of system gableId in modelValue labelled (the string form of "before")
print ((the string form of "fitted: ") + (the string form of (fit bim system gableId top under the roofs above in target))) as a line
show roof fit of system gableId in modelValue labelled (the string form of "frame")
show roof fit of system sheetId in modelValue labelled (the string form of "sheets")

# Refusals leave the system as it was.
set asideId to add bim curtain wall on ground from (a cad vector2 with x 20.0 and y 0.0) to (a cad vector2 with x 20.0 and y 10.0) rising 3.0 in bays of 0.6 by 3.0 of (the string form of "timber") to target
print ((the string form of "no roof above: ") + (the string form of (fit bim system asideId top under the roofs above in target))) as a line
show roof fit of system asideId in modelValue labelled (the string form of "aside")
set lyingId to add bim curtain wall on ground from (a cad vector2 with x 2.0 and y 0.0) to (a cad vector2 with x 2.0 and y 10.0) rising 3.0 in bays of 0.6 by 3.0 of (the string form of "timber") to target
set bim setting (bim system orientation setting) of lyingId to ((bim horizontal orientation) as a 64 bit integer) keeping true in target
print ((the string form of "lying level: ") + (the string form of (fit bim system lyingId top under the roofs above in target))) as a line
