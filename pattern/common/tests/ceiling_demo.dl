# SPDX-License-Identifier: MPL-2.0
# Also writes build/ceiling-led-reproducible.ifcx for the native application.
import ui/editor/bim_editor.dl
import pattern/common/bim_ceiling_demo.dl

function check bim ceiling demonstration {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set demoEditor to a new bim editor
set demoTarget to the address of (demoEditor's documentValue's current)
set beforeRefusal to the bim file text of demoEditor's documentValue's current
set refusedDemo to add bim ceiling demonstration on (the bim refused id) to demoTarget
check bim ceiling demonstration ((refusedDemo = (the bim refused id)) and ((the bim file text of demoEditor's documentValue's current) = beforeRefusal)) named (the string form of "missing storey refuses without model changes")
begin bim transaction in (the address of (demoEditor's documentValue))
set demoId to add bim ceiling demonstration on demoEditor's levelId to demoTarget
commit bim transaction in (the address of (demoEditor's documentValue))
check bim ceiling demonstration ((demoId != (the bim refused id)) and ((the length of (demoEditor's documentValue's current's curtains's values)) = 1)) named (the string form of "one ceiling system created")
set demoSystem to the item at 0 in (demoEditor's documentValue's current's curtains's values)
set farCorner to the bim face point of demoSystem at 4.8 up 3.0 in demoEditor's documentValue's current
check bim ceiling demonstration (((farCorner's x = 4.8) and (farCorner's y = 3.0)) and (farCorner's z = 2.6)) named (the string form of "4800 by 3000 ceiling lies horizontally at 2600")
set demoLightId to the bim panel type of panel 12 of system demoId in demoEditor's documentValue's current
set ordinaryTypeId to the bim panel type of panel 0 of system demoId in demoEditor's documentValue's current
set ordinaryCount to 0
set replacementCount to 0
loop cellCursor from 0 to 40:
    set cellTypeId to the bim panel type of panel cellCursor of system demoId in demoEditor's documentValue's current
    if cellTypeId = demoLightId:
        set replacementCount to replacementCount + 1
    if cellTypeId = ordinaryTypeId:
        set ordinaryCount to ordinaryCount + 1
check bim ceiling demonstration ((replacementCount = 1) and (ordinaryCount = 39)) named (the string form of "only cell 13 uses the LED demonstration type")
begin bim transaction in (the address of (demoEditor's documentValue))
set bim panel 12 of system demoId to type ordinaryTypeId in demoTarget
commit bim transaction in (the address of (demoEditor's documentValue))
ignore undo bim transaction in (the address of (demoEditor's documentValue))
check bim ceiling demonstration ((the bim panel type of panel 12 of system demoId in demoEditor's documentValue's current) = demoLightId) named (the string form of "undo restores cell replacement")
ignore redo bim transaction in (the address of (demoEditor's documentValue))
check bim ceiling demonstration ((the bim panel type of panel 12 of system demoId in demoEditor's documentValue's current) = ordinaryTypeId) named (the string form of "redo restores ordinary infill")
ignore undo bim transaction in (the address of (demoEditor's documentValue))
save bim editor to (the string form of "build/ceiling-led-reproducible.ifcx") in (the address of demoEditor)
set reopenedEditor to a new bim editor
open bim editor from (the string form of "build/ceiling-led-reproducible.ifcx") in (the address of reopenedEditor)
check bim ceiling demonstration (((the length of (reopenedEditor's documentValue's current's curtains's values)) = 1) and ((the bim panel type of panel 12 of system demoId in reopenedEditor's documentValue's current) = demoLightId)) named (the string form of "saved IFCX reopens with same host and LED replacement")
