# SPDX-License-Identifier: MPL-2.0
# Visible outputs use the evaluator, not a legacy recipe index.
import ui/editor/bim_editor.dl
import pattern/common/bim_system_materialization.dl

function check rectangular materialization {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set nativeDefinition to @intrinsic("construct", a bim rectangular definition record, the string form of "generic.ceiling.grid", 1, 600, 600, 24, 38, 15, the string form of "steel", the string form of "mineral fibre", the string form of "generic.rectangular.24x38", the string form of "generic.mineral-fibre.15")
set nativeOccurrence to @intrinsic("construct", a bim rectangular occurrence record, the string form of "ceiling-a", nativeDefinition's identity, 1, 4800, 3000, 2600, 100, true, true)
set nativeReplacements to an empty list of a bim cell replacement record
append (@intrinsic("construct", a bim cell replacement record, 2, 2, the string form of "demo.led.40", the string form of "LED diffuser", 40, 600, 600, true)) to nativeReplacements
set nativeEditor to a new bim editor
set modelTarget to the address of (nativeEditor's documentValue's current)
set beforeRefusal to the bim file text of nativeEditor's documentValue's current
set invalidOccurrence to nativeOccurrence
set invalidOccurrence's bindingsAvailable to false
set rejectedPlacement to place bim rectangle invalidOccurrence defined by nativeDefinition replacing nativeReplacements on nativeEditor's levelId to modelTarget
check rectangular materialization ((rejectedPlacement's valid = false) and ((the bim file text of nativeEditor's documentValue's current) = beforeRefusal)) named (the string form of "unresolved input refuses without adding model objects or types")
begin bim transaction in (the address of (nativeEditor's documentValue))
set generatedPlacement to place bim rectangle nativeOccurrence defined by nativeDefinition replacing nativeReplacements on nativeEditor's levelId to modelTarget
commit bim transaction in (the address of (nativeEditor's documentValue))
check rectangular materialization (generatedPlacement's valid and ((the length of (nativeEditor's documentValue's current's curtains's values)) = 1)) named (the string form of "evaluated intent places one native ceiling host")
set beforeDuplicate to the bim file text of nativeEditor's documentValue's current
set duplicatePlacement to place bim rectangle nativeOccurrence defined by nativeDefinition replacing nativeReplacements on nativeEditor's levelId to modelTarget
check rectangular materialization ((duplicatePlacement's valid = false) and ((the bim file text of nativeEditor's documentValue's current) = beforeDuplicate)) named (the string form of "repeating create cannot duplicate an occurrence or mutate its model")
set nativeSystem to the item at 0 in (nativeEditor's documentValue's current's curtains's values)
set nativeParts to the bim parts of curtain wall nativeSystem in nativeEditor's documentValue's current
set nativeLightCount to 0
set nativeTileCount to 0
set nativeMemberCount to 0
loop partCursor from 0 to the length of (nativeParts's values):
    set nativePart to the item at partCursor in (nativeParts's values)
    if nativePart's kind's material = (the string form of "LED diffuser"):
        set nativeLightCount to nativeLightCount + 1
    else if nativePart's kind's material = (the string form of "mineral fibre"):
        set nativeTileCount to nativeTileCount + 1
    else:
        set nativeMemberCount to nativeMemberCount + 1
check rectangular materialization (((nativeLightCount = 1) and (nativeTileCount = 39)) and (nativeMemberCount = 15)) named (the string form of "native derived geometry agrees with 1 LED 39 tiles and 15 members")
set semanticProperty to the bim property value (the string form of "CellU2V2") of set (the string form of "OpenBIM_RectangularGeneration") of generatedPlacement's systemId in nativeEditor's documentValue's current
check rectangular materialization (semanticProperty = (the string form of "ceiling-a/infill/grid/u2-v2")) named (the string form of "native cell mapping keeps the logical axis-based identity")
save bim editor to (the string form of "build/generated-ceiling-4800x3000.ifcx") in (the address of nativeEditor)
set originalModelText to the bim file text of nativeEditor's documentValue's current
ignore undo bim transaction in (the address of (nativeEditor's documentValue))
check rectangular materialization ((the length of (nativeEditor's documentValue's current's curtains's values)) = 0) named (the string form of "one undo removes the complete generated host")
ignore redo bim transaction in (the address of (nativeEditor's documentValue))
check rectangular materialization ((the bim file text of nativeEditor's documentValue's current) = originalModelText) named (the string form of "redo restores geometry bindings and identity metadata")
set nativeReread to a new bim editor
open bim editor from (the string form of "build/generated-ceiling-4800x3000.ifcx") in (the address of nativeReread)
set rereadKey to the bim property value (the string form of "CellU2V2") of set (the string form of "OpenBIM_RectangularGeneration") of generatedPlacement's systemId in nativeReread's documentValue's current
set originalLightType to the bim panel type of panel 12 of system generatedPlacement's systemId in nativeEditor's documentValue's current
check rectangular materialization ((rereadKey = semanticProperty) and ((the bim panel type of panel 12 of system generatedPlacement's systemId in nativeReread's documentValue's current) = originalLightType)) named (the string form of "IFCX reopen preserves LED binding and semantic cell mapping")
# A separate output model demonstrates a row-count change. It is not in-place
# regeneration of an existing host and does not move a user's open document.
set extendedEditor to a new bim editor
set nativeOccurrence's spanV to 3600
set extendedPlacement to place bim rectangle nativeOccurrence defined by nativeDefinition replacing nativeReplacements on extendedEditor's levelId to (the address of (extendedEditor's documentValue's current))
set extendedKey to the bim property value (the string form of "CellU2V2") of set (the string form of "OpenBIM_RectangularGeneration") of extendedPlacement's systemId in extendedEditor's documentValue's current
check rectangular materialization ((extendedPlacement's valid and (extendedPlacement's rows = 6)) and (extendedKey = semanticProperty)) named (the string form of "six-row output retains LED cell identity despite a different native part index")
save bim editor to (the string form of "build/generated-ceiling-4800x3600.ifcx") in (the address of extendedEditor)
free nativeReplacements
