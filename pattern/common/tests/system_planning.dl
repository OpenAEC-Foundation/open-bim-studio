# SPDX-License-Identifier: MPL-2.0
import pattern/common/bim_system_planning.dl
import lib/string.dl

function check bim system planning {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set units to the bim equal unit plan for length 7200.0 maximum 3300.0 limited to 20
check bim system planning ((units's valid and (units's count = 3)) and (units's unitLength = 2400.0)) named (the string form of "7200 partitions into three equal units below 3300")
set exact to the bim equal unit plan for length 6600.0 maximum 3300.0 limited to 20
check bim system planning ((exact's valid and (exact's count = 2)) and (exact's unitLength = 3300.0)) named (the string form of "exact maximum does not add a unit")
set refused to the bim equal unit plan for length 7200.0 maximum 3300.0 limited to 2
check bim system planning (refused's valid = false) named (the string form of "insufficient unit budget refuses the candidate")
set zero to the bim equal unit plan for length 0.0 maximum 3300.0 limited to 20
set badMaximum to the bim equal unit plan for length 7200.0 maximum 0.0 limited to 20
check bim system planning ((zero's valid = false) and (badMaximum's valid = false)) named (the string form of "zero length or maximum is refused")

set firstCut to the bim strip cut from width 597.0 requiring 250.0 kerf 3.0
set secondCut to the bim strip cut from width (firstCut's residualWidth) requiring 340.0 kerf 3.0
check bim system planning ((firstCut's valid and secondCut's valid) and ((firstCut's residualWidth = 344.0) and (secondCut's residualWidth = 1.0))) named (the string form of "opposite edge cuts can share one stock tile")
set balancedWidth to (((firstCut's installedWidth + secondCut's installedWidth) + firstCut's kerfWidth) + secondCut's kerfWidth) + secondCut's residualWidth
check bim system planning (balancedWidth = 597.0) named (the string form of "installed plus kerf plus remaining stock reconciles")
set whole to the bim strip cut from width 597.0 requiring 597.0 kerf 3.0
set beyond to the bim strip cut from width 597.0 requiring 598.0 kerf 3.0
set negativeKerf to the bim strip cut from width 597.0 requiring 250.0 kerf -1.0
check bim system planning ((whole's valid and (whole's kerfWidth = 0.0)) and ((beyond's valid = false) and (negativeKerf's valid = false))) named (the string form of "whole tile needs no cut and impossible cuts are refused")
set narrowTail to the bim strip cut from width 597.0 requiring 596.0 kerf 3.0
check bim system planning ((narrowTail's valid and (narrowTail's kerfWidth = 1.0)) and (narrowTail's residualWidth = 0.0)) named (the string form of "kerf overrun beyond a free edge does not create negative stock")

set compatible to bim rectangular remnant width 344.0 length 597.0 fits width 340.0 length 597.0 with compatible edges true and direction true
set wrongEdges to bim rectangular remnant width 344.0 length 597.0 fits width 340.0 length 597.0 with compatible edges false and direction true
set wrongDirection to bim rectangular remnant width 344.0 length 597.0 fits width 340.0 length 597.0 with compatible edges true and direction false
set tooLong to bim rectangular remnant width 344.0 length 597.0 fits width 340.0 length 600.0 with compatible edges true and direction true
check bim system planning (compatible and (((wrongEdges = false) and (wrongDirection = false)) and (tooLong = false))) named (the string form of "fit requires geometry and compatible edges and direction")
