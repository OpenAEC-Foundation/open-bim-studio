# SPDX-License-Identifier: MPL-2.0
# A building system's placement orientation (setting 2402100, tilt 2402101):
# upright, level or tilted in between. Systems from before the choice read
# it from their level setting (700007). A recipe change keeps a chosen
# orientation and follows the recipe otherwise. A tilt of 30 degrees from
# upright lays a 3 m face 1.5 m to the left of its line and 2.598 m up; its
# members have their width in the face and their depth along its normal; a
# layer 100 mm out moves 87 mm to the right and 50 mm up. The settings
# survive the .bim file and IFCX.
import viewer/bim_scene.dl
import pattern/common/bim_system_types.dl
import exchange/ifcx/bim_file.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl
import views/schedules/bim_query.dl

function the orientation test text of {a 64 bit floating-point number:value}:
    execute:
        set shown to value
        if (the absolute value of shown) < 0.0005:
            set shown to 0.0
        return the bim query printed shown to 3 decimals

function the orientation test triple of {cad vector3:point}:
    execute:
        return ((the orientation test text of point's x) + (the string form of " ")) + ((the orientation test text of point's y) + ((the string form of " ") + (the orientation test text of point's z)))

function the orientation test summary of {a 64 bit integer:systemId} in {bim model record:modelValue}:
    execute:
        set tiltReading to the bim setting (bim system tilt setting) of systemId in modelValue
        set baseReading to the bim setting (bim system level setting) of systemId in modelValue
        set described to (the string form of "orientation ") + (the string form of (the bim system orientation of systemId in modelValue))
        set described to (described + (the string form of " tilt ")) + (the string form of tiltReading's value)
        set described to (described + (the string form of " base ")) + (the string form of baseReading's value)
        return described

function the orientation test degrees of {a 64 bit integer:systemId} in {bim model record:modelValue}:
    execute:
        return the orientation test text of ((the bim system tilt of systemId in modelValue) * (180.0 / 3.141592653589793))

function the orientation test system of {a 64 bit integer:systemId} in {bim model record:modelValue}:
    execute:
        return the item at (the bim curtain index of systemId in modelValue)'s position in (modelValue's curtains's values)

# The first part named `wanted` of system `systemId`: its roll, and the
# depth axis of its frame.
function show orientation test part {a string:wanted} of {a 64 bit integer:systemId} in {bim model record:modelValue} labelled {a string:title}:
    execute:
        set curtainParts to the bim parts of curtain wall (the orientation test system of systemId in modelValue) in modelValue
        set shown to false
        loop partCursor from 0 to the length of (curtainParts's values):
            set piece to the item at partCursor in (curtainParts's values)
            if (shown = false) and (piece's kind's name = wanted):
                set shown to true
                set partFrame to the bim frame of linear (piece's element) in modelValue
                print ((title + (the string form of ": angle ")) + ((the orientation test text of piece's element's angle) + ((the string form of ", depth ") + (the orientation test triple of partFrame's depthAxis)))) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to target
set origin to a cad vector2 with x 0.0 and y 0.0
set east to a cad vector2 with x 6.0 and y 0.0

# Systems from before the choice: level when their level setting is set.
set legacyLevel to add bim curtain wall on ground from origin to east rising 3.0 in bays of 1.2 by 1.5 of (the string form of "aluminium") to target
set bim setting (bim system level setting) of legacyLevel to (2600 as a 64 bit integer) keeping true in target
print ((the string form of "legacy level: orientation ") + ((the string form of (the bim system orientation of legacyLevel in modelValue)) + ((the string form of " tilt ") + (the orientation test degrees of legacyLevel in modelValue)))) as a line
set legacyUpright to add bim curtain wall on ground from origin to east rising 3.0 in bays of 1.2 by 1.5 of (the string form of "aluminium") to target
print ((the string form of "legacy upright: orientation ") + ((the string form of (the bim system orientation of legacyUpright in modelValue)) + ((the string form of " tilt ") + (the orientation test degrees of legacyUpright in modelValue)))) as a line

# Tilted 30 degrees from upright, its line on the storey.
set slopeId to add bim curtain wall on ground from origin to east rising 3.0 in bays of 1.2 by 1.5 of (the string form of "aluminium") to target
print ((the string form of "set tilted 30: ") + (the string form of (set bim system slopeId orientation (bim tilted orientation) tilted (30000 as a 64 bit integer) based (0 as a 64 bit integer) in target))) as a line
print ((the string form of "tilted 30: ") + (the orientation test summary of slopeId in modelValue)) as a line
set tiltedValue to the orientation test system of slopeId in modelValue
print ((the string form of "tilted 30: top corner ") + (the orientation test triple of (the bim face point of tiltedValue at 0.0 up 3.0 in modelValue))) as a line
print ((the string form of "tilted 30: foot ") + (the orientation test triple of (the bim face point of tiltedValue at 6.0 up 0.0 in modelValue))) as a line
set faceSpot to the bim face place of (the bim face point of tiltedValue at 2.5 up 1.75 in modelValue) on tiltedValue in modelValue
print ((the string form of "tilted 30: face place ") + ((the orientation test text of faceSpot's x) + ((the string form of " ") + (the orientation test text of faceSpot's y)))) as a line
print ((the string form of "tilted 30: normal ") + (the orientation test triple of (the bim face normal of tiltedValue at 0.0 in modelValue))) as a line
show orientation test part (the string form of "Transom") of slopeId in modelValue labelled (the string form of "tilted 30 transom")
show orientation test part (the string form of "Mullion") of slopeId in modelValue labelled (the string form of "tilted 30 mullion")
print ((the string form of "tilted 30: footprint gap 1 m left ") + (the orientation test text of (the bim footprint gap of (a cad vector2 with x 3.0 and y 1.0) to tiltedValue in modelValue))) as a line
print ((the string form of "tilted 30: footprint gap 2 m left ") + (the orientation test text of (the bim footprint gap of (a cad vector2 with x 3.0 and y 2.0) to tiltedValue in modelValue))) as a line

# Barely tilted (1 degree), and tilted along a line running north.
set barely to add bim curtain wall on ground from origin to east rising 3.0 in bays of 1.2 by 1.5 of (the string form of "aluminium") to target
ignore (set bim system barely orientation (bim tilted orientation) tilted (1000 as a 64 bit integer) based (0 as a 64 bit integer) in target)
show orientation test part (the string form of "Mullion") of barely in modelValue labelled (the string form of "tilted 1 mullion")
set north to add bim curtain wall on ground from origin to (a cad vector2 with x 0.0 and y 6.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "aluminium") to target
ignore (set bim system north orientation (bim tilted orientation) tilted (30000 as a 64 bit integer) based (0 as a 64 bit integer) in target)
show orientation test part (the string form of "Transom") of north in modelValue labelled (the string form of "tilted 30 north transom")
show orientation test part (the string form of "Mullion") of north in modelValue labelled (the string form of "tilted 30 north mullion")
show orientation test part (the string form of "Transom") of legacyLevel in modelValue labelled (the string form of "level transom")

# A recipe change keeps a chosen orientation; without one it follows the
# recipe as before.
set keptLevel to add bim curtain wall on ground from origin to east rising 3.0 in bays of 1.2 by 1.5 of (the string form of "aluminium") to target
ignore (set bim system keptLevel orientation (bim horizontal orientation) tilted (0 as a 64 bit integer) based (2600 as a 64 bit integer) in target)
ignore (give bim system keptLevel type 0 in target)
print ((the string form of "recipe keeps horizontal: ") + (the orientation test summary of keptLevel in modelValue)) as a line
set keptUpright to add bim curtain wall on ground from origin to east rising 3.0 in bays of 1.2 by 1.5 of (the string form of "aluminium") to target
ignore (set bim system keptUpright orientation (bim vertical orientation) tilted (0 as a 64 bit integer) based (0 as a 64 bit integer) in target)
ignore (give bim system keptUpright type 15 in target)
print ((the string form of "recipe keeps vertical: ") + ((the orientation test summary of keptUpright in modelValue) + ((the string form of " level ") + (the string form of (bim system keptUpright lies level in modelValue))))) as a line
set following to add bim curtain wall on ground from origin to east rising 3.0 in bays of 1.2 by 1.5 of (the string form of "aluminium") to target
ignore (give bim system following type 15 in target)
print ((the string form of "legacy recipe: ") + (the orientation test summary of following in modelValue)) as a line

# Tilts at or past the ends are upright or level; a curved system does
# not tilt.
set clamped to add bim curtain wall on ground from origin to east rising 3.0 in bays of 1.2 by 1.5 of (the string form of "aluminium") to target
ignore (set bim system clamped orientation (bim tilted orientation) tilted (0 as a 64 bit integer) based (0 as a 64 bit integer) in target)
print ((the string form of "tilt 0 clamps: ") + (the orientation test summary of clamped in modelValue)) as a line
ignore (set bim system clamped orientation (bim tilted orientation) tilted (90000 as a 64 bit integer) based (1000 as a 64 bit integer) in target)
print ((the string form of "tilt 90000 clamps: ") + (the orientation test summary of clamped in modelValue)) as a line
print ((the string form of "unknown orientation refused: ") + (the string form of ((set bim system clamped orientation 3 tilted (0 as a 64 bit integer) based (0 as a 64 bit integer) in target) = false))) as a line
set curved to add bim curtain wall on ground from origin to east rising 3.0 in bays of 1.2 by 1.5 of (the string form of "aluminium") to target
ignore (set bim curtain wall curved bulge to 0.5 in target)
print ((the string form of "curved tilted refused: ") + ((the string form of ((set bim system curved orientation (bim tilted orientation) tilted (30000 as a 64 bit integer) based (0 as a 64 bit integer) in target) = false)) + ((the string form of ", ") + (the orientation test summary of curved in modelValue)))) as a line

# A layer 100 mm out from a tilted host, and a layer that follows its
# host's new orientation.
set layerId to add bim layer to system slopeId offset (100 as a 64 bit integer) in target
set layerPlaced to the bim placed system (the orientation test system of layerId in modelValue) in modelValue
print ((the string form of "layer: ") + ((the orientation test summary of layerId in modelValue) + ((the string form of " shift ") + ((the orientation test text of layerPlaced's curtain's start's y) + ((the string form of " lift ") + (the orientation test text of layerPlaced's lift)))))) as a line
set laterId to add bim layer to system legacyUpright offset (100 as a 64 bit integer) in target
ignore (set bim system legacyUpright orientation (bim tilted orientation) tilted (45000 as a 64 bit integer) based (500 as a 64 bit integer) in target)
print ((the string form of "layer follows its host: ") + (the orientation test summary of laterId in modelValue)) as a line

# The settings survive the .bim file and IFCX.
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of "bim file: ") + (the orientation test summary of slopeId in reread's modelValue)) as a line
set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "o.ifcx") for project (the string form of "o") by (the string form of "test") at (the string form of "2026-11-05T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of "ifcx: ") + (the orientation test summary of slopeId in fromIfcx's modelValue)) as a line
