# SPDX-License-Identifier: MPL-2.0
# Openings in a building system follow its opening rule. A 6 x 3 m system
# in bays of 1.2 m and rows of 1.5 m (6 mullions, 3 transoms, 10 panels)
# hosts a door 1 m wide, 2.1 m high, at 3 m along. Cut and frame: the
# mullion at 3 m stops above the frame's head, the middle transom stops at
# the jambs, a frame of two jambs and a head (no sill at the foot) goes
# round it, and the four panels it touches are cut around the frame.
# Replace panels: those four panels go, nothing else changes. Ignore: the
# system stays whole. The rule and the door survive the file.
import ui/editor/bim_editor.dl

function show bim opening test of {bim model record:modelValue} labelled {a string:title}:
    execute:
        set curtainValue to the item at 0 in (modelValue's curtains's values)
        set curtainParts to the bim parts of curtain wall curtainValue in modelValue
        set mullions to 0
        set transoms to 0
        set glassPanels to 0
        set glassArea to 0.0
        loop partCursor from 0 to the length of (curtainParts's values):
            set derivedPart to the item at partCursor in (curtainParts's values)
            if derivedPart's kind's name = (the string form of "Mullion"):
                set mullions to mullions + 1
            else if derivedPart's kind's name = (the string form of "Transom"):
                set transoms to transoms + 1
            else:
                set glassPanels to glassPanels + 1
                set glassArea to glassArea + (derivedPart's kind's width * (derivedPart's element's finish's z - derivedPart's element's start's z))
        set rounded to (@intrinsic("call", "libc", "round", a 64 bit floating-point number, glassArea * 1000.0)) / 1000.0
        print ((title + (the string form of ": mullions ")) + ((the string form of mullions) + ((the string form of ", transoms ") + ((the string form of transoms) + ((the string form of ", panels ") + ((the string form of glassPanels) + ((the string form of ", glass ") + ((the string form of rounded) + (the string form of " m2"))))))))) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to target
set curtainId to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "aluminium") to target
show bim opening test of modelValue labelled (the string form of "no opening")
set doorType to add bim opening type named (the string form of "Deur") sized 1.0 by 2.1 with sill 0.0 and frame 0.0 to target
set doorId to add bim opening typed doorType in curtainId at 3.0 to target
print ((the string form of "door hosted: ") + (the string form of (doorId != the bim refused id))) as a line
print ((the string form of "rule: ") + (the bim name of opening rule (the bim opening rule of system curtainId in modelValue))) as a line
show bim opening test of modelValue labelled (the string form of "cut and frame")
set bim setting (bim opening rule setting) of curtainId to ((bim replace panels rule) as a 64 bit integer) keeping true in target
show bim opening test of modelValue labelled (the string form of "replace panels")
set bim setting (bim opening rule setting) of curtainId to ((bim ignore openings rule) as a 64 bit integer) keeping true in target
show bim opening test of modelValue labelled (the string form of "ignore")
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", ") + reread's message))) as a line
print ((the string form of "rule from .bim: ") + (the bim name of opening rule (the bim opening rule of system curtainId in reread's modelValue))) as a line
print ((the string form of "openings from .bim: ") + (the string form of (the length of (reread's modelValue's openings's values)))) as a line
