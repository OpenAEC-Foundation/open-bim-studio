# SPDX-License-Identifier: MPL-2.0
import pattern/common/bim_system_preview.dl
import exchange/ifcx/bim_file.dl
import lib/filesystem.dl

function check rectangle preview {boolean:conditionValue} named {a string:captionText}:
    execute:
        if conditionValue = false:
            print ((the string form of "FAIL: ") + captionText) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + captionText) as a line

read the file at "pattern/common/examples/ceiling-input-v1.json" and set exampleReading to it
check rectangle preview (exampleReading succeeded) named (the string form of "authoring input is readable")
set exampleText to the contents of exampleReading
set originalModel to an empty bim model
set originalLevel to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to (the address of originalModel)
ignore add bim level named (the string form of "Unrelated") at 3.0 with height 3.0 to (the address of originalModel)
ignore add bim opening type named (the string form of "Window") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to (the address of originalModel)
ignore add bim door type named (the string form of "Door") sized 0.9 by 2.1 with frame 0.05 to (the address of originalModel)
set originalPlacement to place bim input exampleText with capabilities true bindings true on originalLevel to (the address of originalModel)
set originalId to originalPlacement's systemId
set bim property (the string form of "Note") of set (the string form of "UserNotes") of originalId to (the string form of "Keep original") typed (the string form of "IfcText") in (the address of originalModel)
set originalText to the bim file text of originalModel
check rectangle preview (originalPlacement's valid and (inspect bim rectangle originalId in originalModel)'s matches) named (the string form of "original native host agrees with its creation footprint")
set authoredInput to the bim rectangle input parsed from exampleText with capabilities true bindings true
set proposedOccurrence to authoredInput's occurrenceValue
set proposedOccurrence's spanV to 4200
set proposalEncoding to the bim rectangle input encoding of authoredInput's definitionValue for proposedOccurrence replacing authoredInput's replacements
set proposal to the bim rectangle preview of originalId in originalModel proposing proposalEncoding's text with capabilities true bindings true
check rectangle preview (proposal's valid and ((proposal's retainedOverrides = 2) and (proposal's addedOverrides = 0))) named (the string form of "separate taller proposal retains both existing LED substitutions")
check rectangle preview ((the bim file text of originalModel) = originalText) named (the string form of "successful preview does not change source geometry identity or metadata")
set proposedHost to the item at 0 in (proposal's modelValue's curtains's values)
set originalHost to the item at 0 in (originalModel's curtains's values)
check rectangle preview (((the absolute value of (proposedHost's height - 4.2)) < 1e-9) and ((the absolute value of (originalHost's height - 3.6)) < 1e-9)) named (the string form of "only the independent proposal receives the new span")
set storedProposal to the bim property value (the string form of "InputV1") of set (the string form of "OpenBIM_RectangularGeneration") of proposal's systemId in proposal's modelValue
set reopenedProposalInput to the bim rectangle input parsed from storedProposal with capabilities true bindings true
check rectangle preview (reopenedProposalInput's valid and (reopenedProposalInput's occurrenceValue's spanV = 4200)) named (the string form of "proposal snapshot describes the proposed dimensions")
free reopenedProposalInput's replacements
check rectangle preview ((inspect bim rectangle proposal's systemId in proposal's modelValue)'s matches and (inspect bim rectangle originalId in originalModel)'s matches) named (the string form of "original and proposal each agree with their own InputV1")
set firstCell to the bim property value (the string form of "CellU1V1") of set (the string form of "OpenBIM_RectangularGeneration") of proposal's systemId in proposal's modelValue
set secondCell to the bim property value (the string form of "CellU5V3") of set (the string form of "OpenBIM_RectangularGeneration") of proposal's systemId in proposal's modelValue
check rectangle preview ((firstCell = (the string form of "ceiling-json-a/infill/grid/u1-v1")) and (secondCell = (the string form of "ceiling-json-a/infill/grid/u5-v3"))) named (the string form of "both semantic LED targets survive row-count change")
set firstPanelType to the bim setting ((bim panel type setting) + 9) of proposal's systemId in proposal's modelValue
set secondPanelType to the bim setting ((bim panel type setting) + 39) of proposal's systemId in proposal's modelValue
check rectangle preview ((firstPanelType's found and secondPanelType's found) and (firstPanelType's value = secondPanelType's value)) named (the string form of "LED bindings move to native panel indices 8 and 38")
set proposedParts to the bim parts of curtain wall proposedHost in proposal's modelValue
set lights to 0
set tiles to 0
set members to 0
loop partCursor from 0 to the length of (proposedParts's values):
    set proposedPart to the item at partCursor in (proposedParts's values)
    if proposedPart's kind's material = (the string form of "LED diffuser"):
        set lights to lights + 1
    else if proposedPart's kind's material = (the string form of "mineral fibre"):
        set tiles to tiles + 1
    else:
        set members to members + 1
check rectangle preview (((lights = 2) and (tiles = 54)) and (members = 17)) named (the string form of "taller proposal derives 2 LED panels 54 tiles and 17 members")
set absentHost to the bim rectangle preview of (99999 as a 64 bit integer) in originalModel proposing proposalEncoding's text with capabilities true bindings true
check rectangle preview ((absentHost's valid = false) and ((the length of (absentHost's modelValue's curtains's values)) = 0)) named (the string form of "unknown source host creates no proposal document")
set noCapability to the bim rectangle preview of originalId in originalModel proposing proposalEncoding's text with capabilities false bindings true
set noBindings to the bim rectangle preview of originalId in originalModel proposing proposalEncoding's text with capabilities true bindings false
check rectangle preview (((noCapability's valid = false) and (noBindings's valid = false)) and ((the length of (noCapability's modelValue's curtains's values)) = 0)) named (the string form of "missing runtime capability or bindings emits no proposal host")
set editedSource to the bim snapshot of originalModel
set editedHost to the item at 0 in (editedSource's curtains's values)
set editedHost's height to 4.2
replace item at index 0 in (editedSource's curtains's values) with editedHost
set editedBefore to the bim file text of editedSource
set refusedSource to the bim rectangle preview of originalId in editedSource proposing proposalEncoding's text with capabilities true bindings true
check rectangle preview (((refusedSource's valid = false) and (refusedSource's diagnostic = (the string form of "source: shape: span differs from creation input"))) and ((the bim file text of editedSource) = editedBefore)) named (the string form of "manually drifted source is refused without repair")
set missingReplacement to an empty list of a bim cell replacement record
append (the item at 0 in authoredInput's replacements) to missingReplacement
set omissionEncoding to the bim rectangle input encoding of authoredInput's definitionValue for proposedOccurrence replacing missingReplacement
set omission to the bim rectangle preview of originalId in originalModel proposing omissionEncoding's text with capabilities true bindings true
check rectangle preview ((omission's valid = false) and (omission's diagnostic = (the string form of "preview: an existing semantic replacement was omitted"))) named (the string form of "omitting an existing LED needs an explicit policy")
free missingReplacement
set changedOverrides to an empty list of a bim cell replacement record
set changedOverride to the item at 0 in authoredInput's replacements
set changedOverride's componentKey to the string form of "different.demo.led"
append changedOverride to changedOverrides
append (the item at 1 in authoredInput's replacements) to changedOverrides
set changeEncoding to the bim rectangle input encoding of authoredInput's definitionValue for proposedOccurrence replacing changedOverrides
set changedReplacement to the bim rectangle preview of originalId in originalModel proposing changeEncoding's text with capabilities true bindings true
check rectangle preview ((changedReplacement's valid = false) and (changedReplacement's diagnostic = (the string form of "preview: changing an existing replacement needs an explicit policy"))) named (the string form of "changing an existing replacement cannot be implicit")
free changedOverrides
set narrowTree to (the JSON document parsed from proposalEncoding's text)'s value
set narrowNode to the JSON member named "span_u" in (the JSON member named "occurrence" in narrowTree)
set narrowNode's text to the string form of "2400"
set narrowNode's number to 2400.0
set narrowed to the bim rectangle preview of originalId in originalModel proposing (the compact JSON form of narrowTree) with capabilities true bindings true
free narrowTree
check rectangle preview (((narrowed's valid = false) and (narrowed's diagnostic = (the string form of "replacement: target cell is unresolved in this domain"))) and ((the length of (narrowed's modelValue's curtains's values)) = 0)) named (the string form of "replacement outside the proposed domain emits no preview")
set otherOccurrence to proposedOccurrence
set otherOccurrence's identity to the string form of "other-occurrence"
set otherEncoding to the bim rectangle input encoding of authoredInput's definitionValue for otherOccurrence replacing authoredInput's replacements
set otherPreview to the bim rectangle preview of originalId in originalModel proposing otherEncoding's text with capabilities true bindings true
check rectangle preview ((otherPreview's valid = false) and (otherPreview's diagnostic = (the string form of "preview: occurrence identity must remain unchanged"))) named (the string form of "occurrence identity cannot silently change")
set changedDefinition to authoredInput's definitionValue
set changedDefinition's frameDepth to 42
set definitionEncoding to the bim rectangle input encoding of changedDefinition for proposedOccurrence replacing authoredInput's replacements
set definitionPreview to the bim rectangle preview of originalId in originalModel proposing definitionEncoding's text with capabilities true bindings true
check rectangle preview ((definitionPreview's valid = false) and (definitionPreview's diagnostic = (the string form of "preview: pinned definition cannot be redefined or migrated"))) named (the string form of "pinned definition contents cannot silently change")
set addedOverrides to an empty list of a bim cell replacement record
append (the item at 0 in authoredInput's replacements) to addedOverrides
append (the item at 1 in authoredInput's replacements) to addedOverrides
set addedOverride to the item at 0 in authoredInput's replacements
set addedOverride's ordinalU to 7
set addedOverride's ordinalV to 6
append addedOverride to addedOverrides
set additionEncoding to the bim rectangle input encoding of authoredInput's definitionValue for proposedOccurrence replacing addedOverrides
set additionPreview to the bim rectangle preview of originalId in originalModel proposing additionEncoding's text with capabilities true bindings true
check rectangle preview (additionPreview's valid and ((additionPreview's retainedOverrides = 2) and (additionPreview's addedOverrides = 1))) named (the string form of "an explicit additional replacement preserves the existing two")
free addedOverrides
set reorderedOverrides to an empty list of a bim cell replacement record
append (the item at 1 in authoredInput's replacements) to reorderedOverrides
append (the item at 0 in authoredInput's replacements) to reorderedOverrides
set reorderEncoding to the bim rectangle input encoding of authoredInput's definitionValue for proposedOccurrence replacing reorderedOverrides
set reorderPreview to the bim rectangle preview of originalId in originalModel proposing reorderEncoding's text with capabilities true bindings true
check rectangle preview (reorderPreview's valid and (reorderPreview's retainedOverrides = 2)) named (the string form of "replacement array order does not change semantic retention")
free reorderedOverrides
set budgetTree to (the JSON document parsed from proposalEncoding's text)'s value
set budgetNode to the JSON member named "part_limit" in (the JSON member named "occurrence" in budgetTree)
set budgetNode's text to the string form of "72"
set budgetNode's number to 72.0
set budgetPreview to the bim rectangle preview of originalId in originalModel proposing (the compact JSON form of budgetTree) with capabilities true bindings true
free budgetTree
check rectangle preview (((budgetPreview's valid = false) and (budgetPreview's diagnostic = (the string form of "budget: generated part count exceeds the occurrence limit"))) and ((the length of (budgetPreview's modelValue's curtains's values)) = 0)) named (the string form of "insufficient part budget creates no preview geometry")
set malformedPreview to the bim rectangle preview of originalId in originalModel proposing (the string form of "{]") with capabilities true bindings true
check rectangle preview ((malformedPreview's valid = false) and ((the length of (malformedPreview's modelValue's curtains's values)) = 0)) named (the string form of "malformed proposal cannot mutate or create native geometry")
set repeatedPreview to the bim rectangle preview of originalId in originalModel proposing proposalEncoding's text with capabilities true bindings true
check rectangle preview (repeatedPreview's valid and ((the bim file text of repeatedPreview's modelValue) = (the bim file text of proposal's modelValue))) named (the string form of "identical proposals produce identical independent native documents")
set previewText to the bim file text of proposal's modelValue
set parsedPreview to the bim model parsed from previewText
check rectangle preview (parsedPreview's valid and (inspect bim rectangle proposal's systemId in parsedPreview's modelValue)'s matches) named (the string form of "native proposal serialization preserves agreement with proposed inputs")
check rectangle preview ((write bim text originalText to file (the string form of "build/preview-source.bim")) and ((write bim text previewText to file (the string form of "build/preview-proposal.bim")) and (write bim text storedProposal to file (the string form of "build/preview-proposal-input-v1.json")))) named (the string form of "source and proposal native demonstrators are written separately")
set proposedHost's height to 4.8
replace item at index 0 in (proposal's modelValue's curtains's values) with proposedHost
check rectangle preview (((the bim file text of originalModel) = originalText) and ((the bim file text of proposal's modelValue) != previewText)) named (the string form of "editing the proposal cannot change the original native tables")
free authoredInput's replacements
