# SPDX-License-Identifier: MPL-2.0
import pattern/common/bim_system_catalogue.dl
import lib/filesystem.dl

function check system catalogue {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

read the file at "localisation/nl/building-systems/catalogue.json" and set reading to it
check system catalogue (reading succeeded) named (the string form of "published catalogue file is readable")
set catalogue to the bim system catalogue parsed from (the contents of reading)
check system catalogue (catalogue's valid and ((the number of recipes in bim system catalogue catalogue) = 183)) named (the string form of "native reader loads all 183 concept recipes")
set frame to the recipe named (the string form of "nl.generic.window-timber-fixed") in bim system catalogue catalogue
set missing to the recipe named (the string form of "nl.generic.does-not-exist") in bim system catalogue catalogue
check system catalogue ((frame != (0 as a pointer to a JSON value)) and (missing = (0 as a pointer to a JSON value))) named (the string form of "stable identity lookup returns a recipe or explicit absence")
set noneAvailable to an empty list of a string
check system catalogue ((bim catalogue recipe frame needs only capabilities noneAvailable) = false) named (the string form of "loading a recipe does not activate missing capabilities")
set available to an empty list of a string
set required to the JSON member named "requires_capabilities" in frame
loop cursor from 0 to the number of JSON items in required:
    append (the JSON text at index cursor in required) to available
check system catalogue (bim catalogue recipe frame needs only capabilities available) named (the string form of "all required capabilities can be checked explicitly")
free available
free noneAvailable

set broken to the bim system catalogue parsed from (the string form of "{")
set wrongShape to the bim system catalogue parsed from (the string form of "[]")
check system catalogue ((broken's valid = false) and (wrongShape's valid = false)) named (the string form of "malformed JSON and invalid root shape refuse without aborting")
set recipeList to the JSON member named "recipes" in catalogue's document
set first to the JSON value at index 0 in recipeList
set familyField to the JSON member named "family" in first
set originalFamily to familyField's text
set familyField's text to the string form of "unknown-family"
set badFamily to the bim system catalogue parsed from (the compact JSON form of catalogue's document)
set familyField's text to originalFamily
check system catalogue ((badFamily's valid = false) and (badFamily's diagnostic = (the string form of "Unknown recipe family"))) named (the string form of "missing family refuses with a diagnostic")
set second to the JSON value at index 1 in recipeList
set idField to the JSON member named "id" in second
set originalId to idField's text
set idField's text to the JSON text named "id" in first
set duplicate to the bim system catalogue parsed from (the compact JSON form of catalogue's document)
set idField's text to originalId
check system catalogue ((duplicate's valid = false) and (duplicate's diagnostic = (the string form of "Duplicate recipe identity"))) named (the string form of "duplicate recipe identity is refused")
set manufacturerField to the JSON member named "manufacturer_system" in first
set manufacturerField's boolean to true
set unapproved to the bim system catalogue parsed from (the compact JSON form of catalogue's document)
set manufacturerField's boolean to false
check system catalogue (unapproved's valid = false) named (the string form of "concept reader rejects an asserted manufacturer approval")
free bim system catalogue (the address of broken)
free bim system catalogue (the address of wrongShape)
free bim system catalogue (the address of badFamily)
free bim system catalogue (the address of duplicate)
free bim system catalogue (the address of unapproved)
free bim system catalogue (the address of catalogue)
free bim system catalogue (the address of catalogue)
check system catalogue (((the number of recipes in bim system catalogue catalogue) = 0) and ((the recipe named (the string form of "nl.generic.window-timber-fixed") in bim system catalogue catalogue) = (0 as a pointer to a JSON value))) named (the string form of "release clears access and repeated release is safe")
