# SPDX-License-Identifier: MPL-2.0
import pattern/common/bim_system_input.dl
import lib/filesystem.dl

function check rectangular input {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the rectangular input fixture tree:
    execute:
        read the file at "pattern/common/examples/ceiling-input-v1.json" and set fileReading to it
        if fileReading failed:
            @intrinsic("call", "libc", "exit", nothing, 1)
        set treeReading to the JSON document parsed from (the contents of fileReading)
        if treeReading failed:
            @intrinsic("call", "libc", "exit", nothing, 1)
        return treeReading's value

function check rejected rectangular input tree {a pointer to a JSON value:treeValue} named {a string:label}:
    execute:
        set rejection to the bim rectangle input parsed from (the compact JSON form of treeValue) with capabilities true bindings true
        check rectangular input ((rejection's valid = false) and (((the length of rejection's diagnostic) > 0) and ((the length of rejection's replacements) = 0))) named label
        free rejection's replacements
        free treeValue

read the file at "pattern/common/examples/ceiling-input-v1.json" and set sourceReading to it
check rectangular input (sourceReading succeeded) named (the string form of "versioned authoring JSON is readable")
set inputSource to the contents of sourceReading
set decodedInput to the bim rectangle input parsed from inputSource with capabilities true bindings true
check rectangular input ((decodedInput's valid and (decodedInput's occurrenceValue's spanV = 3600)) and ((the length of decodedInput's replacements) = 2)) named (the string form of "native codec loads the two LED authoring inputs")
set canonicalInput to the bim rectangle input encoding of decodedInput's definitionValue for decodedInput's occurrenceValue replacing decodedInput's replacements
set canonicalAgain to the bim rectangle input encoding of decodedInput's definitionValue for decodedInput's occurrenceValue replacing decodedInput's replacements
check rectangular input ((canonicalInput's valid and canonicalAgain's valid) and (canonicalInput's text = canonicalAgain's text)) named (the string form of "fixed key order produces deterministic compact bytes")
set decodedAgain to the bim rectangle input parsed from canonicalInput's text with capabilities true bindings true
set roundtripInput to the bim rectangle input encoding of decodedAgain's definitionValue for decodedAgain's occurrenceValue replacing decodedAgain's replacements
check rectangular input (decodedAgain's valid and (roundtripInput's text = canonicalInput's text)) named (the string form of "decode encode roundtrip retains canonical source")
set unavailableInput to the bim rectangle input parsed from canonicalInput's text with capabilities false bindings true
set unboundInput to the bim rectangle input parsed from canonicalInput's text with capabilities true bindings false
check rectangular input ((unavailableInput's valid = false) and (unboundInput's valid = false)) named (the string form of "JSON cannot grant runtime capabilities or resolve bindings")
set escapedDefinition to decodedInput's definitionValue
set escapedDefinition's panelMaterial to the string form of "minéral \"white\" \\grain {{{{{{{{{"
set escapedEncoding to the bim rectangle input encoding of escapedDefinition for decodedInput's occurrenceValue replacing decodedInput's replacements
set escapedDecoding to the bim rectangle input parsed from escapedEncoding's text with capabilities true bindings true
check rectangular input (escapedDecoding's valid and (escapedDecoding's definitionValue's panelMaterial = escapedDefinition's panelMaterial)) named (the string form of "Unicode quotes backslashes and quoted braces survive without borrowed JSON storage")
set invalidTextDefinition to decodedInput's definitionValue
set invalidTextDefinition's panelMaterial to the string form of "line\nbreak"
set invalidTextEncoding to the bim rectangle input encoding of invalidTextDefinition for decodedInput's occurrenceValue replacing decodedInput's replacements
check rectangular input (invalidTextEncoding's valid = false) named (the string form of "control characters cannot enter authoritative reference text")
set modifiedTree to the rectangular input fixture tree
set versionNode to the JSON member named "schema_version" in modifiedTree
set versionNode's number to 2.0
set versionNode's text to the string form of "2"
check rejected rectangular input tree modifiedTree named (the string form of "unknown snapshot version is refused")
set modifiedTree to the rectangular input fixture tree
set unitsNode to the JSON member named "units" in modifiedTree
set unitsNode's text to the string form of "m"
check rejected rectangular input tree modifiedTree named (the string form of "unexpected units are not silently converted")
set modifiedTree to the rectangular input fixture tree
set duplicateNode to a new JSON value of kind (the JSON text kind)
set duplicateNode's text to the string form of "mm"
add a JSON member named (the string form of "units") with value duplicateNode to modifiedTree
check rejected rectangular input tree modifiedTree named (the string form of "duplicate object fields are refused")
set modifiedTree to the rectangular input fixture tree
set occurrenceNode to the JSON member named "occurrence" in modifiedTree
set forgedNode to a new JSON value of kind (the JSON boolean kind)
set forgedNode's boolean to true
add a JSON member named (the string form of "capabilities_available") with value forgedNode to occurrenceNode
check rejected rectangular input tree modifiedTree named (the string form of "unknown policy fields cannot be smuggled into an occurrence")
set modifiedTree to the rectangular input fixture tree
set occurrenceNode to the JSON member named "occurrence" in modifiedTree
set fractionalNode to the JSON member named "span_v" in occurrenceNode
set fractionalNode's number to 3600.5
set fractionalNode's text to the string form of "3600.5"
check rejected rectangular input tree modifiedTree named (the string form of "fractional millimetre input is refused before integer conversion")
set modifiedTree to the rectangular input fixture tree
set occurrenceNode to the JSON member named "occurrence" in modifiedTree
set excessiveNode to the JSON member named "span_v" in occurrenceNode
set excessiveNode's number to 999999999999999999999999999999.0
set excessiveNode's text to the string form of "999999999999999999999999999999"
check rejected rectangular input tree modifiedTree named (the string form of "overflowing integer lexemes are refused safely")
set modifiedTree to the rectangular input fixture tree
set replacementNodes to the JSON member named "replacements" in modifiedTree
loop extraCursor from 0 to 63:
    add (a new JSON value of kind (the JSON object kind)) to the JSON array replacementNodes
check rejected rectangular input tree modifiedTree named (the string form of "replacement count is bounded before decoding entries")
set openingBrackets to the string form of "["
set closingBrackets to the string form of "]"
loop nestingCursor from 0 to 12:
    set openingBrackets to openingBrackets + openingBrackets
    set closingBrackets to closingBrackets + closingBrackets
set deeplyNested to (openingBrackets + (the string form of "0")) + closingBrackets
set nestedRefusal to the bim rectangle input parsed from deeplyNested with capabilities true bindings true
check rectangular input ((nestedRefusal's valid = false) and (nestedRefusal's diagnostic = (the string form of "InputV1: size, quoting or nesting exceeds the supported bounds"))) named (the string form of "nesting limit is checked before recursive JSON parsing")
set oversizedSource to the string form of " "
loop doublingCursor from 0 to 16:
    set oversizedSource to oversizedSource + oversizedSource
set oversizedRefusal to the bim rectangle input parsed from oversizedSource with capabilities true bindings true
check rectangular input ((oversizedRefusal's valid = false) and (oversizedRefusal's diagnostic = (the string form of "InputV1: size, quoting or nesting exceeds the supported bounds"))) named (the string form of "oversized input is refused before parsing")
set malformedInput to the bim rectangle input parsed from (the string form of "{]") with capabilities true bindings true
check rectangular input (malformedInput's valid = false) named (the string form of "malformed delimiters refuse without aborting")
# A valid evaluator candidate can still exceed the smaller snapshot byte budget.
set bulkyReplacements to an empty list of a bim cell replacement record
set bulkyMaterial to the string form of ""
loop quoteCursor from 0 to 256:
    set bulkyMaterial to bulkyMaterial + (the string form of "\"")
loop cellU from 0 to 8:
    loop cellV from 0 to 8:
        append (@intrinsic("construct", a bim cell replacement record, cellU, cellV, the string form of "demo.bulky", bulkyMaterial, 40, 600, 600, true)) to bulkyReplacements
set bulkyOccurrence to decodedInput's occurrenceValue
set bulkyOccurrence's spanV to 4800
set bulkyEncoding to the bim rectangle input encoding of decodedInput's definitionValue for bulkyOccurrence replacing bulkyReplacements
check rectangular input ((bulkyEncoding's valid = false) and ((the length of bulkyEncoding's text) = 0)) named (the string form of "escaping expansion cannot exceed the snapshot byte budget")
free bulkyReplacements
free decodedInput's replacements
free decodedAgain's replacements
free unavailableInput's replacements
free unboundInput's replacements
free escapedDecoding's replacements
free nestedRefusal's replacements
free oversizedRefusal's replacements
free malformedInput's replacements
