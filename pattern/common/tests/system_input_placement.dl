# SPDX-License-Identifier: MPL-2.0
import ui/editor/bim_editor.dl
import pattern/common/bim_system_input_placement.dl
import lib/filesystem.dl

function check input placement {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

read the file at "pattern/common/examples/ceiling-input-v1.json" and set authoringReading to it
check input placement (authoringReading succeeded) named (the string form of "authoring JSON fixture is readable")
set authoringText to the contents of authoringReading
set inputEditor to a new bim editor
set inputModel to the address of (inputEditor's documentValue's current)
set untouchedText to the bim file text of inputEditor's documentValue's current
set unavailablePlacement to place bim input authoringText with capabilities false bindings true on inputEditor's levelId to inputModel
check input placement ((unavailablePlacement's valid = false) and ((the bim file text of inputEditor's documentValue's current) = untouchedText)) named (the string form of "missing runtime capability refuses before native mutation")
set invalidPlacement to place bim input (the string form of "{]") with capabilities true bindings true on inputEditor's levelId to inputModel
check input placement ((invalidPlacement's valid = false) and ((the bim file text of inputEditor's documentValue's current) = untouchedText)) named (the string form of "malformed snapshot refuses without native objects or types")
begin bim transaction in (the address of (inputEditor's documentValue))
set inputResult to place bim input authoringText with capabilities true bindings true on inputEditor's levelId to inputModel
commit bim transaction in (the address of (inputEditor's documentValue))
check input placement (inputResult's valid and ((the length of (inputEditor's documentValue's current's curtains's values)) = 1)) named (the string form of "JSON inputs create one native ceiling host")
set inputHost to the item at 0 in (inputEditor's documentValue's current's curtains's values)
set placedParts to the bim parts of curtain wall inputHost in inputEditor's documentValue's current
set placedLights to 0
set placedTiles to 0
set placedMembers to 0
loop partCursor from 0 to the length of (placedParts's values):
    set inputPart to the item at partCursor in (placedParts's values)
    if inputPart's kind's material = (the string form of "LED diffuser"):
        set placedLights to placedLights + 1
    else if inputPart's kind's material = (the string form of "mineral fibre"):
        set placedTiles to placedTiles + 1
    else:
        set placedMembers to placedMembers + 1
check input placement (((placedLights = 2) and (placedTiles = 46)) and (placedMembers = 16)) named (the string form of "JSON substitutions produce 2 LED panels 46 tiles and 16 members")
set storedSnapshot to the bim property value (the string form of "InputV1") of set (the string form of "OpenBIM_RectangularGeneration") of inputResult's systemId in inputEditor's documentValue's current
set storedInput to the bim rectangle input parsed from storedSnapshot with capabilities true bindings true
set storedEncoding to the bim rectangle input encoding of storedInput's definitionValue for storedInput's occurrenceValue replacing storedInput's replacements
check input placement (storedInput's valid and (storedEncoding's text = storedSnapshot)) named (the string form of "stored InputV1 is canonical complete authoring input")
set snapshotCount to 0
set snapshotType to the string form of ""
loop propertyCursor from 0 to the length of (inputEditor's documentValue's current's properties's values):
    set propertyEntry to the item at propertyCursor in (inputEditor's documentValue's current's properties's values)
    if (propertyEntry's elementId = inputResult's systemId) and ((propertyEntry's setName = (the string form of "OpenBIM_RectangularGeneration")) and (propertyEntry's name = (the string form of "InputV1"))):
        set snapshotCount to snapshotCount + 1
        set snapshotType to propertyEntry's valueType
check input placement ((snapshotCount = 1) and (snapshotType = (the string form of "IfcText"))) named (the string form of "one snapshot uses the agreed existing IfcText property boundary")
set placedModelText to the bim file text of inputEditor's documentValue's current
set duplicateInputPlacement to place bim input authoringText with capabilities true bindings true on inputEditor's levelId to inputModel
check input placement ((duplicateInputPlacement's valid = false) and ((the bim file text of inputEditor's documentValue's current) = placedModelText)) named (the string form of "repeating source placement cannot duplicate or replace an existing occurrence")
save bim editor to (the string form of "build/input-v1-ceiling.ifcx") in (the address of inputEditor)
ignore undo bim transaction in (the address of (inputEditor's documentValue))
check input placement ((the length of (inputEditor's documentValue's current's curtains's values)) = 0) named (the string form of "one undo removes generated geometry and authoritative input")
ignore redo bim transaction in (the address of (inputEditor's documentValue))
check input placement ((the bim file text of inputEditor's documentValue's current) = placedModelText) named (the string form of "redo restores the same geometry and snapshot bytes")
set reopenedInputEditor to a new bim editor
open bim editor from (the string form of "build/input-v1-ceiling.ifcx") in (the address of reopenedInputEditor)
set reopenedSnapshot to the bim property value (the string form of "InputV1") of set (the string form of "OpenBIM_RectangularGeneration") of inputResult's systemId in reopenedInputEditor's documentValue's current
set reopenedInput to the bim rectangle input parsed from reopenedSnapshot with capabilities true bindings true
check input placement ((reopenedSnapshot = storedSnapshot) and (reopenedInput's valid and ((the length of reopenedInput's replacements) = 2))) named (the string form of "IFCX reopening preserves canonical input and both logical replacements")
# Recreate in an independent document from the persisted input, rather than
# copying existing geometry; no shared regenerate command is introduced.
set rebuiltInputEditor to a new bim editor
set rebuiltResult to place bim input reopenedSnapshot with capabilities true bindings true on rebuiltInputEditor's levelId to (the address of (rebuiltInputEditor's documentValue's current))
set firstKey to the bim property value (the string form of "CellU1V1") of set (the string form of "OpenBIM_RectangularGeneration") of rebuiltResult's systemId in rebuiltInputEditor's documentValue's current
set secondKey to the bim property value (the string form of "CellU5V3") of set (the string form of "OpenBIM_RectangularGeneration") of rebuiltResult's systemId in rebuiltInputEditor's documentValue's current
check input placement ((rebuiltResult's valid and (firstKey = (the string form of "ceiling-json-a/infill/grid/u1-v1"))) and (secondKey = (the string form of "ceiling-json-a/infill/grid/u5-v3"))) named (the string form of "persisted source rebuilds both semantic LED cells in a fresh model")
save bim editor to (the string form of "build/input-v1-ceiling-rebuilt.ifcx") in (the address of rebuiltInputEditor)
free storedInput's replacements
free reopenedInput's replacements
