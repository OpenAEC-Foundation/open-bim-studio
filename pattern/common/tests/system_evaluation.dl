# SPDX-License-Identifier: MPL-2.0
import pattern/common/bim_system_evaluation.dl
import lib/text.dl

function check rectangular evaluation {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the rectangular intent signature of {bim rectangular evaluation record:evaluationValue}:
    execute:
        set signatureLines to an empty list of a string
        loop partCursor from 0 to the length of evaluationValue's parts:
            set intentValue to the item at partCursor in evaluationValue's parts
            append ((((intentValue's key + (the string form of ":")) + intentValue's componentKey) + (the string form of ":")) + (the string form of intentValue's startU)) to signatureLines
        set signatureText to signatureLines joined with "|"
        free signatureLines
        return signatureText

set ceilingDefinition to @intrinsic("construct", a bim rectangular definition record, the string form of "generic.ceiling.grid", 1, 600, 600, 24, 38, 15, the string form of "steel", the string form of "mineral fibre", the string form of "generic.rectangular.24x38", the string form of "generic.mineral-fibre.15")
set ceilingOccurrence to @intrinsic("construct", a bim rectangular occurrence record, the string form of "ceiling-a", ceilingDefinition's identity, 1, 4800, 3000, 2600, 100, true, true)
set cellReplacements to an empty list of a bim cell replacement record
append (@intrinsic("construct", a bim cell replacement record, 2, 2, the string form of "demo.led.40", the string form of "LED diffuser", 40, 600, 600, true)) to cellReplacements
set firstEvaluation to evaluate bim rectangle ceilingOccurrence defined by ceilingDefinition replacing cellReplacements
check rectangular evaluation (firstEvaluation's valid and ((firstEvaluation's columns = 8) and (firstEvaluation's rows = 5))) named (the string form of "pinned ceiling evaluates to an 8 by 5 grid")
set lightCount to 0
set tileCount to 0
set supportCount to 0
set lightKey to the string form of ""
set clearModule to false
loop partCursor from 0 to the length of firstEvaluation's parts:
    set intentValue to the item at partCursor in firstEvaluation's parts
    if intentValue's role = 2:
        if intentValue's componentKey = (the string form of "demo.led.40"):
            set lightCount to lightCount + 1
            set lightKey to intentValue's key
            set clearModule to ((intentValue's finishU - intentValue's startU) = 576) and ((intentValue's finishV - intentValue's startV) = 576)
        else:
            set tileCount to tileCount + 1
    else:
        set supportCount to supportCount + 1
check rectangular evaluation (((lightCount = 1) and (tileCount = 39)) and ((supportCount = 15) and ((the length of firstEvaluation's parts) = 55))) named (the string form of "40 infills and 15 support members with exactly one replacement")
check rectangular evaluation (clearModule and (lightKey = (the string form of "ceiling-a/infill/grid/u2-v2"))) named (the string form of "LED occupies the 576 mm clear cell with an axis-based key")
set repeatedEvaluation to evaluate bim rectangle ceilingOccurrence defined by ceilingDefinition replacing cellReplacements
check rectangular evaluation ((the rectangular intent signature of firstEvaluation) = (the rectangular intent signature of repeatedEvaluation)) named (the string form of "repeated evaluation preserves ordered semantic output")
set extendedOccurrence to ceilingOccurrence
set extendedOccurrence's spanV to 3600
set extendedEvaluation to evaluate bim rectangle extendedOccurrence defined by ceilingDefinition replacing cellReplacements
set retainedLightKey to the string form of ""
set extendedLightCount to 0
loop partCursor from 0 to the length of extendedEvaluation's parts:
    set intentValue to the item at partCursor in extendedEvaluation's parts
    if intentValue's componentKey = (the string form of "demo.led.40"):
        set retainedLightKey to intentValue's key
        set extendedLightCount to extendedLightCount + 1
check rectangular evaluation (((extendedEvaluation's valid and (extendedEvaluation's rows = 6)) and (extendedLightCount = 1)) and (retainedLightKey = lightKey)) named (the string form of "adding a row retains one LED on the same logical cell")
set badOccurrence to ceilingOccurrence
set badOccurrence's pinnedVersion to 2
set versionRefusal to evaluate bim rectangle badOccurrence defined by ceilingDefinition replacing cellReplacements
check rectangular evaluation ((versionRefusal's valid = false) and ((the length of versionRefusal's parts) = 0)) named (the string form of "mismatched definition version refuses without partial output")
set badOccurrence to ceilingOccurrence
set badOccurrence's capabilitiesAvailable to false
set capabilityRefusal to evaluate bim rectangle badOccurrence defined by ceilingDefinition replacing cellReplacements
check rectangular evaluation ((capabilityRefusal's valid = false) and ((the length of capabilityRefusal's diagnostic) > 0)) named (the string form of "missing generation capability has an explicit refusal")
set badOccurrence to ceilingOccurrence
set badOccurrence's bindingsAvailable to false
set bindingRefusal to evaluate bim rectangle badOccurrence defined by ceilingDefinition replacing cellReplacements
check rectangular evaluation ((bindingRefusal's valid = false) and ((the length of bindingRefusal's parts) = 0)) named (the string form of "unresolved bindings cannot generate geometry")
set badOccurrence to ceilingOccurrence
set badOccurrence's partLimit to 54
set budgetRefusal to evaluate bim rectangle badOccurrence defined by ceilingDefinition replacing cellReplacements
check rectangular evaluation ((budgetRefusal's valid = false) and ((the length of budgetRefusal's parts) = 0)) named (the string form of "part budget refuses the complete candidate atomically")
set badDefinition to ceilingDefinition
set badDefinition's pitchU to 0
set pitchRefusal to evaluate bim rectangle ceilingOccurrence defined by badDefinition replacing cellReplacements
check rectangular evaluation (pitchRefusal's valid = false) named (the string form of "zero pitch refuses before division")
set badOccurrence to ceilingOccurrence
set badOccurrence's spanU to 4700
set clippingRefusal to evaluate bim rectangle badOccurrence defined by ceilingDefinition replacing cellReplacements
check rectangular evaluation (clippingRefusal's valid = false) named (the string form of "partial edge cells report unsupported clipping")
set badReplacement to the item at 0 in cellReplacements
set badReplacement's supportCompatible to false
set incompatibleReplacements to an empty list of a bim cell replacement record
append badReplacement to incompatibleReplacements
set supportRefusal to evaluate bim rectangle ceilingOccurrence defined by ceilingDefinition replacing incompatibleReplacements
check rectangular evaluation ((supportRefusal's valid = false) and ((the length of supportRefusal's parts) = 0)) named (the string form of "unconfirmed LED support prevents the whole candidate")
append (the item at 0 in cellReplacements) to cellReplacements
set duplicateRefusal to evaluate bim rectangle ceilingOccurrence defined by ceilingDefinition replacing cellReplacements
check rectangular evaluation (duplicateRefusal's valid = false) named (the string form of "two replacements cannot target the same cell")
free cellReplacements
free incompatibleReplacements
free firstEvaluation's parts
free repeatedEvaluation's parts
free extendedEvaluation's parts
free versionRefusal's parts
free capabilityRefusal's parts
free bindingRefusal's parts
free budgetRefusal's parts
free pitchRefusal's parts
free clippingRefusal's parts
free supportRefusal's parts
free duplicateRefusal's parts
