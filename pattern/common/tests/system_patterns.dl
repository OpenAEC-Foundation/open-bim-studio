# SPDX-License-Identifier: MPL-2.0
# Building system patterns. A 6 x 3 m system in bays of 1.2 m and rows of
# 1.5 m laid in running bond keeps its bed joints (3 transoms) and its two
# ends, but every other row's joints stand halfway along the bays: 4 and 5
# inner joints, so 11 mullions, and 5 and 6 cells (half cells at the ends).
# The same system makes masonry: 2.4 x 1 m of bricks in bays of 220 mm and
# rows of 62.5 mm, with 10 mm joints 100 mm deep and a brick panel type, is
# 11 and 12 bricks a row over 16 rows. The pattern and joints survive the
# file.
import ui/editor/bim_editor.dl

function show bim pattern test of {bim curtain record:curtainValue} in {bim model record:modelValue} labelled {a string:title}:
    execute:
        set curtainParts to the bim parts of curtain wall curtainValue in modelValue
        set mullions to 0
        set transoms to 0
        set cellCount to 0
        set narrowest to 1000.0
        loop partCursor from 0 to the length of (curtainParts's values):
            set derivedPart to the item at partCursor in (curtainParts's values)
            if derivedPart's kind's name = (the string form of "Mullion"):
                set mullions to mullions + 1
            else if derivedPart's kind's name = (the string form of "Transom"):
                set transoms to transoms + 1
            else:
                set cellCount to cellCount + 1
                set narrowest to the minimum of narrowest and derivedPart's kind's width
        set rounded to (@intrinsic("call", "libc", "round", a 64 bit floating-point number, narrowest * 10000.0)) / 10000.0
        print ((title + (the string form of ": mullions ")) + ((the string form of mullions) + ((the string form of ", transoms ") + ((the string form of transoms) + ((the string form of ", cells ") + ((the string form of cellCount) + ((the string form of ", narrowest cell ") + (the string form of rounded)))))))) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to target
set curtainId to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "aluminium") to target
show bim pattern test of (the item at 0 in (modelValue's curtains's values)) in modelValue labelled (the string form of "grid")
set bim setting (bim system pattern setting) of curtainId to ((bim running bond pattern) as a 64 bit integer) keeping true in target
print ((the string form of "pattern: ") + (the bim name of pattern (the bim pattern of system curtainId in modelValue))) as a line
show bim pattern test of (the item at 0 in (modelValue's curtains's values)) in modelValue labelled (the string form of "running bond")
# Masonry: bricks of a planar type, 10 mm joints, 100 mm deep.
set brickLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to brickLayers
set brickType to add bim wall type named (the string form of "Baksteen 100") with brickLayers to target
free brickLayers
set brickId to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 5.0) to (a cad vector2 with x 2.4 and y 5.0) rising 1.0 in bays of 0.22 by 0.0625 of (the string form of "mortar") to target
set bim setting (bim system pattern setting) of brickId to ((bim running bond pattern) as a 64 bit integer) keeping true in target
set bim setting (bim joint width setting) of brickId to (10 as a 64 bit integer) keeping true in target
set bim setting (bim joint depth setting) of brickId to (100 as a 64 bit integer) keeping true in target
set bim panel -1 of system brickId to type brickType in target
show bim pattern test of (the item at 1 in (modelValue's curtains's values)) in modelValue labelled (the string form of "brickwork")
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", ") + reread's message))) as a line
show bim pattern test of (the item at 1 in (reread's modelValue's curtains's values)) in reread's modelValue labelled (the string form of "brickwork from .bim")
# Merged joints: the brickwork's mortar becomes one closed body, with a
# hole for each brick, as deep as its joints.
set bim setting (bim merged joints setting) of brickId to (1 as a 64 bit integer) keeping true in target
set brickValue to the item at 1 in (modelValue's curtains's values)
set mergedShape to the bim curtain shape of brickValue in modelValue within 0.0
set brickParts to the bim parts of curtain wall brickValue in modelValue
set brickCells to a cad topology list of a bim stair part record
loop partCursor from 0 to the length of (brickParts's values):
    set brickPart to the item at partCursor in (brickParts's values)
    if (brickPart's kind's name != (the string form of "Mullion")) and (brickPart's kind's name != (the string form of "Transom")):
        append brickPart to (brickCells's values)
set mortar to the bim merged joints of brickValue lifted 0.0 among (brickCells's values) in modelValue
print ((the string form of "mortar closed: ") + ((the string form of ((the fast mesh flaw of mortar) = 0)) + ((the string form of ", volume ") + (the string form of ((@intrinsic("call", "libc", "round", a 64 bit floating-point number, (the bim volume of mesh mortar) * 10000.0)) / 10000.0))))) as a line
# Diamonds of 600 mm over 2.4 x 0.9 m: 7 whole, 9 halves along the edges
# and 2 quarters in the corners, which together cover the face; with 1 mm
# joints the panels keep 99% of it. The halves and quarters are panels
# tapering to their points, closed solids each.
set diamondId to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 10.0) to (a cad vector2 with x 2.4 and y 10.0) rising 0.9 in bays of 0.6 by 0.9 of (the string form of "steel") to target
set bim setting (bim system pattern setting) of diamondId to ((bim diamond pattern) as a 64 bit integer) keeping true in target
set bim setting (bim joint width setting) of diamondId to (1 as a 64 bit integer) keeping true in target
set diamondValue to the item at 2 in (modelValue's curtains's values)
set diamondParts to the bim parts of curtain wall diamondValue in modelValue
set wholeCount to 0
set halfCount to 0
set quarterCount to 0
set panelArea to 0.0
set panelFlaws to 0
loop partCursor from 0 to the length of (diamondParts's values):
    set diamondPart to the item at partCursor in (diamondParts's values)
    if (diamondPart's kind's name != (the string form of "Mullion")) and (diamondPart's kind's name != (the string form of "Transom")):
        set partLength to the cad distance from diamondPart's element's start to diamondPart's element's finish
        set panelFlaws to panelFlaws + (the fast mesh flaw of (the bim linear shape of diamondPart's element typed diamondPart's kind in modelValue within 0.0))
        if diamondPart's element's taper's x > 0.5:
            set wholeCount to wholeCount + 1
            set panelArea to panelArea + (diamondPart's kind's width * partLength)
        else:
            set panelArea to panelArea + ((diamondPart's kind's width * partLength) * 0.5)
            if diamondPart's kind's width > 0.5:
                set halfCount to halfCount + 1
            else:
                set quarterCount to quarterCount + 1
print ((the string form of "diamond: whole ") + ((the string form of wholeCount) + ((the string form of ", halves ") + ((the string form of halfCount) + ((the string form of ", quarters ") + (the string form of quarterCount)))))) as a line
print ((the string form of "diamond panels closed: ") + ((the string form of (panelFlaws = 0)) + ((the string form of ", cover the face: ") + (the string form of ((panelArea > (0.99 * 2.16)) and (panelArea <= 2.16)))))) as a line
