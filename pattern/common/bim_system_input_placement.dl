# Create from InputV1 and store one canonical IfcText snapshot. Approved in
# issue22 comment6487422169; no shared UI/serializer/model-record changes.
import pattern/common/bim_system_input.dl
import pattern/common/bim_system_materialization.dl

function place bim input {a string:sourceText} with capabilities {boolean:canGenerate} bindings {boolean:canBind} on {a 64 bit integer:storeyId} to {a pointer to a bim model record:destination}:
    execute:
        set sourceInput to the bim rectangle input parsed from sourceText with capabilities canGenerate bindings canBind
        if sourceInput's valid = false:
            free sourceInput's replacements
            return @intrinsic("construct", a bim rectangular placement record, false, sourceInput's diagnostic, the bim refused id, 0, 0)
        set snapshotEncoding to the bim rectangle input encoding of sourceInput's definitionValue for sourceInput's occurrenceValue replacing sourceInput's replacements
        if snapshotEncoding's valid = false:
            free sourceInput's replacements
            return @intrinsic("construct", a bim rectangular placement record, false, snapshotEncoding's diagnostic, the bim refused id, 0, 0)
        set inputPlacement to place bim rectangle sourceInput's occurrenceValue defined by sourceInput's definitionValue replacing sourceInput's replacements on storeyId to destination
        free sourceInput's replacements
        if inputPlacement's valid:
            set bim property (the string form of "InputV1") of set (the string form of "OpenBIM_RectangularGeneration") of inputPlacement's systemId to snapshotEncoding's text typed (the string form of "IfcText") in destination
        return inputPlacement
