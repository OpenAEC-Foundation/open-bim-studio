# SPDX-License-Identifier: MPL-2.0
# Read-only, host-local agreement with the creation input. Not permission to
# regenerate: external relationships and manual-edit intent need separate policy.
import pattern/common/bim_system_input_placement.dl

class:
    patterns:
        [a|] bim rectangular inspection record
    members:
        matches as a boolean
        diagnostic as a string

local function the bim rectangle inspection refusal saying {a string:reasonText}:
    execute:
        return @intrinsic("construct", a bim rectangular inspection record, false, reasonText)

local function bim rectangle measure {a 64 bit floating-point number:leftValue} agrees with {a 64 bit floating-point number:rightValue}:
    execute:
        return (the absolute value of (leftValue - rightValue)) <= 1e-9

# IDs and generated display names may differ between independent documents.
# Compare the actual planar role and ordered material/thickness layers instead.
local function bim rectangle type {a 64 bit integer:actualTypeId} in {bim model record:actualModel} agrees with type {a 64 bit integer:referenceTypeId} in {bim model record:referenceModel}:
    execute:
        set actualFound to the bim wall type index of actualTypeId in actualModel
        set referenceFound to the bim wall type index of referenceTypeId in referenceModel
        if (actualFound's valid = false) or (referenceFound's valid = false):
            return false
        set actualType to the item at actualFound's position in (actualModel's wallTypes's values)
        set referenceType to the item at referenceFound's position in (referenceModel's wallTypes's values)
        if (actualType's role != referenceType's role) or ((the length of (actualType's layers's values)) != (the length of (referenceType's layers's values))):
            return false
        loop layerCursor from 0 to the length of (actualType's layers's values):
            set actualLayer to the item at layerCursor in (actualType's layers's values)
            set referenceLayer to the item at layerCursor in (referenceType's layers's values)
            if (actualLayer's material != referenceLayer's material) or ((bim rectangle measure actualLayer's thickness agrees with referenceLayer's thickness) = false):
                return false
        return true

# Reads only. The reference is created in an independent scratch model through
# the already-approved create adapter; it never enters the inspected document.
function inspect bim rectangle {a 64 bit integer:inspectedId} in {bim model record:observedModel}:
    execute:
        set actualFound to the bim curtain index of inspectedId in observedModel
        if actualFound's valid = false:
            return the bim rectangle inspection refusal saying (the string form of "host: system does not exist")
        set actualHost to the item at actualFound's position in (observedModel's curtains's values)
        if (the bim level index of actualHost's levelId in observedModel)'s valid = false:
            return the bim rectangle inspection refusal saying (the string form of "host: storey does not exist")
        set sourceSet to the string form of "OpenBIM_RectangularGeneration"
        set sourceText to the bim property value (the string form of "InputV1") of set sourceSet of inspectedId in observedModel
        set sourceInput to the bim rectangle input parsed from sourceText with capabilities true bindings true
        if sourceInput's valid = false:
            free sourceInput's replacements
            return the bim rectangle inspection refusal saying sourceInput's diagnostic
        set sourceEncoding to the bim rectangle input encoding of sourceInput's definitionValue for sourceInput's occurrenceValue replacing sourceInput's replacements
        free sourceInput's replacements
        if sourceEncoding's valid = false:
            return the bim rectangle inspection refusal saying sourceEncoding's diagnostic
        # New nested/layer/opening dependencies are outside the isolated v1 host.
        loop dependentCursor from 0 to the length of (observedModel's curtains's values):
            set dependentHost to the item at dependentCursor in (observedModel's curtains's values)
            if ((the bim setting (bim host system setting) of dependentHost's id in observedModel)'s value = inspectedId) or ((the bim setting (bim layer host setting) of dependentHost's id in observedModel)'s value = inspectedId):
                return the bim rectangle inspection refusal saying (the string form of "host: dependent system is outside the isolated v1 footprint")
        loop openingCursor from 0 to the length of (observedModel's openings's values):
            if (the item at openingCursor in (observedModel's openings's values))'s hostId = inspectedId:
                return the bim rectangle inspection refusal saying (the string form of "host: opening is outside the isolated v1 footprint")
        set referenceModel to an empty bim model
        set referenceLevel to add bim level named (the string form of "Reference") at 0.0 with height 3.0 to (the address of referenceModel)
        set referencePlacement to place bim input sourceEncoding's text with capabilities true bindings true on referenceLevel to (the address of referenceModel)
        if referencePlacement's valid = false:
            return the bim rectangle inspection refusal saying referencePlacement's diagnostic
        set referenceHost to the item at 0 in (referenceModel's curtains's values)
        if (bim rectangle measure actualHost's start's x agrees with referenceHost's start's x) = false:
            return the bim rectangle inspection refusal saying (the string form of "shape: start differs from creation input")
        if (bim rectangle measure actualHost's start's y agrees with referenceHost's start's y) = false:
            return the bim rectangle inspection refusal saying (the string form of "shape: start differs from creation input")
        if (bim rectangle measure actualHost's finish's x agrees with referenceHost's finish's x) = false:
            return the bim rectangle inspection refusal saying (the string form of "shape: finish differs from creation input")
        if (bim rectangle measure actualHost's finish's y agrees with referenceHost's finish's y) = false:
            return the bim rectangle inspection refusal saying (the string form of "shape: finish differs from creation input")
        if (bim rectangle measure actualHost's height agrees with referenceHost's height) = false:
            return the bim rectangle inspection refusal saying (the string form of "shape: span differs from creation input")
        if (bim rectangle measure actualHost's bayWidth agrees with referenceHost's bayWidth) = false:
            return the bim rectangle inspection refusal saying (the string form of "grid: U pitch differs from creation input")
        if (bim rectangle measure actualHost's rowHeight agrees with referenceHost's rowHeight) = false:
            return the bim rectangle inspection refusal saying (the string form of "grid: V pitch differs from creation input")
        if (bim rectangle measure actualHost's bulge agrees with referenceHost's bulge) = false:
            return the bim rectangle inspection refusal saying (the string form of "shape: curved host is outside v1")
        if actualHost's material != referenceHost's material:
            return the bim rectangle inspection refusal saying (the string form of "binding: frame material differs from creation input")
        set actualSettingCount to 0
        set referenceSettingCount to 0
        loop settingCursor from 0 to the length of (observedModel's settings's values):
            set actualSetting to the item at settingCursor in (observedModel's settings's values)
            if actualSetting's elementId = inspectedId:
                set actualSettingCount to actualSettingCount + 1
                set expectedSetting to the bim setting actualSetting's code of referencePlacement's systemId in referenceModel
                if expectedSetting's found = false:
                    return the bim rectangle inspection refusal saying (the string form of "settings: extra or unsupported host setting")
                if (actualSetting's code >= bim panel type setting) and (actualSetting's code < bim connection setting):
                    if (bim rectangle type actualSetting's value in observedModel agrees with type expectedSetting's value in referenceModel) = false:
                        return the bim rectangle inspection refusal saying (the string form of "binding: panel type differs from creation input")
                else if actualSetting's value != expectedSetting's value:
                    return the bim rectangle inspection refusal saying (the string form of "settings: value differs from creation input")
        loop referenceCursor from 0 to the length of (referenceModel's settings's values):
            set referenceSetting to the item at referenceCursor in (referenceModel's settings's values)
            if referenceSetting's elementId = referencePlacement's systemId:
                set referenceSettingCount to referenceSettingCount + 1
                if (the bim setting referenceSetting's code of inspectedId in observedModel)'s found = false:
                    return the bim rectangle inspection refusal saying (the string form of "settings: missing creation setting")
        if actualSettingCount != referenceSettingCount:
            return the bim rectangle inspection refusal saying (the string form of "settings: duplicate host setting")
        set actualPropertyCount to 0
        set referencePropertyCount to 0
        loop propertyCursor from 0 to the length of (observedModel's properties's values):
            set actualProperty to the item at propertyCursor in (observedModel's properties's values)
            if (actualProperty's elementId = inspectedId) and (actualProperty's setName = sourceSet):
                set actualPropertyCount to actualPropertyCount + 1
                set propertyMatches to false
                loop expectedCursor from 0 to the length of (referenceModel's properties's values):
                    set expectedProperty to the item at expectedCursor in (referenceModel's properties's values)
                    if (expectedProperty's elementId = referencePlacement's systemId) and ((expectedProperty's setName = sourceSet) and (expectedProperty's name = actualProperty's name)):
                        set propertyMatches to (actualProperty's valueType = expectedProperty's valueType) and (actualProperty's value = expectedProperty's value)
                        if actualProperty's name = (the string form of "InputV1"):
                            set propertyMatches to (actualProperty's valueType = expectedProperty's valueType) and (sourceEncoding's text = expectedProperty's value)
                if propertyMatches = false:
                    return the bim rectangle inspection refusal saying (the string form of "provenance: generator property differs from creation input")
        loop expectedCursor from 0 to the length of (referenceModel's properties's values):
            set expectedProperty to the item at expectedCursor in (referenceModel's properties's values)
            if (expectedProperty's elementId = referencePlacement's systemId) and (expectedProperty's setName = sourceSet):
                set referencePropertyCount to referencePropertyCount + 1
                set actualValue to the bim property value expectedProperty's name of set sourceSet of inspectedId in observedModel
                if (the length of actualValue) = 0:
                    return the bim rectangle inspection refusal saying (the string form of "provenance: missing generator property")
        if actualPropertyCount != referencePropertyCount:
            return the bim rectangle inspection refusal saying (the string form of "provenance: duplicate or extra generator property")
        return @intrinsic("construct", a bim rectangular inspection record, true, the string form of "host-local creation footprint agrees; not a regeneration authorization")
