# SPDX-License-Identifier: MPL-2.0
# Reproducible baseline using the existing system adapter, not the catalogue
# evaluator. All dimensions are illustrative; no product performance is implied.
import pattern/common/bim_system_types.dl

function add bim ceiling demonstration on {a 64 bit integer:storeyId} to {a pointer to a bim model record:destination}:
    execute:
        # Resolve by name so appending recipes cannot silently change this example.
        set recipes to the bim system types
        set ceilingRecipeIndex to -1
        loop recipeCursor from 0 to the length of recipes:
            if (the item at recipeCursor in recipes)'s name = (the string form of "Systeemplafond 600x600"):
                set ceilingRecipeIndex to recipeCursor
        free recipes
        if (ceilingRecipeIndex < 0) or ((the bim level index of storeyId in (@intrinsic("dereference", destination)))'s valid = false):
            return the bim refused id
        set ceilingDemoId to add bim curtain wall on storeyId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.8 and y 0.0) rising 3.0 in bays of 0.6 by 0.6 of (the string form of "steel") to destination
        ignore give bim system ceilingDemoId type ceilingRecipeIndex in destination
        set lightLayers to an empty list of a bim layer record
        append (@intrinsic("construct", a bim layer record, the string form of "LED diffuser", 0.04)) to lightLayers
        set lightTypeId to add bim planar type named (the string form of "LED-panel 600x600 - demonstration") as role (bim ceiling planar role) with lightLayers to destination
        free lightLayers
        set bim panel 12 of system ceilingDemoId to type lightTypeId in destination
        return ceilingDemoId
