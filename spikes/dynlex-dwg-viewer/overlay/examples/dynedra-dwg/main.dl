import examples/dynedra-dwg/render.dl

set arguments to the command line arguments
if arguments' length < 1:
    print "Usage: dynedra-dwg <drawing.dwg> [reader executable]" as a line
    return 2
set path to the argument at 0 in arguments
set reader to the string form of "build/dynedra-dwg-cargo/debug/dynedra-dwg-reader.exe"
if arguments' length >= 2:
    set reader to the argument at 1 in arguments
set drawing to the dwg drawing at path using reader reader
if drawing's valid = false:
    print drawing's message as a line
    return 1
set window to a new window with width 1240 and height 780
set the title of window to "Dynedra DWG Viewer"
set loading to the result of loading a font from "tests/games/fonts/LiberationMono-Regular.ttf" at size 18 for window
set typeface to loading's typeface
if loading failed:
    print "Could not load viewer font. Run from the repository root." as a line
    close window
    free drawing's segments
    return 1
set view to the initial dwg view
set previousCursor to the cursor position of window
set previousMouse to false
loop while window remains open:
    if key the escape key is down in window:
        request that window close
    set cursor to the cursor position of window
    set mouse to the left mouse button is pressed in window
    if (mouse and previousMouse) and (cursor's x > 230.0):
        set motionX to (cursor's x - previousCursor's x) as a 64 bit floating-point number
        set motionY to (cursor's y - previousCursor's y) as a 64 bit floating-point number
        set view's panX to view's panX + motionX
        set view's panY to view's panY + motionY
    if key the Q key is down in window:
        set view's zoom to (view's zoom / 1.03) clamped between 0.05 and 100.0
    if key the E key is down in window:
        set view's zoom to (view's zoom * 1.03) clamped between 0.05 and 100.0
    if key the 1 key is down in window:
        set view's yaw to 0.0
        set view's pitch to -1.5707963267948966
    if key the 2 key is down in window:
        set view's yaw to 0.6
        set view's pitch to -0.6
    if key the left arrow key is down in window:
        set view's yaw to view's yaw - 0.025
    if key the right arrow key is down in window:
        set view's yaw to view's yaw + 0.025
    if key the up arrow key is down in window:
        set view's pitch to (view's pitch + 0.025) clamped between -1.5707963267948966 and 1.5707963267948966
    if key the down arrow key is down in window:
        set view's pitch to (view's pitch - 0.025) clamped between -1.5707963267948966 and 1.5707963267948966
    if key the 0 key is down in window:
        set view to the initial dwg view
    set previousCursor to cursor
    set previousMouse to mouse
    set frame to a new graphics frame in window with background red 0.9686, green 0.9765, blue 0.9882 and alpha 1.0
    draw dwg drawing drawing with view using typeface in frame
    display frame
    sleep for 8 milliseconds
set releasing to the result of releasing (the address of typeface)
close window
free drawing's segments
if releasing failed:
    return 1
