import examples/dynedra-dwg/model.dl
import lib/graphics.dl
import lib/font.dl

class:
    patterns:
        [a|] dwg view
    members:
        yaw as a 64 bit floating-point number
        pitch as a 64 bit floating-point number
        zoom as a 64 bit floating-point number
        panX as a 64 bit floating-point number
        panY as a 64 bit floating-point number

function the initial dwg view:
    replacement:
        @intrinsic("construct", a dwg view, 0.0, -1.5707963267948966, 1.0, 0.0, 0.0)

function the dwg display point for {cad vector3:point} from {dwg drawing:drawing} with {dwg view:view} sized {integer:width} {integer:height}:
    execute:
        set center to (the cad sum of drawing's low and drawing's high) scaled by 0.5
        set relative to the cad difference of point and center
        set horizontal to ((the cosine of view's yaw) * relative's x) - ((the sine of view's yaw) * relative's y)
        set depth to ((the sine of view's yaw) * relative's x) + ((the cosine of view's yaw) * relative's y)
        set vertical to ((the cosine of view's pitch) * relative's z) - ((the sine of view's pitch) * depth)
        set span to the maximum of 1.0 and (the maximum of (drawing's high's x - drawing's low's x) and (the maximum of (drawing's high's y - drawing's low's y) and (drawing's high's z - drawing's low's z)))
        set size to (the minimum of (width - 245) and (height - 110)) as a 64 bit floating-point number
        set scale to ((size * 0.85) * view's zoom) / span
        set displayX to (230.0 + (((width - 230) as a 64 bit floating-point number) * 0.5)) + ((horizontal * scale) + view's panX)
        set displayY to (65.0 + (((height - 65) as a 64 bit floating-point number) * 0.5)) + ((the negative of vertical * scale) + view's panY)
        return a cad vector2 with x displayX and y displayY

function add dwg stroke from {cad vector2:first} to {cad vector2:second} in {graphics frame:frame}:
    execute:
        set direction to the cad difference of second and first
        set length to the cad length of direction
        if length <= 0.000001:
            return nothing
        set x to (the negative of direction's y) * (0.8 / length)
        set y to direction's x * (0.8 / length)
        add a vertex at x (first's x + x) and y (first's y + y) to frame
        add a vertex at x (first's x - x) and y (first's y - y) to frame
        add a vertex at x (second's x + x) and y (second's y + y) to frame
        add a vertex at x (second's x + x) and y (second's y + y) to frame
        add a vertex at x (first's x - x) and y (first's y - y) to frame
        add a vertex at x (second's x - x) and y (second's y - y) to frame

function draw dwg text value at {integer:x} {integer:y} size {integer:size} muted {boolean:muted} using {font:typeface} in {graphics frame:frame}:
    execute:
        set status to the result of setting typeface's pixel size to size
        if status failed:
            return nothing
        set red to 29
        set green to 47
        set blue to 69
        if muted:
            set red to 106
            set green to 121
            set blue to 142
        set drawing to the result of drawing value as text at x x and y y using typeface in color red red, green green and blue blue in frame

function draw dwg drawing {dwg drawing:drawing} with {dwg view:view} using {font:typeface} in {graphics frame:frame}:
    execute:
        set width to the framebuffer width of frame's window
        set height to the framebuffer height of frame's window
        start triangles in frame
        use vertex color red 32, green 92 and blue 187 in frame
        loop index from 0 to the length of drawing's segments:
            set segment to the item at index in drawing's segments
            set first to the dwg display point for segment's start from drawing with view sized width height
            set second to the dwg display point for segment's end from drawing with view sized width height
            add dwg stroke from first to second in frame
        finish triangles in frame
        draw a rectangle at x 0 and y 0 with width 230 and height height in color red 255, green 255 and blue 255 in frame
        draw a rectangle at x 230 and y 0 with width 1 and height height in color red 216, green 226 and blue 239 in frame
        draw a rectangle at x 0 and y 0 with width width and height 64 in color red 247, green 249 and blue 252 in frame
        draw dwg text "Dynedra DWG" at 24 43 size 28 muted false using typeface in frame
        draw dwg text "READ-ONLY VIEW" at 24 103 size 14 muted true using typeface in frame
        draw dwg text "Model space" at 24 153 size 18 muted false using typeface in frame
        draw dwg text (the string form of drawing's entities + " entities") at 24 194 size 16 muted false using typeface in frame
        draw dwg text (the string form of (the length of drawing's segments) + " segments") at 24 225 size 16 muted false using typeface in frame
        draw dwg text (the string form of drawing's unsupported + " skipped") at 24 256 size 16 muted true using typeface in frame
        draw dwg text "Drag: pan" at 24 335 size 15 muted false using typeface in frame
        draw dwg text "Q / E: zoom" at 24 366 size 15 muted false using typeface in frame
        draw dwg text "1: top  2: orbit" at 24 397 size 15 muted false using typeface in frame
        draw dwg text "Arrows: orbit" at 24 428 size 15 muted false using typeface in frame
        draw dwg text "0: fit view" at 24 459 size 15 muted false using typeface in frame
        draw dwg text "Esc: close" at 24 490 size 15 muted false using typeface in frame
