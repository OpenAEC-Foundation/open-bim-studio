import lib/cadkernel/core.dl
import lib/process.dl
import lib/text.dl

class:
    patterns:
        [a|] dwg segment
    members:
        start as a cad vector3
        end as a cad vector3

class:
    patterns:
        [a|] dwg drawing
    members:
        valid as a boolean
        message as a string
        entities as an integer
        unsupported as an integer
        segments
        low as a cad vector3
        high as a cad vector3

function a failed dwg drawing because {string:reason}:
    execute:
        return @intrinsic("construct", a dwg drawing, false, reason, 0, 0, an empty list of a dwg segment, the cad zero vector3, the cad zero vector3)

function the dwg drawing from {string:contents}:
    execute:
        set rows to contents split at "\n"
        if the length of rows < 1:
            free rows
            return a failed dwg drawing because the string form of "Empty DWG reader output"
        set header to the item at 0 in rows
        store (0 as a byte) into the data of header at header's length
        set entities to 0
        set count to 0
        set unsupported to 0
        set matched to @intrinsic("variadic call", "libc", "sscanf", an integer, 2, the data of header, "DYNEDRA-DWG-1 %d %d %d", the address of entities, the address of count, the address of unsupported)
        if (matched != 3) or ((count < 0) or (count > 1000000)):
            free rows
            return a failed dwg drawing because the string form of "Invalid DWG wireframe header"
        if (entities < 0) or ((unsupported < 0) or (unsupported > entities)):
            free rows
            return a failed dwg drawing because the string form of "Invalid DWG entity counts"
        if the length of rows < (count + 1):
            free rows
            return a failed dwg drawing because the string form of "Truncated DWG wireframe"
        set segments to an empty list of a dwg segment
        set low to the cad zero vector3
        set high to the cad zero vector3
        loop index from 0 to count:
            set row to the item at (index + 1) in rows
            store (0 as a byte) into the data of row at row's length
            set x1 to 0.0 as a 64 bit floating-point number
            set y1 to 0.0 as a 64 bit floating-point number
            set z1 to 0.0 as a 64 bit floating-point number
            set x2 to 0.0 as a 64 bit floating-point number
            set y2 to 0.0 as a 64 bit floating-point number
            set z2 to 0.0 as a 64 bit floating-point number
            set fields to @intrinsic("variadic call", "libc", "sscanf", an integer, 2, the data of row, "%lf %lf %lf %lf %lf %lf", the address of x1, the address of y1, the address of z1, the address of x2, the address of y2, the address of z2)
            if fields != 6:
                free segments
                free rows
                return a failed dwg drawing because the string form of "Invalid DWG segment"
            set first to a cad vector3 with x x1, y y1 and z z1
            set second to a cad vector3 with x x2, y y2 and z z2
            if (cad first is finite) = false or ((cad second is finite) = false):
                free segments
                free rows
                return a failed dwg drawing because the string form of "Non-finite DWG segment"
            if index = 0:
                set low to first
                set high to first
            set low's x to the minimum of low's x and (the minimum of first's x and second's x)
            set low's y to the minimum of low's y and (the minimum of first's y and second's y)
            set low's z to the minimum of low's z and (the minimum of first's z and second's z)
            set high's x to the maximum of high's x and (the maximum of first's x and second's x)
            set high's y to the maximum of high's y and (the maximum of first's y and second's y)
            set high's z to the maximum of high's z and (the maximum of first's z and second's z)
            append (@intrinsic("construct", a dwg segment, first, second)) to segments
        free rows
        return @intrinsic("construct", a dwg drawing, true, the string form of "Drawing loaded", entities, unsupported, segments, low, high)

function the dwg drawing at {string:path} using reader {string:executable}:
    execute:
        set command to a process command for executable
        add "export" as an argument to command
        add path as an argument to command
        run command and set result to it
        if result failed:
            if result's standard error is not empty:
                return a failed dwg drawing because result's standard error
            return a failed dwg drawing because result's error message
        return the dwg drawing from result's standard output
