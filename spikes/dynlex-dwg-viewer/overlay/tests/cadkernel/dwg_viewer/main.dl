import examples/dynedra-dwg/render.dl

set arguments to the command line arguments
if arguments' length != 2:
    print "Expected drawing path and reader executable" as a line
    return 2
set drawing to the dwg drawing at (the argument at 0 in arguments) using reader (the argument at 1 in arguments)
if drawing's valid = false:
    print drawing's message as a line
    return 1
if (drawing's entities != 10) or ((the length of drawing's segments) != 260):
    print "Unexpected DWG entity or segment count" as a line
    return 1
if drawing's unsupported != 0:
    print "Unexpected unsupported entity" as a line
    return 1
if ((drawing's low's x) != -4.0) or ((drawing's high's x) != 10.0):
    print "Unexpected DWG bounds" as a line
    return 1
set malformed to the dwg drawing from the string form of "DYNEDRA-DWG-1 1 2 0\n0 0 0 1 1 1\n"
if malformed's valid:
    print "Truncated wireframe accepted" as a line
    return 1
set invalid to the dwg drawing from the string form of "DYNEDRA-DWG-1 1 1 0\nNaN 0 0 1 1 1\n"
if invalid's valid:
    print "Non-finite wireframe accepted" as a line
    return 1
set window to a new hidden window with width 900 and height 680
set loading to the result of loading a font from "tests/games/fonts/LiberationMono-Regular.ttf" at size 18 for window
if loading failed:
    print "Could not load viewer font" as a line
    close window
    return 1
set typeface to loading's typeface
set frame to a new graphics frame in window with background red 0.9686, green 0.9765, blue 0.9882 and alpha 1.0
if frame's drawable = false:
    print "No drawable graphics frame" as a line
    close window
    return 1
draw dwg drawing drawing with (the initial dwg view) using typeface in frame
display frame
set releasing to the result of releasing (the address of typeface)
close window
free drawing's segments
if releasing failed:
    return 1
print "DWG viewer: decoded, parsed and drew 260 segments" as a line
