        return @intrinsic("construct", a cad key, key's index, key's generation, 0 as a pointer to the type of (the cad edge curve3 of (a cad line3 with origin the cad zero vector3 and direction the cad x axis)))
local function the cad curve key from {cad key:key}:
    execute:
        return @intrinsic("construct", a cad curve key, key's index, key's generation)
function the cad slot of {cad curve key:key}:
    execute:
        return key's index
function {cad curve key:first} = {cad curve key:second}:
    execute:
        return (first's index = second's index) and (first's generation = second's generation)
function {cad curve key:first} != {cad curve key:second}:
    execute:
        return (first = second) = false
function the cad clone of {cad curve key:key}:
    execute:
        return key
function the cad payload clone of {cad curve key:key}:
    execute:
        return key
function the cad debug text of {cad curve key:key}:
    execute:
        return the cad debug text of (the cad arena key of key)
function hash cad key {cad curve key:key} into state:
    execute:
        hash cad key (the cad arena key of key) into state

class:
    patterns:
        [a|] cad vertex
    members:
        point as a cad vector3
        provenance as a cad provenance
class:
    patterns:
        [a|] cad edge
    members:
        curve as a cad curve key
        startParameter as a 64 bit floating-point number
        endParameter as a 64 bit floating-point number
        start as a cad vertex key
        end as a cad vertex key
        coedges as a cad coedge adjacency
        provenance as a cad provenance
class:
    patterns:
        [a|] cad coedge
    members:
        edge as a cad edge key
        forward as a boolean
        pcurve as a cad pcurve result
        owner as a cad loop key
        provenance as a cad provenance
class:
    patterns:
        [a|] cad loop
    members:
        coedges as a cad coedge adjacency
        owner as a cad face key
        provenance as a cad provenance
class:
    patterns:
        [a|] cad face
    members:
        surface as a cad surface key
        forward as a boolean
        loops as a cad face loop adjacency
        owner as a cad shell key
        provenance as a cad provenance
class:
    patterns:
        [a|] cad shell
    members:
        faces as the type of (a cad topology list of a cad face key)
        owner as a cad lump key
        provenance as a cad provenance
class:
    patterns:
        [a|] cad lump
    members:
        shells as the type of (a cad topology list of a cad shell key)
        provenance as a cad provenance

function a cad vertex at {cad vector3:point} with provenance {cad provenance:provenance}:
    execute:
        return @intrinsic("construct", a cad vertex, point, provenance)
function a cad edge on {cad curve key:curve} from {a number:first} to {a number:last} between {cad vertex key:start} and {cad vertex key:end} with provenance {cad provenance:provenance}:
    execute:
        return @intrinsic("construct", a cad edge, curve, first as a 64 bit floating-point number, last as a 64 bit floating-point number, start, end, a fresh cad coedge adjacency, provenance)
function a cad coedge on {cad edge key:edge} forward {boolean:forward} with pcurve {cad pcurve result:pcurve} owned by {cad loop key:owner} with provenance {cad provenance:provenance}:
    execute:
        return @intrinsic("construct", a cad coedge, edge, forward, pcurve, owner, provenance)
function a cad loop owned by {cad face key:owner} with provenance {cad provenance:provenance}:
    execute:
        return @intrinsic("construct", a cad loop, a fresh cad coedge adjacency, owner, provenance)
function a cad face on {cad surface key:surface} forward {boolean:forward} owned by {cad shell key:owner} with provenance {cad provenance:provenance}:
    execute:
        return @intrinsic("construct", a cad face, surface, forward, a fresh cad face loop adjacency, owner, provenance)
function a cad shell owned by {cad lump key:owner} with provenance {cad provenance:provenance}:
    execute:
        return @intrinsic("construct", a cad shell, a cad topology list of a cad face key, owner, provenance)
function a cad lump with provenance {cad provenance:provenance}:
    execute:
        return @intrinsic("construct", a cad lump, a cad topology list of a cad shell key, provenance)

function the cad payload clone of {cad vertex:original}:
    execute:
        return original
function the cad payload clone of {cad edge:original}:
    execute:
        set result to original
        set result's coedges to the cad clone of original's coedges
        return result
function the cad payload clone of {cad coedge:original}:
    execute:
        set result to original
        set result's pcurve to the cad clone of original's pcurve
        return result

function the cad payload clone of {cad loop:original}:
    execute:
        set result to original
        set result's coedges to the cad clone of original's coedges
        return result

function the cad payload clone of {cad face:original}:
    execute:
        set result to original
        set result's loops to the cad clone of original's loops
        return result

function the cad payload clone of {cad shell:original}:
    execute:
        set result to original
        set result's faces to the cad clone of original's faces
        return result

function the cad payload clone of {cad lump:original}:
    execute:
        set result to original
        set result's shells to the cad clone of original's shells
        return result

function the cad payload clone of {cad surface:original}:
    execute:
        return the cad clone of original

function the cad payload clone of {cad edge curve3:original}:
    execute:
        return the cad clone of original

# Source-derived node equality compares every field in declaration order.
function {cad vertex:first} = {cad vertex:second}:
    execute:
        if (((first's point's x = second's point's x) and (first's point's y = second's point's y)) and (first's point's z = second's point's z)) = false:
            return false
        if (first's provenance = second's provenance) = false:
            return false
        return true
function the cad clone of {cad vertex:original}:
    execute:
        return the cad payload clone of original

function {cad edge:first} = {cad edge:second}:
    execute:
        if (first's curve = second's curve) = false:
            return false
        if (first's startParameter = second's startParameter) = false:
            return false
        if (first's endParameter = second's endParameter) = false:
            return false
        if (first's start = second's start) = false:
            return false
        if (first's end = second's end) = false:
            return false
        if (cad coedge adjacencies first's coedges and second's coedges are equal) = false:
            return false
        if (first's provenance = second's provenance) = false:
            return false
        return true
function the cad clone of {cad edge:original}:
    execute:
        return the cad payload clone of original

function {cad coedge:first} = {cad coedge:second}:
    execute:
        if (first's edge = second's edge) = false:
            return false
        if (first's forward = second's forward) = false:
            return false
        if (first's pcurve = second's pcurve) = false:
            return false
        if (first's owner = second's owner) = false:
            return false
        if (first's provenance = second's provenance) = false:
            return false
        return true
function the cad clone of {cad coedge:original}:
    execute:
        return the cad payload clone of original

function {cad loop:first} = {cad loop:second}:
