        set empty to @intrinsic("construct", a cad face loop adjacency values, 0 as a pointer to a cad loop key, 0, 4)
        set initial to @intrinsic("construct", a cad face loop adjacency allocation, empty, 0, a new (a cad loop key array of 4 items))
