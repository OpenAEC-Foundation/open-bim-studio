    patterns:
        [a|] cad coedge vertices result
    members:
        valid as a boolean
        start as a cad vertex key
        end as a cad vertex key
class:
    patterns:
        [a|] cad edge endpoints result
    members:
        valid as a boolean
        start as a cad vector3
        end as a cad vector3

function the cad partner of {cad coedge key:key} in {cad body:body}:
    execute:
        set absent to @intrinsic("construct", a cad partner result, false, a new cad coedge key)
        set use to the cad lookup of key in body
        if use's valid = false:
            return absent
        set node to the cad value of use
        set found to the cad lookup of node's edge in body
        if found's valid = false:
            return absent
        set edge to the cad value of found
        set uses to edge's coedges's values
        if (the length of uses) = 2:
            set first to the item at 0 in uses
            set second to the item at 1 in uses
            if first = key:
                return @intrinsic("construct", a cad partner result, true, second)
            if second = key:
                return @intrinsic("construct", a cad partner result, true, first)
        return absent

function the cad coedge vertices of {cad coedge key:key} in {cad body:body}:
    execute:
        set absent to @intrinsic("construct", a cad coedge vertices result, false, a new cad vertex key, a new cad vertex key)
        set node to the cad node pointer for key in body
        if node = (0 as a pointer to a cad coedge):
            return absent
        set edge to the cad node pointer for node's edge in body
        if edge = (0 as a pointer to a cad edge):
            return absent
        if node's forward:
            return @intrinsic("construct", a cad coedge vertices result, true, edge's start, edge's end)
        return @intrinsic("construct", a cad coedge vertices result, true, edge's end, edge's start)

function the cad [face] coedges of {cad face key:key} in {cad body:body}:
    execute:
        set result to an empty list of a cad coedge key
        set found to the cad lookup of key in body
        if found's valid:
            set face to the cad value of found
            loop index from 0 to the length of face's loops's values:
                set loopKey to the item at index in face's loops's values
                set ring to the cad lookup of loopKey in body
                if ring's valid:
                    set uses to (the cad value of ring)'s coedges's values
                    loop cursor from 0 to the length of uses:
                        append (the item at cursor in uses) to result
        return result

function the cad [edge] endpoints of {cad edge key:key} in {cad body:body}:
    execute:
        set absent to @intrinsic("construct", a cad edge endpoints result, false, the cad zero vector3, the cad zero vector3)
        set found to the cad lookup of key in body
        if found's valid = false:
            return absent
        set edge to the cad value of found
        set shape to the cad lookup of edge's curve in body
        if shape's valid = false:
            return absent
        set curve to the cad value of shape
        return @intrinsic("construct", a cad edge endpoints result, true, the cad point on curve at edge's startParameter, the cad point on curve at edge's endParameter)

function soil cad edge {cad edge key:key} in {cad body:body}:
    execute:
        set found to the cad lookup of key in body
        if found's valid:
            set node to found's value
            soil cad provenance node's provenance
            set uses to the cad clone of node's coedges
            loop index from 0 to the length of uses's values:
                set use to the cad lookup of (the item at index in uses's values) in body
                if use's valid:
                    set coedge to use's value
                    soil cad provenance coedge's provenance
                    set owner to the cad lookup of coedge's owner in body
                    if owner's valid:
                        set ring to owner's value
                        soil cad provenance ring's provenance
                        set face to the cad lookup of ring's owner in body
                        if face's valid:
                            soil cad provenance face's value's provenance

function soil cad vertex {cad vertex key:key} in {cad body:body}:
    execute:
        set found to the cad lookup of key in body
        if found's valid:
            soil cad provenance found's value's provenance
        set touched to an empty list of a cad edge key
        set keys to the cad edge keys of body
        loop index from 0 to the length of keys:
            set edgeKey to the item at index in keys
            set edge to the cad value of (the cad lookup of edgeKey in body)
            if (edge's start = key) or (edge's end = key):
                append edgeKey to touched
        free keys
        loop index from 0 to the length of touched:
            soil cad edge (the item at index in touched) in body
        free touched

function the cad [worst] vertex gap of {cad body:body}:
    execute:
        set worst to 0.0 as a 64 bit floating-point number
        set slots to the slots of body's edges
        loop index from 0 to the length of slots:
            set slot to (the data of slots) + index
            set data to the storage of the payload of slot
            if data != (0 as a pointer to a cad edge):
                set key to @intrinsic("construct", a cad edge key, index as a 32 bit unsigned integer, the generation of slot)
                set endpoints to the cad edge endpoints of key in body
                if endpoints's valid:
                    set edge to @intrinsic("dereference", data)
                    set start to the cad lookup of edge's start in body
                    if start's valid:
                        set distance to the cad distance from endpoints's start to (the cad value of start)'s point
                        if distance > worst:
                            set worst to distance
                    set end to the cad lookup of edge's end in body
                    if end's valid:
                        set distance to the cad distance from endpoints's end to (the cad value of end)'s point
                        if distance > worst:
                            set worst to distance
        return worst

function the cad euler characteristic of {cad body:body}:
    execute:
        return (((the cad count of body's vertices) as a 64 bit integer) - ((the cad count of body's edges) as a 64 bit integer)) + ((the cad count of body's faces) as a 64 bit integer)

class:
    patterns:
        [a|] cad topology flaw
    members:
        kind as an integer
        message as a string
        lump as a cad lump key
        shell as a cad shell key
        face as a cad face key
        ring as a cad loop key
        edge as a cad edge key

function cad dangling key flaw:
    replacement:
        0

function cad broken ownership flaw:
    replacement:
        1

function cad empty lump flaw:
    replacement:
        2

function cad empty shell flaw:
    replacement:
        3

function cad unbounded face flaw:
    replacement:
        4

function cad degenerate loop flaw:
    replacement:
        5

function cad open loop flaw:
    replacement:
        6

function cad unused edge flaw:
    replacement:
        7

function cad nonmanifold edge flaw:
    replacement:
        8

function cad same sided edge flaw:
    replacement:
        9

local function a cad topology flaw with kind {integer:kind} and message {string:message}:
    execute:
        return @intrinsic("construct", a cad topology flaw, kind, message, a new cad lump key, a new cad shell key, a new cad face key, a new cad loop key, a new cad edge key)
local function the cad dangling flaw {string:message}:
    execute:
        return a cad topology flaw with kind cad dangling key flaw and message message
local function the cad ownership flaw {string:message}:
    execute:
        return a cad topology flaw with kind cad broken ownership flaw and message message

local function the cad flaw for {cad lump key:key} of kind {integer:kind}:
    execute:
        set result to a cad topology flaw with kind kind and message ""
        set result's lump to key
        return result

local function the cad flaw for {cad shell key:key} of kind {integer:kind}:
    execute:
        set result to a cad topology flaw with kind kind and message ""
        set result's shell to key
        return result

local function the cad flaw for {cad face key:key} of kind {integer:kind}:
    execute:
        set result to a cad topology flaw with kind kind and message ""
        set result's face to key
        return result

local function the cad flaw for {cad loop key:key} of kind {integer:kind}:
    execute:
        set result to a cad topology flaw with kind kind and message ""
        set result's ring to key
        return result

local function the cad flaw for {cad edge key:key} of kind {integer:kind}:
    execute:
        set result to a cad topology flaw with kind kind and message ""
        set result's edge to key
        return result

function {cad topology flaw:first} = {cad topology flaw:second}:
    execute:
        if first's kind != second's kind:
            return false
        if first's kind < 2:
            return first's message = second's message
        if first's kind = 2:
            return first's lump = second's lump
        if first's kind = 3:
            return first's shell = second's shell
        if first's kind = 4:
            return first's face = second's face
        if first's kind < 7:
            return first's ring = second's ring
        return first's edge = second's edge

local function cad topology surface {cad surface:surface} is closed:
    execute:
        if (surface's kind = 3) or (surface's kind = 4):
            return true
        if surface's kind = 5:
            return surface's nurbs's uClosed and surface's nurbs's vClosed
        return false

local function cad topology surface {cad surface:surface} allows a singular ring:
    execute:
        if surface's kind = 3:
            return true
        if surface's kind = 2:
            set slope to @intrinsic("call", "libc", "tan", a 64 bit floating-point number, surface's cone's halfAngle)
            return (the absolute value of slope) > 1e-15
        if surface's kind = 4:
            set minor to the absolute value of surface's torus's minorRadius
            set major to the absolute value of surface's torus's majorRadius
            return (minor > 2.220446049250313e-16) and (major <= minor)
        return false

local function collect cad [lump] flaws in {cad body:body} into {a pointer to a list:flaws}:
    execute:
        set slots to the slots of body's lumps
        loop index from 0 to the length of slots:
            set slot to (the data of slots) + index
            set data to the storage of the payload of slot
            if data != (0 as a pointer to a cad lump):
                set key to @intrinsic("construct", a cad lump key, index as a 32 bit unsigned integer, the generation of slot)
                set lump to @intrinsic("dereference", data)
                set shells to lump's shells's values
                if (the length of shells) = 0:
                    append (the cad flaw for key of kind cad empty lump flaw) to flaws
                loop cursor from 0 to the length of shells:
                    if (body contains cad key (the item at cursor in shells)) = false:
                        append (the cad dangling flaw "lump names a shell that is gone") to flaws

local function collect cad [shell] flaws in {cad body:body} into {a pointer to a list:flaws}:
    execute:
        set slots to the slots of body's shells
        loop index from 0 to the length of slots:
            set slot to (the data of slots) + index
            set data to the storage of the payload of slot
            if data != (0 as a pointer to a cad shell):
                set key to @intrinsic("construct", a cad shell key, index as a 32 bit unsigned integer, the generation of slot)
                set shell to @intrinsic("dereference", data)
                set faces to shell's faces's values
                if (the length of faces) = 0:
                    append (the cad flaw for key of kind cad empty shell flaw) to flaws
                loop cursor from 0 to the length of faces:
                    set face to the cad lookup of (the item at cursor in faces) in body
                    if face's valid:
                        if (the cad value of face)'s owner != key:
                            append (the cad ownership flaw "a face's shell is not the shell that lists it") to flaws
                    else:
                        append (the cad dangling flaw "shell names a face that is gone") to flaws

local function collect cad [face] flaws in {cad body:body} into {a pointer to a list:flaws}:
    execute:
        set slots to the slots of body's faces
        loop index from 0 to the length of slots:
            set slot to (the data of slots) + index
            set data to the storage of the payload of slot
            if data != (0 as a pointer to a cad face):
                set key to @intrinsic("construct", a cad face key, index as a 32 bit unsigned integer, the generation of slot)
                set face to @intrinsic("dereference", data)
                set surface to the cad lookup of face's surface in body
                set closed to false
                if surface's valid:
                    set closed to cad topology surface (the cad value of surface) is closed
                else:
                    append (the cad dangling flaw "face names a surface that is gone") to flaws
                set rings to face's loops's values
                if ((the length of rings) = 0) and (closed = false):
                    append (the cad flaw for key of kind cad unbounded face flaw) to flaws
                loop cursor from 0 to the length of rings:
                    set ring to the cad lookup of (the item at cursor in rings) in body
                    if ring's valid:
                        if (the cad value of ring)'s owner != key:
                            append (the cad ownership flaw "a loop's face is not the face that lists it") to flaws
                    else:
                        append (the cad dangling flaw "face names a loop that is gone") to flaws

local function collect cad [loop] flaws in {cad body:body} into {a pointer to a list:flaws}:
    execute:
        set slots to the slots of body's loops
        loop index from 0 to the length of slots:
            set slot to (the data of slots) + index
            set data to the storage of the payload of slot
            if data != (0 as a pointer to a cad loop):
                set key to @intrinsic("construct", a cad loop key, index as a 32 bit unsigned integer, the generation of slot)
                set ring to @intrinsic("dereference", data)
                set uses to ring's coedges's values
                set count to the length of uses
                set closedAlone to false
                if count = 1:
                    set use to the cad lookup of (the item at 0 in uses) in body
                    if use's valid:
                        set edge to the cad lookup of (the cad value of use)'s edge in body
                        if edge's valid:
                            set node to the cad value of edge
                            set closedAlone to node's start = node's end
                set singular to false
                if count = 0:
                    set face to the cad lookup of ring's owner in body
                    if face's valid:
                        set surface to the cad lookup of (the cad value of face)'s surface in body
                        if surface's valid:
                            set singular to cad topology surface (the cad value of surface) allows a singular ring
                if (singular = false) and ((count = 0) or ((count < 2) and (closedAlone = false))):
                    append (the cad flaw for key of kind cad degenerate loop flaw) to flaws
                else:
                    loop cursor from 0 to count:
                        set use to the cad lookup of (the item at cursor in uses) in body
                        if use's valid:
                            if (the cad value of use)'s owner != key:
                                append (the cad ownership flaw "a coedge's loop is not the loop that lists it") to flaws
                        else:
                            append (the cad dangling flaw "loop names a coedge that is gone") to flaws
                    set open to false
                    loop cursor from 0 to count:
                        if open = false:
                            set here to the cad coedge vertices of (the item at cursor in uses) in body
                            set nextIndex to the remainder of (cursor + 1) divided by count
                            set next to the cad coedge vertices of (the item at nextIndex in uses) in body
                            if here's valid and next's valid:
                                if here's end != next's start:
                                    append (the cad flaw for key of kind cad open loop flaw) to flaws
                                    set open to true

local function collect cad [edge] flaws in {cad body:body} into {a pointer to a list:flaws}:
    execute:
        if (the cad count of body's edges) = 0:
            return nothing
        # Reuse scratch storage across edges; cache resolved nodes once so seam,
        # ownership, and orientation checks do not repeat arena lookups.
        set seam to an empty list of a boolean
        set resolved to an empty list of a pointer to a cad coedge
        set slots to the slots of body's edges
        loop index from 0 to the length of slots:
            set slot to (the data of slots) + index
            set data to the storage of the payload of slot
            if data != (0 as a pointer to a cad edge):
                clear seam
                clear resolved
                set key to @intrinsic("construct", a cad edge key, index as a 32 bit unsigned integer, the generation of slot)
                set edge to @intrinsic("dereference", data)
                if (body contains cad key edge's curve) = false:
                    append (the cad dangling flaw "edge names a curve that is gone") to flaws
                if ((body contains cad key edge's start) = false) or ((body contains cad key edge's end) = false):
                    append (the cad dangling flaw "edge names a vertex that is gone") to flaws
                set uses to edge's coedges's values
                set count to the length of uses
                loop cursor from 0 to count:
                    append false to seam
                    append (the cad node pointer for (the item at cursor in uses) in body) to resolved
                loop firstIndex from 0 to count:
                    if (the item at firstIndex in seam) = false:
                        set first to the item at firstIndex in resolved
                        if first != (0 as the type of first):
                            set matched to false
                            loop secondIndex from (firstIndex + 1) to count:
                                if (matched = false) and ((the item at secondIndex in seam) = false):
                                    set second to the item at secondIndex in resolved
                                    if second != (0 as the type of second):
                                        if (first's owner = second's owner) and (first's forward != second's forward):
                                            replace item at index firstIndex in seam with true
                                            replace item at index secondIndex in seam with true
                                            set matched to true
                set usedCount to 0
                set firstEffective to (0 as a pointer to a cad coedge)
                set secondEffective to (0 as a pointer to a cad coedge)
                loop cursor from 0 to count:
                    if (the item at cursor in seam) = false:
                        increment usedCount
                        if usedCount = 1:
                            set firstEffective to (the item at cursor in resolved)
                        else if usedCount = 2:
                            set secondEffective to (the item at cursor in resolved)
                if (usedCount = 0) and (count = 0):
                    append (the cad flaw for key of kind cad unused edge flaw) to flaws
                if usedCount > 2:
                    append (the cad flaw for key of kind cad nonmanifold edge flaw) to flaws
                loop cursor from 0 to count:
                    set use to (the item at cursor in resolved)
                    if use != (0 as the type of use):
                        if use's edge != key:
                            append (the cad ownership flaw "a coedge's edge is not the edge that lists it") to flaws
                    else:
                        append (the cad dangling flaw "edge names a coedge that is gone") to flaws
                if usedCount = 2:
                    if firstEffective != (0 as the type of firstEffective):
                        if secondEffective != (0 as the type of secondEffective):
                            if firstEffective's forward = secondEffective's forward:
                                append (the cad flaw for key of kind cad same sided edge flaw) to flaws
        free resolved
        free seam

function the cad flaws of {cad body:body}:
    execute:
        set result to an empty list of a cad topology flaw
        collect cad lump flaws in body into result
        collect cad shell flaws in body into result
        collect cad face flaws in body into result
        collect cad loop flaws in body into result
        collect cad edge flaws in body into result
        return result
