# One allocation owns the body counter and nine typed arena headers.
# Its first field is the counter, so references is also the allocation base.
class:
    patterns:
        [a|] cad body owner allocation
    members:
        references as an integer
        vertices
        edges
        coedges
        loops
        faces
        shells
        lumps
        surfaces
        curves
        roots as a list

# Body storage owns the one owner block and its embedded root-list header.
class:
    patterns:
        [a|] cad body storage
    members:
        vertices
        edges
        coedges
        loops
        faces
        shells
        lumps
        surfaces
        curves
        roots
        references as a pointer to an integer
    retain:
        set owner to the references of @intrinsic("lifecycle value")
        if owner != (0 as a pointer to an integer):
            set count to @intrinsic("dereference", owner)
            if count = 2147483647:
                @intrinsic("call", "libc", "abort", nothing)
            @intrinsic("store at", owner, count + 1)
    release:
        set owner to the references of @intrinsic("lifecycle value")
        if owner != (0 as a pointer to an integer):
            set count to @intrinsic("dereference", owner)
            if count = 1:
                release cad arena contents of (the vertices of @intrinsic("lifecycle value"))
                release cad arena contents of (the edges of @intrinsic("lifecycle value"))
                release cad arena contents of (the coedges of @intrinsic("lifecycle value"))
                release cad arena contents of (the loops of @intrinsic("lifecycle value"))
                release cad arena contents of (the faces of @intrinsic("lifecycle value"))
                release cad arena contents of (the shells of @intrinsic("lifecycle value"))
                release cad arena contents of (the lumps of @intrinsic("lifecycle value"))
                release cad arena contents of (the surfaces of @intrinsic("lifecycle value"))
                release cad arena contents of (the curves of @intrinsic("lifecycle value"))
                set roots to the roots of @intrinsic("lifecycle value")
                clear roots
                @intrinsic("call", "libc", "free", nothing, the data of roots)
                @intrinsic("call", "libc", "free", nothing, owner)
            else:
                @intrinsic("store at", owner, count - 1)

class:
    patterns:
        [a|] cad body
    members:
        vertices
        edges
        coedges
        loops
        faces
        shells
        lumps
        surfaces
        curves
        roots
        provenance as a cad provenance
        storage as a cad body storage

local function the cad body using {cad body storage:storage} with provenance {cad provenance:provenance}:
    execute:
        return @intrinsic("construct", a cad body, storage's vertices, storage's edges, storage's coedges, storage's loops, storage's faces, storage's shells, storage's lumps, storage's surfaces, storage's curves, storage's roots, provenance, storage)
local function the cad fresh body owner allocation:
    execute:
        set initial to @intrinsic("construct", a cad body owner allocation, 0,
            an empty cad arena header of a cad vertex,
            an empty cad arena header of a cad edge,
            an empty cad arena header of a cad coedge,
            an empty cad arena header of a cad loop,
            an empty cad arena header of a cad face,
            an empty cad arena header of a cad shell,
            an empty cad arena header of a cad lump,
            an empty cad arena header of the type of (the cad surface of the cad xy plane),
            an empty cad arena header of the type of (the cad edge curve3 of (a cad line3 with origin the cad zero vector3 and direction the cad x axis)),
            @intrinsic("construct", a list, 0 as a pointer to a cad lump key, 0, 0))
        set bodyBlock to the checked allocation from (0 as a pointer) resized to 1 items of the type of initial
        @intrinsic("initialize at", bodyBlock, initial)
        initialize cad arena header at (the address of (bodyBlock's vertices))
        initialize cad arena header at (the address of (bodyBlock's edges))
        initialize cad arena header at (the address of (bodyBlock's coedges))
        initialize cad arena header at (the address of (bodyBlock's loops))
        initialize cad arena header at (the address of (bodyBlock's faces))
        initialize cad arena header at (the address of (bodyBlock's shells))
        initialize cad arena header at (the address of (bodyBlock's lumps))
        initialize cad arena header at (the address of (bodyBlock's surfaces))
        initialize cad arena header at (the address of (bodyBlock's curves))
        return bodyBlock

local function the cad body storage for {a pointer to a cad body owner allocation:owner}:
    execute:
        return @intrinsic("construct", a cad body storage,
            the cad arena in (the address of (owner's vertices)),
            the cad arena in (the address of (owner's edges)),
            the cad arena in (the address of (owner's coedges)),
            the cad arena in (the address of (owner's loops)),
            the cad arena in (the address of (owner's faces)),
            the cad arena in (the address of (owner's shells)),
            the cad arena in (the address of (owner's lumps)),
            the cad arena in (the address of (owner's surfaces)),
            the cad arena in (the address of (owner's curves)),
            the address of (owner's roots), the address of (owner's references))

function an empty cad body:
    execute:
        set owner to the cad fresh body owner allocation
        set storage to the cad body storage for owner
        return the cad body using storage with provenance the synthesized cad provenance
function the cad default body:
    execute:
        return an empty cad body
function the cad clone of {cad body:original}:
    execute:
        set owner to the cad fresh body owner allocation
        clone cad arena (original's vertices) into (the cad arena in (the address of (owner's vertices)))
        clone cad arena (original's edges) into (the cad arena in (the address of (owner's edges)))
        clone cad arena (original's coedges) into (the cad arena in (the address of (owner's coedges)))
        clone cad arena (original's loops) into (the cad arena in (the address of (owner's loops)))
        clone cad arena (original's faces) into (the cad arena in (the address of (owner's faces)))
        clone cad arena (original's shells) into (the cad arena in (the address of (owner's shells)))
        clone cad arena (original's lumps) into (the cad arena in (the address of (owner's lumps)))
        clone cad arena (original's surfaces) into (the cad arena in (the address of (owner's surfaces)))
        clone cad arena (original's curves) into (the cad arena in (the address of (owner's curves)))
        set storage to the cad body storage for owner
        loop index from 0 to the length of original's roots:
            append (the item at index in original's roots) to (storage's roots)
        return the cad body using storage with provenance original's provenance

# Moves the complete topology and geometry of each body into the other, as
# assigning one Rust body over another does. Provenance belongs to each body
# value and is not exchanged.
function exchange cad body contents of {cad body:body} and {cad body:other}:
    execute:
        exchange cad arena contents of body's vertices and other's vertices
        exchange cad arena contents of body's edges and other's edges
        exchange cad arena contents of body's coedges and other's coedges
        exchange cad arena contents of body's loops and other's loops
        exchange cad arena contents of body's faces and other's faces
        exchange cad arena contents of body's shells and other's shells
        exchange cad arena contents of body's lumps and other's lumps
        exchange cad arena contents of body's surfaces and other's surfaces
        exchange cad arena contents of body's curves and other's curves
        set rootHeader to @intrinsic("dereference", body's roots)
        @intrinsic("store at", body's roots, @intrinsic("dereference", other's roots))
        @intrinsic("store at", other's roots, rootHeader)

