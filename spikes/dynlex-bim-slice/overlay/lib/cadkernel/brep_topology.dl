function the cad face [keys] of {cad body:body}:
    execute:
        set result to an empty list of a cad face key
        if (the cad count of body's faces) > 0:
            ensure enough capacity in result for (the cad count of body's faces) items
        set slots to the slots of body's faces
        loop index from 0 to the length of slots:
            set slot to (the data of slots) + index
            if (the storage of the payload of slot) != (0 as a pointer to a cad face):
                append @intrinsic("construct", a cad face key, index as a 32 bit unsigned integer, the generation of slot) to result
        return result

function the cad vertex [keys] of {cad body:body}:
    execute:
        set result to an empty list of a cad vertex key
        set keys to the cad keys of body's vertices
        if (the length of keys) > 0:
            ensure enough capacity in result for (the length of keys) items
        loop index from 0 to the length of keys:
            append (the cad vertex key from (the item at index in keys)) to result
        free keys
        return result

function the cad edge [keys] of {cad body:body}:
    execute:
        set result to an empty list of a cad edge key
        if (the cad count of body's edges) > 0:
            ensure enough capacity in result for (the cad count of body's edges) items
        set slots to the slots of body's edges
        loop index from 0 to the length of slots:
            set slot to (the data of slots) + index
            if (the storage of the payload of slot) != (0 as a pointer to a cad edge):
                append @intrinsic("construct", a cad edge key, index as a 32 bit unsigned integer, the generation of slot) to result
        return result

class:
    patterns:
        [a|] cad partner result
    members:
        valid as a boolean
        value as a cad coedge key
