class:
    patterns:
        [a|] cad coedge adjacency values
    members:
        data as a pointer to a cad coedge key
        length as an integer
        capacity as an integer

class:
    patterns:
        [a|] cad coedge adjacency allocation
    members:
        values as a cad coedge adjacency values
        references as an integer
        firstFour as a cad coedge key array of 4 items

class:
    patterns:
        [a|] cad coedge adjacency
    members:
        values as a pointer to a cad coedge adjacency values
        references as a pointer to an integer
    retain:
        set owner to the references of @intrinsic("lifecycle value")
        if owner != (0 as a pointer to an integer):
            set count to @intrinsic("dereference", owner)
            if count = 2147483647:
                @intrinsic("call", "libc", "abort", nothing)
            @intrinsic("store at", owner, count + 1)
    release:
        set owner to the references of @intrinsic("lifecycle value")
        if owner != (0 as a pointer to an integer):
            set count to @intrinsic("dereference", owner)
            if count = 1:
                # `values` is the first allocation field and therefore its base.
                set block to (the values of @intrinsic("lifecycle value")) as a pointer to a cad coedge adjacency allocation
                set inlineData to (the address of (block's firstFour)) as a pointer to a cad coedge key
                set data to block's values's data
                if data != inlineData:
                    @intrinsic("call", "libc", "free", nothing, data)
                @intrinsic("call", "libc", "free", nothing, block)
            else:
                @intrinsic("store at", owner, count - 1)

function a fresh cad coedge adjacency:
    execute:
        set empty to @intrinsic("construct", a cad coedge adjacency values, 0 as a pointer to a cad coedge key, 0, 4)
        set initial to @intrinsic("construct", a cad coedge adjacency allocation, empty, 0, a new (a cad coedge key array of 4 items))
        set block to the checked allocation from (0 as a pointer) resized to 1 items of the type of initial
        @intrinsic("initialize at", block, initial)
        set block's values's data to (the address of (block's firstFour)) as a pointer to a cad coedge key
        return @intrinsic("construct", a cad coedge adjacency, the address of (block's values), the address of (block's references))

function the length of {a pointer to a cad coedge adjacency values:values}:
    execute:
        return values's length

function {a pointer to a cad coedge adjacency values:values} lacks an item at {integer:position}:
    execute:
        return position < 0 or position >= values's length

function the item at {integer:position} in {a pointer to a cad coedge adjacency values:values}:
    execute:
        if values lacks an item at position:
            stop because a list index is out of bounds
        return the item at position in values's data

function ensure enough capacity in {a pointer to a cad coedge adjacency values:values} for {integer:count} items:
    execute:
        set limit to the collection capacity from values's capacity expanded to hold count items
        if limit > values's capacity:
            # The stable values header is the allocation base; this cast is
            # valid only while values remains the first field of the owner.
            set block to values as a pointer to a cad coedge adjacency allocation
            set inlineData to (the address of (block's firstFour)) as a pointer to a cad coedge key
            set data to values's data
            if data = inlineData:
                set moved to the checked allocation from (0 as a pointer) resized to limit items of a cad coedge key
                loop index from 0 to values's length:
                    @intrinsic("initialize at", moved + index, the item at index in values)
                set data to moved
            else:
                set data to the checked allocation from (data as a pointer) resized to limit items of a cad coedge key
            set values's data to data
            set values's capacity to limit

function append {cad coedge key:item} to {a pointer to a cad coedge adjacency values:values}:
    execute:
        set required to the collection length after adding one item to values's length
        ensure enough capacity in values for required items
        @intrinsic("initialize at", values's data + values's length, item)
        set values's length to required

function insert {cad coedge key:item} into {a pointer to a cad coedge adjacency values:values} at index {integer:position}:
    execute:
        if (position < 0) or (position > values's length):
            stop because a list index is out of bounds
        set required to the collection length after adding one item to values's length
        ensure enough capacity in values for required items
        set cursor to values's length
        if cursor > position:
            @intrinsic("initialize at", values's data + cursor, the item at (cursor - 1) in values)
            set cursor to cursor - 1
            loop while cursor > position:
                @intrinsic("store at", values's data + cursor, the item at (cursor - 1) in values)
                set cursor to cursor - 1
            @intrinsic("store at", values's data + position, item)
        else:
            @intrinsic("initialize at", values's data + position, item)
        set values's length to required

function replace item at index {integer:position} in {a pointer to a cad coedge adjacency values:values} with {cad coedge key:replacement}:
    execute:
        if values lacks an item at position:
            stop because a list index is out of bounds
        @intrinsic("store at", values's data + position, replacement)

function remove item {integer:position} from {a pointer to a cad coedge adjacency values:values}:
    execute:
        if values lacks an item at position:
            stop because a list index is out of bounds
        set cursor to position
        loop while cursor + 1 < values's length:
            @intrinsic("store at", values's data + cursor, the item at (cursor + 1) in values)
            set cursor to cursor + 1
        set values's length to values's length - 1
        # Keys have no managed fields. Only the active prefix is observable.

function clear {a pointer to a cad coedge adjacency values:values}:
    execute:
        set values's length to 0

function the cad clone of {cad coedge adjacency:original}:
    execute:
        set result to a fresh cad coedge adjacency
        ensure enough capacity in (result's values) for (the length of original's values) items
        loop index from 0 to the length of original's values:
            append (the item at index in original's values) to (result's values)
        return result

function cad coedge adjacencies {cad coedge adjacency:first} and {cad coedge adjacency:second} are equal:
    execute:
        if (the length of first's values) != (the length of second's values):
            return false
        loop index from 0 to the length of first's values:
            if (the item at index in first's values) != (the item at index in second's values):
                return false
        return true


