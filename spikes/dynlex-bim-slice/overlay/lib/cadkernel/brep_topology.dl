# SPDX-License-Identifier: MPL-2.0
# Native foundation from src/brep/{mod,topology}.rs at
# 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
# Nominal keys preserve node kinds; adapters retain arena generation semantics.
# Ordinary managed copies share owned lists/arenas. Explicit clone duplicates them.
# Node pointers and list values borrow their owner; removing a node ends its borrow.
import lib/cadkernel/arena.dl
import lib/cadkernel/topology_list.dl
import lib/cadkernel/brep_geometry.dl
import lib/cadkernel/curve2.dl

class:
    patterns:
        [a|] cad source reference
    members:
        index as a 32 bit unsigned integer
class:
    patterns:
        [a|] cad source result
    members:
        valid as a boolean
        value as a cad source reference
class:
    patterns:
        [a|] cad provenance
    members:
        kind as an integer
        reference as a cad source reference

function a cad source reference for {a 32 bit unsigned integer:index}:
    execute:
        return @intrinsic("construct", a cad source reference, index)
function the cad index of {cad source reference:value}:
    execute:
        return value's index
function {cad source reference:first} = {cad source reference:second}:
    execute:
        return first's index = second's index
function hash cad source reference {cad source reference:value} into state:
    execute:
        hash cad unsigned integer value's index into state
function the cad clone of {cad source reference:value}:
    execute:
        return value
function the clean cad provenance of {cad source reference:reference}:
    execute:
        return @intrinsic("construct", a cad provenance, 1, reference)
function the dirty cad provenance of {cad source reference:reference}:
    execute:
        return @intrinsic("construct", a cad provenance, 2, reference)
function the synthesized cad provenance:
    execute:
        return @intrinsic("construct", a cad provenance, 0, a new cad source reference)
function the cad source of {cad provenance:value}:
    execute:
        return @intrinsic("construct", a cad source result, value's kind != 0, value's reference)
function cad {cad provenance:value} is reusable:
    execute:
        return value's kind = 1
function soil cad provenance {cad provenance:value}:
    execute:
        if value's kind = 1:
            set value's kind to 2
function {cad provenance:first} = {cad provenance:second}:
    execute:
        if first's kind != second's kind:
            return false
        return (first's kind = 0) or (first's reference = second's reference)
function the cad clone of {cad provenance:value}:
    execute:
        return value

local function cad topology lists {cad topology list:first} and {cad topology list:second} are equal:
    execute:
        if (the length of first's values) != (the length of second's values):
            return false
        loop index from 0 to the length of first's values:
            if ((the item at index in first's values) = (the item at index in second's values)) = false:
                return false
        return true

class:
    patterns:
        [a|] cad pcurve allocation
    members:
        references as an integer
        curve as the type of (the cad curve2 of (a cad line2 from the cad zero vector2 to the cad zero vector2))
class:
    patterns:
        [a|] cad pcurve result
    members:
        valid as a boolean
        allocation as a pointer to a cad pcurve allocation
    retain:
        set owner to the allocation of @intrinsic("lifecycle value")
        if owner != (0 as a pointer to a cad pcurve allocation):
            set count to owner's references
            if count = 2147483647:
                @intrinsic("call", "libc", "abort", nothing)
            set owner's references to count + 1
    release:
        set owner to the allocation of @intrinsic("lifecycle value")
        if owner != (0 as a pointer to a cad pcurve allocation):
            set count to owner's references
            if count = 1:
                @intrinsic("destroy at", the address of (owner's curve))
                @intrinsic("call", "libc", "free", nothing, owner)
            else:
                set owner's references to count - 1
function no cad pcurve:
    execute:
        return @intrinsic("construct", a cad pcurve result, false, 0 as a pointer to a cad pcurve allocation)
function the cad pcurve of {cad curve2:value}:
    execute:
        set initial to @intrinsic("construct", a cad pcurve allocation, 0, value)
        set allocation to the checked allocation from (0 as a pointer) resized to 1 items of the type of initial
        @intrinsic("initialize at", allocation, initial)
        return @intrinsic("construct", a cad pcurve result, true, allocation)
function the cad pcurve value of {cad pcurve result:source}:
    execute:
        if source's valid = false:
            return a new (the type of (the cad curve2 of (a cad line2 from the cad zero vector2 to the cad zero vector2)))
        return source's allocation's curve
function the cad clone of {cad pcurve result:original}:
    execute:
        if original's valid:
            return the cad pcurve of (the cad clone of (the cad pcurve value of original))
        return no cad pcurve
function {cad pcurve result:first} = {cad pcurve result:second}:
    execute:
        if first's valid != second's valid:
            return false
        return (first's valid = false) or ((the cad pcurve value of first) = (the cad pcurve value of second))

# Nominal key records make every adjacency field statically kind-specific.

class:
    patterns:
        [a|] cad vertex key
    members:
        index as a 32 bit unsigned integer
        generation as a 32 bit unsigned integer

local function the cad arena key of {cad vertex key:key}:
    execute:
        return @intrinsic("construct", a cad key, key's index, key's generation, 0 as a pointer to a cad vertex)
local function the cad vertex key from {cad key:key}:
    execute:
        return @intrinsic("construct", a cad vertex key, key's index, key's generation)
function the cad slot of {cad vertex key:key}:
    execute:
        return key's index
function {cad vertex key:first} = {cad vertex key:second}:
    execute:
        return (first's index = second's index) and (first's generation = second's generation)
function {cad vertex key:first} != {cad vertex key:second}:
    execute:
        return (first = second) = false
function the cad clone of {cad vertex key:key}:
    execute:
        return key
function the cad payload clone of {cad vertex key:key}:
    execute:
        return key
function the cad debug text of {cad vertex key:key}:
    execute:
        return the cad debug text of (the cad arena key of key)
function hash cad key {cad vertex key:key} into state:
    execute:
        hash cad key (the cad arena key of key) into state

