# SPDX-License-Identifier: MPL-2.0
# Port of the planar predicates of the `robust` crate 1.2.0 (Shewchuk's
# adaptive-precision orient2d and incircle), as called by spade 2.15.1.
# Every operation keeps the crate's binary64 evaluation order. Expansions are
# owned lists ordered from the smallest to the largest component.
import lib/cadkernel/core.dl
import lib/list.dl

class:
    patterns:
        [a|] cad robust pair
    members:
        high as a 64 bit floating-point number
        low as a 64 bit floating-point number

class:
    patterns:
        [a|] cad robust triple
    members:
        x2 as a 64 bit floating-point number
        x1 as a 64 bit floating-point number
        x0 as a 64 bit floating-point number

class:
    patterns:
        [a|] cad robust quad
    members:
        x3 as a 64 bit floating-point number
        x2 as a 64 bit floating-point number
        x1 as a 64 bit floating-point number
        x0 as a 64 bit floating-point number

local function the cad robust epsilon:
    execute:
        return 0.00000000000000011102230246251565

local function the cad robust final error bound:
    execute:
        set epsilonValue to the cad robust epsilon
        return (3.0 + (8.0 * epsilonValue)) * epsilonValue

local function the cad robust counterclockwise error bound b:
    execute:
        set epsilonValue to the cad robust epsilon
        return (2.0 + (12.0 * epsilonValue)) * epsilonValue

local function the cad robust counterclockwise error bound c:
    execute:
        set epsilonValue to the cad robust epsilon
        return ((9.0 + (64.0 * epsilonValue)) * epsilonValue) * epsilonValue

local function the cad robust incircle error bound a:
    execute:
        set epsilonValue to the cad robust epsilon
        return (10.0 + (96.0 * epsilonValue)) * epsilonValue

local function the cad robust incircle error bound b:
    execute:
        set epsilonValue to the cad robust epsilon
        return (4.0 + (48.0 * epsilonValue)) * epsilonValue

local function the cad robust incircle error bound c:
    execute:
        set epsilonValue to the cad robust epsilon
        return ((44.0 + (576.0 * epsilonValue)) * epsilonValue) * epsilonValue

local function the cad robust split of {a 64 bit floating-point number:value}:
    execute:
        set scaledValue to 134217729.0 * value
        set big to scaledValue - value
        set highPart to scaledValue - big
        return @intrinsic("construct", a cad robust pair, highPart, value - highPart)

local function the cad robust two product of {a 64 bit floating-point number:left} and {a 64 bit floating-point number:right}:
    execute:
        set productValue to left * right
        set leftParts to the cad robust split of left
        set rightParts to the cad robust split of right
        set error1 to productValue - ((the high of leftParts) * (the high of rightParts))
        set error2 to error1 - ((the low of leftParts) * (the high of rightParts))
        set error3 to error2 - ((the high of leftParts) * (the low of rightParts))
        return @intrinsic("construct", a cad robust pair, productValue, ((the low of leftParts) * (the low of rightParts)) - error3)

local function the cad robust two product of {a 64 bit floating-point number:left} and {a 64 bit floating-point number:right} split as {cad robust pair:rightParts}:
    execute:
        set productValue to left * right
        set leftParts to the cad robust split of left
        set error1 to productValue - ((the high of leftParts) * (the high of rightParts))
        set error2 to error1 - ((the low of leftParts) * (the high of rightParts))
        set error3 to error2 - ((the high of leftParts) * (the low of rightParts))
        return @intrinsic("construct", a cad robust pair, productValue, ((the low of leftParts) * (the low of rightParts)) - error3)

local function the cad robust square of {a 64 bit floating-point number:value}:
    execute:
        set productValue to value * value
        set parts to the cad robust split of value
        set error1 to productValue - ((the high of parts) * (the high of parts))
        set error3 to error1 - (((the high of parts) + (the high of parts)) * (the low of parts))
        return @intrinsic("construct", a cad robust pair, productValue, ((the low of parts) * (the low of parts)) - error3)

local function the cad robust difference tail of {a 64 bit floating-point number:left} minus {a 64 bit floating-point number:right} rounded to {a 64 bit floating-point number:roundedValue}:
    execute:
        set rightVirtual to left - roundedValue
        set leftVirtual to roundedValue + rightVirtual
        set rightRound to rightVirtual - right
        set leftRound to left - leftVirtual
        return leftRound + rightRound

local function the cad robust two difference of {a 64 bit floating-point number:left} and {a 64 bit floating-point number:right}:
    execute:
        set roundedValue to left - right
        return @intrinsic("construct", a cad robust pair, roundedValue, the cad robust difference tail of left minus right rounded to roundedValue)

local function the cad robust two sum of {a 64 bit floating-point number:left} and {a 64 bit floating-point number:right}:
    execute:
        set roundedValue to left + right
        set rightVirtual to roundedValue - left
        set leftVirtual to roundedValue - rightVirtual
        set rightRound to right - rightVirtual
        set leftRound to left - leftVirtual
        return @intrinsic("construct", a cad robust pair, roundedValue, leftRound + rightRound)

local function the cad robust fast two sum of {a 64 bit floating-point number:left} and {a 64 bit floating-point number:right}:
    execute:
        set roundedValue to left + right
        set rightVirtual to roundedValue - left
        return @intrinsic("construct", a cad robust pair, roundedValue, right - rightVirtual)

local function the cad robust two one difference of {a 64 bit floating-point number:highPart} {a 64 bit floating-point number:lowPart} minus {a 64 bit floating-point number:value}:
    execute:
        set firstPart to the cad robust two difference of lowPart and value
        set secondPart to the cad robust two sum of highPart and (the high of firstPart)
        return @intrinsic("construct", a cad robust triple, the high of secondPart, the low of secondPart, the low of firstPart)

local function the cad robust two two difference of {a 64 bit floating-point number:leftHigh} {a 64 bit floating-point number:leftLow} minus {a 64 bit floating-point number:rightHigh} {a 64 bit floating-point number:rightLow}:
    execute:
        set firstPart to the cad robust two one difference of leftHigh leftLow minus rightLow
        set secondPart to the cad robust two one difference of (the x2 of firstPart) (the x1 of firstPart) minus rightHigh
        return @intrinsic("construct", a cad robust quad, the x2 of secondPart, the x1 of secondPart, the x0 of secondPart, the x0 of firstPart)

local function the cad robust two one sum of {a 64 bit floating-point number:highPart} {a 64 bit floating-point number:lowPart} plus {a 64 bit floating-point number:value}:
    execute:
        set firstPart to the cad robust two sum of lowPart and value
        set secondPart to the cad robust two sum of highPart and (the high of firstPart)
        return @intrinsic("construct", a cad robust triple, the high of secondPart, the low of secondPart, the low of firstPart)

local function the cad robust two two sum of {a 64 bit floating-point number:leftHigh} {a 64 bit floating-point number:leftLow} plus {a 64 bit floating-point number:rightHigh} {a 64 bit floating-point number:rightLow}:
    execute:
        set firstPart to the cad robust two one sum of leftHigh leftLow plus rightLow
        set secondPart to the cad robust two one sum of (the x2 of firstPart) (the x1 of firstPart) plus rightHigh
        return @intrinsic("construct", a cad robust quad, the x2 of secondPart, the x1 of secondPart, the x0 of secondPart, the x0 of firstPart)

local function the cad robust expansion of {cad robust quad:value}:
    execute:
        set result to an empty list of a 64 bit floating-point number
        append (the x0 of value) to result
        append (the x1 of value) to result
        append (the x2 of value) to result
        append (the x3 of value) to result
        return result

local function the cad robust single expansion of {a 64 bit floating-point number:value}:
    execute:
        set result to an empty list of a 64 bit floating-point number
        append value to result
        return result

local function the cad robust difference expansion of products {cad robust pair:left} and {cad robust pair:right}:
    execute:
        return the cad robust expansion of (the cad robust two two difference of (the high of left) (the low of left) minus (the high of right) (the low of right))

local function the cad robust sum expansion of products {cad robust pair:left} and {cad robust pair:right}:
    execute:
        return the cad robust expansion of (the cad robust two two sum of (the high of left) (the low of left) plus (the high of right) (the low of right))

local function the cad robust estimate of {a pointer to a list:sourceExpansion}:
    execute:
        set total to the item at 0 in sourceExpansion
        loop index from 1 to the length of sourceExpansion:
            set total to total + (the item at index in sourceExpansion)
        return total

local function the cad robust scaled expansion of {a pointer to a list:sourceExpansion} by {a 64 bit floating-point number:factor}:
    execute:
        set result to an empty list of a 64 bit floating-point number
        set factorParts to the cad robust split of factor
        set firstPart to the cad robust two product of (the item at 0 in sourceExpansion) and factor split as factorParts
        set accumulated to the high of firstPart
        if (the low of firstPart) != 0.0:
            append (the low of firstPart) to result
        loop index from 1 to the length of sourceExpansion:
            set productValue to the cad robust two product of (the item at index in sourceExpansion) and factor split as factorParts
            set summed to the cad robust two sum of accumulated and (the low of productValue)
            if (the low of summed) != 0.0:
                append (the low of summed) to result
            set fastPart to the cad robust fast two sum of (the high of productValue) and (the high of summed)
            set accumulated to the high of fastPart
            if (the low of fastPart) != 0.0:
                append (the low of fastPart) to result
        if (accumulated != 0.0) or ((the length of result) = 0):
            append accumulated to result
        return result

# (fnow > enow) == (fnow > -enow) selects the component of smaller magnitude.
local function cad robust takes {a 64 bit floating-point number:left} before {a 64 bit floating-point number:right}:
    execute:
        return (right > left) = (right > (-left))

local function the cad robust sum of expansion {a pointer to a list:left} and {a pointer to a list:right}:
    execute:
        set result to an empty list of a 64 bit floating-point number
        set leftIndex to 0
        set rightIndex to 0
        set accumulated to 0.0
        if cad robust takes (the item at 0 in left) before (the item at 0 in right):
            set accumulated to the item at 0 in left
            set leftIndex to 1
        else:
            set accumulated to the item at 0 in right
            set rightIndex to 1
        if (leftIndex < (the length of left)) and (rightIndex < (the length of right)):
            set leftNow to the item at leftIndex in left
            set rightNow to the item at rightIndex in right
            set firstPart to the cad robust fast two sum of rightNow and accumulated
            if cad robust takes leftNow before rightNow:
                set firstPart to the cad robust fast two sum of leftNow and accumulated
                set leftIndex to leftIndex + 1
            else:
                set rightIndex to rightIndex + 1
            set accumulated to the high of firstPart
            if (the low of firstPart) != 0.0:
                append (the low of firstPart) to result
            loop while (leftIndex < (the length of left)) and (rightIndex < (the length of right)):
                set leftNow to the item at leftIndex in left
                set rightNow to the item at rightIndex in right
                set stepPart to the cad robust two sum of accumulated and rightNow
                if cad robust takes leftNow before rightNow:
                    set stepPart to the cad robust two sum of accumulated and leftNow
                    set leftIndex to leftIndex + 1
                else:
                    set rightIndex to rightIndex + 1
                set accumulated to the high of stepPart
                if (the low of stepPart) != 0.0:
                    append (the low of stepPart) to result
        loop while leftIndex < (the length of left):
            set stepPart to the cad robust two sum of accumulated and (the item at leftIndex in left)
            set accumulated to the high of stepPart
            set leftIndex to leftIndex + 1
            if (the low of stepPart) != 0.0:
                append (the low of stepPart) to result
        loop while rightIndex < (the length of right):
            set stepPart to the cad robust two sum of accumulated and (the item at rightIndex in right)
            set accumulated to the high of stepPart
            set rightIndex to rightIndex + 1
            if (the low of stepPart) != 0.0:
                append (the low of stepPart) to result
        if (accumulated != 0.0) or ((the length of result) = 0):
            append accumulated to result
        return result

# Consumes the owned accumulator expansion and returns its sum with addition.
local function the cad robust accumulation of {a pointer to a list:accumulator} with {a pointer to a list:addition}:
    execute:
        set summed to the cad robust sum of expansion accumulator and addition
        free accumulator
        return summed

local function the cad robust orient2d adaptation of {cad vector2:pa}, {cad vector2:pb}, {cad vector2:pc} with sum {a 64 bit floating-point number:detsum}:
    execute:
        set acx to (the x of pa) - (the x of pc)
        set bcx to (the x of pb) - (the x of pc)
        set acy to (the y of pa) - (the y of pc)
        set bcy to (the y of pb) - (the y of pc)
        set detleft to the cad robust two product of acx and bcy
        set detright to the cad robust two product of acy and bcx
        set bExpansion to the cad robust difference expansion of products detleft and detright
        set det to the cad robust estimate of bExpansion
        set errbound to (the cad robust counterclockwise error bound b) * detsum
        if (det >= errbound) or ((-det) >= errbound):
            free bExpansion
            return det
        set acxtail to the cad robust difference tail of (the x of pa) minus (the x of pc) rounded to acx
        set bcxtail to the cad robust difference tail of (the x of pb) minus (the x of pc) rounded to bcx
        set acytail to the cad robust difference tail of (the y of pa) minus (the y of pc) rounded to acy
        set bcytail to the cad robust difference tail of (the y of pb) minus (the y of pc) rounded to bcy
        if ((acxtail = 0.0) and (acytail = 0.0)) and ((bcxtail = 0.0) and (bcytail = 0.0)):
            free bExpansion
            return det
        set errbound to ((the cad robust counterclockwise error bound c) * detsum) + ((the cad robust final error bound) * (the absolute value of det))
        set det to det + (((acx * bcytail) + (bcy * acxtail)) - ((acy * bcxtail) + (bcx * acytail)))
        if (det >= errbound) or ((-det) >= errbound):
            free bExpansion
            return det
        set uExpansion to the cad robust difference expansion of products (the cad robust two product of acxtail and bcy) and (the cad robust two product of acytail and bcx)
        set c1 to the cad robust sum of expansion bExpansion and uExpansion
        free uExpansion
        set uExpansion to the cad robust difference expansion of products (the cad robust two product of acx and bcytail) and (the cad robust two product of acy and bcxtail)
        set c2 to the cad robust sum of expansion c1 and uExpansion
        free uExpansion
        set uExpansion to the cad robust difference expansion of products (the cad robust two product of acxtail and bcytail) and (the cad robust two product of acytail and bcxtail)
        set dExpansion to the cad robust sum of expansion c2 and uExpansion
        set result to the last item of dExpansion
        free uExpansion
        free dExpansion
        free c2
        free c1
        free bExpansion
        return result

# Positive when pc lies left of the directed line from pa to pb.
function the cad robust orientation of {cad vector2:pa}, {cad vector2:pb} and {cad vector2:pc}:
    execute:
        set detleft to ((the x of pa) - (the x of pc)) * ((the y of pb) - (the y of pc))
        set detright to ((the y of pa) - (the y of pc)) * ((the x of pb) - (the x of pc))
        set det to detleft - detright
        set detsum to the absolute value of (detleft + detright)
        set errbound to 3.3306690621773722e-16 * detsum
        if (det >= errbound) or ((-det) >= errbound):
            return det
        return the cad robust orient2d adaptation of pa, pb, pc with sum detsum

# The determinant contribution of one lifted point, scaled twice by its
# coordinate differences: axbc*adx + aybc*ady in the crate's notation.
local function the cad robust lifted expansion of {a pointer to a list:minorExpansion} by {a 64 bit floating-point number:dx} and {a 64 bit floating-point number:dy}:
    execute:
        set xOnce to the cad robust scaled expansion of minorExpansion by dx
        set xTwice to the cad robust scaled expansion of xOnce by dx
        set yOnce to the cad robust scaled expansion of minorExpansion by dy
        set yTwice to the cad robust scaled expansion of yOnce by dy
        set result to the cad robust sum of expansion xTwice and yTwice
        free xOnce
        free xTwice
        free yOnce
        free yTwice
        return result

# temp16a = tail-scaled minor * 2d, temp16b/temp16c = tail-scaled lifts.
local function the cad robust primary tail expansion of {a pointer to a list:tailMinor} doubled by {a 64 bit floating-point number:doubledFactor}, {a pointer to a list:firstLift} by {a 64 bit floating-point number:tailValue} and {a 64 bit floating-point number:firstFactor}, {a pointer to a list:secondLift} by {a 64 bit floating-point number:secondFactor}:
    execute:
        set temp16a to the cad robust scaled expansion of tailMinor by doubledFactor
        set liftedFirst to the cad robust scaled expansion of firstLift by tailValue
        set temp16b to the cad robust scaled expansion of liftedFirst by firstFactor
        set liftedSecond to the cad robust scaled expansion of secondLift by tailValue
        set temp16c to the cad robust scaled expansion of liftedSecond by secondFactor
        set temp32a to the cad robust sum of expansion temp16a and temp16b
        set temp48 to the cad robust sum of expansion temp16c and temp32a
        free temp16a
        free liftedFirst
        free temp16b
        free liftedSecond
        free temp16c
        free temp32a
        return temp48

local function the cad robust lift of {a 64 bit floating-point number:dx} and {a 64 bit floating-point number:dy} when {boolean:needed}:
    execute:
        if needed:
            return the cad robust sum expansion of products (the cad robust square of dx) and (the cad robust square of dy)
        set result to an empty list of a 64 bit floating-point number
        loop index from 0 to 4:
            append 0.0 to result
        return result

local function the cad robust cross tail of {a 64 bit floating-point number:firstTail} {a 64 bit floating-point number:firstValue} {a 64 bit floating-point number:secondValue} {a 64 bit floating-point number:secondTail} {a 64 bit floating-point number:thirdTail} {a 64 bit floating-point number:thirdValue} {a 64 bit floating-point number:fourthValue} {a 64 bit floating-point number:fourthTail}:
    execute:
        set u to the cad robust sum expansion of products (the cad robust two product of firstTail and firstValue) and (the cad robust two product of secondValue and secondTail)
        set v to the cad robust sum expansion of products (the cad robust two product of thirdTail and (-thirdValue)) and (the cad robust two product of fourthValue and (-fourthTail))
        set result to the cad robust sum of expansion u and v
        free u
        free v
        return result

# The first second-order term of one point tail (adxtail, ...): it returns the
# accumulated expansion and stores the tail-scaled cross expansion (axtbct).
local function the cad robust accumulation of {a pointer to a list:fin} with tail {a 64 bit floating-point number:tailValue} doubled by {a 64 bit floating-point number:doubledFactor} of minor tail {a pointer to a list:minorTail} and scaled cross {a pointer to a list:crossScaled}:
    execute:
        set temp16a to the cad robust scaled expansion of minorTail by tailValue
        set temp32a to the cad robust scaled expansion of crossScaled by doubledFactor
        set temp48 to the cad robust sum of expansion temp16a and temp32a
        set result to the cad robust accumulation of fin with temp48
        free temp16a
        free temp32a
        free temp48
        return result

# The final second-order term of one point tail.
local function the cad robust accumulation of {a pointer to a list:fin} with tail {a 64 bit floating-point number:tailValue} doubled by {a 64 bit floating-point number:doubledFactor} of scaled cross {a pointer to a list:crossScaled} and cross tail {a pointer to a list:crossTailTail}:
    execute:
        set temp32a to the cad robust scaled expansion of crossScaled by tailValue
        set crossTailScaled to the cad robust scaled expansion of crossTailTail by tailValue
        set temp16a to the cad robust scaled expansion of crossTailScaled by doubledFactor
        set temp16b to the cad robust scaled expansion of crossTailScaled by tailValue
        set temp32b to the cad robust sum of expansion temp16a and temp16b
        set temp64 to the cad robust sum of expansion temp32a and temp32b
        set result to the cad robust accumulation of fin with temp64
        free temp32a
        free crossTailScaled
        free temp16a
        free temp16b
        free temp32b
        free temp64
        return result

local function the cad robust accumulation of {a pointer to a list:fin} with lift {a pointer to a list:liftExpansion} scaled by {a 64 bit floating-point number:firstFactor} and {a 64 bit floating-point number:secondFactor}:
    execute:
        set temp8 to the cad robust scaled expansion of liftExpansion by firstFactor
        set temp16a to the cad robust scaled expansion of temp8 by secondFactor
        set result to the cad robust accumulation of fin with temp16a
        free temp8
        free temp16a
        return result

local function the cad robust incircle adaptation of {cad vector2:pa}, {cad vector2:pb}, {cad vector2:pc}, {cad vector2:pd} with permanent {a 64 bit floating-point number:permanentValue}:
    execute:
        set adx to (the x of pa) - (the x of pd)
        set bdx to (the x of pb) - (the x of pd)
        set cdx to (the x of pc) - (the x of pd)
        set ady to (the y of pa) - (the y of pd)
        set bdy to (the y of pb) - (the y of pd)
        set cdy to (the y of pc) - (the y of pd)
        set bc to the cad robust difference expansion of products (the cad robust two product of bdx and cdy) and (the cad robust two product of cdx and bdy)
        set adet to the cad robust lifted expansion of bc by adx and ady
        set ca to the cad robust difference expansion of products (the cad robust two product of cdx and ady) and (the cad robust two product of adx and cdy)
        set bdet to the cad robust lifted expansion of ca by bdx and bdy
        set ab to the cad robust difference expansion of products (the cad robust two product of adx and bdy) and (the cad robust two product of bdx and ady)
        set cdet to the cad robust lifted expansion of ab by cdx and cdy
        set abdet to the cad robust sum of expansion adet and bdet
        set fin to the cad robust sum of expansion abdet and cdet
        free adet
        free bdet
        free cdet
        free abdet
        set det to the cad robust estimate of fin
        set errbound to (the cad robust incircle error bound b) * permanentValue
        set finished to (det >= errbound) or ((-det) >= errbound)
        set adxtail to the cad robust difference tail of (the x of pa) minus (the x of pd) rounded to adx
        set adytail to the cad robust difference tail of (the y of pa) minus (the y of pd) rounded to ady
        set bdxtail to the cad robust difference tail of (the x of pb) minus (the x of pd) rounded to bdx
        set bdytail to the cad robust difference tail of (the y of pb) minus (the y of pd) rounded to bdy
        set cdxtail to the cad robust difference tail of (the x of pc) minus (the x of pd) rounded to cdx
        set cdytail to the cad robust difference tail of (the y of pc) minus (the y of pd) rounded to cdy
        if finished = false:
            set finished to ((adxtail = 0.0) and ((bdxtail = 0.0) and (cdxtail = 0.0))) and ((adytail = 0.0) and ((bdytail = 0.0) and (cdytail = 0.0)))
        if finished = false:
            set errbound to ((the cad robust incircle error bound c) * permanentValue) + ((the cad robust final error bound) * (the absolute value of det))
            set aTerm to (((adx * adx) + (ady * ady)) * (((bdx * cdytail) + (cdy * bdxtail)) - ((bdy * cdxtail) + (cdx * bdytail)))) + ((2.0 * ((adx * adxtail) + (ady * adytail))) * ((bdx * cdy) - (bdy * cdx)))
            set bTerm to (((bdx * bdx) + (bdy * bdy)) * (((cdx * adytail) + (ady * cdxtail)) - ((cdy * adxtail) + (adx * cdytail)))) + ((2.0 * ((bdx * bdxtail) + (bdy * bdytail))) * ((cdx * ady) - (cdy * adx)))
            set cTerm to (((cdx * cdx) + (cdy * cdy)) * (((adx * bdytail) + (bdy * adxtail)) - ((ady * bdxtail) + (bdx * adytail)))) + ((2.0 * ((cdx * cdxtail) + (cdy * cdytail))) * ((adx * bdy) - (ady * bdx)))
            set det to det + ((aTerm + bTerm) + cTerm)
            set finished to (det >= errbound) or ((-det) >= errbound)
        if finished:
            free fin
            free bc
            free ca
            free ab
            return det
        set aTailed to (adxtail != 0.0) or (adytail != 0.0)
        set bTailed to (bdxtail != 0.0) or (bdytail != 0.0)
        set cTailed to (cdxtail != 0.0) or (cdytail != 0.0)
        set aa to the cad robust lift of adx and ady when (bTailed or cTailed)
        set bb to the cad robust lift of bdx and bdy when (cTailed or aTailed)
        set cc to the cad robust lift of cdx and cdy when (aTailed or bTailed)
        set axtbc to the cad robust scaled expansion of bc by adxtail
        set aytbc to the cad robust scaled expansion of bc by adytail
        set bxtca to the cad robust scaled expansion of ca by bdxtail
        set bytca to the cad robust scaled expansion of ca by bdytail
        set cxtab to the cad robust scaled expansion of ab by cdxtail
        set cytab to the cad robust scaled expansion of ab by cdytail
        if adxtail != 0.0:
            set temp48 to the cad robust primary tail expansion of axtbc doubled by (2.0 * adx), cc by adxtail and bdy, bb by (-cdy)
            set fin to the cad robust accumulation of fin with temp48
            free temp48
        if adytail != 0.0:
            set temp48 to the cad robust primary tail expansion of aytbc doubled by (2.0 * ady), bb by adytail and cdx, cc by (-bdx)
            set fin to the cad robust accumulation of fin with temp48
            free temp48
        if bdxtail != 0.0:
            set temp48 to the cad robust primary tail expansion of bxtca doubled by (2.0 * bdx), aa by bdxtail and cdy, cc by (-ady)
            set fin to the cad robust accumulation of fin with temp48
            free temp48
        if bdytail != 0.0:
            set temp48 to the cad robust primary tail expansion of bytca doubled by (2.0 * bdy), cc by bdytail and adx, aa by (-cdx)
            set fin to the cad robust accumulation of fin with temp48
            free temp48
        if cdxtail != 0.0:
            set temp48 to the cad robust primary tail expansion of cxtab doubled by (2.0 * cdx), bb by cdxtail and ady, aa by (-bdy)
            set fin to the cad robust accumulation of fin with temp48
            free temp48
        if cdytail != 0.0:
            set temp48 to the cad robust primary tail expansion of cytab doubled by (2.0 * cdy), aa by cdytail and bdx, bb by (-adx)
            set fin to the cad robust accumulation of fin with temp48
            free temp48
        if aTailed:
            set bct to the cad robust single expansion of 0.0
            set bctt to the cad robust single expansion of 0.0
            if bTailed or cTailed:
                free bct
                free bctt
                set bct to the cad robust cross tail of bdxtail cdy bdx cdytail cdxtail bdy cdx bdytail
                set bctt to the cad robust difference expansion of products (the cad robust two product of bdxtail and cdytail) and (the cad robust two product of cdxtail and bdytail)
            if adxtail != 0.0:
                set scaledCross to the cad robust scaled expansion of bct by adxtail
                set fin to the cad robust accumulation of fin with tail adxtail doubled by (2.0 * adx) of minor tail axtbc and scaled cross scaledCross
                if bdytail != 0.0:
                    set fin to the cad robust accumulation of fin with lift cc scaled by adxtail and bdytail
                if cdytail != 0.0:
                    set fin to the cad robust accumulation of fin with lift bb scaled by (-adxtail) and cdytail
                set fin to the cad robust accumulation of fin with tail adxtail doubled by (2.0 * adx) of scaled cross scaledCross and cross tail bctt
                free scaledCross
            if adytail != 0.0:
                set scaledCross to the cad robust scaled expansion of bct by adytail
                set fin to the cad robust accumulation of fin with tail adytail doubled by (2.0 * ady) of minor tail aytbc and scaled cross scaledCross
                set fin to the cad robust accumulation of fin with tail adytail doubled by (2.0 * ady) of scaled cross scaledCross and cross tail bctt
                free scaledCross
            free bct
            free bctt
        if bTailed:
            set cat to the cad robust single expansion of 0.0
            set catt to the cad robust single expansion of 0.0
            if cTailed or aTailed:
                free cat
                free catt
                set cat to the cad robust cross tail of cdxtail ady cdx adytail adxtail cdy adx cdytail
                set catt to the cad robust difference expansion of products (the cad robust two product of cdxtail and adytail) and (the cad robust two product of adxtail and cdytail)
            if bdxtail != 0.0:
                set scaledCross to the cad robust scaled expansion of cat by bdxtail
                set fin to the cad robust accumulation of fin with tail bdxtail doubled by (2.0 * bdx) of minor tail bxtca and scaled cross scaledCross
                if cdytail != 0.0:
                    set fin to the cad robust accumulation of fin with lift aa scaled by bdxtail and cdytail
                if adytail != 0.0:
                    set fin to the cad robust accumulation of fin with lift cc scaled by (-bdxtail) and adytail
                set fin to the cad robust accumulation of fin with tail bdxtail doubled by (2.0 * bdx) of scaled cross scaledCross and cross tail catt
                free scaledCross
            if bdytail != 0.0:
                set scaledCross to the cad robust scaled expansion of cat by bdytail
                set fin to the cad robust accumulation of fin with tail bdytail doubled by (2.0 * bdy) of minor tail bytca and scaled cross scaledCross
                set fin to the cad robust accumulation of fin with tail bdytail doubled by (2.0 * bdy) of scaled cross scaledCross and cross tail catt
                free scaledCross
            free cat
            free catt
        if cTailed:
            set abt to the cad robust single expansion of 0.0
            set abtt to the cad robust single expansion of 0.0
            if aTailed or bTailed:
                free abt
                free abtt
                set abt to the cad robust cross tail of adxtail bdy adx bdytail bdxtail ady bdx adytail
                set abtt to the cad robust difference expansion of products (the cad robust two product of adxtail and bdytail) and (the cad robust two product of bdxtail and adytail)
            if cdxtail != 0.0:
                set scaledCross to the cad robust scaled expansion of abt by cdxtail
                set fin to the cad robust accumulation of fin with tail cdxtail doubled by (2.0 * cdx) of minor tail cxtab and scaled cross scaledCross
                if adytail != 0.0:
                    set fin to the cad robust accumulation of fin with lift bb scaled by cdxtail and adytail
                if bdytail != 0.0:
                    set fin to the cad robust accumulation of fin with lift aa scaled by (-cdxtail) and bdytail
                set fin to the cad robust accumulation of fin with tail cdxtail doubled by (2.0 * cdx) of scaled cross scaledCross and cross tail abtt
                free scaledCross
            if cdytail != 0.0:
                set scaledCross to the cad robust scaled expansion of abt by cdytail
                set fin to the cad robust accumulation of fin with tail cdytail doubled by (2.0 * cdy) of minor tail cytab and scaled cross scaledCross
                set fin to the cad robust accumulation of fin with tail cdytail doubled by (2.0 * cdy) of scaled cross scaledCross and cross tail abtt
                free scaledCross
            free abt
            free abtt
        set result to the last item of fin
        free fin
        free bc
        free ca
        free ab
        free aa
        free bb
        free cc
        free axtbc
        free aytbc
        free bxtca
        free bytca
        free cxtab
        free cytab
        return result

# Positive when pd lies inside the circle through pa, pb and pc in
# counterclockwise order.
function the cad robust incircle of {cad vector2:pa}, {cad vector2:pb}, {cad vector2:pc} and {cad vector2:pd}:
    execute:
        set adx to (the x of pa) - (the x of pd)
        set bdx to (the x of pb) - (the x of pd)
        set cdx to (the x of pc) - (the x of pd)
        set ady to (the y of pa) - (the y of pd)
        set bdy to (the y of pb) - (the y of pd)
        set cdy to (the y of pc) - (the y of pd)
        set bdxcdy to bdx * cdy
        set cdxbdy to cdx * bdy
        set alift to (adx * adx) + (ady * ady)
        set cdxady to cdx * ady
        set adxcdy to adx * cdy
        set blift to (bdx * bdx) + (bdy * bdy)
        set adxbdy to adx * bdy
        set bdxady to bdx * ady
        set clift to (cdx * cdx) + (cdy * cdy)
        set det to ((alift * (bdxcdy - cdxbdy)) + (blift * (cdxady - adxcdy))) + (clift * (adxbdy - bdxady))
        set permanentValue to ((((the absolute value of bdxcdy) + (the absolute value of cdxbdy)) * alift) + (((the absolute value of cdxady) + (the absolute value of adxcdy)) * blift)) + (((the absolute value of adxbdy) + (the absolute value of bdxady)) * clift)
        set errbound to (the cad robust incircle error bound a) * permanentValue
        if (det > errbound) or ((-det) > errbound):
            return det
        return the cad robust incircle adaptation of pa, pb, pc, pd with permanent permanentValue
