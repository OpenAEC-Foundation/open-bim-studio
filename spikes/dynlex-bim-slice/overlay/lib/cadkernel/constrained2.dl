# SPDX-License-Identifier: MPL-2.0
# Port of geom2d/constrained.rs at 953d546b68aef4b6692566a1a9b077fc5bd9fb4f.
# The mesh is a spade 2.15.1 constrained Delaunay triangulation of the source
# rings in normalized coordinates (spade_cdt2.dl). Its vertices carry the
# source parameters. Copies share the source rings and the triangulation
# storage; callers mutate through a mesh pointer.
import lib/cadkernel/spade_cdt2.dl

class:
    patterns:
        [a|] cad constrained triangle2
    members:
        first as a cad vector2
        second as a cad vector2
        third as a cad vector2
        firstConstrained as a boolean
        secondConstrained as a boolean
        thirdConstrained as a boolean

class:
    patterns:
        [a|] cad constrained mesh2
    members:
        triangulation as a cad spade triangulation2
        rings
        origin as a cad vector2
        scale as a cad vector2
        owner as a pointer to an integer
    retain:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            store ((the value at storageOwner) + 1) at storageOwner
    release:
        set storageOwner to the owner of @intrinsic("lifecycle value")
        if storageOwner != (0 as a pointer to an integer):
            set references to the value at storageOwner
            if references = 1:
                set storedRings to the rings of @intrinsic("lifecycle value")
                loop ringIndex from 0 to the length of storedRings:
                    free (the item at ringIndex in storedRings)
                free storedRings
                free cad spade triangulation storage (the triangulation of @intrinsic("lifecycle value"))
                @intrinsic("call", "libc", "free", nothing, storageOwner)
            else:
                store (references - 1) at storageOwner

class:
    patterns:
        [a|] cad constrained mesh result2
    members:
        valid as a boolean
        value as a cad constrained mesh2

class:
    patterns:
        [a|] cad constrained insertion result2
    members:
        valid as a boolean
        inserted as a boolean

class:
    patterns:
        [a|] cad constrained constraint result2
    members:
        valid as a boolean
        added as an integer

local function check cad constrained point {cad vector2:pointValue}:
    execute:
        ignore pointValue

local function check cad constrained ring {a pointer to a list:ringValue}:
    execute:
        check cad constrained point (a new (the type of (the item at 0 in ringValue)))

local function check cad constrained rings {a pointer to a list:ringValues}:
    execute:
        check cad constrained ring (a new (the type of (the item at 0 in ringValues)))

local function cad constrained scalar {a 64 bit floating-point number:value} is finite:
    execute:
        return (value - value) = 0.0

local function an invalid cad constrained mesh result:
    execute:
        set storedRings to an empty list of the type of (an empty list of a cad vector2)
        allocate one slot of 0 and set storageOwner to it
        set meshValue to @intrinsic("construct", a cad constrained mesh2, an empty cad spade triangulation, storedRings, the cad zero vector2, the cad zero vector2, storageOwner)
        return @intrinsic("construct", a cad constrained mesh result2, false, meshValue)

function free cad constrained mesh {cad constrained mesh2:meshValue}:
    replacement:
        set meshValue to a new (the type of meshValue)

function free cad constrained mesh result {cad constrained mesh result2:resultValue}:
    replacement:
        set resultValue to a new (the type of resultValue)

# ConstrainedMesh::vertex: normalized onto the binary64 epsilon grid.
local function the cad constrained position of {cad vector2:parameters} from {cad vector2:originValue} at {cad vector2:scaleValue}:
    execute:
        set step to 2.220446049250313e-16
        set normalizedX to ((the x of parameters) - (the x of originValue)) / (the x of scaleValue)
        set normalizedY to ((the y of parameters) - (the y of originValue)) / (the y of scaleValue)
        set normalizedX to (the rounded value of (normalizedX / step)) * step
        set normalizedY to (the rounded value of (normalizedY / step)) * step
        return a cad vector2 with x normalizedX and y normalizedY

local function free cad constrained ring handles {a pointer to a list:ringHandles}:
    execute:
        loop ringIndex from 0 to the length of ringHandles:
            free (the item at ringIndex in ringHandles)
        free ringHandles

local function free cad constrained rings {a pointer to a list:ringValues}:
    execute:
        loop ringIndex from 0 to the length of ringValues:
            free (the item at ringIndex in ringValues)
        free ringValues

function the cad constrained mesh of rings {a pointer to a list:sourceRings}:
    execute:
        check cad constrained rings sourceRings
        if (the length of sourceRings) = 0:
            return an invalid cad constrained mesh result
        loop ringIndex from 0 to the length of sourceRings:
            if (the length of (the item at ringIndex in sourceRings)) < 3:
                return an invalid cad constrained mesh result
        set lowX to 1.0 / 0.0
        set highX to -1.0 / 0.0
        set lowY to 1.0 / 0.0
        set highY to -1.0 / 0.0
        loop ringIndex from 0 to the length of sourceRings:
            set sourceRing to the item at ringIndex in sourceRings
            loop pointIndex from 0 to the length of sourceRing:
                set sourcePoint to the item at pointIndex in sourceRing
                set lowX to the minimum of lowX and (the x of sourcePoint)
                set highX to the maximum of highX and (the x of sourcePoint)
                set lowY to the minimum of lowY and (the y of sourcePoint)
                set highY to the maximum of highY and (the y of sourcePoint)
        set originValue to a cad vector2 with x lowX and y lowY
        set scaleValue to a cad vector2 with x (highX - lowX) and y (highY - lowY)
        set scaleXValid to (cad constrained scalar (the x of scaleValue) is finite) and ((the x of scaleValue) > 0.0)
        set scaleYValid to (cad constrained scalar (the y of scaleValue) is finite) and ((the y of scaleValue) > 0.0)
        if (scaleXValid and scaleYValid) = false:
            return an invalid cad constrained mesh result
        set storedRings to an empty list of the type of (an empty list of a cad vector2)
        loop ringIndex from 0 to the length of sourceRings:
            set sourceRing to the item at ringIndex in sourceRings
            set storedRing to an empty list of a cad vector2
            loop pointIndex from 0 to the length of sourceRing:
                append (the item at pointIndex in sourceRing) to storedRing
            append storedRing to storedRings
        set cdt to an empty cad spade triangulation
        set ringHandles to an empty list of the type of (an empty list of an integer)
        set failed to false
        loop ringIndex from 0 to the length of sourceRings:
            if failed = false:
                set sourceRing to the item at ringIndex in sourceRings
                set handles to an empty list of an integer
                loop pointIndex from 0 to the length of sourceRing:
                    if failed = false:
                        set sourceParameters to the item at pointIndex in sourceRing
                        set normalizedPosition to the cad constrained position of sourceParameters from originValue at scaleValue
                        set inserted to the cad spade insertion of normalizedPosition with payload sourceParameters into (the address of cdt)
                        if (the valid of inserted) = false:
                            set failed to true
                        else:
                            set repeated to false
                            if (the length of handles) > 0:
                                set repeated to (the last item of handles) = (the vertex of inserted)
                            if repeated:
                                set failed to true
                            else:
                                append (the vertex of inserted) to handles
                if failed = false:
                    if (the item at 0 in handles) = (the last item of handles):
                        remove the last item from handles
                    if (the length of handles) < 3:
                        set failed to true
                append handles to ringHandles
        loop ringIndex from 0 to the length of ringHandles:
            set handles to the item at ringIndex in ringHandles
            loop handleIndex from 0 to the length of handles:
                if failed = false:
                    set fromVertex to the item at handleIndex in handles
                    set toVertex to the item at (the remainder of (handleIndex + 1) divided by (the length of handles)) in handles
                    if fromVertex = toVertex:
                        set failed to true
                    else:
                        set constraintEdges to the cad spade constraint edges from fromVertex to toVertex in (the address of cdt)
                        if (the length of constraintEdges) = 0:
                            set failed to true
                        free constraintEdges
        free cad constrained ring handles ringHandles
        if failed:
            free cad constrained rings storedRings
            free cad spade triangulation storage cdt
            return an invalid cad constrained mesh result
        allocate one slot of 0 and set storageOwner to it
        set meshValue to @intrinsic("construct", a cad constrained mesh2, cdt, storedRings, originValue, scaleValue, storageOwner)
        return @intrinsic("construct", a cad constrained mesh result2, true, meshValue)

function the cad constrained insertion of point {cad vector2:parameters} into {a pointer to a cad constrained mesh2:meshValue}:
    execute:
        set cdt to the triangulation of meshValue
        set before to the cad spade vertex count of (the address of cdt)
        set inserted to the cad spade insertion of (the cad constrained position of parameters from (the origin of meshValue) at (the scale of meshValue)) with payload parameters into (the address of cdt)
        set the triangulation of meshValue to cdt
        if (the valid of inserted) = false:
            return @intrinsic("construct", a cad constrained insertion result2, false, false)
        return @intrinsic("construct", a cad constrained insertion result2, true, (the cad spade vertex count of (the address of cdt)) > before)

function the cad constrained constraint from {cad vector2:fromParameters} to {cad vector2:toParameters} in {a pointer to a cad constrained mesh2:meshValue}:
    execute:
        set cdt to the triangulation of meshValue
        set originValue to the origin of meshValue
        set scaleValue to the scale of meshValue
        set before to the cad spade vertex count of (the address of cdt)
        set fromInserted to the cad spade insertion of (the cad constrained position of fromParameters from originValue at scaleValue) with payload fromParameters into (the address of cdt)
        if (the valid of fromInserted) = false:
            set the triangulation of meshValue to cdt
            return @intrinsic("construct", a cad constrained constraint result2, false, 0)
        set toInserted to the cad spade insertion of (the cad constrained position of toParameters from originValue at scaleValue) with payload toParameters into (the address of cdt)
        if (the valid of toInserted) = false:
            set the triangulation of meshValue to cdt
            return @intrinsic("construct", a cad constrained constraint result2, false, 0)
        if (the vertex of fromInserted) != (the vertex of toInserted):
            set constraintEdges to the cad spade split constraint edges from (the vertex of fromInserted) to (the vertex of toInserted) with payload origin originValue and scale scaleValue in (the address of cdt)
            set added to (the length of constraintEdges) > 0
            free constraintEdges
            if added = false:
                set the triangulation of meshValue to cdt
                return @intrinsic("construct", a cad constrained constraint result2, false, 0)
        set the triangulation of meshValue to cdt
        return @intrinsic("construct", a cad constrained constraint result2, true, (the cad spade vertex count of (the address of cdt)) - before)

local function cad constrained ring {a pointer to a list:ringValue} contains {cad vector2:pointValue}:
    execute:
        set inside to false
        loop pointIndex from 0 to the length of ringValue:
            set nextIndex to pointIndex + 1
            if nextIndex = (the length of ringValue):
                set nextIndex to 0
            set fromPoint to the item at pointIndex in ringValue
            set toPoint to the item at nextIndex in ringValue
            set crosses to ((the y of fromPoint) > (the y of pointValue)) != ((the y of toPoint) > (the y of pointValue))
            if crosses:
                set crossingX to ((((the x of toPoint) - (the x of fromPoint)) * ((the y of pointValue) - (the y of fromPoint))) / ((the y of toPoint) - (the y of fromPoint))) + (the x of fromPoint)
                if (the x of pointValue) < crossingX:
                    set inside to the inverse of inside
        return inside

local function cad constrained {cad vector2:pointValue} is inside {cad constrained mesh2:meshValue}:
    execute:
        set crossings to 0
        loop ringIndex from 0 to the length of meshValue's rings:
            if cad constrained ring (the item at ringIndex in meshValue's rings) contains pointValue:
                set crossings to crossings + 1
        return (the remainder of crossings divided by 2) = 1

# Inner faces in storage order, each from its adjacent edge's predecessor.
function the cad constrained triangles of {cad constrained mesh2:meshValue}:
    execute:
        set cdt to the triangulation of meshValue
        set result to an empty list of a cad constrained triangle2
        loop faceIndex from 1 to the cad spade face count of (the address of cdt):
            set middleEdge to the cad spade adjacent edge of face faceIndex in (the address of cdt)
            set firstEdge to the cad spade previous of middleEdge in (the address of cdt)
            set lastEdge to the cad spade next of middleEdge in (the address of cdt)
            set firstPoint to the cad spade payload of vertex (the cad spade origin of firstEdge in (the address of cdt)) in (the address of cdt)
            set secondPoint to the cad spade payload of vertex (the cad spade origin of middleEdge in (the address of cdt)) in (the address of cdt)
            set thirdPoint to the cad spade payload of vertex (the cad spade origin of lastEdge in (the address of cdt)) in (the address of cdt)
            set centreX to (((the x of firstPoint) + (the x of secondPoint)) + (the x of thirdPoint)) / 3.0
            set centreY to (((the y of firstPoint) + (the y of secondPoint)) + (the y of thirdPoint)) / 3.0
            if cad constrained (a cad vector2 with x centreX and y centreY) is inside meshValue:
                set firstConstrained to cad spade edge firstEdge is a constraint in (the address of cdt)
                set secondConstrained to cad spade edge middleEdge is a constraint in (the address of cdt)
                set thirdConstrained to cad spade edge lastEdge is a constraint in (the address of cdt)
                append (@intrinsic("construct", a cad constrained triangle2, firstPoint, secondPoint, thirdPoint, firstConstrained, secondConstrained, thirdConstrained)) to result
        return result
