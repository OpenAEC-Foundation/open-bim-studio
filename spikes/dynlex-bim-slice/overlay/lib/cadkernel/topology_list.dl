# SPDX-License-Identifier: MPL-2.0
# The shared, reference-counted list of the native cadkernel port (part of the
# src/brep/topology.rs foundation at 953d546b68aef4b6692566a1a9b077fc5bd9fb4f),
# in its own file so that light modules can use it without the B-rep stack.
import lib/list.dl

# A Vec-like owner. Each list is copied explicitly by node/body Clone.
class:
    patterns:
        [a|] cad topology list
    members:
        values
        references as a pointer to an integer
    retain:
        set owner to the references of @intrinsic("lifecycle value")
        if owner != (0 as a pointer to an integer):
            set count to @intrinsic("dereference", owner)
            if count = 2147483647:
                @intrinsic("call", "libc", "abort", nothing)
            @intrinsic("store at", owner, count + 1)
    release:
        set owner to the references of @intrinsic("lifecycle value")
        if owner != (0 as a pointer to an integer):
            set count to @intrinsic("dereference", owner)
            if count = 1:
                # The list header is the first field of the allocation; free
                # releases its elements, data buffer and shared counter block.
                free (the values of @intrinsic("lifecycle value"))
            else:
                @intrinsic("store at", owner, count - 1)

class:
    patterns:
        [a|] cad topology list allocation
    members:
        values
        references as an integer

function a cad topology list of {type:kind}:
    execute:
        set empty to @intrinsic("construct", a list, 0 as a pointer to kind, 0, 0)
        set initial to @intrinsic("construct", a cad topology list allocation, empty, 0)
        set allocation to the checked allocation from (0 as a pointer) resized to 1 items of the type of initial
        @intrinsic("initialize at", allocation, initial)
        return @intrinsic("construct", a cad topology list, the address of (allocation's values), the address of (allocation's references))
function the cad clone of {cad topology list:original}:
    execute:
        set result to a cad topology list of the type of (the item at 0 in original's values)
        loop index from 0 to the length of original's values:
            append (the item at index in original's values) to result's values
        return result
