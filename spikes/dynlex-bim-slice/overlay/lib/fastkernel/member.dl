# SPDX-License-Identifier: MPL-2.0
# A linear member built directly as a planar polyhedron: a cross-section
# (an outer ring and any holes, in the section's own coordinates) swept along
# a straight axis and cut off at each end by a plane. Every edge of the
# section runs parallel to the axis, so every side face stays planar whatever
# the end planes are; each end face is the section projected along the axis
# onto its plane. A square end, a mitre and a member cut back to the face of
# another all come down to the choice of these two planes. A plate is the
# same sweep of its outline over its thickness between two square ends.
import lib/fastkernel/polyhedron.dl

function fast sweep built:
    replacement:
        0
# A ring with fewer than three points or no area.
function fast sweep degenerate section:
    replacement:
        1
# An end plane at less than the minimum angle to the axis, or facing the
# wrong way.
function fast sweep oblique end:
    replacement:
        2
# The end planes cross inside the section: some edge would have no length.
function fast sweep crossed ends:
    replacement:
        3

# The sine of the smallest angle an end plane may make with the axis.
function the fast sweep minimum facing:
    replacement:
        0.05

class:
    patterns:
        [a|] fast sweep result record
    members:
        reason as an integer
        shape as a fast polyhedron record

# An end plane: a point on it and its normal, pointing out of the member.
class:
    patterns:
        [a|] fast cut record
    members:
        point as a cad vector3
        normal as a cad vector3

function a fast cut through {cad vector3:location} facing {cad vector3:direction}:
    execute:
        return @intrinsic("construct", a fast cut record, location, direction)

# Where a section is placed: `origin` is the point of the axis where the
# section's own origin lies, `uAxis` and `vAxis` the section's axes in space
# and `axis` the direction the member runs. All three are unit vectors with
# uAxis x vAxis = axis.
class:
    patterns:
        [a|] fast frame record
    members:
        origin as a cad vector3
        uAxis as a cad vector3
        vAxis as a cad vector3
        axis as a cad vector3

local function a refused fast sweep {integer:reason}:
    execute:
        return @intrinsic("construct", a fast sweep result record, reason, an empty fast polyhedron)

local function the fast doubled area of section ring {a pointer to a list:ring}:
    execute:
        set total to 0.0
        set anchor to the item at 0 in ring
        loop cursor from 1 to (the length of ring) - 1:
            set here to the item at cursor in ring
            set following to the item at (cursor + 1) in ring
            set total to total + (((here's x - anchor's x) * (following's y - anchor's y)) - ((following's x - anchor's x) * (here's y - anchor's y)))
        return total

# The point of space at section coordinates `location` in `frame`.
function the fast point of {cad vector2:location} in {fast frame record:frame}:
    execute:
        return the cad sum of frame's origin and (the cad sum of (frame's uAxis scaled by location's x) and (frame's vAxis scaled by location's y))

# The distance along the axis from `base` to `cut`'s plane.
local function the fast reach from {cad vector3:base} along {cad vector3:axis} to {fast cut record:cut}:
    execute:
        return (the cad dot of cut's normal and (the cad difference of cut's point and base)) / (the cad dot of cut's normal and axis)

# `rings` is a list of rings of cad vector2: the outer ring first, then the
# holes, each running either way round. The member runs along `frame`'s axis
# from `startCut` (whose normal points back along the axis) to `finishCut`
# (whose normal points forward along it).
function the fast sweep of {a pointer to a list:rings} in {fast frame record:frame} from {fast cut record:startCut} to {fast cut record:finishCut} within {a 64 bit floating-point number:tolerance}:
    execute:
        if (the length of rings) = 0:
            return a refused fast sweep fast sweep degenerate section
        loop cursor from 0 to the length of rings:
            set ring to the item at cursor in rings
            if (the length of ring) < 3:
                return a refused fast sweep fast sweep degenerate section
            if (the absolute value of (the fast doubled area of section ring ring)) <= (tolerance * tolerance):
                return a refused fast sweep fast sweep degenerate section
        set startFacing to the cad dot of startCut's normal and frame's axis
        set finishFacing to the cad dot of finishCut's normal and frame's axis
        if (startFacing > (0.0 - the fast sweep minimum facing)) or (finishFacing < the fast sweep minimum facing):
            return a refused fast sweep fast sweep oblique end
        set shape to an empty fast polyhedron
        set target to the address of shape
        set startRings to an empty list of the type of (an empty list of an integer)
        set finishRings to an empty list of the type of (an empty list of an integer)
        set crossed to false
        loop cursor from 0 to the length of rings:
            set ring to the item at cursor in rings
            set startRing to an empty list of an integer
            set finishRing to an empty list of an integer
            loop corner from 0 to the length of ring:
                set base to the fast point of (the item at corner in ring) in frame
                set fromReach to the fast reach from base along frame's axis to startCut
                set toReach to the fast reach from base along frame's axis to finishCut
                if (toReach - fromReach) <= tolerance:
                    set crossed to true
                append (add fast position (the cad sum of base and (frame's axis scaled by fromReach)) to target) to startRing
                append (add fast position (the cad sum of base and (frame's axis scaled by toReach)) to target) to finishRing
            append startRing to startRings
            append finishRing to finishRings
        if crossed:
            loop cursor from 0 to the length of startRings:
                free (the item at cursor in startRings)
                free (the item at cursor in finishRings)
            free startRings
            free finishRings
            return a refused fast sweep fast sweep crossed ends
        set startHoles to an empty list of the type of (an empty list of an integer)
        set finishHoles to an empty list of the type of (an empty list of an integer)
        loop cursor from 1 to the length of rings:
            append (the item at cursor in startRings) to startHoles
            append (the item at cursor in finishRings) to finishHoles
        add fast face (the item at 0 in startRings) with holes startHoles facing (the cad normalization of startCut's normal)'s value to target
        add fast face (the item at 0 in finishRings) with holes finishHoles facing (the cad normalization of finishCut's normal)'s value to target
        set noHoles to an empty list of the type of (an empty list of an integer)
        # Sides face away from the material: out of the outer ring, into holes.
        loop cursor from 0 to the length of rings:
            set ring to the item at cursor in rings
            set turn to 1.0
            if (the fast doubled area of section ring ring) < 0.0:
                set turn to -1.0
            if cursor > 0:
                set turn to 0.0 - turn
            set count to the length of ring
            loop corner from 0 to count:
                set nextCorner to the remainder of (corner + 1) divided by count
                set here to the item at corner in ring
                set there to the item at nextCorner in ring
                set du to there's x - here's x
                set dv to there's y - here's y
                set magnitude to the square root of ((du * du) + (dv * dv))
                if magnitude > 0.0:
                    set side to an empty list of an integer
                    append (the item at corner in (the item at cursor in startRings)) to side
                    append (the item at nextCorner in (the item at cursor in startRings)) to side
                    append (the item at nextCorner in (the item at cursor in finishRings)) to side
                    append (the item at corner in (the item at cursor in finishRings)) to side
                    set outward to the cad sum of (frame's uAxis scaled by ((turn * dv) / magnitude)) and (frame's vAxis scaled by ((0.0 - (turn * du)) / magnitude))
                    add fast face side with holes noHoles facing outward to target
                    free side
        loop cursor from 0 to the length of startRings:
            free (the item at cursor in startRings)
            free (the item at cursor in finishRings)
        free startRings
        free finishRings
        free startHoles
        free finishHoles
        free noHoles
        return @intrinsic("construct", a fast sweep result record, fast sweep built, shape)

# A plate: `rings` swept from `frame`'s origin along its axis over
# `thickness`, with square ends.
function the fast plate of {a pointer to a list:rings} in {fast frame record:frame} thick {a 64 bit floating-point number:thickness} within {a 64 bit floating-point number:tolerance}:
    execute:
        if thickness <= tolerance:
            return a refused fast sweep fast sweep degenerate section
        set backFace to a fast cut through frame's origin facing (frame's axis scaled by -1.0)
        set frontFace to a fast cut through (the cad sum of frame's origin and (frame's axis scaled by thickness)) facing frame's axis
        return the fast sweep of rings in frame from backFace to frontFace within tolerance

# Appends every position, loop and face of `part` to `target`: one
# polyhedron of disjoint closed parts, such as the plates of one joint.
function append fast part {fast polyhedron record:part} to {a pointer to a fast polyhedron record:target}:
    execute:
        set positionBase to the length of (target's positions's values)
        set indexBase to the length of (target's indices's values)
        set loopBase to (the length of (target's loopStarts's values)) - 1
        loop cursor from 0 to the length of (part's positions's values):
            append (the item at cursor in (part's positions's values)) to (target's positions's values)
        loop cursor from 0 to the length of (part's indices's values):
            append ((the item at cursor in (part's indices's values)) + positionBase) to (target's indices's values)
        loop cursor from 1 to the length of (part's loopStarts's values):
            append ((the item at cursor in (part's loopStarts's values)) + indexBase) to (target's loopStarts's values)
        loop cursor from 0 to the length of (part's faces's values):
            set face to the item at cursor in (part's faces's values)
            append (@intrinsic("construct", a fast face record, face's firstLoop + loopBase, face's loopCount, face's normal, face's offset)) to (target's faces's values)

# ---------------------------------------------------------------- merging planes

# The polyhedron of a closed triangle mesh (`positions`, and `triangles` as
# index triples), its triangles merged into one face per region of one
# plane: the outer loop and the holes of each region, without corners that
# lie on a straight edge between two faces. A boolean that leaves faces cut
# into many coplanar pieces comes back as few planar faces with holes.
# Corners within `tolerance` of each other are one corner.
function the fast polyhedron of triangles {a pointer to a list:triangleCorners} at {a pointer to a list:positions} within {a 64 bit floating-point number:tolerance}:
    execute:
        # Welded corners: the first position within tolerance stands for all.
        set welded to an empty list of a cad vector3
        set mapping to an empty list of an integer
        loop cursor from 0 to the length of positions:
            set location to the item at cursor in positions
            set slot to -1
            loop other from 0 to the length of welded:
                if slot < 0:
                    if (the cad length of (the cad difference of (the item at other in welded) and location)) <= tolerance:
                        set slot to other
            if slot < 0:
                append location to welded
                set slot to (the length of welded) - 1
            append slot to mapping
        # Triangles grouped by plane: a unit normal and an offset each.
        set groupNormals to an empty list of a cad vector3
        set groupOffsets to an empty list of a 64 bit floating-point number
        set triangleGroups to an empty list of an integer
        set corner to 0
        loop while corner < the length of triangleCorners:
            set a to the item at (the item at corner in triangleCorners) in mapping
            set b to the item at (the item at (corner + 1) in triangleCorners) in mapping
            set c to the item at (the item at (corner + 2) in triangleCorners) in mapping
            set groupIndex to -1
            if ((a != b) and (b != c)) and (a != c):
                set pa to the item at a in welded
                set crossing to the cad cross of (the cad difference of (the item at b in welded) and pa) and (the cad difference of (the item at c in welded) and pa)
                set unit to the cad normalization of crossing
                if unit's valid:
                    set offset to the cad dot of unit's value and pa
                    loop group from 0 to the length of groupNormals:
                        if groupIndex < 0:
                            if (the cad dot of (the item at group in groupNormals) and unit's value) >= (1.0 - 1e-9):
                                if (the absolute value of ((the item at group in groupOffsets) - offset)) <= tolerance:
                                    set groupIndex to group
                    if groupIndex < 0:
                        append unit's value to groupNormals
                        append offset to groupOffsets
                        set groupIndex to (the length of groupNormals) - 1
            append groupIndex to triangleGroups
            set corner to corner + 3
        # Per group, the boundary: directed edges of its triangles whose
        # reverse is not among them, chained into loops.
        set loopsOfGroups to an empty list of the type of (an empty list of the type of (an empty list of an integer))
        loop group from 0 to the length of groupNormals:
            set starts to an empty list of an integer
            set ends to an empty list of an integer
            set corner to 0
            set triangleIndex to 0
            loop while corner < the length of triangleCorners:
                if (the item at triangleIndex in triangleGroups) = group:
                    loop side from 0 to 3:
                        set origin to the item at (the item at (corner + side) in triangleCorners) in mapping
                        set onto to the item at (the item at (corner + (the remainder of (side + 1) divided by 3)) in triangleCorners) in mapping
                        set reversed to -1
                        loop edge from 0 to the length of starts:
                            if reversed < 0:
                                if ((the item at edge in starts) = onto) and ((the item at edge in ends) = origin):
                                    set reversed to edge
                        if reversed >= 0:
                            replace item at index reversed in starts with -1
                            replace item at index reversed in ends with -1
                        else:
                            append origin to starts
                            append onto to ends
                set corner to corner + 3
                set triangleIndex to triangleIndex + 1
            set groupLoops to an empty list of the type of (an empty list of an integer)
            loop seed from 0 to the length of starts:
                if (the item at seed in starts) >= 0:
                    set ring to an empty list of an integer
                    set current to seed
                    set walking to true
                    loop while walking:
                        append (the item at current in starts) to ring
                        set edgeEnd to the item at current in ends
                        replace item at index current in starts with -1
                        set nextEdge to -1
                        loop edge from 0 to the length of starts:
                            if nextEdge < 0:
                                if (the item at edge in starts) = edgeEnd:
                                    set nextEdge to edge
                        if nextEdge < 0:
                            set walking to false
                        else:
                            set current to nextEdge
                    if (the length of ring) >= 3:
                        append ring to groupLoops
                    else:
                        free ring
            free starts
            free ends
            append groupLoops to loopsOfGroups
        # Corners on a straight edge: collinear with their neighbours in every
        # loop they appear in.
        set uses to an empty list of an integer
        set bent to an empty list of a boolean
        loop cursor from 0 to the length of welded:
            append 0 to uses
            append false to bent
        loop group from 0 to the length of loopsOfGroups:
            set groupLoops to the item at group in loopsOfGroups
            loop ringCursor from 0 to the length of groupLoops:
                set ring to the item at ringCursor in groupLoops
                set count to the length of ring
                loop place from 0 to count:
                    set here to the item at place in ring
                    set before to the item at (the remainder of ((place + count) - 1) divided by count) in ring
                    set after to the item at (the remainder of (place + 1) divided by count) in ring
                    replace item at index here in uses with ((the item at here in uses) + 1)
                    set inward to the cad difference of (the item at here in welded) and (the item at before in welded)
                    set outward to the cad difference of (the item at after in welded) and (the item at here in welded)
                    set across to the cad length of (the cad cross of inward and outward)
                    set scale to (the cad length of inward) * (the cad length of outward)
                    if (across > (1e-9 * scale)) or ((the cad dot of inward and outward) <= 0.0):
                        replace item at index here in bent with true
        set shape to an empty fast polyhedron
        set target to the address of shape
        set newIndex to an empty list of an integer
        loop cursor from 0 to the length of welded:
            append -1 to newIndex
        loop group from 0 to the length of loopsOfGroups:
            set groupLoops to the item at group in loopsOfGroups
            set normal to the item at group in groupNormals
            # The rings kept, with straight-edge corners left out.
            set kept to an empty list of the type of (an empty list of an integer)
            set areas to an empty list of a 64 bit floating-point number
            loop ringCursor from 0 to the length of groupLoops:
                set ring to the item at ringCursor in groupLoops
                set trimmed to an empty list of an integer
                loop place from 0 to the length of ring:
                    set here to the item at place in ring
                    if (the item at here in bent) or ((the item at here in uses) < 2):
                        if (the item at here in newIndex) < 0:
                            replace item at index here in newIndex with (add fast position (the item at here in welded) to target)
                        append (the item at here in newIndex) to trimmed
                if (the length of trimmed) >= 3:
                    set area to the cad zero vector3
                    set anchor to the item at (the item at 0 in trimmed) in (shape's positions's values)
                    loop place from 1 to (the length of trimmed) - 1:
                        set p to the cad difference of (the item at (the item at place in trimmed) in (shape's positions's values)) and anchor
                        set q to the cad difference of (the item at (the item at (place + 1) in trimmed) in (shape's positions's values)) and anchor
                        set area to the cad sum of area and (the cad cross of p and q)
                    append trimmed to kept
                    append (the cad dot of area and normal) to areas
                else:
                    free trimmed
            # Outer loops run counter-clockwise about the normal; each hole
            # goes to the smallest outer loop containing its first corner.
            loop outerCursor from 0 to the length of kept:
                if (the item at outerCursor in areas) > 0.0:
                    set holes to an empty list of the type of (an empty list of an integer)
                    loop holeCursor from 0 to the length of kept:
                        if (the item at holeCursor in areas) < 0.0:
                            set probe to the item at (the item at 0 in (the item at holeCursor in kept)) in (shape's positions's values)
                            set best to -1
                            loop candidate from 0 to the length of kept:
                                if (the item at candidate in areas) > 0.0:
                                    if fast point probe lies within corners (the item at candidate in kept) of (shape's positions's values) about normal:
                                        if best < 0:
                                            set best to candidate
                                        else if (the item at candidate in areas) < (the item at best in areas):
                                            set best to candidate
                            if best = outerCursor:
                                append (the item at holeCursor in kept) to holes
                    add fast face (the item at outerCursor in kept) with holes holes facing normal to target
                    free holes
            loop ringCursor from 0 to the length of kept:
                free (the item at ringCursor in kept)
            free kept
            free areas
        loop group from 0 to the length of loopsOfGroups:
            set groupLoops to the item at group in loopsOfGroups
            loop ringCursor from 0 to the length of groupLoops:
                free (the item at ringCursor in groupLoops)
            free groupLoops
        free loopsOfGroups
        free welded
        free mapping
        free groupNormals
        free groupOffsets
        free triangleGroups
        free uses
        free bent
        free newIndex
        return shape

# True when `probe` lies inside the loop `ring` (position indices into
# `points`), seen along `normal` (even-odd).
function fast point {cad vector3:probe} lies within corners {a pointer to a list:cornerRing} of {a pointer to a list:points} about {cad vector3:normal}:
    execute:
        # Project on the plane's two axes least aligned with the normal.
        set dropX to (the absolute value of normal's x) >= (the maximum of (the absolute value of normal's y) and (the absolute value of normal's z))
        set dropY to ((dropX = false) and ((the absolute value of normal's y) >= (the absolute value of normal's z)))
        set enclosed to false
        set count to the length of cornerRing
        loop place from 0 to count:
            set here to the item at (the item at place in cornerRing) in points
            set following to the item at (the item at (the remainder of (place + 1) divided by count) in cornerRing) in points
            set hu to here's x
            set hv to here's y
            set fu to following's x
            set fv to following's y
            set pu to probe's x
            set pv to probe's y
            if dropX:
                set hu to here's y
                set hv to here's z
                set fu to following's y
                set fv to following's z
                set pu to probe's y
                set pv to probe's z
            else if dropY:
                set hu to here's x
                set hv to here's z
                set fu to following's x
                set fv to following's z
                set pu to probe's x
                set pv to probe's z
            if (hv > pv) != (fv > pv):
                set crossingU to hu + (((pv - hv) / (fv - hv)) * (fu - hu))
                if pu < crossingU:
                    set enclosed to (enclosed = false)
        return enclosed
