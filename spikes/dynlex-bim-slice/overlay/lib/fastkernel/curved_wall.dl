# SPDX-License-Identifier: MPL-2.0
# Direct construction of a curved wall with through-openings as a planar
# polyhedron, without booleans. The wall's centreline is a circular arc; its
# sides follow the exterior and interior arcs in straight pieces, one per
# station. Stations lie at equal fractions of the arc's sweep, `pieceCount`
# of them, and at every opening's jambs. Openings have radial jambs: an
# opening `width` wide spans that length of the centreline, so it is wider on
# the outer arc and narrower on the inner one.
#
# Faces: the top cap; the bottom cap, in one piece between each pair of doors;
# per piece of each side, one face, or for a piece inside an opening the part
# below the sill (none for a door) and the part above the head; the two end
# faces; and the reveals: sill and head faces following the arcs, and two
# radial jambs per opening. Where a side face meets an opening's jamb its edge
# carries the jamb's sill and head corners, so every edge is shared by exactly
# two faces. Openings must lie inside both side faces, clear of the ends, the
# top and each other, and windows clear of the base; anything else is refused
# with the reasons of `lib/fastkernel/wall.dl`.
import lib/fastkernel/wall.dl

# The fraction of the sweep from `startAngle` at which `location` lies about
# `centre`, unclamped; a point in the gap past the end counts from the nearer
# end.
local function the fast fraction of {cad vector2:location} about {cad vector2:centre} from {a 64 bit floating-point number:startAngle} sweeping {a 64 bit floating-point number:sweep}:
    execute:
        set turned to @intrinsic("atan2", location's y - centre's y, location's x - centre's x) - startAngle
        if sweep < 0.0:
            set turned to 0.0 - turned
        set fullTurn to 6.283185307179586
        loop while turned < 0.0:
            set turned to turned + fullTurn
        loop while turned >= fullTurn:
            set turned to turned - fullTurn
        set magnitude to the absolute value of sweep
        if turned > magnitude:
            if (turned - magnitude) > (fullTurn - turned):
                return (turned - fullTurn) / magnitude
        return turned / magnitude

# The point at fraction `t` of the sweep, `reach` from `centre`.
local function the fast arc point at {a 64 bit floating-point number:t} about {cad vector2:centre} reaching {a 64 bit floating-point number:reach} from {a 64 bit floating-point number:startAngle} sweeping {a 64 bit floating-point number:sweep}:
    execute:
        set heading to startAngle + (t * sweep)
        return a cad vector2 with x (centre's x + (reach * (the cosine of heading))) and y (centre's y + (reach * (the sine of heading)))

local function the fast lifted {cad vector2:location} at {a 64 bit floating-point number:level}:
    execute:
        return a cad vector3 with x location's x, y location's y and z level

local function the fast four {integer:first}, {integer:second}, {integer:third} and {integer:fourth}:
    execute:
        set ring to an empty list of an integer
        append first to ring
        append second to ring
        append third to ring
        append fourth to ring
        return ring

# The horizontal unit normal of the vertical plane through `first` and
# `second`, turned to agree with `hint`.
local function the fast plane normal through {cad vector2:first} and {cad vector2:second} toward {cad vector2:hint}:
    execute:
        set dx to second's x - first's x
        set dy to second's y - first's y
        set magnitude to the square root of ((dx * dx) + (dy * dy))
        set nx to dy / magnitude
        set ny to (0.0 - dx) / magnitude
        if ((nx * hint's x) + (ny * hint's y)) < 0.0:
            set nx to 0.0 - nx
            set ny to 0.0 - ny
        return a cad vector3 with x nx, y ny and z 0.0

# Where the ray from `centre` through `toward` crosses the line through
# `first` and `second`.
local function the fast ray from {cad vector2:centre} through {cad vector2:toward} across {cad vector2:first} and {cad vector2:second}:
    execute:
        set ux to toward's x - centre's x
        set uy to toward's y - centre's y
        set ex to second's x - first's x
        set ey to second's y - first's y
        set denominator to (ux * ey) - (uy * ex)
        if (the absolute value of denominator) <= 1e-300:
            return toward
        set gx to first's x - centre's x
        set gy to first's y - centre's y
        set reach to ((gx * ey) - (gy * ex)) / denominator
        return a cad vector2 with x (centre's x + (reach * ux)) and y (centre's y + (reach * uy))

# One station: its fraction of the sweep and the opening whose jamb it is
# (-1 for none).
class:
    patterns:
        [a|] fast station record
    members:
        t as a 64 bit floating-point number
        jamb as an integer

# `corners` lists the footprint as start exterior, finish exterior, finish
# interior, start interior, its ends already cut to their joins. The
# centreline is the arc about `centre` of radius `arcRadius` from
# `startAngle` sweeping `sweep` (positive counter-clockwise); the exterior side
# is on the right of travel, `breadth` is the wall's thickness. `openings` is
# ordered by `along`, their distance along the centreline from its start.
function the fast curved wall on {a pointer to a list:corners} about {cad vector2:centre} spanning {a 64 bit floating-point number:arcRadius}, {a 64 bit floating-point number:startAngle} and {a 64 bit floating-point number:sweep} wide {a 64 bit floating-point number:breadth} in {integer:pieceCount} pieces from {a 64 bit floating-point number:elevation} rising {a 64 bit floating-point number:wallHeight} with {a pointer to a list:openings} within {a 64 bit floating-point number:tolerance}:
    execute:
        set refused to @intrinsic("construct", a fast wall result record, fast wall degenerate footprint, an empty fast polyhedron)
        set half to breadth * 0.5
        if ((the length of corners) != 4) or ((wallHeight <= tolerance) or (pieceCount < 1)):
            return refused
        if ((the absolute value of sweep) <= 1e-12) or ((arcRadius - half) <= tolerance):
            return refused
        set side to 1.0
        if sweep < 0.0:
            set side to -1.0
        set outerReach to arcRadius + (side * half)
        set innerReach to arcRadius - (side * half)
        set arcLength to arcRadius * (the absolute value of sweep)
        set startExterior to the item at 0 in corners
        set finishExterior to the item at 1 in corners
        set finishInterior to the item at 2 in corners
        set startInterior to the item at 3 in corners
        set low to the maximum of (the fast fraction of startExterior about centre from startAngle sweeping sweep) and (the fast fraction of startInterior about centre from startAngle sweeping sweep)
        set high to the minimum of (the fast fraction of finishExterior about centre from startAngle sweeping sweep) and (the fast fraction of finishInterior about centre from startAngle sweeping sweep)
        if high <= low:
            return refused
        set margin to tolerance / arcLength
        # Openings must lie inside both sides, clear of the base and top and of
        # each other.
        set previousRight to low
        loop cursor from 0 to the length of openings:
            set opening to the item at cursor in openings
            set leftT to (opening's along - (opening's width * 0.5)) / arcLength
            set rightT to (opening's along + (opening's width * 0.5)) / arcLength
            if (leftT <= (low + margin)) or (rightT >= (high - margin)):
                return @intrinsic("construct", a fast wall result record, fast wall opening outside face, an empty fast polyhedron)
            if (opening's sill < 0.0) or ((opening's sill + opening's height) >= (wallHeight - tolerance)):
                return @intrinsic("construct", a fast wall result record, fast wall opening outside face, an empty fast polyhedron)
            if ((opening's sill > 0.0) and (opening's sill <= tolerance)) or ((opening's width <= tolerance) or (opening's height <= tolerance)):
                return @intrinsic("construct", a fast wall result record, fast wall opening outside face, an empty fast polyhedron)
            if (leftT <= (previousRight + margin)) and (cursor > 0):
                return @intrinsic("construct", a fast wall result record, fast wall openings overlap, an empty fast polyhedron)
            set previousRight to rightT
        # Stations: the start corners, the equal fractions strictly inside,
        # each opening's two jambs, and the finish corners, in order.
        set stations to an empty list of a fast station record
        append (@intrinsic("construct", a fast station record, low, -1)) to stations
        set nextOpening to 0
        set atRight to false
        loop piece from 1 to pieceCount:
            set t to (piece as a 64 bit floating-point number) / (pieceCount as a 64 bit floating-point number)
            set placing to true
            loop while placing:
                set placing to false
                if nextOpening < (the length of openings):
                    set opening to the item at nextOpening in openings
                    set jambT to (opening's along - (opening's width * 0.5)) / arcLength
                    if atRight:
                        set jambT to (opening's along + (opening's width * 0.5)) / arcLength
                    if jambT <= t:
                        append (@intrinsic("construct", a fast station record, jambT, nextOpening)) to stations
                        if atRight:
                            set nextOpening to nextOpening + 1
                        set atRight to atRight = false
                        set placing to true
            set previousT to (the item at ((the length of stations) - 1) in stations)'s t
            if ((t > (low + 1e-9)) and (t < (high - 1e-9))) and (t > (previousT + 1e-9)):
                append (@intrinsic("construct", a fast station record, t, -1)) to stations
        loop while nextOpening < (the length of openings):
            set opening to the item at nextOpening in openings
            set jambT to (opening's along - (opening's width * 0.5)) / arcLength
            if atRight:
                set jambT to (opening's along + (opening's width * 0.5)) / arcLength
            append (@intrinsic("construct", a fast station record, jambT, nextOpening)) to stations
            if atRight:
                set nextOpening to nextOpening + 1
            set atRight to atRight = false
        append (@intrinsic("construct", a fast station record, high, -1)) to stations
        set count to the length of stations
        # The opening each piece between stations lies in, or -1.
        set pieceOpening to an empty list of an integer
        set inside to -1
        loop cursor from 0 to count - 1:
            set station to the item at cursor in stations
            if station's jamb >= 0:
                if inside = station's jamb:
                    set inside to -1
                else:
                    set inside to station's jamb
            append inside to pieceOpening
        # Positions. Station corners on the exterior (e) and interior (i)
        # sides at the base (b), top (t), sill (s) and head (h); a station
        # beside or inside an opening has sill and head corners, -1 elsewhere.
        set shape to an empty fast polyhedron
        set target to the address of shape
        set top to elevation + wallHeight
        set eBase to an empty list of an integer
        set eTop to an empty list of an integer
        set iBase to an empty list of an integer
        set iTop to an empty list of an integer
        set eSill to an empty list of an integer
        set eHead to an empty list of an integer
        set iSill to an empty list of an integer
        set iHead to an empty list of an integer
        # The side points: the corners at the ends, the arcs at the equal
        # fractions, and at a jamb the point on the straight piece between
        # its neighbours, so that the outline does not depend on openings.
        set outerPoints to an empty list of a cad vector2
        set innerPoints to an empty list of a cad vector2
        loop cursor from 0 to count:
            set station to the item at cursor in stations
            set outerPoint to the fast arc point at station's t about centre reaching outerReach from startAngle sweeping sweep
            set innerPoint to the fast arc point at station's t about centre reaching innerReach from startAngle sweeping sweep
            if cursor = 0:
                set outerPoint to startExterior
                set innerPoint to startInterior
            if cursor = (count - 1):
                set outerPoint to finishExterior
                set innerPoint to finishInterior
            append outerPoint to outerPoints
            append innerPoint to innerPoints
        loop cursor from 1 to count - 1:
            if (the item at cursor in stations)'s jamb >= 0:
                set before to cursor - 1
                loop while (the item at before in stations)'s jamb >= 0:
                    set before to before - 1
                set after to cursor + 1
                loop while (the item at after in stations)'s jamb >= 0:
                    set after to after + 1
                replace item at index cursor in outerPoints with (the fast ray from centre through (the item at cursor in outerPoints) across (the item at before in outerPoints) and (the item at after in outerPoints))
                replace item at index cursor in innerPoints with (the fast ray from centre through (the item at cursor in innerPoints) across (the item at before in innerPoints) and (the item at after in innerPoints))
        loop cursor from 0 to count:
            set outerPoint to the item at cursor in outerPoints
            set innerPoint to the item at cursor in innerPoints
            set station to the item at cursor in stations
            append (add fast position (the fast lifted outerPoint at elevation) to target) to eBase
            append (add fast position (the fast lifted outerPoint at top) to target) to eTop
            append (add fast position (the fast lifted innerPoint at elevation) to target) to iBase
            append (add fast position (the fast lifted innerPoint at top) to target) to iTop
            # The opening at this station: the jamb's, else the piece's after it.
            set here to station's jamb
            if (here < 0) and (cursor < (count - 1)):
                set here to the item at cursor in pieceOpening
            if here >= 0:
                set opening to the item at here in openings
                set sillLevel to elevation + opening's sill
                set headLevel to sillLevel + opening's height
                if opening's sill = 0.0:
                    append (the item at cursor in eBase) to eSill
                    append (the item at cursor in iBase) to iSill
                else:
                    append (add fast position (the fast lifted outerPoint at sillLevel) to target) to eSill
                    append (add fast position (the fast lifted innerPoint at sillLevel) to target) to iSill
                append (add fast position (the fast lifted outerPoint at headLevel) to target) to eHead
                append (add fast position (the fast lifted innerPoint at headLevel) to target) to iHead
            else:
                append -1 to eSill
                append -1 to iSill
                append -1 to eHead
                append -1 to iHead
        set noHoles to an empty list of the type of eBase
        set up to a cad vector3 with x 0.0, y 0.0 and z 1.0
        set down to a cad vector3 with x 0.0, y 0.0 and z -1.0
        # Top cap.
        set ring to an empty list of an integer
        loop cursor from 0 to count:
            append (the item at cursor in eTop) to ring
        set back to count - 1
        loop while back >= 0:
            append (the item at back in iTop) to ring
            set back to back - 1
        add fast face ring with holes noHoles facing up to target
        # Bottom cap, in pieces between doors.
        set pieceStart to -1
        loop cursor from 0 to count - 1:
            set openingIndex to the item at cursor in pieceOpening
            set isDoor to false
            if openingIndex >= 0:
                set isDoor to (the item at openingIndex in openings)'s sill = 0.0
            if isDoor = false:
                if pieceStart < 0:
                    set pieceStart to cursor
            if (isDoor or (cursor = (count - 2))) and (pieceStart >= 0):
                set pieceEnd to cursor + 1
                if isDoor:
                    set pieceEnd to cursor
                clear ring
                loop slot from pieceStart to pieceEnd + 1:
                    append (the item at slot in eBase) to ring
                set back to pieceEnd
                loop while back >= pieceStart:
                    append (the item at back in iBase) to ring
                    set back to back - 1
                add fast face ring with holes noHoles facing down to target
                set pieceStart to -1
        # Side faces, piece by piece. A piece's edge at a station carries that
        # station's sill and head corners when it has them.
        loop cursor from 0 to count - 1:
            set openingIndex to the item at cursor in pieceOpening
            set following to cursor + 1
            set outward to a cad vector2 with x ((the item at following in outerPoints)'s x - (the item at following in innerPoints)'s x) and y ((the item at following in outerPoints)'s y - (the item at following in innerPoints)'s y)
            set inward to a cad vector2 with x (0.0 - outward's x) and y (0.0 - outward's y)
            set outerNormal to the fast plane normal through (the item at cursor in outerPoints) and (the item at following in outerPoints) toward outward
            set innerNormal to the fast plane normal through (the item at cursor in innerPoints) and (the item at following in innerPoints) toward inward
            if openingIndex < 0:
                # Exterior: up the start edge's left side means: base, sill,
                # head, top at `cursor`, then top, head, sill, base at
                # `following`.
                clear ring
                append (the item at cursor in eBase) to ring
                append (the item at following in eBase) to ring
                if (the item at following in eSill) >= 0:
                    if (the item at following in eSill) != (the item at following in eBase):
                        append (the item at following in eSill) to ring
                    append (the item at following in eHead) to ring
                append (the item at following in eTop) to ring
                append (the item at cursor in eTop) to ring
                if (the item at cursor in eHead) >= 0:
                    append (the item at cursor in eHead) to ring
                    if (the item at cursor in eSill) != (the item at cursor in eBase):
                        append (the item at cursor in eSill) to ring
                add fast face ring with holes noHoles facing outerNormal to target
                clear ring
                append (the item at cursor in iBase) to ring
                append (the item at following in iBase) to ring
                if (the item at following in iSill) >= 0:
                    if (the item at following in iSill) != (the item at following in iBase):
                        append (the item at following in iSill) to ring
                    append (the item at following in iHead) to ring
                append (the item at following in iTop) to ring
                append (the item at cursor in iTop) to ring
                if (the item at cursor in iHead) >= 0:
                    append (the item at cursor in iHead) to ring
                    if (the item at cursor in iSill) != (the item at cursor in iBase):
                        append (the item at cursor in iSill) to ring
                add fast face ring with holes noHoles facing innerNormal to target
            else:
                set aboveOuter to the fast four (the item at cursor in eHead), (the item at following in eHead), (the item at following in eTop) and (the item at cursor in eTop)
                add fast face aboveOuter with holes noHoles facing outerNormal to target
                free aboveOuter
                set aboveInner to the fast four (the item at cursor in iHead), (the item at following in iHead), (the item at following in iTop) and (the item at cursor in iTop)
                add fast face aboveInner with holes noHoles facing innerNormal to target
                free aboveInner
                if (the item at openingIndex in openings)'s sill > 0.0:
                    set belowOuter to the fast four (the item at cursor in eBase), (the item at following in eBase), (the item at following in eSill) and (the item at cursor in eSill)
                    add fast face belowOuter with holes noHoles facing outerNormal to target
                    free belowOuter
                    set belowInner to the fast four (the item at cursor in iBase), (the item at following in iBase), (the item at following in iSill) and (the item at cursor in iSill)
                    add fast face belowInner with holes noHoles facing innerNormal to target
                    free belowInner
        # Reveals: per opening its sill (windows), head and two radial jambs.
        loop cursor from 0 to the length of openings:
            set opening to the item at cursor in openings
            set first to -1
            set last to -1
            loop slot from 0 to count:
                if (the item at slot in stations)'s jamb = cursor:
                    if first < 0:
                        set first to slot
                    else:
                        set last to slot
            clear ring
            loop slot from first to last + 1:
                append (the item at slot in eHead) to ring
            set back to last
            loop while back >= first:
                append (the item at back in iHead) to ring
                set back to back - 1
            add fast face ring with holes noHoles facing down to target
            if opening's sill > 0.0:
                clear ring
                loop slot from first to last + 1:
                    append (the item at slot in eSill) to ring
                set back to last
                loop while back >= first:
                    append (the item at back in iSill) to ring
                    set back to back - 1
                add fast face ring with holes noHoles facing up to target
            # The jambs face into the opening, along the arc.
            set forward to a cad vector2 with x ((the item at last in outerPoints)'s x - (the item at first in outerPoints)'s x) and y ((the item at last in outerPoints)'s y - (the item at first in outerPoints)'s y)
            set backward to a cad vector2 with x (0.0 - forward's x) and y (0.0 - forward's y)
            set leftJamb to the fast four (the item at first in eSill), (the item at first in eHead), (the item at first in iHead) and (the item at first in iSill)
            add fast face leftJamb with holes noHoles facing (the fast plane normal through (the item at first in outerPoints) and (the item at first in innerPoints) toward forward) to target
            free leftJamb
            set rightJamb to the fast four (the item at last in eSill), (the item at last in eHead), (the item at last in iHead) and (the item at last in iSill)
            add fast face rightJamb with holes noHoles facing (the fast plane normal through (the item at last in outerPoints) and (the item at last in innerPoints) toward backward) to target
            free rightJamb
        # The two end faces, facing away from the wall.
        set startAway to a cad vector2 with x ((the item at 0 in outerPoints)'s x - (the item at 1 in outerPoints)'s x) and y ((the item at 0 in outerPoints)'s y - (the item at 1 in outerPoints)'s y)
        set startEnd to the fast four (the item at 0 in eBase), (the item at 0 in iBase), (the item at 0 in iTop) and (the item at 0 in eTop)
        add fast face startEnd with holes noHoles facing (the fast plane normal through startExterior and startInterior toward startAway) to target
        free startEnd
        set finishAway to a cad vector2 with x ((the item at (count - 1) in outerPoints)'s x - (the item at (count - 2) in outerPoints)'s x) and y ((the item at (count - 1) in outerPoints)'s y - (the item at (count - 2) in outerPoints)'s y)
        set finishEnd to the fast four (the item at (count - 1) in eBase), (the item at (count - 1) in iBase), (the item at (count - 1) in iTop) and (the item at (count - 1) in eTop)
        add fast face finishEnd with holes noHoles facing (the fast plane normal through finishExterior and finishInterior toward finishAway) to target
        free finishEnd
        free ring
        free noHoles
        free stations
        free pieceOpening
        free eBase
        free eTop
        free iBase
        free iTop
        free eSill
        free eHead
        free iSill
        free iHead
        free outerPoints
        free innerPoints
        return @intrinsic("construct", a fast wall result record, fast wall built, shape)
