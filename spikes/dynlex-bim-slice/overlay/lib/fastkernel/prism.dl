# SPDX-License-Identifier: MPL-2.0
# A prism over a plan polygon with holes, built directly as a planar
# polyhedron: a slab with its openings, for instance. The bottom and top faces
# carry the polygon with its holes; every boundary edge gets a vertical side
# face, facing out of the outer ring and into each hole. Rings may run either
# way round; a ring with less than three points, no area, or a non-positive
# height is refused.
import lib/fastkernel/polyhedron.dl

function fast prism built:
    replacement:
        0
function fast prism degenerate:
    replacement:
        1

class:
    patterns:
        [a|] fast prism result record
    members:
        reason as an integer
        shape as a fast polyhedron record

local function the fast doubled area of {a pointer to a list:ring}:
    execute:
        set total to 0.0
        set anchor to the item at 0 in ring
        loop cursor from 1 to (the length of ring) - 1:
            set here to the item at cursor in ring
            set following to the item at (cursor + 1) in ring
            set total to total + (((here's x - anchor's x) * (following's y - anchor's y)) - ((following's x - anchor's x) * (here's y - anchor's y)))
        return total

local function a refused fast prism:
    execute:
        return @intrinsic("construct", a fast prism result record, fast prism degenerate, an empty fast polyhedron)

# `outline` is the outer ring, `holes` a list of rings, all in plan; the prism
# rises from `elevation` by `prismHeight`.
function the fast prism over {a pointer to a list:outline} with holes {a pointer to a list:holes} from {a 64 bit floating-point number:elevation} rising {a 64 bit floating-point number:prismHeight} within {a 64 bit floating-point number:tolerance}:
    execute:
        if prismHeight <= tolerance:
            return a refused fast prism
        set rings to an empty list of the type of outline
        append outline to rings
        loop cursor from 0 to the length of holes:
            append (the item at cursor in holes) to rings
        loop cursor from 0 to the length of rings:
            set ring to the item at cursor in rings
            if (the length of ring) < 3:
                free rings
                return a refused fast prism
            if (the absolute value of (the fast doubled area of ring)) <= (tolerance * tolerance):
                free rings
                return a refused fast prism
        set shape to an empty fast polyhedron
        set target to the address of shape
        set top to elevation + prismHeight
        set bottomRings to an empty list of the type of (an empty list of an integer)
        set topRings to an empty list of the type of (an empty list of an integer)
        loop cursor from 0 to the length of rings:
            set ring to the item at cursor in rings
            set bottomRing to an empty list of an integer
            set topRing to an empty list of an integer
            loop corner from 0 to the length of ring:
                set location to the item at corner in ring
                append (add fast position (a cad vector3 with x location's x, y location's y and z elevation) to target) to bottomRing
                append (add fast position (a cad vector3 with x location's x, y location's y and z top) to target) to topRing
            append bottomRing to bottomRings
            append topRing to topRings
        set bottomHoles to an empty list of the type of (an empty list of an integer)
        set topHoles to an empty list of the type of (an empty list of an integer)
        loop cursor from 1 to the length of rings:
            append (the item at cursor in bottomRings) to bottomHoles
            append (the item at cursor in topRings) to topHoles
        add fast face (the item at 0 in bottomRings) with holes bottomHoles facing (a cad vector3 with x 0.0, y 0.0 and z -1.0) to target
        add fast face (the item at 0 in topRings) with holes topHoles facing (a cad vector3 with x 0.0, y 0.0 and z 1.0) to target
        set noHoles to an empty list of the type of (an empty list of an integer)
        # Sides face away from the material: out of the outer ring, into holes.
        loop cursor from 0 to the length of rings:
            set ring to the item at cursor in rings
            set turn to 1.0
            if (the fast doubled area of ring) < 0.0:
                set turn to -1.0
            if cursor > 0:
                set turn to 0.0 - turn
            set count to the length of ring
            loop corner from 0 to count:
                set nextCorner to the remainder of (corner + 1) divided by count
                set here to the item at corner in ring
                set there to the item at nextCorner in ring
                set dx to there's x - here's x
                set dy to there's y - here's y
                set magnitude to the square root of ((dx * dx) + (dy * dy))
                if magnitude > 0.0:
                    set side to an empty list of an integer
                    append (the item at corner in (the item at cursor in bottomRings)) to side
                    append (the item at nextCorner in (the item at cursor in bottomRings)) to side
                    append (the item at nextCorner in (the item at cursor in topRings)) to side
                    append (the item at corner in (the item at cursor in topRings)) to side
                    add fast face side with holes noHoles facing (a cad vector3 with x ((turn * dy) / magnitude), y ((0.0 - (turn * dx)) / magnitude) and z 0.0) to target
                    free side
        loop cursor from 0 to the length of bottomRings:
            free (the item at cursor in bottomRings)
            free (the item at cursor in topRings)
        free bottomRings
        free topRings
        free bottomHoles
        free topHoles
        free noHoles
        free rings
        return @intrinsic("construct", a fast prism result record, fast prism built, shape)
