# SPDX-License-Identifier: MPL-2.0
# The Vulkan structures a renderer needs, mirrored field by field. DynLex lays
# out class members as C does (natural alignment), so a record's address can
# be passed to libvulkan directly. Handles of dispatchable objects (instance,
# physical device, device, queue, command buffer) are pointers; all other
# handles are 64-bit integers. Only the structures in use are defined.
import lib/string.dl

class:
    patterns:
        [a|] vk application info
    members:
        kind as a 32 bit unsigned integer
        next as a pointer
        applicationName as a C string
        applicationVersion as a 32 bit unsigned integer
        engineName as a C string
        engineVersion as a 32 bit unsigned integer
        apiVersion as a 32 bit unsigned integer

class:
    patterns:
        [a|] vk instance create info
    members:
        kind as a 32 bit unsigned integer
        next as a pointer
        flags as a 32 bit unsigned integer
        applicationInfo as a pointer
        layerCount as a 32 bit unsigned integer
        layerNames as a pointer
        extensionCount as a 32 bit unsigned integer
        extensionNames as a pointer

class:
    patterns:
        [a|] vk device queue create info
