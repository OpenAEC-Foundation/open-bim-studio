# SPDX-License-Identifier: MPL-2.0
# Fragment shader for text: the vertex colour, covered by the glyph atlas (a
# single-channel texture at bindings 30 and 31) as alpha.
import lib/shader.dl

set coverage to @intrinsic("extract element", @intrinsic("shader sample", 30, shader interpolant x named "uv", shader interpolant y named "uv"), 0)
set the fragment color with a red channel of (shader interpolant x named "tint"), a green channel of (shader interpolant y named "tint"), a blue channel of (shader interpolant z named "tint") and an alpha channel of ((shader interpolant w named "tint") * coverage)
