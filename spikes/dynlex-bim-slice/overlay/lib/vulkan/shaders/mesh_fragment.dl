# SPDX-License-Identifier: MPL-2.0
# Fragment shader of the GPU-resident 3D view: the normal is the corner
# normals interpolated across the triangle, so that a round surface is shaded
# round; where a corner carries none, the face's normal, the cross product of
# how the position changes across and down the screen. It is turned toward
# the viewer; the face is lit by the sun with a weaker
# light from the viewer, as the CPU renderer lit it. Parameters 16 to 18 hold
# the direction toward the sun, 19 to 21 the direction toward the viewer, and
# 22 the ordinal of the selected element (negative for none), which is drawn
# blue.
import lib/shader.dl

set ax to @intrinsic("shader derivative x", shader interpolant x named "place")
set ay to @intrinsic("shader derivative x", shader interpolant y named "place")
set az to @intrinsic("shader derivative x", shader interpolant z named "place")
set bx to @intrinsic("shader derivative y", shader interpolant x named "place")
set by to @intrinsic("shader derivative y", shader interpolant y named "place")
set bz to @intrinsic("shader derivative y", shader interpolant z named "place")
set nx to (ay * bz) - (az * by)
set ny to (az * bx) - (ax * bz)
set nz to (ax * by) - (ay * bx)
set size to @intrinsic("sqrt", ((nx * nx) + (ny * ny)) + (nz * nz))
if size > 0.0:
    set nx to nx / size
    set ny to ny / size
    set nz to nz / size
set sx to shader interpolant x named "smooth"
set sy to shader interpolant y named "smooth"
set sz to shader interpolant z named "smooth"
set smoothSize to @intrinsic("sqrt", ((sx * sx) + (sy * sy)) + (sz * sz))
if smoothSize > 0.5:
    set nx to sx / smoothSize
    set ny to sy / smoothSize
    set nz to sz / smoothSize
set eyeX to @intrinsic("shader buffer read", 0, 19)
set eyeY to @intrinsic("shader buffer read", 0, 20)
set eyeZ to @intrinsic("shader buffer read", 0, 21)
set facing to ((nx * eyeX) + (ny * eyeY)) + (nz * eyeZ)
if facing < 0.0:
    set nx to 0.0 - nx
    set ny to 0.0 - ny
    set nz to 0.0 - nz
    set facing to 0.0 - facing
set lit to ((nx * @intrinsic("shader buffer read", 0, 16)) + (ny * @intrinsic("shader buffer read", 0, 17))) + (nz * @intrinsic("shader buffer read", 0, 18))
if lit < 0.0:
    set lit to 0.0
set shade to (0.42 + (0.4 * lit)) + (0.18 * facing)
set red to shader interpolant x named "tint"
set green to shader interpolant y named "tint"
set blue to shader interpolant z named "tint"
set offset to (shader interpolant x named "pick") - @intrinsic("shader buffer read", 0, 22)
if (offset * offset) < 0.25:
    set red to 0.2745
    set green to 0.5098
    set blue to 0.8627
set the fragment color with a red channel of (red * shade), a green channel of (green * shade), a blue channel of (blue * shade) and an alpha channel of 1.0
