# Fragment shader for flat-coloured triangles: the vertex colour.
import lib/shader.dl

set the fragment color with a red channel of (shader interpolant x named "tint"), a green channel of (shader interpolant y named "tint"), a blue channel of (shader interpolant z named "tint") and an alpha channel of (shader interpolant w named "tint")
