# SPDX-License-Identifier: MPL-2.0
# Straight-alpha RGBA input; the standard screen pipeline blends it.
import lib/shader.dl
set sampled to @intrinsic("shader sample", 30, shader interpolant x named "uv", shader interpolant y named "uv")
set the fragment color with a red channel of (@intrinsic("extract element", sampled, 0)), a green channel of (@intrinsic("extract element", sampled, 1)), a blue channel of (@intrinsic("extract element", sampled, 2)) and an alpha channel of (@intrinsic("extract element", sampled, 3))
