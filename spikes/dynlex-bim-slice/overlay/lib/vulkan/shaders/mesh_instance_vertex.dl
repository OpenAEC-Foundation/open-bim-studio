# SPDX-License-Identifier: MPL-2.0
# Vertex shader of the 3D view's instances: a prototype's corners (the
# position at location 0, the smooth normal in "Attribute3") placed by the
# instance's transform, three rows of four in "Attribute4" to "Attribute6"
# (the axes' parts and the shift, relative to the scene's origin), with the
# instance's element ordinal in "Attribute1" and its colour in "Attribute2".
# The rest is as in `mesh_vertex.dl`: the same parameters and interpolants,
# so that the faces and edges take the mesh's fragment shaders.
import lib/shader.dl

set lx to the vertex x
set ly to the vertex y
set lz to the vertex z
set px to (((the vertex input named "Attribute4" x) * lx) + ((the vertex input named "Attribute4" y) * ly)) + (((the vertex input named "Attribute4" z) * lz) + (the vertex input named "Attribute4" w))
set py to (((the vertex input named "Attribute5" x) * lx) + ((the vertex input named "Attribute5" y) * ly)) + (((the vertex input named "Attribute5" z) * lz) + (the vertex input named "Attribute5" w))
set pz to (((the vertex input named "Attribute6" x) * lx) + ((the vertex input named "Attribute6" y) * ly)) + (((the vertex input named "Attribute6" z) * lz) + (the vertex input named "Attribute6" w))
# The normal turned with the axes (a uniform scale only lengthens it).
set ux to the vertex input named "Attribute3" x
set uy to the vertex input named "Attribute3" y
set uz to the vertex input named "Attribute3" z
set nx to (((the vertex input named "Attribute4" x) * ux) + ((the vertex input named "Attribute4" y) * uy)) + ((the vertex input named "Attribute4" z) * uz)
set ny to (((the vertex input named "Attribute5" x) * ux) + ((the vertex input named "Attribute5" y) * uy)) + ((the vertex input named "Attribute5" z) * uz)
set nz to (((the vertex input named "Attribute6" x) * ux) + ((the vertex input named "Attribute6" y) * uy)) + ((the vertex input named "Attribute6" z) * uz)
set normalSize to @intrinsic("sqrt", ((nx * nx) + (ny * ny)) + (nz * nz))
if normalSize > 0.000001:
    set nx to nx / normalSize
    set ny to ny / normalSize
    set nz to nz / normalSize
set clipX to (((@intrinsic("shader buffer read", 0, 0) * px) + (@intrinsic("shader buffer read", 0, 1) * py)) + (@intrinsic("shader buffer read", 0, 2) * pz)) + @intrinsic("shader buffer read", 0, 3)
set clipY to (((@intrinsic("shader buffer read", 0, 4) * px) + (@intrinsic("shader buffer read", 0, 5) * py)) + (@intrinsic("shader buffer read", 0, 6) * pz)) + @intrinsic("shader buffer read", 0, 7)
set clipZ to (((@intrinsic("shader buffer read", 0, 8) * px) + (@intrinsic("shader buffer read", 0, 9) * py)) + (@intrinsic("shader buffer read", 0, 10) * pz)) + @intrinsic("shader buffer read", 0, 11)
set clipW to (((@intrinsic("shader buffer read", 0, 12) * px) + (@intrinsic("shader buffer read", 0, 13) * py)) + (@intrinsic("shader buffer read", 0, 14) * pz)) + @intrinsic("shader buffer read", 0, 15)
set ordinal to the vertex input named "Attribute1" x
if @intrinsic("shader buffer read", 0, 49) > 0.5:
    if @intrinsic("shader buffer read", 0, 64.5 + ordinal) < 0.5:
        set clipX to 2.0
        set clipY to 0.0
        set clipZ to 0.5
        set clipW to 1.0
set the shader interpolant named "place" with an x coordinate of px, a y coordinate of py, a z coordinate of pz and a w coordinate of 1.0
# An element's colour: light grey in the hidden line view (parameter 37
# set); halfway to white where its flag is 2 (faint, as the 3D view's rules
# draw halftone). The ground and shadows keep theirs.
set tintRed to the vertex input named "Attribute2" x
set tintGreen to the vertex input named "Attribute2" y
set tintBlue to the vertex input named "Attribute2" z
if ordinal > -1.5:
    if @intrinsic("shader buffer read", 0, 37) > 0.5:
        set tintRed to 0.949
        set tintGreen to 0.949
        set tintBlue to 0.933
    if @intrinsic("shader buffer read", 0, 49) > 0.5:
        if @intrinsic("shader buffer read", 0, 64.5 + ordinal) > 1.5:
            set tintRed to (tintRed + 1.0) * 0.5
            set tintGreen to (tintGreen + 1.0) * 0.5
            set tintBlue to (tintBlue + 1.0) * 0.5
set the shader interpolant named "tint" with an x coordinate of tintRed, a y coordinate of tintGreen, a z coordinate of tintBlue and a w coordinate of 1.0
set the shader interpolant named "smooth" with an x coordinate of nx, a y coordinate of ny, a z coordinate of nz and a w coordinate of 0.0
set the shader interpolant named "pick" with an x coordinate of ordinal, a y coordinate of 0.0, a z coordinate of 0.0 and a w coordinate of 0.0
set the output position with x clipX, y clipY, z clipZ and w clipW
