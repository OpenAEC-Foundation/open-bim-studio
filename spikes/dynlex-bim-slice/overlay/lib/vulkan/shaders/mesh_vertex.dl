# SPDX-License-Identifier: MPL-2.0
# Vertex shader of the GPU-resident 3D view. A corner is stored once for the
# faces of an element that meet at it smoothly, with their averaged normal
# ("Attribute3", location 3, -1..1), so that a round surface is shaded round;
# where faces meet at a crease the corner is stored once per side. Inputs:
# the position (location 0), the colour ("Attribute2", location 2, 0..1) and
# the element's ordinal in "Attribute1" (location 1), for highlighting the
# selected element.
# Parameters, floats of the storage buffer at binding 0: 0 to 15 the
# view-projection matrix by rows.
import lib/shader.dl

set px to the vertex x
set py to the vertex y
set pz to the vertex z
set clipX to (((@intrinsic("shader buffer read", 0, 0) * px) + (@intrinsic("shader buffer read", 0, 1) * py)) + (@intrinsic("shader buffer read", 0, 2) * pz)) + @intrinsic("shader buffer read", 0, 3)
set clipY to (((@intrinsic("shader buffer read", 0, 4) * px) + (@intrinsic("shader buffer read", 0, 5) * py)) + (@intrinsic("shader buffer read", 0, 6) * pz)) + @intrinsic("shader buffer read", 0, 7)
set clipZ to (((@intrinsic("shader buffer read", 0, 8) * px) + (@intrinsic("shader buffer read", 0, 9) * py)) + (@intrinsic("shader buffer read", 0, 10) * pz)) + @intrinsic("shader buffer read", 0, 11)
set clipW to (((@intrinsic("shader buffer read", 0, 12) * px) + (@intrinsic("shader buffer read", 0, 13) * py)) + (@intrinsic("shader buffer read", 0, 14) * pz)) + @intrinsic("shader buffer read", 0, 15)
set the shader interpolant named "place" with an x coordinate of px, a y coordinate of py, a z coordinate of pz and a w coordinate of 1.0
set the shader interpolant named "tint" with an x coordinate of (the vertex input named "Attribute2" x), a y coordinate of (the vertex input named "Attribute2" y), a z coordinate of (the vertex input named "Attribute2" z) and a w coordinate of 1.0
set the shader interpolant named "smooth" with an x coordinate of (the vertex input named "Attribute3" x), a y coordinate of (the vertex input named "Attribute3" y), a z coordinate of (the vertex input named "Attribute3" z) and a w coordinate of 0.0
set the shader interpolant named "pick" with an x coordinate of (the vertex input named "Attribute1" x), a y coordinate of 0.0, a z coordinate of 0.0 and a w coordinate of 0.0
set the output position with x clipX, y clipY, z clipZ and w clipW
