# SPDX-License-Identifier: MPL-2.0
# RGBA images are immutable GPU resources, uploaded outside frame recording.
# Navigation only emits six vertices. Each image owns a descriptor pool so
# releasing it does not invalidate the glyph atlas or another image.
import lib/vulkan/graphics.dl
import lib/cadkernel/core.dl

function upload gpu rgba image sized {integer:width} by {integer:height} from {pointer:pixels} in {pointer:window}:
    execute:
        if ((width <= 0) or (height <= 0)) or ((width > 8192) or (height > 8192)):
            return -1
        set context to the gpu context of window
        set heldBytes to 0 as a 64 bit integer
        loop cursor from 0 to the length of (context's imageSlots):
            set held to the item at cursor in (context's imageSlots)
            set heldBytes to heldBytes + (((held's width as a 64 bit integer) * held's height) * 4)
        if (heldBytes + (((width as a 64 bit integer) * height) * 4)) > (268435456 as a 64 bit integer):
            return -1
        set made to a gpu sampled image sized width by height format 37 stride 4 from pixels in context
        set poolSizes to an empty list of a vk descriptor pool size
        append (@intrinsic("construct", a vk descriptor pool size, 7 as a 32 bit unsigned integer, 1 as a 32 bit unsigned integer)) to poolSizes
        append (@intrinsic("construct", a vk descriptor pool size, 2 as a 32 bit unsigned integer, 1 as a 32 bit unsigned integer)) to poolSizes
        append (@intrinsic("construct", a vk descriptor pool size, 0 as a 32 bit unsigned integer, 1 as a 32 bit unsigned integer)) to poolSizes
        set poolInfo to @intrinsic("construct", a vk descriptor pool create info, 33 as a 32 bit unsigned integer, 0 as a pointer, 0 as a 32 bit unsigned integer, 1 as a 32 bit unsigned integer, 3 as a 32 bit unsigned integer, (the data of poolSizes) as a pointer)
        set pool to 0 as a 64 bit unsigned integer
        check gpu (@intrinsic("call", "vulkan", "vkCreateDescriptorPool", an integer, context's device, the address of poolInfo, 0 as a pointer, the address of pool)) doing "image descriptor pool"
        free poolSizes
        set layout to context's setLayout
        set allocation to @intrinsic("construct", a vk descriptor set allocate info, 34 as a 32 bit unsigned integer, 0 as a pointer, pool, 1 as a 32 bit unsigned integer, the address of layout)
        set descriptor to 0 as a 64 bit unsigned integer
        check gpu (@intrinsic("call", "vulkan", "vkAllocateDescriptorSets", an integer, context's device, the address of allocation, the address of descriptor)) doing "image descriptor"
        set bufferInfo to @intrinsic("construct", a vk descriptor buffer info, context's parameters's handle, 0 as a 64 bit unsigned integer, ((gpu parameter count) * 4) as a 64 bit unsigned integer)
        set imageInfo to @intrinsic("construct", a vk descriptor image info, 0 as a 64 bit unsigned integer, made's view, 5 as a 32 bit unsigned integer)
        set samplerInfo to @intrinsic("construct", a vk descriptor image info, context's sampler, 0 as a 64 bit unsigned integer, 0 as a 32 bit unsigned integer)
        set writes to an empty list of a vk write descriptor set
        append (@intrinsic("construct", a vk write descriptor set, 35 as a 32 bit unsigned integer, 0 as a pointer, descriptor, 0 as a 32 bit unsigned integer, 0 as a 32 bit unsigned integer, 1 as a 32 bit unsigned integer, 7 as a 32 bit unsigned integer, 0 as a pointer, the address of bufferInfo, 0 as a pointer)) to writes
        append (@intrinsic("construct", a vk write descriptor set, 35 as a 32 bit unsigned integer, 0 as a pointer, descriptor, 30 as a 32 bit unsigned integer, 0 as a 32 bit unsigned integer, 1 as a 32 bit unsigned integer, 2 as a 32 bit unsigned integer, the address of imageInfo, 0 as a pointer, 0 as a pointer)) to writes
        append (@intrinsic("construct", a vk write descriptor set, 35 as a 32 bit unsigned integer, 0 as a pointer, descriptor, 31 as a 32 bit unsigned integer, 0 as a 32 bit unsigned integer, 1 as a 32 bit unsigned integer, 0 as a 32 bit unsigned integer, the address of samplerInfo, 0 as a pointer, 0 as a pointer)) to writes
        @intrinsic("call", "vulkan", "vkUpdateDescriptorSets", nothing, context's device, 3 as a 32 bit unsigned integer, the data of writes, 0 as a 32 bit unsigned integer, 0 as a pointer)
        free writes
        set made's pool to pool
        set made's descriptor to descriptor
        set fresh to the length of (context's imageSlots)
        append made to (context's imageSlots)
        return fresh

# Call after the last frame using the image has finished; tombstones keep
# other slot numbers stable. Repeated release is harmless.
function release gpu image slot {integer:slot} in {pointer:window}:
    execute:
        set context to the gpu context of window
        if (slot < 0) or (slot >= (the length of (context's imageSlots))):
            return nothing
        set held to the item at slot in (context's imageSlots)
        if held's image = (0 as a 64 bit unsigned integer):
            return nothing
        ignore @intrinsic("call", "vulkan", "vkDeviceWaitIdle", an integer, context's device)
        @intrinsic("call", "vulkan", "vkDestroyDescriptorPool", nothing, context's device, held's pool, 0 as a pointer)
        @intrinsic("call", "vulkan", "vkDestroyImageView", nothing, context's device, held's view, 0 as a pointer)
        @intrinsic("call", "vulkan", "vkDestroyImage", nothing, context's device, held's image, 0 as a pointer)
        @intrinsic("call", "vulkan", "vkFreeMemory", nothing, context's device, held's memory, 0 as a pointer)
        set held's image to 0 as a 64 bit unsigned integer
        set held's width to 0
        set held's height to 0
        replace item at index slot in (context's imageSlots) with held

# Corners are top left, top right, bottom right, bottom left, in pixels.
# The same six vertices can be retained by the normal GPU canvas recording.
function draw gpu image slot {integer:slot} through {cad vector2:first}, {cad vector2:second}, {cad vector2:third} and {cad vector2:fourth} in {graphics frame:frame}:
    execute:
        set context to the gpu context of frame's window
        if (slot < 0) or (slot >= (the length of (context's imageSlots))):
            return nothing
        if (the item at slot in (context's imageSlots))'s image = (0 as a 64 bit unsigned integer):
            return nothing
        start gpu batch of kind gpu image batch in context
        use vertex color red 255, green 255 and blue 255 in frame
        set gpu texture coordinates to 0.0 and 0.0 in context
        add gpu vertex at first's x, first's y and 0.0 in context
        set gpu texture coordinates to 1.0 and 0.0 in context
        add gpu vertex at second's x, second's y and 0.0 in context
        set gpu texture coordinates to 0.0 and 1.0 in context
        add gpu vertex at fourth's x, fourth's y and 0.0 in context
        set gpu texture coordinates to 0.0 and 1.0 in context
        add gpu vertex at fourth's x, fourth's y and 0.0 in context
        set gpu texture coordinates to 1.0 and 0.0 in context
        add gpu vertex at second's x, second's y and 0.0 in context
        set gpu texture coordinates to 1.0 and 1.0 in context
        add gpu vertex at third's x, third's y and 0.0 in context
        finish gpu batch in context
        if context's recordingCanvas:
            set batchIndex to (the length of (context's canvasBatches)) - 1
            set batchValue to the item at batchIndex in (context's canvasBatches)
            set batchValue's slot to slot
            replace item at index batchIndex in (context's canvasBatches) with batchValue
        else:
            set batchIndex to (the length of (context's batches)) - 1
            set batchValue to the item at batchIndex in (context's batches)
            set batchValue's slot to slot
            replace item at index batchIndex in (context's batches) with batchValue

function the gpu image slot named {a string:key} in {pointer:window}:
    execute:
        set context to the gpu context of window
        loop cursor from 0 to the length of (context's imageSlots):
            set held to the item at cursor in (context's imageSlots)
            if (held's key = key) and (held's image != (0 as a 64 bit unsigned integer)):
                return cursor
        return -1
