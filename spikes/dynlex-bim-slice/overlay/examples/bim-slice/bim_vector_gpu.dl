# SPDX-License-Identifier: MPL-2.0
# Model-space source triangles stay on the GPU. Camera-only frames change a
# single instance transform; unrelated document edits keep the same buffer.
import examples/bim-slice/bim_vector_data.dl
import examples/bim-slice/bim_view.dl
import lib/vulkan/graphics.dl

class:
    patterns:
        [a|] bim vector gpu cache record
    members:
        viewId as a 64 bit integer
        source as the type of (a cad topology list of a bim vector batch record)
        slot as an integer
        origin as a cad vector2
        uploads as an integer

function a new bim vector gpu cache:
    execute:
        return @intrinsic("construct", a bim vector gpu cache record, (-1) as a 64 bit integer, a cad topology list of a bim vector batch record, -1, (a cad vector2 with x 0.0 and y 0.0), 0)

function draw retained bim vectors of view {a 64 bit integer:viewId} from {bim vector cache record:dataCache} through {bim drawing transform record:transform} in {a pointer to a bim vector gpu cache record:cache} for {graphics frame:frame}:
    execute:
        if frame's drawable = false:
            return nothing
        set context to the gpu context of frame's window
        if cache's slot < 0:
            set cache's slot to reserve gpu canvas slots 1 in context
        select gpu canvas slot cache's slot in context
        if (cache's viewId != viewId) or (cache's source's values != dataCache's batches's values):
            set originValue to a cad vector2 with x 0.0 and y 0.0
            set foundOrigin to false
            begin gpu canvas recording in context
            start triangles in frame
            loop cursor from 0 to the length of (dataCache's batches's values):
                set batch to the item at cursor in (dataCache's batches's values)
                if (batch's viewId = viewId) and batch's valid:
                    use vertex color red batch's red, green batch's green and blue batch's blue in frame
                    loop vertexIndex from 0 to the length of (batch's corners's values):
                        set pointValue to the item at vertexIndex in (batch's corners's values)
                        if foundOrigin = false:
                            set originValue to pointValue
                            set foundOrigin to true
                        add a vertex at x (pointValue's x - originValue's x), y (originValue's y - pointValue's y) and z 0.0 to frame
            finish triangles in frame
            end gpu canvas recording in context
            set cache's source to dataCache's batches
            set cache's viewId to viewId
            set cache's origin to originValue
            set cache's uploads to cache's uploads + 1
        set dx to transform's centre's x + ((cache's origin's x - transform's origin's x) * transform's scale)
        set dy to transform's centre's y - ((cache's origin's y - transform's origin's y) * transform's scale)
        draw gpu canvas scaled by transform's scale shifted by dx and dy in context
