# Geometric execution of connection voids, separate from recipes and the editor.
import examples/bim-slice/bim_connections.dl
import examples/bim-slice/bim_component.dl
import lib/cadkernel/brep_place.dl

# Two equally sized, CCW profile rings bound a closed faceted stock solid.
function the connection stock from {a pointer to a list:vertices}:
    execute:
        set count to (the length of vertices) / 2
        set faces to an empty list of the type of (an empty list of an integer)
        set firstCap to an empty list of an integer
        set lastCap to an empty list of an integer
        loop cursor from 0 to count:
            append ((count - 1) - cursor) to firstCap
            append (count + cursor) to lastCap
        append firstCap to faces
        append lastCap to faces
        loop cursor from 0 to count:
            set following to the remainder of (cursor + 1) divided by count
            set ring to an empty list of an integer
            append cursor to ring
            append following to ring
            append (following + count) to ring
            append (cursor + count) to ring
            append ring to faces
        set built to the cad faceted solid with vertices vertices and faces faces within 1e-9
        loop cursor from 0 to the length of faces:
            free (the item at cursor in faces)
        free faces
        return built

# Twelve-sided display cutter; exact diameter and axis stay in the definition.
function the connection cutter of {connection void:cutValue}:
    execute:
        set forward to cutValue's direction
        set across to the cad cross of (a cad vector3 with x 0.0, y 0.0 and z 1.0) and forward
        if (the cad length of across) < 0.000001:
            set across to a cad vector3 with x 1.0, y 0.0 and z 0.0
        else:
            set across to across scaled by (1.0 / (the cad length of across))
        set upward to the cad cross of forward and across
        set vertices to an empty list of a cad vector3
        loop endIndex from 0 to 2:
            set advance to -0.00001 + ((endIndex as a 64 bit floating-point number) * (cutValue's depth + 0.00002))
            set centreValue to the cad sum of cutValue's origin and (forward scaled by advance)
            loop sideIndex from 0 to 12:
                set theta to (sideIndex as a 64 bit floating-point number) * (6.283185307179586 / 12.0)
                set radialX to across scaled by ((the cosine of theta) * (cutValue's diameter * 0.5))
                set radialY to upward scaled by ((the sine of theta) * (cutValue's diameter * 0.5))
                append (the cad sum of centreValue and (the cad sum of radialX and radialY)) to vertices
        set toolValue to the connection stock from vertices
        free vertices
        return toolValue

function the bim connection perforations of {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        set holes to a cad topology list of a connection void
        loop cursor from 0 to the length of (modelValue's connections's values):
            set spec to the item at cursor in (modelValue's connections's values)
            set belongs to false
            loop memberCursor from 0 to the length of (spec's members's values):
                if (the item at memberCursor in (spec's members's values))'s elementId = elementId:
                    set belongs to true
            if belongs:
                set generated to the bim connection evaluation of spec in modelValue
                if generated's valid:
                    loop voidCursor from 0 to the length of (generated's voids's values):
                        set cutValue to the item at voidCursor in (generated's voids's values)
                        if (cutValue's kind = 1) and (cutValue's memberId = elementId):
                            append cutValue to (holes's values)
        return holes

function the connection stock {cad body:stockValue} perforated by {a pointer to a list:cutters}:
    execute:
        set current to stockValue
        loop cursor from 0 to the length of cutters:
            set cutValue to the item at cursor in cutters
            set toolValue to the connection cutter of cutValue
            if toolValue's valid = false:
                return @intrinsic("construct", a bim component brep record, 2, an empty cad body)
            set changed to the cad combination of current and toolValue's value using cad difference operation within 1e-9
            if changed's valid = false:
                return @intrinsic("construct", a bim component brep record, 3, an empty cad body)
            set current to changed's value
        return @intrinsic("construct", a bim component brep record, 0, current)
