# The demonstration pavilion (bim_demo_pavilion.dl) loaded into the editor,
# kept apart so that the generator and its test need no editor.
import examples/bim-slice/bim_demo_pavilion.dl
import examples/bim-slice/bim_editor.dl

# The pavilion as the editor's model, in metres, with no undo history; the
# same record as `the bim demo pavilion`.
function make bim demo pavilion in {a pointer to a bim editor record:editor}:
    execute:
        set built to the bim demo pavilion
        load bim editor from text ((the bim file text of built's modelValue) + (the string form of "units m\n")) named (the string form of "") in editor
        set editor's documentValue's undoStack to a cad topology list of a bim model record
        set editor's documentValue's redoStack to a cad topology list of a bim model record
        set editor's message to the string form of "Demonstration model: concrete pavilion 12 x 8 m"
        return built
