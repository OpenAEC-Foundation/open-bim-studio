import lib/std.dl
# A bounded window onto any type library, independent of editor and GPU.
class:
    patterns:
        [a|] bim type menu range record
    members:
        first as an integer
        count as an integer
        lastOffset as an integer
function the bim type menu among {integer:total} showing {integer:visible} scrolled {integer:offset} marking {integer:chosen}:
    execute:
        set countValue to the minimum of (the maximum of total and 0) and (the maximum of visible and 1)
        set lastValue to the maximum of 0 and (total - countValue)
        set firstValue to offset
        if offset < 0:
            set firstValue to chosen - (countValue / 2)
        set firstValue to the minimum of lastValue and (the maximum of firstValue and 0)
        return @intrinsic("construct", a bim type menu range record, firstValue, countValue, lastValue)
