# SPDX-License-Identifier: MPL-2.0
# The drawings of the demonstration pavilion (`bim_demo_pavilion.dl`, 12 by
# 8 m on grids 1/2/3 and A/B/C): a ground floor plan with the grids
# dimensioned and the columns and beams tagged, two sections across the
# frame, the south elevation, and two A2 sheets at 1:50 with title block and
# legend. Everything it adds takes ids from 10000 up, which the generator
# leaves free. It reads the grids and the elements from the model; it adds
# nothing the model does not hold.
import examples/bim-slice/bim_view.dl
import examples/bim-slice/bim_sheet.dl

# What `add bim pavilion drawings` made: the views, the sheets and how many
# dimensions and tags; not valid when the model lacks the pavilion's grids.
class:
    patterns:
        [a|] bim pavilion drawings record
    members:
        valid as a boolean
        planId as a 64 bit integer
        alongId as a 64 bit integer
        acrossId as a 64 bit integer
        elevationId as a 64 bit integer
        planSheetId as a 64 bit integer
        sectionSheetId as a 64 bit integer
        dimensionCount as an integer
        tagCount as an integer

# The first id the drawings take.
function bim pavilion drawings first id:
    replacement:
        10000

# The scale of every drawing (1:50) and the paper (A2 landscape).
function bim pavilion drawings scale:
    replacement:
        50
function bim pavilion drawings paper:
    replacement:
        2

# The id of the grid named `wanted`, or the refused id.
local function the bim pavilion grid id named {a string:wanted} in {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's grids's values):
            set gridValue to the item at cursor in (modelValue's grids's values)
            if gridValue's name = wanted:
                return gridValue's id
        return the bim refused id

local function the bim pavilion grid record of {a 64 bit integer:gridId} in {bim model record:modelValue}:
    execute:
        return the item at (the bim grid index of gridId in modelValue)'s position in (modelValue's grids's values)

# A dimension between grid lines `firstGrid` and `secondGrid`, its line
# through `place`.
local function add bim pavilion dimension from grid {a 64 bit integer:firstGrid} to grid {a 64 bit integer:secondGrid} through {cad vector2:place} to {a pointer to a bim model record:target}:
    execute:
        set fromLine to @intrinsic("construct", a bim reference record, firstGrid, bim grid line feature)
        set toLine to @intrinsic("construct", a bim reference record, secondGrid, bim grid line feature)
        return add bim dimension from fromLine to toLine through place to target

# The view `viewId` at `scale`, cropped to `low` to `high` (model metres in
# plan, metres along the line and up in a section).
local function crop bim pavilion view {a 64 bit integer:viewId} from {cad vector2:low} to {cad vector2:high} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim view index of viewId in (@intrinsic("dereference", target))
        set viewValue to the item at found's position in (target's views's values)
        set viewValue's scale to bim pavilion drawings scale
        set viewValue's cropped to true
        set viewValue's cropLow to low
        set viewValue's cropHigh to high
        store bim view viewValue in target

# The id of the reinforcement marked `wanted`, or the refused id.
local function the bim pavilion reinforcement marked {a string:wanted} in {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's reinforcements's values):
            set spec to the item at cursor in (modelValue's reinforcements's values)
            if spec's mark = wanted:
                return spec's id
        return the bim refused id

# A tag of the reinforcement marked `wanted` at `place`, when the model has
# it; whether it was added.
local function tag bim pavilion reinforcement marked {a string:wanted} at {cad vector2:place} in {a pointer to a bim model record:target}:
    execute:
        set rebarId to the bim pavilion reinforcement marked wanted in (@intrinsic("dereference", target))
        if rebarId = the bim refused id:
            return false
        ignore (add bim tag of rebarId at place to target)
        return true

# How many millimetres `metres` of model take on the sheet at 1:50.
local function the bim pavilion paper length of {a 64 bit floating-point number:metres}:
    execute:
        return metres * (1000.0 / ((bim pavilion drawings scale) as a 64 bit floating-point number))

# View `viewId` on sheet `sheetId`, its frame's lower left corner at
# `corner` (millimetres on the sheet).
local function place bim pavilion view {a 64 bit integer:viewId} on sheet {a 64 bit integer:sheetId} from {cad vector2:corner} in {a pointer to a bim model record:target}:
    execute:
        set shownExtent to the bim model extent of view viewId in (@intrinsic("dereference", target))
        set halfAcross to (the bim pavilion paper length of (shownExtent's high's x - shownExtent's low's x)) * 0.5
        set halfUp to (the bim pavilion paper length of (shownExtent's high's y - shownExtent's low's y)) * 0.5
        set middle to a cad vector2 with x (corner's x + halfAcross) and y (corner's y + halfUp)
        return place bim view viewId on sheet sheetId at middle looking at (the bim model centre of view viewId in (@intrinsic("dereference", target))) in target

# Adds the pavilion's drawings to the model, the plan of storey `groundId`:
#
# - the plan, cropped to the grids' heads and the south elevation mark;
# - section 1 along the grids A/B between them, looking north, and section 2
#   across the bay between grids 2 and 3, looking west, so that each cuts
#   the walls, the beams across it and both floors without running along a
#   face;
# - the south elevation (a hidden line 3D view, which the plan marks);
# - the grids dimensioned bay by bay on the south and west sides and overall
#   on the north and east sides;
# - a tag beside every column and beam of the storey, and five
#   representative reinforcement marks;
# - sheet A-101 with the plan and sheet A-201 with both sections.
function add bim pavilion drawings to {a pointer to a bim model record:target} on level {a 64 bit integer:groundId}:
    execute:
        set noId to the bim refused id
        set unmade to @intrinsic("construct", a bim pavilion drawings record, false, noId, noId, noId, noId, noId, noId, 0, 0)
        set modelValue to @intrinsic("dereference", target)
        set grid1 to the bim pavilion grid id named (the string form of "1") in modelValue
        set grid2 to the bim pavilion grid id named (the string form of "2") in modelValue
        set grid3 to the bim pavilion grid id named (the string form of "3") in modelValue
        set gridA to the bim pavilion grid id named (the string form of "A") in modelValue
        set gridB to the bim pavilion grid id named (the string form of "B") in modelValue
        set gridC to the bim pavilion grid id named (the string form of "C") in modelValue
        set gridsFound to ((grid1 != noId) and ((grid2 != noId) and (grid3 != noId))) and ((gridA != noId) and ((gridB != noId) and (gridC != noId)))
        if (gridsFound = false) or ((the bim level index of groundId in modelValue)'s valid = false):
            return unmade
        if target's nextId < ((bim pavilion drawings first id) as a 64 bit integer):
            set target's nextId to (bim pavilion drawings first id) as a 64 bit integer
        # Where the grids run: 1/2/3 across x, A/B/C across y, and how far
        # their lines (and so their heads) reach.
        set x1 to (the bim pavilion grid record of grid1 in modelValue)'s start's x
        set x2 to (the bim pavilion grid record of grid2 in modelValue)'s start's x
        set x3 to (the bim pavilion grid record of grid3 in modelValue)'s start's x
        set yA to (the bim pavilion grid record of gridA in modelValue)'s start's y
        set yB to (the bim pavilion grid record of gridB in modelValue)'s start's y
        set yC to (the bim pavilion grid record of gridC in modelValue)'s start's y
        set reachLow to a cad vector2 with x 1e300 and y 1e300
        set reachHigh to a cad vector2 with x -1e300 and y -1e300
        loop cursor from 0 to the length of (modelValue's grids's values):
            set gridValue to the item at cursor in (modelValue's grids's values)
            set reachLow to a cad vector2 with x (the minimum of (reachLow's x) and (the minimum of (gridValue's start's x) and (gridValue's finish's x))) and y (the minimum of (reachLow's y) and (the minimum of (gridValue's start's y) and (gridValue's finish's y)))
            set reachHigh to a cad vector2 with x (the maximum of (reachHigh's x) and (the maximum of (gridValue's start's x) and (gridValue's finish's x))) and y (the maximum of (reachHigh's y) and (the maximum of (gridValue's start's y) and (gridValue's finish's y)))
        # The plan: the grids' heads (0.5 m across at 1:50) with a margin, and
        # the south elevation mark 3 m below what the plan holds.
        set planId to add bim view of kind bim plan view named (the string form of "Ground floor plan") on groundId to target
        set southReach to reachLow's y - 0.6
        set held to the bim plan extent of modelValue
        if held's valid:
            set southReach to the minimum of southReach and (held's low's y - 3.6)
        crop bim pavilion view planId from (a cad vector2 with x (reachLow's x - 0.6) and y southReach) to (a cad vector2 with x (reachHigh's x + 0.6) and y (reachHigh's y + 0.6)) in target
        # The sections, their lines ending 0.8 m inside the grids' heads.
        set alongY to (yA + yB) * 0.5
        set alongStart to a cad vector2 with x (reachLow's x + 0.8) and y alongY
        set alongFinish to a cad vector2 with x (reachHigh's x - 0.8) and y alongY
        set alongId to add bim section view from alongStart to alongFinish to target
        set acrossX to x2 + ((x3 - x2) / 3.0)
        set acrossStart to a cad vector2 with x acrossX and y (reachLow's y + 0.8)
        set acrossFinish to a cad vector2 with x acrossX and y (reachHigh's y - 0.8)
        set acrossId to add bim section view from acrossStart to acrossFinish to target
        # In a section: from below the footings to above the grids' heads
        # (the grids reach 4 m, their heads half a metre more).
        set sectionLow to -1.1
        set sectionHigh to 5.1
        crop bim pavilion view alongId from (a cad vector2 with x 0.0 and y sectionLow) to (a cad vector2 with x (the cad distance from alongStart to alongFinish) and y sectionHigh) in target
        crop bim pavilion view acrossId from (a cad vector2 with x 0.0 and y sectionLow) to (a cad vector2 with x (the cad distance from acrossStart to acrossFinish) and y sectionHigh) in target
        # The south elevation.
        set elevationId to add bim view of kind bim model view named (the bim elevation name of 3) on noId to target
        set elevationFound to the bim view index of elevationId in (@intrinsic("dereference", target))
        set elevationValue to the item at elevationFound's position in (target's views's values)
        set elevationValue's detail to 3 as a 64 bit integer
        set elevationValue's displayMode to bim hidden line display
        set elevationValue's scale to bim pavilion drawings scale
        store bim view elevationValue in target
        # The grids dimensioned: bays south and west, overall north and east,
        # each 1.1 m outside the outer grid, inside the grids' heads.
        set southLine to yA - 1.1
        set northLine to yC + 1.1
        set westLine to x1 - 1.1
        set eastLine to x3 + 1.1
        ignore (add bim pavilion dimension from grid grid1 to grid grid2 through (a cad vector2 with x ((x1 + x2) * 0.5) and y southLine) to target)
        ignore (add bim pavilion dimension from grid grid2 to grid grid3 through (a cad vector2 with x ((x2 + x3) * 0.5) and y southLine) to target)
        ignore (add bim pavilion dimension from grid grid1 to grid grid3 through (a cad vector2 with x ((x1 + x3) * 0.5) and y northLine) to target)
        ignore (add bim pavilion dimension from grid gridA to grid gridB through (a cad vector2 with x westLine and y ((yA + yB) * 0.5)) to target)
        ignore (add bim pavilion dimension from grid gridB to grid gridC through (a cad vector2 with x westLine and y ((yB + yC) * 0.5)) to target)
        ignore (add bim pavilion dimension from grid gridA to grid gridC through (a cad vector2 with x eastLine and y ((yA + yC) * 0.5)) to target)
        # Tags: beside each column (north east of it), under each beam along
        # x, and beside each beam along y, inside the building, clear of the
        # section lines.
        set tagged to 0
        set linearCount to the length of (target's linears's values)
        loop cursor from 0 to linearCount:
            set linearValue to the item at cursor in (target's linears's values)
            if linearValue's levelId = groundId:
                set runX to linearValue's finish's x - linearValue's start's x
                set runY to linearValue's finish's y - linearValue's start's y
                set midX to (linearValue's start's x + linearValue's finish's x) * 0.5
                set midY to (linearValue's start's y + linearValue's finish's y) * 0.5
                set tagSpot to a cad vector2 with x (midX + 0.75) and y (midY + 0.45)
                if (the absolute value of runX) > 0.01:
                    set tagSpot to a cad vector2 with x midX and y (midY - 0.45)
                else if (the absolute value of runY) > 0.01:
                    set tagSpot to a cad vector2 with x (midX + 0.9) and y (midY + 0.6)
                    if midX > ((x2 + x3) * 0.5):
                        set tagSpot to a cad vector2 with x (midX - 0.9) and y (midY + 0.6)
                ignore (add bim tag of (linearValue's id) at tagSpot to target)
                set tagged to tagged + 1
        # A few representative reinforcement marks rather than every cage: the
        # cage of column B2, of beam B 1-2, the pad under A1, the floor's mesh
        # and the east wall's area reinforcement, each with a leader.
        if tag bim pavilion reinforcement marked (the string form of "K-B2") at (a cad vector2 with x (x2 + 0.75) and y (yB - 0.45)) in target:
            set tagged to tagged + 1
        if tag bim pavilion reinforcement marked (the string form of "B-3") at (a cad vector2 with x ((x1 + x2) * 0.5) and y (yB + 0.45)) in target:
            set tagged to tagged + 1
        if tag bim pavilion reinforcement marked (the string form of "P-A1") at (a cad vector2 with x (x1 + 0.75) and y (yA - 0.45)) in target:
            set tagged to tagged + 1
        if tag bim pavilion reinforcement marked (the string form of "VL-NET") at (a cad vector2 with x ((x1 + x2) * 0.5) and y (((yA + yB) * 0.5) + 0.6)) in target:
            set tagged to tagged + 1
        if tag bim pavilion reinforcement marked (the string form of "W-OOST") at (a cad vector2 with x (x3 - 0.9) and y (yA + 1.0)) in target:
            set tagged to tagged + 1
        # The sheets: the plan on A-101, the sections on A-201 one above the
        # other; the title block and the legend keep the right hand side.
        set planSheetId to add bim sheet numbered (the string form of "A-101") named (the string form of "Ground floor plan") on paper (bim pavilion drawings paper) landscape true to target
        ignore (place bim pavilion view planId on sheet planSheetId from (a cad vector2 with x 25.0 and y 70.0) in target)
        set sectionSheetId to add bim sheet numbered (the string form of "A-201") named (the string form of "Sections 1 and 2") on paper (bim pavilion drawings paper) landscape true to target
        set sectionTall to the bim pavilion paper length of (sectionHigh - sectionLow)
        ignore (place bim pavilion view alongId on sheet sectionSheetId from (a cad vector2 with x 50.0 and y (390.0 - sectionTall)) in target)
        ignore (place bim pavilion view acrossId on sheet sectionSheetId from (a cad vector2 with x 50.0 and y (236.0 - sectionTall)) in target)
        return @intrinsic("construct", a bim pavilion drawings record, true, planId, alongId, acrossId, elevationId, planSheetId, sectionSheetId, 6, tagged)
