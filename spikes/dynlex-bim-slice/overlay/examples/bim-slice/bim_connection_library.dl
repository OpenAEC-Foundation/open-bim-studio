# SPDX-License-Identifier: MPL-2.0
# The connection type templates the editor offers, each a list of features
# over its participants (see `bim_model.dl`): steel (butt, mitre, end plate
# with optional stiffeners, fin plate, base plate, gusset), timber (mortise
# and tenon, half lap, slotted-in steel plate with dowels), concrete (corbel)
# and aluminium (angle cleat with screws). Role 0 is the member run into
# (the primary member), role 1 the member that frames into it.
import examples/bim-slice/bim_model.dl

# ---------------------------------------------------------------- measures

function a bim measure of {a 64 bit floating-point number:amount}:
    execute:
        return @intrinsic("construct", a bim quantity record, amount, -1, 0.0, -1, 0.0, -1, 0, 0.0, -1, 0, 0.0)

# `base` plus `factor` x parameter `index`, in its first free parameter term.
function the bim measure {bim quantity record:base} plus {a 64 bit floating-point number:factor} of parameter {integer:index}:
    execute:
        set result to base
        if result's parameter < 0:
            set result's parameter to index
            set result's parameterFactor to factor
        else:
            set result's secondParameter to index
            set result's secondFactor to factor
        return result

# `base` plus `factor` x dimension `code` of participant `index`'s profile,
# in its first free dimension term.
function the bim measure {bim quantity record:base} plus {a 64 bit floating-point number:factor} of dimension {integer:code} of role {integer:index}:
    execute:
        set result to base
        if result's role < 0:
            set result's role to index
            set result's dimension to code
            set result's dimensionFactor to factor
        else:
            set result's otherRole to index
            set result's otherDimension to code
            set result's otherFactor to factor
        return result

local function a bim parameter named {a string:label} of {a 64 bit floating-point number:amount} stepping {a 64 bit floating-point number:increment}:
    execute:
        return @intrinsic("construct", a bim parameter record, label, amount, increment)

# A feature of `kind` placed and acting on participant `index`, with every
# measure 0, one cylinder and no material.
function a bim feature of kind {integer:featureKind} on role {integer:index}:
    execute:
        set zero to a bim measure of 0.0
        return @intrinsic("construct", a bim feature record, featureKind, index, index, -1, bim end frame, 0, 0, 1, 1, the string form of "", zero, zero, zero, zero, zero, zero, zero, zero, zero)

local function a bim trim of role {integer:index} by {integer:trimMode} against {integer:otherIndex} set back {bim quantity record:setback}:
    execute:
        set result to a bim feature of kind bim trim feature on role index
        set result's mode to trimMode
        set result's other to otherIndex
        set result's offsetX to setback
        return result

local function a new bim connection type named {a string:label} joining {integer:count}:
    execute:
        return @intrinsic("construct", a bim connection type record, the bim refused id, label, count, a cad topology list of a bim parameter record, a cad topology list of a bim feature record)

# ---------------------------------------------------------------- steel

local function the bim butt template:
    execute:
        set made to a new bim connection type named (the string form of "Butt") joining 2
        append (a bim parameter named (the string form of "Gap") of 0.0 stepping 0.001) to (made's parameters's values)
        append (a bim trim of role 1 by bim trim to face against 0 set back (the bim measure (a bim measure of 0.0) plus 1.0 of parameter 0)) to (made's features's values)
        append (a bim trim of role 0 by bim trim covering against 1 set back (a bim measure of 0.0)) to (made's features's values)
        return made

local function the bim mitre template:
    execute:
        set made to a new bim connection type named (the string form of "Mitre") joining 2
        append (a bim parameter named (the string form of "Gap") of 0.0 stepping 0.001) to (made's parameters's values)
        append (a bim trim of role 0 by bim trim halving against 1 set back (the bim measure (a bim measure of 0.0) plus 0.5 of parameter 0)) to (made's features's values)
        append (a bim trim of role 1 by bim trim halving against 0 set back (the bim measure (a bim measure of 0.0) plus 0.5 of parameter 0)) to (made's features's values)
        return made

# Parameters: 0 gap, 1 plate thickness, 2 margin, 3 hole diameter, 4 bolt
# rows, 5 bolt columns, 6 bolt spread across, 7 weld throat, 8 stiffener
# thickness (0: none).
local function the bim end plate template named {a string:label} thick {a 64 bit floating-point number:thickness} with {integer:rowCount} rows and stiffeners {a 64 bit floating-point number:stiffening}:
    execute:
        set made to a new bim connection type named label joining 2
        append (a bim parameter named (the string form of "Gap") of 0.0 stepping 0.001) to (made's parameters's values)
        append (a bim parameter named (the string form of "Plate thickness") of thickness stepping 0.001) to (made's parameters's values)
        append (a bim parameter named (the string form of "Plate margin") of 0.015 stepping 0.005) to (made's parameters's values)
        append (a bim parameter named (the string form of "Hole diameter") of 0.026 stepping 0.002) to (made's parameters's values)
        append (a bim parameter named (the string form of "Bolt rows") of (rowCount as a 64 bit floating-point number) stepping 1.0) to (made's parameters's values)
        append (a bim parameter named (the string form of "Bolt columns") of 2.0 stepping 1.0) to (made's parameters's values)
        append (a bim parameter named (the string form of "Bolt spread across") of 0.1 stepping 0.005) to (made's parameters's values)
        append (a bim parameter named (the string form of "Weld throat") of 0.006 stepping 0.001) to (made's parameters's values)
        append (a bim parameter named (the string form of "Stiffener thickness") of stiffening stepping 0.002) to (made's parameters's values)
        set gapAndPlate to the bim measure (the bim measure (a bim measure of 0.0) plus 1.0 of parameter 0) plus 1.0 of parameter 1
        append (a bim trim of role 1 by bim trim to face against 0 set back gapAndPlate) to (made's features's values)
        append (a bim trim of role 0 by bim trim covering against 1 set back (a bim measure of 0.0)) to (made's features's values)
        # Feature 2: the board, behind the secondary member's end.
        set board to a bim feature of kind bim add block feature on role 1
        set board's material to the string form of "S235"
        set board's offsetX to the bim measure (a bim measure of 0.0) plus -1.0 of parameter 1
        set board's sizeX to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 1
        set board's sizeY to the bim measure (the bim measure (a bim measure of 0.0) plus 2.0 of parameter 2) plus 1.0 of dimension bim width dimension of role 1
        set board's sizeZ to the bim measure (the bim measure (a bim measure of 0.0) plus 2.0 of parameter 2) plus 1.0 of dimension bim depth dimension of role 1
        append board to (made's features's values)
        # Its bolt holes, and the bolts.
        set holes to a bim feature of kind bim cut cylinders feature on role 1
        set holes's target to -3
        set holes's offsetX to the bim measure (a bim measure of 0.0) plus -0.5 of parameter 1
        set holes's sizeX to the bim measure (a bim measure of 0.004) plus 1.0 of parameter 1
        set holes's countA to -6
        set holes's countB to -5
        set holes's extentA to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 6
        set holes's extentB to the bim measure (the bim measure (the bim measure (a bim measure of 0.0) plus 2.0 of parameter 2) plus -3.0 of parameter 3) plus 1.0 of dimension bim depth dimension of role 1
        set holes's diameter to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 3
        append holes to (made's features's values)
        set bolts to holes
        set bolts's kind to bim add cylinders feature
        set bolts's target to 1
        set bolts's material to the string form of "steel 8.8"
        set bolts's offsetX to the bim measure (a bim measure of -0.012) plus -0.5 of parameter 1
        set bolts's sizeX to the bim measure (a bim measure of 0.05) plus 1.0 of parameter 1
        set bolts's diameter to the bim measure (a bim measure of -0.002) plus 1.0 of parameter 3
        append bolts to (made's features's values)
        # Stiffeners in the primary member at the secondary member's flanges,
        # either side of its web.
        loop level from 0 to 2:
            loop side from 0 to 2:
                set stiffener to a bim feature of kind bim add block feature on role 0
                set stiffener's material to the string form of "S235"
                set stiffener's frameKind to bim other end frame
                set stiffener's other to 1
                set levelSign to 1.0
                if level = 1:
                    set levelSign to -1.0
                set sideSign to 1.0
                if side = 1:
                    set sideSign to -1.0
                set stiffener's offsetX to the bim measure (the bim measure (the bim measure (a bim measure of 0.0) plus -0.5 of parameter 8) plus (levelSign * 0.5) of dimension bim depth dimension of role 1) plus (levelSign * -0.5) of dimension bim flange dimension of role 1
                set stiffener's sizeX to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 8
                set stiffener's offsetY to the bim measure (the bim measure (a bim measure of 0.0) plus (sideSign * 0.25) of dimension bim width dimension of role 0) plus (sideSign * 0.25) of dimension bim web dimension of role 0
                set stiffener's sizeY to the bim measure (the bim measure (a bim measure of 0.0) plus 0.5 of dimension bim width dimension of role 0) plus -0.5 of dimension bim web dimension of role 0
                set stiffener's sizeZ to the bim measure (the bim measure (a bim measure of 0.0) plus 1.0 of dimension bim depth dimension of role 0) plus -2.0 of dimension bim flange dimension of role 0
                append stiffener to (made's features's values)
        return made

# Parameters: 0 gap, 1 board thickness, 2 margin top and bottom, 3 board
# length, 4 hole diameter, 5 bolt rows, 6 bolt columns, 7 bolt spread along.
local function the bim fin plate template:
    execute:
        set made to a new bim connection type named (the string form of "Fin plate 10, 3 M20") joining 2
        append (a bim parameter named (the string form of "Gap") of 0.015 stepping 0.001) to (made's parameters's values)
        append (a bim parameter named (the string form of "Plate thickness") of 0.01 stepping 0.001) to (made's parameters's values)
        append (a bim parameter named (the string form of "Plate margin") of 0.04 stepping 0.005) to (made's parameters's values)
        append (a bim parameter named (the string form of "Plate length") of 0.09 stepping 0.005) to (made's parameters's values)
        append (a bim parameter named (the string form of "Hole diameter") of 0.022 stepping 0.002) to (made's parameters's values)
        append (a bim parameter named (the string form of "Bolt rows") of 3.0 stepping 1.0) to (made's parameters's values)
        append (a bim parameter named (the string form of "Bolt columns") of 1.0 stepping 1.0) to (made's parameters's values)
        append (a bim parameter named (the string form of "Bolt spread along") of 0.06 stepping 0.005) to (made's parameters's values)
        append (a bim trim of role 1 by bim trim to face against 0 set back (the bim measure (a bim measure of 0.0) plus 1.0 of parameter 0)) to (made's features's values)
        append (a bim trim of role 0 by bim trim covering against 1 set back (a bim measure of 0.0)) to (made's features's values)
        # Feature 2: the board, from the primary member's face along one side
        # of the secondary member's web.
        set board to a bim feature of kind bim add block feature on role 1
        set board's material to the string form of "S235"
        set board's offsetX to the bim measure (a bim measure of 0.0) plus -1.0 of parameter 0
        set board's sizeX to the bim measure (the bim measure (a bim measure of 0.0) plus 1.0 of parameter 0) plus 1.0 of parameter 3
        set board's offsetY to the bim measure (the bim measure (a bim measure of 0.0) plus 0.5 of parameter 1) plus 0.5 of dimension bim web dimension of role 1
        set board's sizeY to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 1
        set board's sizeZ to the bim measure (the bim measure (a bim measure of 0.0) plus -2.0 of parameter 2) plus 1.0 of dimension bim depth dimension of role 1
        append board to (made's features's values)
        # Holes through the board, the same holes through the web, the bolts.
        set holes to a bim feature of kind bim cut cylinders feature on role 1
        set holes's target to -3
        set holes's axis to 1
        set holes's offsetX to the bim measure (the bim measure (a bim measure of 0.0) plus 0.5 of parameter 3) plus -0.5 of parameter 0
        set holes's offsetY to board's offsetY
        set holes's sizeX to the bim measure (a bim measure of 0.004) plus 1.0 of parameter 1
        set holes's countA to -7
        set holes's countB to -6
        set holes's extentA to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 7
        set holes's extentB to the bim measure (the bim measure (the bim measure (a bim measure of 0.0) plus -2.0 of parameter 2) plus -3.0 of parameter 4) plus 1.0 of dimension bim depth dimension of role 1
        set holes's diameter to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 4
        append holes to (made's features's values)
        set webHoles to holes
        set webHoles's target to 1
        set webHoles's offsetY to a bim measure of 0.0
        set webHoles's sizeX to the bim measure (a bim measure of 0.004) plus 1.0 of dimension bim web dimension of role 1
        append webHoles to (made's features's values)
        set bolts to holes
        set bolts's kind to bim add cylinders feature
        set bolts's target to 1
        set bolts's material to the string form of "steel 8.8"
        set bolts's offsetY to the bim measure (the bim measure (a bim measure of 0.0) plus 0.5 of parameter 1) plus 0.0 of dimension bim web dimension of role 1
        set bolts's sizeX to the bim measure (the bim measure (a bim measure of 0.03) plus 1.0 of parameter 1) plus 1.0 of dimension bim web dimension of role 1
        set bolts's diameter to the bim measure (a bim measure of -0.002) plus 1.0 of parameter 4
        append bolts to (made's features's values)
        return made

# One participant, the column. Parameters: 0 board thickness, 1 margin, 2
# hole diameter, 3 anchor rows, 4 anchor columns.
local function the bim base plate template:
    execute:
        set made to a new bim connection type named (the string form of "Base plate 25, 4 M24") joining 1
        append (a bim parameter named (the string form of "Plate thickness") of 0.025 stepping 0.001) to (made's parameters's values)
        append (a bim parameter named (the string form of "Plate margin") of 0.05 stepping 0.005) to (made's parameters's values)
        append (a bim parameter named (the string form of "Hole diameter") of 0.028 stepping 0.002) to (made's parameters's values)
        append (a bim parameter named (the string form of "Anchor rows") of 2.0 stepping 1.0) to (made's parameters's values)
        append (a bim parameter named (the string form of "Anchor columns") of 2.0 stepping 1.0) to (made's parameters's values)
        append (a bim trim of role 0 by bim trim square against -1 set back (the bim measure (a bim measure of 0.0) plus 1.0 of parameter 0)) to (made's features's values)
        set board to a bim feature of kind bim add block feature on role 0
        set board's material to the string form of "S235"
        set board's offsetX to the bim measure (a bim measure of 0.0) plus -1.0 of parameter 0
        set board's sizeX to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 0
        set board's sizeY to the bim measure (the bim measure (a bim measure of 0.0) plus 2.0 of parameter 1) plus 1.0 of dimension bim width dimension of role 0
        set board's sizeZ to the bim measure (the bim measure (a bim measure of 0.0) plus 2.0 of parameter 1) plus 1.0 of dimension bim depth dimension of role 0
        append board to (made's features's values)
        set holes to a bim feature of kind bim cut cylinders feature on role 0
        set holes's target to -2
        set holes's offsetX to the bim measure (a bim measure of 0.0) plus -0.5 of parameter 0
        set holes's sizeX to the bim measure (a bim measure of 0.004) plus 1.0 of parameter 0
        set holes's countA to -5
        set holes's countB to -4
        set holes's extentA to the bim measure (the bim measure (the bim measure (a bim measure of 0.0) plus 2.0 of parameter 1) plus -3.0 of parameter 2) plus 1.0 of dimension bim width dimension of role 0
        set holes's extentB to the bim measure (the bim measure (the bim measure (a bim measure of 0.0) plus 2.0 of parameter 1) plus -3.0 of parameter 2) plus 1.0 of dimension bim depth dimension of role 0
        set holes's diameter to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 2
        append holes to (made's features's values)
        set anchors to holes
        set anchors's kind to bim add cylinders feature
        set anchors's target to 0
        set anchors's material to the string form of "steel anchor"
        set anchors's offsetX to the bim measure (a bim measure of -0.15) plus -1.0 of parameter 0
        set anchors's sizeX to a bim measure of 0.4
        set anchors's diameter to the bim measure (a bim measure of -0.004) plus 1.0 of parameter 2
        append anchors to (made's features's values)
        return made

# Parameters: 0 gap, 1 board thickness, 2 margin. The gusset is 1.5 brace
# depths plus twice the margin high; the brace stops 0.6 of that short and
# is slotted for the rest.
local function the bim gusset template:
    execute:
        set made to a new bim connection type named (the string form of "Gusset 12") joining 2
        append (a bim parameter named (the string form of "Gap") of 0.01 stepping 0.001) to (made's parameters's values)
        append (a bim parameter named (the string form of "Plate thickness") of 0.012 stepping 0.001) to (made's parameters's values)
        append (a bim parameter named (the string form of "Plate margin") of 0.03 stepping 0.005) to (made's parameters's values)
        set setback to the bim measure (the bim measure (the bim measure (a bim measure of 0.0) plus 1.0 of parameter 0) plus 1.2 of parameter 2) plus 0.9 of dimension bim depth dimension of role 1
        append (a bim trim of role 1 by bim trim to face against 0 set back setback) to (made's features's values)
        set plate to a bim feature of kind bim add block feature on role 1
        set plate's material to the string form of "S235"
        set plate's offsetX to the bim measure (the bim measure (the bim measure (a bim measure of 0.0) plus -1.0 of parameter 0) plus -1.2 of parameter 2) plus -0.9 of dimension bim depth dimension of role 1
        set plate's sizeX to the bim measure (the bim measure (the bim measure (a bim measure of 0.0) plus 1.0 of parameter 0) plus 2.0 of parameter 2) plus 1.5 of dimension bim depth dimension of role 1
        set plate's sizeY to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 1
        set plate's sizeZ to the bim measure (the bim measure (a bim measure of 0.0) plus 2.0 of parameter 2) plus 1.5 of dimension bim depth dimension of role 1
        append plate to (made's features's values)
        set slot to a bim feature of kind bim cut block feature on role 1
        set slot's sizeX to the bim measure (the bim measure (a bim measure of 0.0) plus 0.8 of parameter 2) plus 0.6 of dimension bim depth dimension of role 1
        set slot's sizeY to the bim measure (a bim measure of 0.004) plus 1.0 of parameter 1
        set slot's sizeZ to the bim measure (a bim measure of 0.01) plus 1.0 of dimension bim depth dimension of role 1
        append slot to (made's features's values)
        return made

# ---------------------------------------------------------------- timber

# Parameters: 0 tenon length, 1 shoulder, 2 clearance. The tenon is a third
# of the secondary member's width thick.
local function the bim mortise and tenon template:
    execute:
        set made to a new bim connection type named (the string form of "Mortise and tenon") joining 2
        append (a bim parameter named (the string form of "Tenon length") of 0.06 stepping 0.005) to (made's parameters's values)
        append (a bim parameter named (the string form of "Shoulder") of 0.03 stepping 0.005) to (made's parameters's values)
        append (a bim parameter named (the string form of "Clearance") of 0.002 stepping 0.001) to (made's parameters's values)
        append (a bim trim of role 1 by bim trim to face against 0 set back (a bim measure of 0.0)) to (made's features's values)
        append (a bim trim of role 0 by bim trim covering against 1 set back (a bim measure of 0.0)) to (made's features's values)
        set peg to a bim feature of kind bim add block feature on role 1
        set peg's material to the string form of "timber C24"
        set peg's offsetX to the bim measure (a bim measure of 0.0) plus -1.0 of parameter 0
        set peg's sizeX to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 0
        set peg's sizeY to the bim measure (a bim measure of 0.0) plus 0.3333333333333333 of dimension bim width dimension of role 1
        set peg's sizeZ to the bim measure (the bim measure (a bim measure of 0.0) plus -2.0 of parameter 1) plus 1.0 of dimension bim depth dimension of role 1
        append peg to (made's features's values)
        set hollow to peg
        set hollow's kind to bim cut block feature
        set hollow's target to 0
        set hollow's material to the string form of ""
        set hollow's offsetX to the bim measure (the bim measure (a bim measure of 0.0) plus -1.0 of parameter 0) plus -1.0 of parameter 2
        set hollow's sizeX to the bim measure (the bim measure (a bim measure of 0.0) plus 1.0 of parameter 0) plus 1.0 of parameter 2
        set hollow's sizeY to the bim measure (the bim measure (a bim measure of 0.0) plus 2.0 of parameter 2) plus 0.3333333333333333 of dimension bim width dimension of role 1
        set hollow's sizeZ to the bim measure (the bim measure (the bim measure (a bim measure of 0.0) plus -2.0 of parameter 1) plus 2.0 of parameter 2) plus 1.0 of dimension bim depth dimension of role 1
        append hollow to (made's features's values)
        return made

# Both members run on over each other and each loses half its depth there.
local function the bim half lap template:
    execute:
        set made to a new bim connection type named (the string form of "Half lap") joining 2
        append (a bim parameter named (the string form of "Overrun") of 0.0 stepping 0.005) to (made's parameters's values)
        append (a bim trim of role 0 by bim trim covering against 1 set back (the bim measure (a bim measure of 0.0) plus -1.0 of parameter 0)) to (made's features's values)
        append (a bim trim of role 1 by bim trim covering against 0 set back (the bim measure (a bim measure of 0.0) plus -1.0 of parameter 0)) to (made's features's values)
        set upper to a bim feature of kind bim cut block feature on role 0
        set upper's sizeX to the bim measure (the bim measure (a bim measure of 0.0) plus 1.0 of parameter 0) plus 1.0 of dimension bim width dimension of role 1
        set upper's sizeY to the bim measure (a bim measure of 0.02) plus 1.0 of dimension bim width dimension of role 0
        set upper's offsetZ to the bim measure (a bim measure of 0.0) plus 0.25 of dimension bim depth dimension of role 0
        set upper's sizeZ to the bim measure (a bim measure of 0.0) plus 0.5 of dimension bim depth dimension of role 0
        append upper to (made's features's values)
        set lower to a bim feature of kind bim cut block feature on role 1
        set lower's sizeX to the bim measure (the bim measure (a bim measure of 0.0) plus 1.0 of parameter 0) plus 1.0 of dimension bim width dimension of role 0
        set lower's sizeY to the bim measure (a bim measure of 0.02) plus 1.0 of dimension bim width dimension of role 1
        set lower's offsetZ to the bim measure (a bim measure of 0.0) plus -0.25 of dimension bim depth dimension of role 1
        set lower's sizeZ to the bim measure (a bim measure of 0.0) plus 0.5 of dimension bim depth dimension of role 1
        append lower to (made's features's values)
        return made

# Parameters: 0 gap, 1 plate thickness, 2 slot length, 3 margin, 4 dowel
# diameter, 5 dowel rows, 6 dowel columns, 7 dowel spread along.
local function the bim dowelled plate template:
    execute:
        set made to a new bim connection type named (the string form of "Slotted plate, dowels") joining 2
        append (a bim parameter named (the string form of "Gap") of 0.01 stepping 0.001) to (made's parameters's values)
        append (a bim parameter named (the string form of "Plate thickness") of 0.008 stepping 0.001) to (made's parameters's values)
        append (a bim parameter named (the string form of "Slot length") of 0.2 stepping 0.01) to (made's parameters's values)
        append (a bim parameter named (the string form of "Plate margin") of 0.04 stepping 0.005) to (made's parameters's values)
        append (a bim parameter named (the string form of "Dowel diameter") of 0.012 stepping 0.002) to (made's parameters's values)
        append (a bim parameter named (the string form of "Dowel rows") of 3.0 stepping 1.0) to (made's parameters's values)
        append (a bim parameter named (the string form of "Dowel columns") of 2.0 stepping 1.0) to (made's parameters's values)
        append (a bim parameter named (the string form of "Dowel spread along") of 0.1 stepping 0.005) to (made's parameters's values)
        append (a bim trim of role 1 by bim trim to face against 0 set back (the bim measure (a bim measure of 0.0) plus 1.0 of parameter 0)) to (made's features's values)
        set slot to a bim feature of kind bim cut block feature on role 1
        set slot's sizeX to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 2
        set slot's sizeY to the bim measure (a bim measure of 0.002) plus 1.0 of parameter 1
        set slot's sizeZ to the bim measure (the bim measure (a bim measure of 0.0) plus -2.0 of parameter 3) plus 1.0 of dimension bim depth dimension of role 1
        append slot to (made's features's values)
        set board to a bim feature of kind bim add block feature on role 1
        set board's material to the string form of "S235"
        set board's offsetX to the bim measure (a bim measure of 0.0) plus -1.0 of parameter 0
        set board's sizeX to the bim measure (the bim measure (a bim measure of 0.0) plus 1.0 of parameter 0) plus 1.0 of parameter 2
        set board's sizeY to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 1
        set board's sizeZ to the bim measure (the bim measure (a bim measure of 0.0) plus -2.0 of parameter 3) plus 1.0 of dimension bim depth dimension of role 1
        append board to (made's features's values)
        set dowels to a bim feature of kind bim add cylinders feature on role 1
        set dowels's material to the string form of "steel dowel"
        set dowels's axis to 1
        set dowels's offsetX to the bim measure (a bim measure of 0.0) plus 0.5 of parameter 2
        set dowels's sizeX to the bim measure (a bim measure of 0.0) plus 1.0 of dimension bim width dimension of role 1
        set dowels's countA to -7
        set dowels's countB to -6
        set dowels's extentA to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 7
        set dowels's extentB to the bim measure (the bim measure (a bim measure of -0.06) plus -2.0 of parameter 3) plus 1.0 of dimension bim depth dimension of role 1
        set dowels's diameter to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 4
        append dowels to (made's features's values)
        set dowelHoles to dowels
        set dowelHoles's kind to bim cut cylinders feature
        set dowelHoles's material to the string form of ""
        set dowelHoles's sizeX to the bim measure (a bim measure of 0.01) plus 1.0 of dimension bim width dimension of role 1
        append dowelHoles to (made's features's values)
        return made

# ---------------------------------------------------------------- concrete

# Parameters: 0 gap, 1 bearing length, 2 corbel depth. The corbel stands out
# from the column's face under the beam's end, as wide as the beam.
local function the bim corbel template:
    execute:
        set made to a new bim connection type named (the string form of "Corbel") joining 2
        append (a bim parameter named (the string form of "Gap") of 0.02 stepping 0.005) to (made's parameters's values)
        append (a bim parameter named (the string form of "Bearing length") of 0.3 stepping 0.01) to (made's parameters's values)
        append (a bim parameter named (the string form of "Corbel depth") of 0.35 stepping 0.01) to (made's parameters's values)
        append (a bim trim of role 1 by bim trim to face against 0 set back (the bim measure (a bim measure of 0.0) plus 1.0 of parameter 0)) to (made's features's values)
        set bracket to a bim feature of kind bim add block feature on role 1
        set bracket's material to the string form of "concrete C30/37"
        set bracket's offsetX to the bim measure (a bim measure of 0.0) plus -1.0 of parameter 0
        set bracket's sizeX to the bim measure (the bim measure (a bim measure of 0.0) plus 1.0 of parameter 0) plus 1.0 of parameter 1
        set bracket's sizeY to the bim measure (a bim measure of 0.0) plus 1.0 of dimension bim width dimension of role 1
        set bracket's offsetZ to the bim measure (the bim measure (a bim measure of 0.0) plus -0.5 of parameter 2) plus -0.5 of dimension bim depth dimension of role 1
        set bracket's sizeZ to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 2
        append bracket to (made's features's values)
        return made

# ---------------------------------------------------------------- aluminium

# Parameters: 0 gap, 1 cleat thickness, 2 leg, 3 margin, 4 screw diameter,
# 5 screw rows. Two legs: one on the primary member's face beside the web,
# one along the web.
local function the bim angle cleat template:
    execute:
        set made to a new bim connection type named (the string form of "Angle cleat, screws") joining 2
        append (a bim parameter named (the string form of "Gap") of 0.005 stepping 0.001) to (made's parameters's values)
        append (a bim parameter named (the string form of "Cleat thickness") of 0.006 stepping 0.001) to (made's parameters's values)
        append (a bim parameter named (the string form of "Leg") of 0.08 stepping 0.005) to (made's parameters's values)
        append (a bim parameter named (the string form of "Margin") of 0.03 stepping 0.005) to (made's parameters's values)
        append (a bim parameter named (the string form of "Screw diameter") of 0.006 stepping 0.001) to (made's parameters's values)
        append (a bim parameter named (the string form of "Screw rows") of 3.0 stepping 1.0) to (made's parameters's values)
        append (a bim trim of role 1 by bim trim to face against 0 set back (the bim measure (a bim measure of 0.0) plus 1.0 of parameter 0)) to (made's features's values)
        set height to the bim measure (the bim measure (a bim measure of 0.0) plus -2.0 of parameter 3) plus 1.0 of dimension bim depth dimension of role 1
        set faceLeg to a bim feature of kind bim add block feature on role 1
        set faceLeg's material to the string form of "aluminium 6060"
        set faceLeg's offsetX to the bim measure (a bim measure of 0.0) plus -1.0 of parameter 0
        set faceLeg's sizeX to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 1
        set faceLeg's offsetY to the bim measure (the bim measure (a bim measure of 0.0) plus 0.5 of parameter 2) plus 0.5 of dimension bim web dimension of role 1
        set faceLeg's sizeY to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 2
        set faceLeg's sizeZ to height
        append faceLeg to (made's features's values)
        set webLeg to faceLeg
        set webLeg's sizeX to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 2
        set webLeg's offsetY to the bim measure (the bim measure (a bim measure of 0.0) plus 0.5 of parameter 1) plus 0.5 of dimension bim web dimension of role 1
        set webLeg's sizeY to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 1
        append webLeg to (made's features's values)
        set screws to a bim feature of kind bim add cylinders feature on role 1
        set screws's material to the string form of "stainless A2"
        set screws's axis to 1
        set screws's offsetX to the bim measure (the bim measure (a bim measure of 0.0) plus 0.5 of parameter 2) plus -0.5 of parameter 0
        set screws's offsetY to webLeg's offsetY
        set screws's sizeX to the bim measure (the bim measure (a bim measure of 0.02) plus 1.0 of parameter 1) plus 1.0 of dimension bim web dimension of role 1
        set screws's countA to 1
        set screws's countB to -6
        set screws's extentB to the bim measure (the bim measure (a bim measure of -0.03) plus -2.0 of parameter 3) plus 1.0 of dimension bim depth dimension of role 1
        set screws's diameter to the bim measure (a bim measure of 0.0) plus 1.0 of parameter 4
        append screws to (made's features's values)
        return made

# ---------------------------------------------------------------- the library

# Every template, in the order the editor lists them.
function the bim connection templates:
    execute:
        set offered to an empty list of a bim connection type record
        append (the bim butt template) to offered
        append (the bim mitre template) to offered
        append (the bim end plate template named (the string form of "End plate 15, 2x2 M24") thick 0.015 with 2 rows and stiffeners 0.0) to offered
        append (the bim end plate template named (the string form of "End plate 20, 4x2 M24") thick 0.02 with 4 rows and stiffeners 0.0) to offered
        append (the bim end plate template named (the string form of "End plate 20 + stiffeners") thick 0.02 with 4 rows and stiffeners 0.012) to offered
        append (the bim fin plate template) to offered
        append (the bim base plate template) to offered
        append (the bim gusset template) to offered
        append (the bim mortise and tenon template) to offered
        append (the bim half lap template) to offered
        append (the bim dowelled plate template) to offered
        append (the bim corbel template) to offered
        append (the bim angle cleat template) to offered
        return offered
