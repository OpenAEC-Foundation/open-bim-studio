# SPDX-License-Identifier: MPL-2.0
# NL-R1: identification data, never a structural design resistance table.
# See REINFORCEMENT-LIBRARY.md for evidence and deliberately unset properties.
import lib/text.dl

class:
    patterns:
        [a|] reinforcement steel entry
    members:
        valid as a boolean
        key as a string
        standard as a string
        status as a string
        historical as a boolean
        # Zero means NOT ESTABLISHED, never zero-strength material.
        nominalYieldMPa as a 64 bit floating-point number
        archivalYieldKgfCm2 as a 64 bit floating-point number
        ductility as a string
        source as a string

function the reinforcement steel named {a string:key}:
    execute:
        set entry to @intrinsic("construct", a reinforcement steel entry, false, key, the string form of "Unspecified", the string form of "Unverified identification", false, 0.0, 0.0, the string form of "Unverified", the string form of "-")
        if key = (the string form of "UNKNOWN"):
            set entry's valid to true
            set entry's status to the string form of "Material not assigned"
            return entry
        if ((key = (the string form of "B500A")) or (key = (the string form of "B500B"))) or (key = (the string form of "B500C")):
            set entry's valid to true
            set entry's standard to the string form of "NEN 6008:2008+A1:2020"
            set entry's status to the string form of "Nominal class; verify supplied steel"
            set entry's nominalYieldMPa to 500.0
            set entry's ductility to the substring of key from 4 spanning 1 bytes
            set entry's source to the string form of "https://www.nen.nl/nen-6008-2008-a1-2020-nl-265616"
            return entry
        set qrKeys to the string form of "QR22 QR24 QR32 QRN32 QR40 QRN40 QR48 QRN48"
        set candidates to qrKeys split at " "
        loop cursor from 0 to the length of candidates:
            if key = (the item at cursor in candidates):
                set entry's valid to true
        free candidates
        if entry's valid:
            set entry's historical to true
            set entry's standard to the string form of "GBV 1962 / archive identification"
            if key = (the string form of "QR22"):
                set entry's archivalYieldKgfCm2 to 2200.0
            if key = (the string form of "QR24"):
                set entry's archivalYieldKgfCm2 to 2400.0
            if (key = (the string form of "QR32")) or (key = (the string form of "QRN32")):
                set entry's archivalYieldKgfCm2 to 3200.0
            if (key = (the string form of "QR40")) or (key = (the string form of "QRN40")):
                set entry's archivalYieldKgfCm2 to 4000.0
            if (key = (the string form of "QR48")) or (key = (the string form of "QRN48")):
                set entry's archivalYieldKgfCm2 to 4800.0
            set entry's status to the string form of "Historical; strength and bond unverified"
            set entry's source to the string form of "https://repository.tudelft.nl/file/File_c3439949-2c4a-4e29-a0d4-8ecbc28e9d9f?preview=1"
            return entry
        set febKeys to the string form of "FEB220HWL FEB400HWL FEB400HK FEB500HWL FEB500HK FEB500HKN"
        set candidates to febKeys split at " "
        loop cursor from 0 to the length of candidates:
            if key = (the item at cursor in candidates):
                set entry's valid to true
        free candidates
        if entry's valid:
            set entry's historical to true
            set entry's standard to the string form of "VBC 1995 / archive identification"
            set entry's archivalYieldKgfCm2 to 5000.0
            if key = (the string form of "FEB220HWL"):
                set entry's archivalYieldKgfCm2 to 2200.0
            if (key = (the string form of "FEB400HWL")) or (key = (the string form of "FEB400HK")):
                set entry's archivalYieldKgfCm2 to 4000.0
            set entry's status to the string form of "Historical; verify original standard and tests"
            set entry's source to the string form of "https://repository.tudelft.nl/file/File_c3439949-2c4a-4e29-a0d4-8ecbc28e9d9f?preview=1"
        return entry
