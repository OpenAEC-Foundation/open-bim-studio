# SPDX-License-Identifier: MPL-2.0
# Schematic construction parameters, not supplier fabrication profiles.
import examples/bim-slice/bim_system_identity.dl

function the bim window operation of {a 64 bit integer:systemId} in {bim model record:modelValue}:
    execute:
        set recipeIndex to the bim system type index of systemId in modelValue
        if ((recipeIndex = 24) or (recipeIndex = 25)) or ((recipeIndex = 26) or (recipeIndex = 34)):
            return 1
        if ((recipeIndex = 28) or (recipeIndex = 29)) or (recipeIndex = 30):
            return 2
        if ((recipeIndex = 31) or (recipeIndex = 32)) or ((recipeIndex >= 36) and (recipeIndex <= 42)):
            return 3
        return 0

function the bim window track count of {a 64 bit integer:systemId} in {bim model record:modelValue}:
    execute:
        if (the bim window operation of systemId in modelValue) != 3:
            return 1
        set recipeIndex to the bim system type index of systemId in modelValue
        if ((recipeIndex = 32) or (recipeIndex = 38)) or ((recipeIndex = 40) or (recipeIndex = 42)):
            return 3
        return 2

function the bim window sash width of {a 64 bit integer:systemId} in {bim model record:modelValue}:
    execute:
        set reading to the bim setting (bim joint width setting) of systemId in modelValue
        set frameWidth to 0.05
        if reading's found:
            set frameWidth to (reading's value as a 64 bit floating-point number) / 1000.0
        return the maximum of 0.015 and (the minimum of 0.06 and (frameWidth * 0.8))

function the bim window sash depth of {a 64 bit integer:systemId} in {bim model record:modelValue}:
    execute:
        set reading to the bim setting (bim joint depth setting) of systemId in modelValue
        set frameDepth to 0.1
        if reading's found:
            set frameDepth to (reading's value as a 64 bit floating-point number) / 1000.0
        set tracks to the bim window track count of systemId in modelValue
        return the maximum of 0.008 and (the minimum of 0.068 and (frameDepth / ((tracks + 1) as a 64 bit floating-point number)))

function the bim window track offset {integer:trackIndex} of {a 64 bit integer:systemId} in {bim model record:modelValue}:
    execute:
        set tracks to the bim window track count of systemId in modelValue
        set depth to the bim window sash depth of systemId in modelValue
        return ((trackIndex as a 64 bit floating-point number) - (((tracks - 1) as a 64 bit floating-point number) * 0.5)) * (depth + 0.004)
