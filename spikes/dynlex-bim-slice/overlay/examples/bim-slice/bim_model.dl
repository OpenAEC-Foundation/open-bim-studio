# SPDX-License-Identifier: MPL-2.0
# Semantic model of the vertical BIM slice: one storey, compound wall types and
# walls on centrelines, parametric opening types and hosted openings, and
# dimensions that reference semantic features. Every element carries a stable
# 64-bit id that is never reused. Elements are immutable values: a change builds
# a new value and replaces the old one, so a shallow copy of the model is a
# complete snapshot for undo.
import lib/cadkernel/brep_topology.dl
import lib/cadkernel/arrangement2.dl
import lib/text.dl

# Feature kinds a dimension may reference. They name semantic features, never
# derived topology.
function bim wall start feature:
    replacement:
        0
function bim wall finish feature:
    replacement:
        1
function bim wall exterior feature:
    replacement:
        2
function bim wall interior feature:
    replacement:
        3
function bim opening left feature:
    replacement:
        4
function bim opening right feature:
    replacement:
        5

class:
    patterns:
        [a|] bim layer record
    members:
        material as a string
        thickness as a 64 bit floating-point number

class:
    patterns:
        [a|] bim wall type record
    members:
        id as a 64 bit integer
        name as a string
        layers as the type of (a cad topology list of a bim layer record)
        # The planar type's role (`bim wall planar role` and the others):
        # what its elements are, and so their IFC class.
        role as an integer

class:
    patterns:
        [a|] bim level record
    members:
        id as a 64 bit integer
        name as a string
        elevation as a 64 bit floating-point number
        height as a 64 bit floating-point number

# A wall runs along its centreline from `start` to `finish` on its level; the
# exterior side is on the right when walking from start to finish. A curved
# wall's centreline is a circular arc: `bulge` is the signed distance from the
# chord's middle to the arc's middle, positive toward the exterior side. A
# straight wall has bulge 0; the arc is at most a half circle.
class:
    patterns:
        [a|] bim wall record
    members:
        id as a 64 bit integer
        typeId as a 64 bit integer
        levelId as a 64 bit integer
        start as a cad vector2
        finish as a cad vector2
        height as a 64 bit floating-point number
        bulge as a 64 bit floating-point number
        # The wall's shape over its height: its top shifted `lean` metres
        # along the exterior normal (a wall leaning out or in), and its middle
        # height bowed `rise` metres out (a wall round in section); both 0
        # for an upright wall.
        lean as a 64 bit floating-point number
        rise as a 64 bit floating-point number
        # The wall's foot above its level's elevation (below when negative);
        # `height` is measured from the foot.
        baseOffset as a 64 bit floating-point number

# A parametric opening type: width, height, sill height and frame width are
# parameters; the rough opening cut into the host follows from formulas.
class:
    patterns:
        [a|] bim opening type record
    members:
        id as a 64 bit integer
        name as a string
        width as a 64 bit floating-point number
        height as a 64 bit floating-point number
        sill as a 64 bit floating-point number
        frame as a 64 bit floating-point number
        isDoor as a boolean

# An opening hosted on a wall, centred `offset` along the wall from its start.
class:
    patterns:
        [a|] bim opening record
    members:
        id as a 64 bit integer
        typeId as a 64 bit integer
        hostId as a 64 bit integer
        offset as a 64 bit floating-point number

class:
    patterns:
        [a|] bim reference record
    members:
        elementId as a 64 bit integer
        feature as an integer

# A drawing type (Drawing Rules): one kind of drawing, defined once in the
# model, that views follow. Each setting is inherited from `parentId` (the
# refused id for a root) or set here, so a child states only what differs:
# per category whether it is shown (-1 inherited, 0 hidden, 1 shown) and
# halftone (-1 inherited, 0 no, 1 yes), per annotation rule (`bim_view.dl`)
# whether it applies (-1 inherited, 0 off, 1 on), and the phase filter (-1
# inherited, else its code). Lists shorter than the categories or the rules
# inherit what they leave out.
class:
    patterns:
        [a|] bim drawing type record
    members:
        id as a 64 bit integer
        name as a string
        parentId as a 64 bit integer
        shown as the type of (a cad topology list of an integer)
        faint as the type of (a cad topology list of an integer)
        annotations as the type of (a cad topology list of an integer)
        phaseFilter as an integer

function the bim drawing type index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's drawingTypes's values)

# A new drawing type named `title` under `parentId` (the refused id for a
# root), inheriting everything; its id.
function add bim drawing type named {a string:title} under {a 64 bit integer:parentId} to {a pointer to a bim model record:target}:
    execute:
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim drawing type record, fresh, title, parentId, a cad topology list of an integer, a cad topology list of an integer, a cad topology list of an integer, -1)) to (target's drawingTypes's values)
        return fresh

# `settings` with entry `slot` set to `value`, padded with -1 (inherited).
function the bim settings {a pointer to a list:settings} changed at {integer:slot} into {integer:value}:
    execute:
        set updated to a cad topology list of an integer
        loop cursor from 0 to the length of settings:
            append (the item at cursor in settings) to (updated's values)
        loop while (the length of (updated's values)) <= slot:
            append -1 to (updated's values)
        replace item at index slot in (updated's values) with value
        return updated

# Sets one setting of drawing type `typeId`: `which` 0 a category's shown,
# 1 a category's halftone, 2 an annotation rule, 3 the phase filter (`slot`
# unused); `value` -1 makes it inherited again. False when there is no such
# type.
function set bim drawing type {a 64 bit integer:typeId} setting {integer:which} at {integer:slot} to {integer:value} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim drawing type index of typeId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set original to the item at found's position in (target's drawingTypes's values)
        set shownList to the cad clone of original's shown
        set faintList to the cad clone of original's faint
        set ruleList to the cad clone of original's annotations
        set filter to original's phaseFilter
        if which = 0:
            set shownList to the bim settings (original's shown's values) changed at slot into value
        if which = 1:
            set faintList to the bim settings (original's faint's values) changed at slot into value
        if which = 2:
            set ruleList to the bim settings (original's annotations's values) changed at slot into value
        if which = 3:
            set filter to value
        replace item at index found's position in (target's drawingTypes's values) with (@intrinsic("construct", a bim drawing type record, original's id, original's name, original's parentId, shownList, faintList, ruleList, filter))
        note bim change of typeId in target
        return true

# A phase of the project (existing, new construction …), in the order the
# model lists them: the first is the earliest.
class:
    patterns:
        [a|] bim phase record
    members:
        id as a 64 bit integer
        name as a string

# When element `id` was built and demolished: phase ids, `createdId` the
# refused id for the last phase and `demolishedId` the refused id for never.
# Kept apart from the elements, in the order of their ids, so that every kind
# of element can have one; an element without one is new in the last phase,
# an opening without one follows its wall.
class:
    patterns:
        [a|] bim phasing record
    members:
        id as a 64 bit integer
        createdId as a 64 bit integer
        demolishedId as a 64 bit integer

function the bim phase index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's phases's values)

# A new phase named `title`, after the others; its id.
function add bim phase named {a string:title} to {a pointer to a bim model record:target}:
    execute:
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim phase record, fresh, title)) to (target's phases's values)
        return fresh

# The phases every model starts from, added once when it has none: Existing
# and New construction.
function ensure bim phases in {a pointer to a bim model record:target}:
    execute:
        if (the length of (target's phases's values)) > 0:
            return nothing
        ignore add bim phase named (the string form of "Existing") to target
        ignore add bim phase named (the string form of "New construction") to target

# Where phase `phaseId` falls in the model's order: 0 the first; the refused
# id (or a missing phase) the last.
function the bim phase order of {a 64 bit integer:phaseId} in {bim model record:modelValue}:
    execute:
        set found to the bim phase index of phaseId in modelValue
        if found's valid:
            return found's position
        return the maximum of 0 and ((the length of (modelValue's phases's values)) - 1)

# The phasing of element `elementId`: its own, or new in the last phase and
# never demolished.
function the bim phasing of element {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        set found to the bim position of elementId among (modelValue's phasings's values)
        if found's valid:
            return the item at found's position in (modelValue's phasings's values)
        # An opening without its own follows the wall it is in.
        set openingFound to the bim opening index of elementId in modelValue
        if openingFound's valid:
            set hostId to (the item at openingFound's position in (modelValue's openings's values))'s hostId
            set hostFound to the bim position of hostId among (modelValue's phasings's values)
            if hostFound's valid:
                set hostPhasing to the item at hostFound's position in (modelValue's phasings's values)
                return @intrinsic("construct", a bim phasing record, elementId, hostPhasing's createdId, hostPhasing's demolishedId)
        return @intrinsic("construct", a bim phasing record, elementId, the bim refused id, the bim refused id)

# Element `elementId` built in phase `createdId` and demolished in
# `demolishedId` (the refused ids for the last phase and never).
function set bim element {a 64 bit integer:elementId} built in {a 64 bit integer:createdId} demolished in {a 64 bit integer:demolishedId} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim position of elementId among (target's phasings's values)
        set plain to (createdId = the bim refused id) and (demolishedId = the bim refused id)
        set entry to @intrinsic("construct", a bim phasing record, elementId, createdId, demolishedId)
        if found's valid:
            if plain:
                remove item found's position from (target's phasings's values)
            else:
                replace item at index found's position in (target's phasings's values) with entry
        else if plain = false:
            set slot to the bim insertion position of elementId among (target's phasings's values)
            insert entry into (target's phasings's values) at index slot
        note bim change of elementId in target

# ---------------------------------------------------------------- building system panels

# The panel type of a building system (`curtainId`): for its panel `panel`
# (bay by bay, each bay's rows from the bottom), or for every panel when
# `panel` is -1. `typeId` is a planar type, whose layers the panel is built
# of; a panel without one is glass.
class:
    patterns:
        [a|] bim system panel record
    members:
        curtainId as a 64 bit integer
        panel as an integer
        typeId as a 64 bit integer

# The planar type panel `panel` of building system `curtainId` is built of:
# its own, else the system's, else the refused id (glass).
function the bim panel type of panel {integer:panelIndex} of system {a 64 bit integer:curtainId} in {bim model record:modelValue}:
    execute:
        set whole to the bim refused id
        loop cursor from 0 to the length of (modelValue's systemPanels's values):
            set entry to the item at cursor in (modelValue's systemPanels's values)
            if entry's curtainId = curtainId:
                if entry's panel = panelIndex:
                    return entry's typeId
                if entry's panel = -1:
                    set whole to entry's typeId
        return whole

# Panel `panelIndex` (-1: every panel) of building system `curtainId` is
# built of planar type `typeId`; the refused id drops the setting, so the
# panel follows the system again (or the system is glass again).
function set bim panel {integer:panelIndex} of system {a 64 bit integer:curtainId} to type {a 64 bit integer:typeId} in {a pointer to a bim model record:target}:
    execute:
        set slot to -1
        loop cursor from 0 to the length of (target's systemPanels's values):
            set entry to the item at cursor in (target's systemPanels's values)
            if (entry's curtainId = curtainId) and (entry's panel = panelIndex):
                set slot to cursor
        if slot >= 0:
            remove item slot from (target's systemPanels's values)
        if typeId != the bim refused id:
            append (@intrinsic("construct", a bim system panel record, curtainId, panelIndex, typeId)) to (target's systemPanels's values)
        note bim change of curtainId in target

# The panel types of building system `curtainId` as text: their count, then
# each panel and its type, all separated by spaces; empty when it has none.
function the bim panel text of system {a 64 bit integer:curtainId} in {bim model record:modelValue}:
    execute:
        set count to 0
        set panelWords to the string form of ""
        loop cursor from 0 to the length of (modelValue's systemPanels's values):
            set entry to the item at cursor in (modelValue's systemPanels's values)
            if entry's curtainId = curtainId:
                set count to count + 1
                set panelWords to ((panelWords + (the string form of " ")) + (the string form of entry's panel)) + ((the string form of " ") + (the string form of entry's typeId))
        if count = 0:
            return the string form of ""
        return (the string form of count) + panelWords

# The states an element is in, seen in a view's phase.
function bim phase absent:
    replacement:
        0
function bim phase existing:
    replacement:
        1
function bim phase demolished:
    replacement:
        2
function bim phase new:
    replacement:
        3

# The state of element `elementId` seen in phase `viewPhaseId`: absent when
# built later or demolished earlier; demolished when demolished in it; new
# when built in it; else existing.
function the bim phase state of element {a 64 bit integer:elementId} seen in {a 64 bit integer:viewPhaseId} in {bim model record:modelValue}:
    execute:
        set viewOrder to the bim phase order of viewPhaseId in modelValue
        set elementPhasing to the bim phasing of element elementId in modelValue
        set builtOrder to the bim phase order of elementPhasing's createdId in modelValue
        if builtOrder > viewOrder:
            return bim phase absent
        if elementPhasing's demolishedId != the bim refused id:
            set goneOrder to the bim phase order of elementPhasing's demolishedId in modelValue
            if goneOrder < viewOrder:
                return bim phase absent
            if goneOrder = viewOrder:
                return bim phase demolished
        if builtOrder = viewOrder:
            return bim phase new
        return bim phase existing

# A view of the model, kept with it, as in Revit: what it shows (`kind`: a
# plan, a ceiling plan, a section, the 3D view or a schedule), of which
# storey (`levelId`, for plans), with `detail` (a schedule's code, a
# section's number), its plan cut `cutHeight` above the storey, its drawing
# `scale` (100 for 1:100), a crop rectangle when `cropped`, and its rules:
# per category (`bim_view.dl`) whether it is shown and whether in halftone.
class:
    patterns:
        [a|] bim view definition record
    members:
        id as a 64 bit integer
        kind as an integer
        name as a string
        levelId as a 64 bit integer
        detail as a 64 bit integer
        cutHeight as a 64 bit floating-point number
        scale as an integer
        cropped as a boolean
        cropLow as a cad vector2
        cropHigh as a cad vector2
        shown as the type of (a cad topology list of a boolean)
        faint as the type of (a cad topology list of a boolean)
        # A section's line in plan, looking to its left.
        lineStart as a cad vector2
        lineFinish as a cad vector2
        # The drawing type the view follows (`bim drawing type record`), or
        # the refused id; when `automatic`, its rules are the type's, else
        # its own.
        drawingTypeId as a 64 bit integer
        automatic as a boolean
        # The phase the view shows the model in; the refused id for the last.
        phaseId as a 64 bit integer

function bim plan view:
    replacement:
        0
function bim section view:
    replacement:
        1
function bim model view:
    replacement:
        2
function bim schedule view:
    replacement:
        3
function bim ceiling view:
    replacement:
        4

function the bim view index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's views's values)

# Puts `viewValue` in the model in place of the view with its id, or adds it.
function store bim view {bim view definition record:viewValue} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim view index of viewValue's id in (@intrinsic("dereference", target))
        if found's valid:
            replace item at index found's position in (target's views's values) with viewValue
        else:
            append viewValue to (target's views's values)
        note bim change of viewValue's id in target

function delete bim view {a 64 bit integer:viewId} from {a pointer to a bim model record:target}:
    execute:
        set found to the bim view index of viewId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        remove item found's position from (target's views's values)
        note bim change of viewId in target
        return true

# A copy of view `viewId` named `title`, with its own id; its id, or the
# refused id.
function duplicate bim view {a 64 bit integer:viewId} named {a string:title} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim view index of viewId in (@intrinsic("dereference", target))
        if found's valid = false:
            return the bim refused id
        set original to the item at found's position in (target's views's values)
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim view definition record, fresh, original's kind, title, original's levelId, original's detail, original's cutHeight, original's scale, original's cropped, original's cropLow, original's cropHigh, the cad clone of original's shown, the cad clone of original's faint, original's lineStart, original's lineFinish, original's drawingTypeId, original's automatic, original's phaseId)) to (target's views's values)
        note bim change of fresh in target
        return fresh

# A straight stair on storey `levelId`, a generator (`bim_stair.dl`): it
# climbs from `start` toward `finish` (its run, in plan) to the storey above,
# `width` wide, in `riserCount` equal risers; its treads and stringers are
# linear elements of `material`, derived when it is evaluated.
class:
    patterns:
        [a|] bim stair record
    members:
        id as a 64 bit integer
        levelId as a 64 bit integer
        start as a cad vector2
        finish as a cad vector2
        width as a 64 bit floating-point number
        riserCount as an integer
        material as a string

function the bim stair index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's stairs's values)

# A new stair; refused for a missing storey, a run under 0.5 m, a width
# under 0.6 m or fewer than 3 risers.
function add bim stair on {a 64 bit integer:levelId} from {cad vector2:start} to {cad vector2:finish} wide {a 64 bit floating-point number:stairWidth} in {integer:riserTotal} risers of {a string:materialName} to {a pointer to a bim model record:target}:
    execute:
        if (the bim level index of levelId in (@intrinsic("dereference", target)))'s valid = false:
            return the bim refused id
        if (((the cad distance from start to finish) < 0.5) or (stairWidth < 0.6)) or (riserTotal < 3):
            return the bim refused id
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim stair record, fresh, levelId, start, finish, stairWidth, riserTotal, materialName)) to (target's stairs's values)
        note bim change of fresh in target
        return fresh

function delete bim stair {a 64 bit integer:stairId} from {a pointer to a bim model record:target}:
    execute:
        set found to the bim stair index of stairId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        remove item found's position from (target's stairs's values)
        note bim change of stairId in target
        set keptRailings to a cad topology list of a bim railing record
        loop cursor from 0 to the length of (target's railings's values):
            set railingValue to the item at cursor in (target's railings's values)
            if railingValue's hostId = stairId:
                note bim change of railingValue's id in target
            else:
                append railingValue to (keptRailings's values)
        set target's railings to keptRailings
        return true

# A railing along `points` (in plan) on storey `levelId`, `height` high, a
# generator (`bim_stair.dl`) of linear posts and rails of `material`. On a
# stair (`hostId`) its foot follows the stair's slope.
class:
    patterns:
        [a|] bim railing record
    members:
        id as a 64 bit integer
        levelId as a 64 bit integer
        hostId as a 64 bit integer
        points as the type of (a cad topology list of a cad vector2)
        height as a 64 bit floating-point number
        material as a string

function the bim railing index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's railings's values)

# A new railing; refused for a missing storey, fewer than two points or a
# height outside 0.3 to 2 m.
function add bim railing on {a 64 bit integer:levelId} along {a pointer to a list:pathPoints} hosted by {a 64 bit integer:hostId} rising {a 64 bit floating-point number:railHeight} of {a string:materialName} to {a pointer to a bim model record:target}:
    execute:
        if (the bim level index of levelId in (@intrinsic("dereference", target)))'s valid = false:
            return the bim refused id
        if ((the length of pathPoints) < 2) or ((railHeight < 0.3) or (railHeight > 2.0)):
            return the bim refused id
        set copied to a cad topology list of a cad vector2
        loop cursor from 0 to the length of pathPoints:
            append (the item at cursor in pathPoints) to (copied's values)
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim railing record, fresh, levelId, hostId, copied, railHeight, materialName)) to (target's railings's values)
        note bim change of fresh in target
        return fresh

function delete bim railing {a 64 bit integer:railingId} from {a pointer to a bim model record:target}:
    execute:
        set found to the bim railing index of railingId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        remove item found's position from (target's railings's values)
        note bim change of railingId in target
        return true

# A curtain wall from `start` to `finish` on storey `levelId`, `height`
# high, a generator (`bim_stair.dl`) of linear mullions, transoms and glass
# panels: bays at most `bayWidth` wide and rows at most `rowHeight` high,
# its frame of `material`.
class:
    patterns:
        [a|] bim curtain record
    members:
        id as a 64 bit integer
        levelId as a 64 bit integer
        start as a cad vector2
        finish as a cad vector2
        height as a 64 bit floating-point number
        bayWidth as a 64 bit floating-point number
        rowHeight as a 64 bit floating-point number
        material as a string

function the bim curtain index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's curtains's values)

# A new curtain wall; refused for a missing storey, a length under 0.5 m, a
# height under 0.5 m or bays and rows under 0.3 m.
function add bim curtain wall on {a 64 bit integer:levelId} from {cad vector2:start} to {cad vector2:finish} rising {a 64 bit floating-point number:wallHeight} in bays of {a 64 bit floating-point number:bay} by {a 64 bit floating-point number:row} of {a string:materialName} to {a pointer to a bim model record:target}:
    execute:
        if (the bim level index of levelId in (@intrinsic("dereference", target)))'s valid = false:
            return the bim refused id
        if (((the cad distance from start to finish) < 0.5) or (wallHeight < 0.5)) or ((bay < 0.3) or (row < 0.3)):
            return the bim refused id
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim curtain record, fresh, levelId, start, finish, wallHeight, bay, row, materialName)) to (target's curtains's values)
        note bim change of fresh in target
        return fresh

function delete bim curtain wall {a 64 bit integer:curtainId} from {a pointer to a bim model record:target}:
    execute:
        set found to the bim curtain index of curtainId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        remove item found's position from (target's curtains's values)
        # Its panels' types go with it.
        set cursor to (the length of (target's systemPanels's values)) - 1
        loop while cursor >= 0:
            if (the item at cursor in (target's systemPanels's values))'s curtainId = curtainId:
                remove item cursor from (target's systemPanels's values)
            set cursor to cursor - 1
        note bim change of curtainId in target
        return true

# A building services system (IfcDistributionSystem): a name, a discipline
# and its members, the elements assigned to it (as IfcRelAssignsToGroup
# does), so that the elements themselves need not change.
class:
    patterns:
        [a|] bim system record
    members:
        id as a 64 bit integer
        name as a string
        discipline as an integer
        members as the type of (a cad topology list of a 64 bit integer)

function bim water discipline:
    replacement:
        0
function bim drainage discipline:
    replacement:
        1
function bim heating discipline:
    replacement:
        2
function bim ventilation discipline:
    replacement:
        3
function bim electrical discipline:
    replacement:
        4

function the bim name of discipline {integer:disciplineCode}:
    execute:
        if disciplineCode = bim water discipline:
            return the string form of "Water"
        if disciplineCode = bim drainage discipline:
            return the string form of "Drainage"
        if disciplineCode = bim heating discipline:
            return the string form of "Heating"
        if disciplineCode = bim ventilation discipline:
            return the string form of "Ventilation"
        return the string form of "Electrical"

# IFC's predefined type of a distribution system of `disciplineCode`.
function the bim ifc system type of discipline {integer:disciplineCode}:
    execute:
        if disciplineCode = bim water discipline:
            return the string form of "DOMESTICCOLDWATER"
        if disciplineCode = bim drainage discipline:
            return the string form of "DRAINAGE"
        if disciplineCode = bim heating discipline:
            return the string form of "HEATING"
        if disciplineCode = bim ventilation discipline:
            return the string form of "VENTILATION"
        return the string form of "ELECTRICAL"

# The colour elements of a system of `disciplineCode` are drawn in.
function the bim colour of discipline {integer:disciplineCode}:
    execute:
        if disciplineCode = bim water discipline:
            return a cad vector3 with x 40.0, y 110.0 and z 220.0
        if disciplineCode = bim drainage discipline:
            return a cad vector3 with x 120.0, y 90.0 and z 50.0
        if disciplineCode = bim heating discipline:
            return a cad vector3 with x 210.0, y 50.0 and z 40.0
        if disciplineCode = bim ventilation discipline:
            return a cad vector3 with x 40.0, y 170.0 and z 170.0
        return a cad vector3 with x 230.0, y 150.0 and z 20.0

function the bim system index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's systems's values)

# A new system of `disciplineCode` named `title`, with no members; its id.
function add bim system named {a string:title} of discipline {integer:disciplineCode} to {a pointer to a bim model record:target}:
    execute:
        if (disciplineCode < 0) or (disciplineCode > 4):
            return the bim refused id
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim system record, fresh, title, disciplineCode, a cad topology list of a 64 bit integer)) to (target's systems's values)
        note bim change of fresh in target
        return fresh

# Element `elementId` assigned to system `systemId` (and taken out of any
# other system); refused for a missing system.
function assign bim element {a 64 bit integer:elementId} to system {a 64 bit integer:systemId} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim system index of systemId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        loop cursor from 0 to the length of (target's systems's values):
            set systemValue to the item at cursor in (target's systems's values)
            set kept to a cad topology list of a 64 bit integer
            loop memberCursor from 0 to the length of (systemValue's members's values):
                set member to the item at memberCursor in (systemValue's members's values)
                if member != elementId:
                    append member to (kept's values)
            if systemValue's id = systemId:
                append elementId to (kept's values)
            replace item at index cursor in (target's systems's values) with (@intrinsic("construct", a bim system record, systemValue's id, systemValue's name, systemValue's discipline, kept))
        note bim change of systemId in target
        note bim change of elementId in target
        return true

# The system element `elementId` belongs to, or the refused id.
function the bim system of element {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's systems's values):
            set systemValue to the item at cursor in (modelValue's systems's values)
            loop memberCursor from 0 to the length of (systemValue's members's values):
                if (the item at memberCursor in (systemValue's members's values)) = elementId:
                    return systemValue's id
        return the bim refused id

# A view placed on a sheet: model point `modelCentre` of view `viewId` lands
# on `centre` of the sheet (millimetres from its lower left corner), at the
# view's scale.
class:
    patterns:
        [a|] bim viewport record
    members:
        viewId as a 64 bit integer
        centre as a cad vector2
        modelCentre as a cad vector2

# A drawing sheet: its number and name for the title block, its paper (`bim
# a0 paper` … `bim a4 paper`, landscape or portrait) and the views placed on
# it.
class:
    patterns:
        [a|] bim sheet record
    members:
        id as a 64 bit integer
        number as a string
        name as a string
        paper as an integer
        landscape as a boolean
        viewports as the type of (a cad topology list of a bim viewport record)

function bim a0 paper:
    replacement:
        0
function bim a4 paper:
    replacement:
        4

function the bim sheet index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's sheets's values)

# A new sheet, empty; its id. Refused for a paper that is not A0 to A4.
function add bim sheet numbered {a string:sheetNumber} named {a string:title} on paper {integer:paperCode} landscape {boolean:wide} to {a pointer to a bim model record:target}:
    execute:
        if (paperCode < bim a0 paper) or (paperCode > bim a4 paper):
            return the bim refused id
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim sheet record, fresh, sheetNumber, title, paperCode, wide, a cad topology list of a bim viewport record)) to (target's sheets's values)
        note bim change of fresh in target
        return fresh

# View `viewId` placed on sheet `sheetId`, model point `modelCentre` at
# `centre`; refused for a missing sheet or view.
function place bim view {a 64 bit integer:viewId} on sheet {a 64 bit integer:sheetId} at {cad vector2:centre} looking at {cad vector2:modelCentre} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim sheet index of sheetId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((the bim view index of viewId in (@intrinsic("dereference", target)))'s valid = false):
            return false
        set sheetValue to the item at found's position in (target's sheets's values)
        set placed to the cad clone of sheetValue's viewports
        append (@intrinsic("construct", a bim viewport record, viewId, centre, modelCentre)) to (placed's values)
        replace item at index found's position in (target's sheets's values) with (@intrinsic("construct", a bim sheet record, sheetValue's id, sheetValue's number, sheetValue's name, sheetValue's paper, sheetValue's landscape, placed))
        note bim change of sheetId in target
        return true

# Viewport `viewportIndex` of sheet `sheetId` moved to `centre`.
function move bim viewport {integer:viewportIndex} of sheet {a 64 bit integer:sheetId} to {cad vector2:centre} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim sheet index of sheetId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set sheetValue to the item at found's position in (target's sheets's values)
        if (viewportIndex < 0) or (viewportIndex >= (the length of (sheetValue's viewports's values))):
            return false
        set placed to the cad clone of sheetValue's viewports
        set original to the item at viewportIndex in (placed's values)
        replace item at index viewportIndex in (placed's values) with (@intrinsic("construct", a bim viewport record, original's viewId, centre, original's modelCentre))
        replace item at index found's position in (target's sheets's values) with (@intrinsic("construct", a bim sheet record, sheetValue's id, sheetValue's number, sheetValue's name, sheetValue's paper, sheetValue's landscape, placed))
        note bim change of sheetId in target
        return true

# A tag: an annotation showing the type of the element it points at, its
# text centred at `place`, with a leader to the element when it stands away.
class:
    patterns:
        [a|] bim tag record
    members:
        id as a 64 bit integer
        elementId as a 64 bit integer
        place as a cad vector2

class:
    patterns:
        [a|] bim dimension record
    members:
        id as a 64 bit integer
        first as a bim reference record
        second as a bim reference record
        # Where the dimension line is drawn: it passes through `place`. A
        # dimension not placed is drawn through the middle of what it
        # measures.
        placed as a boolean
        place as a cad vector2

# A slab on a level: its outline in plan, with its top at the level's
# elevation and its underside `thickness` lower. The outline is never changed
# after the slab is made.
class:
    patterns:
        [a|] bim slab record
    members:
        id as a 64 bit integer
        levelId as a 64 bit integer
        outline as the type of (a cad topology list of a cad vector2)
        thickness as a 64 bit floating-point number
        # What it is made of, as a wall layer's material (`bim_hatch.dl`).
        material as a string
        # A plate (floor, roof or ceiling) of planar type `typeId`, its top
        # `top` metres above its storey at the outline's first corner,
        # rising `pitch` radians toward the plan direction `heading`
        # (radians). Without a type it is the floor of `thickness` and
        # `material` above.
        typeId as a 64 bit integer
        top as a 64 bit floating-point number
        pitch as a 64 bit floating-point number
        heading as a 64 bit floating-point number

# The roles of planar types: what a planar element is.
function bim wall planar role:
    replacement:
        0
function bim floor planar role:
    replacement:
        1
function bim roof planar role:
    replacement:
        2
function bim ceiling planar role:
    replacement:
        3

# The IFC class (IFC4x3) of a planar element of `roleCode`, and of its type
# with "Type" added.
function the bim ifc class of planar role {integer:roleCode}:
    execute:
        if roleCode = bim wall planar role:
            return the string form of "IfcWall"
        if roleCode = bim ceiling planar role:
            return the string form of "IfcCovering"
        return the string form of "IfcSlab"

# The IFC predefined type of a planar element of `roleCode`.
function the bim ifc predefined type of planar role {integer:roleCode}:
    execute:
        if roleCode = bim floor planar role:
            return the string form of "FLOOR"
        if roleCode = bim roof planar role:
            return the string form of "ROOF"
        if roleCode = bim ceiling planar role:
            return the string form of "CEILING"
        return the string form of "STANDARD"

function the bim name of planar role {integer:roleCode}:
    execute:
        if roleCode = bim floor planar role:
            return the string form of "Floor"
        if roleCode = bim roof planar role:
            return the string form of "Roof"
        if roleCode = bim ceiling planar role:
            return the string form of "Ceiling"
        return the string form of "Wall"

# A grid line: named, running in plan from `start` to `finish`, and reaching
# from `low` to `high` in elevation. Grids reference the design; they carry
# no geometry of their own.
class:
    patterns:
        [a|] bim grid record
    members:
        id as a 64 bit integer
        name as a string
        start as a cad vector2
        finish as a cad vector2
        low as a 64 bit floating-point number
        high as a 64 bit floating-point number

# A sketch element, drawn freely on a storey as in SketchUp: a line (two
# points), a face (a closed outline, which push/pull raises into a mass
# `height` high above the storey) or a text (its anchor point and `content`).
class:
    patterns:
        [a|] bim sketch record
    members:
        id as a 64 bit integer
        levelId as a 64 bit integer
        kind as an integer
        points as the type of (a cad topology list of a cad vector2)
        height as a 64 bit floating-point number
        content as a string

# A free mesh on a storey, as in Blender and SketchUp: points in 3D (z up
# from the storey's elevation) and faces, each a closed loop of points. A
# face is kept as its number of points followed by their indices.
class:
    patterns:
        [a|] bim mesh record
    members:
        id as a 64 bit integer
        levelId as a 64 bit integer
        vertices as the type of (a cad topology list of a cad vector3)
        faces as the type of (a cad topology list of an integer)

# A linear type: what a linear element is (`role`, the IFC class it becomes,
# see `the bim ifc class of linear role`), its profile `width` by `depth`
# (round: `width` across) and its `material`, as a wall layer's. The tool
# picks the role; the type, chosen in the type selector, says the rest.
class:
    patterns:
        [a|] bim linear type record
    members:
        id as a 64 bit integer
        name as a string
        role as an integer
        width as a 64 bit floating-point number
        depth as a 64 bit floating-point number
        round as a boolean
        material as a string

# A linear element: its type's profile swept along a straight axis, the one
# element behind columns, beams, mullions, skirtings and pipes. The axis runs
# from `start` to `finish`, in metres on the plan and in height above its
# storey; the profile is turned `angle` radians about it. Its `width` lies
# level across the axis (for an upright axis: along x), its `depth` square to
# both.
class:
    patterns:
        [a|] bim linear record
    members:
        id as a 64 bit integer
        typeId as a 64 bit integer
        levelId as a 64 bit integer
        start as a cad vector3
        finish as a cad vector3
        angle as a 64 bit floating-point number

function bim column role:
    replacement:
        0
function bim beam role:
    replacement:
        1
function bim mullion role:
    replacement:
        2
function bim skirting role:
    replacement:
        3
function bim pipe role:
    replacement:
        4
function bim generic linear role:
    replacement:
        5
function bim duct role:
    replacement:
        6
function bim cable tray role:
    replacement:
        7
# A foundation pile: an upright linear element reaching down from its storey.
function bim pile role:
    replacement:
        8

# The IFC class (IFC4x3) a linear element of `role` is, with its predefined
# type where IFC names one.
function the bim ifc class of linear role {integer:roleCode}:
    execute:
        if roleCode = bim column role:
            return the string form of "IfcColumn"
        if roleCode = bim beam role:
            return the string form of "IfcBeam"
        if roleCode = bim mullion role:
            return the string form of "IfcMember"
        if roleCode = bim skirting role:
            return the string form of "IfcCovering"
        if roleCode = bim pipe role:
            return the string form of "IfcPipeSegment"
        if roleCode = bim duct role:
            return the string form of "IfcDuctSegment"
        if roleCode = bim cable tray role:
            return the string form of "IfcCableCarrierSegment"
        if roleCode = bim pile role:
            return the string form of "IfcPile"
        return the string form of "IfcBuildingElementProxy"

function the bim name of linear role {integer:roleCode}:
    execute:
        if roleCode = bim column role:
            return the string form of "Column"
        if roleCode = bim beam role:
            return the string form of "Beam"
        if roleCode = bim mullion role:
            return the string form of "Mullion"
        if roleCode = bim skirting role:
            return the string form of "Skirting"
        if roleCode = bim pipe role:
            return the string form of "Pipe"
        if roleCode = bim duct role:
            return the string form of "Duct"
        if roleCode = bim cable tray role:
            return the string form of "Cable tray"
        if roleCode = bim pile role:
            return the string form of "Pile"
        return the string form of "Linear element"

# A component: sketch elements kept once, in the component's own coordinates,
# and placed any number of times as instances, as in SketchUp. Editing the
# component changes every instance.
class:
    patterns:
        [a|] bim component record
    members:
        id as a 64 bit integer
        name as a string
        sketches as the type of (a cad topology list of a bim sketch record)
        # Solid parts folded in order into the component's B-rep (see
        # `bim_component.dl`).
        solids as the type of (a cad topology list of a bim solid part record)
        # What it is in a building's services: `bim generic component`, a
        # terminal (a radiator, a basin) or equipment (a boiler, a fan).
        role as an integer
        # Where pipes, ducts or cables connect to it, in its coordinates.
        connectors as the type of (a cad topology list of a bim component connector record)

# A connector of a component: a point and the direction out of it, in the
# component's coordinates, for segments of `role` (pipe, duct, cable tray)
# and `size`.
class:
    patterns:
        [a|] bim component connector record
    members:
        spot as a cad vector3
        direction as a cad vector3
        size as a 64 bit floating-point number
        role as an integer

function bim generic component:
    replacement:
        0
function bim terminal component:
    replacement:
        1
function bim equipment component:
    replacement:
        2

function the bim ifc class of component role {integer:roleCode}:
    execute:
        if roleCode = bim terminal component:
            return the string form of "IfcFlowTerminal"
        if roleCode = bim equipment component:
            return the string form of "IfcEnergyConversionDevice"
        return the string form of "IfcBuildingElementProxy"

# Component `componentId` given `roleCode` and a connector at `spot`
# pointing along `direction`; refused for a missing component.
function add bim connector to component {a 64 bit integer:componentId} as {integer:roleCode} at {cad vector3:spot} pointing {cad vector3:direction} sized {a 64 bit floating-point number:connectorSize} for {integer:segmentRole} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim component index of componentId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set definition to the item at found's position in (target's components's values)
        set kept to the cad clone of definition's connectors
        set directionLength to the cad length of direction
        if directionLength < 1e-9:
            return false
        append (@intrinsic("construct", a bim component connector record, spot, direction scaled by (1.0 / directionLength), connectorSize, segmentRole)) to (kept's values)
        replace item at index found's position in (target's components's values) with (@intrinsic("construct", a bim component record, definition's id, definition's name, definition's sketches, definition's solids, roleCode, kept))
        note bim change of componentId in target
        return true

# A solid part of a component, in the component's coordinates: a primitive
# (`kind`: box, cylinder, sphere, an extrusion of `profile`, or a closed mesh
# of `points` and `faces`, each face its point count then its point
# numbers, as in `bim mesh record`) at `origin`,
# `size` (box: width, depth, height; cylinder: radius, -, height; sphere:
# radius; extrusion: -, -, height), turned `angle` radians about the
# vertical; added to, cut from or intersected with what the parts before it
# made (`operation`), of `material`.
class:
    patterns:
        [a|] bim solid part record
    members:
        kind as an integer
        operation as an integer
        origin as a cad vector3
        size as a cad vector3
        angle as a 64 bit floating-point number
        profile as the type of (a cad topology list of a cad vector2)
        material as a string
        points as the type of (a cad topology list of a cad vector3)
        faces as the type of (a cad topology list of an integer)

function bim box solid:
    replacement:
        0
function bim cylinder solid:
    replacement:
        1
function bim sphere solid:
    replacement:
        2
function bim extrusion solid:
    replacement:
        3
function bim mesh solid:
    replacement:
        4
function bim add operation:
    replacement:
        0
function bim subtract operation:
    replacement:
        1
function bim intersect operation:
    replacement:
        2

# One placement of a component on a storey: its origin at `origin`, turned
# `angle` radians anticlockwise.
class:
    patterns:
        [a|] bim instance record
    members:
        id as a 64 bit integer
        componentId as a 64 bit integer
        levelId as a 64 bit integer
        origin as a cad vector2
        angle as a 64 bit floating-point number
        # The one view it is drawn in (a 2D detail component), or the refused
        # id for a model instance drawn in every plan of its storey and in 3D.
        viewId as a 64 bit integer

function bim line sketch:
    replacement:
        0
function bim face sketch:
    replacement:
        1
function bim text sketch:
    replacement:
        2

class:
    patterns:
        [a|] bim model record
    members:
        nextId as a 64 bit integer
        levels as the type of (a cad topology list of a bim level record)
        wallTypes as the type of (a cad topology list of a bim wall type record)
        walls as the type of (a cad topology list of a bim wall record)
        openingTypes as the type of (a cad topology list of a bim opening type record)
        openings as the type of (a cad topology list of a bim opening record)
        dimensions as the type of (a cad topology list of a bim dimension record)
        slabs as the type of (a cad topology list of a bim slab record)
        journal as the type of (a cad topology list of a 64 bit integer)
        grids as the type of (a cad topology list of a bim grid record)
        sketches as the type of (a cad topology list of a bim sketch record)
        components as the type of (a cad topology list of a bim component record)
        instances as the type of (a cad topology list of a bim instance record)
        meshes as the type of (a cad topology list of a bim mesh record)
        linears as the type of (a cad topology list of a bim linear record)
        linearTypes as the type of (a cad topology list of a bim linear type record)
        tags as the type of (a cad topology list of a bim tag record)
        views as the type of (a cad topology list of a bim view definition record)
        sheets as the type of (a cad topology list of a bim sheet record)
        stairs as the type of (a cad topology list of a bim stair record)
        railings as the type of (a cad topology list of a bim railing record)
        curtains as the type of (a cad topology list of a bim curtain record)
        systems as the type of (a cad topology list of a bim system record)
        drawingTypes as the type of (a cad topology list of a bim drawing type record)
        phases as the type of (a cad topology list of a bim phase record)
        phasings as the type of (a cad topology list of a bim phasing record)
        systemPanels as the type of (a cad topology list of a bim system panel record)

function an empty bim model:
    execute:
        return @intrinsic("construct", a bim model record, 1 as a 64 bit integer, a cad topology list of a bim level record, a cad topology list of a bim wall type record, a cad topology list of a bim wall record, a cad topology list of a bim opening type record, a cad topology list of a bim opening record, a cad topology list of a bim dimension record, a cad topology list of a bim slab record, a cad topology list of a 64 bit integer, a cad topology list of a bim grid record, a cad topology list of a bim sketch record, a cad topology list of a bim component record, a cad topology list of a bim instance record, a cad topology list of a bim mesh record, a cad topology list of a bim linear record, a cad topology list of a bim linear type record, a cad topology list of a bim tag record, a cad topology list of a bim view definition record, a cad topology list of a bim sheet record, a cad topology list of a bim stair record, a cad topology list of a bim railing record, a cad topology list of a bim curtain record, a cad topology list of a bim system record, a cad topology list of a bim drawing type record, a cad topology list of a bim phase record, a cad topology list of a bim phasing record, a cad topology list of a bim system panel record)

# A snapshot shares no element list with the original; elements are immutable
# values. It shares the journal, which the document replaces whenever a
# snapshot becomes the current model again.
function the bim snapshot of {bim model record:modelValue}:
    execute:
        return @intrinsic("construct", a bim model record, modelValue's nextId, the cad clone of modelValue's levels, the cad clone of modelValue's wallTypes, the cad clone of modelValue's walls, the cad clone of modelValue's openingTypes, the cad clone of modelValue's openings, the cad clone of modelValue's dimensions, the cad clone of modelValue's slabs, modelValue's journal, the cad clone of modelValue's grids, the cad clone of modelValue's sketches, the cad clone of modelValue's components, the cad clone of modelValue's instances, the cad clone of modelValue's meshes, the cad clone of modelValue's linears, the cad clone of modelValue's linearTypes, the cad clone of modelValue's tags, the cad clone of modelValue's views, the cad clone of modelValue's sheets, the cad clone of modelValue's stairs, the cad clone of modelValue's railings, the cad clone of modelValue's curtains, the cad clone of modelValue's systems, the cad clone of modelValue's drawingTypes, the cad clone of modelValue's phases, the cad clone of modelValue's phasings, the cad clone of modelValue's systemPanels)

# The journal lists, in order, the id of every element each edit added,
# changed or removed. An evaluation that has seen a prefix of this same
# journal (the same list) needs to compare only the ids after it; any other
# change of model, such as undo, comes with a new journal.
function note bim change of {a 64 bit integer:elementId} in {a pointer to a bim model record:target}:
    execute:
        append elementId to (target's journal's values)

function the bim new id in {a pointer to a bim model record:target}:
    execute:
        set fresh to target's nextId
        set target's nextId to fresh + (1 as a 64 bit integer)
        note bim change of fresh in target
        return fresh

# ---------------------------------------------------------------- formulas

function the bim thickness of {bim wall type record:wallType}:
    execute:
        set total to 0.0 as a 64 bit floating-point number
        loop index from 0 to the length of (wallType's layers's values):
            set total to total + (the item at index in (wallType's layers's values))'s thickness
        return total

function the bim rough width of {bim opening type record:openingType}:
    execute:
        return openingType's width + (2.0 * openingType's frame)

function the bim rough height of {bim opening type record:openingType}:
    execute:
        return openingType's height + openingType's frame

function the bim head height of {bim opening type record:openingType}:
    execute:
        return openingType's sill + (the bim rough height of openingType)

# The plan area of a slab's outline, whichever way round it runs, computed
# relative to its first point so it stays exact far from the origin.
function the bim slab area of {bim slab record:slabValue}:
    execute:
        set points to slabValue's outline's values
        set anchor to the item at 0 in points
        set total to 0.0
        loop cursor from 1 to (the length of points) - 1:
            set here to the item at cursor in points
            set following to the item at (cursor + 1) in points
            set total to total + (((here's x - anchor's x) * (following's y - anchor's y)) - ((following's x - anchor's x) * (here's y - anchor's y)))
        return (the absolute value of total) * 0.5

# ---------------------------------------------------------------- lookups

class:
    patterns:
        [a|] bim index result record
    members:
        valid as a boolean
        position as an integer

local function no bim index:
    execute:
        return @intrinsic("construct", a bim index result record, false, -1)

local function a found bim index at {integer:position}:
    execute:
        return @intrinsic("construct", a bim index result record, true, position)

# Every element list is ordered by id: ids are handed out in increasing order,
# new elements are appended, and edits replace or remove in place. Lookups are
# therefore binary searches over records with an `id` member.

# The position of the first record whose id is not below `wanted`.
function the bim insertion position of {a 64 bit integer:wanted} among {a pointer to a list:records}:
    execute:
        set low to 0
        set high to the length of records
        loop while low < high:
            set middle to (low + high) / 2
            if (the item at middle in records)'s id < wanted:
                set low to middle + 1
            else:
                set high to middle
        return low

function the bim position of {a 64 bit integer:wanted} among {a pointer to a list:records}:
    execute:
        set slot to the bim insertion position of wanted among records
        if slot < the length of records:
            if (the item at slot in records)'s id = wanted:
                return a found bim index at slot
        return no bim index

function the bim level index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's levels's values)

function the bim wall type index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's wallTypes's values)

function the bim wall index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's walls's values)

function the bim opening type index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's openingTypes's values)

function the bim opening index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's openings's values)

function the bim slab index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's slabs's values)

# The storey directly above (`upward`) or below the level `levelId`: the
# nearest level by elevation on that side; invalid when there is none.
function the bim level next to {a 64 bit integer:levelId} going up {boolean:upward} in {bim model record:modelValue}:
    execute:
        set here to the bim level index of levelId in modelValue
        if here's valid = false:
            return here
        set elevation to (the item at here's position in (modelValue's levels's values))'s elevation
        set best to -1
        loop cursor from 0 to the length of (modelValue's levels's values):
            set candidate to (the item at cursor in (modelValue's levels's values))'s elevation
            set beyond to candidate < elevation
            if upward:
                set beyond to candidate > elevation
            if beyond:
                if best < 0:
                    set best to cursor
                else:
                    set bestElevation to (the item at best in (modelValue's levels's values))'s elevation
                    set nearer to candidate > bestElevation
                    if upward:
                        set nearer to candidate < bestElevation
                    if nearer:
                        set best to cursor
        if best < 0:
            return @intrinsic("construct", a bim index result record, false, -1)
        return @intrinsic("construct", a bim index result record, true, best)

function the bim grid index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's grids's values)

function the bim sketch index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's sketches's values)

function the bim component index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's components's values)

function the bim instance index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's instances's values)

function the bim mesh index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's meshes's values)

function the bim dimension index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's dimensions's values)

# ---------------------------------------------------------------- edits
# Each edit validates its references and returns the new element's id, or the
# refused id when it is refused; a refused edit leaves the model unchanged.

function the bim refused id:
    execute:
        return (-1) as a 64 bit integer

function add bim level named {a string:nameValue} at {a 64 bit floating-point number:elevation} with height {a 64 bit floating-point number:heightValue} to {a pointer to a bim model record:target}:
    execute:
        if heightValue <= 0.0:
            return the bim refused id
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim level record, fresh, nameValue, elevation, heightValue)) to (target's levels's values)
        return fresh

# ---------------------------------------------------------------- naming rules

# Types are named by rules, never by hand, so that a name always says what
# the type is: its material and size, in millimetres. The role is the group
# a type is listed in, so it is not part of the name.
#
#     planar type   its layers' materials from the exterior (or top) in,
#                   then the total thickness:  "Beton 250",
#                   "Metselwerk-spouw-isolatie PIR-kalkzandsteen 360"
#     linear type   its material and profile:  "Beton 300x300", "Beton rond 300"
#     opening type  door or window and size:   "Deur 900x2100", "Raam 1200x1500"
#
# Two different types of one role whose names would be the same are told
# apart by " (2)", " (3)" in id order.

# The Dutch name of `material`, as the drawing's legends name it.
function the bim dutch name of material {a string:material}:
    execute:
        set lowered to the lowercase form of material
        if lowered contains "hollow":
            return the string form of "kanaalplaat"
        if lowered contains "concrete":
            return the string form of "beton"
        if lowered contains "brick":
            return the string form of "metselwerk"
        if lowered contains "sand-lime":
            return the string form of "kalkzandsteen"
        if lowered contains "pir":
            return the string form of "isolatie PIR"
        if lowered contains "insulation":
            return the string form of "isolatie"
        if lowered contains "timber":
            return the string form of "hout"
        if lowered contains "steel":
            return the string form of "staal"
        if lowered contains "gypsum":
            return the string form of "gips"
        if lowered contains "air":
            return the string form of "spouw"
        if lowered contains "generic":
            return the string form of "algemeen"
        return lowered

# `text` with its first letter a capital.
local function the bim capitalised {a string:text}:
    execute:
        if (the length of text) = 0:
            return text
        set first to the substring of text from 0 spanning 1 bytes
        set rest to the substring of text from 1 spanning ((the length of text) - 1) bytes
        return (the uppercase form of first) + rest

# `metres` as millimetres: whole, or with one decimal when it has one.
function the bim millimetre text of {a 64 bit floating-point number:metres}:
    execute:
        set tenths to @intrinsic("call", "libc", "round", a 64 bit floating-point number, metres * 10000.0)
        set whole to (tenths / 10.0) as a 64 bit integer
        set rest to (tenths - ((whole as a 64 bit floating-point number) * 10.0)) as a 64 bit integer
        if rest = (0 as a 64 bit integer):
            return the string form of whole
        return ((the string form of whole) + (the string form of ".")) + (the string form of rest)

function the bim rule name of planar type {bim wall type record:planarType}:
    execute:
        set parts to an empty list of a string
        loop cursor from 0 to the length of (planarType's layers's values):
            set dutch to the bim dutch name of material (the item at cursor in (planarType's layers's values))'s material
            set repeated to false
            if (the length of parts) > 0:
                set repeated to (the item at ((the length of parts) - 1) in parts) = dutch
            if repeated = false:
                append dutch to parts
        set joined to parts joined with "-"
        free parts
        return ((the bim capitalised joined) + (the string form of " ")) + (the bim millimetre text of (the bim thickness of planarType))

function the bim rule name of linear type {bim linear type record:linearType}:
    execute:
        set dutch to the bim capitalised (the bim dutch name of material linearType's material)
        if linearType's round:
            return (dutch + (the string form of " rond ")) + (the bim millimetre text of linearType's width)
        return (dutch + (the string form of " ")) + (((the bim millimetre text of linearType's width) + (the string form of "x")) + (the bim millimetre text of linearType's depth))

function the bim rule name of opening type {bim opening type record:openingType}:
    execute:
        set kind to the string form of "Raam"
        if openingType's isDoor:
            set kind to the string form of "Deur"
        return (kind + (the string form of " ")) + (((the bim millimetre text of openingType's width) + (the string form of "x")) + (the bim millimetre text of openingType's height))

# `base` made unique among `taken` (names already given in the same role).
local function the bim unique name of {a string:base} among {a pointer to a list:taken}:
    execute:
        set candidate to base
        set number to 1
        set clashing to true
        loop while clashing:
            set clashing to false
            loop cursor from 0 to the length of taken:
                if (the item at cursor in taken) = candidate:
                    set clashing to true
            if clashing:
                set number to number + 1
                set candidate to (base + (the string form of " (")) + ((the string form of number) + (the string form of ")"))
        append candidate to taken
        return candidate

# Names every type of `target` by the rules above.
function name bim types by the rules in {a pointer to a bim model record:target}:
    execute:
        loop roleCode from 0 to 4:
            set taken to an empty list of a string
            loop cursor from 0 to the length of (target's wallTypes's values):
                set planarType to the item at cursor in (target's wallTypes's values)
                if planarType's role = roleCode:
                    set named to the bim unique name of (the bim rule name of planar type planarType) among taken
                    replace item at index cursor in (target's wallTypes's values) with (@intrinsic("construct", a bim wall type record, planarType's id, named, planarType's layers, planarType's role))
            free taken
        loop roleCode from 0 to 6:
            set taken to an empty list of a string
            loop cursor from 0 to the length of (target's linearTypes's values):
                set linearType to the item at cursor in (target's linearTypes's values)
                if linearType's role = roleCode:
                    set named to the bim unique name of (the bim rule name of linear type linearType) among taken
                    replace item at index cursor in (target's linearTypes's values) with (@intrinsic("construct", a bim linear type record, linearType's id, named, linearType's role, linearType's width, linearType's depth, linearType's round, linearType's material))
            free taken
        set taken to an empty list of a string
        loop cursor from 0 to the length of (target's openingTypes's values):
            set openingType to the item at cursor in (target's openingTypes's values)
            set named to the bim unique name of (the bim rule name of opening type openingType) among taken
            replace item at index cursor in (target's openingTypes's values) with (@intrinsic("construct", a bim opening type record, openingType's id, named, openingType's width, openingType's height, openingType's sill, openingType's frame, openingType's isDoor))
        free taken

function add bim wall type named {a string:nameValue} with {a pointer to a list:layerValues} to {a pointer to a bim model record:target}:
    execute:
        set copied to a cad topology list of a bim layer record
        loop index from 0 to the length of layerValues:
            set layerValue to the item at index in layerValues
            if layerValue's thickness <= 0.0:
                return the bim refused id
            append layerValue to (copied's values)
        if (the length of (copied's values)) = 0:
            return the bim refused id
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim wall type record, fresh, nameValue, copied, bim wall planar role)) to (target's wallTypes's values)
        name bim types by the rules in target
        return fresh

# Wall `wallId` takes wall type `typeId`; its joins and openings follow when
# it is evaluated again.
function set bim wall {a 64 bit integer:wallId} type to {a 64 bit integer:typeId} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim wall index of wallId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((the bim wall type index of typeId in (@intrinsic("dereference", target)))'s valid = false):
            return false
        set wallValue to the item at found's position in (target's walls's values)
        replace item at index found's position in (target's walls's values) with (@intrinsic("construct", a bim wall record, wallValue's id, typeId, wallValue's levelId, wallValue's start, wallValue's finish, wallValue's height, wallValue's bulge, wallValue's lean, wallValue's rise, wallValue's baseOffset))
        note bim change of wallId in target
        return true

function add bim wall typed {a 64 bit integer:typeId} on {a 64 bit integer:levelId} from {cad vector2:startPoint} to {cad vector2:finishPoint} to {a pointer to a bim model record:target}:
    execute:
        set typeFound to the bim wall type index of typeId in (@intrinsic("dereference", target))
        set levelFound to the bim level index of levelId in (@intrinsic("dereference", target))
        if (typeFound's valid = false) or (levelFound's valid = false):
            return the bim refused id
        if (the cad distance from startPoint to finishPoint) <= 1e-6:
            return the bim refused id
        set levelValue to the item at levelFound's position in (target's levels's values)
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim wall record, fresh, typeId, levelId, startPoint, finishPoint, levelValue's height, 0.0, 0.0, 0.0, 0.0)) to (target's walls's values)
        return fresh

function add bim opening type named {a string:nameValue} sized {a 64 bit floating-point number:widthValue} by {a 64 bit floating-point number:heightValue} with sill {a 64 bit floating-point number:sillValue} and frame {a 64 bit floating-point number:frameValue} to {a pointer to a bim model record:target}:
    execute:
        if ((widthValue <= 0.0) or (heightValue <= 0.0)) or ((sillValue < 0.0) or (frameValue < 0.0)):
            return the bim refused id
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim opening type record, fresh, nameValue, widthValue, heightValue, sillValue, frameValue, false)) to (target's openingTypes's values)
        name bim types by the rules in target
        return fresh

# A door type: an opening type standing on the base (sill 0).
function add bim door type named {a string:nameValue} sized {a 64 bit floating-point number:widthValue} by {a 64 bit floating-point number:heightValue} with frame {a 64 bit floating-point number:frameValue} to {a pointer to a bim model record:target}:
    execute:
        if ((widthValue <= 0.0) or (heightValue <= 0.0)) or (frameValue < 0.0):
            return the bim refused id
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim opening type record, fresh, nameValue, widthValue, heightValue, 0.0, frameValue, true)) to (target's openingTypes's values)
        name bim types by the rules in target
        return fresh

function add bim opening typed {a 64 bit integer:typeId} in {a 64 bit integer:hostId} at {a 64 bit floating-point number:offset} to {a pointer to a bim model record:target}:
    execute:
        set typeFound to the bim opening type index of typeId in (@intrinsic("dereference", target))
        set hostFound to the bim wall index of hostId in (@intrinsic("dereference", target))
        if (typeFound's valid = false) or (hostFound's valid = false):
            return the bim refused id
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim opening record, fresh, typeId, hostId, offset)) to (target's openings's values)
        return fresh

# The sign of the turn from `first` through `second` to `third`, computed
# relative to `first`: 1 left, -1 right, 0 straight.
local function the bim turn from {cad vector2:first} through {cad vector2:second} to {cad vector2:third}:
    execute:
        set value to ((second's x - first's x) * (third's y - first's y)) - ((second's y - first's y) * (third's x - first's x))
        if value > 0.0:
            return 1
        if value < 0.0:
            return -1
        return 0

# True when `location`, known to lie on the line through `first` and
# `second`, lies within the segment between them.
local function bim point {cad vector2:location} lies within {cad vector2:first} and {cad vector2:second}:
    execute:
        set insideX to (location's x >= (the minimum of first's x and second's x)) and (location's x <= (the maximum of first's x and second's x))
        set insideY to (location's y >= (the minimum of first's y and second's y)) and (location's y <= (the maximum of first's y and second's y))
        return insideX and insideY

# True when the closed segments `a`–`b` and `c`–`d` share a point.
local function bim segments {cad vector2:a} to {cad vector2:b} and {cad vector2:c} to {cad vector2:d} meet:
    execute:
        set turnC to the bim turn from a through b to c
        set turnD to the bim turn from a through b to d
        set turnA to the bim turn from c through d to a
        set turnB to the bim turn from c through d to b
        if ((turnC * turnD) < 0) and ((turnA * turnB) < 0):
            return true
        if (turnC = 0) and (bim point c lies within a and b):
            return true
        if (turnD = 0) and (bim point d lies within a and b):
            return true
        if (turnA = 0) and (bim point a lies within c and d):
            return true
        if (turnB = 0) and (bim point b lies within c and d):
            return true
        return false

# True when `outlinePoints` is a simple polygon: at least three points, no
# edge without length, no edge doubling back along the one before it, no two
# other edges touching, and an area.
function bim outline {a pointer to a list:outlinePoints} is simple:
    execute:
        set count to the length of outlinePoints
        if count < 3:
            return false
        set doubledArea to 0.0
        set anchor to the item at 0 in outlinePoints
        loop cursor from 0 to count:
            set here to the item at cursor in outlinePoints
            set following to the item at (the remainder of (cursor + 1) divided by count) in outlinePoints
            set afterwards to the item at (the remainder of (cursor + 2) divided by count) in outlinePoints
            if (here's x = following's x) and (here's y = following's y):
                return false
            set doubledArea to doubledArea + (((here's x - anchor's x) * (following's y - anchor's y)) - ((following's x - anchor's x) * (here's y - anchor's y)))
            # The next edge must not run back over this one.
            if (the bim turn from here through following to afterwards) = 0:
                set backX to (following's x - here's x) * (afterwards's x - following's x)
                set backY to (following's y - here's y) * (afterwards's y - following's y)
                if (backX + backY) < 0.0:
                    return false
        if doubledArea = 0.0:
            return false
        loop first from 0 to count:
            loop second from (first + 2) to count:
                # The first and the last edge are neighbours too.
                if ((first = 0) and (second = (count - 1))) = false:
                    set a to the item at first in outlinePoints
                    set b to the item at (the remainder of (first + 1) divided by count) in outlinePoints
                    set c to the item at second in outlinePoints
                    set d to the item at (the remainder of (second + 1) divided by count) in outlinePoints
                    if bim segments a to b and c to d meet:
                        return false
        return true

# Refuses an outline that is not simple or on an unknown level, and a
# thickness that is not positive.
function add bim slab on {a 64 bit integer:levelId} around {a pointer to a list:outlinePoints} thick {a 64 bit floating-point number:thicknessValue} to {a pointer to a bim model record:target}:
    execute:
        if ((the bim level index of levelId in (@intrinsic("dereference", target)))'s valid = false) or (((bim outline outlinePoints is simple) = false) or (thicknessValue <= 0.0)):
            return the bim refused id
        set copied to a cad topology list of a cad vector2
        loop cursor from 0 to the length of outlinePoints:
            append (the item at cursor in outlinePoints) to (copied's values)
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim slab record, fresh, levelId, copied, thicknessValue, the string form of "concrete", the bim refused id, 0.0, 0.0, 0.0)) to (target's slabs's values)
        return fresh

function add bim dimension from {bim reference record:first} to {bim reference record:second} to {a pointer to a bim model record:target}:
    execute:
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim dimension record, fresh, first, second, false, a cad vector2 with x 0.0 and y 0.0)) to (target's dimensions's values)
        return fresh

# The same, its dimension line through `place`.
function add bim dimension from {bim reference record:first} to {bim reference record:second} through {cad vector2:place} to {a pointer to a bim model record:target}:
    execute:
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim dimension record, fresh, first, second, true, place)) to (target's dimensions's values)
        return fresh

function the bim tag index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's tags's values)

# Whether element `elementId` can be tagged: an opening, a wall, a plate, a
# linear element or a component instance.
function bim element {a 64 bit integer:elementId} can be tagged in {bim model record:modelValue}:
    execute:
        if (the bim opening index of elementId in modelValue)'s valid:
            return true
        if (the bim wall index of elementId in modelValue)'s valid:
            return true
        if (the bim slab index of elementId in modelValue)'s valid:
            return true
        if (the bim linear index of elementId in modelValue)'s valid:
            return true
        return (the bim instance index of elementId in modelValue)'s valid

# A new tag of element `elementId` at `place`; refused for an element that
# cannot be tagged.
function add bim tag of {a 64 bit integer:elementId} at {cad vector2:place} to {a pointer to a bim model record:target}:
    execute:
        if (bim element elementId can be tagged in (@intrinsic("dereference", target))) = false:
            return the bim refused id
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim tag record, fresh, elementId, place)) to (target's tags's values)
        note bim change of fresh in target
        return fresh

function move bim tag {a 64 bit integer:tagId} to {cad vector2:place} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim tag index of tagId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set tagValue to the item at found's position in (target's tags's values)
        replace item at index found's position in (target's tags's values) with (@intrinsic("construct", a bim tag record, tagValue's id, tagValue's elementId, place))
        note bim change of tagId in target
        return true

# The name a tag shows for element `elementId`: its type's name (the
# component's for an instance).
function the bim tag text of {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        set openingFound to the bim opening index of elementId in modelValue
        if openingFound's valid:
            set typeFound to the bim opening type index of (the item at openingFound's position in (modelValue's openings's values))'s typeId in modelValue
            if typeFound's valid:
                return (the item at typeFound's position in (modelValue's openingTypes's values))'s name
        set wallFound to the bim wall index of elementId in modelValue
        if wallFound's valid:
            set typeFound to the bim wall type index of (the item at wallFound's position in (modelValue's walls's values))'s typeId in modelValue
            if typeFound's valid:
                return (the item at typeFound's position in (modelValue's wallTypes's values))'s name
        set slabFound to the bim slab index of elementId in modelValue
        if slabFound's valid:
            set typeFound to the bim wall type index of (the item at slabFound's position in (modelValue's slabs's values))'s typeId in modelValue
            if typeFound's valid:
                return (the item at typeFound's position in (modelValue's wallTypes's values))'s name
            return the string form of "Floor"
        set linearFound to the bim linear index of elementId in modelValue
        if linearFound's valid:
            return (the bim type of linear (the item at linearFound's position in (modelValue's linears's values)) in modelValue)'s name
        set instanceFound to the bim instance index of elementId in modelValue
        if instanceFound's valid:
            set componentFound to the bim component index of (the item at instanceFound's position in (modelValue's instances's values))'s componentId in modelValue
            if componentFound's valid:
                return (the item at componentFound's position in (modelValue's components's values))'s name
        return the string form of "?"

function a bim reference to {a 64 bit integer:elementId} feature {integer:featureKind}:
    execute:
        return @intrinsic("construct", a bim reference record, elementId, featureKind)

function move bim wall {a 64 bit integer:wallId} to {cad vector2:startPoint} and {cad vector2:finishPoint} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim wall index of wallId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((the cad distance from startPoint to finishPoint) <= 1e-6):
            return false
        set wallValue to the item at found's position in (target's walls's values)
        replace item at index found's position in (target's walls's values) with (@intrinsic("construct", a bim wall record, wallValue's id, wallValue's typeId, wallValue's levelId, startPoint, finishPoint, wallValue's height, the bim bulge wallValue's bulge kept between startPoint and finishPoint, wallValue's lean, wallValue's rise, wallValue's baseOffset))
        note bim change of wallId in target
        return true

# The bulge `amount` limited to a half circle over the chord from `startPoint`
# to `finishPoint`.
function the bim bulge {a 64 bit floating-point number:amount} kept between {cad vector2:startPoint} and {cad vector2:finishPoint}:
    execute:
        set limit to (the cad distance from startPoint to finishPoint) * 0.5
        if amount > limit:
            return limit
        if amount < (0.0 - limit):
            return 0.0 - limit
        return amount

# Makes wall `wallId` curved with the bulge `amount` (0 makes it straight),
# limited to a half circle.
function bend bim wall {a 64 bit integer:wallId} by {a 64 bit floating-point number:amount} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim wall index of wallId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set wallValue to the item at found's position in (target's walls's values)
        set limited to the bim bulge amount kept between wallValue's start and wallValue's finish
        replace item at index found's position in (target's walls's values) with (@intrinsic("construct", a bim wall record, wallValue's id, wallValue's typeId, wallValue's levelId, wallValue's start, wallValue's finish, wallValue's height, limited, wallValue's lean, wallValue's rise, wallValue's baseOffset))
        note bim change of wallId in target
        return true

# Wall `wallId` is `heightValue` high.
function set bim wall {a 64 bit integer:wallId} height to {a 64 bit floating-point number:heightValue} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim wall index of wallId in (@intrinsic("dereference", target))
        if (found's valid = false) or (heightValue <= 0.0):
            return false
        set wallValue to the item at found's position in (target's walls's values)
        replace item at index found's position in (target's walls's values) with (@intrinsic("construct", a bim wall record, wallValue's id, wallValue's typeId, wallValue's levelId, wallValue's start, wallValue's finish, heightValue, wallValue's bulge, wallValue's lean, wallValue's rise, wallValue's baseOffset))
        note bim change of wallId in target
        return true

# Wall `wallId` stands with its foot `offsetValue` above its level and is
# `heightValue` high from there.
function set bim wall {a 64 bit integer:wallId} base to {a 64 bit floating-point number:offsetValue} and height to {a 64 bit floating-point number:heightValue} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim wall index of wallId in (@intrinsic("dereference", target))
        if (found's valid = false) or (heightValue <= 0.0):
            return false
        set wallValue to the item at found's position in (target's walls's values)
        replace item at index found's position in (target's walls's values) with (@intrinsic("construct", a bim wall record, wallValue's id, wallValue's typeId, wallValue's levelId, wallValue's start, wallValue's finish, heightValue, wallValue's bulge, wallValue's lean, wallValue's rise, offsetValue))
        note bim change of wallId in target
        return true

# Wall `wallId` leans its top `leanValue` metres out along its exterior
# normal and bows `riseValue` metres out at half its height. Refused when a
# shift reaches its height or more.
function set bim wall {a 64 bit integer:wallId} lean to {a 64 bit floating-point number:leanValue} and rise to {a 64 bit floating-point number:riseValue} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim wall index of wallId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set wallValue to the item at found's position in (target's walls's values)
        if ((the absolute value of leanValue) >= wallValue's height) or ((the absolute value of riseValue) >= wallValue's height):
            return false
        replace item at index found's position in (target's walls's values) with (@intrinsic("construct", a bim wall record, wallValue's id, wallValue's typeId, wallValue's levelId, wallValue's start, wallValue's finish, wallValue's height, wallValue's bulge, leanValue, riseValue, wallValue's baseOffset))
        note bim change of wallId in target
        return true

# Level `levelId` lies at `elevationValue` and is `heightValue` high.
function set bim level {a 64 bit integer:levelId} at {a 64 bit floating-point number:elevationValue} with height {a 64 bit floating-point number:heightValue} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim level index of levelId in (@intrinsic("dereference", target))
        if (found's valid = false) or (heightValue <= 0.0):
            return false
        set levelValue to the item at found's position in (target's levels's values)
        replace item at index found's position in (target's levels's values) with (@intrinsic("construct", a bim level record, levelValue's id, levelValue's name, elevationValue, heightValue))
        note bim change of levelId in target
        loop cursor from 0 to the length of (target's walls's values):
            set wallValue to the item at cursor in (target's walls's values)
            if wallValue's levelId = levelId:
                note bim change of wallValue's id in target
        loop cursor from 0 to the length of (target's slabs's values):
            set slabValue to the item at cursor in (target's slabs's values)
            if slabValue's levelId = levelId:
                note bim change of slabValue's id in target
        return true

# Opening `openingId` takes opening type `typeId`.
function set bim opening {a 64 bit integer:openingId} type to {a 64 bit integer:typeId} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim opening index of openingId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((the bim opening type index of typeId in (@intrinsic("dereference", target)))'s valid = false):
            return false
        set openingValue to the item at found's position in (target's openings's values)
        replace item at index found's position in (target's openings's values) with (@intrinsic("construct", a bim opening record, openingValue's id, typeId, openingValue's hostId, openingValue's offset))
        note bim change of openingId in target
        return true

function move bim opening {a 64 bit integer:openingId} to {a 64 bit floating-point number:offset} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim opening index of openingId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set openingValue to the item at found's position in (target's openings's values)
        replace item at index found's position in (target's openings's values) with (@intrinsic("construct", a bim opening record, openingValue's id, openingValue's typeId, openingValue's hostId, offset))
        note bim change of openingId in target
        return true

function set bim opening type {a 64 bit integer:typeId} sized {a 64 bit floating-point number:widthValue} by {a 64 bit floating-point number:heightValue} with sill {a 64 bit floating-point number:sillValue} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim opening type index of typeId in (@intrinsic("dereference", target))
        if ((found's valid = false) or (widthValue <= 0.0)) or ((heightValue <= 0.0) or (sillValue < 0.0)):
            return false
        set openingType to the item at found's position in (target's openingTypes's values)
        replace item at index found's position in (target's openingTypes's values) with (@intrinsic("construct", a bim opening type record, openingType's id, openingType's name, widthValue, heightValue, sillValue, openingType's frame, openingType's isDoor))
        note bim change of typeId in target
        name bim types by the rules in target
        return true

function set bim wall type {a 64 bit integer:typeId} layers to {a pointer to a list:layerValues} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim wall type index of typeId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((the length of layerValues) = 0):
            return false
        set copied to a cad topology list of a bim layer record
        loop index from 0 to the length of layerValues:
            set layerValue to the item at index in layerValues
            if layerValue's thickness <= 0.0:
                return false
            append layerValue to (copied's values)
        set wallType to the item at found's position in (target's wallTypes's values)
        replace item at index found's position in (target's wallTypes's values) with (@intrinsic("construct", a bim wall type record, wallType's id, wallType's name, copied, wallType's role))
        note bim change of typeId in target
        name bim types by the rules in target
        return true

# Deleting a wall deletes its hosted openings and every dimension that refers
# to either, so no reference is left dangling.
# Removes every dimension with an end on one of `removedIds`.
local function drop bim dimensions referring to {a pointer to a list:removedIds} in {a pointer to a bim model record:target}:
    execute:
        set keptDimensions to a cad topology list of a bim dimension record
        loop index from 0 to the length of (target's dimensions's values):
            set dimensionValue to the item at index in (target's dimensions's values)
            if ((removedIds contains dimensionValue's first's elementId) or (removedIds contains dimensionValue's second's elementId)) = false:
                append dimensionValue to (keptDimensions's values)
            else:
                note bim change of dimensionValue's id in target
        set target's dimensions to keptDimensions
        loop index from 0 to the length of removedIds:
            note bim change of (the item at index in removedIds) in target

function delete bim wall {a 64 bit integer:wallId} from {a pointer to a bim model record:target}:
    execute:
        set found to the bim wall index of wallId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        remove item found's position from (target's walls's values)
        set removedIds to an empty list of a 64 bit integer
        append wallId to removedIds
        set keptOpenings to a cad topology list of a bim opening record
        loop index from 0 to the length of (target's openings's values):
            set openingValue to the item at index in (target's openings's values)
            if openingValue's hostId = wallId:
                append openingValue's id to removedIds
            else:
                append openingValue to (keptOpenings's values)
        set target's openings to keptOpenings
        drop bim dimensions referring to removedIds in target
        free removedIds
        return true

# Deletes an opening and the dimensions that reference it.
function delete bim opening {a 64 bit integer:openingId} from {a pointer to a bim model record:target}:
    execute:
        set found to the bim opening index of openingId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        remove item found's position from (target's openings's values)
        set removedIds to an empty list of a 64 bit integer
        append openingId to removedIds
        drop bim dimensions referring to removedIds in target
        free removedIds
        return true

# Refuses a grid without length or with `high` not above `low`.
function add bim grid named {a string:nameValue} from {cad vector2:startPoint} to {cad vector2:finishPoint} reaching {a 64 bit floating-point number:lowValue} to {a 64 bit floating-point number:highValue} to {a pointer to a bim model record:target}:
    execute:
        if ((the cad distance from startPoint to finishPoint) <= 1e-6) or (highValue <= lowValue):
            return the bim refused id
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim grid record, fresh, nameValue, startPoint, finishPoint, lowValue, highValue)) to (target's grids's values)
        return fresh

function move bim grid {a 64 bit integer:gridId} to {cad vector2:startPoint} and {cad vector2:finishPoint} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim grid index of gridId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((the cad distance from startPoint to finishPoint) <= 1e-6):
            return false
        set gridValue to the item at found's position in (target's grids's values)
        replace item at index found's position in (target's grids's values) with (@intrinsic("construct", a bim grid record, gridId, gridValue's name, startPoint, finishPoint, gridValue's low, gridValue's high))
        note bim change of gridId in target
        return true

function delete bim grid {a 64 bit integer:gridId} from {a pointer to a bim model record:target}:
    execute:
        set found to the bim grid index of gridId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        remove item found's position from (target's grids's values)
        note bim change of gridId in target
        return true

# Replaces the outline of a slab; refused when it is not simple.
function set bim slab {a 64 bit integer:slabId} thickness to {a 64 bit floating-point number:thicknessValue} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim slab index of slabId in (@intrinsic("dereference", target))
        if (found's valid = false) or (thicknessValue <= 0.0):
            return false
        set slabValue to the item at found's position in (target's slabs's values)
        replace item at index found's position in (target's slabs's values) with (@intrinsic("construct", a bim slab record, slabValue's id, slabValue's levelId, slabValue's outline, thicknessValue, slabValue's material, slabValue's typeId, slabValue's top, slabValue's pitch, slabValue's heading))
        note bim change of slabId in target
        return true

# Slab `slabId` is now made of `materialName`; refused when it is empty.
function set bim slab {a 64 bit integer:slabId} material to {a string:materialName} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim slab index of slabId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((the length of materialName) = 0):
            return false
        set slabValue to the item at found's position in (target's slabs's values)
        replace item at index found's position in (target's slabs's values) with (@intrinsic("construct", a bim slab record, slabValue's id, slabValue's levelId, slabValue's outline, slabValue's thickness, materialName, slabValue's typeId, slabValue's top, slabValue's pitch, slabValue's heading))
        note bim change of slabId in target
        return true

function set bim slab {a 64 bit integer:slabId} outline to {a pointer to a list:outlinePoints} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim slab index of slabId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((bim outline outlinePoints is simple) = false):
            return false
        set copied to a cad topology list of a cad vector2
        loop cursor from 0 to the length of outlinePoints:
            append (the item at cursor in outlinePoints) to (copied's values)
        set slabValue to the item at found's position in (target's slabs's values)
        replace item at index found's position in (target's slabs's values) with (@intrinsic("construct", a bim slab record, slabValue's id, slabValue's levelId, copied, slabValue's thickness, slabValue's material, slabValue's typeId, slabValue's top, slabValue's pitch, slabValue's heading))
        note bim change of slabId in target
        return true

# A planar type of `roleCode` with `layerValues` (from the top face down for
# a plate, from the exterior in for a wall); refused without layers or with
# a layer not thicker than zero.
function add bim planar type named {a string:nameValue} as role {integer:roleCode} with {a pointer to a list:layerValues} to {a pointer to a bim model record:target}:
    execute:
        set fresh to add bim wall type named nameValue with layerValues to target
        if fresh = the bim refused id:
            return fresh
        set found to the bim wall type index of fresh in (@intrinsic("dereference", target))
        set made to the item at found's position in (target's wallTypes's values)
        replace item at index found's position in (target's wallTypes's values) with (@intrinsic("construct", a bim wall type record, made's id, made's name, made's layers, roleCode))
        name bim types by the rules in target
        return fresh

# The planar type of plate `slabValue`, valid when it has one.
function the bim type index of plate {bim slab record:slabValue} in {bim model record:modelValue}:
    execute:
        return the bim wall type index of slabValue's typeId in modelValue

# What plate `slabValue` is: its type's role, a floor without a type.
function the bim role of plate {bim slab record:slabValue} in {bim model record:modelValue}:
    execute:
        set found to the bim type index of plate slabValue in modelValue
        if found's valid:
            return (the item at found's position in (modelValue's wallTypes's values))'s role
        return bim floor planar role

# The thickness of plate `slabValue`: its type's layers, or its own.
function the bim thickness of plate {bim slab record:slabValue} in {bim model record:modelValue}:
    execute:
        set found to the bim type index of plate slabValue in modelValue
        if found's valid:
            return the bim thickness of (the item at found's position in (modelValue's wallTypes's values))
        return slabValue's thickness

# The material plate `slabValue` shows: its type's thickest layer's, or its
# own.
function the bim material of plate {bim slab record:slabValue} in {bim model record:modelValue}:
    execute:
        set found to the bim type index of plate slabValue in modelValue
        if found's valid = false:
            return slabValue's material
        set planarType to the item at found's position in (modelValue's wallTypes's values)
        set chosen to slabValue's material
        set thickest to 0.0
        loop cursor from 0 to the length of (planarType's layers's values):
            set layerValue to the item at cursor in (planarType's layers's values)
            if layerValue's thickness > thickest:
                set thickest to layerValue's thickness
                set chosen to layerValue's material
        return chosen

# A plate of planar type `typeId` on storey `levelId` around `outlinePoints`,
# its top `topValue` metres above the storey, level; refused for a missing
# storey or type, or an outline that crosses itself.
function add bim plate typed {a 64 bit integer:typeId} on {a 64 bit integer:levelId} around {a pointer to a list:outlinePoints} at top {a 64 bit floating-point number:topValue} to {a pointer to a bim model record:target}:
    execute:
        set typeFound to the bim wall type index of typeId in (@intrinsic("dereference", target))
        if typeFound's valid = false:
            return the bim refused id
        set planarType to the item at typeFound's position in (target's wallTypes's values)
        set fresh to add bim slab on levelId around outlinePoints thick (the bim thickness of planarType) to target
        if fresh = the bim refused id:
            return fresh
        set found to the bim slab index of fresh in (@intrinsic("dereference", target))
        set slabValue to the item at found's position in (target's slabs's values)
        replace item at index found's position in (target's slabs's values) with (@intrinsic("construct", a bim slab record, slabValue's id, slabValue's levelId, slabValue's outline, slabValue's thickness, slabValue's material, typeId, topValue, 0.0, 0.0))
        return fresh

# Plate `slabId` of planar type `typeId`.
function set bim plate {a 64 bit integer:slabId} type to {a 64 bit integer:typeId} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim slab index of slabId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((the bim wall type index of typeId in (@intrinsic("dereference", target)))'s valid = false):
            return false
        set slabValue to the item at found's position in (target's slabs's values)
        replace item at index found's position in (target's slabs's values) with (@intrinsic("construct", a bim slab record, slabValue's id, slabValue's levelId, slabValue's outline, slabValue's thickness, slabValue's material, typeId, slabValue's top, slabValue's pitch, slabValue's heading))
        note bim change of slabId in target
        return true

# Plate `slabId` with its top `topValue` above its storey, rising
# `pitchValue` radians toward `headingValue`; refused for a pitch of a
# right angle or more.
function set bim plate {a 64 bit integer:slabId} top to {a 64 bit floating-point number:topValue} pitch {a 64 bit floating-point number:pitchValue} heading {a 64 bit floating-point number:headingValue} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim slab index of slabId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((the absolute value of pitchValue) >= 1.5):
            return false
        set slabValue to the item at found's position in (target's slabs's values)
        replace item at index found's position in (target's slabs's values) with (@intrinsic("construct", a bim slab record, slabValue's id, slabValue's levelId, slabValue's outline, slabValue's thickness, slabValue's material, slabValue's typeId, topValue, pitchValue, headingValue))
        note bim change of slabId in target
        return true

# Deletes a slab. No dimension refers to a slab.
function delete bim slab {a 64 bit integer:slabId} from {a pointer to a bim model record:target}:
    execute:
        set found to the bim slab index of slabId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        remove item found's position from (target's slabs's values)
        note bim change of slabId in target
        return true

# ---------------------------------------------------------------- sketches

local function add bim sketch of kind {integer:kind} on {a 64 bit integer:levelId} through {a pointer to a list:pointList} rising {a 64 bit floating-point number:rise} saying {a string:message} to {a pointer to a bim model record:target}:
    execute:
        if (the bim level index of levelId in (@intrinsic("dereference", target)))'s valid = false:
            return the bim refused id
        set copied to a cad topology list of a cad vector2
        loop cursor from 0 to the length of pointList:
            append (the item at cursor in pointList) to (copied's values)
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim sketch record, fresh, levelId, kind, copied, rise, message)) to (target's sketches's values)
        return fresh

# A line on storey `levelId` from `startPoint` to `finishPoint`; refused when
# it has no length.
function add bim line on {a 64 bit integer:levelId} from {cad vector2:startPoint} to {cad vector2:finishPoint} to {a pointer to a bim model record:target}:
    execute:
        if (the cad distance from startPoint to finishPoint) <= 1e-6:
            return the bim refused id
        set ends to an empty list of a cad vector2
        append startPoint to ends
        append finishPoint to ends
        set fresh to add bim sketch of kind bim line sketch on levelId through ends rising 0.0 saying (the string form of "") to target
        free ends
        return fresh

# A flat face on storey `levelId` inside `outlinePoints`; refused unless the
# outline is simple.
function add bim face on {a 64 bit integer:levelId} around {a pointer to a list:outlinePoints} to {a pointer to a bim model record:target}:
    execute:
        if (bim outline outlinePoints is simple) = false:
            return the bim refused id
        return add bim sketch of kind bim face sketch on levelId through outlinePoints rising 0.0 saying (the string form of "") to target

# A text on storey `levelId` anchored at `anchor`; refused when empty.
function add bim text on {a 64 bit integer:levelId} at {cad vector2:anchor} saying {a string:message} to {a pointer to a bim model record:target}:
    execute:
        if (the length of message) = 0:
            return the bim refused id
        set spot to an empty list of a cad vector2
        append anchor to spot
        set fresh to add bim sketch of kind bim text sketch on levelId through spot rising 0.0 saying message to target
        free spot
        return fresh

# Push/pull: face `faceId` becomes a mass `rise` high (0 flattens it again).
function set bim face {a 64 bit integer:faceId} height to {a 64 bit floating-point number:rise} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim sketch index of faceId in (@intrinsic("dereference", target))
        if (found's valid = false) or (rise < 0.0):
            return false
        set sketch to the item at found's position in (target's sketches's values)
        if sketch's kind != bim face sketch:
            return false
        replace item at index found's position in (target's sketches's values) with (@intrinsic("construct", a bim sketch record, sketch's id, sketch's levelId, sketch's kind, sketch's points, rise, sketch's content))
        note bim change of faceId in target
        return true

# Moves sketch `sketchId` by `offset`.
function move bim sketch {a 64 bit integer:sketchId} by {cad vector2:offset} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim sketch index of sketchId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set element to the item at found's position in (target's sketches's values)
        set moved to a cad topology list of a cad vector2
        loop cursor from 0 to the length of (element's points's values):
            set point to the item at cursor in (element's points's values)
            append (a cad vector2 with x (point's x + offset's x) and y (point's y + offset's y)) to (moved's values)
        replace item at index found's position in (target's sketches's values) with (@intrinsic("construct", a bim sketch record, element's id, element's levelId, element's kind, moved, element's height, element's content))
        note bim change of sketchId in target
        return true

# Sketch element `sketchId` now runs through `pointList`.
function set bim sketch {a 64 bit integer:sketchId} points to {a pointer to a list:pointList} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim sketch index of sketchId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set element to the item at found's position in (target's sketches's values)
        set placed to a cad topology list of a cad vector2
        loop cursor from 0 to the length of pointList:
            append (the item at cursor in pointList) to (placed's values)
        replace item at index found's position in (target's sketches's values) with (@intrinsic("construct", a bim sketch record, element's id, element's levelId, element's kind, placed, element's height, element's content))
        note bim change of sketchId in target
        return true

function delete bim sketch {a 64 bit integer:sketchId} from {a pointer to a bim model record:target}:
    execute:
        set found to the bim sketch index of sketchId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        remove item found's position from (target's sketches's values)
        note bim change of sketchId in target
        return true

# ---------------------------------------------------------------- components

# `point` of a component placed at `origin`, turned `angle`.
function the bim plan point of {cad vector2:point} at {cad vector2:origin} turned {a 64 bit floating-point number:angle}:
    execute:
        set cosine to the cosine of angle
        set sine to the sine of angle
        return a cad vector2 with x (origin's x + ((point's x * cosine) - (point's y * sine))) and y (origin's y + ((point's x * sine) + (point's y * cosine)))

# The inverse: the component coordinates of `point`.
function the bim component coordinates of {cad vector2:location} at {cad vector2:origin} turned {a 64 bit floating-point number:angle}:
    execute:
        set cosine to the cosine of angle
        set sine to the sine of angle
        set dx to location's x - origin's x
        set dy to location's y - origin's y
        return a cad vector2 with x ((dx * cosine) + (dy * sine)) and y ((dy * cosine) - (dx * sine))

# `element` moved from component coordinates to `placement`; it takes the
# placement's id and storey, so that a pick on it finds the instance.
function the bim sketch {bim sketch record:element} placed by {bim instance record:placement}:
    execute:
        set moved to a cad topology list of a cad vector2
        loop cursor from 0 to the length of (element's points's values):
            append (the bim plan point of (the item at cursor in (element's points's values)) at placement's origin turned placement's angle) to (moved's values)
        return @intrinsic("construct", a bim sketch record, placement's id, placement's levelId, element's kind, moved, element's height, element's content)

# Every sketch element as it is drawn: the free ones, then those of every
# instance in plan coordinates.
function the bim drawn sketches of {bim model record:modelValue}:
    execute:
        return the bim drawn sketches of modelValue seen from view ((0 - 2) as a 64 bit integer)

# The same as drawn in view `viewId`: model instances and the 2D instances of
# that view. The refused id gives the model instances only (as 3D shows
# them); -2 gives every instance.
function the bim drawn sketches of {bim model record:modelValue} seen from view {a 64 bit integer:viewId}:
    execute:
        set result to a cad topology list of a bim sketch record
        loop cursor from 0 to the length of (modelValue's sketches's values):
            append (the item at cursor in (modelValue's sketches's values)) to (result's values)
        loop cursor from 0 to the length of (modelValue's instances's values):
            set placement to the item at cursor in (modelValue's instances's values)
            set found to the bim component index of placement's componentId in modelValue
            set shownHere to ((viewId = ((0 - 2) as a 64 bit integer)) or (placement's viewId = the bim refused id)) or (placement's viewId = viewId)
            if found's valid and shownHere:
                set definition to the item at found's position in (modelValue's components's values)
                loop part from 0 to the length of (definition's sketches's values):
                    append (the bim sketch (the item at part in (definition's sketches's values)) placed by placement) to (result's values)
        return result

# Instance `instanceId` drawn in view `viewId` only (a 2D detail component),
# or, given the refused id, in every plan of its storey and in 3D.
function set bim instance {a 64 bit integer:instanceId} view to {a 64 bit integer:viewId} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim instance index of instanceId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set placement to the item at found's position in (target's instances's values)
        set placement's viewId to viewId
        replace item at index found's position in (target's instances's values) with placement
        note bim change of instanceId in target
        return true

# A new instance of component `componentId` on storey `levelId`.
function place bim component {a 64 bit integer:componentId} on {a 64 bit integer:levelId} at {cad vector2:origin} turned {a 64 bit floating-point number:angle} to {a pointer to a bim model record:target}:
    execute:
        if ((the bim component index of componentId in (@intrinsic("dereference", target)))'s valid = false) or ((the bim level index of levelId in (@intrinsic("dereference", target)))'s valid = false):
            return the bim refused id
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim instance record, fresh, componentId, levelId, origin, angle, the bim refused id)) to (target's instances's values)
        return fresh

# The sketch elements `sketchIds` become component `name`, its origin the
# lower left corner of their extent, and one instance of it takes their
# place. Returns the instance, or the refused id when no id names a sketch on
# storey `levelId`.
function make bim component named {a string:name} from {a pointer to a list:sketchIds} on {a 64 bit integer:levelId} to {a pointer to a bim model record:target}:
    execute:
        set chosen to an empty list of a bim sketch record
        loop cursor from 0 to the length of sketchIds:
            set found to the bim sketch index of (the item at cursor in sketchIds) in (@intrinsic("dereference", target))
            if found's valid:
                set element to the item at found's position in (target's sketches's values)
                if element's levelId = levelId:
                    append element to chosen
        if (the length of chosen) = 0:
            free chosen
            return the bim refused id
        set lowX to 1e300
        set lowY to 1e300
        loop cursor from 0 to the length of chosen:
            set element to the item at cursor in chosen
            loop corner from 0 to the length of (element's points's values):
                set point to the item at corner in (element's points's values)
                set lowX to the minimum of lowX and point's x
                set lowY to the minimum of lowY and point's y
        set origin to a cad vector2 with x lowX and y lowY
        set kept to a cad topology list of a bim sketch record
        loop cursor from 0 to the length of chosen:
            set element to the item at cursor in chosen
            set relative to a cad topology list of a cad vector2
            loop corner from 0 to the length of (element's points's values):
                set point to the item at corner in (element's points's values)
                append (a cad vector2 with x (point's x - lowX) and y (point's y - lowY)) to (relative's values)
            append (@intrinsic("construct", a bim sketch record, element's id, 0 as a 64 bit integer, element's kind, relative, element's height, element's content)) to (kept's values)
            ignore delete bim sketch element's id from target
        free chosen
        set componentId to the bim new id in target
        append (@intrinsic("construct", a bim component record, componentId, name, kept, a cad topology list of a bim solid part record, 0, a cad topology list of a bim component connector record)) to (target's components's values)
        return place bim component componentId on levelId at origin turned 0.0 to target

# Component `componentId` now holds `parts` (component coordinates); every
# instance follows.
function set bim component {a 64 bit integer:componentId} contents to {a pointer to a list:parts} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim component index of componentId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set definition to the item at found's position in (target's components's values)
        set kept to a cad topology list of a bim sketch record
        loop cursor from 0 to the length of parts:
            append (the item at cursor in parts) to (kept's values)
        replace item at index found's position in (target's components's values) with (@intrinsic("construct", a bim component record, definition's id, definition's name, kept, definition's solids, definition's role, definition's connectors))
        note bim change of componentId in target
        loop cursor from 0 to the length of (target's instances's values):
            set placement to the item at cursor in (target's instances's values)
            if placement's componentId = componentId:
                note bim change of placement's id in target
        return true

# Closed mesh `meshId` becomes a part of component `componentId`, moved by
# `shift` into the component's coordinates and added (or cut or
# intersected by `operationCode`); the free mesh goes. Refused for a mesh
# that is missing.
function move bim mesh {a 64 bit integer:meshId} into component {a 64 bit integer:componentId} shifted by {cad vector3:shift} as {integer:operationCode} in {a pointer to a bim model record:target}:
    execute:
        set meshFound to the bim mesh index of meshId in (@intrinsic("dereference", target))
        set found to the bim component index of componentId in (@intrinsic("dereference", target))
        if (meshFound's valid = false) or (found's valid = false):
            return false
        set meshValue to the item at meshFound's position in (target's meshes's values)
        set movedPoints to a cad topology list of a cad vector3
        loop cursor from 0 to the length of (meshValue's vertices's values):
            append (the cad sum of (the item at cursor in (meshValue's vertices's values)) and shift) to (movedPoints's values)
        set copiedFaces to a cad topology list of an integer
        loop cursor from 0 to the length of (meshValue's faces's values):
            append (the item at cursor in (meshValue's faces's values)) to (copiedFaces's values)
        set definition to the item at found's position in (target's components's values)
        set solids to the cad clone of definition's solids
        set noOrigin to a cad vector3 with x 0.0, y 0.0 and z 0.0
        append (@intrinsic("construct", a bim solid part record, bim mesh solid, operationCode, noOrigin, noOrigin, 0.0, a cad topology list of a cad vector2, the string form of "generic", movedPoints, copiedFaces)) to (solids's values)
        replace item at index found's position in (target's components's values) with (@intrinsic("construct", a bim component record, definition's id, definition's name, definition's sketches, solids, definition's role, definition's connectors))
        ignore delete bim mesh meshId from target
        note bim change of componentId in target
        loop cursor from 0 to the length of (target's instances's values):
            set placement to the item at cursor in (target's instances's values)
            if placement's componentId = componentId:
                note bim change of placement's id in target
        return true

# Solid part `partIndex` of component `componentId` resized to `size` (as
# `add bim solid …` takes it); refused for a size the part cannot have.
function resize bim solid {integer:partIndex} of component {a 64 bit integer:componentId} to {cad vector3:size} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim component index of componentId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set definition to the item at found's position in (target's components's values)
        if (partIndex < 0) or (partIndex >= (the length of (definition's solids's values))):
            return false
        set original to the item at partIndex in (definition's solids's values)
        set fits to (size's x > 0.0) and (size's z > 0.0)
        if original's kind = bim box solid:
            set fits to fits and (size's y > 0.0)
        if original's kind = bim sphere solid:
            set fits to size's x > 0.0
        if original's kind = bim extrusion solid:
            set fits to size's z > 0.0
        if original's kind = bim mesh solid:
            set fits to false
        if fits = false:
            return false
        set solids to the cad clone of definition's solids
        replace item at index partIndex in (solids's values) with (@intrinsic("construct", a bim solid part record, original's kind, original's operation, original's origin, size, original's angle, original's profile, original's material, original's points, original's faces))
        replace item at index found's position in (target's components's values) with (@intrinsic("construct", a bim component record, definition's id, definition's name, definition's sketches, solids, definition's role, definition's connectors))
        note bim change of componentId in target
        loop cursor from 0 to the length of (target's instances's values):
            set placement to the item at cursor in (target's instances's values)
            if placement's componentId = componentId:
                note bim change of placement's id in target
        return true

# A new component of no parts yet, for solid parts to go into; its id.
function add bim component named {a string:title} to {a pointer to a bim model record:target}:
    execute:
        set componentId to the bim new id in target
        append (@intrinsic("construct", a bim component record, componentId, title, a cad topology list of a bim sketch record, a cad topology list of a bim solid part record, 0, a cad topology list of a bim component connector record)) to (target's components's values)
        return componentId

# A solid part added to component `componentId` (after its other parts);
# refused for a size it cannot have.
function add bim solid of kind {integer:kindCode} as {integer:operationCode} at {cad vector3:origin} sized {cad vector3:size} turned {a 64 bit floating-point number:turn} along {a pointer to a list:profilePoints} of {a string:materialName} to component {a 64 bit integer:componentId} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim component index of componentId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set sizeValid to (size's x > 0.0) and (size's z > 0.0)
        if kindCode = bim box solid:
            set sizeValid to sizeValid and (size's y > 0.0)
        if kindCode = bim sphere solid:
            set sizeValid to size's x > 0.0
        if kindCode = bim extrusion solid:
            set sizeValid to (size's z > 0.0) and ((the length of profilePoints) >= 3)
        if sizeValid = false:
            return false
        set definition to the item at found's position in (target's components's values)
        set copied to a cad topology list of a cad vector2
        loop cursor from 0 to the length of profilePoints:
            append (the item at cursor in profilePoints) to (copied's values)
        set solids to the cad clone of definition's solids
        append (@intrinsic("construct", a bim solid part record, kindCode, operationCode, origin, size, turn, copied, materialName, a cad topology list of a cad vector3, a cad topology list of an integer)) to (solids's values)
        replace item at index found's position in (target's components's values) with (@intrinsic("construct", a bim component record, definition's id, definition's name, definition's sketches, solids, definition's role, definition's connectors))
        note bim change of componentId in target
        loop cursor from 0 to the length of (target's instances's values):
            set placement to the item at cursor in (target's instances's values)
            if placement's componentId = componentId:
                note bim change of placement's id in target
        return true

function move bim instance {a 64 bit integer:instanceId} to {cad vector2:origin} turned {a 64 bit floating-point number:angle} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim instance index of instanceId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set placement to the item at found's position in (target's instances's values)
        replace item at index found's position in (target's instances's values) with (@intrinsic("construct", a bim instance record, placement's id, placement's componentId, placement's levelId, origin, angle, placement's viewId))
        note bim change of instanceId in target
        return true

# Removes instance `instanceId`; the component stays, also without instances.
function delete bim instance {a 64 bit integer:instanceId} from {a pointer to a bim model record:target}:
    execute:
        set found to the bim instance index of instanceId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        remove item found's position from (target's instances's values)
        note bim change of instanceId in target
        return true

# Explodes instance `instanceId`: its parts become free sketch elements in
# plan coordinates. Returns how many.
function explode bim instance {a 64 bit integer:instanceId} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim instance index of instanceId in (@intrinsic("dereference", target))
        if found's valid = false:
            return 0
        set placement to the item at found's position in (target's instances's values)
        set definitionFound to the bim component index of placement's componentId in (@intrinsic("dereference", target))
        set made to 0
        if definitionFound's valid:
            set definition to the item at definitionFound's position in (target's components's values)
            loop part from 0 to the length of (definition's sketches's values):
                set placed to the bim sketch (the item at part in (definition's sketches's values)) placed by placement
                set fresh to the bim new id in target
                append (@intrinsic("construct", a bim sketch record, fresh, placed's levelId, placed's kind, placed's points, placed's height, placed's content)) to (target's sketches's values)
                set made to made + 1
        ignore delete bim instance instanceId from target
        return made

# ---------------------------------------------------------------- meshes

# Whether `faces` (counts and indices) refers only to points of `vertexCount`
# and every face has at least three.
function bim mesh faces {a pointer to a list:faceList} fit {integer:vertexCount}:
    execute:
        set cursor to 0
        if (the length of faceList) = 0:
            return false
        loop while cursor < the length of faceList:
            set count to the item at cursor in faceList
            if (count < 3) or ((cursor + count) >= the length of faceList):
                return false
            loop corner from 1 to (count + 1):
                set pointIndex to the item at (cursor + corner) in faceList
                if (pointIndex < 0) or (pointIndex >= vertexCount):
                    return false
            set cursor to cursor + (count + 1)
        return true

function the bim face count of mesh {bim mesh record:meshValue}:
    execute:
        set total to 0
        set start to 0
        loop while start < the length of (meshValue's faces's values):
            set total to total + 1
            set start to start + ((the item at start in (meshValue's faces's values)) + 1)
        return total

# A mesh on storey `levelId`; refused when a face does not fit its points.
function add bim mesh on {a 64 bit integer:levelId} with {a pointer to a list:pointList} and {a pointer to a list:faceList} to {a pointer to a bim model record:target}:
    execute:
        if ((the bim level index of levelId in (@intrinsic("dereference", target)))'s valid = false) or ((bim mesh faces faceList fit (the length of pointList)) = false):
            return the bim refused id
        set copiedPoints to a cad topology list of a cad vector3
        loop cursor from 0 to the length of pointList:
            append (the item at cursor in pointList) to (copiedPoints's values)
        set copiedFaces to a cad topology list of an integer
        loop cursor from 0 to the length of faceList:
            append (the item at cursor in faceList) to (copiedFaces's values)
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim mesh record, fresh, levelId, copiedPoints, copiedFaces)) to (target's meshes's values)
        return fresh

# Mesh `meshId` now has `pointList` and `faceList`.
function set bim mesh {a 64 bit integer:meshId} to {a pointer to a list:pointList} and {a pointer to a list:faceList} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim mesh index of meshId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((bim mesh faces faceList fit (the length of pointList)) = false):
            return false
        set meshValue to the item at found's position in (target's meshes's values)
        set copiedPoints to a cad topology list of a cad vector3
        loop cursor from 0 to the length of pointList:
            append (the item at cursor in pointList) to (copiedPoints's values)
        set copiedFaces to a cad topology list of an integer
        loop cursor from 0 to the length of faceList:
            append (the item at cursor in faceList) to (copiedFaces's values)
        replace item at index found's position in (target's meshes's values) with (@intrinsic("construct", a bim mesh record, meshValue's id, meshValue's levelId, copiedPoints, copiedFaces))
        note bim change of meshId in target
        return true

function the bim linear index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's linears's values)

function the bim linear type index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's linearTypes's values)

# The type of `linear`; a 0.1 m square generic one when its type is gone.
function the bim type of linear {bim linear record:linearValue} in {bim model record:modelValue}:
    execute:
        set found to the bim linear type index of linearValue's typeId in modelValue
        if found's valid:
            return the item at found's position in (modelValue's linearTypes's values)
        return @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "", bim generic linear role, 0.1, 0.1, false, the string form of "")

# A linear type; refused without a positive profile.
function add bim linear type named {a string:typeName} as role {integer:roleCode} sized {a 64 bit floating-point number:widthValue} by {a 64 bit floating-point number:depthValue} round {boolean:isRound} of {a string:materialName} to {a pointer to a bim model record:target}:
    execute:
        if (widthValue <= 0.0) or (depthValue <= 0.0):
            return the bim refused id
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim linear type record, fresh, typeName, roleCode, widthValue, depthValue, isRound, materialName)) to (target's linearTypes's values)
        name bim types by the rules in target
        return fresh

# Linear type `typeId` with a profile `widthValue` by `depthValue`; every
# element of the type follows.
function size bim linear type {a 64 bit integer:typeId} to {a 64 bit floating-point number:widthValue} by {a 64 bit floating-point number:depthValue} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim linear type index of typeId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((widthValue <= 0.0) or (depthValue <= 0.0)):
            return false
        set linearType to the item at found's position in (target's linearTypes's values)
        replace item at index found's position in (target's linearTypes's values) with (@intrinsic("construct", a bim linear type record, linearType's id, linearType's name, linearType's role, widthValue, depthValue, linearType's round, linearType's material))
        loop cursor from 0 to the length of (target's linears's values):
            set linearValue to the item at cursor in (target's linears's values)
            if linearValue's typeId = typeId:
                note bim change of linearValue's id in target
        name bim types by the rules in target
        return true

# Linear type `typeId` of `materialName`; its elements follow and its name
# follows the rules.
function set bim linear type {a 64 bit integer:typeId} material to {a string:materialName} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim linear type index of typeId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set linearType to the item at found's position in (target's linearTypes's values)
        replace item at index found's position in (target's linearTypes's values) with (@intrinsic("construct", a bim linear type record, linearType's id, linearType's name, linearType's role, linearType's width, linearType's depth, linearType's round, materialName))
        loop cursor from 0 to the length of (target's linears's values):
            set linearValue to the item at cursor in (target's linears's values)
            if linearValue's typeId = typeId:
                note bim change of linearValue's id in target
        note bim change of typeId in target
        name bim types by the rules in target
        return true

# The material the type editor offers after `materialName`, in turn.
function the bim material after {a string:materialName}:
    execute:
        set offered to an empty list of a string
        append (the string form of "brick") to offered
        append (the string form of "sand-lime") to offered
        append (the string form of "concrete") to offered
        append (the string form of "insulation") to offered
        append (the string form of "PIR insulation") to offered
        append (the string form of "timber") to offered
        append (the string form of "steel") to offered
        append (the string form of "gypsum") to offered
        append (the string form of "air cavity") to offered
        append (the string form of "generic") to offered
        set result to the item at 0 in offered
        loop cursor from 0 to the length of offered:
            if (the item at cursor in offered) = materialName:
                set result to the item at (the remainder of (cursor + 1) divided by (the length of offered)) in offered
        free offered
        return result

# A linear element of type `typeId` on storey `levelId` along `fromSpot` to
# `toSpot`; refused for a missing storey or type, or an axis shorter than a
# millimetre.
function add bim linear typed {a 64 bit integer:typeId} on {a 64 bit integer:levelId} from {cad vector3:fromSpot} to {cad vector3:toSpot} turned {a 64 bit floating-point number:turn} to {a pointer to a bim model record:target}:
    execute:
        if (the bim level index of levelId in (@intrinsic("dereference", target)))'s valid = false:
            return the bim refused id
        if (the bim linear type index of typeId in (@intrinsic("dereference", target)))'s valid = false:
            return the bim refused id
        if (the cad length of (the cad difference of toSpot and fromSpot)) < 0.001:
            return the bim refused id
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim linear record, fresh, typeId, levelId, fromSpot, toSpot, turn)) to (target's linears's values)
        return fresh

# Linear element `linearId` along `fromSpot` to `toSpot`, turned `turn`.
function move bim linear {a 64 bit integer:linearId} to {cad vector3:fromSpot} and {cad vector3:toSpot} turned {a 64 bit floating-point number:turn} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim linear index of linearId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((the cad length of (the cad difference of toSpot and fromSpot)) < 0.001):
            return false
        set linearValue to the item at found's position in (target's linears's values)
        replace item at index found's position in (target's linears's values) with (@intrinsic("construct", a bim linear record, linearValue's id, linearValue's typeId, linearValue's levelId, fromSpot, toSpot, turn))
        note bim change of linearId in target
        return true

# Linear element `linearId` of type `typeId` instead.
function set bim linear {a 64 bit integer:linearId} type to {a 64 bit integer:typeId} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim linear index of linearId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((the bim linear type index of typeId in (@intrinsic("dereference", target)))'s valid = false):
            return false
        set linearValue to the item at found's position in (target's linears's values)
        replace item at index found's position in (target's linears's values) with (@intrinsic("construct", a bim linear record, linearValue's id, typeId, linearValue's levelId, linearValue's start, linearValue's finish, linearValue's angle))
        note bim change of linearId in target
        return true

function delete bim linear {a 64 bit integer:linearId} from {a pointer to a bim model record:target}:
    execute:
        set found to the bim linear index of linearId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        remove item found's position from (target's linears's values)
        note bim change of linearId in target
        return true

function delete bim mesh {a 64 bit integer:meshId} from {a pointer to a bim model record:target}:
    execute:
        set found to the bim mesh index of meshId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        remove item found's position from (target's meshes's values)
        note bim change of meshId in target
        return true

# The normal of the face of `meshValue` whose loop starts at `start` in its
# faces (Newell's method, so a face that is not quite flat still has one).
function the bim normal of mesh face {integer:start} of {bim mesh record:meshValue}:
    execute:
        set count to the item at start in (meshValue's faces's values)
        set nx to 0.0
        set ny to 0.0
        set nz to 0.0
        loop corner from 0 to count:
            set here to the item at (the item at ((start + 1) + corner) in (meshValue's faces's values)) in (meshValue's vertices's values)
            set following to the item at (the item at ((start + 1) + (the remainder of (corner + 1) divided by count)) in (meshValue's faces's values)) in (meshValue's vertices's values)
            set nx to nx + ((here's y - following's y) * (here's z + following's z))
            set ny to ny + ((here's z - following's z) * (here's x + following's x))
            set nz to nz + ((here's x - following's x) * (here's y + following's y))
        set size to the square root of (((nx * nx) + (ny * ny)) + (nz * nz))
        if size <= 1e-15:
            return a cad vector3 with x 0.0, y 0.0 and z 1.0
        return a cad vector3 with x (nx / size), y (ny / size) and z (nz / size)

# Whether the face of `meshValue` starting at `first` and the one starting at
# `second` share a point.
function bim mesh faces {integer:first} and {integer:second} of {bim mesh record:meshValue} touch:
    execute:
        set entries to meshValue's faces's values
        loop corner from 0 to (the item at first in entries):
            set here to the item at ((first + 1) + corner) in entries
            loop other from 0 to (the item at second in entries):
                if (the item at ((second + 1) + other) in entries) = here:
                    return true
        return false

# Mesh `meshId` becomes `source` with its face starting at `start` pushed
# `distance` along its normal, as SketchUp's push/pull: when every other face
# touching it runs along the push, the face itself moves and they stretch;
# otherwise it is extruded, each of its edges growing a side.
function push bim mesh {a 64 bit integer:meshId} face {integer:start} of {bim mesh record:source} by {a 64 bit floating-point number:distance} in {a pointer to a bim model record:target}:
    execute:
        set entries to source's faces's values
        if (start < 0) or (start >= the length of entries):
            return false
        set count to the item at start in entries
        set normal to the bim normal of mesh face start of source
        set shift to normal scaled by distance
        set sliding to true
        set cursor to 0
        loop while cursor < the length of entries:
            if (cursor != start) and (bim mesh faces cursor and start of source touch):
                if (the absolute value of (the cad dot of (the bim normal of mesh face cursor of source) and normal)) > 1e-6:
                    set sliding to false
            set cursor to cursor + ((the item at cursor in entries) + 1)
        set pointList to an empty list of a cad vector3
        loop cursor from 0 to the length of (source's vertices's values):
            append (the item at cursor in (source's vertices's values)) to pointList
        set faceList to an empty list of an integer
        if sliding:
            loop corner from 0 to count:
                set slot to the item at ((start + 1) + corner) in entries
                replace item at index slot in pointList with (the cad sum of (the item at slot in pointList) and shift)
            loop cursor from 0 to the length of entries:
                append (the item at cursor in entries) to faceList
        else:
            set base to the length of pointList
            loop corner from 0 to count:
                append (the cad sum of (the item at (the item at ((start + 1) + corner) in entries) in pointList) and shift) to pointList
            loop cursor from 0 to the length of entries:
                set entry to the item at cursor in entries
                if (cursor > start) and (cursor <= (start + count)):
                    set entry to base + ((cursor - start) - 1)
                append entry to faceList
            loop corner from 0 to count:
                set following to the remainder of (corner + 1) divided by count
                append 4 to faceList
                append (the item at ((start + 1) + corner) in entries) to faceList
                append (the item at ((start + 1) + following) in entries) to faceList
                append (base + following) to faceList
                append (base + corner) to faceList
        set done to set bim mesh meshId to pointList and faceList in target
        free pointList
        free faceList
        return done

# The faces `entries` with point `fresh` put between `first` and `second`
# wherever they follow each other in a face, either way round, so that the
# faces on both sides of that edge keep sharing it.
function the bim mesh faces {a pointer to a list:entries} with {integer:fresh} between {integer:first} and {integer:second}:
    execute:
        set result to an empty list of an integer
        set start to 0
        loop while start < the length of entries:
            set count to the item at start in entries
            set grown to 0
            loop corner from 0 to count:
                set here to the item at ((start + 1) + corner) in entries
                set following to the item at ((start + 1) + (the remainder of (corner + 1) divided by count)) in entries
                if ((here = first) and (following = second)) or ((here = second) and (following = first)):
                    set grown to grown + 1
            append (count + grown) to result
            loop corner from 0 to count:
                set here to the item at ((start + 1) + corner) in entries
                set following to the item at ((start + 1) + (the remainder of (corner + 1) divided by count)) in entries
                append here to result
                if ((here = first) and (following = second)) or ((here = second) and (following = first)):
                    append fresh to result
            set start to start + (count + 1)
        return result

# Where the loop of face number `ordinal` (counting from 0) starts in
# `entries`; -1 when there is no such face.
function the bim start of mesh face number {integer:ordinal} in {a pointer to a list:entries}:
    execute:
        set start to 0
        set seen to 0
        loop while start < the length of entries:
            if seen = ordinal:
                return start
            set seen to seen + 1
            set start to start + ((the item at start in entries) + 1)
        return -1

# The point of the loop of face `start` at `spot` (within `tolerance`), as a
# point number, after putting it on the edge it lies on when it is not a
# corner yet. `pointList` and the faces `entries` grow as needed; -1 when
# `spot` is not on the face's outline.
function the bim mesh point at {cad vector3:spot} on face {integer:start} within {a 64 bit floating-point number:tolerance} adding to {a pointer to a list:pointList} and {a pointer to a list:entries}:
    execute:
        set count to the item at start in entries
        loop corner from 0 to count:
            set here to the item at ((start + 1) + corner) in entries
            if (the cad distance from spot to (the item at here in pointList)) <= tolerance:
                return here
        loop corner from 0 to count:
            set here to the item at ((start + 1) + corner) in entries
            set following to the item at ((start + 1) + (the remainder of (corner + 1) divided by count)) in entries
            set edgeStart to the item at here in pointList
            set run to the cad difference of (the item at following in pointList) and edgeStart
            set runLength to the cad dot of run and run
            if runLength > 1e-18:
                set along to (the cad dot of (the cad difference of spot and edgeStart) and run) / runLength
                if (along > 0.0) and (along < 1.0):
                    set foot to the cad sum of edgeStart and (run scaled by along)
                    if (the cad distance from spot to foot) <= tolerance:
                        set fresh to the length of pointList
                        append foot to pointList
                        set widened to the bim mesh faces entries with fresh between here and following
                        clear entries
                        loop cursor from 0 to the length of widened:
                            append (the item at cursor in widened) to entries
                        free widened
                        return fresh
        return -1

# Mesh `meshId` with face `start` cut in two along the straight line from
# `fromSpot` to `toSpot`, both on its outline (corners or points on edges, in
# the mesh's coordinates), as a line drawn across a face does in SketchUp.
# Refused when a point is off the outline or both lie on one edge.
function split bim mesh {a 64 bit integer:meshId} face {integer:start} from {cad vector3:fromSpot} to {cad vector3:toSpot} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim mesh index of meshId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set meshValue to the item at found's position in (target's meshes's values)
        if (start < 0) or (start >= the length of (meshValue's faces's values)):
            return false
        set ordinal to 0
        set walker to 0
        loop while walker < start:
            set ordinal to ordinal + 1
            set walker to walker + ((the item at walker in (meshValue's faces's values)) + 1)
        if walker != start:
            return false
        set pointList to an empty list of a cad vector3
        loop cursor from 0 to the length of (meshValue's vertices's values):
            append (the item at cursor in (meshValue's vertices's values)) to pointList
        set entries to an empty list of an integer
        loop cursor from 0 to the length of (meshValue's faces's values):
            append (the item at cursor in (meshValue's faces's values)) to entries
        set firstPoint to the bim mesh point at fromSpot on face start within 1e-4 adding to pointList and entries
        set faceStart to the bim start of mesh face number ordinal in entries
        set secondPoint to -1
        if firstPoint >= 0:
            set secondPoint to the bim mesh point at toSpot on face faceStart within 1e-4 adding to pointList and entries
        set faceStart to the bim start of mesh face number ordinal in entries
        set done to false
        if (firstPoint >= 0) and ((secondPoint >= 0) and (firstPoint != secondPoint)):
            set count to the item at faceStart in entries
            set firstAt to -1
            set secondAt to -1
            loop corner from 0 to count:
                if (the item at ((faceStart + 1) + corner) in entries) = firstPoint:
                    set firstAt to corner
                if (the item at ((faceStart + 1) + corner) in entries) = secondPoint:
                    set secondAt to corner
            set gap to the remainder of ((secondAt - firstAt) + count) divided by count
            # Neighbours on the loop would cut nothing off.
            if ((firstAt >= 0) and (secondAt >= 0)) and ((gap >= 2) and (gap <= (count - 2))):
                set faceList to an empty list of an integer
                loop cursor from 0 to faceStart:
                    append (the item at cursor in entries) to faceList
                # This face keeps the run from the first point to the second;
                # the rest of the loop becomes a new face at the end.
                append (gap + 1) to faceList
                loop step from 0 to (gap + 1):
                    append (the item at ((faceStart + 1) + (the remainder of (firstAt + step) divided by count)) in entries) to faceList
                loop cursor from ((faceStart + 1) + count) to the length of entries:
                    append (the item at cursor in entries) to faceList
                append ((count - gap) + 1) to faceList
                loop step from 0 to ((count - gap) + 1):
                    append (the item at ((faceStart + 1) + (the remainder of (secondAt + step) divided by count)) in entries) to faceList
                set done to set bim mesh meshId to pointList and faceList in target
                free faceList
        free pointList
        free entries
        return done

# The points and faces of mass `element` (a face raised its height) as a
# free mesh: its foot and top faces and a side for each edge, the outline
# turning anticlockwise seen from above.
function fill bim mesh lists of mass {bim sketch record:element} into {a pointer to a list:pointList} and {a pointer to a list:faceList}:
    execute:
        set ring to element's points's values
        set count to the length of ring
        set reversed to (the cad signed area of ring) < 0.0
        loop tier from 0 to 2:
            loop cursor from 0 to count:
                set source to cursor
                if reversed:
                    set source to (count - 1) - cursor
                set point to the item at source in ring
                append (a cad vector3 with x point's x, y point's y and z ((tier as a 64 bit floating-point number) * element's height)) to pointList
        # The foot, seen from below, and the top.
        append count to faceList
        loop cursor from 0 to count:
            append ((count - 1) - cursor) to faceList
        append count to faceList
        loop cursor from 0 to count:
            append (count + cursor) to faceList
        loop cursor from 0 to count:
            set following to the remainder of (cursor + 1) divided by count
            append 4 to faceList
            append cursor to faceList
            append following to faceList
            append (count + following) to faceList
            append (count + cursor) to faceList

# A mesh with no points or faces, standing for none.
function an empty bim mesh form:
    execute:
        return @intrinsic("construct", a bim mesh record, the bim refused id, the bim refused id, a cad topology list of a cad vector3, a cad topology list of an integer)

# Mass `element` as the mesh it would become (keeping its id), so that a tool
# can work on its faces before it is made one.
function the bim mesh form of mass {bim sketch record:element}:
    execute:
        set meshPoints to a cad topology list of a cad vector3
        set meshFaces to a cad topology list of an integer
        fill bim mesh lists of mass element into (meshPoints's values) and (meshFaces's values)
        return @intrinsic("construct", a bim mesh record, element's id, element's levelId, meshPoints, meshFaces)

# The mass (a face raised `height`) `sketchId` becomes a free mesh (see
# `fill bim mesh lists of mass`). Returns the mesh, or the refused id.
function make bim mesh of mass {a 64 bit integer:sketchId} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim sketch index of sketchId in (@intrinsic("dereference", target))
        if found's valid = false:
            return the bim refused id
        set element to the item at found's position in (target's sketches's values)
        if (element's kind != bim face sketch) or (element's height <= 0.0):
            return the bim refused id
        set pointList to an empty list of a cad vector3
        set faceList to an empty list of an integer
        fill bim mesh lists of mass element into pointList and faceList
        set fresh to add bim mesh on element's levelId with pointList and faceList to target
        free pointList
        free faceList
        if fresh != the bim refused id:
            ignore delete bim sketch sketchId from target
        return fresh

# ---------------------------------------------------------------- transactions
# The document keeps the current model and unlimited undo and redo stacks of
# snapshots. A transaction snapshots the model before its edits; a refused
# transaction is rolled back. A snapshot that becomes the current model again
# gets a new journal.

class:
    patterns:
        [a|] bim document record
    members:
        current as a bim model record
        undoStack as the type of (a cad topology list of a bim model record)
        redoStack as the type of (a cad topology list of a bim model record)
        revision as a 64 bit integer

function a new bim document:
    execute:
        return @intrinsic("construct", a bim document record, an empty bim model, a cad topology list of a bim model record, a cad topology list of a bim model record, 0 as a 64 bit integer)

function begin bim transaction in {a pointer to a bim document record:documentValue}:
    execute:
        append (the bim snapshot of documentValue's current) to (documentValue's undoStack's values)
        set documentValue's redoStack to a cad topology list of a bim model record

function commit bim transaction in {a pointer to a bim document record:documentValue}:
    execute:
        set documentValue's revision to documentValue's revision + (1 as a 64 bit integer)

function roll back bim transaction in {a pointer to a bim document record:documentValue}:
    execute:
        if (the length of (documentValue's undoStack's values)) = 0:
            return nothing
        set last to (the length of (documentValue's undoStack's values)) - 1
        set documentValue's current to the item at last in (documentValue's undoStack's values)
        remove item last from (documentValue's undoStack's values)
        set documentValue's current's journal to a cad topology list of a 64 bit integer

function undo bim transaction in {a pointer to a bim document record:documentValue}:
    execute:
        if (the length of (documentValue's undoStack's values)) = 0:
            return false
        set last to (the length of (documentValue's undoStack's values)) - 1
        append (the bim snapshot of documentValue's current) to (documentValue's redoStack's values)
        set documentValue's current to the item at last in (documentValue's undoStack's values)
        remove item last from (documentValue's undoStack's values)
        set documentValue's current's journal to a cad topology list of a 64 bit integer
        set documentValue's revision to documentValue's revision + (1 as a 64 bit integer)
        return true

function redo bim transaction in {a pointer to a bim document record:documentValue}:
    execute:
        if (the length of (documentValue's redoStack's values)) = 0:
            return false
        set last to (the length of (documentValue's redoStack's values)) - 1
        append (the bim snapshot of documentValue's current) to (documentValue's undoStack's values)
        set documentValue's current to the item at last in (documentValue's redoStack's values)
        remove item last from (documentValue's redoStack's values)
        set documentValue's current's journal to a cad topology list of a 64 bit integer
        set documentValue's revision to documentValue's revision + (1 as a 64 bit integer)
        return true
