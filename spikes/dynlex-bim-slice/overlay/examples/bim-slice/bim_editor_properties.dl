# SPDX-License-Identifier: MPL-2.0
# The properties window of the editor: the rows the selection shows and
# typing a property's value (split from `bim_editor.dl`).
import examples/bim-slice/bim_editor_core.dl

# ---------------------------------------------------------------- properties

# One row of the properties window: a name, the value shown, and the code of
# the property when it can be typed (0 when it is only shown).
class:
    patterns:
        [a|] bim property row record
    members:
        label as a string
        value as a string
        code as an integer

function bim wall height property:
    replacement:
        1
function bim wall bulge property:
    replacement:
        2
function bim opening offset property:
    replacement:
        3
function bim opening width property:
    replacement:
        4
function bim opening height property:
    replacement:
        5
function bim opening sill property:
    replacement:
        6
function bim slab thickness property:
    replacement:
        7
function bim sketch height property:
    replacement:
        8
function bim level elevation property:
    replacement:
        9
function bim level height property:
    replacement:
        10
function bim instance angle property:
    replacement:
        11
function bim wall lean property:
    replacement:
        12
function bim wall rise property:
    replacement:
        13
function bim linear angle property:
    replacement:
        14
function bim linear width property:
    replacement:
        15
function bim linear depth property:
    replacement:
        16
function bim plate top property:
    replacement:
        17
function bim plate pitch property:
    replacement:
        18
function bim plate heading property:
    replacement:
        19
# The last solid part of the selected instance's component.
function bim part width property:
    replacement:
        20
function bim part depth property:
    replacement:
        21
function bim part height property:
    replacement:
        22
# The plan view shown: its scale (1:n) and its cut height.
function bim view scale property:
    replacement:
        23
function bim view cut property:
    replacement:
        24
# The type editor: 40 + n a planar type's layer n's thickness (typed), 50 + n
# its material (a click takes the next), 60 adds a layer, 61 removes the
# last, 62 the next material of a linear element's type.
function bim layer thickness property:
    replacement:
        40
function bim layer material property:
    replacement:
        50
function bim add layer property:
    replacement:
        60
function bim remove layer property:
    replacement:
        61
function bim linear material property:
    replacement:
        62
# Clicks that take the next value: 63 the phase the selection was built in,
# 64 the phase it is demolished in, 65 the plan view's phase, 66 the plan
# view's drawing type.
function bim phase created property:
    replacement:
        63
function bim phase demolished property:
    replacement:
        64
function bim view phase property:
    replacement:
        65
function bim view drawing type property:
    replacement:
        66
function bim wall base property:
    replacement:
        67
function bim panel type property:
    replacement:
        68
function bim system line property:
    replacement:
        69
# The connection at a linear element's start, and at its finish (one more).
function bim start connection property:
    replacement:
        70
# Unpinning a building system's grid line, and pinning a free one back.
function bim unpin line property:
    replacement:
        72
function bim pin back property:
    replacement:
        73
# A panel's nested building system: made, or selected when it has one.
function bim nested system property:
    replacement:
        74
# A building system's rule for its openings, a click taking the next.
function bim opening rule property:
    replacement:
        75
function bim system bulge property:
    replacement:
        76
# A building system's pattern (a click takes the next), and its joints'
# width and depth (typed).
function bim system pattern property:
    replacement:
        77
function bim joint width property:
    replacement:
        78
function bim joint depth property:
    replacement:
        79
# The selected element's type's assembly codes: NL-SfB, OmniClass.
function bim nlsfb property:
    replacement:
        80
function bim omniclass property:
    replacement:
        81
# A linear element's twist (degrees at its finish) and taper (its finish's
# profile as a share of its start's).
function bim linear twist property:
    replacement:
        82
function bim linear taper property:
    replacement:
        83
# How the plan view hatches: fixed in the world or along the elements.
function bim view hatch property:
    replacement:
        84
# Whether a building system's joints merge into one body (a click toggles).
function bim merged joints property:
    replacement:
        85
# The project's drawing standard (a click takes the next).
function bim drawing standard property:
    replacement:
        86
# A stair's or railing's part profile (87 plus the part slot), a click taking
# the next of the model's linear types; a railing's baluster spacing (typed).
function bim part profile property:
    replacement:
        87
function bim baluster spacing property:
    replacement:
        95
# Whether a level's extent is locked to the one all levels share (a click
# toggles; unlocked it keeps its own).
function bim level extent property:
    replacement:
        96
# How far a layer reaches past the element's outline (90 for the first
# layer, up to 99), typed.
function bim layer edge property:
    replacement:
        90

function append bim property {a string:label} showing {a string:shown} as {integer:code} to {a pointer to a list:rows}:
    execute:
        append (@intrinsic("construct", a bim property row record, label, shown, code)) to rows

# The assembly code rows of type `typeId`: NL-SfB and OmniClass, typed.
function append bim assembly rows of type {a 64 bit integer:typeId} in {bim model record:modelValue} to {a pointer to a list:rows}:
    execute:
        set sfb to the bim setting (bim nlsfb setting) of typeId in modelValue
        set sfbText to the string form of "-"
        if sfb's found:
            set sfbText to the bim assembly code text of sfb's value in (bim nlsfb setting)
        append bim property (the string form of "NL-SfB") showing sfbText as bim nlsfb property to rows
        set omni to the bim setting (bim omniclass setting) of typeId in modelValue
        set omniText to the string form of "-"
        if omni's found:
            set omniText to the bim assembly code text of omni's value in (bim omniclass setting)
        append bim property (the string form of "OmniClass") showing omniText as bim omniclass property to rows

# The type of the selected wall, plate, linear element or opening; else the
# refused id.
function the bim selected type id of {bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        if editor's selectionKind = bim wall picked:
            set wallFound to the bim wall index of editor's selectionId in modelValue
            if wallFound's valid:
                return (the item at wallFound's position in (modelValue's walls's values))'s typeId
        if editor's selectionKind = bim slab picked:
            set slabFound to the bim slab index of editor's selectionId in modelValue
            if slabFound's valid:
                return (the item at slabFound's position in (modelValue's slabs's values))'s typeId
        if editor's selectionKind = bim linear picked:
            set linearFound to the bim linear index of editor's selectionId in modelValue
            if linearFound's valid:
                return (the item at linearFound's position in (modelValue's linears's values))'s typeId
        if editor's selectionKind = bim opening picked:
            set openingFound to the bim opening index of editor's selectionId in modelValue
            if openingFound's valid:
                return (the item at openingFound's position in (modelValue's openings's values))'s typeId
        return the bim refused id

# A heading in the properties (code -1): "Instance" over what each element
# has of its own, "Type" over what all elements of its type share.
function append bim heading {a string:label} to {a pointer to a list:rows}:
    execute:
        append (@intrinsic("construct", a bim property row record, label, the string form of "", -1)) to rows

# The layers of planar type `typeId` as property rows: each layer's material
# (a click takes the next) and thickness (typed), then adding and removing a
# layer.
function append bim layer rows of type {a 64 bit integer:typeId} in {bim model record:modelValue} units {integer:unitCode} to {a pointer to a list:rows}:
    execute:
        set found to the bim wall type index of typeId in modelValue
        if found's valid = false:
            return nothing
        set planarType to the item at found's position in (modelValue's wallTypes's values)
        set layerList to planarType's layers's values
        loop cursor from 0 to (the minimum of (the length of layerList) and 10):
            set layerValue to the item at cursor in layerList
            set label to (the string form of "Layer ") + (the string form of (cursor + 1))
            append bim property (label + (the string form of " (click)")) showing layerValue's material as ((bim layer material property) + cursor) to rows
            append bim property (label + (the string form of " thickness")) showing (the bim length layerValue's thickness in units unitCode) as ((bim layer thickness property) + cursor) to rows
            append bim property (label + (the string form of " edge +/-")) showing (the bim length (the bim layer edge of layer cursor of type typeId in modelValue) in units unitCode) as ((bim layer edge property) + cursor) to rows
        append bim property (the string form of "+ Layer (click)") showing (the string form of "") as bim add layer property to rows
        if (the length of layerList) > 1:
            append bim property (the string form of "- Layer (click)") showing (the string form of "") as bim remove layer property to rows

# The planar type of the selected wall or plate, or of the chosen panel of a
# building system; else the refused id.
function the bim selected planar type of {bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        if editor's selectionKind = bim wall picked:
            set found to the bim wall index of editor's selectionId in modelValue
            if found's valid:
                return (the item at found's position in (modelValue's walls's values))'s typeId
        if editor's selectionKind = bim slab picked:
            set found to the bim slab index of editor's selectionId in modelValue
            if found's valid:
                return (the item at found's position in (modelValue's slabs's values))'s typeId
        # A chosen panel of a building system: its panel type.
        if (editor's selectionKind = bim curtain picked) and (editor's partCode >= 2000):
            return the bim panel type of panel (editor's partCode - 2000) of system editor's selectionId in modelValue
        return the bim refused id

# The selected element's planar type with `layerList` as its layers, in one
# undoable step; the type's name follows the rules.
function give bim editor selected type layers {a pointer to a list:layerList} in {a pointer to a bim editor record:editor}:
    execute:
        set typeId to the bim selected planar type of (@intrinsic("dereference", editor))
        begin bim transaction in (the address of (editor's documentValue))
        if set bim wall type typeId layers to layerList in (the address of (editor's documentValue's current)):
            commit bim transaction in (the address of (editor's documentValue))
            set found to the bim wall type index of typeId in editor's documentValue's current
            set editor's message to (the string form of "Type now ") + (the item at found's position in (editor's documentValue's current's wallTypes's values))'s name
        else:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Refused: a layer must be thicker than nothing"

# A click on a type editor row that acts at once (material, add or remove a
# layer); true when `code` was one.
function act bim editor type property {integer:code} in {a pointer to a bim editor record:editor}:
    execute:
        if code = bim linear material property:
            set found to the bim linear index of editor's selectionId in editor's documentValue's current
            if found's valid = false:
                return true
            set linearType to the bim type of linear (the item at found's position in (editor's documentValue's current's linears's values)) in editor's documentValue's current
            begin bim transaction in (the address of (editor's documentValue))
            ignore set bim linear type linearType's id material to (the bim material after linearType's material) in (the address of (editor's documentValue's current))
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to (the string form of "Type now ") + (the bim type of linear (the item at found's position in (editor's documentValue's current's linears's values)) in editor's documentValue's current)'s name
            return true
        if (code < (bim layer material property)) or (code > (bim remove layer property)):
            return false
        set typeFound to the bim wall type index of (the bim selected planar type of (@intrinsic("dereference", editor))) in editor's documentValue's current
        if typeFound's valid = false:
            return true
        set planarType to the item at typeFound's position in (editor's documentValue's current's wallTypes's values)
        set changed to an empty list of a bim layer record
        loop cursor from 0 to the length of (planarType's layers's values):
            append (the item at cursor in (planarType's layers's values)) to changed
        if code = bim add layer property:
            append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.1)) to changed
        else if code = bim remove layer property:
            if (the length of changed) > 1:
                remove item ((the length of changed) - 1) from changed
        else:
            set layerIndex to code - (bim layer material property)
            if layerIndex < (the length of changed):
                set original to the item at layerIndex in changed
                replace item at index layerIndex in changed with (@intrinsic("construct", a bim layer record, the bim material after original's material, original's thickness))
        give bim editor selected type layers changed in editor
        free changed
        return true

# The name of phase `phaseId`, the last for the refused id; "None" when the
# model has no phases yet.
function the bim phase name of {a 64 bit integer:phaseId} in {bim model record:modelValue}:
    execute:
        if (the length of (modelValue's phases's values)) = 0:
            return the string form of "None"
        set phaseOrder to the bim phase order of phaseId in modelValue
        return (the item at phaseOrder in (modelValue's phases's values))'s name

# The ids the selection holds: the picked element and those chosen with it.
function the bim selected ids of {bim editor record:editor}:
    execute:
        set gathered to an empty list of a 64 bit integer
        if editor's selectionKind != bim nothing picked:
            append editor's selectionId to gathered
        loop cursor from 0 to the length of (editor's chosenSketches's values):
            set chosenId to the item at cursor in (editor's chosenSketches's values)
            if chosenId != editor's selectionId:
                append chosenId to gathered
        return gathered

# The properties of the selection, or of the active storey and plan view when
# nothing is selected, with the phases and the drawing type.
function the bim property rows of {bim editor record:editor}:
    execute:
        set propertyRows to the bim own property rows of editor
        set modelValue to editor's documentValue's current
        set reinforcementFound to the bim reinforcement index of editor's selectionId in modelValue
        if reinforcementFound's valid:
            clear propertyRows
            set spec to the bim hostbound reinforcement (the item at reinforcementFound's position in (modelValue's reinforcements's values)) in modelValue
            append bim property (the string form of "Steel library") showing spec's steelKey as 128 to propertyRows
            append bim property (the string form of "Secondary steel") showing spec's secondarySteelKey as 129 to propertyRows
            append bim property (the string form of "Library preset") showing (the string form of "-") as 130 to propertyRows
            set widthCode to 95
            set depthCode to 96
            if spec's hostId != the bim refused id:
                set widthCode to 0
                set depthCode to 0
            if spec's kind = 1:
                append bim property (the string form of "Top count") showing (the string form of spec's topCount) as 105 to propertyRows
                append bim property (the string form of "Top diameter") showing (the bim length spec's topDiameter in units editor's lengthUnit) as 106 to propertyRows
                append bim property (the string form of "Bottom count") showing (the string form of spec's bottomCount) as 107 to propertyRows
                append bim property (the string form of "Bottom diameter") showing (the bim length spec's bottomDiameter in units editor's lengthUnit) as 108 to propertyRows
                append bim property (the string form of "Stirrup diameter") showing (the bim length spec's secondaryDiameter in units editor's lengthUnit) as 91 to propertyRows
                append bim property (the string form of "Stirrup spacing") showing (the bim length spec's spacing in units editor's lengthUnit) as 92 to propertyRows
                append bim property (the string form of "Cage type (shared)") showing spec's cageType as 109 to propertyRows
                append bim property (the string form of "Start zone length") showing (the bim length spec's startZoneLength in units editor's lengthUnit) as 110 to propertyRows
                append bim property (the string form of "Start stirrup spacing") showing (the bim length spec's startZoneSpacing in units editor's lengthUnit) as 111 to propertyRows
                append bim property (the string form of "End zone length") showing (the bim length spec's endZoneLength in units editor's lengthUnit) as 112 to propertyRows
                append bim property (the string form of "End stirrup spacing") showing (the bim length spec's endZoneSpacing in units editor's lengthUnit) as 113 to propertyRows
                append bim property (the string form of "Extra top count") showing (the string form of spec's extraTopCount) as 114 to propertyRows
                append bim property (the string form of "Extra top diameter") showing (the bim length spec's extraTopDiameter in units editor's lengthUnit) as 115 to propertyRows
                append bim property (the string form of "Extra bottom count") showing (the string form of spec's extraBottomCount) as 116 to propertyRows
                append bim property (the string form of "Extra bottom diameter") showing (the bim length spec's extraBottomDiameter in units editor's lengthUnit) as 117 to propertyRows
                append bim property (the string form of "Extra from") showing (the bim length spec's extraFrom in units editor's lengthUnit) as 118 to propertyRows
                append bim property (the string form of "Extra to") showing (the bim length spec's extraTo in units editor's lengthUnit) as 119 to propertyRows
            else:
                append bim property (the string form of "Diameter") showing (the bim length spec's diameter in units editor's lengthUnit) as 90 to propertyRows

            set secondaryLabel to the string form of "Cross diameter"
            if spec's kind = 1:
                set secondaryLabel to the string form of "Stirrup diameter"
            if spec's kind != 1:
                append bim property secondaryLabel showing (the bim length spec's secondaryDiameter in units editor's lengthUnit) as 91 to propertyRows
                append bim property (the string form of "Spacing") showing (the bim length spec's spacing in units editor's lengthUnit) as 92 to propertyRows
            append bim property (the string form of "Cross spacing") showing (the bim length spec's crossSpacing in units editor's lengthUnit) as 93 to propertyRows
            append bim property (the string form of "Cover") showing (the bim length spec's cover in units editor's lengthUnit) as 94 to propertyRows
            append bim property (the string form of "Width") showing (the bim length spec's width in units editor's lengthUnit) as widthCode to propertyRows
            append bim property (the string form of "Depth") showing (the bim length spec's depth in units editor's lengthUnit) as depthCode to propertyRows
            append bim property (the string form of "Bend radius") showing (the bim length spec's bendRadius in units editor's lengthUnit) as 97 to propertyRows
            append bim property (the string form of "Mark") showing spec's mark as 98 to propertyRows
            if (spec's kind = 2) or (spec's kind = 5):
                set surfaceLabel to the string form of "Floor"
                set faceLabel to the string form of "Bottom"
                if spec's areaMode = 1:
                    set surfaceLabel to the string form of "Wall"
                    set faceLabel to the string form of "Front"
                if spec's faceMask = 2:
                    set faceLabel to the string form of "Top"
                    if spec's areaMode = 1:
                        set faceLabel to the string form of "Back"
                if spec's faceMask = 3:
                    set faceLabel to the string form of "Both"
                set surfaceCode to 120
                if spec's hostId != the bim refused id:
                    set surfaceCode to 0
                append bim property (the string form of "Surface") showing surfaceLabel as surfaceCode to propertyRows
                append bim property (the string form of "Faces") showing faceLabel as 121 to propertyRows
                append bim property (the string form of "Far X diameter") showing (the bim length spec's farDiameter in units editor's lengthUnit) as 122 to propertyRows
                append bim property (the string form of "Far Y diameter") showing (the bim length spec's farSecondaryDiameter in units editor's lengthUnit) as 123 to propertyRows
                append bim property (the string form of "Far Y spacing") showing (the bim length spec's farSpacing in units editor's lengthUnit) as 124 to propertyRows
                append bim property (the string form of "Far X spacing") showing (the bim length spec's farCrossSpacing in units editor's lengthUnit) as 125 to propertyRows
                set radiusCode to 126
                if spec's hostId != the bim refused id:
                    set radiusCode to 0
                append bim property (the string form of "Curve radius (0 flat)") showing (the bim length spec's curveRadius in units editor's lengthUnit) as radiusCode to propertyRows
                append bim property (the string form of "Mesh type") showing spec's meshType as 127 to propertyRows
            set steelEntry to the reinforcement steel named spec's steelKey
            append bim property (the string form of "Steel reference") showing steelEntry's standard as 0 to propertyRows
            append bim property (the string form of "Steel status") showing steelEntry's status as 0 to propertyRows
            if steelEntry's nominalYieldMPa > 0.0:
                append bim property (the string form of "Nominal yield MPa") showing (the string form of steelEntry's nominalYieldMPa) as 0 to propertyRows
            if steelEntry's archivalYieldKgfCm2 > 0.0:
                append bim property (the string form of "Archive yield kgf/cm2") showing (the string form of steelEntry's archivalYieldKgfCm2) as 0 to propertyRows
            set secondaryEntry to the reinforcement steel named spec's secondarySteelKey
            append bim property (the string form of "Secondary reference") showing secondaryEntry's standard as 0 to propertyRows
            append bim property (the string form of "Secondary status") showing secondaryEntry's status as 0 to propertyRows
            append bim property (the string form of "Modern keys") showing (the string form of "B500A B500B B500C") as 0 to propertyRows
            append bim property (the string form of "Historical keys") showing (the string form of "QR22 QR24 QR32 QR40 QR48") as 0 to propertyRows
            append bim property (the string form of "FeB keys") showing (the string form of "FEB220HWL FEB400HWL FEB500HWL FEB500HK FEB500HKN") as 0 to propertyRows
            append bim property (the string form of "Cage presets") showing (the string form of "CAGE_A CAGE_B CAGE_C") as 0 to propertyRows
            append bim property (the string form of "Mesh presets") showing (the string form of "MESH6_150 MESH8_150 MESH10_150") as 0 to propertyRows
            set pointCode to 99
            if spec's hostId != the bim refused id:
                set pointCode to 0
            append bim property (the string form of "Start X") showing (the bim length spec's start's x in units editor's lengthUnit) as pointCode to propertyRows
            set pointCode to 100
            if spec's hostId != the bim refused id:
                set pointCode to 0
            append bim property (the string form of "Start Y") showing (the bim length spec's start's y in units editor's lengthUnit) as pointCode to propertyRows
            set pointCode to 101
            if spec's hostId != the bim refused id:
                set pointCode to 0
            append bim property (the string form of "Start Z") showing (the bim length spec's start's z in units editor's lengthUnit) as pointCode to propertyRows
            set pointCode to 102
            if spec's hostId != the bim refused id:
                set pointCode to 0
            append bim property (the string form of "End X") showing (the bim length spec's finish's x in units editor's lengthUnit) as pointCode to propertyRows
            set pointCode to 103
            if spec's hostId != the bim refused id:
                set pointCode to 0
            append bim property (the string form of "End Y") showing (the bim length spec's finish's y in units editor's lengthUnit) as pointCode to propertyRows
            set pointCode to 104
            if spec's hostId != the bim refused id:
                set pointCode to 0
            append bim property (the string form of "End Z") showing (the bim length spec's finish's z in units editor's lengthUnit) as pointCode to propertyRows
        set nodeFound to the bim connection index of editor's selectionId in modelValue
        if nodeFound's valid:
            clear propertyRows
            set nodeValue to the item at nodeFound's position in (modelValue's connections's values)
            loop memberCursor from 0 to the length of (nodeValue's members's values):
                set memberValue to the item at memberCursor in (nodeValue's members's values)
                append bim property ((the string form of "Setback ") + (the string form of memberValue's elementId)) showing (the bim length memberValue's setback in units editor's lengthUnit) as (9000 + memberCursor) to propertyRows
            loop partCursor from 0 to the length of (nodeValue's additions's values):
                set partValue to the item at partCursor in (nodeValue's additions's values)
                set prefix to (the string form of "Plate ") + (the string form of partValue's key)
                if partValue's kind = 1:
                    set prefix to (the string form of "Bolts ") + (the string form of partValue's key)
                if partValue's kind = 2:
                    set prefix to (the string form of "Screws ") + (the string form of partValue's key)
                append bim property prefix showing (the string form of "") as 0 to propertyRows
                set baseCode to 10000 + (partCursor * 20)
                if partValue's kind = 0:
                    append bim property (the string form of "Width") showing (the bim length partValue's width in units editor's lengthUnit) as (baseCode + 0) to propertyRows
                    append bim property (the string form of "Height") showing (the bim length partValue's height in units editor's lengthUnit) as (baseCode + 1) to propertyRows
                    append bim property (the string form of "Thickness") showing (the bim length partValue's thickness in units editor's lengthUnit) as (baseCode + 2) to propertyRows
                else:
                    append bim property (the string form of "Diameter") showing (the bim length partValue's diameter in units editor's lengthUnit) as (baseCode + 3) to propertyRows
                    append bim property (the string form of "Length") showing (the bim length partValue's length in units editor's lengthUnit) as (baseCode + 4) to propertyRows
                    append bim property (the string form of "Rows") showing (the string form of partValue's rows) as (baseCode + 5) to propertyRows
                    append bim property (the string form of "Columns") showing (the string form of partValue's columns) as (baseCode + 6) to propertyRows
                    append bim property (the string form of "Row pitch") showing (the bim length partValue's rowPitch in units editor's lengthUnit) as (baseCode + 7) to propertyRows
                    append bim property (the string form of "Column pitch") showing (the bim length partValue's columnPitch in units editor's lengthUnit) as (baseCode + 8) to propertyRows
                    append bim property (the string form of "Hole diameter") showing (the bim length partValue's holeDiameter in units editor's lengthUnit) as (baseCode + 9) to propertyRows
                append bim property (the string form of "Offset X") showing (the bim length partValue's origin's x in units editor's lengthUnit) as (baseCode + 10) to propertyRows
                append bim property (the string form of "Offset Y") showing (the bim length partValue's origin's y in units editor's lengthUnit) as (baseCode + 11) to propertyRows
                append bim property (the string form of "Offset Z") showing (the bim length partValue's origin's z in units editor's lengthUnit) as (baseCode + 12) to propertyRows
                append bim property (the string form of "Host member ID") showing (the string form of partValue's memberId) as (baseCode + 13) to propertyRows
                append bim property (the string form of "Axis X") showing (the string form of partValue's axis's x) as (baseCode + 14) to propertyRows
                append bim property (the string form of "Axis Y") showing (the string form of partValue's axis's y) as (baseCode + 15) to propertyRows
                append bim property (the string form of "Axis Z") showing (the string form of partValue's axis's z) as (baseCode + 16) to propertyRows
                append bim property (the string form of "Remove") showing (the string form of "Click to remove") as (50000 + partCursor) to propertyRows
        if (editor's selectionKind != bim nothing picked) and (editor's selectionKind != bim grid picked):
            set elementPhasing to the bim phasing of element editor's selectionId in modelValue
            append bim property (the string form of "Phase built (click)") showing (the bim phase name of elementPhasing's createdId in modelValue) as bim phase created property to propertyRows
            set goneText to the string form of "Never"
            if elementPhasing's demolishedId != the bim refused id:
                set goneText to the bim phase name of elementPhasing's demolishedId in modelValue
            append bim property (the string form of "Phase demolished (click)") showing goneText as bim phase demolished property to propertyRows
        else if editor's selectionKind = bim nothing picked:
            set viewFound to the bim view index of editor's planViewId in modelValue
            if viewFound's valid:
                set viewValue to the item at viewFound's position in (modelValue's views's values)
                set typeText to the string form of "None (own rules)"
                set typeFound to the bim drawing type index of viewValue's drawingTypeId in modelValue
                if typeFound's valid:
                    set typeText to (the item at typeFound's position in (modelValue's drawingTypes's values))'s name
                    if viewValue's automatic:
                        set typeText to typeText + (the string form of " (Automatic)")
                    else:
                        set typeText to typeText + (the string form of " (Manual)")
                append bim property (the string form of "Drawing type (click)") showing typeText as bim view drawing type property to propertyRows
                append bim property (the string form of "Phase (click)") showing (the bim phase name of viewValue's phaseId in modelValue) as bim view phase property to propertyRows
        return propertyRows

# The phase after `phaseId` in the model's order, wrapping round; the
# refused id stands for the last.
function the bim phase after {a 64 bit integer:phaseId} in {bim model record:modelValue}:
    execute:
        set count to the length of (modelValue's phases's values)
        set phaseOrder to the bim phase order of phaseId in modelValue
        set following to the remainder of (phaseOrder + 1) divided by count
        return (the item at following in (modelValue's phases's values))'s id

# A click on a phase or drawing-type row (63 to 66); true when `code` was
# one. The phases and drawing types are added first when the model has none.
function act bim editor phase property {integer:code} in {a pointer to a bim editor record:editor}:
    execute:
        if (code < (bim phase created property)) or (code > (bim view drawing type property)):
            return false
        set target to the address of (editor's documentValue's current)
        begin bim transaction in (the address of (editor's documentValue))
        ensure bim phases in target
        set lastPhase to (the item at ((the length of (target's phases's values)) - 1) in (target's phases's values))'s id
        if (code = bim phase created property) or (code = bim phase demolished property):
            set chosenIds to the bim selected ids of (@intrinsic("dereference", editor))
            loop cursor from 0 to the length of chosenIds:
                set elementId to the item at cursor in chosenIds
                set elementPhasing to the bim phasing of element elementId in (@intrinsic("dereference", target))
                set builtPhase to elementPhasing's createdId
                set gonePhase to elementPhasing's demolishedId
                if code = bim phase created property:
                    set builtPhase to the bim phase after builtPhase in (@intrinsic("dereference", target))
                    if builtPhase = lastPhase:
                        set builtPhase to the bim refused id
                else if gonePhase = the bim refused id:
                    set gonePhase to (the item at 0 in (target's phases's values))'s id
                else if gonePhase = lastPhase:
                    set gonePhase to the bim refused id
                else:
                    set gonePhase to the bim phase after gonePhase in (@intrinsic("dereference", target))
                set bim element elementId built in builtPhase demolished in gonePhase in target
            free chosenIds
            set editor's message to the string form of "Phase changed"
        set viewFound to the bim view index of editor's planViewId in (@intrinsic("dereference", target))
        if ((code = bim view phase property) or (code = bim view drawing type property)) and viewFound's valid:
            set viewValue to the item at viewFound's position in (target's views's values)
            if code = bim view phase property:
                set viewValue's phaseId to the bim phase after viewValue's phaseId in (@intrinsic("dereference", target))
                if viewValue's phaseId = lastPhase:
                    set viewValue's phaseId to the bim refused id
                set editor's message to (the string form of "View phase: ") + (the bim phase name of viewValue's phaseId in (@intrinsic("dereference", target)))
            else:
                ensure bim drawing types in target
                set typeList to target's drawingTypes's values
                set nextType to (the item at 0 in typeList)'s id
                loop typeCursor from 0 to (the length of typeList) - 1:
                    if (the item at typeCursor in typeList)'s id = viewValue's drawingTypeId:
                        set nextType to (the item at (typeCursor + 1) in typeList)'s id
                set viewValue's drawingTypeId to nextType
                set viewValue's automatic to true
                set editor's message to the string form of "View follows its drawing type (Automatic)"
            store bim view viewValue in target
        commit bim transaction in (the address of (editor's documentValue))
        show bim editor plan view editor's planViewId in editor
        set editor's viewsDirty to true
        return true

# How element `elementId` shows after its phase in the view with id
# `viewId` (`bim phase … look`); as normal when there is no such view.
function the bim phase look of element {a 64 bit integer:elementId} in view numbered {a 64 bit integer:viewId} of {bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        if (the length of (modelValue's phases's values)) = 0:
            return bim phase normal look
        set found to the bim view index of viewId in modelValue
        if found's valid = false:
            return bim phase normal look
        return the bim phase look of element elementId in view (the item at found's position in (modelValue's views's values)) in modelValue

# The same in the plan shown, in the section shown, and in the 3D view.
function the bim phase look of element {a 64 bit integer:elementId} in plan of {bim editor record:editor}:
    execute:
        return the bim phase look of element elementId in view numbered editor's planViewId of editor

function the bim phase look of element {a 64 bit integer:elementId} in section of {bim editor record:editor}:
    execute:
        return the bim phase look of element elementId in view numbered editor's sectionViewId of editor

function the bim phase look of element {a 64 bit integer:elementId} in model view of {bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        if (the length of (modelValue's phases's values)) = 0:
            return bim phase normal look
        loop cursor from 0 to the length of (modelValue's views's values):
            set viewValue to the item at cursor in (modelValue's views's values)
            if viewValue's kind = bim model view:
                return the bim phase look of element elementId in view viewValue in modelValue
        return bim phase normal look

# The selection demolished in the plan view's phase (DM).
function demolish bim editor selection in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set chosenIds to the bim selected ids of (@intrinsic("dereference", editor))
        if (the length of chosenIds) = 0:
            set editor's message to the string form of "Demolish: select what is demolished first"
            free chosenIds
            return nothing
        begin bim transaction in (the address of (editor's documentValue))
        ensure bim phases in target
        set viewPhase to the bim refused id
        set viewFound to the bim view index of editor's planViewId in (@intrinsic("dereference", target))
        if viewFound's valid:
            set viewPhase to (the item at viewFound's position in (target's views's values))'s phaseId
        set goneId to (the item at (the bim phase order of viewPhase in (@intrinsic("dereference", target))) in (target's phases's values))'s id
        loop cursor from 0 to the length of chosenIds:
            set elementPhasing to the bim phasing of element (the item at cursor in chosenIds) in (@intrinsic("dereference", target))
            set builtId to elementPhasing's createdId
            # Demolished work stood before: built in an earlier phase.
            if (the bim phase order of builtId in (@intrinsic("dereference", target))) >= (the bim phase order of goneId in (@intrinsic("dereference", target))):
                set builtId to (the item at 0 in (target's phases's values))'s id
            set bim element (the item at cursor in chosenIds) built in builtId demolished in goneId in target
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to ((the string form of "Demolished in ") + (the bim phase name of goneId in (@intrinsic("dereference", target)))) + ((the string form of ": ") + ((the string form of (the length of chosenIds)) + (the string form of " elements")))
        free chosenIds

# The properties of the selection, or of the active storey when nothing is
# selected: what they are, in the project's units, and which can be typed.
function the bim own property rows of {bim editor record:editor}:
    execute:
        set propertyRows to an empty list of a bim property row record
        set modelValue to editor's documentValue's current
        set unitCode to editor's lengthUnit
        # A building system, or the part of it chosen with a second click.
        if editor's selectionKind = bim curtain picked:
            set curtainFound to the bim curtain index of editor's selectionId in modelValue
            if curtainFound's valid:
                set curtainValue to the item at curtainFound's position in (modelValue's curtains's values)
                set chosenPart to the bim system part name of curtainValue coded editor's partCode in modelValue
                append bim property (the string form of "Part") showing chosenPart as 0 to propertyRows
                if editor's partCode < 0:
                    append bim property (the string form of "IFC class") showing (the string form of "IfcCurtainWall") as 0 to propertyRows
                else if editor's partCode < 2000:
                    append bim property (the string form of "IFC class") showing (the string form of "IfcMember") as 0 to propertyRows
                else:
                    append bim property (the string form of "IFC class") showing (the string form of "IfcPlate") as 0 to propertyRows
                set hostReading to the bim setting (bim host system setting) of curtainValue's id in modelValue
                if hostReading's found:
                    append bim property (the string form of "Nested in panel") showing (the string form of (((the bim setting (bim host panel setting) of curtainValue's id in modelValue)'s value) + 1)) as 0 to propertyRows
                if editor's partCode < 0:
                    append bim property (the string form of "Height") showing (the bim length curtainValue's height in units unitCode) as 0 to propertyRows
                    append bim property (the string form of "Curvature") showing (the bim length curtainValue's bulge in units unitCode) as bim system bulge property to propertyRows
                    append bim property (the string form of "Pattern (click)") showing (the bim name of pattern (the bim pattern of system curtainValue's id in modelValue)) as bim system pattern property to propertyRows
                    append bim property (the string form of "Joint width") showing (the bim length (the bim joint width of system curtainValue's id in modelValue) in units unitCode) as bim joint width property to propertyRows
                    append bim property (the string form of "Joint depth") showing (the bim length (the bim joint depth of system curtainValue's id in modelValue) in units unitCode) as bim joint depth property to propertyRows
                    set jointsText to the string form of "Separate"
                    if ((the bim setting (bim merged joints setting) of curtainValue's id in modelValue)'s value) = (1 as a 64 bit integer):
                        set jointsText to the string form of "Merged"
                    append bim property (the string form of "Joints (click)") showing jointsText as bim merged joints property to propertyRows
                    append bim property (the string form of "Bay width (max)") showing (the bim length curtainValue's bayWidth in units unitCode) as 0 to propertyRows
                    append bim property (the string form of "Row height (max)") showing (the bim length curtainValue's rowHeight in units unitCode) as 0 to propertyRows
                    append bim property (the string form of "Frame") showing curtainValue's material as 0 to propertyRows
                    append bim property (the string form of "Panels (click)") showing (the bim panel type name of (the bim panel type of panel -1 of system curtainValue's id in modelValue) in modelValue) as bim panel type property to propertyRows
                    append bim property (the string form of "Openings (click)") showing (the bim name of opening rule (the bim opening rule of system curtainValue's id in modelValue)) as bim opening rule property to propertyRows
                else if editor's partCode >= 2000:
                    set panelTypeId to the bim panel type of panel (editor's partCode - 2000) of system curtainValue's id in modelValue
                    append bim property (the string form of "Panel type (click)") showing (the bim panel type name of panelTypeId in modelValue) as bim panel type property to propertyRows
                    set nestedShown to the string form of "Add"
                    if (the bim system nested in panel (editor's partCode - 2000) of curtainValue's id in modelValue) != the bim refused id:
                        set nestedShown to the string form of "Select"
                    append bim property (the string form of "Nested system (click)") showing nestedShown as bim nested system property to propertyRows
                    append bim layer rows of type panelTypeId in modelValue units unitCode to propertyRows
                else:
                    if bim system line (editor's partCode) of curtainValue moves:
                        append bim property (the string form of "Position") showing (the bim length (the bim system line position of curtainValue coded editor's partCode in modelValue) in units unitCode) as bim system line property to propertyRows
                    append bim property (the string form of "Pinned (click)") showing (the string form of "Unpin") as bim unpin line property to propertyRows
                    append bim property (the string form of "Profile") showing ((the bim length (the bim joint width of system curtainValue's id in modelValue) in units unitCode) + ((the string form of " x ") + (the bim length (the bim joint depth of system curtainValue's id in modelValue) in units unitCode))) as 0 to propertyRows
                set partBox to the bim system part box of curtainValue coded (the maximum of 0 and editor's partCode) in editor's documentValue's current
                if editor's partCode >= 0:
                    append bim property (the string form of "Width") showing (the bim length (partBox's high's x - partBox's low's x) in units unitCode) as 0 to propertyRows
                    append bim property (the string form of "Height") showing (the bim length (partBox's high's y - partBox's low's y) in units unitCode) as 0 to propertyRows
            return propertyRows
        if editor's selectionKind = bim wall picked:
            set found to the bim wall index of editor's selectionId in modelValue
            if found's valid:
                set wallValue to the item at found's position in (modelValue's walls's values)
                append bim heading (the string form of "Instance") to propertyRows
                append bim property (the string form of "Storey") showing (the item at (the bim level index of wallValue's levelId in modelValue)'s position in (modelValue's levels's values))'s name as 0 to propertyRows
                append bim property (the string form of "Height") showing (the bim length wallValue's height in units unitCode) as bim wall height property to propertyRows
                append bim property (the string form of "Base offset") showing (the bim length wallValue's baseOffset in units unitCode) as bim wall base property to propertyRows
                set heldLevel to the bim level index of wallValue's topLevelId in modelValue
                if heldLevel's valid:
                    append bim property (the string form of "Top held at") showing (the item at heldLevel's position in (modelValue's levels's values))'s name as 0 to propertyRows
                append bim property (the string form of "Curvature") showing (the bim length wallValue's bulge in units unitCode) as bim wall bulge property to propertyRows
                append bim property (the string form of "Lean (top)") showing (the bim length wallValue's lean in units unitCode) as bim wall lean property to propertyRows
                append bim property (the string form of "Bow (section)") showing (the bim length wallValue's rise in units unitCode) as bim wall rise property to propertyRows
                append bim property (the string form of "Length") showing (the bim length (the bim centreline length of wallValue) in units unitCode) as 0 to propertyRows
                append bim heading (the string form of "Type") to propertyRows
                set wallTypeFound to the bim wall type index of wallValue's typeId in modelValue
                if wallTypeFound's valid:
                    append bim property (the string form of "Name") showing (the item at wallTypeFound's position in (modelValue's wallTypes's values))'s name as 0 to propertyRows
                append bim property (the string form of "IFC class") showing (the string form of "IfcWall") as 0 to propertyRows
                append bim assembly rows of type wallValue's typeId in modelValue to propertyRows
                append bim property (the string form of "Width") showing (the bim length (the bim wall thickness of wallValue in modelValue) in units unitCode) as 0 to propertyRows
                append bim layer rows of type wallValue's typeId in modelValue units unitCode to propertyRows
            return propertyRows
        if editor's selectionKind = bim opening picked:
            set found to the bim opening index of editor's selectionId in modelValue
            if found's valid:
                set openingValue to the item at found's position in (modelValue's openings's values)
                append bim property (the string form of "Offset") showing (the bim length openingValue's offset in units unitCode) as bim opening offset property to propertyRows
                set typeFound to the bim opening type index of openingValue's typeId in modelValue
                if typeFound's valid:
                    set openingType to the item at typeFound's position in (modelValue's openingTypes's values)
                    set openingClass to the string form of "IfcWindow"
                    if openingType's isDoor:
                        set openingClass to the string form of "IfcDoor"
                    append bim property (the string form of "IFC class") showing openingClass as 0 to propertyRows
                    append bim assembly rows of type openingValue's typeId in modelValue to propertyRows
                    append bim property (the string form of "Width (type)") showing (the bim length openingType's width in units unitCode) as bim opening width property to propertyRows
                    append bim property (the string form of "Height (type)") showing (the bim length openingType's height in units unitCode) as bim opening height property to propertyRows
                    append bim property (the string form of "Sill (type)") showing (the bim length openingType's sill in units unitCode) as bim opening sill property to propertyRows
                append bim property (the string form of "Host wall") showing (the string form of openingValue's hostId) as 0 to propertyRows
            return propertyRows
        if editor's selectionKind = bim slab picked:
            set found to the bim slab index of editor's selectionId in modelValue
            if found's valid:
                set slabValue to the item at found's position in (modelValue's slabs's values)
                set plateTyped to (the bim type index of plate slabValue in modelValue)'s valid
                if plateTyped:
                    append bim property (the string form of "Type") showing (the item at (the bim type index of plate slabValue in modelValue)'s position in (modelValue's wallTypes's values))'s name as 0 to propertyRows
                    append bim property (the string form of "IFC class") showing (the bim ifc class of planar role (the bim role of plate slabValue in modelValue)) as 0 to propertyRows
                    append bim assembly rows of type slabValue's typeId in modelValue to propertyRows
                    append bim property (the string form of "Thickness (type)") showing (the bim length (the bim thickness of plate slabValue in modelValue) in units unitCode) as 0 to propertyRows
                    append bim property (the string form of "Top") showing (the bim length slabValue's top in units unitCode) as bim plate top property to propertyRows
                    append bim property (the string form of "Pitch") showing ((the bim metres text of (slabValue's pitch * (180.0 / 3.141592653589793))) + (the string form of " deg")) as bim plate pitch property to propertyRows
                    append bim property (the string form of "Slope toward") showing ((the bim metres text of (slabValue's heading * (180.0 / 3.141592653589793))) + (the string form of " deg")) as bim plate heading property to propertyRows
                    append bim layer rows of type slabValue's typeId in modelValue units unitCode to propertyRows
                else:
                    append bim property (the string form of "Thickness") showing (the bim length slabValue's thickness in units unitCode) as bim slab thickness property to propertyRows
                append bim property (the string form of "Material") showing (the bim material of plate slabValue in modelValue) as 0 to propertyRows
                append bim property (the string form of "Area") showing ((the bim metres text of (the bim slab area of slabValue)) + (the string form of " m2")) as 0 to propertyRows
            return propertyRows
        if editor's selectionKind = bim sketch picked:
            set found to the bim sketch index of editor's selectionId in modelValue
            if found's valid:
                set element to the item at found's position in (modelValue's sketches's values)
                if element's kind = bim face sketch:
                    append bim property (the string form of "IFC class") showing (the string form of "IfcBuildingElementProxy") as 0 to propertyRows
                else:
                    append bim property (the string form of "IFC class") showing (the string form of "IfcAnnotation") as 0 to propertyRows
                if element's kind = bim face sketch:
                    append bim property (the string form of "Height") showing (the bim length element's height in units unitCode) as bim sketch height property to propertyRows
                    append bim property (the string form of "Area") showing ((the bim metres text of (the absolute value of (the cad signed area of (element's points's values)))) + (the string form of " m2")) as 0 to propertyRows
                else if element's kind = bim line sketch:
                    append bim property (the string form of "Length") showing (the bim length (the cad distance from (the item at 0 in (element's points's values)) to (the item at 1 in (element's points's values))) in units unitCode) as 0 to propertyRows
                else:
                    append bim property (the string form of "Text") showing element's content as 0 to propertyRows
            return propertyRows
        if editor's selectionKind = bim linear picked:
            set found to the bim linear index of editor's selectionId in modelValue
            if found's valid:
                set linearValue to the item at found's position in (modelValue's linears's values)
                set linearType to the bim type of linear linearValue in modelValue
                append bim property (the string form of "Type") showing linearType's name as 0 to propertyRows
                append bim property (the string form of "IFC class") showing (the bim ifc class of linear role linearType's role) as 0 to propertyRows
                append bim assembly rows of type linearType's id in modelValue to propertyRows
                append bim property (the string form of "Length") showing (the bim length (the cad length of (the cad difference of linearValue's finish and linearValue's start)) in units unitCode) as 0 to propertyRows
                append bim property (the string form of "Angle") showing ((the bim metres text of (linearValue's angle * (180.0 / 3.141592653589793))) + (the string form of " deg")) as bim linear angle property to propertyRows
                append bim property (the string form of "Width (type)") showing (the bim length linearType's width in units unitCode) as bim linear width property to propertyRows
                append bim property (the string form of "Depth (type)") showing (the bim length linearType's depth in units unitCode) as bim linear depth property to propertyRows
                append bim property (the string form of "Material (click)") showing linearType's material as bim linear material property to propertyRows
                append bim property (the string form of "Twist (deg)") showing (the bim metres text of (linearValue's twist * (180.0 / 3.141592653589793))) as bim linear twist property to propertyRows
                append bim property (the string form of "Taper (end x)") showing (the bim metres text of linearValue's taper's x) as bim linear taper property to propertyRows
                append bim property (the string form of "Start joint (click)") showing (the bim name of connection (the bim connection at end 0 of linearValue's id in modelValue)) as bim start connection property to propertyRows
                append bim property (the string form of "End joint (click)") showing (the bim name of connection (the bim connection at end 1 of linearValue's id in modelValue)) as ((bim start connection property) + 1) to propertyRows
                if (the bim pinning of linear linearValue's id in modelValue)'s found:
                    append bim property (the string form of "Unpinned (click)") showing (the string form of "Pin back") as bim pin back property to propertyRows
            return propertyRows
        if editor's selectionKind = bim mesh picked:
            set found to the bim mesh index of editor's selectionId in modelValue
            if found's valid:
                set meshValue to the item at found's position in (modelValue's meshes's values)
                set levelFound to the bim level index of meshValue's levelId in modelValue
                set meshTriangles to the bim mesh shape of meshValue at 0.0
                append bim property (the string form of "IFC class") showing (the string form of "IfcBuildingElementProxy") as 0 to propertyRows
                append bim property (the string form of "Points") showing (the string form of (the length of (meshValue's vertices's values))) as 0 to propertyRows
                append bim property (the string form of "Faces") showing (the string form of (the bim face count of mesh meshValue)) as 0 to propertyRows
                append bim property (the string form of "Volume") showing ((the bim metres text of (the absolute value of (the bim volume of mesh meshTriangles))) + (the string form of " m3")) as 0 to propertyRows
                if levelFound's valid:
                    append bim property (the string form of "Storey") showing (the item at levelFound's position in (modelValue's levels's values))'s name as 0 to propertyRows
            return propertyRows
        if editor's selectionKind = bim instance picked:
            set found to the bim instance index of editor's selectionId in modelValue
            if found's valid:
                set placement to the item at found's position in (modelValue's instances's values)
                append bim property (the string form of "IFC class") showing (the string form of "IfcBuildingElementProxy") as 0 to propertyRows
                append bim property (the string form of "Angle") showing ((the bim metres text of (placement's angle * (180.0 / 3.141592653589793))) + (the string form of " deg")) as bim instance angle property to propertyRows
                set definitionFound to the bim component index of placement's componentId in modelValue
                if definitionFound's valid:
                    set definition to the item at definitionFound's position in (modelValue's components's values)
                    append bim property (the string form of "Component") showing definition's name as 0 to propertyRows
                    loop partCursor from 0 to the length of (definition's solids's values):
                        set solidPart to the item at partCursor in (definition's solids's values)
                        set summary to ((the bim solid kind name of solidPart's kind) + (the string form of ", ")) + (the bim operation name of solidPart's operation)
                        append bim property ((the string form of "Part ") + (the string form of (partCursor + 1))) showing summary as 0 to propertyRows
                    set partCount to the length of (definition's solids's values)
                    if partCount > 0:
                        set lastPart to the item at (partCount - 1) in (definition's solids's values)
                        if lastPart's kind = bim box solid:
                            append bim property (the string form of "Last part width") showing (the bim length lastPart's size's x in units unitCode) as bim part width property to propertyRows
                            append bim property (the string form of "Last part depth") showing (the bim length lastPart's size's y in units unitCode) as bim part depth property to propertyRows
                        if (lastPart's kind = bim cylinder solid) or (lastPart's kind = bim sphere solid):
                            append bim property (the string form of "Last part radius") showing (the bim length lastPart's size's x in units unitCode) as bim part width property to propertyRows
                        if (lastPart's kind != bim sphere solid) and (lastPart's kind != bim mesh solid):
                            append bim property (the string form of "Last part height") showing (the bim length lastPart's size's z in units unitCode) as bim part height property to propertyRows
            return propertyRows
        # Stairs and railings: built of linear elements, each part of a
        # linear type chosen from the model's (else its default).
        if (editor's selectionKind = bim stair picked) or (editor's selectionKind = bim railing picked):
            set firstSlot to bim tread part
            set lastSlot to bim stringer part
            set partClass to the string form of "IfcStair"
            if editor's selectionKind = bim railing picked:
                set firstSlot to bim post part
                set lastSlot to bim baluster part
                set partClass to the string form of "IfcRailing"
            append bim property (the string form of "IFC class") showing partClass as 0 to propertyRows
            loop partSlot from firstSlot to (lastSlot + 1):
                set chosenProfile to the bim setting ((bim part type setting) + partSlot) of editor's selectionId in modelValue
                set profileText to the string form of "Default"
                if chosenProfile's found:
                    set profileFound to the bim linear type index of chosenProfile's value in modelValue
                    if profileFound's valid:
                        set profileText to (the item at profileFound's position in (modelValue's linearTypes's values))'s name
                append bim property ((the bim name of part slot partSlot) + (the string form of " (click)")) showing profileText as ((bim part profile property) + partSlot) to propertyRows
            if editor's selectionKind = bim railing picked:
                append bim property (the string form of "Balusters every") showing (the bim length (((the bim setting (bim baluster spacing setting) of editor's selectionId in modelValue)'s value as a 64 bit floating-point number) / 1000.0) in units unitCode) as bim baluster spacing property to propertyRows
            return propertyRows
        if editor's selectionKind = bim grid picked:
            set found to the bim grid index of editor's selectionId in modelValue
            if found's valid:
                set gridValue to the item at found's position in (modelValue's grids's values)
                append bim property (the string form of "Name") showing gridValue's name as 0 to propertyRows
                append bim property (the string form of "IFC class") showing (the string form of "IfcGrid") as 0 to propertyRows
                append bim property (the string form of "Length") showing (the bim length (the cad distance from gridValue's start to gridValue's finish) in units unitCode) as 0 to propertyRows
            return propertyRows
        set levelFound to the bim level index of (the bim edited level of editor) in modelValue
        if levelFound's valid:
            set levelValue to the item at levelFound's position in (modelValue's levels's values)
            append bim property (the string form of "Storey") showing levelValue's name as 0 to propertyRows
            append bim property (the string form of "IFC class") showing (the string form of "IfcBuildingStorey") as 0 to propertyRows
            append bim property (the string form of "Elevation") showing (the bim length levelValue's elevation in units unitCode) as bim level elevation property to propertyRows
            append bim property (the string form of "Storey height") showing (the bim length levelValue's height in units unitCode) as bim level height property to propertyRows
            set extentText to the string form of "locked to all levels"
            if bim level levelValue's id is unlocked in modelValue:
                set extentText to the string form of "its own"
            append bim property (the string form of "Extent") showing extentText as bim level extent property to propertyRows
        set viewFound to the bim view index of editor's planViewId in modelValue
        if viewFound's valid:
            set viewValue to the item at viewFound's position in (modelValue's views's values)
            append bim property (the string form of "View") showing viewValue's name as 0 to propertyRows
            append bim property (the string form of "Scale 1:") showing (the string form of viewValue's scale) as bim view scale property to propertyRows
            append bim property (the string form of "Cut height") showing (the bim length viewValue's cutHeight in units unitCode) as bim view cut property to propertyRows
            set cropText to the string form of "none (CV crops)"
            if viewValue's cropped:
                set cropText to (the bim length (viewValue's cropHigh's x - viewValue's cropLow's x) in units unitCode) + ((the string form of " x ") + (the bim length (viewValue's cropHigh's y - viewValue's cropLow's y) in units unitCode))
            append bim property (the string form of "Crop") showing cropText as 0 to propertyRows
            set hatchText to the string form of "World"
            if bim view viewValue's id hatches along objects in modelValue:
                set hatchText to the string form of "Along objects"
            append bim property (the string form of "Hatch (click)") showing hatchText as bim view hatch property to propertyRows
        append bim heading (the string form of "Project") to propertyRows
        append bim property (the string form of "Drawing standard (click)") showing (the bim name of standard (the bim drawing standard of modelValue)) as bim drawing standard property to propertyRows
        return propertyRows

# The building system grid line chosen (a mullion or transom part) made a
# free linear element, which is then selected, as one undoable step.
function unpin bim editor system line in {a pointer to a bim editor record:editor}:
    execute:
        if (editor's selectionKind != bim curtain picked) or ((editor's partCode < 0) or (editor's partCode >= 2000)):
            return nothing
        begin bim transaction in (the address of (editor's documentValue))
        set freeId to unpin bim system line editor's partCode of editor's selectionId in (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        if freeId != the bim refused id:
            select bim editor (bim linear picked) numbered freeId in editor
            set editor's message to the string form of "Unpinned: a free linear element now"

# The chosen panel's nested building system selected, made first (as one
# undoable step) when the panel has none.
function nest bim editor system in {a pointer to a bim editor record:editor}:
    execute:
        if (editor's selectionKind != bim curtain picked) or (editor's partCode < 2000):
            return nothing
        set hostId to editor's selectionId
        set panelIndex to editor's partCode - 2000
        set nestedId to the bim system nested in panel panelIndex of hostId in editor's documentValue's current
        if nestedId = the bim refused id:
            begin bim transaction in (the address of (editor's documentValue))
            set nestedId to nest bim system in panel panelIndex of hostId in (the address of (editor's documentValue's current))
            commit bim transaction in (the address of (editor's documentValue))
        if nestedId != the bim refused id:
            select bim editor (bim curtain picked) numbered nestedId in editor
            set editor's message to the string form of "Nested building system: its own bays, rows and panels"

# The selected linear element's connection at end `endIndex` takes the next
# kind, as one undoable step.
function cycle bim editor connection at end {integer:endIndex} in {a pointer to a bim editor record:editor}:
    execute:
        set elementId to editor's selectionId
        set chosen to the bim connection at end endIndex of elementId in editor's documentValue's current
        set following to the remainder of (chosen + 1) divided by (bim connection kind count)
        begin bim transaction in (the address of (editor's documentValue))
        set bim setting ((bim connection setting) + endIndex) of elementId to (following as a 64 bit integer) keeping (following != bim automatic connection) in (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to (the string form of "Joint now ") + (the bim name of connection following)

# A click on a property's value: typing it begins.
function start bim editor property {integer:code} in {a pointer to a bim editor record:editor}:
    execute:
        if code >= 50000:
            set editor's propertyCode to -1
            set nodeFound to the bim connection index of editor's selectionId in editor's documentValue's current
            if nodeFound's valid:
                set nodeValue to the item at nodeFound's position in (editor's documentValue's current's connections's values)
                set partCursor to code - 50000
                if partCursor < (the length of (nodeValue's additions's values)):
                    set nodeValue's additions to the cad clone of nodeValue's additions
                    remove item partCursor from (nodeValue's additions's values)
                    begin bim transaction in (the address of (editor's documentValue))
                    ignore store bim connection nodeValue in (the address of (editor's documentValue's current))
                    commit bim transaction in (the address of (editor's documentValue))
                    set editor's message to the string form of "Connection part removed"
            return nothing
        if code = bim panel type property:
            cycle bim editor panel type in editor
            return nothing
        if code = bim system pattern property:
            if editor's selectionKind = bim curtain picked:
                set following to the remainder of ((the bim pattern of system editor's selectionId in editor's documentValue's current) + 1) divided by (bim pattern count)
                begin bim transaction in (the address of (editor's documentValue))
                set bim setting (bim system pattern setting) of editor's selectionId to (following as a 64 bit integer) keeping (following != bim grid pattern) in (the address of (editor's documentValue's current))
                commit bim transaction in (the address of (editor's documentValue))
                set editor's message to (the string form of "Pattern: ") + (the bim name of pattern following)
            return nothing
        if (code >= bim part profile property) and (code < ((bim part profile property) + 5)):
            # The next of the model's linear types, then the default again.
            set partSlot to code - (bim part profile property)
            set linearTypeList to editor's documentValue's current's linearTypes's values
            set currentChoice to the bim setting ((bim part type setting) + partSlot) of editor's selectionId in editor's documentValue's current
            set nextIndex to 0
            if currentChoice's found:
                set currentFound to the bim linear type index of currentChoice's value in editor's documentValue's current
                if currentFound's valid:
                    set nextIndex to currentFound's position + 1
            begin bim transaction in (the address of (editor's documentValue))
            if nextIndex < (the length of linearTypeList):
                set bim setting ((bim part type setting) + partSlot) of editor's selectionId to (the item at nextIndex in linearTypeList)'s id keeping true in (the address of (editor's documentValue's current))
                set editor's message to ((the bim name of part slot partSlot) + (the string form of ": ")) + (the item at nextIndex in linearTypeList)'s name
            else:
                set bim setting ((bim part type setting) + partSlot) of editor's selectionId to (0 as a 64 bit integer) keeping false in (the address of (editor's documentValue's current))
                set editor's message to (the bim name of part slot partSlot) + (the string form of ": default")
            commit bim transaction in (the address of (editor's documentValue))
            return nothing
        if code = bim drawing standard property:
            set followingStandard to the remainder of ((the bim drawing standard of editor's documentValue's current) + 1) divided by (bim standard count)
            begin bim transaction in (the address of (editor's documentValue))
            set bim setting (bim drawing standard setting) of (0 as a 64 bit integer) to (followingStandard as a 64 bit integer) keeping (followingStandard != bim nen standard) in (the address of (editor's documentValue's current))
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to (the string form of "Drawing standard: ") + (the bim name of standard followingStandard)
            return nothing
        if code = bim level extent property:
            set extentLevel to the bim edited level of (@intrinsic("dereference", editor))
            set modelExtent to the bim plan extent of editor's documentValue's current
            set roomy to @intrinsic("construct", a bim plan extent record, true, (a cad vector2 with x (modelExtent's low's x - 1.5) and y (modelExtent's low's y - 1.5)), (a cad vector2 with x (modelExtent's high's x + 1.5) and y (modelExtent's high's y + 1.5)))
            if modelExtent's valid = false:
                set roomy to @intrinsic("construct", a bim plan extent record, true, (a cad vector2 with x -10.0 and y -10.0), (a cad vector2 with x 10.0 and y 10.0))
            set unlocking to (bim level extentLevel is unlocked in editor's documentValue's current) = false
            set shownExtent to the bim level extent of extentLevel in editor's documentValue's current around roomy
            begin bim transaction in (the address of (editor's documentValue))
            set bim level extentLevel unlocked unlocking from shownExtent in (the address of (editor's documentValue's current))
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Level extent locked to all levels"
            if unlocking:
                set editor's message to the string form of "Level extent of its own"
            return nothing
        if code = bim merged joints property:
            if editor's selectionKind = bim curtain picked:
                set joining to ((the bim setting (bim merged joints setting) of editor's selectionId in editor's documentValue's current)'s value) = (0 as a 64 bit integer)
                begin bim transaction in (the address of (editor's documentValue))
                set bim setting (bim merged joints setting) of editor's selectionId to (1 as a 64 bit integer) keeping joining in (the address of (editor's documentValue's current))
                commit bim transaction in (the address of (editor's documentValue))
                set editor's message to the string form of "Joints separate"
                if joining:
                    set editor's message to the string form of "Joints merged into one body"
            return nothing
        if code = bim view hatch property:
            set hatchedView to editor's planViewId
            set turning to (bim view hatchedView hatches along objects in editor's documentValue's current) = false
            begin bim transaction in (the address of (editor's documentValue))
            set bim setting (bim view hatch setting) of hatchedView to (1 as a 64 bit integer) keeping turning in (the address of (editor's documentValue's current))
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Hatches fixed in the world"
            if turning:
                set editor's message to the string form of "Hatches along the elements"
            return nothing
        if code = bim opening rule property:
            if editor's selectionKind = bim curtain picked:
                set following to the remainder of ((the bim opening rule of system editor's selectionId in editor's documentValue's current) + 1) divided by 3
                begin bim transaction in (the address of (editor's documentValue))
                set bim setting (bim opening rule setting) of editor's selectionId to (following as a 64 bit integer) keeping (following != bim cut and frame rule) in (the address of (editor's documentValue's current))
                commit bim transaction in (the address of (editor's documentValue))
                set editor's message to (the string form of "Openings: ") + (the bim name of opening rule following)
            return nothing
        if code = bim nested system property:
            nest bim editor system in editor
            return nothing
        if code = bim unpin line property:
            unpin bim editor system line in editor
            return nothing
        if code = bim pin back property:
            set pinning to the bim pinning of linear editor's selectionId in editor's documentValue's current
            begin bim transaction in (the address of (editor's documentValue))
            ignore pin bim linear editor's selectionId back in (the address of (editor's documentValue's current))
            commit bim transaction in (the address of (editor's documentValue))
            select bim editor (bim curtain picked) numbered pinning's curtainId in editor
            set editor's message to the string form of "Pinned back to its building system"
            return nothing
        if (code = bim start connection property) or (code = ((bim start connection property) + 1)):
            cycle bim editor connection at end (code - (bim start connection property)) in editor
            return nothing
        if act bim editor type property code in editor:
            return nothing
        if act bim editor phase property code in editor:
            return nothing
        set editor's propertyCode to code
        set editor's propertyText to the string form of ""
        set editor's message to the string form of "Type the value and press Enter (Esc cancels)"

# Keys while a property is typed: digits, point and minus, Backspace, Enter
# applies, Esc cancels.
function bim editor edits reinforcement text {bim editor record:editor}:
    execute:
        set code to editor's propertyCode
        return (((code >= 128) and (code <= 130)) or (((code = 98) or (code = 109)) or (code = 127))) or ((code = 120) or (code = 121))

function type bim editor property key {integer:code} in {a pointer to a bim editor record:editor}:
    execute:
        if (bim editor edits reinforcement text (@intrinsic("dereference", editor))) and ((code >= 32) and (code <= 126)):
            set letter to a new string buffer containing 1 bytes
            store (code as a byte) into the data of letter at 0
            set editor's propertyText to editor's propertyText + letter
            return nothing
        if ((code >= 48) and (code <= 57)) or ((code = 46) or (code = 45)):
            set digit to a new string buffer containing 1 bytes
            store (code as a byte) into the data of digit at 0
            set editor's propertyText to editor's propertyText + digit
            return nothing
        if code = bim backspace key code:
            if (the length of editor's propertyText) > 0:
                set editor's propertyText to the substring of editor's propertyText from 0 spanning ((the length of editor's propertyText) - 1) bytes
            return nothing
        if code = bim escape key code:
            set editor's propertyCode to -1
            set editor's message to the string form of "Cancelled"
            return nothing
        if code = bim enter key code:
            apply bim editor property in editor

# Applies the typed property to the selection (lengths in the project's
# units, angles in degrees), as one edit; refused values leave it unchanged.
function apply bim editor property in {a pointer to a bim editor record:editor}:
    execute:
        set code to editor's propertyCode
        set editor's propertyCode to -1
        if (the length of editor's propertyText) = 0:
            return nothing
        if ((code >= 128) and (code <= 130)) or (((code = 98) or (code = 109)) or (code = 127)) or ((code = 120) or (code = 121)):
            set rebarFound to the bim reinforcement index of editor's selectionId in editor's documentValue's current
            if rebarFound's valid:
                set spec to the item at rebarFound's position in (editor's documentValue's current's reinforcements's values)
                if code = 98:
                    set spec's mark to editor's propertyText
                else if code = 120:
                    set spec's areaMode to -1
                    if ((editor's propertyText = (the string form of "Wall")) or (editor's propertyText = (the string form of "WALL"))) or (editor's propertyText = (the string form of "wall")):
                        set spec's areaMode to 1
                    if ((editor's propertyText = (the string form of "Floor")) or (editor's propertyText = (the string form of "FLOOR"))) or (editor's propertyText = (the string form of "floor")):
                        set spec's areaMode to 0
                else if code = 121:
                    set spec's faceMask to 0
                    if ((editor's propertyText = (the string form of "Both")) or (editor's propertyText = (the string form of "BOTH"))) or (editor's propertyText = (the string form of "both")):
                        set spec's faceMask to 3
                    if (((editor's propertyText = (the string form of "Top")) or (editor's propertyText = (the string form of "TOP"))) or ((editor's propertyText = (the string form of "Back")) or (editor's propertyText = (the string form of "BACK")))) or ((editor's propertyText = (the string form of "top")) or (editor's propertyText = (the string form of "back"))):
                        set spec's faceMask to 2
                    if (((editor's propertyText = (the string form of "Bottom")) or (editor's propertyText = (the string form of "BOTTOM"))) or ((editor's propertyText = (the string form of "Front")) or (editor's propertyText = (the string form of "FRONT")))) or ((editor's propertyText = (the string form of "bottom")) or (editor's propertyText = (the string form of "front"))):
                        set spec's faceMask to 1
                else if code = 128:
                    set spec's steelKey to the uppercase form of (editor's propertyText with " " replaced by "")
                else if code = 129:
                    set spec's secondarySteelKey to the uppercase form of (editor's propertyText with " " replaced by "")
                else if code = 130:
                    set presetKey to the uppercase form of (editor's propertyText with " " replaced by "_")
                    set spec to the reinforcement spec applying library preset presetKey
                else if code = 127:
                    set spec's meshType to editor's propertyText with " " replaced by "_"
                else:
                    set spec's cageType to editor's propertyText with " " replaced by "_"
                    set spec to the bim reinforcement adopting type of spec in editor's documentValue's current
                begin bim transaction in (the address of (editor's documentValue))
                set storedId to store bim reinforcement spec in (the address of (editor's documentValue's current))
                if storedId = the bim refused id:
                    roll back bim transaction in (the address of (editor's documentValue))
                    set editor's message to the string form of "Invalid reinforcement property or type does not fit every placement"
                else:
                    commit bim transaction in (the address of (editor's documentValue))
                    set editor's message to the reinforcement annotation of spec
            return nothing
        set typed to the bim numeric value of editor's propertyText
        set metres to typed * (the bim metres per editor's lengthUnit)
        set target to the address of (editor's documentValue's current)
        set chosenId to editor's selectionId
        begin bim transaction in (the address of (editor's documentValue))
        set changed to false
        if (code >= 9000) and (code < 10000):
            set nodeFound to the bim connection index of chosenId in (@intrinsic("dereference", target))
            if nodeFound's valid:
                set nodeValue to the item at nodeFound's position in (target's connections's values)
                set memberCursor to code - 9000
                if memberCursor < (the length of (nodeValue's members's values)):
                    set nodeValue's members to the cad clone of nodeValue's members
                    set memberValue to the item at memberCursor in (nodeValue's members's values)
                    set memberValue's setback to metres
                    replace item at index memberCursor in (nodeValue's members's values) with memberValue
                    set changed to (store bim connection nodeValue in target) != the bim refused id
        if code >= 10000:
            set nodeFound to the bim connection index of chosenId in (@intrinsic("dereference", target))
            if nodeFound's valid:
                set nodeValue to the item at nodeFound's position in (target's connections's values)
                set partCursor to (code - 10000) / 20
                set fieldCode to the remainder of (code - 10000) divided by 20
                if partCursor < (the length of (nodeValue's additions's values)):
                    set nodeValue's additions to the cad clone of nodeValue's additions
                    set partValue to the item at partCursor in (nodeValue's additions's values)
                    if fieldCode = 0:
                        set partValue's width to metres
                    if fieldCode = 1:
                        set partValue's height to metres
                    if fieldCode = 2:
                        set partValue's thickness to metres
                    if fieldCode = 3:
                        set partValue's diameter to metres
                    if fieldCode = 4:
                        set partValue's length to metres
                    if fieldCode = 5:
                        set partValue's rows to typed as an integer
                    if fieldCode = 6:
                        set partValue's columns to typed as an integer
                    if fieldCode = 7:
                        set partValue's rowPitch to metres
                    if fieldCode = 8:
                        set partValue's columnPitch to metres
                    if fieldCode = 9:
                        set partValue's holeDiameter to metres
                    if fieldCode = 10:
                        set partValue's origin's x to metres
                    if fieldCode = 11:
                        set partValue's origin's y to metres
                    if fieldCode = 12:
                        set partValue's origin's z to metres
                    if fieldCode = 13:
                        set partValue's memberId to typed as a 64 bit integer
                    if fieldCode = 14:
                        set partValue's axis's x to typed
                    if fieldCode = 15:
                        set partValue's axis's y to typed
                    if fieldCode = 16:
                        set partValue's axis's z to typed
                    replace item at index partCursor in (nodeValue's additions's values) with partValue
                    set changed to (store bim connection nodeValue in target) != the bim refused id
        if (code >= 90) and (code <= 127):
            set found to the bim reinforcement index of chosenId in (@intrinsic("dereference", target))
            if found's valid:
                set spec to the item at found's position in (target's reinforcements's values)
                if code = 90:
                    set spec's diameter to metres
                if code = 91:
                    set spec's secondaryDiameter to metres
                if code = 92:
                    set spec's spacing to metres
                if code = 93:
                    set spec's crossSpacing to metres
                if code = 94:
                    set spec's cover to metres
                if code = 95:
                    set spec's width to metres
                if code = 96:
                    set spec's depth to metres
                if code = 97:
                    set spec's bendRadius to metres
                if code = 99:
                    set spec's start's x to metres
                if code = 100:
                    set spec's start's y to metres
                if code = 101:
                    set spec's start's z to metres
                if code = 102:
                    set spec's finish's x to metres
                if code = 103:
                    set spec's finish's y to metres
                if code = 104:
                    set spec's finish's z to metres
                if code = 105:
                    set spec's topCount to 0
                    if (typed >= 1.0) and (typed <= 100.0):
                        if typed = ((typed as an integer) as a 64 bit floating-point number):
                            set spec's topCount to typed as an integer
                if code = 106:
                    set spec's topDiameter to metres
                if code = 107:
                    set spec's bottomCount to 0
                    if (typed >= 1.0) and (typed <= 100.0):
                        if typed = ((typed as an integer) as a 64 bit floating-point number):
                            set spec's bottomCount to typed as an integer
                if code = 108:
                    set spec's bottomDiameter to metres
                if code = 110:
                    set spec's startZoneLength to metres
                if code = 111:
                    set spec's startZoneSpacing to metres
                if code = 112:
                    set spec's endZoneLength to metres
                if code = 113:
                    set spec's endZoneSpacing to metres
                if code = 114:
                    set spec's extraTopCount to -1
                    if (typed >= 0.0) and (typed <= 100.0):
                        if typed = ((typed as an integer) as a 64 bit floating-point number):
                            set spec's extraTopCount to typed as an integer
                if code = 115:
                    set spec's extraTopDiameter to metres
                if code = 116:
                    set spec's extraBottomCount to -1
                    if (typed >= 0.0) and (typed <= 100.0):
                        if typed = ((typed as an integer) as a 64 bit floating-point number):
                            set spec's extraBottomCount to typed as an integer
                if code = 117:
                    set spec's extraBottomDiameter to metres
                if code = 118:
                    set spec's extraFrom to metres
                if code = 119:
                    set spec's extraTo to metres
                if code = 120:
                    set spec's areaMode to -1
                    if (typed >= 0.0) and (typed <= 3.0):
                        if typed = ((typed as an integer) as a 64 bit floating-point number):
                            set spec's areaMode to typed as an integer
                if code = 121:
                    set spec's faceMask to -1
                    if (typed >= 0.0) and (typed <= 3.0):
                        if typed = ((typed as an integer) as a 64 bit floating-point number):
                            set spec's faceMask to typed as an integer
                if code = 122:
                    set spec's farDiameter to metres
                if code = 123:
                    set spec's farSecondaryDiameter to metres
                if code = 124:
                    set spec's farSpacing to metres
                if code = 125:
                    set spec's farCrossSpacing to metres
                if code = 126:
                    set spec's curveRadius to metres
                set changed to (store bim reinforcement spec in target) != the bim refused id
        if code = bim wall height property:
            set changed to set bim wall chosenId height to metres in target
        if code = bim wall base property:
            set baseFound to the bim wall index of chosenId in (@intrinsic("dereference", target))
            if baseFound's valid:
                set changed to set bim wall chosenId base to metres and height to (the item at baseFound's position in (target's walls's values))'s height in target
                # A top held at a level stays there.
                if changed and ((the item at baseFound's position in (target's walls's values))'s topLevelId != the bim refused id):
                    set changed to hold bim wall chosenId top at level (the item at baseFound's position in (target's walls's values))'s topLevelId in target
        if code = bim wall bulge property:
            set changed to bend bim wall chosenId keeping its joins by metres in target
        if code = bim system line property:
            set changed to move bim system line editor's partCode of chosenId to metres in target
        if code = bim system bulge property:
            set changed to set bim curtain wall chosenId bulge to metres in target
        if (code = bim linear twist property) or (code = bim linear taper property):
            set shapedFound to the bim linear index of chosenId in (@intrinsic("dereference", target))
            if shapedFound's valid:
                set shapedValue to the item at shapedFound's position in (target's linears's values)
                if code = bim linear twist property:
                    set changed to shape bim linear chosenId twisting ((typed * 3.141592653589793) / 180.0) tapering shapedValue's taper in target
                else:
                    set changed to shape bim linear chosenId twisting shapedValue's twist tapering (a cad vector2 with x typed and y typed) in target
        if (code >= bim layer edge property) and (code < ((bim layer edge property) + 10)):
            # Whole millimetres past the outline (negative: short of it).
            set edgedType to the bim selected planar type of (@intrinsic("dereference", editor))
            if edgedType != the bim refused id:
                set edgeMillimetres to (the floor of ((metres * 1000.0) + 0.5)) as a 64 bit integer
                set bim setting ((bim layer edge setting) + (code - (bim layer edge property))) of edgedType to edgeMillimetres keeping (edgeMillimetres != (0 as a 64 bit integer)) in target
                set changed to true
        if (code = bim nlsfb property) or (code = bim omniclass property):
            # A code as typed, not a length: 21.12, or eight digits.
            set codedType to the bim selected type id of (@intrinsic("dereference", editor))
            if codedType != the bim refused id:
                set assemblyCode to bim nlsfb setting
                set codeValue to (the floor of ((typed * 100.0) + 0.5)) as a 64 bit integer
                if code = bim omniclass property:
                    set assemblyCode to bim omniclass setting
                    set codeValue to (the floor of (typed + 0.5)) as a 64 bit integer
                set bim setting assemblyCode of codedType to codeValue keeping (codeValue > (0 as a 64 bit integer)) in target
                set changed to true
        if code = bim baluster spacing property:
            set spacingMillimetres to (the floor of ((metres * 1000.0) + 0.5)) as a 64 bit integer
            set bim setting (bim baluster spacing setting) of chosenId to spacingMillimetres keeping (spacingMillimetres > (20 as a 64 bit integer)) in target
            set changed to true
        if (code = bim joint width property) or (code = bim joint depth property):
            # Whole millimetres, at least one.
            set jointMillimetres to (the floor of ((metres * 1000.0) + 0.5)) as a 64 bit integer
            if jointMillimetres >= (1 as a 64 bit integer):
                set jointCode to bim joint width setting
                if code = bim joint depth property:
                    set jointCode to bim joint depth setting
                set bim setting jointCode of chosenId to jointMillimetres keeping true in target
                set changed to true
        if ((code = bim plate top property) or (code = bim plate pitch property)) or (code = bim plate heading property):
            set plateFound to the bim slab index of chosenId in (@intrinsic("dereference", target))
            if plateFound's valid:
                set plateValue to the item at plateFound's position in (target's slabs's values)
                set newTop to plateValue's top
                set newPitch to plateValue's pitch
                set newHeading to plateValue's heading
                if code = bim plate top property:
                    set newTop to metres
                if code = bim plate pitch property:
                    set newPitch to typed * (3.141592653589793 / 180.0)
                if code = bim plate heading property:
                    set newHeading to typed * (3.141592653589793 / 180.0)
                set changed to set bim plate chosenId top to newTop pitch newPitch heading newHeading in target
        if ((code = bim linear angle property) or (code = bim linear width property)) or (code = bim linear depth property):
            set linearFound to the bim linear index of chosenId in (@intrinsic("dereference", target))
            if linearFound's valid:
                set linearValue to the item at linearFound's position in (target's linears's values)
                set linearType to the bim type of linear linearValue in (@intrinsic("dereference", target))
                if code = bim linear angle property:
                    set changed to move bim linear chosenId to linearValue's start and linearValue's finish turned (typed * (3.141592653589793 / 180.0)) in target
                else if code = bim linear width property:
                    set changed to size bim linear type linearType's id to metres by linearType's depth in target
                else:
                    set changed to size bim linear type linearType's id to linearType's width by metres in target
        if (code = bim wall lean property) or (code = bim wall rise property):
            set wallFound to the bim wall index of chosenId in (@intrinsic("dereference", target))
            if wallFound's valid:
                set shapedWall to the item at wallFound's position in (target's walls's values)
                if code = bim wall lean property:
                    set changed to set bim wall chosenId lean to metres and rise to shapedWall's rise in target
                else:
                    set changed to set bim wall chosenId lean to shapedWall's lean and rise to metres in target
        if code = bim opening offset property:
            set changed to move bim opening chosenId to metres in target
        if (code >= bim opening width property) and (code <= bim opening sill property):
            set found to the bim opening index of chosenId in (@intrinsic("dereference", target))
            if found's valid:
                set typeId to (the item at found's position in (target's openings's values))'s typeId
                set typeFound to the bim opening type index of typeId in (@intrinsic("dereference", target))
                set openingType to the item at typeFound's position in (target's openingTypes's values)
                set widthValue to openingType's width
                set heightValue to openingType's height
                set sillValue to openingType's sill
                if code = bim opening width property:
                    set widthValue to metres
                if code = bim opening height property:
                    set heightValue to metres
                if code = bim opening sill property:
                    set sillValue to metres
                set changed to set bim opening type typeId sized widthValue by heightValue with sill sillValue in target
        if code = bim slab thickness property:
            set changed to set bim slab chosenId thickness to metres in target
        if code = bim sketch height property:
            set changed to set bim face chosenId height to metres in target
        if (code = bim level elevation property) or (code = bim level height property):
            set editedLevel to the bim edited level of (@intrinsic("dereference", editor))
            set levelFound to the bim level index of editedLevel in (@intrinsic("dereference", target))
            if levelFound's valid:
                set levelValue to the item at levelFound's position in (target's levels's values)
                if code = bim level elevation property:
                    set changed to set bim level editedLevel at metres with height levelValue's height in target
                else:
                    set changed to set bim level editedLevel at levelValue's elevation with height metres in target
        if code = bim instance angle property:
            set found to the bim instance index of chosenId in (@intrinsic("dereference", target))
            if found's valid:
                set placement to the item at found's position in (target's instances's values)
                set changed to move bim instance chosenId to placement's origin turned (typed * (3.141592653589793 / 180.0)) in target
        if (code >= (bim layer thickness property)) and (code < (bim layer material property)):
            set typeFound to the bim wall type index of (the bim selected planar type of (@intrinsic("dereference", editor))) in (@intrinsic("dereference", target))
            if typeFound's valid:
                set planarType to the item at typeFound's position in (target's wallTypes's values)
                set layerIndex to code - (bim layer thickness property)
                if (layerIndex < (the length of (planarType's layers's values))) and (metres > 0.0):
                    set thickened to an empty list of a bim layer record
                    loop cursor from 0 to the length of (planarType's layers's values):
                        append (the item at cursor in (planarType's layers's values)) to thickened
                    set original to the item at layerIndex in thickened
                    replace item at index layerIndex in thickened with (@intrinsic("construct", a bim layer record, original's material, metres))
                    set changed to set bim wall type planarType's id layers to thickened in target
                    free thickened
        if (code = bim view scale property) or (code = bim view cut property):
            set viewFound to the bim view index of editor's planViewId in (@intrinsic("dereference", target))
            if viewFound's valid:
                set viewValue to the item at viewFound's position in (target's views's values)
                set changed to true
                if code = bim view scale property:
                    set wholeScale to (the rounded value of typed) as an integer
                    if (wholeScale < 1) or (wholeScale > 10000):
                        set changed to false
                    set viewValue's scale to wholeScale
                else:
                    if (metres < -10.0) or (metres > 100.0):
                        set changed to false
                    set viewValue's cutHeight to metres
                if changed:
                    store bim view viewValue in target
        if ((code = bim part width property) or (code = bim part depth property)) or (code = bim part height property):
            set found to the bim instance index of chosenId in (@intrinsic("dereference", target))
            if found's valid:
                set placement to the item at found's position in (target's instances's values)
                set definitionFound to the bim component index of placement's componentId in (@intrinsic("dereference", target))
                if definitionFound's valid:
                    set definition to the item at definitionFound's position in (target's components's values)
                    set partCount to the length of (definition's solids's values)
                    if partCount > 0:
                        set lastPart to the item at (partCount - 1) in (definition's solids's values)
                        set resized to lastPart's size
                        if code = bim part width property:
                            set resized to a cad vector3 with x metres, y resized's y and z resized's z
                        if code = bim part depth property:
                            set resized to a cad vector3 with x resized's x, y metres and z resized's z
                        if code = bim part height property:
                            set resized to a cad vector3 with x resized's x, y resized's y and z metres
                        set changed to resize bim solid (partCount - 1) of component placement's componentId to resized in target
        if changed:
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Property changed"
        else:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Refused: that value does not fit"
