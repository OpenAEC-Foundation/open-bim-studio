# A modelling recipe, not a resistance or anchor-design calculation.
import examples/bim-slice/bim_connections.dl

function add bim base plate below {a 64 bit integer:columnId} in {a pointer to a bim model record:target}:
    execute:
        set modelValue to @intrinsic("dereference", target)
        set found to the bim linear index of columnId in modelValue
        if found's valid = false:
            return the bim refused id
        set hostValue to the item at found's position in (modelValue's linears's values)
        set profile to the bim type of linear hostValue in modelValue
        set orientation to the bim frame of linear hostValue in modelValue
        if ((profile's role != bim column role) or (profile's material != (the string form of "steel"))) or ((the absolute value of orientation's along's z) < 0.999999):
            return the bim refused id
        set whichEnd to 0
        set anchorPoint to orientation's first
        if orientation's last's z < orientation's first's z:
            set whichEnd to 1
            set anchorPoint to orientation's last
        set members to a cad topology list of a connection member
        append (@intrinsic("construct", a connection member, columnId, whichEnd, 0.0)) to (members's values)
        set parts to a cad topology list of a connection addition
        set downward to a cad vector3 with x 0.0, y 0.0 and z -1.0
        set plateValue to @intrinsic("construct", a connection addition, 1, columnId, 0, (a cad vector3 with x 0.0, y 0.0 and z -0.01), downward, profile's width + 0.20, profile's depth + 0.20, 0.02, 0.02, 0.35, 2, 2, profile's depth + 0.10, profile's width + 0.10, 0.024)
        append plateValue to (parts's values)
        set anchors to plateValue
        set anchors's key to 2
        set anchors's kind to 3
        set anchors's origin's z to 0.04
        append anchors to (parts's values)
        set label to (the string form of "BP") + (the string form of target's nextId)
        set spec to @intrinsic("construct", a connection definition, the bim refused id, hostValue's levelId, label, 1, 2, anchorPoint, members, parts)
        return store bim connection spec in target
