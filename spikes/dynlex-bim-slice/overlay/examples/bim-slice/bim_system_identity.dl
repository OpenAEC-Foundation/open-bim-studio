# Recipe identity shared by the generator and recipe library.
import examples/bim-slice/bim_model.dl

# The setting that keeps the type a building system was given: its index in
# `the bim system types` plus one.
function bim system type setting:
    replacement:
        1700000

# The index of the type building system `systemId` was given, or -1.
function the bim system type index of {a 64 bit integer:systemId} in {bim model record:modelValue}:
    execute:
        set reading to the bim setting (bim system type setting) of systemId in modelValue
        if reading's found = false:
            return -1
        return (reading's value as an integer) - 1

# New creation actions store the clear gap to the outer frame, in mm.
# Older models retain their explicit centre-line hosting inset unchanged.
function bim window clearance setting:
    replacement:
        1700002
