# SPDX-License-Identifier: MPL-2.0
# The property sets in the properties window, edited. Each property's row
# carries a code (`bim pset property base` plus its row number among the
# element's properties, in the window's order); a click on it types a new
# value, and Enter stores it in the property's own type: Yes or No for a
# boolean, a length in the project's unit, else the text. A row after the
# sets takes a new property as "Set.Name=value" (the set OBS_Properties when
# no set is named). The element is the edited level, else the selection,
# else the sheet whose properties show (`the bim pset owner of`).
import examples/bim-slice/bim_editor_core.dl

function bim pset property base:
    replacement:
        40000
function bim new pset property:
    replacement:
        49999
function bim pset property limit:
    replacement:
        50000

# The element whose property sets the properties window shows, or the
# refused id: the edited level, else the selection (not a grid, nor an
# import, which the model keeps no properties for), else the sheet open in
# its tab.
function the bim pset owner of {bim editor record:editor}:
    execute:
        if editor's selectionKind = bim level picked:
            return the bim edited level of editor
        if (editor's selectionKind != bim nothing picked) and ((editor's selectionKind != bim grid picked) and (editor's selectionKind != bim imported picked)):
            return editor's selectionId
        if editor's propertiesViewId = bim sheet properties context:
            return editor's sheetId
        return the bim refused id

# Property number `rowNumber` of `ownerId`, in the window's order (the sets
# in the order they first appear, each with its properties in order), or
# an entry of no element when there is none.
function the bim pset entry {integer:rowNumber} of {a 64 bit integer:ownerId} in {bim model record:modelValue}:
    execute:
        set setNames to an empty list of a string
        loop entryCursor from 0 to the length of (modelValue's properties's values):
            set candidate to the item at entryCursor in (modelValue's properties's values)
            if candidate's elementId = ownerId:
                set seen to false
                loop nameCursor from 0 to the length of setNames:
                    if (the item at nameCursor in setNames) = candidate's setName:
                        set seen to true
                if seen = false:
                    append candidate's setName to setNames
        set counted to 0
        loop setCursor from 0 to the length of setNames:
            set wantedSet to the item at setCursor in setNames
            loop entryCursor from 0 to the length of (modelValue's properties's values):
                set candidate to the item at entryCursor in (modelValue's properties's values)
                if (candidate's elementId = ownerId) and (candidate's setName = wantedSet):
                    if counted = rowNumber:
                        free setNames
                        return candidate
                    set counted to counted + 1
        free setNames
        return @intrinsic("construct", a bim pset entry record, the bim refused id, the string form of "", the string form of "", the string form of "", the string form of "")

# `rawText` without the spaces at its ends.
function the bim pset trimmed {a string:rawText}:
    execute:
        set first to 0
        set last to the length of rawText
        loop while (first < last) and (((the character at first in rawText) as an integer) = 32):
            set first to first + 1
        loop while (last > first) and (((the character at (last - 1) in rawText) as an integer) = 32):
            set last to last - 1
        return the substring of rawText from first spanning (last - first) bytes

# The stored form of `rawText` for a property of `valueType`: .T. or .F.
# (unknown .U.) for a boolean or logical typed Yes/No, true/false or 1/0;
# metres for a length typed in the units `unitCode`; else the text itself.
function the bim pset stored value of {a string:rawText} typed {a string:valueType} in units {integer:unitCode}:
    execute:
        if (valueType = (the string form of "IFCBOOLEAN")) or (valueType = (the string form of "IFCLOGICAL")):
            set first to 0
            if (the length of rawText) > 0:
                set first to (the character at 0 in rawText) as an integer
            if (((first = 89) or (first = 121)) or ((first = 84) or (first = 116))) or (first = 49):
                return the string form of ".T."
            if (((first = 78) or (first = 110)) or ((first = 70) or (first = 102))) or (first = 48):
                return the string form of ".F."
            return the string form of ".U."
        if (valueType = (the string form of "IFCLENGTHMEASURE")) or (valueType = (the string form of "IFCPOSITIVELENGTHMEASURE")):
            return the string form of ((the bim numeric value of rawText) * (the bim metres per unitCode))
        return rawText

# The typed text applied to the property of code `code` of the element
# shown, as one edit; true when `code` is a property set's.
function apply bim editor pset text {integer:code} in {a pointer to a bim editor record:editor}:
    execute:
        if (code < bim pset property base) or (code >= bim pset property limit):
            return false
        set ownerId to the bim pset owner of (@intrinsic("dereference", editor))
        if ownerId = the bim refused id:
            set editor's message to the string form of "Properties: select an element first"
            return true
        set target to the address of (editor's documentValue's current)
        if code = bim new pset property:
            set assignment to editor's propertyText
            set equals to the index of "=" in assignment
            if equals < 0:
                set editor's message to the string form of "Type Set.Name=value"
                return true
            set spec to the bim pset trimmed (the substring of assignment from 0 spanning equals bytes)
            set newValue to the bim pset trimmed (the substring of assignment from (equals + 1) spanning (((the length of assignment) - equals) - 1) bytes)
            set setName to the string form of "OBS_Properties"
            set propertyName to spec
            set dot to the index of "." in spec
            if dot >= 0:
                set setName to the bim pset trimmed (the substring of spec from 0 spanning dot bytes)
                set propertyName to the bim pset trimmed (the substring of spec from (dot + 1) spanning (((the length of spec) - dot) - 1) bytes)
            if ((the length of propertyName) = 0) or ((the length of setName) = 0):
                set editor's message to the string form of "Type Set.Name=value"
                return true
            begin bim transaction in (the address of (editor's documentValue))
            set bim property propertyName of set setName of ownerId to newValue typed (the string form of "IFCLABEL") in target
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to (setName + (the string form of ".")) + (propertyName + ((the string form of " = ") + newValue))
            return true
        set edited to the bim pset entry (code - (bim pset property base)) of ownerId in (@intrinsic("dereference", target))
        if edited's elementId = the bim refused id:
            set editor's message to the string form of "Properties: that row is gone"
            return true
        set kept to the bim pset stored value of (editor's propertyText) typed (edited's valueType) in units (editor's lengthUnit)
        begin bim transaction in (the address of (editor's documentValue))
        set bim property (edited's name) of set (edited's setName) of ownerId to kept typed (edited's valueType) in target
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to ((edited's setName) + (the string form of ".")) + ((edited's name) + ((the string form of " = ") + kept))
        return true
