# SPDX-License-Identifier: MPL-2.0
# Strict model-space coordinates, independent of editor and rendering state.
import examples/bim-slice/bim_model.dl

class:
    patterns:
        [a|] bim point input record
    members:
        valid as a boolean
        point as a cad vector2

class:
    patterns:
        [a|] bim input number record
    members:
        valid as a boolean
        value as a 64 bit floating-point number

local function bim input whitespace code {integer:octet}:
    execute:
        return (octet = 32) or ((octet >= 9) and (octet <= 13))

local function the bim input trimmed text of {a string:rawText}:
    execute:
        set firstIndex to 0
        set lastIndex to the length of rawText
        set trimmingEnds to true
        loop while (firstIndex < lastIndex) and trimmingEnds:
            set octet to (the character at firstIndex in rawText) as an integer
            set trimmingEnds to bim input whitespace code octet
            if trimmingEnds:
                set firstIndex to firstIndex + 1
        set trimmingEnds to true
        loop while (lastIndex > firstIndex) and trimmingEnds:
            set octet to (the character at (lastIndex - 1) in rawText) as an integer
            set trimmingEnds to bim input whitespace code octet
            if trimmingEnds:
                set lastIndex to lastIndex - 1
        return the substring of rawText from firstIndex spanning (lastIndex - firstIndex) bytes

local function the bim input number of {a string:numberText}:
    execute:
        set refusedNumber to @intrinsic("construct", a bim input number record, false, 0.0)
        set digitsText to the bim input trimmed text of numberText
        if (the length of digitsText) = 0:
            return refusedNumber
        set resultValue to 0.0
        set signValue to 1.0
        set digitCursor to 0
        set firstCode to (the character at 0 in digitsText) as an integer
        if (firstCode = 43) or (firstCode = 45):
            if firstCode = 45:
                set signValue to -1.0
            set digitCursor to 1
        set fractionWeight to 0.1
        set decimalSeen to false
        set digitsSeen to 0
        loop while digitCursor < (the length of digitsText):
            set octet to (the character at digitCursor in digitsText) as an integer
            if octet = 46:
                if decimalSeen:
                    return refusedNumber
                set decimalSeen to true
            else:
                if (octet < 48) or (octet > 57):
                    return refusedNumber
                set digitsSeen to digitsSeen + 1
                if decimalSeen:
                    set resultValue to resultValue + (((octet - 48) as a 64 bit floating-point number) * fractionWeight)
                    set fractionWeight to fractionWeight * 0.1
                else:
                    set resultValue to (resultValue * 10.0) + ((octet - 48) as a 64 bit floating-point number)
                if resultValue > 1000000000000.0:
                    return refusedNumber
            set digitCursor to digitCursor + 1
        if digitsSeen = 0:
            return refusedNumber
        return @intrinsic("construct", a bim input number record, true, resultValue * signValue)

local function the bim scalar precedence of {integer:operatorCode}:
    execute:
        if (operatorCode = 117) or (operatorCode = 112):
            return 3
        if (operatorCode = 42) or (operatorCode = 47):
            return 2
        if (operatorCode = 43) or (operatorCode = 45):
            return 1
        return 0

local function reduce bim scalar operators {a pointer to a list:operatorStack} using {a pointer to a list:valueStack}:
    execute:
        if (the length of operatorStack) = 0:
            return false
        set operationCode to the item at ((the length of operatorStack) - 1) in operatorStack
        remove item ((the length of operatorStack) - 1) from operatorStack
        if ((the length of valueStack) = 0) or (operationCode = 40):
            return false
        set rightValue to the item at ((the length of valueStack) - 1) in valueStack
        remove item ((the length of valueStack) - 1) from valueStack
        set resultValue to rightValue
        if operationCode = 117:
            set resultValue to 0.0 - rightValue
        else if operationCode != 112:
            if (the length of valueStack) = 0:
                return false
            set leftValue to the item at ((the length of valueStack) - 1) in valueStack
            remove item ((the length of valueStack) - 1) from valueStack
            if operationCode = 43:
                set resultValue to leftValue + rightValue
            else if operationCode = 45:
                set resultValue to leftValue - rightValue
            else if operationCode = 42:
                set resultValue to leftValue * rightValue
            else if operationCode = 47:
                if rightValue = 0.0:
                    return false
                set resultValue to leftValue / rightValue
            else:
                return false
        if ((the absolute value of resultValue) <= 1000000000000.0) = false:
            return false
        append resultValue to valueStack
        return true

# A complete scalar expression: bounded tokens and intermediate results,
# explicit multiplication, balanced brackets, and no division by zero.
function the bim scalar input of {a string:inputText}:
    execute:
        set refusedNumber to @intrinsic("construct", a bim input number record, false, 0.0)
        if ((the length of inputText) = 0) or ((the length of inputText) > 4096):
            return refusedNumber
        set expressionText to the bim input trimmed text of inputText
        if (the length of expressionText) = 0:
            return refusedNumber
        set scanIndex to 0
        if ((the character at 0 in expressionText) as an integer) = 61:
            set scanIndex to 1
        set pendingCodes to an empty list of an integer
        set operandValues to an empty list of a 64 bit floating-point number
        set expectingOperand to true
        set evaluationValid to true
        loop while (scanIndex < (the length of expressionText)) and evaluationValid:
            set octet to (the character at scanIndex in expressionText) as an integer
            if bim input whitespace code octet:
                set scanIndex to scanIndex + 1
            else if expectingOperand:
                if (octet = 43) or (octet = 45):
                    set unaryCode to 112
                    if octet = 45:
                        set unaryCode to 117
                    append unaryCode to pendingCodes
                    set scanIndex to scanIndex + 1
                else if octet = 40:
                    append 40 to pendingCodes
                    set scanIndex to scanIndex + 1
                else if ((octet >= 48) and (octet <= 57)) or (octet = 46):
                    set numberStart to scanIndex
                    set readingDigits to true
                    loop while (scanIndex < (the length of expressionText)) and readingDigits:
                        set digitCode to (the character at scanIndex in expressionText) as an integer
                        set readingDigits to ((digitCode >= 48) and (digitCode <= 57)) or (digitCode = 46)
                        if readingDigits:
                            set scanIndex to scanIndex + 1
                    set numberReading to the bim input number of (the substring of expressionText from numberStart spanning (scanIndex - numberStart) bytes)
                    set evaluationValid to numberReading's valid
                    if evaluationValid:
                        append numberReading's value to operandValues
                        set expectingOperand to false
                else:
                    set evaluationValid to false
            else if octet = 41:
                set foundOpening to false
                loop while ((the length of pendingCodes) > 0) and (evaluationValid and (foundOpening = false)):
                    if (the item at ((the length of pendingCodes) - 1) in pendingCodes) = 40:
                        remove item ((the length of pendingCodes) - 1) from pendingCodes
                        set foundOpening to true
                    else:
                        set evaluationValid to reduce bim scalar operators pendingCodes using operandValues
                if foundOpening = false:
                    set evaluationValid to false
                set scanIndex to scanIndex + 1
            else if ((octet = 43) or (octet = 45)) or ((octet = 42) or (octet = 47)):
                set reducingStack to true
                loop while ((the length of pendingCodes) > 0) and (evaluationValid and reducingStack):
                    set stackedCode to the item at ((the length of pendingCodes) - 1) in pendingCodes
                    if (stackedCode != 40) and ((the bim scalar precedence of stackedCode) >= (the bim scalar precedence of octet)):
                        set evaluationValid to reduce bim scalar operators pendingCodes using operandValues
                    else:
                        set reducingStack to false
                append octet to pendingCodes
                set expectingOperand to true
                set scanIndex to scanIndex + 1
            else:
                set evaluationValid to false
        if expectingOperand:
            set evaluationValid to false
        loop while ((the length of pendingCodes) > 0) and evaluationValid:
            set evaluationValid to reduce bim scalar operators pendingCodes using operandValues
        set resultReading to refusedNumber
        if evaluationValid and ((the length of operandValues) = 1):
            set resultReading to @intrinsic("construct", a bim input number record, true, the item at 0 in operandValues)
        free pendingCodes
        free operandValues
        return resultReading

local function bim input position {cad vector2:locationValue} is bounded:
    execute:
        return ((the absolute value of locationValue's x) <= 1000000000000.0) and ((the absolute value of locationValue's y) <= 1000000000000.0)

# x,y and #x,y are absolute; @dx,dy and @distance<degrees are relative.
# A scalar follows the pointer direction from the base, including negatives.
# Length components use the supplied current unit; angles are always degrees.
# Refusal retains the base point and never changes caller-owned state.
function the bim point input of {a string:inputText} relative to {cad vector2:basePoint} along {cad vector2:pointerPoint} metres per unit {a 64 bit floating-point number:unitScale}:
    execute:
        set refusedPoint to @intrinsic("construct", a bim point input record, false, basePoint)
        if (((the length of inputText) > 4096) or ((the length of inputText) = 0)) or (((unitScale > 0.0) and (unitScale <= 1000000.0)) = false):
            return refusedPoint
        set entryText to the bim input trimmed text of inputText
        if (the length of entryText) = 0:
            return refusedPoint
        set relativeEntry to false
        set forcedAbsolute to false
        set prefixCode to (the character at 0 in entryText) as an integer
        if (prefixCode = 64) or (prefixCode = 35):
            set relativeEntry to prefixCode = 64
            set forcedAbsolute to prefixCode = 35
            set entryText to the bim input trimmed text of (the substring of entryText from 1 spanning ((the length of entryText) - 1) bytes)
        set commaIndex to -1
        set polarIndex to -1
        loop entryCursor from 0 to the length of entryText:
            set octet to (the character at entryCursor in entryText) as an integer
            if octet = 44:
                if commaIndex >= 0:
                    return refusedPoint
                set commaIndex to entryCursor
            if octet = 60:
                if polarIndex >= 0:
                    return refusedPoint
                set polarIndex to entryCursor
        set resultPoint to basePoint
        if commaIndex >= 0:
            if polarIndex >= 0:
                return refusedPoint
            set xReading to the bim input number of (the substring of entryText from 0 spanning commaIndex bytes)
            set yReading to the bim input number of (the substring of entryText from (commaIndex + 1) spanning ((the length of entryText) - (commaIndex + 1)) bytes)
            if (xReading's valid = false) or (yReading's valid = false):
                return refusedPoint
            set resultPoint to a cad vector2 with x (xReading's value * unitScale) and y (yReading's value * unitScale)
            if relativeEntry:
                if (bim input position basePoint is bounded) = false:
                    return refusedPoint
                set resultPoint to a cad vector2 with x (basePoint's x + resultPoint's x) and y (basePoint's y + resultPoint's y)
        else if polarIndex >= 0:
            if (relativeEntry = false) or ((bim input position basePoint is bounded) = false):
                return refusedPoint
            set distanceReading to the bim input number of (the substring of entryText from 0 spanning polarIndex bytes)
            set angleReading to the bim input number of (the substring of entryText from (polarIndex + 1) spanning ((the length of entryText) - (polarIndex + 1)) bytes)
            if (distanceReading's valid = false) or (angleReading's valid = false):
                return refusedPoint
            set radiansValue to angleReading's value * (3.141592653589793 / 180.0)
            set distanceValue to distanceReading's value * unitScale
            set resultPoint to a cad vector2 with x (basePoint's x + (distanceValue * (the cosine of radiansValue))) and y (basePoint's y + (distanceValue * (the sine of radiansValue)))
        else:
            if relativeEntry or forcedAbsolute:
                return refusedPoint
            if ((bim input position basePoint is bounded) and (bim input position pointerPoint is bounded)) = false:
                return refusedPoint
            set distanceReading to the bim scalar input of entryText
            if distanceReading's valid = false:
                return refusedPoint
            set directionLength to the cad distance from basePoint to pointerPoint
            if directionLength <= 1e-12:
                return refusedPoint
            set distanceValue to distanceReading's value * unitScale
            set resultPoint to a cad vector2 with x (basePoint's x + (((pointerPoint's x - basePoint's x) / directionLength) * distanceValue)) and y (basePoint's y + (((pointerPoint's y - basePoint's y) / directionLength) * distanceValue))
        if (bim input position resultPoint is bounded) = false:
            return refusedPoint
        return @intrinsic("construct", a bim point input record, true, resultPoint)
