# SPDX-License-Identifier: MPL-2.0
# Editor core of the BIM slice: tools, inference snapping, numeric input during
# a gesture, transactions and incremental evaluation, driven by abstract
# location and key events so it runs without a window. Commands are verb first:
# choose a tool, gesture, optionally type a number, confirm.
import examples/bim-slice/bim_drawing.dl
import examples/bim-slice/bim_sheet.dl
import examples/bim-slice/bim_schedule.dl
import examples/bim-slice/bim_network.dl
import examples/bim-slice/bim_ifc.dl
import examples/bim-slice/bim_ifcx.dl
import examples/bim-slice/bim_ifcx_read.dl
import examples/bim-slice/bim_scene.dl
import examples/bim-slice/bim_file.dl
import examples/bim-slice/bim_hidden.dl
import examples/bim-slice/bim_view.dl
import examples/bim-slice/bim_checks.dl
import examples/bim-slice/bim_boundary_sketch.dl
import examples/bim-slice/bim_system_types.dl
import examples/bim-slice/bim_stair_types.dl
import examples/bim-slice/bim_steel_profiles.dl
import examples/bim-slice/bim_project_settings.dl

