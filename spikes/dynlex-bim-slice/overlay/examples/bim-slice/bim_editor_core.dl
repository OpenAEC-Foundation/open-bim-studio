class:
    patterns:
        [a|] bim snap record
    members:
        point as a cad vector2
        label as a string
        # Where an extension or a parallel runs from (else `point`).
        origin as a cad vector2

class:
    patterns:
        [a|] bim space choice record
    members:
        valid as a boolean
        space as a bim space record

class:
    patterns:
        [a|] bim slab choice record
    members:
        valid as a boolean
        slab as a bim slab record

class:
    patterns:
        [a|] bim wall end record
    members:
        wallId as a 64 bit integer
        atFinish as a boolean
        origin as a cad vector2

class:
    patterns:
        [a|] bim editor record
    members:
        documentValue as a bim document record
        tool as an integer
        levelId as a 64 bit integer
        wallTypeId as a 64 bit integer
        openingTypeId as a 64 bit integer
        chainActive as a boolean
        chainStart as a cad vector2
        snap as a bim snap record
        numeric as a string
        dragging as a boolean
        dragMoved as a boolean
        dragEnds as the type of (a cad topology list of a bim wall end record)
        hoverWall as a 64 bit integer
        evaluation as a bim evaluation record
        evaluatedRevision as a 64 bit integer
        evaluatedDrag as a boolean
        plan as a bim view record
        lastRebuilt as an integer
        lastMicroseconds as a 64 bit integer
        message as a string
        sectionActive as a boolean
        sectionStart as a cad vector2
        hasSection as a boolean
        sectionFirst as a cad vector2
        sectionSecond as a cad vector2
        section as a bim view record
        viewsDirty as a boolean
        adopted as a boolean
        adoptedMicroseconds as a 64 bit integer
        spaces as the type of (a cad topology list of a bim space record)
        selectionKind as an integer
        selectionId as a 64 bit integer
        pointerLocation as a cad vector2
        windowTypeId as a 64 bit integer
        doorTypeId as a 64 bit integer
        dragOrigin as a cad vector2
        slabCorner as an integer
        pickTolerance as a 64 bit floating-point number
        planRules as a bim view rules record
        sectionRules as a bim view rules record
        modelRules as a bim view rules record
        gridActive as a boolean
        gridStart as a cad vector2
        gridDragId as a 64 bit integer
        gridDragAtFinish as a boolean
        bendWallId as a 64 bit integer
        sketchChain as the type of (a cad topology list of a cad vector2)
        pushId as a 64 bit integer
        pushOrigin as a cad vector2
        pushBase as a 64 bit floating-point number
        textActive as a boolean
        textAnchor as a cad vector2
        textBuffer as a string
        moveStage as an integer
        moveBase as a cad vector2
        snapOff as a boolean
        orthoOn as a boolean
        polarOn as a boolean
        extending as a boolean
        chosenSketches as the type of (a cad topology list of a 64 bit integer)
        placeComponentId as a 64 bit integer
        editingInstanceId as a 64 bit integer
        editingComponentId as a 64 bit integer
        editingOrigin as a cad vector2
        editingAngle as a 64 bit floating-point number
        editingFirstId as a 64 bit integer
        editingParts as the type of (a cad topology list of a 64 bit integer)
        floorTypeIndex as an integer
        pendingLetter as an integer
        lengthUnit as an integer
        pendingAt as a 64 bit integer
        turnStart as a 64 bit floating-point number
        boundaryId as a 64 bit integer
        offsetDistance as a 64 bit floating-point number
        # Edit mode (Tab), as in Blender: the sketch element edited, its
        # picked points, and a grab (G) under way, constrained to an axis
        # (0 free, 1 X, 2 Y, 3 Z) from where it began.
        editMode as a boolean
        editSketchId as a 64 bit integer
        editPicked as the type of (a cad topology list of an integer)
        grabbing as a boolean
        grabAxis as an integer
        grabBase as a cad vector2
        # A property being typed in the properties window, and its text.
        propertyCode as an integer
        propertyText as a string
        # Push/pull of a mass's side (its outline edge `pushEdge`), as in
        # SketchUp; -1 for its top.
        pushEdge as an integer
        # Push/pull of a free mesh's face (where its loop starts in the
        # mesh's faces); -1 when the push is not of a mesh.
        pushFace as an integer
        # Whether edit mode edits a free mesh (`editSketchId` is then its id).
        editMesh as a boolean
        # The linear tool's role and the linear type it draws.
        linearRole as an integer
        linearTypeId as a 64 bit integer
        # The planar type the next floor, roof or ceiling gets (by role).
        plateTypeId as a 64 bit integer
        # The solid tool's part kind and operation, the instance whose
        # component it models (or none, for a new component), and its first
        # and second click.
        solidKind as an integer
        solidOperation as an integer
        solidInstanceId as a 64 bit integer
        solidCorner as a cad vector2
        solidReach as a cad vector2
        # The dimension tool's first and second feature.
        dimensionFirst as a bim reference record
        dimensionSecond as a bim reference record
        # The plan view (`bim view definition record`) the plan shows, or the
        # refused id while the model keeps no views.
        planViewId as a 64 bit integer
        # The section view the section panel shows, or the refused id.
        sectionViewId as a 64 bit integer
        # The sheet open in its tab, or the refused id.
        sheetId as a 64 bit integer
        # The schedule the window shows (its code), or -1.
        scheduleCode as an integer
        # What the spaces were found for (`the bim spaces key of …`), so that
        # an edit that moves no wall of the storey keeps them.
        spacesKey as a 64 bit floating-point number
        # The view the instance being edited belongs to (a 2D detail), or the
        # refused id.
        editingViewId as a 64 bit integer
        # The object snaps turned off, one bit per rank (`bim snap bit of`):
        # end point, mid point, intersection, perpendicular, nearest, grid.
        snapRefused as an integer
        # The part of the selected building system chosen (`the bim system
        # part code of`), or -1 for the whole system.
        partCode as an integer
        # The section view's zoom (1 fits it) and pan (pixels), set by the
        # wheel and the middle or right button over it.
        sectionZoom as a 64 bit floating-point number
        sectionPanX as a 64 bit floating-point number
        sectionPanY as a 64 bit floating-point number
        # What edit mode edits: a sketch, a mesh, or another element by its
        # control points (`the bim handles of`), by its pick kind.
        editKind as an integer
        # The 3D cursor, as in Blender: a point in the model (plan position and
        # height above the active storey) that tools can turn about.
        cursorPoint as a cad vector3
        # The control point (`the bim handles of`) of the selection a shape
        # handle drags, or -1.
        handleDrag as an integer
        # A region to zoom the plan onto (ZR), from `zoomFrom` to `zoomTo`,
        # waiting for the window when `zoomReady`.
        zoomFrom as a cad vector2
        zoomTo as a cad vector2
        zoomReady as a boolean
        # The boundary sketch open (Tab on a floor, roof or ceiling, see
        # `bim_boundary_sketch.dl`): its segments, the points clicked of the
        # line or arc being drawn, the sketch tool (`bim sketch line tool`,
        # arc or pick) and the picked segment (-1 none).
        sketchSegments as the type of (a cad topology list of a bim boundary segment record)
        sketchPending as the type of (a cad topology list of a cad vector2)
        sketchTool as an integer
        sketchPicked as an integer
        # What the sketch bounds (a plate's or a building system's pick
        # kind), and, on a building system's face, the pointer there in the
        # face's coordinates and whether it is (the 3D view is over it).
        sketchHostKind as an integer
        sketchPointer as a cad vector2
        sketchInView as a boolean
        # AL in the 3D view: the reference face's plane, through `alignSpot`
        # (in the model) with unit normal `alignNormal`, once `alignFaceSet`.
        alignSpot as a cad vector3
        alignNormal as a cad vector3
        alignFaceSet as a boolean
        # The building system type (`the bim system types`) the building
        # system tool draws, or -1 for none.
        systemTypeIndex as an integer
        # The view chosen in the project browser, whose properties show
        # while nothing is selected (else the active plan's).
        propertiesViewId as a 64 bit integer
        # The stair or railing type (`the bim stair types`) the stair and
        # railing tools draw, or -1 for none.
        stairTypeIndex as an integer
        railingTypeIndex as an integer
        # The line the wall tool draws on (`bim wall centre line`, its
        # exterior face or its interior face), and the last wall of the chain
        # being drawn, whose finish the next corner mitres (the refused id
        # for none).
        wallLine as an integer
        chainWallId as a 64 bit integer
        # The elements hidden in a view for this session (HH, HR restores;
        # `bim_hidden.dl`): pairs of a view and an element, never in the
        # model, its file or its undo.
        hiddenElements as the type of (a cad topology list of a bim hidden element record)

# Monotonic wall time, so the measured evaluation excludes nothing that runs
# on other threads and includes nothing they consume (`platform/
# obs_platform.c`: clock_gettime, or the performance counter on Windows).
function the bim microseconds now:
    execute:
        set reading to @intrinsic("call", "obs_platform", "obs_platform_monotonic_microseconds", a 64 bit integer)
        if reading < (0 as a 64 bit integer):
            @intrinsic("call", "libc", "abort", nothing)
        return reading

# A new editor holds one storey, a cavity wall type, a partition type and a
# window type, created in the first transaction.
function a new bim editor:
    execute:
        set documentValue to a new bim document
        begin bim transaction in (the address of documentValue)
        set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to (the address of (documentValue's current))
        set layerValues to an empty list of a bim layer record
        append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
        append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.12)) to layerValues
        append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.1)) to layerValues
        set cavity to add bim wall type named (the string form of "Cavity wall") with layerValues to (the address of (documentValue's current))
        free layerValues
        set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to (the address of (documentValue's current))
        set doorType to add bim door type named (the string form of "Door 900") sized 0.9 by 2.1 with frame 0.05 to (the address of (documentValue's current))
        commit bim transaction in (the address of documentValue)
        set origin to a cad vector2 with x 0.0 and y 0.0
        set snapValue to @intrinsic("construct", a bim snap record, origin, the string form of "", origin)
        return @intrinsic("construct", a bim editor record, documentValue, bim select tool, storey, cavity, windowType, false, origin, snapValue, the string form of "", false, false, a cad topology list of a bim wall end record, the bim refused id, an empty bim evaluation, (-1) as a 64 bit integer, false, an empty bim view, 0, 0 as a 64 bit integer, the string form of "", false, origin, false, origin, origin, an empty bim view, true, false, 0 as a 64 bit integer, a cad topology list of a bim space record, bim nothing picked, the bim refused id, origin, windowType, doorType, origin, -1, 0.1, the bim template rules of view kind bim plan view kind, the bim template rules of view kind bim section view kind, the bim template rules of view kind bim model view kind, false, origin, the bim refused id, false, the bim refused id, a cad topology list of a cad vector2, the bim refused id, origin, 0.0, false, origin, the string form of "", 0, origin, false, false, true, false, a cad topology list of a 64 bit integer, the bim refused id, the bim refused id, the bim refused id, origin, 0.0, 0 as a 64 bit integer, a cad topology list of a 64 bit integer, 2, 0, bim metre unit, 0 as a 64 bit integer, 0.0, the bim refused id, 1.0, false, the bim refused id, a cad topology list of an integer, false, 0, origin, -1, the string form of "", -1, -1, false, 0, the bim refused id, the bim refused id, 0, 0, the bim refused id, origin, origin, a bim reference to (the bim refused id) feature -1, a bim reference to (the bim refused id) feature -1, the bim refused id, the bim refused id, the bim refused id, -1, -1.0, the bim refused id, 0, -1, 1.0, 0.0, 0.0, 0, (a cad vector3 with x 0.0, y 0.0 and z 0.0), -1, origin, origin, false, a cad topology list of a bim boundary segment record, a cad topology list of a cad vector2, 0, -1, 0, origin, false, (a cad vector3 with x 0.0, y 0.0 and z 0.0), (a cad vector3 with x 0.0, y 0.0 and z 1.0), false, -1, the bim refused id, -1, -1, 0, the bim refused id, no bim hidden elements)

# ---------------------------------------------------------------- snapping

function the bim snap {cad vector2:point} labelled {a string:label}:
    execute:
        return @intrinsic("construct", a bim snap record, point, the string form of label, point)

function the bim snap {cad vector2:point} labelled {a string:label} from {cad vector2:source}:
    execute:
        return @intrinsic("construct", a bim snap record, point, the string form of label, source)

# Rounds a length along a tracking line to 5 cm, as the grid.
function the bim tracked length {a 64 bit floating-point number:along}:
    execute:
        return (the floor of ((along / 0.05) + 0.5)) * 0.05

# Whether `direction` (a unit vector) runs along a polar ray (every 45
# degrees), which tracking already offers.
function bim direction {cad vector2:direction} is polar:
    execute:
        set angle to @intrinsic("atan2", direction's y, direction's x)
        set step to 3.141592653589793 / 4.0
        set ray to (the floor of ((angle / step) + 0.5)) * step
        return (the absolute value of (angle - ray)) < 1e-6

function the bim grid point near {cad vector2:location} step {a 64 bit floating-point number:stepSize}:
    execute:
        set x to (@intrinsic("call", "libc", "round", a 64 bit floating-point number, location's x / stepSize)) * stepSize
        set y to (@intrinsic("call", "libc", "round", a 64 bit floating-point number, location's y / stepSize)) * stepSize
        return a cad vector2 with x x and y y

# Inference snapping in priority order: a wall end point, a wall mid point,
# horizontal or vertical alignment with the chain start, then the 0.05 m grid.
# Wall points snap on every storey, so walls can be stacked over the storey
# below. `tolerance` is the pick radius in model units.
# A snap candidate: its point, its kind, its priority (lower wins a near
# tie) and its distance from the pointer.
class:
    patterns:
        [a|] bim snap candidate record
    members:
        point as a cad vector2
        label as a string
        rank as an integer
        gap as a 64 bit floating-point number
        found as a boolean
        # The snap kinds turned off (`snapRefused` of the editor).
        refused as an integer

# Offers `point` as a snap of kind `label`: the nearest candidate within
# `tolerance` wins; within a tenth of the tolerance the lower rank wins.
# The bit of the snap kind ranked `rank` in an editor's `snapRefused`.
function the bim snap bit of {integer:rank}:
    execute:
        set mask to 1
        loop shiftCursor from 0 to rank:
            set mask to mask * 2
        return mask

function offer bim snap {cad vector2:point} labelled {a string:label} ranked {integer:rank} near {cad vector2:location} within {a 64 bit floating-point number:tolerance} to {a pointer to a bim snap candidate record:best}:
    execute:
        if (best's refused bitwise and (the bim snap bit of rank)) != 0:
            return nothing
        set gap to the cad distance from location to point
        if gap > tolerance:
            return nothing
        set tie to 0.1 * tolerance
        set better to (best's found = false) or (gap < (best's gap - tie))
        if (better = false) and ((the absolute value of (gap - best's gap)) <= tie):
            set better to rank < best's rank
        if better:
            set best's point to point
            set best's label to label
            set best's rank to rank
            set best's gap to gap
            set best's found to true

# The straight pieces near `location` that can be snapped to, as pairs of
# points: wall centrelines (straight walls), sketch lines and face edges of
# the active storey, and grid lines.
function the bim snap segments near {cad vector2:location} within {a 64 bit floating-point number:tolerance} for {bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        set result to an empty list of a cad vector2
        set candidates to the bim walls within tolerance of location for editor
        loop cursor from 0 to the length of candidates:
            set wallFound to the bim wall index of (the item at cursor in candidates) in modelValue
            if wallFound's valid:
                set wallValue to the item at wallFound's position in (modelValue's walls's values)
                if (wallValue's bulge = 0.0) and ((bim editor hides (wallValue's id) in plan of editor) = false):
                    append wallValue's start to result
                    append wallValue's finish to result
        free candidates
        loop cursor from 0 to the length of (modelValue's sketches's values):
            set element to the item at cursor in (modelValue's sketches's values)
            if ((element's levelId = editor's levelId) and (element's kind != bim text sketch)) and ((bim editor hides (element's id) in plan of editor) = false):
                set ring to element's points's values
                set count to the length of ring
                set edgeCount to count
                if element's kind = bim line sketch:
                    set edgeCount to 1
                loop corner from 0 to edgeCount:
                    set here to the item at corner in ring
                    set following to the item at (the remainder of (corner + 1) divided by count) in ring
                    if (the cad distance from location to the segment from here to following) <= tolerance:
                        append here to result
                        append following to result
        # Component reference lines participate in the same object snaps.
        # Query in local coordinates first; only nearby segments are
        # transformed, without expanding every component on every motion.
        if bim category bim line category is visible in editor's planRules:
            loop instanceCursor from 0 to the length of (modelValue's instances's values):
                set placement to the item at instanceCursor in (modelValue's instances's values)
                set inView to (placement's viewId = the bim refused id) or (placement's viewId = editor's planViewId)
                if (placement's levelId = editor's levelId) and inView:
                    set found to the bim component index of placement's componentId in modelValue
                    if found's valid:
                        set definition to the item at found's position in (modelValue's components's values)
                        set query to the bim component coordinates of location at placement's origin turned placement's angle
                        loop partCursor from 0 to the length of (definition's sketches's values):
                            set part to the item at partCursor in (definition's sketches's values)
                            if (part's kind = bim line sketch) and ((the length of (part's points's values)) >= 2):
                                set first to the item at 0 in (part's points's values)
                                set last to the item at 1 in (part's points's values)
                                if (the cad distance from query to the segment from first to last) <= tolerance:
                                    append (the bim plan point of first at placement's origin turned placement's angle) to result
                                    append (the bim plan point of last at placement's origin turned placement's angle) to result
        loop cursor from 0 to the length of (modelValue's grids's values):
            set gridValue to the item at cursor in (modelValue's grids's values)
            set gridHidden to bim editor hides (gridValue's id) in plan of editor
            if ((the cad distance from location to the segment from gridValue's start to gridValue's finish) <= tolerance) and (gridHidden = false):
                append gridValue's start to result
                append gridValue's finish to result
        return result

# The point drawing tracks from: the last point of the chain, rectangle,
# grid, section line or move under way; `found` is false when there is none.
function the bim tracking origin of {bim editor record:editor}:
    execute:
        set none to @intrinsic("construct", a bim snap candidate record, editor's pointerLocation, the string form of "", 0, 0.0, false, 0)
        if (editor's tool = bim wall tool) and editor's chainActive:
            return @intrinsic("construct", a bim snap candidate record, editor's chainStart, the string form of "", 0, 0.0, true, 0)
        set chain to editor's sketchChain's values
        if (((editor's tool = bim line tool) or (editor's tool = bim rectangle tool)) or (editor's tool = bim split tool)) and ((the length of chain) > 0):
            return @intrinsic("construct", a bim snap candidate record, the item at ((the length of chain) - 1) in chain, the string form of "", 0, 0.0, true, 0)
        if (editor's tool = bim grid tool) and editor's gridActive:
            return @intrinsic("construct", a bim snap candidate record, editor's gridStart, the string form of "", 0, 0.0, true, 0)
        if (editor's tool = bim section tool) and editor's sectionActive:
            return @intrinsic("construct", a bim snap candidate record, editor's sectionStart, the string form of "", 0, 0.0, true, 0)
        # A drag tracks from where it began: horizontal, vertical and polar.
        if editor's dragging:
            return @intrinsic("construct", a bim snap candidate record, editor's dragOrigin, the string form of "", 0, 0.0, true, 0)
        set moving to ((editor's tool = bim move tool) or (editor's tool = bim copy tool)) or ((editor's tool = bim rotate tool) or (editor's tool = bim mirror tool))
        if moving and (editor's moveStage >= 2):
            return @intrinsic("construct", a bim snap candidate record, editor's moveBase, the string form of "", 0, 0.0, true, 0)
        return none

# The snapped point of `location`, as in Open 2D Studio: object snaps (end
# point, mid point, intersection, perpendicular from the tracking origin),
# then nearest on an edge, then tracking from the origin (horizontal and
# vertical, polar rays every 45 degrees, or ortho), then the grid. F3 turns
# snapping off.
function the bim snap of {cad vector2:location} in {bim editor record:editor} within {a 64 bit floating-point number:tolerance}:
    execute:
        if editor's snapOff:
            return the bim snap location labelled "Free"
        set modelValue to editor's documentValue's current
        set bestValue to @intrinsic("construct", a bim snap candidate record, location, the string form of "", 99, 0.0, false, editor's snapRefused)
        set best to the address of bestValue
        # Wall ends and middles, through the evaluation's spatial index.
        set candidates to the bim walls within tolerance of location for editor
        loop cursor from 0 to the length of candidates:
            set wallFound to the bim wall index of (the item at cursor in candidates) in modelValue
            if wallFound's valid and ((bim editor hides ((the item at cursor in candidates)) in plan of editor) = false):
                set wallValue to the item at wallFound's position in (modelValue's walls's values)
                offer bim snap wallValue's start labelled (the string form of "End point") ranked 0 near location within tolerance to best
                offer bim snap wallValue's finish labelled (the string form of "End point") ranked 0 near location within tolerance to best
                offer bim snap (the bim middle of wall wallValue) labelled (the string form of "Mid point") ranked 1 near location within tolerance to best
                # The corners of its faces, so a move goes from or to a
                # wall's corner; not while the wall itself is dragged.
                set footprint to the bim footprint of wallValue in modelValue using editor's evaluation's index
                set ownDrag to false
                if editor's dragging:
                    loop endCursor from 0 to the length of (editor's dragEnds's values):
                        if (the item at endCursor in (editor's dragEnds's values))'s wallId = wallValue's id:
                            set ownDrag to true
                if footprint's valid and (ownDrag = false):
                    offer bim snap footprint's startExterior labelled (the string form of "End point") ranked 0 near location within tolerance to best
                    offer bim snap footprint's finishExterior labelled (the string form of "End point") ranked 0 near location within tolerance to best
                    offer bim snap footprint's startInterior labelled (the string form of "End point") ranked 0 near location within tolerance to best
                    offer bim snap footprint's finishInterior labelled (the string form of "End point") ranked 0 near location within tolerance to best
        free candidates
        # The corners of the active storey's slabs, but not of a slab whose
        # corner or edge is being dragged.
        loop slabCursor from 0 to the length of (modelValue's slabs's values):
            set slabValue to the item at slabCursor in (modelValue's slabs's values)
            if ((slabValue's levelId = editor's levelId) and ((editor's dragging and (editor's slabCorner != -1)) = false)) and ((bim editor hides (slabValue's id) in plan of editor) = false):
                loop slabPoint from 0 to the length of (slabValue's outline's values):
                    offer bim snap (the item at slabPoint in (slabValue's outline's values)) labelled (the string form of "End point") ranked 0 near location within tolerance to best
        set segments to the bim snap segments near location within tolerance for editor
        set tracker to the bim tracking origin of editor
        set cursor to 0
        loop while (cursor + 1) < the length of segments:
            set first to the item at cursor in segments
            set second to the item at (cursor + 1) in segments
            offer bim snap first labelled (the string form of "End point") ranked 0 near location within tolerance to best
            offer bim snap second labelled (the string form of "End point") ranked 0 near location within tolerance to best
            offer bim snap (a cad vector2 with x ((first's x + second's x) * 0.5) and y ((first's y + second's y) * 0.5)) labelled (the string form of "Mid point") ranked 1 near location within tolerance to best
            # Crossings with the other pieces.
            set other to cursor + 2
            loop while (other + 1) < the length of segments:
                set third to the item at other in segments
                set fourth to the item at (other + 1) in segments
                set ax to second's x - first's x
                set ay to second's y - first's y
                set cx to fourth's x - third's x
                set cy to fourth's y - third's y
                set denominator to (ax * cy) - (ay * cx)
                if (the absolute value of denominator) > 1e-12:
                    set t to (((third's x - first's x) * cy) - ((third's y - first's y) * cx)) / denominator
                    set u to (((third's x - first's x) * ay) - ((third's y - first's y) * ax)) / denominator
                    if ((t >= -1e-9) and (t <= 1.000000001)) and ((u >= -1e-9) and (u <= 1.000000001)):
                        offer bim snap (a cad vector2 with x (first's x + (t * ax)) and y (first's y + (t * ay))) labelled (the string form of "Intersection") ranked 2 near location within tolerance to best
                set other to other + 2
            # The foot of the perpendicular from the tracking origin.
            if tracker's found:
                set run to ((second's x - first's x) * (second's x - first's x)) + ((second's y - first's y) * (second's y - first's y))
                if run > 1e-18:
                    set t to (((tracker's point's x - first's x) * (second's x - first's x)) + ((tracker's point's y - first's y) * (second's y - first's y))) / run
                    if (t > 0.0) and (t < 1.0):
                        offer bim snap (a cad vector2 with x (first's x + (t * (second's x - first's x))) and y (first's y + (t * (second's y - first's y)))) labelled (the string form of "Perpendicular") ranked 3 near location within tolerance to best
            set cursor to cursor + 2
        if bestValue's found:
            free segments
            return the bim snap bestValue's point labelled bestValue's label
        # Nearest and extension only help an operation under way: a drawing
        # or editing tool, or a selection to drag; hovering with nothing
        # selected snaps to points and the grid alone.
        set underWay to ((editor's tool != bim select tool) or (editor's selectionKind != bim nothing picked)) or editor's dragging
        if underWay = false:
            free segments
            if (editor's snapRefused bitwise and (the bim snap bit of 5)) != 0:
                return the bim snap location labelled "Free"
            return the bim snap (the bim grid point near location step 0.05) labelled "Grid"
        # Nearest on an edge.
        set cursor to 0
        loop while (cursor + 1) < the length of segments:
            set first to the item at cursor in segments
            set second to the item at (cursor + 1) in segments
            set run to ((second's x - first's x) * (second's x - first's x)) + ((second's y - first's y) * (second's y - first's y))
            if run > 1e-18:
                set t to (((location's x - first's x) * (second's x - first's x)) + ((location's y - first's y) * (second's y - first's y))) / run
                set t to the maximum of 0.0 and (the minimum of 1.0 and t)
                offer bim snap (a cad vector2 with x (first's x + (t * (second's x - first's x))) and y (first's y + (t * (second's y - first's y)))) labelled (the string form of "Nearest") ranked 4 near location within tolerance to best
            set cursor to cursor + 2
        free segments
        if bestValue's found:
            return the bim snap bestValue's point labelled bestValue's label
        # Extension, as in CAD: on the line of a straight piece within reach,
        # past one of its ends; and parallel: from the tracking origin along
        # the direction of a piece within reach. Ortho keeps to its two
        # directions, so it takes neither.
        set reachable to an empty list of a cad vector2
        if editor's orthoOn = false:
            free reachable
            set reachable to the bim snap segments near location within (tolerance * 25.0) for editor
        set extensionFound to false
        set extensionGap to tolerance
        set extensionPoint to location
        set extensionFrom to location
        set parallelFound to false
        set parallelGap to tolerance
        set parallelPoint to location
        set cursor to 0
        loop while (cursor + 1) < the length of reachable:
            set first to the item at cursor in reachable
            set second to the item at (cursor + 1) in reachable
            set run to the cad distance from first to second
            if run > 1e-9:
                set ux to (second's x - first's x) / run
                set uy to (second's y - first's y) / run
                # Past the second end, then past the first.
                loop side from 0 to 2:
                    set endPoint to second
                    set sign to 1.0
                    if side = 1:
                        set endPoint to first
                        set sign to -1.0
                    set along to (((location's x - endPoint's x) * ux) + ((location's y - endPoint's y) * uy)) * sign
                    set across to the absolute value of (((location's x - endPoint's x) * uy) - ((location's y - endPoint's y) * ux))
                    if (along > tolerance) and (across < extensionGap):
                        set rounded to the bim tracked length along
                        set extensionFound to true
                        set extensionGap to across
                        set extensionPoint to a cad vector2 with x (endPoint's x + ((rounded * sign) * ux)) and y (endPoint's y + ((rounded * sign) * uy))
                        set extensionFrom to endPoint
                if tracker's found and ((bim direction (a cad vector2 with x ux and y uy) is polar) = false):
                    set dx to location's x - tracker's point's x
                    set dy to location's y - tracker's point's y
                    set along to (dx * ux) + (dy * uy)
                    set across to the absolute value of ((dx * uy) - (dy * ux))
                    if ((the absolute value of along) > (tolerance * 2.0)) and (across < parallelGap):
                        set rounded to the bim tracked length along
                        set parallelFound to true
                        set parallelGap to across
                        set parallelPoint to a cad vector2 with x (tracker's point's x + (rounded * ux)) and y (tracker's point's y + (rounded * uy))
            set cursor to cursor + 2
        free reachable
        if extensionFound:
            return the bim snap extensionPoint labelled (the string form of "Extension") from extensionFrom
        if parallelFound:
            return the bim snap parallelPoint labelled (the string form of "Parallel") from tracker's point
        # Tracking from the origin: ortho, or the 45 degree polar rays.
        if tracker's found:
            set dx to location's x - tracker's point's x
            set dy to location's y - tracker's point's y
            set reach to the square root of ((dx * dx) + (dy * dy))
            if editor's orthoOn and (reach > 1e-9):
                set gridded to the bim grid point near location step 0.05
                if (the absolute value of dx) >= (the absolute value of dy):
                    return the bim snap (a cad vector2 with x gridded's x and y tracker's point's y) labelled "Horizontal"
                return the bim snap (a cad vector2 with x tracker's point's x and y gridded's y) labelled "Vertical"
            if reach > 1e-9:
                set angle to @intrinsic("atan2", dy, dx)
                set step to 3.141592653589793 / 4.0
                set ray to (the floor of ((angle / step) + 0.5)) * step
                set ux to the cosine of ray
                set uy to the sine of ray
                set along to (dx * ux) + (dy * uy)
                set across to the absolute value of ((dx * uy) - (dy * ux))
                if (across <= tolerance) and (along > 0.0):
                    # Lengths along a ray are rounded to 5 cm, as the grid.
                    set rounded to (the floor of ((along / 0.05) + 0.5)) * 0.05
                    set onRay to a cad vector2 with x (tracker's point's x + (rounded * ux)) and y (tracker's point's y + (rounded * uy))
                    if (the absolute value of uy) < 1e-9:
                        return the bim snap (a cad vector2 with x onRay's x and y tracker's point's y) labelled "Horizontal"
                    if (the absolute value of ux) < 1e-9:
                        return the bim snap (a cad vector2 with x tracker's point's x and y onRay's y) labelled "Vertical"
                    if editor's polarOn:
                        return the bim snap onRay labelled "Polar 45"
        if (editor's snapRefused bitwise and (the bim snap bit of 5)) != 0:
            return the bim snap location labelled "Free"
        return the bim snap (the bim grid point near location step 0.05) labelled "Grid"

# The ids of the walls of the active storey that can pass within `tolerance`
# of `location`: through the evaluation's spatial index, or, while the model
# has changed since it was evaluated, all of the storey's walls.
function the bim walls within {a 64 bit floating-point number:tolerance} of {cad vector2:location} for {bim editor record:editor}:
    execute:
        if editor's evaluatedRevision = editor's documentValue's revision:
            return the bim walls within tolerance of location on level editor's levelId in editor's evaluation's index
        set found to an empty list of a 64 bit integer
        loop cursor from 0 to the length of (editor's documentValue's current's walls's values):
            set wallValue to the item at cursor in (editor's documentValue's current's walls's values)
            if wallValue's levelId = editor's levelId:
                append wallValue's id to found
        return found

# The nearest wall of the active storey whose centreline passes within
# `tolerance` of `location`; none while walls are hidden in the plan.
function the bim wall near {cad vector2:location} in {bim editor record:editor} within {a 64 bit floating-point number:tolerance}:
    execute:
        set best to the bim refused id
        if (bim category bim wall category is visible in editor's planRules) = false:
            return best
        set modelValue to editor's documentValue's current
        set candidates to the bim walls within tolerance of location for editor
        set bestDistance to tolerance
        loop cursor from 0 to the length of candidates:
            set wallFound to the bim wall index of (the item at cursor in candidates) in modelValue
            if wallFound's valid:
                set wallValue to the item at wallFound's position in (modelValue's walls's values)
                set gap to the bim distance from location to the centreline of wallValue
                if ((gap <= bestDistance) and (wallValue's levelId = editor's levelId)) and ((bim editor hides (wallValue's id) in plan of editor) = false):
                    set bestDistance to gap
                    set best to wallValue's id
        free candidates
        return best

# ---------------------------------------------------------------- evaluation

# Re-evaluates when the model changed since the last evaluation, or while a
# drag is open; only the affected walls are rebuilt. The plan, cut 1.2 m above
# the level, and the section follow the evaluation per rebuilt wall; spaces are
# derived again. Views whose definition changed are cut again in full.
function refresh bim editor {a pointer to a bim editor record:editor}:
    execute:
        set revision to editor's documentValue's revision
        set modelChanged to ((revision != editor's evaluatedRevision) or editor's dragging) or (editor's dragging != editor's evaluatedDrag)
        if (modelChanged = false) and (editor's viewsDirty = false):
            return nothing
        set started to the bim microseconds now
        set rebuiltNow to 0
        set alreadySpent to 0 as a 64 bit integer
        if modelChanged:
            if editor's adopted:
                set alreadySpent to editor's adoptedMicroseconds
            else:
                update bim evaluation (the address of (editor's evaluation)) to editor's documentValue's current
            set rebuiltNow to editor's evaluation's rebuilt
        set editor's adopted to false
        # Undoing the creation of the active storey leaves the first storey
        # active.
        set levelFound to the bim level index of editor's levelId in editor's documentValue's current
        if (levelFound's valid = false) and ((the length of (editor's documentValue's current's levels's values)) > 0):
            set editor's levelId to (the item at 0 in (editor's documentValue's current's levels's values))'s id
            set levelFound to the bim level index of editor's levelId in editor's documentValue's current
        set elevation to 0.0
        if levelFound's valid:
            set elevation to (the item at levelFound's position in (editor's documentValue's current's levels's values))'s elevation
        set planPlane to the bim plan plane at elevation cut at (the bim plan cut height of (@intrinsic("dereference", editor)))
        if bim planes editor's plan's viewPlane and planPlane are identical:
            if modelChanged:
                update bim view (the address of (editor's plan)) from editor's evaluation
        else:
            set editor's plan to the bim view of editor's evaluation cut by planPlane
        if editor's hasSection:
            set sectionPlane to the bim section plane from editor's sectionFirst to editor's sectionSecond
            if bim planes editor's section's viewPlane and sectionPlane are identical:
                if modelChanged:
                    update bim view (the address of (editor's section)) from editor's evaluation
            else:
                set editor's section to the bim view of editor's evaluation cut by sectionPlane
        set wantedSpacesKey to the bim spaces key of (@intrinsic("dereference", editor))
        if wantedSpacesKey != editor's spacesKey:
            set editor's spaces to the bim spaces of editor's documentValue's current on level editor's levelId using editor's evaluation's index
            set editor's spacesKey to wantedSpacesKey
        set editor's lastRebuilt to rebuiltNow
        set editor's lastMicroseconds to ((the bim microseconds now) - started) + alreadySpent
        set editor's evaluatedRevision to revision
        set editor's evaluatedDrag to editor's dragging
        set editor's viewsDirty to false

# A number standing for what the spaces of the active storey depend on: the
# storey, its walls (ends, curvature, height, type) and the thicknesses of
# the wall types. Equal numbers leave the spaces as they were.
function the bim spaces key of {bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        set signature to (editor's levelId as a 64 bit floating-point number) * 0.001
        set count to 0
        loop cursor from 0 to the length of (modelValue's walls's values):
            set wallValue to the item at cursor in (modelValue's walls's values)
            if wallValue's levelId = editor's levelId:
                set count to count + 1
                set signature to signature + (((wallValue's start's x * 1.31) + (wallValue's start's y * 1.73)) + ((wallValue's finish's x * 2.37) + (wallValue's finish's y * 2.91)))
                set signature to signature + ((((wallValue's typeId as a 64 bit floating-point number) * 0.0037) + (wallValue's bulge * 3.11)) + ((wallValue's height * 0.113) + (wallValue's baseOffset * 0.157)))
        loop cursor from 0 to the length of (modelValue's wallTypes's values):
            set wallType to the item at cursor in (modelValue's wallTypes's values)
            loop layerCursor from 0 to the length of (wallType's layers's values):
                set signature to signature + ((the item at layerCursor in (wallType's layers's values))'s thickness * (((cursor + 1) as a 64 bit floating-point number) * 0.71))
        return signature + ((count as a 64 bit floating-point number) * 1000.0)

function the bim failure count of {bim evaluation record:evaluation}:
    execute:
        set failures to 0
        loop cursor from 0 to the length of (evaluation's elements's values):
            if (the item at cursor in (evaluation's elements's values))'s status != 0:
                set failures to failures + 1
        return failures

# Ends the open transaction: commits it with `description` as the message, or
# rolls it back when it would leave more walls failing to evaluate than
# before (an opening that no longer fits its wall), reporting `refusal`.
function settle bim editor change in {a pointer to a bim editor record:editor} described {a string:description} or refused as {a string:refusal}:
    execute:
        set trialStarted to the bim microseconds now
        set trial to the bim evaluation of editor's documentValue's current after editor's evaluation
        set trialSpent to (the bim microseconds now) - trialStarted
        if (the bim failure count of trial) > (the bim failure count of editor's evaluation):
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to (the string form of "Refused: ") + refusal
            return false
        commit bim transaction in (the address of (editor's documentValue))
        # The trial already evaluates the committed model; refresh adopts it.
        set editor's evaluation to trial
        set editor's adopted to true
        set editor's adoptedMicroseconds to trialSpent
        set editor's message to description
        return true

function the bim metres of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.2f", value)
        return the substring of buffer from 0 spanning written bytes

# Changes the current opening type; every opening of that type follows.
function resize bim editor opening type by {a 64 bit floating-point number:widthChange} and {a 64 bit floating-point number:heightChange} in {a pointer to a bim editor record:editor}:
    execute:
        refresh bim editor editor
        set found to the bim opening type index of editor's openingTypeId in editor's documentValue's current
        if found's valid = false:
            return nothing
        set openingType to the item at found's position in (editor's documentValue's current's openingTypes's values)
        set newWidth to openingType's width + widthChange
        set newHeight to openingType's height + heightChange
        if (newWidth < 0.3) or (newHeight < 0.3):
            set editor's message to the string form of "Refused: a window stays at least 0.30 m wide and high"
            return nothing
        begin bim transaction in (the address of (editor's documentValue))
        if (set bim opening type editor's openingTypeId sized newWidth by newHeight with sill openingType's sill in (the address of (editor's documentValue's current))) = false:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Refused: invalid window size"
            return nothing
        set description to ((openingType's name + (the string form of ": ")) + (the bim metres of newWidth)) + (the string form of " x ")
        ignore settle bim editor change in editor described ((description + (the bim metres of newHeight)) + (the string form of " m")) or refused as (the string form of "a window would not fit its wall")

function the bim example point {a 64 bit floating-point number:x} {a 64 bit floating-point number:y} from {cad vector2:base}:
    execute:
        return a cad vector2 with x (x + base's x) and y (y + base's y)

# A 10 m x 7 m house with a partition across it, a wall from the partition to
# the east facade, seven windows, three doors and a ground slab, and a first
# floor above it and six grids, added as one undoable transaction, with its
# plan coordinates moved by `base`.
function add bim example building to {a pointer to a bim editor record:editor} at {cad vector2:base}:
    execute:
        set target to the address of (editor's documentValue's current)
        begin bim transaction in (the address of (editor's documentValue))
        set wallTypeId to editor's wallTypeId
        set levelId to editor's levelId
        set south to add bim wall typed wallTypeId on levelId from (the bim example point -2.0 -1.5 from base) to (the bim example point 8.0 -1.5 from base) to target
        set east to add bim wall typed wallTypeId on levelId from (the bim example point 8.0 -1.5 from base) to (the bim example point 8.0 5.5 from base) to target
        set north to add bim wall typed wallTypeId on levelId from (the bim example point 8.0 5.5 from base) to (the bim example point -2.0 5.5 from base) to target
        set west to add bim wall typed wallTypeId on levelId from (the bim example point -2.0 5.5 from base) to (the bim example point -2.0 -1.5 from base) to target
        set across to add bim wall typed wallTypeId on levelId from (the bim example point 3.0 -1.5 from base) to (the bim example point 3.0 5.5 from base) to target
        set between to add bim wall typed wallTypeId on levelId from (the bim example point 3.0 2.0 from base) to (the bim example point 8.0 2.0 from base) to target
        ignore add bim opening typed editor's windowTypeId in south at 2.5 to target
        ignore add bim opening typed editor's windowTypeId in south at 7.5 to target
        ignore add bim opening typed editor's windowTypeId in east at 1.75 to target
        ignore add bim opening typed editor's windowTypeId in east at 5.25 to target
        ignore add bim opening typed editor's windowTypeId in north at 2.5 to target
        ignore add bim opening typed editor's windowTypeId in north at 8.0 to target
        ignore add bim opening typed editor's windowTypeId in west at 4.5 to target
        # A front door, and a door into each of the two east rooms.
        ignore add bim opening typed editor's doorTypeId in south at 6.0 to target
        ignore add bim opening typed editor's doorTypeId in across at 2.0 to target
        ignore add bim opening typed editor's doorTypeId in between at 1.5 to target
        # A ground slab under the whole house, flush with the exterior faces.
        set reach to (the bim thickness of (the item at (the bim wall type index of wallTypeId in (@intrinsic("dereference", target)))'s position in (target's wallTypes's values))) * 0.5
        set groundOutline to an empty list of a cad vector2
        append (the bim example point (-2.0 - reach) (-1.5 - reach) from base) to groundOutline
        append (the bim example point (8.0 + reach) (-1.5 - reach) from base) to groundOutline
        append (the bim example point (8.0 + reach) (5.5 + reach) from base) to groundOutline
        append (the bim example point (-2.0 - reach) (5.5 + reach) from base) to groundOutline
        ignore add bim slab on levelId around groundOutline thick the bim slab thickness to target
        free groundOutline
        # A first floor on the ground floor: the same facades with six windows
        # and the partition, without a floor slab, so the 3D view looks into
        # the rooms below.
        set ground to the item at (the bim level index of levelId in (@intrinsic("dereference", target)))'s position in (target's levels's values)
        set upper to add bim level named (the string form of "First floor") at (ground's elevation + ground's height) with height ground's height to target
        set upperSouth to add bim wall typed wallTypeId on upper from (the bim example point -2.0 -1.5 from base) to (the bim example point 8.0 -1.5 from base) to target
        set upperEast to add bim wall typed wallTypeId on upper from (the bim example point 8.0 -1.5 from base) to (the bim example point 8.0 5.5 from base) to target
        set upperNorth to add bim wall typed wallTypeId on upper from (the bim example point 8.0 5.5 from base) to (the bim example point -2.0 5.5 from base) to target
        set upperWest to add bim wall typed wallTypeId on upper from (the bim example point -2.0 5.5 from base) to (the bim example point -2.0 -1.5 from base) to target
        ignore add bim wall typed wallTypeId on upper from (the bim example point 3.0 -1.5 from base) to (the bim example point 3.0 5.5 from base) to target
        ignore add bim opening typed editor's windowTypeId in upperSouth at 2.5 to target
        ignore add bim opening typed editor's windowTypeId in upperSouth at 7.5 to target
        ignore add bim opening typed editor's windowTypeId in upperEast at 3.5 to target
        ignore add bim opening typed editor's windowTypeId in upperNorth at 2.5 to target
        ignore add bim opening typed editor's windowTypeId in upperNorth at 8.0 to target
        ignore add bim opening typed editor's windowTypeId in upperWest at 3.5 to target
        # Grids on the facades and the partition: 1 to 3 across, A to C along.
        set reachValue to the bim grid reach of (@intrinsic("dereference", target))
        ignore add bim grid named (the string form of "1") from (the bim example point -2.0 -3.0 from base) to (the bim example point -2.0 7.0 from base) reaching reachValue's x to reachValue's y to target
        ignore add bim grid named (the string form of "2") from (the bim example point 3.0 -3.0 from base) to (the bim example point 3.0 7.0 from base) reaching reachValue's x to reachValue's y to target
        ignore add bim grid named (the string form of "3") from (the bim example point 8.0 -3.0 from base) to (the bim example point 8.0 7.0 from base) reaching reachValue's x to reachValue's y to target
        ignore add bim grid named (the string form of "A") from (the bim example point -3.5 -1.5 from base) to (the bim example point 9.5 -1.5 from base) reaching reachValue's x to reachValue's y to target
        ignore add bim grid named (the string form of "B") from (the bim example point -3.5 2.0 from base) to (the bim example point 9.5 2.0 from base) reaching reachValue's x to reachValue's y to target
        ignore add bim grid named (the string form of "C") from (the bim example point -3.5 5.5 from base) to (the bim example point 9.5 5.5 from base) reaching reachValue's x to reachValue's y to target
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to the string form of "Example building"

function add bim example building to {a pointer to a bim editor record:editor}:
    execute:
        add bim example building to editor at (a cad vector2 with x 0.0 and y 0.0)

# The example building's foundation and structural drawings: a precast
# pile under every grid crossing (12 m down from the ground floor), and a
# structural plan and a pile plan of the ground floor, each following its
# drawing type; one undoable step. The plan shown stays as it was.
function add bim example structure to {a pointer to a bim editor record:editor} at {cad vector2:base}:
    execute:
        ensure bim pile types in editor
        set target to the address of (editor's documentValue's current)
        set pileTypeId to the bim refused id
        loop cursor from 0 to the length of (target's linearTypes's values):
            set candidate to the item at cursor in (target's linearTypes's values)
            if (candidate's role = bim pile role) and (pileTypeId = the bim refused id):
                set pileTypeId to candidate's id
        begin bim transaction in (the address of (editor's documentValue))
        if pileTypeId != the bim refused id:
            loop column from 0 to 3:
                loop row from 0 to 3:
                    set gridX to -2.0 + (5.0 * (column as a 64 bit floating-point number))
                    set gridY to -1.5 + (3.5 * (row as a 64 bit floating-point number))
                    set pileTop to the bim example point gridX gridY from base
                    ignore add bim linear typed pileTypeId on editor's levelId from (a cad vector3 with x pileTop's x, y pileTop's y and z 0.0) to (a cad vector3 with x pileTop's x, y pileTop's y and z (0.0 - (bim pile length))) turned 0.0 to target
        ensure bim drawing types in target
        set storeyName to the bim storey name of (@intrinsic("dereference", editor))
        set structuralType to the bim drawing type named (the string form of "Structural plan") in (@intrinsic("dereference", target))
        if structuralType != the bim refused id:
            ignore add bim plan view following drawing type structuralType named ((the string form of "Structural plan - ") + storeyName) on editor's levelId to target
        set pileType to the bim drawing type named (the string form of "Pile plan") in (@intrinsic("dereference", target))
        if pileType != the bim refused id:
            ignore add bim plan view following drawing type pileType named ((the string form of "Pile plan - ") + storeyName) on editor's levelId to target
        commit bim transaction in (the address of (editor's documentValue))

# An imaginary tower of at least `wallCount` walls, for testing at scale. Each
# storey is a grid of `roomCount` x `roomCount` rooms of 4 m x 4 m: cavity walls on the
# facade with a window in each, sand-lime partitions inside (one wall per room
# side), and a floor slab under the storey, flush with the facade. Storeys of
# 3 m are added until the walls reach `wallCount`. Returns the storey count.
function add bim generated tower of {integer:wallCount} walls with {integer:roomCount} rooms a side to {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        begin bim transaction in (the address of (editor's documentValue))
        set partitionLayers to an empty list of a bim layer record
        append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.1)) to partitionLayers
        set partition to add bim wall type named (the string form of "Partition 100") with partitionLayers to target
        free partitionLayers
        set facade to editor's wallTypeId
        set reach to (the bim thickness of (the item at (the bim wall type index of facade in (@intrinsic("dereference", target)))'s position in (target's wallTypes's values))) * 0.5
        set perStorey to (2 * roomCount) * (roomCount + 1)
        set storeys to ((wallCount + perStorey) - 1) / perStorey
        set extent to 4.0 * (roomCount as a 64 bit floating-point number)
        set levelId to editor's levelId
        set placed to 0
        loop storey from 0 to storeys:
            if storey > 0:
                set levelId to add bim level named ((the string form of "Storey ") + (the string form of storey)) at (3.0 * (storey as a 64 bit floating-point number)) with height 3.0 to target
            loop row from 0 to roomCount + 1:
                set y to 4.0 * (row as a 64 bit floating-point number)
                set onFacade to (row = 0) or (row = roomCount)
                loop column from 0 to roomCount:
                    set x to 4.0 * (column as a 64 bit floating-point number)
                    set typeId to partition
                    if onFacade:
                        set typeId to facade
                    # Facade walls run so that their exterior faces out.
                    set fromPoint to a cad vector2 with x x and y y
                    set toPoint to a cad vector2 with x (x + 4.0) and y y
                    if row = roomCount:
                        set fromPoint to a cad vector2 with x (x + 4.0) and y y
                        set toPoint to a cad vector2 with x x and y y
                    set wallId to add bim wall typed typeId on levelId from fromPoint to toPoint to target
                    if onFacade:
                        ignore add bim opening typed editor's windowTypeId in wallId at 2.0 to target
                    set placed to placed + 1
            loop column from 0 to roomCount + 1:
                set x to 4.0 * (column as a 64 bit floating-point number)
                set onFacade to (column = 0) or (column = roomCount)
                loop row from 0 to roomCount:
                    set y to 4.0 * (row as a 64 bit floating-point number)
                    set typeId to partition
                    if onFacade:
                        set typeId to facade
                    set fromPoint to a cad vector2 with x x and y (y + 4.0)
                    set toPoint to a cad vector2 with x x and y y
                    if column = roomCount:
                        set fromPoint to a cad vector2 with x x and y y
                        set toPoint to a cad vector2 with x x and y (y + 4.0)
                    set wallId to add bim wall typed typeId on levelId from fromPoint to toPoint to target
                    if onFacade:
                        ignore add bim opening typed editor's windowTypeId in wallId at 2.0 to target
                    set placed to placed + 1
            set outline to an empty list of a cad vector2
            append (a cad vector2 with x (0.0 - reach) and y (0.0 - reach)) to outline
            append (a cad vector2 with x (extent + reach) and y (0.0 - reach)) to outline
            append (a cad vector2 with x (extent + reach) and y (extent + reach)) to outline
            append (a cad vector2 with x (0.0 - reach) and y (extent + reach)) to outline
            ignore add bim slab on levelId around outline thick the bim slab thickness to target
            free outline
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to ((the string form of "Generated ") + (the string form of placed)) + ((the string form of " walls on ") + ((the string form of storeys) + (the string form of " storeys")))
        return storeys

# ---------------------------------------------------------------- selection

function select bim editor {integer:kindCode} numbered {a 64 bit integer:elementId} in {a pointer to a bim editor record:editor}:
    execute:
        set chosenKind to kindCode
        if (kindCode = bim sketch picked) and ((the bim instance index of elementId in editor's documentValue's current)'s valid):
            set chosenKind to bim instance picked
        # Shift adds sketch elements and instances to the selection; any
        # other pick starts it afresh.
        set gathering to (((chosenKind = bim sketch picked) or (chosenKind = bim instance picked)) or (chosenKind = bim mesh picked)) or (chosenKind = bim linear picked)
        if (editor's extending = false) or (gathering = false):
            set editor's chosenSketches to a cad topology list of a 64 bit integer
        if gathering:
            set already to false
            loop cursor from 0 to the length of (editor's chosenSketches's values):
                if (the item at cursor in (editor's chosenSketches's values)) = elementId:
                    set already to true
            if already = false:
                append elementId to (editor's chosenSketches's values)
        set editor's selectionKind to chosenKind
        set editor's selectionId to elementId
        set editor's partCode to -1
        set editor's message to the bim selection description of (@intrinsic("dereference", editor))

# The opening of the hovered wall, else the hovered wall, else a slab of the
# active storey with an edge near `location`, else the space under
# `location`; nothing when none. Hidden categories are passed over.
# ---------------------------------------------------------------- linear elements

function add bim library linear type {a string:typeName} as role {integer:roleCode} sized {a 64 bit floating-point number:widthValue} by {a 64 bit floating-point number:depthValue} round {boolean:isRound} of {a string:materialName} to {a pointer to a bim model record:target}:
    execute:
        ignore add bim linear type named typeName as role roleCode sized widthValue by depthValue round isRound of materialName to target

# The linear types every model starts with, added once (as one edit) when a
# model has none: columns, beams, a mullion, a skirting and a pipe.
function ensure bim linear types in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        if (the length of (target's linearTypes's values)) > 0:
            return nothing
        begin bim transaction in (the address of (editor's documentValue))
        add bim library linear type (the string form of "Kolom beton 300x300") as role bim column role sized 0.3 by 0.3 round false of (the string form of "concrete") to target
        add bim library linear type (the string form of "Kolom beton rond 300") as role bim column role sized 0.3 by 0.3 round true of (the string form of "concrete") to target
        add bim library linear type (the string form of "Kolom staal 200x200") as role bim column role sized 0.2 by 0.2 round false of (the string form of "steel") to target
        add bim library linear type (the string form of "Kolom hout 150x150") as role bim column role sized 0.15 by 0.15 round false of (the string form of "timber") to target
        add bim library linear type (the string form of "Balk beton 300x500") as role bim beam role sized 0.3 by 0.5 round false of (the string form of "concrete") to target
        add bim library linear type (the string form of "Balk staal 200x400") as role bim beam role sized 0.2 by 0.4 round false of (the string form of "steel") to target
        add bim library linear type (the string form of "Balk hout 75x225") as role bim beam role sized 0.075 by 0.225 round false of (the string form of "timber") to target
        add bim library linear type (the string form of "Stijl aluminium 50x100") as role bim mullion role sized 0.05 by 0.1 round false of (the string form of "steel") to target
        add bim library linear type (the string form of "Plint hout 12x70") as role bim skirting role sized 0.012 by 0.07 round false of (the string form of "timber") to target
        add bim library linear type (the string form of "Leiding 110") as role bim pipe role sized 0.11 by 0.11 round true of (the string form of "generic") to target
        commit bim transaction in (the address of (editor's documentValue))

# The linear tool for `roleCode`, drawing the current type when it has that
# role, else the first type that does.
function start bim editor linear tool for role {integer:roleCode} in {a pointer to a bim editor record:editor}:
    execute:
        ensure bim linear types in editor
        ensure bim services types in editor
        ensure bim pile types in editor
        set modelValue to editor's documentValue's current
        set editor's tool to bim linear tool
        set editor's linearRole to roleCode
        set editor's chainActive to false
        set editor's moveStage to 0
        set keep to false
        set found to the bim linear type index of editor's linearTypeId in modelValue
        if found's valid:
            set keep to (the item at found's position in (modelValue's linearTypes's values))'s role = roleCode
        if keep = false:
            set editor's linearTypeId to the bim refused id
            loop cursor from 0 to the length of (modelValue's linearTypes's values):
                set linearType to the item at cursor in (modelValue's linearTypes's values)
                if (linearType's role = roleCode) and (editor's linearTypeId = the bim refused id):
                    set editor's linearTypeId to linearType's id
        set placing to the string form of "click two points"
        if ((roleCode = bim column role) or (roleCode = bim mullion role)) or (roleCode = bim pile role):
            set placing to the string form of "click where it stands"
        set editor's message to ((the bim name of linear role roleCode) + (the string form of ": ")) + placing

# Linear type `typeId` drawn next, or given to the selected linear element.
function choose bim editor linear type {a 64 bit integer:typeId} in {a pointer to a bim editor record:editor}:
    execute:
        set found to the bim linear type index of typeId in editor's documentValue's current
        if found's valid = false:
            return nothing
        set linearType to the item at found's position in (editor's documentValue's current's linearTypes's values)
        if editor's selectionKind = bim linear picked:
            begin bim transaction in (the address of (editor's documentValue))
            if set bim linear editor's selectionId type to typeId in (the address of (editor's documentValue's current)):
                commit bim transaction in (the address of (editor's documentValue))
                set editor's message to (the string form of "Now ") + linearType's name
            else:
                roll back bim transaction in (the address of (editor's documentValue))
            return nothing
        set editor's linearTypeId to typeId
        set editor's linearRole to linearType's role
        set editor's message to (the string form of "Draws ") + linearType's name

# The height on its storey a linear element of `linearType` runs at: a beam
# and a pipe under the storey above, a skirting on the floor.
function the bim run height of {bim linear type record:linearType} under {a 64 bit floating-point number:storeyHeight}:
    execute:
        if linearType's role = bim skirting role:
            return linearType's depth * 0.5
        return storeyHeight - (linearType's depth * 0.5)

# The linear element the linear tool would place, as it would stand: its
# outline on the plan (a beam's, pipe's or skirting's from the first click to
# `finishPoint`, its type wide; a column's, mullion's or pile's footprint at
# `finishPoint`, round for a round type), first at its foot and then the same
# corners at its head, in height above the storey. Empty without a type or,
# for a beam, before its first click.
function the bim linear preview of {bim editor record:editor} to {cad vector2:finishPoint}:
    execute:
        set corners to a cad topology list of a cad vector3
        set modelValue to editor's documentValue's current
        set typeFound to the bim linear type index of editor's linearTypeId in modelValue
        set levelFound to the bim level index of editor's levelId in modelValue
        if (typeFound's valid = false) or (levelFound's valid = false):
            return corners
        set chosenType to the item at typeFound's position in (modelValue's linearTypes's values)
        set storeyHeight to (the item at levelFound's position in (modelValue's levels's values))'s height
        set halfWidth to chosenType's width * 0.5
        set halfDepth to chosenType's depth * 0.5
        set standing to ((chosenType's role = bim column role) or (chosenType's role = bim mullion role)) or (chosenType's role = bim pile role)
        set footprint to an empty list of a cad vector2
        set footLevel to 0.0
        set headLevel to storeyHeight
        if standing:
            if chosenType's round:
                loop sideCursor from 0 to 16:
                    set turn to ((sideCursor as a 64 bit floating-point number) * 6.283185307179586) / 16.0
                    append (a cad vector2 with x (finishPoint's x + (halfWidth * (the cosine of turn))) and y (finishPoint's y + (halfWidth * (the sine of turn)))) to footprint
            else:
                append (a cad vector2 with x (finishPoint's x - halfWidth) and y (finishPoint's y - halfDepth)) to footprint
                append (a cad vector2 with x (finishPoint's x + halfWidth) and y (finishPoint's y - halfDepth)) to footprint
                append (a cad vector2 with x (finishPoint's x + halfWidth) and y (finishPoint's y + halfDepth)) to footprint
                append (a cad vector2 with x (finishPoint's x - halfWidth) and y (finishPoint's y + halfDepth)) to footprint
            if chosenType's role = bim pile role:
                set footLevel to 0.0 - (bim pile length)
                set headLevel to 0.0
        else:
            set spanLength to the cad distance from editor's chainStart to finishPoint
            if editor's chainActive and (spanLength > 0.001):
                set acrossX to ((editor's chainStart's y - finishPoint's y) / spanLength) * halfWidth
                set acrossY to ((finishPoint's x - editor's chainStart's x) / spanLength) * halfWidth
                append (a cad vector2 with x (editor's chainStart's x + acrossX) and y (editor's chainStart's y + acrossY)) to footprint
                append (a cad vector2 with x (finishPoint's x + acrossX) and y (finishPoint's y + acrossY)) to footprint
                append (a cad vector2 with x (finishPoint's x - acrossX) and y (finishPoint's y - acrossY)) to footprint
                append (a cad vector2 with x (editor's chainStart's x - acrossX) and y (editor's chainStart's y - acrossY)) to footprint
            set runLevel to the bim run height of chosenType under storeyHeight
            set footLevel to runLevel - halfDepth
            set headLevel to runLevel + halfDepth
        loop footCursor from 0 to the length of footprint:
            set spot to the item at footCursor in footprint
            append (a cad vector3 with x spot's x, y spot's y and z footLevel) to (corners's values)
        loop headCursor from 0 to the length of footprint:
            set spot to the item at headCursor in footprint
            append (a cad vector3 with x spot's x, y spot's y and z headLevel) to (corners's values)
        free footprint
        return corners

# A click of the linear tool at `point`: a column or mullion stands there for
# the storey's height; a beam, skirting or pipe runs from the last click,
# chaining on as walls do.
function place bim editor linear at {cad vector2:point} in {a pointer to a bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        set typeFound to the bim linear type index of editor's linearTypeId in modelValue
        set levelFound to the bim level index of editor's levelId in modelValue
        if (typeFound's valid = false) or (levelFound's valid = false):
            set editor's message to the string form of "Choose a type in the type selector first"
            return nothing
        set linearType to the item at typeFound's position in (modelValue's linearTypes's values)
        set storeyHeight to (the item at levelFound's position in (modelValue's levels's values))'s height
        set standing to ((linearType's role = bim column role) or (linearType's role = bim mullion role)) or (linearType's role = bim pile role)
        if (standing = false) and (editor's chainActive = false):
            set editor's chainActive to true
            set editor's chainStart to point
            set editor's message to (linearType's name + (the string form of ": click the end"))
            return nothing
        set fromSpot to a cad vector3 with x point's x, y point's y and z 0.0
        set toSpot to a cad vector3 with x point's x, y point's y and z storeyHeight
        # A pile reaches down from its storey, its head at the storey's
        # level.
        if linearType's role = bim pile role:
            set toSpot to a cad vector3 with x point's x, y point's y and z (0.0 - (bim pile length))
        if standing = false:
            set runHeight to the bim run height of linearType under storeyHeight
            set fromSpot to a cad vector3 with x editor's chainStart's x, y editor's chainStart's y and z runHeight
            set toSpot to a cad vector3 with x point's x, y point's y and z runHeight
        begin bim transaction in (the address of (editor's documentValue))
        set fresh to add bim linear typed linearType's id on editor's levelId from fromSpot to toSpot turned 0.0 to (the address of (editor's documentValue's current))
        if fresh = the bim refused id:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Refused: the element needs a length"
            return nothing
        commit bim transaction in (the address of (editor's documentValue))
        set editor's chainStart to point
        set editor's message to ((linearType's name + (the string form of " ")) + (the string form of fresh)) + (the string form of "; click on, Esc ends")

# The linear element of the active storey at `location`: one whose outline
# seen from above holds it or passes within `tolerance`; the refused id when
# there is none.
function the bim linear at {cad vector2:location} in {bim editor record:editor} within {a 64 bit floating-point number:tolerance}:
    execute:
        set modelValue to editor's documentValue's current
        loop cursor from 0 to the length of (modelValue's linears's values):
            set linearValue to the item at cursor in (modelValue's linears's values)
            if (linearValue's levelId = editor's levelId) and ((bim editor hides (linearValue's id) in plan of editor) = false):
                set shown to true
                set linearCategory to the bim category of linear role (the bim type of linear linearValue in modelValue)'s role
                set shown to bim category linearCategory is visible in editor's planRules
                if shown:
                    set ringValue to the bim plan outline of linear linearValue in modelValue
                    set near to bim flat point location lies in ringValue
                    loop corner from 0 to the length of ringValue:
                        if (the cad distance from location to the segment from (the item at corner in ringValue) to (the item at (the remainder of (corner + 1) divided by (the length of ringValue)) in ringValue)) <= tolerance:
                            set near to true
                    free ringValue
                    if near:
                        return linearValue's id
        return the bim refused id

# ---------------------------------------------------------------- sketches

# The sketch element of the active storey at `location`: a text whose anchor
# is near, a line passing near, or a face containing it, in that order; the
# refused id when there is none or sketches are hidden.
function the bim sketch at {cad vector2:location} in {bim editor record:editor} within {a 64 bit floating-point number:tolerance}:
    execute:
        set drawn to the bim drawn sketches of editor's documentValue's current seen from view editor's planViewId
        set sketches to drawn's values
        loop cursor from 0 to the length of sketches:
            set entry to the item at cursor in sketches
            if ((entry's levelId = editor's levelId) and (entry's kind = bim text sketch)) and ((bim editor hides (entry's id) in plan of editor) = false):
                if (bim category bim text category is visible in editor's planRules) and ((the cad distance from location to (the item at 0 in (entry's points's values))) <= (tolerance * 2.0)):
                    return entry's id
        loop cursor from 0 to the length of sketches:
            set entry to the item at cursor in sketches
            if ((entry's levelId = editor's levelId) and (entry's kind = bim line sketch)) and ((bim editor hides (entry's id) in plan of editor) = false):
                set gap to the cad distance from location to the segment from (the item at 0 in (entry's points's values)) to (the item at 1 in (entry's points's values))
                if (gap <= tolerance) and (bim category bim line category is visible in editor's planRules):
                    return entry's id
        loop cursor from 0 to the length of sketches:
            set entry to the item at cursor in sketches
            if ((entry's levelId = editor's levelId) and (entry's kind = bim face sketch)) and ((bim editor hides (entry's id) in plan of editor) = false):
                if (bim category bim mass category is visible in editor's planRules) and (bim flat point location lies in (entry's points's values)):
                    return entry's id
        return the bim refused id

# The free mesh of the active storey at `location`: one with an edge passing
# near, seen from above, or a face turned up containing it; the refused id
# when there is none or masses are hidden.
function the bim mesh at {cad vector2:location} in {bim editor record:editor} within {a 64 bit floating-point number:tolerance}:
    execute:
        if (bim category bim mass category is visible in editor's planRules) = false:
            return the bim refused id
        set meshList to editor's documentValue's current's meshes's values
        loop cursor from 0 to the length of meshList:
            set meshValue to the item at cursor in meshList
            if (meshValue's levelId = editor's levelId) and ((bim editor hides (meshValue's id) in plan of editor) = false):
                set start to 0
                loop while start < the length of (meshValue's faces's values):
                    set faceRing to the bim plan outline of mesh face start of meshValue
                    loop corner from 0 to the length of faceRing:
                        if (the cad distance from location to the segment from (the item at corner in faceRing) to (the item at (the remainder of (corner + 1) divided by (the length of faceRing)) in faceRing)) <= tolerance:
                            free faceRing
                            return meshValue's id
                    free faceRing
                    set start to start + ((the item at start in (meshValue's faces's values)) + 1)
                if (the bim top face of mesh meshValue at location) >= 0:
                    return meshValue's id
        return the bim refused id

# The face of the active storey containing `location`, or the refused id.
function the bim face at {cad vector2:location} in {bim editor record:editor}:
    execute:
        set sketches to editor's documentValue's current's sketches's values
        loop cursor from 0 to the length of sketches:
            set sketch to the item at cursor in sketches
            if ((sketch's levelId = editor's levelId) and (sketch's kind = bim face sketch)) and (bim flat point location lies in (sketch's points's values)):
                return sketch's id
        return the bim refused id

# ---------------------------------------------------------------- views

# The level the storey rows show and edit: the level picked in a section,
# else the active storey.
function the bim edited level of {bim editor record:editor}:
    execute:
        if editor's selectionKind = bim level picked:
            return editor's selectionId
        return editor's levelId

# How high above the storey the plan cuts: the plan view's cut height, or
# 1.2 m without a view.
function the bim plan cut height of {bim editor record:editor}:
    execute:
        set found to the bim view index of editor's planViewId in editor's documentValue's current
        if found's valid:
            return (the item at found's position in (editor's documentValue's current's views's values))'s cutHeight
        return 1.2

# A click of the crop tool: the first corner, then the plan view shown is
# cropped to the rectangle.
function place bim editor crop at {cad vector2:point} in {a pointer to a bim editor record:editor}:
    execute:
        set found to the bim view index of editor's planViewId in editor's documentValue's current
        if found's valid = false:
            set editor's message to the string form of "Crop: no plan view"
            return nothing
        if editor's moveStage = 0:
            set editor's solidCorner to point
            set editor's moveStage to 1
            set editor's message to the string form of "Crop: click the opposite corner"
            return nothing
        set viewValue to the item at found's position in (editor's documentValue's current's views's values)
        set lowCorner to a cad vector2 with x (the minimum of point's x and editor's solidCorner's x) and y (the minimum of point's y and editor's solidCorner's y)
        set highCorner to a cad vector2 with x (the maximum of point's x and editor's solidCorner's x) and y (the maximum of point's y and editor's solidCorner's y)
        set editor's moveStage to 0
        if ((highCorner's x - lowCorner's x) < 0.01) or ((highCorner's y - lowCorner's y) < 0.01):
            return nothing
        set viewValue's cropped to true
        set viewValue's cropLow to lowCorner
        set viewValue's cropHigh to highCorner
        begin bim transaction in (the address of (editor's documentValue))
        store bim view viewValue in (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        set editor's tool to bim select tool
        set editor's message to (the string form of "Cropped ") + viewValue's name

# The plan view shown, uncropped (UC).
function uncrop bim editor plan view in {a pointer to a bim editor record:editor}:
    execute:
        set found to the bim view index of editor's planViewId in editor's documentValue's current
        if found's valid = false:
            return nothing
        set viewValue to the item at found's position in (editor's documentValue's current's views's values)
        set viewValue's cropped to false
        begin bim transaction in (the address of (editor's documentValue))
        store bim view viewValue in (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to (the string form of "Uncropped ") + viewValue's name

# The plan view the editor shows for storey `levelId`: the active one when it
# is of that storey, else the storey's first; the refused id when it has none.
function the bim plan view of storey {a 64 bit integer:levelId} for {bim editor record:editor}:
    execute:
        set viewList to editor's documentValue's current's views's values
        set chosen to the bim refused id
        loop cursor from 0 to the length of viewList:
            set viewValue to the item at cursor in viewList
            if (viewValue's kind = bim plan view) and (viewValue's levelId = levelId):
                if (chosen = the bim refused id) or (viewValue's id = editor's planViewId):
                    set chosen to viewValue's id
        return chosen

# The plan shows view `viewId`: its storey and its rules.
function show bim editor plan view {a 64 bit integer:viewId} in {a pointer to a bim editor record:editor}:
    execute:
        set found to the bim view index of viewId in editor's documentValue's current
        if found's valid = false:
            return nothing
        set viewValue to the item at found's position in (editor's documentValue's current's views's values)
        if viewValue's kind != bim plan view:
            return nothing
        set editor's planViewId to viewId
        if editor's levelId != viewValue's levelId:
            set editor's levelId to viewValue's levelId
            set editor's chainActive to false
        set editor's planRules to the bim rules of view viewValue in editor's documentValue's current
        set editor's viewsDirty to true

# The section panel shows section view `viewId`: its line and its rules.
function show bim editor section view {a 64 bit integer:viewId} in {a pointer to a bim editor record:editor}:
    execute:
        set found to the bim view index of viewId in editor's documentValue's current
        if found's valid = false:
            return nothing
        set viewValue to the item at found's position in (editor's documentValue's current's views's values)
        if viewValue's kind != bim section view:
            return nothing
        set editor's sectionViewId to viewId
        set editor's hasSection to true
        set editor's sectionZoom to 1.0
        set editor's sectionPanX to 0.0
        set editor's sectionPanY to 0.0
        set editor's sectionFirst to viewValue's lineStart
        set editor's sectionSecond to viewValue's lineFinish
        set editor's sectionRules to the bim rules of view viewValue in editor's documentValue's current
        set editor's viewsDirty to true

# The section's rules, changed in the visibility panel, kept in its view.
function keep bim editor section rules in {a pointer to a bim editor record:editor}:
    execute:
        set found to the bim view index of editor's sectionViewId in editor's documentValue's current
        if found's valid = false:
            return nothing
        set viewValue to the item at found's position in (editor's documentValue's current's views's values)
        begin bim transaction in (the address of (editor's documentValue))
        # A rule changed by hand makes the view Manual.
        store bim view (the bim view (the bim view viewValue ruled by editor's sectionRules) made manual) in (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))

# After the active storey changed: the plan shows that storey's plan view.
function follow bim editor storey in {a pointer to a bim editor record:editor}:
    execute:
        set viewId to the bim plan view of storey editor's levelId for (@intrinsic("dereference", editor))
        if viewId != the bim refused id:
            show bim editor plan view viewId in editor

# The plan's rules, changed in the visibility panel, kept in its view.
function keep bim editor plan rules in {a pointer to a bim editor record:editor}:
    execute:
        set found to the bim view index of editor's planViewId in editor's documentValue's current
        if found's valid = false:
            return nothing
        set viewValue to the item at found's position in (editor's documentValue's current's views's values)
        begin bim transaction in (the address of (editor's documentValue))
        # A rule changed by hand makes the view Manual.
        store bim view (the bim view (the bim view viewValue ruled by editor's planRules) made manual) in (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))

# Every storey has a plan view and the model a 3D view (made as needed, kept
# out of undo), and the plan shows the active storey's. The window calls it;
# headless tests keep no views unless they make them.
function prepare bim editor views in {a pointer to a bim editor record:editor}:
    execute:
        set made to ensure bim default views in (the address of (editor's documentValue's current))
        free made
        set found to the bim view index of editor's planViewId in editor's documentValue's current
        if found's valid = false:
            follow bim editor storey in editor
        else if (the item at found's position in (editor's documentValue's current's views's values))'s levelId != editor's levelId:
            follow bim editor storey in editor
        # A section view undone or deleted leaves the section panel.
        if (editor's sectionViewId != the bim refused id) and ((the bim view index of editor's sectionViewId in editor's documentValue's current)'s valid = false):
            set editor's sectionViewId to the bim refused id
            set editor's hasSection to false
            set editor's viewsDirty to true

# A new A1 landscape sheet numbered after the sheets there are (NS), open
# next.
function add bim editor sheet in {a pointer to a bim editor record:editor}:
    execute:
        set count to (the length of (editor's documentValue's current's sheets's values)) + 1
        set sheetNumber to (the string form of "A-10") + (the string form of count)
        begin bim transaction in (the address of (editor's documentValue))
        set fresh to add bim sheet numbered sheetNumber named ((the string form of "Sheet ") + (the string form of count)) on paper 1 landscape true to (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        set editor's sheetId to fresh
        set editor's message to (the string form of "Sheet ") + sheetNumber

# The plan view shown placed on the sheet open (PV): its middle on the
# sheet's middle, above the title block.
function place bim editor plan view on sheet in {a pointer to a bim editor record:editor}:
    execute:
        set sheetFound to the bim sheet index of editor's sheetId in editor's documentValue's current
        if sheetFound's valid = false:
            set editor's message to the string form of "Place view: open a sheet first (NS makes one)"
            return nothing
        if (the bim view index of editor's planViewId in editor's documentValue's current)'s valid = false:
            set editor's message to the string form of "Place view: no plan view"
            return nothing
        set sheetValue to the item at sheetFound's position in (editor's documentValue's current's sheets's values)
        set sheetSize to the bim size of sheet sheetValue
        set middle to a cad vector2 with x (sheetSize's x * 0.5) and y ((sheetSize's y + 50.0) * 0.5)
        set lookedAt to the bim model centre of view editor's planViewId in editor's documentValue's current
        begin bim transaction in (the address of (editor's documentValue))
        if place bim view editor's planViewId on sheet editor's sheetId at middle looking at lookedAt in (the address of (editor's documentValue's current)):
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to (the string form of "Placed on ") + sheetValue's number
        else:
            roll back bim transaction in (the address of (editor's documentValue))

# The schedule shown placed on the sheet open (PS), its top left corner
# inside the sheet's border; its view is made the first time.
function place bim editor schedule on sheet in {a pointer to a bim editor record:editor}:
    execute:
        set sheetFound to the bim sheet index of editor's sheetId in editor's documentValue's current
        if sheetFound's valid = false:
            set editor's message to the string form of "Place schedule: open a sheet first (NS makes one)"
            return nothing
        if editor's scheduleCode < 0:
            set editor's message to the string form of "Place schedule: show a schedule first (project browser)"
            return nothing
        set target to the address of (editor's documentValue's current)
        begin bim transaction in (the address of (editor's documentValue))
        set scheduleViewId to the bim refused id
        loop cursor from 0 to the length of (target's views's values):
            set viewValue to the item at cursor in (target's views's values)
            if (viewValue's kind = bim schedule view) and (viewValue's detail = (editor's scheduleCode as a 64 bit integer)):
                set scheduleViewId to viewValue's id
        if scheduleViewId = the bim refused id:
            set scheduleViewId to add bim view of kind bim schedule view named (the bim schedule name of editor's scheduleCode) on (the bim refused id) to target
            set made to the item at (the bim view index of scheduleViewId in (@intrinsic("dereference", target)))'s position in (target's views's values)
            set made's detail to editor's scheduleCode as a 64 bit integer
            store bim view made in target
        set sheetValue to the item at sheetFound's position in (target's sheets's values)
        set sheetSize to the bim size of sheet sheetValue
        set corner to a cad vector2 with x 20.0 and y (sheetSize's y - 20.0)
        if place bim view scheduleViewId on sheet editor's sheetId at corner looking at (a cad vector2 with x 0.0 and y 0.0) in target:
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to (the string form of "Schedule placed on ") + sheetValue's number
        else:
            roll back bim transaction in (the address of (editor's documentValue))

# A copy of the plan view shown (DV), shown next.
# A new plan of the active storey following the library drawing type named
# `typeName` (Structural plan SP… from the View tab), shown next.
function add bim editor plan of drawing type named {a string:typeName} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        begin bim transaction in (the address of (editor's documentValue))
        ensure bim drawing types in target
        set typeId to the bim drawing type named typeName in (@intrinsic("dereference", target))
        if typeId = the bim refused id:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to (the string form of "No drawing type ") + typeName
            return nothing
        set levelFound to the bim level index of editor's levelId in (@intrinsic("dereference", target))
        set storeyName to the string form of ""
        if levelFound's valid:
            set storeyName to (the item at levelFound's position in (target's levels's values))'s name
        set fresh to add bim plan view following drawing type typeId named ((typeName + (the string form of " - ")) + storeyName) on editor's levelId to target
        commit bim transaction in (the address of (editor's documentValue))
        show bim editor plan view fresh in editor
        set editor's message to ((typeName + (the string form of " - ")) + storeyName) + (the string form of " (follows its drawing type)")

# The plan shown follows its drawing type again (Automatic), dropping the
# rules changed by hand.
function make bim editor plan view automatic in {a pointer to a bim editor record:editor}:
    execute:
        set found to the bim view index of editor's planViewId in editor's documentValue's current
        if found's valid = false:
            return nothing
        set viewValue to the item at found's position in (editor's documentValue's current's views's values)
        if (the bim drawing type index of viewValue's drawingTypeId in editor's documentValue's current)'s valid = false:
            set editor's message to the string form of "This view has no drawing type: it keeps its own rules"
            return nothing
        begin bim transaction in (the address of (editor's documentValue))
        store bim view (the bim view viewValue made automatic) in (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        show bim editor plan view viewValue's id in editor
        set editor's message to the string form of "View follows its drawing type (Automatic)"

function duplicate bim editor plan view in {a pointer to a bim editor record:editor}:
    execute:
        set found to the bim view index of editor's planViewId in editor's documentValue's current
        if found's valid = false:
            set editor's message to the string form of "Duplicate view: no plan view"
            return nothing
        set original to the item at found's position in (editor's documentValue's current's views's values)
        set title to original's name + (the string form of " (copy)")
        begin bim transaction in (the address of (editor's documentValue))
        set fresh to duplicate bim view original's id named title in (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        show bim editor plan view fresh in editor
        set editor's message to (the string form of "View ") + title

# ---------------------------------------------------------------- dimensions

# The semantic feature of the active storey nearest `location` within
# `tolerance`: an opening's edge or a wall's end first, else a wall's face;
# feature -1 when there is none.
function the bim reference at {cad vector2:location} in {bim editor record:editor} within {a 64 bit floating-point number:tolerance}:
    execute:
        set modelValue to editor's documentValue's current
        set index to the bim join index of modelValue
        set candidates to the bim walls within tolerance of location for editor
        set chosen to a bim reference to (the bim refused id) feature -1
        set nearest to tolerance
        # Points: opening edges and wall ends.
        loop cursor from 0 to the length of candidates:
            set wallId to the item at cursor in candidates
            loop featureKind from 0 to 2:
                set anchor to the bim feature of (a bim reference to wallId feature featureKind) in modelValue using index
                if anchor's valid and ((the cad distance from location to anchor's origin) < nearest):
                    set nearest to the cad distance from location to anchor's origin
                    set chosen to a bim reference to wallId feature featureKind
            # The masonry module's lines and its face's far end, on a wall
            # that has one (`bim_masonry.dl`).
            set masonryWall to the bim wall index of wallId in modelValue
            if masonryWall's valid:
                set masonryValue to the bim masonry of wall (the item at masonryWall's position in (modelValue's walls's values)) in modelValue using index
                if masonryValue's status = (bim masonry measured):
                    loop lineNumber from 0 to (masonryValue's whole + 1):
                        set masonrySpot to the bim masonry point lineNumber of masonryValue
                        if (the cad distance from location to masonrySpot) < nearest:
                            set nearest to the cad distance from location to masonrySpot
                            set chosen to a bim reference to wallId feature ((bim masonry line feature) + lineNumber)
                    set farSpot to the bim masonry point 0 of masonryValue
                    set farSpot to a cad vector2 with x (farSpot's x + (masonryValue's onward's x * masonryValue's span)) and y (farSpot's y + (masonryValue's onward's y * masonryValue's span))
                    if (the cad distance from location to farSpot) < nearest:
                        set nearest to the cad distance from location to farSpot
                        set chosen to a bim reference to wallId feature (bim masonry far end feature)
            loop openingCursor from 0 to the length of (modelValue's openings's values):
                set openingValue to the item at openingCursor in (modelValue's openings's values)
                if openingValue's hostId = wallId:
                    loop featureKind from 4 to 6:
                        set anchor to the bim feature of (a bim reference to openingValue's id feature featureKind) in modelValue using index
                        if anchor's valid and ((the cad distance from location to anchor's origin) < nearest):
                            set nearest to the cad distance from location to anchor's origin
                            set chosen to a bim reference to openingValue's id feature featureKind
        if chosen's feature >= 0:
            return chosen
        # Lines: the faces of the walls passing near.
        loop cursor from 0 to the length of candidates:
            set wallId to the item at cursor in candidates
            loop featureKind from 2 to 4:
                set anchor to the bim feature of (a bim reference to wallId feature featureKind) in modelValue using index
                if anchor's valid:
                    set dx to location's x - anchor's origin's x
                    set dy to location's y - anchor's origin's y
                    set gap to the absolute value of ((dx * anchor's direction's y) - (dy * anchor's direction's x))
                    if gap < nearest:
                        set nearest to gap
                        set chosen to a bim reference to wallId feature featureKind
        return chosen

function the bim feature name of {integer:featureKind}:
    execute:
        if featureKind = bim wall start feature:
            return the string form of "wall start"
        if featureKind = bim wall finish feature:
            return the string form of "wall end"
        if featureKind = bim wall exterior feature:
            return the string form of "exterior face"
        if featureKind = bim wall interior feature:
            return the string form of "interior face"
        if (featureKind = (bim masonry near end feature)) or (featureKind = (bim masonry far end feature)):
            return the string form of "masonry face end"
        if featureKind >= (bim masonry line feature):
            return the string form of "masonry module line"
        return the string form of "opening edge"

function start bim editor dimension tool in {a pointer to a bim editor record:editor}:
    execute:
        set editor's tool to bim dimension tool
        set editor's moveStage to 0
        set editor's message to the string form of "Dimension: click a wall face, a wall end, a masonry line or an opening edge"

# A click of the dimension tool at `point`: the first feature, the second,
# then where its line goes.
function place bim editor dimension at {cad vector2:point} in {a pointer to a bim editor record:editor}:
    execute:
        if editor's moveStage < 2:
            set picked to the bim reference at point in (@intrinsic("dereference", editor)) within (editor's pickTolerance * 2.0)
            if picked's feature < 0:
                set editor's message to the string form of "Dimension: no wall face, wall end or opening edge there"
                return nothing
            if editor's moveStage = 0:
                set editor's dimensionFirst to picked
                set editor's moveStage to 1
                set editor's message to ((the string form of "Dimension from the ") + (the bim feature name of picked's feature)) + (the string form of ": click the second feature")
                return nothing
            set editor's dimensionSecond to picked
            set editor's moveStage to 2
            set editor's message to the string form of "Dimension: click where its line goes"
            return nothing
        begin bim transaction in (the address of (editor's documentValue))
        set made to add bim dimension from editor's dimensionFirst to editor's dimensionSecond through point to (the address of (editor's documentValue's current))
        set found to the bim dimension index of made in editor's documentValue's current
        set measured to the bim measure of (the item at found's position in (editor's documentValue's current's dimensions's values)) in editor's documentValue's current
        if measured's valid = false:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's moveStage to 0
            set editor's message to the string form of "Dimension refused: those features are not parallel"
            return nothing
        commit bim transaction in (the address of (editor's documentValue))
        set editor's moveStage to 0
        set editor's message to (the string form of "Dimension ") + (the bim length measured's value in units editor's lengthUnit)

# ---------------------------------------------------------------- building services

# Duct and cable tray types, once, when the model has none of them.
function ensure bim services types in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        loop cursor from 0 to the length of (target's linearTypes's values):
            set linearType to the item at cursor in (target's linearTypes's values)
            if (linearType's role = bim duct role) or (linearType's role = bim cable tray role):
                return nothing
        begin bim transaction in (the address of (editor's documentValue))
        add bim library linear type (the string form of "Kanaal 400x200") as role bim duct role sized 0.4 by 0.2 round false of (the string form of "steel") to target
        add bim library linear type (the string form of "Kanaal rond 250") as role bim duct role sized 0.25 by 0.25 round true of (the string form of "steel") to target
        add bim library linear type (the string form of "Kabelgoot 300x60") as role bim cable tray role sized 0.3 by 0.06 round false of (the string form of "steel") to target
        commit bim transaction in (the address of (editor's documentValue))

# The length a new pile reaches down, in metres.
function bim pile length:
    replacement:
        12.0

# Pile types, once, when the model has none: a square precast concrete pile,
# a driven cast-in-place pile (vibro) and a bored pile.
function ensure bim pile types in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        loop cursor from 0 to the length of (target's linearTypes's values):
            if (the item at cursor in (target's linearTypes's values))'s role = bim pile role:
                return nothing
        begin bim transaction in (the address of (editor's documentValue))
        add bim library linear type (the string form of "Prefab beton 290x290") as role bim pile role sized 0.29 by 0.29 round false of (the string form of "concrete") to target
        add bim library linear type (the string form of "Vibropaal 457") as role bim pile role sized 0.457 by 0.457 round true of (the string form of "concrete") to target
        add bim library linear type (the string form of "Boorpaal 600") as role bim pile role sized 0.6 by 0.6 round true of (the string form of "concrete") to target
        commit bim transaction in (the address of (editor's documentValue))

# The discipline a system of elements of `roleCode` is of: water for pipes,
# ventilation for ducts, electrical for cable trays.
function the bim discipline of role {integer:roleCode}:
    execute:
        if roleCode = bim duct role:
            return bim ventilation discipline
        if roleCode = bim cable tray role:
            return bim electrical discipline
        return bim water discipline

# The selected pipes, ducts and cable trays made one system (SY), of the
# discipline of the first of them.
function make bim editor system in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set gathered to an empty list of a 64 bit integer
        loop cursor from 0 to the length of (editor's chosenSketches's values):
            append (the item at cursor in (editor's chosenSketches's values)) to gathered
        if editor's selectionKind = bim linear picked:
            append editor's selectionId to gathered
        set disciplineCode to -1
        set chosen to an empty list of a 64 bit integer
        loop cursor from 0 to the length of gathered:
            set elementId to the item at cursor in gathered
            set found to the bim linear index of elementId in (@intrinsic("dereference", target))
            if found's valid:
                set linearType to the bim type of linear (the item at found's position in (target's linears's values)) in (@intrinsic("dereference", target))
                if bim role linearType's role connects:
                    if disciplineCode < 0:
                        set disciplineCode to the bim discipline of role linearType's role
                    append elementId to chosen
        free gathered
        if (the length of chosen) = 0:
            set editor's message to the string form of "System: select pipes, ducts or cable trays first"
            free chosen
            return nothing
        set count to 1
        loop cursor from 0 to the length of (target's systems's values):
            if (the item at cursor in (target's systems's values))'s discipline = disciplineCode:
                set count to count + 1
        set title to ((the bim name of discipline disciplineCode) + (the string form of " ")) + (the string form of count)
        begin bim transaction in (the address of (editor's documentValue))
        set made to add bim system named title of discipline disciplineCode to target
        loop cursor from 0 to the length of chosen:
            ignore assign bim element (the item at cursor in chosen) to system made in target
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to ((the string form of "System ") + title) + ((the string form of ": ") + ((the string form of (the length of chosen)) + (the string form of " elements")))
        free chosen

# ---------------------------------------------------------------- stairs

# The stair of the active storey whose footprint holds `location`, or the
# refused id.
function the bim stair at {cad vector2:location} in {bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of (editor's documentValue's current's stairs's values):
            set stairValue to the item at cursor in (editor's documentValue's current's stairs's values)
            if (stairValue's levelId = editor's levelId) and ((bim editor hides (stairValue's id) in plan of editor) = false):
                set run to the cad distance from stairValue's start to stairValue's finish
                if run > 1e-9:
                    set ux to (stairValue's finish's x - stairValue's start's x) / run
                    set uy to (stairValue's finish's y - stairValue's start's y) / run
                    set dx to location's x - stairValue's start's x
                    set dy to location's y - stairValue's start's y
                    set along to (dx * ux) + (dy * uy)
                    set across to (dy * ux) - (dx * uy)
                    if ((along >= 0.0) and (along <= run)) and ((the absolute value of across) <= (stairValue's width * 0.5)):
                        return stairValue's id
        return the bim refused id

# A click of the stair tool: the foot of the run, then its head; the risers
# are as many as keep each at most 185 mm up the storey's height.
function place bim editor stair at {cad vector2:point} in {a pointer to a bim editor record:editor}:
    execute:
        if editor's moveStage = 0:
            set editor's solidCorner to point
            set editor's moveStage to 1
            set editor's message to the string form of "Stair: click the head of the run"
            return nothing
        set editor's moveStage to 0
        set levelFound to the bim level index of editor's levelId in editor's documentValue's current
        if levelFound's valid = false:
            return nothing
        set storeyHeight to (the item at levelFound's position in (editor's documentValue's current's levels's values))'s height
        set riserTotal to 3
        loop while (storeyHeight / (riserTotal as a 64 bit floating-point number)) > 0.185:
            set riserTotal to riserTotal + 1
        begin bim transaction in (the address of (editor's documentValue))
        set made to add bim stair on editor's levelId from editor's solidCorner to point wide 1.0 in riserTotal risers of (the string form of "timber") to (the address of (editor's documentValue's current))
        if made = the bim refused id:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Stair refused: the run must be at least 0.5 m"
            return nothing
        if editor's stairTypeIndex >= 0:
            ignore give bim stair made type editor's stairTypeIndex in (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        set stairValue to the item at (the bim stair index of made in editor's documentValue's current)'s position in (editor's documentValue's current's stairs's values)
        set riserText to the bim millimetre text of (storeyHeight / (riserTotal as a 64 bit floating-point number))
        set goingText to the bim millimetre text of (the bim going of stair stairValue)
        select bim editor bim stair picked numbered made in editor
        set editor's message to ((((the string form of "Stair: ") + (the string form of riserTotal)) + (the string form of " risers of ")) + riserText) + (((the string form of " mm, going ") + goingText) + (the string form of " mm"))

# ---------------------------------------------------------------- railings

# The railing of the active storey whose path passes within `tolerance` of
# `location`, or the refused id.
function the bim railing at {cad vector2:location} in {bim editor record:editor} within {a 64 bit floating-point number:tolerance}:
    execute:
        loop cursor from 0 to the length of (editor's documentValue's current's railings's values):
            set railingValue to the item at cursor in (editor's documentValue's current's railings's values)
            if (railingValue's levelId = editor's levelId) and ((bim editor hides (railingValue's id) in plan of editor) = false):
                set pathPoints to railingValue's points's values
                loop segmentIndex from 0 to ((the length of pathPoints) - 1):
                    if (the cad distance from location to the segment from (the item at segmentIndex in pathPoints) to (the item at (segmentIndex + 1) in pathPoints)) <= tolerance:
                        return railingValue's id
        return the bim refused id

# The curtain wall of the active storey whose line passes within `tolerance`
# of `location`, or the refused id.
# The building system of the active storey nearest to `location` in the
# plan, its footprint within `tolerance`; else the refused id.
function the bim curtain at {cad vector2:location} in {bim editor record:editor} within {a 64 bit floating-point number:tolerance}:
    execute:
        set modelValue to editor's documentValue's current
        set nearest to the bim refused id
        set nearestGap to tolerance
        loop cursor from 0 to the length of (modelValue's curtains's values):
            set curtainValue to the item at cursor in (modelValue's curtains's values)
            set curtainHidden to bim editor hides (curtainValue's id) in plan of editor
            if ((the bim placed system curtainValue in modelValue)'s curtain's levelId = editor's levelId) and (curtainHidden = false):
                set gap to the bim footprint gap of location to curtainValue in modelValue
                if gap <= nearestGap:
                    set nearest to curtainValue's id
                    set nearestGap to gap
        return nearest

# ---------------------------------------------------------------- building system parts

# The part of building system `curtainValue` at `along` metres along its
# line and `height` above its storey: a mullion (its index from the start,
# 0 to the number of bays), a transom (1000 plus its index from the bottom)
# or a panel (2000 plus its index, bay by bay and each bay's rows from the
# bottom), whichever the point lies on; -1 off the system.
function the bim system part code of {bim curtain record:curtainValue} at {a 64 bit floating-point number:alongLine} and {a 64 bit floating-point number:height} in {bim model record:modelValue}:
    execute:
        set run to the bim system length of curtainValue
        if ((run < 1e-9) or ((alongLine < -0.05) or (alongLine > (run + 0.05)))) or ((height < -0.05) or (height > (curtainValue's height + 0.05))):
            return -1
        set bays to the bim bay count of curtainValue
        set rows to the bim row count of curtainValue
        set reach to ((the bim joint width of system curtainValue's id in modelValue) * 0.5) + 0.02
        set bay to 0
        loop lineCursor from 0 to (bays + 1):
            set lineAlong to the bim mullion lineCursor along curtainValue in modelValue
            if (the absolute value of (alongLine - lineAlong)) <= reach:
                return lineCursor
            if (lineAlong <= alongLine) and (lineCursor < bays):
                set bay to lineCursor
        set row to 0
        loop lineCursor from 0 to (rows + 1):
            set lineHeight to the bim transom lineCursor along curtainValue in modelValue
            if (the absolute value of (height - lineHeight)) <= reach:
                return 1000 + lineCursor
            if (lineHeight <= height) and (lineCursor < rows):
                set row to lineCursor
        return 2000 + ((bay * rows) + row)

# Where part `code` of building system `curtainValue` lies: from `low` to
# `high`, each along its line (x) and above its storey (y).
class:
    patterns:
        [a|] bim system part box record
    members:
        low as a cad vector2
        high as a cad vector2

function the bim system part box of {bim curtain record:curtainValue} coded {integer:code} in {bim model record:modelValue}:
    execute:
        set run to the bim system length of curtainValue
        set rows to the bim row count of curtainValue
        set half to (the bim joint width of system curtainValue's id in modelValue) * 0.5
        if code < 1000:
            set edgeAlong to the bim mullion code along curtainValue in modelValue
            return @intrinsic("construct", a bim system part box record, a cad vector2 with x (edgeAlong - half) and y 0.0, a cad vector2 with x (edgeAlong + half) and y curtainValue's height)
        if code < 2000:
            set transomLevel to the bim transom (code - 1000) along curtainValue in modelValue
            return @intrinsic("construct", a bim system part box record, a cad vector2 with x 0.0 and y (transomLevel - half), a cad vector2 with x run and y (transomLevel + half))
        set bay to (code - 2000) / rows
        set row to the remainder of (code - 2000) divided by rows
        set low to a cad vector2 with x ((the bim mullion bay along curtainValue in modelValue) + half) and y ((the bim transom row along curtainValue in modelValue) + half)
        return @intrinsic("construct", a bim system part box record, low, a cad vector2 with x ((the bim mullion (bay + 1) along curtainValue in modelValue) - half) and y ((the bim transom (row + 1) along curtainValue in modelValue) - half))

# Whether grid line `code` (a mullion, or 1000 plus a transom) of
# `curtainValue` can move: every line but the first and the last.
function bim system line {integer:code} of {bim curtain record:curtainValue} moves:
    execute:
        if code < 0:
            return false
        if code < 1000:
            return (code > 0) and (code < (the bim bay count of curtainValue))
        if code < 2000:
            return ((code - 1000) > 0) and ((code - 1000) < (the bim row count of curtainValue))
        return false

# Where grid line `code` of `curtainValue` lies, in metres from its start
# (a mullion) or foot (a transom).
function the bim system line position of {bim curtain record:curtainValue} coded {integer:code} in {bim model record:modelValue}:
    execute:
        if code < 1000:
            return the bim mullion code along curtainValue in modelValue
        return the bim transom (code - 1000) along curtainValue in modelValue

# Moves grid line `code` of building system `curtainId` to `position`
# metres from its start or foot, rounded to whole millimetres; refused off
# the space between its neighbours (keeping 100 mm to each).
function move bim system line {integer:code} of {a 64 bit integer:curtainId} to {a 64 bit floating-point number:position} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim curtain index of curtainId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set curtainValue to the item at found's position in (target's curtains's values)
        if (bim system line code of curtainValue moves) = false:
            return false
        set before to the bim system line position of curtainValue coded (code - 1) in (@intrinsic("dereference", target))
        set after to the bim system line position of curtainValue coded (code + 1) in (@intrinsic("dereference", target))
        if (position < (before + 0.1)) or (position > (after - 0.1)):
            return false
        set bim system line code of system curtainId to ((the floor of ((position * 1000.0) + 0.5)) as a 64 bit integer) in target
        return true

# The name of planar type `typeId` as a panel: its name, or Glass.
function the bim panel type name of {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        set found to the bim wall type index of typeId in modelValue
        if found's valid:
            return (the item at found's position in (modelValue's wallTypes's values))'s name
        return the string form of "Glass"

# The name of part `code`: "Mullion 3", "Transom 1" or "Panel 5 (bay 2,
# row 1)", counted from 1, a panel with its type (or Glass).
function the bim system part name of {bim curtain record:curtainValue} coded {integer:code} in {bim model record:modelValue}:
    execute:
        if code < 0:
            return the string form of "Building system"
        if code < 1000:
            return (the string form of "Mullion ") + (the string form of (code + 1))
        if code < 2000:
            return (the string form of "Transom ") + (the string form of ((code - 1000) + 1))
        set rows to the bim row count of curtainValue
        set panelIndex to code - 2000
        set text to (the string form of "Panel ") + (the string form of (panelIndex + 1))
        set text to ((text + (the string form of " (bay ")) + (the string form of ((panelIndex / rows) + 1))) + (((the string form of ", row ") + (the string form of ((the remainder of panelIndex divided by rows) + 1))) + (the string form of ")"))
        return (text + (the string form of ": ")) + (the bim panel type name of (the bim panel type of panel panelIndex of system curtainValue's id in modelValue) in modelValue)

# UI terminology is separate from the part names used by geometry/tests.
function the bim displayed system part of {bim curtain record:curtainValue} coded {integer:code} in {bim model record:modelValue}:
    execute:
        if (code >= 0) and (code < 1000):
            return (the string form of "Frame ") + (the string form of (code + 1))
        return the bim system part name of curtainValue coded code in modelValue

# Chooses the part of selected building system `curtainId` at `along` and
# `height` (see `the bim system part code of`); a click off its parts
# chooses the whole system again.
function choose bim editor part of system {a 64 bit integer:curtainId} at {a 64 bit floating-point number:along} and {a 64 bit floating-point number:height} in {a pointer to a bim editor record:editor}:
    execute:
        set found to the bim curtain index of curtainId in editor's documentValue's current
        if found's valid = false:
            return nothing
        set curtainValue to the item at found's position in (editor's documentValue's current's curtains's values)
        set editor's partCode to the bim system part code of curtainValue at along and height in editor's documentValue's current
        set editor's message to (the bim displayed system part of curtainValue coded editor's partCode in editor's documentValue's current) + (the string form of " (Esc: the whole system)")

# A click on building system `curtainId` at model point `spot` (its height
# above the system's storey): the system selected with its part there
# chosen, so that a click picks a mullion, transom or panel at once.
function choose bim editor part of system {a 64 bit integer:curtainId} seen at {cad vector3:spot} in {a pointer to a bim editor record:editor}:
    execute:
        set found to the bim curtain index of curtainId in editor's documentValue's current
        if found's valid = false:
            return nothing
        if (editor's selectionKind != bim curtain picked) or (editor's selectionId != curtainId):
            select bim editor bim curtain picked numbered curtainId in editor
        set curtainValue to the item at found's position in (editor's documentValue's current's curtains's values)
        set place to the bim face place of spot on curtainValue in editor's documentValue's current
        choose bim editor part of system curtainId at place's x and place's y in editor

# The planar type after `typeId` among the panel choices: Glass (the refused
# id), then every planar type in order, then Glass again.
function the bim next panel type after {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        set types to modelValue's wallTypes's values
        if (the length of types) = 0:
            return the bim refused id
        if typeId = the bim refused id:
            return (the item at 0 in types)'s id
        set found to the bim wall type index of typeId in modelValue
        if (found's valid = false) or ((found's position + 1) >= (the length of types)):
            return the bim refused id
        return (the item at (found's position + 1) in types)'s id

# A click on the panel type row: the chosen panel (or, with the whole system
# chosen, every panel without its own type) takes the next planar type, as
# one edit.
function cycle bim editor panel type in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set found to the bim curtain index of editor's selectionId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((editor's partCode >= 0) and (editor's partCode < 2000)):
            set editor's message to the string form of "Choose a panel or the whole building system"
            return nothing
        set curtainValue to the item at found's position in (target's curtains's values)
        set panelIndex to -1
        if editor's partCode >= 2000:
            set panelIndex to editor's partCode - 2000
        set present to the bim panel type of panel panelIndex of system curtainValue's id in (@intrinsic("dereference", target))
        set following to the bim next panel type after present in (@intrinsic("dereference", target))
        begin bim transaction in (the address of (editor's documentValue))
        set bim panel panelIndex of system curtainValue's id to type following in target
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to (the string form of "Panel type: ") + (the bim panel type name of following in (@intrinsic("dereference", target)))

# A click of the curtain wall tool: its start, then its end; it rises the
# storey's height in bays of 1.2 m and rows of 1.5 m.
function place bim editor curtain at {cad vector2:point} in {a pointer to a bim editor record:editor}:
    execute:
        if editor's moveStage = 0:
            set editor's solidCorner to point
            set editor's moveStage to 1
            set editor's message to the string form of "Building system: click its end"
            return nothing
        set editor's moveStage to 0
        set levelFound to the bim level index of editor's levelId in editor's documentValue's current
        if levelFound's valid = false:
            return nothing
        set storeyHeight to (the item at levelFound's position in (editor's documentValue's current's levels's values))'s height
        begin bim transaction in (the address of (editor's documentValue))
        set made to add bim curtain wall on editor's levelId from editor's solidCorner to point rising storeyHeight in bays of 1.2 by 1.5 of (the string form of "steel") to (the address of (editor's documentValue's current))
        if made = the bim refused id:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Building system refused: it must be at least 0.5 m long"
            return nothing
        # Of the type chosen in the type selector.
        if editor's systemTypeIndex >= 0:
            ignore give bim system made type editor's systemTypeIndex in (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        select bim editor bim curtain picked numbered made in editor
        set editor's message to (the string form of "Building system ") + (the string form of made)

# A click of the railing tool: a point of its path; Enter ends it.
function place bim editor railing point at {cad vector2:point} in {a pointer to a bim editor record:editor}:
    execute:
        append point to (editor's sketchChain's values)
        set editor's message to (the string form of "Railing: ") + ((the string form of (the length of (editor's sketchChain's values))) + (the string form of " points; click the next, Enter ends"))

# The railing drawn so far made (Enter), a metre high in steel.
function finish bim editor railing in {a pointer to a bim editor record:editor}:
    execute:
        set pathPoints to editor's sketchChain's values
        if (the length of pathPoints) < 2:
            set editor's message to the string form of "Railing: click at least two points"
            return nothing
        begin bim transaction in (the address of (editor's documentValue))
        set made to add bim railing on editor's levelId along pathPoints hosted by (the bim refused id) rising 1.0 of (the string form of "steel") to (the address of (editor's documentValue's current))
        if made = the bim refused id:
            roll back bim transaction in (the address of (editor's documentValue))
            return nothing
        if editor's railingTypeIndex >= 0:
            ignore give bim stair made type editor's railingTypeIndex in (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        set editor's sketchChain to a cad topology list of a cad vector2
        select bim editor bim railing picked numbered made in editor
        set editor's message to (the string form of "Railing ") + (the string form of made)

# Railings on both sides of the selected stair (RS), following its slope.
function rail bim editor stair in {a pointer to a bim editor record:editor}:
    execute:
        if editor's selectionKind != bim stair picked:
            set editor's message to the string form of "Railings: select a stair first"
            return nothing
        set target to the address of (editor's documentValue's current)
        set found to the bim stair index of editor's selectionId in (@intrinsic("dereference", target))
        if found's valid = false:
            return nothing
        set stairValue to the item at found's position in (target's stairs's values)
        set sidePaths to the bim railing paths of stair stairValue
        begin bim transaction in (the address of (editor's documentValue))
        loop cursor from 0 to the length of sidePaths:
            ignore add bim railing on stairValue's levelId along (the item at cursor in sidePaths) hosted by stairValue's id rising 0.9 of (the string form of "steel") to target
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to the string form of "Railings on both sides of the stair"

# ---------------------------------------------------------------- tags

# The element of the active storey a tag would point at under `location`:
# an opening, a linear element, a wall, then a plate; the refused id when
# there is none.
function the bim taggable at {cad vector2:location} in {bim editor record:editor} within {a 64 bit floating-point number:tolerance}:
    execute:
        set modelValue to editor's documentValue's current
        loop rebarCursor from 0 to the length of (modelValue's reinforcements's values):
            set spec to the item at rebarCursor in (modelValue's reinforcements's values)
            if spec's levelId = editor's levelId:
                set generated to the bim reinforcement paths of spec in modelValue
                loop barCursor from 0 to the length of (generated's bars's values):
                    set barValue to the item at barCursor in (generated's bars's values)
                    loop edge from 0 to ((the length of (barValue's points's values)) - 1):
                        set beginning to the item at edge in (barValue's points's values)
                        set ending to the item at (edge + 1) in (barValue's points's values)
                        if (the cad distance from location to the segment from (a cad vector2 with x beginning's x and y beginning's y) to (a cad vector2 with x ending's x and y ending's y)) <= tolerance:
                            return spec's id
        loop cursor from 0 to the length of (modelValue's openings's values):
            set openingValue to the item at cursor in (modelValue's openings's values)
            set anchorSpot to the bim tag anchor of openingValue's id in modelValue
            set typeFound to the bim opening type index of openingValue's typeId in modelValue
            if (anchorSpot's valid and typeFound's valid) and (anchorSpot's levelId = editor's levelId):
                set reach to ((the bim rough width of (the item at typeFound's position in (modelValue's openingTypes's values))) * 0.5) + tolerance
                if (the cad distance from location to anchorSpot's origin) <= reach:
                    return openingValue's id
        set linearId to the bim linear at location in editor within tolerance
        if linearId != the bim refused id:
            return linearId
        set candidates to the bim walls within tolerance of location for editor
        if (the length of candidates) > 0:
            return the item at 0 in candidates
        loop cursor from 0 to the length of (modelValue's slabs's values):
            set slabValue to the item at cursor in (modelValue's slabs's values)
            if (slabValue's levelId = editor's levelId) and (bim flat point location lies in (slabValue's outline's values)):
                return slabValue's id
        return the bim refused id

# A click of the tag tool: the element under it gets a tag there (an
# opening's tag stands outside its wall).
function place bim editor tag at {cad vector2:point} in {a pointer to a bim editor record:editor}:
    execute:
        set elementId to the bim taggable at point in (@intrinsic("dereference", editor)) within (editor's pickTolerance * 2.0)
        if elementId = the bim refused id:
            set editor's message to the string form of "Tag: click a window, door, wall, column, beam or floor"
            return nothing
        set tagPlace to point
        if (the bim opening index of elementId in editor's documentValue's current)'s valid:
            set anchorSpot to the bim tag anchor of elementId in editor's documentValue's current
            set tagPlace to a cad vector2 with x (anchorSpot's origin's x + (anchorSpot's direction's x * 0.7)) and y (anchorSpot's origin's y + (anchorSpot's direction's y * 0.7))
        begin bim transaction in (the address of (editor's documentValue))
        set made to add bim tag of elementId at tagPlace to (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to (the string form of "Tag: ") + (the bim tag text of elementId in editor's documentValue's current)

# Every window and door of the active storey without a tag gets one,
# outside its wall (TA).
function tag bim editor all openings in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set made to 0
        begin bim transaction in (the address of (editor's documentValue))
        loop cursor from 0 to the length of (target's openings's values):
            set openingValue to the item at cursor in (target's openings's values)
            set anchorSpot to the bim tag anchor of openingValue's id in (@intrinsic("dereference", target))
            set tagged to false
            loop tagCursor from 0 to the length of (target's tags's values):
                if (the item at tagCursor in (target's tags's values))'s elementId = openingValue's id:
                    set tagged to true
            if (anchorSpot's valid and (anchorSpot's levelId = editor's levelId)) and (tagged = false):
                set place to a cad vector2 with x (anchorSpot's origin's x + (anchorSpot's direction's x * 0.7)) and y (anchorSpot's origin's y + (anchorSpot's direction's y * 0.7))
                ignore add bim tag of openingValue's id at place to target
                set made to made + 1
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to ((the string form of "Tagged ") + (the string form of made)) + (the string form of " windows and doors")

# ---------------------------------------------------------------- components

function the bim solid kind name of {integer:kindCode}:
    execute:
        if kindCode = bim cylinder solid:
            return the string form of "Cylinder"
        if kindCode = bim sphere solid:
            return the string form of "Sphere"
        if kindCode = bim extrusion solid:
            return the string form of "Extrusion"
        if kindCode = bim mesh solid:
            return the string form of "Mesh"
        return the string form of "Box"

function the bim operation name of {integer:operationCode}:
    execute:
        if operationCode = bim subtract operation:
            return the string form of "cut"
        if operationCode = bim intersect operation:
            return the string form of "intersect"
        return the string form of "add"

function show bim editor solid prompt in {a pointer to a bim editor record:editor}:
    execute:
        set head to ((the bim solid kind name of editor's solidKind) + (the string form of " (")) + ((the bim operation name of editor's solidOperation) + (the string form of ")"))
        if editor's solidInstanceId = the bim refused id:
            set head to head + (the string form of ", new component")
        set step to the string form of ": click a corner"
        if editor's solidKind != bim box solid:
            set step to the string form of ": click the centre"
        if editor's moveStage = 1:
            set step to the string form of ": click the opposite corner"
            if editor's solidKind != bim box solid:
                set step to the string form of ": click the radius"
        if editor's moveStage = 2:
            set step to the string form of ": move up the plan or type a height, then click or Enter"
        set editor's message to (head + step) + (the string form of "  (Add / Cut / Intersect in the ribbon)")

# The solid tool for parts of `kindCode`: into the selected instance's
# component, or a new component when no instance is selected.
function start bim editor solid tool of kind {integer:kindCode} in {a pointer to a bim editor record:editor}:
    execute:
        if editor's tool != bim solid tool:
            set editor's solidInstanceId to the bim refused id
            if editor's selectionKind = bim instance picked:
                set editor's solidInstanceId to editor's selectionId
        set editor's tool to bim solid tool
        set editor's solidKind to kindCode
        set editor's moveStage to 0
        set editor's chainActive to false
        set editor's numeric to the string form of ""
        show bim editor solid prompt in editor

# The next part adds, cuts or intersects.
function set bim editor solid operation to {integer:operationCode} in {a pointer to a bim editor record:editor}:
    execute:
        set editor's solidOperation to operationCode
        if editor's tool = bim solid tool:
            show bim editor solid prompt in editor
        else:
            set editor's message to (the string form of "Solid parts now ") + (the bim operation name of operationCode)

# The part from the clicks so far, `rise` high, into the instance's
# component (in its coordinates) or a new component placed at the first
# click.
function finish bim editor solid rising {a 64 bit floating-point number:rise} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set first to editor's solidCorner
        set second to editor's solidReach
        set reach to the cad distance from first to second
        set lowX to the minimum of first's x and second's x
        set lowY to the minimum of first's y and second's y
        set widthSpan to the absolute value of (second's x - first's x)
        set depthSpan to the absolute value of (second's y - first's y)
        begin bim transaction in (the address of (editor's documentValue))
        set instanceFound to the bim instance index of editor's solidInstanceId in (@intrinsic("dereference", target))
        set componentId to the bim refused id
        set placeOrigin to a cad vector2 with x lowX and y lowY
        set placeAngle to 0.0
        if instanceFound's valid:
            set placement to the item at instanceFound's position in (target's instances's values)
            set componentId to placement's componentId
            set placeOrigin to placement's origin
            set placeAngle to placement's angle
        else:
            set title to (the string form of "Component ") + (the string form of ((the length of (target's components's values)) + 1))
            set componentId to add bim component named title to target
            set editor's solidInstanceId to place bim component componentId on editor's levelId at placeOrigin turned 0.0 to target
        set noProfile to an empty list of a cad vector2
        set partOrigin to a cad vector3 with x 0.0, y 0.0 and z 0.0
        set partSize to a cad vector3 with x reach, y 0.0 and z rise
        if editor's solidKind = bim box solid:
            set corner to the bim component coordinates of (a cad vector2 with x lowX and y lowY) at placeOrigin turned placeAngle
            set partOrigin to a cad vector3 with x corner's x, y corner's y and z 0.0
            set partSize to a cad vector3 with x widthSpan, y depthSpan and z rise
        else:
            set centre to the bim component coordinates of first at placeOrigin turned placeAngle
            set partOrigin to a cad vector3 with x centre's x, y centre's y and z 0.0
            if editor's solidKind = bim sphere solid:
                set partOrigin to a cad vector3 with x centre's x, y centre's y and z reach
        set operationCode to editor's solidOperation
        if instanceFound's valid = false:
            set operationCode to bim add operation
        set added to add bim solid of kind editor's solidKind as operationCode at partOrigin sized partSize turned (0.0 - placeAngle) along noProfile of (the string form of "concrete") to component componentId in target
        free noProfile
        set editor's moveStage to 0
        set editor's numeric to the string form of ""
        if added = false:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "That part has no size; try again"
            return nothing
        commit bim transaction in (the address of (editor's documentValue))
        show bim editor solid prompt in editor
        set done to the string form of " added"
        if operationCode = bim subtract operation:
            set done to the string form of " cut"
        if operationCode = bim intersect operation:
            set done to the string form of " intersected"
        set editor's message to ((the bim solid kind name of editor's solidKind) + done) + (the string form of "; click for the next part, Esc ends")

# A click of the solid tool at `point`.
function place bim editor solid at {cad vector2:point} in {a pointer to a bim editor record:editor}:
    execute:
        if editor's moveStage = 0:
            set editor's solidCorner to point
            set editor's moveStage to 1
            show bim editor solid prompt in editor
            return nothing
        if editor's moveStage = 1:
            if (the cad distance from editor's solidCorner to point) <= 1e-6:
                return nothing
            set editor's solidReach to point
            if editor's solidKind = bim sphere solid:
                finish bim editor solid rising 0.0 in editor
                return nothing
            set editor's moveStage to 2
            set editor's numeric to the string form of ""
            show bim editor solid prompt in editor
            return nothing
        set rise to the cad distance from editor's solidReach to point
        if (the length of editor's numeric) > 0:
            set rise to (the bim numeric value of editor's numeric) * (the bim metres per editor's lengthUnit)
        if rise <= 1e-6:
            return nothing
        finish bim editor solid rising rise in editor

# The selected sketch elements and free meshes become a new component, with
# one instance in their place (Ctrl+G); a mesh becomes a solid part of it.
function make bim editor component in {a pointer to a bim editor record:editor}:
    execute:
        set gathered to an empty list of a 64 bit integer
        set meshIds to an empty list of a 64 bit integer
        loop cursor from 0 to the length of (editor's chosenSketches's values):
            set elementId to the item at cursor in (editor's chosenSketches's values)
            if (the bim sketch index of elementId in editor's documentValue's current)'s valid:
                append elementId to gathered
            if (the bim mesh index of elementId in editor's documentValue's current)'s valid:
                append elementId to meshIds
        if (((the length of gathered) + (the length of meshIds)) = 0) and (editor's selectionKind = bim sketch picked):
            append editor's selectionId to gathered
        if (((the length of gathered) + (the length of meshIds)) = 0) and (editor's selectionKind = bim mesh picked):
            append editor's selectionId to meshIds
        if ((the length of gathered) + (the length of meshIds)) = 0:
            set editor's message to the string form of "Make component: select sketch elements or meshes first (Shift adds)"
            free gathered
            free meshIds
            return nothing
        set title to (the string form of "Component ") + (the string form of ((the length of (editor's documentValue's current's components's values)) + 1))
        set target to the address of (editor's documentValue's current)
        begin bim transaction in (the address of (editor's documentValue))
        set placed to the bim refused id
        if (the length of gathered) > 0:
            set placed to make bim component named title from gathered on editor's levelId to target
        else:
            set lowX to 1e300
            set lowY to 1e300
            loop cursor from 0 to the length of meshIds:
                set meshValue to the item at (the bim mesh index of (the item at cursor in meshIds) in (@intrinsic("dereference", target)))'s position in (target's meshes's values)
                loop corner from 0 to the length of (meshValue's vertices's values):
                    set lowX to the minimum of lowX and (the item at corner in (meshValue's vertices's values))'s x
                    set lowY to the minimum of lowY and (the item at corner in (meshValue's vertices's values))'s y
            set fresh to add bim component named title to target
            set placed to place bim component fresh on editor's levelId at (a cad vector2 with x lowX and y lowY) turned 0.0 to target
        free gathered
        if placed = the bim refused id:
            roll back bim transaction in (the address of (editor's documentValue))
            free meshIds
            return nothing
        set placement to the item at (the bim instance index of placed in (@intrinsic("dereference", target)))'s position in (target's instances's values)
        set shift to a cad vector3 with x (0.0 - placement's origin's x), y (0.0 - placement's origin's y) and z 0.0
        loop cursor from 0 to the length of meshIds:
            ignore move bim mesh (the item at cursor in meshIds) into component placement's componentId shifted by shift as bim add operation in target
        free meshIds
        commit bim transaction in (the address of (editor's documentValue))
        set found to the bim instance index of placed in editor's documentValue's current
        set editor's placeComponentId to (the item at found's position in (editor's documentValue's current's instances's values))'s componentId
        set editor's chosenSketches to a cad topology list of a 64 bit integer
        select bim editor bim instance picked numbered placed in editor
        set editor's message to title + (the string form of ": made; Ctrl+I places more")

# The selected sketch elements made a component whose one instance is drawn
# in the plan view shown only: a 2D detail component (DC).
function make bim editor detail component in {a pointer to a bim editor record:editor}:
    execute:
        if (the bim view index of editor's planViewId in editor's documentValue's current)'s valid = false:
            set editor's message to the string form of "Detail component: no plan view"
            return nothing
        make bim editor component in editor
        if editor's selectionKind != bim instance picked:
            return nothing
        begin bim transaction in (the address of (editor's documentValue))
        ignore set bim instance editor's selectionId view to editor's planViewId in (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to (the string form of "Detail component: drawn in this view only")

# Explodes the selected instance into free sketch elements (Ctrl+U).
function explode bim editor instance in {a pointer to a bim editor record:editor}:
    execute:
        # A wall of a layered type explodes into a wall per layer.
        if editor's selectionKind = bim wall picked:
            begin bim transaction in (the address of (editor's documentValue))
            set wallPieces to explode bim wall editor's selectionId in (the address of (editor's documentValue's current))
            if wallPieces = 0:
                roll back bim transaction in (the address of (editor's documentValue))
                set editor's message to the string form of "Explode: the wall has one layer, openings or a curve"
                return nothing
            commit bim transaction in (the address of (editor's documentValue))
            select bim editor bim nothing picked numbered (the bim refused id) in editor
            set editor's message to (the string form of "Exploded into ") + ((the string form of wallPieces) + (the string form of " walls, one per layer"))
            return nothing
        # A plate of a layered type explodes into a plate per layer.
        if editor's selectionKind = bim slab picked:
            begin bim transaction in (the address of (editor's documentValue))
            set pieces to explode bim plate editor's selectionId in (the address of (editor's documentValue's current))
            if pieces = 0:
                roll back bim transaction in (the address of (editor's documentValue))
                set editor's message to the string form of "Explode: the plate has one layer or through-openings"
                return nothing
            commit bim transaction in (the address of (editor's documentValue))
            select bim editor bim nothing picked numbered (the bim refused id) in editor
            set editor's message to (the string form of "Exploded into ") + ((the string form of pieces) + (the string form of " plates, one per layer"))
            return nothing
        if editor's selectionKind != bim instance picked:
            set editor's message to the string form of "Explode: select an instance or a layered plate"
            return nothing
        begin bim transaction in (the address of (editor's documentValue))
        set made to explode bim instance editor's selectionId in (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        select bim editor bim nothing picked numbered (the bim refused id) in editor
        set editor's message to (the string form of "Exploded into ") + ((the string form of made) + (the string form of " elements"))

# Opens the selected instance's component for editing (Ctrl+E): its parts
# become free sketch elements where the instance is, and the instance steps
# aside until the component is closed again.
function open bim editor component in {a pointer to a bim editor record:editor}:
    execute:
        if editor's editingInstanceId != the bim refused id:
            return nothing
        if editor's selectionKind != bim instance picked:
            set editor's message to the string form of "Edit component: select an instance"
            return nothing
        set target to the address of (editor's documentValue's current)
        set found to the bim instance index of editor's selectionId in (@intrinsic("dereference", target))
        set placement to the item at found's position in (target's instances's values)
        set definitionFound to the bim component index of placement's componentId in (@intrinsic("dereference", target))
        set definition to the item at definitionFound's position in (target's components's values)
        begin bim transaction in (the address of (editor's documentValue))
        set editor's editingInstanceId to placement's id
        set editor's editingComponentId to placement's componentId
        set editor's editingOrigin to placement's origin
        set editor's editingAngle to placement's angle
        set editor's editingViewId to placement's viewId
        set editor's editingFirstId to target's nextId
        set editor's editingParts to a cad topology list of a 64 bit integer
        loop part from 0 to the length of (definition's sketches's values):
            set shown to the bim sketch (the item at part in (definition's sketches's values)) placed by placement
            set fresh to the bim new id in target
            append (@intrinsic("construct", a bim sketch record, fresh, placement's levelId, shown's kind, shown's points, shown's height, shown's content)) to (target's sketches's values)
            append fresh to (editor's editingParts's values)
            note bim change of fresh in target
        ignore delete bim instance placement's id from target
        commit bim transaction in (the address of (editor's documentValue))
        select bim editor bim nothing picked numbered (the bim refused id) in editor
        set editor's message to ((the string form of "Editing ") + definition's name) + (the string form of ": Ctrl+E closes it, every instance follows")

# Closes the component being edited: the sketch elements made while it was
# open (its parts and any new ones on its storey) become its contents again,
# in its own coordinates, and its instance returns.
function close bim editor component in {a pointer to a bim editor record:editor}:
    execute:
        if editor's editingInstanceId = the bim refused id:
            return nothing
        set target to the address of (editor's documentValue's current)
        set parts to an empty list of a bim sketch record
        set doomed to an empty list of a 64 bit integer
        set levelId to editor's levelId
        loop cursor from 0 to the length of (target's sketches's values):
            set element to the item at cursor in (target's sketches's values)
            set member to element's id >= editor's editingFirstId
            if member:
                set relative to a cad topology list of a cad vector2
                loop corner from 0 to the length of (element's points's values):
                    append (the bim component coordinates of (the item at corner in (element's points's values)) at editor's editingOrigin turned editor's editingAngle) to (relative's values)
                append (@intrinsic("construct", a bim sketch record, element's id, 0 as a 64 bit integer, element's kind, relative, element's height, element's content)) to parts
                append element's id to doomed
                set levelId to element's levelId
        begin bim transaction in (the address of (editor's documentValue))
        loop cursor from 0 to the length of doomed:
            ignore delete bim sketch (the item at cursor in doomed) from target
        ignore set bim component editor's editingComponentId contents to parts in target
        set back to @intrinsic("construct", a bim instance record, editor's editingInstanceId, editor's editingComponentId, levelId, editor's editingOrigin, editor's editingAngle, editor's editingViewId)
        set slot to the bim insertion position of back's id among (target's instances's values)
        insert back into (target's instances's values) at index slot
        note bim change of back's id in target
        commit bim transaction in (the address of (editor's documentValue))
        free parts
        free doomed
        set editor's message to the string form of "Component closed"
        set editor's editingInstanceId to the bim refused id
        set editor's editingParts to a cad topology list of a 64 bit integer
        select bim editor bim instance picked numbered back's id in editor

# The edge of `ring` that `location` lies on (within a micrometre), or -1.
function the bim edge of {a pointer to a list:ring} under {cad vector2:location}:
    execute:
        set count to the length of ring
        loop cursor from 0 to count:
            set here to the item at cursor in ring
            set following to the item at (the remainder of (cursor + 1) divided by count) in ring
            if (the cad distance from location to the segment from here to following) <= 1e-6:
                return cursor
        return -1

# The faces of the active storey that the line from `first` to `second`
# crosses from edge to edge are split in two along it, as in SketchUp; a mass
# keeps its height on both parts. Returns how many faces were split.
function split bim editor faces along {cad vector2:first} to {cad vector2:second} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set middle to a cad vector2 with x ((first's x + second's x) * 0.5) and y ((first's y + second's y) * 0.5)
        set candidates to an empty list of a 64 bit integer
        loop cursor from 0 to the length of (target's sketches's values):
            set element to the item at cursor in (target's sketches's values)
            if ((element's levelId = editor's levelId) and (element's kind = bim face sketch)) and (bim flat point middle lies in (element's points's values)):
                set allowed to true
                if editor's tool = bim split tool:
                    set allowed to (editor's selectionKind = bim sketch picked) and (editor's selectionId = element's id)
                if allowed:
                    append element's id to candidates
        set splitCount to 0
        loop candidateCursor from 0 to the length of candidates:
            set faceId to the item at candidateCursor in candidates
            set found to the bim sketch index of faceId in (@intrinsic("dereference", target))
            set element to the item at found's position in (target's sketches's values)
            set ring to element's points's values
            set firstEdge to the bim edge of ring under first
            set secondEdge to the bim edge of ring under second
            if ((firstEdge >= 0) and (secondEdge >= 0)) and (firstEdge != secondEdge):
                # The outline with both cut points in it, and where they sit.
                set cut to an empty list of a cad vector2
                set firstAt to -1
                set secondAt to -1
                loop corner from 0 to the length of ring:
                    set here to the item at corner in ring
                    if (the cad distance from here to first) <= 1e-6:
                        set firstAt to the length of cut
                    if (the cad distance from here to second) <= 1e-6:
                        set secondAt to the length of cut
                    append here to cut
                    set following to the item at (the remainder of (corner + 1) divided by (the length of ring)) in ring
                    if (corner = firstEdge) and (((the cad distance from first to here) > 1e-6) and ((the cad distance from first to following) > 1e-6)):
                        set firstAt to the length of cut
                        append first to cut
                    if (corner = secondEdge) and (((the cad distance from second to here) > 1e-6) and ((the cad distance from second to following) > 1e-6)):
                        set secondAt to the length of cut
                        append second to cut
                set onePart to an empty list of a cad vector2
                set otherPart to an empty list of a cad vector2
                set step to firstAt
                set walking to true
                loop while walking:
                    append (the item at step in cut) to onePart
                    if step = secondAt:
                        set walking to false
                    set step to the remainder of (step + 1) divided by (the length of cut)
                set step to secondAt
                set walking to true
                loop while walking:
                    append (the item at step in cut) to otherPart
                    if step = firstAt:
                        set walking to false
                    set step to the remainder of (step + 1) divided by (the length of cut)
                set validCut to (bim outline onePart is simple) and (bim outline otherPart is simple)
                set oldArea to the absolute value of (the cad signed area of ring)
                set splitArea to (the absolute value of (the cad signed area of onePart)) + (the absolute value of (the cad signed area of otherPart))
                if (the absolute value of (splitArea - oldArea)) > (1e-7 * (the maximum of 1.0 and oldArea)):
                    set validCut to false
                if validCut:
                    set rise to element's height
                    ignore delete bim sketch faceId from target
                    set oneId to add bim face on editor's levelId around onePart to target
                    set otherId to add bim face on editor's levelId around otherPart to target
                    if rise > 0.0:
                        ignore set bim face oneId height to rise in target
                        ignore set bim face otherId height to rise in target
                    set splitCount to splitCount + 1
                free onePart
                free otherPart
                free cut
        free candidates
        return splitCount

# A pointer near an outline is projected onto its nearest edge. This keeps
# the same snapping tolerance as picking while giving the splitter exact ends.
function the bim split edge point of {bim sketch record:faceValue} near {cad vector2:pointValue} within {a 64 bit floating-point number:tolerance}:
    execute:
        set result to @intrinsic("construct", a bim snap candidate record, pointValue, the string form of "Edge", 0, tolerance, false, 0)
        set bestGap to tolerance
        set ring to faceValue's points's values
        loop corner from 0 to the length of ring:
            set firstSpot to the item at corner in ring
            set lastSpot to the item at (the remainder of (corner + 1) divided by (the length of ring)) in ring
            set dx to lastSpot's x - firstSpot's x
            set dy to lastSpot's y - firstSpot's y
            set squared to (dx * dx) + (dy * dy)
            if squared > 1e-16:
                set fraction to ((((pointValue's x - firstSpot's x) * dx) + ((pointValue's y - firstSpot's y) * dy)) / squared) clamped between 0.0 and 1.0
                set projected to a cad vector2 with x (firstSpot's x + (fraction * dx)) and y (firstSpot's y + (fraction * dy))
                set gap to the cad distance from pointValue to projected
                if gap <= bestGap:
                    set bestGap to gap
                    set result's point to projected
                    set result's found to true
        return result

function press bim editor split at {cad vector2:pointValue} in {a pointer to a bim editor record:editor}:
    execute:
        if (bim category bim mass category is visible in editor's planRules) = false:
            set editor's message to the string form of "Split: show sketch faces and masses in this view first"
            return nothing
        set chosenId to the bim refused id
        set snapped to pointValue
        set bestGap to editor's pickTolerance
        loop cursor from 0 to the length of (editor's documentValue's current's sketches's values):
            set faceValue to the item at cursor in (editor's documentValue's current's sketches's values)
            set allowed to ((faceValue's kind = bim face sketch) and (faceValue's levelId = editor's levelId)) and (faceValue's height >= 0.0)
            if editor's selectionKind = bim sketch picked:
                set allowed to allowed and (faceValue's id = editor's selectionId)
            if allowed:
                set edgePoint to the bim split edge point of faceValue near pointValue within bestGap
                if edgePoint's found:
                    set chosenId to faceValue's id
                    set snapped to edgePoint's point
                    set bestGap to the cad distance from pointValue to snapped
        if chosenId = the bim refused id:
            set editor's message to the string form of "Split: click an edge of a flat face or positive-height sketch mass"
            return nothing
        if (the length of (editor's sketchChain's values)) = 0:
            select bim editor bim sketch picked numbered chosenId in editor
            append snapped to (editor's sketchChain's values)
            set editor's message to the string form of "Split: click another edge of the same face; Esc cancels"
            return nothing
        set startSpot to the item at 0 in (editor's sketchChain's values)
        begin bim transaction in (the address of (editor's documentValue))
        set madeCount to split bim editor faces along startSpot to snapped in editor
        if madeCount > 0:
            commit bim transaction in (the address of (editor's documentValue))
            select bim editor bim nothing picked numbered (the bim refused id) in editor
            set editor's sketchChain to a cad topology list of a cad vector2
            set editor's viewsDirty to true
            set editor's message to the string form of "Face split; pick two edges for another split"
        else:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Split refused: choose a different edge across the face"

# The next line of the sketch chain, to `point`. Returning to the chain's
# first point closes it: the loop becomes a face, as in SketchUp.
function add bim editor sketch line to {cad vector2:point} in {a pointer to a bim editor record:editor}:
    execute:
        set chain to editor's sketchChain's values
        set last to the item at ((the length of chain) - 1) in chain
        if (the cad distance from last to point) <= 1e-6:
            return nothing
        begin bim transaction in (the address of (editor's documentValue))
        set fresh to add bim line on editor's levelId from last to point to (the address of (editor's documentValue's current))
        if fresh = the bim refused id:
            roll back bim transaction in (the address of (editor's documentValue))
            return nothing
        set closing to ((the length of chain) >= 3) and ((the cad distance from point to (the item at 0 in chain)) <= 1e-6)
        if closing:
            set faceId to add bim face on editor's levelId around chain to (the address of (editor's documentValue's current))
            set editor's sketchChain to a cad topology list of a cad vector2
            if faceId = the bim refused id:
                set editor's message to the string form of "Lines closed, but they cross: no face"
            else:
                set editor's message to (the string form of "Face ") + (the string form of faceId)
        else:
            append point to (editor's sketchChain's values)
            set editor's message to (the string form of "Line ") + (the string form of fresh)
            set splitCount to split bim editor faces along last to point in editor
            if splitCount > 0:
                set editor's message to (the string form of "Line ") + ((the string form of fresh) + (the string form of ": face split in two"))
                set editor's sketchChain to a cad topology list of a cad vector2
        commit bim transaction in (the address of (editor's documentValue))

# A rectangle from corner `first` to the opposite corner `second`: its four
# lines and its face.
function add bim editor rectangle from {cad vector2:first} to {cad vector2:second} in {a pointer to a bim editor record:editor}:
    execute:
        if ((the absolute value of (second's x - first's x)) <= 1e-6) or ((the absolute value of (second's y - first's y)) <= 1e-6):
            set editor's message to the string form of "A rectangle needs a width and a depth"
            return nothing
        set corners to an empty list of a cad vector2
        append first to corners
        append (a cad vector2 with x second's x and y first's y) to corners
        append second to corners
        append (a cad vector2 with x first's x and y second's y) to corners
        set target to the address of (editor's documentValue's current)
        begin bim transaction in (the address of (editor's documentValue))
        loop side from 0 to 4:
            ignore add bim line on editor's levelId from (the item at side in corners) to (the item at (the remainder of (side + 1) divided by 4) in corners) to target
        set faceId to add bim face on editor's levelId around corners to target
        commit bim transaction in (the address of (editor's documentValue))
        free corners
        set editor's message to (the string form of "Rectangle, face ") + (the string form of faceId)

# Marks the open edit as changed, so that the views follow it before it is
# committed.
function show bim editor preview in {a pointer to a bim editor record:editor}:
    execute:
        set editor's documentValue's revision to editor's documentValue's revision + (1 as a 64 bit integer)

# Whether mesh `meshId` is still sound compared with the snapshot of the
# open transaction (see `bim mesh stays sound after`).
function bim editor mesh {a 64 bit integer:meshId} stays sound in {bim editor record:editor}:
    execute:
        set stack to editor's documentValue's undoStack's values
        set nowFound to the bim mesh index of meshId in editor's documentValue's current
        if ((the length of stack) = 0) or (nowFound's valid = false):
            return true
        set original to the item at ((the length of stack) - 1) in stack
        set beforeFound to the bim mesh index of meshId in original
        if beforeFound's valid = false:
            return true
        return bim mesh (the item at nowFound's position in (editor's documentValue's current's meshes's values)) stays sound after (the item at beforeFound's position in (original's meshes's values))

function finish bim editor push in {a pointer to a bim editor record:editor}:
    execute:
        if editor's pushFace >= 0:
            # Pushed through the far side, or turned inside out: refused.
            if (bim editor mesh editor's pushId stays sound in (@intrinsic("dereference", editor))) = false:
                roll back bim transaction in (the address of (editor's documentValue))
                set editor's message to the string form of "Refused: the face would pass through the mesh"
                set editor's pushId to the bim refused id
                set editor's pushFace to -1
                set editor's numeric to the string form of ""
                return nothing
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Pushed the face"
            set editor's pushId to the bim refused id
            set editor's pushFace to -1
            set editor's numeric to the string form of ""
            return nothing
        set found to the bim sketch index of editor's pushId in editor's documentValue's current
        if (editor's pushEdge >= 0) and found's valid:
            set pushed to the item at found's position in (editor's documentValue's current's sketches's values)
            # Pulled in past its far side, a face turns inside out: refused.
            set stack to editor's documentValue's undoStack's values
            set before to (the item at found's position in (editor's documentValue's current's sketches's values))'s points's values
            if (the length of stack) > 0:
                set snapshot to the item at ((the length of stack) - 1) in stack
                set beforeFound to the bim sketch index of editor's pushId in snapshot
                if beforeFound's valid:
                    set before to (the item at beforeFound's position in (snapshot's sketches's values))'s points's values
            set turnedOver to ((the cad signed area of (pushed's points's values)) * (the cad signed area of before)) <= 0.0
            if turnedOver or ((bim outline (pushed's points's values) is simple) = false):
                roll back bim transaction in (the address of (editor's documentValue))
                set editor's message to the string form of "Refused: the face would cross itself"
                set editor's pushId to the bim refused id
                set editor's pushEdge to -1
                set editor's numeric to the string form of ""
                return nothing
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Pushed the side"
            set editor's pushId to the bim refused id
            set editor's pushEdge to -1
            set editor's numeric to the string form of ""
            return nothing
        commit bim transaction in (the address of (editor's documentValue))
        if found's valid:
            set rise to (the item at found's position in (editor's documentValue's current's sketches's values))'s height
            set editor's message to (the string form of "Push/pull to ") + (the bim length rise in units editor's lengthUnit)
        set editor's pushId to the bim refused id
        set editor's numeric to the string form of ""

# True while a value is being typed: a property, a grab's or a move's
# distance, or a length while drawing, pushing, rotating or offsetting.
function bim editor takes a typed value {bim editor record:editor}:
    execute:
        if (editor's propertyCode >= 0) or editor's grabbing:
            return true
        if (editor's tool = bim push tool) and (editor's pushId != the bim refused id):
            return true
        if (editor's tool = bim wall tool) and editor's chainActive:
            return true
        if ((editor's tool = bim rotate tool) and (editor's moveStage >= 2)) or (editor's tool = bim offset tool):
            return true
        return (editor's tool = bim solid tool) and (editor's moveStage = 2)

# Types character `code` into the text being written; while a value is
# typed, the characters of a sum (= + * / and brackets) go into it.
function type bim editor character {integer:code} in {a pointer to a bim editor record:editor}:
    execute:
        set summing to ((((code = 61) or (code = 43)) or (code = 42)) or (code = 47)) or ((code = 40) or (code = 41))
        if summing and (bim editor takes a typed value (@intrinsic("dereference", editor))):
            set symbol to a new string buffer containing 1 bytes
            store (code as a byte) into the data of symbol at 0
            if editor's propertyCode >= 0:
                set editor's propertyText to editor's propertyText + symbol
            else:
                set editor's numeric to editor's numeric + symbol
            return nothing
        if ((editor's tool = bim text tool) and editor's textActive) and ((code >= 32) and (code < 127)):
            set letter to a new string buffer containing 1 bytes
            store (code as a byte) into the data of letter at 0
            set editor's textBuffer to editor's textBuffer + letter

function select bim editor element at {cad vector2:location} in {a pointer to a bim editor record:editor}:
    execute:
        # A grid's head first: its circle is 11 pixels round its end, the
        # pick tolerance 8.
        set headGrid to the bim grid head near location in (@intrinsic("dereference", editor)) within (editor's pickTolerance * 1.4)
        if headGrid != the bim refused id:
            select bim editor bim grid picked numbered headGrid in editor
            return nothing
        # Visible datum lines take precedence over overlapping model faces.
        set lineGrid to the bim grid near location in (@intrinsic("dereference", editor)) within editor's pickTolerance
        if lineGrid != the bim refused id:
            select bim editor bim grid picked numbered lineGrid in editor
            return nothing
        loop nodeCursor from 0 to the length of (editor's documentValue's current's connections's values):
            set nodeValue to the item at nodeCursor in (editor's documentValue's current's connections's values)
            if (nodeValue's levelId = editor's levelId) and ((bim editor hides (nodeValue's id) in plan of (@intrinsic("dereference", editor))) = false):
                set primary to the item at 0 in (nodeValue's members's values)
                set memberFound to the bim linear index of primary's elementId in editor's documentValue's current
                if memberFound's valid:
                    set memberValue to the item at memberFound's position in (editor's documentValue's current's linears's values)
                    set anchor to memberValue's start
                    if primary's end = 1:
                        set anchor to memberValue's finish
                    if (the cad distance from location to (a cad vector2 with x anchor's x and y anchor's y)) < (editor's pickTolerance * 2.0):
                        select bim editor 31 numbered nodeValue's id in editor
                        return nothing
        loop reinforcementCursor from 0 to the length of (editor's documentValue's current's reinforcements's values):
            set spec to the bim hostbound reinforcement (the item at reinforcementCursor in (editor's documentValue's current's reinforcements's values)) in editor's documentValue's current
            if (spec's levelId = editor's levelId) and ((bim editor hides (spec's id) in plan of (@intrinsic("dereference", editor))) = false):
                set generated to the bim reinforcement paths of spec in editor's documentValue's current
                loop barCursor from 0 to the length of (generated's bars's values):
                    set itemValue to the item at barCursor in (generated's bars's values)
                    loop edge from 0 to ((the length of (itemValue's points's values)) - 1):
                        set firstPoint to the item at edge in (itemValue's points's values)
                        set lastPoint to the item at (edge + 1) in (itemValue's points's values)
                        set firstPlan to a cad vector2 with x firstPoint's x and y firstPoint's y
                        set lastPlan to a cad vector2 with x lastPoint's x and y lastPoint's y
                        if (the cad distance from location to the segment from firstPlan to lastPlan) <= editor's pickTolerance:
                            select bim editor 30 numbered spec's id in editor
                            return nothing
        set modelValue to editor's documentValue's current
        if bim category bim space category is visible in editor's planRules:
            loop cursor from 0 to the length of (modelValue's spaceObjects's values):
                set spaceValue to the item at cursor in (modelValue's spaceObjects's values)
                if spaceValue's levelId = editor's levelId:
                    set tagPoint to a bim point inside (spaceValue's outline's values)
                    if ((the absolute value of (location's x - tagPoint's x)) <= (editor's pickTolerance * 5.0)) and ((the absolute value of (location's y - tagPoint's y)) <= (editor's pickTolerance * 1.5)):
                        select bim editor bim space object picked numbered spaceValue's id in editor
                        return nothing
        # A room's tag (its area label, about 60 by 13 pixels round the
        # point the plan writes it at) before what lies under it.
        if bim category bim space category is visible in editor's planRules:
            loop cursor from 0 to the length of (editor's spaces's values):
                set regionValue to the item at cursor in (editor's spaces's values)
                set tagPoint to a bim point inside (regionValue's outline's values)
                if (((the absolute value of (location's x - tagPoint's x)) <= (editor's pickTolerance * 5.0)) and ((the absolute value of (location's y - tagPoint's y)) <= (editor's pickTolerance * 1.5))) and ((bim region regionValue has an explicit space in modelValue) = false):
                    select bim editor bim space picked numbered (the bim identity of regionValue) in editor
                    return nothing
        set sketchId to the bim sketch at location in (@intrinsic("dereference", editor)) within editor's pickTolerance
        if sketchId != the bim refused id:
            select bim editor bim sketch picked numbered sketchId in editor
            return nothing
        set meshId to the bim mesh at location in (@intrinsic("dereference", editor)) within editor's pickTolerance
        if meshId != the bim refused id:
            select bim editor bim mesh picked numbered meshId in editor
            return nothing
        set linearId to the bim linear at location in (@intrinsic("dereference", editor)) within editor's pickTolerance
        if linearId != the bim refused id:
            select bim editor bim linear picked numbered linearId in editor
            return nothing
        set curtainId to the bim curtain at location in (@intrinsic("dereference", editor)) within (editor's pickTolerance * 2.0)
        if curtainId != the bim refused id:
            # A click on a building system chooses its part there, at the
            # plan's cut height (Esc: the whole system).
            choose bim editor part of system curtainId seen at (a cad vector3 with x location's x, y location's y and z (the bim plan cut height of (@intrinsic("dereference", editor)))) in editor
            return nothing
        set railingId to the bim railing at location in (@intrinsic("dereference", editor)) within (editor's pickTolerance * 2.0)
        if railingId != the bim refused id:
            select bim editor bim railing picked numbered railingId in editor
            return nothing
        set stairId to the bim stair at location in (@intrinsic("dereference", editor))
        if stairId != the bim refused id:
            select bim editor bim stair picked numbered stairId in editor
            return nothing
        if editor's hoverWall != the bim refused id:
            set host to the item at (the bim wall index of editor's hoverWall in modelValue)'s position in (modelValue's walls's values)
            set along to the bim offset along host nearest location
            loop cursor from 0 to the length of (modelValue's openings's values):
                set openingValue to the item at cursor in (modelValue's openings's values)
                set openingHidden to bim editor hides (openingValue's id) in plan of (@intrinsic("dereference", editor))
                if ((openingValue's hostId = host's id) and (bim category (the bim category of element openingValue's id in modelValue) is visible in editor's planRules)) and (openingHidden = false):
                    set typeFound to the bim opening type index of openingValue's typeId in modelValue
                    if typeFound's valid:
                        set halfWidth to (the bim rough width of (the item at typeFound's position in (modelValue's openingTypes's values))) * 0.5
                        if (the absolute value of (along - openingValue's offset)) <= halfWidth:
                            select bim editor bim opening picked numbered openingValue's id in editor
                            return nothing
            select bim editor bim wall picked numbered host's id in editor
            return nothing
        loop cursor from 0 to the length of (modelValue's slabs's values):
            set slabValue to the item at cursor in (modelValue's slabs's values)
            set slabHidden to bim editor hides (slabValue's id) in plan of (@intrinsic("dereference", editor))
            if (((slabValue's levelId = editor's levelId) and (bim category (the bim category of element slabValue's id in modelValue) is visible in editor's planRules)) and (bim slab slabValue has an edge near location within editor's pickTolerance)) and (slabHidden = false):
                select bim editor bim slab picked numbered slabValue's id in editor
                return nothing
        if bim category bim space category is visible in editor's planRules:
            loop cursor from 0 to the length of (modelValue's spaceObjects's values):
                set spaceValue to the item at cursor in (modelValue's spaceObjects's values)
                if (spaceValue's levelId = editor's levelId) and (bim ring (spaceValue's outline's values) encloses location):
                    select bim editor bim space object picked numbered spaceValue's id in editor
                    return nothing
        loop cursor from 0 to the length of (editor's spaces's values):
            set regionValue to the item at cursor in (editor's spaces's values)
            if ((bim category bim space category is visible in editor's planRules) and (bim ring (regionValue's outline's values) encloses location)) and ((bim region regionValue has an explicit space in modelValue) = false):
                select bim editor bim space picked numbered (the bim identity of regionValue) in editor
                return nothing
        select bim editor bim nothing picked numbered (the bim refused id) in editor

# The selected slab, when a slab is selected and still exists.
function the bim selected slab of {bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        if editor's selectionKind = bim slab picked:
            set found to the bim slab index of editor's selectionId in modelValue
            if found's valid:
                return @intrinsic("construct", a bim slab choice record, true, the item at found's position in (modelValue's slabs's values))
        return @intrinsic("construct", a bim slab choice record, false, @intrinsic("construct", a bim slab record, the bim refused id, the bim refused id, a cad topology list of a cad vector2, 0.0, the string form of "concrete", the bim refused id, 0.0, 0.0, 0.0))

# The corner of `slabValue` nearest to `location` within `tolerance`, or -1.
function the bim slab corner near {cad vector2:location} in {bim slab record:slabValue} within {a 64 bit floating-point number:tolerance}:
    execute:
        set best to -1
        set bestDistance to tolerance
        loop cursor from 0 to the length of (slabValue's outline's values):
            set gap to the cad distance from location to (the item at cursor in (slabValue's outline's values))
            if gap <= bestDistance:
                set best to cursor
                set bestDistance to gap
        return best

# The middle of edge `edgeIndex` of `slabValue`, from corner `edgeIndex` to
# the next.
function the bim middle of slab edge {integer:edgeIndex} of {bim slab record:slabValue}:
    execute:
        set here to the item at edgeIndex in (slabValue's outline's values)
        set following to the item at (the remainder of (edgeIndex + 1) divided by (the length of (slabValue's outline's values))) in (slabValue's outline's values)
        return a cad vector2 with x ((here's x + following's x) * 0.5) and y ((here's y + following's y) * 0.5)

# The edge of `slabValue` whose middle is nearest to `location` within
# `tolerance`, or -1.
function the bim slab edge middle near {cad vector2:location} in {bim slab record:slabValue} within {a 64 bit floating-point number:tolerance}:
    execute:
        set best to -1
        set bestDistance to tolerance
        loop cursor from 0 to the length of (slabValue's outline's values):
            set gap to the cad distance from location to (the bim middle of slab edge cursor of slabValue)
            if gap <= bestDistance:
                set best to cursor
                set bestDistance to gap
        return best

# `slabCorner` while an edge is dragged: this minus the edge's index.
function bim slab edge drag base:
    replacement:
        -10

# Fills `pushedCorners` with the outline of `slabValue` with edge `edgeIndex`
# moved across itself by the part of `shift` along its normal; its two
# corners slide along the edges before and after it so those keep their
# directions. False (and `pushedCorners` left empty) when a neighbouring edge
# runs parallel to it.
function fill bim outline of {bim slab record:slabValue} with edge {integer:edgeIndex} pushed by {cad vector2:shift} into {a pointer to a list:pushedCorners}:
    execute:
        set corners to slabValue's outline's values
        set count to the length of corners
        if count < 3:
            return false
        set here to the item at edgeIndex in corners
        set following to the item at (the remainder of (edgeIndex + 1) divided by count) in corners
        set run to the cad distance from here to following
        if run <= 1e-9:
            return false
        set nx to (0.0 - (following's y - here's y)) / run
        set ny to (following's x - here's x) / run
        set amount to (shift's x * nx) + (shift's y * ny)
        # The pushed edge's line and the lines of its neighbours meet at its
        # new corners.
        set before to the item at (the remainder of ((edgeIndex + count) - 1) divided by count) in corners
        set after to the item at (the remainder of (edgeIndex + 2) divided by count) in corners
        set edgeRun to a cad vector2 with x (following's x - here's x) and y (following's y - here's y)
        set newHere to the bim meeting point from before through here with (a cad vector2 with x (here's x + (amount * nx)) and y (here's y + (amount * ny))) along edgeRun
        set newFollowing to the bim meeting point from after through following with (a cad vector2 with x (following's x + (amount * nx)) and y (following's y + (amount * ny))) along edgeRun
        if (newHere's valid = false) or (newFollowing's valid = false):
            return false
        set followingIndex to the remainder of (edgeIndex + 1) divided by count
        loop cursor from 0 to count:
            if cursor = edgeIndex:
                append newHere's point to pushedCorners
            else if cursor = followingIndex:
                append newFollowing's point to pushedCorners
            else:
                append (the item at cursor in corners) to pushedCorners
        return true

class:
    patterns:
        [a|] bim meeting choice record
    members:
        valid as a boolean
        point as a cad vector2

# Where the line through `neighbour` and `cornerPoint` meets the line through
# `spot` running along `direction`.
function the bim meeting point from {cad vector2:neighbour} through {cad vector2:cornerPoint} with {cad vector2:spot} along {cad vector2:direction}:
    execute:
        set ex to cornerPoint's x - neighbour's x
        set ey to cornerPoint's y - neighbour's y
        set denominator to (ex * direction's y) - (ey * direction's x)
        if (the absolute value of denominator) <= 1e-12:
            return @intrinsic("construct", a bim meeting choice record, false, cornerPoint)
        set t to (((spot's x - neighbour's x) * direction's y) - ((spot's y - neighbour's y) * direction's x)) / denominator
        return @intrinsic("construct", a bim meeting choice record, true, a cad vector2 with x (neighbour's x + (t * ex)) and y (neighbour's y + (t * ey)))

# True when an edge of `slabValue` passes within `tolerance` of `location`.
function bim slab {bim slab record:slabValue} has an edge near {cad vector2:location} within {a 64 bit floating-point number:tolerance}:
    execute:
        set count to the length of (slabValue's outline's values)
        loop cursor from 0 to count:
            set here to the item at cursor in (slabValue's outline's values)
            set following to the item at (the remainder of (cursor + 1) divided by count) in (slabValue's outline's values)
            if (the cad distance from location to the segment from here to following) <= tolerance:
                return true
        return false

# The wall ends that move when wall `wallId` is dragged whole: both of its
# ends, and every end of another wall of its storey that meets one of them or
# lies on the wall (a T join), so its joins stay joined.
function the bim wall ends moving with {a 64 bit integer:wallId} in {bim editor record:editor}:
    execute:
        set walls to editor's documentValue's current's walls's values
        set moved to a cad topology list of a bim wall end record
        set found to the bim wall index of wallId in editor's documentValue's current
        if found's valid = false:
            return moved
        set dragged to the item at found's position in walls
        append (@intrinsic("construct", a bim wall end record, wallId, false, dragged's start)) to (moved's values)
        append (@intrinsic("construct", a bim wall end record, wallId, true, dragged's finish)) to (moved's values)
        loop cursor from 0 to the length of walls:
            set other to the item at cursor in walls
            if (other's id != wallId) and (other's levelId = dragged's levelId):
                if (the bim distance from other's start to the centreline of dragged) <= the bim join tolerance:
                    append (@intrinsic("construct", a bim wall end record, other's id, false, other's start)) to (moved's values)
                if (the bim distance from other's finish to the centreline of dragged) <= the bim join tolerance:
                    append (@intrinsic("construct", a bim wall end record, other's id, true, other's finish)) to (moved's values)
        return moved

# The ends of the walls on level `levelId` that meet at `location`.
function the bim wall ends meeting {cad vector2:location} on level {a 64 bit integer:levelId} in {bim editor record:editor}:
    execute:
        set found to a cad topology list of a bim wall end record
        loop cursor from 0 to the length of (editor's documentValue's current's walls's values):
            set wallValue to the item at cursor in (editor's documentValue's current's walls's values)
            if wallValue's levelId = levelId:
                if (the cad distance from location to wallValue's start) <= the bim join tolerance:
                    append (@intrinsic("construct", a bim wall end record, wallValue's id, false, wallValue's start)) to (found's values)
                if (the cad distance from location to wallValue's finish) <= the bim join tolerance:
                    append (@intrinsic("construct", a bim wall end record, wallValue's id, true, wallValue's finish)) to (found's values)
        return found

# A handle of the selection, as shown in the 3D view: an end of the selected
# wall (`corner` is -1) or a corner of the selected slab, at its level's
# elevation.
class:
    patterns:
        [a|] bim grip record
    members:
        location as a cad vector3
        wallId as a 64 bit integer
        atFinish as a boolean
        corner as an integer

# The `corner` of a grip on a wall's middle, which bends it.
function bim bend grip:
    replacement:
        -2
# `handleDrag` while the whole selection is dragged by its body (any
# element but a wall, whose ends drag with the walls joined to them).
function bim whole drag:
    replacement:
        -2
# The `corner` of a shape handle on control point `n` is this minus `n`.
function bim shape grip base:
    replacement:
        -10

function the bim elevation of level {a 64 bit integer:levelId} in {bim model record:modelValue}:
    execute:
        set found to the bim level index of levelId in modelValue
        if found's valid = false:
            return 0.0
        return (the item at found's position in (modelValue's levels's values))'s elevation

# The handles of the selected wall or slab; none for another selection.
function the bim grips of {bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        set handles to a cad topology list of a bim grip record
        if editor's selectionKind = bim wall picked:
            set found to the bim wall index of editor's selectionId in modelValue
            if found's valid:
                set wallValue to the item at found's position in (modelValue's walls's values)
                set elevation to the bim elevation of level wallValue's levelId in modelValue
                append (@intrinsic("construct", a bim grip record, (a cad vector3 with x wallValue's start's x, y wallValue's start's y and z elevation), wallValue's id, false, -1)) to (handles's values)
                append (@intrinsic("construct", a bim grip record, (a cad vector3 with x wallValue's finish's x, y wallValue's finish's y and z elevation), wallValue's id, true, -1)) to (handles's values)
                # The middle handle bends the wall.
                set middle to the bim middle of wall wallValue
                append (@intrinsic("construct", a bim grip record, (a cad vector3 with x middle's x, y middle's y and z elevation), wallValue's id, false, bim bend grip)) to (handles's values)
        # A building system's or linear element's shape handles: each of its
        # control points.
        if (editor's selectionKind = bim curtain picked) or (editor's selectionKind = bim linear picked):
            set lift to the bim handle lift of editor's selectionKind numbered editor's selectionId in modelValue
            set shapePoints to the bim handles of editor's selectionKind numbered editor's selectionId in modelValue
            loop cursor from 0 to the length of (shapePoints's values):
                set shapePoint to the item at cursor in (shapePoints's values)
                append (@intrinsic("construct", a bim grip record, (a cad vector3 with x shapePoint's x, y shapePoint's y and z (shapePoint's z + lift)), the bim refused id, false, bim shape grip base - cursor)) to (handles's values)
        set chosen to the bim selected slab of editor
        if chosen's valid:
            set elevation to the bim elevation of level chosen's slab's levelId in modelValue
            loop cursor from 0 to the length of (chosen's slab's outline's values):
                set point to the item at cursor in (chosen's slab's outline's values)
                append (@intrinsic("construct", a bim grip record, (a cad vector3 with x point's x, y point's y and z elevation), the bim refused id, false, cursor)) to (handles's values)
        return handles

# How high above the model's datum the control points (`the bim handles
# of`) of element `elementId` stand: its own storey's elevation.
function the bim handle lift of {integer:pickKind} numbered {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        if pickKind = bim curtain picked:
            set curtainFound to the bim curtain index of elementId in modelValue
            if curtainFound's valid:
                return the bim elevation of level (the item at curtainFound's position in (modelValue's curtains's values))'s levelId in modelValue
        if pickKind = bim linear picked:
            set linearFound to the bim linear index of elementId in modelValue
            if linearFound's valid:
                return the bim elevation of level (the item at linearFound's position in (modelValue's linears's values))'s levelId in modelValue
        return 0.0

# Whether the shape handle being dragged sets a height (a building system's
# transom or top): it is dragged up and down, not across the plan.
function bim editor drags a handle upright {bim editor record:editor}:
    execute:
        if (editor's handleDrag < 0) or (editor's selectionKind != bim curtain picked):
            return false
        set found to the bim curtain index of editor's selectionId in editor's documentValue's current
        if found's valid = false:
            return false
        return editor's handleDrag > (the bim bay count of (the item at found's position in (editor's documentValue's current's curtains's values)))

# The shape handle being dragged raised to `height` above the model's datum,
# where it stands in plan (a transom or a building system's top).
function raise bim editor handle drag to {a 64 bit floating-point number:height} in {a pointer to a bim editor record:editor}:
    execute:
        set stack to editor's documentValue's undoStack's values
        if (editor's handleDrag < 0) or ((the length of stack) = 0):
            return nothing
        set original to the item at ((the length of stack) - 1) in stack
        set before to the bim handles of editor's selectionKind numbered editor's selectionId in original
        set lift to the bim handle lift of editor's selectionKind numbered editor's selectionId in original
        set raised to an empty list of a cad vector3
        loop cursor from 0 to the length of (before's values):
            set controlPoint to the item at cursor in (before's values)
            if cursor = editor's handleDrag:
                set controlPoint to a cad vector3 with x controlPoint's x, y controlPoint's y and z (height - lift)
            append controlPoint to raised
        if set bim handles of editor's selectionKind numbered editor's selectionId to raised in (the address of (editor's documentValue's current)):
            set editor's dragMoved to true
            set editor's message to (the string form of "Height ") + (the bim length (height - lift) in units editor's lengthUnit)
        free raised

# Starts dragging handle `grip`: a wall end with every end of its storey that
# meets it, a wall's middle, which bends it, or a slab corner. The pointer then
# moves in plan coordinates.
function start bim editor drag of {bim grip record:grip} in {a pointer to a bim editor record:editor}:
    execute:
        set origin to a cad vector2 with x grip's location's x and y grip's location's y
        set editor's handleDrag to -1
        if grip's corner <= bim shape grip base:
            set editor's handleDrag to bim shape grip base - grip's corner
            set editor's slabCorner to -1
        else if grip's corner = bim bend grip:
            set editor's bendWallId to grip's wallId
            set editor's slabCorner to -1
        else if grip's corner >= 0:
            set editor's slabCorner to grip's corner
        else:
            set found to the bim wall index of grip's wallId in editor's documentValue's current
            if found's valid = false:
                return nothing
            set levelId to (the item at found's position in (editor's documentValue's current's walls's values))'s levelId
            set editor's dragEnds to the bim wall ends meeting origin on level levelId in (@intrinsic("dereference", editor))
            set editor's slabCorner to -1
        begin bim transaction in (the address of (editor's documentValue))
        set editor's dragOrigin to origin
        set editor's dragging to true
        set editor's dragMoved to false

# The elevations a new grid reaches: a metre below the lowest storey to a
# metre above the top of the highest.
function the bim grid reach of {bim model record:modelValue}:
    execute:
        set lowest to 0.0
        set highest to 3.0
        loop cursor from 0 to the length of (modelValue's levels's values):
            set levelValue to the item at cursor in (modelValue's levels's values)
            if cursor = 0:
                set lowest to levelValue's elevation
                set highest to levelValue's elevation + levelValue's height
            set lowest to the minimum of lowest and levelValue's elevation
            set highest to the maximum of highest and (levelValue's elevation + levelValue's height)
        return a cad vector2 with x (lowest - 1.0) and y (highest + 1.0)

# The name of a new grid from `startPoint` to `finishPoint`: grids running
# mostly north-south are numbered 1, 2, 3...; the others are lettered A, B,
# C..., after the grids of their kind that exist.
function the bim next grid name from {cad vector2:startPoint} to {cad vector2:finishPoint} in {bim model record:modelValue}:
    execute:
        set numbered to (the absolute value of (finishPoint's y - startPoint's y)) > (the absolute value of (finishPoint's x - startPoint's x))
        set alike to 0
        loop cursor from 0 to the length of (modelValue's grids's values):
            set other to the item at cursor in (modelValue's grids's values)
            set otherNumbered to (the absolute value of (other's finish's y - other's start's y)) > (the absolute value of (other's finish's x - other's start's x))
            if otherNumbered = numbered:
                set alike to alike + 1
        if numbered:
            return the string form of (alike + 1)
        set letter to a new string buffer containing 1 bytes
        store ((65 + (the remainder of alike divided by 26)) as a byte) into the data of letter at 0
        if alike >= 26:
            return letter + (the string form of ((alike / 26) + 1))
        return letter

# The grid whose line passes within `tolerance` of `location`, or the refused
# id; none while grids are hidden in the plan.
function the bim grid near {cad vector2:location} in {bim editor record:editor} within {a 64 bit floating-point number:tolerance}:
    execute:
        set best to the bim refused id
        set bestDistance to tolerance
        if (bim category bim grid category is visible in editor's planRules) = false:
            return best
        loop cursor from 0 to the length of (editor's documentValue's current's grids's values):
            set gridValue to the item at cursor in (editor's documentValue's current's grids's values)
            set gap to the cad distance from location to the segment from gridValue's start to gridValue's finish
            if (gap <= bestDistance) and ((bim editor hides (gridValue's id) in plan of editor) = false):
                set best to gridValue's id
                set bestDistance to gap
        return best

# The grid with a head (the circle at either end of its line) within
# `tolerance` of `location`, or the refused id; none while grids are hidden
# in the plan. A head is the grid's own: a line often runs under a column or
# a beam on it, which a click there takes first.
function the bim grid head near {cad vector2:location} in {bim editor record:editor} within {a 64 bit floating-point number:tolerance}:
    execute:
        set best to the bim refused id
        set bestDistance to tolerance
        if (bim category bim grid category is visible in editor's planRules) = false:
            return best
        loop cursor from 0 to the length of (editor's documentValue's current's grids's values):
            set gridValue to the item at cursor in (editor's documentValue's current's grids's values)
            set startGap to the cad distance from location to gridValue's start
            set finishGap to the cad distance from location to gridValue's finish
            set gap to the minimum of startGap and finishGap
            if (gap <= bestDistance) and ((bim editor hides (gridValue's id) in plan of editor) = false):
                set best to gridValue's id
                set bestDistance to gap
        return best

# The selected space, when a space is selected and still exists.
function the bim selected space of {bim editor record:editor}:
    execute:
        if editor's selectionKind = bim space object picked:
            set savedFound to the bim space object index of editor's selectionId in editor's documentValue's current
            if savedFound's valid:
                set savedRegion to the item at savedFound's position in (editor's documentValue's current's spaceObjects's values)
                set regionArea to the absolute value of (the cad signed area of (savedRegion's outline's values))
                set chosenRegion to @intrinsic("construct", a bim space record, savedRegion's levelId, a cad topology list of a 64 bit integer, savedRegion's outline, regionArea)
                return @intrinsic("construct", a bim space choice record, true, chosenRegion)
        loop cursor from 0 to the length of (editor's spaces's values):
            set candidate to the item at cursor in (editor's spaces's values)
            if (editor's selectionKind = bim space picked) and ((the bim identity of candidate) = editor's selectionId):
                return @intrinsic("construct", a bim space choice record, true, candidate)
        return @intrinsic("construct", a bim space choice record, false, @intrinsic("construct", a bim space record, the bim refused id, a cad topology list of a 64 bit integer, a cad topology list of a cad vector2, 0.0))

function the bim metres text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.2f", value)
        return the substring of buffer from 0 spanning written bytes

# ---------------------------------------------------------------- units

# `value` (metres) as a number in the units `unitCode`, without the unit.
function the bim number {a 64 bit floating-point number:value} in units {integer:unitCode}:
    execute:
        set text to the bim length value in units unitCode
        set space to the index of " " in text
        if space < 0:
            return text
        return the substring of text from 0 spanning space bytes

# The project's length units: millimetres, centimetres or metres. Lengths are
# kept in metres; the unit is how they are shown and how typed lengths are
# read. Areas are always shown in square metres.
function bim millimetre unit:
    replacement:
        0
function bim centimetre unit:
    replacement:
        1
function bim metre unit:
    replacement:
        2

function the bim metres per {integer:unitCode}:
    execute:
        if unitCode = bim millimetre unit:
            return 0.001
        if unitCode = bim centimetre unit:
            return 0.01
        return 1.0

function the bim name of unit {integer:unitCode}:
    execute:
        if unitCode = bim millimetre unit:
            return the string form of "mm"
        if unitCode = bim centimetre unit:
            return the string form of "cm"
        return the string form of "m"

# `value` (metres) in the units `unitCode`, with its unit: whole millimetres,
# centimetres to one decimal, or metres to two.
function the bim length {a 64 bit floating-point number:value} in units {integer:unitCode}:
    execute:
        set buffer to a new string buffer containing 40 bytes
        set written to 0
        if unitCode = bim millimetre unit:
            set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 41 as a word sized unsigned integer, "%.0f mm", value * 1000.0)
        else if unitCode = bim centimetre unit:
            set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 41 as a word sized unsigned integer, "%.1f cm", value * 100.0)
        else:
            set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 41 as a word sized unsigned integer, "%.2f m", value)
        return the substring of buffer from 0 spanning written bytes

# A one-line description of the selection; empty when nothing (still) exists.
function the bim selection description of {bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        if editor's selectionKind = 30:
            set rebarFound to the bim reinforcement index of editor's selectionId in modelValue
            if rebarFound's valid:
                return the reinforcement annotation of (the item at rebarFound's position in (modelValue's reinforcements's values))
        if editor's selectionKind = 31:
            set nodeFound to the bim connection index of editor's selectionId in modelValue
            if nodeFound's valid:
                set nodeValue to the item at nodeFound's position in (modelValue's connections's values)
                return nodeValue's name + ((the string form of " / members: ") + (the string form of (the length of (nodeValue's members's values))))
        if editor's selectionKind = bim instance picked:
            set found to the bim instance index of editor's selectionId in modelValue
            if found's valid = false:
                return the string form of ""
            set placement to the item at found's position in (modelValue's instances's values)
            set definition to the item at (the bim component index of placement's componentId in modelValue)'s position in (modelValue's components's values)
            set copies to 0
            loop cursor from 0 to the length of (modelValue's instances's values):
                if (the item at cursor in (modelValue's instances's values))'s componentId = placement's componentId:
                    set copies to copies + 1
            return ((the string form of "Instance ") + ((the string form of placement's id) + (the string form of " of "))) + (definition's name + ((the string form of ", ") + ((the string form of copies) + (the string form of " placed (Ctrl+E edits, Ctrl+U explodes)"))))
        if editor's selectionKind = bim linear picked:
            set linearFound to the bim linear index of editor's selectionId in modelValue
            if linearFound's valid = false:
                return the string form of ""
            set linearValue to the item at linearFound's position in (modelValue's linears's values)
            set linearType to the bim type of linear linearValue in modelValue
            set run to the cad length of (the cad difference of linearValue's finish and linearValue's start)
            return (((the bim name of linear role linearType's role) + (the string form of " ")) + (the string form of linearValue's id)) + (((the string form of ": ") + linearType's name) + ((the string form of ", length ") + (the bim length run in units editor's lengthUnit)))
        if editor's selectionKind = bim mesh picked:
            set meshFound to the bim mesh index of editor's selectionId in modelValue
            if meshFound's valid = false:
                return the string form of ""
            set meshValue to the item at meshFound's position in (modelValue's meshes's values)
            return ((the string form of "Mesh ") + (the string form of meshValue's id)) + (((the string form of ": ") + (the string form of (the length of (meshValue's vertices's values)))) + ((the string form of " points, ") + ((the string form of (the bim face count of mesh meshValue)) + (the string form of " faces (Tab edits its points, P pushes a face)"))))
        if editor's selectionKind = bim sketch picked:
            set sketchFound to the bim sketch index of editor's selectionId in modelValue
            if sketchFound's valid = false:
                return the string form of ""
            set sketch to the item at sketchFound's position in (modelValue's sketches's values)
            set label to (the string form of " ") + ((the string form of sketch's id) + (the string form of ": "))
            if sketch's kind = bim line sketch:
                return ((the string form of "Line") + label) + ((the string form of "length ") + (the bim length (the cad distance from (the item at 0 in (sketch's points's values)) to (the item at 1 in (sketch's points's values))) in units editor's lengthUnit))
            if sketch's kind = bim text sketch:
                return ((the string form of "Text") + label) + sketch's content
            set area to the absolute value of (the cad signed area of (sketch's points's values))
            if sketch's height > 0.0:
                return ((the string form of "Mass") + label) + ((the string form of "area ") + ((the bim metres text of area) + ((the string form of " m2, height ") + (the bim length sketch's height in units editor's lengthUnit))))
            return ((the string form of "Face") + label) + ((the string form of "area ") + ((the bim metres text of area) + (the string form of " m2 (P: push/pull)")))
        if editor's selectionKind = bim wall picked:
            set found to the bim wall index of editor's selectionId in modelValue
            if found's valid = false:
                return the string form of ""
            set wallValue to the item at found's position in (modelValue's walls's values)
            set typeName to the string form of "untyped"
            set typeFound to the bim wall type index of wallValue's typeId in modelValue
            if typeFound's valid:
                set typeName to (the item at typeFound's position in (modelValue's wallTypes's values))'s name
            set hostedCount to 0
            loop cursor from 0 to the length of (modelValue's openings's values):
                if (the item at cursor in (modelValue's openings's values))'s hostId = wallValue's id:
                    set hostedCount to hostedCount + 1
            set text to ((the string form of "Wall ") + (the string form of wallValue's id)) + (the string form of ": ")
            set text to ((text + typeName) + (the string form of " ")) + (the bim length (the bim wall thickness of wallValue in modelValue) in units editor's lengthUnit)
            set text to ((text + (the string form of ", length ")) + (the bim length (the bim centreline length of wallValue) in units editor's lengthUnit)) + (the string form of ", height ")
            set text to ((text + (the bim length wallValue's height in units editor's lengthUnit)) + (the string form of ", openings ")) + (the string form of hostedCount)
            set wallArc to the bim arc of wallValue
            if wallArc's curved:
                set text to (text + (the string form of ", radius ")) + (the bim length wallArc's radius in units editor's lengthUnit)
            return text
        if editor's selectionKind = bim opening picked:
            set found to the bim opening index of editor's selectionId in modelValue
            if found's valid = false:
                return the string form of ""
            set openingValue to the item at found's position in (modelValue's openings's values)
            set typeFound to the bim opening type index of openingValue's typeId in modelValue
            set text to ((the string form of "Opening ") + (the string form of openingValue's id)) + (the string form of ": ")
            if typeFound's valid:
                set openingType to the item at typeFound's position in (modelValue's openingTypes's values)
                set text to ((text + openingType's name) + (the string form of " ")) + (the bim number openingType's width in units editor's lengthUnit)
                set text to ((text + (the string form of " x ")) + (the bim length openingType's height in units editor's lengthUnit)) + (the string form of ", sill ")
                set text to (text + (the bim length openingType's sill in units editor's lengthUnit)) + (the string form of ", ")
            set text to ((text + (the string form of "in wall ")) + (the string form of openingValue's hostId)) + (the string form of " at ")
            return text + (the bim length openingValue's offset in units editor's lengthUnit)
        if editor's selectionKind = bim space object picked:
            set found to the bim space object index of editor's selectionId in modelValue
            if found's valid = false:
                return the string form of ""
            set spaceValue to the item at found's position in (modelValue's spaceObjects's values)
            set areaValue to the absolute value of (the cad signed area of (spaceValue's outline's values))
            set text to (the string form of "Space ") + (the bim tag text of spaceValue's id in modelValue)
            return (text + (the string form of ": ")) + ((the bim area text of areaValue) + (the string form of " m2"))
        if editor's selectionKind = bim space picked:
            set chosen to the bim selected space of editor
            if chosen's valid = false:
                return the string form of ""
            set text to ((the string form of "Space: ") + (the bim metres text of chosen's space's area)) + (the string form of " m2, bounded by ")
            return (text + (the string form of (the length of (chosen's space's boundingWalls's values)))) + (the string form of " walls")
        if editor's selectionKind = bim level picked:
            set found to the bim level index of editor's selectionId in modelValue
            if found's valid = false:
                return the string form of ""
            set levelValue to the item at found's position in (modelValue's levels's values)
            return ((the string form of "Level ") + levelValue's name) + ((the string form of ": ") + ((the bim length levelValue's elevation in units editor's lengthUnit) + (the string form of " (click its label to type its height)")))
        if editor's selectionKind = bim grid picked:
            set found to the bim grid index of editor's selectionId in modelValue
            if found's valid = false:
                return the string form of ""
            set gridValue to the item at found's position in (modelValue's grids's values)
            set text to ((the string form of "Grid ") + gridValue's name) + (the string form of ": length ")
            return text + (the bim length (the cad distance from gridValue's start to gridValue's finish) in units editor's lengthUnit)
        if editor's selectionKind = bim slab picked:
            set found to the bim slab index of editor's selectionId in modelValue
            if found's valid = false:
                return the string form of ""
            set slabValue to the item at found's position in (modelValue's slabs's values)
            set text to ((the string form of "Slab ") + (the string form of slabValue's id)) + (the string form of ": thickness ")
            set text to ((text + (the bim length slabValue's thickness in units editor's lengthUnit)) + (the string form of ", area ")) + (the bim metres text of (the bim slab area of slabValue))
            return (text + (the string form of " m2, corners ")) + (the string form of (the length of (slabValue's outline's values)))
        return the string form of ""

function add bim library planar type {a string:typeName} as role {integer:roleCode} of {a string:firstMaterial} {a 64 bit floating-point number:firstThickness} and {a string:secondMaterial} {a 64 bit floating-point number:secondThickness} to {a pointer to a bim model record:target}:
    execute:
        set layerValues to an empty list of a bim layer record
        append (@intrinsic("construct", a bim layer record, firstMaterial, firstThickness)) to layerValues
        if secondThickness > 0.0:
            append (@intrinsic("construct", a bim layer record, secondMaterial, secondThickness)) to layerValues
        ignore add bim planar type named typeName as role roleCode with layerValues to target
        free layerValues

# The planar types of floors, roofs and ceilings every model starts with
# (Open 2D Studio's floor types among them), added once as one edit when a
# model has no floor type.
function ensure bim plate types in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set hasFloor to false
        set hasRoof to false
        set hasCeiling to false
        loop cursor from 0 to the length of (target's wallTypes's values):
            set roleCode to (the item at cursor in (target's wallTypes's values))'s role
            if roleCode = bim floor planar role:
                set hasFloor to true
            if roleCode = bim roof planar role:
                set hasRoof to true
            if roleCode = bim ceiling planar role:
                set hasCeiling to true
        if (hasFloor and hasRoof) and hasCeiling:
            return nothing
        begin bim transaction in (the address of (editor's documentValue))
        if hasFloor = false:
            add bim library planar type (the string form of "Vloer beton 150") as role bim floor planar role of (the string form of "concrete") 0.15 and (the string form of "") 0.0 to target
            add bim library planar type (the string form of "Vloer beton 200") as role bim floor planar role of (the string form of "concrete") 0.2 and (the string form of "") 0.0 to target
            add bim library planar type (the string form of "Vloer beton 250") as role bim floor planar role of (the string form of "concrete") 0.25 and (the string form of "") 0.0 to target
            add bim library planar type (the string form of "Vloer beton 300") as role bim floor planar role of (the string form of "concrete") 0.3 and (the string form of "") 0.0 to target
            add bim library planar type (the string form of "Kanaalplaat 200") as role bim floor planar role of (the string form of "hollow-core concrete") 0.2 and (the string form of "") 0.0 to target
            add bim library planar type (the string form of "Kanaalplaat 260") as role bim floor planar role of (the string form of "hollow-core concrete") 0.26 and (the string form of "") 0.0 to target
            add bim library planar type (the string form of "Kanaalplaat 320") as role bim floor planar role of (the string form of "hollow-core concrete") 0.32 and (the string form of "") 0.0 to target
            add bim library planar type (the string form of "Vloer hout 200") as role bim floor planar role of (the string form of "timber") 0.2 and (the string form of "") 0.0 to target
        if hasRoof = false:
            add bim library planar type (the string form of "Plat dak beton") as role bim roof planar role of (the string form of "insulation PIR") 0.12 and (the string form of "concrete") 0.2 to target
            add bim library planar type (the string form of "Hellend dak hout") as role bim roof planar role of (the string form of "insulation") 0.15 and (the string form of "timber") 0.05 to target
        if hasCeiling = false:
            add bim library planar type (the string form of "Plafond gips 12.5") as role bim ceiling planar role of (the string form of "gypsum") 0.0125 and (the string form of "") 0.0 to target
            add bim library planar type (the string form of "Systeemplafond") as role bim ceiling planar role of (the string form of "gypsum") 0.02 and (the string form of "") 0.0 to target
        commit bim transaction in (the address of (editor's documentValue))

# The planar type of `roleCode` the editor draws next: its current one when
# it has that role, else the first of the role.
function the bim plate type for role {integer:roleCode} of {bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        set found to the bim wall type index of editor's plateTypeId in modelValue
        if found's valid:
            if (the item at found's position in (modelValue's wallTypes's values))'s role = roleCode:
                return editor's plateTypeId
        # A floor is 250 mm of concrete unless another type was chosen.
        if roleCode = bim floor planar role:
            loop cursor from 0 to the length of (modelValue's wallTypes's values):
                set planarType to the item at cursor in (modelValue's wallTypes's values)
                if (planarType's role = roleCode) and (planarType's name = (the string form of "Beton 250")):
                    return planarType's id
        loop cursor from 0 to the length of (modelValue's wallTypes's values):
            set planarType to the item at cursor in (modelValue's wallTypes's values)
            if planarType's role = roleCode:
                return planarType's id
        return the bim refused id

# A floor, roof or ceiling (`roleCode`) under the selected space, following
# its outline, as one edit: a floor at the storey's level, a roof on top of
# the storey's walls, a ceiling 0.3 m under the storey above.
function add bim editor plate of role {integer:roleCode} under the selection in {a pointer to a bim editor record:editor}:
    execute:
        set chosen to the bim selected space of (@intrinsic("dereference", editor))
        if chosen's valid = false:
            set editor's message to the string form of "Select a space first"
            return nothing
        ensure bim plate types in editor
        set typeId to the bim plate type for role roleCode of (@intrinsic("dereference", editor))
        set modelValue to editor's documentValue's current
        set typeFound to the bim wall type index of typeId in modelValue
        set levelFound to the bim level index of chosen's space's levelId in modelValue
        if (typeFound's valid = false) or (levelFound's valid = false):
            return nothing
        set storeyHeight to (the item at levelFound's position in (modelValue's levels's values))'s height
        set topValue to 0.0
        if roleCode = bim roof planar role:
            set topValue to storeyHeight + (the bim thickness of (the item at typeFound's position in (modelValue's wallTypes's values)))
        if roleCode = bim ceiling planar role:
            set topValue to storeyHeight - 0.3
        begin bim transaction in (the address of (editor's documentValue))
        set fresh to add bim plate typed typeId on chosen's space's levelId around (chosen's space's outline's values) at top topValue to (the address of (editor's documentValue's current))
        if fresh = the bim refused id:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Refused: the space has no valid outline"
            return nothing
        commit bim transaction in (the address of (editor's documentValue))
        set editor's plateTypeId to typeId
        select bim editor bim slab picked numbered fresh in editor

function add bim editor slab under the selection in {a pointer to a bim editor record:editor}:
    execute:
        add bim editor plate of role bim floor planar role under the selection in editor

# Planar type `typeId` given to the selected plate, or drawn next.
function choose bim editor plate type {a 64 bit integer:typeId} in {a pointer to a bim editor record:editor}:
    execute:
        set found to the bim wall type index of typeId in editor's documentValue's current
        if found's valid = false:
            return nothing
        set planarType to the item at found's position in (editor's documentValue's current's wallTypes's values)
        if editor's selectionKind = bim slab picked:
            begin bim transaction in (the address of (editor's documentValue))
            if set bim plate editor's selectionId type to typeId in (the address of (editor's documentValue's current)):
                commit bim transaction in (the address of (editor's documentValue))
                set editor's message to ((the string form of "Slab ") + (the string form of editor's selectionId)) + ((the string form of " is now ") + planarType's name)
            else:
                roll back bim transaction in (the address of (editor's documentValue))
            return nothing
        set editor's plateTypeId to typeId
        set editor's message to ((the string form of "New ") + (the bim name of planar role planarType's role)) + ((the string form of ": ") + planarType's name)

# Stair or railing type `typeIndex` (of `the bim stair types`) chosen in
# the type selector: given to the selected stair or railing, as one edit,
# or drawn by the stair or railing tool from now on.
function choose bim editor stair type {integer:typeIndex} in {a pointer to a bim editor record:editor}:
    execute:
        set library to the bim stair types
        if (typeIndex < 0) or (typeIndex >= (the length of library)):
            return nothing
        set chosen to the item at typeIndex in library
        set selectedFits to (editor's selectionKind = bim stair picked) and (chosen's isRailing = false)
        if (editor's selectionKind = bim railing picked) and chosen's isRailing:
            set selectedFits to true
        if selectedFits:
            begin bim transaction in (the address of (editor's documentValue))
            if give bim stair editor's selectionId type typeIndex in (the address of (editor's documentValue's current)):
                commit bim transaction in (the address of (editor's documentValue))
                set editor's message to ((the string form of "Now ") + chosen's name)
            else:
                roll back bim transaction in (the address of (editor's documentValue))
            return nothing
        if chosen's isRailing:
            set editor's railingTypeIndex to typeIndex
        else:
            set editor's stairTypeIndex to typeIndex
        set editor's message to (chosen's name + (the string form of ": drawn by the "))
        if chosen's isRailing:
            set editor's message to editor's message + (the string form of "railing tool from now on")
        else:
            set editor's message to editor's message + (the string form of "stair tool from now on")

# Building system type `typeIndex` (of `the bim system types`) chosen in
# the type selector: given to the selected building system, as one edit,
# or drawn by the building system tool from now on.
function choose bim editor system type {integer:typeIndex} in {a pointer to a bim editor record:editor}:
    execute:
        set library to the bim system types
        if (typeIndex < 0) or (typeIndex >= (the length of library)):
            return nothing
        set typeName to (the item at typeIndex in library)'s name
        if editor's selectionKind = bim curtain picked:
            begin bim transaction in (the address of (editor's documentValue))
            if give bim system editor's selectionId type typeIndex in (the address of (editor's documentValue's current)):
                commit bim transaction in (the address of (editor's documentValue))
                set editor's partCode to -1
                set editor's message to ((the string form of "Building system ") + (the string form of editor's selectionId)) + ((the string form of " is now ") + typeName)
            else:
                roll back bim transaction in (the address of (editor's documentValue))
            return nothing
        set editor's systemTypeIndex to typeIndex
        set editor's tool to bim curtain tool
        set editor's moveStage to 0
        set editor's message to ((the string form of "Building system (") + typeName) + (the string form of "): click its start")

# The view the properties show while nothing is selected: the one last
# chosen in the project browser, else the active plan.
# Non-element Properties contexts. Real view IDs remain nonnegative.
function bim sheet properties context:
    replacement:
        (-2) as a 64 bit integer
function bim project properties context:
    replacement:
        (-3) as a 64 bit integer

function the bim properties view of {bim editor record:editor}:
    execute:
        if editor's propertiesViewId < (the bim refused id):
            return the bim refused id
        if (the bim view index of editor's propertiesViewId in editor's documentValue's current)'s valid:
            return editor's propertiesViewId
        return editor's planViewId

# The name of the active storey; empty when it no longer exists.
function the bim storey name of {bim editor record:editor}:
    execute:
        set found to the bim level index of editor's levelId in editor's documentValue's current
        if found's valid = false:
            return the string form of ""
        return (the item at found's position in (editor's documentValue's current's levels's values))'s name

# Makes the storey above or below the active one active. Going up from the top
# storey adds a storey on it, as high as the top storey, in one undoable
# transaction. Ends a wall chain and clears the selection.
function change bim editor storey up {boolean:upward} in {a pointer to a bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        set adjacent to the bim level next to editor's levelId going up upward in modelValue
        if adjacent's valid:
            set editor's levelId to (the item at adjacent's position in (modelValue's levels's values))'s id
        else if upward:
            set here to the bim level index of editor's levelId in modelValue
            if here's valid = false:
                return nothing
            set top to the item at here's position in (modelValue's levels's values)
            set storeyName to (the string form of "Level ") + (the string form of ((the length of (modelValue's levels's values)) + 1))
            begin bim transaction in (the address of (editor's documentValue))
            set fresh to add bim level named storeyName at (top's elevation + top's height) with height top's height to (the address of (editor's documentValue's current))
            if fresh = the bim refused id:
                roll back bim transaction in (the address of (editor's documentValue))
                return nothing
            commit bim transaction in (the address of (editor's documentValue))
            set editor's levelId to fresh
        else:
            set editor's message to the string form of "No storey below"
            return nothing
        set editor's chainActive to false
        set editor's selectionKind to bim nothing picked
        set editor's selectionId to the bim refused id
        follow bim editor storey in editor
        set editor's viewsDirty to true
        set editor's message to (the string form of "Storey: ") + (the bim storey name of (@intrinsic("dereference", editor)))

# Adds a storey for each storey of `imported` that has none within a
# millimetre of its elevation, named as there and reaching up to the next
# storey, native or imported (the top one 3 m), in one undoable transaction,
# so that each gets its plan.
function add bim editor storeys of {bim import record:imported} in {a pointer to a bim editor record:editor}:
    execute:
        set choices to the bim storeys of editor's documentValue's current with imported
        set added to 0
        begin bim transaction in (the address of (editor's documentValue))
        loop cursor from 0 to the length of (imported's storeys's names's values):
            set storeyHeight to the item at cursor in (imported's storeys's elevations's values)
            set taken to false
            loop levelCursor from 0 to the length of (editor's documentValue's current's levels's values):
                set levelValue to the item at levelCursor in (editor's documentValue's current's levels's values)
                if (the absolute value of (levelValue's elevation - storeyHeight)) < 0.001:
                    set taken to true
            if taken = false:
                set storeyReach to 3.0
                set found to false
                loop choiceCursor from 0 to the length of (choices's elevations):
                    set above to the item at choiceCursor in (choices's elevations)
                    if (found = false) and (above > (storeyHeight + 0.001)):
                        set storeyReach to above - storeyHeight
                        set found to true
                if (add bim level named (the item at cursor in (imported's storeys's names's values)) at storeyHeight with height storeyReach to (the address of (editor's documentValue's current))) != the bim refused id:
                    set added to added + 1
        free (choices's elevations)
        free (choices's names)
        if added = 0:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Every imported storey has a storey in the model"
            return nothing
        commit bim transaction in (the address of (editor's documentValue))
        set editor's viewsDirty to true
        set editor's message to ((the string form of "Added ") + (the string form of added)) + (the string form of " storeys from the import")

# Removes corner `doomedCorner` of `slabValue` in one undoable transaction;
# refused when the outline would keep less than three corners or cross
# itself.
function remove bim editor slab corner {integer:doomedCorner} of {bim slab record:slabValue} in {a pointer to a bim editor record:editor}:
    execute:
        set corners to an empty list of a cad vector2
        loop cursor from 0 to the length of (slabValue's outline's values):
            if cursor != doomedCorner:
                append (the item at cursor in (slabValue's outline's values)) to corners
        begin bim transaction in (the address of (editor's documentValue))
        if set bim slab slabValue's id outline to corners in (the address of (editor's documentValue's current)):
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Corner removed"
        else:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Refused: a slab keeps at least three corners and may not cross itself"
        free corners

# ---------------------------------------------------------------- events

function move bim editor pointer to {cad vector2:location} within {a 64 bit floating-point number:tolerance} in {a pointer to a bim editor record:editor}:
    execute:
        set editor's pointerLocation to location
        set editor's pickTolerance to tolerance
        set editor's sketchInView to false
        set editor's snap to the bim snap of location in (@intrinsic("dereference", editor)) within tolerance
        set editor's hoverWall to the bim wall near location in (@intrinsic("dereference", editor)) within tolerance
        # A grab follows the pointer from where it began, unless a distance
        # is being typed.
        if editor's grabbing and ((the length of editor's numeric) = 0):
            set dx to editor's snap's point's x - editor's grabBase's x
            set dy to editor's snap's point's y - editor's grabBase's y
            if editor's grabAxis = 1:
                set dy to 0.0
            if editor's grabAxis = 2:
                set dx to 0.0
            set lift to 0.0
            if editor's grabAxis = 3:
                set lift to location's y - editor's grabBase's y
                set dx to 0.0
                set dy to 0.0
            apply bim editor grab by (a cad vector2 with x dx and y dy) lifting lift in editor
        # Push/pull follows the pointer up the plan; a move follows it from
        # its base point.
        if (editor's tool = bim push tool) and (((editor's pushId != the bim refused id) and (editor's pushEdge >= 0)) and ((the length of editor's numeric) = 0)):
            set normal to the bim push normal of (@intrinsic("dereference", editor))
            push bim editor side by (((location's x - editor's pushOrigin's x) * normal's x) + ((location's y - editor's pushOrigin's y) * normal's y)) in editor
        if (editor's tool = bim push tool) and (((editor's pushId != the bim refused id) and (editor's pushFace >= 0)) and ((the length of editor's numeric) = 0)):
            push bim editor mesh face by (location's y - editor's pushOrigin's y) in editor
        if (editor's tool = bim push tool) and ((((editor's pushId != the bim refused id) and (editor's pushEdge < 0)) and (editor's pushFace < 0)) and ((the length of editor's numeric) = 0)):
            set rise to the maximum of 0.0 and (editor's pushBase + (location's y - editor's pushOrigin's y))
            if set bim face editor's pushId height to rise in (the address of (editor's documentValue's current)):
                show bim editor preview in editor
        if (editor's tool = bim rotate tool) and (editor's moveStage = 3):
            set turned to @intrinsic("atan2", editor's snap's point's y - editor's moveBase's y, editor's snap's point's x - editor's moveBase's x) - editor's turnStart
            reposition bim editor selection by (the bim turn transform about editor's moveBase by turned) in editor
            show bim editor preview in editor
        if (editor's tool = bim move tool) and (editor's moveStage = 2):
            apply bim editor move by (a cad vector2 with x (editor's snap's point's x - editor's moveBase's x) and y (editor's snap's point's y - editor's moveBase's y)) in editor
            show bim editor preview in editor
        if editor's dragging = false:
            return nothing
        set target to editor's snap's point
        if editor's bendWallId != the bim refused id:
            # The arc follows the pointer: its middle lies over the pointer.
            set found to the bim wall index of editor's bendWallId in editor's documentValue's current
            if found's valid:
                set wallValue to the item at found's position in (editor's documentValue's current's walls's values)
                if bend bim wall editor's bendWallId keeping its joins by (the bim bulge of wallValue toward location) in (the address of (editor's documentValue's current)):
                    set editor's dragMoved to true
            return nothing
        if editor's handleDrag = bim whole drag:
            set wholeX to target's x - editor's moveBase's x
            set wholeY to target's y - editor's moveBase's y
            if editor's dragMoved or (((wholeX * wholeX) + (wholeY * wholeY)) >= ((editor's pickTolerance * 0.5) * (editor's pickTolerance * 0.5))):
                apply bim editor move by (a cad vector2 with x wholeX and y wholeY) in editor
                set editor's dragMoved to true
            return nothing
        if editor's handleDrag >= 0:
            # A shape handle: that control point follows the pointer across
            # the plan, keeping its height.
            set stack to editor's documentValue's undoStack's values
            if (the length of stack) > 0:
                set original to the item at ((the length of stack) - 1) in stack
                set before to the bim handles of editor's selectionKind numbered editor's selectionId in original
                set moved to an empty list of a cad vector3
                loop cursor from 0 to the length of (before's values):
                    set controlPoint to the item at cursor in (before's values)
                    if cursor = editor's handleDrag:
                        set controlPoint to a cad vector3 with x target's x, y target's y and z controlPoint's z
                    append controlPoint to moved
                if set bim handles of editor's selectionKind numbered editor's selectionId to moved in (the address of (editor's documentValue's current)):
                    set editor's dragMoved to true
                free moved
            return nothing
        if editor's gridDragId != the bim refused id:
            set found to the bim grid index of editor's gridDragId in editor's documentValue's current
            if found's valid:
                set gridValue to the item at found's position in (editor's documentValue's current's grids's values)
                set newStart to gridValue's start
                set newFinish to gridValue's finish
                if editor's gridDragAtFinish:
                    set newFinish to target
                else:
                    set newStart to target
                if move bim grid editor's gridDragId to newStart and newFinish in (the address of (editor's documentValue's current)):
                    set editor's dragMoved to true
            return nothing
        if editor's slabCorner <= bim slab edge drag base:
            set chosen to the bim selected slab of (@intrinsic("dereference", editor))
            if chosen's valid:
                set corners to an empty list of a cad vector2
                if fill bim outline of chosen's slab with edge (bim slab edge drag base - editor's slabCorner) pushed by (a cad vector2 with x (target's x - editor's moveBase's x) and y (target's y - editor's moveBase's y)) into corners:
                    if set bim slab chosen's slab's id outline to corners in (the address of (editor's documentValue's current)):
                        set editor's dragMoved to true
                        set editor's moveBase to target
                free corners
            return nothing
        if editor's slabCorner >= 0:
            set chosen to the bim selected slab of (@intrinsic("dereference", editor))
            if chosen's valid:
                set corners to an empty list of a cad vector2
                loop cursor from 0 to the length of (chosen's slab's outline's values):
                    if cursor = editor's slabCorner:
                        append target to corners
                    else:
                        append (the item at cursor in (chosen's slab's outline's values)) to corners
                # A corner moved to where it would make the outline cross
                # itself stays where it last was.
                if set bim slab chosen's slab's id outline to corners in (the address of (editor's documentValue's current)):
                    set editor's dragMoved to true
                free corners
            return nothing
        # Every dragged wall end moves by the pointer's displacement from where
        # the drag began.
        set dx to target's x - editor's dragOrigin's x
        set dy to target's y - editor's dragOrigin's y
        # A press that has not yet travelled half the pick tolerance is a
        # click, not a drag: it moves nothing (a snap shifting under the
        # pointer would otherwise nudge the wall).
        if (editor's dragMoved = false) and (((dx * dx) + (dy * dy)) < ((editor's pickTolerance * 0.5) * (editor's pickTolerance * 0.5))):
            return nothing
        loop cursor from 0 to the length of (editor's dragEnds's values):
            set endValue to the item at cursor in (editor's dragEnds's values)
            set found to the bim wall index of endValue's wallId in editor's documentValue's current
            if found's valid:
                set wallValue to the item at found's position in (editor's documentValue's current's walls's values)
                set placed to a cad vector2 with x (endValue's origin's x + dx) and y (endValue's origin's y + dy)
                set newStart to wallValue's start
                set newFinish to wallValue's finish
                if endValue's atFinish:
                    set newFinish to placed
                else:
                    set newStart to placed
                if move bim wall endValue's wallId to newStart and newFinish in (the address of (editor's documentValue's current)):
                    set editor's dragMoved to true

# The line the wall tool draws on, as the location line in Revit: the wall's
# centreline, or its exterior or interior face (the exterior side is on the
# right of the drawing direction, `bim_model.dl`).
function bim wall centre line:
    replacement:
        0
function bim wall exterior line:
    replacement:
        1
function bim wall interior line:
    replacement:
        2

# How far the centreline of a wall the wall tool draws lies from the drawn
# line, along the exterior normal: in (negative) by half the type's thickness
# when the exterior face is drawn, out by as much when the interior face is,
# 0 on the centreline.
function the bim editor wall line shift in {a pointer to a bim editor record:editor}:
    execute:
        if editor's wallLine = bim wall centre line:
            return 0.0
        set typeFound to the bim wall type index of editor's wallTypeId in editor's documentValue's current
        if typeFound's valid = false:
            return 0.0
        set half to (the bim thickness of (the item at typeFound's position in (editor's documentValue's current's wallTypes's values))) * 0.5
        if editor's wallLine = bim wall exterior line:
            return 0.0 - half
        return half

# The wall from the chain's last drawn point to `finishPoint`, on the wall
# line: drawn on the centreline, the points are the wall's; drawn on a face,
# the centreline lies half the type's thickness in from the drawn line, and
# at the corner with the chain's previous wall both centrelines are mitred
# to where the drawn faces turn, so that the walls meet there. One
# transaction: the undo of the wall also takes the mitre back.
function add bim editor wall to {cad vector2:finishPoint} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set drawnStart to editor's chainStart
        set along to a cad vector2 with x (finishPoint's x - drawnStart's x) and y (finishPoint's y - drawnStart's y)
        set drawnLength to the square root of ((along's x * along's x) + (along's y * along's y))
        if drawnLength <= 1e-6:
            set editor's message to the string form of "Wall refused: zero length"
            return nothing
        set lineShift to the bim editor wall line shift in editor
        set outward to a cad vector2 with x (along's y / drawnLength) and y (0.0 - (along's x / drawnLength))
        set centreStart to a cad vector2 with x (drawnStart's x + (outward's x * lineShift)) and y (drawnStart's y + (outward's y * lineShift))
        set centreFinish to a cad vector2 with x (finishPoint's x + (outward's x * lineShift)) and y (finishPoint's y + (outward's y * lineShift))
        set mitred to false
        set previousStart to drawnStart
        set previousFound to the bim wall index of editor's chainWallId in (@intrinsic("dereference", target))
        if (lineShift != 0.0) and previousFound's valid:
            set previousWall to the item at previousFound's position in (target's walls's values)
            set previousOutward to the bim exterior normal of previousWall
            # The point on both offset lines: the corner moved along the
            # sum of the normals (a straight continuation keeps the
            # perpendicular offset; a wall turning back on itself has no
            # mitre).
            set turning to 1.0 + ((previousOutward's x * outward's x) + (previousOutward's y * outward's y))
            if turning > 1e-6:
                set centreStart to a cad vector2 with x (drawnStart's x + (((previousOutward's x + outward's x) * lineShift) / turning)) and y (drawnStart's y + (((previousOutward's y + outward's y) * lineShift) / turning))
                set previousStart to previousWall's start
                set mitred to true
        begin bim transaction in (the address of (editor's documentValue))
        if mitred:
            ignore move bim wall (editor's chainWallId) to previousStart and centreStart in target
        set fresh to add bim wall typed editor's wallTypeId on editor's levelId from centreStart to centreFinish to target
        if fresh = the bim refused id:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Wall refused: zero length"
            return nothing
        commit bim transaction in (the address of (editor's documentValue))
        set editor's chainStart to finishPoint
        set editor's chainWallId to fresh
        set editor's message to (the string form of "Wall ") + (the string form of fresh)

# Reinforcement placement: two points; dimensions remain editable parameters.
function place bim editor reinforcement at {cad vector2:point} in {a pointer to a bim editor record:editor}:
    execute:
        if editor's moveStage = 0:
            set editor's solidCorner to point
            set editor's moveStage to 1
            set editor's message to the string form of "Reinforcement: click the end (mesh: opposite corner)"
            return nothing
        set editor's moveStage to 0
        set target to the address of (editor's documentValue's current)
        set variant to editor's tool - 30
        set beginning to a cad vector3 with x editor's solidCorner's x, y editor's solidCorner's y and z 0.25
        set ending to a cad vector3 with x point's x, y point's y and z 0.25
        set breadth to 0.3
        if (variant = 2) or (variant = 5):
            set beginning to a cad vector3 with x (the minimum of point's x and editor's solidCorner's x), y (the minimum of point's y and editor's solidCorner's y) and z 0.0
            set ending to a cad vector3 with x (the maximum of point's x and editor's solidCorner's x), y beginning's y and z 0.0
            set breadth to the absolute value of (point's y - editor's solidCorner's y)
        set label to (the string form of "R") + (the string form of target's nextId)
        set spec to @intrinsic("construct", a reinforcement definition, the bim refused id, editor's levelId, the bim refused id, variant, label, beginning, ending, breadth, 0.5, 0.016, 0.008, 0.15, 0.15, 0.035, 0.024, 3, 3, 0.012, 0.016, the string form of "-", 0.0, 0.1, 0.0, 0.1, 0, 0.012, 0, 0.016, 0.3, 1.0, 0, 1, 0.012, 0.012, 0.15, 0.15, 0.0, the string form of "Custom", the string form of "UNKNOWN", the string form of "UNKNOWN")
        if variant = 5:
            set spec's faceMask to 3
            set spec's depth to 0.2
            set spec's diameter to 0.012
            set spec's secondaryDiameter to 0.012
        set issue to the reinforcement issue of spec
        if issue != (the string form of ""):
            set editor's message to issue
            return nothing
        begin bim transaction in (the address of (editor's documentValue))
        set made to store bim reinforcement spec in target
        if made = the bim refused id:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Reinforcement refused"
            return nothing
        commit bim transaction in (the address of (editor's documentValue))
        select bim editor 30 numbered made in editor
        set editor's message to the reinforcement annotation of spec


function press bim editor pointer in {a pointer to a bim editor record:editor}:
    execute:
        set point to editor's snap's point
        if editor's tool = bim arc wall tool:
            if editor's moveStage = 0:
                set editor's solidCorner to point
                set editor's moveStage to 1
                set editor's message to the string form of "Arc wall: click the end point"
                return nothing
            if editor's moveStage = 1:
                if (the cad distance from editor's solidCorner to point) <= 1e-6:
                    return nothing
                set editor's solidReach to point
                set editor's moveStage to 2
                set editor's message to the string form of "Arc wall: click a point on the arc"
                return nothing
            set bulgeValue to the bim boundary bulge from editor's solidCorner to editor's solidReach through point
            set chordLength to the cad distance from editor's solidCorner to editor's solidReach
            if ((the absolute value of bulgeValue) <= 1e-7) or ((the absolute value of bulgeValue) > ((chordLength * 0.5) + 1e-7)):
                set editor's message to the string form of "Arc wall: choose a non-collinear point within a half-circle"
                return nothing
            set curve to the bim arc of boundary segment (the bim boundary arc from editor's solidCorner to editor's solidReach bulging bulgeValue)
            set chosenType to the bim wall type index of editor's wallTypeId in editor's documentValue's current
            if chosenType's valid:
                set wallBreadth to the bim thickness of (the item at chosenType's position in (editor's documentValue's current's wallTypes's values))
                if curve's radius <= ((wallBreadth * 0.5) + 1e-7):
                    set editor's message to the string form of "Arc wall: radius is too small for this wall thickness"
                    return nothing
            set target to the address of (editor's documentValue's current)
            begin bim transaction in (the address of (editor's documentValue))
            set made to add bim wall typed editor's wallTypeId on editor's levelId from editor's solidCorner to editor's solidReach to target
            if made = the bim refused id:
                roll back bim transaction in (the address of (editor's documentValue))
                return nothing
            ignore bend bim wall made by bulgeValue in target
            commit bim transaction in (the address of (editor's documentValue))
            set editor's moveStage to 0
            select bim editor bim wall picked numbered made in editor
            set editor's message to the string form of "Arc wall created; click the start of another arc"
            return nothing
        if editor's tool = bim vertical opening tool:
            if editor's moveStage = 0:
                set editor's moveBase to point
                set editor's moveStage to 1
                set editor's message to the string form of "Vertical opening: click the opposite corner"
            else:
                set corners to an empty list of a cad vector2
                append editor's moveBase to corners
                append (a cad vector2 with x point's x and y editor's moveBase's y) to corners
                append point to corners
                append (a cad vector2 with x editor's moveBase's x and y point's y) to corners
                begin bim transaction in (the address of (editor's documentValue))
                set openingId to add bim plate opening on editor's boundaryId around corners in (the address of (editor's documentValue's current))
                free corners
                if openingId > 0:
                    commit bim transaction in (the address of (editor's documentValue))
                    set editor's message to the string form of "Vertical opening added; click to draw another, Esc to finish"
                else:
                    roll back bim transaction in (the address of (editor's documentValue))
                    set editor's message to the string form of "Opening must fit inside every layer and not overlap another opening"
                set editor's moveStage to 0
            return nothing
        if (editor's tool >= 30) and (editor's tool <= 35):
            place bim editor reinforcement at point in editor
            return nothing
        if bim editor sketches a boundary (@intrinsic("dereference", editor)):
            press bim editor boundary sketch in editor
            return nothing
        if editor's editMode:
            if editor's grabbing:
                finish bim editor grab in editor
            else:
                pick bim editor points at editor's pointerLocation in editor
            return nothing
        if editor's tool = bim split tool:
            press bim editor split at point in editor
            return nothing
        if editor's tool = bim line tool:
            if (the length of (editor's sketchChain's values)) = 0:
                append point to (editor's sketchChain's values)
                set editor's message to the string form of "Line: click the next point; back on the first closes a face"
            else:
                add bim editor sketch line to point in editor
            return nothing
        if editor's tool = bim rectangle tool:
            if (the length of (editor's sketchChain's values)) = 0:
                append point to (editor's sketchChain's values)
                set editor's message to the string form of "Rectangle: click the opposite corner"
            else:
                add bim editor rectangle from (the item at 0 in (editor's sketchChain's values)) to point in editor
                set editor's sketchChain to a cad topology list of a cad vector2
            return nothing
        if editor's tool = bim push tool:
            if editor's pushId = the bim refused id:
                set faceId to the bim face at editor's pointerLocation in (@intrinsic("dereference", editor))
                if faceId = the bim refused id:
                    # Seen from above, a mesh is pushed by its face on top.
                    set meshId to the bim mesh at editor's pointerLocation in (@intrinsic("dereference", editor)) within 0.0
                    if meshId != the bim refused id:
                        set meshValue to the item at (the bim mesh index of meshId in editor's documentValue's current)'s position in (editor's documentValue's current's meshes's values)
                        set topFace to the bim top face of mesh meshValue at editor's pointerLocation
                        if topFace >= 0:
                            start bim editor push of mesh meshId face topFace in editor
                            return nothing
                    set editor's message to the string form of "Push/pull: click a face"
                    return nothing
                set found to the bim sketch index of faceId in editor's documentValue's current
                begin bim transaction in (the address of (editor's documentValue))
                set editor's pushId to faceId
                set editor's pushOrigin to editor's pointerLocation
                set editor's pushBase to (the item at found's position in (editor's documentValue's current's sketches's values))'s height
                set editor's numeric to the string form of ""
                set editor's message to the string form of "Push/pull: move up the plan or type a height, then click or Enter"
                if editor's pushEdge >= 0:
                    set editor's message to the string form of "Push/pull the side: move out or in, or type a distance, then click or Enter"
            else:
                finish bim editor push in editor
            return nothing
        if editor's tool = bim linear tool:
            place bim editor linear at point in editor
            return nothing
        if editor's tool = bim solid tool:
            place bim editor solid at point in editor
            return nothing
        if editor's tool = bim dimension tool:
            place bim editor dimension at point in editor
            return nothing
        if editor's tool = bim tag tool:
            place bim editor tag at point in editor
            return nothing
        if editor's tool = bim crop tool:
            place bim editor crop at point in editor
            return nothing
        if editor's tool = bim stair tool:
            place bim editor stair at point in editor
            return nothing
        if editor's tool = bim railing tool:
            place bim editor railing point at point in editor
            return nothing
        if editor's tool = bim curtain tool:
            place bim editor curtain at point in editor
            return nothing
        if editor's tool = bim place tool:
            begin bim transaction in (the address of (editor's documentValue))
            set placed to place bim component editor's placeComponentId on editor's levelId at point turned 0.0 to (the address of (editor's documentValue's current))
            if placed = the bim refused id:
                roll back bim transaction in (the address of (editor's documentValue))
                set editor's message to the string form of "Place: make a component first (Ctrl+G)"
            else:
                commit bim transaction in (the address of (editor's documentValue))
                set editor's message to (the string form of "Instance ") + (the string form of placed)
            return nothing
        if editor's tool = bim text tool:
            set editor's textActive to true
            set editor's textAnchor to point
            set editor's textBuffer to the string form of ""
            set editor's message to the string form of "Text: type, then Enter"
            return nothing
        if (editor's tool = bim rotate tool) or (editor's tool = bim mirror tool):
            set verb to the string form of "Rotate"
            if editor's tool = bim mirror tool:
                set verb to the string form of "Mirror"
            if editor's moveStage = 0:
                select bim editor element at editor's pointerLocation in editor
                if (editor's selectionKind = bim nothing picked) or ((editor's selectionKind = bim space picked) or (editor's selectionKind = bim opening picked)):
                    set editor's message to verb + (the string form of ": click a wall, slab, grid, sketch element or instance")
                    return nothing
                set editor's moveStage to 1
                if editor's tool = bim rotate tool:
                    set editor's message to the string form of "Rotate: click the centre (Enter: the 3D cursor)"
                else:
                    set editor's message to the string form of "Mirror: click the first point of the mirror line"
                return nothing
            if editor's moveStage = 1:
                if editor's selectionKind = bim nothing picked:
                    set editor's moveStage to 0
                    return nothing
                set editor's moveBase to point
                set editor's moveStage to 2
                set editor's numeric to the string form of ""
                if editor's tool = bim rotate tool:
                    set editor's message to the string form of "Rotate: click a reference direction, or type degrees and Enter"
                else:
                    set editor's message to the string form of "Mirror: click the second point of the mirror line"
                return nothing
            if editor's tool = bim mirror tool:
                if (the cad distance from point to editor's moveBase) <= 1e-6:
                    return nothing
                set made to copy bim editor selection changed by (the bim mirror transform from editor's moveBase through point) in editor
                set editor's message to (the string form of "Mirrored ") + (the string form of made)
                set editor's moveStage to 0
                set editor's tool to bim select tool
                return nothing
            if editor's moveStage = 2:
                if (the cad distance from point to editor's moveBase) <= 1e-6:
                    return nothing
                set editor's turnStart to @intrinsic("atan2", point's y - editor's moveBase's y, point's x - editor's moveBase's x)
                begin bim transaction in (the address of (editor's documentValue))
                set editor's moveStage to 3
                set editor's message to the string form of "Rotate: click the new direction"
                return nothing
            set turned to @intrinsic("atan2", point's y - editor's moveBase's y, point's x - editor's moveBase's x) - editor's turnStart
            reposition bim editor selection by (the bim turn transform about editor's moveBase by turned) in editor
            commit bim transaction in (the address of (editor's documentValue))
            set editor's moveStage to 0
            set editor's tool to bim select tool
            set editor's message to (the string form of "Rotated ") + ((the bim metres text of (turned * (180.0 / 3.141592653589793))) + (the string form of " degrees"))
            return nothing
        if editor's tool = bim offset tool:
            if editor's moveStage = 0:
                select bim editor element at editor's pointerLocation in editor
                set usable to (editor's selectionKind = bim wall picked) or (editor's selectionKind = bim sketch picked)
                if usable:
                    set usable to (the bim segment of editor's selectionId in editor's documentValue's current)'s valid
                if usable = false:
                    set editor's message to the string form of "Offset: click a straight wall or a line"
                    return nothing
                set editor's moveStage to 1
                set editor's message to ((the string form of "Offset ") + (the bim length editor's offsetDistance in units editor's lengthUnit)) + (the string form of ": click the side")
                return nothing
            set piece to the bim segment of editor's selectionId in editor's documentValue's current
            set run to the cad distance from piece's start to piece's finish
            if run > 1e-9:
                set nx to (0.0 - (piece's finish's y - piece's start's y)) / run
                set ny to (piece's finish's x - piece's start's x) / run
                set side to ((point's x - piece's start's x) * nx) + ((point's y - piece's start's y) * ny)
                if side < 0.0:
                    set nx to 0.0 - nx
                    set ny to 0.0 - ny
                ignore copy bim editor selection changed by (the bim shift transform by (a cad vector2 with x (nx * editor's offsetDistance) and y (ny * editor's offsetDistance))) in editor
                set editor's message to (the string form of "Offset ") + ((the bim length editor's offsetDistance in units editor's lengthUnit) + (the string form of "; click the next, or type a distance"))
            set editor's moveStage to 0
            return nothing
        # TR trims or extends two walls or lines to the corner where they
        # meet, keeping the parts that were clicked (Revit's Trim/Extend to
        # Corner).
        if editor's tool = bim trim tool:
            set cornerPick to editor's pointerLocation
            # Only straight walls and lines count, the nearest under the
            # click (a window in the wall, a room's tag or a building
            # system beside it do not get in the way).
            set trimmedId to the bim trim candidate at cornerPick for (@intrinsic("dereference", editor))
            if trimmedId = the bim refused id:
                set editor's message to the string form of "Trim to corner: click a straight wall, beam or line, on the part to keep"
                return nothing
            select bim editor (the bim kind of trim candidate trimmedId in editor's documentValue's current) numbered trimmedId in editor
            if (editor's moveStage = 0) or (editor's selectionId = editor's boundaryId):
                set editor's boundaryId to editor's selectionId
                set editor's moveBase to cornerPick
                set editor's moveStage to 1
                set editor's message to the string form of "Trim to corner: click the second wall, beam or line, on the part to keep"
                return nothing
            set editor's message to trim bim editor corner of editor's boundaryId at editor's moveBase and editor's selectionId at cornerPick in editor
            set editor's moveStage to 0
            return nothing
        # ZR: the first click a corner, the second the opposite one; the
        # window then zooms the plan onto the region.
        if editor's tool = bim zoom region tool:
            if editor's moveStage = 0:
                set editor's zoomFrom to point
                set editor's moveStage to 1
                set editor's message to the string form of "Zoom region: click the opposite corner"
                return nothing
            set editor's zoomTo to point
            set editor's zoomReady to ((the absolute value of (point's x - editor's zoomFrom's x)) > 0.01) and ((the absolute value of (point's y - editor's zoomFrom's y)) > 0.01)
            set editor's moveStage to 0
            set editor's tool to bim select tool
            set editor's message to the string form of "Zoomed to the region"
            return nothing
        # AL: the first click picks the reference (a straight wall, a grid or
        # a line), each later click a wall, grid or line parallel to it,
        # which moves across onto the reference's line.
        if editor's tool = bim align tool:
            set alignPick to editor's pointerLocation
            # A grid under the pointer comes first: aligning is mostly to
            # and of grids.
            set alignGrid to the bim grid near alignPick in (@intrinsic("dereference", editor)) within editor's pickTolerance
            if editor's moveStage = 0:
                if alignGrid != the bim refused id:
                    select bim editor bim grid picked numbered alignGrid in editor
                else:
                    select bim editor element at alignPick in editor
                if (editor's selectionKind = bim nothing picked) or (((the bim segment of editor's selectionId in editor's documentValue's current)'s valid) = false):
                    set editor's message to the string form of "Align: click the reference: a straight wall, a grid or a line"
                    return nothing
                set editor's boundaryId to editor's selectionId
                set editor's moveBase to alignPick
                set editor's moveStage to 1
                set editor's message to the string form of "Align: click a wall face, grid or line to bring onto it; Esc ends"
                return nothing
            if alignGrid != the bim refused id:
                select bim editor bim grid picked numbered alignGrid in editor
            else:
                select bim editor element at alignPick in editor
            if editor's selectionKind = bim nothing picked:
                set editor's message to the string form of "Align: click a wall, grid or line"
                return nothing
            set editor's message to align bim editor element editor's selectionId at alignPick to the reference in editor
            return nothing
        if editor's tool = bim extend tool:
            set extending to true
            if editor's moveStage = 0:
                select bim editor element at editor's pointerLocation in editor
                if (editor's selectionKind = bim nothing picked) or (((the bim segment of editor's selectionId in editor's documentValue's current)'s valid) = false):
                    set editor's message to the string form of "Trim/extend: click the boundary: a straight wall, a line or a grid"
                    return nothing
                set editor's boundaryId to editor's selectionId
                set editor's moveStage to 1
                set editor's message to the string form of "Click the walls or lines to trim or extend; Esc ends"
                return nothing
            set pick to editor's pointerLocation
            set previousKind to editor's selectionKind
            set previousId to editor's selectionId
            select bim editor element at pick in editor
            if (editor's selectionKind != bim wall picked) and (editor's selectionKind != bim sketch picked):
                set editor's message to the string form of "Click a wall or a line"
                return nothing
            set outcome to trim bim editor element editor's selectionId at pick extending extending in editor
            select bim editor previousKind numbered previousId in editor
            set editor's message to outcome
            return nothing
        if editor's tool = bim copy tool:
            if editor's moveStage = 0:
                select bim editor element at editor's pointerLocation in editor
                if (editor's selectionKind = bim nothing picked) or ((editor's selectionKind = bim space picked) or (editor's selectionKind = bim opening picked)):
                    set editor's message to the string form of "Copy: click a wall, slab, building system, grid, sketch element or instance"
                    return nothing
                set editor's moveStage to 1
                set editor's message to the string form of "Copy: click the base point"
                return nothing
            if editor's moveStage = 1:
                set editor's moveBase to point
                set editor's moveStage to 2
                set editor's message to the string form of "Copy: click where the copy goes"
                return nothing
            copy bim editor selection by (a cad vector2 with x (point's x - editor's moveBase's x) and y (point's y - editor's moveBase's y)) in editor
            return nothing
        if editor's tool = bim move tool:
            if editor's moveStage = 0:
                select bim editor element at editor's pointerLocation in editor
                if editor's selectionKind = bim nothing picked:
                    set editor's message to the string form of "Move: click an element"
                    return nothing
                if editor's selectionKind = bim space picked:
                    set editor's message to the string form of "Move: spaces follow their walls"
                    return nothing
                set editor's moveStage to 1
                set editor's message to the string form of "Move: click the base point"
                return nothing
            if editor's moveStage = 1:
                set editor's moveBase to point
                set editor's moveStage to 2
                begin bim transaction in (the address of (editor's documentValue))
                set editor's message to the string form of "Move: click the destination"
                return nothing
            apply bim editor move by (a cad vector2 with x (point's x - editor's moveBase's x) and y (point's y - editor's moveBase's y)) in editor
            commit bim transaction in (the address of (editor's documentValue))
            set editor's moveStage to 0
            set editor's message to the string form of "Moved"
            return nothing
        if editor's tool = bim wall tool:
            if editor's chainActive:
                add bim editor wall to point in editor
            else:
                set editor's chainActive to true
                set editor's chainStart to point
                set editor's chainWallId to the bim refused id
            set editor's numeric to the string form of ""
            return nothing
        if editor's tool = bim opening tool:
            if editor's hoverWall = the bim refused id:
                # A building system hosts it too, by its opening rule.
                set systemId to the bim curtain at point in (@intrinsic("dereference", editor)) within (editor's pickTolerance * 2.0)
                if systemId != the bim refused id:
                    set hostSystem to the item at (the bim curtain index of systemId in editor's documentValue's current)'s position in (editor's documentValue's current's curtains's values)
                    set systemAlong to (the bim system station of point on hostSystem)'s x
                    begin bim transaction in (the address of (editor's documentValue))
                    set fresh to add bim opening typed editor's openingTypeId in systemId at systemAlong to (the address of (editor's documentValue's current))
                    if fresh = the bim refused id:
                        roll back bim transaction in (the address of (editor's documentValue))
                        set editor's message to the string form of "Refused: no opening type"
                        return nothing
                    commit bim transaction in (the address of (editor's documentValue))
                    set editor's message to (the string form of "Opening in the building system: ") + (the bim name of opening rule (the bim opening rule of system systemId in editor's documentValue's current))
                    return nothing
                set editor's message to the string form of "Openings are hosted: point at a wall or a building system"
                return nothing
            set found to the bim wall index of editor's hoverWall in editor's documentValue's current
            set host to the item at found's position in (editor's documentValue's current's walls's values)
            set along to the bim offset along host nearest point
            refresh bim editor editor
            begin bim transaction in (the address of (editor's documentValue))
            set fresh to add bim opening typed editor's openingTypeId in editor's hoverWall at along to (the address of (editor's documentValue's current))
            if fresh = the bim refused id:
                roll back bim transaction in (the address of (editor's documentValue))
                set editor's message to the string form of "Refused: no opening type"
                return nothing
            ignore settle bim editor change in editor described ((the string form of "Opening ") + (the string form of fresh)) or refused as (the string form of "the window does not fit there")
            return nothing
        if editor's tool = bim grid tool:
            if editor's gridActive = false:
                set editor's gridActive to true
                set editor's gridStart to point
                set editor's message to the string form of "Grid: click its end"
                return nothing
            set reach to the bim grid reach of editor's documentValue's current
            set gridName to the bim next grid name from editor's gridStart to point in editor's documentValue's current
            begin bim transaction in (the address of (editor's documentValue))
            set fresh to add bim grid named gridName from editor's gridStart to point reaching reach's x to reach's y to (the address of (editor's documentValue's current))
            if fresh = the bim refused id:
                roll back bim transaction in (the address of (editor's documentValue))
                set editor's message to the string form of "Refused: a grid needs a length"
                return nothing
            commit bim transaction in (the address of (editor's documentValue))
            set editor's gridActive to false
            set editor's message to (the string form of "Grid ") + gridName
            return nothing
        if editor's tool = bim section tool:
            if editor's sectionActive = false:
                set editor's sectionActive to true
                set editor's sectionStart to point
                set editor's message to the string form of "Section: click the second point"
                return nothing
            if (the cad distance from editor's sectionStart to point) <= the bim join tolerance:
                return nothing
            set editor's sectionActive to false
            begin bim transaction in (the address of (editor's documentValue))
            set made to add bim section view from editor's sectionStart to point to (the address of (editor's documentValue's current))
            commit bim transaction in (the address of (editor's documentValue))
            show bim editor section view made in editor
            set editor's message to the string form of "Section placed"
            return nothing
        # Select tool. On the selected slab, pressing on a corner drags it and
        # pressing on an edge's middle pushes that side across itself.
        # Pressing on a wall end point of the active storey drags every wall
        # end of that storey that meets there, so joins stay joined. Pressing
        # elsewhere selects what lies under the pointer; pressing on a wall
        # drags the whole wall, with the ends of the walls joined to it.
        set editor's dragOrigin to point
        set editor's slabCorner to -1
        set editor's gridDragId to the bim refused id
        set editor's bendWallId to the bim refused id
        # The end of a grid under the pointer drags that end.
        if bim category bim grid category is visible in editor's planRules:
            loop cursor from 0 to the length of (editor's documentValue's current's grids's values):
                set gridValue to the item at cursor in (editor's documentValue's current's grids's values)
                set nearStart to (the cad distance from editor's pointerLocation to gridValue's start) <= editor's pickTolerance
                set nearFinish to (the cad distance from editor's pointerLocation to gridValue's finish) <= editor's pickTolerance
                if (nearStart or nearFinish) and (editor's gridDragId = the bim refused id):
                    set editor's gridDragId to gridValue's id
                    set editor's gridDragAtFinish to nearFinish
            if editor's gridDragId != the bim refused id:
                begin bim transaction in (the address of (editor's documentValue))
                set editor's dragging to true
                set editor's dragMoved to false
                select bim editor bim grid picked numbered editor's gridDragId in editor
                return nothing
        # A shape handle of the selected building system or linear element.
        set editor's handleDrag to -1
        if (editor's selectionKind = bim curtain picked) or (editor's selectionKind = bim linear picked):
            set shapePoints to the bim handles of editor's selectionKind numbered editor's selectionId in editor's documentValue's current
            loop cursor from 0 to the length of (shapePoints's values):
                set shapePoint to the item at cursor in (shapePoints's values)
                if (editor's handleDrag < 0) and ((the cad distance from editor's pointerLocation to (a cad vector2 with x shapePoint's x and y shapePoint's y)) <= editor's pickTolerance):
                    set editor's handleDrag to cursor
            # A column's handles stand one above the other: in plan it drags
            # whole instead.
            if (editor's handleDrag >= 0) and (editor's selectionKind = bim linear picked):
                set upright to the bim linear index of editor's selectionId in editor's documentValue's current
                if upright's valid:
                    set uprightValue to the item at upright's position in (editor's documentValue's current's linears's values)
                    if (the cad distance from (a cad vector2 with x uprightValue's start's x and y uprightValue's start's y) to (a cad vector2 with x uprightValue's finish's x and y uprightValue's finish's y)) < 0.001:
                        set editor's handleDrag to -1
            if editor's handleDrag >= 0:
                begin bim transaction in (the address of (editor's documentValue))
                set editor's dragging to true
                set editor's dragMoved to false
                return nothing
        set chosen to the bim selected slab of (@intrinsic("dereference", editor))
        if chosen's valid:
            set cornerIndex to the bim slab corner near editor's pointerLocation in chosen's slab within editor's pickTolerance
            if cornerIndex >= 0:
                begin bim transaction in (the address of (editor's documentValue))
                set editor's slabCorner to cornerIndex
                set editor's dragging to true
                set editor's dragMoved to false
                return nothing
            # An edge's middle drags that side across itself, its corners
            # sliding along the neighbouring edges' directions.
            set edgeIndex to the bim slab edge middle near editor's pointerLocation in chosen's slab within editor's pickTolerance
            if edgeIndex >= 0:
                begin bim transaction in (the address of (editor's documentValue))
                set editor's slabCorner to bim slab edge drag base - edgeIndex
                set editor's moveBase to editor's pointerLocation
                set editor's dragging to true
                set editor's dragMoved to false
                return nothing
        # The middle of the selected wall bends it.
        if editor's selectionKind = bim wall picked:
            set selectedFound to the bim wall index of editor's selectionId in editor's documentValue's current
            if selectedFound's valid:
                set selectedWall to the item at selectedFound's position in (editor's documentValue's current's walls's values)
                if (the cad distance from editor's pointerLocation to (the bim middle of wall selectedWall)) <= editor's pickTolerance:
                    begin bim transaction in (the address of (editor's documentValue))
                    set editor's bendWallId to selectedWall's id
                    set editor's dragging to true
                    set editor's dragMoved to false
                    return nothing
        set draggedEnds to a cad topology list of a bim wall end record
        if editor's snap's label = "End point":
            set draggedEnds to the bim wall ends meeting point on level editor's levelId in (@intrinsic("dereference", editor))
        if (the length of (draggedEnds's values)) = 0:
            select bim editor element at editor's pointerLocation in editor
            if editor's selectionKind != bim wall picked:
                # Any other element drags whole, moving live as the pointer
                # goes (as the Move tool does), once it has travelled half
                # the pick tolerance.
                set wholeKind to editor's selectionKind
                if ((wholeKind = bim slab picked) or (wholeKind = bim linear picked)) or (((wholeKind = bim instance picked) or (wholeKind = bim mesh picked)) or (wholeKind = bim sketch picked)):
                    begin bim transaction in (the address of (editor's documentValue))
                    set editor's handleDrag to bim whole drag
                    set editor's moveBase to point
                    set editor's dragging to true
                    set editor's dragMoved to false
                return nothing
            set draggedEnds to the bim wall ends moving with editor's selectionId in (@intrinsic("dereference", editor))
        begin bim transaction in (the address of (editor's documentValue))
        set editor's dragEnds to draggedEnds
        set editor's dragging to true
        set editor's dragMoved to false

function release bim editor pointer in {a pointer to a bim editor record:editor}:
    execute:
        if editor's dragging = false:
            return nothing
        set editor's dragging to false
        if editor's dragMoved:
            commit bim transaction in (the address of (editor's documentValue))
            if editor's handleDrag >= 0:
                set editor's message to the string form of "Shape changed"
            else if editor's handleDrag = bim whole drag:
                set editor's message to the string form of "Moved"
            else if editor's bendWallId != the bim refused id:
                set editor's message to the string form of "Bent"
            else if editor's slabCorner <= bim slab edge drag base:
                set editor's message to the string form of "Edge moved"
            else if editor's slabCorner < 0:
                set editor's message to the string form of "Moved"
            else if editor's message != "Corner added":
                set editor's message to the string form of "Corner moved"
        else:
            roll back bim transaction in (the address of (editor's documentValue))
        set editor's dragEnds to a cad topology list of a bim wall end record
        set editor's slabCorner to -1
        set editor's gridDragId to the bim refused id
        set editor's bendWallId to the bim refused id
        set editor's handleDrag to -1

# How tightly operator `operatorCode` binds: + and - 1, * and / 2, a
# leading minus (`u`) 3, a bracket 0.
function the bim binding of operator {integer:operatorCode}:
    execute:
        if (operatorCode = 43) or (operatorCode = 45):
            return 1
        if (operatorCode = 42) or (operatorCode = 47):
            return 2
        if operatorCode = 117:
            return 3
        return 0

# Applies the operator on top of `operators` to the values on top of
# `operands`, leaving its result there.
function apply bim operator from {a pointer to a list:operators} to {a pointer to a list:operands}:
    execute:
        set operatorCode to the item at ((the length of operators) - 1) in operators
        remove item ((the length of operators) - 1) from operators
        if (the length of operands) = 0:
            return nothing
        set right to the item at ((the length of operands) - 1) in operands
        remove item ((the length of operands) - 1) from operands
        if operatorCode = 117:
            append (0.0 - right) to operands
            return nothing
        set left to 0.0
        if (the length of operands) > 0:
            set left to the item at ((the length of operands) - 1) in operands
            remove item ((the length of operands) - 1) from operands
        if operatorCode = 43:
            append (left + right) to operands
        else if operatorCode = 45:
            append (left - right) to operands
        else if operatorCode = 42:
            append (left * right) to operands
        else if (operatorCode = 47) and (right != 0.0):
            append (left / right) to operands
        else:
            append left to operands

# The value of typed text: a number, or a sum as in a spreadsheet, such as
# "=1500+500" or "2*(1200+300)/3" (the leading = may be left out). An
# operator at the end (still being typed) is passed over.
function the bim numeric value of {a string:digits}:
    execute:
        set operands to an empty list of a 64 bit floating-point number
        set operators to an empty list of an integer
        set expectingValue to true
        set cursor to 0
        set count to the length of digits
        loop while cursor < count:
            set symbol to (the character at cursor in digits) as an integer
            if ((symbol >= 48) and (symbol <= 57)) or (symbol = 46):
                set ending to cursor
                set scanning to true
                loop while scanning:
                    if ending >= count:
                        set scanning to false
                    else:
                        set following to (the character at ending in digits) as an integer
                        if ((following >= 48) and (following <= 57)) or (following = 46):
                            set ending to ending + 1
                        else:
                            set scanning to false
                set piece to the substring of digits from cursor spanning (ending - cursor) bytes
                append (@intrinsic("call", "libc", "strtod", a 64 bit floating-point number, the data of piece, 0 as a pointer)) to operands
                set expectingValue to false
                set cursor to ending
            else:
                if symbol = 40:
                    append 40 to operators
                    set expectingValue to true
                else if symbol = 41:
                    set closing to true
                    loop while closing:
                        if (the length of operators) = 0:
                            set closing to false
                        else if (the item at ((the length of operators) - 1) in operators) = 40:
                            set closing to false
                        else:
                            apply bim operator from operators to operands
                    if (the length of operators) > 0:
                        remove item ((the length of operators) - 1) from operators
                    set expectingValue to false
                else if (((symbol = 43) or (symbol = 45)) or (symbol = 42)) or (symbol = 47):
                    set operatorCode to symbol
                    if expectingValue and (symbol = 45):
                        set operatorCode to 117
                    if (expectingValue and (symbol = 43)) = false:
                        if operatorCode != 117:
                            set reducing to true
                            loop while reducing:
                                if (the length of operators) = 0:
                                    set reducing to false
                                else if (the bim binding of operator (the item at ((the length of operators) - 1) in operators)) >= (the bim binding of operator operatorCode):
                                    apply bim operator from operators to operands
                                else:
                                    set reducing to false
                        append operatorCode to operators
                        set expectingValue to true
                set cursor to cursor + 1
        # A trailing operator, still being typed, does nothing.
        if expectingValue and ((the length of operators) > 0):
            set lastOperator to the item at ((the length of operators) - 1) in operators
            if (lastOperator != 40) and (lastOperator != 117):
                remove item ((the length of operators) - 1) from operators
        loop while (the length of operators) > 0:
            if (the item at ((the length of operators) - 1) in operators) = 40:
                remove item ((the length of operators) - 1) from operators
            else:
                apply bim operator from operators to operands
        set result to 0.0
        if (the length of operands) > 0:
            set result to the item at ((the length of operands) - 1) in operands
        free operands
        free operators
        return result

# ---------------------------------------------------------------- bending with joins

# One wall end that meets another wall's centreline between its ends.
class:
    patterns:
        [a|] bim attached end record
    members:
        wallId as a 64 bit integer
        atFinish as a boolean

# Bends wall `wallId` to `amount` (as `bend bim wall` does) and keeps the
# walls that meet it along its length (a T join) meeting it: each such end
# slides along its own wall onto the new centreline. Without this a partition
# would stop short of a wall bent away from it, and its rooms would run
# together.
function bend bim wall {a 64 bit integer:wallId} keeping its joins by {a 64 bit floating-point number:amount} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim wall index of wallId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set host to the item at found's position in (target's walls's values)
        set attached to an empty list of a bim attached end record
        loop cursor from 0 to the length of (target's walls's values):
            set other to the item at cursor in (target's walls's values)
            if (other's id != wallId) and (other's levelId = host's levelId):
                loop endIndex from 0 to 2:
                    set place to other's start
                    if endIndex = 1:
                        set place to other's finish
                    set onHost to (the bim distance from place to the centreline of host) <= 1e-6
                    set atHostEnd to ((the cad distance from place to host's start) <= 1e-6) or ((the cad distance from place to host's finish) <= 1e-6)
                    if onHost and (atHostEnd = false):
                        append (@intrinsic("construct", a bim attached end record, other's id, endIndex = 1)) to attached
        if (bend bim wall wallId by amount in target) = false:
            free attached
            return false
        set bent to the item at (the bim wall index of wallId in (@intrinsic("dereference", target)))'s position in (target's walls's values)
        set arc to the bim arc of bent
        loop cursor from 0 to the length of attached:
            set entry to the item at cursor in attached
            set otherFound to the bim wall index of entry's wallId in (@intrinsic("dereference", target))
            if otherFound's valid:
                set other to the item at otherFound's position in (target's walls's values)
                set anchorEnd to other's start
                set movingEnd to other's finish
                if entry's atFinish = false:
                    set anchorEnd to other's finish
                    set movingEnd to other's start
                set runLength to the cad distance from anchorEnd to movingEnd
                if runLength > 1e-9:
                    set dx to (movingEnd's x - anchorEnd's x) / runLength
                    set dy to (movingEnd's y - anchorEnd's y) / runLength
                    # Where the line from the anchorEnd end meets the new
                    # centreline: a circle, or the straight chord.
                    set reach to -1.0
                    if arc's curved:
                        set fx to anchorEnd's x - arc's centre's x
                        set fy to anchorEnd's y - arc's centre's y
                        set half to (fx * dx) + (fy * dy)
                        set rest to ((fx * fx) + (fy * fy)) - (arc's radius * arc's radius)
                        set discriminant to (half * half) - rest
                        if discriminant >= 0.0:
                            set root to the square root of discriminant
                            set nearer to (0.0 - half) - root
                            set farther to (0.0 - half) + root
                            # Prefer the crossing on the arc itself, then the one
                            # nearer where the end was.
                            set nearerPoint to a cad vector2 with x (anchorEnd's x + (nearer * dx)) and y (anchorEnd's y + (nearer * dy))
                            set fartherPoint to a cad vector2 with x (anchorEnd's x + (farther * dx)) and y (anchorEnd's y + (farther * dy))
                            set nearerFraction to the bim fraction of nearerPoint on arc
                            set fartherFraction to the bim fraction of fartherPoint on arc
                            set nearerOnArc to (nearerFraction >= -0.000001) and (nearerFraction <= 1.000001)
                            set fartherOnArc to (fartherFraction >= -0.000001) and (fartherFraction <= 1.000001)
                            set reach to nearer
                            if fartherOnArc and (nearerOnArc = false):
                                set reach to farther
                            else if (fartherOnArc = nearerOnArc) and ((the absolute value of (farther - runLength)) < (the absolute value of (nearer - runLength))):
                                set reach to farther
                    else:
                        set cx to bent's finish's x - bent's start's x
                        set cy to bent's finish's y - bent's start's y
                        set denominator to (dx * cy) - (dy * cx)
                        if (the absolute value of denominator) > 1e-12:
                            set reach to (((bent's start's x - anchorEnd's x) * cy) - ((bent's start's y - anchorEnd's y) * cx)) / denominator
                    if reach > 1e-6:
                        set landed to a cad vector2 with x (anchorEnd's x + (reach * dx)) and y (anchorEnd's y + (reach * dy))
                        if entry's atFinish:
                            ignore move bim wall other's id to other's start and landed in target
                        else:
                            ignore move bim wall other's id to landed and other's finish in target
        free attached
        return true

# ---------------------------------------------------------------- transforms

# A rigid change of the plan: a shift by `shift`, a turn about `centre` by
# `angle` (radians, anticlockwise), or a mirror in the line through `centre`
# along the unit `axis`.
class:
    patterns:
        [a|] bim transform record
    members:
        kind as an integer
        shift as a cad vector2
        centre as a cad vector2
        angle as a 64 bit floating-point number
        axis as a cad vector2

function bim shift transform kind:
    replacement:
        0
function bim turn transform kind:
    replacement:
        1
function bim mirror transform kind:
    replacement:
        2

function the bim shift transform by {cad vector2:offset}:
    execute:
        set origin to a cad vector2 with x 0.0 and y 0.0
        return @intrinsic("construct", a bim transform record, bim shift transform kind, offset, origin, 0.0, (a cad vector2 with x 1.0 and y 0.0))

function the bim turn transform about {cad vector2:pivot} by {a 64 bit floating-point number:turnAngle}:
    execute:
        set origin to a cad vector2 with x 0.0 and y 0.0
        return @intrinsic("construct", a bim transform record, bim turn transform kind, origin, pivot, turnAngle, (a cad vector2 with x 1.0 and y 0.0))

# The mirror in the line from `first` through `second`.
function the bim mirror transform from {cad vector2:first} through {cad vector2:second}:
    execute:
        set origin to a cad vector2 with x 0.0 and y 0.0
        set run to the cad distance from first to second
        set direction to a cad vector2 with x 1.0 and y 0.0
        if run > 1e-12:
            set direction to a cad vector2 with x ((second's x - first's x) / run) and y ((second's y - first's y) / run)
        return @intrinsic("construct", a bim transform record, bim mirror transform kind, origin, first, @intrinsic("atan2", direction's y, direction's x), direction)

function the bim point {cad vector2:location} under {bim transform record:change}:
    execute:
        if change's kind = bim shift transform kind:
            return a cad vector2 with x (location's x + change's shift's x) and y (location's y + change's shift's y)
        set dx to location's x - change's centre's x
        set dy to location's y - change's centre's y
        if change's kind = bim turn transform kind:
            set cosine to the cosine of change's angle
            set sine to the sine of change's angle
            return a cad vector2 with x (change's centre's x + ((dx * cosine) - (dy * sine))) and y (change's centre's y + ((dx * sine) + (dy * cosine)))
        set along to (dx * change's axis's x) + (dy * change's axis's y)
        return a cad vector2 with x (change's centre's x + (((2.0 * along) * change's axis's x) - dx)) and y (change's centre's y + (((2.0 * along) * change's axis's y) - dy))

# The direction `heading` (radians) after `change`.
function the bim heading {a 64 bit floating-point number:bearing} under {bim transform record:change}:
    execute:
        if change's kind = bim turn transform kind:
            return bearing + change's angle
        if change's kind = bim mirror transform kind:
            return (2.0 * change's angle) - bearing
        return bearing

# `points` after `change`, in reverse order when it mirrors (so that a ring
# keeps its turning sense).
function the bim corners {a pointer to a list:points} under {bim transform record:change}:
    execute:
        set result to an empty list of a cad vector2
        loop cursor from 0 to the length of points:
            set slot to cursor
            if change's kind = bim mirror transform kind:
                set slot to ((the length of points) - 1) - cursor
            append (the bim point (the item at slot in points) under change) to result
        return result

# The points of `meshValue` after `change`, each keeping its height.
function the bim mesh points of {bim mesh record:meshValue} under {bim transform record:change}:
    execute:
        set result to an empty list of a cad vector3
        loop cursor from 0 to the length of (meshValue's vertices's values):
            set spot to the item at cursor in (meshValue's vertices's values)
            set flat to the bim point (a cad vector2 with x spot's x and y spot's y) under change
            append (a cad vector3 with x flat's x, y flat's y and z spot's z) to result
        return result

# The faces of `meshValue` after `change`: each loop turned round when it
# mirrors (from the same first point, so that a face not quite flat is
# triangulated alike), so that the faces keep facing out.
function the bim mesh faces of {bim mesh record:meshValue} under {bim transform record:change}:
    execute:
        set result to an empty list of an integer
        set entries to meshValue's faces's values
        set start to 0
        loop while start < the length of entries:
            set count to the item at start in entries
            append count to result
            loop corner from 0 to count:
                set slot to corner
                if (change's kind = bim mirror transform kind) and (corner > 0):
                    set slot to count - corner
                append (the item at ((start + 1) + slot) in entries) to result
            set start to start + (count + 1)
        return result

# The id of the model's 3D view (the first view of the model kind, as the
# phases read it), or the refused id.
function the bim model view id of {bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of (editor's documentValue's current's views's values):
            set viewValue to the item at cursor in (editor's documentValue's current's views's values)
            if viewValue's kind = bim model view:
                return viewValue's id
        return the bim refused id

# Whether element `elementId` is hidden (HH) in the view with id `viewId`,
# in the plan shown, or in the 3D view.
function bim editor hides {a 64 bit integer:elementId} in view numbered {a 64 bit integer:viewId} of {bim editor record:editor}:
    execute:
        return bim element (elementId) is hidden in view viewId among (editor's hiddenElements's values)

function bim editor hides {a 64 bit integer:elementId} in plan of {bim editor record:editor}:
    execute:
        return bim element (elementId) is hidden in view (editor's planViewId) among (editor's hiddenElements's values)

function bim editor hides {a 64 bit integer:elementId} in model view of {bim editor record:editor}:
    execute:
        return bim element (elementId) is hidden in view (the bim model view id of editor) among (editor's hiddenElements's values)

# The elements the 3D view leaves out because they are hidden there (HH):
# those hidden, and the openings of a hidden wall, which go with it.
function the bim hidden ids in model view of {bim editor record:editor}:
    execute:
        set modelViewId to the bim model view id of editor
        set leftOut to the bim hidden ids in view modelViewId among (editor's hiddenElements's values)
        if (the length of (leftOut's values)) > 0:
            loop openingCursor from 0 to the length of (editor's documentValue's current's openings's values):
                set openingValue to the item at openingCursor in (editor's documentValue's current's openings's values)
                if bim element (openingValue's hostId) is hidden in view modelViewId among (editor's hiddenElements's values):
                    append openingValue's id to (leftOut's values)
        return leftOut

# HH: the selection (the selected element and every one chosen with it; a
# building system whole, a component's instance as one) hidden in view
# `viewId` for this session, and the selection cleared. Spaces and levels
# are not hidden. The model is not changed.
function hide bim editor selection in view numbered {a 64 bit integer:viewId} in {a pointer to a bim editor record:editor}:
    execute:
        if (editor's selectionKind = bim nothing picked) or (viewId = the bim refused id):
            set editor's message to the string form of "Hide element (HH): select what to hide first"
            return nothing
        if (editor's selectionKind = bim space picked) or (editor's selectionKind = bim level picked):
            set editor's message to the string form of "Hide element (HH): spaces and levels show by the view's rules"
            return nothing
        set chosenIds to the bim selection members of (@intrinsic("dereference", editor))
        set added to hide bim elements chosenIds in view viewId among (editor's hiddenElements's values)
        free chosenIds
        select bim editor bim nothing picked numbered (the bim refused id) in editor
        set editor's message to ((the string form of "Hidden in this view: ") + (the string form of added)) + (the string form of " (HR shows them again)")

# HR: every element view `viewId` hides shown again.
function restore bim editor hidden elements in view numbered {a 64 bit integer:viewId} in {a pointer to a bim editor record:editor}:
    execute:
        set restored to restore bim hidden elements in view viewId among (editor's hiddenElements's values)
        set editor's message to ((the string form of "Shown again in this view: ") + (the string form of restored))

# The ids the selection covers: the selected element, and every one chosen
# with it (Shift, or a selection box).
function the bim selection members of {bim editor record:editor}:
    execute:
        set ids to an empty list of a 64 bit integer
        append editor's selectionId to ids
        if editor's selectionKind != bim nothing picked:
            loop cursor from 0 to the length of (editor's chosenSketches's values):
                set chosen to the item at cursor in (editor's chosenSketches's values)
                if chosen != editor's selectionId:
                    append chosen to ids
        return ids

# The contour of building system `curtainId` turned round after its line
# came to run the other way (mirrored): each corner as far from the new
# start as it was from the old one, from the same first corner backwards,
# so that its arcs' spans simply come in reverse.
function turn bim face contour of {a 64 bit integer:curtainId} round in {a pointer to a bim model record:target}:
    execute:
        set found to the bim curtain index of curtainId in (@intrinsic("dereference", target))
        if found's valid = false:
            return nothing
        set curtainValue to the item at found's position in (target's curtains's values)
        set contourList to the bim face contour of curtainId in (@intrinsic("dereference", target))
        if (the length of contourList) >= 3:
            set run to the bim system length of curtainValue
            set turnedRound to an empty list of a cad vector2
            set firstCorner to the item at 0 in contourList
            append (a cad vector2 with x (run - firstCorner's x) and y firstCorner's y) to turnedRound
            set contourCursor to (the length of contourList) - 1
            loop while contourCursor >= 1:
                set corner to the item at contourCursor in contourList
                append (a cad vector2 with x (run - corner's x) and y corner's y) to turnedRound
                set contourCursor to contourCursor - 1
            set spanList to the bim boundary spans of curtainId in (@intrinsic("dereference", target))
            set reversedSpans to an empty list of an integer
            set spanCursor to (the length of spanList) - 1
            loop while spanCursor >= 0:
                append (the item at spanCursor in spanList) to reversedSpans
                set spanCursor to spanCursor - 1
            keep bim face contour turnedRound of curtainId in target
            keep bim boundary spans reversedSpans of curtainId in target
            free turnedRound
            free reversedSpans
            free spanList
        free contourList

# Places the selection as it was when the open transaction began (the
# snapshot it keeps), changed by `change`. A mirrored wall runs the other way,
# so that its exterior side follows, and its openings keep their places.
function reposition bim editor selection by {bim transform record:change} in {a pointer to a bim editor record:editor}:
    execute:
        set stack to editor's documentValue's undoStack's values
        if (the length of stack) = 0:
            return nothing
        set original to the item at ((the length of stack) - 1) in stack
        set target to the address of (editor's documentValue's current)
        set ids to the bim selection members of (@intrinsic("dereference", editor))
        # Refuse the whole operation rather than silently dropping host holes.
        loop checkedCursor from 0 to the length of ids:
            if bim plate (the item at checkedCursor in ids) has openings in (editor's documentValue's current):
                set editor's message to the string form of "Move/copy of floors with openings is not supported yet"
                free ids
                return nothing
        loop cursor from 0 to the length of ids:
            set elementId to the item at cursor in ids
            set wallFound to the bim wall index of elementId in original
            set gridFound to the bim grid index of elementId in original
            set slabFound to the bim slab index of elementId in original
            set instanceFound to the bim instance index of elementId in original
            set sketchFound to the bim sketch index of elementId in original
            set meshFound to the bim mesh index of elementId in original
            set linearFound to the bim linear index of elementId in original
            set rebarFound to the bim reinforcement index of elementId in original
            if rebarFound's valid:
                set rebarValue to the item at rebarFound's position in (original's reinforcements's values)
                if rebarValue's hostId = the bim refused id:
                    set movedStart to the bim point (a cad vector2 with x rebarValue's start's x and y rebarValue's start's y) under change
                    set movedFinish to the bim point (a cad vector2 with x rebarValue's finish's x and y rebarValue's finish's y) under change
                    set rebarValue's start to a cad vector3 with x movedStart's x, y movedStart's y and z rebarValue's start's z
                    set rebarValue's finish to a cad vector3 with x movedFinish's x, y movedFinish's y and z rebarValue's finish's z
                    ignore store bim reinforcement rebarValue in target
            if linearFound's valid:
                set linearValue to the item at linearFound's position in (original's linears's values)
                set movedStart to the bim point (a cad vector2 with x linearValue's start's x and y linearValue's start's y) under change
                set movedFinish to the bim point (a cad vector2 with x linearValue's finish's x and y linearValue's finish's y) under change
                set newAngle to linearValue's angle
                if change's kind = bim turn transform kind:
                    set newAngle to newAngle + change's angle
                ignore move bim linear elementId to (a cad vector3 with x movedStart's x, y movedStart's y and z linearValue's start's z) and (a cad vector3 with x movedFinish's x, y movedFinish's y and z linearValue's finish's z) turned newAngle in target
            if meshFound's valid:
                set meshValue to the item at meshFound's position in (original's meshes's values)
                set placedPoints to the bim mesh points of meshValue under change
                set placedFaces to the bim mesh faces of meshValue under change
                ignore set bim mesh elementId to placedPoints and placedFaces in target
                free placedPoints
                free placedFaces
            if wallFound's valid:
                set wallValue to the item at wallFound's position in (original's walls's values)
                set newStart to the bim point wallValue's start under change
                set newFinish to the bim point wallValue's finish under change
                if change's kind = bim mirror transform kind:
                    ignore move bim wall elementId to newFinish and newStart in target
                    set run to the bim centreline length of wallValue
                    loop openingCursor from 0 to the length of (original's openings's values):
                        set openingValue to the item at openingCursor in (original's openings's values)
                        if openingValue's hostId = elementId:
                            ignore move bim opening openingValue's id to (run - openingValue's offset) in target
                else:
                    ignore move bim wall elementId to newStart and newFinish in target
            else if gridFound's valid:
                set gridValue to the item at gridFound's position in (original's grids's values)
                ignore move bim grid elementId to (the bim point gridValue's start under change) and (the bim point gridValue's finish under change) in target
            else if slabFound's valid:
                set slabOriginal to the item at slabFound's position in (original's slabs's values)
                set placed to the bim corners (slabOriginal's outline's values) under change
                ignore set bim slab elementId outline to placed in target
                ignore set bim plate elementId top to slabOriginal's top pitch slabOriginal's pitch heading (the bim heading slabOriginal's heading under change) in target
                free placed
            else if instanceFound's valid:
                set placement to the item at instanceFound's position in (original's instances's values)
                ignore move bim instance elementId to (the bim point placement's origin under change) turned (the bim heading placement's angle under change) in target
            else if sketchFound's valid:
                set placed to the bim corners ((the item at sketchFound's position in (original's sketches's values))'s points's values) under change
                ignore set bim sketch elementId points to placed in target
                free placed
            # A building system follows its line; mirrored it runs the other
            # way, as a wall, and its contour turns round with it.
            set curtainFound to the bim curtain index of elementId in original
            if curtainFound's valid:
                set curtainOriginal to the item at curtainFound's position in (original's curtains's values)
                set newStart to the bim point curtainOriginal's start under change
                set newFinish to the bim point curtainOriginal's finish under change
                if change's kind = bim mirror transform kind:
                    ignore move bim curtain wall elementId to newFinish and newStart in target
                    turn bim face contour of elementId round in target
                else:
                    ignore move bim curtain wall elementId to newStart and newFinish in target
        free ids

# The 3D cursor lands at `location` on the active storey (Shift and the
# right button drag it, Shift+C takes it home).
function place bim editor cursor at {cad vector2:location} in {a pointer to a bim editor record:editor}:
    execute:
        set editor's cursorPoint to a cad vector3 with x location's x, y location's y and z 0.0
        set editor's message to (the string form of "3D cursor at ") + ((the bim length location's x in units editor's lengthUnit) + ((the string form of ", ") + (the bim length location's y in units editor's lengthUnit)))

# Where the selection lies, for the 3D gizmo: the middle of its control
# points (`the bim handles of`), height above its storey; `found`
# false when it has none.
class:
    patterns:
        [a|] bim selection centre record
    members:
        found as a boolean
        point as a cad vector3

function the bim selection centre of {bim editor record:editor}:
    execute:
        set controlList to an empty list of a cad vector3
        set any to false
        if editor's selectionKind = 30:
            set rebarFound to the bim reinforcement index of editor's selectionId in editor's documentValue's current
            if rebarFound's valid:
                set rebarValue to the item at rebarFound's position in (editor's documentValue's current's reinforcements's values)
                if rebarValue's hostId = the bim refused id:
                    append rebarValue's start to controlList
                    append rebarValue's finish to controlList
                    set any to true
        if bim kind (editor's selectionKind) has handles:
            set foundControls to the bim handles of editor's selectionKind numbered editor's selectionId in editor's documentValue's current
            loop foundCursor from 0 to the length of (foundControls's values):
                append (the item at foundCursor in (foundControls's values)) to controlList
            set any to (the length of controlList) > 0
        set accumulated to a cad vector3 with x 0.0, y 0.0 and z 0.0
        loop cursor from 0 to the length of controlList:
            set accumulated to the cad sum of accumulated and (the item at cursor in controlList)
        set count to the length of controlList
        free controlList
        if ((any = false) or (count = 0)) or (editor's selectionKind = bim level picked):
            return @intrinsic("construct", a bim selection centre record, false, accumulated)
        return @intrinsic("construct", a bim selection centre record, true, accumulated scaled by (1.0 / (count as a 64 bit floating-point number)))

# The gizmo drags the selection as one edit: begun, moved `offset` or turned
# `turnAngle` about `pivot` from where it was, then kept.
function begin bim editor gizmo drag in {a pointer to a bim editor record:editor}:
    execute:
        begin bim transaction in (the address of (editor's documentValue))

function drag bim editor gizmo by {cad vector2:offset} lifting {a 64 bit floating-point number:rise} turning {a 64 bit floating-point number:turnAngle} about {cad vector2:pivot} in {a pointer to a bim editor record:editor}:
    execute:
        set unitCode to editor's lengthUnit
        if turnAngle != 0.0:
            reposition bim editor selection by (the bim turn transform about pivot by turnAngle) in editor
            set editor's message to (the string form of "Turn ") + ((the string form of ((the floor of (((turnAngle * 180.0) / 3.141592653589793) + 0.5)) as an integer)) + (the string form of " deg"))
            return nothing
        reposition bim editor selection by (the bim shift transform by offset) in editor
        lift bim editor selection by rise in editor
        set editor's message to (the string form of "Move X ") + ((the bim length offset's x in units unitCode) + ((the string form of ", Y ") + ((the bim length offset's y in units unitCode) + ((the string form of ", Z ") + (the bim length rise in units unitCode)))))

# The selected element's control points `rise` higher than when the open
# transaction began, where it now stands in plan (the gizmo's Z arrow).
function lift bim editor selection by {a 64 bit floating-point number:rise} in {a pointer to a bim editor record:editor}:
    execute:
        set stack to editor's documentValue's undoStack's values
        if ((the length of stack) = 0) or ((bim kind (editor's selectionKind) has handles) = false):
            return nothing
        set original to the item at ((the length of stack) - 1) in stack
        if editor's selectionKind = bim slab picked:
            set plateFound to the bim slab index of editor's selectionId in editor's documentValue's current
            set originalFound to the bim slab index of editor's selectionId in original
            if plateFound's valid and originalFound's valid:
                set plate to the item at plateFound's position in (editor's documentValue's current's slabs's values)
                set beforePlate to the item at originalFound's position in (original's slabs's values)
                ignore set bim plate plate's id top to (beforePlate's top + rise) pitch plate's pitch heading plate's heading in (the address of (editor's documentValue's current))
            return nothing
        set before to the bim handles of editor's selectionKind numbered editor's selectionId in original
        set present to the bim handles of editor's selectionKind numbered editor's selectionId in editor's documentValue's current
        if (the length of (before's values)) != (the length of (present's values)):
            return nothing
        set raised to an empty list of a cad vector3
        loop cursor from 0 to the length of (present's values):
            set now to the item at cursor in (present's values)
            append (a cad vector3 with x now's x, y now's y and z ((the item at cursor in (before's values))'s z + rise)) to raised
        ignore (set bim handles of editor's selectionKind numbered editor's selectionId to raised in (the address of (editor's documentValue's current)))
        free raised

function finish bim editor gizmo drag in {a pointer to a bim editor record:editor}:
    execute:
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to the string form of "Moved with the gizmo"

function apply bim editor move by {cad vector2:offset} in {a pointer to a bim editor record:editor}:
    execute:
        reposition bim editor selection by (the bim shift transform by offset) in editor

# Copies of the selection changed by `change`, as one edit. A wall keeps its
# type, bulge and openings.
function copy bim editor selection changed by {bim transform record:change} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set ids to the bim selection members of (@intrinsic("dereference", editor))
        # Refuse the whole operation rather than silently dropping host holes.
        loop checkedCursor from 0 to the length of ids:
            if bim plate (the item at checkedCursor in ids) has openings in (editor's documentValue's current):
                set editor's message to the string form of "Move/copy of floors with openings is not supported yet"
                free ids
                return 0
        begin bim transaction in (the address of (editor's documentValue))
        set made to 0
        loop cursor from 0 to the length of ids:
            set elementId to the item at cursor in ids
            set wallFound to the bim wall index of elementId in (@intrinsic("dereference", target))
            set slabFound to the bim slab index of elementId in (@intrinsic("dereference", target))
            set gridFound to the bim grid index of elementId in (@intrinsic("dereference", target))
            set sketchFound to the bim sketch index of elementId in (@intrinsic("dereference", target))
            set instanceFound to the bim instance index of elementId in (@intrinsic("dereference", target))
            set meshFound to the bim mesh index of elementId in (@intrinsic("dereference", target))
            set linearFound to the bim linear index of elementId in (@intrinsic("dereference", target))
            if linearFound's valid:
                set linearValue to the item at linearFound's position in (target's linears's values)
                set movedStart to the bim point (a cad vector2 with x linearValue's start's x and y linearValue's start's y) under change
                set movedFinish to the bim point (a cad vector2 with x linearValue's finish's x and y linearValue's finish's y) under change
                set newAngle to linearValue's angle
                if change's kind = bim turn transform kind:
                    set newAngle to newAngle + change's angle
                if (add bim linear typed linearValue's typeId on linearValue's levelId from (a cad vector3 with x movedStart's x, y movedStart's y and z linearValue's start's z) to (a cad vector3 with x movedFinish's x, y movedFinish's y and z linearValue's finish's z) turned newAngle to target) != the bim refused id:
                    set made to made + 1
            if meshFound's valid:
                set meshValue to the item at meshFound's position in (target's meshes's values)
                set placedPoints to the bim mesh points of meshValue under change
                set placedFaces to the bim mesh faces of meshValue under change
                if (add bim mesh on meshValue's levelId with placedPoints and placedFaces to target) != the bim refused id:
                    set made to made + 1
                free placedPoints
                free placedFaces
            # A building system copied with its settings (type, pattern,
            # contour, lines moved), its unpinned parts pinned again (they
            # stay with the original); mirrored it runs the other way, as a
            # wall.
            set curtainFound to the bim curtain index of elementId in (@intrinsic("dereference", target))
            if curtainFound's valid:
                set curtainValue to the item at curtainFound's position in (target's curtains's values)
                set copyStart to the bim point curtainValue's start under change
                set copyFinish to the bim point curtainValue's finish under change
                set turning to change's kind = bim mirror transform kind
                if turning:
                    set swap to copyStart
                    set copyStart to copyFinish
                    set copyFinish to swap
                set freshSystem to add bim curtain wall on curtainValue's levelId from copyStart to copyFinish rising curtainValue's height in bays of curtainValue's bayWidth by curtainValue's rowHeight of curtainValue's material to target
                if freshSystem != the bim refused id:
                    set made to made + 1
                    copy bim properties of elementId to freshSystem in target
                    if curtainValue's bulge != 0.0:
                        ignore set bim curtain wall freshSystem bulge to curtainValue's bulge in target
                    set carried to an empty list of a bim setting record
                    loop settingCursor from 0 to the length of (target's settings's values):
                        set entry to the item at settingCursor in (target's settings's values)
                        if (entry's elementId = elementId) and ((entry's code < bim unpinned line setting) or (entry's code >= bim host system setting)):
                            append entry to carried
                    loop settingCursor from 0 to the length of carried:
                        set entry to the item at settingCursor in carried
                        set bim setting entry's code of freshSystem to entry's value keeping true in target
                    free carried
                    if turning:
                        turn bim face contour of freshSystem round in target
            if wallFound's valid:
                set wallValue to the item at wallFound's position in (target's walls's values)
                set newStart to the bim point wallValue's start under change
                set newFinish to the bim point wallValue's finish under change
                set mirrored to change's kind = bim mirror transform kind
                if mirrored:
                    set swap to newStart
                    set newStart to newFinish
                    set newFinish to swap
                set fresh to add bim wall typed wallValue's typeId on wallValue's levelId from newStart to newFinish to target
                if fresh != the bim refused id:
                    set made to made + 1
                    copy bim properties of elementId to fresh in target
                    if wallValue's bulge != 0.0:
                        ignore bend bim wall fresh by wallValue's bulge in target
                    set run to the bim centreline length of wallValue
                    loop openingCursor from 0 to the length of (target's openings's values):
                        set openingValue to the item at openingCursor in (target's openings's values)
                        if openingValue's hostId = elementId:
                            set along to openingValue's offset
                            if mirrored:
                                set along to run - openingValue's offset
                            ignore add bim opening typed openingValue's typeId in fresh at along to target
            else if slabFound's valid:
                set slabValue to the item at slabFound's position in (target's slabs's values)
                set placed to the bim corners (slabValue's outline's values) under change
                set freshSlab to add bim slab on slabValue's levelId around placed thick slabValue's thickness to target
                if freshSlab != the bim refused id:
                    copy bim properties of elementId to freshSlab in target
                    ignore set bim slab freshSlab material to slabValue's material in target
                    if slabValue's typeId != the bim refused id:
                        ignore set bim plate freshSlab type to slabValue's typeId in target
                    ignore set bim plate freshSlab top to slabValue's top pitch slabValue's pitch heading (the bim heading slabValue's heading under change) in target
                    set made to made + 1
                free placed
            else if gridFound's valid:
                set gridValue to the item at gridFound's position in (target's grids's values)
                set startPoint to the bim point gridValue's start under change
                set finishPoint to the bim point gridValue's finish under change
                set label to the bim next grid name from startPoint to finishPoint in (@intrinsic("dereference", target))
                if (add bim grid named label from startPoint to finishPoint reaching gridValue's low to gridValue's high to target) != the bim refused id:
                    set made to made + 1
            else if sketchFound's valid:
                set element to the item at sketchFound's position in (target's sketches's values)
                set placed to the bim corners (element's points's values) under change
                set fresh to the bim refused id
                if element's kind = bim line sketch:
                    set fresh to add bim line on element's levelId from (the item at 0 in placed) to (the item at 1 in placed) to target
                else if element's kind = bim face sketch:
                    set fresh to add bim face on element's levelId around placed to target
                    if (fresh != the bim refused id) and (element's height > 0.0):
                        ignore set bim face fresh height to element's height in target
                else:
                    set fresh to add bim text on element's levelId at (the item at 0 in placed) saying element's content to target
                if fresh != the bim refused id:
                    set made to made + 1
                free placed
            else if instanceFound's valid:
                set placement to the item at instanceFound's position in (target's instances's values)
                if (place bim component placement's componentId on placement's levelId at (the bim point placement's origin under change) turned (the bim heading placement's angle under change) to target) != the bim refused id:
                    set made to made + 1
        free ids
        if made = 0:
            roll back bim transaction in (the address of (editor's documentValue))
        else:
            commit bim transaction in (the address of (editor's documentValue))
        return made

function copy bim editor selection by {cad vector2:offset} in {a pointer to a bim editor record:editor}:
    execute:
        set made to copy bim editor selection changed by (the bim shift transform by offset) in editor
        if made = 0:
            set editor's message to the string form of "Copy: nothing here can be copied (floors with openings are not supported yet)"
        else:
            set editor's message to (the string form of "Copied ") + ((the string form of made) + (the string form of "; click again for another copy, Esc ends"))

# ---------------------------------------------------------------- trim and extend

# The straight line of wall, sketch line or grid `elementId`, or not valid
# (curved walls are not trimmed against yet).
class:
    patterns:
        [a|] bim segment choice record
    members:
        valid as a boolean
        start as a cad vector2
        finish as a cad vector2

function the bim segment of {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        set origin to a cad vector2 with x 0.0 and y 0.0
        set wallFound to the bim wall index of elementId in modelValue
        if wallFound's valid:
            set wallValue to the item at wallFound's position in (modelValue's walls's values)
            if wallValue's bulge = 0.0:
                return @intrinsic("construct", a bim segment choice record, true, wallValue's start, wallValue's finish)
        set linearFound to the bim linear index of elementId in modelValue
        if linearFound's valid:
            set member to the item at linearFound's position in (modelValue's linears's values)
            set first to a cad vector2 with x member's start's x and y member's start's y
            set last to a cad vector2 with x member's finish's x and y member's finish's y
            if (the cad distance from first to last) > 1e-6:
                return @intrinsic("construct", a bim segment choice record, true, first, last)
        set gridFound to the bim grid index of elementId in modelValue
        if gridFound's valid:
            set gridValue to the item at gridFound's position in (modelValue's grids's values)
            return @intrinsic("construct", a bim segment choice record, true, gridValue's start, gridValue's finish)
        set sketchFound to the bim sketch index of elementId in modelValue
        if sketchFound's valid:
            set element to the item at sketchFound's position in (modelValue's sketches's values)
            if element's kind = bim line sketch:
                return @intrinsic("construct", a bim segment choice record, true, the item at 0 in (element's points's values), the item at 1 in (element's points's values))
        return @intrinsic("construct", a bim segment choice record, false, origin, origin)

# Trims (`extending` false) or extends wall or sketch line `elementId` to the
# line of the boundary: trimming keeps the side `pick` is on, extending moves
# the end nearer `pick` onto the boundary, or trims like trimming when the
# boundary crosses the element (Revit's Trim/Extend Single Element). Returns
# a description.
function trim bim editor element {a 64 bit integer:elementId} at {cad vector2:pick} extending {boolean:extending} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set boundary to the bim segment of editor's boundaryId in (@intrinsic("dereference", target))
        set piece to the bim segment of elementId in (@intrinsic("dereference", target))
        if (boundary's valid = false) or (piece's valid = false):
            return the string form of "pick a straight wall or a line"
        set dx to piece's finish's x - piece's start's x
        set dy to piece's finish's y - piece's start's y
        set boundaryX to boundary's finish's x - boundary's start's x
        set boundaryY to boundary's finish's y - boundary's start's y
        set denominator to (dx * boundaryY) - (dy * boundaryX)
        if (the absolute value of denominator) <= 1e-12:
            return the string form of "it runs parallel to the boundary"
        set t to (((boundary's start's x - piece's start's x) * boundaryY) - ((boundary's start's y - piece's start's y) * boundaryX)) / denominator
        set meeting to a cad vector2 with x (piece's start's x + (t * dx)) and y (piece's start's y + (t * dy))
        set runSquared to (dx * dx) + (dy * dy)
        set pickT to (((pick's x - piece's start's x) * dx) + ((pick's y - piece's start's y) * dy)) / runSquared
        set newStart to piece's start
        set newFinish to piece's finish
        set crossing to (t > 0.0) and (t < 1.0)
        if extending and (crossing = false):
            if pickT < 0.5:
                set newStart to meeting
            else:
                set newFinish to meeting
        else:
            if crossing = false:
                return the string form of "the boundary does not cross it"
            if pickT > t:
                set newStart to meeting
            else:
                set newFinish to meeting
        if (the cad distance from newStart to newFinish) <= 1e-6:
            return the string form of "nothing would be left"
        begin bim transaction in (the address of (editor's documentValue))
        set changed to false
        if (the bim wall index of elementId in (@intrinsic("dereference", target)))'s valid:
            set changed to move bim wall elementId to newStart and newFinish in target
        else:
            set ends to an empty list of a cad vector2
            append newStart to ends
            append newFinish to ends
            set changed to set bim sketch elementId points to ends in target
            free ends
        if changed:
            commit bim transaction in (the address of (editor's documentValue))
            if extending and (crossing = false):
                return the string form of "Extended"
            return the string form of "Trimmed"
        roll back bim transaction in (the address of (editor's documentValue))
        return the string form of "refused"

# Moves the selected element `elementId` (a wall, grid or line parallel to
# the reference, `boundaryId`) across onto the reference's line, as one
# edit; its joined walls follow as a move would make them. Returns what
# happened.
function align bim editor element {a 64 bit integer:elementId} at {cad vector2:pick} to the reference in {a pointer to a bim editor record:editor}:
    execute:
        set referenceLine to the bim segment of editor's boundaryId in editor's documentValue's current
        set piece to the bim segment of elementId in editor's documentValue's current
        if (referenceLine's valid = false) or (piece's valid = false):
            return the string form of "Align: a straight wall, grid or line only"
        set referenceRun to the cad distance from referenceLine's start to referenceLine's finish
        set pieceRun to the cad distance from piece's start to piece's finish
        if (referenceRun <= 1e-9) or (pieceRun <= 1e-9):
            return the string form of "Align: too short"
        set rx to (referenceLine's finish's x - referenceLine's start's x) / referenceRun
        set ry to (referenceLine's finish's y - referenceLine's start's y) / referenceRun
        set px to (piece's finish's x - piece's start's x) / pieceRun
        set py to (piece's finish's y - piece's start's y) / pieceRun
        if (the absolute value of ((rx * py) - (ry * px))) > 0.001:
            return the string form of "Align: it is not parallel to the reference"
        set nx to 0.0 - ry
        set ny to rx
        # A wall is aligned by its face on the side clicked, a grid or a
        # line by itself (Revit's Align to faces).
        set referenceFace to the bim face offset of editor's boundaryId toward editor's moveBase from referenceLine across nx and ny in editor's documentValue's current
        set pieceFace to the bim face offset of elementId toward pick from piece across nx and ny in editor's documentValue's current
        set apart to ((((piece's start's x - referenceLine's start's x) * nx) + ((piece's start's y - referenceLine's start's y) * ny)) + pieceFace) - referenceFace
        if (the absolute value of apart) <= 1e-9:
            return the string form of "Align: already aligned"
        begin bim transaction in (the address of (editor's documentValue))
        apply bim editor move by (a cad vector2 with x (0.0 - (apart * nx)) and y (0.0 - (apart * ny))) in editor
        commit bim transaction in (the address of (editor's documentValue))
        return (the string form of "Aligned, moved ") + (the bim length (the absolute value of apart) in units editor's lengthUnit)

# How far the face of element `elementId` on the side of `pick` lies from
# its line `piece` across (`nx`, `ny`): half a wall's thickness to that side;
# 0 for a grid or a line.
function the bim face offset of {a 64 bit integer:elementId} toward {cad vector2:pick} from {bim segment choice record:piece} across {a 64 bit floating-point number:nx} and {a 64 bit floating-point number:ny} in {bim model record:modelValue}:
    execute:
        set wallFound to the bim wall index of elementId in modelValue
        if wallFound's valid = false:
            return 0.0
        set halfThickness to (the bim wall thickness of (the item at wallFound's position in (modelValue's walls's values)) in modelValue) * 0.5
        set side to ((pick's x - piece's start's x) * nx) + ((pick's y - piece's start's y) * ny)
        if side < 0.0:
            return 0.0 - halfThickness
        return halfThickness

# AL in the 3D view: the first click takes the face under the pointer as
# the reference plane; each later one moves the element of the face clicked
# along the reference's normal until that face lies in the plane, as one
# edit. The faces must be parallel: an upright one moves across the plan, a
# level one up or down.
function align bim editor face {bim face pick record:seenFace} in {a pointer to a bim editor record:editor}:
    execute:
        if (seenFace's found = false) or (((seenFace's kind = bim imported picked) or (seenFace's kind = bim opening picked)) or (seenFace's kind = bim space picked)):
            set editor's message to the string form of "Align: click a face of an element"
            return nothing
        if editor's alignFaceSet = false:
            set editor's alignSpot to seenFace's spot
            set editor's alignNormal to seenFace's normal
            set editor's alignFaceSet to true
            set editor's message to the string form of "Align: click the face to bring into the reference's plane; Esc ends"
            return nothing
        set reference to editor's alignNormal
        if (the absolute value of (the cad dot of reference and seenFace's normal)) < 0.999:
            set editor's message to the string form of "Align: that face is not parallel to the reference"
            return nothing
        set gap to the cad dot of (the cad difference of editor's alignSpot and seenFace's spot) and reference
        if (the absolute value of gap) <= 1e-6:
            set editor's message to the string form of "Align: already in the reference's plane"
            return nothing
        set shift to reference scaled by gap
        select bim editor seenFace's kind numbered seenFace's id in editor
        set upright to (the absolute value of reference's z) <= 0.02
        set level to (the absolute value of reference's z) >= 0.98
        if (upright = false) and (level = false):
            set editor's message to the string form of "Align: only upright or level faces"
            return nothing
        begin bim transaction in (the address of (editor's documentValue))
        set moved to true
        if upright:
            apply bim editor move by (a cad vector2 with x shift's x and y shift's y) in editor
        else if seenFace's kind = bim slab picked:
            set plateFound to the bim slab index of seenFace's id in editor's documentValue's current
            set moved to false
            if plateFound's valid:
                set plate to the item at plateFound's position in (editor's documentValue's current's slabs's values)
                set moved to set bim plate seenFace's id top to (plate's top + shift's z) pitch plate's pitch heading plate's heading in (the address of (editor's documentValue's current))
        else if bim kind (seenFace's kind) has handles:
            lift bim editor selection by shift's z in editor
        else:
            set moved to false
        if moved = false:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Align: that element cannot move that way"
            return nothing
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to (the string form of "Aligned, moved ") + (the bim length (the absolute value of gap) in units editor's lengthUnit)

# Level `levelId` moves to `height` (aligned in a section), keeping its
# storey height, as one edit.
function align bim editor level {a 64 bit integer:levelId} to height {a 64 bit floating-point number:height} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set found to the bim level index of levelId in (@intrinsic("dereference", target))
        if found's valid = false:
            return nothing
        set levelValue to the item at found's position in (target's levels's values)
        begin bim transaction in (the address of (editor's documentValue))
        if set bim level levelId at height with height levelValue's height in target:
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to ((the string form of "Aligned: level ") + levelValue's name) + ((the string form of " at ") + (the bim length height in units editor's lengthUnit))
        else:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Align refused"

# The ends of straight segment `piece` cut or stretched to `meeting` on the
# line through it, keeping the part `pick` lies on: when `meeting` lies within
# the segment the side of `pick` stays, otherwise the end nearer `meeting`
# moves onto it.
function the bim segment {bim segment choice record:piece} cornered at {cad vector2:meeting} keeping {cad vector2:pick}:
    execute:
        set dx to piece's finish's x - piece's start's x
        set dy to piece's finish's y - piece's start's y
        set runSquared to (dx * dx) + (dy * dy)
        set along to (((meeting's x - piece's start's x) * dx) + ((meeting's y - piece's start's y) * dy)) / runSquared
        set pickAlong to (((pick's x - piece's start's x) * dx) + ((pick's y - piece's start's y) * dy)) / runSquared
        if (along > 0.0) and (along < 1.0):
            if pickAlong > along:
                return @intrinsic("construct", a bim segment choice record, true, meeting, piece's finish)
            return @intrinsic("construct", a bim segment choice record, true, piece's start, meeting)
        if along <= 0.0:
            return @intrinsic("construct", a bim segment choice record, true, meeting, piece's finish)
        return @intrinsic("construct", a bim segment choice record, true, piece's start, meeting)

# Moves the ends of wall or sketch line `elementId` to `cut`'s.
function place bim segment {a 64 bit integer:elementId} as {bim segment choice record:cut} in {a pointer to a bim model record:target}:
    execute:
        if (the bim wall index of elementId in (@intrinsic("dereference", target)))'s valid:
            return move bim wall elementId to cut's start and cut's finish in target
        set linearFound to the bim linear index of elementId in (@intrinsic("dereference", target))
        if linearFound's valid:
            set member to the item at linearFound's position in (target's linears's values)
            set first to the bim point on linear member at plan cut's start
            set last to the bim point on linear member at plan cut's finish
            return move bim linear elementId to first and last turned member's angle in target
        set ends to an empty list of a cad vector2
        append cut's start to ends
        append cut's finish to ends
        set placed to set bim sketch elementId points to ends in target
        free ends
        return placed

# The straight wall or sketch line of the active storey nearest to
# `location` for TR: a wall within its thickness (plus the pick tolerance)
# of its line, a line within twice the tolerance; else the refused id.
function the bim trim candidate at {cad vector2:location} for {bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        set nearest to the bim refused id
        set nearestGap to 1.0e30
        loop cursor from 0 to the length of (modelValue's walls's values):
            set wallValue to the item at cursor in (modelValue's walls's values)
            if (wallValue's levelId = editor's levelId) and (wallValue's bulge = 0.0):
                set gap to the cad distance from location to the segment from wallValue's start to wallValue's finish
                set reach to ((the bim wall thickness of wallValue in modelValue) * 0.5) + (editor's pickTolerance * 1.5)
                if (gap <= reach) and (gap < nearestGap):
                    set nearest to wallValue's id
                    set nearestGap to gap
        loop cursor from 0 to the length of (modelValue's linears's values):
            set member to the item at cursor in (modelValue's linears's values)
            set axis to the bim segment of member's id in modelValue
            if (member's levelId = editor's levelId) and axis's valid:
                set typeFound to the bim linear type index of member's typeId in modelValue
                if typeFound's valid:
                    set memberType to the item at typeFound's position in (modelValue's linearTypes's values)
                    set gap to the cad distance from location to the segment from axis's start to axis's finish
                    set reach to ((the maximum of memberType's width and memberType's depth) * 0.5) + editor's pickTolerance
                    if (gap <= reach) and (gap < nearestGap):
                        set nearest to member's id
                        set nearestGap to gap
        loop cursor from 0 to the length of (modelValue's sketches's values):
            set element to the item at cursor in (modelValue's sketches's values)
            if (element's levelId = editor's levelId) and ((element's kind = bim line sketch) and ((the length of (element's points's values)) >= 2)):
                set gap to the cad distance from location to the segment from (the item at 0 in (element's points's values)) to (the item at 1 in (element's points's values))
                if (gap <= (editor's pickTolerance * 2.0)) and (gap < nearestGap):
                    set nearest to element's id
                    set nearestGap to gap
        return nearest

# The pick kind of TR's candidate `elementId`: a wall or a sketch line.
function the bim kind of trim candidate {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        if (the bim wall index of elementId in modelValue)'s valid:
            return bim wall picked
        if (the bim linear index of elementId in modelValue)'s valid:
            return bim linear picked
        return bim sketch picked

# Trims or extends walls or sketch lines `firstId` and `secondId` to the
# corner where their lines meet, as one edit, keeping the part of each that
# was clicked (`firstPick`, `secondPick`). Returns a description.
function trim bim editor corner of {a 64 bit integer:firstId} at {cad vector2:firstPick} and {a 64 bit integer:secondId} at {cad vector2:secondPick} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set firstSegment to the bim segment of firstId in (@intrinsic("dereference", target))
        set secondSegment to the bim segment of secondId in (@intrinsic("dereference", target))
        if (firstSegment's valid = false) or (secondSegment's valid = false):
            return the string form of "Trim to corner: pick straight walls or lines"
        set dx to firstSegment's finish's x - firstSegment's start's x
        set dy to firstSegment's finish's y - firstSegment's start's y
        set otherX to secondSegment's finish's x - secondSegment's start's x
        set otherY to secondSegment's finish's y - secondSegment's start's y
        set denominator to (dx * otherY) - (dy * otherX)
        if (the absolute value of denominator) <= 1e-12:
            return the string form of "Trim to corner: they run parallel"
        set t to (((secondSegment's start's x - firstSegment's start's x) * otherY) - ((secondSegment's start's y - firstSegment's start's y) * otherX)) / denominator
        set meeting to a cad vector2 with x (firstSegment's start's x + (t * dx)) and y (firstSegment's start's y + (t * dy))
        set firstMember to the bim linear index of firstId in (@intrinsic("dereference", target))
        set secondMember to the bim linear index of secondId in (@intrinsic("dereference", target))
        if firstMember's valid and secondMember's valid:
            set firstPoint to the bim point on linear (the item at firstMember's position in (target's linears's values)) at plan meeting
            set secondPoint to the bim point on linear (the item at secondMember's position in (target's linears's values)) at plan meeting
            if (the absolute value of (firstPoint's z - secondPoint's z)) > 0.001:
                return the string form of "Trim to corner: beam axes do not meet at the same height"
        set firstCut to the bim segment firstSegment cornered at meeting keeping firstPick
        set secondCut to the bim segment secondSegment cornered at meeting keeping secondPick
        if ((the cad distance from firstCut's start to firstCut's finish) <= 1e-6) or ((the cad distance from secondCut's start to secondCut's finish) <= 1e-6):
            return the string form of "Trim to corner: nothing would be left"
        begin bim transaction in (the address of (editor's documentValue))
        set placed to place bim segment firstId as firstCut in target
        if placed:
            set placed to place bim segment secondId as secondCut in target
        if placed:
            commit bim transaction in (the address of (editor's documentValue))
            return the string form of "Trimmed to corner"
        roll back bim transaction in (the address of (editor's documentValue))
        return the string form of "Trim to corner: refused"

# ---------------------------------------------------------------- push/pull of a mesh face

# Starts pushing face `start` of mesh `meshId`: it follows the pointer up the
# plan (or the 3D view, along the face's normal) or a typed distance.
function start bim editor push of mesh {a 64 bit integer:meshId} face {integer:start} in {a pointer to a bim editor record:editor}:
    execute:
        begin bim transaction in (the address of (editor's documentValue))
        set editor's tool to bim push tool
        set editor's pushId to meshId
        set editor's pushFace to start
        set editor's pushEdge to -1
        set editor's pushOrigin to editor's pointerLocation
        set editor's numeric to the string form of ""
        set editor's message to the string form of "Push/pull the face: move out or in, or type a distance, then click or Enter"

# The pushed mesh face `distance` out along its normal from where it was when
# the push began.
function push bim editor mesh face by {a 64 bit floating-point number:distance} in {a pointer to a bim editor record:editor}:
    execute:
        set stack to editor's documentValue's undoStack's values
        if (the length of stack) = 0:
            return nothing
        set original to the item at ((the length of stack) - 1) in stack
        set found to the bim mesh index of editor's pushId in original
        if found's valid = false:
            return nothing
        if push bim mesh editor's pushId face editor's pushFace of (the item at found's position in (original's meshes's values)) by distance in (the address of (editor's documentValue's current)):
            show bim editor preview in editor
            set editor's message to (the string form of "Push/pull the face: ") + (the bim length distance in units editor's lengthUnit)

# A line drawn across face `start` of mesh `meshId` from `fromSpot` to
# `toSpot` (on its outline, in the mesh's coordinates) cuts it in two, as
# one edit; the two faces can then be pushed apart.
function split bim editor mesh {a 64 bit integer:meshId} face {integer:start} from {cad vector3:fromSpot} to {cad vector3:toSpot} in {a pointer to a bim editor record:editor}:
    execute:
        begin bim transaction in (the address of (editor's documentValue))
        if split bim mesh meshId face start from fromSpot to toSpot in (the address of (editor's documentValue's current)):
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Split the face"
            return true
        roll back bim transaction in (the address of (editor's documentValue))
        set editor's message to the string form of "Line on a face: click two points on its edges, not on one edge"
        return false

# Explicit Split commits mass conversion and subdivision together. Only free
# sketch masses or meshes qualify; semantic BIM objects never become meshes.
function split bim editor sketch mesh {a 64 bit integer:sourceId} mass {boolean:isMass} face {integer:faceStart} from {cad vector3:fromSpot} to {cad vector3:toSpot} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set meshId to sourceId
        if isMass:
            set sourceFound to the bim sketch index of sourceId in (@intrinsic("dereference", target))
            if sourceFound's valid = false:
                return false
            set sourceValue to the item at sourceFound's position in (target's sketches's values)
            if (sourceValue's kind != bim face sketch) or (sourceValue's height <= 0.0):
                set editor's message to the string form of "3D Split currently requires a positive-height sketch mass or an existing mesh"
                return false
        else if (the bim mesh index of meshId in (@intrinsic("dereference", target)))'s valid = false:
            return false
        begin bim transaction in (the address of (editor's documentValue))
        if isMass:
            set meshId to make bim mesh of mass sourceId in target
        set changed to false
        if meshId != the bim refused id:
            set changed to split bim mesh meshId face faceStart from fromSpot to toSpot in target
        if changed:
            commit bim transaction in (the address of (editor's documentValue))
            select bim editor bim mesh picked numbered meshId in editor
            set editor's viewsDirty to true
            set editor's message to the string form of "Split the sketch face; Push/Pull can move either part"
            return true
        roll back bim transaction in (the address of (editor's documentValue))
        set editor's message to the string form of "Split refused: choose two different edges of the same face"
        return false

# Start from the actual 3D hit ID, rather than repicking an overlapping plan face.
function start bim editor push of sketch {a 64 bit integer:sketchId} side {integer:edgeIndex} in {a pointer to a bim editor record:editor}:
    execute:
        if editor's pushId != the bim refused id:
            return false
        set found to the bim sketch index of sketchId in editor's documentValue's current
        if found's valid = false:
            return false
        set faceValue to the item at found's position in (editor's documentValue's current's sketches's values)
        if faceValue's kind != bim face sketch:
            return false
        if (edgeIndex >= 0) and (faceValue's height = 0.0):
            return false
        if (edgeIndex < -1) or (edgeIndex >= (the length of (faceValue's points's values))):
            return false
        begin bim transaction in (the address of (editor's documentValue))
        set editor's tool to bim push tool
        set editor's pushId to sketchId
        set editor's pushEdge to edgeIndex
        set editor's pushFace to -1
        set editor's pushOrigin to editor's pointerLocation
        set editor's pushBase to faceValue's height
        set editor's numeric to the string form of ""
        set editor's message to the string form of "Push/pull the side: move out or in, or type a distance, then click or Enter"
        if edgeIndex = -1:
            set editor's message to the string form of "Push/pull: move up or type a height, then click or Enter"
        return true

# ---------------------------------------------------------------- push/pull of a side

# The outward normal of the pushed side, from the face as the push began.
function the bim push normal of {bim editor record:editor}:
    execute:
        set stack to editor's documentValue's undoStack's values
        set none to a cad vector2 with x 0.0 and y 0.0
        if (the length of stack) = 0:
            return none
        set original to the item at ((the length of stack) - 1) in stack
        set found to the bim sketch index of editor's pushId in original
        if found's valid = false:
            return none
        set ring to (the item at found's position in (original's sketches's values))'s points's values
        set count to the length of ring
        set here to the item at editor's pushEdge in ring
        set following to the item at (the remainder of (editor's pushEdge + 1) divided by count) in ring
        set dx to following's x - here's x
        set dy to following's y - here's y
        set run to the square root of ((dx * dx) + (dy * dy))
        if run <= 1e-12:
            return none
        set turning to 1.0
        if (the cad signed area of ring) < 0.0:
            set turning to -1.0
        return a cad vector2 with x ((turning * dy) / run) and y ((0.0 - (turning * dx)) / run)

# The pushed face as the push began, with its side moved `distance` out (in
# when negative), as in SketchUp: the side's two corners are joined to their
# moved copies, and points left on a straight line or doubling back are taken
# out, so that a rectangle simply grows or shrinks.
function push bim editor side by {a 64 bit floating-point number:distance} in {a pointer to a bim editor record:editor}:
    execute:
        set stack to editor's documentValue's undoStack's values
        if (the length of stack) = 0:
            return nothing
        set original to the item at ((the length of stack) - 1) in stack
        set found to the bim sketch index of editor's pushId in original
        if found's valid = false:
            return nothing
        set ring to (the item at found's position in (original's sketches's values))'s points's values
        set count to the length of ring
        set normal to the bim push normal of (@intrinsic("dereference", editor))
        set shift to a cad vector2 with x (normal's x * distance) and y (normal's y * distance)
        set grown to an empty list of a cad vector2
        loop cursor from 0 to count:
            set point to the item at cursor in ring
            append point to grown
            if cursor = editor's pushEdge:
                set following to the item at (the remainder of (cursor + 1) divided by count) in ring
                append (a cad vector2 with x (point's x + shift's x) and y (point's y + shift's y)) to grown
                append (a cad vector2 with x (following's x + shift's x) and y (following's y + shift's y)) to grown
        # Points on a straight line with their neighbours, or doubling back.
        set cleaning to true
        loop while cleaning and ((the length of grown) > 3):
            set cleaning to false
            set size to the length of grown
            set removal to -1
            loop cursor from 0 to size:
                if removal < 0:
                    set before to the item at (the remainder of ((cursor + size) - 1) divided by size) in grown
                    set here to the item at cursor in grown
                    set after to the item at (the remainder of (cursor + 1) divided by size) in grown
                    set turn to ((before's x - here's x) * (after's y - here's y)) - ((before's y - here's y) * (after's x - here's x))
                    set spanOne to the cad distance from before to here
                    set spanTwo to the cad distance from here to after
                    if ((the absolute value of turn) <= (1e-9 * ((spanOne * spanTwo) + 1e-12))) or ((spanOne <= 1e-9) or (spanTwo <= 1e-9)):
                        set removal to cursor
            if removal >= 0:
                remove item removal from grown
                set cleaning to true
        ignore set bim sketch editor's pushId points to grown in (the address of (editor's documentValue's current))
        free grown
        show bim editor preview in editor


# ---------------------------------------------------------------- control points

# The pick kind of a reinforcement definition (its bars share its id).
function bim reinforcement picked:
    replacement:
        30

# The points an element is edited by in edit mode, in model coordinates
# (plan position and height above its storey): a grid's, wall's or linear
# element's two ends, a floor's corners, a level's one point at its
# elevation, reinforcement without a host its axis's two ends. One way to
# edit every element, as Blender edits every object.
function the bim handles of {integer:pickKind} numbered {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        set found to a cad topology list of a cad vector3
        if pickKind = bim grid picked:
            set gridFound to the bim grid index of elementId in modelValue
            if gridFound's valid:
                set gridValue to the item at gridFound's position in (modelValue's grids's values)
                append (a cad vector3 with x gridValue's start's x, y gridValue's start's y and z 0.0) to (found's values)
                append (a cad vector3 with x gridValue's finish's x, y gridValue's finish's y and z 0.0) to (found's values)
        if pickKind = bim wall picked:
            set wallFound to the bim wall index of elementId in modelValue
            if wallFound's valid:
                set wallValue to the item at wallFound's position in (modelValue's walls's values)
                append (a cad vector3 with x wallValue's start's x, y wallValue's start's y and z wallValue's baseOffset) to (found's values)
                append (a cad vector3 with x wallValue's finish's x, y wallValue's finish's y and z wallValue's baseOffset) to (found's values)
        if pickKind = bim linear picked:
            set linearFound to the bim linear index of elementId in modelValue
            if linearFound's valid:
                set linearValue to the item at linearFound's position in (modelValue's linears's values)
                append linearValue's start to (found's values)
                append linearValue's finish to (found's values)
        if pickKind = bim reinforcement picked:
            # Reinforcement on a host follows the host and has no points of
            # its own; its generated bars are never points either.
            set rebarFound to the bim reinforcement index of elementId in modelValue
            if rebarFound's valid:
                set rebarValue to the item at rebarFound's position in (modelValue's reinforcements's values)
                if rebarValue's hostId = the bim refused id:
                    append rebarValue's start to (found's values)
                    append rebarValue's finish to (found's values)
        if pickKind = bim slab picked:
            set slabFound to the bim slab index of elementId in modelValue
            if slabFound's valid:
                set slabValue to the item at slabFound's position in (modelValue's slabs's values)
                loop corner from 0 to the length of (slabValue's outline's values):
                    set outlinePoint to the item at corner in (slabValue's outline's values)
                    append (a cad vector3 with x outlinePoint's x, y outlinePoint's y and z 0.0) to (found's values)
        if pickKind = bim level picked:
            set levelFound to the bim level index of elementId in modelValue
            if levelFound's valid:
                append (a cad vector3 with x 0.0, y 0.0 and z (the item at levelFound's position in (modelValue's levels's values))'s elevation) to (found's values)
        if pickKind = bim curtain picked:
            # A building system: its two ends, then each inner mullion's
            # foot on the line, then each inner transom and its top, over the
            # middle of the line. A nested one follows its panel and has none.
            set curtainFound to the bim curtain index of elementId in modelValue
            if curtainFound's valid and ((the bim setting (bim host system setting) of elementId in modelValue)'s found = false):
                set curtainValue to the item at curtainFound's position in (modelValue's curtains's values)
                set middlePoint to the bim system point at ((the bim system length of curtainValue) * 0.5) of curtainValue
                append (a cad vector3 with x curtainValue's start's x, y curtainValue's start's y and z 0.0) to (found's values)
                append (a cad vector3 with x curtainValue's finish's x, y curtainValue's finish's y and z 0.0) to (found's values)
                loop lineCursor from 1 to the bim bay count of curtainValue:
                    set linePoint to the bim system point at (the bim mullion lineCursor along curtainValue in modelValue) of curtainValue
                    append (a cad vector3 with x linePoint's x, y linePoint's y and z 0.0) to (found's values)
                loop lineCursor from 1 to the bim row count of curtainValue:
                    append (a cad vector3 with x middlePoint's x, y middlePoint's y and z (the bim transom lineCursor along curtainValue in modelValue)) to (found's values)
                append (a cad vector3 with x middlePoint's x, y middlePoint's y and z curtainValue's height) to (found's values)
        return found

# Whether elements of pick kind `pickKind` are edited by control points.
function bim kind {integer:pickKind} has handles:
    execute:
        if (pickKind = bim grid picked) or (pickKind = bim wall picked):
            return true
        if (pickKind = bim linear picked) or ((pickKind = bim slab picked) or (pickKind = bim level picked)):
            return true
        return (pickKind = bim curtain picked) or (pickKind = bim reinforcement picked)

# Element `elementId` takes `pointList` as its control points (see `the bim
# handles of`); refused as the element's own edit refuses them.
function set bim handles of {integer:pickKind} numbered {a 64 bit integer:elementId} to {a pointer to a list:pointList} in {a pointer to a bim model record:target}:
    execute:
        set count to the length of pointList
        if count = 0:
            return false
        set first to the item at 0 in pointList
        set last to the item at (count - 1) in pointList
        if (pickKind = bim grid picked) and (count = 2):
            return move bim grid elementId to (a cad vector2 with x first's x and y first's y) and (a cad vector2 with x last's x and y last's y) in target
        if (pickKind = bim wall picked) and (count = 2):
            # Both ends at a new height: the wall rises as a whole, as its
            # base offset does; a top held at a level stays there.
            set wallFound to the bim wall index of elementId in (@intrinsic("dereference", target))
            if wallFound's valid:
                set wallValue to the item at wallFound's position in (target's walls's values)
                if ((the absolute value of (first's z - wallValue's baseOffset)) > 1e-9) and ((the absolute value of (last's z - first's z)) < 1e-9):
                    if set bim wall elementId base to first's z and height to wallValue's height in target:
                        if wallValue's topLevelId != the bim refused id:
                            ignore (hold bim wall elementId top at level wallValue's topLevelId in target)
            return move bim wall elementId to (a cad vector2 with x first's x and y first's y) and (a cad vector2 with x last's x and y last's y) in target
        if (pickKind = bim linear picked) and (count = 2):
            set linearFound to the bim linear index of elementId in (@intrinsic("dereference", target))
            if linearFound's valid = false:
                return false
            return move bim linear elementId to first and last turned (the item at linearFound's position in (target's linears's values))'s angle in target
        if (pickKind = bim reinforcement picked) and (count = 2):
            # Only the definition's axis moves, its bars regenerate from it;
            # refused on a host and for an axis the definition refuses.
            set rebarFound to the bim reinforcement index of elementId in (@intrinsic("dereference", target))
            if rebarFound's valid = false:
                return false
            set rebarValue to the item at rebarFound's position in (target's reinforcements's values)
            if rebarValue's hostId != the bim refused id:
                return false
            set rebarValue's start to first
            set rebarValue's finish to last
            return (store bim reinforcement rebarValue in target) != the bim refused id
        if pickKind = bim slab picked:
            set corners to an empty list of a cad vector2
            loop cursor from 0 to count:
                set corner to the item at cursor in pointList
                append (a cad vector2 with x corner's x and y corner's y) to corners
            set applied to set bim slab elementId outline to corners in target
            free corners
            return applied
        if pickKind = bim level picked:
            set levelFound to the bim level index of elementId in (@intrinsic("dereference", target))
            if levelFound's valid = false:
                return false
            return set bim level elementId at first's z with height (the item at levelFound's position in (target's levels's values))'s height in target
        if pickKind = bim curtain picked:
            return set bim system handles of elementId to pointList in target
        return false

# Building system `curtainId` takes `pointList` (see `the bim handles of`):
# its height from the last, its line from the first two, then each inner
# grid line whose point moved
# goes to it, measured along the new line or up from the foot. Lines are
# tried from both sides, so a group moved together passes its neighbours'
# old places. Refused when the line or every moved grid line is refused.
function set bim system handles of {a 64 bit integer:curtainId} to {a pointer to a list:pointList} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim curtain index of curtainId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set curtainValue to the item at found's position in (target's curtains's values)
        set bays to the bim bay count of curtainValue
        set rows to the bim row count of curtainValue
        if (the length of pointList) != ((bays + rows) + 1):
            return false
        set first to the item at 0 in pointList
        set last to the item at 1 in pointList
        # The top first: a new height.
        set topPoint to the item at (bays + rows) in pointList
        if (the absolute value of (topPoint's z - curtainValue's height)) > 0.0005:
            if (set bim curtain wall curtainId height to topPoint's z in target) = false:
                return false
            set curtainValue to the item at found's position in (target's curtains's values)
            if ((the bim bay count of curtainValue) != bays) or ((the bim row count of curtainValue) != rows):
                return true
        set lineStart to a cad vector2 with x first's x and y first's y
        set lineFinish to a cad vector2 with x last's x and y last's y
        if ((the cad distance from lineStart to curtainValue's start) > 1e-9) or ((the cad distance from lineFinish to curtainValue's finish) > 1e-9):
            if (move bim curtain wall curtainId to lineStart and lineFinish in target) = false:
                return false
            set curtainValue to the item at found's position in (target's curtains's values)
            # A length that changes the number of bays or rows renumbers
            # the lines; their even spacing then stands.
            if ((the bim bay count of curtainValue) != bays) or ((the bim row count of curtainValue) != rows):
                return true
        set wanted to an empty list of a 64 bit floating-point number
        set lineCodes to an empty list of an integer
        loop cursor from 2 to (bays + rows):
            set grip to the item at cursor in pointList
            if cursor < (bays + 1):
                append (cursor - 1) to lineCodes
                append (the bim system station of (a cad vector2 with x grip's x and y grip's y) on curtainValue)'s x to wanted
            else:
                append (1000 + (cursor - bays)) to lineCodes
                append grip's z to wanted
        set settled to true
        loop pass from 0 to 2:
            loop step from 0 to the length of lineCodes:
                set slot to step
                if pass = 1:
                    set slot to ((the length of lineCodes) - 1) - step
                set code to the item at slot in lineCodes
                set goal to the item at slot in wanted
                set present to the bim system line position of (the item at found's position in (target's curtains's values)) coded code in (@intrinsic("dereference", target))
                if (the absolute value of (goal - present)) > 0.0005:
                    if (move bim system line code of curtainId to goal in target) = false:
                        if pass = 1:
                            set settled to false
        free wanted
        free lineCodes
        return settled

# ---------------------------------------------------------------- edit mode

# The sketch element in edit mode, as it is now; `found` false when gone.
function the bim edited sketch of {bim editor record:editor}:
    execute:
        set found to the bim sketch index of editor's editSketchId in editor's documentValue's current
        return found

# The pick kind of the host of reinforcement `rebarValue` (a linear
# element, a plate or a wall); nothing picked when it has none or it is gone.
function the bim host kind of reinforcement {reinforcement definition:rebarValue} in {bim model record:modelValue}:
    execute:
        if rebarValue's hostId = the bim refused id:
            return bim nothing picked
        if (the bim linear index of rebarValue's hostId in modelValue)'s valid:
            return bim linear picked
        if (the bim slab index of rebarValue's hostId in modelValue)'s valid:
            return bim slab picked
        if (the bim wall index of rebarValue's hostId in modelValue)'s valid:
            return bim wall picked
        return bim nothing picked

# Tab on the selection: edit mode. Reinforcement without a host is edited by
# its axis's two ends, as any element by its points. Reinforcement on a host
# keeps following it: Tab selects the host and edits the host's geometry,
# and says so; the reinforcement is never cut loose from it.
function enter bim editor edit mode in {a pointer to a bim editor record:editor}:
    execute:
        # Placement takes pointer input before edit mode. End an active rebar
        # placement when Tab switches to editing the selected object's points.
        if (editor's tool >= 30) and (editor's tool <= 35):
            set editor's tool to bim select tool
            set editor's moveStage to 0
        if editor's selectionKind != bim reinforcement picked:
            enter bim editor ordinary edit mode in editor
            return nothing
        set modelValue to editor's documentValue's current
        set rebarFound to the bim reinforcement index of editor's selectionId in modelValue
        if rebarFound's valid = false:
            set editor's message to the string form of "Tab: select an element to edit its points"
            return nothing
        set rebarValue to the item at rebarFound's position in (modelValue's reinforcements's values)
        if rebarValue's hostId = the bim refused id:
            enter bim editor ordinary edit mode in editor
            if editor's editMode:
                set editor's message to (the string form of "Edit mode (reinforcement ") + (rebarValue's mark + (the string form of "): its two ends; G grabs, X Y Z constrain; Tab leaves"))
            return nothing
        set hostKind to the bim host kind of reinforcement rebarValue in modelValue
        if hostKind = bim nothing picked:
            set editor's message to (the string form of "Tab: the host of reinforcement ") + (rebarValue's mark + (the string form of " is gone; place it again or delete it"))
            return nothing
        select bim editor hostKind numbered (rebarValue's hostId) in editor
        enter bim editor ordinary edit mode in editor
        set hostEditing to editor's editMode or (bim editor sketches a boundary (@intrinsic("dereference", editor)))
        if hostEditing:
            set editor's message to (the string form of "Reinforcement ") + (rebarValue's mark + ((the string form of " follows its host: editing the host's geometry. ") + editor's message))
        else:
            set editor's message to (the string form of "Reinforcement ") + (rebarValue's mark + (the string form of " follows its host, whose geometry is not edited by points; host selected"))

# Tab on a selected sketch element: edit mode, its points to pick and grab.
# A mass becomes a free mesh first, as in Blender, so that each of its points
# moves in 3D; a mesh is edited as it is.
local function enter bim editor ordinary edit mode in {a pointer to a bim editor record:editor}:
    execute:
        set editor's editMesh to false
        # A plate, a wall or a building system: its outline as a sketch; a
        # building system's chosen grid line is edited as a control point.
        set chosenLine to (editor's selectionKind = bim curtain picked) and ((editor's partCode >= 0) and (editor's partCode < 2000))
        if (((editor's selectionKind = bim slab picked) or (editor's selectionKind = bim curtain picked)) or (editor's selectionKind = bim wall picked)) and (chosenLine = false):
            open bim editor boundary sketch in editor
            if bim editor sketches a boundary (@intrinsic("dereference", editor)):
                return nothing
        if editor's selectionKind = bim sketch picked:
            set found to the bim sketch index of editor's selectionId in editor's documentValue's current
            if found's valid:
                set element to the item at found's position in (editor's documentValue's current's sketches's values)
                if (element's kind = bim face sketch) and (element's height > 0.0):
                    begin bim transaction in (the address of (editor's documentValue))
                    set fresh to make bim mesh of mass element's id in (the address of (editor's documentValue's current))
                    if fresh = the bim refused id:
                        roll back bim transaction in (the address of (editor's documentValue))
                    else:
                        commit bim transaction in (the address of (editor's documentValue))
                        set editor's selectionKind to bim mesh picked
                        set editor's selectionId to fresh
                        set editor's chosenSketches to a cad topology list of a 64 bit integer
        if bim kind (editor's selectionKind) has handles:
            set editor's editMode to true
            set editor's editKind to editor's selectionKind
            set editor's editSketchId to editor's selectionId
            set editor's editPicked to a cad topology list of an integer
            if editor's selectionKind = bim level picked:
                # A level has one point: its height, grabbed along Z.
                append 0 to (editor's editPicked's values)
                set editor's message to the string form of "Edit mode (level): G Z moves it up or down, type a distance; Tab leaves"
            else if ((editor's selectionKind = bim curtain picked) and (editor's partCode > 0)) and (editor's partCode < 2000):
                # A chosen grid line comes picked: G moves it at once.
                set curtainFound to the bim curtain index of editor's selectionId in editor's documentValue's current
                if curtainFound's valid:
                    set curtainValue to the item at curtainFound's position in (editor's documentValue's current's curtains's values)
                    if bim system line (editor's partCode) of curtainValue moves:
                        if editor's partCode < 1000:
                            append (editor's partCode + 1) to (editor's editPicked's values)
                        else:
                            append ((the bim bay count of curtainValue) + (editor's partCode - 1000)) to (editor's editPicked's values)
                set editor's message to the string form of "Edit mode (building system): the ends, inner mullions and transoms; G grabs, X Y Z constrain; Tab leaves"
            else:
                set editor's message to the string form of "Edit mode: click points (Shift adds, A all); G grabs, X Y Z constrain; Tab leaves"
            return nothing
        if editor's selectionKind = bim mesh picked:
            set editor's editMode to true
            set editor's editKind to bim mesh picked
            set editor's editMesh to true
            set editor's editSketchId to editor's selectionId
            set editor's editPicked to a cad topology list of an integer
            set editor's message to the string form of "Edit mode (mesh): click points, edges or faces (Shift adds, A all); G grabs, X Y Z constrain; Tab leaves"
            return nothing
        if editor's selectionKind != bim sketch picked:
            set editor's message to the string form of "Tab: select an element to edit its points"
            return nothing
        set editor's editMode to true
        set editor's editKind to bim sketch picked
        set editor's editSketchId to editor's selectionId
        set editor's editPicked to a cad topology list of an integer
        set editor's message to the string form of "Edit mode: click points, edges or the face (Shift adds, A all); G grabs, X Y Z constrain; Tab leaves"

# Point `pointIndex` of the edited mesh picked, as a click in the 3D view
# finds it; Shift adds.
function pick bim editor mesh point {integer:pointIndex} in {a pointer to a bim editor record:editor}:
    execute:
        if editor's extending = false:
            set editor's editPicked to a cad topology list of an integer
        add bim edit point pointIndex in editor
        set editor's message to (the string form of "Picked points: ") + (the string form of (the length of (editor's editPicked's values)))

# The points of the edited mesh's face starting at `start` picked.
function pick bim editor mesh face {integer:start} in {a pointer to a bim editor record:editor}:
    execute:
        set found to the bim mesh index of editor's editSketchId in editor's documentValue's current
        if found's valid = false:
            return nothing
        set meshValue to the item at found's position in (editor's documentValue's current's meshes's values)
        if editor's extending = false:
            set editor's editPicked to a cad topology list of an integer
        loop corner from 0 to (the item at start in (meshValue's faces's values)):
            add bim edit point (the item at ((start + 1) + corner) in (meshValue's faces's values)) in editor
        set editor's message to (the string form of "Picked a face: ") + ((the string form of (the length of (editor's editPicked's values))) + (the string form of " points"))

# Picks the edited mesh's points at `location` in the plan, seen from above:
# the nearest point (the highest of those stacked there), else the ends of
# the highest edge passing near, else the points of the face seen there.
function pick bim editor mesh points at {cad vector2:location} in {a pointer to a bim editor record:editor}:
    execute:
        set found to the bim mesh index of editor's editSketchId in editor's documentValue's current
        if found's valid = false:
            set editor's editMode to false
            return nothing
        set meshValue to the item at found's position in (editor's documentValue's current's meshes's values)
        set tolerance to editor's pickTolerance * 1.5
        set nearest to -1
        set nearestGap to tolerance
        set nearestZ to 0.0
        loop cursor from 0 to the length of (meshValue's vertices's values):
            set point to the item at cursor in (meshValue's vertices's values)
            set gap to the cad distance from location to (a cad vector2 with x point's x and y point's y)
            set closer to gap < (nearestGap - 1e-9)
            set stacked to (the absolute value of (gap - nearestGap)) <= 1e-9
            if closer or (stacked and ((nearest < 0) or (point's z > nearestZ))):
                if gap <= tolerance:
                    set nearest to cursor
                    set nearestGap to gap
                    set nearestZ to point's z
        if nearest >= 0:
            pick bim editor mesh point nearest in editor
            return nothing
        set entries to meshValue's faces's values
        set edgeFirst to -1
        set edgeSecond to -1
        set edgeZ to 0.0 - (1.0 / 0.0)
        set start to 0
        loop while start < the length of entries:
            set count to the item at start in entries
            loop corner from 0 to count:
                set here to the item at ((start + 1) + corner) in entries
                set following to the item at ((start + 1) + (the remainder of (corner + 1) divided by count)) in entries
                set endA to the item at here in (meshValue's vertices's values)
                set endB to the item at following in (meshValue's vertices's values)
                set gap to the cad distance from location to the segment from (a cad vector2 with x endA's x and y endA's y) to (a cad vector2 with x endB's x and y endB's y)
                if (gap <= tolerance) and (((endA's z + endB's z) * 0.5) > edgeZ):
                    set edgeFirst to here
                    set edgeSecond to following
                    set edgeZ to (endA's z + endB's z) * 0.5
            set start to start + (count + 1)
        if edgeFirst >= 0:
            if editor's extending = false:
                set editor's editPicked to a cad topology list of an integer
            add bim edit point edgeFirst in editor
            add bim edit point edgeSecond in editor
            set editor's message to the string form of "Picked an edge"
            return nothing
        set face to the bim top face of mesh meshValue at location
        if face >= 0:
            pick bim editor mesh face face in editor
            return nothing
        if editor's extending = false:
            set editor's editPicked to a cad topology list of an integer
        set editor's message to the string form of "Nothing picked"

# The points edit mode edits, in model coordinates (height above the active
# storey): the edited mesh's points, or the element's control points.
function the bim edit points of {bim editor record:editor}:
    execute:
        set found to a cad topology list of a cad vector3
        if editor's editMesh:
            set meshFound to the bim mesh index of editor's editSketchId in editor's documentValue's current
            if meshFound's valid:
                set meshValue to the item at meshFound's position in (editor's documentValue's current's meshes's values)
                loop cursor from 0 to the length of (meshValue's vertices's values):
                    append (the item at cursor in (meshValue's vertices's values)) to (found's values)
            return found
        if bim kind (editor's editKind) has handles:
            return the bim handles of editor's editKind numbered editor's editSketchId in editor's documentValue's current
        return found

# Box selection in edit mode, as in Blender: every edit point whose place on
# screen (`pixels`, one per point of `the bim edit points of`) lies in the
# box from `corner` to `opposite` is picked; Shift adds to the points picked.
function pick bim editor points among {a pointer to a list:pixels} in box from {cad vector2:corner} to {cad vector2:opposite} in {a pointer to a bim editor record:editor}:
    execute:
        if editor's extending = false:
            set editor's editPicked to a cad topology list of an integer
        set lowX to the minimum of corner's x and opposite's x
        set highX to the maximum of corner's x and opposite's x
        set lowY to the minimum of corner's y and opposite's y
        set highY to the maximum of corner's y and opposite's y
        loop cursor from 0 to the length of pixels:
            set spot to the item at cursor in pixels
            if ((spot's x >= lowX) and (spot's x <= highX)) and ((spot's y >= lowY) and (spot's y <= highY)):
                if (bim edit point cursor is picked in (@intrinsic("dereference", editor))) = false:
                    add bim edit point cursor in editor
        set editor's message to (the string form of "Picked points: ") + (the string form of (the length of (editor's editPicked's values)))

function bim edit point {integer:pointIndex} is picked in {bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of (editor's editPicked's values):
            if (the item at cursor in (editor's editPicked's values)) = pointIndex:
                return true
        return false

function add bim edit point {integer:pointIndex} in {a pointer to a bim editor record:editor}:
    execute:
        if (bim edit point pointIndex is picked in (@intrinsic("dereference", editor))) = false:
            append pointIndex to (editor's editPicked's values)

# Picks the edited element's points at `location`: the nearest point, else
# both ends of the nearest edge, else all of a face clicked inside, as in
# SketchUp; Shift adds to the picked points.
function pick bim editor points at {cad vector2:location} in {a pointer to a bim editor record:editor}:
    execute:
        if editor's editMesh:
            pick bim editor mesh points at location in editor
            return nothing
        if bim kind (editor's editKind) has handles:
            set controlList to an empty list of a cad vector3
            set foundControls to the bim handles of editor's editKind numbered editor's editSketchId in editor's documentValue's current
            loop foundCursor from 0 to the length of (foundControls's values):
                append (the item at foundCursor in (foundControls's values)) to controlList
            if editor's extending = false:
                set editor's editPicked to a cad topology list of an integer
            set nearest to -1
            set nearestGap to editor's pickTolerance * 1.5
            loop cursor from 0 to the length of controlList:
                set controlPoint to the item at cursor in controlList
                set gap to the cad distance from location to (a cad vector2 with x controlPoint's x and y controlPoint's y)
                if gap <= nearestGap:
                    set nearestGap to gap
                    set nearest to cursor
            free controlList
            if nearest >= 0:
                add bim edit point nearest in editor
                set editor's message to (the string form of "Picked points: ") + (the string form of (the length of (editor's editPicked's values)))
            else:
                set editor's message to the string form of "Nothing picked"
            return nothing
        set found to the bim edited sketch of (@intrinsic("dereference", editor))
        if found's valid = false:
            set editor's editMode to false
            return nothing
        set element to the item at found's position in (editor's documentValue's current's sketches's values)
        set ring to element's points's values
        if editor's extending = false:
            set editor's editPicked to a cad topology list of an integer
        set tolerance to editor's pickTolerance * 1.5
        set nearest to -1
        set nearestGap to tolerance
        loop cursor from 0 to the length of ring:
            set gap to the cad distance from location to (the item at cursor in ring)
            if gap <= nearestGap:
                set nearestGap to gap
                set nearest to cursor
        if nearest >= 0:
            add bim edit point nearest in editor
            set editor's message to (the string form of "Picked points: ") + (the string form of (the length of (editor's editPicked's values)))
            return nothing
        set count to the length of ring
        set edgeCount to count
        if element's kind = bim line sketch:
            set edgeCount to 1
        loop cursor from 0 to edgeCount:
            set following to the remainder of (cursor + 1) divided by count
            if (the cad distance from location to the segment from (the item at cursor in ring) to (the item at following in ring)) <= tolerance:
                add bim edit point cursor in editor
                add bim edit point following in editor
                set editor's message to the string form of "Picked an edge"
                return nothing
        if (element's kind = bim face sketch) and (bim flat point location lies in ring):
            pick bim editor all points in editor
            return nothing
        set editor's message to the string form of "Nothing picked"

function pick bim editor all points in {a pointer to a bim editor record:editor}:
    execute:
        if editor's editMesh:
            set meshFound to the bim mesh index of editor's editSketchId in editor's documentValue's current
            if meshFound's valid:
                set total to the length of ((the item at meshFound's position in (editor's documentValue's current's meshes's values))'s vertices's values)
                set editor's editPicked to a cad topology list of an integer
                loop cursor from 0 to total:
                    append cursor to (editor's editPicked's values)
                set editor's message to (the string form of "Picked all ") + ((the string form of total) + (the string form of " points"))
            return nothing
        if bim kind (editor's editKind) has handles:
            set controlList to an empty list of a cad vector3
            set foundControls to the bim handles of editor's editKind numbered editor's editSketchId in editor's documentValue's current
            loop foundCursor from 0 to the length of (foundControls's values):
                append (the item at foundCursor in (foundControls's values)) to controlList
            set editor's editPicked to a cad topology list of an integer
            loop cursor from 0 to the length of controlList:
                append cursor to (editor's editPicked's values)
            set editor's message to (the string form of "Picked all ") + ((the string form of (the length of controlList)) + (the string form of " points"))
            free controlList
            return nothing
        set found to the bim edited sketch of (@intrinsic("dereference", editor))
        if found's valid = false:
            return nothing
        set element to the item at found's position in (editor's documentValue's current's sketches's values)
        set editor's editPicked to a cad topology list of an integer
        loop cursor from 0 to the length of (element's points's values):
            append cursor to (editor's editPicked's values)
        set editor's message to (the string form of "Picked all ") + ((the string form of (the length of (element's points's values))) + (the string form of " points"))

# G: grabs the picked points.
function start bim editor grab in {a pointer to a bim editor record:editor}:
    execute:
        if (the length of (editor's editPicked's values)) = 0:
            set editor's message to the string form of "G: pick points first"
            return nothing
        begin bim transaction in (the address of (editor's documentValue))
        set editor's grabbing to true
        set editor's grabAxis to 0
        set editor's grabBase to editor's pointerLocation
        set editor's numeric to the string form of ""
        set editor's message to the string form of "Grab: move, X Y Z constrain, type a distance; click or Enter places, Esc cancels"

# The picked control points of the element in edit mode moved `offset` and
# lifted `lift` from where they were in `earlier`, the model before the grab.
function shift bim editor handles by {cad vector2:offset} lifting {a 64 bit floating-point number:lift} from {bim model record:earlier} in {a pointer to a bim editor record:editor}:
    execute:
        set before to the bim handles of editor's editKind numbered editor's editSketchId in earlier
        set after to an empty list of a cad vector3
        loop cursor from 0 to the length of (before's values):
            set controlPoint to the item at cursor in (before's values)
            if bim edit point cursor is picked in (@intrinsic("dereference", editor)):
                set controlPoint to a cad vector3 with x (controlPoint's x + offset's x), y (controlPoint's y + offset's y) and z (controlPoint's z + lift)
            append controlPoint to after
        set accepted to set bim handles of editor's editKind numbered editor's editSketchId to after in (the address of (editor's documentValue's current))
        if accepted = false:
            # Refused where the points would go: the element stands as it did
            # when the grab began, not where it was last accepted, so that
            # placing the grab here changes nothing.
            ignore (set bim handles of editor's editKind numbered editor's editSketchId to (before's values) in (the address of (editor's documentValue's current)))
            set editor's message to the string form of "Refused: the element cannot take these points"
        free after

# Whether the control points of the element in edit mode stand where they
# did when the open transaction began.
function bim editor handles are unmoved in {bim editor record:editor}:
    execute:
        set stack to editor's documentValue's undoStack's values
        if (the length of stack) = 0:
            return false
        set earlier to the item at ((the length of stack) - 1) in stack
        set beforeHandles to the bim handles of editor's editKind numbered editor's editSketchId in earlier
        set nowHandles to the bim handles of editor's editKind numbered editor's editSketchId in editor's documentValue's current
        if (the length of (beforeHandles's values)) != (the length of (nowHandles's values)):
            return false
        loop cursor from 0 to the length of (nowHandles's values):
            if (the cad distance from (the item at cursor in (beforeHandles's values)) to (the item at cursor in (nowHandles's values))) > 1e-9:
                return false
        return true

# Places the picked points `offset` away from where they were when the grab
# began, and a mass `lift` higher (Z).
function apply bim editor grab by {cad vector2:offset} lifting {a 64 bit floating-point number:lift} in {a pointer to a bim editor record:editor}:
    execute:
        set stack to editor's documentValue's undoStack's values
        if (the length of stack) = 0:
            return nothing
        set original to the item at ((the length of stack) - 1) in stack
        if editor's editMesh:
            set meshFound to the bim mesh index of editor's editSketchId in original
            if meshFound's valid = false:
                return nothing
            set meshValue to the item at meshFound's position in (original's meshes's values)
            set shifted to an empty list of a cad vector3
            loop cursor from 0 to the length of (meshValue's vertices's values):
                set spot to the item at cursor in (meshValue's vertices's values)
                if bim edit point cursor is picked in (@intrinsic("dereference", editor)):
                    set spot to a cad vector3 with x (spot's x + offset's x), y (spot's y + offset's y) and z (spot's z + lift)
                append spot to shifted
            ignore set bim mesh editor's editSketchId to shifted and (meshValue's faces's values) in (the address of (editor's documentValue's current))
            free shifted
            show bim editor preview in editor
            return nothing
        if bim kind (editor's editKind) has handles:
            shift bim editor handles by offset lifting lift from original in editor
            show bim editor preview in editor
            return nothing
        set found to the bim sketch index of editor's editSketchId in original
        if found's valid = false:
            return nothing
        set element to the item at found's position in (original's sketches's values)
        set target to the address of (editor's documentValue's current)
        set moved to an empty list of a cad vector2
        loop cursor from 0 to the length of (element's points's values):
            set point to the item at cursor in (element's points's values)
            if bim edit point cursor is picked in (@intrinsic("dereference", editor)):
                set point to a cad vector2 with x (point's x + offset's x) and y (point's y + offset's y)
            append point to moved
        ignore set bim sketch editor's editSketchId points to moved in target
        free moved
        if (lift != 0.0) and (element's kind = bim face sketch):
            ignore set bim face editor's editSketchId height to (the maximum of 0.0 and (element's height + lift)) in target
        show bim editor preview in editor

# Ends the grab: kept, unless a face would cross itself; control points the
# element refused, or that did not move, leave no edit (and no undo step).
function finish bim editor grab in {a pointer to a bim editor record:editor}:
    execute:
        set typedDistance to (the length of editor's numeric) > 0
        set editor's grabbing to false
        set editor's numeric to the string form of ""
        if editor's editMesh and ((bim editor mesh editor's editSketchId stays sound in (@intrinsic("dereference", editor))) = false):
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Refused: the mesh would turn inside out"
            return nothing
        set found to the bim edited sketch of (@intrinsic("dereference", editor))
        if (found's valid and (editor's editMesh = false)) and (editor's editKind = bim sketch picked):
            set element to the item at found's position in (editor's documentValue's current's sketches's values)
            if (element's kind = bim face sketch) and ((bim outline (element's points's values) is simple) = false):
                roll back bim transaction in (the address of (editor's documentValue))
                set editor's message to the string form of "Refused: the face would cross itself"
                return nothing
        set pointsKept to (editor's editMesh = false) and (bim kind (editor's editKind) has handles)
        if pointsKept and (bim editor handles are unmoved in (@intrinsic("dereference", editor))):
            roll back bim transaction in (the address of (editor's documentValue))
            set pointerMoved to (the cad distance from (editor's grabBase) to (editor's pointerLocation)) > 1e-9
            if pointerMoved or typedDistance:
                set editor's message to the string form of "Refused: the element cannot take these points; nothing changed"
            else:
                set editor's message to the string form of "Nothing moved"
            return nothing
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to the string form of "Moved the points"

# Keys during a grab: X, Y and Z constrain (again: free), a typed distance in
# the project's units (- turns it round) and Enter places it, Esc cancels.
function type bim editor grab key {integer:code} in {a pointer to a bim editor record:editor}:
    execute:
        if (code = 88) or ((code = 89) or (code = 90)):
            set axis to code - 87
            if editor's grabAxis = axis:
                set editor's grabAxis to 0
            else:
                set editor's grabAxis to axis
            set names to (the string form of "free") 
            if editor's grabAxis = 1:
                set names to the string form of "along X"
            if editor's grabAxis = 2:
                set names to the string form of "along Y"
            if editor's grabAxis = 3:
                set names to the string form of "along Z (height)"
            set editor's message to (the string form of "Grab ") + names
            move bim editor pointer to editor's pointerLocation within editor's pickTolerance in editor
            return nothing
        if ((code >= 48) and (code <= 57)) or ((code = 46) or (code = 45)):
            set digit to a new string buffer containing 1 bytes
            store (code as a byte) into the data of digit at 0
            set editor's numeric to editor's numeric + digit
            set amount to (the bim numeric value of editor's numeric) * (the bim metres per editor's lengthUnit)
            set offset to a cad vector2 with x amount and y 0.0
            set lift to 0.0
            if editor's grabAxis = 2:
                set offset to a cad vector2 with x 0.0 and y amount
            if editor's grabAxis = 3:
                set offset to a cad vector2 with x 0.0 and y 0.0
                set lift to amount
            apply bim editor grab by offset lifting lift in editor
            set editor's message to (the string form of "Grab: ") + ((editor's numeric + (the string form of " ")) + (the bim name of unit editor's lengthUnit))
            return nothing
        if code = bim backspace key code:
            if (the length of editor's numeric) > 0:
                set editor's numeric to the substring of editor's numeric from 0 spanning ((the length of editor's numeric) - 1) bytes
            return nothing
        if code = bim enter key code:
            finish bim editor grab in editor
            return nothing
        if code = bim escape key code:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's grabbing to false
            set editor's numeric to the string form of ""
            set editor's message to the string form of "Grab cancelled"

# ---------------------------------------------------------------- boundary sketch

# Edit mode on a boundary sketch (see `bim_boundary_sketch.dl`): Tab on a
# floor, roof or ceiling opens its outline as lines and arcs; lines and arcs
# are added (L, A), picked and removed (Esc, a click, Delete); Tab chains
# them into the plate's new outline, as one edit.
function bim boundary edit:
    replacement:
        60

function bim sketch line tool:
    replacement:
        0
function bim sketch arc tool:
    replacement:
        1
function bim sketch pick tool:
    replacement:
        2
function bim sketch move tool:
    replacement:
        3

function bim editor sketches a boundary {bim editor record:editor}:
    execute:
        return editor's editMode and (editor's editKind = bim boundary edit)

# What the sketch tool asks for next, with the keys.
function the bim sketch hint of {bim editor record:editor}:
    execute:
        set clicked to the length of (editor's sketchPending's values)
        set asked to the string form of "Pick a point or edge; G moves, Delete removes an edge"
        if editor's sketchTool = bim sketch move tool:
            set asked to the string form of "Move: click to place, Esc cancels the move"
        if editor's sketchTool = bim sketch line tool:
            set asked to the string form of "Line: click its start"
            if clicked > 0:
                set asked to the string form of "Line: click the next point (Enter ends the chain)"
        if editor's sketchTool = bim sketch arc tool:
            set asked to the string form of "Arc: click its start"
            if clicked = 1:
                set asked to the string form of "Arc: click its end"
            if clicked = 2:
                set asked to the string form of "Arc: click a point on the arc"
        return asked + (the string form of " | L line, A arc, Esc pick, Tab finishes")

# Tab on a selected host: its boundary ready for point or edge selection.
function open bim editor boundary sketch in {a pointer to a bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        set editor's sketchHostKind to editor's selectionKind
        if editor's selectionKind = bim curtain picked:
            # A building system on its own: one nested in a panel or laid
            # on another follows that one's face.
            if (the bim curtain index of editor's selectionId in modelValue)'s valid = false:
                return nothing
            if ((the bim setting (bim host system setting) of editor's selectionId in modelValue)'s found) or ((the bim setting (bim layer host setting) of editor's selectionId in modelValue)'s found):
                set editor's message to the string form of "Tab: this building system follows its host's face"
                return nothing
            set editor's sketchSegments to the bim boundary segments of system editor's selectionId in modelValue
            set editor's sketchInView to false
        else if editor's selectionKind = bim wall picked:
            if (the bim wall index of editor's selectionId in modelValue)'s valid = false:
                return nothing
            set editor's sketchSegments to the bim boundary segments of wall editor's selectionId in modelValue
            set editor's sketchInView to false
        else:
            if (the bim slab index of editor's selectionId in modelValue)'s valid = false:
                return nothing
            set editor's sketchSegments to the bim boundary segments of slab editor's selectionId in modelValue
        set editor's sketchPending to a cad topology list of a cad vector2
        set editor's sketchTool to bim sketch pick tool
        set editor's sketchPicked to -1
        set editor's tool to bim select tool
        set editor's editMode to true
        set editor's editKind to bim boundary edit
        set editor's editMesh to false
        set editor's editSketchId to editor's selectionId
        set editor's editPicked to a cad topology list of an integer
        set editor's partCode to -1
        set editor's message to (the string form of "Sketch mode (boundary): ") + (the bim sketch hint of (@intrinsic("dereference", editor)))
        if bim editor sketches upright (@intrinsic("dereference", editor)):
            set editor's message to (the string form of "Sketch mode (contour, in the 3D view): ") + (the bim sketch hint of (@intrinsic("dereference", editor)))

# Snap only to geometry in this host's sketch coordinates. Never reuse the
# plan/model snap: its XY coordinates are unrelated to an upright wall face.
function the bim sketch snap at {cad vector2:location} of {bim editor record:editor}:
    execute:
        if editor's snapOff:
            return the bim snap location labelled "Free"
        set tolerance to editor's pickTolerance * 1.5
        set bestValue to @intrinsic("construct", a bim snap candidate record, location, the string form of "", 99, 0.0, false, editor's snapRefused)
        set best to the address of bestValue
        loop cursor from 0 to the length of (editor's sketchSegments's values):
            set piece to the item at cursor in (editor's sketchSegments's values)
            offer bim snap piece's start labelled (the string form of "End point") ranked 0 near location within tolerance to best
            offer bim snap piece's finish labelled (the string form of "End point") ranked 0 near location within tolerance to best
        loop cursor from 0 to the length of (editor's sketchPending's values):
            offer bim snap (the item at cursor in (editor's sketchPending's values)) labelled (the string form of "End point") ranked 0 near location within tolerance to best
        if bestValue's found:
            return the bim snap bestValue's point labelled bestValue's label
        loop cursor from 0 to the length of (editor's sketchSegments's values):
            set piece to the item at cursor in (editor's sketchSegments's values)
            offer bim snap (the bim middle of boundary segment piece) labelled (the string form of "Mid point") ranked 1 near location within tolerance to best
        if bestValue's found:
            return the bim snap bestValue's point labelled bestValue's label
        set reference to location
        set tracking to false
        if (the length of (editor's sketchPending's values)) > 0:
            set reference to the item at ((the length of (editor's sketchPending's values)) - 1) in (editor's sketchPending's values)
            set tracking to true
        if editor's sketchTool = bim sketch move tool:
            set reference to editor's moveBase
            set tracking to true
        if tracking:
            if (the absolute value of (location's x - reference's x)) < tolerance:
                offer bim snap (a cad vector2 with x reference's x and y location's y) labelled (the string form of "Vertical") ranked 3 near location within tolerance to best
            if (the absolute value of (location's y - reference's y)) < tolerance:
                offer bim snap (a cad vector2 with x location's x and y reference's y) labelled (the string form of "Horizontal") ranked 3 near location within tolerance to best
            if bestValue's found:
                return the bim snap bestValue's point labelled bestValue's label from reference
        # Nearest edge follows the same sampled arc displayed in the sketch.
        loop cursor from 0 to the length of (editor's sketchSegments's values):
            set points to the bim drawn points of boundary segment (the item at cursor in (editor's sketchSegments's values))
            loop edgeCursor from 0 to (the length of points) - 1:
                set firstPoint to the item at edgeCursor in points
                set lastPoint to the item at (edgeCursor + 1) in points
                set dx to lastPoint's x - firstPoint's x
                set dy to lastPoint's y - firstPoint's y
                set run to (dx * dx) + (dy * dy)
                if run > 1e-18:
                    set along to (((location's x - firstPoint's x) * dx) + ((location's y - firstPoint's y) * dy)) / run
                    set along to the maximum of 0.0 and (the minimum of 1.0 and along)
                    set closest to a cad vector2 with x (firstPoint's x + (along * dx)) and y (firstPoint's y + (along * dy))
                    offer bim snap closest labelled (the string form of "Nearest") ranked 4 near location within tolerance to best
            free points
        if bestValue's found:
            return the bim snap bestValue's point labelled bestValue's label
        if (editor's snapRefused bitwise and (the bim snap bit of 5)) != 0:
            return the bim snap location labelled "Free"
        return the bim snap (the bim grid point near location step 0.05) labelled "Grid"

function the bim sketch point at {cad vector2:location} of {bim editor record:editor}:
    execute:
        return (the bim sketch snap at location of editor)'s point

# Whether `point` is the end of a segment of the sketch: a chain that
# reaches one ends there.
function bim sketch point {cad vector2:spot} ends a segment of {bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of (editor's sketchSegments's values):
            set piece to the item at cursor in (editor's sketchSegments's values)
            if (bim boundary point piece's start meets spot) or (bim boundary point piece's finish meets spot):
                return true
        return false

# The segment of the sketch passing nearest `location`, within the pick
# tolerance; -1 when none.
function the bim sketch segment near {cad vector2:location} of {bim editor record:editor}:
    execute:
        set nearest to -1
        set nearestGap to editor's pickTolerance * 1.5
        loop cursor from 0 to the length of (editor's sketchSegments's values):
            set drawn to the bim drawn points of boundary segment (the item at cursor in (editor's sketchSegments's values))
            loop corner from 0 to (the length of drawn) - 1:
                set gap to the cad distance from location to the segment from (the item at corner in drawn) to (the item at (corner + 1) in drawn)
                if gap < nearestGap:
                    set nearest to cursor
                    set nearestGap to gap
            free drawn
        return nearest

# A click in the sketch: the next point of the line or arc being drawn, or
# the segment picked.
function bim boundary point selected in {bim editor record:editor}:
    execute:
        if (editor's editMode = false) or (editor's editKind != bim boundary edit):
            return false
        if (the length of (editor's editPicked's values)) != 1:
            return false
        if (editor's sketchTool != bim sketch pick tool) and (editor's sketchTool != bim sketch move tool):
            return false
        set vertexCode to the item at 0 in (editor's editPicked's values)
        return (vertexCode >= 0) and (vertexCode < ((the length of (editor's sketchSegments's values)) * 2))

function the bim selected boundary point of {bim editor record:editor}:
    execute:
        set vertexCode to the item at 0 in (editor's editPicked's values)
        set segmentValue to the item at (vertexCode / 2) in (editor's sketchSegments's values)
        if (the remainder of vertexCode divided by 2) = 1:
            return segmentValue's finish
        return segmentValue's start

# Pending sketch only: move every incident endpoint together, so the loop
# remains joined. Tab applies the existing simple-loop validator and makes
# the entire boundary one undoable edit; Escape can still discard it.
function move bim selected boundary point to {cad vector2:destination} in {a pointer to a bim editor record:editor}:
    execute:
        if (bim boundary point selected in (@intrinsic("dereference", editor))) = false:
            return false
        set originalPoint to the bim selected boundary point of (@intrinsic("dereference", editor))
        loop cursor from 0 to the length of (editor's sketchSegments's values):
            set segmentValue to the item at cursor in (editor's sketchSegments's values)
            if bim boundary point segmentValue's start meets originalPoint:
                set segmentValue's start to destination
            if bim boundary point segmentValue's finish meets originalPoint:
                set segmentValue's finish to destination
            replace item at index cursor in (editor's sketchSegments's values) with segmentValue
        return true

# Preview and commit share the same endpoint translation. Incident edges stay
# joined; a picked edge translates both endpoints, including neighbouring edges.
function the bim displayed boundary segment at {integer:cursor} of {bim editor record:editor}:
    execute:
        set piece to the item at cursor in (editor's sketchSegments's values)
        if editor's sketchTool != bim sketch move tool:
            return piece
        set chosen to the item at editor's sketchPicked in (editor's sketchSegments's values)
        set firstPoint to chosen's start
        set lastPoint to chosen's finish
        if bim boundary point selected in editor:
            set firstPoint to the bim selected boundary point of editor
            set lastPoint to firstPoint
        set destination to the bim sketch point at (the bim sketch location of editor) of editor
        set displacement to a cad vector2 with x (destination's x - editor's moveBase's x) and y (destination's y - editor's moveBase's y)
        return the bim boundary segment piece moving endpoints firstPoint and lastPoint by displacement

function place bim boundary move in {a pointer to a bim editor record:editor}:
    execute:
        set movedPieces to a cad topology list of a bim boundary segment record
        loop cursor from 0 to the length of (editor's sketchSegments's values):
            append (the bim displayed boundary segment at cursor of (@intrinsic("dereference", editor))) to (movedPieces's values)
        set editor's sketchSegments to movedPieces
        set editor's sketchTool to bim sketch pick tool
        set editor's message to the string form of "Moved in sketch; G moves again, Tab applies the boundary"

function press bim editor boundary sketch in {a pointer to a bim editor record:editor}:
    execute:
        if (bim editor sketches upright (@intrinsic("dereference", editor))) and (editor's sketchInView = false):
            set editor's message to the string form of "Draw the contour in the 3D view, on the system's face"
            return nothing
        set location to the bim sketch location of (@intrinsic("dereference", editor))
        set point to the bim sketch point at location of (@intrinsic("dereference", editor))
        if editor's sketchTool = bim sketch move tool:
            place bim boundary move in editor
            return nothing
        if editor's sketchTool = bim sketch pick tool:
            set editor's editPicked to a cad topology list of an integer
            set closestCode to -1
            set closestGap to editor's pickTolerance * 1.5
            loop cursor from 0 to the length of (editor's sketchSegments's values):
                set segmentValue to the item at cursor in (editor's sketchSegments's values)
                set gap to the cad distance from location to segmentValue's start
                if gap < closestGap:
                    set closestGap to gap
                    set closestCode to cursor * 2
                set gap to the cad distance from location to segmentValue's finish
                if gap < closestGap:
                    set closestGap to gap
                    set closestCode to (cursor * 2) + 1
            if closestCode >= 0:
                append closestCode to (editor's editPicked's values)
                set editor's sketchPicked to closestCode / 2
                set editor's message to the string form of "Boundary point selected: G moves; edit coordinates in Properties; Tab applies"
                return nothing
            set editor's sketchPicked to the bim sketch segment near location of (@intrinsic("dereference", editor))
            if editor's sketchPicked >= 0:
                set editor's message to the string form of "Picked an edge: G moves, Delete removes it | L line, A arc, Tab finishes"
            else:
                set editor's message to the bim sketch hint of (@intrinsic("dereference", editor))
            return nothing
        set editor's sketchPicked to -1
        set editor's editPicked to a cad topology list of an integer
        set clicked to the length of (editor's sketchPending's values)
        if clicked = 0:
            append point to (editor's sketchPending's values)
            set editor's message to the bim sketch hint of (@intrinsic("dereference", editor))
            return nothing
        set fromPoint to the item at 0 in (editor's sketchPending's values)
        if editor's sketchTool = bim sketch line tool:
            set fromPoint to the item at (clicked - 1) in (editor's sketchPending's values)
            if bim boundary point fromPoint meets point:
                return nothing
            set joins to bim sketch point point ends a segment of (@intrinsic("dereference", editor))
            append (the bim boundary line from fromPoint to point) to (editor's sketchSegments's values)
            set editor's sketchPending to a cad topology list of a cad vector2
            if joins = false:
                append point to (editor's sketchPending's values)
            set editor's message to the bim sketch hint of (@intrinsic("dereference", editor))
            return nothing
        if clicked = 1:
            if bim boundary point fromPoint meets point:
                return nothing
            append point to (editor's sketchPending's values)
            set editor's message to the bim sketch hint of (@intrinsic("dereference", editor))
            return nothing
        set toPoint to the item at 1 in (editor's sketchPending's values)
        set rise to the bim boundary bulge from fromPoint to toPoint through point
        set joins to bim sketch point toPoint ends a segment of (@intrinsic("dereference", editor))
        append (the bim boundary arc from fromPoint to toPoint bulging rise) to (editor's sketchSegments's values)
        set editor's sketchPending to a cad topology list of a cad vector2
        if joins = false:
            append toPoint to (editor's sketchPending's values)
        set editor's message to the bim sketch hint of (@intrinsic("dereference", editor))

# The sketch closed without changing the plate.
function leave bim editor boundary sketch in {a pointer to a bim editor record:editor}:
    execute:
        set editor's editMode to false
        set editor's editPicked to a cad topology list of an integer
        set editor's sketchPending to a cad topology list of a cad vector2
        set editor's sketchPicked to -1

# Tab in the sketch: the plate takes the loop of its segments as its
# outline, as one edit; refused (the sketch stays open) when they do not
# make one closed loop that does not cross itself.
function finish bim editor boundary sketch in {a pointer to a bim editor record:editor}:
    execute:
        set plateId to editor's editSketchId
        begin bim transaction in (the address of (editor's documentValue))
        set refusal to the string form of ""
        if editor's sketchHostKind = bim curtain picked:
            set refusal to set bim system plateId boundary to (editor's sketchSegments's values) in (the address of (editor's documentValue's current))
        else if editor's sketchHostKind = bim wall picked:
            set refusal to set bim wall plateId boundary to (editor's sketchSegments's values) in (the address of (editor's documentValue's current))
        else:
            set refusal to set bim slab plateId boundary to (editor's sketchSegments's values) in (the address of (editor's documentValue's current))
        if (the length of refusal) > 0:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to ((the string form of "Sketch not finished: ") + refusal) + (the string form of " (Esc Esc leaves it as it was)")
            return nothing
        commit bim transaction in (the address of (editor's documentValue))
        set lineCount to 0
        set arcCount to 0
        loop cursor from 0 to the length of (editor's sketchSegments's values):
            if (the item at cursor in (editor's sketchSegments's values))'s bulge = 0.0:
                set lineCount to lineCount + 1
            else:
                set arcCount to arcCount + 1
        leave bim editor boundary sketch in editor
        select bim editor editor's sketchHostKind numbered plateId in editor
        set editor's message to ((the string form of "Boundary finished: ") + (the string form of lineCount)) + (((the string form of " lines, ") + (the string form of arcCount)) + (the string form of " arcs"))

# A key in the sketch: Tab finishes; Esc ends the line or arc being drawn,
# then picks, then leaves the sketch as it was; L and A choose the line or
# the arc; Delete removes the picked segment (else the last one); Enter ends
# a chain.
function type bim editor boundary key {integer:code} in {a pointer to a bim editor record:editor}:
    execute:
        if editor's sketchTool = bim sketch move tool:
            if code = bim escape key code:
                set editor's sketchTool to bim sketch pick tool
                set editor's message to the string form of "Move cancelled; sketch selection kept"
                return nothing
            if (code = bim enter key code) or (code = 258):
                place bim boundary move in editor
                if code = 258:
                    finish bim editor boundary sketch in editor
            return nothing
        if code = 71:
            if (editor's sketchTool != bim sketch pick tool) or (editor's sketchPicked < 0):
                set editor's message to the string form of "Select a boundary point or edge before G"
                return nothing
            set editor's moveBase to the bim sketch point at (the bim sketch location of (@intrinsic("dereference", editor))) of (@intrinsic("dereference", editor))
            set editor's sketchTool to bim sketch move tool
            set editor's message to the bim sketch hint of (@intrinsic("dereference", editor))
            return nothing
        if code = 258:
            finish bim editor boundary sketch in editor
            return nothing
        if code = bim escape key code:
            if (the length of (editor's sketchPending's values)) > 0:
                set editor's sketchPending to a cad topology list of a cad vector2
            else if editor's sketchTool != bim sketch pick tool:
                set editor's sketchTool to bim sketch pick tool
            else:
                leave bim editor boundary sketch in editor
                set editor's message to the string form of "Sketch left; the boundary is as it was"
                return nothing
            set editor's message to the bim sketch hint of (@intrinsic("dereference", editor))
            return nothing
        if (code = 76) or (code = 65):
            set editor's sketchTool to bim sketch line tool
            if code = 65:
                set editor's sketchTool to bim sketch arc tool
            set editor's sketchPending to a cad topology list of a cad vector2
            set editor's sketchPicked to -1
            set editor's message to the bim sketch hint of (@intrinsic("dereference", editor))
            return nothing
        if code = bim enter key code:
            set editor's sketchPending to a cad topology list of a cad vector2
            set editor's message to the bim sketch hint of (@intrinsic("dereference", editor))
            return nothing
        if (code = bim delete key code) or (code = bim backspace key code):
            set editor's editPicked to a cad topology list of an integer
            set segmentCount to the length of (editor's sketchSegments's values)
            if (editor's sketchPicked >= 0) and (editor's sketchPicked < segmentCount):
                remove item editor's sketchPicked from (editor's sketchSegments's values)
            else if (the length of (editor's sketchPending's values)) > 0:
                set editor's sketchPending to a cad topology list of a cad vector2
            else if segmentCount > 0:
                remove item (segmentCount - 1) from (editor's sketchSegments's values)
            set editor's sketchPicked to -1
            set editor's message to ((the string form of "Segments: ") + (the string form of (the length of (editor's sketchSegments's values)))) + ((the string form of " | ") + (the bim sketch hint of (@intrinsic("dereference", editor))))
            return nothing
        set editor's message to (the string form of "Sketch mode: ") + (the bim sketch hint of (@intrinsic("dereference", editor)))

# ---------------------------------------------------------------- the sketch on a face

# Where the pointer is in the sketch's coordinates: on the plan for a
# plate's, on the face (from the 3D view) for a building system's.
function the bim sketch location of {bim editor record:editor}:
    execute:
        if (editor's sketchHostKind = bim curtain picked) or (editor's sketchHostKind = bim wall picked):
            return editor's sketchPointer
        return editor's pointerLocation

# The pointer over the face of the building system sketched, at `spot` in its
# face's coordinates (from the 3D view), within `tolerance`.
function move bim editor sketch pointer to {cad vector2:spot} within {a 64 bit floating-point number:tolerance} in {a pointer to a bim editor record:editor}:
    execute:
        set editor's sketchPointer to spot
        set editor's pickTolerance to tolerance
        set editor's sketchInView to true

# Whether the sketch lies on a building system's face (drawn in 3D).
function bim editor sketches upright {bim editor record:editor}:
    execute:
        return (bim editor sketches a boundary editor) and ((editor's sketchHostKind = bim curtain picked) or (editor's sketchHostKind = bim wall picked))

# Point `location` on the face of the building system sketched, caught on a
# grid line (a mullion along it, a transom up it) within the tolerance, else
# to the millimetre.
function the bim face snap of {cad vector2:location} for {bim editor record:editor}:
    execute:
        set snappedX to (@intrinsic("ceil", (location's x * 1000.0) - 0.5)) / 1000.0
        set snappedY to (@intrinsic("ceil", (location's y * 1000.0) - 0.5)) / 1000.0
        set wallFound to the bim wall index of editor's editSketchId in editor's documentValue's current
        if (editor's sketchHostKind = bim wall picked) and wallFound's valid:
            # A wall's: on its ends, foot and top.
            set wallValue to the item at wallFound's position in (editor's documentValue's current's walls's values)
            set wallLength to the bim centreline length of wallValue
            if (the absolute value of location's x) < editor's pickTolerance:
                set snappedX to 0.0
            if (the absolute value of (location's x - wallLength)) < editor's pickTolerance:
                set snappedX to wallLength
            if (the absolute value of (location's y - wallValue's baseOffset)) < editor's pickTolerance:
                set snappedY to wallValue's baseOffset
            if (the absolute value of (location's y - (wallValue's baseOffset + wallValue's height))) < editor's pickTolerance:
                set snappedY to wallValue's baseOffset + wallValue's height
            return a cad vector2 with x snappedX and y snappedY
        set found to the bim curtain index of editor's editSketchId in editor's documentValue's current
        if found's valid:
            set modelValue to editor's documentValue's current
            set curtainValue to the item at found's position in (modelValue's curtains's values)
            set gapX to editor's pickTolerance
            set gapY to editor's pickTolerance
            loop lineCursor from 0 to (the bim bay count of curtainValue) + 1:
                set lineAlong to the bim mullion lineCursor along curtainValue in modelValue
                if (the absolute value of (location's x - lineAlong)) < gapX:
                    set snappedX to lineAlong
                    set gapX to the absolute value of (location's x - lineAlong)
            loop lineCursor from 0 to (the bim row count of curtainValue) + 1:
                set lineUp to the bim transom lineCursor along curtainValue in modelValue
                if (the absolute value of (location's y - lineUp)) < gapY:
                    set snappedY to lineUp
                    set gapY to the absolute value of (location's y - lineUp)
        return a cad vector2 with x snappedX and y snappedY

# A point of the sketch in the model: on a plate's top, or on a building
# system's face.
function the bim sketch world point of {cad vector2:spot} for {bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        if editor's sketchHostKind = bim curtain picked:
            set found to the bim curtain index of editor's editSketchId in modelValue
            if found's valid:
                set curtainValue to the item at found's position in (modelValue's curtains's values)
                set onFace to the bim face point of curtainValue at spot's x up spot's y in modelValue
                set lift to the bim elevation of level curtainValue's levelId in modelValue
                return a cad vector3 with x onFace's x, y onFace's y and z (onFace's z + lift)
        if editor's sketchHostKind = bim wall picked:
            set wallFound to the bim wall index of editor's editSketchId in modelValue
            if wallFound's valid:
                set wallValue to the item at wallFound's position in (modelValue's walls's values)
                set direction to the bim direction of wallValue
                set lift to the bim elevation of level wallValue's levelId in modelValue
                return a cad vector3 with x (wallValue's start's x + (direction's x * spot's x)), y (wallValue's start's y + (direction's y * spot's x)) and z (lift + spot's y)
        set z to the bim elevation of level editor's levelId in modelValue
        set plateFound to the bim slab index of editor's editSketchId in modelValue
        if plateFound's valid:
            set plate to the item at plateFound's position in (modelValue's slabs's values)
            set z to (the bim elevation of level plate's levelId in modelValue) + plate's top
            if (the length of (plate's outline's values)) > 0:
                set anchor to the item at 0 in (plate's outline's values)
                set slope to (the sine of plate's pitch) / (the cosine of plate's pitch)
                set z to z + (slope * (((spot's x - anchor's x) * (the cosine of plate's heading)) + ((spot's y - anchor's y) * (the sine of plate's heading))))
        return a cad vector3 with x spot's x, y spot's y and z z

# Where a ray (from the 3D view) meets the face of the building system
# sketched, in the face's coordinates.
class:
    patterns:
        [a|] bim sketch hit record
    members:
        found as a boolean
        spot as a cad vector2

function the bim sketch hit along {bim ray record:ray} for {bim editor record:editor}:
    execute:
        set missed to @intrinsic("construct", a bim sketch hit record, false, a cad vector2 with x 0.0 and y 0.0)
        set modelValue to editor's documentValue's current
        if editor's sketchHostKind = bim slab picked:
            set plateFound to the bim slab index of editor's editSketchId in modelValue
            if plateFound's valid = false:
                return missed
            set plate to the item at plateFound's position in (modelValue's slabs's values)
            if (the length of (plate's outline's values)) = 0:
                return missed
            set anchor to the item at 0 in (plate's outline's values)
            set planePoint to the bim sketch world point of anchor for editor
            set slope to (the sine of plate's pitch) / (the cosine of plate's pitch)
            set slopeX to slope * (the cosine of plate's heading)
            set slopeY to slope * (the sine of plate's heading)
            set facing to (ray's direction's z - (slopeX * ray's direction's x)) - (slopeY * ray's direction's y)
            if (the absolute value of facing) <= 1e-9:
                return missed
            set numerator to ((planePoint's z - ray's origin's z) + (slopeX * (ray's origin's x - anchor's x))) + (slopeY * (ray's origin's y - anchor's y))
            set planeReach to numerator / facing
            if planeReach < 0.0:
                return missed
            set hitSpot to a cad vector2 with x (ray's origin's x + (planeReach * ray's direction's x)) and y (ray's origin's y + (planeReach * ray's direction's y))
            return @intrinsic("construct", a bim sketch hit record, true, hitSpot)
        if editor's sketchHostKind = bim wall picked:
            # A wall's: the upright plane through its line.
            set wallFound to the bim wall index of editor's editSketchId in modelValue
            if wallFound's valid = false:
                return missed
            set wallValue to the item at wallFound's position in (modelValue's walls's values)
            set direction to the bim direction of wallValue
            set wallFacing to (ray's direction's x * direction's y) - (ray's direction's y * direction's x)
            if (the absolute value of wallFacing) <= 1e-9:
                return missed
            set wallReach to (((wallValue's start's x - ray's origin's x) * direction's y) - ((wallValue's start's y - ray's origin's y) * direction's x)) / wallFacing
            if wallReach < 0.0:
                return missed
            set wallHit to the cad sum of ray's origin and (ray's direction scaled by wallReach)
            set wallAlong to ((wallHit's x - wallValue's start's x) * direction's x) + ((wallHit's y - wallValue's start's y) * direction's y)
            return @intrinsic("construct", a bim sketch hit record, true, a cad vector2 with x wallAlong and y (wallHit's z - (the bim elevation of level wallValue's levelId in modelValue)))
        set found to the bim curtain index of editor's editSketchId in modelValue
        if found's valid = false:
            return missed
        set curtainValue to the item at found's position in (modelValue's curtains's values)
        set lift to the bim elevation of level curtainValue's levelId in modelValue
        set reach to -1.0
        if bim system curtainValue's id lies level in modelValue:
            set flatHeight to ((the bim setting (bim system level setting) of curtainValue's id in modelValue)'s value as a 64 bit floating-point number) / 1000.0
            if (the absolute value of ray's direction's z) > 1e-9:
                set reach to ((lift + flatHeight) - ray's origin's z) / ray's direction's z
        else:
            set course to the bim system path of curtainValue
            if course's curved:
                # The cylinder over the arc.
                set ox to ray's origin's x - course's centre's x
                set oy to ray's origin's y - course's centre's y
                set quadA to (ray's direction's x * ray's direction's x) + (ray's direction's y * ray's direction's y)
                set quadB to 2.0 * ((ox * ray's direction's x) + (oy * ray's direction's y))
                set quadC to ((ox * ox) + (oy * oy)) - (course's radius * course's radius)
                set discriminant to (quadB * quadB) - ((4.0 * quadA) * quadC)
                if (quadA > 1e-12) and (discriminant >= 0.0):
                    set root to the square root of discriminant
                    set nearer to ((0.0 - quadB) - root) / (2.0 * quadA)
                    set farther to ((0.0 - quadB) + root) / (2.0 * quadA)
                    set reach to nearer
                    if nearer < 0.0:
                        set reach to farther
            else:
                set wallLength to the maximum of 1e-9 and (the bim system length of curtainValue)
                set nx to (curtainValue's finish's y - curtainValue's start's y) / wallLength
                set ny to (curtainValue's start's x - curtainValue's finish's x) / wallLength
                set facing to (ray's direction's x * nx) + (ray's direction's y * ny)
                if (the absolute value of facing) > 1e-9:
                    set reach to (((curtainValue's start's x - ray's origin's x) * nx) + ((curtainValue's start's y - ray's origin's y) * ny)) / facing
        if reach < 0.0:
            return missed
        set hitPoint to the cad sum of ray's origin and (ray's direction scaled by reach)
        set place to the bim face place of (a cad vector3 with x hitPoint's x, y hitPoint's y and z (hitPoint's z - lift)) on curtainValue in modelValue
        return @intrinsic("construct", a bim sketch hit record, true, place)

# Interpolate/extrapolate the original 3D axis when its plan ends are trimmed.
function the bim point on linear {bim linear record:member} at plan {cad vector2:location}:
    execute:
        set dx to member's finish's x - member's start's x
        set dy to member's finish's y - member's start's y
        set span to (dx * dx) + (dy * dy)
        if span <= 1e-12:
            return member's start
        set along to (((location's x - member's start's x) * dx) + ((location's y - member's start's y) * dy)) / span
        return a cad vector3 with x location's x, y location's y and z (member's start's z + (along * (member's finish's z - member's start's z)))

# Visible classification uses the same role mapping as IFC/IFCX export.
function the bim ifc class of editor selection {bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        if editor's selectionKind = bim wall picked:
            return the string form of "IfcWall"
        if editor's selectionKind = bim slab picked:
            set found to the bim slab index of editor's selectionId in modelValue
            if found's valid:
                set plate to the item at found's position in (modelValue's slabs's values)
                set role to the bim role of plate plate in modelValue
                return ((the bim ifc class of planar role role) + (the string form of " / ")) + (the bim ifc predefined type of planar role role)
        if editor's selectionKind = bim linear picked:
            set found to the bim linear index of editor's selectionId in modelValue
            if found's valid:
                set member to the item at found's position in (modelValue's linears's values)
                return the bim ifc class of linear role (the bim type of linear member in modelValue)'s role
        if editor's selectionKind = bim opening picked:
            set found to the bim opening index of editor's selectionId in modelValue
            if found's valid:
                set openingValue to the item at found's position in (modelValue's openings's values)
                set typed to the bim opening type index of openingValue's typeId in modelValue
                if typed's valid:
                    if (the item at typed's position in (modelValue's openingTypes's values))'s isDoor:
                        return the string form of "IfcDoor"
                    return the string form of "IfcWindow"
        if editor's selectionKind = bim curtain picked:
            if editor's partCode < 0:
                return the string form of "IfcCurtainWall"
            if editor's partCode < 2000:
                return the string form of "IfcMember"
            return the string form of "IfcPlate"
        if editor's selectionKind = bim space picked:
            return the string form of "IfcSpace"
        if editor's selectionKind = bim stair picked:
            return the string form of "IfcStair"
        if editor's selectionKind = bim railing picked:
            return the string form of "IfcRailing"
        if editor's selectionKind = bim level picked:
            return the string form of "IfcBuildingStorey"
        if editor's selectionKind = bim grid picked:
            return the string form of "IfcGrid"
        return the string form of ""

class:
    patterns:
        [a|] bim object frame record
    members:
        found as a boolean
        origin as a cad vector3
        xAxis as a cad vector3
        yAxis as a cad vector3
        zAxis as a cad vector3

function no bim object frame:
    execute:
        return @intrinsic("construct", a bim object frame record, false, (a cad vector3 with x 0.0, y 0.0 and z 0.0), (a cad vector3 with x 1.0, y 0.0 and z 0.0), (a cad vector3 with x 0.0, y 1.0 and z 0.0), (a cad vector3 with x 0.0, y 0.0 and z 1.0))

function the bim world point of {cad vector3:localPoint} in frame {bim object frame record:basis}:
    execute:
        return the cad sum of basis's origin and (the cad sum of (basis's xAxis scaled by localPoint's x) and (the cad sum of (basis's yAxis scaled by localPoint's y) and (basis's zAxis scaled by localPoint's z)))

function the bim object frame of {bim editor record:editor}:
    execute:
        set basis to no bim object frame
        set modelValue to editor's documentValue's current
        if editor's selectionKind = bim wall picked:
            set found to the bim wall index of editor's selectionId in modelValue
            if found's valid:
                set wallValue to the item at found's position in (modelValue's walls's values)
                set direction to the bim direction of wallValue
                set basis's origin to a cad vector3 with x wallValue's start's x, y wallValue's start's y and z ((the bim elevation of level wallValue's levelId in modelValue) + wallValue's baseOffset)
                set basis's xAxis to a cad vector3 with x direction's x, y direction's y and z 0.0
                set basis's yAxis to a cad vector3 with x (0.0 - direction's y), y direction's x and z 0.0
                set basis's found to true
        if editor's selectionKind = bim slab picked:
            set found to the bim slab index of editor's selectionId in modelValue
            if found's valid:
                set plate to the item at found's position in (modelValue's slabs's values)
                if (the length of (plate's outline's values)) > 0:
                    set anchor to the item at 0 in (plate's outline's values)
                    set basis's origin to a cad vector3 with x anchor's x, y anchor's y and z ((the bim elevation of level plate's levelId in modelValue) + plate's top)
                    set basis's xAxis to a cad vector3 with x ((the cosine of plate's heading) * (the cosine of plate's pitch)), y ((the sine of plate's heading) * (the cosine of plate's pitch)) and z (the sine of plate's pitch)
                    set basis's yAxis to a cad vector3 with x (0.0 - (the sine of plate's heading)), y (the cosine of plate's heading) and z 0.0
                    set basis's zAxis to the cad cross of basis's xAxis and basis's yAxis
                    set basis's found to true
        if editor's selectionKind = bim linear picked:
            set found to the bim linear index of editor's selectionId in modelValue
            if found's valid:
                set member to the item at found's position in (modelValue's linears's values)
                set direction to the cad difference of member's finish and member's start
                set span to the cad length of direction
                if span > 1e-9:
                    set basis's xAxis to direction scaled by (1.0 / span)
                    set across to the cad cross of basis's zAxis and basis's xAxis
                    if (the cad length of across) < 1e-9:
                        set across to a cad vector3 with x 0.0, y 1.0 and z 0.0
                    set across to across scaled by (1.0 / (the cad length of across))
                    set upward to the cad cross of basis's xAxis and across
                    set basis's yAxis to the cad sum of (across scaled by (the cosine of member's angle)) and (upward scaled by (the sine of member's angle))
                    set basis's zAxis to the cad cross of basis's xAxis and basis's yAxis
                    set basis's origin to a cad vector3 with x member's start's x, y member's start's y and z (member's start's z + (the bim elevation of level member's levelId in modelValue))
                    set basis's found to true
        if editor's selectionKind = bim curtain picked:
            set found to the bim curtain index of editor's selectionId in modelValue
            if found's valid:
                set system to the item at found's position in (modelValue's curtains's values)
                set dx to system's finish's x - system's start's x
                set dy to system's finish's y - system's start's y
                set span to the square root of ((dx * dx) + (dy * dy))
                if span > 1e-9:
                    set basis's origin to a cad vector3 with x system's start's x, y system's start's y and z (the bim elevation of level system's levelId in modelValue)
                    set basis's xAxis to a cad vector3 with x (dx / span), y (dy / span) and z 0.0
                    set basis's yAxis to a cad vector3 with x (0.0 - (dy / span)), y (dx / span) and z 0.0
                    set basis's found to true
        if ((basis's found = false) and (bim kind editor's selectionKind has handles)) and (editor's selectionKind != bim level picked):
            set points to the bim handles of editor's selectionKind numbered editor's selectionId in modelValue
            if (the length of (points's values)) > 0:
                set firstPoint to the item at 0 in (points's values)
                set basis's origin to a cad vector3 with x firstPoint's x, y firstPoint's y and z (firstPoint's z + (the bim handle lift of editor's selectionKind numbered editor's selectionId in modelValue))
                set basis's found to true
        return basis
