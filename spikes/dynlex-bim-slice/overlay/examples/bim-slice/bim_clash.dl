# SPDX-License-Identifier: MPL-2.0
# Clash detection across disciplines. Linear elements are convex prisms (a
# convex profile along an axis) and straight walls convex boxes, so two of
# them intersect exactly when no separating axis exists: the face normals of
# either and the cross products of their edge directions (the separating
# axis theorem). A clash is reported when they overlap by more than a
# millimetre along every axis.
#
# A pipe, duct or cable tray clashes with any element that is not a segment,
# and with segments it is not joined to in the network.
import examples/bim-slice/bim_scene.dl
import examples/bim-slice/bim_network.dl

# A convex solid by its corners, with the directions its faces and edges
# run in.
class:
    patterns:
        [a|] bim convex record
    members:
        elementId as a 64 bit integer
        corners as the type of (a cad topology list of a cad vector3)
        normals as the type of (a cad topology list of a cad vector3)
        edges as the type of (a cad topology list of a cad vector3)
        connects as a boolean

# The box around a convex solid, to rule pairs out before the exact test.
class:
    patterns:
        [a|] bim clash box record
    members:
        low as a cad vector3
        high as a cad vector3

class:
    patterns:
        [a|] bim clash record
    members:
        firstId as a 64 bit integer
        secondId as a 64 bit integer

local function append bim unit {cad vector3:direction} to {a pointer to a list:directions}:
    execute:
        set size to the cad length of direction
        if size > 1e-12:
            append (direction scaled by (1.0 / size)) to directions

# Linear element `linearValue` as a convex solid: its profile rings' corners,
# its side faces' normals and its axis.
function the bim convex of linear {bim linear record:linearValue} in {bim model record:modelValue}:
    execute:
        set linearType to the bim type of linear linearValue in modelValue
        set profileCorners to the bim profile rings of linearValue as linearType in modelValue at 12 round corners
        set solid to @intrinsic("construct", a bim convex record, linearValue's id, a cad topology list of a cad vector3, a cad topology list of a cad vector3, a cad topology list of a cad vector3, bim role linearType's role connects)
        loop cursor from 0 to the length of profileCorners:
            append (the item at cursor in profileCorners) to (solid's corners's values)
        set count to (the length of profileCorners) / 2
        set axis to the cad difference of (the item at count in profileCorners) and (the item at 0 in profileCorners)
        append bim unit axis to (solid's normals's values)
        append bim unit axis to (solid's edges's values)
        loop cursor from 0 to count:
            set here to the item at cursor in profileCorners
            set following to the item at (the remainder of (cursor + 1) divided by count) in profileCorners
            set side to the cad difference of following and here
            append bim unit side to (solid's edges's values)
            append bim unit (the cad cross of side and axis) to (solid's normals's values)
        free profileCorners
        return solid

# A straight wall as a convex box: its footprint's corners at its base and
# top (its openings are not taken out).
function the bim convex of wall {bim wall record:wallValue} in {bim model record:modelValue} using {bim join index record:index}:
    execute:
        set solid to @intrinsic("construct", a bim convex record, wallValue's id, a cad topology list of a cad vector3, a cad topology list of a cad vector3, a cad topology list of a cad vector3, false)
        set wallFootprint to the bim footprint of wallValue in modelValue using index
        set base to 0.0
        set levelFound to the bim level index of wallValue's levelId in modelValue
        if levelFound's valid:
            set base to (the item at levelFound's position in (modelValue's levels's values))'s elevation
        set plan to an empty list of a cad vector2
        append wallFootprint's startExterior to plan
        append wallFootprint's finishExterior to plan
        append wallFootprint's finishInterior to plan
        append wallFootprint's startInterior to plan
        loop level from 0 to 2:
            set height to base + (wallValue's height * (level as a 64 bit floating-point number))
            loop cursor from 0 to 4:
                set spot to the item at cursor in plan
                append (a cad vector3 with x spot's x, y spot's y and z height) to (solid's corners's values)
        set upward to a cad vector3 with x 0.0, y 0.0 and z 1.0
        append upward to (solid's normals's values)
        append upward to (solid's edges's values)
        loop cursor from 0 to 4:
            set here to the item at cursor in plan
            set following to the item at (the remainder of (cursor + 1) divided by 4) in plan
            set side to a cad vector3 with x (following's x - here's x), y (following's y - here's y) and z 0.0
            append bim unit side to (solid's edges's values)
            append bim unit (the cad cross of side and upward) to (solid's normals's values)
        free plan
        return solid

# The piece of a straight wall between `fromT` and `toT` along it (fractions
# of its length) and between heights `low` and `high` above its base, as a
# convex box.
local function the bim wall piece of {bim wall record:wallValue} with {bim footprint record:wallFootprint} from {a 64 bit floating-point number:fromT} to {a 64 bit floating-point number:toT} between {a 64 bit floating-point number:low} and {a 64 bit floating-point number:high} above {a 64 bit floating-point number:base}:
    execute:
        set boxPiece to @intrinsic("construct", a bim convex record, wallValue's id, a cad topology list of a cad vector3, a cad topology list of a cad vector3, a cad topology list of a cad vector3, false)
        set plan to an empty list of a cad vector2
        set ex to wallFootprint's startExterior
        set fx to wallFootprint's finishExterior
        set si to wallFootprint's startInterior
        set fi to wallFootprint's finishInterior
        append (a cad vector2 with x (ex's x + ((fx's x - ex's x) * fromT)) and y (ex's y + ((fx's y - ex's y) * fromT))) to plan
        append (a cad vector2 with x (ex's x + ((fx's x - ex's x) * toT)) and y (ex's y + ((fx's y - ex's y) * toT))) to plan
        append (a cad vector2 with x (si's x + ((fi's x - si's x) * toT)) and y (si's y + ((fi's y - si's y) * toT))) to plan
        append (a cad vector2 with x (si's x + ((fi's x - si's x) * fromT)) and y (si's y + ((fi's y - si's y) * fromT))) to plan
        loop level from 0 to 2:
            set height to base + low
            if level = 1:
                set height to base + high
            loop cursor from 0 to 4:
                set spot to the item at cursor in plan
                append (a cad vector3 with x spot's x, y spot's y and z height) to (boxPiece's corners's values)
        set upward to a cad vector3 with x 0.0, y 0.0 and z 1.0
        append upward to (boxPiece's normals's values)
        append upward to (boxPiece's edges's values)
        loop cursor from 0 to 4:
            set here to the item at cursor in plan
            set following to the item at (the remainder of (cursor + 1) divided by 4) in plan
            set side to a cad vector3 with x (following's x - here's x), y (following's y - here's y) and z 0.0
            append bim unit side to (boxPiece's edges's values)
            append bim unit (the cad cross of side and upward) to (boxPiece's normals's values)
        free plan
        return boxPiece

# A straight wall as convex pieces that leave its openings' voids out: the
# stretches between openings over the full height, and under each opening's
# sill and over its head.
function the bim convex pieces of wall {bim wall record:wallValue} in {bim model record:modelValue} using {bim join index record:index}:
    execute:
        set pieceList to a cad topology list of a bim convex record
        set wallFootprint to the bim footprint of wallValue in modelValue using index
        set base to 0.0
        set levelFound to the bim level index of wallValue's levelId in modelValue
        if levelFound's valid:
            set base to (the item at levelFound's position in (modelValue's levels's values))'s elevation
        set wallLength to the cad distance from wallValue's start to wallValue's finish
        if wallLength < 1e-9:
            return pieceList
        # The openings' spans along the wall, in order.
        set starts to an empty list of a 64 bit floating-point number
        set ends to an empty list of a 64 bit floating-point number
        set sills to an empty list of a 64 bit floating-point number
        set heads to an empty list of a 64 bit floating-point number
        loop cursor from 0 to the length of (modelValue's openings's values):
            set openingValue to the item at cursor in (modelValue's openings's values)
            set typeFound to the bim opening type index of openingValue's typeId in modelValue
            if (openingValue's hostId = wallValue's id) and typeFound's valid:
                set openingType to the item at typeFound's position in (modelValue's openingTypes's values)
                set halfWidth to (the bim rough width of openingType) * 0.5
                set fromT to the maximum of 0.0 and ((openingValue's offset - halfWidth) / wallLength)
                set toT to the minimum of 1.0 and ((openingValue's offset + halfWidth) / wallLength)
                # Where it goes in order (DynLex's `and` does not stop early,
                # so the search carries its own flag).
                set slot to 0
                set searching to (the length of starts) > 0
                loop while searching:
                    if (the item at slot in starts) < fromT:
                        set slot to slot + 1
                        if slot >= the length of starts:
                            set searching to false
                    else:
                        set searching to false
                insert fromT into starts at index slot
                insert toT into ends at index slot
                insert openingType's sill into sills at index slot
                insert (openingType's sill + (the bim rough height of openingType)) into heads at index slot
        set along to 0.0
        loop cursor from 0 to the length of starts:
            if (the item at cursor in starts) > along:
                append (the bim wall piece of wallValue with wallFootprint from along to (the item at cursor in starts) between 0.0 and wallValue's height above base) to (pieceList's values)
            if (the item at cursor in sills) > 0.0:
                append (the bim wall piece of wallValue with wallFootprint from (the item at cursor in starts) to (the item at cursor in ends) between 0.0 and (the item at cursor in sills) above base) to (pieceList's values)
            if (the item at cursor in heads) < wallValue's height:
                append (the bim wall piece of wallValue with wallFootprint from (the item at cursor in starts) to (the item at cursor in ends) between (the item at cursor in heads) and wallValue's height above base) to (pieceList's values)
            set along to the maximum of along and (the item at cursor in ends)
        if along < 1.0:
            append (the bim wall piece of wallValue with wallFootprint from along to 1.0 between 0.0 and wallValue's height above base) to (pieceList's values)
        free starts
        free ends
        free sills
        free heads
        return pieceList

# How far `first` and `second` overlap along `direction` (negative when a gap
# separates them).
local function the bim overlap of {bim convex record:first} and {bim convex record:second} along {cad vector3:direction}:
    execute:
        set lowFirst to 1e300
        set highFirst to -1e300
        loop cursor from 0 to the length of (first's corners's values):
            set reach to the cad dot of (the item at cursor in (first's corners's values)) and direction
            set lowFirst to the minimum of lowFirst and reach
            set highFirst to the maximum of highFirst and reach
        set lowSecond to 1e300
        set highSecond to -1e300
        loop cursor from 0 to the length of (second's corners's values):
            set reach to the cad dot of (the item at cursor in (second's corners's values)) and direction
            set lowSecond to the minimum of lowSecond and reach
            set highSecond to the maximum of highSecond and reach
        return (the minimum of highFirst and highSecond) - (the maximum of lowFirst and lowSecond)

# Whether `first` and `second` overlap by more than `margin` along every
# candidate separating axis.
function bim convex {bim convex record:first} clashes with {bim convex record:second} beyond {a 64 bit floating-point number:margin}:
    execute:
        set axes to an empty list of a cad vector3
        loop cursor from 0 to the length of (first's normals's values):
            append (the item at cursor in (first's normals's values)) to axes
        loop cursor from 0 to the length of (second's normals's values):
            append (the item at cursor in (second's normals's values)) to axes
        loop cursor from 0 to the length of (first's edges's values):
            loop other from 0 to the length of (second's edges's values):
                append bim unit (the cad cross of (the item at cursor in (first's edges's values)) and (the item at other in (second's edges's values))) to axes
        set clashing to true
        loop cursor from 0 to the length of axes:
            if clashing:
                if (the bim overlap of first and second along (the item at cursor in axes)) <= margin:
                    set clashing to false
        free axes
        return clashing

# Whether segments `firstId` and `secondId` share a node of `network`.
local function bim segments {a 64 bit integer:firstId} and {a 64 bit integer:secondId} meet in {bim network record:network}:
    execute:
        loop nodeCursor from 0 to the length of (network's nodes's values):
            set networkNode to the item at nodeCursor in (network's nodes's values)
            set hasFirst to false
            set hasSecond to false
            loop memberCursor from 0 to the length of (networkNode's connectors's values):
                set member to the item at (the item at memberCursor in (networkNode's connectors's values)) in (network's connectors's values)
                if member's elementId = firstId:
                    set hasFirst to true
                if member's elementId = secondId:
                    set hasSecond to true
            if hasFirst and hasSecond:
                return true
        return false

function the bim box around convex {bim convex record:solid}:
    execute:
        set low to a cad vector3 with x 1e300, y 1e300 and z 1e300
        set high to a cad vector3 with x -1e300, y -1e300 and z -1e300
        loop cursor from 0 to the length of (solid's corners's values):
            set spot to the item at cursor in (solid's corners's values)
            set low to a cad vector3 with x (the minimum of low's x and spot's x), y (the minimum of low's y and spot's y) and z (the minimum of low's z and spot's z)
            set high to a cad vector3 with x (the maximum of high's x and spot's x), y (the maximum of high's y and spot's y) and z (the maximum of high's z and spot's z)
        return @intrinsic("construct", a bim clash box record, low, high)

# A solid's place in the sweep: where its box starts along x.
class:
    patterns:
        [a|] bim sweep entry record
    members:
        lowX as a 64 bit floating-point number
        index as an integer

function bim sweep ordering {pointer:left} and {pointer:right}:
    execute:
        set first to @intrinsic("dereference", left as a pointer to a bim sweep entry record)
        set second to @intrinsic("dereference", right as a pointer to a bim sweep entry record)
        if first's lowX < second's lowX:
            return -1
        if first's lowX > second's lowX:
            return 1
        return 0

local function bim box {bim clash box record:first} overlaps {bim clash box record:second}:
    execute:
        if (first's high's x < second's low's x) or (second's high's x < first's low's x):
            return false
        if (first's high's y < second's low's y) or (second's high's y < first's low's y):
            return false
        return (first's high's z >= second's low's z) and (second's high's z >= first's low's z)

# The clashes of `modelValue`: every pipe, duct or cable tray against every
# other linear element and every straight wall, each pair once, segments
# joined in the network left out.
function the bim clashes of {bim model record:modelValue}:
    execute:
        set found to a cad topology list of a bim clash record
        set solids to a cad topology list of a bim convex record
        loop cursor from 0 to the length of (modelValue's linears's values):
            append (the bim convex of linear (the item at cursor in (modelValue's linears's values)) in modelValue) to (solids's values)
        set index to the bim join index of modelValue
        loop cursor from 0 to the length of (modelValue's walls's values):
            set wallValue to the item at cursor in (modelValue's walls's values)
            if wallValue's bulge = 0.0:
                set wallPieces to the bim convex pieces of wall wallValue in modelValue using index
                loop pieceCursor from 0 to the length of (wallPieces's values):
                    append (the item at pieceCursor in (wallPieces's values)) to (solids's values)
        set servicesNetwork to the bim network of modelValue
        set boxes to an empty list of a bim clash box record
        loop cursor from 0 to the length of (solids's values):
            append (the bim box around convex (the item at cursor in (solids's values))) to boxes
        # Sweep and prune: the solids in order of where their boxes start
        # along x; each is compared only with those that start before its box
        # ends there.
        set sweep to an empty list of a bim sweep entry record
        loop cursor from 0 to the length of boxes:
            append (@intrinsic("construct", a bim sweep entry record, (the item at cursor in boxes)'s low's x, cursor)) to sweep
        set comparator to the function named "bim sweep ordering $ and $"
        sort native array at ((the data of sweep) as a pointer) with ((the length of sweep) as a word sized unsigned integer) items of ((the size of a bim sweep entry record) as a word sized unsigned integer) bytes using comparator
        loop sweepCursor from 0 to the length of sweep:
            set firstIndex to (the item at sweepCursor in sweep)'s index
            set firstBox to the item at firstIndex in boxes
            set ahead to sweepCursor + 1
            loop while (ahead < the length of sweep) and ((the item at ((the minimum of ahead and ((the length of sweep) - 1))) in sweep)'s lowX <= firstBox's high's x):
                set secondIndex to (the item at ahead in sweep)'s index
                set ahead to ahead + 1
                set cursor to the minimum of firstIndex and secondIndex
                set other to the maximum of firstIndex and secondIndex
                set first to the item at cursor in (solids's values)
                set second to the item at other in (solids's values)
                set candidate to first's connects or second's connects
                if candidate:
                    set candidate to bim box (the item at cursor in boxes) overlaps (the item at other in boxes)
                if candidate:
                    set joined to false
                    if first's connects and second's connects:
                        set joined to bim segments first's elementId and second's elementId meet in servicesNetwork
                    if joined = false:
                        if bim convex first clashes with second beyond 0.001:
                            # A wall's pieces report it once.
                            set already to false
                            loop foundCursor from 0 to the length of (found's values):
                                set earlier to the item at foundCursor in (found's values)
                                if (earlier's firstId = first's elementId) and (earlier's secondId = second's elementId):
                                    set already to true
                            if already = false:
                                append (@intrinsic("construct", a bim clash record, first's elementId, second's elementId)) to (found's values)
        return found
