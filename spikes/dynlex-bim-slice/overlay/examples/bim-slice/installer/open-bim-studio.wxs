<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MPL-2.0 -->
<!--
  The Windows installer of Open BIM Studio (WiX Toolset 3): the staged folder
  (`make-windows-package.ps1`, harvested by heat.exe into the component group
  AppFiles) under Program Files, and a Start menu entry that starts the program
  in the person's Documents folder, where its exports are written. The program
  finds its fonts, shaders and icons beside its bin\ folder by itself.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Open BIM Studio"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="OpenAEC Foundation"
           UpgradeCode="{99DB270E-1365-4B01-896C-77EB56A23112}">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"
             Description="Open BIM Studio $(var.Version)" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Open BIM Studio is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ApplicationIcon" SourceFile="$(var.StageDir)\icons\open-bim-studio.ico" />
    <Property Id="ARPPRODUCTICON" Value="ApplicationIcon" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Open BIM Studio" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="PersonalFolder" />
    </Directory>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="{50F1F2DF-9B4C-493E-8A31-9862E0DB75A8}" Win64="yes">
        <Shortcut Id="OpenBimStudioShortcut"
                  Name="Open BIM Studio"
                  Description="Open BIM Studio"
                  Icon="ApplicationIcon" IconIndex="0"
                  Target="[INSTALLFOLDER]bin\open-bim-studio.exe"
                  WorkingDirectory="PersonalFolder" />
        <RegistryValue Root="HKCU" Key="Software\OpenAEC Foundation\Open BIM Studio"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Application" Title="Open BIM Studio" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
