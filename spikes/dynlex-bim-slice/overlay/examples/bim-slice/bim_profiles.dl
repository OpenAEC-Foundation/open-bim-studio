# SPDX-License-Identifier: MPL-2.0
# The standard IFC profiles of linear types: a linear type is a rectangle
# or a circle (its width and depth) unless it has a profile kind, kept as
# its settings with the profile's dimensions, as IFC's parametric profile
# definitions: IfcRectangleProfileDef, IfcCircleProfileDef,
# IfcIShapeProfileDef, IfcLShapeProfileDef, IfcUShapeProfileDef,
# IfcTShapeProfileDef, IfcCShapeProfileDef, IfcZShapeProfileDef,
# IfcRectangleHollowProfileDef, IfcCircleHollowProfileDef,
# IfcEllipseProfileDef and IfcTrapeziumProfileDef. Each lies with the middle
# of its bounding box on the element's axis, as IFC places them; its width
# along the type's width, its depth along its depth.
#
# The 3D view sweeps its outline and holes (`bim_scene.dl`), the plan draws
# its outline, the IFC export writes its profile definition.
import examples/bim-slice/bim_model.dl

function bim no profile:
    replacement:
        0
function bim i shape profile:
    replacement:
        1
function bim l shape profile:
    replacement:
        2
function bim u shape profile:
    replacement:
        3
function bim t shape profile:
    replacement:
        4
function bim c shape profile:
    replacement:
        5
function bim z shape profile:
    replacement:
        6
function bim rectangle hollow profile:
    replacement:
        7
function bim circle hollow profile:
    replacement:
        8
function bim ellipse profile:
    replacement:
        9
function bim trapezium profile:
    replacement:
        10

# The settings of a linear type's profile: its kind at 2000000, its
# dimensions at 2000001 to 2000004 in tenths of a millimetre (web, flange,
# fillet radius and a fourth by kind, see `the bim profile of linear type`),
# its series at 2000005 (`bim steel series setting` in `bim_model.dl`).
function bim profile kind setting:
    replacement:
        2000000
function bim profile dimension setting:
    replacement:
        2000001

# A linear type's profile: its kind, width and depth (the type's), and by
# kind: I, U, T, Z a web and a flange thickness and a fillet radius; L a
# thickness (`web`) and a fillet radius; C a wall thickness (`web`) and a
# lip (`fourth`); hollow sections a wall thickness (`web`) and an outer
# corner radius; a trapezium its top width (`fourth`). In metres.
class:
    patterns:
        [a|] bim profile record
    members:
        kind as an integer
        width as a 64 bit floating-point number
        depth as a 64 bit floating-point number
        web as a 64 bit floating-point number
        flange as a 64 bit floating-point number
        fillet as a 64 bit floating-point number
        fourth as a 64 bit floating-point number
        round as a boolean

function the bim profile dimension {integer:slot} of {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        return ((the bim setting ((bim profile dimension setting) + slot) of typeId in modelValue)'s value as a 64 bit floating-point number) / 10000.0

function the bim profile of linear type {bim linear type record:linearType} in {bim model record:modelValue}:
    execute:
        set kindCode to ((the bim setting (bim profile kind setting) of linearType's id in modelValue)'s value) as an integer
        return @intrinsic("construct", a bim profile record, kindCode, linearType's width, linearType's depth, (the bim profile dimension 0 of linearType's id in modelValue), (the bim profile dimension 1 of linearType's id in modelValue), (the bim profile dimension 2 of linearType's id in modelValue), (the bim profile dimension 3 of linearType's id in modelValue), linearType's round)

# Linear type `typeId` given profile `kindCode` with dimensions (metres)
# `web`, `flange`, `fillet` and `fourth`, of series `seriesCode` (0 none).
function give bim linear type {a 64 bit integer:typeId} profile {integer:kindCode} web {a 64 bit floating-point number:webValue} flange {a 64 bit floating-point number:flangeValue} fillet {a 64 bit floating-point number:filletValue} fourth {a 64 bit floating-point number:fourthValue} series {integer:seriesCode} in {a pointer to a bim model record:target}:
    execute:
        set bim setting (bim profile kind setting) of typeId to (kindCode as a 64 bit integer) keeping (kindCode != bim no profile) in target
        set bim setting (bim profile dimension setting) of typeId to ((the rounded value of (webValue * 10000.0)) as a 64 bit integer) keeping (webValue > 0.0) in target
        set bim setting ((bim profile dimension setting) + 1) of typeId to ((the rounded value of (flangeValue * 10000.0)) as a 64 bit integer) keeping (flangeValue > 0.0) in target
        set bim setting ((bim profile dimension setting) + 2) of typeId to ((the rounded value of (filletValue * 10000.0)) as a 64 bit integer) keeping (filletValue > 0.0) in target
        set bim setting ((bim profile dimension setting) + 3) of typeId to ((the rounded value of (fourthValue * 10000.0)) as a 64 bit integer) keeping (fourthValue > 0.0) in target
        set bim setting (bim steel series setting) of typeId to (seriesCode as a 64 bit integer) keeping (seriesCode > 0) in target
        note bim change of typeId in target

local function append bim profile corner {a 64 bit floating-point number:x} {a 64 bit floating-point number:y} to {a pointer to a list:ring}:
    execute:
        append (a cad vector2 with x x and y y) to ring

# A quarter circle of `cornerRadius` about (`centreX`, `centreY`) from
# angle `fromAngle` to `toAngle`, in 6 steps (the first point left out).
local function append bim profile arc about {a 64 bit floating-point number:centreX} {a 64 bit floating-point number:centreY} radius {a 64 bit floating-point number:cornerRadius} from {a 64 bit floating-point number:fromAngle} to {a 64 bit floating-point number:toAngle} to {a pointer to a list:ring}:
    execute:
        loop step from 1 to 7:
            set turn to fromAngle + ((toAngle - fromAngle) * ((step as a 64 bit floating-point number) / 6.0))
            append (a cad vector2 with x (centreX + (cornerRadius * (the cosine of turn))) and y (centreY + (cornerRadius * (the sine of turn)))) to ring

# A rectangle `across` by `tall` about the origin, its corners rounded by
# `cornerRadius`, anticlockwise.
local function the bim profile rounded box {a 64 bit floating-point number:across} by {a 64 bit floating-point number:tall} radius {a 64 bit floating-point number:cornerRadius}:
    execute:
        set ring to an empty list of a cad vector2
        set halfX to across * 0.5
        set halfY to tall * 0.5
        set rounding to the minimum of cornerRadius and (the minimum of halfX and halfY)
        if rounding <= 0.0001:
            append bim profile corner (0.0 - halfX) (0.0 - halfY) to ring
            append bim profile corner halfX (0.0 - halfY) to ring
            append bim profile corner halfX halfY to ring
            append bim profile corner (0.0 - halfX) halfY to ring
            return ring
        append bim profile corner (halfX - rounding) (0.0 - halfY) to ring
        append bim profile arc about (halfX - rounding) ((0.0 - halfY) + rounding) radius rounding from -1.5707963267948966 to 0.0 to ring
        append bim profile arc about (halfX - rounding) (halfY - rounding) radius rounding from 0.0 to 1.5707963267948966 to ring
        append bim profile arc about ((0.0 - halfX) + rounding) (halfY - rounding) radius rounding from 1.5707963267948966 to 3.141592653589793 to ring
        append bim profile arc about ((0.0 - halfX) + rounding) ((0.0 - halfY) + rounding) radius rounding from 3.141592653589793 to 4.71238898038469 to ring
        return ring

local function the bim profile ellipse {a 64 bit floating-point number:across} by {a 64 bit floating-point number:tall} in {integer:cornerCount} corners:
    execute:
        set ring to an empty list of a cad vector2
        loop step from 0 to cornerCount:
            set turn to (6.283185307179586 * (step as a 64 bit floating-point number)) / (cornerCount as a 64 bit floating-point number)
            append (a cad vector2 with x ((across * 0.5) * (the cosine of turn)) and y ((tall * 0.5) * (the sine of turn))) to ring
        return ring

# The rings of `profile` about the middle of its bounding box: its outline
# first (anticlockwise), then its holes (clockwise); `roundCorners` corners
# on a circle. Fillets are left square except on hollow sections.
function the bim rings of profile {bim profile record:shapeProfile} at {integer:roundCorners} round corners:
    execute:
        set ringList to an empty list of the type of (an empty list of a cad vector2)
        set halfWidth to shapeProfile's width * 0.5
        set halfDepth to shapeProfile's depth * 0.5
        set web to the maximum of 0.0005 and shapeProfile's web
        set flange to the maximum of 0.0005 and shapeProfile's flange
        if (shapeProfile's kind = bim no profile) and shapeProfile's round:
            append (the bim profile ellipse shapeProfile's width by shapeProfile's width in roundCorners corners) to ringList
            return ringList
        if shapeProfile's kind = bim i shape profile:
            set ring to an empty list of a cad vector2
            append bim profile corner (0.0 - halfWidth) (0.0 - halfDepth) to ring
            append bim profile corner halfWidth (0.0 - halfDepth) to ring
            append bim profile corner halfWidth ((0.0 - halfDepth) + flange) to ring
            append bim profile corner (web * 0.5) ((0.0 - halfDepth) + flange) to ring
            append bim profile corner (web * 0.5) (halfDepth - flange) to ring
            append bim profile corner halfWidth (halfDepth - flange) to ring
            append bim profile corner halfWidth halfDepth to ring
            append bim profile corner (0.0 - halfWidth) halfDepth to ring
            append bim profile corner (0.0 - halfWidth) (halfDepth - flange) to ring
            append bim profile corner (0.0 - (web * 0.5)) (halfDepth - flange) to ring
            append bim profile corner (0.0 - (web * 0.5)) ((0.0 - halfDepth) + flange) to ring
            append bim profile corner (0.0 - halfWidth) ((0.0 - halfDepth) + flange) to ring
            append ring to ringList
            return ringList
        if shapeProfile's kind = bim l shape profile:
            # The legs along the left and the bottom (IfcLShapeProfileDef).
            set ring to an empty list of a cad vector2
            append bim profile corner (0.0 - halfWidth) (0.0 - halfDepth) to ring
            append bim profile corner halfWidth (0.0 - halfDepth) to ring
            append bim profile corner halfWidth ((0.0 - halfDepth) + web) to ring
            append bim profile corner ((0.0 - halfWidth) + web) ((0.0 - halfDepth) + web) to ring
            append bim profile corner ((0.0 - halfWidth) + web) halfDepth to ring
            append bim profile corner (0.0 - halfWidth) halfDepth to ring
            append ring to ringList
            return ringList
        if (shapeProfile's kind = bim u shape profile) or (shapeProfile's kind = bim c shape profile):
            # The web on the left, flanges to the right (a C's lips turned in).
            set ring to an empty list of a cad vector2
            set flangeThickness to flange
            if shapeProfile's kind = bim c shape profile:
                set flangeThickness to web
            append bim profile corner (0.0 - halfWidth) (0.0 - halfDepth) to ring
            append bim profile corner halfWidth (0.0 - halfDepth) to ring
            if (shapeProfile's kind = bim c shape profile) and (shapeProfile's fourth > web):
                append bim profile corner halfWidth ((0.0 - halfDepth) + shapeProfile's fourth) to ring
                append bim profile corner (halfWidth - web) ((0.0 - halfDepth) + shapeProfile's fourth) to ring
                append bim profile corner (halfWidth - web) ((0.0 - halfDepth) + flangeThickness) to ring
            else:
                append bim profile corner halfWidth ((0.0 - halfDepth) + flangeThickness) to ring
            append bim profile corner ((0.0 - halfWidth) + web) ((0.0 - halfDepth) + flangeThickness) to ring
            append bim profile corner ((0.0 - halfWidth) + web) (halfDepth - flangeThickness) to ring
            if (shapeProfile's kind = bim c shape profile) and (shapeProfile's fourth > web):
                append bim profile corner (halfWidth - web) (halfDepth - flangeThickness) to ring
                append bim profile corner (halfWidth - web) (halfDepth - shapeProfile's fourth) to ring
                append bim profile corner halfWidth (halfDepth - shapeProfile's fourth) to ring
            else:
                append bim profile corner halfWidth (halfDepth - flangeThickness) to ring
            append bim profile corner halfWidth halfDepth to ring
            append bim profile corner (0.0 - halfWidth) halfDepth to ring
            append ring to ringList
            return ringList
        if shapeProfile's kind = bim t shape profile:
            # The flange at the top, the web down the middle.
            set ring to an empty list of a cad vector2
            append bim profile corner (0.0 - (web * 0.5)) (0.0 - halfDepth) to ring
            append bim profile corner (web * 0.5) (0.0 - halfDepth) to ring
            append bim profile corner (web * 0.5) (halfDepth - flange) to ring
            append bim profile corner halfWidth (halfDepth - flange) to ring
            append bim profile corner halfWidth halfDepth to ring
            append bim profile corner (0.0 - halfWidth) halfDepth to ring
            append bim profile corner (0.0 - halfWidth) (halfDepth - flange) to ring
            append bim profile corner (0.0 - (web * 0.5)) (halfDepth - flange) to ring
            append ring to ringList
            return ringList
        if shapeProfile's kind = bim z shape profile:
            set ring to an empty list of a cad vector2
            append bim profile corner (0.0 - (web * 0.5)) (0.0 - halfDepth) to ring
            append bim profile corner halfWidth (0.0 - halfDepth) to ring
            append bim profile corner halfWidth ((0.0 - halfDepth) + flange) to ring
            append bim profile corner (web * 0.5) ((0.0 - halfDepth) + flange) to ring
            append bim profile corner (web * 0.5) halfDepth to ring
            append bim profile corner (0.0 - halfWidth) halfDepth to ring
            append bim profile corner (0.0 - halfWidth) (halfDepth - flange) to ring
            append bim profile corner (0.0 - (web * 0.5)) (halfDepth - flange) to ring
            append ring to ringList
            return ringList
        if shapeProfile's kind = bim rectangle hollow profile:
            append (the bim profile rounded box shapeProfile's width by shapeProfile's depth radius shapeProfile's flange) to ringList
            set inner to the bim profile rounded box (shapeProfile's width - (2.0 * web)) by (shapeProfile's depth - (2.0 * web)) radius (the maximum of 0.0 and (shapeProfile's flange - web))
            append (the bim profile reversed ring inner) to ringList
            free inner
            return ringList
        if shapeProfile's kind = bim circle hollow profile:
            append (the bim profile ellipse shapeProfile's width by shapeProfile's width in roundCorners corners) to ringList
            set inner to the bim profile ellipse (shapeProfile's width - (2.0 * web)) by (shapeProfile's width - (2.0 * web)) in roundCorners corners
            append (the bim profile reversed ring inner) to ringList
            free inner
            return ringList
        if shapeProfile's kind = bim ellipse profile:
            append (the bim profile ellipse shapeProfile's width by shapeProfile's depth in roundCorners corners) to ringList
            return ringList
        if shapeProfile's kind = bim trapezium profile:
            set ring to an empty list of a cad vector2
            set halfTop to the maximum of 0.0005 and (shapeProfile's fourth * 0.5)
            append bim profile corner (0.0 - halfWidth) (0.0 - halfDepth) to ring
            append bim profile corner halfWidth (0.0 - halfDepth) to ring
            append bim profile corner halfTop halfDepth to ring
            append bim profile corner (0.0 - halfTop) halfDepth to ring
            append ring to ringList
            return ringList
        append (the bim profile rounded box shapeProfile's width by shapeProfile's depth radius 0.0) to ringList
        return ringList

# The IFC name of profile kind `kindCode` (`round` for a plain one).
function the bim name of profile kind {integer:kindCode} round {boolean:isRound}:
    execute:
        if kindCode = bim i shape profile:
            return the string form of "IfcIShapeProfileDef"
        if kindCode = bim l shape profile:
            return the string form of "IfcLShapeProfileDef"
        if kindCode = bim u shape profile:
            return the string form of "IfcUShapeProfileDef"
        if kindCode = bim t shape profile:
            return the string form of "IfcTShapeProfileDef"
        if kindCode = bim c shape profile:
            return the string form of "IfcCShapeProfileDef"
        if kindCode = bim z shape profile:
            return the string form of "IfcZShapeProfileDef"
        if kindCode = bim rectangle hollow profile:
            return the string form of "IfcRectangleHollowProfileDef"
        if kindCode = bim circle hollow profile:
            return the string form of "IfcCircleHollowProfileDef"
        if kindCode = bim ellipse profile:
            return the string form of "IfcEllipseProfileDef"
        if kindCode = bim trapezium profile:
            return the string form of "IfcTrapeziumProfileDef"
        if isRound:
            return the string form of "IfcCircleProfileDef"
        return the string form of "IfcRectangleProfileDef"

function the bim profile reversed ring {a pointer to a list:sourceRing}:
    execute:
        set reversedRing to an empty list of a cad vector2
        set cursor to (the length of sourceRing) - 1
        loop while cursor >= 0:
            append (the item at cursor in sourceRing) to reversedRing
            set cursor to cursor - 1
        return reversedRing

# The IFC4 profile definition of `profile` (its entity's text, in metres,
# placed by `positionReference`).
function the bim ifc profile text of {bim profile record:shapeProfile} at {a string:positionReference}:
    execute:
        set head to (the string form of "(.AREA.,$,") + positionReference
        set width to the bim profile number shapeProfile's width
        set depth to the bim profile number shapeProfile's depth
        set web to the bim profile number shapeProfile's web
        set flange to the bim profile number shapeProfile's flange
        set fillet to the bim profile number shapeProfile's fillet
        if shapeProfile's kind = bim i shape profile:
            return ((the string form of "IFCISHAPEPROFILEDEF") + head) + ((((((((the string form of ",") + width) + (the string form of ",")) + depth) + (the string form of ",")) + web) + (the string form of ",")) + ((flange + (the string form of ",")) + (fillet + (the string form of ",$,$)"))))
        if shapeProfile's kind = bim l shape profile:
            return ((the string form of "IFCLSHAPEPROFILEDEF") + head) + ((((((the string form of ",") + depth) + (the string form of ",")) + width) + (the string form of ",")) + ((web + (the string form of ",")) + (fillet + (the string form of ",$,$)"))))
        if shapeProfile's kind = bim u shape profile:
            return ((the string form of "IFCUSHAPEPROFILEDEF") + head) + ((((((((the string form of ",") + depth) + (the string form of ",")) + width) + (the string form of ",")) + web) + (the string form of ",")) + ((flange + (the string form of ",")) + (fillet + (the string form of ",$,$)"))))
        if shapeProfile's kind = bim t shape profile:
            return ((the string form of "IFCTSHAPEPROFILEDEF") + head) + ((((((((the string form of ",") + depth) + (the string form of ",")) + width) + (the string form of ",")) + web) + (the string form of ",")) + ((flange + (the string form of ",")) + (fillet + (the string form of ",$,$,$,$)"))))
        if shapeProfile's kind = bim c shape profile:
            return ((the string form of "IFCCSHAPEPROFILEDEF") + head) + ((((((the string form of ",") + depth) + (the string form of ",")) + width) + (the string form of ",")) + ((web + (the string form of ",")) + ((the bim profile number shapeProfile's fourth) + (the string form of ",$)"))))
        if shapeProfile's kind = bim z shape profile:
            return ((the string form of "IFCZSHAPEPROFILEDEF") + head) + ((((((((the string form of ",") + depth) + (the string form of ",")) + width) + (the string form of ",")) + web) + (the string form of ",")) + ((flange + (the string form of ",")) + (fillet + (the string form of ",$)"))))
        if shapeProfile's kind = bim rectangle hollow profile:
            return ((the string form of "IFCRECTANGLEHOLLOWPROFILEDEF") + head) + ((((((the string form of ",") + width) + (the string form of ",")) + depth) + (the string form of ",")) + ((web + (the string form of ",$,")) + (flange + (the string form of ")"))))
        if shapeProfile's kind = bim circle hollow profile:
            return ((the string form of "IFCCIRCLEHOLLOWPROFILEDEF") + head) + ((((the string form of ",") + (the bim profile number (shapeProfile's width * 0.5))) + (the string form of ",")) + (web + (the string form of ")")))
        if shapeProfile's kind = bim ellipse profile:
            return ((the string form of "IFCELLIPSEPROFILEDEF") + head) + ((((the string form of ",") + (the bim profile number (shapeProfile's width * 0.5))) + (the string form of ",")) + ((the bim profile number (shapeProfile's depth * 0.5)) + (the string form of ")")))
        if shapeProfile's kind = bim trapezium profile:
            return ((the string form of "IFCTRAPEZIUMPROFILEDEF") + head) + ((((((the string form of ",") + width) + (the string form of ",")) + (the bim profile number shapeProfile's fourth)) + (the string form of ",")) + ((depth + (the string form of ",")) + ((the bim profile number ((shapeProfile's width - shapeProfile's fourth) * 0.5)) + (the string form of ")"))))
        if shapeProfile's round:
            return ((the string form of "IFCCIRCLEPROFILEDEF") + head) + (((the string form of ",") + (the bim profile number (shapeProfile's width * 0.5))) + (the string form of ")"))
        return ((the string form of "IFCRECTANGLEPROFILEDEF") + head) + ((((the string form of ",") + width) + (the string form of ",")) + (depth + (the string form of ")")))

# A length for IFC text (metres, six decimals, a point always).
function the bim profile number {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.6f", value)
        return the substring of buffer from 0 spanning written bytes
