# SPDX-License-Identifier: MPL-2.0
# Planar corner constructions shared by native modify commands.
import lib/cadkernel/core.dl

class:
    patterns:
        [a|] bim modify corner record
    members:
        valid as a boolean
        firstCut as a cad vector2
        secondCut as a cad vector2
        firstKept as a cad vector2
        secondKept as a cad vector2
        middle as a cad vector2

function the bim modify corner from {cad vector2:firstStart} to {cad vector2:firstFinish} keeping {cad vector2:firstPick} and from {cad vector2:secondStart} to {cad vector2:secondFinish} keeping {cad vector2:secondPick} sized {a 64 bit floating-point number:amount} rounded {boolean:rounded}:
    execute:
        set none to @intrinsic("construct", a bim modify corner record, false, firstStart, secondStart, firstFinish, secondFinish, firstStart)
        if ((amount > 0.0) and (amount <= 1000000.0)) = false:
            return none
        set ax to firstFinish's x - firstStart's x
        set ay to firstFinish's y - firstStart's y
        set bx to secondFinish's x - secondStart's x
        set by to secondFinish's y - secondStart's y
        set denominator to (ax * by) - (ay * bx)
        if (the absolute value of denominator) < 1e-12:
            return none
        set share to (((secondStart's x - firstStart's x) * by) - ((secondStart's y - firstStart's y) * bx)) / denominator
        set meeting to a cad vector2 with x (firstStart's x + (share * ax)) and y (firstStart's y + (share * ay))
        set keptFirst to firstFinish
        if (((firstPick's x - meeting's x) * ax) + ((firstPick's y - meeting's y) * ay)) < 0.0:
            set keptFirst to firstStart
        set keptSecond to secondFinish
        if (((secondPick's x - meeting's x) * bx) + ((secondPick's y - meeting's y) * by)) < 0.0:
            set keptSecond to secondStart
        set firstRun to the cad distance from meeting to keptFirst
        set secondRun to the cad distance from meeting to keptSecond
        if (firstRun < 1e-9) or (secondRun < 1e-9):
            return none
        set ux to (keptFirst's x - meeting's x) / firstRun
        set uy to (keptFirst's y - meeting's y) / firstRun
        set vx to (keptSecond's x - meeting's x) / secondRun
        set vy to (keptSecond's y - meeting's y) / secondRun
        set dot to (ux * vx) + (uy * vy)
        if (dot <= -0.999999999) or (dot >= 0.999999999):
            return none
        set setback to amount
        set middle to meeting
        if rounded:
            set halfSine to the square root of ((1.0 - dot) * 0.5)
            set halfCosine to the square root of ((1.0 + dot) * 0.5)
            set setback to (amount * halfCosine) / halfSine
            set bisectorRun to the square root of (((ux + vx) * (ux + vx)) + ((uy + vy) * (uy + vy)))
            set middleDistance to (amount / halfSine) - amount
            set middle to a cad vector2 with x (meeting's x + (((ux + vx) / bisectorRun) * middleDistance)) and y (meeting's y + (((uy + vy) / bisectorRun) * middleDistance))
        if (setback >= (firstRun - 1e-6)) or (setback >= (secondRun - 1e-6)):
            return none
        return @intrinsic("construct", a bim modify corner record, true, (a cad vector2 with x (meeting's x + (ux * setback)) and y (meeting's y + (uy * setback))), (a cad vector2 with x (meeting's x + (vx * setback)) and y (meeting's y + (vy * setback))), keptFirst, keptSecond, middle)
