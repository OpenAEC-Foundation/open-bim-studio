# Synthetic 18 x 12 m steel hall. All geometry is native/editable DynLex BIM.
import examples/bim-slice/bim_steel_connections.dl
import examples/bim-slice/bim_baseplate.dl

function add steel hall joint from {a 64 bit integer:primaryId} to {a 64 bit integer:secondaryId} style {integer:styleCode} in {a pointer to a bim model record:target}:
    execute:
        set identities to an empty list of a 64 bit integer
        append primaryId to identities
        if secondaryId != the bim refused id:
            append secondaryId to identities
        set nodeId to add bim steel connection among identities style styleCode in target
        free identities
        return nodeId

function the bim demo steel hall:
    execute:
        set modelValue to an empty bim model
        set target to the address of modelValue
        set ground to add bim level named (the string form of "Steel hall datum") at 0.0 with height 6.6 to target
        set columnType to add bim linear type named (the string form of "HEB 260") as role bim column role sized 0.26 by 0.26 round false of (the string form of "steel") to target
        give bim linear type columnType profile bim i shape profile web 0.010 flange 0.0175 fillet 0.024 fourth 0.0 series 4 in target
        set bim setting (bim steel designation setting) of columnType to (260 as a 64 bit integer) keeping true in target
        set rafterType to add bim linear type named (the string form of "IPE 400") as role bim beam role sized 0.18 by 0.4 round false of (the string form of "steel") to target
        give bim linear type rafterType profile bim i shape profile web 0.0086 flange 0.0135 fillet 0.021 fourth 0.0 series 1 in target
        set bim setting (bim steel designation setting) of rafterType to (400 as a 64 bit integer) keeping true in target
        set purlinType to add bim linear type named (the string form of "IPE 200") as role bim beam role sized 0.10 by 0.20 round false of (the string form of "steel") to target
        give bim linear type purlinType profile bim i shape profile web 0.0056 flange 0.0085 fillet 0.012 fourth 0.0 series 1 in target
        set bim setting (bim steel designation setting) of purlinType to (200 as a 64 bit integer) keeping true in target
        set braceType to add bim linear type named (the string form of "SHS 80x80x5") as role bim generic linear role sized 0.08 by 0.08 round false of (the string form of "steel") to target
        give bim linear type braceType profile bim rectangle hollow profile web 0.005 flange 0.0075 fillet 0.0 fourth 0.0 series 11 in target
        set columns to an empty list of a 64 bit integer
        set rafters to an empty list of a 64 bit integer
        loop station from 0 to 4:
            set xValue to (station as a 64 bit floating-point number) * 6.0
            loop sideIndex from 0 to 2:
                set yValue to (sideIndex as a 64 bit floating-point number) * 12.0
                set columnId to add bim linear typed columnType on ground from (a cad vector3 with x xValue, y yValue and z 0.0) to (a cad vector3 with x xValue, y yValue and z 6.6) turned 0.0 to target
                append columnId to columns
                ignore add bim base plate below columnId in target
                ignore add steel hall joint from columnId to (the bim refused id) style 8 in target
            loop halfIndex from 0 to 2:
                set yValue to (halfIndex as a 64 bit floating-point number) * 6.0
                set rafterId to add bim linear typed rafterType on ground from (a cad vector3 with x xValue, y yValue and z 6.0) to (a cad vector3 with x xValue, y (yValue + 6.0) and z 6.0) turned 0.0 to target
                append rafterId to rafters
                ignore add steel hall joint from (the item at ((station * 2) + halfIndex) in columns) to rafterId style 3 in target
            ignore add steel hall joint from (the item at (station * 2) in rafters) to (the item at ((station * 2) + 1) in rafters) style 6 in target
        set finType to the bim refused id
        loop bayIndex from 0 to 3:
            set xValue to (bayIndex as a 64 bit floating-point number) * 6.0
            loop rowIndex from 0 to 4:
                set yValue to 0.0
                if rowIndex = 1:
                    set yValue to 3.0
                if rowIndex = 2:
                    set yValue to 9.0
                if rowIndex = 3:
                    set yValue to 12.0
                set purlinId to add bim linear typed purlinType on ground from (a cad vector3 with x xValue, y yValue and z 6.0) to (a cad vector3 with x (xValue + 6.0), y yValue and z 6.0) turned 0.0 to target
                loop endIndex from 0 to 2:
                    set station to bayIndex + endIndex
                    set halfIndex to 0
                    if rowIndex >= 2:
                        set halfIndex to 1
                    set hostId to the item at ((station * 2) + halfIndex) in rafters
                    if (rowIndex = 0) or (rowIndex = 3):
                        set hostId to the item at ((station * 2) + halfIndex) in columns
                    set nodeId to the bim refused id
                    if endIndex = 0:
                        if finType = the bim refused id:
                            set nodeId to add steel hall joint from hostId to purlinId style 4 in target
                            set finType to save bim connection nodeId as type named (the string form of "FP IPE200 four M20") in target
                        else:
                            set identities to an empty list of a 64 bit integer
                            append hostId to identities
                            append purlinId to identities
                            set nodeId to apply bim connection type finType among identities in target
                            free identities
                    else:
                        set nodeId to add steel hall joint from hostId to purlinId style 5 in target
            if bayIndex != 1:
                loop sideIndex from 0 to 2:
                    set yValue to (sideIndex as a 64 bit floating-point number) * 12.0
                    set braceId to add bim linear typed braceType on ground from (a cad vector3 with x xValue, y yValue and z 0.4) to (a cad vector3 with x (xValue + 6.0), y yValue and z 5.5) turned 0.0 to target
                    ignore add steel hall joint from (the item at ((bayIndex * 2) + sideIndex) in columns) to braceId style 7 in target
                    ignore add steel hall joint from (the item at (((bayIndex + 1) * 2) + sideIndex) in columns) to braceId style 7 in target
        free columns
        free rafters
        # The editor requires these tool defaults even in a steel-only project.
        # Add them last so the member and connection identities remain stable.
        set defaultLayers to an empty list of a bim layer record
        append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to defaultLayers
        ignore add bim wall type named (the string form of "Default wall") with defaultLayers to target
        free defaultLayers
        ignore add bim opening type named (the string form of "Default window") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
        ignore add bim door type named (the string form of "Default door") sized 0.9 by 2.1 with frame 0.05 to target
        name bim types by the rules in target
        return modelValue
