import lib/text.dl

function the bim manager octet at {integer:byteIndex} in {a string:rawText}:
    execute:
        return (((the character at byteIndex in rawText) as a 32 bit integer) bitwise and 255) as an integer

local function the bim first nonspace byte of {a string:inputText}:
    execute:
        set byteCount to the length of inputText
        loop scanIndex from 0 to byteCount:
            if (the character at scanIndex in inputText) != 32:
                return scanIndex
        return byteCount

local function the bim last nonspace edge of {a string:inputText}:
    execute:
        set byteCount to the length of inputText
        loop reverseStep from 0 to byteCount:
            set byteIndex to (byteCount - 1) - reverseStep
            if (the character at byteIndex in inputText) != 32:
                return byteIndex + 1
        return 0

function the bim managed clean name of {a string:rawText}:
    execute:
        set byteCount to the length of rawText
        if byteCount = 0:
            return rawText
        set firstIndex to the bim first nonspace byte of rawText
        if firstIndex = byteCount:
            return the string form of ""
        set lastIndex to the bim last nonspace edge of rawText
        return the substring of rawText from firstIndex spanning (lastIndex - firstIndex) bytes

# The byte length of the valid prefix after deleting the last UTF8 character.
# The counted loop reads only byte indices within the original string.
function the bim text backspace prefix length of {a string:inputText}:
    execute:
        set byteCount to the length of inputText
        loop reverseStep from 0 to byteCount:
            set byteIndex to (byteCount - 1) - reverseStep
            set trailingOctet to the bim manager octet at byteIndex in inputText
            if (trailingOctet < 128) or (trailingOctet >= 192):
                return byteIndex
        return 0
