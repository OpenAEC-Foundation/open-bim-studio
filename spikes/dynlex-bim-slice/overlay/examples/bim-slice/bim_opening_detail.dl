# SPDX-License-Identifier: MPL-2.0
# Opening-detail components are owned by their opening. Settings are millimetres.
# 2400100 enabled; +1 lining; +2 depth; +3 joint; +4 sill projection; +5 sill.
import examples/bim-slice/bim_stair.dl

function the bim detail opening of {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        if (the bim opening index of elementId in modelValue)'s valid:
            return elementId
        set hosted to the bim setting (bim host opening setting) of elementId in modelValue
        if hosted's found:
            if (the bim opening index of hosted's value in modelValue)'s valid:
                return hosted's value
        return the bim refused id

function the bim opening detail parts of {a 64 bit integer:openingId} in {bim model record:modelValue}:
    execute:
        set output to a cad topology list of a bim stair part record
        if (the bim setting 2400100 of openingId in modelValue)'s value != (1 as a 64 bit integer):
            return output
        set found to the bim opening index of openingId in modelValue
        if found's valid = false:
            return output
        set openingValue to the item at found's position in (modelValue's openings's values)
        set hostFound to the bim wall index of openingValue's hostId in modelValue
        set typeFound to the bim opening type index of openingValue's typeId in modelValue
        if (hostFound's valid = false) or (typeFound's valid = false):
            return output
        set wallValue to the item at hostFound's position in (modelValue's walls's values)
        # Curved, sloped and leaning walls need a different reveal generator.
        if ((wallValue's bulge != 0.0) or (wallValue's lean != 0.0)) or (wallValue's rise != 0.0):
            return output
        set kind to the item at typeFound's position in (modelValue's openingTypes's values)
        set run to the cad distance from wallValue's start to wallValue's finish
        if run <= 0.000001:
            return output
        set along to a cad vector2 with x ((wallValue's finish's x - wallValue's start's x) / run) and y ((wallValue's finish's y - wallValue's start's y) / run)
        set lining to ((the bim setting 2400101 of openingId in modelValue)'s value as a 64 bit floating-point number) / 1000.0
        set depthValue to ((the bim setting 2400102 of openingId in modelValue)'s value as a 64 bit floating-point number) / 1000.0
        set joint to ((the bim setting 2400103 of openingId in modelValue)'s value as a 64 bit floating-point number) / 1000.0
        set projection to ((the bim setting 2400104 of openingId in modelValue)'s value as a 64 bit floating-point number) / 1000.0
        set sill to ((the bim setting 2400105 of openingId in modelValue)'s value as a 64 bit floating-point number) / 1000.0
        if ((lining <= 0.0) or (depthValue <= 0.0)) or ((joint < 0.0) or (sill <= 0.0)):
            return output
        set halfWidth to ((the bim rough width of kind) * 0.5) - joint
        set bottom to (kind's sill + wallValue's baseOffset) + joint
        set top to ((the bim head height of kind) + wallValue's baseOffset) - joint
        if (halfWidth <= lining) or ((top - bottom) <= (sill + lining)):
            return output
        set middle to a cad vector2 with x (wallValue's start's x + along's x * openingValue's offset) and y (wallValue's start's y + along's y * openingValue's offset)
        loop partIndex from 0 to 4:
            set label to the string form of "Opening detail jamb"
            set widthValue to lining
            set pieceDepth to depthValue
            set lowAlong to (0.0 - halfWidth) + (lining * 0.5)
            set highAlong to lowAlong
            set lowZ to bottom + sill
            set highZ to top - lining
            set angleValue to @intrinsic("atan2", along's y, along's x)
            if partIndex = 1:
                set lowAlong to halfWidth - (lining * 0.5)
                set highAlong to lowAlong
            if partIndex >= 2:
                set lowAlong to 0.0 - halfWidth
                set highAlong to halfWidth
                set angleValue to 1.5707963267948966
                set lowZ to top - (lining * 0.5)
                set highZ to lowZ
                set label to the string form of "Opening detail head"
                if partIndex = 3:
                    set label to the string form of "Opening detail sill"
                    set widthValue to sill
                    set pieceDepth to depthValue + (2.0 * projection)
                    set lowZ to bottom + (sill * 0.5)
                    set highZ to lowZ
            set first to a cad vector3 with x (middle's x + along's x * lowAlong), y (middle's y + along's y * lowAlong) and z lowZ
            set last to a cad vector3 with x (middle's x + along's x * highAlong), y (middle's y + along's y * highAlong) and z highZ
            set profile to @intrinsic("construct", a bim linear type record, the bim refused id, label, bim generic linear role, widthValue, pieceDepth, false, the string form of "timber")
            set element to @intrinsic("construct", a bim linear record, openingId, the bim refused id, wallValue's levelId, first, last, angleValue, 0.0, (a cad vector2 with x 1.0 and y 1.0))
            append (@intrinsic("construct", a bim stair part record, element, profile)) to (output's values)
        return output

function add bim opening detail to {a 64 bit integer:elementId} in {a pointer to a bim model record:target}:
    execute:
        set openingId to the bim detail opening of elementId in (@intrinsic("dereference", target))
        if openingId = the bim refused id:
            return false
        # Reapplying preserves custom parameter values.
        if (the bim setting 2400100 of openingId in (@intrinsic("dereference", target)))'s value = (1 as a 64 bit integer):
            return true
        set bim setting 2400100 of openingId to (1 as a 64 bit integer) keeping true in target
        set bim setting 2400101 of openingId to (18 as a 64 bit integer) keeping true in target
        set bim setting 2400102 of openingId to (200 as a 64 bit integer) keeping true in target
        set bim setting 2400103 of openingId to (10 as a 64 bit integer) keeping true in target
        set bim setting 2400104 of openingId to (40 as a 64 bit integer) keeping true in target
        set bim setting 2400105 of openingId to (30 as a 64 bit integer) keeping true in target
        return (the length of ((the bim opening detail parts of openingId in (@intrinsic("dereference", target)))'s values)) = 4
