# SPDX-License-Identifier: MPL-2.0
# Declarative steel recipes. Coordinates are local to the secondary member:
# x = section width, y = section depth, z = inward along its axis.
import examples/bim-slice/connections.dl

function the steel connection style name of {integer:styleCode}:
    execute:
        if styleCode = 0:
            return the string form of "Butt"
        if styleCode = 1:
            return the string form of "Miter"
        if styleCode = 2:
            return the string form of "Base plate"
        if styleCode = 3:
            return the string form of "End plate"
        if styleCode = 4:
            return the string form of "Fin plate"
        if styleCode = 5:
            return the string form of "Double cleat"
        if styleCode = 6:
            return the string form of "Splice"
        if styleCode = 7:
            return the string form of "Gusset"
        if styleCode = 8:
            return the string form of "End cap"
        return the string form of "Unknown"

function a steel connection part keyed {integer:keyValue} on {a 64 bit integer:memberId} kind {integer:kindCode} at {cad vector3:spot} along {cad vector3:axisValue} wide {a 64 bit floating-point number:widthValue} high {a 64 bit floating-point number:heightValue} thick {a 64 bit floating-point number:thicknessValue}:
    execute:
        return @intrinsic("construct", a connection addition, keyValue, memberId, kindCode, spot, axisValue, widthValue, heightValue, thicknessValue, 0.020, 0.080, 2, 2, 0.080, 0.060, 0.022)

# A recipe is a starting point for editable parts, never a structural design.
function the steel connection parts for style {integer:styleCode} on {a 64 bit integer:memberId} wide {a 64 bit floating-point number:sectionWidth} deep {a 64 bit floating-point number:sectionDepth} web {a 64 bit floating-point number:webThickness}:
    execute:
        set resultParts to a cad topology list of a connection addition
        set across to a cad vector3 with x 1.0, y 0.0 and z 0.0
        set upward to a cad vector3 with x 0.0, y 1.0 and z 0.0
        set inward to a cad vector3 with x 0.0, y 0.0 and z 1.0
        set zero to a cad vector3 with x 0.0, y 0.0 and z 0.0
        set plateThickness to 0.012
        set plateHeight to the maximum of 0.16 and (sectionDepth * 0.6)
        set plateWidth to the maximum of 0.16 and (sectionWidth + 0.08)
        set plate to a steel connection part keyed 1 on memberId kind 0 at zero along inward wide plateWidth high (sectionDepth + 0.08) thick plateThickness
        set bolts to a steel connection part keyed 2 on memberId kind 1 at zero along inward wide 0.0 high 0.0 thick 0.0
        set weld to a steel connection part keyed 3 on memberId kind 4 at zero along upward wide 0.0 high 0.0 thick 0.006
        set weld's length to plateHeight
        if (styleCode = 3) or (styleCode = 8):
            set plate's origin's z to plateThickness * 0.5
            if styleCode = 8:
                set plate's origin's z to 0.0 - (plateThickness * 0.5)
            append plate to (resultParts's values)
            if styleCode = 3:
                set bolts's origin's z to -0.030
                set bolts's rowPitch to sectionDepth * 0.5
                set bolts's columnPitch to sectionWidth * 0.5
                append bolts to (resultParts's values)
            set weld's origin to a cad vector3 with x (sectionWidth * 0.5), y (0.0 - plateHeight * 0.5) and z plateThickness
            if styleCode = 8:
                set weld's origin's z to 0.0
            append weld to (resultParts's values)
            set weld's key to 4
            set weld's origin's x to 0.0 - (sectionWidth * 0.5)
            append weld to (resultParts's values)
        if (styleCode = 4) or (styleCode = 7):
            # A vertical plate alongside the web, extending into the beam.
            set plate's axis to across
            set plate's width to plateHeight
            set plate's height to 0.24
            set plate's origin to a cad vector3 with x ((webThickness + plateThickness) * 0.5), y 0.0 and z 0.12
            append plate to (resultParts's values)
            set bolts's axis to across
            set bolts's origin to a cad vector3 with x -0.025, y 0.0 and z 0.14
            set bolts's rowPitch to 0.08
            set bolts's columnPitch to plateHeight * 0.5
            append bolts to (resultParts's values)
            set weld's origin to a cad vector3 with x (webThickness * 0.5), y (0.0 - plateHeight * 0.5) and z 0.0
            append weld to (resultParts's values)
        if styleCode = 5:
            # Two angles, each made from two independently editable legs.
            loop sideIndex from 0 to 2:
                set signValue to -1.0 + (2.0 * (sideIndex as a 64 bit floating-point number))
                set plate's key to 1 + (sideIndex * 3)
                set plate's axis to across
                set plate's width to plateHeight
                set plate's height to 0.10
                set plate's origin to a cad vector3 with x (signValue * ((webThickness + plateThickness) * 0.5)), y 0.0 and z 0.05
                append plate to (resultParts's values)
                set plate's key to plate's key + 1
                set plate's axis to inward
                set plate's width to 0.10
                set plate's height to plateHeight
                set plate's origin to a cad vector3 with x (signValue * ((webThickness * 0.5) + 0.05)), y 0.0 and z (plateThickness * 0.5)
                append plate to (resultParts's values)
                set bolts's key to plate's key + 1
                set bolts's axis to inward
                set bolts's columns to 1
                set bolts's columnPitch to 0.06
                set bolts's rowPitch to plateHeight * 0.5
                set bolts's origin to a cad vector3 with x (signValue * ((webThickness * 0.5) + 0.06)), y 0.0 and z -0.03
                append bolts to (resultParts's values)
            set bolts's key to 7
            set bolts's axis to across
            set bolts's origin to a cad vector3 with x (0.0 - (webThickness * 0.5) - 0.024), y 0.0 and z 0.06
            set bolts's columns to 1
            set bolts's rowPitch to plateHeight * 0.5
            append bolts to (resultParts's values)
        if styleCode = 6:
            # Paired flange cover plates spanning the gap; a web cover each side.
            loop sideIndex from 0 to 2:
                set signValue to -1.0 + (2.0 * (sideIndex as a 64 bit floating-point number))
                set plate's key to 1 + (sideIndex * 4)
                set plate's axis to upward
                set plate's width to sectionWidth
                set plate's height to 0.48
                set plate's origin to a cad vector3 with x 0.0, y (signValue * ((sectionDepth + plateThickness) * 0.5)) and z 0.0
                append plate to (resultParts's values)
                set bolts's key to plate's key + 1
                set bolts's axis to upward
                set bolts's origin to a cad vector3 with x 0.0, y (signValue * ((sectionDepth + plateThickness) * 0.5) - 0.04) and z 0.0
                set bolts's rowPitch to 0.28
                set bolts's columnPitch to sectionWidth * 0.5
                append bolts to (resultParts's values)
                set plate's key to plate's key + 2
                set plate's axis to across
                set plate's width to plateHeight
                set plate's height to 0.48
                set plate's origin to a cad vector3 with x (signValue * ((webThickness + plateThickness) * 0.5)), y 0.0 and z 0.0
                append plate to (resultParts's values)
                set bolts's key to plate's key + 1
                set bolts's axis to across
                set bolts's origin to a cad vector3 with x (signValue * ((webThickness + plateThickness) * 0.5) - 0.04), y 0.0 and z 0.0
                set bolts's rowPitch to 0.28
                set bolts's columnPitch to plateHeight * 0.5
                append bolts to (resultParts's values)
        return resultParts
