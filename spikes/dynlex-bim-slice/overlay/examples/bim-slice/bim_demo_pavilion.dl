# SPDX-License-Identifier: MPL-2.0
# The demonstration model: a small concrete pavilion of 12 m by 8 m, built
# the same way every time from the modeller's own elements, in model metres.
#
# Grids 1/2/3 at x = 0, 6 and 12 and A/B/C at y = 0, 4 and 8. On the ground
# floor ("00 Begane grond", at 0.0): a pad footing under every grid crossing
# (1.6 x 1.6 x 0.5, top at -0.25), a floor plate of 0.25, nine columns of
# 400 x 400 from 0 to 3, a grid of twelve beams of 300 x 500 with their tops
# at z = 3, and concrete walls of 200, 2.5 high: the north one with two
# windows, the west one with a door, the east one closed. On "01 Dak" (at
# 3.0): a roof plate of 0.25 on the beams. Component types of its own (a
# concrete bench, a planter and a bike rack) placed several times, and
# parametric reinforcement: cages in the columns and beams (shared cage types
# K-KOL and K-BALK), both faces of every footing, a mesh in the floor and
# both faces of the east wall. The bars are illustrative; nothing is claimed
# about a design code.
#
# Every id is below `bim demo pavilion reserved id`, and the model's next id
# is set to it, so that views and sheets added afterwards (the drawings
# module) number from there.
#
# The module needs no editor (bim_demo_pavilion_editor.dl loads the model
# into one), so that a headless test stays light.
import examples/bim-slice/bim_reinforcement.dl

function bim demo pavilion reserved id:
    replacement:
        10000

# The model and the ids of what it holds: the first id and the number of
# each kind (the elements of a kind have consecutive ids in the order they
# are listed here).
class:
    patterns:
        [a|] bim demo pavilion record
    members:
        modelValue as a bim model record
        groundLevelId as a 64 bit integer
        roofLevelId as a 64 bit integer
        firstGridId as a 64 bit integer
        gridCount as an integer
        firstFootingId as a 64 bit integer
        footingCount as an integer
        floorSlabId as a 64 bit integer
        roofSlabId as a 64 bit integer
        firstColumnId as a 64 bit integer
        columnCount as an integer
        firstBeamId as a 64 bit integer
        beamCount as an integer
        northWallId as a 64 bit integer
        westWallId as a 64 bit integer
        eastWallId as a 64 bit integer
        firstComponentId as a 64 bit integer
        componentCount as an integer
        firstInstanceId as a 64 bit integer
        instanceCount as an integer
        firstReinforcementId as a 64 bit integer
        reinforcementCount as an integer

function the pavilion corner {a 64 bit floating-point number:px} {a 64 bit floating-point number:py}:
    execute:
        return a cad vector2 with x px and y py

# The rectangle from (`ax`, `ay`) to (`bx`, `by`), counter-clockwise from
# its first corner (a plain list, freed by the caller).
function the pavilion rectangle from {a 64 bit floating-point number:ax} {a 64 bit floating-point number:ay} to {a 64 bit floating-point number:bx} {a 64 bit floating-point number:by}:
    execute:
        set corners to an empty list of a cad vector2
        append (the pavilion corner ax ay) to corners
        append (the pavilion corner bx ay) to corners
        append (the pavilion corner bx by) to corners
        append (the pavilion corner ax by) to corners
        return corners

# Grid line `index` (0, 1, 2) of the y direction: A, B, C.
function the pavilion grid letter {integer:index}:
    execute:
        if index = 0:
            return the string form of "A"
        if index = 1:
            return the string form of "B"
        return the string form of "C"

# A reinforcement definition of `kindCode` with the common parameters: bars
# of `mainDiameter` with `crossDiameter` across them, `gap` apart, `cover`
# to the outer steel, B500B, no zones or additions; its placement follows
# its host when it has one.
function the pavilion reinforcement of kind {integer:kindCode} marked {a string:label} on {a 64 bit integer:levelId} hosted by {a 64 bit integer:hostId} from {cad vector3:fromSpot} to {cad vector3:toSpot} wide {a 64 bit floating-point number:breadth} deep {a 64 bit floating-point number:thick} bars {a 64 bit floating-point number:mainDiameter} and {a 64 bit floating-point number:crossDiameter} at {a 64 bit floating-point number:gap} cover {a 64 bit floating-point number:coverValue}:
    execute:
        return @intrinsic("construct", a reinforcement definition, the bim refused id, levelId, hostId, kindCode, label, fromSpot, toSpot, breadth, thick, mainDiameter, crossDiameter, gap, gap, coverValue, 0.024, 2, 2, mainDiameter, mainDiameter, the string form of "-", 0.0, gap, 0.0, gap, 0, 0.012, 0, 0.016, 0.3, 1.0, 0, 1, mainDiameter, crossDiameter, gap, gap, 0.0, the string form of "Custom", the string form of "B500B", the string form of "B500B")

# A box solid from (`ax`, `ay`, `az`), `dx` by `dy` by `dz`, added to (or,
# with `operationCode` subtract, cut from) component `componentId`.
function add pavilion box to component {a 64 bit integer:componentId} from {a 64 bit floating-point number:ax} {a 64 bit floating-point number:ay} {a 64 bit floating-point number:az} measuring {a 64 bit floating-point number:dx} {a 64 bit floating-point number:dy} {a 64 bit floating-point number:dz} of {a string:materialName} as {integer:operationCode} in {a pointer to a bim model record:target}:
    execute:
        set noProfile to an empty list of a cad vector2
        ignore (add bim solid of kind bim box solid as operationCode at (a cad vector3 with x ax, y ay and z az) sized (a cad vector3 with x dx, y dy and z dz) turned 0.0 along noProfile of materialName to component componentId in target)
        free noProfile

# The pavilion, with the ids of what it holds.
function the bim demo pavilion:
    execute:
        set modelValue to an empty bim model
        set target to the address of modelValue
        set groundLevelId to add bim level named (the string form of "00 Begane grond") at 0.0 with height 3.0 to target
        set roofLevelId to add bim level named (the string form of "01 Dak") at 3.0 with height 0.5 to target

        # Types, each used by several elements.
        set layerValues to an empty list of a bim layer record
        append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to layerValues
        set concreteWall to add bim wall type named (the string form of "Wand beton 200") with layerValues to target
        clear layerValues
        append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.25)) to layerValues
        set floorType to add bim planar type named (the string form of "Vloer beton 250") as role bim floor planar role with layerValues to target
        clear layerValues
        append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.5)) to layerValues
        set footingType to add bim planar type named (the string form of "Poer beton 500") as role bim floor planar role with layerValues to target
        clear layerValues
        append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.25)) to layerValues
        set roofType to add bim planar type named (the string form of "Dakvloer beton 250") as role bim roof planar role with layerValues to target
        free layerValues
        set windowType to add bim opening type named (the string form of "Raam 2400x1500") sized 2.4 by 1.5 with sill 0.9 and frame 0.06 to target
        set doorType to add bim door type named (the string form of "Deur 1000x2300") sized 1.0 by 2.3 with frame 0.07 to target
        set columnType to add bim linear type named (the string form of "Kolom beton 400x400") as role bim column role sized 0.4 by 0.4 round false of (the string form of "concrete") to target
        set beamType to add bim linear type named (the string form of "Balk beton 300x500") as role bim beam role sized 0.3 by 0.5 round false of (the string form of "concrete") to target

        # Grids, reaching from below the footings to above the roof.
        set firstGridId to the bim refused id
        set gridCount to 0
        loop gridCursor from 0 to 3:
            set gridX to 6.0 * (gridCursor as a 64 bit floating-point number)
            set madeGrid to add bim grid named (the string form of (gridCursor + 1)) from (the pavilion corner gridX -2.0) to (the pavilion corner gridX 10.0) reaching -1.0 to 4.0 to target
            if firstGridId = the bim refused id:
                set firstGridId to madeGrid
            set gridCount to gridCount + 1
        loop gridCursor from 0 to 3:
            set gridY to 4.0 * (gridCursor as a 64 bit floating-point number)
            ignore (add bim grid named (the pavilion grid letter gridCursor) from (the pavilion corner -2.0 gridY) to (the pavilion corner 14.0 gridY) reaching -1.0 to 4.0 to target)
            set gridCount to gridCount + 1

        # Pad footings under the grid crossings, then the floor and the roof.
        set firstFootingId to the bim refused id
        set footingCount to 0
        loop rowCursor from 0 to 3:
            loop columnCursor from 0 to 3:
                set padX to 6.0 * (columnCursor as a 64 bit floating-point number)
                set padY to 4.0 * (rowCursor as a 64 bit floating-point number)
                set outline to the pavilion rectangle from (padX - 0.8) (padY - 0.8) to (padX + 0.8) (padY + 0.8)
                set madePad to add bim plate typed footingType on groundLevelId around outline at top -0.25 to target
                free outline
                if firstFootingId = the bim refused id:
                    set firstFootingId to madePad
                set footingCount to footingCount + 1
        set outline to the pavilion rectangle from -0.2 -0.2 to 12.2 8.2
        set floorSlabId to add bim plate typed floorType on groundLevelId around outline at top 0.0 to target
        set roofSlabId to add bim plate typed roofType on roofLevelId around outline at top 0.25 to target
        free outline

        # Columns on the grid crossings, and the beams between them with
        # their tops at z = 3: along A, B and C, then along 1, 2 and 3.
        set firstColumnId to the bim refused id
        set columnCount to 0
        loop rowCursor from 0 to 3:
            loop columnCursor from 0 to 3:
                set postX to 6.0 * (columnCursor as a 64 bit floating-point number)
                set postY to 4.0 * (rowCursor as a 64 bit floating-point number)
                set madeColumn to add bim linear typed columnType on groundLevelId from (a cad vector3 with x postX, y postY and z 0.0) to (a cad vector3 with x postX, y postY and z 3.0) turned 0.0 to target
                if firstColumnId = the bim refused id:
                    set firstColumnId to madeColumn
                set columnCount to columnCount + 1
        set firstBeamId to the bim refused id
        set beamCount to 0
        loop rowCursor from 0 to 3:
            loop columnCursor from 0 to 2:
                set beamY to 4.0 * (rowCursor as a 64 bit floating-point number)
                set beamX to 6.0 * (columnCursor as a 64 bit floating-point number)
                set madeBeam to add bim linear typed beamType on groundLevelId from (a cad vector3 with x beamX, y beamY and z 2.75) to (a cad vector3 with x (beamX + 6.0), y beamY and z 2.75) turned 0.0 to target
                if firstBeamId = the bim refused id:
                    set firstBeamId to madeBeam
                set beamCount to beamCount + 1
        loop columnCursor from 0 to 3:
            loop rowCursor from 0 to 2:
                set beamX to 6.0 * (columnCursor as a 64 bit floating-point number)
                set beamY to 4.0 * (rowCursor as a 64 bit floating-point number)
                ignore (add bim linear typed beamType on groundLevelId from (a cad vector3 with x beamX, y beamY and z 2.75) to (a cad vector3 with x beamX, y (beamY + 4.0) and z 2.75) turned 0.0 to target)
                set beamCount to beamCount + 1

        # Walls under the beams: north with two windows, west with a door,
        # east closed.
        set northWallId to add bim wall typed concreteWall on groundLevelId from (the pavilion corner 0.0 8.0) to (the pavilion corner 12.0 8.0) to target
        set westWallId to add bim wall typed concreteWall on groundLevelId from (the pavilion corner 0.0 0.0) to (the pavilion corner 0.0 8.0) to target
        set eastWallId to add bim wall typed concreteWall on groundLevelId from (the pavilion corner 12.0 0.0) to (the pavilion corner 12.0 4.0) to target
        ignore (set bim wall northWallId height to 2.5 in target)
        ignore (set bim wall westWallId height to 2.5 in target)
        ignore (set bim wall eastWallId height to 2.5 in target)
        ignore (add bim opening typed windowType in northWallId at 3.0 to target)
        ignore (add bim opening typed windowType in northWallId at 9.0 to target)
        ignore (add bim opening typed doorType in westWallId at 2.0 to target)

        # Component types of its own.
        set benchId to add bim component named (the string form of "Zitbank beton 2000") to target
        add pavilion box to component benchId from -1.0 -0.2 0.0 measuring 0.4 0.4 0.42 of (the string form of "concrete") as (bim add operation) in target
        add pavilion box to component benchId from 0.6 -0.2 0.0 measuring 0.4 0.4 0.42 of (the string form of "concrete") as (bim add operation) in target
        add pavilion box to component benchId from -1.0 -0.225 0.42 measuring 2.0 0.45 0.05 of (the string form of "timber") as (bim add operation) in target
        set planterId to add bim component named (the string form of "Plantenbak beton 1000") to target
        add pavilion box to component planterId from -0.5 -0.5 0.0 measuring 1.0 1.0 0.6 of (the string form of "concrete") as (bim add operation) in target
        add pavilion box to component planterId from -0.42 -0.42 0.1 measuring 0.84 0.84 0.6 of (the string form of "concrete") as (bim subtract operation) in target
        set rackId to add bim component named (the string form of "Fietsenrek staal 5 plaatsen") to target
        add pavilion box to component rackId from -1.0 -0.05 0.0 measuring 2.0 0.1 0.05 of (the string form of "steel") as (bim add operation) in target
        loop hoopCursor from 0 to 5:
            set hoopX to -0.81 + (0.4 * (hoopCursor as a 64 bit floating-point number))
            add pavilion box to component rackId from hoopX -0.3 0.05 measuring 0.02 0.6 0.75 of (the string form of "steel") as (bim add operation) in target

        # The components placed: two benches under the roof, a planter at
        # each corner, the bike rack by the east side.
        set firstInstanceId to place bim component benchId on groundLevelId at (the pavilion corner 3.0 1.5) turned 0.0 to target
        ignore (place bim component benchId on groundLevelId at (the pavilion corner 9.0 1.5) turned 0.0 to target)
        ignore (place bim component planterId on groundLevelId at (the pavilion corner -1.5 -1.5) turned 0.0 to target)
        ignore (place bim component planterId on groundLevelId at (the pavilion corner 13.5 -1.5) turned 0.0 to target)
        ignore (place bim component planterId on groundLevelId at (the pavilion corner 13.5 9.5) turned 0.0 to target)
        ignore (place bim component planterId on groundLevelId at (the pavilion corner -1.5 9.5) turned 0.0 to target)
        ignore (place bim component rackId on groundLevelId at (the pavilion corner 14.0 6.0) turned 1.5707963267948966 to target)

        # Reinforcement: cages in the columns and beams, footings on both
        # faces, a mesh in the floor, the east wall on both faces.
        set firstReinforcementId to the bim refused id
        set reinforcementCount to 0
        loop columnCursor from 0 to columnCount:
            set hostId to firstColumnId + (columnCursor as a 64 bit integer)
            set hostFound to the bim linear index of hostId in modelValue
            set hostValue to the item at hostFound's position in (modelValue's linears's values)
            set label to ((the string form of "K-") + (the pavilion grid letter (columnCursor / 3))) + (the string form of ((the remainder of columnCursor divided by 3) + 1))
            set spec to the pavilion reinforcement of kind 1 marked label on groundLevelId hosted by hostId from hostValue's start to hostValue's finish wide 0.4 deep 0.4 bars 0.016 and 0.008 at 0.15 cover 0.035
            set spec's cageType to the string form of "K-KOL"
            set spec's startZoneLength to 0.5
            set spec's startZoneSpacing to 0.1
            set spec's endZoneLength to 0.5
            set spec's endZoneSpacing to 0.1
            set madeBars to store bim reinforcement spec in target
            if madeBars != the bim refused id:
                if firstReinforcementId = the bim refused id:
                    set firstReinforcementId to madeBars
                set reinforcementCount to reinforcementCount + 1
        loop beamCursor from 0 to beamCount:
            set hostId to firstBeamId + (beamCursor as a 64 bit integer)
            set hostFound to the bim linear index of hostId in modelValue
            set hostValue to the item at hostFound's position in (modelValue's linears's values)
            set label to (the string form of "B-") + (the string form of (beamCursor + 1))
            set spec to the pavilion reinforcement of kind 1 marked label on groundLevelId hosted by hostId from hostValue's start to hostValue's finish wide 0.3 deep 0.5 bars 0.016 and 0.008 at 0.15 cover 0.035
            set spec's cageType to the string form of "K-BALK"
            set spec's topDiameter to 0.012
            set spec's bottomCount to 3
            set spec's startZoneLength to 0.6
            set spec's startZoneSpacing to 0.1
            set spec's endZoneLength to 0.6
            set spec's endZoneSpacing to 0.1
            set madeBars to store bim reinforcement spec in target
            if madeBars != the bim refused id:
                set reinforcementCount to reinforcementCount + 1
        loop padCursor from 0 to footingCount:
            set hostId to firstFootingId + (padCursor as a 64 bit integer)
            set padX to 6.0 * ((the remainder of padCursor divided by 3) as a 64 bit floating-point number)
            set padY to 4.0 * ((padCursor / 3) as a 64 bit floating-point number)
            set label to ((the string form of "P-") + (the pavilion grid letter (padCursor / 3))) + (the string form of ((the remainder of padCursor divided by 3) + 1))
            set spec to the pavilion reinforcement of kind 5 marked label on groundLevelId hosted by hostId from (a cad vector3 with x (padX - 0.8), y (padY - 0.8) and z -0.75) to (a cad vector3 with x (padX + 0.8), y (padY - 0.8) and z -0.75) wide 1.6 deep 0.5 bars 0.012 and 0.012 at 0.15 cover 0.05
            set spec's faceMask to 3
            set madeBars to store bim reinforcement spec in target
            if madeBars != the bim refused id:
                set reinforcementCount to reinforcementCount + 1
        set spec to the pavilion reinforcement of kind 2 marked (the string form of "VL-NET") on groundLevelId hosted by floorSlabId from (a cad vector3 with x -0.2, y -0.2 and z -0.25) to (a cad vector3 with x 12.2, y -0.2 and z -0.25) wide 8.4 deep 0.25 bars 0.008 and 0.008 at 0.15 cover 0.035
        set spec's faceMask to 3
        set spec's meshType to the string form of "Generic_150"
        set madeBars to store bim reinforcement spec in target
        if madeBars != the bim refused id:
            set reinforcementCount to reinforcementCount + 1
        set spec to the pavilion reinforcement of kind 5 marked (the string form of "W-OOST") on groundLevelId hosted by eastWallId from (a cad vector3 with x 12.0, y 0.0 and z 0.0) to (a cad vector3 with x 12.0, y 4.0 and z 0.0) wide 2.5 deep 0.2 bars 0.01 and 0.01 at 0.15 cover 0.03
        set spec's faceMask to 3
        set madeBars to store bim reinforcement spec in target
        if madeBars != the bim refused id:
            set reinforcementCount to reinforcementCount + 1

        set reservedFrom to (bim demo pavilion reserved id) as a 64 bit integer
        if modelValue's nextId < reservedFrom:
            set modelValue's nextId to reservedFrom
        return @intrinsic("construct", a bim demo pavilion record, modelValue, groundLevelId, roofLevelId, firstGridId, gridCount, firstFootingId, footingCount, floorSlabId, roofSlabId, firstColumnId, columnCount, firstBeamId, beamCount, northWallId, westWallId, eastWallId, benchId, 3, firstInstanceId, 7, firstReinforcementId, reinforcementCount)
