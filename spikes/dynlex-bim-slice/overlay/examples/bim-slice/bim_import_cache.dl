# SPDX-License-Identifier: MPL-2.0
# Import metadata changes with the document, never with pointer motion.
import examples/bim-slice/bim_ifc_psets.dl

class:
    patterns:
        [a|] bim import metadata cache record
    members:
        revision as a 64 bit integer
        linkedPath as a string
        promotedCount as an integer

function a new bim import metadata cache:
    execute:
        return @intrinsic("construct", a bim import metadata cache record, (-1) as a 64 bit integer, the string form of "", 0)

# Document revisions increase on open, new, commit, undo and redo. This cache
# belongs to one document lifecycle; it is not shared between editors.
function refresh bim import metadata of {bim document record:documentValue} in {a pointer to a bim import metadata cache record:cache}:
    execute:
        if cache's revision = documentValue's revision:
            return false
        set cache's linkedPath to the bim linked ifc of documentValue's current
        set cache's promotedCount to the bim promoted count of documentValue's current
        set cache's revision to documentValue's revision
        return true
