# SPDX-License-Identifier: MPL-2.0
# Categories and view rules. Every element belongs to a category: the model's
# own walls, floors, doors, windows, spaces, grids and dimensions, and the
# categories imported elements arrive in. Every view (the plan, the section
# and the 3D view) draws each category by its rule: visible or hidden, and
# halftone. A view starts from its kind's template and keeps its own
# overrides, as Revit's visibility and graphics do.
import examples/bim-slice/bim_model.dl

function bim wall category:
    replacement:
        0
function bim slab category:
    replacement:
        1
function bim door category:
    replacement:
        2
function bim window category:
    replacement:
        3
function bim space category:
    replacement:
        4
function bim grid category:
    replacement:
        5
function bim dimension category:
    replacement:
        6
# Categories of imported elements; the codes are those of
# `import/ifc_to_mesh.py`.
function bim column category:
    replacement:
        7
function bim beam category:
    replacement:
        8
function bim roof category:
    replacement:
        9
function bim stair category:
    replacement:
        10
function bim railing category:
    replacement:
        11
function bim furniture category:
    replacement:
        12
function bim other category:
    replacement:
        13
function bim line category:
    replacement:
        14
function bim text category:
    replacement:
        15
function bim mass category:
    replacement:
        16
function the bim category count:
    replacement:
        17

function bim plan view kind:
    replacement:
        0
function bim section view kind:
    replacement:
        1
function bim model view kind:
    replacement:
        2

# The name of a category, as shown in the visibility panel.
function the bim name of category {integer:categoryCode}:
    execute:
        if categoryCode = bim wall category:
            return the string form of "Walls"
        if categoryCode = bim slab category:
            return the string form of "Floors"
        if categoryCode = bim door category:
            return the string form of "Doors"
        if categoryCode = bim window category:
            return the string form of "Windows"
        if categoryCode = bim space category:
            return the string form of "Spaces"
        if categoryCode = bim grid category:
            return the string form of "Grids"
        if categoryCode = bim dimension category:
            return the string form of "Dimensions"
        if categoryCode = bim column category:
            return the string form of "Columns"
        if categoryCode = bim beam category:
            return the string form of "Beams"
        if categoryCode = bim roof category:
            return the string form of "Roofs"
        if categoryCode = bim stair category:
            return the string form of "Stairs"
        if categoryCode = bim railing category:
            return the string form of "Railings"
        if categoryCode = bim furniture category:
            return the string form of "Furniture"
        if categoryCode = bim line category:
            return the string form of "Lines"
        if categoryCode = bim text category:
            return the string form of "Texts"
        if categoryCode = bim mass category:
            return the string form of "Masses"
        return the string form of "Other"

# How one category is drawn in one view.
class:
    patterns:
        [a|] bim category rule record
    members:
        visible as a boolean
        halftone as a boolean

# The rules of one view, one per category, indexed by category.
class:
    patterns:
        [a|] bim view rules record
    members:
        kind as an integer
        rules as the type of (a cad topology list of a bim category rule record)

# The template of a view kind: plans show everything; sections leave out
# spaces; the 3D view shows the model and grids, without spaces and
# dimensions.
function the bim template rules of view kind {integer:viewKind}:
    execute:
        set entries to a cad topology list of a bim category rule record
        loop code from 0 to the bim category count:
            set shown to true
            if (viewKind = bim section view kind) and (code = bim space category):
                set shown to false
            if (viewKind = bim model view kind) and ((code = bim space category) or (code = bim dimension category)):
                set shown to false
            append (@intrinsic("construct", a bim category rule record, shown, false)) to (entries's values)
        return @intrinsic("construct", a bim view rules record, viewKind, entries)

function bim category {integer:categoryCode} is visible in {bim view rules record:viewRules}:
    execute:
        return (the item at categoryCode in (viewRules's rules's values))'s visible

function bim category {integer:categoryCode} is halftone in {bim view rules record:viewRules}:
    execute:
        return (the item at categoryCode in (viewRules's rules's values))'s halftone

# Shows or hides `categoryCode` in the view `target`.
function toggle bim category {integer:categoryCode} visibility in {a pointer to a bim view rules record:target}:
    execute:
        set rule to the item at categoryCode in (target's rules's values)
        replace item at index categoryCode in (target's rules's values) with (@intrinsic("construct", a bim category rule record, rule's visible = false, rule's halftone))

# Draws `categoryCode` in halftone in the view `target`, or no longer.
function toggle bim category {integer:categoryCode} halftone in {a pointer to a bim view rules record:target}:
    execute:
        set rule to the item at categoryCode in (target's rules's values)
        replace item at index categoryCode in (target's rules's values) with (@intrinsic("construct", a bim category rule record, rule's visible, rule's halftone = false))

# The category of the element with `elementId` in `modelValue`; -1 when it
# is not an element of a known category.
function the bim category of element {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        if (the bim wall index of elementId in modelValue)'s valid:
            return bim wall category
        if (the bim slab index of elementId in modelValue)'s valid:
            return bim slab category
        set found to the bim opening index of elementId in modelValue
        if found's valid:
            set openingValue to the item at found's position in (modelValue's openings's values)
            set typeFound to the bim opening type index of openingValue's typeId in modelValue
            if typeFound's valid and (the item at typeFound's position in (modelValue's openingTypes's values))'s isDoor:
                return bim door category
            return bim window category
        if (the bim dimension index of elementId in modelValue)'s valid:
            return bim dimension category
        set sketchFound to the bim sketch index of elementId in modelValue
        if sketchFound's valid:
            set sketch to the item at sketchFound's position in (modelValue's sketches's values)
            if sketch's kind = bim line sketch:
                return bim line category
            if sketch's kind = bim text sketch:
                return bim text category
            return bim mass category
        if (the bim instance index of elementId in modelValue)'s valid:
            return bim mass category
        return -1

# A colour drawn in halftone: halfway to white.
function the bim halftone of channel {integer:channel} when {boolean:halftone}:
    execute:
        if halftone:
            return (channel + 255) / 2
        return channel

# The 3D colour of category `categoryCode`, red, green and blue in 0..255.
function the bim colour of category {integer:categoryCode}:
    execute:
        if categoryCode = bim slab category:
            return a cad vector3 with x 175.0, y 168.0 and z 155.0
        if categoryCode = bim door category:
            return a cad vector3 with x 170.0, y 135.0 and z 100.0
        if categoryCode = bim window category:
            return a cad vector3 with x 150.0, y 190.0 and z 215.0
        if categoryCode = bim column category:
            return a cad vector3 with x 165.0, y 165.0 and z 170.0
        if categoryCode = bim beam category:
            return a cad vector3 with x 160.0, y 150.0 and z 140.0
        if categoryCode = bim roof category:
            return a cad vector3 with x 185.0, y 120.0 and z 105.0
        if categoryCode = bim stair category:
            return a cad vector3 with x 175.0, y 160.0 and z 130.0
        if categoryCode = bim railing category:
            return a cad vector3 with x 120.0, y 125.0 and z 135.0
        if categoryCode = bim furniture category:
            return a cad vector3 with x 140.0, y 170.0 and z 130.0
        if categoryCode = bim space category:
            return a cad vector3 with x 190.0, y 215.0 and z 245.0
        if categoryCode = bim other category:
            return a cad vector3 with x 170.0, y 170.0 and z 165.0
        if categoryCode = bim mass category:
            return a cad vector3 with x 205.0, y 208.0 and z 214.0
        return a cad vector3 with x 150.0, y 160.0 and z 175.0

# The 3D colour of a wall layer's material, red, green and blue in 0..255:
# the fill colours of its hatch pattern in the plan.
function the bim material colour of {a string:name}:
    execute:
        set lowered to the lowercase form of name
        if lowered contains "brick":
            return a cad vector3 with x 205.0, y 140.0 and z 115.0
        if lowered contains "insulation":
            return a cad vector3 with x 240.0, y 225.0 and z 150.0
        if lowered contains "concrete":
            return a cad vector3 with x 185.0, y 185.0 and z 185.0
        if lowered contains "sand-lime":
            return a cad vector3 with x 225.0, y 220.0 and z 205.0
        return a cad vector3 with x 175.0, y 182.0 and z 195.0
