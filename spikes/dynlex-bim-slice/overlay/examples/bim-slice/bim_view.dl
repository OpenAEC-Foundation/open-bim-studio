# SPDX-License-Identifier: MPL-2.0
# Categories and view rules. Every element belongs to a category: the model's
# own walls, floors, doors, windows, spaces, grids and dimensions, and the
# categories imported elements arrive in. Every view (the plan, the section
# and the 3D view) draws each category by its rule: visible or hidden, and
# halftone. A view starts from its kind's template and keeps its own
# overrides, as Revit's visibility and graphics do.
import examples/bim-slice/bim_model.dl

function bim wall category:
    replacement:
        0
function bim slab category:
    replacement:
        1
function bim door category:
    replacement:
        2
function bim window category:
    replacement:
        3
function bim space category:
    replacement:
        4
function bim grid category:
    replacement:
        5
function bim dimension category:
    replacement:
        6
# Categories of imported elements; the codes are those of
# `import/ifc_to_mesh.py`.
function bim column category:
    replacement:
        7
function bim beam category:
    replacement:
        8
function bim roof category:
    replacement:
        9
function bim stair category:
    replacement:
        10
function bim railing category:
    replacement:
        11
function bim furniture category:
    replacement:
        12
function bim other category:
    replacement:
        13
function bim line category:
    replacement:
        14
function bim text category:
    replacement:
        15
function bim mass category:
    replacement:
        16
# Ceilings: plates of the ceiling role.
function bim ceiling category:
    replacement:
        17
# Foundation piles: linear elements of the pile role.
function bim pile category:
    replacement:
        18
function the bim category count:
    replacement:
        19

function bim plan view kind:
    replacement:
        0
function bim section view kind:
    replacement:
        1
function bim model view kind:
    replacement:
        2

# The name of a category, as shown in the visibility panel.
function the bim name of category {integer:categoryCode}:
    execute:
        if categoryCode = bim wall category:
            return the string form of "Walls"
        if categoryCode = bim slab category:
            return the string form of "Floors"
        if categoryCode = bim door category:
            return the string form of "Doors"
        if categoryCode = bim window category:
            return the string form of "Windows"
        if categoryCode = bim space category:
            return the string form of "Spaces"
        if categoryCode = bim grid category:
            return the string form of "Grids"
        if categoryCode = bim dimension category:
            return the string form of "Dimensions"
        if categoryCode = bim column category:
            return the string form of "Columns"
        if categoryCode = bim beam category:
            return the string form of "Beams"
        if categoryCode = bim roof category:
            return the string form of "Roofs"
        if categoryCode = bim stair category:
            return the string form of "Stairs"
        if categoryCode = bim railing category:
            return the string form of "Railings"
        if categoryCode = bim furniture category:
            return the string form of "Furniture"
        if categoryCode = bim line category:
            return the string form of "Lines"
        if categoryCode = bim text category:
            return the string form of "Texts"
        if categoryCode = bim mass category:
            return the string form of "Masses"
        if categoryCode = bim ceiling category:
            return the string form of "Ceilings"
        if categoryCode = bim pile category:
            return the string form of "Piles"
        return the string form of "Other"

# How one category is drawn in one view.
class:
    patterns:
        [a|] bim category rule record
    members:
        visible as a boolean
        halftone as a boolean

# The rules of one view, one per category, indexed by category.
class:
    patterns:
        [a|] bim view rules record
    members:
        kind as an integer
        rules as the type of (a cad topology list of a bim category rule record)

# The template of a view kind: plans show everything; sections leave out
# spaces; the 3D view shows the model and grids, without spaces and
# dimensions.
function the bim template rules of view kind {integer:viewKind}:
    execute:
        set entries to a cad topology list of a bim category rule record
        loop code from 0 to the bim category count:
            set shown to true
            if (viewKind = bim section view kind) and (code = bim space category):
                set shown to false
            if (viewKind = bim model view kind) and ((code = bim space category) or (code = bim dimension category)):
                set shown to false
            # A floor plan looks down; ceilings belong to a reflected one.
            # Piles lie under the storey: the pile plan shows them.
            if (viewKind = bim plan view kind) and ((code = bim ceiling category) or (code = bim pile category)):
                set shown to false
            append (@intrinsic("construct", a bim category rule record, shown, false)) to (entries's values)
        return @intrinsic("construct", a bim view rules record, viewKind, entries)

# The template kind (`bim plan view kind` …) a view record's rules follow.
function the bim rules kind of view kind {integer:viewKind}:
    execute:
        if viewKind = bim section view:
            return bim section view kind
        if viewKind = bim model view:
            return bim model view kind
        return bim plan view kind

# The rules of view `viewValue`.
function the bim rules of view {bim view definition record:viewValue}:
    execute:
        set entries to a cad topology list of a bim category rule record
        loop code from 0 to the bim category count:
            set shownHere to true
            set faintHere to false
            if code < (the length of (viewValue's shown's values)):
                set shownHere to the item at code in (viewValue's shown's values)
            if code < (the length of (viewValue's faint's values)):
                set faintHere to the item at code in (viewValue's faint's values)
            append (@intrinsic("construct", a bim category rule record, shownHere, faintHere)) to (entries's values)
        return @intrinsic("construct", a bim view rules record, the bim rules kind of view kind viewValue's kind, entries)

# `viewValue` with `viewRules` as its rules.
function the bim view {bim view definition record:viewValue} ruled by {bim view rules record:viewRules}:
    execute:
        set shownFlags to a cad topology list of a boolean
        set faintFlags to a cad topology list of a boolean
        loop code from 0 to the bim category count:
            append (bim category code is visible in viewRules) to (shownFlags's values)
            append (bim category code is halftone in viewRules) to (faintFlags's values)
        return @intrinsic("construct", a bim view definition record, viewValue's id, viewValue's kind, viewValue's name, viewValue's levelId, viewValue's detail, viewValue's cutHeight, viewValue's scale, viewValue's cropped, viewValue's cropLow, viewValue's cropHigh, shownFlags, faintFlags, viewValue's lineStart, viewValue's lineFinish, viewValue's drawingTypeId, viewValue's automatic, viewValue's phaseId)

# A new view of `viewKind` named `title` (on storey `levelId` for a plan),
# with its kind's template rules, cut at 1.2 m, at 1:100, not cropped.
function add bim view of kind {integer:viewKind} named {a string:title} on {a 64 bit integer:levelId} to {a pointer to a bim model record:target}:
    execute:
        set fresh to the bim new id in target
        set zero to a cad vector2 with x 0.0 and y 0.0
        set blank to @intrinsic("construct", a bim view definition record, fresh, viewKind, title, levelId, 0 as a 64 bit integer, 1.2, 100, false, zero, zero, a cad topology list of a boolean, a cad topology list of a boolean, zero, zero, the bim refused id, false, the bim refused id)
        set templated to the bim view blank ruled by (the bim template rules of view kind (the bim rules kind of view kind viewKind))
        store bim view templated in target
        return fresh

# A new section view along the line from `first` to `second`, named
# "Section n"; its id.
function add bim section view from {cad vector2:first} to {cad vector2:second} to {a pointer to a bim model record:target}:
    execute:
        set count to 1
        loop cursor from 0 to the length of (target's views's values):
            if (the item at cursor in (target's views's values))'s kind = bim section view:
                set count to count + 1
        set fresh to add bim view of kind bim section view named ((the string form of "Section ") + (the string form of count)) on (the bim refused id) to target
        set found to the bim view index of fresh in (@intrinsic("dereference", target))
        set made to the item at found's position in (target's views's values)
        set made's lineStart to first
        set made's lineFinish to second
        set made's detail to count as a 64 bit integer
        store bim view made in target
        return fresh

# Every storey gets a plan named after it and the model one 3D view, when it
# has none; the ids of the views made.
function ensure bim default views in {a pointer to a bim model record:target}:
    execute:
        set made to an empty list of a 64 bit integer
        loop cursor from 0 to the length of (target's levels's values):
            set levelValue to the item at cursor in (target's levels's values)
            set hasPlan to false
            loop viewCursor from 0 to the length of (target's views's values):
                set viewValue to the item at viewCursor in (target's views's values)
                if (viewValue's kind = bim plan view) and (viewValue's levelId = levelValue's id):
                    set hasPlan to true
            if hasPlan = false:
                append (add bim view of kind bim plan view named levelValue's name on levelValue's id to target) to made
        set hasModel to false
        loop viewCursor from 0 to the length of (target's views's values):
            if (the item at viewCursor in (target's views's values))'s kind = bim model view:
                set hasModel to true
        if hasModel = false:
            append (add bim view of kind bim model view named (the string form of "3D") on (the bim refused id) to target) to made
        return made

function bim category {integer:categoryCode} is visible in {bim view rules record:viewRules}:
    execute:
        return (the item at categoryCode in (viewRules's rules's values))'s visible

function bim category {integer:categoryCode} is halftone in {bim view rules record:viewRules}:
    execute:
        return (the item at categoryCode in (viewRules's rules's values))'s halftone

# Shows or hides `categoryCode` in the view `target`.
function toggle bim category {integer:categoryCode} visibility in {a pointer to a bim view rules record:target}:
    execute:
        set rule to the item at categoryCode in (target's rules's values)
        replace item at index categoryCode in (target's rules's values) with (@intrinsic("construct", a bim category rule record, rule's visible = false, rule's halftone))

# Draws `categoryCode` in halftone in the view `target`, or no longer.
function toggle bim category {integer:categoryCode} halftone in {a pointer to a bim view rules record:target}:
    execute:
        set rule to the item at categoryCode in (target's rules's values)
        replace item at index categoryCode in (target's rules's values) with (@intrinsic("construct", a bim category rule record, rule's visible, rule's halftone = false))

# The category of the element with `elementId` in `modelValue`; -1 when it
# is not an element of a known category.
function the bim category of element {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        if (the bim wall index of elementId in modelValue)'s valid:
            return bim wall category
        set plateFound to the bim slab index of elementId in modelValue
        if plateFound's valid:
            set plateRole to the bim role of plate (the item at plateFound's position in (modelValue's slabs's values)) in modelValue
            if plateRole = bim roof planar role:
                return bim roof category
            if plateRole = bim ceiling planar role:
                return bim ceiling category
            return bim slab category
        set found to the bim opening index of elementId in modelValue
        if found's valid:
            set openingValue to the item at found's position in (modelValue's openings's values)
            set typeFound to the bim opening type index of openingValue's typeId in modelValue
            if typeFound's valid and (the item at typeFound's position in (modelValue's openingTypes's values))'s isDoor:
                return bim door category
            return bim window category
        if (the bim dimension index of elementId in modelValue)'s valid:
            return bim dimension category
        set sketchFound to the bim sketch index of elementId in modelValue
        if sketchFound's valid:
            set sketch to the item at sketchFound's position in (modelValue's sketches's values)
            if sketch's kind = bim line sketch:
                return bim line category
            if sketch's kind = bim text sketch:
                return bim text category
            return bim mass category
        if (the bim instance index of elementId in modelValue)'s valid:
            return bim mass category
        return -1

# A colour drawn in halftone: halfway to white.
function the bim halftone of channel {integer:channel} when {boolean:halftone}:
    execute:
        if halftone:
            return (channel + 255) / 2
        return channel

# The 3D colour of category `categoryCode`, red, green and blue in 0..255.
function the bim colour of category {integer:categoryCode}:
    execute:
        if categoryCode = bim slab category:
            return a cad vector3 with x 175.0, y 168.0 and z 155.0
        if categoryCode = bim door category:
            return a cad vector3 with x 170.0, y 135.0 and z 100.0
        if categoryCode = bim window category:
            return a cad vector3 with x 150.0, y 190.0 and z 215.0
        if categoryCode = bim column category:
            return a cad vector3 with x 165.0, y 165.0 and z 170.0
        if categoryCode = bim beam category:
            return a cad vector3 with x 160.0, y 150.0 and z 140.0
        if categoryCode = bim pile category:
            return a cad vector3 with x 150.0, y 150.0 and z 145.0
        if categoryCode = bim roof category:
            return a cad vector3 with x 185.0, y 120.0 and z 105.0
        if categoryCode = bim stair category:
            return a cad vector3 with x 175.0, y 160.0 and z 130.0
        if categoryCode = bim railing category:
            return a cad vector3 with x 120.0, y 125.0 and z 135.0
        if categoryCode = bim furniture category:
            return a cad vector3 with x 140.0, y 170.0 and z 130.0
        if categoryCode = bim space category:
            return a cad vector3 with x 190.0, y 215.0 and z 245.0
        if categoryCode = bim other category:
            return a cad vector3 with x 170.0, y 170.0 and z 165.0
        if categoryCode = bim mass category:
            return a cad vector3 with x 205.0, y 208.0 and z 214.0
        return a cad vector3 with x 150.0, y 160.0 and z 175.0

# The 3D colour of a wall layer's material, red, green and blue in 0..255:
# the fill colours of its hatch pattern in the plan.
function the bim material colour of {a string:name}:
    execute:
        set lowered to the lowercase form of name
        if lowered contains "brick":
            return a cad vector3 with x 205.0, y 140.0 and z 115.0
        if lowered contains "insulation":
            return a cad vector3 with x 240.0, y 225.0 and z 150.0
        if lowered contains "concrete":
            return a cad vector3 with x 185.0, y 185.0 and z 185.0
        if lowered contains "sand-lime":
            return a cad vector3 with x 225.0, y 220.0 and z 205.0
        if lowered contains "timber":
            return a cad vector3 with x 205.0, y 165.0 and z 115.0
        if lowered contains "steel":
            return a cad vector3 with x 95.0, y 100.0 and z 110.0
        if lowered contains "gypsum":
            return a cad vector3 with x 240.0, y 240.0 and z 236.0
        return a cad vector3 with x 175.0, y 182.0 and z 195.0

# ---------------------------------------------------------------- drawing rules

# The annotation rules a drawing type can apply (`annotations` of a
# `bim drawing type record`), drawn on its views automatically.
function bim grid dimensions annotation:
    replacement:
        0
function bim pile numbers annotation:
    replacement:
        1
function bim pile table annotation:
    replacement:
        2
function bim beam labels annotation:
    replacement:
        3
function bim room labels annotation:
    replacement:
        4
function bim opening tags annotation:
    replacement:
        5
function bim level marks annotation:
    replacement:
        6
# NEN 2580 floor areas: BVO, GO, NVO and VVO per storey, with their bounds.
function bim area measures annotation:
    replacement:
        7
function the bim annotation count:
    replacement:
        8

function the bim name of annotation {integer:ruleCode}:
    execute:
        if ruleCode = bim grid dimensions annotation:
            return the string form of "Dimensions to grids"
        if ruleCode = bim pile numbers annotation:
            return the string form of "Pile numbers"
        if ruleCode = bim pile table annotation:
            return the string form of "Pile table"
        if ruleCode = bim beam labels annotation:
            return the string form of "Beam labels"
        if ruleCode = bim room labels annotation:
            return the string form of "Room labels"
        if ruleCode = bim opening tags annotation:
            return the string form of "Door and window tags"
        if ruleCode = bim level marks annotation:
            return the string form of "Level marks"
        if ruleCode = bim area measures annotation:
            return the string form of "Areas (NEN 2580)"
        return the string form of "Annotation"

# The phase filters a drawing type can apply.
function bim show all phases:
    replacement:
        0
function bim show new phase:
    replacement:
        1
function bim show existing phase:
    replacement:
        2
function bim show existing and demolished phases:
    replacement:
        3
function bim show demolition phase:
    replacement:
        4
function the bim phase filter count:
    replacement:
        5

function the bim name of phase filter {integer:filterCode}:
    execute:
        if filterCode = bim show new phase:
            return the string form of "New construction"
        if filterCode = bim show existing phase:
            return the string form of "Existing"
        if filterCode = bim show existing and demolished phases:
            return the string form of "Existing and demolished"
        if filterCode = bim show demolition phase:
            return the string form of "Demolition"
        return the string form of "Show all"

# The setting `which` (0 shown, 1 halftone, 2 annotation, 3 phase filter) at
# `slot` of drawing type `typeId`, resolved through its parents: the first
# that sets it; -1 when none does (a missing type, or every ancestor
# inheriting). A chain longer than 32 is cut off, so a cycle cannot hang.
function the bim resolved setting {integer:which} at {integer:slot} of drawing type {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        set current to typeId
        loop depth from 0 to 32:
            set found to the bim drawing type index of current in modelValue
            if found's valid = false:
                return -1
            set drawingType to the item at found's position in (modelValue's drawingTypes's values)
            set value to -1
            if which = 0:
                if slot < (the length of (drawingType's shown's values)):
                    set value to the item at slot in (drawingType's shown's values)
            if which = 1:
                if slot < (the length of (drawingType's faint's values)):
                    set value to the item at slot in (drawingType's faint's values)
            if which = 2:
                if slot < (the length of (drawingType's annotations's values)):
                    set value to the item at slot in (drawingType's annotations's values)
            if which = 3:
                set value to drawingType's phaseFilter
            if value >= 0:
                return value
            set current to drawingType's parentId
        return -1

# The category rules of drawing type `typeId`: each resolved through its
# parents, falling back to a floor plan's template.
function the bim rules of drawing type {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        set fallback to the bim template rules of view kind bim plan view kind
        set entries to a cad topology list of a bim category rule record
        loop code from 0 to the bim category count:
            set shownHere to bim category code is visible in fallback
            set faintHere to bim category code is halftone in fallback
            set shownSetting to the bim resolved setting 0 at code of drawing type typeId in modelValue
            set faintSetting to the bim resolved setting 1 at code of drawing type typeId in modelValue
            if shownSetting >= 0:
                set shownHere to shownSetting = 1
            if faintSetting >= 0:
                set faintHere to faintSetting = 1
            append (@intrinsic("construct", a bim category rule record, shownHere, faintHere)) to (entries's values)
        return @intrinsic("construct", a bim view rules record, bim plan view kind, entries)

# Whether annotation rule `ruleCode` applies to drawing type `typeId`.
function bim annotation {integer:ruleCode} applies to drawing type {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        return (the bim resolved setting 2 at ruleCode of drawing type typeId in modelValue) = 1

# The phase filter of drawing type `typeId`; show all when none is set.
function the bim phase filter of drawing type {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        set filterCode to the bim resolved setting 3 at 0 of drawing type typeId in modelValue
        if filterCode < 0:
            return bim show all phases
        return filterCode

# The rules view `viewValue` draws by in `modelValue`: its drawing type's when
# it is automatic and has one, else its own.
function the bim rules of view {bim view definition record:viewValue} in {bim model record:modelValue}:
    execute:
        if viewValue's automatic and (the bim drawing type index of viewValue's drawingTypeId in modelValue)'s valid:
            return the bim rules of drawing type viewValue's drawingTypeId in modelValue
        return the bim rules of view viewValue

# `viewValue` keeping its own rules from now on (Manual).
function the bim view {bim view definition record:viewValue} made manual:
    execute:
        return @intrinsic("construct", a bim view definition record, viewValue's id, viewValue's kind, viewValue's name, viewValue's levelId, viewValue's detail, viewValue's cutHeight, viewValue's scale, viewValue's cropped, viewValue's cropLow, viewValue's cropHigh, viewValue's shown, viewValue's faint, viewValue's lineStart, viewValue's lineFinish, viewValue's drawingTypeId, false, viewValue's phaseId)

# `viewValue` following its drawing type again (Automatic).
function the bim view {bim view definition record:viewValue} made automatic:
    execute:
        return @intrinsic("construct", a bim view definition record, viewValue's id, viewValue's kind, viewValue's name, viewValue's levelId, viewValue's detail, viewValue's cutHeight, viewValue's scale, viewValue's cropped, viewValue's cropLow, viewValue's cropHigh, viewValue's shown, viewValue's faint, viewValue's lineStart, viewValue's lineFinish, viewValue's drawingTypeId, true, viewValue's phaseId)

# The drawing type named `title`, or the refused id.
function the bim drawing type named {a string:title} in {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's drawingTypes's values):
            if (the item at cursor in (modelValue's drawingTypes's values))'s name = title:
                return (the item at cursor in (modelValue's drawingTypes's values))'s id
        return the bim refused id

local function set bim library type {a 64 bit integer:typeId} showing {integer:categoryCode} as {integer:value} in {a pointer to a bim model record:target}:
    execute:
        ignore set bim drawing type typeId setting 0 at categoryCode to value in target

local function set bim library type {a 64 bit integer:typeId} fading {integer:categoryCode} in {a pointer to a bim model record:target}:
    execute:
        ignore set bim drawing type typeId setting 1 at categoryCode to 1 in target

local function set bim library type {a 64 bit integer:typeId} annotating {integer:ruleCode} in {a pointer to a bim model record:target}:
    execute:
        ignore set bim drawing type typeId setting 2 at ruleCode to 1 in target

# The drawing types every model starts from, added once when it has none,
# after Open 2D Studio's plan subtypes and Revit's view templates:
# - Architectural, every category shown but ceilings and piles, with room
#   labels and door and window tags; beneath it Floor plan, Ceiling plan
#   (ceilings shown, furniture hidden), Section/Elevation (spaces hidden) and
#   Details.
# - Structural, the load-bearing elements with grids and dimensions, without
#   doors, windows, spaces, furniture and finishes, with dimensions to the
#   grids; beneath it Structural plan (beam labels), Pile plan (piles shown,
#   walls, floors and columns in halftone, beams, roofs and stairs hidden,
#   pile numbers and the pile table) and Structural details.
function ensure bim drawing types in {a pointer to a bim model record:target}:
    execute:
        if (the length of (target's drawingTypes's values)) > 0:
            ensure bim area plan type in target
            return nothing
        set architectural to add bim drawing type named (the string form of "Architectural") under (the bim refused id) to target
        loop code from 0 to the bim category count:
            set value to 1
            if (code = bim ceiling category) or (code = bim pile category):
                set value to 0
            set bim library type architectural showing code as value in target
            ignore set bim drawing type architectural setting 1 at code to 0 in target
        loop ruleCode from 0 to the bim annotation count:
            ignore set bim drawing type architectural setting 2 at ruleCode to 0 in target
        set bim library type architectural annotating bim room labels annotation in target
        set bim library type architectural annotating bim opening tags annotation in target
        ignore set bim drawing type architectural setting 3 at 0 to bim show all phases in target
        ignore add bim drawing type named (the string form of "Floor plan") under architectural to target
        set ceilingPlan to add bim drawing type named (the string form of "Ceiling plan") under architectural to target
        set bim library type ceilingPlan showing bim ceiling category as 1 in target
        set bim library type ceilingPlan showing bim furniture category as 0 in target
        set sectionType to add bim drawing type named (the string form of "Section/Elevation") under architectural to target
        set bim library type sectionType showing bim space category as 0 in target
        ignore add bim drawing type named (the string form of "Details") under architectural to target
        set structural to add bim drawing type named (the string form of "Structural") under (the bim refused id) to target
        loop code from 0 to the bim category count:
            set framing to ((code = bim wall category) or (code = bim slab category)) or ((code = bim column category) or (code = bim beam category))
            set marking to (code = bim grid category) or (code = bim dimension category)
            set value to 0
            if (framing or marking) or ((code = bim roof category) or (code = bim stair category)):
                set value to 1
            set bim library type structural showing code as value in target
            ignore set bim drawing type structural setting 1 at code to 0 in target
        loop ruleCode from 0 to the bim annotation count:
            ignore set bim drawing type structural setting 2 at ruleCode to 0 in target
        set bim library type structural annotating bim grid dimensions annotation in target
        ignore set bim drawing type structural setting 3 at 0 to bim show all phases in target
        set structuralPlan to add bim drawing type named (the string form of "Structural plan") under structural to target
        set bim library type structuralPlan annotating bim beam labels annotation in target
        set pilePlan to add bim drawing type named (the string form of "Pile plan") under structural to target
        set bim library type pilePlan showing bim pile category as 1 in target
        set bim library type pilePlan showing bim beam category as 0 in target
        set bim library type pilePlan showing bim roof category as 0 in target
        set bim library type pilePlan showing bim stair category as 0 in target
        set bim library type pilePlan fading bim wall category in target
        set bim library type pilePlan fading bim slab category in target
        set bim library type pilePlan fading bim column category in target
        set bim library type pilePlan annotating bim pile numbers annotation in target
        set bim library type pilePlan annotating bim pile table annotation in target
        ignore add bim drawing type named (the string form of "Structural details") under structural to target
        ensure bim area plan type in target

# The Area plan type beneath Architectural (or at the top when there is
# none), added to models made before it existed: spaces shown, furniture
# and the loose 2D lines left out, the NEN 2580 areas (BVO, GO, NVO, VVO)
# drawn.
function ensure bim area plan type in {a pointer to a bim model record:target}:
    execute:
        if (the bim drawing type named (the string form of "Area plan") in (@intrinsic("dereference", target))) != the bim refused id:
            return nothing
        set parentId to the bim drawing type named (the string form of "Architectural") in (@intrinsic("dereference", target))
        set areaPlan to add bim drawing type named (the string form of "Area plan") under parentId to target
        set bim library type areaPlan showing bim space category as 1 in target
        set bim library type areaPlan showing bim furniture category as 0 in target
        set bim library type areaPlan showing bim dimension category as 0 in target
        set bim library type areaPlan annotating bim area measures annotation in target
        ignore set bim drawing type areaPlan setting 2 at bim opening tags annotation to 0 in target

# A new plan of storey `levelId` following drawing type `typeId`
# automatically, named `title`, cut at 1.2 m, at 1:100; its id.
function add bim plan view following drawing type {a 64 bit integer:typeId} named {a string:title} on {a 64 bit integer:levelId} to {a pointer to a bim model record:target}:
    execute:
        set fresh to the bim new id in target
        set zero to a cad vector2 with x 0.0 and y 0.0
        set blank to @intrinsic("construct", a bim view definition record, fresh, bim plan view, title, levelId, 0 as a 64 bit integer, 1.2, 100, false, zero, zero, a cad topology list of a boolean, a cad topology list of a boolean, zero, zero, typeId, true, the bim refused id)
        set templated to the bim view blank ruled by (the bim rules of drawing type typeId in (@intrinsic("dereference", target)))
        store bim view templated in target
        return fresh

# ---------------------------------------------------------------- phasing

# How an element shows in a view, after its phase and the view's phase
# filter.
function bim phase hidden look:
    replacement:
        0
function bim phase normal look:
    replacement:
        1
function bim phase faint look:
    replacement:
        2
function bim phase demolished look:
    replacement:
        3

# How element `elementId` shows in view `viewValue`: not at all, as normal,
# in halftone (existing work beside new), or as demolished; as normal in a
# model without phases. The filter is the view's drawing type's (show all
# for a view without one):
# - show all: existing in halftone, demolished as demolished, new as normal;
# - new construction: only the new;
# - existing: what stood before the phase, the demolished included;
# - existing and demolished: the existing, and the demolished as such;
# - demolition: only the demolished.
function the bim phase look of element {a 64 bit integer:elementId} in view {bim view definition record:viewValue} in {bim model record:modelValue}:
    execute:
        if (the length of (modelValue's phases's values)) = 0:
            return bim phase normal look
        set phaseState to the bim phase state of element elementId seen in viewValue's phaseId in modelValue
        if phaseState = bim phase absent:
            return bim phase hidden look
        set filterCode to bim show all phases
        if (the bim drawing type index of viewValue's drawingTypeId in modelValue)'s valid:
            set filterCode to the bim phase filter of drawing type viewValue's drawingTypeId in modelValue
        if filterCode = bim show new phase:
            if phaseState = bim phase new:
                return bim phase normal look
            return bim phase hidden look
        if filterCode = bim show existing phase:
            if phaseState = bim phase new:
                return bim phase hidden look
            return bim phase normal look
        if filterCode = bim show existing and demolished phases:
            if phaseState = bim phase new:
                return bim phase hidden look
            if phaseState = bim phase demolished:
                return bim phase demolished look
            return bim phase normal look
        if filterCode = bim show demolition phase:
            if phaseState = bim phase demolished:
                return bim phase demolished look
            return bim phase hidden look
        if phaseState = bim phase existing:
            return bim phase faint look
        if phaseState = bim phase demolished:
            return bim phase demolished look
        return bim phase normal look
