# SPDX-License-Identifier: MPL-2.0
# The 3D scene of the BIM slice: one triangle mesh per evaluated wall or slab,
# cached per build, and picking of walls, slabs, openings and spaces along a
# ray.
#
# A ray picks the nearest of: a wall or slab triangle; an opening's rectangle in its
# host's centre plane (so a window is picked through its hole, and also when
# the ray first touches the opening's reveals); and a space's floor, at its
# level's elevation inside its outline. A space's floor coincides with the top
# of a slab under it, so it is picked only when it lies clearly (by more than
# the bim pick margin) in front of every element hit; the slab is picked
# otherwise. Every intersection is computed
# relative to the ray's origin, so picking stays exact far from the
# coordinate origin.
import examples/bim-slice/bim_spaces.dl
import examples/bim-slice/bim_view.dl
import examples/bim-slice/bim_component.dl
import examples/bim-slice/bim_stair.dl

class:
    patterns:
        [a|] bim scene mesh record
    members:
        elementId as a 64 bit integer
        serial as a 64 bit integer
        shape as a fast mesh record
        category as an integer
        # The mesh's own colour (red, green, blue in 0..255), or a negative
        # red to colour it by its category.
        colour as a cad vector3

# The colour that leaves a mesh coloured by its category.
function the bim category colouring:
    execute:
        return a cad vector3 with x -1.0, y 0.0 and z 0.0

# Meshes of the evaluated walls and slabs, reusing every mesh of `previous`
# whose build (serial) is unchanged. Both lists follow ascending element ids.
function the bim scene meshes of {bim evaluation record:evaluation} after {a pointer to a list:previous}:
    execute:
        return the bim scene meshes of evaluation after previous layered false

# The same, and when `layered`, each wall as one mesh per layer in its
# material's colour (the fine detail level); `previous` must have been built
# with the same `layered`.
function the bim scene meshes of {bim evaluation record:evaluation} after {a pointer to a list:previous} layered {boolean:layered}:
    execute:
        set result to a cad topology list of a bim scene mesh record
        set earlier to 0
        loop cursor from 0 to the length of (evaluation's elements's values):
            set geometry to the item at cursor in (evaluation's elements's values)
            set searching to true
            loop while searching:
                if earlier = the length of previous:
                    set searching to false
                else if (the item at earlier in previous)'s elementId < geometry's id:
                    set earlier to earlier + 1
                else:
                    set searching to false
            if geometry's status = 0:
                set reused to false
                # A wall shown in layers has several meshes in a row.
                set scanning to true
                loop while scanning:
                    if earlier < the length of previous:
                        set cached to the item at earlier in previous
                        if (cached's elementId = geometry's id) and (cached's serial = geometry's serial):
                            append cached to (result's values)
                            set reused to true
                            set earlier to earlier + 1
                        else:
                            set scanning to false
                    else:
                        set scanning to false
                if reused = false:
                    set category to the bim category of element geometry's id in evaluation's modelValue
                    set layers to a cad topology list of a bim layer solid record
                    if layered and (category = bim wall category):
                        set wallFound to the bim wall index of geometry's id in evaluation's modelValue
                        if wallFound's valid:
                            set layers to the bim layer solids of (the item at wallFound's position in (evaluation's modelValue's walls's values)) in evaluation's modelValue using evaluation's index
                    if (the length of (layers's values)) > 0:
                        loop layerCursor from 0 to the length of (layers's values):
                            set layer to the item at layerCursor in (layers's values)
                            set triangles to an empty fast mesh
                            append fast mesh of layer's shape to (the address of triangles)
                            append (@intrinsic("construct", a bim scene mesh record, geometry's id, geometry's serial, triangles, category, the bim material colour of layer's material)) to (result's values)
                    else:
                        set triangles to an empty fast mesh
                        append bim mesh of geometry to (the address of triangles)
                        # At the fine detail level a slab shows its material.
                        set colouring to the bim category colouring
                        set slabFound to the bim slab index of geometry's id in evaluation's modelValue
                        if layered and slabFound's valid:
                            set colouring to the bim material colour of (the bim material of plate (the item at slabFound's position in (evaluation's modelValue's slabs's values)) in evaluation's modelValue)
                        append (@intrinsic("construct", a bim scene mesh record, geometry's id, geometry's serial, triangles, category, colouring)) to (result's values)
        return result

# The mesh of sketch face `element` on a storey at `elevation`: a flat face
# as one triangulated polygon drawn from both sides, a pushed face as the
# prism the fast kernel builds from its storey up its height.
function the bim sketch mesh of {bim sketch record:element} at {a 64 bit floating-point number:elevation}:
    execute:
        set triangles to an empty fast mesh
        if element's height > 0.0:
            set noHoles to an empty list of the type of (an empty list of a cad vector2)
            set built to the fast prism over (element's points's values) with holes noHoles from elevation rising element's height within 1e-9
            free noHoles
            if built's reason = fast prism built:
                append fast mesh of built's shape to (the address of triangles)
        else:
            set noHoles to an empty list of the type of (an empty list of a cad vector2)
            set flat to the cad triangulation of (element's points's values) with holes noHoles
            free noHoles
            set upward to a cad vector3 with x 0.0, y 0.0 and z 1.0
            set downward to a cad vector3 with x 0.0, y 0.0 and z -1.0
            loop corner from 0 to the length of (the points of flat):
                set point to the item at corner in (the points of flat)
                append (a cad vector3 with x point's x, y point's y and z (elevation + 0.002)) to (triangles's positions's values)
                append upward to (triangles's normals's values)
            set count to the length of (the points of flat)
            loop corner from 0 to count:
                set point to the item at corner in (the points of flat)
                append (a cad vector3 with x point's x, y point's y and z (elevation + 0.002)) to (triangles's positions's values)
                append downward to (triangles's normals's values)
            loop face from 0 to the length of (the triangles of flat):
                set triple to the item at face in (the triangles of flat)
                append (the first of triple) to (triangles's triangles's values)
                append (the second of triple) to (triangles's triangles's values)
                append (the third of triple) to (triangles's triangles's values)
                append ((the first of triple) + count) to (triangles's triangles's values)
                append ((the third of triple) + count) to (triangles's triangles's values)
                append ((the second of triple) + count) to (triangles's triangles's values)
            free cad triangulation flat
        return triangles

# The triangles of free mesh `meshValue` on a storey at `elevation`: each face
# laid flat in its own plane and triangulated there, so that faces need not
# be convex.
function the bim mesh shape of {bim mesh record:meshValue} at {a 64 bit floating-point number:elevation}:
    execute:
        set triangles to an empty fast mesh
        set faces to meshValue's faces's values
        set points to meshValue's vertices's values
        set start to 0
        loop while start < the length of faces:
            set count to the item at start in faces
            set normal to the bim normal of mesh face start of meshValue
            set origin to the item at (the item at (start + 1) in faces) in points
            set second to the item at (the item at (start + 2) in faces) in points
            set across to the cad difference of second and origin
            set across to the cad difference of across and (normal scaled by (the cad dot of across and normal))
            set acrossLength to the cad length of across
            if acrossLength > 1e-12:
                set uAxis to across scaled by (1.0 / acrossLength)
                set vAxis to the cad cross of normal and uAxis
                set outline to an empty list of a cad vector2
                loop corner from 0 to count:
                    set point to the item at (the item at ((start + 1) + corner) in faces) in points
                    set offset to the cad difference of point and origin
                    append (a cad vector2 with x (the cad dot of offset and uAxis) and y (the cad dot of offset and vAxis)) to outline
                set noHoles to an empty list of the type of (an empty list of a cad vector2)
                set flat to the cad triangulation of outline with holes noHoles
                free noHoles
                set base to the length of (triangles's positions's values)
                # The face's own points where the triangulation kept them, so
                # that a face not quite flat keeps its shape.
                set kept to (the length of (the points of flat)) = count
                loop corner from 0 to the length of (the points of flat):
                    set planar to the item at corner in (the points of flat)
                    set placed to the cad sum of origin and (the cad sum of (uAxis scaled by planar's x) and (vAxis scaled by planar's y))
                    if kept:
                        set placed to the item at (the item at ((start + 1) + corner) in faces) in points
                    append (a cad vector3 with x placed's x, y placed's y and z (placed's z + elevation)) to (triangles's positions's values)
                    append normal to (triangles's normals's values)
                loop face from 0 to the length of (the triangles of flat):
                    set triple to the item at face in (the triangles of flat)
                    append (base + (the first of triple)) to (triangles's triangles's values)
                    append (base + (the second of triple)) to (triangles's triangles's values)
                    append (base + (the third of triple)) to (triangles's triangles's values)
                free cad triangulation flat
                free outline
            set start to start + (count + 1)
        return triangles

# The volume `meshValue` encloses, negative when its faces turn inward
# (the divergence theorem over its triangles).
function the bim signed volume of mesh {bim mesh record:meshValue}:
    execute:
        set triangles to the bim mesh shape of meshValue at 0.0
        set total to 0.0
        set corners to triangles's triangles's values
        set spots to triangles's positions's values
        set cursor to 0
        loop while (cursor + 2) < the length of corners:
            set alpha to the item at (the item at cursor in corners) in spots
            set beta to the item at (the item at (cursor + 1) in corners) in spots
            set gamma to the item at (the item at (cursor + 2) in corners) in spots
            set total to total + ((alpha's x * ((beta's y * gamma's z) - (beta's z * gamma's y))) - ((alpha's y * ((beta's x * gamma's z) - (beta's z * gamma's x))) - (alpha's z * ((beta's x * gamma's y) - (beta's y * gamma's x)))))
            set cursor to cursor + 3
        return total / 6.0

# Whether `pushed` (the same mesh as `earlier` after a push or grab) still
# encloses something and keeps every face of `earlier` facing the same way.
function bim mesh {bim mesh record:pushed} stays sound after {bim mesh record:earlier}:
    execute:
        if (the bim signed volume of mesh pushed) <= 1e-9:
            return false
        set start to 0
        loop while start < the length of (earlier's faces's values):
            if start < the length of (pushed's faces's values):
                if (the cad dot of (the bim normal of mesh face start of earlier) and (the bim normal of mesh face start of pushed)) < 0.0:
                    return false
            set start to start + ((the item at start in (earlier's faces's values)) + 1)
        return true

# The elevation of storey `levelId` in `modelValue`, 0 when it is gone.
function the bim elevation of storey {a 64 bit integer:levelId} in {bim model record:modelValue}:
    execute:
        set found to the bim level index of levelId in modelValue
        if found's valid:
            return (the item at found's position in (modelValue's levels's values))'s elevation
        return 0.0

# The profile ring of `linear` (of `linearType`) at both ends of its axis, in
# model coordinates: `count` corners at the start, then `count` at the
# finish, each ring turning anticlockwise about the axis. The width lies
# level across the axis (along x for an upright axis), the depth square to
# both, turned by the element's angle; a round profile has 24 corners.
function the bim profile rings of {bim linear record:linearValue} as {bim linear type record:linearType} in {bim model record:modelValue}:
    execute:
        return the bim profile rings of linearValue as linearType in modelValue at 24 round corners

# The corners a circle of `radius` needs so that no chord leaves it by more
# than `tolerance`: the sagitta r (1 - cos(pi / n)) is about r (pi / n)^2 / 2,
# so n = pi / sqrt(2 tolerance / r); from 12 to 256, a multiple of 4.
function the bim round corners for radius {a 64 bit floating-point number:circleRadius} within {a 64 bit floating-point number:chordTolerance}:
    execute:
        if (circleRadius <= 0.0) or (chordTolerance <= 0.0):
            return 24
        set ratio to (2.0 * chordTolerance) / circleRadius
        if ratio >= 1.0:
            return 12
        set needed to 3.141592653589793 / (the square root of ratio)
        set cornerCount to 12
        loop while (cornerCount < 256) and ((cornerCount as a 64 bit floating-point number) < needed):
            set cornerCount to cornerCount + 4
        return cornerCount

# The profile rings with `roundCorners` corners on a round profile.
function the bim profile rings of {bim linear record:linearValue} as {bim linear type record:linearType} in {bim model record:modelValue} at {integer:roundCorners} round corners:
    execute:
        set profileRings to an empty list of a cad vector3
        set lift to the bim elevation of storey linearValue's levelId in modelValue
        set first to a cad vector3 with x linearValue's start's x, y linearValue's start's y and z (linearValue's start's z + lift)
        set last to a cad vector3 with x linearValue's finish's x, y linearValue's finish's y and z (linearValue's finish's z + lift)
        set axisVector to the cad difference of last and first
        set axisLength to the cad length of axisVector
        set along to axisVector scaled by (1.0 / axisLength)
        set across to a cad vector3 with x 1.0, y 0.0 and z 0.0
        set upward to a cad vector3 with x 0.0, y 0.0 and z 1.0
        if (the absolute value of along's z) < 0.999:
            set square to the cad difference of upward and (along scaled by along's z)
            set upward to square scaled by (1.0 / (the cad length of square))
            set across to the cad cross of upward and along
        else:
            set upward to the cad cross of along and across
        set c to the cosine of linearValue's angle
        set sn to the sine of linearValue's angle
        set widthAxis to the cad sum of (across scaled by c) and (upward scaled by sn)
        set depthAxis to the cad difference of (upward scaled by c) and (across scaled by sn)
        set profileCorners to an empty list of a cad vector2
        if linearType's round:
            loop step from 0 to roundCorners:
                set turn to (6.283185307179586 * (step as a 64 bit floating-point number)) / (roundCorners as a 64 bit floating-point number)
                append (a cad vector2 with x ((linearType's width * 0.5) * (the cosine of turn)) and y ((linearType's width * 0.5) * (the sine of turn))) to profileCorners
        else:
            set halfWidth to linearType's width * 0.5
            set halfDepth to linearType's depth * 0.5
            append (a cad vector2 with x (0.0 - halfWidth) and y (0.0 - halfDepth)) to profileCorners
            append (a cad vector2 with x halfWidth and y (0.0 - halfDepth)) to profileCorners
            append (a cad vector2 with x halfWidth and y halfDepth) to profileCorners
            append (a cad vector2 with x (0.0 - halfWidth) and y halfDepth) to profileCorners
        loop endCursor from 0 to 2:
            set centre to first
            if endCursor = 1:
                set centre to last
            loop cursor from 0 to the length of profileCorners:
                set corner to the item at cursor in profileCorners
                append (the cad sum of centre and (the cad sum of (widthAxis scaled by corner's x) and (depthAxis scaled by corner's y))) to profileRings
        free profileCorners
        return profileRings

# The triangles of `linear`: its type's profile swept along its axis, each
# side flat, closed by its two ends.
function the bim linear shape of {bim linear record:linearValue} in {bim model record:modelValue}:
    execute:
        return the bim linear shape of linearValue in modelValue within 0.0

# The same, a round profile fine enough that it leaves the circle by at most
# `tolerance` (24 corners for a tolerance of 0).
function the bim linear shape of {bim linear record:linearValue} in {bim model record:modelValue} within {a 64 bit floating-point number:tolerance}:
    execute:
        return the bim linear shape of linearValue typed (the bim type of linear linearValue in modelValue) in modelValue within tolerance

# The same for a linear element of `linearType` given (a stair's tread or
# stringer, which the model does not store).
function the bim linear shape of {bim linear record:linearValue} typed {bim linear type record:linearType} in {bim model record:modelValue} within {a 64 bit floating-point number:tolerance}:
    execute:
        set triangles to an empty fast mesh
        set roundCorners to the bim round corners for radius (linearType's width * 0.5) within tolerance
        set profileRings to the bim profile rings of linearValue as linearType in modelValue at roundCorners round corners
        set count to (the length of profileRings) / 2
        set first to the item at 0 in profileRings
        set last to the item at count in profileRings
        set along to the cad difference of last and first
        set along to along scaled by (1.0 / (the cad length of along))
        loop cursor from 0 to count:
            set following to the remainder of (cursor + 1) divided by count
            set a to the item at cursor in profileRings
            set b to the item at following in profileRings
            set c to the item at (count + following) in profileRings
            set d to the item at (count + cursor) in profileRings
            set side to the cad cross of (the cad difference of b and a) and along
            set side to side scaled by (1.0 / (the maximum of 1e-12 and (the cad length of side)))
            set base to the length of (triangles's positions's values)
            append a to (triangles's positions's values)
            append b to (triangles's positions's values)
            append c to (triangles's positions's values)
            append d to (triangles's positions's values)
            loop corner from 0 to 4:
                append side to (triangles's normals's values)
            append base to (triangles's triangles's values)
            append (base + 1) to (triangles's triangles's values)
            append (base + 2) to (triangles's triangles's values)
            append base to (triangles's triangles's values)
            append (base + 2) to (triangles's triangles's values)
            append (base + 3) to (triangles's triangles's values)
        # The ends: the start faces back along the axis, the finish forward.
        set backward to along scaled by -1.0
        loop endCursor from 0 to 2:
            set base to the length of (triangles's positions's values)
            set facing to backward
            if endCursor = 1:
                set facing to along
            loop cursor from 0 to count:
                append (the item at ((endCursor * count) + cursor) in profileRings) to (triangles's positions's values)
                append facing to (triangles's normals's values)
            loop cursor from 1 to (count - 1):
                append base to (triangles's triangles's values)
                if endCursor = 1:
                    append (base + cursor) to (triangles's triangles's values)
                    append (base + (cursor + 1)) to (triangles's triangles's values)
                else:
                    append (base + (cursor + 1)) to (triangles's triangles's values)
                    append (base + cursor) to (triangles's triangles's values)
        free profileRings
        return triangles

# What `linear` covers seen from above: the outline (anticlockwise) of its
# swept profile's corners.
function the bim plan outline of linear {bim linear record:linearValue} in {bim model record:modelValue}:
    execute:
        return the bim plan outline of linear linearValue typed (the bim type of linear linearValue in modelValue) in modelValue

function the bim plan outline of linear {bim linear record:linearValue} typed {bim linear type record:linearType} in {bim model record:modelValue}:
    execute:
        set profileRings to the bim profile rings of linearValue as linearType in modelValue
        set flat to an empty list of a cad vector2
        loop cursor from 0 to the length of profileRings:
            set spot to the item at cursor in profileRings
            append (a cad vector2 with x spot's x and y spot's y) to flat
        free profileRings
        # The hull, by gift wrapping (few points).
        set hull to an empty list of a cad vector2
        set lowest to 0
        loop cursor from 1 to the length of flat:
            set here to the item at cursor in flat
            set best to the item at lowest in flat
            if (here's x < best's x) or ((here's x = best's x) and (here's y < best's y)):
                set lowest to cursor
        set currentIndex to lowest
        set guard to 0
        set wrapping to true
        loop while wrapping:
            append (the item at currentIndex in flat) to hull
            set candidate to 0
            if candidate = currentIndex:
                set candidate to 1
            loop cursor from 0 to the length of flat:
                if cursor != currentIndex:
                    set origin to the item at currentIndex in flat
                    set toCandidate to the item at candidate in flat
                    set toCursor to the item at cursor in flat
                    set turnValue to ((toCandidate's x - origin's x) * (toCursor's y - origin's y)) - ((toCandidate's y - origin's y) * (toCursor's x - origin's x))
                    set further to (the cad distance from origin to toCursor) > (the cad distance from origin to toCandidate)
                    if (turnValue < -1e-12) or (((the absolute value of turnValue) <= 1e-12) and further):
                        set candidate to cursor
            set currentIndex to candidate
            set guard to guard + 1
            if (currentIndex = lowest) or (guard > (the length of flat)):
                set wrapping to false
        free flat
        return hull

# The lowest and highest height `linear` reaches, as (low, high).
function the bim height range of linear {bim linear record:linearValue} in {bim model record:modelValue}:
    execute:
        return the bim height range of linear linearValue typed (the bim type of linear linearValue in modelValue) in modelValue

function the bim height range of linear {bim linear record:linearValue} typed {bim linear type record:linearType} in {bim model record:modelValue}:
    execute:
        set profileRings to the bim profile rings of linearValue as linearType in modelValue
        set low to 1.0 / 0.0
        set high to 0.0 - (1.0 / 0.0)
        loop cursor from 0 to the length of profileRings:
            set low to the minimum of low and (the item at cursor in profileRings)'s z
            set high to the maximum of high and (the item at cursor in profileRings)'s z
        free profileRings
        return a cad vector2 with x low and y high

# The view category of a linear element of `roleCode`: columns and beams
# their own, the others as other elements.
function the bim category of linear role {integer:roleCode}:
    execute:
        if roleCode = bim column role:
            return bim column category
        if roleCode = bim beam role:
            return bim beam category
        return bim other category

# The triangles of all of a stair's derived parts, in model coordinates.
function the bim stair shape of {bim stair record:stairValue} in {bim model record:modelValue} within {a 64 bit floating-point number:tolerance}:
    execute:
        set combined to an empty fast mesh
        set stairParts to the bim parts of stair stairValue in modelValue
        loop cursor from 0 to the length of (stairParts's values):
            set part to the item at cursor in (stairParts's values)
            set partShape to the bim linear shape of part's element typed part's kind in modelValue within tolerance
            set base to the length of (combined's positions's values)
            loop corner from 0 to the length of (partShape's positions's values):
                append (the item at corner in (partShape's positions's values)) to (combined's positions's values)
                append (the item at corner in (partShape's normals's values)) to (combined's normals's values)
            loop corner from 0 to the length of (partShape's triangles's values):
                append (base + (the item at corner in (partShape's triangles's values))) to (combined's triangles's values)
        return combined

# The meshes of the sketch faces of `modelValue`, free and in instances.
function the bim sketch meshes of {bim model record:modelValue}:
    execute:
        return the bim sketch meshes of modelValue within 0.0

# The same, round shapes (round linear elements, components' curved faces)
# fine enough to leave the true surface by at most `tolerance`.
function the bim sketch meshes of {bim model record:modelValue} within {a 64 bit floating-point number:tolerance}:
    execute:
        set result to a cad topology list of a bim scene mesh record
        # Components with solid parts: their B-rep, meshed once per
        # component and placed per instance; their faces are in it.
        set foldedIds to an empty list of a 64 bit integer
        set componentTolerance to 0.002
        if tolerance > 0.0:
            set componentTolerance to the maximum of tolerance and 0.0002
        loop componentCursor from 0 to the length of (modelValue's components's values):
            set definition to the item at componentCursor in (modelValue's components's values)
            if bim component definition is folded:
                set componentShape to the bim component mesh of (the bim brep of component definition within 1e-9) within componentTolerance
                loop placementCursor from 0 to the length of (modelValue's instances's values):
                    set placement to the item at placementCursor in (modelValue's instances's values)
                    set placementLevel to the bim level index of placement's levelId in modelValue
                    if (placement's componentId = definition's id) and placementLevel's valid:
                        append placement's id to foldedIds
                        set placementElevation to (the item at placementLevel's position in (modelValue's levels's values))'s elevation
                        append (@intrinsic("construct", a bim scene mesh record, placement's id, 0 as a 64 bit integer, the bim component triangles componentShape placed by placement at placementElevation, bim mass category, the bim category colouring)) to (result's values)
        set drawn to the bim drawn sketches of modelValue
        loop cursor from 0 to the length of (drawn's values):
            set element to the item at cursor in (drawn's values)
            set levelFound to the bim level index of element's levelId in modelValue
            set inFolded to false
            loop foldedCursor from 0 to the length of foldedIds:
                if ((the item at foldedCursor in foldedIds) = element's id) and (element's height > 0.0):
                    set inFolded to true
            if ((element's kind = bim face sketch) and levelFound's valid) and (inFolded = false):
                set elevation to (the item at levelFound's position in (modelValue's levels's values))'s elevation
                append (@intrinsic("construct", a bim scene mesh record, element's id, 0 as a 64 bit integer, the bim sketch mesh of element at elevation, bim mass category, the bim category colouring)) to (result's values)
        # Linear elements, coloured by their material.
        loop cursor from 0 to the length of (modelValue's linears's values):
            set linearValue to the item at cursor in (modelValue's linears's values)
            set linearType to the bim type of linear linearValue in modelValue
            append (@intrinsic("construct", a bim scene mesh record, linearValue's id, 0 as a 64 bit integer, the bim linear shape of linearValue in modelValue within tolerance, the bim category of linear role linearType's role, the bim material colour of linearType's material)) to (result's values)
        # Stairs: their derived treads and stringers, one mesh per stair.
        loop cursor from 0 to the length of (modelValue's stairs's values):
            set stairValue to the item at cursor in (modelValue's stairs's values)
            append (@intrinsic("construct", a bim scene mesh record, stairValue's id, 0 as a 64 bit integer, the bim stair shape of stairValue in modelValue within tolerance, bim stair category, the bim material colour of stairValue's material)) to (result's values)
        # Free meshes.
        loop cursor from 0 to the length of (modelValue's meshes's values):
            set meshValue to the item at cursor in (modelValue's meshes's values)
            set levelFound to the bim level index of meshValue's levelId in modelValue
            if levelFound's valid:
                set elevation to (the item at levelFound's position in (modelValue's levels's values))'s elevation
                append (@intrinsic("construct", a bim scene mesh record, meshValue's id, 0 as a 64 bit integer, the bim mesh shape of meshValue at elevation, bim mass category, the bim category colouring)) to (result's values)
        return result

class:
    patterns:
        [a|] bim ray record
    members:
        origin as a cad vector3
        direction as a cad vector3

function bim nothing picked:
    replacement:
        0
function bim wall picked:
    replacement:
        1
function bim opening picked:
    replacement:
        2
function bim space picked:
    replacement:
        3
function bim slab picked:
    replacement:
        4
function bim grid picked:
    replacement:
        5
# An imported element, read-only; `id` is its scene mesh's element id.
function bim imported picked:
    replacement:
        6
# A sketch element: a line, a face or mass, or a text.
function bim sketch picked:
    replacement:
        7
# An instance of a component.
function bim instance picked:
    replacement:
        8
# A free mesh.
function bim mesh picked:
    replacement:
        9
# A linear element (column, beam, mullion, skirting, pipe).
function bim linear picked:
    replacement:
        10

# Scene meshes of imported elements have ids from here up, above any id the
# model hands out.
function the bim imported id base:
    execute:
        return 1099511627776 as a 64 bit integer

# `id` is the wall, slab or opening id, or the space's identity; `distance` is along
# the ray.
class:
    patterns:
        [a|] bim pick record
    members:
        kind as an integer
        id as a 64 bit integer
        distance as a 64 bit floating-point number

# How far a space's floor must lie in front of an element hit to be picked
# instead of it.
function the bim pick margin:
    replacement:
        1e-6

function no bim pick:
    execute:
        return @intrinsic("construct", a bim pick record, bim nothing picked, the bim refused id, 1.0 / 0.0)

# The distance along the ray to the triangle, or infinity (Möller–Trumbore).
local function the bim ray distance to {cad vector3:first}, {cad vector3:second} and {cad vector3:third} along {bim ray record:ray}:
    execute:
        set miss to 1.0 / 0.0
        set a to the cad difference of first and ray's origin
        set edgeOne to the cad difference of second and first
        set edgeTwo to the cad difference of third and first
        set crossing to the cad cross of ray's direction and edgeTwo
        set determinant to the cad dot of edgeOne and crossing
        if (the absolute value of determinant) <= 1e-18:
            return miss
        set inverse to 1.0 / determinant
        set offset to a scaled by -1.0
        set u to (the cad dot of offset and crossing) * inverse
        if (u < 0.0) or (u > 1.0):
            return miss
        set turned to the cad cross of offset and edgeOne
        set v to (the cad dot of ray's direction and turned) * inverse
        if (v < 0.0) or ((u + v) > 1.0):
            return miss
        set reach to (the cad dot of edgeTwo and turned) * inverse
        if reach <= 0.0:
            return miss
        return reach

# True when `location` lies inside the closed polygon `outline` (even-odd).
function bim flat point {cad vector2:location} lies in {a pointer to a list:outline}:
    execute:
        set enclosed to false
        set count to the length of outline
        loop cursor from 0 to count:
            set here to the item at cursor in outline
            set following to the item at (the remainder of (cursor + 1) divided by count) in outline
            if (here's y > location's y) != (following's y > location's y):
                set crossingX to here's x + (((location's y - here's y) / (following's y - here's y)) * (following's x - here's x))
                if location's x < crossingX:
                    set enclosed to (enclosed = false)
        return enclosed

# The corners of the face of `meshValue` starting at `start`, seen from above.
function the bim plan outline of mesh face {integer:start} of {bim mesh record:meshValue}:
    execute:
        set faceRing to an empty list of a cad vector2
        loop corner from 0 to (the item at start in (meshValue's faces's values)):
            set point to the item at (the item at ((start + 1) + corner) in (meshValue's faces's values)) in (meshValue's vertices's values)
            append (a cad vector2 with x point's x and y point's y) to faceRing
        return faceRing

# The face of `meshValue` seen from above at `location`: the highest of the
# faces turned up whose outline contains it; -1 when there is none.
function the bim top face of mesh {bim mesh record:meshValue} at {cad vector2:location}:
    execute:
        set best to -1
        set bestHeight to 0.0 - (1.0 / 0.0)
        set start to 0
        loop while start < the length of (meshValue's faces's values):
            set count to the item at start in (meshValue's faces's values)
            if (the bim normal of mesh face start of meshValue)'s z > 1e-6:
                set faceRing to the bim plan outline of mesh face start of meshValue
                if bim flat point location lies in faceRing:
                    set height to 0.0
                    loop corner from 0 to count:
                        set height to height + (the item at (the item at ((start + 1) + corner) in (meshValue's faces's values)) in (meshValue's vertices's values))'s z
                    set height to height / (count as a 64 bit floating-point number)
                    if height > bestHeight:
                        set bestHeight to height
                        set best to start
                free faceRing
            set start to start + (count + 1)
        return best

# The face of `meshValue` on which `spot` (in the mesh's own coordinates)
# lies: the face whose plane is nearest, among those whose outline holds it
# in their plane; -1 when there is none.
function the bim face of mesh {bim mesh record:meshValue} through {cad vector3:spot}:
    execute:
        set best to -1
        set bestGap to 1e-3
        set start to 0
        loop while start < the length of (meshValue's faces's values):
            set count to the item at start in (meshValue's faces's values)
            set normal to the bim normal of mesh face start of meshValue
            set origin to the item at (the item at (start + 1) in (meshValue's faces's values)) in (meshValue's vertices's values)
            set gap to the absolute value of (the cad dot of (the cad difference of spot and origin) and normal)
            if gap <= bestGap:
                # Into the face's plane: along its largest normal component.
                set faceRing to an empty list of a cad vector2
                set dropAxis to 2
                if ((the absolute value of normal's x) >= (the absolute value of normal's y)) and ((the absolute value of normal's x) >= (the absolute value of normal's z)):
                    set dropAxis to 0
                else if (the absolute value of normal's y) >= (the absolute value of normal's z):
                    set dropAxis to 1
                loop corner from 0 to count:
                    set point to the item at (the item at ((start + 1) + corner) in (meshValue's faces's values)) in (meshValue's vertices's values)
                    append (the bim flat of point dropping dropAxis) to faceRing
                if bim flat point (the bim flat of spot dropping dropAxis) lies in faceRing:
                    set best to start
                    set bestGap to gap
                free faceRing
            set start to start + (count + 1)
        return best

# A point on a mesh face's outline, when one was found.
class:
    patterns:
        [a|] bim mesh spot record
    members:
        valid as a boolean
        spot as a cad vector3

# The point of the outline of face `start` of `meshValue` nearest `spot`: a
# corner within `tolerance`, else an edge's middle, else the nearest point
# of an edge within it.
function the bim outline spot of mesh face {integer:start} of {bim mesh record:meshValue} near {cad vector3:spot} within {a 64 bit floating-point number:tolerance}:
    execute:
        set entries to meshValue's faces's values
        set count to the item at start in entries
        loop corner from 0 to count:
            set here to the item at (the item at ((start + 1) + corner) in entries) in (meshValue's vertices's values)
            if (the cad distance from spot to here) <= tolerance:
                return @intrinsic("construct", a bim mesh spot record, true, here)
        loop corner from 0 to count:
            set here to the item at (the item at ((start + 1) + corner) in entries) in (meshValue's vertices's values)
            set following to the item at (the item at ((start + 1) + (the remainder of (corner + 1) divided by count)) in entries) in (meshValue's vertices's values)
            set middle to (the cad sum of here and following) scaled by 0.5
            if (the cad distance from spot to middle) <= tolerance:
                return @intrinsic("construct", a bim mesh spot record, true, middle)
        set best to @intrinsic("construct", a bim mesh spot record, false, spot)
        set bestGap to tolerance
        loop corner from 0 to count:
            set here to the item at (the item at ((start + 1) + corner) in entries) in (meshValue's vertices's values)
            set following to the item at (the item at ((start + 1) + (the remainder of (corner + 1) divided by count)) in entries) in (meshValue's vertices's values)
            set run to the cad difference of following and here
            set runLength to the cad dot of run and run
            if runLength > 1e-18:
                set along to the maximum of 0.0 and (the minimum of 1.0 and ((the cad dot of (the cad difference of spot and here) and run) / runLength))
                set foot to the cad sum of here and (run scaled by along)
                set gap to the cad distance from spot to foot
                if gap <= bestGap:
                    set bestGap to gap
                    set best to @intrinsic("construct", a bim mesh spot record, true, foot)
        return best

local function the bim flat of {cad vector3:point} dropping {integer:dropAxis}:
    execute:
        if dropAxis = 0:
            return a cad vector2 with x point's y and y point's z
        if dropAxis = 1:
            return a cad vector2 with x point's x and y point's z
        return a cad vector2 with x point's x and y point's y

# The nearest wall, slab, opening or space along `ray`. `meshes` are the scene
# meshes of `modelValue`'s evaluation and `spaces` its spaces.
function the bim pick along {bim ray record:ray} among {a pointer to a list:meshes} in {bim model record:modelValue} with {a pointer to a list:spaces}:
    execute:
        set best to no bim pick
        loop meshCursor from 0 to the length of meshes:
            set entry to the item at meshCursor in meshes
            set entryKind to bim imported picked
            if entry's elementId < (the bim imported id base):
                set entryKind to bim wall picked
                if (the bim slab index of entry's elementId in modelValue)'s valid:
                    set entryKind to bim slab picked
                if entry's category = bim mass category:
                    set entryKind to bim sketch picked
                    if (the bim mesh index of entry's elementId in modelValue)'s valid:
                        set entryKind to bim mesh picked
                if (the bim linear index of entry's elementId in modelValue)'s valid:
                    set entryKind to bim linear picked
            set points to entry's shape's positions's values
            set corners to entry's shape's triangles's values
            set cursor to 0
            loop while cursor < the length of corners:
                set triangleDistance to the bim ray distance to (the item at (the item at cursor in corners) in points), (the item at (the item at (cursor + 1) in corners) in points) and (the item at (the item at (cursor + 2) in corners) in points) along ray
                if triangleDistance < best's distance:
                    set best to @intrinsic("construct", a bim pick record, entryKind, entry's elementId, triangleDistance)
                set cursor to cursor + 3
        # An opening wins over its own wall when the ray reaches its centre
        # plane within the wall's thickness of the wall hit: the ray entered
        # the opening or touched its reveals.
        loop openingCursor from 0 to the length of (modelValue's openings's values):
            set openingValue to the item at openingCursor in (modelValue's openings's values)
            set hostFound to the bim wall index of openingValue's hostId in modelValue
            set typeFound to the bim opening type index of openingValue's typeId in modelValue
            if hostFound's valid and typeFound's valid:
                set host to the item at hostFound's position in (modelValue's walls's values)
                set openingType to the item at typeFound's position in (modelValue's openingTypes's values)
                set levelFound to the bim level index of host's levelId in modelValue
                set elevation to 0.0
                if levelFound's valid:
                    set elevation to (the item at levelFound's position in (modelValue's levels's values))'s elevation
                # The opening's centre plane; along a curved host, on the
                # tangent at the opening's middle.
                set halfWidth to (the bim rough width of openingType) * 0.5
                set span to the bim span of host at openingValue's offset reaching halfWidth
                set direction to span's direction
                set normal to span's normal
                set base to span's left
                set facing to (ray's direction's x * normal's x) + (ray's direction's y * normal's y)
                if (the absolute value of facing) > 1e-12:
                    set planeGap to ((base's x - ray's origin's x) * normal's x) + ((base's y - ray's origin's y) * normal's y)
                    set openingDistance to planeGap / facing
                    if openingDistance > 0.0:
                        set hitX to (ray's origin's x - base's x) + (openingDistance * ray's direction's x)
                        set hitY to (ray's origin's y - base's y) + (openingDistance * ray's direction's y)
                        set hitZ to (ray's origin's z + (openingDistance * ray's direction's z)) - elevation
                        set alongWall to (openingValue's offset - halfWidth) + ((hitX * direction's x) + (hitY * direction's y))
                        set inside to ((alongWall >= (openingValue's offset - halfWidth)) and (alongWall <= (openingValue's offset + halfWidth))) and ((hitZ >= openingType's sill) and (hitZ <= (the bim head height of openingType)))
                        if inside:
                            set throughHost to (best's kind = bim wall picked) and (best's id = host's id)
                            set nearHost to throughHost and (openingDistance <= (best's distance + (the bim wall thickness of host in modelValue)))
                            if (openingDistance < best's distance) or nearHost:
                                set best to @intrinsic("construct", a bim pick record, bim opening picked, openingValue's id, openingDistance)
        loop spaceCursor from 0 to the length of spaces:
            set space to the item at spaceCursor in spaces
            set levelFound to the bim level index of space's levelId in modelValue
            if levelFound's valid and ((the absolute value of ray's direction's z) > 1e-12):
                set elevation to (the item at levelFound's position in (modelValue's levels's values))'s elevation
                set floorDistance to (elevation - ray's origin's z) / ray's direction's z
                if (floorDistance > 0.0) and (floorDistance < (best's distance - the bim pick margin)):
                    set floorPoint to a cad vector2 with x (ray's origin's x + (floorDistance * ray's direction's x)) and y (ray's origin's y + (floorDistance * ray's direction's y))
                    if bim flat point floorPoint lies in (space's outline's values):
                        set best to @intrinsic("construct", a bim pick record, bim space picked, the bim identity of space, floorDistance)
        return best
