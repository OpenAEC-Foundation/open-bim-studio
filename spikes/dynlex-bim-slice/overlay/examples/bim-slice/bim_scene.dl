# SPDX-License-Identifier: MPL-2.0
# The 3D scene of the BIM slice: one triangle mesh per evaluated wall or slab,
# cached per build, and picking of walls, slabs, openings and spaces along a
# ray.
#
# A ray picks the nearest of: a wall or slab triangle; an opening's rectangle in its
# host's centre plane (so a window is picked through its hole, and also when
# the ray first touches the opening's reveals); and a space's floor, at its
# level's elevation inside its outline. A space's floor coincides with the top
# of a slab under it, so it is picked only when it lies clearly (by more than
# the bim pick margin) in front of every element hit; the slab is picked
# otherwise. Every intersection is computed
# relative to the ray's origin, so picking stays exact far from the
# coordinate origin.
import examples/bim-slice/bim_spaces.dl
import examples/bim-slice/bim_view.dl
import examples/bim-slice/bim_component.dl
import examples/bim-slice/bim_stair.dl
import examples/bim-slice/bim_network.dl
import examples/bim-slice/bim_reinforcement.dl
import examples/bim-slice/bim_connections.dl
import examples/bim-slice/bim_connection_geometry.dl
import examples/bim-slice/bim_profiles.dl
import examples/bim-slice/bim_masonry.dl

class:
    patterns:
        [a|] bim scene mesh record
    members:
        elementId as a 64 bit integer
        serial as a 64 bit integer
        shape as a fast mesh record
        category as an integer
        # The mesh's own colour (red, green, blue in 0..255), or a negative
        # red to colour it by its category.
        colour as a cad vector3

# The colour that leaves a mesh coloured by its category.
function the bim category colouring:
    execute:
        return a cad vector3 with x -1.0, y 0.0 and z 0.0

# Meshes of the evaluated walls and slabs, reusing every mesh of `previous`
# whose build (serial) is unchanged. Both lists follow ascending element ids.
function the bim scene meshes of {bim evaluation record:evaluation} after {a pointer to a list:previous}:
    execute:
        return the bim scene meshes of evaluation after previous layered false

# The same, and when `layered`, each wall as one mesh per layer in its
# material's colour (the fine detail level); `previous` must have been built
# with the same `layered`.
function the bim scene meshes of {bim evaluation record:evaluation} after {a pointer to a list:previous} layered {boolean:layered}:
    execute:
        set result to a cad topology list of a bim scene mesh record
        set earlier to 0
        loop cursor from 0 to the length of (evaluation's elements's values):
            set geometry to the item at cursor in (evaluation's elements's values)
            set searching to true
            loop while searching:
                if earlier = the length of previous:
                    set searching to false
                else if (the item at earlier in previous)'s elementId < geometry's id:
                    set earlier to earlier + 1
                else:
                    set searching to false
            if geometry's status = 0:
                set reused to false
                # A wall shown in layers has several meshes in a row.
                set scanning to true
                loop while scanning:
                    if earlier < the length of previous:
                        set cached to the item at earlier in previous
                        if (cached's elementId = geometry's id) and (cached's serial = geometry's serial):
                            append cached to (result's values)
                            set reused to true
                            set earlier to earlier + 1
                        else:
                            set scanning to false
                    else:
                        set scanning to false
                if reused = false:
                    set category to the bim category of element geometry's id in evaluation's modelValue
                    set layers to a cad topology list of a bim layer solid record
                    if layered and (category = bim wall category):
                        set wallFound to the bim wall index of geometry's id in evaluation's modelValue
                        if wallFound's valid:
                            set layers to the bim layer solids of (the item at wallFound's position in (evaluation's modelValue's walls's values)) in evaluation's modelValue using evaluation's index
                    # A plate of a layered type shows its layers, each on its
                    # own outline.
                    set plateFound to the bim slab index of geometry's id in evaluation's modelValue
                    if layered and plateFound's valid:
                        set layers to the bim layer solids of plate (the item at plateFound's position in (evaluation's modelValue's slabs's values)) in evaluation's modelValue
                    if (the length of (layers's values)) > 0:
                        loop layerCursor from 0 to the length of (layers's values):
                            set layer to the item at layerCursor in (layers's values)
                            set triangles to an empty fast mesh
                            append fast mesh of layer's shape to (the address of triangles)
                            append (@intrinsic("construct", a bim scene mesh record, geometry's id, geometry's serial, triangles, category, the bim material colour of layer's material)) to (result's values)
                    else:
                        set triangles to an empty fast mesh
                        append bim mesh of geometry to (the address of triangles)
                        # At the fine detail level a slab shows its material;
                        # a wall shows its outside layer's at every level, as
                        # Revit's shaded view (masonry looks like masonry).
                        set colouring to the bim category colouring
                        set slabFound to the bim slab index of geometry's id in evaluation's modelValue
                        if layered and slabFound's valid:
                            set colouring to the bim material colour of (the bim material of plate (the item at slabFound's position in (evaluation's modelValue's slabs's values)) in evaluation's modelValue)
                        if category = bim wall category:
                            set shownWall to the bim wall index of geometry's id in evaluation's modelValue
                            if shownWall's valid:
                                set shownType to the bim wall type index of (the item at shownWall's position in (evaluation's modelValue's walls's values))'s typeId in evaluation's modelValue
                                if shownType's valid:
                                    set typeLayers to (the item at shownType's position in (evaluation's modelValue's wallTypes's values))'s layers's values
                                    if (the length of typeLayers) > 0:
                                        set colouring to the bim material colour of (the item at 0 in typeLayers)'s material
                        append (@intrinsic("construct", a bim scene mesh record, geometry's id, geometry's serial, triangles, category, colouring)) to (result's values)
        return result

# The mesh of sketch face `element` on a storey at `elevation`: a flat face
# as one triangulated polygon drawn from both sides, a pushed face as the
# prism the fast kernel builds from its storey up its height.
function the bim sketch mesh of {bim sketch record:element} at {a 64 bit floating-point number:elevation}:
    execute:
        set triangles to an empty fast mesh
        if element's height > 0.0:
            set noHoles to an empty list of the type of (an empty list of a cad vector2)
            set built to the fast prism over (element's points's values) with holes noHoles from elevation rising element's height within 1e-9
            free noHoles
            if built's reason = fast prism built:
                append fast mesh of built's shape to (the address of triangles)
        else:
            set noHoles to an empty list of the type of (an empty list of a cad vector2)
            set flat to the cad triangulation of (element's points's values) with holes noHoles
            free noHoles
            set upward to a cad vector3 with x 0.0, y 0.0 and z 1.0
            set downward to a cad vector3 with x 0.0, y 0.0 and z -1.0
            loop corner from 0 to the length of (the points of flat):
                set point to the item at corner in (the points of flat)
                append (a cad vector3 with x point's x, y point's y and z (elevation + 0.002)) to (triangles's positions's values)
                append upward to (triangles's normals's values)
            set count to the length of (the points of flat)
            loop corner from 0 to count:
                set point to the item at corner in (the points of flat)
                append (a cad vector3 with x point's x, y point's y and z (elevation + 0.002)) to (triangles's positions's values)
                append downward to (triangles's normals's values)
            loop face from 0 to the length of (the triangles of flat):
                set triple to the item at face in (the triangles of flat)
                append (the first of triple) to (triangles's triangles's values)
                append (the second of triple) to (triangles's triangles's values)
                append (the third of triple) to (triangles's triangles's values)
                append ((the first of triple) + count) to (triangles's triangles's values)
                append ((the third of triple) + count) to (triangles's triangles's values)
                append ((the second of triple) + count) to (triangles's triangles's values)
            free cad triangulation flat
        return triangles

# The triangles of free mesh `meshValue` on a storey at `elevation`: each face
# laid flat in its own plane and triangulated there, so that faces need not
# be convex.
function the bim mesh shape of {bim mesh record:meshValue} at {a 64 bit floating-point number:elevation}:
    execute:
        set triangles to an empty fast mesh
        set faces to meshValue's faces's values
        set points to meshValue's vertices's values
        set start to 0
        loop while start < the length of faces:
            set count to the item at start in faces
            set normal to the bim normal of mesh face start of meshValue
            set origin to the item at (the item at (start + 1) in faces) in points
            set second to the item at (the item at (start + 2) in faces) in points
            set across to the cad difference of second and origin
            set across to the cad difference of across and (normal scaled by (the cad dot of across and normal))
            set acrossLength to the cad length of across
            if acrossLength > 1e-12:
                set uAxis to across scaled by (1.0 / acrossLength)
                set vAxis to the cad cross of normal and uAxis
                set outline to an empty list of a cad vector2
                loop corner from 0 to count:
                    set point to the item at (the item at ((start + 1) + corner) in faces) in points
                    set offset to the cad difference of point and origin
                    append (a cad vector2 with x (the cad dot of offset and uAxis) and y (the cad dot of offset and vAxis)) to outline
                set noHoles to an empty list of the type of (an empty list of a cad vector2)
                set flat to the cad triangulation of outline with holes noHoles
                free noHoles
                set base to the length of (triangles's positions's values)
                # The face's own points where the triangulation kept them, so
                # that a face not quite flat keeps its shape.
                set kept to (the length of (the points of flat)) = count
                loop corner from 0 to the length of (the points of flat):
                    set planar to the item at corner in (the points of flat)
                    set placed to the cad sum of origin and (the cad sum of (uAxis scaled by planar's x) and (vAxis scaled by planar's y))
                    if kept:
                        set placed to the item at (the item at ((start + 1) + corner) in faces) in points
                    append (a cad vector3 with x placed's x, y placed's y and z (placed's z + elevation)) to (triangles's positions's values)
                    append normal to (triangles's normals's values)
                loop face from 0 to the length of (the triangles of flat):
                    set triple to the item at face in (the triangles of flat)
                    append (base + (the first of triple)) to (triangles's triangles's values)
                    append (base + (the second of triple)) to (triangles's triangles's values)
                    append (base + (the third of triple)) to (triangles's triangles's values)
                free cad triangulation flat
                free outline
            set start to start + (count + 1)
        return triangles

# The volume `meshValue` encloses, negative when its faces turn inward
# (the divergence theorem over its triangles).
function the bim signed volume of mesh {bim mesh record:meshValue}:
    execute:
        set triangles to the bim mesh shape of meshValue at 0.0
        set total to 0.0
        set corners to triangles's triangles's values
        set spots to triangles's positions's values
        set cursor to 0
        loop while (cursor + 2) < the length of corners:
            set alpha to the item at (the item at cursor in corners) in spots
            set beta to the item at (the item at (cursor + 1) in corners) in spots
            set gamma to the item at (the item at (cursor + 2) in corners) in spots
            set total to total + ((alpha's x * ((beta's y * gamma's z) - (beta's z * gamma's y))) - ((alpha's y * ((beta's x * gamma's z) - (beta's z * gamma's x))) - (alpha's z * ((beta's x * gamma's y) - (beta's y * gamma's x)))))
            set cursor to cursor + 3
        return total / 6.0

# Whether `pushed` (the same mesh as `earlier` after a push or grab) still
# encloses something and keeps every face of `earlier` facing the same way.
function bim mesh {bim mesh record:pushed} stays sound after {bim mesh record:earlier}:
    execute:
        if (the bim signed volume of mesh pushed) <= 1e-9:
            return false
        set start to 0
        loop while start < the length of (earlier's faces's values):
            if start < the length of (pushed's faces's values):
                if (the cad dot of (the bim normal of mesh face start of earlier) and (the bim normal of mesh face start of pushed)) < 0.0:
                    return false
            set start to start + ((the item at start in (earlier's faces's values)) + 1)
        return true

# The profile ring of `linear` (of `linearType`) at both ends of its axis, in
# model coordinates: `count` corners at the start, then `count` at the
# finish, each ring turning anticlockwise about the axis. The width lies
# level across the axis (along x for an upright axis), the depth square to
# both, turned by the element's angle; a round profile has 24 corners.
function the bim profile rings of {bim linear record:linearValue} as {bim linear type record:linearType} in {bim model record:modelValue}:
    execute:
        return the bim profile rings of linearValue as linearType in modelValue at 24 round corners

# The corners a circle of `radius` needs so that no chord leaves it by more
# than `tolerance`: the sagitta r (1 - cos(pi / n)) is about r (pi / n)^2 / 2,
# so n = pi / sqrt(2 tolerance / r); from 12 to 256, a multiple of 4.
function the bim round corners for radius {a 64 bit floating-point number:circleRadius} within {a 64 bit floating-point number:chordTolerance}:
    execute:
        if (circleRadius <= 0.0) or (chordTolerance <= 0.0):
            return 24
        set ratio to (2.0 * chordTolerance) / circleRadius
        if ratio >= 1.0:
            return 12
        set needed to 3.141592653589793 / (the square root of ratio)
        set cornerCount to 12
        loop while (cornerCount < 256) and ((cornerCount as a 64 bit floating-point number) < needed):
            set cornerCount to cornerCount + 4
        return cornerCount

# The profile rings with `roundCorners` corners on a round profile.
function the bim profile rings of {bim linear record:linearValue} as {bim linear type record:linearType} in {bim model record:modelValue} at {integer:roundCorners} round corners:
    execute:
        return the bim profile rings of linearValue as linearType in modelValue at roundCorners round corners cut by (a bim uncut end)

# The same, each end's ring slid along the axis onto its join's cut plane
# (`the bim end cuts of parts`) where it has one.
function the bim profile rings of {bim linear record:linearValue} as {bim linear type record:linearType} in {bim model record:modelValue} at {integer:roundCorners} round corners cut by {bim end cut record:automaticCuts}:
    execute:
        set endCut to the bim explicit cuts of linearValue's id after automaticCuts in modelValue
        set profileRings to an empty list of a cad vector3
        set linearFrame to the bim frame of linear linearValue in modelValue
        # The outline of its profile (`bim_profiles.dl`): a rectangle or a
        # circle, or an I, L, U, T, C or Z shape, a hollow section's outside.
        set profileCorners to an empty list of a cad vector2
        set profileShapes to the bim rings of linear type linearType in modelValue at roundCorners round corners
        set outerRing to the item at 0 in profileShapes
        loop cursor from 0 to the length of outerRing:
            append (the item at cursor in outerRing) to profileCorners
        loop shapeCursor from 0 to the length of profileShapes:
            free (the item at shapeCursor in profileShapes)
        free profileShapes
        loop endCursor from 0 to 2:
            set centre to linearFrame's first
            set cutting to endCut's startCut
            set planePoint to endCut's startPoint
            set planeNormal to endCut's startNormal
            if endCursor = 1:
                set centre to linearFrame's last
                set cutting to endCut's finishCut
                set planePoint to endCut's finishPoint
                set planeNormal to endCut's finishNormal
            set slope to the cad dot of linearFrame's along and planeNormal
            # At the finish the profile is scaled by the taper and turned by
            # the twist.
            set scaleX to 1.0
            set scaleY to 1.0
            set twistCosine to 1.0
            set twistSine to 0.0
            if endCursor = 1:
                set scaleX to linearValue's taper's x
                set scaleY to linearValue's taper's y
                set twistCosine to the cosine of linearValue's twist
                set twistSine to the sine of linearValue's twist
            loop cursor from 0 to the length of profileCorners:
                set original to the item at cursor in profileCorners
                set stretchedX to original's x * scaleX
                set stretchedY to original's y * scaleY
                set corner to a cad vector2 with x ((stretchedX * twistCosine) - (stretchedY * twistSine)) and y ((stretchedX * twistSine) + (stretchedY * twistCosine))
                set placed to the cad sum of centre and (the cad sum of (linearFrame's widthAxis scaled by corner's x) and (linearFrame's depthAxis scaled by corner's y))
                if cutting and ((the absolute value of slope) > 0.05):
                    set slide to (the cad dot of (the cad difference of planePoint and placed) and planeNormal) / slope
                    set placed to the cad sum of placed and (linearFrame's along scaled by slide)
                append placed to profileRings
        free profileCorners
        return profileRings

# The triangles of `linear`: its type's profile swept along its axis, each
# side flat, closed by its two ends.
function the bim linear shape of {bim linear record:linearValue} in {bim model record:modelValue}:
    execute:
        return the bim linear shape of linearValue in modelValue within 0.0

# The same, a round profile fine enough that it leaves the circle by at most
# `tolerance` (24 corners for a tolerance of 0).
function the bim linear shape of {bim linear record:linearValue} in {bim model record:modelValue} within {a 64 bit floating-point number:tolerance}:
    execute:
        return the bim linear shape of linearValue typed (the bim type of linear linearValue in modelValue) in modelValue within tolerance

# The same for a linear element of `linearType` given (a stair's tread or
# stringer, which the model does not store).
function the bim linear shape of {bim linear record:linearValue} typed {bim linear type record:linearType} in {bim model record:modelValue} within {a 64 bit floating-point number:tolerance}:
    execute:
        return the bim linear shape of linearValue typed linearType in modelValue within tolerance cut by (a bim uncut end)

# The same with its ends cut by its joins.
function the bim linear shape of {bim linear record:linearValue} typed {bim linear type record:linearType} in {bim model record:modelValue} within {a 64 bit floating-point number:tolerance} cut by {bim end cut record:automaticCuts}:
    execute:
        set endCut to the bim explicit cuts of linearValue's id after automaticCuts in modelValue
        if (the absolute value of linearValue's twist) <= 1e-9:
            return the bim swept shape of linearValue typed linearType in modelValue within tolerance cut by endCut
        # A twisted element: short pieces of at most 15 degrees each, every
        # piece starting where the last turned and scaled to, so that its
        # edges follow helices rather than straight lines.
        set pieceCount to (the ceiling of ((the absolute value of linearValue's twist) / 0.2617993877991494)) as an integer
        set combined to an empty fast mesh
        loop pieceCursor from 0 to pieceCount:
            set fromShare to (pieceCursor as a 64 bit floating-point number) / (pieceCount as a 64 bit floating-point number)
            set toShare to ((pieceCursor + 1) as a 64 bit floating-point number) / (pieceCount as a 64 bit floating-point number)
            set fromScaleX to 1.0 + ((linearValue's taper's x - 1.0) * fromShare)
            set fromScaleY to 1.0 + ((linearValue's taper's y - 1.0) * fromShare)
            set toScaleX to 1.0 + ((linearValue's taper's x - 1.0) * toShare)
            set toScaleY to 1.0 + ((linearValue's taper's y - 1.0) * toShare)
            set piece to linearValue
            set piece's start to the cad sum of linearValue's start and ((the cad difference of linearValue's finish and linearValue's start) scaled by fromShare)
            set piece's finish to the cad sum of linearValue's start and ((the cad difference of linearValue's finish and linearValue's start) scaled by toShare)
            set piece's angle to linearValue's angle + (linearValue's twist * fromShare)
            set piece's twist to linearValue's twist * (toShare - fromShare)
            set piece's taper to a cad vector2 with x (toScaleX / fromScaleX) and y (toScaleY / fromScaleY)
            set pieceType to linearType
            set pieceType's width to linearType's width * fromScaleX
            set pieceType's depth to linearType's depth * fromScaleY
            set pieceCut to a bim uncut end
            if pieceCursor = 0:
                set pieceCut's startCut to endCut's startCut
                set pieceCut's startPoint to endCut's startPoint
                set pieceCut's startNormal to endCut's startNormal
            if pieceCursor = (pieceCount - 1):
                set pieceCut's finishCut to endCut's finishCut
                set pieceCut's finishPoint to endCut's finishPoint
                set pieceCut's finishNormal to endCut's finishNormal
            set pieceShape to the bim swept shape of piece typed pieceType in modelValue within tolerance cut by pieceCut
            set base to the length of (combined's positions's values)
            loop corner from 0 to the length of (pieceShape's positions's values):
                append (the item at corner in (pieceShape's positions's values)) to (combined's positions's values)
                append (the item at corner in (pieceShape's normals's values)) to (combined's normals's values)
            loop corner from 0 to the length of (pieceShape's triangles's values):
                append (base + (the item at corner in (pieceShape's triangles's values))) to (combined's triangles's values)
        return combined

# Profile point `flat` (in the profile's coordinates) of `linear` placed at
# its start (`endIndex` 0) or finish (1), as `the bim profile rings of`
# places its corners: scaled by the taper and turned by the twist at the
# finish, slid along the axis onto a cut end's plane.
function the bim placed profile point {cad vector2:flat} of {bim linear record:linearValue} framed {bim linear frame record:linearFrame} at end {integer:endIndex} cut by {bim end cut record:endCut}:
    execute:
        set centre to linearFrame's first
        set cutting to endCut's startCut
        set planePoint to endCut's startPoint
        set planeNormal to endCut's startNormal
        set stretchedX to flat's x
        set stretchedY to flat's y
        set corner to flat
        if endIndex = 1:
            set centre to linearFrame's last
            set cutting to endCut's finishCut
            set planePoint to endCut's finishPoint
            set planeNormal to endCut's finishNormal
            set stretchedX to flat's x * linearValue's taper's x
            set stretchedY to flat's y * linearValue's taper's y
            set corner to a cad vector2 with x ((stretchedX * (the cosine of linearValue's twist)) - (stretchedY * (the sine of linearValue's twist))) and y ((stretchedX * (the sine of linearValue's twist)) + (stretchedY * (the cosine of linearValue's twist)))
        set pointPlaced to the cad sum of centre and (the cad sum of (linearFrame's widthAxis scaled by corner's x) and (linearFrame's depthAxis scaled by corner's y))
        set slope to the cad dot of linearFrame's along and planeNormal
        if cutting and ((the absolute value of slope) > 0.05):
            set slide to (the cad dot of (the cad difference of planePoint and pointPlaced) and planeNormal) / slope
            set pointPlaced to the cad sum of pointPlaced and (linearFrame's along scaled by slide)
        return pointPlaced

# One straight sweep of `linearType`'s profile along `linear`, its finish's
# profile scaled and turned by the element's taper and twist.
function the bim swept shape of {bim linear record:linearValue} typed {bim linear type record:linearType} in {bim model record:modelValue} within {a 64 bit floating-point number:tolerance} cut by {bim end cut record:endCut}:
    execute:
        set triangles to an empty fast mesh
        set roundCorners to the bim round corners for radius (linearType's width * 0.5) within tolerance
        set profileRings to the bim profile rings of linearValue as linearType in modelValue at roundCorners round corners cut by endCut
        set holes to the bim connection perforations of linearValue's id in modelValue
        if (the length of (holes's values)) > 0:
            set stockValue to the connection stock from profileRings
            free profileRings
            if stockValue's valid = false:
                return triangles
            set drilled to the connection stock stockValue's value perforated by (holes's values)
            return the bim component mesh of drilled within 0.001
        set count to (the length of profileRings) / 2
        set first to the item at 0 in profileRings
        set last to the item at count in profileRings
        set along to the cad difference of last and first
        set along to along scaled by (1.0 / (the cad length of along))
        set twisted to (the absolute value of linearValue's twist) > 1e-9
        # Each ring of the profile (its outline, a hollow section's hole
        # too) placed at both ends, and its sides between them.
        set linearFrame to the bim frame of linear linearValue in modelValue
        set profileShapes to the bim rings of linear type linearType in modelValue at roundCorners round corners
        loop shapeCursor from 0 to the length of profileShapes:
            set shapeRing to the item at shapeCursor in profileShapes
            set ringCount to the length of shapeRing
            set placedRing to an empty list of a cad vector3
            loop endCursor from 0 to 2:
                loop cursor from 0 to ringCount:
                    append (the bim placed profile point (the item at cursor in shapeRing) of linearValue framed linearFrame at end endCursor cut by endCut) to placedRing
            loop cursor from 0 to ringCount:
                set following to the remainder of (cursor + 1) divided by ringCount
                set a to the item at cursor in placedRing
                set b to the item at following in placedRing
                set c to the item at (ringCount + following) in placedRing
                set d to the item at (ringCount + cursor) in placedRing
                set side to the cad cross of (the cad difference of b and a) and along
                set side to side scaled by (1.0 / (the maximum of 1e-12 and (the cad length of side)))
                set base to the length of (triangles's positions's values)
                append a to (triangles's positions's values)
                append b to (triangles's positions's values)
                append c to (triangles's positions's values)
                append d to (triangles's positions's values)
                loop corner from 0 to 4:
                    append side to (triangles's normals's values)
                if twisted:
                    # A twisted side is not flat: a fan about its centre keeps
                    # it from cutting into the solid along one diagonal.
                    append ((the cad sum of (the cad sum of a and b) and (the cad sum of c and d)) scaled by 0.25) to (triangles's positions's values)
                    append side to (triangles's normals's values)
                    loop corner from 0 to 4:
                        append (base + corner) to (triangles's triangles's values)
                        append (base + ((the remainder of (corner + 1) divided by 4))) to (triangles's triangles's values)
                        append (base + 4) to (triangles's triangles's values)
                else:
                    append base to (triangles's triangles's values)
                    append (base + 1) to (triangles's triangles's values)
                    append (base + 2) to (triangles's triangles's values)
                    append base to (triangles's triangles's values)
                    append (base + 2) to (triangles's triangles's values)
                    append (base + 3) to (triangles's triangles's values)
            free placedRing
        # The ends: the profile triangulated (its holes left open), the start
        # facing back along the axis, the finish forward; a cut end faces out
        # along its cut plane's normal.
        set holeRings to an empty list of the type of (an empty list of a cad vector2)
        loop shapeCursor from 1 to the length of profileShapes:
            append (the bim profile reversed ring (the item at shapeCursor in profileShapes)) to holeRings
        set flat to the cad triangulation of (the item at 0 in profileShapes) with holes holeRings
        set backward to along scaled by -1.0
        loop endCursor from 0 to 2:
            set base to the length of (triangles's positions's values)
            set facing to backward
            if endCut's startCut and (endCursor = 0):
                set facing to endCut's startNormal
                if (the cad dot of facing and along) > 0.0:
                    set facing to facing scaled by -1.0
            if endCursor = 1:
                set facing to along
                if endCut's finishCut:
                    set facing to endCut's finishNormal
                    if (the cad dot of facing and along) < 0.0:
                        set facing to facing scaled by -1.0
            loop cursor from 0 to the length of (the points of flat):
                append (the bim placed profile point (the item at cursor in (the points of flat)) of linearValue framed linearFrame at end endCursor cut by endCut) to (triangles's positions's values)
                append facing to (triangles's normals's values)
            loop face from 0 to the length of (the triangles of flat):
                set triple to the item at face in (the triangles of flat)
                append (base + (the first of triple)) to (triangles's triangles's values)
                if endCursor = 1:
                    append (base + (the second of triple)) to (triangles's triangles's values)
                    append (base + (the third of triple)) to (triangles's triangles's values)
                else:
                    append (base + (the third of triple)) to (triangles's triangles's values)
                    append (base + (the second of triple)) to (triangles's triangles's values)
        free cad triangulation flat
        loop shapeCursor from 0 to the length of holeRings:
            free (the item at shapeCursor in holeRings)
        free holeRings
        loop shapeCursor from 0 to the length of profileShapes:
            free (the item at shapeCursor in profileShapes)
        free profileShapes
        free profileRings
        return triangles

# What `linear` covers seen from above: the outline (anticlockwise) of its
# swept profile's corners.
function the bim plan outline of linear {bim linear record:linearValue} in {bim model record:modelValue}:
    execute:
        return the bim plan outline of linear linearValue typed (the bim type of linear linearValue in modelValue) in modelValue

function the bim plan outline of linear {bim linear record:linearValue} typed {bim linear type record:linearType} in {bim model record:modelValue}:
    execute:
        return the bim plan outline of linear linearValue typed linearType in modelValue cut by (a bim uncut end)

# The same with its ends cut by its joins.
function the bim plan outline of linear {bim linear record:linearValue} typed {bim linear type record:linearType} in {bim model record:modelValue} cut by {bim end cut record:endCut}:
    execute:
        set profileRings to the bim profile rings of linearValue as linearType in modelValue at 24 round corners cut by endCut
        set flat to an empty list of a cad vector2
        loop cursor from 0 to the length of profileRings:
            set spot to the item at cursor in profileRings
            append (a cad vector2 with x spot's x and y spot's y) to flat
        # Standing upright, it is seen from above as its profile (an H, an
        # L, a hollow section's outside), not its hull.
        set ringCount to (the length of profileRings) / 2
        set rise to the cad difference of (the item at ringCount in profileRings) and (the item at 0 in profileRings)
        free profileRings
        if (ringCount >= 3) and ((the absolute value of rise's z) >= (0.99 * (the cad length of rise))):
            set footprint to an empty list of a cad vector2
            loop cursor from 0 to ringCount:
                append (the item at cursor in flat) to footprint
            free flat
            return footprint
        # The hull, by gift wrapping (few points).
        set hull to an empty list of a cad vector2
        set lowest to 0
        loop cursor from 1 to the length of flat:
            set here to the item at cursor in flat
            set best to the item at lowest in flat
            if (here's x < best's x) or ((here's x = best's x) and (here's y < best's y)):
                set lowest to cursor
        set currentIndex to lowest
        set guard to 0
        set wrapping to true
        loop while wrapping:
            append (the item at currentIndex in flat) to hull
            set candidate to 0
            if candidate = currentIndex:
                set candidate to 1
            loop cursor from 0 to the length of flat:
                if cursor != currentIndex:
                    set origin to the item at currentIndex in flat
                    set toCandidate to the item at candidate in flat
                    set toCursor to the item at cursor in flat
                    set turnValue to ((toCandidate's x - origin's x) * (toCursor's y - origin's y)) - ((toCandidate's y - origin's y) * (toCursor's x - origin's x))
                    set further to (the cad distance from origin to toCursor) > (the cad distance from origin to toCandidate)
                    if (turnValue < -1e-12) or (((the absolute value of turnValue) <= 1e-12) and further):
                        set candidate to cursor
            set currentIndex to candidate
            set guard to guard + 1
            if (currentIndex = lowest) or (guard > (the length of flat)):
                set wrapping to false
        free flat
        return hull

# The lowest and highest height `linear` reaches, as (low, high).
function the bim height range of linear {bim linear record:linearValue} in {bim model record:modelValue}:
    execute:
        return the bim height range of linear linearValue typed (the bim type of linear linearValue in modelValue) in modelValue

function the bim height range of linear {bim linear record:linearValue} typed {bim linear type record:linearType} in {bim model record:modelValue}:
    execute:
        set profileRings to the bim profile rings of linearValue as linearType in modelValue
        set low to 1.0 / 0.0
        set high to 0.0 - (1.0 / 0.0)
        loop cursor from 0 to the length of profileRings:
            set low to the minimum of low and (the item at cursor in profileRings)'s z
            set high to the maximum of high and (the item at cursor in profileRings)'s z
        free profileRings
        return a cad vector2 with x low and y high

# The view category of a linear element of `roleCode`: columns and beams
# their own, the others as other elements.
function the bim category of linear role {integer:roleCode}:
    execute:
        if roleCode = bim column role:
            return bim column category
        if roleCode = bim beam role:
            return bim beam category
        if roleCode = bim pile role:
            return bim pile category
        return bim other category

# The triangles of all of a stair's derived parts, in model coordinates.
function the bim stair shape of {bim stair record:stairValue} in {bim model record:modelValue} within {a 64 bit floating-point number:tolerance}:
    execute:
        set stairParts to the bim parts of stair stairValue in modelValue
        return the bim shape of derived parts (stairParts's values) in modelValue within tolerance

# The same for a railing.
function the bim railing shape of {bim railing record:railingValue} in {bim model record:modelValue} within {a 64 bit floating-point number:tolerance}:
    execute:
        set railingParts to the bim parts of railing railingValue in modelValue
        return the bim shape of derived parts (railingParts's values) in modelValue within tolerance

# The same for a curtain wall: its parts, then the panels its contour cuts.
function the bim curtain shape of {bim curtain record:curtainValue} in {bim model record:modelValue} within {a 64 bit floating-point number:tolerance}:
    execute:
        set combined to the bim framed shape of curtainValue in modelValue within tolerance
        set cutPanels to the bim contour panels of curtainValue in modelValue
        if (the length of (cutPanels's values)) = 0:
            return combined
        set placement to the bim placed system curtainValue in modelValue
        set noHoles to an empty list of the type of (an empty list of a cad vector2)
        loop panelCursor from 0 to the length of (cutPanels's values):
            set cutPanel to the item at panelCursor in (cutPanels's values)
            # Its layers stacked across the face as an uncut panel's, or
            # glass.
            set layerStarts to an empty list of a 64 bit floating-point number
            set layerDepths to an empty list of a 64 bit floating-point number
            set layered to the bim wall type index of cutPanel's typeId in modelValue
            if layered's valid:
                set planarType to the item at layered's position in (modelValue's wallTypes's values)
                set reached to (the bim thickness of planarType) * -0.5
                loop layerCursor from 0 to the length of (planarType's layers's values):
                    set layer to the item at layerCursor in (planarType's layers's values)
                    append reached to layerStarts
                    append layer's thickness to layerDepths
                    set reached to reached + layer's thickness
            else:
                append ((the bim glass thickness) * -0.5) to layerStarts
                append (the bim glass thickness) to layerDepths
            loop layerCursor from 0 to the length of layerStarts:
                set built to the fast prism over (cutPanel's outline's values) with holes noHoles from (the item at layerCursor in layerStarts) rising (the item at layerCursor in layerDepths) within 0.0001
                if built's reason = fast prism built:
                    set local to an empty fast mesh
                    append fast mesh of built's shape to (the address of local)
                    set placedPanel to the bim face mesh of local on placement's curtain lifted placement's lift in modelValue
                    set base to the length of (combined's positions's values)
                    loop corner from 0 to the length of (placedPanel's positions's values):
                        append (the item at corner in (placedPanel's positions's values)) to (combined's positions's values)
                        append (the item at corner in (placedPanel's normals's values)) to (combined's normals's values)
                    loop corner from 0 to the length of (placedPanel's triangles's values):
                        append (base + (the item at corner in (placedPanel's triangles's values))) to (combined's triangles's values)
            free layerStarts
            free layerDepths
        return combined

# A piece of a building system's shape all of one material, so that the 3D
# view colours each: its frame (or a masonry's mortar joints) in the
# system's material, its panels (bricks, boards, glass) in theirs.
class:
    patterns:
        [a|] bim material shape record
    members:
        material as a string
        shape as a fast mesh record

# Mesh `addition` added to `target`.
function append bim triangles {fast mesh record:addition} onto {a pointer to a fast mesh record:target}:
    execute:
        set base to the length of (target's positions's values)
        loop corner from 0 to the length of (addition's positions's values):
            append (the item at corner in (addition's positions's values)) to (target's positions's values)
            append (the item at corner in (addition's normals's values)) to (target's normals's values)
        loop corner from 0 to the length of (addition's triangles's values):
            append (base + (the item at corner in (addition's triangles's values))) to (target's triangles's values)

# Mesh `addition` added to the piece of `material` in `pieceList`, or as a
# new piece.
function add bim coloured piece {fast mesh record:addition} of {a string:material} to {a pointer to a list:pieceList}:
    execute:
        loop cursor from 0 to the length of pieceList:
            set existing to the item at cursor in pieceList
            if existing's material = material:
                append bim triangles addition onto (the address of (existing's shape))
                replace item at index cursor in pieceList with existing
                return nothing
        set fresh to an empty fast mesh
        append bim triangles addition onto (the address of fresh)
        append (@intrinsic("construct", a bim material shape record, material, fresh)) to pieceList

# The shape of building system `curtainValue` (as `the bim curtain shape
# of`) in pieces of one material each: its parts grouped by their
# materials, its merged joints in the system's, the panels its contour cuts
# in their layers' (glass when untyped).
function the bim curtain pieces of {bim curtain record:curtainValue} in {bim model record:modelValue} within {a 64 bit floating-point number:tolerance}:
    execute:
        set pieceList to a cad topology list of a bim material shape record
        set curtainParts to the bim parts of curtain wall curtainValue in modelValue
        set merging to ((the bim setting (bim merged joints setting) of curtainValue's id in modelValue)'s value) = (1 as a 64 bit integer)
        set placement to the bim placed system curtainValue in modelValue
        set jointsMerged to merging
        if (the bim system path of placement's curtain)'s curved and (bim system placement's curtain's id lies level in modelValue):
            set jointsMerged to false
        set kept to a cad topology list of a bim stair part record
        set materials to an empty list of a string
        loop cursor from 0 to the length of (curtainParts's values):
            set part to the item at cursor in (curtainParts's values)
            set isJoint to (part's kind's name = (the string form of "Mullion")) or (part's kind's name = (the string form of "Transom"))
            if (jointsMerged and isJoint) = false:
                append part to (kept's values)
                set known to false
                loop materialCursor from 0 to the length of materials:
                    if (the item at materialCursor in materials) = part's kind's material:
                        set known to true
                if known = false:
                    append part's kind's material to materials
        loop materialCursor from 0 to the length of materials:
            set wanted to the item at materialCursor in materials
            set group to a cad topology list of a bim stair part record
            loop cursor from 0 to the length of (kept's values):
                set part to the item at cursor in (kept's values)
                if part's kind's material = wanted:
                    append part to (group's values)
            add bim coloured piece (the bim shape of derived parts (group's values) in modelValue within tolerance) of wanted to (pieceList's values)
        if jointsMerged:
            set jointBody to the bim merged joints of placement's curtain lifted placement's lift among (kept's values) in modelValue
            add bim coloured piece jointBody of curtainValue's material to (pieceList's values)
        free materials
        set cutPanels to the bim contour panels of curtainValue in modelValue
        set noHoles to an empty list of the type of (an empty list of a cad vector2)
        loop panelCursor from 0 to the length of (cutPanels's values):
            set cutPanel to the item at panelCursor in (cutPanels's values)
            set layerStarts to an empty list of a 64 bit floating-point number
            set layerDepths to an empty list of a 64 bit floating-point number
            set layerMaterials to an empty list of a string
            set layered to the bim wall type index of cutPanel's typeId in modelValue
            if layered's valid:
                set planarType to the item at layered's position in (modelValue's wallTypes's values)
                set reached to (the bim thickness of planarType) * -0.5
                loop layerCursor from 0 to the length of (planarType's layers's values):
                    set layer to the item at layerCursor in (planarType's layers's values)
                    append reached to layerStarts
                    append layer's thickness to layerDepths
                    append layer's material to layerMaterials
                    set reached to reached + layer's thickness
            else:
                append ((the bim glass thickness) * -0.5) to layerStarts
                append (the bim glass thickness) to layerDepths
                append (the string form of "glass") to layerMaterials
            loop layerCursor from 0 to the length of layerStarts:
                set built to the fast prism over (cutPanel's outline's values) with holes noHoles from (the item at layerCursor in layerStarts) rising (the item at layerCursor in layerDepths) within 0.0001
                if built's reason = fast prism built:
                    set local to an empty fast mesh
                    append fast mesh of built's shape to (the address of local)
                    add bim coloured piece (the bim face mesh of local on placement's curtain lifted placement's lift in modelValue) of (the item at layerCursor in layerMaterials) to (pieceList's values)
            free layerStarts
            free layerDepths
            free layerMaterials
        return pieceList

# A curtain wall's parts together, its joints merged into one body when it
# says so.
function the bim framed shape of {bim curtain record:curtainValue} in {bim model record:modelValue} within {a 64 bit floating-point number:tolerance}:
    execute:
        set curtainParts to the bim parts of curtain wall curtainValue in modelValue
        set merging to ((the bim setting (bim merged joints setting) of curtainValue's id in modelValue)'s value) = (1 as a 64 bit integer)
        set placement to the bim placed system curtainValue in modelValue
        if (merging = false) or ((the bim system path of placement's curtain)'s curved and (bim system placement's curtain's id lies level in modelValue)):
            return the bim shape of derived parts (curtainParts's values) in modelValue within tolerance
        # Merged joints: the parts but the joints, and the joints as one body.
        set others to a cad topology list of a bim stair part record
        loop cursor from 0 to the length of (curtainParts's values):
            set part to the item at cursor in (curtainParts's values)
            if (part's kind's name != (the string form of "Mullion")) and (part's kind's name != (the string form of "Transom")):
                append part to (others's values)
        set combined to the bim shape of derived parts (others's values) in modelValue within tolerance
        set jointBody to the bim merged joints of placement's curtain lifted placement's lift among (others's values) in modelValue
        set base to the length of (combined's positions's values)
        loop corner from 0 to the length of (jointBody's positions's values):
            append (the item at corner in (jointBody's positions's values)) to (combined's positions's values)
            append (the item at corner in (jointBody's normals's values)) to (combined's normals's values)
        loop corner from 0 to the length of (jointBody's triangles's values):
            append (base + (the item at corner in (jointBody's triangles's values))) to (combined's triangles's values)
        return combined

# Where the edge from `one` to `other` crosses the plane x = `planeX`: worked
# from the edge's lesser end, so both triangles on an edge get the same point.
function the bim slice crossing of {cad vector3:one} and {cad vector3:other} at {a 64 bit floating-point number:planeX}:
    execute:
        set low to one
        set high to other
        if (other's x < one's x) or ((other's x = one's x) and ((other's y < one's y) or ((other's y = one's y) and (other's z < one's z)))):
            set low to other
            set high to one
        set share to (planeX - low's x) / (high's x - low's x)
        return a cad vector3 with x planeX, y (low's y + ((high's y - low's y) * share)) and z (low's z + ((high's z - low's z) * share))

# Which side of the plane x = `planeX` `spot` lies on: -1, 1, or 0 on it.
function the bim slice side of {cad vector3:spot} at {a 64 bit floating-point number:planeX}:
    execute:
        if spot's x < (planeX - 1e-9):
            return -1
        if spot's x > (planeX + 1e-9):
            return 1
        return 0

# The triangles of `shape` cut by the planes x = k `step` (every whole k),
# so that none spans more than `step` along x. An edge is cut at the same
# point from both its sides, so a closed mesh stays closed.
function the bim mesh {fast mesh record:shape} sliced every {a 64 bit floating-point number:step}:
    execute:
        set slicedMesh to an empty fast mesh
        set waiting to an empty list of a cad vector3
        set waitingFacing to an empty list of a cad vector3
        set cornerCursor to 0
        loop while (cornerCursor + 2) < the length of (shape's triangles's values):
            loop side from 0 to 3:
                append (the item at (the item at (cornerCursor + side) in (shape's triangles's values)) in (shape's positions's values)) to waiting
            append (the item at (the item at cornerCursor in (shape's triangles's values)) in (shape's normals's values)) to waitingFacing
            set cornerCursor to cornerCursor + 3
        set readCursor to 0
        loop while (readCursor + 2) < the length of waiting:
            set facing to the item at (readCursor / 3) in waitingFacing
            set lowestX to (the item at readCursor in waiting)'s x
            set highestX to lowestX
            loop side from 1 to 3:
                set lowestX to the minimum of lowestX and ((the item at (readCursor + side) in waiting)'s x)
                set highestX to the maximum of highestX and ((the item at (readCursor + side) in waiting)'s x)
            set planeX to ((the floor of (lowestX / step)) + 1.0) * step
            if planeX <= (lowestX + 1e-9):
                set planeX to planeX + step
            if planeX < (highestX - 1e-9):
                # Split in two polygons, the part below the plane and the
                # part above, each fanned into triangles that wait in turn.
                set lowerPart to an empty list of a cad vector3
                set upperPart to an empty list of a cad vector3
                loop side from 0 to 3:
                    set here to the item at (readCursor + side) in waiting
                    set onward to the item at (readCursor + (the remainder of (side + 1) divided by 3)) in waiting
                    set hereSide to the bim slice side of here at planeX
                    set onwardSide to the bim slice side of onward at planeX
                    if hereSide <= 0:
                        append here to lowerPart
                    if hereSide >= 0:
                        append here to upperPart
                    if (hereSide * onwardSide) < 0:
                        set cutPoint to the bim slice crossing of here and onward at planeX
                        append cutPoint to lowerPart
                        append cutPoint to upperPart
                loop half from 0 to 2:
                    set polygon to lowerPart
                    if half = 1:
                        set polygon to upperPart
                    loop fan from 1 to ((the length of polygon) - 1):
                        append (the item at 0 in polygon) to waiting
                        append (the item at fan in polygon) to waiting
                        append (the item at (fan + 1) in polygon) to waiting
                        append facing to waitingFacing
                free lowerPart
                free upperPart
            else:
                set base to the length of (slicedMesh's positions's values)
                loop side from 0 to 3:
                    append (the item at (readCursor + side) in waiting) to (slicedMesh's positions's values)
                    append facing to (slicedMesh's normals's values)
                    append (base + side) to (slicedMesh's triangles's values)
            set readCursor to readCursor + 3
        free waiting
        free waitingFacing
        return slicedMesh

# Mesh `local`, in building system `curtainValue`'s face coordinates (x
# along its line, y up its face, z across it toward its exterior; lying
# level: across the line to its left, z up), put in place `lift` higher. On
# a curved line it is cut every 5 degrees along it, then bent onto the arc.
function the bim face mesh of {fast mesh record:local} on {bim curtain record:curtainValue} lifted {a 64 bit floating-point number:lift} in {bim model record:modelValue}:
    execute:
        set placed to an empty fast mesh
        set wallLength to the maximum of 1e-9 and (the bim system length of curtainValue)
        set flat to bim system curtainValue's id lies level in modelValue
        set flatHeight to ((the bim setting (bim system level setting) of curtainValue's id in modelValue)'s value as a 64 bit floating-point number) / 1000.0
        set ux to (curtainValue's finish's x - curtainValue's start's x) / wallLength
        set uy to (curtainValue's finish's y - curtainValue's start's y) / wallLength
        set shaped to local
        set course to the bim system path of curtainValue
        set bending to course's curved and (flat = false)
        if bending:
            # A curved line: cut every 5 degrees along it, then bent
            # onto the arc.
            set shaped to the bim mesh local sliced every (the maximum of 0.02 and (course's radius * 0.08726646259971647))
        # Into place: along the line, up the face (or across it lying
        # level), the depth across (or up).
        loop cursor from 0 to the length of (shaped's positions's values):
            set spot to the item at cursor in (shaped's positions's values)
            set facing to the item at cursor in (shaped's normals's values)
            if flat:
                append (a cad vector3 with x ((curtainValue's start's x + (ux * spot's x)) - (uy * spot's y)), y ((curtainValue's start's y + (uy * spot's x)) + (ux * spot's y)) and z ((flatHeight + lift) + spot's z)) to (placed's positions's values)
                append (a cad vector3 with x ((ux * facing's x) - (uy * facing's y)), y ((uy * facing's x) + (ux * facing's y)) and z facing's z) to (placed's normals's values)
            else if bending:
                set onLine to the bim system point at spot's x of curtainValue
                set bearing to the bim system heading at spot's x of curtainValue
                set bearingCosine to the cosine of bearing
                set bearingSine to the sine of bearing
                append (a cad vector3 with x (onLine's x + (bearingSine * spot's z)), y (onLine's y - (bearingCosine * spot's z)) and z (lift + spot's y)) to (placed's positions's values)
                append (a cad vector3 with x ((bearingCosine * facing's x) + (bearingSine * facing's z)), y ((bearingSine * facing's x) - (bearingCosine * facing's z)) and z facing's y) to (placed's normals's values)
            else:
                append (a cad vector3 with x ((curtainValue's start's x + (ux * spot's x)) + (uy * spot's z)), y ((curtainValue's start's y + (uy * spot's x)) - (ux * spot's z)) and z (lift + spot's y)) to (placed's positions's values)
                append (a cad vector3 with x ((ux * facing's x) + (uy * facing's z)), y ((uy * facing's x) - (ux * facing's z)) and z facing's y) to (placed's normals's values)
        loop cursor from 0 to the length of (shaped's triangles's values):
            append (the item at cursor in (shaped's triangles's values)) to (placed's triangles's values)
        return placed

# A building system's joints as one body: its face (out to the
# joints' outer edges) with a hole for every cell (each of `cellParts` read
# back to its rectangle on the face) and every rough opening, as deep as its
# joints and centred on its line; standing `lift` metres up, or lying level.
function the bim merged joints of {bim curtain record:curtainValue} lifted {a 64 bit floating-point number:lift} among {a pointer to a list:cellParts} in {bim model record:modelValue}:
    execute:
        set jointMesh to an empty fast mesh
        set jointWidth to the bim joint width of system curtainValue's id in modelValue
        set jointDepth to the bim joint depth of system curtainValue's id in modelValue
        set wallLength to the bim system length of curtainValue
        if ((jointWidth <= 0.0005) or (jointDepth <= 0.0005)) or (wallLength < 1e-9):
            return jointMesh
        set flat to bim system curtainValue's id lies level in modelValue
        set flatHeight to ((the bim setting (bim system level setting) of curtainValue's id in modelValue)'s value as a 64 bit floating-point number) / 1000.0
        set ux to (curtainValue's finish's x - curtainValue's start's x) / wallLength
        set uy to (curtainValue's finish's y - curtainValue's start's y) / wallLength
        set half to jointWidth * 0.5
        # The face, in its own coordinates (along the line, up the face):
        # its contour, or its rectangle out to the joints' outer edges.
        set outline to the bim face contour of curtainValue's id in modelValue
        if (the length of outline) < 3:
            free outline
            set outline to an empty list of a cad vector2
            append (a cad vector2 with x (0.0 - half) and y (0.0 - half)) to outline
            append (a cad vector2 with x (wallLength + half) and y (0.0 - half)) to outline
            append (a cad vector2 with x (wallLength + half) and y (curtainValue's height + half)) to outline
            append (a cad vector2 with x (0.0 - half) and y (curtainValue's height + half)) to outline
        set holes to an empty list of the type of (an empty list of a cad vector2)
        set seen to an empty list of a cad vector2
        loop cursor from 0 to the length of cellParts:
            set part to the item at cursor in cellParts
            if part's kind's name != (the string form of "Point"):
                set foot to part's element's start
                set head to part's element's finish
                set centreAlong to (the bim system station of (a cad vector2 with x foot's x and y foot's y) on curtainValue)'s x
                set fromUp to foot's z - lift
                set toUp to head's z - lift
                if flat:
                    set centreAlong to ((((foot's x + head's x) * 0.5) - curtainValue's start's x) * ux) + ((((foot's y + head's y) * 0.5) - curtainValue's start's y) * uy)
                    set fromUp to (((foot's x - curtainValue's start's x) * (0.0 - uy)) + ((foot's y - curtainValue's start's y) * ux))
                    set toUp to (((head's x - curtainValue's start's x) * (0.0 - uy)) + ((head's y - curtainValue's start's y) * ux))
                set fromAlong to centreAlong - (part's kind's width * 0.5)
                set key to a cad vector2 with x (the floor of ((fromAlong * 1000.0) + 0.5)) and y (the floor of (((the minimum of fromUp and toUp) * 1000.0) + 0.5))
                # The layers of one cell share its rectangle: once is enough.
                set already to false
                loop seenCursor from 0 to the length of seen:
                    set earlier to the item at seenCursor in seen
                    if ((the absolute value of (earlier's x - key's x)) < 0.5) and ((the absolute value of (earlier's y - key's y)) < 0.5):
                        set already to true
                if already = false:
                    append key to seen
                    set hole to an empty list of a cad vector2
                    set lowUp to the minimum of fromUp and toUp
                    set highUp to the maximum of fromUp and toUp
                    append (a cad vector2 with x fromAlong and y lowUp) to hole
                    append (a cad vector2 with x (fromAlong + part's kind's width) and y lowUp) to hole
                    append (a cad vector2 with x (fromAlong + part's kind's width) and y highUp) to hole
                    append (a cad vector2 with x fromAlong and y highUp) to hole
                    append hole to holes
        set openingBoxes to the bim openings in system curtainValue's id in modelValue
        loop cursor from 0 to the length of (openingBoxes's values):
            set roughBox to the item at cursor in (openingBoxes's values)
            set hole to an empty list of a cad vector2
            append (a cad vector2 with x roughBox's fromAlong and y (the maximum of roughBox's bottom and (0.0 - half))) to hole
            append (a cad vector2 with x roughBox's untilAlong and y (the maximum of roughBox's bottom and (0.0 - half))) to hole
            append (a cad vector2 with x roughBox's untilAlong and y roughBox's top) to hole
            append (a cad vector2 with x roughBox's fromAlong and y roughBox's top) to hole
            append hole to holes
        set built to the fast prism over outline with holes holes from (0.0 - (jointDepth * 0.5)) rising jointDepth within 0.0001
        if built's reason = fast prism built:
            set local to an empty fast mesh
            append fast mesh of built's shape to (the address of local)
            set jointMesh to the bim face mesh of local on curtainValue lifted lift in modelValue
        free outline
        free holes
        free seen
        return jointMesh

# The triangles of derived linear parts (`bim stair part record`) together.
function the bim shape of derived parts {a pointer to a list:partList} in {bim model record:modelValue} within {a 64 bit floating-point number:tolerance}:
    execute:
        set combined to an empty fast mesh
        set partCuts to the bim end cuts of parts partList in modelValue
        loop cursor from 0 to the length of partList:
            set part to the item at cursor in partList
            set partShape to the bim linear shape of part's element typed part's kind in modelValue within tolerance cut by (the item at cursor in (partCuts's values))
            set base to the length of (combined's positions's values)
            loop corner from 0 to the length of (partShape's positions's values):
                append (the item at corner in (partShape's positions's values)) to (combined's positions's values)
                append (the item at corner in (partShape's normals's values)) to (combined's normals's values)
            loop corner from 0 to the length of (partShape's triangles's values):
                append (base + (the item at corner in (partShape's triangles's values))) to (combined's triangles's values)
        return combined

# Reinforcement segments do not participate in structural member joins.
function the bim reinforcement shape of {reinforcement definition:spec} in {bim model record:modelValue}:
    execute:
        set derived to the bim parts of reinforcement (the bim hostbound reinforcement spec in modelValue) in modelValue
        return the bim independent shapes of (derived's values) in modelValue

# A reinforcement object as the centre lines of its bars, without their
# diameter: the same bars as `the bim reinforcement shape of` (bars,
# stirrups, cages, area and mesh reinforcement, following their host), as
# pairs of model points with the storey's elevation added, and no
# triangles. The 3D view draws reinforcement so unless asked for the
# diameter; nothing is meshed round. Export keeps the round shape.
function the bim reinforcement line shape of {reinforcement definition:spec} in {bim model record:modelValue}:
    execute:
        set lineShape to an empty fast mesh
        set bound to the bim hostbound reinforcement spec in modelValue
        set lift to 0.0
        set levelFound to the bim level index of bound's levelId in modelValue
        if levelFound's valid:
            set lift to (the item at levelFound's position in (modelValue's levels's values))'s elevation
        set generated to the bim reinforcement paths of bound in modelValue
        set upward to a cad vector3 with x 0.0, y 0.0 and z 1.0
        loop barCursor from 0 to the length of (generated's bars's values):
            set barPoints to (the item at barCursor in (generated's bars's values))'s points's values
            loop edge from 0 to ((the length of barPoints) - 1):
                set firstPoint to the item at edge in barPoints
                set lastPoint to the item at (edge + 1) in barPoints
                append (a cad vector3 with x firstPoint's x, y firstPoint's y and z (firstPoint's z + lift)) to (lineShape's positions's values)
                append (a cad vector3 with x lastPoint's x, y lastPoint's y and z (lastPoint's z + lift)) to (lineShape's positions's values)
                append upward to (lineShape's normals's values)
                append upward to (lineShape's normals's values)
        return lineShape

# A wall's masonry module (`bim_masonry.dl`) as light lines: one upright
# line per module line on its masonry face, from the wall's foot to its top,
# as pairs of model points with no triangles. Nothing for a module that is
# not measured, and never a solid per brick.
function the bim masonry line shape of {bim masonry record:masonryValue}:
    execute:
        set lineShape to an empty fast mesh
        if masonryValue's status != (bim masonry measured):
            return lineShape
        set facing to a cad vector3 with x masonryValue's onward's y, y (0.0 - masonryValue's onward's x) and z 0.0
        set stride to the bim masonry drawing stride of masonryValue
        set lineNumber to 0
        loop while lineNumber <= masonryValue's whole:
            set footSpot to the bim masonry spot lineNumber of masonryValue
            append footSpot to (lineShape's positions's values)
            append (a cad vector3 with x footSpot's x, y footSpot's y and z (footSpot's z + masonryValue's height)) to (lineShape's positions's values)
            append facing to (lineShape's normals's values)
            append facing to (lineShape's normals's values)
            set lineNumber to lineNumber + stride
        return lineShape

# Clip module stations to the host's actual opening heights before drawing.
function the bim masonry line shape of {bim masonry record:masonryValue} on {bim wall record:wallValue} in {bim model record:modelValue}:
    execute:
        set lineShape to an empty fast mesh
        if masonryValue's status != (bim masonry measured):
            return lineShape
        set facing to a cad vector3 with x masonryValue's onward's y, y (0.0 - masonryValue's onward's x) and z 0.0
        set stride to the bim masonry drawing stride of masonryValue
        set lineNumber to 0
        loop while lineNumber <= masonryValue's whole:
            set spotValue to the bim masonry point lineNumber of masonryValue
            set spans to the bim masonry vertical spans at spotValue on wallValue in modelValue
            loop cursor from 0 to the length of spans:
                set spanValue to the item at cursor in spans
                append (a cad vector3 with x spotValue's x, y spotValue's y and z spanValue's x) to (lineShape's positions's values)
                append (a cad vector3 with x spotValue's x, y spotValue's y and z spanValue's y) to (lineShape's positions's values)
                append facing to (lineShape's normals's values)
                append facing to (lineShape's normals's values)
            free spans
            set lineNumber to lineNumber + stride
        return lineShape

# Whether scene mesh `entry` holds lines (pairs of points, as `the bim
# reinforcement line shape of` makes) instead of triangles.
function bim scene mesh {bim scene mesh record:entry} draws lines:
    execute:
        return ((the length of (entry's shape's triangles's values)) = 0) and ((the length of (entry's shape's positions's values)) >= 2)

# How far along `ray` it passes within `reach` of the segment from `first`
# to `second`, at its nearest; infinity when it passes farther off, runs
# parallel to it or meets it behind its origin. Lines are picked so, not
# through a mesh made round them.
function the bim ray distance to segment from {cad vector3:first} to {cad vector3:second} along {bim ray record:ray} within {a 64 bit floating-point number:reach}:
    execute:
        set missed to 1.0 / 0.0
        set run to the cad difference of second and first
        set fromStart to the cad difference of ray's origin and first
        set aa to the cad dot of ray's direction and ray's direction
        set bb to the cad dot of ray's direction and run
        set cc to the cad dot of run and run
        set dd to the cad dot of ray's direction and fromStart
        set ee to the cad dot of run and fromStart
        set denominator to (aa * cc) - (bb * bb)
        if (aa < 1e-18) or (cc < 1e-18):
            return missed
        if denominator <= (1e-12 * (aa * cc)):
            return missed
        set share to (((aa * ee) - (bb * dd)) / denominator) clamped between 0.0 and 1.0
        set travel to ((bb * share) - dd) / aa
        if travel <= 0.0:
            return missed
        set onRay to the cad sum of ray's origin and (ray's direction scaled by travel)
        set onSegment to the cad sum of first and (run scaled by share)
        if (the cad length of (the cad difference of onRay and onSegment)) > reach:
            return missed
        return travel

function the bim independent shapes of {a pointer to a list:parts} in {bim model record:modelValue}:
    execute:
        set combined to an empty fast mesh
        loop cursor from 0 to the length of parts:
            set partValue to the item at cursor in parts
            set partShape to the bim linear shape of partValue's element typed partValue's kind in modelValue within 0.002 cut by (a bim uncut end)
            if partValue's kind's name = (the string form of "Connection plate"):
                set nodeFound to the bim connection index of partValue's element's id in modelValue
                if nodeFound's valid:
                    set spec to the item at nodeFound's position in (modelValue's connections's values)
                    set generated to the bim connection evaluation of spec in modelValue
                    set holes to an empty list of a connection void
                    loop voidCursor from 0 to the length of (generated's voids's values):
                        set cutValue to the item at voidCursor in (generated's voids's values)
                        if cutValue's kind = 1:
                            append cutValue to holes
                    if (the length of holes) > 0:
                        set vertices to the bim profile rings of partValue's element as partValue's kind in modelValue
                        set stockValue to the connection stock from vertices
                        free vertices
                        if stockValue's valid:
                            set partShape to the bim component mesh of (the connection stock stockValue's value perforated by holes) within 0.001
                    free holes
            set base to the length of (combined's positions's values)
            loop corner from 0 to the length of (partShape's positions's values):
                append (the item at corner in (partShape's positions's values)) to (combined's positions's values)
                append (the item at corner in (partShape's normals's values)) to (combined's normals's values)
            loop corner from 0 to the length of (partShape's triangles's values):
                append (base + (the item at corner in (partShape's triangles's values))) to (combined's triangles's values)
        return combined


# The meshes of the sketch faces of `modelValue`, free and in instances.
function the bim sketch meshes of {bim model record:modelValue}:
    execute:
        return the bim sketch meshes of modelValue within 0.0

# The same, round shapes (round linear elements, components' curved faces)
# fine enough to leave the true surface by at most `tolerance`.
function the bim sketch meshes of {bim model record:modelValue} within {a 64 bit floating-point number:tolerance}:
    execute:
        set noPrevious to an empty list of a bim scene mesh record
        set built to the bim sketch meshes of modelValue within tolerance reusing noPrevious
        free noPrevious
        return built

# Only supply meshes from the same unchanged model revision. Fixed-detail
# reinforcement and boolean cuts do not depend on camera magnification.
function the bim retained mesh index of {a 64 bit integer:wanted} among {a pointer to a list:previous}:
    execute:
        loop slot from 0 to the length of previous:
            set entry to the item at slot in previous
            if (entry's elementId = wanted) and (entry's serial = 0):
                return slot
        return -1

# Whether scene mesh `newMesh` is `oldMesh` again: the same element, coloured
# alike, with the same corners.
function bim scene mesh {bim scene mesh record:newMesh} repeats {bim scene mesh record:oldMesh}:
    execute:
        if (newMesh's elementId != oldMesh's elementId) or (newMesh's category != oldMesh's category):
            return false
        if ((newMesh's colour's x != oldMesh's colour's x) or (newMesh's colour's y != oldMesh's colour's y)) or (newMesh's colour's z != oldMesh's colour's z):
            return false
        set newCorners to newMesh's shape's triangles's values
        set oldCorners to oldMesh's shape's triangles's values
        set newPoints to newMesh's shape's positions's values
        set oldPoints to oldMesh's shape's positions's values
        if ((the length of newCorners) != (the length of oldCorners)) or ((the length of newPoints) != (the length of oldPoints)):
            return false
        loop corner from 0 to the length of newCorners:
            if (the item at corner in newCorners) != (the item at corner in oldCorners):
                return false
        loop corner from 0 to the length of newPoints:
            set newPoint to the item at corner in newPoints
            set oldPoint to the item at corner in oldPoints
            if ((newPoint's x != oldPoint's x) or (newPoint's y != oldPoint's y)) or (newPoint's z != oldPoint's z):
                return false
        return true

# Whether the scene meshes `newMeshes` are `oldMeshes` again, in the same
# order. The 3D view keeps what it holds when they are.
function bim scene meshes {a pointer to a list:newMeshes} repeat {a pointer to a list:oldMeshes}:
    execute:
        if (the length of newMeshes) != (the length of oldMeshes):
            return false
        loop cursor from 0 to the length of newMeshes:
            if (bim scene mesh (the item at cursor in newMeshes) repeats (the item at cursor in oldMeshes)) = false:
                return false
        return true

function the bim sketch meshes of {bim model record:modelValue} within {a 64 bit floating-point number:tolerance} reusing {a pointer to a list:previous}:
    execute:
        set everything to an empty list of a boolean
        set built to the bim sketch meshes of modelValue within tolerance reusing previous refreshing everything
        free everything
        return built

# Whether the mesh at `position` of `previous` is kept as it is: `remade`
# names, for each mesh of `previous`, whether it is made again (empty: all
# are).
local function bim mesh {integer:position} stays among {a pointer to a list:remade} of {a pointer to a list:previous}:
    execute:
        if ((the length of remade) = 0) or (position >= (the length of previous)):
            return false
        if position >= (the length of remade):
            return true
        return (the item at position in remade) = false

# Whether any mesh from `position` on, counting `count`, is made again.
local function bim meshes from {integer:position} counting {integer:count} are wanted among {a pointer to a list:remade} of {a pointer to a list:previous}:
    execute:
        loop cursor from position to (position + count):
            if (bim mesh cursor stays among remade of previous) = false:
                return true
        return false

# The same, when `remade` is not empty, making again only the meshes it
# marks (by their position in `previous`, which must have been made from
# the same model revision) and keeping the others as they are: the 3D view
# makes round shapes finer or coarser for the zoom a few at a time, those
# covering the most of the screen first. Work shared by elements (a
# component's mesh, the joins' end cuts, the fittings) is done only for
# what is made again. Reinforcement is meshed round (its diameter).
function the bim sketch meshes of {bim model record:modelValue} within {a 64 bit floating-point number:tolerance} reusing {a pointer to a list:previous} refreshing {a pointer to a list:remade}:
    execute:
        return the bim sketch meshes of modelValue within tolerance reusing previous refreshing remade with reinforcement detail true

# The same, from nothing made before.
function the bim sketch meshes of {bim model record:modelValue} within {a 64 bit floating-point number:tolerance} with reinforcement detail {boolean:rebarDetail}:
    execute:
        set noPrevious to an empty list of a bim scene mesh record
        set everything to an empty list of a boolean
        set built to the bim sketch meshes of modelValue within tolerance reusing noPrevious refreshing everything with reinforcement detail rebarDetail
        free noPrevious
        free everything
        return built

# The same, reinforcement as its bars' centre lines (`the bim reinforcement
# line shape of`) unless `rebarDetail`: then meshed round, with its
# diameter. `previous` must hold reinforcement made the same way.
function the bim sketch meshes of {bim model record:modelValue} within {a 64 bit floating-point number:tolerance} reusing {a pointer to a list:previous} refreshing {a pointer to a list:remade} with reinforcement detail {boolean:rebarDetail}:
    execute:
        set result to a cad topology list of a bim scene mesh record
        loop cursor from 0 to the length of (modelValue's connections's values):
            set spec to the item at cursor in (modelValue's connections's values)
            set retainedSlot to the bim retained mesh index of spec's id among previous
            if bim mesh (the length of (result's values)) stays among remade of previous:
                append (the item at (the length of (result's values)) in previous) to (result's values)
            else if retainedSlot >= 0:
                append (the item at retainedSlot in previous) to (result's values)
            else:
                set derived to the bim parts of connection spec in modelValue
                append (@intrinsic("construct", a bim scene mesh record, spec's id, 0 as a 64 bit integer, the bim independent shapes of (derived's values) in modelValue, bim other category, the bim material colour of (the string form of "steel"))) to (result's values)
        loop cursor from 0 to the length of (modelValue's reinforcements's values):
            set spec to the item at cursor in (modelValue's reinforcements's values)
            set retainedSlot to the bim retained mesh index of spec's id among previous
            if bim mesh (the length of (result's values)) stays among remade of previous:
                append (the item at (the length of (result's values)) in previous) to (result's values)
            else if retainedSlot >= 0:
                append (the item at retainedSlot in previous) to (result's values)
            else:
                set rebarShape to an empty fast mesh
                if rebarDetail:
                    set rebarShape to the bim reinforcement shape of spec in modelValue
                else:
                    set rebarShape to the bim reinforcement line shape of spec in modelValue
                append (@intrinsic("construct", a bim scene mesh record, spec's id, 0 as a 64 bit integer, rebarShape, bim other category, the bim material colour of (the string form of "steel"))) to (result's values)
        # Components with solid parts: mesh their B-rep once per component
        # and place it per instance.
        set foldedIds to an empty list of a 64 bit integer
        set componentTolerance to 0.002
        if tolerance > 0.0:
            set componentTolerance to the maximum of tolerance and 0.0002
        loop componentCursor from 0 to the length of (modelValue's components's values):
            set definition to the item at componentCursor in (modelValue's components's values)
            if bim component definition is folded:
                set placedHere to an empty list of an integer
                loop placementCursor from 0 to the length of (modelValue's instances's values):
                    set placement to the item at placementCursor in (modelValue's instances's values)
                    set placementLevel to the bim level index of placement's levelId in modelValue
                    if (placement's componentId = definition's id) and placementLevel's valid:
                        append placementCursor to placedHere
                set firstPlaced to the length of (result's values)
                set remeshed to bim meshes from firstPlaced counting (the length of placedHere) are wanted among remade of previous
                set componentShape to an empty fast mesh
                if remeshed:
                    set componentShape to the bim component mesh of (the bim brep of component definition within 1e-9) within componentTolerance
                loop placedCursor from 0 to the length of placedHere:
                    set placement to the item at (the item at placedCursor in placedHere) in (modelValue's instances's values)
                    append placement's id to foldedIds
                    if bim mesh (the length of (result's values)) stays among remade of previous:
                        append (the item at (the length of (result's values)) in previous) to (result's values)
                    else:
                        set placementLevel to the bim level index of placement's levelId in modelValue
                        set placementElevation to (the item at placementLevel's position in (modelValue's levels's values))'s elevation
                        append (@intrinsic("construct", a bim scene mesh record, placement's id, 0 as a 64 bit integer, the bim component triangles componentShape placed by placement at placementElevation, bim mass category, the bim category colouring)) to (result's values)
                free placedHere
        set drawn to the bim drawn sketches of modelValue seen from view (the bim refused id)
        loop cursor from 0 to the length of (drawn's values):
            set element to the item at cursor in (drawn's values)
            set levelFound to the bim level index of element's levelId in modelValue
            set inFolded to false
            loop foldedCursor from 0 to the length of foldedIds:
                if ((the item at foldedCursor in foldedIds) = element's id) and (element's height > 0.0):
                    set inFolded to true
            if ((element's kind = bim face sketch) and levelFound's valid) and (inFolded = false):
                if bim mesh (the length of (result's values)) stays among remade of previous:
                    append (the item at (the length of (result's values)) in previous) to (result's values)
                else:
                    set elevation to (the item at levelFound's position in (modelValue's levels's values))'s elevation
                    append (@intrinsic("construct", a bim scene mesh record, element's id, 0 as a 64 bit integer, the bim sketch mesh of element at elevation, bim mass category, the bim category colouring)) to (result's values)
        # Linear elements, coloured by their material, their ends shaped by
        # their joins (worked out only when one of them is made again).
        set linearStart to the length of (result's values)
        set linearCount to the length of (modelValue's linears's values)
        set modelCuts to a cad topology list of a bim end cut record
        if bim meshes from linearStart counting linearCount are wanted among remade of previous:
            set modelParts to the bim linear parts of modelValue
            set modelCuts to the bim end cuts of parts (modelParts's values) in modelValue
        loop cursor from 0 to linearCount:
            set linearValue to the item at cursor in (modelValue's linears's values)
            if bim mesh (the length of (result's values)) stays among remade of previous:
                append (the item at (the length of (result's values)) in previous) to (result's values)
            else:
                set linearType to the bim type of linear linearValue in modelValue
                # A system's elements in its discipline's colour.
                set linearColour to the bim material colour of linearType's material
                set systemId to the bim system of element linearValue's id in modelValue
                if systemId != the bim refused id:
                    set linearColour to the bim colour of discipline (the item at (the bim system index of systemId in modelValue)'s position in (modelValue's systems's values))'s discipline
                set retainedSlot to -1
                if (the length of previous) > 0:
                    set perforations to the bim connection perforations of linearValue's id in modelValue
                    if (linearType's round = false) or ((the length of (perforations's values)) > 0):
                        set retainedSlot to the bim retained mesh index of linearValue's id among previous
                if retainedSlot >= 0:
                    append (the item at retainedSlot in previous) to (result's values)
                else:
                    append (@intrinsic("construct", a bim scene mesh record, linearValue's id, 0 as a 64 bit integer, the bim linear shape of linearValue typed linearType in modelValue within tolerance cut by (the item at cursor in (modelCuts's values)), the bim category of linear role linearType's role, linearColour)) to (result's values)
        # Fittings, derived at the network's nodes: each picks as the first
        # segment it joins and takes its colour. When meshes are kept, those
        # after the fittings tell how many there are, so that the network is
        # derived only when one of them is made again.
        set fittingStart to the length of (result's values)
        set derivingFittings to true
        if (the length of remade) > 0:
            # The meshes after the fittings, counted back from the end: the
            # free meshes on a level, each curtain wall's pieces (the meshes
            # with its id), the railings and the stairs.
            set laterStart to the length of previous
            loop cursor from 0 to the length of (modelValue's meshes's values):
                if (the bim level index of (the item at cursor in (modelValue's meshes's values))'s levelId in modelValue)'s valid:
                    set laterStart to laterStart - 1
            loop step from 0 to the length of (modelValue's curtains's values):
                set curtainId to (the item at (((the length of (modelValue's curtains's values)) - 1) - step) in (modelValue's curtains's values))'s id
                loop while (laterStart > 0) and ((the item at (the minimum of (laterStart - 1) and ((the length of previous) - 1)) in previous)'s elementId = curtainId):
                    set laterStart to laterStart - 1
            set laterStart to (laterStart - (the length of (modelValue's railings's values))) - (the length of (modelValue's stairs's values))
            set fittingCount to laterStart - fittingStart
            if (fittingCount >= 0) and ((bim meshes from fittingStart counting fittingCount are wanted among remade of previous) = false):
                set derivingFittings to false
                loop cursor from 0 to fittingCount:
                    append (the item at (fittingStart + cursor) in previous) to (result's values)
        if derivingFittings:
            set servicesNetwork to the bim network of modelValue
            set derivedFittings to the bim fittings of servicesNetwork in modelValue
            loop cursor from 0 to the length of (derivedFittings's values):
                set fittingValue to the item at cursor in (derivedFittings's values)
                if bim mesh (the length of (result's values)) stays among remade of previous:
                    append (the item at (the length of (result's values)) in previous) to (result's values)
                else:
                    set fittingColour to the bim material colour of (the string form of "steel")
                    if fittingValue's systemId != the bim refused id:
                        set fittingColour to the bim colour of discipline (the item at (the bim system index of fittingValue's systemId in modelValue)'s position in (modelValue's systems's values))'s discipline
                    append (@intrinsic("construct", a bim scene mesh record, fittingValue's firstElementId, 0 as a 64 bit integer, the bim shape of derived parts (fittingValue's stubs's values) in modelValue within tolerance, bim other category, fittingColour)) to (result's values)
        # Stairs: their derived treads and stringers, one mesh per stair.
        loop cursor from 0 to the length of (modelValue's stairs's values):
            set stairValue to the item at cursor in (modelValue's stairs's values)
            if bim mesh (the length of (result's values)) stays among remade of previous:
                append (the item at (the length of (result's values)) in previous) to (result's values)
            else:
                append (@intrinsic("construct", a bim scene mesh record, stairValue's id, 0 as a 64 bit integer, the bim stair shape of stairValue in modelValue within tolerance, bim stair category, the bim material colour of stairValue's material)) to (result's values)
        # Railings: their posts and rails, one mesh per railing.
        loop cursor from 0 to the length of (modelValue's railings's values):
            set railingValue to the item at cursor in (modelValue's railings's values)
            if bim mesh (the length of (result's values)) stays among remade of previous:
                append (the item at (the length of (result's values)) in previous) to (result's values)
            else:
                append (@intrinsic("construct", a bim scene mesh record, railingValue's id, 0 as a 64 bit integer, the bim railing shape of railingValue in modelValue within tolerance, bim railing category, the bim material colour of railingValue's material)) to (result's values)
        # Curtain walls.
        loop cursor from 0 to the length of (modelValue's curtains's values):
            set curtainValue to the item at cursor in (modelValue's curtains's values)
            # In pieces of one material each: a masonry's bricks apart from
            # its joints, glass apart from its frame. Kept, they are the
            # meshes of `previous` that follow here with its id.
            set keptPieces to 0
            if bim mesh (the length of (result's values)) stays among remade of previous:
                loop while (((the length of (result's values)) + keptPieces) < (the length of previous)) and ((the item at ((the length of (result's values)) + keptPieces) in previous)'s elementId = curtainValue's id):
                    set keptPieces to keptPieces + 1
            if (keptPieces > 0) and ((bim meshes from (the length of (result's values)) counting keptPieces are wanted among remade of previous) = false):
                loop pieceCursor from 0 to keptPieces:
                    append (the item at (the length of (result's values)) in previous) to (result's values)
            else:
                set curtainPieces to the bim curtain pieces of curtainValue in modelValue within tolerance
                loop pieceCursor from 0 to the length of (curtainPieces's values):
                    set curtainPiece to the item at pieceCursor in (curtainPieces's values)
                    append (@intrinsic("construct", a bim scene mesh record, curtainValue's id, 0 as a 64 bit integer, curtainPiece's shape, bim wall category, the bim material colour of curtainPiece's material)) to (result's values)
        # Free meshes.
        loop cursor from 0 to the length of (modelValue's meshes's values):
            set meshValue to the item at cursor in (modelValue's meshes's values)
            set levelFound to the bim level index of meshValue's levelId in modelValue
            if levelFound's valid:
                if bim mesh (the length of (result's values)) stays among remade of previous:
                    append (the item at (the length of (result's values)) in previous) to (result's values)
                else:
                    set elevation to (the item at levelFound's position in (modelValue's levels's values))'s elevation
                    append (@intrinsic("construct", a bim scene mesh record, meshValue's id, 0 as a 64 bit integer, the bim mesh shape of meshValue at elevation, bim mass category, the bim category colouring)) to (result's values)
        # Masonry module lines, one line mesh for each wall whose module is
        # measured (`the bim masonry line shape of`), under the wall's id.
        set masonryWalls to an empty list of an integer
        loop cursor from 0 to the length of (modelValue's walls's values):
            if (the bim setting (bim masonry module setting) of ((the item at cursor in (modelValue's walls's values))'s id) in modelValue)'s found:
                append cursor to masonryWalls
        if (the length of masonryWalls) > 0:
            set masonryIndex to the bim join index of modelValue
            loop cursor from 0 to the length of masonryWalls:
                set masonryWallValue to the item at (the item at cursor in masonryWalls) in (modelValue's walls's values)
                set masonryValue to the bim masonry of wall masonryWallValue in modelValue using masonryIndex
                if masonryValue's status = (bim masonry measured):
                    if bim mesh (the length of (result's values)) stays among remade of previous:
                        append (the item at (the length of (result's values)) in previous) to (result's values)
                    else:
                        append (@intrinsic("construct", a bim scene mesh record, masonryWallValue's id, 0 as a 64 bit integer, the bim masonry line shape of masonryValue on masonryWallValue in modelValue, bim other category, the bim material colour of (the string form of "brick"))) to (result's values)
        free masonryWalls
        # Kept meshes are found by their position; should an element come
        # out in another number of meshes, every mesh is made again.
        if ((the length of remade) > 0) and ((the length of (result's values)) != (the length of previous)):
            set everything to an empty list of a boolean
            set result to the bim sketch meshes of modelValue within tolerance reusing previous refreshing everything with reinforcement detail rebarDetail
            free everything
        return result

class:
    patterns:
        [a|] bim ray record
    members:
        origin as a cad vector3
        direction as a cad vector3

function bim nothing picked:
    replacement:
        0

function bim wall picked:
    replacement:
        1

function bim opening picked:
    replacement:
        2

function bim space picked:
    replacement:
        3

function bim slab picked:
    replacement:
        4

function bim grid picked:
    replacement:
        5

# An imported element, read-only; `id` is its scene mesh's element id.
function bim imported picked:
    replacement:
        6

# A sketch element: a line, a face or mass, or a text.
function bim sketch picked:
    replacement:
        7

# An instance of a component.
function bim instance picked:
    replacement:
        8

# A free mesh.
function bim mesh picked:
    replacement:
        9

# A linear element (column, beam, mullion, skirting, pipe).
function bim linear picked:
    replacement:
        10

# A stair (its derived parts pick as it).
function bim stair picked:
    replacement:
        11

# A railing (its derived parts pick as it).
function bim railing picked:
    replacement:
        12

# A curtain wall (its derived parts pick as it).
function bim curtain picked:
    replacement:
        13

# A level, picked in a section.
function bim level picked:
    replacement:
        14

# A persistent, explicitly placed spatial object (not a derived room hash).
function bim space object picked:
    replacement:
        15

# Scene meshes of imported elements have ids from here up, above any id the
# model hands out.
function the bim imported id base:
    execute:
        return 1099511627776 as a 64 bit integer

# `id` is the wall, slab or opening id, or the space's identity; `distance` is along
# the ray.
class:
    patterns:
        [a|] bim pick record
    members:
        kind as an integer
        id as a 64 bit integer
        distance as a 64 bit floating-point number

# How far a space's floor must lie in front of an element hit to be picked
# instead of it.
function the bim pick margin:
    replacement:
        1e-6

function no bim pick:
    execute:
        return @intrinsic("construct", a bim pick record, bim nothing picked, the bim refused id, 1.0 / 0.0)

# The distance along the ray to the triangle, or infinity (Möller–Trumbore).
local function the bim ray distance to {cad vector3:first}, {cad vector3:second} and {cad vector3:third} along {bim ray record:ray}:
    execute:
        set miss to 1.0 / 0.0
        set a to the cad difference of first and ray's origin
        set edgeOne to the cad difference of second and first
        set edgeTwo to the cad difference of third and first
        set crossing to the cad cross of ray's direction and edgeTwo
        set determinant to the cad dot of edgeOne and crossing
        if (the absolute value of determinant) <= 1e-18:
            return miss
        set inverse to 1.0 / determinant
        set offset to a scaled by -1.0
        set u to (the cad dot of offset and crossing) * inverse
        if (u < 0.0) or (u > 1.0):
            return miss
        set turned to the cad cross of offset and edgeOne
        set v to (the cad dot of ray's direction and turned) * inverse
        if (v < 0.0) or ((u + v) > 1.0):
            return miss
        set reach to (the cad dot of edgeTwo and turned) * inverse
        if reach <= 0.0:
            return miss
        return reach

# True when `location` lies inside the closed polygon `outline` (even-odd).
function bim flat point {cad vector2:location} lies in {a pointer to a list:outline}:
    execute:
        set enclosed to false
        set count to the length of outline
        loop cursor from 0 to count:
            set here to the item at cursor in outline
            set following to the item at (the remainder of (cursor + 1) divided by count) in outline
            if (here's y > location's y) != (following's y > location's y):
                set crossingX to here's x + (((location's y - here's y) / (following's y - here's y)) * (following's x - here's x))
                if location's x < crossingX:
                    set enclosed to (enclosed = false)
        return enclosed

# The corners of the face of `meshValue` starting at `start`, seen from above.
function the bim plan outline of mesh face {integer:start} of {bim mesh record:meshValue}:
    execute:
        set faceRing to an empty list of a cad vector2
        loop corner from 0 to (the item at start in (meshValue's faces's values)):
            set point to the item at (the item at ((start + 1) + corner) in (meshValue's faces's values)) in (meshValue's vertices's values)
            append (a cad vector2 with x point's x and y point's y) to faceRing
        return faceRing

# The face of `meshValue` seen from above at `location`: the highest of the
# faces turned up whose outline contains it; -1 when there is none.
function the bim top face of mesh {bim mesh record:meshValue} at {cad vector2:location}:
    execute:
        set best to -1
        set bestHeight to 0.0 - (1.0 / 0.0)
        set start to 0
        loop while start < the length of (meshValue's faces's values):
            set count to the item at start in (meshValue's faces's values)
            if (the bim normal of mesh face start of meshValue)'s z > 1e-6:
                set faceRing to the bim plan outline of mesh face start of meshValue
                if bim flat point location lies in faceRing:
                    set height to 0.0
                    loop corner from 0 to count:
                        set height to height + (the item at (the item at ((start + 1) + corner) in (meshValue's faces's values)) in (meshValue's vertices's values))'s z
                    set height to height / (count as a 64 bit floating-point number)
                    if height > bestHeight:
                        set bestHeight to height
                        set best to start
                free faceRing
            set start to start + (count + 1)
        return best

# The face of `meshValue` on which `spot` (in the mesh's own coordinates)
# lies: the face whose plane is nearest, among those whose outline holds it
# in their plane; -1 when there is none.
function the bim face of mesh {bim mesh record:meshValue} through {cad vector3:spot}:
    execute:
        set best to -1
        set bestGap to 1e-3
        set start to 0
        loop while start < the length of (meshValue's faces's values):
            set count to the item at start in (meshValue's faces's values)
            set normal to the bim normal of mesh face start of meshValue
            set origin to the item at (the item at (start + 1) in (meshValue's faces's values)) in (meshValue's vertices's values)
            set gap to the absolute value of (the cad dot of (the cad difference of spot and origin) and normal)
            if gap <= bestGap:
                # Into the face's plane: along its largest normal component.
                set faceRing to an empty list of a cad vector2
                set dropAxis to 2
                if ((the absolute value of normal's x) >= (the absolute value of normal's y)) and ((the absolute value of normal's x) >= (the absolute value of normal's z)):
                    set dropAxis to 0
                else if (the absolute value of normal's y) >= (the absolute value of normal's z):
                    set dropAxis to 1
                loop corner from 0 to count:
                    set point to the item at (the item at ((start + 1) + corner) in (meshValue's faces's values)) in (meshValue's vertices's values)
                    append (the bim flat of point dropping dropAxis) to faceRing
                if bim flat point (the bim flat of spot dropping dropAxis) lies in faceRing:
                    set best to start
                    set bestGap to gap
                free faceRing
            set start to start + (count + 1)
        return best

# A point on a mesh face's outline, when one was found.
class:
    patterns:
        [a|] bim mesh spot record
    members:
        valid as a boolean
        spot as a cad vector3

# The point of the outline of face `start` of `meshValue` nearest `spot`: a
# corner within `tolerance`, else an edge's middle, else the nearest point
# of an edge within it.
function the bim outline spot of mesh face {integer:start} of {bim mesh record:meshValue} near {cad vector3:spot} within {a 64 bit floating-point number:tolerance}:
    execute:
        set entries to meshValue's faces's values
        set count to the item at start in entries
        loop corner from 0 to count:
            set here to the item at (the item at ((start + 1) + corner) in entries) in (meshValue's vertices's values)
            if (the cad distance from spot to here) <= tolerance:
                return @intrinsic("construct", a bim mesh spot record, true, here)
        loop corner from 0 to count:
            set here to the item at (the item at ((start + 1) + corner) in entries) in (meshValue's vertices's values)
            set following to the item at (the item at ((start + 1) + (the remainder of (corner + 1) divided by count)) in entries) in (meshValue's vertices's values)
            set middle to (the cad sum of here and following) scaled by 0.5
            if (the cad distance from spot to middle) <= tolerance:
                return @intrinsic("construct", a bim mesh spot record, true, middle)
        set best to @intrinsic("construct", a bim mesh spot record, false, spot)
        set bestGap to tolerance
        loop corner from 0 to count:
            set here to the item at (the item at ((start + 1) + corner) in entries) in (meshValue's vertices's values)
            set following to the item at (the item at ((start + 1) + (the remainder of (corner + 1) divided by count)) in entries) in (meshValue's vertices's values)
            set run to the cad difference of following and here
            set runLength to the cad dot of run and run
            if runLength > 1e-18:
                set along to the maximum of 0.0 and (the minimum of 1.0 and ((the cad dot of (the cad difference of spot and here) and run) / runLength))
                set foot to the cad sum of here and (run scaled by along)
                set gap to the cad distance from spot to foot
                if gap <= bestGap:
                    set bestGap to gap
                    set best to @intrinsic("construct", a bim mesh spot record, true, foot)
        return best

local function the bim flat of {cad vector3:point} dropping {integer:dropAxis}:
    execute:
        if dropAxis = 0:
            return a cad vector2 with x point's y and y point's z
        if dropAxis = 1:
            return a cad vector2 with x point's x and y point's z
        return a cad vector2 with x point's x and y point's y

# What a click on scene mesh `entry` picks: its element's pick kind.
function the bim pick kind of {bim scene mesh record:entry} in {bim model record:modelValue}:
    execute:
        if entry's elementId >= (the bim imported id base):
            return bim imported picked
        set entryKind to bim wall picked
        if (the bim slab index of entry's elementId in modelValue)'s valid:
            set entryKind to bim slab picked
        if entry's category = bim mass category:
            set entryKind to bim sketch picked
            if (the bim mesh index of entry's elementId in modelValue)'s valid:
                set entryKind to bim mesh picked
        if (the bim stair index of entry's elementId in modelValue)'s valid:
            set entryKind to bim stair picked
        if (the bim railing index of entry's elementId in modelValue)'s valid:
            set entryKind to bim railing picked
        if (the bim curtain index of entry's elementId in modelValue)'s valid:
            set entryKind to bim curtain picked
        if (the bim linear index of entry's elementId in modelValue)'s valid:
            set entryKind to bim linear picked
        if (the bim reinforcement index of entry's elementId in modelValue)'s valid:
            set entryKind to 30
        if (the bim connection index of entry's elementId in modelValue)'s valid:
            set entryKind to 31
        return entryKind

# The face of the model seen first along a ray: the element it belongs to
# (its pick kind and id), where the ray meets it (in the model, the storey's
# elevation included) and the face's unit normal, toward the ray's origin.
class:
    patterns:
        [a|] bim face pick record
    members:
        found as a boolean
        kind as an integer
        id as a 64 bit integer
        spot as a cad vector3
        normal as a cad vector3

function the bim face along {bim ray record:ray} among {a pointer to a list:meshes} in {bim model record:modelValue}:
    execute:
        set nearest to 1.0 / 0.0
        set chosenKind to bim nothing picked
        set chosenId to the bim refused id
        set chosenNormal to a cad vector3 with x 0.0, y 0.0 and z 1.0
        loop meshCursor from 0 to the length of meshes:
            set entry to the item at meshCursor in meshes
            set points to entry's shape's positions's values
            set corners to entry's shape's triangles's values
            set cursor to 0
            loop while cursor < the length of corners:
                set first to the item at (the item at cursor in corners) in points
                set second to the item at (the item at (cursor + 1) in corners) in points
                set third to the item at (the item at (cursor + 2) in corners) in points
                set triangleDistance to the bim ray distance to first, second and third along ray
                if triangleDistance < nearest:
                    set crossed to the cad cross of (the cad difference of second and first) and (the cad difference of third and first)
                    set crossedLength to the cad length of crossed
                    if crossedLength > 1e-12:
                        set nearest to triangleDistance
                        set chosenKind to the bim pick kind of entry in modelValue
                        set chosenId to entry's elementId
                        set chosenNormal to crossed scaled by (1.0 / crossedLength)
                set cursor to cursor + 3
        if chosenKind = bim nothing picked:
            return @intrinsic("construct", a bim face pick record, false, bim nothing picked, the bim refused id, ray's origin, chosenNormal)
        if (the cad dot of chosenNormal and ray's direction) > 0.0:
            set chosenNormal to chosenNormal scaled by -1.0
        return @intrinsic("construct", a bim face pick record, true, chosenKind, chosenId, (the cad sum of ray's origin and (ray's direction scaled by nearest)), chosenNormal)

# The nearest wall, slab, opening or space along `ray`. `meshes` are the scene
# meshes of `modelValue`'s evaluation and `spaces` its spaces.
function the bim pick along {bim ray record:ray} among {a pointer to a list:meshes} in {bim model record:modelValue} with {a pointer to a list:spaces}:
    execute:
        return the bim pick along ray among meshes in modelValue with spaces reaching lines within 0.0

# The same, a mesh of lines (reinforcement drawn as its centre lines) hit
# where the ray passes within `lineReach` of one of them.
function the bim pick along {bim ray record:ray} among {a pointer to a list:meshes} in {bim model record:modelValue} with {a pointer to a list:spaces} reaching lines within {a 64 bit floating-point number:lineReach}:
    execute:
        set best to no bim pick
        loop meshCursor from 0 to the length of meshes:
            set entry to the item at meshCursor in meshes
            set entryKind to the bim pick kind of entry in modelValue
            if (lineReach > 0.0) and (bim scene mesh entry draws lines):
                set linePoints to entry's shape's positions's values
                set lineCursor to 0
                loop while (lineCursor + 1) < the length of linePoints:
                    set lineDistance to the bim ray distance to segment from (the item at lineCursor in linePoints) to (the item at (lineCursor + 1) in linePoints) along ray within lineReach
                    if lineDistance < best's distance:
                        set best to @intrinsic("construct", a bim pick record, entryKind, entry's elementId, lineDistance)
                    set lineCursor to lineCursor + 2
            set points to entry's shape's positions's values
            set corners to entry's shape's triangles's values
            set cursor to 0
            loop while cursor < the length of corners:
                set triangleDistance to the bim ray distance to (the item at (the item at cursor in corners) in points), (the item at (the item at (cursor + 1) in corners) in points) and (the item at (the item at (cursor + 2) in corners) in points) along ray
                if triangleDistance < best's distance:
                    set best to @intrinsic("construct", a bim pick record, entryKind, entry's elementId, triangleDistance)
                set cursor to cursor + 3
        # An opening wins over its own wall when the ray reaches its centre
        # plane within the wall's thickness of the wall hit: the ray entered
        # the opening or touched its reveals.
        loop openingCursor from 0 to the length of (modelValue's openings's values):
            set openingValue to the item at openingCursor in (modelValue's openings's values)
            set hostFound to the bim wall index of openingValue's hostId in modelValue
            set typeFound to the bim opening type index of openingValue's typeId in modelValue
            if hostFound's valid and typeFound's valid:
                set host to the item at hostFound's position in (modelValue's walls's values)
                set openingType to the item at typeFound's position in (modelValue's openingTypes's values)
                set levelFound to the bim level index of host's levelId in modelValue
                set elevation to 0.0
                if levelFound's valid:
                    set elevation to (the item at levelFound's position in (modelValue's levels's values))'s elevation
                # The opening's centre plane; along a curved host, on the
                # tangent at the opening's middle.
                set halfWidth to (the bim rough width of openingType) * 0.5
                set span to the bim span of host at openingValue's offset reaching halfWidth
                set direction to span's direction
                set normal to span's normal
                set base to span's left
                set facing to (ray's direction's x * normal's x) + (ray's direction's y * normal's y)
                if (the absolute value of facing) > 1e-12:
                    set planeGap to ((base's x - ray's origin's x) * normal's x) + ((base's y - ray's origin's y) * normal's y)
                    set openingDistance to planeGap / facing
                    if openingDistance > 0.0:
                        set hitX to (ray's origin's x - base's x) + (openingDistance * ray's direction's x)
                        set hitY to (ray's origin's y - base's y) + (openingDistance * ray's direction's y)
                        set hitZ to (ray's origin's z + (openingDistance * ray's direction's z)) - elevation
                        set alongWall to (openingValue's offset - halfWidth) + ((hitX * direction's x) + (hitY * direction's y))
                        set inside to ((alongWall >= (openingValue's offset - halfWidth)) and (alongWall <= (openingValue's offset + halfWidth))) and ((hitZ >= openingType's sill) and (hitZ <= (the bim head height of openingType)))
                        if inside:
                            set throughHost to (best's kind = bim wall picked) and (best's id = host's id)
                            set nearHost to throughHost and (openingDistance <= (best's distance + (the bim wall thickness of host in modelValue)))
                            if (openingDistance < best's distance) or nearHost:
                                set best to @intrinsic("construct", a bim pick record, bim opening picked, openingValue's id, openingDistance)
        loop spaceCursor from 0 to the length of spaces:
            set space to the item at spaceCursor in spaces
            set levelFound to the bim level index of space's levelId in modelValue
            if levelFound's valid and ((the absolute value of ray's direction's z) > 1e-12):
                set elevation to (the item at levelFound's position in (modelValue's levels's values))'s elevation
                set floorDistance to (elevation - ray's origin's z) / ray's direction's z
                if (floorDistance > 0.0) and (floorDistance < (best's distance - the bim pick margin)):
                    set floorPoint to a cad vector2 with x (ray's origin's x + (floorDistance * ray's direction's x)) and y (ray's origin's y + (floorDistance * ray's direction's y))
                    if bim flat point floorPoint lies in (space's outline's values):
                        set best to @intrinsic("construct", a bim pick record, bim space picked, the bim identity of space, floorDistance)
        return best

# ---------------------------------------------------------------- section box

# Coordinate `axis` (0 x, 1 y, 2 z) of `point`.
function the bim coordinate {integer:axis} of {cad vector3:point}:
    execute:
        if axis = 0:
            return point's x
        if axis = 1:
            return point's y
        return point's z

# Whether `spot` lies on the kept side of face `faceIndex` of the box from `low`
# to `high` (faces 0 and 1 bound x from below and above, 2 and 3 y, 4 and 5 z).
function bim point {cad vector3:spot} lies inside face {integer:faceIndex} from {cad vector3:low} to {cad vector3:high}:
    execute:
        set axis to faceIndex / 2
        if (the remainder of faceIndex divided by 2) = 0:
            return (the bim coordinate axis of spot) >= (the bim coordinate axis of low)
        return (the bim coordinate axis of spot) <= (the bim coordinate axis of high)

# Where the segment from `first` to `second` crosses face `faceIndex` of the box.
function the bim crossing of {cad vector3:first} and {cad vector3:second} at face {integer:faceIndex} from {cad vector3:low} to {cad vector3:high}:
    execute:
        set axis to faceIndex / 2
        set bound to the bim coordinate axis of high
        if (the remainder of faceIndex divided by 2) = 0:
            set bound to the bim coordinate axis of low
        set fromValue to the bim coordinate axis of first
        set toValue to the bim coordinate axis of second
        set share to 0.0
        if (the absolute value of (toValue - fromValue)) > 1e-12:
            set share to (bound - fromValue) / (toValue - fromValue)
        return the cad sum of first and ((the cad difference of second and first) scaled by share)

# `triangles` clipped to the box from `low` to `high`, as a section box
# shows the model: what lies outside is cut away, and a triangle crossing a
# face is cut along it (each face by Sutherland and Hodgman's rule).
function the bim mesh {fast mesh record:triangles} clipped to box from {cad vector3:low} to {cad vector3:high}:
    execute:
        set cutMesh to an empty fast mesh
        set positions to triangles's positions's values
        set cursor to 0
        loop while (cursor + 2) < the length of (triangles's triangles's values):
            set firstIndex to the item at cursor in (triangles's triangles's values)
            set polygon to an empty list of a cad vector3
            append (the item at firstIndex in positions) to polygon
            append (the item at (the item at (cursor + 1) in (triangles's triangles's values)) in positions) to polygon
            append (the item at (the item at (cursor + 2) in (triangles's triangles's values)) in positions) to polygon
            set facing to the item at firstIndex in (triangles's normals's values)
            loop boundIndex from 0 to 6:
                set count to the length of polygon
                if count > 0:
                    set kept to an empty list of a cad vector3
                    loop corner from 0 to count:
                        set here to the item at corner in polygon
                        set after to the item at (the remainder of (corner + 1) divided by count) in polygon
                        set hereIn to bim point here lies inside face boundIndex from low to high
                        set afterIn to bim point after lies inside face boundIndex from low to high
                        if hereIn:
                            append here to kept
                        if hereIn != afterIn:
                            append (the bim crossing of here and after at face boundIndex from low to high) to kept
                    free polygon
                    set polygon to kept
            set count to the length of polygon
            loop corner from 1 to (count - 1):
                set base to the length of (cutMesh's positions's values)
                append (the item at 0 in polygon) to (cutMesh's positions's values)
                append (the item at corner in polygon) to (cutMesh's positions's values)
                append (the item at (corner + 1) in polygon) to (cutMesh's positions's values)
                loop copyCursor from 0 to 3:
                    append facing to (cutMesh's normals's values)
                append base to (cutMesh's triangles's values)
                append (base + 1) to (cutMesh's triangles's values)
                append (base + 2) to (cutMesh's triangles's values)
            free polygon
            set cursor to cursor + 3
        return cutMesh

# The part `span` (from x to y, as shares of the run) of a segment that
# stays within `lowEdge` to `highEdge` along one axis, starting at `start`
# and moving `step` over its run; empty (x above y) when it stays outside.
function the bim clip of {a 64 bit floating-point number:start} moving {a 64 bit floating-point number:step} between {a 64 bit floating-point number:lowEdge} and {a 64 bit floating-point number:highEdge} narrowing {cad vector2:span}:
    execute:
        if (the absolute value of step) < 1e-15:
            if (start < lowEdge) or (start > highEdge):
                return a cad vector2 with x 1.0 and y 0.0
            return span
        set atLow to (lowEdge - start) / step
        set atHigh to (highEdge - start) / step
        set enter to the minimum of atLow and atHigh
        set leave to the maximum of atLow and atHigh
        return a cad vector2 with x (the maximum of span's x and enter) and y (the minimum of span's y and leave)

# A mesh of lines (pairs of points) clipped to the box from `low` to `high`:
# each line cut to its part inside, those wholly outside left out.
function the bim line shape {fast mesh record:lineShape} clipped to box from {cad vector3:low} to {cad vector3:high}:
    execute:
        set kept to an empty fast mesh
        set upward to a cad vector3 with x 0.0, y 0.0 and z 1.0
        set linePoints to lineShape's positions's values
        set cursor to 0
        loop while (cursor + 1) < the length of linePoints:
            set first to the item at cursor in linePoints
            set run to the cad difference of (the item at (cursor + 1) in linePoints) and first
            set span to a cad vector2 with x 0.0 and y 1.0
            set span to the bim clip of (first's x) moving (run's x) between (low's x) and (high's x) narrowing span
            set span to the bim clip of (first's y) moving (run's y) between (low's y) and (high's y) narrowing span
            set span to the bim clip of (first's z) moving (run's z) between (low's z) and (high's z) narrowing span
            if span's x <= span's y:
                append (the cad sum of first and (run scaled by (span's x))) to (kept's positions's values)
                append (the cad sum of first and (run scaled by (span's y))) to (kept's positions's values)
                append upward to (kept's normals's values)
                append upward to (kept's normals's values)
            set cursor to cursor + 2
        return kept

# The scene meshes `sceneList` clipped to the box from `low` to `high`; those
# left empty are left out. Meshes of lines keep the parts of their lines
# inside.
function the bim scene meshes of {a pointer to a list:sceneList} clipped to box from {cad vector3:low} to {cad vector3:high}:
    execute:
        set result to a cad topology list of a bim scene mesh record
        loop cursor from 0 to the length of sceneList:
            set sceneMesh to the item at cursor in sceneList
            if bim scene mesh sceneMesh draws lines:
                set cutLines to the bim line shape sceneMesh's shape clipped to box from low to high
                if (the length of (cutLines's positions's values)) > 0:
                    set sceneMesh's shape to cutLines
                    append sceneMesh to (result's values)
            else:
                set cutShape to the bim mesh sceneMesh's shape clipped to box from low to high
                if (the length of (cutShape's triangles's values)) > 0:
                    set sceneMesh's shape to cutShape
                    append sceneMesh to (result's values)
        return result

# ---------------------------------------------------------------- reinforcement inside its host

# Whether element `wanted` is one of `ids`.
function bim element {a 64 bit integer:wanted} is among {a pointer to a list:ids}:
    execute:
        loop cursor from 0 to the length of ids:
            if (the item at cursor in ids) = wanted:
                return true
        return false

# Whether `corners` (a closed outline) turn the one way only: a convex
# outline, so that a segment between two points inside it lies inside it.
function bim outline {a pointer to a list:corners} turns one way:
    execute:
        set count to the length of corners
        if count < 3:
            return false
        set turning to 0.0
        loop cursor from 0 to count:
            set here to the item at cursor in corners
            set following to the item at (the remainder of (cursor + 1) divided by count) in corners
            set after to the item at (the remainder of (cursor + 2) divided by count) in corners
            set bend to ((following's x - here's x) * (after's y - following's y)) - ((following's y - here's y) * (after's x - following's x))
            if (the absolute value of bend) > 1e-12:
                if turning = 0.0:
                    set turning to bend
                else if (turning * bend) < 0.0:
                    return false
        return turning != 0.0

# Whether plate `plateValue` is one solid prism over its outline, read from
# its type alone (no geometry built): a plate of no type (its own thickness
# and material), or of a planar type whose every layer has a thickness, is
# not air and keeps to the outline (no layer edge). In doubt (a type not
# found, no layers) it is not.
function bim plate {bim slab record:plateValue} is one solid prism in {bim model record:modelValue}:
    execute:
        if plateValue's typeId = the bim refused id:
            return true
        set typeFound to the bim wall type index of plateValue's typeId in modelValue
        if typeFound's valid = false:
            return false
        set planarType to the item at typeFound's position in (modelValue's wallTypes's values)
        if (the length of (planarType's layers's values)) = 0:
            return false
        loop layerCursor from 0 to the length of (planarType's layers's values):
            set layerValue to the item at layerCursor in (planarType's layers's values)
            if (layerValue's thickness <= 1e-6) or (layerValue's material = (the string form of "air")):
                return false
            if (the absolute value of (the bim layer edge of layer layerCursor of type planarType's id in modelValue)) > 1e-9:
                return false
        return true

# Whether every point of reinforcement mesh `entry` lies at least a
# millimetre inside the solid of its host `spec` names: a level plate
# (floor, roof or ceiling) of a convex outline and one solid prism over it
# (`bim plate … is one solid prism in …`; plates have no holes), shown among
# `sceneMeshes`, opaque (not halftone in `rules`), not among `keptIds` (the
# selection), nor the reinforcement. A convex solid holds the segments and
# triangles between points inside it. In doubt (no host, another kind of
# host, a sloped, concave or layered plate, a host hidden or not found) it
# is not.
function bim reinforcement mesh {bim scene mesh record:entry} lies inside the host of {reinforcement definition:spec} among {a pointer to a list:sceneMeshes} in {bim model record:modelValue} following {bim view rules record:rules} keeping {a pointer to a list:keptIds}:
    execute:
        if (spec's hostId = the bim refused id) or (bim element spec's id is among keptIds):
            return false
        if bim element spec's hostId is among keptIds:
            return false
        set plateFound to the bim slab index of spec's hostId in modelValue
        if plateFound's valid = false:
            return false
        set plateValue to the item at plateFound's position in (modelValue's slabs's values)
        set plateCategory to the bim category of element plateValue's id in modelValue
        if ((plateValue's pitch != 0.0) or ((bim category plateCategory is visible in rules) = false)) or (bim category plateCategory is halftone in rules):
            return false
        if (bim outline (plateValue's outline's values) turns one way) = false:
            return false
        if (bim plate plateValue is one solid prism in modelValue) = false:
            return false
        set plateShown to false
        loop meshCursor from 0 to the length of sceneMeshes:
            set candidate to the item at meshCursor in sceneMeshes
            if candidate's elementId = plateValue's id:
                if (the length of (candidate's shape's triangles's values)) > 0:
                    set plateShown to true
        if plateShown = false:
            return false
        set levelFound to the bim level index of plateValue's levelId in modelValue
        if levelFound's valid = false:
            return false
        set plateTop to (the item at levelFound's position in (modelValue's levels's values))'s elevation + plateValue's top
        set plateBottom to plateTop - (the bim thickness of plate plateValue in modelValue)
        set outlineRing to plateValue's outline's values
        set spots to entry's shape's positions's values
        if ((the length of outlineRing) < 3) or ((the length of spots) = 0):
            return false
        loop spotCursor from 0 to the length of spots:
            set spot to the item at spotCursor in spots
            if (spot's z < (plateBottom + 0.001)) or (spot's z > (plateTop - 0.001)):
                return false
            set flatSpot to a cad vector2 with x spot's x and y spot's y
            if (bim ring outlineRing encloses flatSpot) = false:
                return false
            loop edgeCursor from 0 to the length of outlineRing:
                set edgeFrom to the item at edgeCursor in outlineRing
                set edgeTo to the item at (the remainder of (edgeCursor + 1) divided by (the length of outlineRing)) in outlineRing
                if (the cad distance from flatSpot to the segment from edgeFrom to edgeTo) < 0.001:
                    return false
        return true

# The reinforcement objects among `sceneMeshes` that lie wholly inside their
# host (`bim reinforcement mesh … lies inside the host of …`), where the
# host's faces hide them: the 3D view leaves them out. None while the
# section box cuts (`boxCuts`) or in the wireframe view (`wireframe`).
function the bim reinforcement hidden in hosts among {a pointer to a list:sceneMeshes} of {bim model record:modelValue} following {bim view rules record:rules} boxed {boolean:boxCuts} wired {boolean:wireframe} keeping {a pointer to a list:keptIds}:
    execute:
        set hiddenIds to a cad topology list of a 64 bit integer
        if boxCuts or wireframe:
            return hiddenIds
        loop meshCursor from 0 to the length of sceneMeshes:
            set entry to the item at meshCursor in sceneMeshes
            set rebarFound to the bim reinforcement index of entry's elementId in modelValue
            if rebarFound's valid:
                set spec to the item at rebarFound's position in (modelValue's reinforcements's values)
                if bim reinforcement mesh entry lies inside the host of spec among sceneMeshes in modelValue following rules keeping keptIds:
                    append entry's elementId to (hiddenIds's values)
        return hiddenIds

# `sceneMeshes` without the meshes of the elements `leftOut` names.
function the bim meshes among {a pointer to a list:sceneMeshes} leaving out {a pointer to a list:leftOut}:
    execute:
        set kept to a cad topology list of a bim scene mesh record
        loop cursor from 0 to the length of sceneMeshes:
            set entry to the item at cursor in sceneMeshes
            if (bim element entry's elementId is among leftOut) = false:
                append entry to (kept's values)
        return kept

# Wire edges shared by display and picking. They need no triangulation and
# follow the object's own height, not the storey's default height.
function the bim wire of space object {bim space object record:spaceValue} in {bim model record:modelValue}:
    execute:
        set wire to an empty fast mesh
        set levelFound to the bim level index of spaceValue's levelId in modelValue
        if levelFound's valid = false:
            return wire
        set low to (the item at levelFound's position in (modelValue's levels's values))'s elevation
        set high to low + spaceValue's height
        set count to the length of (spaceValue's outline's values)
        loop edge from 0 to count:
            set here to the item at edge in (spaceValue's outline's values)
            set following to the item at (the remainder of (edge + 1) divided by count) in (spaceValue's outline's values)
            set lowA to a cad vector3 with x here's x, y here's y and z low
            set lowB to a cad vector3 with x following's x, y following's y and z low
            set highA to a cad vector3 with x here's x, y here's y and z high
            set highB to a cad vector3 with x following's x, y following's y and z high
            append lowA to (wire's positions's values)
            append lowB to (wire's positions's values)
            append highA to (wire's positions's values)
            append highB to (wire's positions's values)
            append lowA to (wire's positions's values)
            append highA to (wire's positions's values)
        return wire

# Spaces pick on their visible wires, not on an invisible volume enclosing
# every chair and wall. The caller gates by category. A negative level
# means all storeys. Clipping happens before distance tests, as for display.
function the bim space object pick along {bim ray record:ray} in {bim model record:modelValue} on level {a 64 bit integer:levelId} within {a 64 bit floating-point number:reach} clipped {boolean:boxed} from {cad vector3:low} to {cad vector3:high}:
    execute:
        set best to no bim pick
        if reach <= 0.0:
            return best
        loop cursor from 0 to the length of (modelValue's spaceObjects's values):
            set spaceValue to the item at cursor in (modelValue's spaceObjects's values)
            if (levelId < (0 as a 64 bit integer)) or (spaceValue's levelId = levelId):
                set wire to the bim wire of space object spaceValue in modelValue
                if boxed:
                    set wire to the bim line shape wire clipped to box from low to high
                set edge to 0
                loop while (edge + 1) < (the length of (wire's positions's values)):
                    set first to the item at edge in (wire's positions's values)
                    set last to the item at (edge + 1) in (wire's positions's values)
                    set distance to the bim ray distance to segment from first to last along ray within reach
                    if distance < best's distance:
                        set best to @intrinsic("construct", a bim pick record, bim space object picked, spaceValue's id, distance)
                    set edge to edge + 2
        return best
