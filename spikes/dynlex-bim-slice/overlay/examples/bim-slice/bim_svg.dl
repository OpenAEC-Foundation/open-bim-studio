# SPDX-License-Identifier: MPL-2.0
# A recorded drawing (`bim canvas record`) written as SVG: each batch of
# triangles one path in its colour, each label a text in Osifont. The canvas
# is recorded in millimetres with y down from the top of the page, as SVG
# has it, so nothing is flipped.
import examples/bim-slice/bim_pdf.dl

# `message` with the characters XML reserves written as entities, and
# characters outside printable ASCII left out.
function the bim xml text of {a string:message}:
    execute:
        set parts to an empty list of a string
        loop cursor from 0 to the length of message:
            set code to the character at cursor in message
            if code = 38:
                append (the string form of "&amp;") to parts
            else if code = 60:
                append (the string form of "&lt;") to parts
            else if code = 62:
                append (the string form of "&gt;") to parts
            else if code = 34:
                append (the string form of "&quot;") to parts
            else if (code >= 32) and (code < 127):
                set letter to a new string buffer containing 1 bytes
                store (code as a byte) into the data of letter at 0
                append letter to parts
        set written to parts joined with ""
        free parts
        return written

# The SVG file of `canvas` on a page `pageWidth` by `pageHeight` millimetres,
# its labels `textSize` millimetres high.
function the bim svg of {bim canvas record:canvas} sized {a 64 bit floating-point number:pageWidth} by {a 64 bit floating-point number:pageHeight} with text {a 64 bit floating-point number:textSize} high:
    execute:
        set parts to an empty list of a string
        append ((((the string form of "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"") + (the bim pdf number of pageWidth)) + ((the string form of "mm\" height=\"") + (the bim pdf number of pageHeight))) + ((((the string form of "mm\" viewBox=\"0 0 ") + (the bim pdf number of pageWidth)) + ((the string form of " ") + (the bim pdf number of pageHeight))) + (the string form of "\">\n"))) to parts
        loop batchCursor from 0 to the length of (canvas's batches's values):
            set batch to the item at batchCursor in (canvas's batches's values)
            set corners to batch's pixels's values
            if (the length of corners) >= 3:
                set path to ((((the string form of "<path fill=\"rgb(") + (the string form of batch's red)) + ((the string form of ",") + (the string form of batch's green))) + (((the string form of ",") + (the string form of batch's blue)) + (the string form of ")\" d=\"")))
                append path to parts
                set cursor to 0
                loop while (cursor + 2) < the length of corners:
                    set first to the item at cursor in corners
                    set second to the item at (cursor + 1) in corners
                    set third to the item at (cursor + 2) in corners
                    set step to ((((the string form of "M") + (the bim pdf number of first's x)) + ((the string form of " ") + (the bim pdf number of first's y))) + (((the string form of "L") + (the bim pdf number of second's x)) + ((the string form of " ") + (the bim pdf number of second's y))))
                    set step to step + ((((the string form of "L") + (the bim pdf number of third's x)) + ((the string form of " ") + (the bim pdf number of third's y))) + (the string form of "Z"))
                    append step to parts
                    set cursor to cursor + 3
                append (the string form of "\"/>\n") to parts
        loop textCursor from 0 to the length of (canvas's texts's values):
            set label to the item at textCursor in (canvas's texts's values)
            set anchor to the string form of "start"
            if label's centred:
                set anchor to the string form of "middle"
            set line to ((((the string form of "<text x=\"") + (the bim pdf number of label's x)) + ((the string form of "\" y=\"") + (the bim pdf number of label's y))) + ((the string form of "\" font-family=\"osifont, sans-serif\" font-size=\"") + (the bim pdf number of textSize)))
            set line to line + ((((the string form of "\" text-anchor=\"") + anchor) + ((the string form of "\" fill=\"rgb(") + (the string form of label's red))) + (((the string form of ",") + (the string form of label's green)) + (((the string form of ",") + (the string form of label's blue)) + (the string form of ")\">"))))
            set line to line + ((the bim xml text of label's message) + (the string form of "</text>\n"))
            append line to parts
        append (the string form of "</svg>\n") to parts
        set svgText to parts joined with ""
        free parts
        return svgText
