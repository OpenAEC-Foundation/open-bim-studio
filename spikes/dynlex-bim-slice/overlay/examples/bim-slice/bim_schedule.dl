# SPDX-License-Identifier: MPL-2.0
# A quantity schedule of the model: one row per wall type, opening type, the
# slabs and the spaces, with the count and the quantities that apply.
#
# - Walls, per type: the centreline length (along the arc for a curved wall),
#   the net area of one face (length times height less the rough openings),
#   and the volume of the evaluated solids.
# - Doors and windows, per type: the count and the total rough opening area.
# - Slabs: the outline area and the evaluated volume.
# - Spaces: the floor area.
# - Masses (pushed sketch faces): the footprint area and the volume.
# - Components, each: the instances placed, and the footprint area and the
#   volume of the masses in all of them.
#
# A quantity that does not apply to a row is negative and shown as blank.
import examples/bim-slice/bim_spaces.dl
import examples/bim-slice/bim_network.dl
import examples/bim-slice/bim_clash.dl

class:
    patterns:
        [a|] bim schedule row record
    members:
        group as a string
        name as a string
        count as an integer
        length as a 64 bit floating-point number
        area as a 64 bit floating-point number
        volume as a 64 bit floating-point number

local function a bim schedule row in {a string:group} named {a string:name}:
    execute:
        return @intrinsic("construct", a bim schedule row record, group, name, 0, -1.0, -1.0, -1.0)

# The doubled signed area of the closed ring `points`.
local function the bim ring area of {a pointer to a list:points}:
    execute:
        set total to 0.0
        set count to the length of points
        if count < 3:
            return 0.0
        set anchor to the item at 0 in points
        loop cursor from 1 to count - 1:
            set here to the item at cursor in points
            set following to the item at (cursor + 1) in points
            set total to total + (((here's x - anchor's x) * (following's y - anchor's y)) - ((following's x - anchor's x) * (here's y - anchor's y)))
        return (the absolute value of total) * 0.5

# The building services per system: each system's segments per type (count
# and length) and its fittings per kind (count), in groups named after the
# system ("Services: Water 1"); segments in no system under "Services".
function append bim services rows of {bim model record:modelValue} to {a pointer to a list:rows}:
    execute:
        set servicesNetwork to the bim network of modelValue
        set derivedFittings to the bim fittings of servicesNetwork in modelValue
        # Each linear element's system, found once.
        set linearSystems to an empty list of a 64 bit integer
        loop cursor from 0 to the length of (modelValue's linears's values):
            append (the bim refused id) to linearSystems
        loop cursor from 0 to the length of (modelValue's systems's values):
            set systemValue to the item at cursor in (modelValue's systems's values)
            loop memberCursor from 0 to the length of (systemValue's members's values):
                set memberFound to the bim linear index of (the item at memberCursor in (systemValue's members's values)) in modelValue
                if memberFound's valid:
                    replace item at index memberFound's position in linearSystems with systemValue's id
        # The systems, then no system (the refused id).
        set groups to an empty list of a 64 bit integer
        loop cursor from 0 to the length of (modelValue's systems's values):
            append (the item at cursor in (modelValue's systems's values))'s id to groups
        append (the bim refused id) to groups
        loop groupCursor from 0 to the length of groups:
            set systemId to the item at groupCursor in groups
            set groupName to the string form of "Services"
            if systemId != the bim refused id:
                set groupName to (the string form of "Services: ") + (the item at (the bim system index of systemId in modelValue)'s position in (modelValue's systems's values))'s name
            loop typeCursor from 0 to the length of (modelValue's linearTypes's values):
                set linearType to the item at typeCursor in (modelValue's linearTypes's values)
                if bim role linearType's role connects:
                    set row to a bim schedule row in groupName named linearType's name
                    set row's length to 0.0
                    loop cursor from 0 to the length of (modelValue's linears's values):
                        set linearValue to the item at cursor in (modelValue's linears's values)
                        if (linearValue's typeId = linearType's id) and ((the item at cursor in linearSystems) = systemId):
                            set row's count to row's count + 1
                            set row's length to row's length + (the cad length of (the cad difference of linearValue's finish and linearValue's start))
                    if row's count > 0:
                        append row to rows
            loop kindCode from 1 to 4:
                set row to a bim schedule row in groupName named (the bim name of fitting kindCode)
                loop cursor from 0 to the length of (derivedFittings's values):
                    set fittingValue to the item at cursor in (derivedFittings's values)
                    if (fittingValue's kind = kindCode) and (fittingValue's systemId = systemId):
                        set row's count to row's count + 1
                if row's count > 0:
                    append row to rows
        free groups
        free linearSystems

# The schedule of `modelValue`, with volumes from `evaluation` (which must
# have evaluated it) and the spaces `spaces`.
function the bim schedule of {bim model record:modelValue} with {bim evaluation record:evaluation} and {a pointer to a list:spaces}:
    execute:
        set rows to a cad topology list of a bim schedule row record
        # Once for the whole model: each wall's and slab's evaluated volume
        # and each wall's openings' area, by position (each element is found
        # by its id, in id order, not searched for per row).
        set wallVolumes to an empty list of a 64 bit floating-point number
        set wallOpenings to an empty list of a 64 bit floating-point number
        loop cursor from 0 to the length of (modelValue's walls's values):
            append 0.0 to wallVolumes
            append 0.0 to wallOpenings
        set slabVolumes to an empty list of a 64 bit floating-point number
        loop cursor from 0 to the length of (modelValue's slabs's values):
            append 0.0 to slabVolumes
        loop cursor from 0 to the length of (evaluation's elements's values):
            set geometry to the item at cursor in (evaluation's elements's values)
            set wallFound to the bim wall index of geometry's id in modelValue
            if wallFound's valid:
                replace item at index wallFound's position in wallVolumes with (the bim volume of geometry)
            else:
                set slabFound to the bim slab index of geometry's id in modelValue
                if slabFound's valid:
                    replace item at index slabFound's position in slabVolumes with (the bim volume of geometry)
        loop openingCursor from 0 to the length of (modelValue's openings's values):
            set openingValue to the item at openingCursor in (modelValue's openings's values)
            set hostFound to the bim wall index of openingValue's hostId in modelValue
            set typeFound to the bim opening type index of openingValue's typeId in modelValue
            if hostFound's valid and typeFound's valid:
                set openingType to the item at typeFound's position in (modelValue's openingTypes's values)
                replace item at index hostFound's position in wallOpenings with ((the item at hostFound's position in wallOpenings) + ((the bim rough width of openingType) * (the bim rough height of openingType)))
        loop typeCursor from 0 to the length of (modelValue's wallTypes's values):
            set wallType to the item at typeCursor in (modelValue's wallTypes's values)
            set row to a bim schedule row in (the string form of "Walls") named wallType's name
            if wallType's role != bim wall planar role:
                set row's count to -1
            set row's length to 0.0
            set row's area to 0.0
            set row's volume to 0.0
            loop cursor from 0 to the length of (modelValue's walls's values):
                set wallValue to the item at cursor in (modelValue's walls's values)
                if wallValue's typeId = wallType's id:
                    set run to the bim centreline length of wallValue
                    set face to (run * wallValue's height) - (the item at cursor in wallOpenings)
                    set row's count to row's count + 1
                    set row's length to row's length + run
                    set row's area to row's area + face
                    set row's volume to row's volume + (the item at cursor in wallVolumes)
            if row's count > 0:
                append row to (rows's values)
        loop typeCursor from 0 to the length of (modelValue's openingTypes's values):
            set openingType to the item at typeCursor in (modelValue's openingTypes's values)
            set group to the string form of "Windows"
            if openingType's isDoor:
                set group to the string form of "Doors"
            set row to a bim schedule row in group named openingType's name
            set row's area to 0.0
            loop cursor from 0 to the length of (modelValue's openings's values):
                if (the item at cursor in (modelValue's openings's values))'s typeId = openingType's id:
                    set row's count to row's count + 1
                    set row's area to row's area + ((the bim rough width of openingType) * (the bim rough height of openingType))
            if row's count > 0:
                append row to (rows's values)
        # Plates per planar type, grouped by role; untyped slabs as floors.
        loop roleCode from 1 to 4:
            loop typeCursor from -1 to the length of (modelValue's wallTypes's values):
                set typeId to the bim refused id
                set label to the string form of "Slabs"
                set usable to roleCode = bim floor planar role
                if typeCursor >= 0:
                    set planarType to the item at typeCursor in (modelValue's wallTypes's values)
                    set typeId to planarType's id
                    set label to planarType's name
                    set usable to planarType's role = roleCode
                if usable:
                    set row to a bim schedule row in ((the bim name of planar role roleCode) + (the string form of "s")) named label
                    set row's area to 0.0
                    set row's volume to 0.0
                    loop cursor from 0 to the length of (modelValue's slabs's values):
                        set slabValue to the item at cursor in (modelValue's slabs's values)
                        set ownType to slabValue's typeId
                        if (the bim wall type index of ownType in modelValue)'s valid = false:
                            set ownType to the bim refused id
                        if ownType = typeId:
                            set row's count to row's count + 1
                            set row's area to row's area + (the bim ring area of (slabValue's outline's values))
                            set row's volume to row's volume + (the item at cursor in slabVolumes)
                    if row's count > 0:
                        append row to (rows's values)
        # Linear elements per type, grouped by role: count, length, volume
        # (the profile's area times the length).
        loop typeCursor from 0 to the length of (modelValue's linearTypes's values):
            set linearType to the item at typeCursor in (modelValue's linearTypes's values)
            set row to a bim schedule row in ((the bim name of linear role linearType's role) + (the string form of "s")) named linearType's name
            set row's length to 0.0
            set row's volume to 0.0
            set profileArea to linearType's width * linearType's depth
            if linearType's round:
                set radius to linearType's width * 0.5
                set profileArea to ((12.0 * radius) * radius) * (the sine of (6.283185307179586 / 24.0))
            loop cursor from 0 to the length of (modelValue's linears's values):
                set linearValue to the item at cursor in (modelValue's linears's values)
                if linearValue's typeId = linearType's id:
                    set run to the cad length of (the cad difference of linearValue's finish and linearValue's start)
                    set row's count to row's count + 1
                    set row's length to row's length + run
                    set row's volume to row's volume + (profileArea * run)
            if row's count > 0:
                append row to (rows's values)
        if (the length of spaces) > 0:
            set row to a bim schedule row in (the string form of "Spaces") named (the string form of "Rooms")
            set row's area to 0.0
            loop cursor from 0 to the length of spaces:
                set row's count to row's count + 1
                set row's area to row's area + (the item at cursor in spaces)'s area
            append row to (rows's values)
        set masses to a bim schedule row in (the string form of "Masses") named (the string form of "Sketch masses")
        set masses's area to 0.0
        set masses's volume to 0.0
        loop cursor from 0 to the length of (modelValue's sketches's values):
            set element to the item at cursor in (modelValue's sketches's values)
            if (element's kind = bim face sketch) and (element's height > 0.0):
                set footprint to the bim ring area of (element's points's values)
                set masses's count to masses's count + 1
                set masses's area to masses's area + footprint
                set masses's volume to masses's volume + (footprint * element's height)
        if masses's count > 0:
            append masses to (rows's values)
        loop cursor from 0 to the length of (modelValue's components's values):
            set definition to the item at cursor in (modelValue's components's values)
            set row to a bim schedule row in (the string form of "Components") named definition's name
            set row's area to 0.0
            set row's volume to 0.0
            loop placementCursor from 0 to the length of (modelValue's instances's values):
                if (the item at placementCursor in (modelValue's instances's values))'s componentId = definition's id:
                    set row's count to row's count + 1
            loop part from 0 to the length of (definition's sketches's values):
                set element to the item at part in (definition's sketches's values)
                if (element's kind = bim face sketch) and (element's height > 0.0):
                    set footprint to the bim ring area of (element's points's values)
                    set row's area to row's area + (footprint * (row's count as a 64 bit floating-point number))
                    set row's volume to row's volume + ((footprint * element's height) * (row's count as a 64 bit floating-point number))
            append row to (rows's values)
        free wallVolumes
        free wallOpenings
        free slabVolumes
        append bim services rows of modelValue to (rows's values)
        # The clashes, one row per pair, named by the elements' types.
        set clashList to the bim clashes of modelValue
        loop cursor from 0 to the length of (clashList's values):
            set clashValue to the item at cursor in (clashList's values)
            set row to a bim schedule row in (the string form of "Clashes") named (((the bim tag text of clashValue's firstId in modelValue) + (the string form of " with ")) + (the bim tag text of clashValue's secondId in modelValue))
            set row's count to 1
            append row to (rows's values)
        return rows

# `value` with two decimals, or blank when it is negative (does not apply).
function the bim schedule text of {a 64 bit floating-point number:value}:
    execute:
        if value < 0.0:
            return the string form of ""
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.2f", value)
        return the substring of buffer from 0 spanning written bytes

# The schedules the project browser lists, by code: 0 all quantities, 1
# walls, 2 doors and windows, 3 floors, roofs and ceilings, 4 linear
# elements, 5 spaces.
function the bim schedule name of {integer:scheduleCode}:
    execute:
        if scheduleCode = 1:
            return the string form of "Walls"
        if scheduleCode = 2:
            return the string form of "Doors and windows"
        if scheduleCode = 3:
            return the string form of "Floors, roofs, ceilings"
        if scheduleCode = 4:
            return the string form of "Linear elements"
        if scheduleCode = 5:
            return the string form of "Spaces"
        if scheduleCode = 6:
            return the string form of "Building services"
        if scheduleCode = 7:
            return the string form of "Clashes"
        return the string form of "Quantities"

function the bim schedule count:
    replacement:
        8

# Whether a row of `group` belongs in schedule `scheduleCode`.
function bim schedule group {a string:group} belongs in {integer:scheduleCode}:
    execute:
        if scheduleCode = 0:
            return group != (the string form of "Clashes")
        if scheduleCode = 1:
            return group = (the string form of "Walls")
        if scheduleCode = 2:
            return (group = (the string form of "Doors")) or (group = (the string form of "Windows"))
        if scheduleCode = 3:
            return ((group = (the string form of "Floors")) or (group = (the string form of "Roofs"))) or (group = (the string form of "Ceilings"))
        if scheduleCode = 4:
            return ((((group = (the string form of "Columns")) or (group = (the string form of "Beams"))) or ((group = (the string form of "Mullions")) or (group = (the string form of "Skirtings")))) or (group = (the string form of "Pipes"))) or (((group = (the string form of "Linear elements")) or (group = (the string form of "Ducts"))) or (group = (the string form of "Cable trays")))
        if scheduleCode = 5:
            return group = (the string form of "Spaces")
        if scheduleCode = 7:
            return group = (the string form of "Clashes")
        if scheduleCode = 6:
            if (the length of group) < 8:
                return false
            return (the substring of group from 0 spanning 8 bytes) = (the string form of "Services")
        return false

# The rows of `rows` in schedule `scheduleCode`.
function the bim rows of {a pointer to a list:rows} in schedule {integer:scheduleCode}:
    execute:
        set chosen to a cad topology list of a bim schedule row record
        loop cursor from 0 to the length of rows:
            set row to the item at cursor in rows
            if bim schedule group row's group belongs in scheduleCode:
                append row to (chosen's values)
        return chosen

# The schedule as comma-separated text, with a header line.
function the bim schedule csv of {a pointer to a list:rows}:
    execute:
        set text to the string form of "Group,Type,Count,Length (m),Area (m2),Volume (m3)\n"
        loop cursor from 0 to the length of rows:
            set row to the item at cursor in rows
            set line to ((row's group + (the string form of ",")) + row's name) + (the string form of ",")
            set line to ((line + (the string form of row's count)) + (the string form of ",")) + (the bim schedule text of row's length)
            set line to ((line + (the string form of ",")) + (the bim schedule text of row's area)) + (the string form of ",")
            set text to ((text + line) + (the bim schedule text of row's volume)) + (the string form of "\n")
        return text
