# SPDX-License-Identifier: MPL-2.0
# The properties window: the rows of a wall, an opening and the storey, and
# values typed into them in the project's units.
import examples/bim-slice/bim_editor.dl

function show bim properties of {a pointer to a bim editor record:editor} labelled {a string:caption}:
    execute:
        print caption as a line
        set propertyRows to the bim property rows of (@intrinsic("dereference", editor))
        loop cursor from 0 to the length of propertyRows:
            set propertyRow to the item at cursor in propertyRows
            print ((the string form of "  ") + ((propertyRow's label + (the string form of ": ")) + ((propertyRow's value + (the string form of " #")) + (the string form of propertyRow's code)))) as a line

function type bim properties test {a string:keys} in {a pointer to a bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of keys:
            type bim editor key ((the character at cursor in keys) as an integer) in editor
        type bim editor key bim enter key code in editor

set editor to a new bim editor
set e to the address of editor
add bim example building to e
type bim editor key 2050 in e
show bim properties of e labelled (the string form of "storey")
select bim editor bim wall picked numbered (5 as a 64 bit integer) in e
show bim properties of e labelled (the string form of "wall 5")
start bim editor property bim wall height property in e
type bim properties test (the string form of "2750") in e
print editor's message as a line
start bim editor property bim wall bulge property in e
type bim properties test (the string form of "500") in e
show bim properties of e labelled (the string form of "wall 5 changed")
select bim editor bim opening picked numbered (11 as a 64 bit integer) in e
start bim editor property bim opening offset property in e
type bim properties test (the string form of "3000") in e
start bim editor property bim opening width property in e
type bim properties test (the string form of "1000") in e
show bim properties of e labelled (the string form of "opening 11 changed")
select bim editor bim nothing picked numbered (the bim refused id) in e
start bim editor property bim level height property in e
type bim properties test (the string form of "3100") in e
show bim properties of e labelled (the string form of "storey changed")
start bim editor property bim level height property in e
type bim properties test (the string form of "-5") in e
print editor's message as a line
