# SPDX-License-Identifier: MPL-2.0
# One edit mode for every element, as in Blender: Tab on a selected grid,
# wall, linear element, floor or level edits its control points. A grid's
# end picked and grabbed 2 m along X moves that end only; a level grabbed
# 0.5 m up along Z rises. The 3D gizmo drags a wall along X; Rotate turns
# about the 3D cursor when Enter answers its centre.
import examples/bim-slice/bim_editor.dl

function click bim control test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        refresh bim editor editor
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function type bim control test {a string:keys} in {a pointer to a bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of keys:
            type bim editor key ((the character at cursor in keys) as an integer) in editor

function show bim control wall of {bim model record:modelValue} labelled {a string:label}:
    execute:
        set wallValue to the item at ((the length of (modelValue's walls's values)) - 1) in (modelValue's walls's values)
        print ((label + (the string form of ": ")) + ((the bim length wallValue's start's x in units 0) + ((the string form of ",") + ((the bim length wallValue's start's y in units 0) + ((the string form of " -> ") + ((the bim length wallValue's finish's x in units 0) + ((the string form of ",") + (the bim length wallValue's finish's y in units 0)))))))) as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set gridId to add bim grid named (the string form of "A") from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 8.0) reaching -1.0 to 10.0 to target
commit bim transaction in (the address of (editor's documentValue))
select bim editor bim grid picked numbered gridId in e
type bim editor key 258 in e
print editor's message as a line
click bim control test at 0.0 and 8.0 in e
print editor's message as a line
type bim editor key 71 in e
type bim editor key 88 in e
type bim control test (the string form of "2") in e
type bim editor key bim enter key code in e
print editor's message as a line
set gridValue to the item at 0 in (editor's documentValue's current's grids's values)
print ((the string form of "grid A: ") + ((the bim length gridValue's start's x in units 0) + ((the string form of ",") + ((the bim length gridValue's start's y in units 0) + ((the string form of " -> ") + ((the bim length gridValue's finish's x in units 0) + ((the string form of ",") + (the bim length gridValue's finish's y in units 0)))))))) as a line
type bim editor key 258 in e
print editor's message as a line
# A level: its one point, grabbed along Z.
set levelId to (the item at 0 in (editor's documentValue's current's levels's values))'s id
select bim editor bim level picked numbered levelId in e
type bim editor key 258 in e
print editor's message as a line
type bim editor key 71 in e
type bim editor key 90 in e
type bim control test (the string form of "0.5") in e
type bim editor key bim enter key code in e
set levelValue to the item at 0 in (editor's documentValue's current's levels's values)
print ((the string form of "level at ") + (the bim length levelValue's elevation in units 0)) as a line
type bim editor key bim escape key code in e
# Undo takes the level back.
type bim editor key 90 in e
print ((the string form of "undone: level at ") + (the bim length (the item at 0 in (editor's documentValue's current's levels's values))'s elevation in units 0)) as a line
# The 3D gizmo: a wall's middle, dragged 1 m along X as one edit.
type bim editor key 87 in e
click bim control test at 0.0 and 2.0 in e
click bim control test at 4.0 and 2.0 in e
type bim editor key bim escape key code in e
type bim editor key bim escape key code in e
type bim editor key 83 in e
click bim control test at 2.0 and 2.0 in e
set middle to the bim selection centre of editor
print ((the string form of "gizmo at ") + ((the bim length middle's point's x in units 0) + ((the string form of ",") + (the bim length middle's point's y in units 0)))) as a line
begin bim editor gizmo drag in e
set pivot to a cad vector2 with x middle's point's x and y middle's point's y
drag bim editor gizmo by (a cad vector2 with x 0.5 and y 0.0) turning 0.0 about pivot in e
drag bim editor gizmo by (a cad vector2 with x 1.0 and y 0.0) turning 0.0 about pivot in e
finish bim editor gizmo drag in e
show bim control wall of editor's documentValue's current labelled (the string form of "dragged 1 m along X")
# The 3D cursor as Rotate's centre: Enter instead of a click turns about it.
place bim editor cursor at (a cad vector2 with x 0.0 and y 0.0) in e
# The wall is still selected, so Rotate asks for its centre at once.
type bim editor key 2010 in e
print editor's message as a line
type bim editor key bim enter key code in e
print editor's message as a line
type bim control test (the string form of "90") in e
type bim editor key bim enter key code in e
show bim control wall of editor's documentValue's current labelled (the string form of "turned 90 degrees about the cursor")
