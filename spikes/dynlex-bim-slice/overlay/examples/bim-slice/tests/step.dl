# SPDX-License-Identifier: MPL-2.0
# STEP physical files (`bim_step.dl`): the index of instances, the schema,
# and an instance's arguments: numbers, strings with escapes, enumerations,
# references, unset and derived values, typed values and nested lists; broken
# files refused.
import examples/bim-slice/bim_step.dl

function the step test value {integer:nodeIndex} of {bim step instance record:instanceValue}:
    execute:
        set valueKind to the bim step kind of nodeIndex in instanceValue
        if valueKind = bim step unset:
            return the string form of "$"
        if valueKind = bim step derived:
            return the string form of "*"
        if valueKind = bim step reference:
            return (the string form of "#") + (the string form of (the bim step reference of nodeIndex in instanceValue))
        if valueKind = bim step whole number:
            return (the string form of "int ") + (the string form of ((the bim step number of nodeIndex in instanceValue) as an integer))
        if valueKind = bim step number:
            return (the string form of "real ") + (the string form of (the bim step number of nodeIndex in instanceValue))
        if valueKind = bim step text:
            return ((the string form of "'") + (the bim step string of nodeIndex in instanceValue)) + (the string form of "'")
        if valueKind = bim step enumeration:
            return ((the string form of ".") + (the bim step raw text of nodeIndex in instanceValue)) + (the string form of ".")
        if valueKind = bim step typed:
            set typedNode to the item at nodeIndex in (instanceValue's nodes)
            set typedName to the substring of (instanceValue's text) from typedNode's start spanning typedNode's length bytes
            return ((typedName + (the string form of "(")) + (the step test value (the item at typedNode's first in (instanceValue's members)) of instanceValue)) + (the string form of ")")
        set pieces to an empty list of a string
        loop cursor from 0 to the bim step count of nodeIndex in instanceValue:
            append (the step test value (the bim step member cursor of nodeIndex in instanceValue) of instanceValue) to pieces
        set joined to ((the string form of "[") + (pieces joined with ", ")) + (the string form of "]")
        free pieces
        return joined

set lines to an empty list of a string
append (the string form of "ISO-10303-21;") to lines
append (the string form of "HEADER;") to lines
append (the string form of "FILE_DESCRIPTION(('ViewDefinition [CoordinationView]'),'2;1');") to lines
append (the string form of "FILE_SCHEMA(('IFC4X3_ADD2'));") to lines
append (the string form of "ENDSEC;") to lines
append (the string form of "DATA;") to lines
append (the string form of "#1=IFCCARTESIANPOINT((0.,-2.5,1.E3));") to lines
set backslash to a new string buffer containing 1 bytes
store (92 as a byte) into the data of backslash at 0
set accented to (((backslash + (the string form of "X2")) + backslash) + (the string form of "00E9")) + ((backslash + (the string form of "X0")) + backslash)
append (((the string form of "/* a comment */ #12 = IFCWALL('2O2Fr$t4X7Zf8NOew3FLOH',$,'Wall ''north'' ") + accented) + (the string form of "',*,.NOTDEFINED.,#1,(#1,(3,4)),IFCLENGTHMEASURE(2.75));")) to lines
append (the string form of "#7=IFCPROPERTYSINGLEVALUE('Fire; rating',$,IFCLABEL('EI 60'),$);") to lines
append (the string form of "ENDSEC;") to lines
append (the string form of "END-ISO-10303-21;") to lines
set fileText to lines joined with "\n"
set stepFile to the bim step file of fileText
print ((the string form of "valid: ") + (the string form of stepFile's valid)) as a line
print ((the string form of "schema: ") + stepFile's schema) as a line
print ((the string form of "instances: ") + (the string form of stepFile's count)) as a line
print ((the string form of "#12 is a wall: ") + (the string form of (bim step instance 12 is a "IFCWALL" in stepFile))) as a line
print ((the string form of "#12 is a wall type: ") + (the string form of (bim step instance 12 is a "IFCWALLTYPE" in stepFile))) as a line
print ((the string form of "#5 exists: ") + (the string form of (bim step file stepFile holds 5))) as a line
loop identifier from 0 to 13:
    if bim step file stepFile holds identifier:
        set instanceValue to the bim step instance identifier in stepFile
        set shown to ((the string form of "#") + (the string form of identifier)) + ((the string form of " ") + (instanceValue's typeName + (the string form of " ")))
        print (shown + (the step test value instanceValue's root of instanceValue)) as a line
        free bim step instance instanceValue
set broken to the bim step file of (the string form of "ISO-10303-21;\nDATA;\n#1=IFCX(1);\n#2 IFCX(2);\nENDSEC;\n")
print ((the string form of "broken: ") + broken's message) as a line
set unfinished to the bim step file of (the string form of "ISO-10303-21;\nDATA;\n#1=IFCX(1);\n")
print ((the string form of "unfinished: ") + unfinished's message) as a line
print ((the string form of "not STEP: ") + (the bim step file of (the string form of "{}"))'s message) as a line
