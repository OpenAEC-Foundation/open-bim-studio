# SPDX-License-Identifier: MPL-2.0
# Phasing: the phases of the project, when each element was built and
# demolished, and how a view shows it after its phase and its drawing type's
# phase filter. Column A stood before (Existing), column B stood before and
# is demolished in New construction, column C is new. Seen in New
# construction with every phase shown: A in halftone, B as demolished, C as
# normal; seen in Existing: A and B as normal, C not at all. A floor plan
# filtered to new construction shows only C; filtered to existing and
# demolished, A and B. The phases, the phasings and the view's phase survive
# the file and IfcX.
import examples/bim-slice/bim_file.dl
import examples/bim-slice/bim_ifcx.dl
import examples/bim-slice/bim_ifcx_read.dl

function the phase look word of {integer:lookCode}:
    execute:
        if lookCode = bim phase hidden look:
            return the string form of "hidden"
        if lookCode = bim phase faint look:
            return the string form of "halftone"
        if lookCode = bim phase demolished look:
            return the string form of "demolished"
        return the string form of "normal"

function show phase looks of {a pointer to a list:columns} in view {a 64 bit integer:viewId} of {bim model record:modelValue} labelled {a string:label}:
    execute:
        set viewValue to the item at (the bim view index of viewId in modelValue)'s position in (modelValue's views's values)
        set line to label + (the string form of ":")
        set names to [the string form of " A ", the string form of ", B ", the string form of ", C "]
        loop cursor from 0 to 3:
            set seen to the bim phase look of element (the item at cursor in columns) in view viewValue in modelValue
            set line to (line + (the item at cursor in names)) + (the phase look word of seen)
        print line as a line

set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
set columnType to add bim linear type named (the string form of "Kolom") as role bim column role sized 0.3 by 0.3 round false of (the string form of "concrete") to target
set columns to an empty list of a 64 bit integer
loop cursor from 0 to 3:
    set along to (cursor as a 64 bit floating-point number) * 3.0
    set foot to a cad vector3 with x along, y 0.0 and z 0.0
    set head to a cad vector3 with x along, y 0.0 and z 3.0
    append (add bim linear typed columnType on storey from foot to head turned 0.0 to target) to columns
set planView to add bim view of kind bim plan view named (the string form of "Ground floor") on storey to target
show phase looks of columns in view planView of modelValue labelled (the string form of "no phases")
ensure bim phases in target
set existing to (the item at 0 in (modelValue's phases's values))'s id
set newWork to (the item at 1 in (modelValue's phases's values))'s id
print ((the string form of "phases: ") + (((the item at 0 in (modelValue's phases's values))'s name + (the string form of ", ")) + (the item at 1 in (modelValue's phases's values))'s name)) as a line
set bim element (the item at 0 in columns) built in existing demolished in (the bim refused id) in target
set bim element (the item at 1 in columns) built in existing demolished in newWork in target
print ((the string form of "phasings kept: ") + (the string form of (the length of (modelValue's phasings's values)))) as a line
show phase looks of columns in view planView of modelValue labelled (the string form of "new construction, show all")
set viewValue to the item at (the bim view index of planView in modelValue)'s position in (modelValue's views's values)
set viewValue's phaseId to existing
store bim view viewValue in target
show phase looks of columns in view planView of modelValue labelled (the string form of "existing, show all")
ensure bim drawing types in target
set floorPlan to the bim drawing type named (the string form of "Floor plan") in modelValue
set viewValue to the item at (the bim view index of planView in modelValue)'s position in (modelValue's views's values)
set viewValue's phaseId to the bim refused id
set viewValue's drawingTypeId to floorPlan
set viewValue's automatic to true
store bim view viewValue in target
ignore set bim drawing type floorPlan setting 3 at 0 to bim show new phase in target
show phase looks of columns in view planView of modelValue labelled (the string form of "floor plan, new construction")
ignore set bim drawing type floorPlan setting 3 at 0 to bim show existing and demolished phases in target
show phase looks of columns in view planView of modelValue labelled (the string form of "floor plan, existing and demolished")
set bim element (the item at 1 in columns) built in (the bim refused id) demolished in (the bim refused id) in target
print ((the string form of "B made plain again, phasings kept: ") + (the string form of (the length of (modelValue's phasings's values)))) as a line
set bim element (the item at 1 in columns) built in existing demolished in newWork in target
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of " ") + reread's message))) as a line
print ((the string form of "phases ") + ((the string form of (the length of (reread's modelValue's phases's values))) + ((the string form of ", phasings ") + (the string form of (the length of (reread's modelValue's phasings's values)))))) as a line
show phase looks of columns in view planView of reread's modelValue labelled (the string form of "from .bim")
set exported to the bim ifcx text of modelValue identified as (the string form of "f.ifcx") for project (the string form of "f") by (the string form of "test") at (the string form of "2026-10-12T00:00:00Z")
set native to the bim native text of ifcx exported
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of " ") + fromIfcx's message))) as a line
print ((the string form of "phases ") + ((the string form of (the length of (fromIfcx's modelValue's phases's values))) + ((the string form of ", phasings ") + (the string form of (the length of (fromIfcx's modelValue's phasings's values)))))) as a line
show phase looks of columns in view planView of fromIfcx's modelValue labelled (the string form of "from .ifcx")
