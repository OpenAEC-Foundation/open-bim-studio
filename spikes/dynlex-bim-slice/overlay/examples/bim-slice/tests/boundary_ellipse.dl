# SPDX-License-Identifier: MPL-2.0
# Analytic ellipse quarters survive tessellation and native-file persistence.
import examples/bim-slice/bim_boundary_sketch.dl
import examples/bim-slice/bim_file.dl

function check boundary ellipse {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set ellipse to the bim boundary ellipse between (a cad vector2 with x -3.0 and y -2.0) and (a cad vector2 with x 3.0 and y 2.0)
check boundary ellipse ((the length of (ellipse's values)) = 4) named (the string form of "an ellipse retains four analytic quarters")
set chained to the bim boundary loop of (ellipse's values)
check boundary ellipse (chained's valid and (bim outline (chained's corners's values) is simple)) named (the string form of "ellipse quarters form a simple closed boundary")
set approximationCorrect to true
loop quarterCursor from 0 to 4:
    set quarter to the item at quarterCursor in (ellipse's values)
    set count to the bim pieces of boundary segment quarter
    loop step from 0 to count:
        set firstShare to (step as a 64 bit floating-point number) / (count as a 64 bit floating-point number)
        set lastShare to ((step + 1) as a 64 bit floating-point number) / (count as a 64 bit floating-point number)
        set exactMiddle to the bim ellipse quarter point of quarter at ((firstShare + lastShare) * 0.5)
        set firstSpot to the bim ellipse quarter point of quarter at firstShare
        set lastSpot to the bim ellipse quarter point of quarter at lastShare
        set chordMiddle to a cad vector2 with x ((firstSpot's x + lastSpot's x) * 0.5) and y ((firstSpot's y + lastSpot's y) * 0.5)
        if (the cad distance from exactMiddle to chordMiddle) > 0.0005:
            set approximationCorrect to false
check boundary ellipse approximationCorrect named (the string form of "ellipse chord error stays below half a millimetre")
set transformedCorners to an empty list of a cad vector2
loop cursor from 0 to the length of (chained's corners's values):
    set spot to the item at cursor in (chained's corners's values)
    append (a cad vector2 with x (10.0 + spot's y) and y (20.0 + spot's x)) to transformedCorners
set reopened to the bim boundary segments of transformedCorners spanned (chained's spans's values)
set centresCorrect to (the length of (reopened's values)) = 4
loop cursor from 0 to the length of (reopened's values):
    set quarter to the item at cursor in (reopened's values)
    if (quarter's elliptic = false) or ((the cad distance from quarter's centre to (a cad vector2 with x 10.0 and y 20.0)) > 1e-8):
        set centresCorrect to false
check boundary ellipse centresCorrect named (the string form of "mirrored and translated quarters recover their analytic centres")
set firstQuarter to the item at 0 in (ellipse's values)
set reversed to the bim boundary segment firstQuarter reversed
check boundary ellipse ((the cad distance from (the bim middle of boundary segment reversed) to (the bim middle of boundary segment firstQuarter)) < 1e-9) named (the string form of "reversing a quarter preserves its curve")
set moved to the bim boundary segment firstQuarter moving endpoints firstQuarter's start and firstQuarter's finish by (a cad vector2 with x 1.0 and y 2.0)
check boundary ellipse ((the cad distance from moved's centre to (a cad vector2 with x 1.0 and y 2.0)) < 1e-9) named (the string form of "moving an elliptic edge translates its centre")
set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set floorId to add bim slab on ground around (chained's corners's values) thick 0.25 to target
set refusal to set bim slab floorId boundary to (ellipse's values) in target
set parsed to the bim model parsed from (the bim file text of modelValue)
check boundary ellipse parsed's valid named (the string form of "the saved ellipse model parses successfully")
set persisted to the bim boundary segments of slab floorId in parsed's modelValue
set persistedCorrect to (the length of (persisted's values)) = 4
loop cursor from 0 to the length of (persisted's values):
    if ((the item at cursor in (persisted's values))'s elliptic) = false:
        set persistedCorrect to false
check boundary ellipse ((refusal = (the string form of "")) and persistedCorrect) named (the string form of "native-file round trip preserves editable ellipse quarters")
set flatEllipse to the bim boundary ellipse between (a cad vector2 with x 0.0 and y 0.0) and (a cad vector2 with x 0.0 and y 2.0)
check boundary ellipse ((the length of (flatEllipse's values)) = 0) named (the string form of "a zero-width ellipse is refused")
free transformedCorners
