# SPDX-License-Identifier: MPL-2.0
# Linear members and connections: cross-section areas of library profiles,
# a free beam, and every connection template of the library on a pair of
# members (a column and a beam framing into it, or a column alone): the
# trims it makes, the parts it adds and the material it cuts out. Every
# fast solid is checked to be closed.
import examples/bim-slice/bim_framing.dl
import examples/bim-slice/bim_profiles.dl
import examples/bim-slice/bim_connection_library.dl

function the bim framing test text of {a 64 bit floating-point number:value} digits {integer:digits}:
    execute:
        set buffer to a new string buffer containing 48 bytes
        set format to "%.4f"
        if digits = 1:
            set format to "%.1f"
        if digits = 6:
            set format to "%.6f"
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 49 as a word sized unsigned integer, format, value)
        return the substring of buffer from 0 spanning written bytes

function a bim framing point at {a 64 bit floating-point number:x}, {a 64 bit floating-point number:y} and {a 64 bit floating-point number:z}:
    execute:
        return a cad vector3 with x x, y y and z z

# The volume of a framing solid and, for a fast one, whether it is closed.
function report bim framing solid {bim framing solid record:built} labelled {a string:label}:
    execute:
        set line to (label + (the string form of " status ")) + (the string form of built's status)
        if built's status = 0:
            if built's fast:
                set line to (line + (the string form of " flaw ")) + (the string form of (the fast flaw of built's shape within 1e-9))
                set line to (line + (the string form of " volume ")) + (the bim framing test text of (the fast volume of built's shape) digits 6)
            else:
                set tessellated to the cad mesh of built's solid with maximum angle 0.3 within 1e-6
                set properties to the cad mass properties of tessellated
                set line to line + (the string form of " cut")
                if properties's valid:
                    set line to (line + (the string form of " volume ")) + (the bim framing test text of properties's value's volume digits 6)
        print line as a line

function the bim framing template named {a string:wanted}:
    execute:
        set offered to the bim connection templates
        set chosen to the item at 0 in offered
        loop cursor from 0 to the length of offered:
            if (the item at cursor in offered)'s name = wanted:
                set chosen to the item at cursor in offered
        free offered
        return chosen

set library to the bim steel profiles
print ((the string form of "library profiles ") + (the string form of (the length of (library's values)))) as a line
set names to an empty list of a string
append (the string form of "IPE 300") to names
append (the string form of "HEA 200") to names
append (the string form of "INP 200") to names
append (the string form of "UNP 200") to names
append (the string form of "L 100x100x10") to names
append (the string form of "RHS 200x100x8") to names
append (the string form of "CHS 168.3x8.0") to names
append (the string form of "Timber 71x171") to names
append (the string form of "GL24h 140x440") to names
append (the string form of "Concrete 300x400") to names
append (the string form of "Concrete D400") to names
loop cursor from 0 to the length of names:
    set profile to the bim steel profile named (the item at cursor in names) in (library's values)
    set area to (the bim section area of profile) * 1000000.0
    print ((profile's name + (the string form of " area mm2 ")) + ((the bim framing test text of area digits 1) + ((the string form of " ") + profile's material))) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target

# A free beam: square ends, the section's area times its length.
set ipe to add bim member type named (the string form of "IPE 300") with profile (the bim steel profile named (the string form of "IPE 300") in (library's values)) in (the string form of "S235") to target
set free to add bim member typed ipe on storey as bim beam role from (a bim framing point at 0.0, -20.0 and 3.0) to (a bim framing point at 6.0, -20.0 and 3.0) to target
report bim framing solid (the bim member solid of free in modelValue) labelled (the string form of "free beam")
print ((the string form of "  area times length ") + (the bim framing test text of ((the bim section area of (the bim steel profile named (the string form of "IPE 300") in (library's values))) * 6.0) digits 6)) as a line

# Each template on its own pair of members, 20 m apart: a column 4 m high
# and a beam at 3 m framing into it (a T), or meeting its top (an L) for
# the mitre and the half lap, or the column alone for the base plate.
set pairs to an empty list of a string
append (the string form of "Butt|HEA 200|IPE 300|T") to pairs
append (the string form of "Mitre|IPE 300|IPE 300|L") to pairs
append (the string form of "End plate 20 + stiffeners|HEA 200|IPE 300|T") to pairs
append (the string form of "Fin plate 10, 3 M20|HEA 200|IPE 300|T") to pairs
append (the string form of "Base plate 25, 4 M24|HEA 200|-|-") to pairs
append (the string form of "Gusset 12|HEA 200|CHS 168.3x8.0|T") to pairs
append (the string form of "Mortise and tenon|GL24h 200x200|GL24h 140x400|T") to pairs
append (the string form of "Half lap|Timber 146x146|Timber 146x146|L") to pairs
append (the string form of "Slotted plate, dowels|GL24h 200x200|GL24h 140x400|T") to pairs
append (the string form of "Corbel|Concrete 400x400|Concrete 300x500|T") to pairs
append (the string form of "Angle cleat, screws|SHS 100x100x5|IPE 200|T") to pairs
loop cursor from 0 to the length of pairs:
    set fields to (the item at cursor in pairs) split at "|"
    set template to the bim framing template named (the item at 0 in fields)
    set typeId to add bim connection type template to target
    set x to 20.0 * ((cursor + 1) as a 64 bit floating-point number)
    set columnProfile to the bim steel profile named (the item at 1 in fields) in (library's values)
    set columnType to add bim member type named (the item at 1 in fields) with profile columnProfile in columnProfile's material to target
    set columnHeight to 4.0
    if (the item at 3 in fields) = (the string form of "L"):
        set columnHeight to 3.0
    set column to add bim member typed columnType on storey as bim column role from (a bim framing point at x, 0.0 and 0.0) to (a bim framing point at x, 0.0 and columnHeight) to target
    set joint to the bim refused id
    set beam to the bim refused id
    if template's roles = 1:
        set joint to add bim joint typed typeId on column to target
    else:
        set beamProfile to the bim steel profile named (the item at 2 in fields) in (library's values)
        set beamType to add bim member type named (the item at 2 in fields) with profile beamProfile in beamProfile's material to target
        set role to bim beam role
        set beamFinish to a bim framing point at (x + 5.0), 0.0 and 3.0
        if (the item at 2 in fields) starts with "CHS":
            set role to bim brace role
            set beamFinish to a bim framing point at (x + 4.0), 0.0 and 0.0
        set beam to add bim member typed beamType on storey as role from (a bim framing point at x, 0.0 and 3.0) to beamFinish to target
        if (the item at 3 in fields) = (the string form of "L"):
            ignore set bim member beam justification to bim centre justification in target
        set joint to add bim joint typed typeId between column and beam to target
    print ((template's name + (the string form of ": joint ")) + (the string form of (joint != the bim refused id))) as a line
    report bim framing solid (the bim member solid of column in modelValue) labelled (the string form of "  column")
    if beam != the bim refused id:
        report bim framing solid (the bim member solid of beam in modelValue) labelled (the string form of "  beam")
    set jointValue to the item at (the bim joint index of joint in modelValue)'s position in (modelValue's joints's values)
    report bim framing solid (the bim joint solid of jointValue in modelValue) labelled (the string form of "  parts")
    print ((the string form of "  drawn as ") + (the bim drawing material of joint in modelValue)) as a line

# A parameter change: the end plate 5 mm thicker moves the beam's end back by
# 5 mm and thickens the plate.
set plated to the item at 2 in (modelValue's connectionTypes's values)
set plateJoint to the item at 2 in (modelValue's joints's values)
set plateBeam to the item at 1 in (plateJoint's members's values)
set before to the bim end of (the bim member choice of plateBeam in modelValue) at finish false in modelValue
ignore set bim connection type (plated's id) parameter 1 to 0.025 in target
set after to the bim end of (the bim member choice of plateBeam in modelValue) at finish false in modelValue
print ((the string form of "end plate 25 mm: beam end moved ") + ((the bim framing test text of ((after's cut's point's x - before's cut's point's x) * 1000.0) digits 1) + (the string form of " mm"))) as a line

# Swapping and deleting.
print ((the string form of "swap: ") + (the string form of (swap bim joint (plateJoint's id) in target))) as a line
set jointsBefore to the length of (modelValue's joints's values)
ignore delete bim member (the item at 0 in (plateJoint's members's values)) from target
print ((the string form of "joints after deleting a member ") + ((the string form of (the length of (modelValue's joints's values))) + ((the string form of " of ") + (the string form of jointsBefore)))) as a line
print ((the string form of "a joint of the wrong number of members refused: ") + (the string form of ((add bim joint typed (plated's id) on free to target) = the bim refused id))) as a line
