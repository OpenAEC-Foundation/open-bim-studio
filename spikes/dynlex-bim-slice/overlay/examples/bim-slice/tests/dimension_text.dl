# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/bim_svg.dl

function check dimension text {boolean:condition} named {a string:name}:
    execute:
        if condition:
            print ((the string form of "PASS ") + name) as a line
        else:
            print ((the string form of "FAIL ") + name) as a line

set first to a cad vector2 with x 10.0 and y 10.0
set last to a cad vector2 with x 30.0 and y 30.0
set forward to the bim readable text angle from first to last
set reverse to the bim readable text angle from last to first
check dimension text ((the absolute value of (forward - reverse)) < 0.000001) named (the string form of "endpoint order preserves text orientation")
check dimension text ((the absolute value of (forward - 0.7853981633974483)) < 0.000001) named (the string form of "diagonal parallel")
set vertical to the bim readable text angle from first to (a cad vector2 with x 10.0 and y 30.0)
check dimension text ((the absolute value of (vertical + 1.5707963267948966)) < 0.000001) named (the string form of "vertical reads bottom to top")
set canvas to a new bim canvas
record bim dimension text (the string form of "28284") between first and last on (the address of canvas)
set label to the item at 0 in (canvas's texts's values)
check dimension text (label's centred and ((the absolute value of (label's angle - forward)) < 0.000001)) named (the string form of "canvas retains rotation")
set svgText to the bim svg of canvas sized 100.0 by 100.0 with text 2.5 high
check dimension text ((the index of (the string form of "rotate(45") in svgText) >= 0) named (the string form of "SVG rotation")
set pdfText to the bim pdf content of canvas on a page 100.0 high with text 2.5 high
check dimension text ((the index of (the string form of " Tm (") in pdfText) >= 0) named (the string form of "PDF rotated text matrix")
