# SPDX-License-Identifier: MPL-2.0
# The editor on view records: the window prepares a plan view per storey and
# the plan shows the active storey's; a new storey (PgUp from the top) gets
# its own; DV duplicates the plan view shown; rules changed in a view stay
# with that view, and showing another view brings its own rules back.
import examples/bim-slice/bim_editor.dl

function show view editor state of {bim editor record:editor} labelled {a string:title}:
    execute:
        set found to the bim view index of editor's planViewId in editor's documentValue's current
        set name to the string form of "none"
        if found's valid:
            set name to (the item at found's position in (editor's documentValue's current's views's values))'s name
        set line to (title + (the string form of ": plan view ")) + name
        set line to (line + (the string form of ", storey ")) + (the bim storey name of editor)
        set line to (line + (the string form of ", walls halftone ")) + (the string form of (bim category bim wall category is halftone in editor's planRules))
        set line to (line + (the string form of ", views ")) + (the string form of (the length of (editor's documentValue's current's views's values)))
        print line as a line

set editor to a new bim editor
set e to the address of editor
show view editor state of editor labelled (the string form of "new editor")
prepare bim editor views in e
show view editor state of editor labelled (the string form of "prepared")
# PgUp from the top storey makes a storey; the window prepares its view.
type bim editor key 266 in e
prepare bim editor views in e
show view editor state of editor labelled (the string form of "storey added")
type bim editor key 267 in e
show view editor state of editor labelled (the string form of "back down")
# DV, then walls in halftone in the copy only.
type bim editor key 2092 in e
print editor's message as a line
toggle bim category bim wall category halftone in (the address of (editor's planRules))
keep bim editor plan rules in e
show view editor state of editor labelled (the string form of "copy, walls halftone")
set original to the bim plan view of storey editor's levelId for editor
loop cursor from 0 to the length of (editor's documentValue's current's views's values):
    set viewValue to the item at cursor in (editor's documentValue's current's views's values)
    if (viewValue's kind = bim plan view) and ((viewValue's levelId = editor's levelId) and (viewValue's id != editor's planViewId)):
        set original to viewValue's id
set copyId to editor's planViewId
show bim editor plan view original in e
show view editor state of editor labelled (the string form of "original shown")
show bim editor plan view copyId in e
show view editor state of editor labelled (the string form of "copy shown again")

# Two sections drawn with the section tool (C) are two section views; each
# shows its own line, and they survive .bim.
function click view editor test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.0001 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

type bim editor key 67 in e
click view editor test at 0.0 and -2.0 in e
click view editor test at 0.0 and 6.0 in e
type bim editor key 67 in e
click view editor test at -2.0 and 1.0 in e
click view editor test at 8.0 and 1.0 in e
loop cursor from 0 to the length of (editor's documentValue's current's views's values):
    set sectionView to the item at cursor in (editor's documentValue's current's views's values)
    if sectionView's kind = bim section view:
        print (((sectionView's name + (the string form of " from ")) + ((the string form of sectionView's lineStart's x) + ((the string form of ",") + (the string form of sectionView's lineStart's y)))) + ((the string form of " to ") + ((the string form of sectionView's lineFinish's x) + ((the string form of ",") + (the string form of sectionView's lineFinish's y))))) as a line
print ((the string form of "section shown from y ") + (the string form of editor's sectionFirst's y)) as a line
set firstSection to the bim refused id
loop cursor from 0 to the length of (editor's documentValue's current's views's values):
    set sectionView to the item at cursor in (editor's documentValue's current's views's values)
    if (sectionView's kind = bim section view) and (firstSection = the bim refused id):
        set firstSection to sectionView's id
show bim editor section view firstSection in e
print ((the string form of "first section shown from y ") + (the string form of editor's sectionFirst's y)) as a line
set reread to the bim model parsed from (the bim file text of editor's documentValue's current)
set sectionCount to 0
loop cursor from 0 to the length of (reread's modelValue's views's values):
    if (the item at cursor in (reread's modelValue's views's values))'s kind = bim section view:
        set sectionCount to sectionCount + 1
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", section views ") + (the string form of sectionCount)))) as a line

# The plan view's scale and cut height typed in the properties (nothing
# selected), and a crop by two clicks (CV); UC uncrops.
function type view editor test {a string:keys} in {a pointer to a bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of keys:
            type bim editor key ((the character at cursor in keys) as an integer) in editor
        type bim editor key bim enter key code in editor

function show view editor plan view of {bim editor record:editor}:
    execute:
        set found to the bim view index of editor's planViewId in editor's documentValue's current
        set viewValue to the item at found's position in (editor's documentValue's current's views's values)
        set line to (viewValue's name + (the string form of ": 1:")) + (the string form of viewValue's scale)
        set line to (line + (the string form of ", cut ")) + (the string form of (the bim plan cut height of editor))
        set line to (line + (the string form of ", cropped ")) + (the string form of viewValue's cropped)
        if viewValue's cropped:
            set line to (line + (the string form of " from ")) + ((the string form of viewValue's cropLow's x) + ((the string form of ",") + (the string form of viewValue's cropLow's y)))
            set line to (line + (the string form of " to ")) + ((the string form of viewValue's cropHigh's x) + ((the string form of ",") + (the string form of viewValue's cropHigh's y)))
        print line as a line

type bim editor key bim escape key code in e
start bim editor property bim view scale property in e
type view editor test (the string form of "50") in e
start bim editor property bim view cut property in e
type view editor test (the string form of "1.5") in e
show view editor plan view of editor
type bim editor key 2093 in e
click view editor test at 1.0 and 2.0 in e
click view editor test at -1.0 and -0.5 in e
print editor's message as a line
show view editor plan view of editor
type bim editor key 2094 in e
show view editor plan view of editor

# NS makes a sheet; PV places the plan view shown on it and PS the schedule
# shown (its view made once); placing the same schedule again reuses it.
type bim editor key 2096 in e
print editor's message as a line
type bim editor key 2095 in e
print editor's message as a line
type bim editor key 2096 in e
print editor's message as a line
type bim editor key 2097 in e
print editor's message as a line
set editor's scheduleCode to 1
type bim editor key 2097 in e
print editor's message as a line
type bim editor key 2097 in e
set openSheet to the item at 0 in (editor's documentValue's current's sheets's values)
print ((the string form of "viewports on ") + (openSheet's number + ((the string form of ": ") + (the string form of (the length of (openSheet's viewports's values)))))) as a line
set scheduleViews to 0
loop cursor from 0 to the length of (editor's documentValue's current's views's values):
    if (the item at cursor in (editor's documentValue's current's views's values))'s kind = bim schedule view:
        set scheduleViews to scheduleViews + 1
print ((the string form of "schedule views ") + (the string form of scheduleViews)) as a line
