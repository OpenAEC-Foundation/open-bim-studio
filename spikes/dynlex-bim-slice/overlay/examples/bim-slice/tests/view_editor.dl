# SPDX-License-Identifier: MPL-2.0
# The editor on view records: the window prepares a plan view per storey and
# the plan shows the active storey's; a new storey (PgUp from the top) gets
# its own; DV duplicates the plan view shown; rules changed in a view stay
# with that view, and showing another view brings its own rules back.
import examples/bim-slice/bim_editor.dl

function show view editor state of {bim editor record:editor} labelled {a string:title}:
    execute:
        set found to the bim view index of editor's planViewId in editor's documentValue's current
        set name to the string form of "none"
        if found's valid:
            set name to (the item at found's position in (editor's documentValue's current's views's values))'s name
        set line to (title + (the string form of ": plan view ")) + name
        set line to (line + (the string form of ", storey ")) + (the bim storey name of editor)
        set line to (line + (the string form of ", walls halftone ")) + (the string form of (bim category bim wall category is halftone in editor's planRules))
        set line to (line + (the string form of ", views ")) + (the string form of (the length of (editor's documentValue's current's views's values)))
        print line as a line

set editor to a new bim editor
set e to the address of editor
show view editor state of editor labelled (the string form of "new editor")
prepare bim editor views in e
show view editor state of editor labelled (the string form of "prepared")
# PgUp from the top storey makes a storey; the window prepares its view.
type bim editor key 266 in e
prepare bim editor views in e
show view editor state of editor labelled (the string form of "storey added")
type bim editor key 267 in e
show view editor state of editor labelled (the string form of "back down")
# DV, then walls in halftone in the copy only.
type bim editor key 2092 in e
print editor's message as a line
toggle bim category bim wall category halftone in (the address of (editor's planRules))
keep bim editor plan rules in e
show view editor state of editor labelled (the string form of "copy, walls halftone")
set original to the bim plan view of storey editor's levelId for editor
loop cursor from 0 to the length of (editor's documentValue's current's views's values):
    set viewValue to the item at cursor in (editor's documentValue's current's views's values)
    if (viewValue's kind = bim plan view) and ((viewValue's levelId = editor's levelId) and (viewValue's id != editor's planViewId)):
        set original to viewValue's id
set copyId to editor's planViewId
show bim editor plan view original in e
show view editor state of editor labelled (the string form of "original shown")
show bim editor plan view copyId in e
show view editor state of editor labelled (the string form of "copy shown again")
