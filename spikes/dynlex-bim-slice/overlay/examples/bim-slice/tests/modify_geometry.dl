# SPDX-License-Identifier: MPL-2.0
import lib/std.dl
import examples/bim-slice/bim_modify_geometry.dl

function check modify geometry {boolean:passed} named {a string:caption}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set zero to a cad vector2 with x 0.0 and y 0.0
set east to a cad vector2 with x 10.0 and y 0.0
set north to a cad vector2 with x 0.0 and y 10.0
set rounded to the bim modify corner from zero to east keeping east and from zero to north keeping north sized 2.0 rounded true
check modify geometry rounded's valid named (the string form of "perpendicular lines admit a fillet")
check modify geometry (((the cad distance from rounded's firstCut to (a cad vector2 with x 2.0 and y 0.0)) < 1e-9) and ((the cad distance from rounded's secondCut to (a cad vector2 with x 0.0 and y 2.0)) < 1e-9)) named (the string form of "fillet tangent points use the requested radius")
set expectedMiddle to 2.0 - (the square root of 2.0)
check modify geometry ((the cad distance from rounded's middle to (a cad vector2 with x expectedMiddle and y expectedMiddle)) < 1e-9) named (the string form of "fillet middle lies on the tangent circle")
set bevel to the bim modify corner from zero to east keeping east and from zero to north keeping north sized 3.0 rounded false
check modify geometry (bevel's valid and ((the cad distance from bevel's firstCut to (a cad vector2 with x 3.0 and y 0.0)) < 1e-9)) named (the string form of "chamfer uses equal setbacks")
set refused to the bim modify corner from zero to east keeping east and from zero to north keeping north sized 20.0 rounded true
check modify geometry (refused's valid = false) named (the string form of "oversized corner leaves the source geometry untouched")
set parallel to the bim modify corner from zero to east keeping east and from (a cad vector2 with x 0.0 and y 2.0) to (a cad vector2 with x 10.0 and y 2.0) keeping east sized 1.0 rounded true
check modify geometry (parallel's valid = false) named (the string form of "parallel lines refuse a rounded corner")
