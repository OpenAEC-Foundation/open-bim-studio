# SPDX-License-Identifier: MPL-2.0
# The stair tool (ST): two clicks give a straight stair up the 3 m storey,
# its risers as many as keep each at most 185 mm; a click on it in plan
# selects it, Delete removes it, undo brings it back.
import examples/bim-slice/bim_editor.dl

function click stair test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.0001 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

set editor to a new bim editor
set e to the address of editor
type bim editor key 2099 in e
print editor's message as a line
click stair test at 0.0 and 0.0 in e
click stair test at 0.0 and 4.0 in e
print editor's message as a line
print ((the string form of "stairs ") + (the string form of (the length of (editor's documentValue's current's stairs's values)))) as a line
type bim editor key bim escape key code in e
type bim editor key 83 in e
click stair test at 0.2 and 2.0 in e
print ((the string form of "selected a stair ") + (the string form of (editor's selectionKind = bim stair picked))) as a line
type bim editor key bim delete key code in e
print ((the string form of "after delete ") + (the string form of (the length of (editor's documentValue's current's stairs's values)))) as a line
type bim editor key 90 in e
print ((the string form of "after undo ") + (the string form of (the length of (editor's documentValue's current's stairs's values)))) as a line
# RS puts railings on both sides of the selected stair; RL draws one by its
# points, Enter ending it.
type bim editor key 83 in e
click stair test at 0.2 and 2.0 in e
type bim editor key 2111 in e
print editor's message as a line
type bim editor key 2110 in e
click stair test at 3.0 and 0.0 in e
click stair test at 3.0 and 3.0 in e
click stair test at 5.0 and 3.0 in e
type bim editor key bim enter key code in e
print editor's message as a line
print ((the string form of "railings ") + (the string form of (the length of (editor's documentValue's current's railings's values)))) as a line
# CW draws a curtain wall by two clicks; a click on its line selects its
# part, Esc the whole system, and Delete removes it.
type bim editor key bim escape key code in e
type bim editor key 2112 in e
click stair test at 10.0 and 0.0 in e
click stair test at 16.0 and 0.0 in e
print editor's message as a line
type bim editor key bim escape key code in e
type bim editor key 83 in e
click stair test at 13.0 and 0.0 in e
print ((the string form of "selected a curtain wall ") + (the string form of (editor's selectionKind = bim curtain picked))) as a line
type bim editor key bim escape key code in e
type bim editor key bim delete key code in e
print ((the string form of "curtain walls ") + (the string form of (the length of (editor's documentValue's current's curtains's values)))) as a line
