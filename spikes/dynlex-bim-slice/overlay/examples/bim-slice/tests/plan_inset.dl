# SPDX-License-Identifier: MPL-2.0
# The plan inset at the 3D view's lower left fits the model's plan, and a
# metre around it, into its 236 by 156 pixel field: a 10 x 5 m plan (walls,
# a building system and a beam out to 12 m) is 14 m wide, so 16.857 pixels
# a metre, its middle on the field's middle. A click maps back to the plan
# point under it, which the 3D camera then looks at.
import examples/bim-slice/bim_editor.dl

function the inset test text of {cad vector2:spot}:
    execute:
        set roundedX to (@intrinsic("call", "libc", "round", a 64 bit floating-point number, spot's x * 1000.0)) / 1000.0
        set roundedY to (@intrinsic("call", "libc", "round", a 64 bit floating-point number, spot's y * 1000.0)) / 1000.0
        return ((the string form of roundedX) + (the string form of ", ")) + (the string form of roundedY)

set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to layers
set wallType to add bim wall type named (the string form of "Wall 200") with layers to target
free layers
ignore (add bim wall typed wallType on storey from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 10.0 and y 0.0) to target)
ignore (add bim wall typed wallType on storey from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 5.0) to target)
ignore (add bim curtain wall on storey from (a cad vector2 with x 0.0 and y 5.0) to (a cad vector2 with x 10.0 and y 5.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "aluminium") to target)
set beamType to add bim linear type named (the string form of "Beam 200x400") as role bim beam role sized 0.2 by 0.4 round false of (the string form of "steel") to target
ignore (add bim linear typed beamType on storey from (a cad vector3 with x 10.0, y 2.0 and z 3.0) to (a cad vector3 with x 12.0, y 2.0 and z 3.0) turned 0.0 to target)
set extent to the bim plan extent of modelValue
print ((the string form of "extent ") + ((the inset test text of extent's low) + ((the string form of " to ") + (the inset test text of extent's high)))) as a line
set insetMap to the bim inset transform at 100.0 and 500.0 over extent
print ((the string form of "pixels a metre ") + (the string form of ((@intrinsic("call", "libc", "round", a 64 bit floating-point number, insetMap's scale * 1000.0)) / 1000.0))) as a line
print ((the string form of "middle at ") + (the inset test text of (the bim pixel of (a cad vector2 with x 6.0 and y 2.5) through insetMap))) as a line
set corner to the bim pixel of (a cad vector2 with x 10.0 and y 5.0) through insetMap
print ((the string form of "corner at ") + (the inset test text of corner)) as a line
print ((the string form of "clicked back ") + (the inset test text of (the bim plan point under corner through insetMap))) as a line
