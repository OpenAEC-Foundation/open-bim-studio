# SPDX-License-Identifier: MPL-2.0
# Reinforcement wholly inside its floor is left out of the 3D view: every
# point of its mesh a millimetre or more inside the floor's solid, the
# floor shown and opaque. It shows when it sticks out, runs within a
# millimetre of the floor's edge, when the floor is hidden, halftone or
# not among the shown meshes, while the section box cuts, in the wireframe
# view, and when it or its floor is selected.
import examples/bim-slice/bim_scene.dl

function check host hiding {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# A scene mesh of lines through `spots` (pairs) for element `elementId`.
function the host hiding lines of {a 64 bit integer:elementId} through {a pointer to a list:spots}:
    execute:
        set lineShape to an empty fast mesh
        loop cursor from 0 to the length of spots:
            append (the item at cursor in spots) to (lineShape's positions's values)
            append (a cad vector3 with x 0.0, y 0.0 and z 1.0) to (lineShape's normals's values)
        return @intrinsic("construct", a bim scene mesh record, elementId, 0 as a 64 bit integer, lineShape, bim other category, the bim material colour of (the string form of "steel"))

# Whether reinforcement `rebarId` is left out among `sceneMeshes`.
function host hiding leaves out {a 64 bit integer:rebarId} among {a pointer to a list:sceneMeshes} of {bim model record:modelValue} following {bim view rules record:rules} boxed {boolean:boxCuts} wired {boolean:wireframe} keeping {a pointer to a list:keptIds}:
    execute:
        set hiddenIds to the bim reinforcement hidden in hosts among sceneMeshes of modelValue following rules boxed boxCuts wired wireframe keeping keptIds
        return bim element rebarId is among (hiddenIds's values)

set documentValue to a new bim document
set target to the address of (documentValue's current)
begin bim transaction in (the address of documentValue)
set levelId to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set squareOutline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to squareOutline
append (a cad vector2 with x 4.0 and y 0.0) to squareOutline
append (a cad vector2 with x 4.0 and y 4.0) to squareOutline
append (a cad vector2 with x 0.0 and y 4.0) to squareOutline
set floorId to add bim slab on levelId around squareOutline thick 0.2 to target
set spec to @intrinsic("construct", a reinforcement definition, the bim refused id, levelId, floorId, 5, the string form of "VL", (a cad vector3 with x 0.0, y 0.0 and z 0.0), (a cad vector3 with x 4.0, y 0.0 and z 0.0), 0.3, 0.5, 0.016, 0.008, 0.15, 0.15, 0.035, 0.024, 2, 2, 0.016, 0.016, the string form of "-", 0.0, 0.1, 0.0, 0.1, 0, 0.012, 0, 0.016, 0.3, 1.0, 0, 1, 0.012, 0.012, 0.15, 0.15, 0.0, the string form of "Custom", the string form of "UNKNOWN", the string form of "UNKNOWN")
set spec's id to the bim new id in target
append spec to (target's reinforcements's values)
# An L-shaped floor, concave at (2, 2), and reinforcement on it.
set notched to an empty list of a cad vector2
append (a cad vector2 with x 10.0 and y 0.0) to notched
append (a cad vector2 with x 14.0 and y 0.0) to notched
append (a cad vector2 with x 14.0 and y 2.0) to notched
append (a cad vector2 with x 12.0 and y 2.0) to notched
append (a cad vector2 with x 12.0 and y 4.0) to notched
append (a cad vector2 with x 10.0 and y 4.0) to notched
set notchedId to add bim slab on levelId around notched thick 0.2 to target
set notchedSpec to spec
set notchedSpec's hostId to notchedId
set notchedSpec's id to the bim new id in target
append notchedSpec to (target's reinforcements's values)
commit bim transaction in (the address of documentValue)
set modelValue to documentValue's current
check host hiding ((floorId != the bim refused id) and (notchedId != the bim refused id)) named (the string form of "a floor 4 by 4 m and an L-shaped one, 200 mm thick")
check host hiding ((bim outline squareOutline turns one way) and ((bim outline notched turns one way) = false)) named (the string form of "the square is convex, the L is not")

# The floor's solid: its top at its storey's elevation plus its top, its
# underside its thickness below.
set floorValue to the item at 0 in (modelValue's slabs's values)
set floorTop to floorValue's top
set floorBottom to floorTop - (the bim thickness of plate floorValue in modelValue)
set middleHeight to (floorTop + floorBottom) * 0.5

# The floor among the shown meshes: one triangle is enough to show it.
set floorShape to an empty fast mesh
append (a cad vector3 with x 0.0, y 0.0 and z floorTop) to (floorShape's positions's values)
append (a cad vector3 with x 4.0, y 0.0 and z floorTop) to (floorShape's positions's values)
append (a cad vector3 with x 4.0, y 4.0 and z floorTop) to (floorShape's positions's values)
loop corner from 0 to 3:
    append (a cad vector3 with x 0.0, y 0.0 and z 1.0) to (floorShape's normals's values)
    append corner to (floorShape's triangles's values)
set floorMesh to @intrinsic("construct", a bim scene mesh record, floorId, 0 as a 64 bit integer, floorShape, bim slab category, the bim category colouring)

set insideSpots to an empty list of a cad vector3
append (a cad vector3 with x 0.5, y 0.5 and z middleHeight) to insideSpots
append (a cad vector3 with x 3.5, y 0.5 and z middleHeight) to insideSpots
append (a cad vector3 with x 0.5, y 3.5 and z middleHeight) to insideSpots
append (a cad vector3 with x 3.5, y 3.5 and z middleHeight) to insideSpots
set outSpots to an empty list of a cad vector3
append (a cad vector3 with x 0.5, y 0.5 and z middleHeight) to outSpots
append (a cad vector3 with x 0.5, y 0.5 and z (floorTop + 0.05)) to outSpots
set edgeSpots to an empty list of a cad vector3
append (a cad vector3 with x 0.0005, y 0.5 and z middleHeight) to edgeSpots
append (a cad vector3 with x 3.5, y 0.5 and z middleHeight) to edgeSpots

set rules to the bim template rules of view kind (bim model view kind)
set nobody to an empty list of a 64 bit integer
set shown to an empty list of a bim scene mesh record
append floorMesh to shown
append (the host hiding lines of spec's id through insideSpots) to shown
check host hiding (host hiding leaves out spec's id among shown of modelValue following rules boxed false wired false keeping nobody) named (the string form of "wholly inside the floor: left out")
set leftOut to the bim reinforcement hidden in hosts among shown of modelValue following rules boxed false wired false keeping nobody
set kept to the bim meshes among shown leaving out (leftOut's values)
check host hiding (((the length of (kept's values)) = 1) and ((the item at 0 in (kept's values))'s elementId = floorId)) named (the string form of "the floor stays, the reinforcement goes")
check host hiding ((host hiding leaves out spec's id among shown of modelValue following rules boxed true wired false keeping nobody) = false) named (the string form of "section box: shown")
check host hiding ((host hiding leaves out spec's id among shown of modelValue following rules boxed false wired true keeping nobody) = false) named (the string form of "wireframe: shown")
set chosenRebar to an empty list of a 64 bit integer
append spec's id to chosenRebar
check host hiding ((host hiding leaves out spec's id among shown of modelValue following rules boxed false wired false keeping chosenRebar) = false) named (the string form of "reinforcement selected: shown")
set chosenFloor to an empty list of a 64 bit integer
append floorId to chosenFloor
check host hiding ((host hiding leaves out spec's id among shown of modelValue following rules boxed false wired false keeping chosenFloor) = false) named (the string form of "floor selected: shown")

set halftoneRules to the bim template rules of view kind (bim model view kind)
toggle bim category (bim slab category) halftone in (the address of halftoneRules)
check host hiding ((host hiding leaves out spec's id among shown of modelValue following halftoneRules boxed false wired false keeping nobody) = false) named (the string form of "floor halftone: shown")
set hiddenRules to the bim template rules of view kind (bim model view kind)
toggle bim category (bim slab category) visibility in (the address of hiddenRules)
check host hiding ((host hiding leaves out spec's id among shown of modelValue following hiddenRules boxed false wired false keeping nobody) = false) named (the string form of "floor hidden by the rules: shown")
set withoutFloor to an empty list of a bim scene mesh record
append (the host hiding lines of spec's id through insideSpots) to withoutFloor
check host hiding ((host hiding leaves out spec's id among withoutFloor of modelValue following rules boxed false wired false keeping nobody) = false) named (the string form of "floor not among the shown meshes: shown")

set sticking to an empty list of a bim scene mesh record
append floorMesh to sticking
append (the host hiding lines of spec's id through outSpots) to sticking
check host hiding ((host hiding leaves out spec's id among sticking of modelValue following rules boxed false wired false keeping nobody) = false) named (the string form of "sticking out of the floor: shown")
set atEdge to an empty list of a bim scene mesh record
append floorMesh to atEdge
append (the host hiding lines of spec's id through edgeSpots) to atEdge
check host hiding ((host hiding leaves out spec's id among atEdge of modelValue following rules boxed false wired false keeping nobody) = false) named (the string form of "within a millimetre of the floor's edge: shown")

# On the L-shaped floor both ends of a bar lie inside it, but the bar
# crosses the notch: a concave floor never hides.
set notchedShape to an empty fast mesh
append (a cad vector3 with x 10.0, y 0.0 and z floorTop) to (notchedShape's positions's values)
append (a cad vector3 with x 14.0, y 0.0 and z floorTop) to (notchedShape's positions's values)
append (a cad vector3 with x 10.0, y 4.0 and z floorTop) to (notchedShape's positions's values)
loop corner from 0 to 3:
    append (a cad vector3 with x 0.0, y 0.0 and z 1.0) to (notchedShape's normals's values)
    append corner to (notchedShape's triangles's values)
set notchedSpots to an empty list of a cad vector3
append (a cad vector3 with x 13.5, y 1.5 and z middleHeight) to notchedSpots
append (a cad vector3 with x 11.5, y 3.5 and z middleHeight) to notchedSpots
set acrossNotch to an empty list of a bim scene mesh record
append (@intrinsic("construct", a bim scene mesh record, notchedId, 0 as a 64 bit integer, notchedShape, bim slab category, the bim category colouring)) to acrossNotch
append (the host hiding lines of notchedSpec's id through notchedSpots) to acrossNotch
check host hiding ((host hiding leaves out notchedSpec's id among acrossNotch of modelValue following rules boxed false wired false keeping nobody) = false) named (the string form of "across a concave floor's notch: shown")
