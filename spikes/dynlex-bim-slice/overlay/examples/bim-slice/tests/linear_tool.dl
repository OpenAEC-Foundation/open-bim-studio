# SPDX-License-Identifier: MPL-2.0
# The linear tools: the ribbon picks the role, the type selector the type.
# A column placed with one click, a chain of beams with three, the column
# selected and given a round type, its properties, and everything deleted
# by a crossing box and undone. Create similar (CS) from a beam: the beam
# tool with its type, its placement preview from the first click (outline at
# foot and head), and a column's footprint under the pointer.
import examples/bim-slice/bim_editor.dl

function click bim linear test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function list bim linear elements of {a pointer to a bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        loop cursor from 0 to the length of (modelValue's linears's values):
            set linearValue to the item at cursor in (modelValue's linears's values)
            set linearType to the bim type of linear linearValue in modelValue
            print ((the string form of "  ") + (((the bim ifc class of linear role linearType's role) + (the string form of " ")) + (linearType's name + ((the string form of " from z ") + ((the string form of linearValue's start's z) + ((the string form of " to z ") + (the string form of linearValue's finish's z))))))) as a line

function show bim linear preview corner {integer:slot} of {a pointer to a list:corners}:
    execute:
        set cornerSpot to the item at slot in corners
        print ((the string form of "  corner ") + ((the string form of slot) + ((the string form of ": ") + ((the bim length cornerSpot's x in units bim millimetre unit) + ((the string form of ", ") + ((the bim length cornerSpot's y in units bim millimetre unit) + ((the string form of ", ") + (the bim length cornerSpot's z in units bim millimetre unit)))))))) as a line

set editor to a new bim editor
set e to the address of editor
type bim editor key 2070 in e
print editor's message as a line
click bim linear test at 2.0 and 2.0 in e
print editor's message as a line
type bim editor key 2071 in e
print editor's message as a line
click bim linear test at 0.0 and 0.0 in e
click bim linear test at 4.0 and 0.0 in e
click bim linear test at 4.0 and 3.0 in e
type bim editor key bim escape key code in e
print ((the string form of "linear types in the library: ") + (the string form of (the length of (editor's documentValue's current's linearTypes's values)))) as a line
list bim linear elements of e
# The column selected and made round.
click bim linear test at 2.0 and 2.0 in e
print editor's message as a line
set roundType to the bim refused id
loop cursor from 0 to the length of (editor's documentValue's current's linearTypes's values):
    set linearType to the item at cursor in (editor's documentValue's current's linearTypes's values)
    if linearType's name = (the string form of "Beton rond 300"):
        set roundType to linearType's id
choose bim editor linear type roundType in e
print editor's message as a line
set propertyRows to the bim property rows of editor
loop cursor from 0 to the length of propertyRows:
    set propertyRow to the item at cursor in propertyRows
    print ((the string form of "  ") + ((propertyRow's label + (the string form of ": ")) + propertyRow's value)) as a line
# All of them by a crossing box, deleted and undone.
type bim editor key bim escape key code in e
set outlines to the bim selection outlines of editor in plan true
project bim selection outlines outlines from above
ignore select bim editor in box from (a cad vector2 with x 6.0 and y 5.0) to (a cad vector2 with x -1.0 and y -1.0) among outlines in e
print editor's message as a line
type bim editor key bim delete key code in e
print ((the string form of "after delete: ") + (the string form of (the length of (editor's documentValue's current's linears's values)))) as a line
type bim editor key 90 in e
print ((the string form of "after undo: ") + (the string form of (the length of (editor's documentValue's current's linears's values)))) as a line
# Create similar from a beam, and the placement previews.
type bim editor key bim escape key code in e
click bim linear test at 2.0 and 0.0 in e
print ((the string form of "beam selected: ") + (the string form of (editor's selectionKind = bim linear picked))) as a line
create bim editor similar in e
print editor's message as a line
print ((the string form of "tool is the linear tool: ") + (the string form of (editor's tool = bim linear tool))) as a line
set beforeClick to the bim linear preview of editor to (a cad vector2 with x 1.0 and y 1.0)
print ((the string form of "preview before the first click: ") + (the string form of (the length of (beforeClick's values)))) as a line
set editor's chainActive to true
set editor's chainStart to a cad vector2 with x 0.0 and y 5.0
set beamPreview to the bim linear preview of editor to (a cad vector2 with x 4.0 and y 5.0)
print ((the string form of "beam preview: ") + (the string form of (the length of (beamPreview's values)))) as a line
show bim linear preview corner 0 of (beamPreview's values)
show bim linear preview corner 2 of (beamPreview's values)
show bim linear preview corner 4 of (beamPreview's values)
type bim editor key bim escape key code in e
type bim editor key 2070 in e
set columnPreview to the bim linear preview of editor to (a cad vector2 with x 2.0 and y 2.0)
print ((the string form of "column preview: ") + (the string form of (the length of (columnPreview's values)))) as a line
show bim linear preview corner 0 of (columnPreview's values)
show bim linear preview corner 6 of (columnPreview's values)
