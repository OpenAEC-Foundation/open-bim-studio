# SPDX-License-Identifier: MPL-2.0
# The Sketch tab driven by simulated events: a rectangle pushed into a mass, a
# line splitting it in two, the two parts made into a component placed three
# times, the component edited once so that every instance follows, the model
# written and read back, and one instance exploded.
import examples/bim-slice/bim_editor.dl

function check bim sketch {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print label as a line
            @intrinsic("call", "libc", "exit", nothing, 1)

function click bim sketch at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function report bim sketch {a pointer to a bim editor record:editor} labelled {a string:label}:
    execute:
        set modelValue to editor's documentValue's current
        set drawn to the bim drawn sketches of modelValue
        set faces to 0
        set masses to 0
        loop cursor from 0 to the length of (drawn's values):
            set element to the item at cursor in (drawn's values)
            if element's kind = bim face sketch:
                set faces to faces + 1
                if element's height > 0.0:
                    set masses to masses + 1
        set line to (label + (the string form of ": sketches ")) + (the string form of (the length of (modelValue's sketches's values)))
        set line to (line + (the string form of " components ")) + (the string form of (the length of (modelValue's components's values)))
        set line to (line + (the string form of " instances ")) + (the string form of (the length of (modelValue's instances's values)))
        set line to (line + (the string form of " drawn ")) + (the string form of (the length of (drawn's values)))
        set line to (line + (the string form of " faces ")) + (the string form of faces)
        set line to (line + (the string form of " masses ")) + (the string form of masses)
        print line as a line
        print ((the string form of "  ") + editor's message) as a line

set editor to a new bim editor
set e to the address of editor
type bim editor key 82 in e
click bim sketch at 0.0 and 0.0 in e
click bim sketch at 4.0 and 3.0 in e
type bim editor key 80 in e
click bim sketch at 1.0 and 1.0 in e
type bim editor key 50 in e
type bim editor key bim enter key code in e
report bim sketch e labelled (the string form of "pushed")
type bim editor key 78 in e
click bim sketch at 2.0 and 0.0 in e
click bim sketch at 2.0 and 3.0 in e
report bim sketch e labelled (the string form of "split")

type bim editor key 83 in e
click bim sketch at 1.0 and 1.0 in e
set editor's extending to true
click bim sketch at 3.0 and 1.0 in e
set editor's extending to false
print ((the string form of "chosen ") + (the string form of (the length of (editor's chosenSketches's values)))) as a line
type bim editor key 1071 in e
report bim sketch e labelled (the string form of "component")
type bim editor key 1073 in e
click bim sketch at 10.0 and 0.0 in e
click bim sketch at 20.0 and 0.0 in e
report bim sketch e labelled (the string form of "placed")

type bim editor key 83 in e
click bim sketch at 11.0 and 1.0 in e
check bim sketch (editor's selectionKind = bim instance picked) named "an instance is picked"
print editor's message as a line
type bim editor key 1069 in e
report bim sketch e labelled (the string form of "editing")
type bim editor key 78 in e
click bim sketch at 10.0 and 1.5 in e
click bim sketch at 12.0 and 1.5 in e
type bim editor key 1069 in e
report bim sketch e labelled (the string form of "edited")

set written to the bim file text of editor's documentValue's current
set parsed to the bim model parsed from written
check bim sketch parsed's valid named ((the string form of "read: ") + parsed's message)
check bim sketch ((the bim file text of parsed's modelValue) = written) named "text differs after reading"
print (the string form of "file round trip ok") as a line

type bim editor key 83 in e
click bim sketch at 21.0 and 1.0 in e
type bim editor key 1085 in e
report bim sketch e labelled (the string form of "exploded")
type bim editor key 90 in e
report bim sketch e labelled (the string form of "undone")
