# SPDX-License-Identifier: MPL-2.0
# Spaces derived from walls: a room split by a partition, the partition moved,
# a wall removed so a space opens up, and the identity of a space kept while
# its walls move.
import examples/bim-slice/bim_spaces.dl

function a bim spaces test point at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y}:
    execute:
        return a cad vector2 with x x and y y

function report bim spaces of {bim model record:modelValue} on {a 64 bit integer:levelId} labelled {a string:label}:
    execute:
        set found to the bim spaces of modelValue on level levelId using (the bim join index of modelValue)
        print ((label + (the string form of " spaces ")) + (the string form of (the length of (found's values)))) as a line
        loop cursor from 0 to the length of (found's values):
            set space to the item at cursor in (found's values)
            set rounded to (@intrinsic("call", "libc", "round", a 64 bit floating-point number, space's area * 1000000.0)) / 1000000.0
            set line to ((the string form of "  area ") + (the string form of rounded)) + (the string form of " walls")
            loop wallCursor from 0 to the length of (space's boundingWalls's values):
                set line to (line + (the string form of " ")) + (the string form of (the item at wallCursor in (space's boundingWalls's values)))
            print ((line + (the string form of " identity ")) + (the string form of (the bim identity of space))) as a line

set modelValue to an empty bim model
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to (the address of modelValue)
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.12)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.1)) to layerValues
set exteriorType to add bim wall type named (the string form of "Cavity wall") with layerValues to (the address of modelValue)
free layerValues
set innerLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.1)) to innerLayers
set interiorType to add bim wall type named (the string form of "Partition") with innerLayers to (the address of modelValue)
free innerLayers
set south to add bim wall typed exteriorType on storey from (a bim spaces test point at 0.0 and 0.0) to (a bim spaces test point at 6.0 and 0.0) to (the address of modelValue)
set east to add bim wall typed exteriorType on storey from (a bim spaces test point at 6.0 and 0.0) to (a bim spaces test point at 6.0 and 4.0) to (the address of modelValue)
set north to add bim wall typed exteriorType on storey from (a bim spaces test point at 6.0 and 4.0) to (a bim spaces test point at 0.0 and 4.0) to (the address of modelValue)
set west to add bim wall typed exteriorType on storey from (a bim spaces test point at 0.0 and 4.0) to (a bim spaces test point at 0.0 and 0.0) to (the address of modelValue)
report bim spaces of modelValue on storey labelled (the string form of "room")
set middle to add bim wall typed interiorType on storey from (a bim spaces test point at 3.0 and 0.0) to (a bim spaces test point at 3.0 and 4.0) to (the address of modelValue)
report bim spaces of modelValue on storey labelled (the string form of "partitioned")
if (move bim wall middle to (a bim spaces test point at 2.0 and 0.0) and (a bim spaces test point at 2.0 and 4.0) in (the address of modelValue)) = false:
    print "move refused" as a line
report bim spaces of modelValue on storey labelled (the string form of "partition moved")
if (delete bim wall east from (the address of modelValue)) = false:
    print "delete refused" as a line
report bim spaces of modelValue on storey labelled (the string form of "east wall removed")
