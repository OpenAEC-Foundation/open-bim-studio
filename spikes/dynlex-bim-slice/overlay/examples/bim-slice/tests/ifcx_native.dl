# SPDX-License-Identifier: MPL-2.0
# IFC5 (IfcX) as the editor's own file: a model saved as .ifcx opens again as
# the same model, with its units and view rules.
import examples/bim-slice/bim_editor.dl

set editor to a new bim editor
set e to the address of editor
add bim example building to e
add bim type library to e
set target to the address of (editor's documentValue's current)
set block to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to block
append (a cad vector2 with x 1.0 and y 0.0) to block
append (a cad vector2 with x 1.0 and y 0.5) to block
append (a cad vector2 with x 0.0 and y 0.5) to block
set faceId to add bim face on editor's levelId around block to target
ignore set bim face faceId height to 0.8 in target
free block
set chosen to an empty list of a 64 bit integer
append faceId to chosen
set first to make bim component named (the string form of "Desk \"oak\"") from chosen on editor's levelId to target
free chosen
set found to the bim instance index of first in (@intrinsic("dereference", target))
set componentId to (the item at found's position in (target's instances's values))'s componentId
ignore place bim component componentId on editor's levelId at (a cad vector2 with x 2.0 and y 1.0) turned 0.7 to target
ignore add bim line on editor's levelId from (a cad vector2 with x 0.1 and y -2.0) to (a cad vector2 with x 5.3 and y -2.7) to target
ignore add bim text on editor's levelId at (a cad vector2 with x 1.0 and y -2.5) saying (the string form of "Entrance north") to target
ignore bend bim wall (5 as a 64 bit integer) by 0.75 in target
type bim editor key 2050 in e
toggle bim category bim grid category visibility in (the address of (editor's modelRules))
set original to the bim file text of editor's documentValue's current
save bim editor to (the string form of "build/bim-slice-native-test.ifcx") in e
print editor's message as a line
set other to a new bim editor
open bim editor from (the string form of "build/bim-slice-native-test.ifcx") in (the address of other)
print other's message as a line
set reopened to the bim file text of other's documentValue's current
print ((the string form of "same model: ") + (the string form of (reopened = original))) as a line
if reopened != original:
    print original as a line
    print reopened as a line
print ((the string form of "units: ") + (the bim name of unit other's lengthUnit)) as a line
print ((the string form of "grids shown in 3D: ") + (the string form of (bim category bim grid category is visible in other's modelRules))) as a line
print ((the string form of "walls ") + ((the string form of (the length of (other's documentValue's current's walls's values))) + ((the string form of ", wall types ") + (the string form of (the length of (other's documentValue's current's wallTypes's values)))))) as a line
