# SPDX-License-Identifier: MPL-2.0
# Own type (command 2195, in the ribbon's Build group): with no wall selected
# nothing changes; the selected wall takes a copy of its type with the same
# layers under a name of its own, the other wall of that type keeps it, the
# copy's layers change apart from the original's, one undo takes it all back
# and redo brings it again, and the copy is saved with the model.
import examples/bim-slice/bim_ui.dl
import examples/bim-slice/bim_editor.dl

function check own type {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The type of wall `wallId` in `modelValue`.
function the own type of wall {a 64 bit integer:wallId} in {bim model record:modelValue}:
    execute:
        set wallFound to the bim wall index of wallId in modelValue
        return (the item at wallFound's position in (modelValue's walls's values))'s typeId

# Planar type `typeId` of `modelValue`.
function the own type record {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        set typeFound to the bim wall type index of typeId in modelValue
        return the item at typeFound's position in (modelValue's wallTypes's values)

# Whether planar types `firstId` and `secondId` have the same layers.
function own type {a 64 bit integer:firstId} layers match {a 64 bit integer:secondId} in {bim model record:modelValue}:
    execute:
        set firstType to the own type record firstId in modelValue
        set secondType to the own type record secondId in modelValue
        if (the length of (firstType's layers's values)) != (the length of (secondType's layers's values)):
            return false
        loop cursor from 0 to the length of (firstType's layers's values):
            set firstLayer to the item at cursor in (firstType's layers's values)
            set secondLayer to the item at cursor in (secondType's layers's values)
            if (firstLayer's material != secondLayer's material) or (firstLayer's thickness != secondLayer's thickness):
                return false
        return true

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set firstWall to add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to target
set secondWall to add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 0.0 and y 3.0) to (a cad vector2 with x 4.0 and y 3.0) to target
commit bim transaction in (the address of (editor's documentValue))
set sharedType to the own type of wall firstWall in editor's documentValue's current
set typesBefore to the length of (editor's documentValue's current's wallTypes's values)

# The button is in the ribbon.
set foundButton to false
set groups to the bim ribbon groups of tab 0
loop groupCursor from 0 to the length of groups:
    set group to the item at groupCursor in groups
    loop buttonCursor from 0 to the length of (group's buttons):
        if (the item at buttonCursor in (group's buttons))'s command = 2195:
            set foundButton to true
check own type foundButton named (the string form of "the ribbon has an Own type button")

# No wall selected: nothing changes.
type bim editor key 2195 in e
check own type (((the length of (editor's documentValue's current's wallTypes's values)) = typesBefore) and (editor's message = (the string form of "Duplicate type: select a wall first"))) named (the string form of "no wall selected: no type made")

select bim editor bim wall picked numbered firstWall in e
type bim editor key 2195 in e
set ownType to the own type of wall firstWall in editor's documentValue's current
check own type ((ownType != sharedType) and ((the length of (editor's documentValue's current's wallTypes's values)) = (typesBefore + 1))) named (the string form of "the selected wall has a new type")
check own type (own type ownType layers match sharedType in editor's documentValue's current) named (the string form of "the new type has the same layers")
check own type ((the own type record ownType in editor's documentValue's current)'s name != (the own type record sharedType in editor's documentValue's current)'s name) named (the string form of "the new type has a name of its own")
check own type ((the own type of wall secondWall in editor's documentValue's current) = sharedType) named (the string form of "the other wall keeps the old type")

# Its layers change apart from the original's.
start bim editor property (bim add layer property) in e
check own type (((the length of ((the own type record ownType in editor's documentValue's current)'s layers's values)) = ((the length of ((the own type record sharedType in editor's documentValue's current)'s layers's values)) + 1))) named (the string form of "a layer added to the copy leaves the original")
ignore undo bim transaction in (the address of (editor's documentValue))

# One undo takes the copy and the retyping back; redo brings both.
ignore undo bim transaction in (the address of (editor's documentValue))
check own type (((the length of (editor's documentValue's current's wallTypes's values)) = typesBefore) and ((the own type of wall firstWall in editor's documentValue's current) = sharedType)) named (the string form of "one undo restores type and wall")
ignore redo bim transaction in (the address of (editor's documentValue))
check own type (((the length of (editor's documentValue's current's wallTypes's values)) = (typesBefore + 1)) and ((the own type of wall firstWall in editor's documentValue's current) = ownType)) named (the string form of "redo brings the own type again")

# The copy is saved with the model.
set reopened to the bim model parsed from (the bim file text of editor's documentValue's current)
check own type (reopened's valid and ((the own type of wall firstWall in reopened's modelValue) = ownType)) named (the string form of "the own type is saved")
