# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/test_support/reinforcement_fixture.dl

set modelValue to the reinforcement fixture named (the string form of "reinforcement-column-footing.bim") counting 2
check reinforcement fixture (((the length of (modelValue's linears's values)) = 1) and ((the length of (modelValue's slabs's values)) = 1)) named (the string form of "column and footing hosts load")
set cage to the bim hostbound reinforcement (the item at 0 in (modelValue's reinforcements's values)) in modelValue
check reinforcement fixture (((cage's start's z = 0.0) and (cage's finish's z = 3.0)) and ((cage's topCount = 4) and (cage's bottomCount = 4))) named (the string form of "vertical column cage retains eight main bars")
set area to the bim hostbound reinforcement (the item at 1 in (modelValue's reinforcements's values)) in modelValue
check reinforcement fixture ((area's faceMask = 3) and ((area's start's z = -0.6) and (area's depth = 0.6))) named (the string form of "footing reinforcement uses both faces at host elevation")
