# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/test_support/reinforcement_fixture.dl

set modelValue to the reinforcement fixture named (the string form of "reinforcement-floor-field.bim") counting 3
set mesh to the bim hostbound reinforcement (the item at 0 in (modelValue's reinforcements's values)) in modelValue
check reinforcement fixture ((mesh's kind = 2) and (mesh's faceMask = 3) and (mesh's diameter = 0.008) and (mesh's farDiameter = 0.01)) named (the string form of "floor mesh retains distinct lower and upper diameters")
check reinforcement fixture ((mesh's width = 4.0) and (mesh's depth = 0.25)) named (the string form of "floor mesh follows slab dimensions")
set firstEdge to the item at 1 in (modelValue's reinforcements's values)
set secondEdge to the item at 2 in (modelValue's reinforcements's values)
check reinforcement fixture ((firstEdge's kind = 4) and (secondEdge's kind = 4)) named (the string form of "floor includes two sample U bars")
