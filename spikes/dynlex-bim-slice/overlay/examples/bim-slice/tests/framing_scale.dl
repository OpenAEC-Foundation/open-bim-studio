# SPDX-License-Identifier: MPL-2.0
# Timing of steel framing at scale: the steel example building of BAYS x
# ROWS bays over STOREYS storeys (arguments; 12 10 4 by default), evaluated
# from scratch and after single edits through the editor, saved and read
# back, and exported to IFC. Prints counts and wall times; build it -O2.
import examples/bim-slice/bim_editor.dl

function the bim scale milliseconds since {a 64 bit integer:started}:
    execute:
        set spent to ((the bim microseconds now) - started) as a 64 bit floating-point number
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.1f ms", spent / 1000.0)
        return the substring of buffer from 0 spanning written bytes

function report bim scale step {a string:label} since {a 64 bit integer:started} for {bim editor record:editor}:
    execute:
        print ((label + (the string form of ": ")) + ((the bim scale milliseconds since started) + ((the string form of ", rebuilt ") + ((the string form of editor's evaluation's rebuilt) + ((the string form of " of ") + (the string form of (the length of (editor's evaluation's elements's values)))))))) as a line

set bayCount to 12
set rowCount to 10
set storeyCount to 4
if (the length of (the command line arguments)) >= 3:
    set bayCount to @intrinsic("call", "libc", "atoi", integer, the data of (the argument at 0 in the command line arguments))
    set rowCount to @intrinsic("call", "libc", "atoi", integer, the data of (the argument at 1 in the command line arguments))
    set storeyCount to @intrinsic("call", "libc", "atoi", integer, the data of (the argument at 2 in the command line arguments))
set editor to a new bim editor
set e to the address of editor
refresh bim editor e
set started to the bim microseconds now
ignore add bim steel example of bayCount by rowCount bays over storeyCount storeys to e
print ((editor's message + (the string form of ", made in ")) + (the bim scale milliseconds since started)) as a line
set started to the bim microseconds now
refresh bim editor e
report bim scale step (the string form of "first evaluation") since started for editor
set failures to 0
set steel to 0.0
loop cursor from 0 to the length of (editor's evaluation's elements's values):
    set geometry to the item at cursor in (editor's evaluation's elements's values)
    if (geometry's status != 0) and (geometry's status != 4):
        set failures to failures + 1
    set steel to steel + (the bim volume of geometry)
print ((the string form of "failing elements ") + ((the string form of failures) + ((the string form of ", steel volume m3 ") + (the string form of steel)))) as a line
set modelValue to editor's documentValue's current
# One column (an inner one) moved 0.1 m along y, as a drag step would.
set inner to the item at (((bayCount / 2) * (rowCount + 1)) + (rowCount / 2)) in (modelValue's members's values)
begin bim transaction in (the address of (editor's documentValue))
ignore move bim member inner's id to (a cad vector3 with x inner's start's x, y (inner's start's y + 0.1) and z inner's start's z) and (a cad vector3 with x inner's finish's x, y (inner's finish's y + 0.1) and z inner's finish's z) in (the address of (editor's documentValue's current))
commit bim transaction in (the address of (editor's documentValue))
set started to the bim microseconds now
refresh bim editor e
report bim scale step (the string form of "inner column moved") since started for editor
# The end plate type made thicker: every plate and every secondary beam.
set plateType to the bim refused id
loop cursor from 0 to the length of (editor's documentValue's current's connectionTypes's values):
    set connection to the item at cursor in (editor's documentValue's current's connectionTypes's values)
    if connection's name starts with "End plate":
        set plateType to connection's id
begin bim transaction in (the address of (editor's documentValue))
ignore set bim connection type plateType parameter 1 to 0.025 in (the address of (editor's documentValue's current))
commit bim transaction in (the address of (editor's documentValue))
set started to the bim microseconds now
refresh bim editor e
report bim scale step (the string form of "thicker end plates") since started for editor
set started to the bim microseconds now
type bim editor key 90 in e
refresh bim editor e
report bim scale step (the string form of "undo") since started for editor
set started to the bim microseconds now
set written to the bim file text of (editor's documentValue's current)
print ((the string form of "file text: ") + ((the string form of (the length of written)) + ((the string form of " bytes, ") + (the bim scale milliseconds since started)))) as a line
set started to the bim microseconds now
set parsed to the bim model parsed from written
print ((the string form of "read back: ") + ((the string form of parsed's valid) + ((the string form of ", ") + (the bim scale milliseconds since started)))) as a line
set started to the bim microseconds now
set ifcText to the bim ifc text of (editor's documentValue's current)
print ((the string form of "ifc text: ") + ((the string form of (the length of ifcText)) + ((the string form of " bytes, ") + (the bim scale milliseconds since started)))) as a line
if write bim text ifcText to file (the string form of "framing-scale.ifc"):
    print (the string form of "wrote framing-scale.ifc") as a line
