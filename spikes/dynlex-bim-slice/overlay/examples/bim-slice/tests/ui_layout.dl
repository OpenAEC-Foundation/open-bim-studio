# SPDX-License-Identifier: MPL-2.0
# The chrome's layout without its drawing (`bim_ui_layout.dl`): no title row
# of its own (the window's title bar names the application), the tabs' band
# at the top, the ribbon, then the document bar right above the canvas,
# folded or not; the quick actions (Save, Undo, Redo) in the document bar
# after the model's name tab, apart and inside the bar.
import lib/std.dl
import examples/bim-slice/bim_ui_layout.dl

function show layout test buttons after {a 64 bit floating-point number:tabWidth} under {a 64 bit floating-point number:barTop}:
    execute:
        set side to bim ui document button size
        set firstLeft to the bim ui document button 0 left after a tab tabWidth
        set secondLeft to the bim ui document button 1 left after a tab tabWidth
        set thirdLeft to the bim ui document button 2 left after a tab tabWidth
        set buttonTop to the bim ui document button top below barTop
        print ((the string form of "buttons at ") + ((the string form of firstLeft) + ((the string form of ", ") + ((the string form of secondLeft) + ((the string form of ", ") + (the string form of thirdLeft)))))) as a line
        print ((the string form of "  clear of the tab: ") + (the string form of (firstLeft >= (8.0 + tabWidth)))) as a line
        print ((the string form of "  apart: ") + (the string form of (((firstLeft + side) < secondLeft) and ((secondLeft + side) < thirdLeft)))) as a line
        print ((the string form of "  inside the bar: ") + (the string form of ((buttonTop >= barTop) and ((buttonTop + side) <= (barTop + (bim ui document bar height)))))) as a line

print ((the string form of "title row: ") + (the string form of (bim ui title bar height))) as a line
print ((the string form of "tabs band: ") + (the string form of (bim ui top bar height))) as a line
print ((the string form of "canvas top: ") + ((the string form of (the bim ui canvas top folded false)) + ((the string form of ", folded ") + (the string form of (the bim ui canvas top folded true))))) as a line
print ((the string form of "document bar top: ") + ((the string form of (the bim ui document bar top folded false)) + ((the string form of ", folded ") + (the string form of (the bim ui document bar top folded true))))) as a line
print ((the string form of "folded, the document bar meets the tabs: ") + (the string form of ((the bim ui document bar top folded true) = (bim ui top bar height)))) as a line
print ((the string form of "name tab: ") + ((the string form of (the bim ui document tab width around 100.0 changed false)) + ((the string form of ", unsaved ") + (the string form of (the bim ui document tab width around 100.0 changed true))))) as a line
show layout test buttons after (the bim ui document tab width around 100.0 changed true) under (the bim ui document bar top folded false)
