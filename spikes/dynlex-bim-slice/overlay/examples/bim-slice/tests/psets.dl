# SPDX-License-Identifier: MPL-2.0
# Property sets (bim_ifc_psets.dl, `bim pset entry record`): a wall read
# from IFC text with its own property set (a label, a boolean, a length, an
# enumerated value), its type's property set (IfcRelDefinesByType) and its
# quantities (IfcElementQuantity), and a storey with a long name,
# a description and a property set, become the native wall's and level's
# properties; they survive the native file, an IFC export read back, and
# IfcX.
import examples/bim-slice/bim_ifc_native.dl
import examples/bim-slice/bim_ifcx.dl
import examples/bim-slice/bim_ifcx_read.dl

# Every property of every element of `modelValue`, one line each.
function show bim psets of {bim model record:modelValue} labelled {a string:title}:
    execute:
        print ((title + (the string form of ": ")) + (the string form of (the length of (modelValue's properties's values)))) as a line
        loop cursor from 0 to the length of (modelValue's properties's values):
            set entry to the item at cursor in (modelValue's properties's values)
            set kindText to the string form of "other"
            if (the bim wall index of entry's elementId in modelValue)'s valid:
                set kindText to the string form of "wall"
            if (the bim level index of entry's elementId in modelValue)'s valid:
                set kindText to the string form of "level"
            set head to ((the string form of "  ") + kindText) + (the string form of " ")
            set middle to (entry's setName + (the string form of ".")) + (entry's name + (the string form of " = "))
            set tail to (entry's value + (the string form of " (")) + (entry's valueType + (the string form of ")"))
            print ((head + middle) + tail) as a line

set ifcLines to an empty list of a string
append (the string form of "ISO-10303-21;") to ifcLines
append (the string form of "HEADER;") to ifcLines
append (the string form of "FILE_DESCRIPTION(('ViewDefinition [ReferenceView]'),'2;1');") to ifcLines
append (the string form of "FILE_NAME('psets.ifc','2026-10-20',(''),(''),'','','');") to ifcLines
append (the string form of "FILE_SCHEMA(('IFC4'));") to ifcLines
append (the string form of "ENDSEC;") to ifcLines
append (the string form of "DATA;") to ifcLines
append (the string form of "#1=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);") to ifcLines
append (the string form of "#2=IFCUNITASSIGNMENT((#1));") to ifcLines
append (the string form of "#3=IFCCARTESIANPOINT((0.,0.,0.));") to ifcLines
append (the string form of "#4=IFCAXIS2PLACEMENT3D(#3,$,$);") to ifcLines
append (the string form of "#5=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#4,$);") to ifcLines
append (the string form of "#6=IFCPROJECT('0aaaaaaaaaaaaaaaaaaaaa',$,'P',$,$,$,$,(#5),#2);") to ifcLines
append (the string form of "#10=IFCLOCALPLACEMENT($,#4);") to ifcLines
append (the string form of "#11=IFCBUILDINGSTOREY('0bbbbbbbbbbbbbbbbbbbbb',$,'00',$,$,#10,$,'Begane grond',.ELEMENT.,0.);") to ifcLines
append (the string form of "#13=IFCCARTESIANPOINT((0.,0.,3000.));") to ifcLines
append (the string form of "#14=IFCAXIS2PLACEMENT3D(#13,$,$);") to ifcLines
append (the string form of "#15=IFCLOCALPLACEMENT($,#14);") to ifcLines
append (the string form of "#12=IFCBUILDINGSTOREY('0ccccccccccccccccccccc',$,'01','Woonlaag',$,#15,$,'Eerste verdieping',.ELEMENT.,3000.);") to ifcLines
append (the string form of "#20=IFCCARTESIANPOINT((0.,0.));") to ifcLines
append (the string form of "#21=IFCCARTESIANPOINT((5000.,0.));") to ifcLines
append (the string form of "#22=IFCPOLYLINE((#20,#21));") to ifcLines
append (the string form of "#23=IFCSHAPEREPRESENTATION(#5,'Axis','Curve2D',(#22));") to ifcLines
append (the string form of "#24=IFCCARTESIANPOINT((0.,-100.));") to ifcLines
append (the string form of "#25=IFCCARTESIANPOINT((5000.,-100.));") to ifcLines
append (the string form of "#26=IFCCARTESIANPOINT((5000.,100.));") to ifcLines
append (the string form of "#27=IFCCARTESIANPOINT((0.,100.));") to ifcLines
append (the string form of "#28=IFCPOLYLINE((#24,#25,#26,#27,#24));") to ifcLines
append (the string form of "#29=IFCARBITRARYCLOSEDPROFILEDEF(.AREA.,$,#28);") to ifcLines
append (the string form of "#30=IFCDIRECTION((0.,0.,1.));") to ifcLines
append (the string form of "#31=IFCEXTRUDEDAREASOLID(#29,#4,#30,2600.);") to ifcLines
append (the string form of "#32=IFCSHAPEREPRESENTATION(#5,'Body','SweptSolid',(#31));") to ifcLines
append (the string form of "#33=IFCPRODUCTDEFINITIONSHAPE($,$,(#23,#32));") to ifcLines
append (the string form of "#34=IFCWALL('0ddddddddddddddddddddd',$,'Binnenwand',$,$,#10,#33,$,$);") to ifcLines
append (the string form of "#35=IFCRELCONTAINEDINSPATIALSTRUCTURE('0eeeeeeeeeeeeeeeeeeeee',$,$,$,(#34),#11);") to ifcLines
append (the string form of "#40=IFCPROPERTYSINGLEVALUE('Reference',$,IFCIDENTIFIER('W-01'),$);") to ifcLines
append (the string form of "#41=IFCPROPERTYSINGLEVALUE('IsExternal',$,IFCBOOLEAN(.F.),$);") to ifcLines
append (the string form of "#42=IFCPROPERTYSINGLEVALUE('Brandwerendheid',$,IFCLABEL('60 min'),$);") to ifcLines
append (the string form of "#43=IFCPROPERTYSINGLEVALUE('Afwerkhoogte',$,IFCLENGTHMEASURE(2450.),$);") to ifcLines
append (the string form of "#44=IFCPROPERTYENUMERATEDVALUE('Status',$,(IFCLABEL('Nieuw'),IFCLABEL('Bestaand')),$);") to ifcLines
append (the string form of "#45=IFCPROPERTYSET('0fffffffffffffffffffff',$,'Pset_WallCommon',$,(#40,#41));") to ifcLines
append (the string form of "#46=IFCPROPERTYSET('0ggggggggggggggggggggg',$,'NLSfB_Eigen',$,(#42,#43,#44));") to ifcLines
append (the string form of "#47=IFCRELDEFINESBYPROPERTIES('0hhhhhhhhhhhhhhhhhhhhh',$,$,$,(#34),#45);") to ifcLines
append (the string form of "#48=IFCRELDEFINESBYPROPERTIES('0iiiiiiiiiiiiiiiiiiiii',$,$,$,(#34),#46);") to ifcLines
append (the string form of "#50=IFCQUANTITYLENGTH('Length',$,$,5000.,$);") to ifcLines
append (the string form of "#51=IFCQUANTITYAREA('NetSideArea',$,$,13.,$);") to ifcLines
append (the string form of "#52=IFCELEMENTQUANTITY('0jjjjjjjjjjjjjjjjjjjjj',$,'Qto_WallBaseQuantities',$,$,(#50,#51));") to ifcLines
append (the string form of "#53=IFCRELDEFINESBYPROPERTIES('0kkkkkkkkkkkkkkkkkkkkk',$,$,$,(#34),#52);") to ifcLines
append (the string form of "#60=IFCPROPERTYSINGLEVALUE('Fabrikant',$,IFCLABEL('Xella'),$);") to ifcLines
append (the string form of "#61=IFCPROPERTYSET('0lllllllllllllllllllll',$,'Type_Gegevens',$,(#60));") to ifcLines
append (the string form of "#62=IFCWALLTYPE('0mmmmmmmmmmmmmmmmmmmmm',$,'Kalkzandsteen 200',$,$,(#61),$,$,$,.STANDARD.);") to ifcLines
append (the string form of "#63=IFCRELDEFINESBYTYPE('0nnnnnnnnnnnnnnnnnnnnn',$,$,$,(#34),#62);") to ifcLines
append (the string form of "#70=IFCPROPERTYSINGLEVALUE('AboveGround',$,IFCLOGICAL(.T.),$);") to ifcLines
append (the string form of "#71=IFCPROPERTYSET('0ooooooooooooooooooooo',$,'Pset_BuildingStoreyCommon',$,(#70));") to ifcLines
append (the string form of "#72=IFCRELDEFINESBYPROPERTIES('0ppppppppppppppppppppp',$,$,$,(#12),#71);") to ifcLines
append (the string form of "ENDSEC;") to ifcLines
append (the string form of "END-ISO-10303-21;") to ifcLines
set stepFile to the bim step file of (ifcLines joined with "\n")
set nativeSet to the bim ifc natives of stepFile
print ((the string form of "read: ") + (the string form of (the length of (nativeSet's psets's values)))) as a line
set modelValue to an empty bim model
set counts to add bim ifc natives nativeSet to (the address of modelValue)
print (the bim ifc native text of counts) as a line
show bim psets of modelValue labelled (the string form of "imported")
set wallValue to the item at 0 in (modelValue's walls's values)
set wallSets to the bim property set names of wallValue's id in modelValue
print ((the string form of "wall sets: ") + ((wallSets's values) joined with ", ")) as a line

# Edited and copied: a property changed, one added, the wall copied.
set bim property (the string form of "Brandwerendheid") of set (the string form of "NLSfB_Eigen") of wallValue's id to (the string form of "90 min") typed (the string form of "IFCLABEL") in (the address of modelValue)
set bim property (the string form of "Opmerking") of set (the string form of "Eigen") of wallValue's id to (the string form of "Let op: 'aansluiting'") typed (the string form of "IFCTEXT") in (the address of modelValue)
set wallProperties to the bim properties of wallValue's id in modelValue
print ((the string form of "after edit: ") + (the string form of (the length of (wallProperties's values)))) as a line

# The native file.
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of " ") + reread's message))) as a line
show bim psets of reread's modelValue labelled (the string form of "from .bim")

# An IFC export read back.
set exported to the bim ifc text of modelValue
set exportedFile to the bim step file of exported
print ((the string form of "IFC sets written: ") + (the string form of (the length of (the bim step instances of type (the string form of "IFCPROPERTYSET") in exportedFile)))) as a line
set backSet to the bim ifc natives of exportedFile
set backModel to an empty bim model
ignore add bim ifc natives backSet to (the address of backModel)
show bim psets of backModel labelled (the string form of "from IFC")

# IfcX.
set ifcxText to the bim ifcx text of modelValue identified as (the string form of "p.ifcx") for project (the string form of "p") by (the string form of "test") at (the string form of "2026-10-20T00:00:00")
set native to the bim native text of ifcx ifcxText
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of " ") + fromIfcx's message))) as a line
print ((the string form of "from IfcX: ") + (the string form of (the length of (fromIfcx's modelValue's properties's values)))) as a line

# Read only: the same wall imported as an imported element keeps its
# property sets in the import, keyed by its index there.
set noneSkipped to an empty list of an integer
set readOnly to the bim ifc elements of stepFile skipping noneSkipped
print ((the string form of "read-only elements: ") + (the string form of (the length of (readOnly's labels's values)))) as a line
print ((the string form of "read-only psets: ") + (the string form of (the length of (readOnly's psets's values)))) as a line
loop cursor from 0 to the length of (readOnly's psets's values):
    set entry to the item at cursor in (readOnly's psets's values)
    print (((the string form of "  element ") + (the string form of entry's elementId)) + ((the string form of " ") + ((entry's setName + (the string form of ".")) + ((entry's name + (the string form of " = ")) + entry's value)))) as a line

# The same file imported again into the same model: what it made native is
# in the model already (by GlobalId) and is not made twice.
set againCounts to add bim ifc natives nativeSet to (the address of modelValue)
print ((the string form of "imported again: ") + (the bim ifc native text of againCounts)) as a line
print ((the string form of "walls now: ") + (the string form of (the length of (modelValue's walls's values)))) as a line
