# SPDX-License-Identifier: MPL-2.0
# Direct library operations, stale state recovery and gesture cancellation.
import examples/bim-slice/bim_type_manager.dl

function check managed type {boolean:valid} named {a string:label}:
    execute:
        if valid = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set editor to a new bim editor
set e to the address of editor
set manager to a new bim type manager
set m to the address of manager
set originalUndo to the length of (editor's documentValue's undoStack's values)
open bim type manager in m for e
check managed type manager's open named (the string form of "manager opens without an occurrence")
check managed type ((the length of (editor's documentValue's undoStack's values)) = originalUndo) named (the string form of "browsing creates no transaction")
set fresh to add bim managed type on tab 0 in e
check managed type (fresh != the bim refused id) named (the string form of "add creates a wall type")
check managed type (((the length of (editor's documentValue's current's walls's values)) = 0) and ((the length of (editor's documentValue's current's linears's values)) = 0)) named (the string form of "library editing creates no dummy elements")
check managed type (set bim managed type fresh on tab 0 layer 0 field 0 to (the string form of "Facade shared") in e) named (the string form of "custom type name is editable")
set another to add bim managed type on tab 0 in e
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.24)) to layers
begin bim transaction in (the address of (editor's documentValue))
ignore set bim wall type fresh layers to layers in (the address of (editor's documentValue's current))
commit bim transaction in (the address of (editor's documentValue))
free layers
check managed type (((the bim managed type fresh on tab 0 in editor's documentValue's current)'s name) = (the string form of "Facade shared")) named (the string form of "custom name survives another type and external layer edit")
set editor's lengthUnit to 0
check managed type (set bim managed type fresh on tab 0 layer 0 field 2 to (the string form of "250") in e) named (the string form of "dimension editing uses project millimetres")
check managed type ((the absolute value of (((the bim managed type fresh on tab 0 in editor's documentValue's current)'s width) - 0.25)) < 0.000001) named (the string form of "typed dimension updates the real definition")
check managed type ((set bim managed type fresh on tab 0 layer 0 field 2 to (the string form of "-1") in e) = false) named (the string form of "invalid dimensions are refused")
check managed type (set bim managed type fresh on tab 0 layer 0 field 6 to (the string form of "21-02 10 10") in e) named (the string form of "formatted classification code is accepted")
set copied to duplicate bim managed type fresh on tab 0 in e
check managed type ((copied != fresh) and (copied != the bim refused id)) named (the string form of "duplicate has independent identity")
check managed type (change bim managed type copied layer 0 by 1 in e) named (the string form of "layer added directly to type")
check managed type (((the bim managed type copied on tab 0 in editor's documentValue's current)'s layerCount) = 2) named (the string form of "layer structure is stored")
check managed type (change bim managed type copied layer 1 by -1 in e) named (the string form of "selected layer can be removed")
check managed type ((change bim managed type copied layer 0 by -1 in e) = false) named (the string form of "last layer cannot be removed")
begin bim transaction in (the address of (editor's documentValue))
set wallId to add bim wall typed fresh on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 5.0 and y 0.0) to (the address of (editor's documentValue's current))
commit bim transaction in (the address of (editor's documentValue))
check managed type ((delete bim managed type fresh on tab 0 in e) = false) named (the string form of "used type deletion is refused")
select bim editor (bim wall picked) numbered wallId in e
check managed type (apply bim managed type copied on tab 0 in e) named (the string form of "apply changes compatible selection and default")
check managed type (((the item at 0 in (editor's documentValue's current's walls's values))'s typeId = copied) and (editor's wallTypeId = copied)) named (the string form of "apply preserves native type binding")
check managed type (delete bim managed type another on tab 0 in e) named (the string form of "unused type deletion succeeds")
set manager's chosenId to another
refresh bim type manager m for editor
check managed type (manager's chosenId != another) named (the string form of "deleted selection recovers safely")
set priorWalls to the length of (editor's documentValue's current's walls's values)
begin bim transaction in (the address of (editor's documentValue))
ignore add bim wall typed copied on editor's levelId from (a cad vector2 with x 0.0 and y 2.0) to (a cad vector2 with x 5.0 and y 2.0) to (the address of (editor's documentValue's current))
set editor's dragging to true
open bim type manager in m for e
check managed type (((the length of (editor's documentValue's current's walls's values)) = priorWalls) and (editor's dragging = false)) named (the string form of "opening manager rolls back provisional geometry")
check managed type ((editor's selectionId = wallId) and (editor's selectionKind = bim wall picked)) named (the string form of "gesture cancellation keeps apply selection")
set columnType to add bim managed type on tab 4 in e
check managed type (apply bim managed type columnType on tab 4 in e) named (the string form of "incompatible selection sets drawing default")
check managed type (((the item at 0 in (editor's documentValue's current's walls's values))'s typeId = copied) and (editor's linearTypeId = columnType)) named (the string form of "incompatible selection is unchanged")
set manager's chosenId to copied
set manager's tab to 0
set manager's field to 0
set manager's text to the string form of "Old field"
ignore undo bim transaction in (the address of (editor's documentValue))
refresh bim type manager m for editor
check managed type (manager's field = -1) named (the string form of "undo invalidates an in-progress field safely")
set pileType to add bim managed type on tab 6 in e
check managed type (set bim managed type pileType on tab 6 layer 0 field 0 to (the string form of "Foundation pile") in e) named (the string form of "pile type name is editable")
ignore size bim linear type pileType to 0.4 by 0.4 in (the address of (editor's documentValue's current))
check managed type (((the bim managed type pileType on tab 6 in editor's documentValue's current)'s name) = (the string form of "Foundation pile")) named (the string form of "pile name survives external dimension changes")
