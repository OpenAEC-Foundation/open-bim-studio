# SPDX-License-Identifier: MPL-2.0
# The wall tool's line (Line, command 2207) and Flip (2206). Drawn on the
# exterior face, a chain of walls has its centrelines half a thickness in,
# meeting at the mitred corner, the drawn line on their exterior faces; one
# undo takes the last wall and its mitre back. Drawn on the interior face
# the centreline lies half a thickness out; on the centreline the drawn
# points are the wall's. Flip with no wall selected changes nothing; a
# flipped wall runs the other way with its opening in place, its arc, lean
# and rise turned with it and its masonry counted from the same corner; one
# undo takes it back, redo brings it again, and a second flip restores it.
import examples/bim-slice/bim_ui.dl
import examples/bim-slice/bim_editor.dl

function check wall line {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function click wall line test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        refresh bim editor editor
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

# Whether `point` is at `x` and `y` to a micrometre.
function wall line point {cad vector2:point} is at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y}:
    execute:
        return ((the absolute value of (point's x - x)) < 1e-6) and ((the absolute value of (point's y - y)) < 1e-6)

# Whether `measured` is `wanted` to a micrometre.
function wall line measure {a 64 bit floating-point number:measured} is {a 64 bit floating-point number:wanted}:
    execute:
        return (the absolute value of (measured - wanted)) < 1e-6

# Wall `wallId` of `modelValue`.
function the wall line wall {a 64 bit integer:wallId} in {bim model record:modelValue}:
    execute:
        set found to the bim wall index of wallId in modelValue
        return the item at found's position in (modelValue's walls's values)

# The `ordinal`th wall of `modelValue`, in order of making.
function the wall line ordinal {integer:ordinal} wall in {bim model record:modelValue}:
    execute:
        return the item at ordinal in (modelValue's walls's values)

# The offset of opening `openingId` of `modelValue` along its wall.
function the wall line offset of opening {a 64 bit integer:openingId} in {bim model record:modelValue}:
    execute:
        set found to the bim opening index of openingId in modelValue
        return (the item at found's position in (modelValue's openings's values))'s offset

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set typeFound to the bim wall type index of editor's wallTypeId in editor's documentValue's current
set half to (the bim thickness of (the item at typeFound's position in (editor's documentValue's current's wallTypes's values))) * 0.5

# The buttons are in the ribbon.
set foundFlip to false
set foundLine to false
set ribbonGroups to the bim ribbon groups of tab 0
loop groupCursor from 0 to the length of ribbonGroups:
    set ribbonGroup to the item at groupCursor in ribbonGroups
    loop buttonCursor from 0 to the length of (ribbonGroup's buttons):
        if (the item at buttonCursor in (ribbonGroup's buttons))'s command = 2206:
            set foundFlip to true
        if (the item at buttonCursor in (ribbonGroup's buttons))'s command = 2207:
            set foundLine to true
check wall line (foundFlip and foundLine) named (the string form of "the ribbon has Flip and Line buttons")

# Exterior face: an L of two walls.
check wall line ((editor's wallLine = bim wall centre line) and (half > 0.0)) named (the string form of "a new editor draws on the centreline")
type bim editor key 2207 in e
check wall line ((editor's wallLine = bim wall exterior line) and (editor's message = (the string form of "Wall line: exterior face"))) named (the string form of "Line moves to the exterior face")
type bim editor key 87 in e
click wall line test at 0.0 and 0.0 in e
click wall line test at 6.0 and 0.0 in e
click wall line test at 6.0 and 4.0 in e
type bim editor key bim escape key code in e
type bim editor key bim escape key code in e
set first to the wall line ordinal 0 wall in editor's documentValue's current
set second to the wall line ordinal 1 wall in editor's documentValue's current
check wall line (((the length of (editor's documentValue's current's walls's values)) = 2) and ((wall line point (first's start) is at 0.0 and half) and (wall line point (first's finish) is at (6.0 - half) and half))) named (the string form of "the first wall's centreline lies half a thickness in, mitred at the corner")
check wall line ((wall line point (second's start) is at (6.0 - half) and half) and (wall line point (second's finish) is at (6.0 - half) and 4.0)) named (the string form of "the second wall starts at the mitre and runs half a thickness in")
set firstOutward to the bim exterior normal of first
set secondOutward to the bim exterior normal of second
set firstFace to a cad vector2 with x (first's start's x + (firstOutward's x * half)) and y (first's start's y + (firstOutward's y * half))
set secondFace to a cad vector2 with x (second's finish's x + (secondOutward's x * half)) and y (second's finish's y + (secondOutward's y * half))
check wall line ((wall line point firstFace is at 0.0 and 0.0) and (wall line point secondFace is at 6.0 and 4.0)) named (the string form of "the drawn line is on the exterior faces")
ignore undo bim transaction in (the address of (editor's documentValue))
set firstAgain to the wall line wall (first's id) in editor's documentValue's current
check wall line (((the length of (editor's documentValue's current's walls's values)) = 1) and (wall line point (firstAgain's finish) is at 6.0 and half)) named (the string form of "one undo takes the second wall and the mitre back")

# Interior face, then the centreline again.
type bim editor key 2207 in e
check wall line ((editor's wallLine = bim wall interior line) and (editor's message = (the string form of "Wall line: interior face"))) named (the string form of "Line moves to the interior face")
type bim editor key 87 in e
click wall line test at 0.0 and 10.0 in e
click wall line test at 6.0 and 10.0 in e
type bim editor key bim escape key code in e
type bim editor key bim escape key code in e
set inner to the wall line ordinal 1 wall in editor's documentValue's current
check wall line ((wall line point (inner's start) is at 0.0 and (10.0 - half)) and (wall line point (inner's finish) is at 6.0 and (10.0 - half))) named (the string form of "drawn on the interior face, the centreline lies half a thickness out")
type bim editor key 2207 in e
check wall line ((editor's wallLine = bim wall centre line) and (editor's message = (the string form of "Wall line: centreline"))) named (the string form of "Line returns to the centreline")
type bim editor key 87 in e
click wall line test at 0.0 and 20.0 in e
click wall line test at 6.0 and 20.0 in e
type bim editor key bim escape key code in e
type bim editor key bim escape key code in e
set plain to the wall line ordinal 2 wall in editor's documentValue's current
set plainId to plain's id
check wall line ((wall line point (plain's start) is at 0.0 and 20.0) and (wall line point (plain's finish) is at 6.0 and 20.0)) named (the string form of "drawn on the centreline, the points are the wall's")

# Flip: nothing selected, nothing changes.
select bim editor bim nothing picked numbered (the bim refused id) in e
type bim editor key 2206 in e
set plainStill to the wall line wall plainId in editor's documentValue's current
check wall line ((editor's message = (the string form of "Flip: select a wall first")) and (wall line point (plainStill's start) is at 0.0 and 20.0)) named (the string form of "Flip with no wall selected changes nothing")

# The wall gets an opening, a bend, a lean and a rise and a masonry module.
begin bim transaction in (the address of (editor's documentValue))
set hole to add bim opening typed (editor's windowTypeId) in plainId at 2.0 to target
ignore bend bim wall plainId by 0.5 in target
ignore set bim wall plainId lean to 0.1 and rise to 0.05 in target
ignore give bim wall plainId masonry module (1260 as a 64 bit integer) on layer 0 from finish false offset (0 as a 64 bit integer) in target
commit bim transaction in (the address of (editor's documentValue))
select bim editor bim wall picked numbered plainId in e
type bim editor key 2206 in e
set flipped to the wall line wall plainId in editor's documentValue's current
set endReading to the bim setting (bim masonry end setting) of plainId in editor's documentValue's current
check wall line ((wall line point (flipped's start) is at 6.0 and 20.0) and (wall line point (flipped's finish) is at 0.0 and 20.0)) named (the string form of "the flipped wall runs the other way")
check wall line (wall line measure (the wall line offset of opening hole in editor's documentValue's current) is 4.0) named (the string form of "its opening keeps its place")
check wall line ((wall line measure (flipped's bulge) is (0.0 - 0.5)) and ((wall line measure (flipped's lean) is (0.0 - 0.1)) and (wall line measure (flipped's rise) is (0.0 - 0.05)))) named (the string form of "its arc, lean and rise turn with it")
check wall line (endReading's found and (endReading's value = (1 as a 64 bit integer))) named (the string form of "its masonry is counted from the same corner")
check wall line (editor's selectionId = plainId) named (the string form of "the wall stays selected")
ignore undo bim transaction in (the address of (editor's documentValue))
set undone to the wall line wall plainId in editor's documentValue's current
set endUndone to the bim setting (bim masonry end setting) of plainId in editor's documentValue's current
check wall line ((wall line point (undone's start) is at 0.0 and 20.0) and ((wall line measure (the wall line offset of opening hole in editor's documentValue's current) is 2.0) and ((wall line measure (undone's bulge) is 0.5) and (endUndone's found = false)))) named (the string form of "one undo takes the flip back")
ignore redo bim transaction in (the address of (editor's documentValue))
set redone to the wall line wall plainId in editor's documentValue's current
check wall line ((wall line point (redone's start) is at 6.0 and 20.0) and (wall line measure (the wall line offset of opening hole in editor's documentValue's current) is 4.0)) named (the string form of "redo flips it again")
type bim editor key 2206 in e
set restored to the wall line wall plainId in editor's documentValue's current
set endRestored to the bim setting (bim masonry end setting) of plainId in editor's documentValue's current
check wall line ((wall line point (restored's start) is at 0.0 and 20.0) and ((wall line measure (the wall line offset of opening hole in editor's documentValue's current) is 2.0) and ((wall line measure (restored's lean) is 0.1) and (endRestored's found = false)))) named (the string form of "a second flip restores the wall")
