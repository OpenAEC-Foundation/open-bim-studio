# SPDX-License-Identifier: MPL-2.0
# The native file format: the example house, near the origin and 500 km away
# at a non-integral offset, written and read back must give the same text and
# the same evaluated geometry; a file saved by the editor opens again; and
# malformed files are refused with the fault named.
import examples/bim-slice/bim_editor.dl

function check bim file {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print label as a line
            @intrinsic("call", "libc", "exit", nothing, 1)

function report round trip shifted by {cad vector2:base} labelled {a string:label}:
    execute:
        set editor to a new bim editor
        add bim example building to (the address of editor) at base
        set written to the bim file text of editor's documentValue's current
        set parsed to the bim model parsed from written
        check bim file parsed's valid named ((label + (the string form of " read: ")) + parsed's message)
        check bim file ((the bim file text of parsed's modelValue) = written) named (label + (the string form of " text differs after reading"))
        set original to the bim evaluation of editor's documentValue's current after (an empty bim evaluation)
        set reread to the bim evaluation of parsed's modelValue after (an empty bim evaluation)
        check bim file ((the length of (original's elements's values)) = (the length of (reread's elements's values))) named (label + (the string form of " element count"))
        loop cursor from 0 to the length of (original's elements's values):
            check bim file ((the item at cursor in (original's elements's values))'s signature = (the item at cursor in (reread's elements's values))'s signature) named (label + (the string form of " signature"))
        set line to ((label + (the string form of " lines ")) + (the string form of (the length of (written split at "\n")))) + (the string form of " elements ")
        print (line + (the string form of (the length of (reread's elements's values)))) as a line

function report refusal of {a string:content} labelled {a string:label}:
    execute:
        set parsed to the bim model parsed from content
        if parsed's valid:
            print (label + (the string form of ": accepted")) as a line
        else:
            print ((label + (the string form of ": ")) + parsed's message) as a line

report round trip shifted by (a cad vector2 with x 0.0 and y 0.0) labelled (the string form of "near")
report round trip shifted by (a cad vector2 with x 500000.123 and y 499999.987) labelled (the string form of "far")

# Saved and opened through the editor.
set path to the string form of "build/bim-slice-file-test.bim"
set editor to a new bim editor
add bim example building to (the address of editor)
save bim editor to path in (the address of editor)
print editor's message as a line
set other to a new bim editor
open bim editor from path in (the address of other)
print other's message as a line
check bim file ((the bim file text of other's documentValue's current) = (the bim file text of editor's documentValue's current)) named "opened model differs"
print ((the string form of "opened storey ") + (the bim storey name of other)) as a line
open bim editor from (the string form of "build/no-such-file.bim") in (the address of other)
print other's message as a line
ignore @intrinsic("call", "libc", "remove", integer, the data of path)

# Refusals.
set header to the string form of "BIM-SLICE 1\nnext 9\nlevel 1 0 3 Ground floor\nwalltype 2 Wall\nlayer 0.2 brick\n"
report refusal of (header + (the string form of "wall 3 2 1 0 0 5 0 3\n")) labelled (the string form of "valid")
report refusal of (the string form of "BIM-SLICE 2\nnext 1\n") labelled (the string form of "version")
report refusal of (the string form of "BIM-SLICE 1\nlevel 1 0 3 Ground\n") labelled (the string form of "no next")
report refusal of (header + (the string form of "roof 3\n")) labelled (the string form of "unknown")
report refusal of (header + (the string form of "wall 3 2 1 0 0 5x 0 3\n")) labelled (the string form of "bad number")
report refusal of (header + (the string form of "wall 3 2 1 0 0 nan 0 3\n")) labelled (the string form of "nan")
report refusal of (header + (the string form of "wall 3 2 7 0 0 5 0 3\n")) labelled (the string form of "missing level")
report refusal of (header + (the string form of "wall 2 2 1 0 0 5 0 3\n")) labelled (the string form of "id used twice")
report refusal of (header + (the string form of "wall 12 2 1 0 0 5 0 3\n")) labelled (the string form of "id not below next")
report refusal of (header + (the string form of "wall 4 2 1 0 0 5 0 3\nwall 3 2 1 0 0 0 5 3\n")) labelled (the string form of "out of order")
report refusal of (header + (the string form of "openingtype 3 0.9 2.1 0.1 0.05 1 Door\n")) labelled (the string form of "door above the base")
report refusal of (header + (the string form of "slab 3 1 0.25 3 0 0 1 0\n")) labelled (the string form of "short slab")
report refusal of (header + (the string form of "wall 3 2 1 0 0 5 0 3\nopening 4 8 3 1.0\n")) labelled (the string form of "missing opening type")
report refusal of (header + (the string form of "wall 3 2 1 0 0 5 0 3\ndimension 4 3 0 3 4\n")) labelled (the string form of "wrong feature")
