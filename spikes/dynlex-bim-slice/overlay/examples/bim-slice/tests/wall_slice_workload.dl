# SPDX-License-Identifier: MPL-2.0
# The slice's most expensive kernel calls on one wall, for comparison with the
# pinned Rust cadkernel (`wall_slice_workload.rs`, same inputs): a 6.32 x 0.32
# x 3 m wall box minus a window box (mode 0, repeated), or the plan slice of
# that cut wall at 1.2 m (mode 1, repeated). Prints the total face count of
# the results, which must equal the Rust output. Mode 2 repeats the planar
# section of the cut wall at 1.2 m, a DynLex extension without a Rust
# counterpart, and prints the total number of section points.
import lib/cadkernel/brep_boolean.dl
import lib/cadkernel/brep_make.dl
import lib/cadkernel/brep_slice.dl
import lib/cadkernel/brep_section.dl

set modeText to the argument at 0 in the command line arguments
set mode to @intrinsic("call", "libc", "atoi", integer, the data of modeText)
set iterationText to the argument at 1 in the command line arguments
set iterations to @intrinsic("call", "libc", "atoi", integer, the data of iterationText)
set wallMade to the cad cuboid at (the cad zero vector3) with size (a cad vector3 with x 6.32, y 0.32 and z 3.0)
set windowMade to the cad cuboid at (a cad vector3 with x 1.0, y -0.1 and z 0.9) with size (a cad vector3 with x 1.3, y 0.52 and z 1.6)
set wallBody to wallMade's value
set windowBody to windowMade's value
set cutMade to the cad combination of wallBody and windowBody using cad difference operation within 1e-9
set cutBody to cutMade's value
set viewPlane to a cad plane with origin (a cad vector3 with x 0.0, y 0.0 and z 1.2), x axis (the cad x axis) and y axis (the cad y axis)
set faces to 0
loop repeat from 0 to iterations:
    if mode = 0:
        set combined to the cad combination of wallBody and windowBody using cad difference operation within 1e-9
        set faces to faces + (the cad count of combined's value's faces)
    else if mode = 2:
        set sectioned to the cad plane section of cutBody by viewPlane
        loop ringCursor from 0 to the length of (sectioned's loops's values):
            set faces to faces + (the length of ((the item at ringCursor in (sectioned's loops's values))'s values))
    else:
        set sliced to the cad plane slice of cutBody by viewPlane
        set faces to faces + ((the cad count of sliced's negative's faces) + (the cad count of sliced's positive's faces))
print faces as a line
