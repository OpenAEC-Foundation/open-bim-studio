import examples/bim-slice/bim_workspace_tabs.dl

function check workspace tab {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set kinds to an empty list of an integer
set details to an empty list of a 64 bit integer
loop index from 0 to 4:
    append index to kinds
    append ((100 + index) as a 64 bit integer) to details
check workspace tab (move bim workspace tab 0 to 3 among kinds and details) named (the string form of "move first tab to last")
check workspace tab (((the item at 3 in kinds) = 0) and ((the item at 3 in details) = 100)) named (the string form of "view identity stays paired")
check workspace tab ((the bim tab index 2 after moving 0 to 3) = 1) named (the string form of "tiled pane index follows reorder")
check workspace tab ((the bim tab index -1 after moving 0 to 3) = -1) named (the string form of "absent pane stays absent")
check workspace tab (move bim workspace tab 3 to 0 among kinds and details) named (the string form of "move last tab to first")
check workspace tab (((the item at 0 in kinds) = 0) and ((the item at 3 in details) = 103)) named (the string form of "reverse move restores order")
check workspace tab ((move bim workspace tab 0 to -1 among kinds and details) = false) named (the string form of "outside drop does not reorder")
