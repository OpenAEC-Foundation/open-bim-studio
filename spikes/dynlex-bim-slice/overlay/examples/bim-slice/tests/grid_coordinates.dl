# SPDX-License-Identifier: MPL-2.0
# Exact grid editing through editor properties, without rendering imports.
import examples/bim-slice/bim_editor.dl

function check grid coordinates {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function type grid coordinate field {integer:fieldCode} with {a string:inputValue} in {a pointer to a bim editor record:editTarget}:
    execute:
        start bim editor property fieldCode in editTarget
        set editTarget's propertyText to inputValue
        apply bim editor property in editTarget

set gridEditor to a new bim editor
set ep to the address of gridEditor
set modelTarget to the address of (gridEditor's documentValue's current)
set gridId to add bim grid named (the string form of "1") from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 10.0) reaching -2.0 to 12.0 to modelTarget
set otherGrid to add bim grid named (the string form of "B") from (a cad vector2 with x 3.0 and y 0.0) to (a cad vector2 with x 3.0 and y 10.0) reaching -2.0 to 12.0 to modelTarget
set sourceRef to @intrinsic("construct", a bim reference record, gridId, bim grid line feature)
set otherRef to @intrinsic("construct", a bim reference record, otherGrid, bim grid line feature)
set dimensionId to add bim dimension from sourceRef to otherRef to modelTarget
set bim property (the string form of "SourceId") of set (the string form of "Source") of gridId to (the string form of "source-A") typed (the string form of "IfcLabel") in modelTarget
select bim editor bim grid picked numbered gridId in ep
set rowsShown to the bim property rows of gridEditor
set editableCount to 0
loop rowCursor from 0 to the length of rowsShown:
    set rowValue to the item at rowCursor in rowsShown
    if (rowValue's code >= 301) and (rowValue's code <= 305):
        set editableCount to editableCount + 1
check grid coordinates (editableCount = 5) named (the string form of "name and four coordinate fields visible")
free rowsShown
start bim editor property bim grid name property in ep
check grid coordinates (bim editor edits reinforcement text gridEditor) named (the string form of "grid name accepts text input")
set gridEditor's propertyText to the string form of "  A  "
apply bim editor property in ep
type grid coordinate field bim grid name property with (the string form of "   ") in ep
check grid coordinates ((the item at 0 in (modelTarget's grids's values))'s name = (the string form of "A")) named (the string form of "name trimmed and blank refused")
ignore undo bim transaction in (the address of (gridEditor's documentValue))
check grid coordinates ((the item at 0 in (modelTarget's grids's values))'s name = (the string form of "1")) named (the string form of "rename undo ignores refused blank input")
ignore redo bim transaction in (the address of (gridEditor's documentValue))
set gridEditor's lengthUnit to bim millimetre unit
type grid coordinate field bim grid end y property with (the string form of "0") in ep
check grid coordinates ((the item at 0 in (modelTarget's grids's values))'s finish's y = 10.0) named (the string form of "zero-length grid refused")
type grid coordinate field bim grid start x property with (the string form of "100") in ep
type grid coordinate field bim grid start y property with (the string form of "-1000") in ep
type grid coordinate field bim grid end x property with (the string form of "100") in ep
type grid coordinate field bim grid end y property with (the string form of "15000") in ep
set editedGrid to the item at 0 in (modelTarget's grids's values)
check grid coordinates (((the cad distance from editedGrid's start to (a cad vector2 with x 0.1 and y -1.0)) < 1e-9) and ((the cad distance from editedGrid's finish to (a cad vector2 with x 0.1 and y 15.0)) < 1e-9)) named (the string form of "four coordinates use millimetres")
check grid coordinates ((editedGrid's id = gridId) and ((editedGrid's low = -2.0) and (editedGrid's high = 12.0))) named (the string form of "identity and vertical extents preserved")
type grid coordinate field bim grid end y property with (the string form of "12..3") in ep
type grid coordinate field bim grid end y property with (the string form of "abc") in ep
type grid coordinate field bim grid end y property with (the string form of "1e309") in ep
check grid coordinates ((the item at 0 in (modelTarget's grids's values))'s finish's y = 15.0) named (the string form of "malformed and nonfinite input refused")
ignore undo bim transaction in (the address of (gridEditor's documentValue))
check grid coordinates ((the item at 0 in (modelTarget's grids's values))'s finish's y = 10.0) named (the string form of "one valid coordinate edit is one undo")
ignore redo bim transaction in (the address of (gridEditor's documentValue))
set gridEditor's lengthUnit to bim metre unit
type grid coordinate field bim grid end y property with (the string form of "16.25") in ep
check grid coordinates ((the item at 0 in (modelTarget's grids's values))'s finish's y = 16.25) named (the string form of "metre input respected")
set retainedDimension to the item at 0 in (modelTarget's dimensions's values)
check grid coordinates ((retainedDimension's id = dimensionId) and ((retainedDimension's first's elementId = gridId) and (retainedDimension's second's elementId = otherGrid))) named (the string form of "dimension references retain grid identities")
check grid coordinates ((the bim property value (the string form of "SourceId") of set (the string form of "Source") of gridId in gridEditor's documentValue's current) = (the string form of "source-A")) named (the string form of "source identity preserved")
set gridEditor's selectionId to 999999 as a 64 bit integer
type grid coordinate field bim grid start x property with (the string form of "12") in ep
type grid coordinate field bim grid name property with (the string form of "missing") in ep
check grid coordinates ((the item at 0 in (modelTarget's grids's values))'s name = (the string form of "A")) named (the string form of "stale selection does not change grids")
set savedText to the bim file text of gridEditor's documentValue's current
set parsedGridModel to the bim model parsed from savedText
check grid coordinates (parsedGridModel's valid and ((the bim file text of parsedGridModel's modelValue) = savedText)) named (the string form of "edited grids and references survive native roundtrip")
