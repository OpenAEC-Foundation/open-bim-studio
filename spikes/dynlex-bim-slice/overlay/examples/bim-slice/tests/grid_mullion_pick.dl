# SPDX-License-Identifier: MPL-2.0
# Picking a grid and a building system's mullion in the plan. A grid line
# under a beam and the grid's heads (the circles at its ends) both select the grid,
# whose properties then show, and which deletes and comes back with undo.
# A click on a building system chooses its mullion there, and the mullion
# highlights as its whole body: every edge of it at the mullion's place
# along the line, from the storey's floor to the system's top; a transom
# along the whole line at its height; a panel has no such edges.
import examples/bim-slice/bim_editor.dl

function click pick test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        refresh bim editor editor
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function show pick test selection of {a pointer to a bim editor record:editor} labelled {a string:title}:
    execute:
        print ((title + (the string form of ": grid ")) + (the string form of (editor's selectionKind = bim grid picked))) as a line

# The extent of the chosen joint's edges: across x and up z, and how many.
function show pick test joint of {a pointer to a bim editor record:editor} labelled {a string:title}:
    execute:
        set jointEdges to the bim chosen joint edges of (@intrinsic("dereference", editor))
        set count to the length of (jointEdges's values)
        if count = 0:
            print ((title + (the string form of ": part ")) + ((the string form of editor's partCode) + (the string form of ", no joint edges"))) as a line
            return nothing
        set lowX to 1.0 / 0.0
        set highX to -1.0 / 0.0
        set lowZ to 1.0 / 0.0
        set highZ to -1.0 / 0.0
        loop cursor from 0 to count:
            set spot to the item at cursor in (jointEdges's values)
            set lowX to the minimum of lowX and spot's x
            set highX to the maximum of highX and spot's x
            set lowZ to the minimum of lowZ and spot's z
            set highZ to the maximum of highZ and spot's z
        set middleX to (lowX + highX) * 0.5
        set middleZ to (lowZ + highZ) * 0.5
        print ((title + (the string form of ": part ")) + ((the string form of editor's partCode) + ((the string form of ", edges in pairs ") + (the string form of ((the remainder of count divided by 2) = 0))))) as a line
        print ((the string form of "  middle x ") + ((the bim length middleX in units 0) + ((the string form of ", z ") + (the bim length middleZ in units 0)))) as a line
        # Its length: along x for a transom, up z for a mullion (its
        # profile's size across is the system's joint).
        if (highX - lowX) > 1.0:
            print ((the string form of "  x ") + ((the bim length lowX in units 0) + ((the string form of " to ") + (the bim length highX in units 0)))) as a line
        if (highZ - lowZ) > 1.0:
            print ((the string form of "  z ") + ((the bim length lowZ in units 0) + ((the string form of " to ") + (the bim length highZ in units 0)))) as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set ground to editor's levelId
begin bim transaction in (the address of (editor's documentValue))
set gridId to add bim grid named (the string form of "A") from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) reaching 0.0 to 10.0 to target
set beamType to add bim linear type named (the string form of "Beam 200x400") as role (bim beam role) sized 0.2 by 0.4 round false of (the string form of "concrete") to target
set beamId to add bim linear typed beamType on ground from (a cad vector3 with x 0.0, y 0.0 and z 2.6) to (a cad vector3 with x 6.0, y 0.0 and z 2.6) turned 0.0 to target
set curtainId to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 3.0) to (a cad vector2 with x 6.0 and y 3.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
commit bim transaction in (the address of (editor's documentValue))

# The visible grid line and its heads take precedence over the beam.
click pick test at 3.0 and 0.0 in e
show pick test selection of e labelled (the string form of "line under the beam")
type bim editor key bim escape key code in e
click pick test at 6.05 and 0.02 in e
show pick test selection of e labelled (the string form of "head at the finish")
type bim editor key bim escape key code in e
click pick test at -0.06 and 0.0 in e
show pick test selection of e labelled (the string form of "head at the start")
set gridRows to the bim own property rows of editor
set firstRow to the item at 0 in gridRows
print ((the string form of "properties: ") + ((firstRow's label + (the string form of " ")) + firstRow's value)) as a line
free gridRows
type bim editor key bim delete key code in e
print ((the string form of "grids after delete: ") + (the string form of (the length of (editor's documentValue's current's grids's values)))) as a line
type bim editor key 90 in e
print ((the string form of "grids after undo: ") + (the string form of (the length of (editor's documentValue's current's grids's values)))) as a line
type bim editor key bim escape key code in e

# The building system: mullion 1 stands 1.2 m along its line.
click pick test at 1.2 and 3.0 in e
show pick test joint of e labelled (the string form of "mullion")
choose bim editor part of system curtainId at 3.0 and 1.5 in e
show pick test joint of e labelled (the string form of "transom")
choose bim editor part of system curtainId at 0.6 and 0.75 in e
show pick test joint of e labelled (the string form of "panel")
type bim editor key bim escape key code in e
show pick test joint of e labelled (the string form of "whole system")
