# SPDX-License-Identifier: MPL-2.0
# Area plans after NEN 2580: a 6 x 4 m room of 320 mm cavity walls split by
# a 100 mm partition. BVO runs along the outer faces (6.32 x 4.32), GO along
# the outer walls' inner faces (5.68 x 3.68, the partition included), NVO is
# the two spaces (GO less the partition) and VVO equals GO while no space is
# marked as not lettable. The library has an Area plan type drawing them.
import examples/bim-slice/bim_spaces.dl
import examples/bim-slice/bim_view.dl

function a bim area test point at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y}:
    execute:
        return a cad vector2 with x x and y y

function the bim area test text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.4f", value)
        return the substring of buffer from 0 spanning written bytes

set modelValue to an empty bim model
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to (the address of modelValue)
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.12)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.1)) to layerValues
set exteriorType to add bim wall type named (the string form of "Cavity wall") with layerValues to (the address of modelValue)
free layerValues
set innerLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.1)) to innerLayers
set interiorType to add bim wall type named (the string form of "Partition") with innerLayers to (the address of modelValue)
free innerLayers
ignore add bim wall typed exteriorType on storey from (a bim area test point at 0.0 and 0.0) to (a bim area test point at 6.0 and 0.0) to (the address of modelValue)
ignore add bim wall typed exteriorType on storey from (a bim area test point at 6.0 and 0.0) to (a bim area test point at 6.0 and 4.0) to (the address of modelValue)
ignore add bim wall typed exteriorType on storey from (a bim area test point at 6.0 and 4.0) to (a bim area test point at 0.0 and 4.0) to (the address of modelValue)
ignore add bim wall typed exteriorType on storey from (a bim area test point at 0.0 and 4.0) to (a bim area test point at 0.0 and 0.0) to (the address of modelValue)
ignore add bim wall typed interiorType on storey from (a bim area test point at 3.0 and 0.0) to (a bim area test point at 3.0 and 4.0) to (the address of modelValue)
set areas to the bim area measures of modelValue on level storey using (the bim join index of modelValue)
print ((the string form of "BVO ") + (the bim area test text of areas's gross)) as a line
print ((the string form of "GO  ") + (the bim area test text of areas's usable)) as a line
print ((the string form of "NVO ") + (the bim area test text of areas's net)) as a line
print ((the string form of "VVO ") + (the bim area test text of areas's lettable)) as a line
print ((the string form of "BVO bound segments ") + (the string form of ((the length of (areas's grossPairs's values)) / 2))) as a line
print ((the string form of "GO bound segments ") + (the string form of ((the length of (areas's usablePairs's values)) / 2))) as a line
ensure bim drawing types in (the address of modelValue)
set areaPlanType to the bim drawing type named (the string form of "Area plan") in modelValue
print ((the string form of "Area plan type exists: ") + (the string form of (areaPlanType != the bim refused id))) as a line
print ((the string form of "it draws NEN 2580 areas: ") + (the string form of (bim annotation bim area measures annotation applies to drawing type areaPlanType in modelValue))) as a line
print ((the string form of "it shows spaces: ") + (the string form of (bim category bim space category is visible in (the bim rules of drawing type areaPlanType in modelValue)))) as a line
set floorPlanType to the bim drawing type named (the string form of "Floor plan") in modelValue
print ((the string form of "a floor plan draws them: ") + (the string form of (bim annotation bim area measures annotation applies to drawing type floorPlanType in modelValue))) as a line
