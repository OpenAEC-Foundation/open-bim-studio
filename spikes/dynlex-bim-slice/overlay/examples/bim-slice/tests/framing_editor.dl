# SPDX-License-Identifier: MPL-2.0
# Steel framing in the editor: columns at four clicks, a chain of beams over
# them joined automatically, a profile and a connection chosen from the
# library, a joint made with the join tool, swapped, a member turned and
# justified, undone and deleted.
import examples/bim-slice/bim_editor.dl
import examples/bim-slice/bim_schedule.dl

function the bim framing editor profile index of {a string:wanted} in {bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of (editor's profiles's values):
            if (the item at cursor in (editor's profiles's values))'s name = wanted:
                return cursor
        return -1

function click bim framing editor at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function report bim framing editor {bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        print ((the string form of "  members ") + ((the string form of (the length of (modelValue's members's values))) + ((the string form of ", joints ") + ((the string form of (the length of (modelValue's joints's values))) + ((the string form of ", member types ") + (the string form of (the length of (modelValue's memberTypes's values)))))))) as a line

set editor to a new bim editor
set e to the address of editor
print ((the string form of "profiles ") + (the string form of (the length of (editor's profiles's values)))) as a line
set families to the bim profile families of editor
set familyLine to the string form of "families"
loop cursor from 0 to the length of families:
    set familyLine to (familyLine + (the string form of " ")) + (the item at cursor in families)
print familyLine as a line

# Four HEA 200 columns.
choose bim editor profile (the bim framing editor profile index of (the string form of "HEA 200") in editor) in e
print editor's message as a line
type bim editor key 2100 in e
click bim framing editor at 0.0 and 0.0 in e
print editor's message as a line
click bim framing editor at 6.0 and 0.0 in e
click bim framing editor at 6.0 and 5.0 in e
click bim framing editor at 0.0 and 5.0 in e
refresh bim editor e
report bim framing editor editor

# A chain of IPE 300 beams over the columns, snapped to their tops: each
# beam end on a column top is a butt joint with the column through.
choose bim editor profile (the bim framing editor profile index of (the string form of "IPE 300") in editor) in e
type bim editor key 2101 in e
click bim framing editor at 0.02 and 0.03 in e
click bim framing editor at 6.0 and 0.0 in e
print editor's message as a line
click bim framing editor at 6.0 and 5.0 in e
click bim framing editor at 0.0 and 5.0 in e
click bim framing editor at 0.0 and 0.0 in e
print editor's message as a line
type bim editor key bim escape key code in e
refresh bim editor e
report bim framing editor editor
set failures to 0
loop cursor from 0 to the length of (editor's evaluation's elements's values):
    set status to (the item at cursor in (editor's evaluation's elements's values))'s status
    if (status != 0) and (status != 4):
        set failures to failures + 1
print ((the string form of "  failing elements ") + (the string form of failures)) as a line

# A secondary beam across the middle, from beam to beam: T joints, then an
# end plate chosen for the selected joint.
type bim editor key 2101 in e
click bim framing editor at 3.0 and 0.0 in e
click bim framing editor at 3.0 and 5.0 in e
print editor's message as a line
type bim editor key bim escape key code in e
refresh bim editor e
report bim framing editor editor
set lastJoint to (the item at ((the length of (editor's documentValue's current's joints's values)) - 1) in (editor's documentValue's current's joints's values))'s id
select bim editor bim joint picked numbered lastJoint in e
choose bim editor connection 3 in e
print editor's message as a line
refresh bim editor e
print (the bim selection description of editor) as a line
set plateGeometry to the item at (the bim position of lastJoint among (editor's evaluation's elements's values))'s position in (editor's evaluation's elements's values)
print ((the string form of "  plate status ") + (the string form of plateGeometry's status)) as a line

# Selecting a member in the plan, turning it and changing its justification.
type bim editor key 83 in e
click bim framing editor at 3.0 and 2.5 in e
print editor's message as a line
type bim editor key 2105 in e
print editor's message as a line
type bim editor key 2106 in e
print editor's message as a line
type bim editor key 90 in e
type bim editor key 90 in e
refresh bim editor e
set middle to the item at (the bim member index of editor's selectionId in editor's documentValue's current)'s position in (editor's documentValue's current's members's values)
print ((the string form of "  after two undos: roll ") + ((the string form of middle's roll) + ((the string form of ", justification ") + (the string form of middle's justification)))) as a line

# The join tool on two members already joined selects their joint; swapping
# it makes the other member primary.
type bim editor key 2103 in e
click bim framing editor at 0.0 and 2.5 in e
click bim framing editor at 2.0 and 5.0 in e
print editor's message as a line
type bim editor key 2104 in e
print editor's message as a line

# Deleting the selected column deletes its joints.
type bim editor key 83 in e
click bim framing editor at 6.0 and 5.0 in e
print editor's message as a line
type bim editor key bim delete key code in e
refresh bim editor e
report bim framing editor editor
type bim editor key 90 in e
refresh bim editor e
report bim framing editor editor

# Saving and reading back keeps the framing: the same text, and the same
# solids from the read model.
set written to the bim file text of editor's documentValue's current
set parsed to the bim model parsed from written
print ((the string form of "read back: ") + (the string form of parsed's valid) + (the string form of " ") + parsed's message) as a line
print ((the string form of "  same text ") + (the string form of ((the bim file text of parsed's modelValue) = written))) as a line
set reread to the bim evaluation of parsed's modelValue after an empty bim evaluation
set sameSolids to (the length of (reread's elements's values)) = (the length of (editor's evaluation's elements's values))
if sameSolids:
    loop cursor from 0 to the length of (reread's elements's values):
        if (the item at cursor in (reread's elements's values))'s signature != (the item at cursor in (editor's evaluation's elements's values))'s signature:
            set sameSolids to false
print ((the string form of "  same solids ") + (the string form of sameSolids)) as a line
set lineCount to 0
set framingLines to written split at "\n"
loop cursor from 0 to the length of framingLines:
    set line to the item at cursor in framingLines
    if ((line starts with "membertype") or (line starts with "connectiontype")) or (line starts with "joint 2"):
        print ((the string form of "  ") + line) as a line
set broken to written
loop cursor from 0 to the length of framingLines:
    set line to the item at cursor in framingLines
    if line starts with "joint 26 ":
        set tokens to line split at " "
        set broken to written with line replaced by ((the string form of "joint 26 ") + ((the item at 2 in tokens) + ((the string form of " 999 ") + (the item at 4 in tokens))))
print ((the string form of "  dangling joint: ") + (the bim model parsed from broken)'s message) as a line

# IFC4 export: beams, columns and the end plates as faceted B-reps, the
# members associated with their material.
set ifcText to the bim ifc text of (editor's documentValue's current)
set ifcLines to ifcText split at "\n"
set beams to 0
set columns to 0
set plates to 0
set breps to 0
set materials to 0
loop cursor from 0 to the length of ifcLines:
    set line to the item at cursor in ifcLines
    if line contains "=IFCBEAM(":
        set beams to beams + 1
    if line contains "=IFCCOLUMN(":
        set columns to columns + 1
    if line contains "=IFCPLATE(":
        set plates to plates + 1
    if line contains "=IFCFACETEDBREP(":
        set breps to breps + 1
    if line contains "=IFCRELASSOCIATESMATERIAL(":
        set materials to materials + 1
print ((the string form of "ifc: beams ") + ((the string form of beams) + ((the string form of ", columns ") + ((the string form of columns) + ((the string form of ", plates ") + ((the string form of plates) + ((the string form of ", breps ") + ((the string form of breps) + ((the string form of ", material associations ") + (the string form of materials)))))))))) as a line
if write bim text ifcText to file (the string form of "framing-editor.ifc"):
    print (the string form of "  wrote framing-editor.ifc") as a line

# A glued laminated timber column and a round concrete column take their
# profile's material, which their cut and their 3D colour follow.
choose bim editor profile (the bim framing editor profile index of (the string form of "GL24h 200x400") in editor) in e
type bim editor key 2100 in e
click bim framing editor at 12.0 and 0.0 in e
print editor's message as a line
choose bim editor profile (the bim framing editor profile index of (the string form of "Concrete D500") in editor) in e
click bim framing editor at 15.0 and 0.0 in e
print editor's message as a line
type bim editor key bim escape key code in e
refresh bim editor e
loop cursor from 0 to the length of (editor's documentValue's current's members's values):
    set memberValue to the item at cursor in (editor's documentValue's current's members's values)
    if memberValue's start's x > 10.0:
        set memberType to the item at (the bim member type index of memberValue's typeId in editor's documentValue's current)'s position in (editor's documentValue's current's memberTypes's values)
        set geometry to the item at (the bim position of memberValue's id among (editor's evaluation's elements's values))'s position in (editor's evaluation's elements's values)
        print ((the string form of "  ") + (memberType's name + ((the string form of ": ") + (memberType's material + ((the string form of ", drawn as ") + ((the bim drawing material of (memberValue's id) in editor's documentValue's current) + ((the string form of ", volume ") + (the string form of (the bim volume of geometry))))))))) as a line

# The schedule's steel rows.
set rows to the bim schedule of editor's documentValue's current with editor's evaluation and (editor's spaces's values)
set csv to the bim schedule csv of (rows's values)
set csvLines to csv split at "\n"
loop cursor from 0 to the length of csvLines:
    if (((the item at cursor in csvLines) starts with "Steel") or ((the item at cursor in csvLines) starts with "Timber")) or ((the item at cursor in csvLines) starts with "Concrete"):
        print ((the string form of "  ") + (the item at cursor in csvLines)) as a line
