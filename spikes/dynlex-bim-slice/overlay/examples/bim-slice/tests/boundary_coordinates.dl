# SPDX-License-Identifier: MPL-2.0
# Numeric boundary points stay pending until Tab; joined endpoints move
# together, units convert without rounding, malformed values do not move,
# invalid loops cannot commit, and the complete sketch is undoable.
import examples/bim-slice/bim_editor.dl

function check boundary coordinate {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set editor to a new bim editor
set target to the address of editor
set outlinePoints to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to outlinePoints
append (a cad vector2 with x 6.0 and y 0.0) to outlinePoints
append (a cad vector2 with x 6.0 and y 4.0) to outlinePoints
append (a cad vector2 with x 0.0 and y 4.0) to outlinePoints
set floorId to add bim slab on editor's levelId around outlinePoints thick 0.25 to (the address of (editor's documentValue's current))
refresh bim editor target
select bim editor bim slab picked numbered floorId in target
type bim editor key 258 in target
move bim editor pointer to (a cad vector2 with x 0.0 and y 0.0) within 0.1 in target
press bim editor pointer in target
release bim editor pointer in target
check boundary coordinate (bim boundary point selected in editor) named (the string form of "a boundary endpoint is selected")
set originalFile to the bim file text of editor's documentValue's current
set editor's lengthUnit to bim millimetre unit
start bim editor property 290 in target
set editor's propertyText to the string form of "-250.125"
apply bim editor property in target
start bim editor property 291 in target
set editor's propertyText to the string form of "125.5"
apply bim editor property in target
set chosenPoint to the bim selected boundary point of editor
check boundary coordinate (((the absolute value of (chosenPoint's x + 0.250125)) < 1e-9) and ((the absolute value of (chosenPoint's y - 0.1255)) < 1e-9)) named (the string form of "millimetre coordinates retain submillimetre precision")
set incidentCount to 0
loop cursor from 0 to the length of (editor's sketchSegments's values):
    set segmentValue to the item at cursor in (editor's sketchSegments's values)
    if bim boundary point segmentValue's start meets chosenPoint:
        set incidentCount to incidentCount + 1
    if bim boundary point segmentValue's finish meets chosenPoint:
        set incidentCount to incidentCount + 1
check boundary coordinate (incidentCount = 2) named (the string form of "both incident endpoints move together")
check boundary coordinate ((the bim file text of editor's documentValue's current) = originalFile) named (the string form of "coordinates remain pending in the sketch")
start bim editor property 290 in target
set editor's propertyText to the string form of "12..3"
apply bim editor property in target
check boundary coordinate (((the bim selected boundary point of editor)'s x) = chosenPoint's x) named (the string form of "malformed coordinate is refused")
type bim editor key 258 in target
check boundary coordinate (editor's editMode = false) named (the string form of "Tab commits the valid boundary")
ignore undo bim transaction in (the address of (editor's documentValue))
check boundary coordinate ((the bim file text of editor's documentValue's current) = originalFile) named (the string form of "undo restores the original whole boundary")
refresh bim editor target
select bim editor bim slab picked numbered floorId in target
type bim editor key 258 in target
move bim editor pointer to (a cad vector2 with x 0.0 and y 0.0) within 0.1 in target
press bim editor pointer in target
release bim editor pointer in target
ignore move bim selected boundary point to (a cad vector2 with x 7.0 and y 3.0) in target
type bim editor key 258 in target
check boundary coordinate (editor's editMode and ((the bim file text of editor's documentValue's current) = originalFile)) named (the string form of "a crossing boundary stays pending and cannot commit")
leave bim editor boundary sketch in target
check boundary coordinate ((the bim file text of editor's documentValue's current) = originalFile) named (the string form of "cancel discards pending coordinates")
