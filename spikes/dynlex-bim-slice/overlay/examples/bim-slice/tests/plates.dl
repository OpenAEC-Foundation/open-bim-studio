# SPDX-License-Identifier: MPL-2.0
# Plates: floors, roofs and ceilings are one element, its planar type saying
# which (and so its IFC class) with its layers. A floor given the timber
# floor type takes its thickness and material; a roof sits on the walls and
# pitched 30 degrees rises along its slope; a ceiling hangs under the storey
# above; all survive .bim and .ifcx, and an old untyped slab still reads.
import examples/bim-slice/bim_editor.dl

function the plate test text of {a 64 bit floating-point number:value}:
    execute:
        set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, value * 10000.0)
        return the string form of (scaled / 10000.0)

function show bim plate {a 64 bit integer:slabId} of {bim model record:modelValue} labelled {a string:label}:
    execute:
        set found to the bim slab index of slabId in modelValue
        if found's valid = false:
            print (label + (the string form of ": no plate")) as a line
            return nothing
        set slabValue to the item at found's position in (modelValue's slabs's values)
        set evaluation to the bim evaluation of modelValue after (an empty bim evaluation)
        set low to 1.0 / 0.0
        set high to 0.0 - (1.0 / 0.0)
        set volume to 0.0
        loop cursor from 0 to the length of (evaluation's elements's values):
            set geometry to the item at cursor in (evaluation's elements's values)
            if geometry's id = slabId:
                set volume to the bim volume of geometry
                loop corner from 0 to the length of (geometry's shape's positions's values):
                    set low to the minimum of low and (the item at corner in (geometry's shape's positions's values))'s z
                    set high to the maximum of high and (the item at corner in (geometry's shape's positions's values))'s z
        set line to (label + (the string form of ": ")) + (the bim ifc class of planar role (the bim role of plate slabValue in modelValue))
        set line to (line + (the string form of ", ")) + ((the plate test text of (the bim thickness of plate slabValue in modelValue)) + (the string form of " m "))
        set line to line + (the bim material of plate slabValue in modelValue)
        set line to (line + (the string form of ", volume ")) + (the plate test text of volume)
        set line to (line + (the string form of ", heights ")) + (((the plate test text of low) + (the string form of " to ")) + (the plate test text of high))
        print line as a line

function the bim plate test type named {a string:wanted} in {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's wallTypes's values):
            if (the item at cursor in (modelValue's wallTypes's values))'s name = wanted:
                return (the item at cursor in (modelValue's wallTypes's values))'s id
        return the bim refused id

set editor to a new bim editor
set e to the address of editor
set outline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to outline
append (a cad vector2 with x 5.0 and y 0.0) to outline
append (a cad vector2 with x 5.0 and y 4.0) to outline
append (a cad vector2 with x 0.0 and y 4.0) to outline
begin bim transaction in (the address of (editor's documentValue))
set slabId to add bim slab on editor's levelId around outline thick 0.2 to (the address of (editor's documentValue's current))
commit bim transaction in (the address of (editor's documentValue))
show bim plate slabId of editor's documentValue's current labelled (the string form of "old untyped slab")
ensure bim plate types in e
select bim editor bim slab picked numbered slabId in e
choose bim editor plate type (the bim plate test type named (the string form of "Hout 200") in editor's documentValue's current) in e
print editor's message as a line
show bim plate slabId of editor's documentValue's current labelled (the string form of "timber floor")
set propertyRows to the bim property rows of editor
loop cursor from 0 to the length of propertyRows:
    set propertyRow to the item at cursor in propertyRows
    print ((the string form of "  ") + ((propertyRow's label + (the string form of ": ")) + propertyRow's value)) as a line
# A roof on the walls of the 3 m storey, pitched 30 degrees rising north.
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set roofType to the bim plate test type named (the string form of "Isolatie PIR-beton 320") in editor's documentValue's current
set roof to add bim plate typed roofType on editor's levelId around outline at top 3.32 to target
commit bim transaction in (the address of (editor's documentValue))
show bim plate roof of editor's documentValue's current labelled (the string form of "flat roof 0.32 on 3 m walls (6.4 m3)")
ignore set bim plate roof top to 3.32 pitch (30.0 * (3.141592653589793 / 180.0)) heading (90.0 * (3.141592653589793 / 180.0)) in target
show bim plate roof of editor's documentValue's current labelled (the string form of "pitched 30 deg north (top +4 tan 30 = +2.3094)")
set ceilingType to the bim plate test type named (the string form of "Gips 12.5") in editor's documentValue's current
set ceiling to add bim plate typed ceilingType on editor's levelId around outline at top 2.7 to target
show bim plate ceiling of editor's documentValue's current labelled (the string form of "ceiling under 0.3 m of plenum")
print ((the string form of "ceiling hidden in the plan: ") + (the string form of ((bim category (the bim category of element ceiling in editor's documentValue's current) is visible in editor's planRules) = false))) as a line
# Saved and read back.
set reread to the bim model parsed from (the bim file text of editor's documentValue's current)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of " ") + reread's message))) as a line
show bim plate roof of reread's modelValue labelled (the string form of "roof from .bim")
set exported to the bim ifcx text of editor's documentValue's current identified as (the string form of "plates.ifcx") for project (the string form of "plates") by (the string form of "test") at (the string form of "2026-10-09T00:00:00Z")
print ((the string form of "IfcX: IfcSlabType, ROOF and IfcCovering: ") + (the string form of (((exported contains "IfcSlabType") and (exported contains "ROOF")) and (exported contains "IfcCovering")))) as a line
set native to the bim native text of ifcx exported
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of " ") + fromIfcx's message))) as a line
show bim plate slabId of fromIfcx's modelValue labelled (the string form of "floor from .ifcx")
show bim plate ceiling of fromIfcx's modelValue labelled (the string form of "ceiling from .ifcx")
