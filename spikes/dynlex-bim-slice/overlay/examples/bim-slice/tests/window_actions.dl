import examples/bim-slice/bim_window_actions.dl
function check window action {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line
set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layers
set wallType to add bim wall type named (the string form of "Brick") with layers to target
set wallId to add bim wall typed wallType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set openingType to add bim opening type named (the string form of "Window") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
set openingId to add bim opening typed openingType in wallId at 3.0 to target
set windowId to ensure bim window system in opening openingId typed 34 with joint (10 as a 64 bit integer) in target
check window action ((windowId != the bim refused id) and ((the bim window system in opening openingId in modelValue) = windowId)) named (the string form of "opening action creates and links a window system")
set again to ensure bim window system in opening openingId typed 42 with joint (10 as a 64 bit integer) in target
check window action ((again = windowId) and ((the length of (modelValue's curtains's values)) = 1)) named (the string form of "repeated action selects the existing system")
check window action ((the bim system type index of windowId in modelValue) = 34) named (the string form of "existing window recipe remains unchanged")
set secondOpening to add bim opening typed openingType in wallId at 1.0 to target
check window action ((ensure bim window system in opening secondOpening typed 0 with joint (10 as a 64 bit integer) in target) = the bim refused id) named (the string form of "non-window recipes are refused")
check window action ((ensure bim window system in opening secondOpening typed 21 with joint ((-1) as a 64 bit integer) in target) = the bim refused id) named (the string form of "negative installation joint is refused")
check window action ((ensure bim window system in opening (99999 as a 64 bit integer) typed 21 with joint (10 as a 64 bit integer) in target) = the bim refused id) named (the string form of "missing opening creates no stray system")
check window action ((the length of (modelValue's curtains's values)) = 1) named (the string form of "refused actions leave the system list unchanged")
