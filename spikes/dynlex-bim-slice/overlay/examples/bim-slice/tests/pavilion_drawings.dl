# SPDX-License-Identifier: MPL-2.0
# The demonstration pavilion's drawings (`bim_pavilion_drawings.dl`): its
# plan, two sections and south elevation at 1:50, the grids dimensioned, the
# columns, beams and five reinforcement marks tagged, all from id 10000 up;
# two A2 sheets whose viewports refer to those views and lie inside the
# border, clear of the title block, the legend and each other; all of it
# read back from .bim and .ifcx.
import examples/bim-slice/bim_demo_pavilion.dl
import examples/bim-slice/bim_pavilion_drawings.dl
import examples/bim-slice/bim_drawing.dl
import examples/bim-slice/bim_file.dl
import examples/bim-slice/bim_ifcx.dl
import examples/bim-slice/bim_ifcx_read.dl

function show pavilion test drawings of {bim model record:modelValue} labelled {a string:title}:
    execute:
        print title as a line
        set reserved to (bim pavilion drawings first id) as a 64 bit integer
        loop cursor from 0 to the length of (modelValue's views's values):
            set viewValue to the item at cursor in (modelValue's views's values)
            print ((the string form of "  ") + ((viewValue's name + (the string form of ": kind ")) + ((the string form of viewValue's kind) + ((the string form of ", 1:") + ((the string form of viewValue's scale) + ((the string form of ", cropped ") + ((the string form of viewValue's cropped) + ((the string form of ", from 10000 ") + (the string form of (viewValue's id >= reserved)))))))))) as a line
        set millimetres to the string form of ""
        loop cursor from 0 to the length of (modelValue's dimensions's values):
            set measured to the bim measure of (the item at cursor in (modelValue's dimensions's values)) in modelValue
            set millimetres to (millimetres + (the string form of " ")) + (the string form of ((measured's value) * 1000.0))
        print (((the string form of "  dimensions ") + (the string form of (the length of (modelValue's dimensions's values)))) + ((the string form of ":") + millimetres)) as a line
        set anchored to 0
        set tagsReserved to true
        loop cursor from 0 to the length of (modelValue's tags's values):
            set tagValue to the item at cursor in (modelValue's tags's values)
            if (the bim tag anchor of (tagValue's elementId) in modelValue)'s valid:
                set anchored to anchored + 1
            if tagValue's id < reserved:
                set tagsReserved to false
        print ((the string form of "  tags ") + ((the string form of (the length of (modelValue's tags's values))) + ((the string form of ", anchored ") + ((the string form of anchored) + ((the string form of ", from 10000 ") + (the string form of tagsReserved)))))) as a line
        loop cursor from 0 to the length of (modelValue's sheets's values):
            set sheetValue to the item at cursor in (modelValue's sheets's values)
            set sheetSize to the bim size of sheet sheetValue
            set legendList to the bim legend entries of sheet sheetValue in modelValue
            set placementText to the bim placement fault of sheet sheetValue in modelValue
            if (the length of placementText) = 0:
                set placementText to the string form of "none"
            print ((the string form of "  ") + ((sheetValue's number + (the string form of " ")) + ((sheetValue's name + (the string form of ", ")) + ((the string form of (sheetSize's x)) + ((the string form of " x ") + (the string form of (sheetSize's y))))))) as a line
            print ((the string form of "    viewports ") + ((the string form of (the length of (sheetValue's viewports's values))) + ((the string form of ", legend rows ") + ((the string form of (the length of legendList)) + ((the string form of ", scale ") + (the bim scale text of sheet sheetValue in modelValue)))))) as a line
            print ((the string form of "    placement fault: ") + placementText) as a line
            free legendList

set generated to the bim demo pavilion
set modelValue to generated's modelValue
set made to add bim pavilion drawings to (the address of modelValue) on level (generated's groundLevelId)
print ((the string form of "drawings made: ") + (the string form of made's valid)) as a line
print ((the string form of "plan id: ") + (the string form of made's planId)) as a line
show pavilion test drawings of modelValue labelled (the string form of "model:")
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", ") + reread's message))) as a line
show pavilion test drawings of reread's modelValue labelled (the string form of "from .bim:")
set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "pavilion.ifcx") for project (the string form of "pavilion") by (the string form of "test") at (the string form of "2026-10-20T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of ", ") + fromIfcx's message))) as a line
show pavilion test drawings of fromIfcx's modelValue labelled (the string form of "from .ifcx:")
