# SPDX-License-Identifier: MPL-2.0
# Incremental evaluation of linear members and joints: a portal frame of
# columns and beams with butt, mitre and end plate joints, changed step by
# step. After every step the updated evaluation must equal a reference one, and
# only the members and joints a change reaches are rebuilt.
import examples/bim-slice/bim_evaluate.dl
import examples/bim-slice/bim_profiles.dl
import examples/bim-slice/bim_connection_library.dl

function check bim framing {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print label as a line
            @intrinsic("call", "libc", "exit", nothing, 1)

function a bim frame point at {a 64 bit floating-point number:x}, {a 64 bit floating-point number:y} and {a 64 bit floating-point number:z}:
    execute:
        return a cad vector3 with x x, y y and z z

function the bim frame test text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 48 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 49 as a word sized unsigned integer, "%.6f", value)
        return the substring of buffer from 0 spanning written bytes

# Checks `evaluation` against a reference evaluation of `modelValue`: the same
# elements with the same signatures and statuses.
function compare bim framing {bim evaluation record:evaluation} with a fresh one of {bim model record:modelValue} labelled {a string:label}:
    execute:
        set reference to the bim evaluation of modelValue after an empty bim evaluation
        check bim framing ((the length of (evaluation's elements's values)) = (the length of (reference's elements's values))) named (label + (the string form of ": element count differs"))
        set total to 0.0
        loop cursor from 0 to the length of (reference's elements's values):
            set expected to the item at cursor in (reference's elements's values)
            set actual to the item at cursor in (evaluation's elements's values)
            check bim framing (expected's id = actual's id) named (label + (the string form of ": ids differ"))
            check bim framing (expected's signature = actual's signature) named ((label + (the string form of ": stale signature of ")) + (the string form of actual's id))
            check bim framing (expected's status = actual's status) named (label + (the string form of ": status differs"))
            if actual's status = 0:
                check bim framing ((the fast flaw of actual's shape within 1e-9) = 0) named (label + (the string form of ": open solid"))
            set total to total + (the bim volume of actual)
        print ((label + (the string form of ": rebuilt ")) + ((the string form of evaluation's rebuilt) + ((the string form of " of ") + ((the string form of (the length of (evaluation's elements's values))) + ((the string form of ", steel ") + (the bim frame test text of total)))))) as a line

function the bim evaluate template named {a string:wanted}:
    execute:
        set offered to the bim connection templates
        set chosen to the item at 0 in offered
        loop cursor from 0 to the length of offered:
            if (the item at cursor in offered)'s name = wanted:
                set chosen to the item at cursor in offered
        free offered
        return chosen

set library to the bim steel profiles
set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 4.0 to target
set columnType to add bim member type named (the string form of "HEA 240") with profile (the bim steel profile named (the string form of "HEA 240") in (library's values)) in (the string form of "S355") to target
set beamType to add bim member type named (the string form of "IPE 360") with profile (the bim steel profile named (the string form of "IPE 360") in (library's values)) in (the string form of "S355") to target
set mitre to add bim connection type (the bim evaluate template named (the string form of "Mitre")) to target
set butt to add bim connection type (the bim evaluate template named (the string form of "Butt")) to target
set plated to add bim connection type (the bim evaluate template named (the string form of "End plate 20, 4x2 M24")) to target

# Two portals 6 m apart: columns 4 m high, rafters across, a tie beam
# between the portals framing into the columns at 3 m.
set westLeft to add bim member typed columnType on storey as bim column role from (a bim frame point at 0.0, 0.0 and 0.0) to (a bim frame point at 0.0, 0.0 and 4.0) to target
set westRight to add bim member typed columnType on storey as bim column role from (a bim frame point at 8.0, 0.0 and 0.0) to (a bim frame point at 8.0, 0.0 and 4.0) to target
set westBeam to add bim member typed beamType on storey as bim beam role from (a bim frame point at 0.0, 0.0 and 4.0) to (a bim frame point at 8.0, 0.0 and 4.0) to target
set eastLeft to add bim member typed columnType on storey as bim column role from (a bim frame point at 0.0, 6.0 and 0.0) to (a bim frame point at 0.0, 6.0 and 4.0) to target
set eastRight to add bim member typed columnType on storey as bim column role from (a bim frame point at 8.0, 6.0 and 0.0) to (a bim frame point at 8.0, 6.0 and 4.0) to target
set eastBeam to add bim member typed beamType on storey as bim beam role from (a bim frame point at 0.0, 6.0 and 4.0) to (a bim frame point at 8.0, 6.0 and 4.0) to target
set tie to add bim member typed beamType on storey as bim beam role from (a bim frame point at 0.0, 0.0 and 3.0) to (a bim frame point at 0.0, 6.0 and 3.0) to target
ignore set bim member westBeam justification to bim centre justification in target
ignore set bim member eastBeam justification to bim centre justification in target
ignore add bim joint typed butt between westLeft and westBeam to target
ignore add bim joint typed butt between westRight and westBeam to target
ignore add bim joint typed mitre between eastLeft and eastBeam to target
ignore add bim joint typed mitre between eastRight and eastBeam to target
set tieWest to add bim joint typed plated between westLeft and tie to target
set tieEast to add bim joint typed plated between eastLeft and tie to target

set evaluation to an empty bim evaluation
update bim evaluation (the address of evaluation) to modelValue
compare bim framing evaluation with a fresh one of modelValue labelled (the string form of "first evaluation")

update bim evaluation (the address of evaluation) to modelValue
compare bim framing evaluation with a fresh one of modelValue labelled (the string form of "unchanged")

# Moving the west right column 0.5 m out moves the west beam's end with it:
# the column, the beam and the beam's other column are examined.
ignore move bim member westRight to (a bim frame point at 8.5, 0.0 and 0.0) and (a bim frame point at 8.5, 0.0 and 4.0) in target
ignore move bim member westBeam to (a bim frame point at 0.0, 0.0 and 4.0) and (a bim frame point at 8.5, 0.0 and 4.0) in target
update bim evaluation (the address of evaluation) to modelValue
compare bim framing evaluation with a fresh one of modelValue labelled (the string form of "west portal widened")

# Raising the tie beam moves both plates; the columns run through.
ignore move bim member tie to (a bim frame point at 0.0, 0.0 and 3.2) and (a bim frame point at 0.0, 6.0 and 3.2) in target
update bim evaluation (the address of evaluation) to modelValue
compare bim framing evaluation with a fresh one of modelValue labelled (the string form of "tie raised")

# A thicker end plate: both plates and the tie beam's ends.
ignore set bim connection type plated parameter 1 to 0.025 in target
update bim evaluation (the address of evaluation) to modelValue
compare bim framing evaluation with a fresh one of modelValue labelled (the string form of "thicker plates")

# Heavier columns: every column, and every member and plate joined to one.
ignore set bim member type columnType profile to (the bim steel profile named (the string form of "HEB 300") in (library's values)) in target
update bim evaluation (the address of evaluation) to modelValue
compare bim framing evaluation with a fresh one of modelValue labelled (the string form of "heavier columns")

# The east corners become butt joints with the beam running through.
loop cursor from 0 to the length of (modelValue's joints's values):
    set jointValue to the item at cursor in (modelValue's joints's values)
    if jointValue's typeId = mitre:
        ignore set bim joint jointValue's id type to butt in target
        ignore swap bim joint jointValue's id in target
update bim evaluation (the address of evaluation) to modelValue
compare bim framing evaluation with a fresh one of modelValue labelled (the string form of "east corners butt")

# Deleting the tie beam deletes its plates.
ignore delete bim member tie from target
update bim evaluation (the address of evaluation) to modelValue
compare bim framing evaluation with a fresh one of modelValue labelled (the string form of "tie deleted")

# A model with a new journal (as after undo) is compared record by record.
set copied to the bim snapshot of modelValue
set copied's journal to a cad topology list of a 64 bit integer
update bim evaluation (the address of evaluation) to copied
compare bim framing evaluation with a fresh one of copied labelled (the string form of "new journal")
