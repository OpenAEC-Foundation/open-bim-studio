import examples/bim-slice/bim_fastener_detail.dl
function check detail {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set fastener to @intrinsic("construct", a connection fastener, 1, 1 as a 64 bit integer, 1, (a cad vector3 with x 2.0, y 3.0 and z 4.0), (a cad vector3 with x 0.0, y 0.0 and z -1.0), 0.02, 0.35)
set points to the bim cosmetic helix of fastener
check detail ((the length of (points's values)) = 193) named (the string form of "bounded thread detail")
set first to the item at 0 in (points's values)
set last to the item at 192 in (points's values)
check detail ((the absolute value of (first's x - 2.0101)) < 1e-9) named (the string form of "thread outside shaft")
check detail ((the absolute value of (last's z - 3.96)) < 1e-9) named (the string form of "reversed anchor follows axis")
set fastener's axis to a cad vector3 with x 2.0, y 0.0 and z 0.0
set fastener's length to 0.01
set points to the bim cosmetic helix of fastener
set last to the item at 192 in (points's values)
check detail ((the absolute value of (last's x - 2.01)) < 1e-9) named (the string form of "short horizontal shaft limits thread")
set fastener's diameter to 0.0
set invalidPoints to the bim cosmetic helix of fastener
check detail ((the length of (invalidPoints's values)) = 0) named (the string form of "invalid diameter produces no thread")
