# SPDX-License-Identifier: MPL-2.0
# A wall's masonry module in 3D (`the bim masonry line shape of`): light
# lines, one upright line per module line from the wall's foot to its top
# on the masonry face, with no triangles. Among the sketch meshes under the
# wall's id, they move with the wall. A wall without a module and a curved
# one get none. The sizes are generic (a 210 mm module), not project data.
import examples/bim-slice/bim_scene.dl

function check masonry lines {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The sketch mesh of element `elementId` in `modelValue`, as lines: how many
# points it has (0 when it has none), and its first point's x and y.
class:
    patterns:
        [a|] masonry lines found record
    members:
        points as an integer
        firstX as a 64 bit floating-point number
        firstY as a 64 bit floating-point number

function the lines of element {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        set sketchList to the bim sketch meshes of modelValue
        loop cursor from 0 to the length of (sketchList's values):
            set entry to the item at cursor in (sketchList's values)
            if (entry's elementId = elementId) and (bim scene mesh entry draws lines):
                set firstPoint to the item at 0 in (entry's shape's positions's values)
                return @intrinsic("construct", a masonry lines found record, the length of (entry's shape's positions's values), firstPoint's x, firstPoint's y)
        return @intrinsic("construct", a masonry lines found record, 0, 0.0, 0.0)

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 1.0 with height 3.0 to target
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "block", 0.1)) to layerValues
set cavityType to add bim wall type named (the string form of "Two leaves 200") with layerValues to target
set wallId to add bim wall typed cavityType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 2.0 and y 0.0) to target
set plainWall to add bim wall typed cavityType on ground from (a cad vector2 with x 0.0 and y 5.0) to (a cad vector2 with x 2.0 and y 5.0) to target
ignore give bim wall wallId masonry module (2100 as a 64 bit integer) on layer 0 from finish false offset (0 as a 64 bit integer) in target

# Nine whole modules: ten lines of two points each, upright, 3 m high from
# the foot at 1 m.
set wallFound to the bim wall index of wallId in modelValue
set masonryValue to the bim masonry of wall (the item at wallFound's position in (modelValue's walls's values)) in modelValue
set lineShape to the bim masonry line shape of masonryValue
set firstFoot to the item at 0 in (lineShape's positions's values)
set firstTop to the item at 1 in (lineShape's positions's values)
check masonry lines (((the length of (lineShape's positions's values)) = 20) and ((the length of (lineShape's triangles's values)) = 0)) named (the string form of "ten module lines, as lines, no triangles")
check masonry lines (((the absolute value of (firstFoot's z - 1.0)) < 0.000001) and ((the absolute value of (firstTop's z - 4.0)) < 0.000001)) named (the string form of "each from the wall's foot to its top")
check masonry lines (((the absolute value of (firstTop's x - firstFoot's x)) < 0.000001) and ((the absolute value of (firstFoot's y + 0.1)) < 0.000001)) named (the string form of "upright, on the masonry face")

set sketchFound to the lines of element wallId in modelValue
check masonry lines (sketchFound's points = 20) named (the string form of "the sketch meshes hold them under the wall's id")
check masonry lines (((the lines of element plainWall in modelValue)'s points) = 0) named (the string form of "a wall without a module has no lines")

# Moved 3 m across: the lines go with it.
set moved to the item at wallFound's position in (modelValue's walls's values)
set moved's start to a cad vector2 with x 0.0 and y 3.0
set moved's finish to a cad vector2 with x 2.0 and y 3.0
replace item at index wallFound's position in (target's walls's values) with moved
check masonry lines (((the absolute value of (((the lines of element wallId in modelValue)'s firstY) - 2.9)) < 0.000001)) named (the string form of "the wall moved, its lines go with it")

# Curved: no lines rather than straight ones.
set bent to the item at wallFound's position in (modelValue's walls's values)
set bent's bulge to 0.3
replace item at index wallFound's position in (target's walls's values) with bent
check masonry lines (((the lines of element wallId in modelValue)'s points) = 0) named (the string form of "a curved wall has no lines")
