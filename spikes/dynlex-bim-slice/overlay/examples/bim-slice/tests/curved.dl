# SPDX-License-Identifier: MPL-2.0
# Curved walls: a free arc wall against the exact volume of its ring sector,
# a room closed by an arc wall with its L joins, a window in the arc, the
# bulge kept to a half circle, the file round trip, the room's space and the
# plan bands of the arc's layers.
import examples/bim-slice/bim_hatch.dl
import examples/bim-slice/bim_spaces.dl
import examples/bim-slice/bim_file.dl

function check bim curve {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print label as a line
            @intrinsic("call", "libc", "exit", nothing, 1)

function a bim curve point at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y}:
    execute:
        return a cad vector2 with x x and y y

function the bim curve text of {a 64 bit floating-point number:value}:
    execute:
        set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, value * 10000.0)
        return the string form of (scaled / 10000.0)

function the bim geometry of {a 64 bit integer:elementId} in {bim evaluation record:evaluation}:
    execute:
        set chosen to 0
        loop cursor from 0 to the length of (evaluation's elements's values):
            if (the item at cursor in (evaluation's elements's values))'s id = elementId:
                set chosen to cursor
        return the item at chosen in (evaluation's elements's values)

set modelValue to an empty bim model
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to (the address of modelValue)
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.12)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.1)) to layerValues
set cavity to add bim wall type named (the string form of "Cavity wall") with layerValues to (the address of modelValue)
free layerValues

# A free arc wall: chord 6, bulge 1.5, so radius 3.75 and sweep 4 atan(0.5).
set free to add bim wall typed cavity on storey from (a bim curve point at 0.0 and 10.0) to (a bim curve point at 6.0 and 10.0) to (the address of modelValue)
check bim curve (bend bim wall free by 1.5 in (the address of modelValue)) named "bend refused"
set freeValue to the item at (the bim wall index of free in modelValue)'s position in (modelValue's walls's values)
set arc to the bim arc of freeValue
print (((the string form of "radius ") + (the bim curve text of arc's radius)) + ((the string form of " sweep ") + (the bim curve text of arc's sweep))) as a line
set middle to the bim middle of wall freeValue
print (((the string form of "middle ") + (the bim curve text of middle's x)) + ((the string form of " ") + (the bim curve text of middle's y))) as a line
print ((the string form of "length ") + (the bim curve text of (the bim centreline length of freeValue))) as a line
set evaluation to the bim evaluation of modelValue after (an empty bim evaluation)
set geometry to the bim geometry of free in evaluation
check bim curve (geometry's status = 0) named "free arc wall did not evaluate"
check bim curve geometry's fast named "free arc wall not built by the fast kernel"
check bim curve ((the fast flaw of geometry's shape within 1e-9) = 0) named "free arc wall is not a closed polyhedron"
set exact to (arc's sweep * arc's radius) * (0.32 * 3.0)
set built to the bim volume of geometry
set error to (the absolute value of (built - exact)) / exact
print (((the string form of "free volume ") + (the bim curve text of built)) + ((the string form of " exact ") + (the bim curve text of exact))) as a line
check bim curve (error < 0.0005) named "free arc volume off by more than 0.05 %"
set footprint to the bim footprint of freeValue in modelValue
set outline to the bim outline of freeValue with footprint wide 0.32
print ((the string form of "outline corners ") + (the string form of (the length of outline))) as a line
free outline

# A room closed on the south by an arc bulging outward, joined at both ends.
set south to add bim wall typed cavity on storey from (a bim curve point at 0.0 and 0.0) to (a bim curve point at 6.0 and 0.0) to (the address of modelValue)
set east to add bim wall typed cavity on storey from (a bim curve point at 6.0 and 0.0) to (a bim curve point at 6.0 and 4.0) to (the address of modelValue)
set north to add bim wall typed cavity on storey from (a bim curve point at 6.0 and 4.0) to (a bim curve point at 0.0 and 4.0) to (the address of modelValue)
set west to add bim wall typed cavity on storey from (a bim curve point at 0.0 and 4.0) to (a bim curve point at 0.0 and 0.0) to (the address of modelValue)
check bim curve (bend bim wall south by 1.0 in (the address of modelValue)) named "south bend refused"
set evaluation to the bim evaluation of modelValue after evaluation
set total to 0.0
loop cursor from 0 to the length of (evaluation's elements's values):
    set element to the item at cursor in (evaluation's elements's values)
    check bim curve (element's status = 0) named "a room wall did not evaluate"
    set total to total + (the bim volume of element)
print ((the string form of "room walls volume ") + (the bim curve text of total)) as a line
set southValue to the item at (the bim wall index of south in modelValue)'s position in (modelValue's walls's values)
set southFootprint to the bim footprint of southValue in modelValue
print (((the string form of "south start exterior ") + (the bim curve text of southFootprint's startExterior's x)) + ((the string form of " ") + (the bim curve text of southFootprint's startExterior's y))) as a line
print (((the string form of "south finish interior ") + (the bim curve text of southFootprint's finishInterior's x)) + ((the string form of " ") + (the bim curve text of southFootprint's finishInterior's y))) as a line
set wholeSouth to the bim volume of (the bim geometry of south in evaluation)

# A window in the middle of the arc is cut by the port's booleans.
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to (the address of modelValue)
set window to add bim opening typed windowType in south at ((the bim centreline length of southValue) * 0.5) to (the address of modelValue)
check bim curve (window > 0) named "window refused"
set evaluation to the bim evaluation of modelValue after evaluation
set voided to the bim geometry of south in evaluation
check bim curve (voided's status = 0) named "arc wall with a window did not evaluate"
check bim curve voided's fast named "arc wall with a window not built by the fast kernel"
check bim curve ((the fast flaw of voided's shape within 1e-9) = 0) named "arc wall with a window is not a closed polyhedron"
set removed to wholeSouth - (the bim volume of voided)
set openingType to the item at (the bim opening type index of windowType in modelValue)'s position in (modelValue's openingTypes's values)
set radialExact to ((the bim rough width of openingType) * 0.32) * (the bim rough height of openingType)
print (((the string form of "window removed ") + (the bim curve text of removed)) + ((the string form of " radial exact ") + (the bim curve text of radialExact))) as a line
check bim curve (((the absolute value of (removed - radialExact)) / radialExact) < 0.001) named "radial window void off by more than 0.1 %"

# The arc wall's layers as solids (the fine 3D detail level): three closed
# polyhedra that together make up the wall with its window.
set layers to the bim layer solids of southValue in modelValue using (the bim join index of modelValue)
check bim curve ((the length of (layers's values)) = 3) named "three layer solids"
set layerTotal to 0.0
loop cursor from 0 to the length of (layers's values):
    set layer to the item at cursor in (layers's values)
    check bim curve ((the fast flaw of layer's shape within 1e-9) = 0) named "a layer is not a closed polyhedron"
    set layerTotal to layerTotal + (the fast volume of layer's shape)
print (((the string form of "layers ") + (the bim curve text of layerTotal)) + ((the string form of " wall ") + (the bim curve text of (the bim volume of voided)))) as a line
check bim curve (((the absolute value of (layerTotal - (the bim volume of voided))) / layerTotal) < 0.001) named "layers do not make up the wall"

# The bulge is kept to a half circle; 0 makes the wall straight again.
check bim curve (bend bim wall free by 10.0 in (the address of modelValue)) named "large bend refused"
set freeValue to the item at (the bim wall index of free in modelValue)'s position in (modelValue's walls's values)
print ((the string form of "kept bulge ") + (the bim curve text of freeValue's bulge)) as a line

# The file keeps the bulge exactly.
set text to the bim file text of modelValue
set parsed to the bim model parsed from text
check bim curve parsed's valid named "curved model did not read back"
set reread to the item at (the bim wall index of south in parsed's modelValue)'s position in (parsed's modelValue's walls's values)
check bim curve (reread's bulge = southValue's bulge) named "bulge changed in the file"
print ((the string form of "file round trip bulge ") + (the bim curve text of reread's bulge)) as a line

# The room's space reaches into the arc.
set found to the bim spaces of modelValue on level storey using (the bim join index of modelValue)
print ((the string form of "spaces ") + (the string form of (the length of (found's values)))) as a line
loop cursor from 0 to the length of (found's values):
    set space to the item at cursor in (found's values)
    print ((the string form of "  area ") + (the bim curve text of space's area)) as a line

# The arc's layers in plan: one band per layer per wedge of the arc.
set bands to the bim plan hatch bands of southValue in modelValue
set southArc to the bim arc of southValue
set pieces to the bim pieces of southArc reaching 0.16
print (((the string form of "bands ") + (the string form of (the length of (bands's values)))) + ((the string form of " pieces ") + (the string form of pieces))) as a line
check bim curve ((the length of (bands's values)) = (pieces * 3)) named "band count"
