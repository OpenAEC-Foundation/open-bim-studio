# SPDX-License-Identifier: MPL-2.0
# Tests the exact editor action used by Props/MCP without the full UI.
import examples/bim-slice/bim_editor_window_placement.dl
function check window editor {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line
set editor to a new bim editor
set editor's lengthUnit to bim millimetre unit
set target to the address of (editor's documentValue's current)
set wallId to add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set openingId to add bim opening typed editor's openingTypeId in wallId at 3.0 to target
set systemId to ensure bim window system in opening openingId typed 34 with joint (10 as a 64 bit integer) in target
set editor's selectionKind to bim curtain picked
set editor's selectionId to systemId
set initialUndo to the length of (editor's documentValue's undoStack's values)
set editor's propertyText to the string form of "25"
check window editor (apply bim editor window placement property (bim window gap property) in (the address of editor)) named (the string form of "placement action handles the GUI property code")
check window editor (((the absolute value of ((the bim installation gap of window systemId in editor's documentValue's current) - 0.025)) < 0.000001) and ((the length of (editor's documentValue's undoStack's values)) = (initialUndo + 1))) named (the string form of "millimetre input commits one undoable edit")
ignore undo bim transaction in (the address of (editor's documentValue))
check window editor ((the absolute value of ((the bim installation gap of window systemId in editor's documentValue's current) - 0.01)) < 0.000001) named (the string form of "undo restores the original clearance")
set beforeRevision to editor's documentValue's revision
set beforeRedo to the length of (editor's documentValue's redoStack's values)
set editor's propertyText to the string form of "10000"
ignore apply bim editor window placement property (bim window gap property) in (the address of editor)
check window editor ((editor's documentValue's revision = beforeRevision) and ((the length of (editor's documentValue's redoStack's values)) = beforeRedo)) named (the string form of "refused placement preserves redo and revision")
check window editor (redo bim transaction in (the address of (editor's documentValue))) named (the string form of "redo remains available after a refused value")
set beforeRevision to editor's documentValue's revision
set beforeUndo to the length of (editor's documentValue's undoStack's values)
set editor's propertyText to the string form of "25"
ignore apply bim editor window placement property (bim window gap property) in (the address of editor)
check window editor ((editor's documentValue's revision = beforeRevision) and ((the length of (editor's documentValue's undoStack's values)) = beforeUndo)) named (the string form of "unchanged input creates no undo step")
set editor's propertyText to the string form of "not-a-number"
ignore apply bim editor window placement property (bim window gap property) in (the address of editor)
set editor's propertyText to the string form of "-1"
ignore apply bim editor window placement property (bim window gap property) in (the address of editor)
set editor's propertyText to the string form of "1e300"
ignore apply bim editor window placement property (bim window depth property) in (the address of editor)
check window editor ((editor's documentValue's revision = beforeRevision) and ((the length of (editor's documentValue's undoStack's values)) = beforeUndo)) named (the string form of "malformed negative and overflowing values are refused without undo")
set editor's lengthUnit to bim metre unit
set editor's propertyText to the string form of "0.05"
ignore apply bim editor window placement property (bim window depth property) in (the address of editor)
check window editor ((the bim setting (bim host depth setting) of systemId in editor's documentValue's current)'s value = (50 as a 64 bit integer)) named (the string form of "depth input follows the project length unit")
set beforeUndo to the length of (editor's documentValue's undoStack's values)
check window editor (start bim editor window host property (bim window host property) in (the address of editor)) named (the string form of "host action is available from system properties")
check window editor (((editor's selectionKind = bim opening picked) and (editor's selectionId = openingId)) and ((the length of (editor's documentValue's undoStack's values)) = beforeUndo)) named (the string form of "host navigation selects the opening without editing the model")
set beforeRevision to editor's documentValue's revision
set editor's propertyText to the string form of "0.02"
ignore apply bim editor window placement property (bim window gap property) in (the address of editor)
check window editor (editor's documentValue's revision = beforeRevision) named (the string form of "wrong selection cannot receive a placement edit")
check window editor (((apply bim editor window placement property 999 in (the address of editor)) = false) and ((start bim editor window host property 999 in (the address of editor)) = false)) named (the string form of "unrelated property codes fall through to the normal editor")
