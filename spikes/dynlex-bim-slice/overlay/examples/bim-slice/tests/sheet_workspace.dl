import examples/bim-slice/bim_sheet_workspace.dl
import examples/bim-slice/bim_file.dl

function check sheet workspace {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set camera to a new bim sheet camera
set pointerValue to a cad vector2 with x 600.0 and y 400.0
set before to the bim unprojected sheet pixel pointerValue through camera
set camera to the bim sheet camera camera zoomed by 2.0 at pointerValue
set after to the bim unprojected sheet pixel pointerValue through camera
check sheet workspace ((the cad distance from before to after) < 1e-9) named (the string form of "zoom stays anchored under pointer")
set camera's pan to a cad vector2 with x (camera's pan's x + 40.0) and y (camera's pan's y - 20.0)
set moved to the bim unprojected sheet pixel (a cad vector2 with x 640.0 and y 380.0) through camera
check sheet workspace ((the cad distance from before to moved) < 1e-9) named (the string form of "pan uses the same inverse transform")
set modelValue to an empty bim model
set target to the address of modelValue
set levelId to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set viewId to add bim view of kind bim plan view named (the string form of "Plan") on levelId to target
set sheetId to add bim sheet numbered (the string form of "A101") named (the string form of "Plans") on paper 3 landscape true to target
ignore (place bim view viewId on sheet sheetId at (a cad vector2 with x 100.0 and y 120.0) looking at (a cad vector2 with x 5.0 and y 6.0) in target)
check sheet workspace (set bim viewport 0 on sheet sheetId title type to 1 in target) named (the string form of "viewport title type assigned")
check sheet workspace (copy bim viewport 0 on sheet sheetId to (a cad vector2 with x 250.0 and y 120.0) in target) named (the string form of "viewport copied as a placement of the same model view")
check sheet workspace ((the bim viewport title type of 1 on sheetId in modelValue) = 1) named (the string form of "copy preserves viewport title type")
ignore (set bim viewport 0 on sheet sheetId title type to 2 in target)
ignore (remove bim viewport 0 on sheet sheetId in target)
check sheet workspace ((the bim viewport title type of 0 on sheetId in modelValue) = 1) named (the string form of "delete keeps following viewport metadata attached")
check sheet workspace ((the bim viewport title type of 1 on sheetId in modelValue) = 0) named (the string form of "delete clears obsolete title metadata")
set encoded to the bim file text of modelValue
set reread to the bim model parsed from encoded
check sheet workspace (reread's valid and ((the bim viewport title type of 0 on sheetId in reread's modelValue) = 1)) named (the string form of "viewport types survive native roundtrip")
check sheet workspace ((set bim viewport 0 on sheet sheetId title type to 8 in target) = false) named (the string form of "invalid title type refused")
ignore (set bim viewport 0 on sheet sheetId title type to 0 in target)
check sheet workspace (the bim setting 2400600 of sheetId in modelValue)'s found named (the string form of "explicit title overrides custom-frame default")
ignore (copy bim viewport 0 on sheet sheetId to (a cad vector2 with x 350.0 and y 120.0) in target)
check sheet workspace (the bim setting 2400601 of sheetId in modelValue)'s found named (the string form of "copy keeps an explicit default title type")
ignore (remove bim viewport 0 on sheet sheetId in target)
check sheet workspace (the bim setting 2400600 of sheetId in modelValue)'s found named (the string form of "delete preserves an explicit default title type")
