# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/bim_roof_offset.dl
function check roof offset {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line
set profilePoints to an empty list of a cad vector2
append (a cad vector2 with x -2.0 and y 0.0) to profilePoints
append (a cad vector2 with x 0.0 and y 2.0) to profilePoints
append (a cad vector2 with x 2.0 and y 0.0) to profilePoints
set shifted to the bim parallel roof profile of profilePoints offset -0.2
check roof offset ((the length of shifted) = 3) named (the string form of "offset retains the profile sampling contract")
check roof offset ((the absolute value of ((the item at 1 in shifted)'s y - (2.0 - (0.2 * (the square root of 2.0))))) < 0.000001) named (the string form of "sharp ridge uses the analytical parallel-line miter")
set first to the item at 0 in shifted
check roof offset ((the absolute value of ((the cad distance from first to (the item at 0 in profilePoints)) - 0.2)) < 0.000001) named (the string form of "eave endpoint moves by the normal thickness")
set unchanged to the bim parallel roof profile of profilePoints offset 0.0
check roof offset (((the item at 0 in unchanged)'s x = -2.0) and ((the item at 1 in unchanged)'s y = 2.0)) named (the string form of "zero offset preserves the outer roof")
set invisible to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 1e30) to invisible
append (a cad vector2 with x 6.0 and y 1e30) to invisible
set flat to the bim parallel roof profile of invisible offset -0.35
check roof offset (((the length of flat) = 2) and ((the item at 1 in flat)'s x = 6.0)) named (the string form of "unlimited hip retains the full extrusion path")
replace item at index 1 in profilePoints with (a cad vector2 with x 0.0 and y -2.0)
set refused to the bim parallel roof profile of profilePoints offset -0.2
check roof offset ((the length of refused) = 0) named (the string form of "non-convex roof sections choose the general geometry path")
