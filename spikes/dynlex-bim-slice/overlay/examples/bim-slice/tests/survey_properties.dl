# SPDX-License-Identifier: MPL-2.0
# Own type for an opening (command 2208) and property sets edited in the
# properties window. The selected opening takes a copy of its type, the
# other opening of that type keeps it, and the copy's size changes apart
# from the original's. A property set's rows carry codes; a new property is
# typed as "Set.Name=value" (OBS_Survey.Mark=K), a value is retyped in its
# own type (text, Yes/No, a length in the project's unit), one undo takes an
# edit back, a level takes properties too, and with nothing selected a typed
# property goes nowhere.
import examples/bim-slice/bim_ui.dl
import examples/bim-slice/bim_editor.dl

function check survey {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function type survey keys {a string:keys} in {a pointer to a bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of keys:
            type bim editor key ((the character at cursor in keys) as an integer) in editor
        type bim editor key bim enter key code in editor

# The type of opening `openingId` in `modelValue`.
function the survey type of opening {a 64 bit integer:openingId} in {bim model record:modelValue}:
    execute:
        set found to the bim opening index of openingId in modelValue
        return (the item at found's position in (modelValue's openings's values))'s typeId

# Opening type `typeId` of `modelValue`.
function the survey opening type {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        set found to the bim opening type index of typeId in modelValue
        return the item at found's position in (modelValue's openingTypes's values)

# The code of the property row labelled `label` in the window, or -1.
function the survey row code of {a string:label} in {a pointer to a bim editor record:editor}:
    execute:
        set propertyRows to the bim property rows of (@intrinsic("dereference", editor))
        set found to -1
        loop cursor from 0 to the length of propertyRows:
            set propertyRow to the item at cursor in propertyRows
            if propertyRow's label = label:
                set found to propertyRow's code
        free propertyRows
        return found

# What the window shows for the property row labelled `label`, or "".
function the survey row value of {a string:label} in {a pointer to a bim editor record:editor}:
    execute:
        set propertyRows to the bim property rows of (@intrinsic("dereference", editor))
        set found to the string form of ""
        loop cursor from 0 to the length of propertyRows:
            set propertyRow to the item at cursor in propertyRows
            if propertyRow's label = label:
                set found to propertyRow's value
        free propertyRows
        return found

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set host to add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set firstHole to add bim opening typed (editor's windowTypeId) in host at 2.0 to target
set secondHole to add bim opening typed (editor's windowTypeId) in host at 4.0 to target
commit bim transaction in (the address of (editor's documentValue))
set sharedType to the survey type of opening firstHole in editor's documentValue's current
set typesBefore to the length of (editor's documentValue's current's openingTypes's values)

# The button is in the ribbon.
set foundButton to false
set ribbonGroups to the bim ribbon groups of tab 0
loop groupCursor from 0 to the length of ribbonGroups:
    set ribbonGroup to the item at groupCursor in ribbonGroups
    loop buttonCursor from 0 to the length of (ribbonGroup's buttons):
        if (the item at buttonCursor in (ribbonGroup's buttons))'s command = 2208:
            set foundButton to true
check survey foundButton named (the string form of "the ribbon has an Own type button for openings")

# Own type: nothing selected, then the first opening.
type bim editor key 2208 in e
check survey (((the length of (editor's documentValue's current's openingTypes's values)) = typesBefore) and (editor's message = (the string form of "Own type: select an opening first"))) named (the string form of "no opening selected: no type made")
select bim editor bim opening picked numbered firstHole in e
type bim editor key 2208 in e
set ownType to the survey type of opening firstHole in editor's documentValue's current
check survey ((ownType != sharedType) and ((the length of (editor's documentValue's current's openingTypes's values)) = (typesBefore + 1))) named (the string form of "the selected opening has a new type")
check survey ((the survey type of opening secondHole in editor's documentValue's current) = sharedType) named (the string form of "the other opening keeps the old type")
set copied to the survey opening type ownType in editor's documentValue's current
set original to the survey opening type sharedType in editor's documentValue's current
check survey (((copied's width = original's width) and (copied's height = original's height)) and ((copied's sill = original's sill) and (copied's name != original's name))) named (the string form of "the copy has the same size and a name of its own")
begin bim transaction in (the address of (editor's documentValue))
ignore set bim opening type ownType sized 0.9 by 1.2 with sill 1.0 in target
commit bim transaction in (the address of (editor's documentValue))
check survey (((the survey opening type sharedType in editor's documentValue's current)'s width = original's width) and ((the survey opening type ownType in editor's documentValue's current)'s width = 0.9)) named (the string form of "the copy's size changes apart from the original's")
ignore undo bim transaction in (the address of (editor's documentValue))
ignore undo bim transaction in (the address of (editor's documentValue))
check survey (((the survey type of opening firstHole in editor's documentValue's current) = sharedType) and ((the length of (editor's documentValue's current's openingTypes's values)) = typesBefore)) named (the string form of "undo takes the own type back")

# A new property, typed as Set.Name=value.
select bim editor bim opening picked numbered firstHole in e
check survey ((the survey row code of (the string form of "New property (click)") in e) = bim new pset property) named (the string form of "the window offers a new property row")
start bim editor property (bim new pset property) in e
type survey keys (the string form of "OBS_Survey.Mark=K") in e
check survey (((the bim property value (the string form of "Mark") of set (the string form of "OBS_Survey") of firstHole in editor's documentValue's current) = (the string form of "K")) and (editor's message = (the string form of "OBS_Survey.Mark = K"))) named (the string form of "OBS_Survey.Mark=K makes the property")
check survey (((the survey row code of (the string form of "Mark") in e) = bim pset property base) and ((the survey row value of (the string form of "Mark") in e) = (the string form of "K"))) named (the string form of "the property's row shows it with its code")
start bim editor property (bim pset property base) in e
type survey keys (the string form of "K1") in e
check survey ((the bim property value (the string form of "Mark") of set (the string form of "OBS_Survey") of firstHole in editor's documentValue's current) = (the string form of "K1")) named (the string form of "retyping the row changes the value")
start bim editor property (bim new pset property) in e
type survey keys (the string form of "OBS_Survey.Status = UNVERIFIED HEIGHT") in e
check survey (((the bim property value (the string form of "Status") of set (the string form of "OBS_Survey") of firstHole in editor's documentValue's current) = (the string form of "UNVERIFIED HEIGHT")) and ((the survey row code of (the string form of "Status") in e) = ((bim pset property base) + 1))) named (the string form of "a value with spaces is kept, trimmed at its ends")
start bim editor property (bim new pset property) in e
type survey keys (the string form of "Fixed=later") in e
check survey ((the bim property value (the string form of "Fixed") of set (the string form of "OBS_Properties") of firstHole in editor's documentValue's current) = (the string form of "later")) named (the string form of "a name without a set goes to OBS_Properties")
ignore undo bim transaction in (the address of (editor's documentValue))
check survey (((the bim property value (the string form of "Fixed") of set (the string form of "OBS_Properties") of firstHole in editor's documentValue's current) = (the string form of "")) and ((the bim property value (the string form of "Status") of set (the string form of "OBS_Survey") of firstHole in editor's documentValue's current) = (the string form of "UNVERIFIED HEIGHT"))) named (the string form of "one undo takes one property back")

# A boolean and a length are typed in their own form.
begin bim transaction in (the address of (editor's documentValue))
set bim property (the string form of "Verified") of set (the string form of "OBS_Survey") of firstHole to (the string form of ".F.") typed (the string form of "IFCBOOLEAN") in target
set bim property (the string form of "Clear") of set (the string form of "OBS_Survey") of firstHole to (the string form of "1.2") typed (the string form of "IFCLENGTHMEASURE") in target
commit bim transaction in (the address of (editor's documentValue))
check survey ((the survey row value of (the string form of "Verified") in e) = (the string form of "No")) named (the string form of "a boolean shows as No")
start bim editor property (the survey row code of (the string form of "Verified") in e) in e
type survey keys (the string form of "Yes") in e
check survey (((the bim property value (the string form of "Verified") of set (the string form of "OBS_Survey") of firstHole in editor's documentValue's current) = (the string form of ".T.")) and ((the survey row value of (the string form of "Verified") in e) = (the string form of "Yes"))) named (the string form of "Yes stores .T.")
start bim editor property (the survey row code of (the string form of "Clear") in e) in e
type survey keys (the string form of "0.9") in e
check survey ((the absolute value of ((the bim numeric value of (the bim property value (the string form of "Clear") of set (the string form of "OBS_Survey") of firstHole in editor's documentValue's current)) - 0.9)) < 1e-6) named (the string form of "a length is stored in metres")

# A level takes properties too; nothing selected takes none.
select bim editor bim level picked numbered editor's levelId in e
start bim editor property (bim new pset property) in e
type survey keys (the string form of "OBS_Survey.Source=BP-22") in e
check survey ((the bim property value (the string form of "Source") of set (the string form of "OBS_Survey") of editor's levelId in editor's documentValue's current) = (the string form of "BP-22")) named (the string form of "a level takes a property")
set propertiesBefore to the length of (editor's documentValue's current's properties's values)
select bim editor bim nothing picked numbered (the bim refused id) in e
start bim editor property (bim new pset property) in e
type survey keys (the string form of "OBS_Survey.Mark=X") in e
check survey (((the length of (editor's documentValue's current's properties's values)) = propertiesBefore) and (editor's message = (the string form of "Properties: select an element first"))) named (the string form of "nothing selected: no property made")
