# SPDX-License-Identifier: MPL-2.0
# A wall's foot off its level and TR (Trim/Extend to Corner). The Base offset
# property raises a wall's foot, keeping its height measured from the foot;
# the offset survives the file and IfcX. TR then joins two walls that stop
# short of each other at their corner, and trims two that cross, keeping the
# parts clicked.
import examples/bim-slice/bim_editor.dl
import examples/bim-slice/bim_ifcx.dl
import examples/bim-slice/bim_ifcx_read.dl

function click bim base test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        refresh bim editor editor
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function list bim wall bases of {bim model record:modelValue} labelled {a string:label}:
    execute:
        loop cursor from 0 to the length of (modelValue's walls's values):
            set wallValue to the item at cursor in (modelValue's walls's values)
            print ((label + (the string form of ": wall ")) + ((the string form of wallValue's id) + ((the string form of " base ") + ((the bim length wallValue's baseOffset in units 0) + ((the string form of " height ") + (the bim length wallValue's height in units 0)))))) as a line

function list bim wall ends of {bim model record:modelValue} labelled {a string:label}:
    execute:
        print label as a line
        loop cursor from 0 to the length of (modelValue's walls's values):
            set wallValue to the item at cursor in (modelValue's walls's values)
            print ((the string form of "  ") + ((the bim length wallValue's start's x in units 0) + ((the string form of ",") + ((the bim length wallValue's start's y in units 0) + ((the string form of " -> ") + ((the bim length wallValue's finish's x in units 0) + ((the string form of ",") + (the bim length wallValue's finish's y in units 0)))))))) as a line

set editor to a new bim editor
set e to the address of editor
type bim editor key 87 in e
click bim base test at 0.0 and 0.0 in e
click bim base test at 5.0 and 0.0 in e
type bim editor key bim escape key code in e
type bim editor key bim escape key code in e
type bim editor key 83 in e
click bim base test at 2.5 and 0.0 in e
start bim editor property bim wall base property in e
loop cursor from 0 to 3:
    type bim editor key ((the character at cursor in "0.5") as an integer) in e
type bim editor key bim enter key code in e
print editor's message as a line
list bim wall bases of editor's documentValue's current labelled (the string form of "raised")
set reread to the bim model parsed from (the bim file text of editor's documentValue's current)
print ((the string form of ".bim read: ") + (the string form of reread's valid)) as a line
list bim wall bases of reread's modelValue labelled (the string form of "from .bim")
set exported to the bim ifcx text of editor's documentValue's current identified as (the string form of "b.ifcx") for project (the string form of "b") by (the string form of "test") at (the string form of "2026-10-12T00:00:00Z")
set native to the bim native text of ifcx exported
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + (the string form of fromIfcx's valid)) as a line
list bim wall bases of fromIfcx's modelValue labelled (the string form of "from .ifcx")
# A second wall stopping short of the first's end: TR on both extends the
# second and the first meets it at the corner.
type bim editor key 87 in e
click bim base test at 6.0 and 1.0 in e
click bim base test at 6.0 and 4.0 in e
type bim editor key bim escape key code in e
type bim editor key bim escape key code in e
print ((the string form of "TR is trim to corner: ") + (the string form of ((the bim two letter command of 84 then 82) = 2012))) as a line
type bim editor key 2012 in e
click bim base test at 2.0 and 0.0 in e
print editor's message as a line
click bim base test at 6.0 and 3.0 in e
print editor's message as a line
list bim wall ends of editor's documentValue's current labelled (the string form of "cornered")
# A third wall crossing the first: TR trims both to the corner, keeping the
# parts clicked.
type bim editor key bim escape key code in e
type bim editor key 87 in e
click bim base test at 3.0 and -2.0 in e
click bim base test at 3.0 and 2.0 in e
type bim editor key bim escape key code in e
type bim editor key bim escape key code in e
type bim editor key 2012 in e
click bim base test at 1.0 and 0.0 in e
click bim base test at 3.0 and 1.5 in e
print editor's message as a line
list bim wall ends of editor's documentValue's current labelled (the string form of "crossing trimmed")
