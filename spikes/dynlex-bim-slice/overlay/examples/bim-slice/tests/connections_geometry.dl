# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/bim_connection_geometry.dl

function check perforation test {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set vertices to an empty list of a cad vector3
append (a cad vector3 with x 0.0, y 0.0 and z 0.0) to vertices
append (a cad vector3 with x 1.0, y 0.0 and z 0.0) to vertices
append (a cad vector3 with x 1.0, y 1.0 and z 0.0) to vertices
append (a cad vector3 with x 0.0, y 1.0 and z 0.0) to vertices
append (a cad vector3 with x 0.0, y 0.0 and z 1.0) to vertices
append (a cad vector3 with x 1.0, y 0.0 and z 1.0) to vertices
append (a cad vector3 with x 1.0, y 1.0 and z 1.0) to vertices
append (a cad vector3 with x 0.0, y 1.0 and z 1.0) to vertices
set stockValue to the connection stock from vertices
free vertices
check perforation test stockValue's valid named (the string form of "closed stock solid")
set cutters to an empty list of a connection void
loop rowIndex from 0 to 2:
    loop columnIndex from 0 to 2:
        set spotValue to a cad vector3 with x (0.25 + ((columnIndex as a 64 bit floating-point number) * 0.5)), y -0.01 and z (0.25 + ((rowIndex as a 64 bit floating-point number) * 0.5))
        append (@intrinsic("construct", a connection void, 1 as a 64 bit integer, 1, spotValue, (a cad vector3 with x 0.0, y 1.0 and z 0.0), 0.1, 0.51, 1)) to cutters
set drilled to the connection stock stockValue's value perforated by cutters
check perforation test (drilled's status = 0) named (the string form of "four blind cylindrical holes")
set triangulated to the cad mesh of drilled's solid with maximum angle 0.05 within 0.00001
set measured to the cad mass properties of triangulated
set expectedVolume to 1.0 - ((4.0 * (3.0 * 0.0025)) * 0.50001)
check perforation test (measured's valid and ((the absolute value of (measured's value's volume - expectedVolume)) < 0.00005)) named (the string form of "blind holes match polygonal cutter volume")
free cutters

# A square hollow member must not turn into a solid block when drilled.
set cavityVertices to an empty list of a cad vector3
loop endIndex from 0 to 2:
    set elevation to -0.01 + (1.02 * (endIndex as a 64 bit floating-point number))
    append (a cad vector3 with x 0.2, y 0.2 and z elevation) to cavityVertices
    append (a cad vector3 with x 0.8, y 0.2 and z elevation) to cavityVertices
    append (a cad vector3 with x 0.8, y 0.8 and z elevation) to cavityVertices
    append (a cad vector3 with x 0.2, y 0.8 and z elevation) to cavityVertices
set cavities to an empty list of the type of (an empty list of a cad vector3)
append cavityVertices to cavities
set hollowed to the connection stock stockValue's value hollowed by cavities
check perforation test (hollowed's status = 0) named (the string form of "original hollow section cavity retained")
set cutters to an empty list of a connection void
append (@intrinsic("construct", a connection void, 1 as a 64 bit integer, 1, (a cad vector3 with x -0.01, y 0.5 and z 0.5), (a cad vector3 with x 1.0, y 0.0 and z 0.0), 0.1, 1.02, 1)) to cutters
set drilled to the connection stock hollowed's solid perforated by cutters
check perforation test (drilled's status = 0) named (the string form of "hole passes through both hollow-section walls")
set triangulated to the cad mesh of drilled's solid with maximum angle 0.05 within 0.00001
set measured to the cad mass properties of triangulated
check perforation test (measured's valid and ((the absolute value of (measured's value's volume - 0.637)) < 0.00001)) named (the string form of "hollow stock and drilled wall volumes agree")
free cavityVertices
free cavities
free cutters
