# Exercise the actual drilled display solids, beyond recipe validity.
import examples/bim-slice/bim_demo_steel_hall.dl
import examples/bim-slice/bim_scene.dl

set hallModel to the bim demo steel hall
set scene to the bim sketch meshes of hallModel within 0.0078125
set nodeCount to 0
set memberCount to 0
loop cursor from 0 to the length of (scene's values):
    set entry to the item at cursor in (scene's values)
    if (the length of (entry's shape's triangles's values)) > 0:
        if (the bim connection index of entry's elementId in hallModel)'s valid:
            set nodeCount to nodeCount + 1
        if (the bim linear index of entry's elementId in hallModel)'s valid:
            set memberCount to memberCount + 1
if ((nodeCount = 60) and (memberCount = 32)) = false:
    print (((the string form of "FAIL: nonempty solids ") + (the string form of nodeCount)) + ((the string form of " nodes, members ") + (the string form of memberCount))) as a line
    @intrinsic("call", "libc", "exit", nothing, 1)
print "PASS: all 60 connection bodies and 32 steel members mesh" as a line
