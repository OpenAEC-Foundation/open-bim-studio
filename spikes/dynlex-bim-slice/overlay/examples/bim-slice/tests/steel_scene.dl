# SPDX-License-Identifier: MPL-2.0
# Exercise the actual drilled display solids, beyond recipe validity.
import examples/bim-slice/bim_demo_steel_hall.dl
import examples/bim-slice/bim_scene.dl
import examples/bim-slice/bim_file.dl

set hallModel to the bim demo steel hall
set members to the bim linear parts of hallModel
set cuts to the bim end cuts of parts (members's values) in hallModel
loop cursor from 0 to the length of (hallModel's linears's values):
    set element to the item at cursor in (hallModel's linears's values)
    set kind to the bim type of linear element in hallModel
    set holes to the bim connection perforations of element's id in hallModel
    if (the length of (holes's values)) > 0:
        set corners to the bim round corners for radius (kind's width * 0.5) within 0.0078125
        set checked to the bim drilled sweep of element typed kind in hallModel using (holes's values) at corners round corners cut by (the item at cursor in (cuts's values))
        if checked's valid = false:
            print ((the string form of "FAIL: unsupported bored hall member ") + ((the string form of element's id) + ((the string form of " reason ") + (the string form of checked's reason)))) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        if (the fast mesh flaw of checked's shape) != 0:
            print ((the string form of "FAIL: nonclosed bored hall member ") + (the string form of element's id)) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
print "PASS: all bored hall members use watertight direct meshes" as a line
set scene to the bim sketch meshes of hallModel within 0.0078125
set nodeCount to 0
set memberCount to 0
loop cursor from 0 to the length of (scene's values):
    set entry to the item at cursor in (scene's values)
    if (the length of (entry's shape's triangles's values)) > 0:
        if (the bim connection index of entry's elementId in hallModel)'s valid:
            set nodeCount to nodeCount + 1
        if (the bim linear index of entry's elementId in hallModel)'s valid:
            set memberCount to memberCount + 1
if ((nodeCount = 60) and (memberCount = 32)) = false:
    print (((the string form of "FAIL: nonempty solids ") + (the string form of nodeCount)) + ((the string form of " nodes, members ") + (the string form of memberCount))) as a line
    @intrinsic("call", "libc", "exit", nothing, 1)
print "PASS: all 60 connection bodies and 32 steel members mesh" as a line
set nativeText to the bim file text of hallModel
set parsed to the bim model parsed from nativeText
if parsed's valid = false:
    @intrinsic("call", "libc", "exit", nothing, 1)
if (the bim file text of parsed's modelValue) != nativeText:
    @intrinsic("call", "libc", "exit", nothing, 1)
if (write bim text nativeText to file (the string form of "steel-connection-hall.bim")) = false:
    @intrinsic("call", "libc", "exit", nothing, 1)
print "PASS: meshed hall persists exactly and is written" as a line
