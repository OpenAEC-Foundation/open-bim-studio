# SPDX-License-Identifier: MPL-2.0
# Pure DXF parsing, block expansion, unit handling and native persistence.
import examples/bim-slice/bim_dxf_reference.dl

function check dxf reference {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set source to (the string form of "0\nSECTION\n2\nHEADER\n9\n$INSUNITS\n70\n4\n9\n$DWGCODEPAGE\n3\nANSI_1252\n0\nENDSEC\n0\nSECTION\n2\nBLOCKS\n0\nBLOCK\n2\nB\n10\n100\n20\n200\n0\nLINE\n8\n0\n5\n11\n10\n100\n20\n200\n11\n1100\n21\n200\n0\nENDBLK\n0\nBLOCK\n2\nN\n10\n0\n20\n0\n0\nINSERT\n2\nB\n10\n1000\n20\n0\n0\nENDBLK\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n0\nINSERT\n2\nB\n8\nFrames\n10\n10000\n20\n20000\n41\n2\n42\n3\n50\n90\n0\nINSERT\n2\nN\n8\nNested\n10\n0\n20\n0\n0\nINSERT\n2\nB\n8\nArray\n10\n0\n20\n0\n70\n2\n71\n2\n44\n2000\n45\n3000\n0\nLWPOLYLINE\n8\nCurve\n90\n2\n70\n0\n10\n0\n20\n0\n42\n1\n10\n2000\n20\n0\n0\nCIRCLE\n8\nCircle\n10\n0\n20\n0\n40\n1000\n0\nLINE\n67\n1\n10\n0\n20\n0\n11\n1\n21\n1\n0\nTEXT\n1\nignored\n0\nINSERT\n2\nMissing\n0\nENDSEC\n0\nEOF\n")
set reading to the bim dxf reference read from source
check dxf reference reading's valid named (the string form of "ASCII DXF with block geometry reads")
check dxf reference ((reading's units = 4) and (reading's factor = 0.001)) named (the string form of "INSUNITS millimetres become metres")
set first to the item at 0 in (reading's segments's values)
check dxf reference (((the absolute value of (first's first's x - 10.0)) < 1e-9) and ((the absolute value of (first's last's y - 22.0)) < 1e-9)) named (the string form of "INSERT base point scale and rotation compose")
check dxf reference (first's layer = (the string form of "Frames")) named (the string form of "block layer zero inherits INSERT layer")
set nested to the item at 1 in (reading's segments's values)
check dxf reference (((the absolute value of (nested's first's x - 1.0)) < 1e-9) and ((the absolute value of (nested's last's x - 2.0)) < 1e-9)) named (the string form of "nested block transforms compose")
set arrayLast to the item at 5 in (reading's segments's values)
check dxf reference (((the absolute value of (arrayLast's first's x - 2.0)) < 1e-9) and ((the absolute value of (arrayLast's first's y - 3.0)) < 1e-9)) named (the string form of "INSERT array offsets are included")
check dxf reference ((reading's paper = 1) and ((reading's unsupported = 1) and (reading's missing = 1))) named (the string form of "paperspace unsupported entities and missing blocks are reported")
check dxf reference ((the length of (reading's segments's values)) > 100) named (the string form of "polyline bulge and circle are tessellated")
set unitless to the bim dxf reference read from (source with "$INSUNITS\n70\n4" replaced by "$INSUNITS\n70\n0")
check dxf reference (unitless's valid = false) named (the string form of "unitless drawings are refused without a guess")
set malformed to the bim dxf reference read from (the string form of "invalid\nLINE\n")
check dxf reference (malformed's valid = false) named (the string form of "malformed group codes are refused")
set recursive to the bim dxf reference read from (the string form of "0\nSECTION\n2\nHEADER\n9\n$INSUNITS\n70\n4\n9\n$DWGCODEPAGE\n3\nANSI_1252\n0\nENDSEC\n0\nSECTION\n2\nBLOCKS\n0\nBLOCK\n2\nR\n0\nINSERT\n2\nR\n0\nENDBLK\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n0\nINSERT\n2\nR\n0\nENDSEC\n0\nEOF\n")
check dxf reference (recursive's valid = false) named (the string form of "recursive block cycle is bounded")
set arcSource to the string form of "0\nSECTION\n2\nHEADER\n9\n$INSUNITS\n70\n4\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n0\nARC\n10\n0\n20\n0\n40\n1000\n50\n350\n51\n10\n0\nENDSEC\n0\nEOF\n"
set arc to the bim dxf reference read from arcSource
check dxf reference arc's valid named (the string form of "ARC crossing zero degrees reads")
set arcFirst to the item at 0 in (arc's segments's values)
set arcLast to the item at ((the length of (arc's segments's values)) - 1) in (arc's segments's values)
check dxf reference ((arcFirst's first's y < 0.0) and ((arcLast's last's y > 0.0) and (arcLast's last's x > 0.98))) named (the string form of "ARC keeps the short counterclockwise sweep")
set modelValue to an empty bim model
set levelId to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to (the address of modelValue)
set instanceId to add bim dxf reference reading named (the string form of "Reference") from (the string form of "reference.dxf") on levelId to (the address of modelValue)
check dxf reference (((the length of (modelValue's instances's values)) = 1) and ((the length of (modelValue's sketches's values)) = 0)) named (the string form of "one selectable component replaces loose sketches")
set reread to the bim model parsed from (the bim file text of modelValue)
check dxf reference (reread's valid and ((the length of ((the item at 0 in (reread's modelValue's components's values))'s sketches's values)) = (the length of (reading's segments's values)))) named (the string form of "component geometry survives native roundtrip")
check dxf reference ((the bim property value (the string form of "INSUNITS") of set (the string form of "OBS_DXFReference") of instanceId in reread's modelValue) = (the string form of "4")) named (the string form of "units metadata survives native roundtrip")
set beforeId to modelValue's nextId
ignore (add bim dxf reference malformed named (the string form of "Bad") from (the string form of "bad.dxf") on levelId to (the address of modelValue))
check dxf reference (modelValue's nextId = beforeId) named (the string form of "invalid reading leaves model untouched")
check dxf reference ((the index of (the string form of "Frames") in (the bim property value (the string form of "PartLayerHandleTSV") of set (the string form of "OBS_DXFReference") of instanceId in reread's modelValue)) >= 0) named (the string form of "part layer mapping survives native roundtrip")
set documentValue to a new bim document
set baseId to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to (the address of (documentValue's current))
begin bim transaction in (the address of documentValue)
ignore (add bim dxf reference reading named (the string form of "Reference") from (the string form of "reference.dxf") on baseId to (the address of (documentValue's current)))
commit bim transaction in (the address of documentValue)
ignore undo bim transaction in (the address of documentValue)
check dxf reference (((the length of (documentValue's current's instances's values)) = 0) and ((the length of (documentValue's current's components's values)) = 0)) named (the string form of "reference import undoes atomically")
