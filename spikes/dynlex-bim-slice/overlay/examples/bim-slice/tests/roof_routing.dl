# SPDX-License-Identifier: MPL-2.0
# Ribbon dispatch reaches native plate creation before the generic fallback.
import examples/bim-slice/bim_editor.dl

function check roof route {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set before to the length of (target's slabs's values)
type bim editor key 2080 in e
check roof route (((the length of (target's slabs's values)) = before) and (editor's message = (the string form of "Select a space first"))) named (the string form of "Roof without a space requests a contour")
set corners to an empty list of a cad vector2
append (a cad vector2 with x 1.0 and y 2.0) to corners
append (a cad vector2 with x 5.0 and y 2.0) to corners
append (a cad vector2 with x 5.0 and y 5.0) to corners
append (a cad vector2 with x 1.0 and y 5.0) to corners
set spaceId to add bim space object named (the string form of "Roof footprint") numbered (the string form of "1") on editor's levelId around corners high 3.0 to target
select bim editor bim space object picked numbered spaceId in e
type bim editor key 2080 in e
check roof route (((the length of (target's slabs's values)) = (before + 1)) and (editor's selectionKind = bim slab picked)) named (the string form of "Roof ribbon creates and selects a native plate")
set roof to the item at (the bim slab index of editor's selectionId in (@intrinsic("dereference", target)))'s position in (target's slabs's values)
check roof route ((the bim role of plate roof in (@intrinsic("dereference", target))) = bim roof planar role) named (the string form of "Roof keeps its native semantic role")
check roof route (((the length of (roof's outline's values)) = 4) and ((the bim slab area of roof) = 12.0)) named (the string form of "Roof follows the selected Space footprint")
ignore undo bim transaction in (the address of (editor's documentValue))
check roof route ((the length of (target's slabs's values)) = before) named (the string form of "Roof creation is one undo")
select bim editor bim space object picked numbered spaceId in e
type bim editor key 2081 in e
check roof route (((the length of (target's slabs's values)) = (before + 1)) and (editor's selectionKind = bim slab picked)) named (the string form of "Ceiling ribbon creates and selects a native plate")
set ceiling to the item at (the bim slab index of editor's selectionId in (@intrinsic("dereference", target)))'s position in (target's slabs's values)
check roof route ((the bim role of plate ceiling in (@intrinsic("dereference", target))) = bim ceiling planar role) named (the string form of "Ceiling keeps its native semantic role")
ignore undo bim transaction in (the address of (editor's documentValue))
check roof route ((the length of (target's slabs's values)) = before) named (the string form of "Ceiling creation is one undo")
type bim editor key 2070 in e
check roof route ((editor's tool = bim linear tool) and (editor's linearRole = bim column role)) named (the string form of "Column ribbon still reaches its linear tool")
type bim editor key 2071 in e
check roof route ((editor's tool = bim linear tool) and (editor's linearRole = bim beam role)) named (the string form of "Beam ribbon still reaches its linear tool")
type bim editor key 2072 in e
check roof route ((editor's tool = bim linear tool) and (editor's linearRole = bim mullion role)) named (the string form of "Frame ribbon still reaches its linear tool")
type bim editor key 2077 in e
check roof route ((editor's tool = bim linear tool) and (editor's linearRole = bim pile role)) named (the string form of "Pile ribbon still reaches its linear tool")
