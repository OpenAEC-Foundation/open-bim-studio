# SPDX-License-Identifier: MPL-2.0
# Reinforcement through the editor: the concrete members of the concrete
# example get their bars from the rules; a rule's field stepped in
# the properties panel updates every member the rule reinforces and nothing
# else; the model survives a save and a read; IFC exports the bars.
import examples/bim-slice/bim_editor.dl
import examples/bim-slice/bim_schedule.dl

function the bim rebar test text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 48 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 49 as a word sized unsigned integer, "%.3f", value)
        return the substring of buffer from 0 spanning written bytes

set editor to a new bim editor
set e to the address of editor
refresh bim editor e
ignore add bim concrete example to e
print editor's message as a line
refresh bim editor e
set modelValue to editor's documentValue's current
loop cursor from 0 to the length of (modelValue's rebarRules's values):
    set ruleValue to the item at cursor in (modelValue's rebarRules's values)
    print ((the string form of "  rule ") + ((the string form of ruleValue's id) + ((the string form of ": ") + ruleValue's name))) as a line

# Every member evaluates; the concrete ones carry bars.
set failures to 0
set reinforced to 0
set barTotal to 0
set steelMass to 0.0
set firstColumn to the bim refused id
set firstBeam to the bim refused id
loop cursor from 0 to the length of (editor's evaluation's elements's values):
    set geometry to the item at cursor in (editor's evaluation's elements's values)
    if ((geometry's status != 0) and (geometry's status != 4)) and (geometry's status != 5):
        set failures to failures + 1
    set found to the bim member index of geometry's id in modelValue
    if found's valid and ((the length of (geometry's fasteners's values)) > 0):
        set reinforced to reinforced + 1
        set barTotal to barTotal + (the length of (geometry's fasteners's values))
        set steelMass to steelMass + (the bim bar mass of (geometry's fasteners's values))
        set memberValue to the item at found's position in (modelValue's members's values)
        if (memberValue's role = bim column role) and (firstColumn = the bim refused id):
            set firstColumn to geometry's id
        if (memberValue's role = bim beam role) and (firstBeam = the bim refused id):
            set firstBeam to geometry's id
set summary to (the string form of "reinforced members ") + (the string form of reinforced)
set summary to (summary + (the string form of ", bars ")) + (the string form of barTotal)
set summary to (summary + (the string form of ", steel kg ")) + (the bim rebar test text of steelMass)
set summary to (summary + (the string form of ", failing ")) + (the string form of failures)
print summary as a line
# Every bar is a closed solid.
set open to 0
loop cursor from 0 to the length of (editor's evaluation's elements's values):
    set geometry to the item at cursor in (editor's evaluation's elements's values)
    loop barCursor from 0 to the length of (geometry's fasteners's values):
        if (the fast flaw of (the item at barCursor in (geometry's fasteners's values))'s shape within 1e-9) != 0:
            set open to open + 1
print ((the string form of "open bars ") + (the string form of open)) as a line

# The schedule counts the barTotal per designation.
set rows to the bim schedule of modelValue with editor's evaluation and (editor's spaces's values)
set csv to the bim schedule csv of (rows's values)
set csvLines to csv split at "\n"
loop cursor from 0 to the length of csvLines:
    if (the item at cursor in csvLines) starts with "Reinforcement":
        print ((the string form of "  ") + (the item at cursor in csvLines)) as a line

# The scene draws every bar as a mesh of its own; one is selected.
set meshes to the bim scene meshes of editor's evaluation after (an empty list of a bim scene mesh record)
set barMeshes to 0
set firstBar to the bim refused id
loop cursor from 0 to the length of (meshes's values):
    set entry to the item at cursor in (meshes's values)
    if entry's category = bim reinforcement category:
        set barMeshes to barMeshes + 1
        if firstBar = the bim refused id:
            set firstBar to entry's elementId
print ((the string form of "bar meshes ") + (the string form of barMeshes)) as a line
select bim editor bim fastener picked numbered firstBar in e
print (the bim selection description of editor) as a line
select bim editor bim member picked numbered firstColumn in e
print (the bim selection description of editor) as a line
select bim editor bim member picked numbered firstBeam in e
print (the bim selection description of editor) as a line

# The selected beam's rule gets wider link spacing: only the members the
# rule reinforces are rebuilt.
step bim editor rebar field 6 up true in e
print editor's message as a line
refresh bim editor e
print ((the string form of "  rebuilt ") + (the string form of editor's evaluation's rebuilt)) as a line
print (the bim selection description of editor) as a line
# A column's rule gets two more barTotal.
select bim editor bim member picked numbered firstColumn in e
step bim editor rebar field 2 up true in e
print editor's message as a line
refresh bim editor e
print ((the string form of "  rebuilt ") + (the string form of editor's evaluation's rebuilt)) as a line
print (the bim selection description of editor) as a line
type bim editor key 90 in e
refresh bim editor e
print ((the string form of "undone, rebuilt ") + (the string form of editor's evaluation's rebuilt)) as a line
print (the bim selection description of editor) as a line

# Saving and reading back: the same text, the same solids and barTotal.
set written to the bim file text of (editor's documentValue's current)
set parsed to the bim model parsed from written
print ((the string form of "read back ") + ((the string form of parsed's valid) + ((the string form of " ") + parsed's message))) as a line
print ((the string form of "  same text ") + (the string form of ((the bim file text of parsed's modelValue) = written))) as a line
print ((the string form of "  rules read ") + (the string form of (the length of (parsed's modelValue's rebarRules's values)))) as a line
set reread to the bim evaluation of parsed's modelValue after an empty bim evaluation
set sameSolids to (the length of (reread's elements's values)) = (the length of (editor's evaluation's elements's values))
if sameSolids:
    loop cursor from 0 to the length of (reread's elements's values):
        if (the item at cursor in (reread's elements's values))'s signature != (the item at cursor in (editor's evaluation's elements's values))'s signature:
            set sameSolids to false
print ((the string form of "  same solids ") + (the string form of sameSolids)) as a line

# IFC4: the barTotal as reinforcing barTotal of their members' storey.
set ifcText to the bim ifc text of (editor's documentValue's current)
set ifcLines to ifcText split at "\n"
set columns to 0
set beams to 0
set mainBars to 0
set links to 0
loop cursor from 0 to the length of ifcLines:
    set line to the item at cursor in ifcLines
    if line contains "=IFCBEAM(":
        set beams to beams + 1
    if line contains "=IFCCOLUMN(":
        set columns to columns + 1
    if line contains "=IFCREINFORCINGBAR(":
        if line contains ".LIGATURE.":
            set links to links + 1
        else:
            set mainBars to mainBars + 1
set ifcLine to (the string form of "ifc: beams ") + (the string form of beams)
set ifcLine to (ifcLine + (the string form of ", columns ")) + (the string form of columns)
set ifcLine to (ifcLine + (the string form of ", main bars ")) + (the string form of mainBars)
set ifcLine to (ifcLine + (the string form of ", links ")) + (the string form of links)
print ifcLine as a line
if write bim text ifcText to file (the string form of "rebar.ifc"):
    print (the string form of "wrote rebar.ifc") as a line
