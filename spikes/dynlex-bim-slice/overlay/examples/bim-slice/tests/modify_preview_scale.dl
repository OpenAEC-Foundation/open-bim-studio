# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/bim_modify_preview.dl

function check scaled ghost {boolean:accepted} named {a string:captionText}:
    execute:
        if accepted = false:
            print ((the string form of "FAIL: ") + captionText) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + captionText) as a line

class:
    patterns:
        [a|] scaled ghost bounds record
    members:
        low as a cad vector3
        high as a cad vector3

function the scaled ghost bounds among {a pointer to a list:edgeValues}:
    execute:
        set lowerSpot to a cad vector3 with x 1e100, y 1e100 and z 1e100
        set upperSpot to a cad vector3 with x -1e100, y -1e100 and z -1e100
        loop cornerCursor from 0 to the length of edgeValues:
            set edgeSpot to the item at cornerCursor in edgeValues
            set lowerSpot's x to the minimum of lowerSpot's x and edgeSpot's x
            set lowerSpot's y to the minimum of lowerSpot's y and edgeSpot's y
            set lowerSpot's z to the minimum of lowerSpot's z and edgeSpot's z
            set upperSpot's x to the maximum of upperSpot's x and edgeSpot's x
            set upperSpot's y to the maximum of upperSpot's y and edgeSpot's y
            set upperSpot's z to the maximum of upperSpot's z and edgeSpot's z
        return @intrinsic("construct", a scaled ghost bounds record, lowerSpot, upperSpot)

function bim ghost list {a pointer to a list:beforeEdges} matches {a pointer to a list:afterEdges}:
    execute:
        if ((the length of beforeEdges) = 0) or ((the length of beforeEdges) != (the length of afterEdges)):
            return false
        loop edgeCursor from 0 to the length of beforeEdges:
            set beforeEdge to the item at edgeCursor in beforeEdges
            set afterEdge to the item at edgeCursor in afterEdges
            if ((the cad distance from beforeEdge's first to afterEdge's first) > 1e-8) or ((the cad distance from beforeEdge's last to afterEdge's last) > 1e-8):
                return false
        return true

function prepare scaled ghost by {a 64 bit floating-point number:factorValue} copying {boolean:makingCopy} in {a pointer to a bim editor record:editorValue}:
    execute:
        set editorValue's tool to bim scale tool
        set editorValue's moveStage to 2
        set editorValue's moveBase to a cad vector2 with x 0.0 and y 0.0
        set editorValue's modify's factor to factorValue
        set editorValue's modify's typed to true
        set editorValue's modify's copyMode to makingCopy

# One shared case exercises the renderer and commit with the same input types.
function run scaled ghost case {integer:shapeCode}:
    execute:
        set panelLayout to @intrinsic("construct", a bim screen layout record, 1200.0, 800.0, 0.0, 600.0, 0.0, 800.0)
        set viewCamera to @intrinsic("construct", a bim camera record, (a cad vector2 with x 0.0 and y 0.0), 20.0, 0.5, 0.6, (a cad vector3 with x 0.0, y 0.0 and z 0.0), 20.0)
        set workEditor to a new bim editor
        set editorPointer to the address of workEditor
        set modelPointer to the address of (workEditor's documentValue's current)
        set captionPrefix to the string form of "column: "
        set firstControl to a cad vector3 with x 1.0, y 0.0 and z 0.0
        set lastControl to a cad vector3 with x 1.0, y 0.0 and z 3.0
        set expectedWidth to 0.3
        set expectedDepth to 0.3
        set expectedHeight to 3.0
        set expectedElevation to 1.5
        set roleCode to bim column role
        if shapeCode = 1:
            set captionPrefix to the string form of "beam: "
            set firstControl to a cad vector3 with x 1.0, y 1.0 and z 1.0
            set lastControl to a cad vector3 with x 3.0, y 1.0 and z 1.0
            set expectedWidth to 4.0
            set expectedHeight to 0.5
            set expectedElevation to 1.0
            set roleCode to bim beam role
        set sourceId to the bim refused id
        if shapeCode < 2:
            set profileDepth to 0.3
            if shapeCode = 1:
                set profileDepth to 0.5
            set typeId to add bim linear type named (the string form of "Preview profile") as role roleCode sized 0.3 by profileDepth round false of (the string form of "generic") to modelPointer
            set sourceId to add bim linear typed typeId on workEditor's levelId from firstControl to lastControl turned 0.0 to modelPointer
            select bim editor bim linear picked numbered sourceId in editorPointer
        else:
            set captionPrefix to the string form of "wall copy: "
            set firstControl to a cad vector3 with x -2.0, y -1.0 and z 0.0
            set lastControl to a cad vector3 with x 0.0, y -1.0 and z 0.0
            set sourceId to add bim wall typed workEditor's wallTypeId on workEditor's levelId from (a cad vector2 with x firstControl's x and y firstControl's y) to (a cad vector2 with x lastControl's x and y lastControl's y) to modelPointer
            select bim editor bim wall picked numbered sourceId in editorPointer
            set expectedWidth to 4.0
            set expectedDepth to the bim wall thickness of (the item at 0 in (modelPointer's walls's values)) in (@intrinsic("dereference", modelPointer))
        prepare scaled ghost by 2.0 copying (shapeCode = 2) in editorPointer
        if shapeCode < 2:
            set sourceLinear to the item at 0 in (modelPointer's linears's values)
            set scaleChange to the bim scale transform about workEditor's moveBase by 2.0
            set worldEdges to the bim scaled linear preview edges of sourceLinear by scaleChange in (@intrinsic("dereference", modelPointer))
            set worldBounds to the scaled ghost bounds among (worldEdges's values)
            set worldWidth to worldBounds's high's x - worldBounds's low's x
            set worldDepth to worldBounds's high's y - worldBounds's low's y
            set worldHeight to worldBounds's high's z - worldBounds's low's z
            set worldElevation to (worldBounds's high's z + worldBounds's low's z) * 0.5
            set nativeDimensions to ((the absolute value of (worldWidth - expectedWidth)) < 1e-9) and ((the absolute value of (worldDepth - expectedDepth)) < 1e-9)
            set nativeDimensions to nativeDimensions and (((the absolute value of (worldHeight - expectedHeight)) < 1e-9) and ((the absolute value of (worldElevation - expectedElevation)) < 1e-9))
            check scaled ghost nativeDimensions named (captionPrefix + (the string form of "native profile sizes and Z are preserved"))
        set sourceRevision to workEditor's documentValue's revision
        set sourceUndo to the length of (workEditor's documentValue's undoStack's values)
        set sourceRedo to the length of (workEditor's documentValue's redoStack's values)
        set sourceNextId to modelPointer's nextId
        set beforePlan to an empty list of a bim modification ghost record
        set beforeView to an empty list of a bim modification ghost record
        loop phaseCode from 0 to 2:
            loop viewCode from 0 to 2:
                set inView to viewCode = 1
                set ghostValues to the bim modification preview segments of workEditor in view inView in panelLayout with viewCamera
                if phaseCode = 0:
                    loop ghostCursor from 0 to the length of ghostValues:
                        if inView:
                            append (the item at ghostCursor in ghostValues) to beforeView
                        else:
                            append (the item at ghostCursor in ghostValues) to beforePlan
                    if inView = false:
                        set lowestX to 1e100
                        set highestX to -1e100
                        set lowestY to 1e100
                        set highestY to -1e100
                        loop ghostCursor from 0 to the length of ghostValues:
                            set ghostValue to the item at ghostCursor in ghostValues
                            set lowestX to the minimum of lowestX and (the minimum of ghostValue's first's x and ghostValue's last's x)
                            set highestX to the maximum of highestX and (the maximum of ghostValue's first's x and ghostValue's last's x)
                            set lowestY to the minimum of lowestY and (the minimum of ghostValue's first's y and ghostValue's last's y)
                            set highestY to the maximum of highestY and (the maximum of ghostValue's first's y and ghostValue's last's y)
                        set nativeFootprint to ((the absolute value of ((highestX - lowestX) - (expectedWidth * viewCamera's scale))) < 1e-8) and ((the absolute value of ((highestY - lowestY) - (expectedDepth * viewCamera's scale))) < 1e-8)
                        check scaled ghost nativeFootprint named (captionPrefix + (the string form of "plan ghost keeps native thickness and profile dimensions"))
                else:
                    set geometryMatches to false
                    set viewCaption to the string form of "plan ghost matches actual committed geometry"
                    if inView:
                        set geometryMatches to bim ghost list beforeView matches ghostValues
                        set viewCaption to the string form of "3D ghost matches actual committed geometry"
                    else:
                        set geometryMatches to bim ghost list beforePlan matches ghostValues
                    check scaled ghost geometryMatches named (captionPrefix + viewCaption)
                free ghostValues
            if phaseCode = 0:
                set unchanged to (modelPointer's nextId = sourceNextId) and (workEditor's documentValue's revision = sourceRevision)
                set unchanged to unchanged and (((the length of (workEditor's documentValue's undoStack's values)) = sourceUndo) and ((the length of (workEditor's documentValue's redoStack's values)) = sourceRedo))
                set currentFirst to firstControl
                set currentLast to lastControl
                if shapeCode < 2:
                    set retainedLinear to the item at 0 in (modelPointer's linears's values)
                    set currentFirst to retainedLinear's start
                    set currentLast to retainedLinear's finish
                    set unchanged to unchanged and ((the length of (modelPointer's linears's values)) = 1)
                else:
                    set retainedWall to the item at 0 in (modelPointer's walls's values)
                    set currentFirst to a cad vector3 with x retainedWall's start's x, y retainedWall's start's y and z 0.0
                    set currentLast to a cad vector3 with x retainedWall's finish's x, y retainedWall's finish's y and z 0.0
                    set unchanged to unchanged and ((the length of (modelPointer's walls's values)) = 1)
                set unchanged to unchanged and (((the cad distance from currentFirst to firstControl) < 1e-12) and ((the cad distance from currentLast to lastControl) < 1e-12))
                check scaled ghost unchanged named (captionPrefix + (the string form of "preview preserves source geometry revision undo and redo"))
                check scaled ghost (apply bim editor scale by 2.0 in editorPointer) named (captionPrefix + (the string form of "native scale commits the axis change"))
                prepare scaled ghost by 1.0 copying false in editorPointer
        free beforePlan
        free beforeView

loop fixtureCode from 0 to 3:
    run scaled ghost case fixtureCode
