# SPDX-License-Identifier: MPL-2.0
# A linear element's profile can taper and twist along it. A beam 4 m long,
# 0.2 x 0.4 m at its start, tapering to half of that at its finish, holds
# 4/3 (0.08 + 0.02 + 0.04) = 0.1867 m3; twisted a quarter turn it stays a
# closed solid. Both survive the file and IfcX.
import examples/bim-slice/bim_editor.dl
import examples/bim-slice/bim_ifcx.dl

function the shape test text of {a 64 bit floating-point number:value}:
    execute:
        return the string form of ((@intrinsic("call", "libc", "round", a 64 bit floating-point number, value * 10000.0)) / 10000.0)

function show bim shape test of {bim model record:modelValue} labelled {a string:title}:
    execute:
        set linearValue to the item at 0 in (modelValue's linears's values)
        set solidShape to the bim linear shape of linearValue in modelValue
        print ((title + (the string form of ": twist ")) + ((the shape test text of linearValue's twist) + ((the string form of ", taper ") + ((the shape test text of linearValue's taper's x) + ((the string form of ", flaw ") + ((the string form of (the fast mesh flaw of solidShape)) + ((the string form of ", volume ") + (the shape test text of (the bim volume of mesh solidShape))))))))) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
set beamType to add bim linear type named (the string form of "Balk 200x400") as role bim beam role sized 0.2 by 0.4 round false of (the string form of "steel") to target
set beam to add bim linear typed beamType on storey from (a cad vector3 with x 0.0, y 0.0 and z 2.8) to (a cad vector3 with x 4.0, y 0.0 and z 2.8) turned 0.0 to target
show bim shape test of modelValue labelled (the string form of "prism (0.32 m3)")
print ((the string form of "tapered: ") + (the string form of (shape bim linear beam twisting 0.0 tapering (a cad vector2 with x 0.5 and y 0.5) in target))) as a line
show bim shape test of modelValue labelled (the string form of "tapered (0.1867 m3)")
print ((the string form of "zero scale refused: ") + (the string form of ((shape bim linear beam twisting 0.0 tapering (a cad vector2 with x 0.0 and y 1.0) in target) = false))) as a line
ignore (shape bim linear beam twisting 1.5707963267948966 tapering (a cad vector2 with x 0.5 and y 0.5) in target)
show bim shape test of modelValue labelled (the string form of "twisted a quarter turn")
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", ") + reread's message))) as a line
show bim shape test of reread's modelValue labelled (the string form of "from .bim")
set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "l.ifcx") for project (the string form of "l") by (the string form of "test") at (the string form of "2026-10-13T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of ", ") + fromIfcx's message))) as a line
show bim shape test of fromIfcx's modelValue labelled (the string form of "from .ifcx")
