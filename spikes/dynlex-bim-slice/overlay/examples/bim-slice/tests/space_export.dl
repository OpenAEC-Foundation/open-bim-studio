# SPDX-License-Identifier: MPL-2.0
# Saving a detected room as an explicit Space must not export two IfcSpaces.
import examples/bim-slice/bim_file.dl
import examples/bim-slice/bim_ifcx.dl
import examples/bim-slice/bim_ifcx_read.dl

function check space export {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the test spatial count in {a string:exportText}:
    execute:
        set pieces to exportText split at "\"IfcSpace\""
        set resultCount to (the length of pieces) - 1
        free pieces
        return resultCount

function the test spatial export of {bim model record:modelValue}:
    execute:
        return the bim ifcx text of modelValue identified as (the string form of "spaces.ifcx") for project (the string form of "Spaces") by (the string form of "test") at (the string form of "2026-10-21T00:00:00Z")

set modelValue to an empty bim model
set target to the address of modelValue
set levelId to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to layerValues
set typeId to add bim wall type named (the string form of "Wall") with layerValues to target
set corners to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to corners
append (a cad vector2 with x 4.0 and y 0.0) to corners
append (a cad vector2 with x 4.0 and y 3.0) to corners
append (a cad vector2 with x 0.0 and y 3.0) to corners
loop corner from 0 to 4:
    ignore add bim wall typed typeId on levelId from (the item at corner in corners) to (the item at (the remainder of (corner + 1) divided by 4) in corners) to target
set derived to the bim spaces of modelValue on level levelId using (the bim join index of modelValue)
check space export ((the length of (derived's values)) = 1) named (the string form of "four walls derive one region")
check space export ((the test spatial count in (the test spatial export of modelValue)) = 1) named (the string form of "unclaimed derived room still exports")
set regionValue to the item at 0 in (derived's values)
set ringCount to the length of (regionValue's outline's values)
set shifted to an empty list of a cad vector2
loop corner from 0 to ringCount:
    set sourceCorner to the item at (the remainder of ((ringCount + 1) - corner) divided by ringCount) in (regionValue's outline's values)
    append (a cad vector2 with x (sourceCorner's x + 0.0000001) and y sourceCorner's y) to shifted
check space export (bim space contours (regionValue's outline's values) and shifted match within 0.000001) named (the string form of "shifted reversed contour matches within tolerance")
set explicitId to add bim space object named (the string form of "Living") numbered (the string form of "01") on levelId around shifted high 2.7 to target
set exportText to the test spatial export of modelValue
check space export ((the test spatial count in exportText) = 1) named (the string form of "explicit Space replaces derived IfcSpace")
check space export ((the length of (the bim unsaved regions of (derived's values) in modelValue)'s values) = 0) named (the string form of "same filtered list drives children and nodes")
set nativeResult to the bim native text of ifcx exportText
set nativeReading to the bim model parsed from nativeResult's text
check space export (nativeResult's valid and nativeReading's valid) named (the string form of "deduplicated IFCX reopens")
check space export (((the length of (nativeReading's modelValue's spaceObjects's values)) = 1) and ((the item at 0 in (nativeReading's modelValue's spaceObjects's values))'s id = explicitId)) named (the string form of "roundtrip retains explicit identity")
check space export ((the test spatial count in (the test spatial export of nativeReading's modelValue)) = 1) named (the string form of "roundtrip export remains one IfcSpace")
set standalone to an empty list of a cad vector2
loop corner from 0 to 4:
    set pointValue to the item at corner in corners
    append (a cad vector2 with x (pointValue's x + 20.0) and y pointValue's y) to standalone
ignore add bim space object named (the string form of "Standalone") numbered (the string form of "02") on levelId around standalone high 2.7 to target
check space export ((the test spatial count in (the test spatial export of modelValue)) = 2) named (the string form of "unrelated standalone Space remains")
ignore delete bim space object explicitId from target
set otherLevel to add bim level named (the string form of "Upper") at 3.0 with height 3.0 to target
ignore add bim space object named (the string form of "Upper") numbered (the string form of "03") on otherLevel around shifted high 2.7 to target
check space export ((the test spatial count in (the test spatial export of modelValue)) = 3) named (the string form of "same outline on another storey does not suppress room")
