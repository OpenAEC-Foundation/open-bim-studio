# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/bim_steel_connections.dl

set modelValue to an empty bim model
set target to the address of modelValue
set levelId to add bim level named (the string form of "Ground") at 2.0 with height 6.0 to target
set columnType to add bim linear type named (the string form of "Column") as role bim column role sized 0.2 by 0.2 round false of (the string form of "steel") to target
set beamType to add bim linear type named (the string form of "Beam") as role bim beam role sized 0.18 by 0.3 round false of (the string form of "steel") to target
set columnId to add bim linear typed columnType on levelId from (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (a cad vector3 with x 0.0, y 0.0 and z 6.0) turned 0.0 to target
set beamId to add bim linear typed beamType on levelId from (a cad vector3 with x 0.0, y 0.0 and z 3.0) to (a cad vector3 with x 4.0, y 0.0 and z 3.0) turned 0.0 to target
set ids to an empty list of a 64 bit integer
append columnId to ids
append beamId to ids
loop styleCode from 3 to 8:
    if styleCode != 6:
        set nodeId to add bim steel connection among ids style styleCode in target
        if nodeId = the bim refused id:
            print (the string form of "Connection refused") as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        set spec to the item at 0 in (modelValue's connections's values)
        set derivedParts to the bim parts of connection spec in modelValue
        set expected to 10
        if styleCode = 3:
            set expected to 11
        if styleCode = 5:
            set expected to 16
        if (the length of (derivedParts's values)) != expected:
            print (the string form of "Incorrect independent part count") as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the steel connection style name of styleCode) + ((the string form of " parts: ") + (the string form of expected))) as a line
        ignore delete bim connection nodeId from target
free ids
