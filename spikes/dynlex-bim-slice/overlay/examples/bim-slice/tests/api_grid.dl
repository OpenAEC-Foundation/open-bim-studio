# SPDX-License-Identifier: MPL-2.0
# Background grid batches and cursor placement through actual native requests.
import examples/bim-slice/bim_api.dl

function check api grid {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function api grid response {a string:answer} succeeds:
    execute:
        return (the index of (the string form of "\"ok\":true") in answer) >= 0

set editor to a new bim editor
set target to the address of editor
set answer to the bim api answer to (the string form of "1\ngrid\nZ\n0\n0\n0\n10\n-2\n12\n") for target
check api grid ((api grid response answer succeeds) and ((the length of (editor's documentValue's current's grids's values)) = 1)) named (the string form of "grid request creates geometry without pointer events")
set source to the item at 0 in (editor's documentValue's current's grids's values)
check api grid ((source's name = (the string form of "Z")) and ((source's low = -2.0) and (source's high = 12.0))) named (the string form of "grid request preserves name and elevation bounds")
set beforeId to editor's documentValue's current's nextId
set beforeUndo to the length of (editor's documentValue's undoStack's values)
set answer to the bim api answer to (the string form of "2\ngrid\nBad\n0\n0\n0\n0\n0\n3\n") for target
check api grid (((api grid response answer succeeds) = false) and ((editor's documentValue's current's nextId = beforeId) and ((the length of (editor's documentValue's undoStack's values)) = beforeUndo))) named (the string form of "zero length request does not consume ids or undo")
set answer to the bim api answer to (the string form of "3\ngrid\nBad\n0\n0\n0\n10\n4\n3\n") for target
check api grid ((api grid response answer succeeds) = false) named (the string form of "inverted elevation bounds refused")
set answer to the bim api answer to (the string form of "4\ngrid\nBad\n1e309\n0\n0\n10\n0\n3\n") for target
check api grid ((api grid response answer succeeds) = false) named (the string form of "nonfinite grid coordinates refused")
set answer to the bim api answer to (the string form of "5\ngrid\n   \n0\n0\n0\n10\n0\n3\n") for target
check api grid ((api grid response answer succeeds) = false) named (the string form of "blank grid name refused")
set answer to the bim api answer to (the string form of "6\ngrid\nZ\n1\n0\n1\n10\n0\n3\n") for target
check api grid ((api grid response answer succeeds) = false) named (the string form of "duplicate grid name refused")
set answer to the bim api answer to (((the string form of "7\ngridrepeat\n") + (the string form of source's id)) + (the string form of "\n5000 2x3000\n0\n")) for target
check api grid ((api grid response answer succeeds) and ((the index of (the string form of "\"count\":3") in answer) >= 0)) named (the string form of "repeat returns the created count")
check api grid ((the index of (the string form of "\"ids\":[") in answer) >= 0) named (the string form of "repeat returns created element ids")
set last to the item at 3 in (editor's documentValue's current's grids's values)
check api grid ((last's start's x = 11.0) and ((last's finish's y = 10.0) and (last's name = (the string form of "AC")))) named (the string form of "repeat uses cumulative millimetres and sequential letters")
check api grid (((the length of (editor's documentValue's undoStack's values)) = (beforeUndo + 1)) and ((last's low = -2.0) and (last's high = 12.0))) named (the string form of "repeat preserves elevation in one undo step")
set answer to the bim api answer to (the string form of "8\nundo\n") for target
check api grid ((the length of (editor's documentValue's current's grids's values)) = 1) named (the string form of "undo removes the complete repeated batch")
set beforeRedo to the length of (editor's documentValue's redoStack's values)
set beforeId to editor's documentValue's current's nextId
set answer to the bim api answer to (((the string form of "9\ngridrepeat\n") + (the string form of source's id)) + (the string form of "\n5000 junk\n0\n")) for target
check api grid (((api grid response answer succeeds) = false) and ((editor's documentValue's current's nextId = beforeId) and ((the length of (editor's documentValue's redoStack's values)) = beforeRedo))) named (the string form of "invalid repeat preserves redo and id allocation")
set answer to the bim api answer to (the string form of "10\nredo\n") for target
check api grid ((the length of (editor's documentValue's current's grids's values)) = 4) named (the string form of "redo survives the refused request")
set answer to the bim api answer to (((the string form of "11\nselect\n") + (the string form of source's id)) + (the string form of "\n")) for target
set editor's lengthUnit to bim millimetre unit
set answer to the bim api answer to (the string form of "12\ngridrepeat\nselected\n1000\n") for target
set last to the item at 4 in (editor's documentValue's current's grids's values)
check api grid ((api grid response answer succeeds) and ((last's start's x = 1.0) and (last's name = (the string form of "AD")))) named (the string form of "selected source and current project unit are supported")
set answer to the bim api answer to (the string form of "13\ngridrepeat\nselected\n1\n8\n") for target
check api grid ((api grid response answer succeeds) = false) named (the string form of "unsupported spacing unit refused")
set answer to the bim api answer to (the string form of "14\ngridrepeat\n1.5\n1\n2\n") for target
check api grid ((api grid response answer succeeds) = false) named (the string form of "fractional source id refused")
set answer to the bim api answer to (the string form of "15\ngridrepeat\n999999\n1\n2\n") for target
check api grid ((api grid response answer succeeds) = false) named (the string form of "stale source id refused")
set editor's tool to bim grid tool
set beforeUndo to the length of (editor's documentValue's undoStack's values)
set answer to the bim api answer to (the string form of "16\ncursor\n3.013\n5.027\n") for target
check api grid ((api grid response answer succeeds) and ((editor's cursorPoint's x = 3.013) and (editor's cursorPoint's y = 5.027))) named (the string form of "cursor request places exact coordinates without snapping")
check api grid ((editor's tool = bim grid tool) and ((the length of (editor's documentValue's undoStack's values)) = beforeUndo)) named (the string form of "cursor placement retains the tool and model undo")
set answer to the bim api answer to (the string form of "17\ncursor\nNaN\n0\n") for target
check api grid (((api grid response answer succeeds) = false) and (editor's cursorPoint's x = 3.013)) named (the string form of "invalid cursor request leaves coordinates untouched")
set answer to the bim api answer to (the string form of "18\nelements\n") for target
check api grid (((the index of (the string form of "\"grids\":[") in answer) >= 0) and ((the index of (the string form of "\"low\":-2") in answer) >= 0)) named (the string form of "elements exposes grids and elevation bounds")
set answer to the bim api answer to (the string form of "19\nstate\n") for target
check api grid (((the index of (the string form of "\"grids\":5") in answer) >= 0) and ((the index of (the string form of "\"cursor3D\":[3.013,5.027,0]") in answer) >= 0)) named (the string form of "state exposes grid count and 3D cursor")
set controls to a new string buffer containing 7 bytes
store (0 as a byte) into the data of controls at 0
store (9 as a byte) into the data of controls at 1
store (10 as a byte) into the data of controls at 2
store (13 as a byte) into the data of controls at 3
store (31 as a byte) into the data of controls at 4
store (34 as a byte) into the data of controls at 5
store (92 as a byte) into the data of controls at 6
set escaped to the bim json text of controls
set noRawControl to true
loop cursor from 0 to the length of escaped:
    if ((the character at cursor in escaped) as an integer) < 32:
        set noRawControl to false
check api grid noRawControl named (the string form of "JSON escapes every control byte")
set quotedSlash to a new string buffer containing 4 bytes
store (92 as a byte) into the data of quotedSlash at 0
store (34 as a byte) into the data of quotedSlash at 1
store (92 as a byte) into the data of quotedSlash at 2
store (92 as a byte) into the data of quotedSlash at 3
check api grid (((the index of (the string form of "\\u0000") in escaped) >= 0) and (((the index of (the string form of "\\u001f") in escaped) >= 0) and ((the index of quotedSlash in escaped) >= 0))) named (the string form of "JSON retains null quote and backslash semantics")
