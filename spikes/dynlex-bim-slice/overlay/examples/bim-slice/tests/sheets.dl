# SPDX-License-Identifier: MPL-2.0
# Sheets: an A1 landscape sheet with a plan view placed at 1:50; a model
# metre is 20 mm on it, the viewport takes the view's crop at that scale, the
# title block sits in the lower right corner; all of it read back from .bim
# and .ifcx.
import examples/bim-slice/bim_sheet.dl
import examples/bim-slice/bim_file.dl
import examples/bim-slice/bim_ifcx.dl
import examples/bim-slice/bim_ifcx_read.dl

function show sheet test sheets of {bim model record:modelValue} labelled {a string:title}:
    execute:
        print title as a line
        loop cursor from 0 to the length of (modelValue's sheets's values):
            set sheetValue to the item at cursor in (modelValue's sheets's values)
            set sheetSize to the bim size of sheet sheetValue
            set titleBlock to the bim title block of sheet sheetValue
            print ((the string form of "  ") + ((sheetValue's number + (the string form of " ")) + ((sheetValue's name + (the string form of ", ")) + ((the string form of sheetSize's x) + ((the string form of " x ") + (the string form of sheetSize's y)))))) as a line
            print ((the string form of "  title block from ") + ((the string form of titleBlock's low's x) + ((the string form of ",") + ((the string form of titleBlock's low's y) + ((the string form of " to ") + ((the string form of titleBlock's high's x) + ((the string form of ",") + (the string form of titleBlock's high's y)))))))) as a line
            loop placedCursor from 0 to the length of (sheetValue's viewports's values):
                set placedViewport to the item at placedCursor in (sheetValue's viewports's values)
                set viewportFrame to the bim frame of viewport placedViewport in modelValue
                set probe to the bim sheet point of (a cad vector2 with x 6.0 and y 4.0) through placedViewport in modelValue
                print ((the string form of "  viewport frame from ") + ((the string form of viewportFrame's low's x) + ((the string form of ",") + ((the string form of viewportFrame's low's y) + ((the string form of " to ") + ((the string form of viewportFrame's high's x) + ((the string form of ",") + (the string form of viewportFrame's high's y)))))))) as a line
                print ((the string form of "  model point 6,4 at ") + ((the string form of probe's x) + ((the string form of ",") + (the string form of probe's y)))) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to target
set made to ensure bim default views in target
set planId to the item at 0 in made
set found to the bim view index of planId in modelValue
set planView to the item at found's position in (modelValue's views's values)
set planView's scale to 50
set planView's cropped to true
set planView's cropLow to a cad vector2 with x 0.0 and y 0.0
set planView's cropHigh to a cad vector2 with x 10.0 and y 8.0
store bim view planView in target
set sheetId to add bim sheet numbered (the string form of "A-101") named (the string form of "Plattegrond begane grond") on paper 1 landscape true to target
print (the string form of (place bim view planId on sheet sheetId at (a cad vector2 with x 420.0 and y 330.0) looking at (the bim model centre of view planId in modelValue) in target)) as a line
print (the string form of (place bim view (9999 as a 64 bit integer) on sheet sheetId at (a cad vector2 with x 0.0 and y 0.0) looking at (a cad vector2 with x 0.0 and y 0.0) in target)) as a line
show sheet test sheets of modelValue labelled (the string form of "placed:")
print (the string form of (move bim viewport 0 of sheet sheetId to (a cad vector2 with x 400.0 and y 300.0) in target)) as a line
show sheet test sheets of modelValue labelled (the string form of "moved:")
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", ") + reread's message))) as a line
show sheet test sheets of reread's modelValue labelled (the string form of "from .bim:")
set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "s.ifcx") for project (the string form of "s") by (the string form of "test") at (the string form of "2026-10-09T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of ", ") + fromIfcx's message))) as a line
show sheet test sheets of fromIfcx's modelValue labelled (the string form of "from .ifcx:")
