# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/bim_editor.dl
import examples/bim-slice/bim_ui.dl

function check reinforcement editor {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set editor to a new bim editor
set control to the address of editor
type bim editor key 2050 in control
type bim editor key 2201 in control
place bim editor reinforcement at (a cad vector2 with x 0.0 and y 0.0) in control
place bim editor reinforcement at (a cad vector2 with x 3.0 and y 0.0) in control
check reinforcement editor ((the length of (editor's documentValue's current's reinforcements's values)) = 1) named (the string form of "cage tool creates model element")
set elementId to editor's selectionId
set spec to the item at 0 in (editor's documentValue's current's reinforcements's values)
set geometry to the bim reinforcement shape of spec in editor's documentValue's current
check reinforcement editor ((the length of (geometry's triangles's values)) > 0) named (the string form of "cage generates display triangles")
start bim editor property 90 in control
set editor's propertyText to the string form of "20"
apply bim editor property in control
set spec to the item at 0 in (editor's documentValue's current's reinforcements's values)
check reinforcement editor ((the absolute value of (spec's diameter - 0.02)) < 1e-12) named (the string form of "diameter property edits definition")
start bim editor property 101 in control
set editor's propertyText to the string form of "500"
apply bim editor property in control
set spec to the item at 0 in (editor's documentValue's current's reinforcements's values)
check reinforcement editor ((the absolute value of (spec's start's z - 0.5)) < 1e-12) named (the string form of "start elevation property edits placement")
place bim editor tag at (a cad vector2 with x 1.0 and y 0.0) in control
check reinforcement editor ((the length of (editor's documentValue's current's tags's values)) = 1) named (the string form of "tag tool recognizes reinforcement")
check reinforcement editor ((the bim tag anchor of elementId in editor's documentValue's current)'s valid) named (the string form of "reinforcement notation has drawing anchor")
set exported to the bim ifcx text of editor's documentValue's current identified as (the string form of "rebar.ifcx") for project (the string form of "rebar") by (the string form of "test") at (the string form of "2026-10-13T00:00:00Z")
set native to the bim native text of ifcx exported
set readback to the bim model parsed from native's text
check reinforcement editor (native's valid and readback's valid) named (the string form of "IfcX native parameters round trip")
check reinforcement editor ((the length of (readback's modelValue's reinforcements's values)) = 1) named (the string form of "IfcX retains reinforcement")
check reinforcement editor ((the length of (readback's modelValue's tags's values)) = 1) named (the string form of "IfcX retains reinforcement annotation")
set groups to the bim ribbon groups of tab 7
check reinforcement editor ((the length of groups) > 0) named (the string form of "reinforcement ribbon exists")
free groups
type bim editor key bim delete key code in control
check reinforcement editor ((the length of (editor's documentValue's current's reinforcements's values)) = 0) named (the string form of "delete selected cage")
ignore undo bim transaction in (the address of (editor's documentValue))
check reinforcement editor ((the item at 0 in (editor's documentValue's current's reinforcements's values))'s id = elementId) named (the string form of "undo deletion restores identity")

# Connection UI, perforations and round trip share this editor integration test.
set editor to a new bim editor
type bim editor key 2050 in control
set target to the address of (editor's documentValue's current)
set typeId to add bim linear type named (the string form of "Steel") as role bim beam role sized 0.2 by 0.4 round false of (the string form of "steel") to target
set zero to a cad vector3 with x 0.0, y 0.0 and z 0.0
set firstId to add bim linear typed typeId on editor's levelId from zero to (a cad vector3 with x 3.0, y 0.0 and z 0.0) turned 0.0 to target
set secondId to add bim linear typed typeId on editor's levelId from zero to (a cad vector3 with x 0.0, y 3.0 and z 0.0) turned 0.0 to target
select bim editor bim linear picked numbered firstId in control
append secondId to (editor's chosenSketches's values)
type bim editor key 2302 in control
check reinforcement editor (editor's selectionKind = 31) named (the string form of "Complex node tool links selected beams")
set nodeId to editor's selectionId
type bim editor key 2310 in control
type bim editor key 2312 in control
set specNode to the item at 0 in (target's connections's values)
check reinforcement editor ((the length of (specNode's additions's values)) = 2) named (the string form of "plate and screw ribbon actions")
start bim editor property 10024 in control
set editor's propertyText to the string form of "60"
apply bim editor property in control
set specNode to the item at 0 in (target's connections's values)
check reinforcement editor ((the absolute value of ((the item at 1 in (specNode's additions's values))'s length - 0.06)) < 1e-12) named (the string form of "screw length property")
ignore undo bim transaction in (the address of (editor's documentValue))
set specNode to the item at 0 in (target's connections's values)
check reinforcement editor ((the absolute value of ((the item at 1 in (specNode's additions's values))'s length - 0.04)) < 1e-12) named (the string form of "undo owns independent screw parameters")
select bim editor element at (a cad vector2 with x 0.0 and y 0.0) in control
check reinforcement editor ((editor's selectionKind = 31) and (editor's selectionId = nodeId)) named (the string form of "plan picks linking node")
set memberValue to the item at (the bim linear index of secondId in editor's documentValue's current)'s position in (target's linears's values)
set drilledShape to the bim linear shape of memberValue in editor's documentValue's current
set stockVolume to (0.2 * 0.4) * 3.0
set drilledVolume to the bim volume of mesh drilledShape
check reinforcement editor ((drilledVolume > (stockVolume * 0.99)) and (drilledVolume < (stockVolume - 0.0000001))) named (the string form of "screw pilot holes remove member volume")
set partsValue to the bim parts of connection specNode in editor's documentValue's current
set assemblyShape to the bim independent shapes of (partsValue's values) in editor's documentValue's current
check reinforcement editor ((the length of (assemblyShape's triangles's values)) > 0) named (the string form of "connection additions have geometry")
set exported to the bim ifcx text of editor's documentValue's current identified as (the string form of "connections.ifcx") for project (the string form of "connections") by (the string form of "test") at (the string form of "2026-10-14T00:00:00Z")
set native to the bim native text of ifcx exported
set readback to the bim model parsed from native's text
check reinforcement editor (readback's valid and ((the length of (readback's modelValue's connections's values)) = 1)) named (the string form of "IfcX preserves editable connection")

# A small review model containing the new tools, written into the build tree.
type bim editor key 2201 in control
place bim editor reinforcement at (a cad vector2 with x 0.0 and y -1.0) in control
place bim editor reinforcement at (a cad vector2 with x 3.0 and y -1.0) in control
place bim editor tag at (a cad vector2 with x 1.0 and y -1.0) in control
type bim editor key 2202 in control
place bim editor reinforcement at (a cad vector2 with x 0.0 and y -3.0) in control
place bim editor reinforcement at (a cad vector2 with x 3.0 and y -2.0) in control
type bim editor key 2203 in control
place bim editor reinforcement at (a cad vector2 with x 4.0 and y -1.0) in control
place bim editor reinforcement at (a cad vector2 with x 5.5 and y -1.0) in control
type bim editor key 2204 in control
place bim editor reinforcement at (a cad vector2 with x 4.0 and y -2.0) in control
place bim editor reinforcement at (a cad vector2 with x 5.5 and y -2.0) in control
check reinforcement editor (write bim text (the bim file text of editor's documentValue's current) to file (the string form of "../reinforcement-connections-demo.bim")) named (the string form of "write review model")
