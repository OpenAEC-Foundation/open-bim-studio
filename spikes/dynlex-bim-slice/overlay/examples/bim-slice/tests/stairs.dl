# SPDX-License-Identifier: MPL-2.0
# A straight stair as a generator of linear elements: 17 risers up a 3 m
# storey over a 3.6 m run give 16 treads of 225 mm going and two stringers;
# the parts' volume is exact against the planks' and stringers' sizes, and the
# stair reads back from .bim and .ifcx.
import examples/bim-slice/bim_scene.dl
import examples/bim-slice/bim_file.dl
import examples/bim-slice/bim_ifcx.dl
import examples/bim-slice/bim_ifcx_read.dl

function show stair test stairs of {bim model record:modelValue} labelled {a string:title}:
    execute:
        print title as a line
        loop cursor from 0 to the length of (modelValue's stairs's values):
            set stairValue to the item at cursor in (modelValue's stairs's values)
            set stairParts to the bim parts of stair stairValue in modelValue
            set riserText to (the rounded value of ((the bim riser height of stair stairValue in modelValue) * 100000.0)) / 100000.0
            set goingText to (the rounded value of ((the bim going of stair stairValue) * 100000.0)) / 100000.0
            print ((the string form of "  risers ") + ((the string form of stairValue's riserCount) + ((the string form of ", riser ") + ((the string form of riserText) + ((the string form of ", going ") + ((the string form of goingText) + ((the string form of ", parts ") + (the string form of (the length of (stairParts's values)))))))))) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to target
set stairId to add bim stair on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 3.6 and y 0.0) wide 1.0 in 17 risers of (the string form of "timber") to target
print ((the string form of "refused short: ") + (the string form of ((add bim stair on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.2 and y 0.0) wide 1.0 in 17 risers of (the string form of "timber") to target) = the bim refused id))) as a line
show stair test stairs of modelValue labelled (the string form of "stair:")
set stairValue to the item at 0 in (modelValue's stairs's values)
set stairShape to the bim stair shape of stairValue in modelValue within 0.0
set measured to the absolute value of (the bim volume of mesh stairShape)
# Treads: (going + nosing) x thickness x width each; stringers: breadth x
# depth x their axis length.
set rise to 3.0 / 17.0
set treadGoing to 3.6 / 16.0
set treadVolume to 16.0 * (((treadGoing + 0.02) * 0.04) * 1.0)
set lowHeight to rise * 0.5
set highHeight to (rise * 16.0) - 0.125
set stringerLength to the square root of ((3.6 * 3.6) + ((highHeight - lowHeight) * (highHeight - lowHeight)))
set stringerVolume to 2.0 * ((0.05 * 0.25) * stringerLength)
set expected to treadVolume + stringerVolume
print ((the string form of "volume as expected ") + (the string form of ((the absolute value of (measured - expected)) < 1e-9))) as a line
set low to 1e300
set high to -1e300
loop corner from 0 to the length of (stairShape's positions's values):
    set low to the minimum of low and (the item at corner in (stairShape's positions's values))'s z
    set high to the maximum of high and (the item at corner in (stairShape's positions's values))'s z
print ((the string form of "top tread at ") + (the string form of ((the rounded value of (high * 10000.0)) / 10000.0))) as a line
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", ") + reread's message))) as a line
show stair test stairs of reread's modelValue labelled (the string form of "from .bim:")
set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "st.ifcx") for project (the string form of "st") by (the string form of "test") at (the string form of "2026-10-09T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of ", ") + fromIfcx's message))) as a line
show stair test stairs of fromIfcx's modelValue labelled (the string form of "from .ifcx:")
