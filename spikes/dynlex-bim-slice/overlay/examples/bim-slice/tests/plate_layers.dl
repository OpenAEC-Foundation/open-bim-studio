# SPDX-License-Identifier: MPL-2.0
# A plate's layers can reach past or stop short of its outline. A 4 x 4 m
# floor of 50 mm screed (50 mm short of the edge), 200 mm concrete and
# 100 mm insulation (100 mm past it) is three solids: 3.9 x 3.9 x 0.05 =
# 0.7605 m3, 4 x 4 x 0.2 = 3.2 m3 and 4.2 x 4.2 x 0.1 = 1.764 m3. Exploded
# it becomes three plates of single-layer types, stacked at their tops.
import examples/bim-slice/bim_editor.dl
import examples/bim-slice/bim_hatch.dl

function the plate layer test text of {a 64 bit floating-point number:value}:
    execute:
        return the string form of ((@intrinsic("call", "libc", "round", a 64 bit floating-point number, value * 10000.0)) / 10000.0)

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to target
set floorLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "screed", 0.05)) to floorLayers
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to floorLayers
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.1)) to floorLayers
set floorType to add bim planar type named (the string form of "Vloer 350") as role bim floor planar role with floorLayers to target
free floorLayers
set bim setting ((bim layer edge setting) + 0) of floorType to (-50 as a 64 bit integer) keeping true in target
set bim setting ((bim layer edge setting) + 2) of floorType to (100 as a 64 bit integer) keeping true in target
set corners to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to corners
append (a cad vector2 with x 4.0 and y 0.0) to corners
append (a cad vector2 with x 4.0 and y 4.0) to corners
append (a cad vector2 with x 0.0 and y 4.0) to corners
set floorId to add bim plate typed floorType on ground around corners at top 0.0 to target
set plateValue to the item at 0 in (modelValue's slabs's values)
set layerSolids to the bim layer solids of plate plateValue in modelValue
print ((the string form of "layer solids: ") + (the string form of (the length of (layerSolids's values)))) as a line
loop solidCursor from 0 to the length of (layerSolids's values):
    set layerSolid to the item at solidCursor in (layerSolids's values)
    set layerMesh to an empty fast mesh
    append fast mesh of layerSolid's shape to (the address of layerMesh)
    print ((the string form of "  ") + (layerSolid's material + ((the string form of " ") + (the plate layer test text of (the bim volume of mesh layerMesh))))) as a line
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of "edges from .bim: ") + ((the plate layer test text of (the bim layer edge of layer 0 of type floorType in reread's modelValue)) + ((the string form of " ") + (the plate layer test text of (the bim layer edge of layer 2 of type floorType in reread's modelValue))))) as a line
print ((the string form of "exploded into ") + (the string form of (explode bim plate floorId in target))) as a line
loop slabCursor from 0 to the length of (modelValue's slabs's values):
    set piece to the item at slabCursor in (modelValue's slabs's values)
    set pieceType to the item at (the bim wall type index of piece's typeId in modelValue)'s position in (modelValue's wallTypes's values)
    set firstCorner to the item at 0 in (piece's outline's values)
    print ((the string form of "  ") + (pieceType's name + ((the string form of ", top ") + ((the plate layer test text of piece's top) + ((the string form of ", corner ") + (the plate layer test text of firstCorner's x)))))) as a line
# A wall of three 100 mm layers explodes into three walls of single-layer
# types, exterior first on the right of its line (y 9.9, 10 and 10.1), the
# insulation reaching 100 mm past both ends.
set wallLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to wallLayers
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.1)) to wallLayers
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.1)) to wallLayers
set wallType to add bim wall type named (the string form of "Spouwmuur 300") with wallLayers to target
free wallLayers
set bim setting ((bim layer edge setting) + 1) of wallType to (100 as a 64 bit integer) keeping true in target
set wallId to add bim wall typed wallType on ground from (a cad vector2 with x 0.0 and y 10.0) to (a cad vector2 with x 5.0 and y 10.0) to target
print ((the string form of "wall exploded into ") + (the string form of (explode bim wall wallId in target))) as a line
loop wallCursor from 0 to the length of (modelValue's walls's values):
    set pieceWall to the item at wallCursor in (modelValue's walls's values)
    set pieceWallType to the item at (the bim wall type index of pieceWall's typeId in modelValue)'s position in (modelValue's wallTypes's values)
    print ((the string form of "  ") + (pieceWallType's name + ((the string form of ", y ") + ((the plate layer test text of pieceWall's start's y) + ((the string form of ", x ") + ((the plate layer test text of pieceWall's start's x) + ((the string form of " to ") + (the plate layer test text of pieceWall's finish's x)))))))) as a line
# The wall type's NL-SfB code goes to IFC as a classification reference.
set bim setting (bim nlsfb setting) of wallType to (2112 as a 64 bit integer) keeping true in target
print ((the string form of "NL-SfB: ") + (the bim assembly code text of (2112 as a 64 bit integer) in (bim nlsfb setting))) as a line
set ifcText to the bim ifc text of modelValue
print ((the string form of "IFC classification: ") + (the string form of ((the index of "IFCCLASSIFICATIONREFERENCE($,'21.12'" in ifcText) >= 0))) as a line
# The project's drawing standard: NEN 47 unless set; it chooses hatches.
print ((the string form of "standard: ") + (the bim name of standard (the bim drawing standard of modelValue))) as a line
set bim setting (bim drawing standard setting) of (0 as a 64 bit integer) to ((bim din standard) as a 64 bit integer) keeping true in target
set dinBrick to the bim hatch pattern of material (the string form of "brick") under (the bim drawing standard of modelValue)
print ((the string form of "DIN brick: lines every ") + ((the string form of dinBrick's spacing) + ((the string form of ", fill ") + (the string form of dinBrick's fillRed)))) as a line
set rereadStandard to the bim model parsed from (the bim file text of modelValue)
print ((the string form of "standard from .bim: ") + (the bim name of standard (the bim drawing standard of rereadStandard's modelValue))) as a line
