# SPDX-License-Identifier: MPL-2.0
# Times the fast kernel against the port on the operations of the fast-kernel
# spike's criteria: a 6 m cavity wall with one window and with four windows,
# built; the tessellation of a room of four walls with two windows; and an
# L-shaped slab, built and tessellated, against the port's extrusion. Each
# operation is repeated; prints the median microseconds of 15 rounds per
# operation and the ratio port / fast.
import examples/bim-slice/bim_evaluate.dl

local function the timing microseconds now:
    execute:
        set clockValues to an empty list of a 64 bit integer
        append (0 as a 64 bit integer) to clockValues
        append (0 as a 64 bit integer) to clockValues
        set status to @intrinsic("call", "libc", "clock_gettime", an integer, 1, the data of clockValues)
        set micro to ((the item at 0 in clockValues) * (1000000 as a 64 bit integer)) + ((the item at 1 in clockValues) / (1000 as a 64 bit integer))
        free clockValues
        if status != 0:
            @intrinsic("call", "libc", "abort", nothing)
        return micro

local function the timing median of {a pointer to a list:samples}:
    execute:
        loop outer from 1 to the length of samples:
            set moving to the item at outer in samples
            set slot to outer
            set shifting to true
            loop while shifting:
                if slot = 0:
                    set shifting to false
                else if (the item at (slot - 1) in samples) > moving:
                    replace item at index slot in samples with (the item at (slot - 1) in samples)
                    set slot to slot - 1
                else:
                    set shifting to false
            replace item at index slot in samples with moving
        return the item at ((the length of samples) / 2) in samples

local function the timing text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.2f", value)
        return the substring of buffer from 0 spanning written bytes

# A storey with a cavity wall type and a window type.
local function a timing model:
    execute:
        set modelValue to an empty bim model
        set target to the address of modelValue
        ignore add bim level named (the string form of "Level") at 0.0 with height 3.0 to target
        set layers to an empty list of a bim layer record
        append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layers
        append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.12)) to layers
        append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.1)) to layers
        ignore add bim wall type named (the string form of "Cavity") with layers to target
        free layers
        ignore add bim opening type named (the string form of "Window") sized 0.9 by 1.4 with sill 0.9 and frame 0.05 to target
        return modelValue

local function the timing point {a 64 bit floating-point number:x} {a 64 bit floating-point number:y}:
    execute:
        return a cad vector2 with x x and y y

# Microseconds per build of `wallId`, median of 15 rounds of `repeats` builds.
local function the timing of building {a 64 bit integer:wallId} in {bim model record:modelValue} preferring fast {boolean:preferringFast} repeated {integer:repeats}:
    execute:
        set index to the bim join index of modelValue
        set wallValue to the item at (the bim wall index of wallId in modelValue)'s position in (modelValue's walls's values)
        set samples to an empty list of a 64 bit floating-point number
        loop round from 0 to 15:
            set began to the timing microseconds now
            loop repeat from 0 to repeats:
                set built to the bim solid of wallValue in modelValue using index preferring fast preferringFast
                if built's status != 0:
                    @intrinsic("call", "libc", "abort", nothing)
            append ((((the timing microseconds now) - began) as a 64 bit floating-point number) / (repeats as a 64 bit floating-point number)) to samples
        set median to the timing median of samples
        free samples
        return median

local function report timing {a string:label} fast {a 64 bit floating-point number:fastTime} port {a 64 bit floating-point number:portTime}:
    execute:
        set line to ((label + (the string form of ": fast ")) + (the timing text of fastTime)) + (the string form of " us, port ")
        set line to ((line + (the timing text of portTime)) + (the string form of " us, ratio ")) + (the timing text of (portTime / fastTime))
        print line as a line

# A lone 6 m wall with one and with four windows.
set single to a timing model
set wallId to add bim wall typed (2 as a 64 bit integer) on (1 as a 64 bit integer) from (the timing point 0.0 0.0) to (the timing point 6.0 0.0) to (the address of single)
ignore add bim opening typed (3 as a 64 bit integer) in wallId at 1.5 to (the address of single)
report timing (the string form of "wall with one window") fast (the timing of building wallId in single preferring fast true repeated 200) port (the timing of building wallId in single preferring fast false repeated 20)
set quadruple to a timing model
set wallFour to add bim wall typed (2 as a 64 bit integer) on (1 as a 64 bit integer) from (the timing point 0.0 0.0) to (the timing point 6.0 0.0) to (the address of quadruple)
ignore add bim opening typed (3 as a 64 bit integer) in wallFour at 0.8 to (the address of quadruple)
ignore add bim opening typed (3 as a 64 bit integer) in wallFour at 2.3 to (the address of quadruple)
ignore add bim opening typed (3 as a 64 bit integer) in wallFour at 3.8 to (the address of quadruple)
ignore add bim opening typed (3 as a 64 bit integer) in wallFour at 5.2 to (the address of quadruple)
report timing (the string form of "wall with four windows") fast (the timing of building wallFour in quadruple preferring fast true repeated 200) port (the timing of building wallFour in quadruple preferring fast false repeated 10)

# A room of four joined walls with a window in two of them, tessellated.
set room to a timing model
set roomTarget to the address of room
set south to add bim wall typed (2 as a 64 bit integer) on (1 as a 64 bit integer) from (the timing point 0.0 0.0) to (the timing point 6.0 0.0) to roomTarget
ignore add bim wall typed (2 as a 64 bit integer) on (1 as a 64 bit integer) from (the timing point 6.0 0.0) to (the timing point 6.0 4.0) to roomTarget
set north to add bim wall typed (2 as a 64 bit integer) on (1 as a 64 bit integer) from (the timing point 6.0 4.0) to (the timing point 0.0 4.0) to roomTarget
ignore add bim wall typed (2 as a 64 bit integer) on (1 as a 64 bit integer) from (the timing point 0.0 4.0) to (the timing point 0.0 0.0) to roomTarget
ignore add bim opening typed (3 as a 64 bit integer) in south at 1.5 to roomTarget
ignore add bim opening typed (3 as a 64 bit integer) in north at 3.0 to roomTarget
set roomIndex to the bim join index of room
set fastSolids to an empty list of a bim element geometry record
set portSolids to an empty list of a bim element geometry record
loop cursor from 0 to the length of (room's walls's values):
    set wallValue to the item at cursor in (room's walls's values)
    set directBuilt to the bim solid of wallValue in room using roomIndex preferring fast true
    append (@intrinsic("construct", a bim element geometry record, wallValue's id, the string form of "", 0 as a 64 bit integer, directBuilt's status, directBuilt's solid, directBuilt's fast, directBuilt's shape)) to fastSolids
    set generalBuilt to the bim solid of wallValue in room using roomIndex preferring fast false
    append (@intrinsic("construct", a bim element geometry record, wallValue's id, the string form of "", 0 as a 64 bit integer, generalBuilt's status, generalBuilt's solid, generalBuilt's fast, generalBuilt's shape)) to portSolids
set roundTimes to an empty list of a 64 bit floating-point number
loop round from 0 to 15:
    set began to the timing microseconds now
    loop repeat from 0 to 100:
        set triangles to an empty fast mesh
        loop cursor from 0 to the length of fastSolids:
            append bim mesh of (the item at cursor in fastSolids) to (the address of triangles)
    append ((((the timing microseconds now) - began) as a 64 bit floating-point number) / 100.0) to roundTimes
set fastMesh to the timing median of roundTimes
clear roundTimes
loop round from 0 to 15:
    set began to the timing microseconds now
    loop repeat from 0 to 5:
        set triangles to an empty fast mesh
        loop cursor from 0 to the length of portSolids:
            append bim mesh of (the item at cursor in portSolids) to (the address of triangles)
    append ((((the timing microseconds now) - began) as a 64 bit floating-point number) / 5.0) to roundTimes
set portMesh to the timing median of roundTimes
free roundTimes
report timing (the string form of "room tessellation") fast fastMesh port portMesh
set fastCount to 0
loop cursor from 0 to the length of fastSolids:
    if (the item at cursor in fastSolids)'s fast:
        set fastCount to fastCount + 1
print ((the string form of "room walls built directly ") + (the string form of fastCount)) as a line
free fastSolids
free portSolids

# An L-shaped slab of six corners, 0.25 m thick: the fast prism against the
# port's extrusion of the same outline, built and tessellated.
set slabModel to a timing model
set slabOutline to an empty list of a cad vector2
append (the timing point 0.0 0.0) to slabOutline
append (the timing point 10.0 0.0) to slabOutline
append (the timing point 10.0 4.0) to slabOutline
append (the timing point 4.0 4.0) to slabOutline
append (the timing point 4.0 7.0) to slabOutline
append (the timing point 0.0 7.0) to slabOutline
set slabId to add bim slab on (1 as a 64 bit integer) around slabOutline thick 0.25 to (the address of slabModel)
set slabValue to the item at (the bim slab index of slabId in slabModel)'s position in (slabModel's slabs's values)
set slabProfile to an empty list of the type of (the cad curve2 of (a new cad line2))
loop cursor from 0 to the length of slabOutline:
    append (the cad curve2 of (a cad line2 from (the item at cursor in slabOutline) to (the item at (the remainder of (cursor + 1) divided by (the length of slabOutline)) in slabOutline))) to slabProfile
set slabPlane to a cad plane with origin (a cad vector3 with x 0.0, y 0.0 and z -0.25), x axis (the cad x axis) and y axis (the cad y axis)
set slabSamples to an empty list of a 64 bit floating-point number
loop round from 0 to 15:
    set began to the timing microseconds now
    loop repeat from 0 to 1000:
        set slabBuilt to the bim slab solid of slabValue in slabModel
        if slabBuilt's status != 0:
            @intrinsic("call", "libc", "abort", nothing)
    append ((((the timing microseconds now) - began) as a 64 bit floating-point number) / 1000.0) to slabSamples
set fastSlab to the timing median of slabSamples
clear slabSamples
loop round from 0 to 15:
    set began to the timing microseconds now
    loop repeat from 0 to 100:
        set extruded to the cad extrusion of slabProfile on slabPlane along (a cad vector3 with x 0.0, y 0.0 and z 0.25)
        if extruded's valid = false:
            @intrinsic("call", "libc", "abort", nothing)
    append ((((the timing microseconds now) - began) as a 64 bit floating-point number) / 100.0) to slabSamples
set portSlab to the timing median of slabSamples
clear slabSamples
report timing (the string form of "L-shaped slab") fast fastSlab port portSlab
set fastSlabSolid to the bim slab solid of slabValue in slabModel
set fastSlabGeometry to @intrinsic("construct", a bim element geometry record, slabId, the string form of "", 0 as a 64 bit integer, 0, fastSlabSolid's solid, true, fastSlabSolid's shape)
set portSlabSolid to the cad extrusion of slabProfile on slabPlane along (a cad vector3 with x 0.0, y 0.0 and z 0.25)
set portSlabGeometry to @intrinsic("construct", a bim element geometry record, slabId, the string form of "", 0 as a 64 bit integer, 0, portSlabSolid's value, false, an empty fast polyhedron)
loop round from 0 to 15:
    set began to the timing microseconds now
    loop repeat from 0 to 1000:
        set triangles to an empty fast mesh
        append bim mesh of fastSlabGeometry to (the address of triangles)
    append ((((the timing microseconds now) - began) as a 64 bit floating-point number) / 1000.0) to slabSamples
set fastSlabMesh to the timing median of slabSamples
clear slabSamples
loop round from 0 to 15:
    set began to the timing microseconds now
    loop repeat from 0 to 100:
        set triangles to an empty fast mesh
        append bim mesh of portSlabGeometry to (the address of triangles)
    append ((((the timing microseconds now) - began) as a 64 bit floating-point number) / 100.0) to slabSamples
set portSlabMesh to the timing median of slabSamples
free slabSamples
report timing (the string form of "L-shaped slab tessellation") fast fastSlabMesh port portSlabMesh
set volumeLine to (the string form of "slab volume fast ") + (the timing text of (the bim volume of fastSlabGeometry))
print ((volumeLine + (the string form of " port ")) + (the timing text of (the bim volume of portSlabGeometry))) as a line
set slabTriangles to an empty fast mesh
append bim mesh of fastSlabGeometry to (the address of slabTriangles)
print ((the string form of "slab mesh flaw ") + (the string form of (the fast mesh flaw of slabTriangles))) as a line
free slabProfile
free slabOutline
