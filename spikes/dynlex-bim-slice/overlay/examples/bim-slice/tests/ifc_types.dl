# SPDX-License-Identifier: MPL-2.0
# Role-correct exchange types and one grouped Types relationship per type.
import examples/bim-slice/bim_ifc.dl
import examples/bim-slice/bim_file.dl

function check ifc types {boolean:valid} named {a string:label}:
    execute:
        if valid = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set upper to add bim level named (the string form of "Upper") at 3.0 with height 3.0 to target
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to layers
set wallType to add bim planar type named (the string form of "Wall") as role (bim wall planar role) with layers to target
set floorType to add bim planar type named (the string form of "Floor") as role (bim floor planar role) with layers to target
set roofType to add bim planar type named (the string form of "Roof") as role (bim roof planar role) with layers to target
set ceilingType to add bim planar type named (the string form of "Ceiling") as role (bim ceiling planar role) with layers to target
free layers
set wallId to add bim wall typed wallType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
ignore add bim wall typed wallType on upper from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set outline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to outline
append (a cad vector2 with x 2.0 and y 0.0) to outline
append (a cad vector2 with x 2.0 and y 2.0) to outline
append (a cad vector2 with x 0.0 and y 2.0) to outline
ignore add bim plate typed floorType on ground around outline at top 0.0 to target
ignore add bim plate typed roofType on upper around outline at top 3.0 to target
ignore add bim plate typed ceilingType on ground around outline at top 2.7 to target
ignore add bim slab on ground around outline thick 0.12 to target
free outline
set columnType to add bim linear type named (the string form of "Column") as role (bim column role) sized 0.3 by 0.3 round false of (the string form of "concrete") to target
set beamType to add bim linear type named (the string form of "Beam") as role (bim beam role) sized 0.2 by 0.4 round false of (the string form of "steel") to target
set pileType to add bim linear type named (the string form of "Pile") as role (bim pile role) sized 0.3 by 0.3 round true of (the string form of "concrete") to target
ignore add bim linear typed columnType on ground from (a cad vector3 with x 0.0, y 3.0 and z 0.0) to (a cad vector3 with x 0.0, y 3.0 and z 3.0) turned 0.0 to target
ignore add bim linear typed beamType on ground from (a cad vector3 with x 0.0, y 3.0 and z 3.0) to (a cad vector3 with x 4.0, y 3.0 and z 3.0) turned 0.0 to target
ignore add bim linear typed pileType on ground from (a cad vector3 with x 4.0, y 3.0 and z -5.0) to (a cad vector3 with x 4.0, y 3.0 and z 0.0) turned 0.0 to target
set windowType to add bim opening type named (the string form of "Window") sized 1.0 by 1.2 with sill 0.9 and frame 0.05 to target
set doorType to add bim door type named (the string form of "Door") sized 0.9 by 2.1 with frame 0.05 to target
ignore add bim opening typed windowType in wallId at 1.2 to target
ignore add bim opening typed doorType in wallId at 4.5 to target
set exported to the bim ifc43 text of modelValue
check ifc types (((the length of (exported split at "IFCWALLTYPE(")) - 1) = 1) named (the string form of "wall type is not used for other planar roles")
check ifc types (((the length of (exported split at "IFCSLABTYPE(")) - 1) = 3) named (the string form of "floor roof and legacy slab types are exported")
check ifc types (exported contains "IFCCOVERINGTYPE(") named (the string form of "ceiling exports its covering type")
check ifc types ((exported contains "IFCCOLUMNTYPE(") and (exported contains "IFCBEAMTYPE(")) named (the string form of "column and beam types are exported")
check ifc types (exported contains "IFCPILETYPE(") named (the string form of "pile type is exported")
check ifc types ((exported contains "IFCDOORTYPE(") and (exported contains "IFCWINDOWTYPE(")) named (the string form of "door and window types are exported")
check ifc types (((the length of (exported split at "IFCRELDEFINESBYTYPE(")) - 1) = 10) named (the string form of "one relationship per used type across all storeys")
check ifc types ((exported contains ",.ROOF.)") and (exported contains ",.CEILING.)")) named (the string form of "planar predefined types match their roles")
check ifc types (write bim text exported to file (the string form of "ifc-types-test.ifc")) named (the string form of "exchange fixture written for independent schema checks")
