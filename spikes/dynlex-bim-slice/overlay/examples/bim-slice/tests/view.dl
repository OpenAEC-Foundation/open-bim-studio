# SPDX-License-Identifier: MPL-2.0
# Categories and view rules: the templates of the three view kinds, toggling
# visibility and halftone in one view only, the category of each element of
# the example house, hidden categories passed over by plan selection, and
# view rules surviving a save and an open.
import examples/bim-slice/bim_editor.dl

function the view test flags of {bim view rules record:viewRules}:
    execute:
        set written to the string form of ""
        loop code from 0 to the bim category count:
            if bim category code is visible in viewRules:
                set written to written + (the string form of "V")
            else:
                set written to written + (the string form of "-")
            if bim category code is halftone in viewRules:
                set written to written + (the string form of "h ")
            else:
                set written to written + (the string form of "  ")
        return written

set editor to a new bim editor
add bim example building to (the address of editor)
refresh bim editor (the address of editor)
print ((the string form of "plan    ") + (the view test flags of editor's planRules)) as a line
print ((the string form of "section ") + (the view test flags of editor's sectionRules)) as a line
print ((the string form of "3D      ") + (the view test flags of editor's modelRules)) as a line

# Each element's category.
set modelValue to editor's documentValue's current
set counts to an empty list of an integer
loop code from 0 to the bim category count:
    append 0 to counts
set ids to an empty list of a 64 bit integer
loop cursor from 0 to the length of (modelValue's walls's values):
    append (the item at cursor in (modelValue's walls's values))'s id to ids
loop cursor from 0 to the length of (modelValue's openings's values):
    append (the item at cursor in (modelValue's openings's values))'s id to ids
loop cursor from 0 to the length of (modelValue's slabs's values):
    append (the item at cursor in (modelValue's slabs's values))'s id to ids
loop cursor from 0 to the length of ids:
    set code to the bim category of element (the item at cursor in ids) in modelValue
    replace item at index code in counts with ((the item at code in counts) + 1)
loop code from 0 to the bim category count:
    print (((the bim name of category code) + (the string form of " ")) + (the string form of (the item at code in counts))) as a line
print ((the string form of "category of a level ") + (the string form of (the bim category of element (the item at 0 in (modelValue's levels's values))'s id in modelValue))) as a line

# Hiding walls in the 3D view leaves the plan alone; halftone toggles.
toggle bim category bim wall category visibility in (the address of (editor's modelRules))
toggle bim category bim window category halftone in (the address of (editor's planRules))
print ((the string form of "after toggles plan ") + (the view test flags of editor's planRules)) as a line
print ((the string form of "after toggles 3D   ") + (the view test flags of editor's modelRules)) as a line

# With walls hidden in the plan, a click on a wall's centreline neither hovers
# nor selects the wall; grid B, which runs there, is selected instead. Shown
# again, the wall is selected.
set e to the address of editor
type bim editor key 83 in e
toggle bim category bim wall category visibility in (the address of (editor's planRules))
move bim editor pointer to (a cad vector2 with x 5.5 and y 2.0) within 0.1 in e
press bim editor pointer in e
release bim editor pointer in e
print ((the string form of "hidden walls, hover ") + (the string form of editor's hoverWall)) as a line
print ((the string form of "hidden walls, selected kind ") + (the string form of editor's selectionKind)) as a line
toggle bim category bim wall category visibility in (the address of (editor's planRules))
move bim editor pointer to (a cad vector2 with x 5.5 and y 2.0) within 0.1 in e
press bim editor pointer in e
release bim editor pointer in e
print ((the string form of "shown walls, selected kind ") + (the string form of editor's selectionKind)) as a line

# Saved and opened again, the views keep their rules.
set path to the string form of "build/bim-slice-view-test.bim"
save bim editor to path in e
set other to a new bim editor
open bim editor from path in (the address of other)
print other's message as a line
print ((the string form of "reopened plan ") + (the view test flags of other's planRules)) as a line
print ((the string form of "reopened 3D   ") + (the view test flags of other's modelRules)) as a line
ignore @intrinsic("call", "libc", "remove", integer, the data of path)
