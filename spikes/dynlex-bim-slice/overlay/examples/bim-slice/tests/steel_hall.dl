# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/bim_demo_steel_hall.dl
import examples/bim-slice/bim_file.dl

function check steel hall {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set hallModel to the bim demo steel hall
check steel hall ((the length of (hallModel's linears's values)) = 32) named (the string form of "32 native steel members")
check steel hall ((the length of (hallModel's connections's values)) = 60) named (the string form of "60 semantic connection nodes")
check steel hall ((the length of (hallModel's connectionTypes's values)) = 1) named (the string form of "reusable named fin-plate type")
set allValid to true
set totalParts to 0
set totalWelds to 0
loop cursor from 0 to the length of (hallModel's connections's values):
    set spec to the item at cursor in (hallModel's connections's values)
    set generated to the bim connection evaluation of spec in hallModel
    if generated's valid = false:
        print (spec's name + ((the string form of ": ") + generated's message)) as a line
        set allValid to false
    set totalWelds to totalWelds + (the length of (generated's welds's values))
    set derivedParts to the bim parts of connection spec in hallModel
    set totalParts to totalParts + (the length of (derivedParts's values))
check steel hall allValid named (the string form of "every connection generates valid geometry")
check steel hall (totalWelds = 52) named (the string form of "52 independent weld runs")
check steel hall (totalParts > 400) named (the string form of "plates bolts anchors and welds generate independent parts")
set nativeText to the bim file text of hallModel
set readback to the bim model parsed from nativeText
check steel hall readback's valid named (the string form of "hall file parses with saved connection type")
if (the bim file text of readback's modelValue) != nativeText:
    ignore write bim text nativeText to file (the string form of "steel-hall-before.bim")
    ignore write bim text (the bim file text of readback's modelValue) to file (the string form of "steel-hall-after.bim")
check steel hall ((the bim file text of readback's modelValue) = nativeText) named (the string form of "hall and type library round trip exactly")
check steel hall (write bim text nativeText to file (the string form of "steel-connection-hall.bim")) named (the string form of "editable 3D hall written")
# Applying a configured type must retain edited part values, remap slots and own
# lists. It must not leave a node or consume ids when ownership rejects it.
set target to the address of hallModel
set template to the item at 0 in (hallModel's connectionTypes's values)
set secondTemplate to template
set secondTemplate's additions to the cad clone of template's additions
set plate to the item at 0 in (secondTemplate's additions's values)
set plate's thickness to 0.016
replace item at index 0 in (secondTemplate's additions's values) with plate
replace item at index 0 in (target's connectionTypes's values) with secondTemplate
set sourceNode to the item at 0 in (hallModel's connections's values)
set typeRoundtrip to the bim model parsed from (the bim file text of hallModel)
check steel hall (typeRoundtrip's valid and ((the item at 0 in ((the item at 0 in (typeRoundtrip's modelValue's connectionTypes's values))'s additions's values))'s thickness = 0.016)) named (the string form of "edited type parameters survive serialization")
check steel hall ((the item at 0 in (template's additions's values))'s thickness = 0.012) named (the string form of "type edit leaves prior snapshot intact")
