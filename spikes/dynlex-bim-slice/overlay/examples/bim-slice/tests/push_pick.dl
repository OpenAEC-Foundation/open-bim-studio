# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/bim_push_pick.dl

function check push picking {boolean:accepted} named {a string:description}:
    execute:
        if accepted = false:
            print ((the string form of "FAIL: ") + description) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + description) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set upperLevel to add bim level named (the string form of "Upper") at 6.0 with height 3.0 to target
set ringPoints to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to ringPoints
append (a cad vector2 with x 4.0 and y 0.0) to ringPoints
append (a cad vector2 with x 4.0 and y 3.0) to ringPoints
append (a cad vector2 with x 0.0 and y 3.0) to ringPoints
set massId to add bim face on upperLevel around ringPoints to target
set massFound to the bim sketch index of massId in modelValue
set massValue to the item at massFound's position in (modelValue's sketches's values)
set massValue's height to 2.0
check push picking ((the bim side of mass massValue at (a cad vector3 with x 2.0, y 0.0 and z 7.0) in modelValue) = 0) named (the string form of "side hit uses the object's upper storey")
check push picking ((the bim side of mass massValue at (a cad vector3 with x 4.0, y 1.0 and z 7.0) in modelValue) = 1) named (the string form of "east side is selected independently")
check push picking ((the bim side of mass massValue at (a cad vector3 with x 2.0, y 3.0 and z 7.0) in modelValue) = 2) named (the string form of "north side is selected independently")
check push picking ((the bim side of mass massValue at (a cad vector3 with x 0.0, y 1.0 and z 7.0) in modelValue) = 3) named (the string form of "west side is selected independently")
check push picking ((the bim side of mass massValue at (a cad vector3 with x 2.0, y 0.0 and z 1.0) in modelValue) = -1) named (the string form of "same XY on another storey is not a side hit")
check push picking ((the bim side of mass massValue at (a cad vector3 with x 2.0, y 1.0 and z 7.0) in modelValue) = -1) named (the string form of "interior section cap does not invent an editable side")
check push picking ((the bim side of mass massValue at (a cad vector3 with x 2.0, y 0.0 and z 8.0) in modelValue) = -1) named (the string form of "top rim retains height extrusion")
set massValue's height to -2.0
check push picking ((the bim side of mass massValue at (a cad vector3 with x 2.0, y 0.0 and z 5.0) in modelValue) = 0) named (the string form of "negative-height mass sides remain editable")
set originPixel to a cad vector2 with x 100.0 and y 100.0
check push picking ((the bim push travel from originPixel to (a cad vector2 with x 150.0 and y 100.0) along (a cad vector2 with x 100.0 and y 0.0) scaled 100.0) = 0.5) named (the string form of "side drag measures projected normal travel")
check push picking ((the bim push travel from originPixel to (a cad vector2 with x 100.0 and y 50.0) along (a cad vector2 with x 0.0 and y 0.0) scaled 100.0) = 0.5) named (the string form of "head-on normal falls back to upward outward travel")
check push picking ((the bim push travel from originPixel to (a cad vector2 with x 100.0 and y 150.0) along (a cad vector2 with x 0.001 and y 0.0) scaled 100.0) = -0.5) named (the string form of "near-head-on travel stays bounded and supports inward movement")
free ringPoints

set negativeShape to the bim sketch mesh of massValue at 6.0
check push picking ((the fast mesh flaw of negativeShape) = 0) named (the string form of "negative mass renders as a closed solid")
set minimumZ to 1e30
set maximumZ to -1e30
loop vertexCursor from 0 to the length of (negativeShape's positions's values):
    set vertexSpot to the item at vertexCursor in (negativeShape's positions's values)
    set minimumZ to the minimum of minimumZ and vertexSpot's z
    set maximumZ to the maximum of maximumZ and vertexSpot's z
check push picking ((minimumZ = 4.0) and (maximumZ = 6.0)) named (the string form of "negative solid occupies its own storey minus height")
