# SPDX-License-Identifier: MPL-2.0
# Command/geometry/undo checks; no main, graphics or native window imports.
import lib/std.dl
import examples/bim-slice/bim_editor.dl

function check sketch division {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function click sketch division at {cad vector2:spot} in {a pointer to a bim editor record:targetEditor}:
    execute:
        move bim editor pointer to spot within 0.1 in targetEditor
        press bim editor pointer in targetEditor
        release bim editor pointer in targetEditor

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set corners to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to corners
append (a cad vector2 with x 4.0 and y 0.0) to corners
append (a cad vector2 with x 4.0 and y 3.0) to corners
append (a cad vector2 with x 0.0 and y 3.0) to corners
set faceId to add bim face on editor's levelId around corners to target
ignore set bim face faceId height to 2.0 in target
set overlapId to add bim face on editor's levelId around corners to target
ignore set bim face overlapId height to 7.0 in target
select bim editor bim sketch picked numbered faceId in e
type bim editor key 2360 in e
check sketch division (editor's tool = bim split tool) named (the string form of "Split command selects its explicit tool")
click sketch division at (a cad vector2 with x 2.0 and y 0.0) in e
check sketch division (((the length of (target's sketches's values)) = 2) and ((the length of (editor's sketchChain's values)) = 1)) named (the string form of "first Split click changes no geometry")
click sketch division at (a cad vector2 with x 2.0 and y 3.0) in e
check sketch division ((the length of (target's sketches's values)) = 3) named (the string form of "Split makes two faces without a loose line")
set raisedParts to 0
loop cursor from 0 to the length of (target's sketches's values):
    set piece to the item at cursor in (target's sketches's values)
    if (piece's kind = bim face sketch) and (piece's height = 2.0):
        set raisedParts to raisedParts + 1
check sketch division (raisedParts = 2) named (the string form of "both split mass parts retain their height")
check sketch division ((the item at (the bim sketch index of overlapId in (@intrinsic("dereference", target)))'s position in (target's sketches's values))'s height = 7.0) named (the string form of "overlapping unselected mass remains untouched")
ignore undo bim transaction in (the address of (editor's documentValue))
check sketch division (((the length of (target's sketches's values)) = 2) and ((the bim sketch index of faceId in (@intrinsic("dereference", target)))'s valid)) named (the string form of "one undo restores original 2D face identity")
select bim editor bim sketch picked numbered faceId in e
type bim editor key 2360 in e
click sketch division at (a cad vector2 with x 1.0 and y 0.0) in e
click sketch division at (a cad vector2 with x 3.0 and y 0.0) in e
check sketch division ((the length of (target's sketches's values)) = 2) named (the string form of "cut along one edge is refused without mutation")
type bim editor key bim escape key code in e
check sketch division ((editor's tool = bim select tool) and ((the length of (editor's sketchChain's values)) = 0)) named (the string form of "Escape cancels the pending split")
set massValue to the item at (the bim sketch index of faceId in (@intrinsic("dereference", target)))'s position in (target's sketches's values)
set virtualMesh to the bim mesh form of mass massValue
set topFace to the bim top face of mesh virtualMesh at (a cad vector2 with x 2.0 and y 1.0)
set undoCount to the length of (editor's documentValue's undoStack's values)
set badCut to split bim editor sketch mesh faceId mass true face topFace from (a cad vector3 with x 0.0, y 0.0 and z 2.0) to (a cad vector3 with x 4.0, y 0.0 and z 2.0) in e
check sketch division ((badCut = false) and (((the length of (target's meshes's values)) = 0) and ((the bim sketch index of faceId in (@intrinsic("dereference", target)))'s valid))) named (the string form of "failed 3D split rolls back mass conversion")
check sketch division ((the length of (editor's documentValue's undoStack's values)) = undoCount) named (the string form of "refused 3D split adds no undo step")
set goodCut to split bim editor sketch mesh faceId mass true face topFace from (a cad vector3 with x 2.0, y 0.0 and z 2.0) to (a cad vector3 with x 2.0, y 3.0 and z 2.0) in e
check sketch division (goodCut and ((the length of (target's meshes's values)) = 1)) named (the string form of "3D mass conversion and split commit together")
set splitMesh to the item at 0 in (target's meshes's values)
check sketch division (((the bim face count of mesh splitMesh) = 7) and ((the absolute value of ((the bim signed volume of mesh splitMesh) - 24.0)) < 1e-7)) named (the string form of "mesh subdivision adds a face while preserving mass volume")
ignore undo bim transaction in (the address of (editor's documentValue))
check sketch division (((the length of (target's meshes's values)) = 0) and ((the bim sketch index of faceId in (@intrinsic("dereference", target)))'s valid)) named (the string form of "one undo restores the sketch mass after 3D split")
check sketch division ((start bim editor push of sketch overlapId side 0 in e) and (editor's pushId = overlapId)) named (the string form of "side push uses exact hit ID among overlapping masses")
set editor's lengthUnit to 2
type bim editor key 49 in e
set pushedMass to the item at (the bim sketch index of overlapId in (@intrinsic("dereference", target)))'s position in (target's sketches's values)
check sketch division ((the absolute value of (the cad signed area of (pushedMass's points's values))) > 12.0) named (the string form of "numeric side push changes the hit mass footprint")
check sketch division (editor's numeric = (the string form of "1")) named (the string form of "side push retains numeric input semantics")
type bim editor key bim escape key code in e
check sketch division ((editor's pushId = the bim refused id) and ((the length of ((the item at (the bim sketch index of overlapId in (@intrinsic("dereference", target)))'s position in (target's sketches's values))'s points's values)) = 4)) named (the string form of "Escape rolls back explicit-ID side push")
check sketch division (start bim editor push of sketch overlapId side -1 in e) named (the string form of "top push accepts explicit ID with side minus one")
type bim editor key bim escape key code in e
check sketch division ((start bim editor push of sketch overlapId side -2 in e) = false) named (the string form of "invalid side is refused before starting a transaction")
set negativeId to add bim face on editor's levelId around corners to target
# Imported records may carry negative height; the interactive height setter
# intentionally still refuses creating one. Test the side API independently.
set negativeIndex to (the bim sketch index of negativeId in (@intrinsic("dereference", target)))'s position
set negativeValue to the item at negativeIndex in (target's sketches's values)
set negativeValue's height to -2.0
replace item at index negativeIndex in (target's sketches's values) with negativeValue
select bim editor bim sketch picked numbered negativeId in e
type bim editor key 2360 in e
click sketch division at (a cad vector2 with x 2.0 and y 0.0) in e
check sketch division ((the length of (editor's sketchChain's values)) = 0) named (the string form of "unsupported negative mass Split never flattens the source")
check sketch division (start bim editor push of sketch negativeId side 0 in e) named (the string form of "negative-height mass can be pushed sideways")
type bim editor key bim escape key code in e
set flatId to add bim face on editor's levelId around corners to target
check sketch division (start bim editor push of sketch flatId side -1 in e) named (the string form of "flat face can start an explicit-ID height extrusion")
type bim editor key bim escape key code in e
check sketch division ((start bim editor push of sketch flatId side 0 in e) = false) named (the string form of "flat face has no side to push")
