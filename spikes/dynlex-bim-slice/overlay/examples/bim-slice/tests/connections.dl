# SPDX-License-Identifier: MPL-2.0
# The connection showcase through the editor: every member and connection
# evaluates; a type parameter stepped in the properties panel updates every
# connection of the type and the members it cuts; the model survives a save
# and a read; IFC exports members and connection assemblies.
import examples/bim-slice/bim_editor.dl

function the bim connections test text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 48 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 49 as a word sized unsigned integer, "%.6f", value)
        return the substring of buffer from 0 spanning written bytes

set editor to a new bim editor
set e to the address of editor
refresh bim editor e
ignore add bim connection showcase to e
print editor's message as a line
refresh bim editor e
set modelValue to editor's documentValue's current
set failures to 0
set members to 0
set parts to 0
set steel to 0.0
loop cursor from 0 to the length of (editor's evaluation's elements's values):
    set geometry to the item at cursor in (editor's evaluation's elements's values)
    if ((geometry's status != 0) and (geometry's status != 4)) and (geometry's status != 5):
        set failures to failures + 1
        print ((the string form of "  failing element ") + ((the string form of geometry's id) + ((the string form of " status ") + (the string form of geometry's status)))) as a line
    if (the bim member index of geometry's id in modelValue)'s valid:
        set members to members + 1
    else if geometry's status = 0:
        set parts to parts + 1
    if geometry's status = 5:
        print ((the string form of "  member ") + ((the string form of geometry's id) + (the string form of " lacks a refused cut"))) as a line
    set steel to steel + (the bim volume of geometry)
print ((the string form of "members ") + ((the string form of members) + ((the string form of ", connections with parts ") + ((the string form of parts) + ((the string form of ", failing ") + ((the string form of failures) + ((the string form of ", steel m3 ") + (the bim connections test text of steel)))))))) as a line
loop cursor from 0 to the length of (modelValue's connectionTypes's values):
    set connection to the item at cursor in (modelValue's connectionTypes's values)
    set count to 0
    loop jointCursor from 0 to the length of (modelValue's joints's values):
        if (the item at jointCursor in (modelValue's joints's values))'s typeId = connection's id:
            set count to count + 1
    print ((the string form of "  ") + ((connection's name + (the string form of ": ")) + (the string form of count))) as a line

# Select a fin plate joint and give its type a fourth bolt row.
set finJoint to the bim refused id
loop cursor from 0 to the length of (modelValue's joints's values):
    set jointValue to the item at cursor in (modelValue's joints's values)
    set connection to the item at (the bim connection type index of jointValue's typeId in modelValue)'s position in (modelValue's connectionTypes's values)
    if (finJoint = the bim refused id) and (connection's name starts with "Fin plate"):
        set finJoint to jointValue's id
select bim editor bim joint picked numbered finJoint in e
print (the bim selection description of editor) as a line
step bim editor parameter 5 up true in e
print editor's message as a line
refresh bim editor e
print ((the string form of "  rebuilt ") + (the string form of editor's evaluation's rebuilt)) as a line
type bim editor key 90 in e
refresh bim editor e
print ((the string form of "undone, rebuilt ") + (the string form of editor's evaluation's rebuilt)) as a line

# Saving and reading back: the same text, the same solids.
set written to the bim file text of (editor's documentValue's current)
set parsed to the bim model parsed from written
print ((the string form of "read back ") + ((the string form of parsed's valid) + ((the string form of " ") + parsed's message))) as a line
print ((the string form of "  same text ") + (the string form of ((the bim file text of parsed's modelValue) = written))) as a line
set reread to the bim evaluation of parsed's modelValue after an empty bim evaluation
set sameSolids to (the length of (reread's elements's values)) = (the length of (editor's evaluation's elements's values))
if sameSolids:
    loop cursor from 0 to the length of (reread's elements's values):
        if (the item at cursor in (reread's elements's values))'s signature != (the item at cursor in (editor's evaluation's elements's values))'s signature:
            set sameSolids to false
print ((the string form of "  same solids ") + (the string form of sameSolids)) as a line

# IFC4: beams, columns, braces and connection assemblies.
set ifcText to the bim ifc text of (editor's documentValue's current)
set ifcLines to ifcText split at "\n"
set beams to 0
set columns to 0
set braces to 0
set assemblies to 0
loop cursor from 0 to the length of ifcLines:
    set line to the item at cursor in ifcLines
    if line contains "=IFCBEAM(":
        set beams to beams + 1
    if line contains "=IFCCOLUMN(":
        set columns to columns + 1
    if line contains "=IFCMEMBER(":
        set braces to braces + 1
    if line contains "=IFCELEMENTASSEMBLY(":
        set assemblies to assemblies + 1
print ((the string form of "ifc: beams ") + ((the string form of beams) + ((the string form of ", columns ") + ((the string form of columns) + ((the string form of ", braces ") + ((the string form of braces) + ((the string form of ", assemblies ") + (the string form of assemblies)))))))) as a line
if write bim text ifcText to file (the string form of "connections.ifc"):
    print (the string form of "wrote connections.ifc") as a line
