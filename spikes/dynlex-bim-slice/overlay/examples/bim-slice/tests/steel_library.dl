# SPDX-License-Identifier: MPL-2.0
# Profiles, European steel and libraries: the EU steel profiles loaded as
# linear types named by designation with their IFC profiles; an HEA column
# swept as an H (its plan outline twelve corners), a circular hollow section
# with its hole; the library exported as IfcX, read back and added to
# another project, with its profiles and assembly codes.
import examples/bim-slice/bim_editor.dl

function find steel test type named {a string:wanted} role {integer:roleCode} in {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's linearTypes's values):
            set candidate to the item at cursor in (modelValue's linearTypes's values)
            if (candidate's name = wanted) and (candidate's role = roleCode):
                return candidate's id
        return the bim refused id

set editor to a new bim editor
set e to the address of editor
type bim editor key 2135 in e
print editor's message as a line
type bim editor key 2135 in e
print editor's message as a line
set modelValue to editor's documentValue's current
loop cursor from 0 to 6:
    set wanted to the string form of "HEA 200"
    if cursor = 1:
        set wanted to the string form of "IPE 300"
    if cursor = 2:
        set wanted to the string form of "UPN 200"
    if cursor = 3:
        set wanted to the string form of "L 80x80x8"
    if cursor = 4:
        set wanted to the string form of "SHS 100x100x5"
    if cursor = 5:
        set wanted to the string form of "CHS 114.3x5"
    set typeId to find steel test type named wanted role (bim beam role) in modelValue
    if typeId = the bim refused id:
        print (wanted + (the string form of ": missing")) as a line
    else:
        set linearType to the item at (the bim linear type index of typeId in modelValue)'s position in (modelValue's linearTypes's values)
        set shapeProfile to the bim profile of linear type linearType in modelValue
        print (((wanted + (the string form of ": ")) + (the bim name of profile kind shapeProfile's kind round shapeProfile's round)) + (((the string form of " ") + (the bim metres text of linearType's width)) + ((the string form of " x ") + (the bim metres text of linearType's depth)))) as a line
# An HEA 200 column and a CHS 114.3x5 beam in the model.
set columnType to find steel test type named (the string form of "HEA 200") role (bim column role) in modelValue
set tubeType to find steel test type named (the string form of "CHS 114.3x5") role (bim beam role) in modelValue
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set columnId to add bim linear typed columnType on editor's levelId from (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (a cad vector3 with x 0.0, y 0.0 and z 3.0) turned 0.0 to target
set tubeId to add bim linear typed tubeType on editor's levelId from (a cad vector3 with x 1.0, y 0.0 and z 2.5) to (a cad vector3 with x 5.0, y 0.0 and z 2.5) turned 0.0 to target
commit bim transaction in (the address of (editor's documentValue))
set modelValue to editor's documentValue's current
set column to the item at (the bim linear index of columnId in modelValue)'s position in (modelValue's linears's values)
set columnShape to the bim linear shape of column in modelValue
print ((the string form of "column triangles ") + ((the string form of ((the length of (columnShape's triangles's values)) / 3)) + ((the string form of ", plan outline corners ") + (the string form of (the length of (the bim plan outline of linear column in modelValue)))))) as a line
set tube to the item at (the bim linear index of tubeId in modelValue)'s position in (modelValue's linears's values)
set tubeShape to the bim linear shape of tube in modelValue
print ((the string form of "tube volume ") + ((the bim metres text of (1000.0 * (the absolute value of (the bim volume of mesh tubeShape)))) + (the string form of " dm3"))) as a line
# The library out and in again.
ignore @intrinsic("call", "libc", "mkdir", integer, the data of (the string form of "build"), 493)
print ((the string form of "library written: ") + (the string form of (write bim library of editor's documentValue's current to (the string form of "build/steel-library.ifcx")))) as a line
set libraryReading to the bim library read from (the string form of "build/steel-library.ifcx")
print (((the string form of "library read: ") + (the string form of libraryReading's valid)) + ((the string form of " ") + libraryReading's message)) as a line
set other to a new bim editor
begin bim transaction in (the address of (other's documentValue))
set addedTypes to add bim library libraryReading's library to (the address of (other's documentValue's current))
commit bim transaction in (the address of (other's documentValue))
print ((the string form of "added to another project: ") + (the string form of addedTypes)) as a line
set otherModel to other's documentValue's current
set copiedId to find steel test type named (the string form of "HEA 200") role (bim column role) in otherModel
print ((the string form of "HEA 200 there: ") + (the string form of (copiedId != the bim refused id))) as a line
if copiedId != the bim refused id:
    set copiedType to the item at (the bim linear type index of copiedId in otherModel)'s position in (otherModel's linearTypes's values)
    print (((the string form of "  profile ") + (the bim name of profile kind ((the bim profile of linear type copiedType in otherModel)'s kind) round false)) + ((the string form of ", NL-SfB ") + (the bim assembly code text of ((the bim setting (bim nlsfb setting) of copiedId in otherModel)'s value) in (bim nlsfb setting)))) as a line

# The Dutch steel-beam button loads the library and starts a real profile.
set steelCountBefore to the length of (editor's documentValue's current's linearTypes's values)
type bim editor key 2385 in e
set activeSteel to the item at (the bim linear type index of editor's linearTypeId in editor's documentValue's current)'s position in (editor's documentValue's current's linearTypes's values)
print ((the string form of "steel beam command: ") + (the string form of ((editor's tool = bim linear tool) and (editor's linearRole = bim beam role)))) as a line
print ((the string form of "default beam profile: ") + activeSteel's name) as a line
print ((the string form of "steel button reuses library: ") + (the string form of ((the length of (editor's documentValue's current's linearTypes's values)) = steelCountBefore))) as a line
