# SPDX-License-Identifier: MPL-2.0
# The platform shim (`platform/obs_platform.c`) on whatever platform it runs:
# the UTC calendar of two known moments, a wall clock past 2023, a
# monotonic clock that does not go back, an environment variable set and
# read back, a folder made twice, an absolute path, a file's size in 64
# bits, and a thread that runs and is joined.
import lib/string.dl

function check platform {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

class:
    patterns:
        [a|] platform check calendar record
    members:
        year as a 64 bit integer
        month as a 64 bit integer
        day as a 64 bit integer
        hour as a 64 bit integer
        minute as a 64 bit integer
        second as a 64 bit integer

class:
    patterns:
        [a|] platform check job record
    members:
        done as a 64 bit integer

# The calendar of `moment` in UTC.
function the platform check calendar at {a 64 bit integer:moment}:
    execute:
        set fields to @intrinsic("construct", a platform check calendar record, 0 as a 64 bit integer, 0 as a 64 bit integer, 0 as a 64 bit integer, 0 as a 64 bit integer, 0 as a 64 bit integer, 0 as a 64 bit integer)
        ignore @intrinsic("call", "obs_platform", "obs_platform_calendar", a 64 bit integer, moment, 0 as a 64 bit integer, the address of fields)
        return fields

# The thread's entry: it marks the job done.
exposed function run platform check job {a pointer to a platform check job record:target}:
    execute:
        set target's done to 1 as a 64 bit integer
        return target

set onWindows to (@intrinsic("call", "obs_platform", "obs_platform_is_windows", a 64 bit integer)) = (1 as a 64 bit integer)

set epoch to the platform check calendar at (0 as a 64 bit integer)
check platform (((epoch's year = (1970 as a 64 bit integer)) and (epoch's month = (1 as a 64 bit integer))) and (((epoch's day = (1 as a 64 bit integer)) and (epoch's hour = (0 as a 64 bit integer))) and ((epoch's minute = (0 as a 64 bit integer)) and (epoch's second = (0 as a 64 bit integer))))) named (the string form of "0 s is 1970-01-01 00:00:00 UTC")
set known to the platform check calendar at (1700000000 as a 64 bit integer)
check platform (((known's year = (2023 as a 64 bit integer)) and (known's month = (11 as a 64 bit integer))) and (((known's day = (14 as a 64 bit integer)) and (known's hour = (22 as a 64 bit integer))) and ((known's minute = (13 as a 64 bit integer)) and (known's second = (20 as a 64 bit integer))))) named (the string form of "1700000000 s is 2023-11-14 22:13:20 UTC")

set wall to @intrinsic("call", "obs_platform", "obs_platform_wall_seconds", a 64 bit integer)
check platform (wall > (1700000000 as a 64 bit integer)) named (the string form of "the wall clock is past 2023")
set earlier to @intrinsic("call", "obs_platform", "obs_platform_monotonic_microseconds", a 64 bit integer)
set later to @intrinsic("call", "obs_platform", "obs_platform_monotonic_microseconds", a 64 bit integer)
check platform ((earlier >= (0 as a 64 bit integer)) and (later >= earlier)) named (the string form of "the monotonic clock does not go back")

set setOutcome to @intrinsic("call", "obs_platform", "obs_platform_set_environment", a 64 bit integer, "OBS_PLATFORM_CHECK", "7")
set readPointer to @intrinsic("call", "libc", "getenv", a pointer to a byte, "OBS_PLATFORM_CHECK")
set readBack to 0
if readPointer != (0 as a pointer to a byte):
    set readBack to @intrinsic("call", "libc", "atoi", integer, readPointer)
check platform ((setOutcome = (0 as a 64 bit integer)) and (readBack = 7)) named (the string form of "an environment variable set is read back")

set firstMade to @intrinsic("call", "obs_platform", "obs_platform_make_directory", a 64 bit integer, "obs-platform-check")
set againMade to @intrinsic("call", "obs_platform", "obs_platform_make_directory", a 64 bit integer, "obs-platform-check")
check platform ((firstMade = (0 as a 64 bit integer)) and (againMade = (0 as a 64 bit integer))) named (the string form of "a folder is made, and made again without fault")

set buffer to a new string buffer containing 4096 bytes
set absoluteLength to @intrinsic("call", "obs_platform", "obs_platform_absolute_path", a 64 bit integer, "obs-platform-check", the data of buffer, 4097 as a 64 bit integer)
set absoluteText to the string form of ""
if absoluteLength > (0 as a 64 bit integer):
    set absoluteText to the substring of buffer from 0 spanning (absoluteLength as an integer) bytes
set rooted to false
if (the length of absoluteText) > 2:
    if onWindows:
        set rooted to (the character at 1 in absoluteText) = 58
    else:
        set rooted to (the character at 0 in absoluteText) = 47
check platform rooted named (the string form of "a relative path made absolute")

set writer to @intrinsic("call", "libc", "fopen", a pointer to a byte, "obs-platform-check/size.txt", "wb")
ignore @intrinsic("call", "libc", "fwrite", a word sized integer, "12345", 1 as a word sized integer, 5 as a word sized integer, writer)
ignore @intrinsic("call", "libc", "fclose", integer, writer)
set reader to @intrinsic("call", "libc", "fopen", a pointer to a byte, "obs-platform-check/size.txt", "rb")
set measured to @intrinsic("call", "obs_platform", "obs_platform_file_size", a 64 bit integer, reader)
ignore @intrinsic("call", "libc", "fclose", integer, reader)
check platform (measured = (5 as a 64 bit integer)) named (the string form of "a file of 5 bytes measures 5")

set checkJob to @intrinsic("construct", a platform check job record, 0 as a 64 bit integer)
# DynLex keeps a function reached only through `the function named` when it
# is also called directly, in a branch that never runs.
if checkJob's done < (0 as a 64 bit integer):
    ignore run platform check job (the address of checkJob)
set entry to the function named "run platform check job $"
set handle to 0 as a 64 bit integer
set started to @intrinsic("call", "obs_platform", "obs_platform_start_thread", a 64 bit integer, entry, the address of checkJob, 1048576 as a 64 bit integer, the address of handle)
set joined to @intrinsic("call", "obs_platform", "obs_platform_join_thread", a 64 bit integer, handle)
check platform (((started = (0 as a 64 bit integer)) and (joined = (0 as a 64 bit integer))) and (checkJob's done = (1 as a 64 bit integer))) named (the string form of "a thread runs and is joined")
