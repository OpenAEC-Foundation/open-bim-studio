# SPDX-License-Identifier: MPL-2.0
# Floor types carry a material: a slab given a timber floor type takes its
# thickness and material; the material shows in the properties, survives
# saving as .bim and .ifcx, and a copy keeps it. A slab without one stays
# concrete, and its .bim line is as before.
import examples/bim-slice/bim_editor.dl

function show bim slab {a 64 bit integer:slabId} of {bim model record:modelValue} labelled {a string:label}:
    execute:
        set found to the bim slab index of slabId in modelValue
        if found's valid = false:
            print (label + (the string form of ": no slab")) as a line
            return nothing
        set slabValue to the item at found's position in (modelValue's slabs's values)
        print ((label + (the string form of ": ")) + ((the string form of slabValue's thickness) + ((the string form of " m, ") + slabValue's material))) as a line

set editor to a new bim editor
set e to the address of editor
set outline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to outline
append (a cad vector2 with x 5.0 and y 0.0) to outline
append (a cad vector2 with x 5.0 and y 4.0) to outline
append (a cad vector2 with x 0.0 and y 4.0) to outline
begin bim transaction in (the address of (editor's documentValue))
set slabId to add bim slab on editor's levelId around outline thick 0.2 to (the address of (editor's documentValue's current))
commit bim transaction in (the address of (editor's documentValue))
show bim slab slabId of editor's documentValue's current labelled (the string form of "new slab")
set plain to the bim file text of editor's documentValue's current
set slabLines to 0
set fileLines to plain split at "\n"
loop cursor from 0 to the length of fileLines:
    set fileLine to the item at cursor in fileLines
    if (the length of fileLine) > 5:
        if (the substring of fileLine from 0 spanning 5 bytes) = (the string form of "slab "):
            set slabLines to slabLines + 1
            print ((the string form of "concrete slab line names its material: ") + (the string form of (fileLine contains "concrete"))) as a line
select bim editor bim slab picked numbered slabId in e
set floorTypes to the bim floor types
set timberIndex to (the length of floorTypes) - 1
print ((the string form of "last floor type: ") + ((the item at timberIndex in floorTypes)'s name)) as a line
choose bim editor floor type timberIndex in e
print editor's message as a line
show bim slab slabId of editor's documentValue's current labelled (the string form of "timber floor")
set propertyRows to the bim property rows of editor
loop cursor from 0 to the length of propertyRows:
    set propertyRow to the item at cursor in propertyRows
    print ((the string form of "  ") + ((propertyRow's label + (the string form of ": ")) + propertyRow's value)) as a line
set reread to the bim model parsed from (the bim file text of editor's documentValue's current)
print ((the string form of ".bim read: ") + (the string form of reread's valid)) as a line
show bim slab slabId of reread's modelValue labelled (the string form of "from .bim")
set exported to the bim ifcx text of editor's documentValue's current identified as (the string form of "floor.ifcx") for project (the string form of "floor") by (the string form of "test") at (the string form of "2026-10-08T00:00:00Z")
set native to the bim native text of ifcx exported
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + (the string form of fromIfcx's valid)) as a line
show bim slab slabId of fromIfcx's modelValue labelled (the string form of "from .ifcx")
print ((the string form of "ifcx names timber: ") + (the string form of (exported contains "timber"))) as a line
copy bim editor selection by (a cad vector2 with x 10.0 and y 0.0) in e
set copyId to (the item at ((the length of (editor's documentValue's current's slabs's values)) - 1) in (editor's documentValue's current's slabs's values))'s id
show bim slab copyId of editor's documentValue's current labelled (the string form of "copy")
type bim editor key 90 in e
type bim editor key 90 in e
show bim slab slabId of editor's documentValue's current labelled (the string form of "undone twice")
