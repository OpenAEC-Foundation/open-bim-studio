# SPDX-License-Identifier: MPL-2.0
# Check physical default placement, not only the existence of generated parts.
import examples/bim-slice/bim_steel_connections.dl

function check steel contact {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Contact datum") at 0.0 with height 6.0 to target
set primaryType to add bim linear type named (the string form of "Primary I") as role bim beam role sized 0.2 by 0.4 round false of (the string form of "steel") to target
set secondaryType to add bim linear type named (the string form of "Secondary I") as role bim beam role sized 0.1 by 0.2 round false of (the string form of "steel") to target
set tubeType to add bim linear type named (the string form of "Square hollow brace") as role bim generic linear role sized 0.08 by 0.08 round false of (the string form of "steel") to target
give bim linear type primaryType profile bim i shape profile web 0.01 flange 0.02 fillet 0.0 fourth 0.0 series 0 in target
give bim linear type secondaryType profile bim i shape profile web 0.006 flange 0.01 fillet 0.0 fourth 0.0 series 0 in target
give bim linear type tubeType profile bim rectangle hollow profile web 0.005 flange 0.0075 fillet 0.0 fourth 0.0 series 0 in target
set primaryId to add bim linear typed primaryType on ground from (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (a cad vector3 with x 0.0, y 6.0 and z 0.0) turned 0.0 to target
set secondaryId to add bim linear typed secondaryType on ground from (a cad vector3 with x 0.0, y 3.0 and z 0.0) to (a cad vector3 with x 4.0, y 3.0 and z 0.0) turned 0.0 to target
set ids to an empty list of a 64 bit integer
append primaryId to ids
append secondaryId to ids
set nodeId to add bim steel connection among ids style 4 in target
check steel contact (nodeId != the bim refused id) named (the string form of "fin plate on an I-section web")
set spec to the item at (the bim connection index of nodeId in modelValue)'s position in (modelValue's connections's values)
set generated to the bim connection evaluation of spec in modelValue
set plate to the item at 0 in (generated's plates's values)
check steel contact ((the absolute value of ((plate's origin's x - (plate's height * 0.5)) - 0.005)) < 1e-9) named (the string form of "plate meets actual web face instead of flange envelope")
set weld to the item at 0 in (generated's welds's values)
check steel contact ((the absolute value of (weld's origin's x - 0.005)) < 1e-9) named (the string form of "fin weld lies on supporting web face")
set bolt to the item at 0 in (generated's fasteners's values)
check steel contact (((the absolute value of (bolt's origin's y - 2.997)) < 1e-9) and (bolt's length >= 0.028)) named (the string form of "bolt head bears on web and shank reaches plate")
ignore set bim linear secondaryId type to primaryType in target
set invalid to the bim connection evaluation of spec in modelValue
check steel contact (invalid's valid = false) named (the string form of "flange interference requests a cope instead of overlapping solids")
set withheld to the bim parts of connection spec in modelValue
check steel contact ((the length of (withheld's values)) = 0) named (the string form of "invalid reprofile withholds connection geometry")
ignore set bim linear secondaryId type to secondaryType in target
ignore delete bim connection nodeId from target
set nodeId to add bim steel connection among ids style 5 in target
set spec to the item at (the bim connection index of nodeId in modelValue)'s position in (modelValue's connections's values)
set generated to the bim connection evaluation of spec in modelValue
set cleatBindings to true
loop cursor from 0 to the length of (generated's fasteners's values):
    set bolt to the item at cursor in (generated's fasteners's values)
    if (the absolute value of bolt's axis's x) > 0.999:
        if bolt's memberId != primaryId:
            set cleatBindings to false
    else:
        if bolt's memberId != secondaryId:
            set cleatBindings to false
check steel contact cleatBindings named (the string form of "cleat feet drill primary and web bolts drill secondary")
ignore delete bim connection nodeId from target
free ids

set firstId to add bim linear typed secondaryType on ground from (a cad vector3 with x 0.0, y 8.0 and z 0.0) to (a cad vector3 with x 4.0, y 8.0 and z 0.0) turned 0.0 to target
set secondId to add bim linear typed secondaryType on ground from (a cad vector3 with x 4.0, y 8.0 and z 0.0) to (a cad vector3 with x 8.0, y 8.0 and z 0.0) turned 0.0 to target
set ids to an empty list of a 64 bit integer
append firstId to ids
append secondId to ids
set nodeId to add bim steel connection among ids style 6 in target
set spec to the item at (the bim connection index of nodeId in modelValue)'s position in (modelValue's connections's values)
set generated to the bim connection evaluation of spec in modelValue
check steel contact (generated's valid and ((the length of (generated's fasteners's values)) = 12)) named (the string form of "splice has twelve distinct bolts")
set firstHoles to 0
set secondHoles to 0
loop cursor from 0 to the length of (generated's voids's values):
    set hole to the item at cursor in (generated's voids's values)
    if hole's kind = 1:
        if hole's memberId = firstId:
            set firstHoles to firstHoles + 1
        if hole's memberId = secondId:
            set secondHoles to secondHoles + 1
check steel contact ((firstHoles = 6) and (secondHoles = 6)) named (the string form of "splice drills both member halves")
set distinct to true
loop cursor from 0 to the length of (generated's fasteners's values):
    set bolt to the item at cursor in (generated's fasteners's values)
    loop previous from 0 to cursor:
        if (the cad distance from bolt's origin to (the item at previous in (generated's fasteners's values))'s origin) < 1e-9:
            set distinct to false
check steel contact distinct named (the string form of "paired web covers share one through-bolt group")
free ids

set columnId to add bim linear typed primaryType on ground from (a cad vector3 with x 10.0, y 0.0 and z 0.0) to (a cad vector3 with x 10.0, y 0.0 and z 6.0) turned 0.0 to target
set braceId to add bim linear typed tubeType on ground from (a cad vector3 with x 10.0, y 0.0 and z 3.0) to (a cad vector3 with x 14.0, y 0.0 and z 6.0) turned 0.0 to target
set ids to an empty list of a 64 bit integer
append columnId to ids
append braceId to ids
set nodeId to add bim steel connection among ids style 7 in target
check steel contact (nodeId != the bim refused id) named (the string form of "sloping rectangular hollow brace gusset")
set spec to the item at (the bim connection index of nodeId in modelValue)'s position in (modelValue's connections's values)
set generated to the bim connection evaluation of spec in modelValue
set derived to the bim parts of connection spec in modelValue
set platePart to the item at 0 in (derived's values)
set plateFrame to the bim frame of linear platePart's element in modelValue
check steel contact ((the absolute value of plateFrame's widthAxis's z) > 0.999999) named (the string form of "gusset seating edge follows the primary axis")
set weld to the item at 0 in (generated's welds's values)
check steel contact (((the absolute value of (weld's origin's x - 0.005)) < 1e-9) and ((the absolute value of weld's axis's z) > 0.999999)) named (the string form of "sloping gusset weld remains on the primary face")
set bolt to the item at 0 in (generated's fasteners's values)
check steel contact (((the absolute value of (bolt's origin's y + 0.04)) < 1e-9) and (bolt's length > 0.1)) named (the string form of "hollow brace bolts span both walls and external plate")
free ids
