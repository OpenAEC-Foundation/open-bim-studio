# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/bim_grid_controls.dl

function check grid control {boolean:accepted} named {a string:captionText}:
    execute:
        if accepted = false:
            print ((the string form of "FAIL: ") + captionText) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + captionText) as a line

set lowPixel to a cad vector2 with x 0.0 and y 0.0
set highPixel to a cad vector2 with x 100.0 and y 100.0
set controlValue to the bim grid add placement from (a cad vector2 with x 40.0 and y 30.0) to (a cad vector2 with x 40.0 and y 60.0) between lowPixel and (a cad vector2 with x 200.0 and y 200.0)
check grid control (controlValue's visible and ((the cad distance from controlValue's point to (a cad vector2 with x 40.0 and y 97.0)) < 1e-9)) named (the string form of "normal grid keeps its outward add position")
set controlValue to the bim grid add placement from (a cad vector2 with x 50.0 and y 80.0) to (a cad vector2 with x 50.0 and y 5.0) between lowPixel and highPixel
check grid control controlValue's visible named (the string form of "visible head near the top edge keeps an add button")
check grid control (((the absolute value of (controlValue's point's x - 50.0)) >= 25.0) and ((controlValue's point's y >= 12.0) and (controlValue's point's y <= 88.0))) named (the string form of "edge fallback is beside the head and fully inside the viewport")
set controlValue to the bim grid add placement from (a cad vector2 with x 50.0 and y 45.0) to (a cad vector2 with x 50.0 and y -30.0) between lowPixel and highPixel
check grid control (controlValue's visible and ((the cad distance from controlValue's point to (a cad vector2 with x 50.0 and y 82.0)) < 1e-9)) named (the string form of "other visible head supplies the add button")
set controlValue to the bim grid add placement from (a cad vector2 with x -30.0 and y -30.0) to (a cad vector2 with x -30.0 and y 130.0) between lowPixel and highPixel
check grid control (controlValue's visible = false) named (the string form of "fully invisible grid has no detached button")
set controlValue to the bim grid add placement from (a cad vector2 with x -30.0 and y 50.0) to (a cad vector2 with x 130.0 and y 50.0) between lowPixel and highPixel
check grid control (controlValue's visible = false) named (the string form of "a crossing line without visible heads has no detached button")
set controlValue to the bim grid add placement from (a cad vector2 with x 3.0 and y 60.0) to (a cad vector2 with x 3.0 and y 3.0) between lowPixel and highPixel
check grid control (controlValue's visible and (((controlValue's point's x >= 12.0) and (controlValue's point's x <= 88.0)) and ((controlValue's point's y >= 12.0) and (controlValue's point's y <= 88.0)))) named (the string form of "corner fallback keeps the entire fixed size button visible")
