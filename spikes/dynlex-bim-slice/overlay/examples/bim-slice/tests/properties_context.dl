# Empty selection follows its context; level and project settings are explicit.
import examples/bim-slice/bim_editor.dl

function check properties context {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function context rows of {bim editor record:editor} contain {a string:label} showing {a string:value}:
    execute:
        set rows to the bim property rows of editor
        set matched to false
        loop cursor from 0 to the length of rows:
            set row to the item at cursor in rows
            if (row's label = label) and (row's value = value):
                set matched to true
        free rows
        return matched

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set planId to add bim view of kind bim plan view kind named (the string form of "Ground plan") on editor's levelId to target
set modelId to add bim view of kind bim model view kind named (the string form of "Model view") on editor's levelId to target
set sectionId to add bim section view from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to target
set editor's planViewId to planId
set editor's propertiesViewId to planId
check properties context (context rows of editor contain (the string form of "Kind") showing (the string form of "Floor plan")) named (the string form of "empty selection shows active plan")
check properties context ((context rows of editor contain (the string form of "IFC class") showing (the string form of "IfcBuildingStorey")) = false) named (the string form of "active plan does not show level properties")
check properties context ((context rows of editor contain (the string form of "Project") showing (the string form of "")) = false) named (the string form of "active plan does not show project settings")
set editor's propertiesViewId to modelId
check properties context (context rows of editor contain (the string form of "Kind") showing (the string form of "3D view")) named (the string form of "empty selection shows active model view")
set editor's propertiesViewId to sectionId
check properties context (context rows of editor contain (the string form of "Kind") showing (the string form of "Section")) named (the string form of "empty selection shows active section")
set sheetId to add bim sheet numbered (the string form of "A01") named (the string form of "Plans") on paper 3 landscape true to target
set editor's sheetId to sheetId
set editor's propertiesViewId to bim sheet properties context
check properties context (context rows of editor contain (the string form of "Number") showing (the string form of "A01")) named (the string form of "empty selection shows active sheet")
check properties context ((the bim properties view of editor) = the bim refused id) named (the string form of "sheet context cannot edit the last plan by accident")
select bim editor bim level picked numbered editor's levelId in e
check properties context (context rows of editor contain (the string form of "IFC class") showing (the string form of "IfcBuildingStorey")) named (the string form of "explicit level selection takes priority over sheet")
check properties context ((context rows of editor contain (the string form of "Sheet") showing (the string form of "")) = false) named (the string form of "selected level has no mixed sheet properties")
select bim editor bim nothing picked numbered (the bim refused id) in e
check properties context (context rows of editor contain (the string form of "Number") showing (the string form of "A01")) named (the string form of "deselect returns to sheet properties")
type bim editor key 2198 in e
check properties context (context rows of editor contain (the string form of "Project") showing (the string form of "")) named (the string form of "Project settings command remains explicit")
check properties context ((the bim properties view of editor) = the bim refused id) named (the string form of "project settings cannot edit a view by accident")
type bim editor key bim escape key code in e
check properties context (editor's propertiesViewId = the bim refused id) named (the string form of "Escape requests active-tab context restoration")
set editor's propertiesViewId to modelId
select bim editor bim level picked numbered editor's levelId in e
select bim editor bim nothing picked numbered (the bim refused id) in e
check properties context (context rows of editor contain (the string form of "Kind") showing (the string form of "3D view")) named (the string form of "deselect restores model view without plan fallback")
