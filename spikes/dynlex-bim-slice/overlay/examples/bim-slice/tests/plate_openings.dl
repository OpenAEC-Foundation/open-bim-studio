# SPDX-License-Identifier: MPL-2.0
# Multiple rectangular through-openings: persistence, net geometry and refusal.
import examples/bim-slice/bim_file.dl
import examples/bim-slice/bim_ifcx.dl
import examples/bim-slice/bim_ifcx_read.dl

function check plate opening {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the opening test rectangle at {a 64 bit floating-point number:originX} and {a 64 bit floating-point number:originY} wide {a 64 bit floating-point number:width} deep {a 64 bit floating-point number:depth}:
    execute:
        set corners to an empty list of a cad vector2
        append (a cad vector2 with x originX and y originY) to corners
        append (a cad vector2 with x (originX + width) and y originY) to corners
        append (a cad vector2 with x (originX + width) and y (originY + depth)) to corners
        append (a cad vector2 with x originX and y (originY + depth)) to corners
        return corners

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "First") at 3.0 with height 3.0 to target
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "screed", 0.05)) to layers
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to layers
set floorType to add bim planar type named (the string form of "Floor") as role bim floor planar role with layers to target
set outlinePoints to the opening test rectangle at 0.0 and 0.0 wide 10.0 deep 8.0
set floorId to add bim plate typed floorType on ground around outlinePoints at top 0.0 to target
set firstHole to the opening test rectangle at 1.0 and 1.0 wide 2.0 deep 1.0
set secondHole to the opening test rectangle at 5.0 and 3.0 wide 1.0 deep 2.0
check plate opening ((add bim plate opening on floorId around firstHole in target) = 1) named (the string form of "first ID")
check plate opening ((add bim plate opening on floorId around secondHole in target) = 2) named (the string form of "second ID retains first")
set plateValue to the item at 0 in (modelValue's slabs's values)
check plate opening ((the bim net plan area of plate plateValue in modelValue) = 76.0) named (the string form of "net area subtracts both holes")
set built to the bim slab solid of plateValue in modelValue
check plate opening (built's status = 0) named (the string form of "solid builds")
set meshValue to an empty fast mesh
append fast mesh of built's shape to (the address of meshValue)
check plate opening ((the fast mesh flaw of meshValue) = 0) named (the string form of "perforated mesh closed")
check plate opening ((the absolute value of ((the bim volume of mesh meshValue) - 19.0)) < 0.000001) named (the string form of "mesh net volume")
set layerSolids to the bim layer solids of plate plateValue in modelValue
check plate opening ((the length of (layerSolids's values)) = 2) named (the string form of "both layers exist")
set totalVolume to 0.0
loop layerCursor from 0 to the length of (layerSolids's values):
    set layerMesh to an empty fast mesh
    append fast mesh of (the item at layerCursor in (layerSolids's values))'s shape to (the address of layerMesh)
    check plate opening ((the fast mesh flaw of layerMesh) = 0) named (the string form of "layer mesh closed")
    set totalVolume to totalVolume + (the bim volume of mesh layerMesh)
check plate opening ((the absolute value of (totalVolume - 19.0)) < 0.000001) named (the string form of "layer volumes match combined volume")
set fileText to the bim file text of modelValue
set nativeReading to the bim model parsed from fileText
check plate opening (nativeReading's valid and ((the bim file text of nativeReading's modelValue) = fileText)) named (the string form of "native exact roundtrip")
set ifcxText to the bim ifcx text of modelValue identified as (the string form of "openings.ifcx") for project (the string form of "Openings") by (the string form of "test") at (the string form of "2026-10-21T00:00:00Z")
check plate opening ((the index of (the string form of "bsi::ifc::prop::NetArea\": 76") in ifcxText) >= 0) named (the string form of "IFCX net area agrees")
set nativeResult to the bim native text of ifcx ifcxText
check plate opening nativeResult's valid named (the string form of "IFCX native payload")
set fromIfcx to the bim model parsed from nativeResult's text
check plate opening (fromIfcx's valid and ((the bim file text of fromIfcx's modelValue) = fileText)) named (the string form of "IFCX exact roundtrip")
set overlapRing to the opening test rectangle at 2.0 and 1.0 wide 2.0 deep 1.0
check plate opening ((add bim plate opening on floorId around overlapRing in target) = -1) named (the string form of "overlap rejected")
set touchingRing to the opening test rectangle at 0.0 and 5.0 wide 2.0 deep 1.0
check plate opening ((add bim plate opening on floorId around touchingRing in target) = -1) named (the string form of "outer boundary touch rejected")
set smallerRing to the opening test rectangle at 0.0 and 0.0 wide 4.0 deep 4.0
check plate opening ((set bim slab floorId outline to smallerRing in target) = false) named (the string form of "contour edit cannot abandon second hole")
check plate opening ((explode bim plate floorId in target) = 0) named (the string form of "explode explicitly refused")
check plate opening ((the bim file text of modelValue) = fileText) named (the string form of "refusals leave model unchanged")
set earlier to the bim snapshot of modelValue
check plate opening (delete bim plate opening 1 on floorId in target) named (the string form of "delete first")
check plate opening ((the bim net plan area of plate plateValue in earlier) = 76.0) named (the string form of "snapshot retains holes")
check plate opening ((add bim plate opening on floorId around firstHole in target) = 3) named (the string form of "deleted ID is not reused")
check plate opening (delete bim slab floorId from target) named (the string form of "delete host")
check plate opening (((the bim setting (bim plate opening count setting) of floorId in modelValue)'s found) = false) named (the string form of "delete removes hole metadata")
