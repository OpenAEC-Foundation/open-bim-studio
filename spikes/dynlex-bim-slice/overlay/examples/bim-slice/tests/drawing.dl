# SPDX-License-Identifier: MPL-2.0
# Plan and section cuts and associative dimensions of the slice, and an
# incremental plan after an edit, which must equal a fresh cut.
import examples/bim-slice/bim_drawing.dl

function check bim drawing {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print label as a line
            @intrinsic("call", "libc", "exit", nothing, 1)

function a bim test point at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y}:
    execute:
        return a cad vector2 with x x and y y

function the bim rounded text of {a 64 bit floating-point number:value}:
    execute:
        set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, value * 10000.0)
        return the string form of (scaled / 10000.0)

function report bim view {bim view record:viewValue} labelled {a string:label}:
    execute:
        set total to 0.0
        set polygons to a cad topology list of a bim cut polygon record
        loop sourceCursor from 0 to the length of (viewValue's sources's values):
            set sourcePolygons to (the item at sourceCursor in (viewValue's sources's values))'s polygons's values
            loop cursor from 0 to the length of sourcePolygons:
                append (the item at cursor in sourcePolygons) to (polygons's values)
        loop cursor from 0 to the length of (polygons's values):
            set polygon to the item at cursor in (polygons's values)
            set area to the absolute value of (the bim area of polygon)
            set total to total + area
            set line to (label + (the string form of " element ")) + (the string form of polygon's elementId)
            set line to ((line + (the string form of " corners ")) + (the string form of (the length of (polygon's points's values)))) + (the string form of " area ")
            set least to (the item at 0 in (polygon's points's values))'s x
            loop corner from 1 to the length of (polygon's points's values):
                set least to the minimum of least and (the item at corner in (polygon's points's values))'s x
            set line to (line + (the bim rounded text of area)) + (the string form of " min x ")
            print (line + (the bim rounded text of least)) as a line
        set line to (label + (the string form of " polygons ")) + (the string form of (the bim polygon count of viewValue))
        print ((line + (the string form of " total ")) + (the bim rounded text of total)) as a line
        print ((label + (the string form of " refused ")) + (the string form of viewValue's refused)) as a line

set modelValue to an empty bim model
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to (the address of modelValue)
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.12)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.1)) to layerValues
set exteriorType to add bim wall type named (the string form of "Cavity wall") with layerValues to (the address of modelValue)
free layerValues
set innerLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.1)) to innerLayers
set interiorType to add bim wall type named (the string form of "Partition") with innerLayers to (the address of modelValue)
free innerLayers
set south to add bim wall typed exteriorType on storey from (a bim test point at 0.0 and 0.0) to (a bim test point at 6.0 and 0.0) to (the address of modelValue)
set east to add bim wall typed exteriorType on storey from (a bim test point at 6.0 and 0.0) to (a bim test point at 6.0 and 4.0) to (the address of modelValue)
set north to add bim wall typed exteriorType on storey from (a bim test point at 6.0 and 4.0) to (a bim test point at 0.0 and 4.0) to (the address of modelValue)
set west to add bim wall typed exteriorType on storey from (a bim test point at 0.0 and 4.0) to (a bim test point at 0.0 and 0.0) to (the address of modelValue)
set middle to add bim wall typed interiorType on storey from (a bim test point at 3.0 and 0.0) to (a bim test point at 3.0 and 4.0) to (the address of modelValue)
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to (the address of modelValue)
set window to add bim opening typed windowType in south at 1.5 to (the address of modelValue)
set door to add bim opening typed windowType in middle at 2.0 to (the address of modelValue)
set evaluation to the bim evaluation of modelValue after (an empty bim evaluation)
set planBefore to the bim plan of evaluation at 0.0 cut at 1.2
report bim view planBefore labelled (the string form of "plan")
report bim view (the bim section of evaluation from (a bim test point at 1.5 and -1.0) to (a bim test point at 1.5 and 5.0)) labelled (the string form of "section")

set clearDimension to add bim dimension from (a bim reference to west feature bim wall interior feature) to (a bim reference to middle feature bim wall exterior feature) to (the address of modelValue)
set widthDimension to add bim dimension from (a bim reference to window feature bim opening left feature) to (a bim reference to window feature bim opening right feature) to (the address of modelValue)
set clearValue to the item at (the bim dimension index of clearDimension in modelValue)'s position in (modelValue's dimensions's values)
set openingValue to the item at (the bim dimension index of widthDimension in modelValue)'s position in (modelValue's dimensions's values)
print ((the string form of "clear width ") + (the bim rounded text of (the bim measure of clearValue in modelValue)'s value)) as a line
print ((the string form of "opening width ") + (the bim rounded text of (the bim measure of openingValue in modelValue)'s value)) as a line
check bim drawing (move bim wall middle to (a bim test point at 2.5 and 0.0) and (a bim test point at 2.5 and 4.0) in (the address of modelValue)) named "move partition"
print ((the string form of "clear width after move ") + (the bim rounded text of (the bim measure of clearValue in modelValue)'s value)) as a line
set evaluationAfter to the bim evaluation of modelValue after evaluation
update bim view (the address of planBefore) from evaluationAfter
set line to (the string form of "after move rebuilt ") + (the string form of evaluationAfter's rebuilt)
print ((line + (the string form of " recut ")) + (the string form of planBefore's recut)) as a line
report bim view planBefore labelled (the string form of "incremental plan")
report bim view (the bim plan of evaluationAfter at 0.0 cut at 1.2) labelled (the string form of "fresh plan")
set crossed to add bim dimension from (a bim reference to south feature bim wall exterior feature) to (a bim reference to west feature bim wall exterior feature) to (the address of modelValue)
set crossedValue to the item at (the bim dimension index of crossed in modelValue)'s position in (modelValue's dimensions's values)
print ((the string form of "crossed sides valid ") + (the string form of ((the bim measure of crossedValue in modelValue)'s valid as an integer))) as a line
