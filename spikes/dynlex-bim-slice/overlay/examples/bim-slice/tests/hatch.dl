# SPDX-License-Identifier: MPL-2.0
# Hatching geometry: the layer bands of a cavity wall in plan and where a
# section crosses it, a cut clipped to each band, and hatch lines and a
# zigzag clipped to a ring, checked against their exact extents.
import examples/bim-slice/bim_hatch.dl

function the hatch test text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.6g", value)
        return the substring of buffer from 0 spanning written bytes

function the hatch test length of {a pointer to a list:segments}:
    execute:
        set total to 0.0
        set cursor to 0
        loop while cursor < the length of segments:
            set total to total + (the cad distance from (the item at cursor in segments) to (the item at (cursor + 1) in segments))
            set cursor to cursor + 2
        return total

function the hatch test area of {a pointer to a list:corners}:
    execute:
        set total to 0.0
        set count to the length of corners
        loop cursor from 0 to count:
            set here to the item at cursor in corners
            set following to the item at (the remainder of (cursor + 1) divided by count) in corners
            set total to total + ((here's x * following's y) - (following's x * here's y))
        return (the absolute value of total) * 0.5

set modelValue to an empty bim model
set storey to add bim level named (the string form of "Level") at 0.0 with height 3.0 to (the address of modelValue)
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layers
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.12)) to layers
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.1)) to layers
set cavity to add bim wall type named (the string form of "Cavity") with layers to (the address of modelValue)
free layers
# A wall along x from 0 to 4: its exterior is on the right, toward -y.
set wallId to add bim wall typed cavity on storey from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to (the address of modelValue)
set wallValue to the item at 0 in (modelValue's walls's values)
set footprint to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y -0.16) to footprint
append (a cad vector2 with x 4.0 and y -0.16) to footprint
append (a cad vector2 with x 4.0 and y 0.16) to footprint
append (a cad vector2 with x 0.0 and y 0.16) to footprint
set planBands to the bim plan hatch bands of wallValue in modelValue
loop cursor from 0 to the length of (planBands's values):
    set band to the item at cursor in (planBands's values)
    set piece to the bim ring footprint within band
    set line to (((the string form of "plan band ") + band's material) + (the string form of " area ")) + (the hatch test text of (the hatch test area of piece))
    print line as a line
    free piece

# A section across the wall at x = 1, from south to north, and one along it.
set crossing to the bim section hatch bands of wallValue in modelValue from (a cad vector2 with x 1.0 and y -1.0) to (a cad vector2 with x 1.0 and y 1.0)
loop cursor from 0 to the length of (crossing's values):
    set band to the item at cursor in (crossing's values)
    print ((((the string form of "section band ") + band's material) + (the string form of " from ")) + (((the hatch test text of band's low) + (the string form of " to ")) + (the hatch test text of band's high))) as a line
set alongWall to the bim section hatch bands of wallValue in modelValue from (a cad vector2 with x 0.0 and y 0.1) to (a cad vector2 with x 4.0 and y 0.1)
print ((the string form of "section along the wall bands ") + (the string form of (the length of (alongWall's values)))) as a line
print ((the string form of "  material ") + (the item at 0 in (alongWall's values))'s material) as a line

# Hatch lines at 0 degrees every 2 pixels from y = 1 across a 10 x 10 pixel
# square: five lines of 10 pixels, at y = 1, 3, 5, 7 and 9. At 45 degrees the
# total is about the area divided by the spacing. A zigzag across the full
# square with a half period of 5 pixels is two strokes of sqrt(125).
set square to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to square
append (a cad vector2 with x 10.0 and y 0.0) to square
append (a cad vector2 with x 10.0 and y 10.0) to square
append (a cad vector2 with x 0.0 and y 10.0) to square
set segments to an empty list of a cad vector2
append bim hatch lines of square at 0.0 every 2.0 from (a cad vector2 with x 0.0 and y 1.0) into segments
print ((the string form of "level hatch segments ") + (the string form of ((the length of segments) / 2))) as a line
print ((the string form of "level hatch length ") + (the hatch test text of (the hatch test length of segments))) as a line
clear segments
append bim hatch lines of square at 45.0 every 2.0 from (a cad vector2 with x 0.0 and y 0.0) into segments
print ((the string form of "diagonal hatch length ") + (the hatch test text of (the hatch test length of segments))) as a line
clear segments
append bim zigzag of square across (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 10.0) along (a cad vector2 with x 1.0 and y 0.0) into segments
print ((the string form of "zigzag segments ") + (the string form of ((the length of segments) / 2))) as a line
print ((the string form of "zigzag length ") + (the hatch test text of (the hatch test length of segments))) as a line
print ((the string form of "insulation zigzag ") + (the string form of (the bim hatch pattern of material (the string form of "Mineral insulation"))'s zigzag)) as a line
