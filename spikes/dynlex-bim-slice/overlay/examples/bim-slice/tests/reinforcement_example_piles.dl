# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/test_support/reinforcement_fixture.dl

set modelValue to the reinforcement fixture named (the string form of "reinforcement-pile-foundation.bim") counting 5
check reinforcement fixture (((the length of (modelValue's linears's values)) = 4) and ((the length of (modelValue's slabs's values)) = 1)) named (the string form of "four piles and pile cap load")
set cagesValid to true
loop index from 0 to 4:
    set cage to the bim hostbound reinforcement (the item at index in (modelValue's reinforcements's values)) in modelValue
    if ((cage's start's z != -3.0) or (cage's finish's z != -0.5)) or ((cage's topCount != 2) or (cage's bottomCount != 2)):
        set cagesValid to false
check reinforcement fixture cagesValid named (the string form of "pile cages follow four vertical hosts")
set cap to the bim hostbound reinforcement (the item at 4 in (modelValue's reinforcements's values)) in modelValue
check reinforcement fixture ((cap's kind = 5) and ((cap's faceMask = 3) and (cap's spacing = 0.2))) named (the string form of "pile cap retains two face area reinforcement")
