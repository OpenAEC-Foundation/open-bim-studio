# SPDX-License-Identifier: MPL-2.0
# A building system's parts: a 6 x 3 m system in bays of at most 1.2 m and
# rows of at most 1.5 m has 6 mullions, 3 transoms and 10 panels. A click's
# place along the line and its height name the part there. A panel given a
# layered planar type (a sandwich panel of aluminium, PIR and aluminium) is
# built of one part per layer, stacked across the line; giving the type to
# the whole system gives it to every panel without its own. The panel types
# survive the file and IfcX. A moved mullion (whole millimetres, kept between
# its neighbours) widens one bay and narrows the next, and survives too.
import examples/bim-slice/bim_editor.dl

function show bim system parts of {bim model record:modelValue} labelled {a string:title}:
    execute:
        loop cursor from 0 to the length of (modelValue's curtains's values):
            set curtainValue to the item at cursor in (modelValue's curtains's values)
            set curtainParts to the bim parts of curtain wall curtainValue in modelValue
            set mullions to 0
            set transoms to 0
            set glassPanels to 0
            set layerParts to 0
            loop partCursor from 0 to the length of (curtainParts's values):
                set derivedPart to the item at partCursor in (curtainParts's values)
                if derivedPart's kind's name = (the string form of "Mullion"):
                    set mullions to mullions + 1
                else if derivedPart's kind's name = (the string form of "Transom"):
                    set transoms to transoms + 1
                else if derivedPart's kind's name = (the string form of "Panel"):
                    set glassPanels to glassPanels + 1
                else:
                    set layerParts to layerParts + 1
            print ((title + (the string form of ": mullions ")) + ((the string form of mullions) + ((the string form of ", transoms ") + ((the string form of transoms) + ((the string form of ", glass panels ") + ((the string form of glassPanels) + ((the string form of ", layer parts ") + (the string form of layerParts)))))))) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to target
set sandwichLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "aluminium", 0.002)) to sandwichLayers
append (@intrinsic("construct", a bim layer record, the string form of "PIR", 0.1)) to sandwichLayers
append (@intrinsic("construct", a bim layer record, the string form of "aluminium", 0.002)) to sandwichLayers
set sandwich to add bim wall type named (the string form of "Sandwich panel") with sandwichLayers to target
free sandwichLayers
set curtainId to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
show bim system parts of modelValue labelled (the string form of "glass")
set curtainValue to the item at 0 in (modelValue's curtains's values)
print (the bim system part name of curtainValue coded (the bim system part code of curtainValue at 1.2 and 1.0 in modelValue) in modelValue) as a line
print (the bim system part name of curtainValue coded (the bim system part code of curtainValue at 0.6 and 1.5 in modelValue) in modelValue) as a line
print (the bim system part name of curtainValue coded (the bim system part code of curtainValue at 0.6 and 0.7 in modelValue) in modelValue) as a line
print (the bim system part name of curtainValue coded (the bim system part code of curtainValue at 1.8 and 2.2 in modelValue) in modelValue) as a line
print ((the string form of "off the system: ") + (the string form of (the bim system part code of curtainValue at 7.0 and 1.0 in modelValue))) as a line
set bim panel 3 of system curtainId to type sandwich in target
show bim system parts of modelValue labelled (the string form of "panel 4 sandwich")
print (the bim system part name of curtainValue coded 2003 in modelValue) as a line
set bim panel -1 of system curtainId to type sandwich in target
show bim system parts of modelValue labelled (the string form of "all sandwich")
set bim panel -1 of system curtainId to type (the bim refused id) in target
show bim system parts of modelValue labelled (the string form of "system glass again")
print ((the string form of "move mullion 2 to 1.75: ") + (the string form of (move bim system line 1 of curtainId to 1.7504 in target))) as a line
print ((the string form of "move it past mullion 3: ") + (the string form of (move bim system line 1 of curtainId to 2.35 in target))) as a line
print ((the string form of "move the end mullion: ") + (the string form of (move bim system line 0 of curtainId to 0.5 in target))) as a line
set curtainValue to the item at 0 in (modelValue's curtains's values)
print (the bim system part name of curtainValue coded (the bim system part code of curtainValue at 1.74 and 1.0 in modelValue) in modelValue) as a line
set firstBay to the bim system part box of curtainValue coded 2000 in modelValue
set secondBay to the bim system part box of curtainValue coded 2002 in modelValue
print ((the string form of "bay widths: ") + ((the bim length (firstBay's high's x - firstBay's low's x) in units 0) + ((the string form of ", ") + (the bim length (secondBay's high's x - secondBay's low's x) in units 0)))) as a line
print ((the string form of "moved lines: ") + (the bim grid line text of system curtainId in modelValue)) as a line
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", ") + reread's message))) as a line
show bim system parts of reread's modelValue labelled (the string form of "from .bim")
set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "s.ifcx") for project (the string form of "s") by (the string form of "test") at (the string form of "2026-10-12T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of ", ") + fromIfcx's message))) as a line
show bim system parts of fromIfcx's modelValue labelled (the string form of "from .ifcx")
print ((the string form of "from .bim mullion 2: ") + (the bim length (the bim mullion 1 along (the item at 0 in (reread's modelValue's curtains's values)) in reread's modelValue) in units 0)) as a line
print ((the string form of "from .ifcx mullion 2: ") + (the bim length (the bim mullion 1 along (the item at 0 in (fromIfcx's modelValue's curtains's values)) in fromIfcx's modelValue) in units 0)) as a line
