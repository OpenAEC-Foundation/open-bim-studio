# SPDX-License-Identifier: MPL-2.0
# Drawing rules: drawing types kept in the model, each inheriting from its
# parent what it does not set. The library's Structural tree: a pile plan
# shows piles and fades walls, and inherits from Structural that doors are
# hidden and grids dimensioned. Showing doors on Structural shows them in
# the pile plan too. A plan view following the pile plan draws by its rules
# while Automatic, by its own when Manual; the types and the link survive
# the file and IfcX.
import examples/bim-slice/bim_file.dl
import examples/bim-slice/bim_ifcx.dl
import examples/bim-slice/bim_ifcx_read.dl

function describe bim drawing type named {a string:title} in {bim model record:modelValue}:
    execute:
        set typeId to the bim drawing type named title in modelValue
        set rules to the bim rules of drawing type typeId in modelValue
        set line to title + (the string form of ":")
        set line to (line + (the string form of " piles ")) + (the string form of (bim category bim pile category is visible in rules))
        set line to (line + (the string form of ", walls halftone ")) + (the string form of (bim category bim wall category is halftone in rules))
        set line to (line + (the string form of ", doors ")) + (the string form of (bim category bim door category is visible in rules))
        set line to (line + (the string form of ", grids ")) + (the string form of (bim category bim grid category is visible in rules))
        set line to (line + (the string form of ", grid dimensions ")) + (the string form of (bim annotation bim grid dimensions annotation applies to drawing type typeId in modelValue))
        set line to (line + (the string form of ", pile numbers ")) + (the string form of (bim annotation bim pile numbers annotation applies to drawing type typeId in modelValue))
        set line to (line + (the string form of ", beam labels ")) + (the string form of (bim annotation bim beam labels annotation applies to drawing type typeId in modelValue))
        set line to (line + (the string form of ", room labels ")) + (the string form of (bim annotation bim room labels annotation applies to drawing type typeId in modelValue))
        print line as a line

function list bim drawing types of {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's drawingTypes's values):
            set drawingType to the item at cursor in (modelValue's drawingTypes's values)
            set parentName to the string form of "-"
            set parentFound to the bim drawing type index of drawingType's parentId in modelValue
            if parentFound's valid:
                set parentName to (the item at parentFound's position in (modelValue's drawingTypes's values))'s name
            print (((the string form of "  ") + drawingType's name) + ((the string form of " < ") + parentName)) as a line

function describe bim view {a 64 bit integer:viewId} in {bim model record:modelValue} labelled {a string:label}:
    execute:
        set viewValue to the item at (the bim view index of viewId in modelValue)'s position in (modelValue's views's values)
        set typeName to the string form of "none"
        set typeFound to the bim drawing type index of viewValue's drawingTypeId in modelValue
        if typeFound's valid:
            set typeName to (the item at typeFound's position in (modelValue's drawingTypes's values))'s name
        set rules to the bim rules of view viewValue in modelValue
        print ((label + (the string form of ": ")) + (((viewValue's name + (the string form of ", type ")) + typeName) + (((the string form of ", automatic ") + (the string form of viewValue's automatic)) + ((the string form of ", piles shown ") + (the string form of (bim category bim pile category is visible in rules)))))) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
ensure bim drawing types in target
print ((the string form of "drawing types: ") + (the string form of (the length of (modelValue's drawingTypes's values)))) as a line
list bim drawing types of modelValue
describe bim drawing type named (the string form of "Floor plan") in modelValue
describe bim drawing type named (the string form of "Structural plan") in modelValue
describe bim drawing type named (the string form of "Pile plan") in modelValue
set structural to the bim drawing type named (the string form of "Structural") in modelValue
ignore set bim drawing type structural setting 0 at bim door category to 1 in target
print (the string form of "doors shown on Structural:") as a line
describe bim drawing type named (the string form of "Pile plan") in modelValue
ignore set bim drawing type structural setting 0 at bim door category to -1 in target
print (the string form of "Structural's doors inherited again (no parent: the floor plan default):") as a line
describe bim drawing type named (the string form of "Pile plan") in modelValue
set pileType to the bim drawing type named (the string form of "Pile plan") in modelValue
set pileView to add bim plan view following drawing type pileType named (the string form of "Pile plan - Ground floor") on storey to target
describe bim view pileView in modelValue labelled (the string form of "view")
set viewValue to the item at (the bim view index of pileView in modelValue)'s position in (modelValue's views's values)
set manualRules to the bim rules of view viewValue
toggle bim category bim pile category visibility in (the address of manualRules)
store bim view (the bim view (the bim view viewValue ruled by manualRules) made manual) in target
describe bim view pileView in modelValue labelled (the string form of "manual, piles hidden by hand")
set viewValue to the item at (the bim view index of pileView in modelValue)'s position in (modelValue's views's values)
store bim view (the bim view viewValue made automatic) in target
describe bim view pileView in modelValue labelled (the string form of "automatic again")
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of " ") + reread's message))) as a line
print ((the string form of "drawing types: ") + (the string form of (the length of (reread's modelValue's drawingTypes's values)))) as a line
describe bim drawing type named (the string form of "Pile plan") in reread's modelValue
describe bim view pileView in reread's modelValue labelled (the string form of "view from .bim")
set exported to the bim ifcx text of modelValue identified as (the string form of "d.ifcx") for project (the string form of "d") by (the string form of "test") at (the string form of "2026-10-12T00:00:00Z")
set native to the bim native text of ifcx exported
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of " ") + fromIfcx's message))) as a line
print ((the string form of "drawing types: ") + (the string form of (the length of (fromIfcx's modelValue's drawingTypes's values)))) as a line
describe bim drawing type named (the string form of "Pile plan") in fromIfcx's modelValue
describe bim view pileView in fromIfcx's modelValue labelled (the string form of "view from .ifcx")
