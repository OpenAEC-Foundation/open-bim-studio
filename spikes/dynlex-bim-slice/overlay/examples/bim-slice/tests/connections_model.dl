# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/bim_connections.dl
import examples/bim-slice/bim_file.dl

function check connection model {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set documentValue to a new bim document
set target to the address of (documentValue's current)
set levelId to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set typeId to add bim linear type named (the string form of "Steel") as role bim beam role sized 0.2 by 0.4 round false of (the string form of "steel") to target
set zero to a cad vector3 with x 0.0, y 0.0 and z 0.0
set firstId to add bim linear typed typeId on levelId from zero to (a cad vector3 with x 3.0, y 0.0 and z 0.0) turned 0.0 to target
set secondId to add bim linear typed typeId on levelId from zero to (a cad vector3 with x 0.0, y 3.0 and z 0.0) turned 0.0 to target
set identities to an empty list of a 64 bit integer
append firstId to identities
append secondId to identities
begin bim transaction in (the address of documentValue)
set nodeId to add bim connection among identities category 1 style 0 in target
check connection model (nodeId != the bim refused id) named (the string form of "create linked node")
check connection model (add bim connection part of kind 0 to node nodeId in target) named (the string form of "add plate")
check connection model (add bim connection part of kind 1 to node nodeId in target) named (the string form of "add bolt group")
check connection model (add bim connection part of kind 2 to node nodeId in target) named (the string form of "add screw group")
commit bim transaction in (the address of documentValue)
set spec to the item at 0 in (target's connections's values)
set generated to the bim connection evaluation of spec in documentValue's current
check connection model (generated's valid and ((the length of (generated's fasteners's values)) = 8)) named (the string form of "derive distinct fastening groups")
set text to the bim file text of documentValue's current
set readback to the bim model parsed from text
check connection model readback's valid named (the string form of "connection file parses")
check connection model ((the bim file text of readback's modelValue) = text) named (the string form of "connection parameters round trip")
check connection model ((add bim connection among identities category 0 style 0 in target) = the bim refused id) named (the string form of "duplicate end ownership refused")
begin bim transaction in (the address of documentValue)
ignore move bim linear firstId to (a cad vector3 with x -1.0, y 0.0 and z 0.0) and (a cad vector3 with x 3.0, y 0.0 and z 0.0) turned 0.0 in target
commit bim transaction in (the address of documentValue)
set secondary to the item at (the bim linear index of secondId in documentValue's current)'s position in (target's linears's values)
check connection model (secondary's start's x = -1.0) named (the string form of "node links endpoint movement")
ignore undo bim transaction in (the address of documentValue)
check connection model ((the bim file text of documentValue's current) = text) named (the string form of "undo linked movement")
begin bim transaction in (the address of documentValue)
ignore delete bim linear firstId from target
commit bim transaction in (the address of documentValue)
check connection model ((the length of (target's connections's values)) = 0) named (the string form of "host deletion removes dependent node")
ignore undo bim transaction in (the address of documentValue)
check connection model ((the item at 0 in (target's connections's values))'s id = nodeId) named (the string form of "undo restores node identity")
set buttSpec to the item at 0 in (target's connections's values)
set buttSpec's category to 0
set buttSpec's style to 0
set buttSpec's additions to a cad topology list of a connection addition
set buttResult to the bim connection evaluation of buttSpec in documentValue's current
check connection model (buttResult's valid and ((the absolute value of ((the item at 1 in (buttResult's voids's values))'s origin's y - 0.1)) < 1e-12)) named (the string form of "butt stops secondary at primary section")
free identities
