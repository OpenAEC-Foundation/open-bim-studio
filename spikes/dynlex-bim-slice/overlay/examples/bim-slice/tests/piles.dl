# SPDX-License-Identifier: MPL-2.0
# Piles: a linear role reaching down from its storey. PI starts the pile
# tool with the library's pile types; one click places a pile with its head
# at the storey and its foot 12 m down. It is an IfcPile in IfcX and stays a
# pile after the file and IfcX; the pile category is hidden in a floor plan.
import examples/bim-slice/bim_editor.dl
import examples/bim-slice/bim_ifcx.dl
import examples/bim-slice/bim_ifcx_read.dl

function list bim piles of {bim model record:modelValue} labelled {a string:label}:
    execute:
        loop cursor from 0 to the length of (modelValue's linears's values):
            set linearValue to the item at cursor in (modelValue's linears's values)
            set linearType to the bim type of linear linearValue in modelValue
            print ((label + (the string form of ": ")) + (((the bim ifc class of linear role linearType's role) + (the string form of " ")) + (linearType's name + ((the string form of " from z ") + ((the string form of linearValue's start's z) + ((the string form of " to z ") + (the string form of linearValue's finish's z))))))) as a line

set editor to a new bim editor
set e to the address of editor
print ((the string form of "PI is the pile tool: ") + (the string form of ((the bim two letter command of 80 then 73) = 2077))) as a line
type bim editor key 2077 in e
print editor's message as a line
move bim editor pointer to (a cad vector2 with x 3.0 and y 4.0) within 0.1 in e
press bim editor pointer in e
release bim editor pointer in e
set modelValue to editor's documentValue's current
list bim piles of modelValue labelled (the string form of "placed")
set pileType to the bim type of linear (the item at 0 in (modelValue's linears's values)) in modelValue
print ((the string form of "category: ") + (the bim name of category (the bim category of linear role pileType's role))) as a line
set floorRules to the bim template rules of view kind bim plan view kind
print ((the string form of "shown in a floor plan: ") + (the string form of (bim category bim pile category is visible in floorRules))) as a line
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + (the string form of reread's valid)) as a line
list bim piles of reread's modelValue labelled (the string form of "from .bim")
set exported to the bim ifcx text of modelValue identified as (the string form of "p.ifcx") for project (the string form of "p") by (the string form of "test") at (the string form of "2026-10-12T00:00:00Z")
print ((the string form of "IfcX names IfcPile: ") + (the string form of (exported contains "IfcPile"))) as a line
set native to the bim native text of ifcx exported
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + (the string form of fromIfcx's valid)) as a line
list bim piles of fromIfcx's modelValue labelled (the string form of "from .ifcx")
