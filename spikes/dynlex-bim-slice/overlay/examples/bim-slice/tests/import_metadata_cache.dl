# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/bim_import_cache.dl

function check import metadata {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set documentValue to a new bim document
set cache to a new bim import metadata cache
check import metadata (refresh bim import metadata of documentValue in (the address of cache)) named (the string form of "initial document is inspected")
check import metadata ((cache's linkedPath = (the string form of "")) and (cache's promotedCount = 0)) named (the string form of "unlinked native model has no promoted import")
check import metadata ((refresh bim import metadata of documentValue in (the address of cache)) = false) named (the string form of "unchanged frames do not rescan properties")
begin bim transaction in (the address of documentValue)
link bim ifc (the string form of "example.ifc") to (the address of (documentValue's current))
set bim property (the string form of "guid-one") of set (the bim promoted set name) of (0 as a 64 bit integer) to (the string form of "true") typed (the string form of "IfcBoolean") in (the address of (documentValue's current))
commit bim transaction in (the address of documentValue)
ignore refresh bim import metadata of documentValue in (the address of cache)
check import metadata ((cache's linkedPath = (the string form of "example.ifc")) and (cache's promotedCount = 1)) named (the string form of "committed link and promotion refresh together")
ignore undo bim transaction in (the address of documentValue)
ignore refresh bim import metadata of documentValue in (the address of cache)
check import metadata ((cache's linkedPath = (the string form of "")) and (cache's promotedCount = 0)) named (the string form of "undo removes cached link and promotion")
ignore redo bim transaction in (the address of documentValue)
ignore refresh bim import metadata of documentValue in (the address of cache)
check import metadata ((cache's linkedPath = (the string form of "example.ifc")) and (cache's promotedCount = 1)) named (the string form of "redo restores cached link and promotion")
check import metadata ((refresh bim import metadata of documentValue in (the address of cache)) = false) named (the string form of "settled document reuses refreshed metadata")
