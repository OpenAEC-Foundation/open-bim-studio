# SPDX-License-Identifier: MPL-2.0
# The Open 2D Studio wall type library: the types, a wall drawn with a cavity
# wall type (its cavity no solid), and a wall given another type.
import examples/bim-slice/bim_editor.dl

function the bim types test text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.4f", value)
        return the substring of buffer from 0 spanning written bytes

set editor to a new bim editor
set e to the address of editor
add bim type library to e
add bim type library to e
set modelValue to editor's documentValue's current
print ((the string form of "wall types ") + (the string form of (the length of (modelValue's wallTypes's values)))) as a line
set cavityId to the bim refused id
set solidId to the bim refused id
loop cursor from 0 to the length of (modelValue's wallTypes's values):
    set wallType to the item at cursor in (modelValue's wallTypes's values)
    print ((the string form of "  ") + ((wallType's name + (the string form of " ")) + ((the bim types test text of (the bim thickness of wallType)) + ((the string form of " layers ") + (the string form of (the length of (wallType's layers's values))))))) as a line
    if wallType's name = (the string form of "Spouwmuur 360"):
        set cavityId to wallType's id
    if wallType's name = (the string form of "Massieve Binnenwand"):
        set solidId to wallType's id
print ((the string form of "undo after the library: ") + (the string form of (undo bim transaction in (the address of (editor's documentValue))))) as a line
choose bim editor wall type cavityId in e
type bim editor key 87 in e
move bim editor pointer to (a cad vector2 with x 0.0 and y 0.0) within 0.1 in e
press bim editor pointer in e
move bim editor pointer to (a cad vector2 with x 6.0 and y 0.0) within 0.1 in e
press bim editor pointer in e
type bim editor key bim escape key code in e
refresh bim editor e
set wallValue to the item at 0 in (editor's documentValue's current's walls's values)
print ((the string form of "wall thickness ") + (the bim types test text of (the bim wall thickness of wallValue in editor's documentValue's current))) as a line
set layers to the bim layer solids of wallValue in editor's documentValue's current using editor's evaluation's index
print ((the string form of "layer solids ") + (the string form of (the length of (layers's values)))) as a line
loop cursor from 0 to the length of (layers's values):
    print ((the string form of "  ") + (the item at cursor in (layers's values))'s material) as a line
select bim editor bim wall picked numbered wallValue's id in e
choose bim editor wall type solidId in e
print editor's message as a line
refresh bim editor e
set changed to the item at 0 in (editor's documentValue's current's walls's values)
print ((the string form of "wall thickness now ") + (the bim types test text of (the bim wall thickness of changed in editor's documentValue's current))) as a line
type bim editor key 90 in e
set restored to the item at 0 in (editor's documentValue's current's walls's values)
print ((the string form of "after undo ") + (the bim types test text of (the bim wall thickness of restored in editor's documentValue's current))) as a line
# The floor types: the example's ground slab given a hollow core floor.
add bim example building to e
refresh bim editor e
set slabValue to the item at 0 in (editor's documentValue's current's slabs's values)
print ((the string form of "slab thickness ") + (the bim types test text of slabValue's thickness)) as a line
select bim editor bim slab picked numbered slabValue's id in e
choose bim editor floor type 5 in e
print editor's message as a line
set thicker to the item at 0 in (editor's documentValue's current's slabs's values)
print ((the string form of "slab thickness now ") + (the bim types test text of thicker's thickness)) as a line
type bim editor key 90 in e
print ((the string form of "after undo ") + (the bim types test text of (the item at 0 in (editor's documentValue's current's slabs's values))'s thickness)) as a line
