# SPDX-License-Identifier: MPL-2.0
# A building system's members of a linear type chosen per role: the frame
# (outer mullions and transoms), the inner mullions and the inner transoms,
# each from the model's linear types, else the generated ones. A chosen
# type's level members of an upright system are turned a quarter about
# their axis, so its profile reads the same on every member (x in the face,
# y through the system); a system lying level turns none. A type that is
# gone falls back. The types are neutral rectangles, not frame sections.
import examples/bim-slice/bim_stair.dl

function check system profiles {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# How many members of system `systemId` are of linear type `typeId`, and
# whether each of them, when level, is turned by `levelTurn` (an upright
# one by none).
class:
    patterns:
        [a|] system profile count record
    members:
        count as an integer
        turned as a boolean

function the members of system {a 64 bit integer:systemId} typed {a 64 bit integer:typeId} turning {a 64 bit floating-point number:levelTurn} in {bim model record:modelValue}:
    execute:
        set found to the bim curtain index of systemId in modelValue
        set systemParts to the bim parts of curtain wall (the item at found's position in (modelValue's curtains's values)) in modelValue
        set tally to 0
        set allTurned to true
        loop cursor from 0 to the length of (systemParts's values):
            set systemPart to the item at cursor in (systemParts's values)
            if systemPart's kind's id = typeId:
                set tally to tally + 1
                set rising to (the absolute value of (systemPart's element's finish's z - systemPart's element's start's z)) > 0.001
                set wantedTurn to levelTurn
                if rising:
                    set wantedTurn to 0.0
                if (the absolute value of (systemPart's element's angle - wantedTurn)) > 0.000001:
                    set allTurned to false
        return @intrinsic("construct", a system profile count record, tally, allTurned)

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
# Three bays of 1 m and two rows of 1 m: four outer members, two inner
# mullions, one inner transom.
set systemId to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 3.0 and y 0.0) rising 2.0 in bays of 1.0 by 1.0 of (the string form of "wood") to target
set frameType to add bim linear type named (the string form of "Frame 70x100") as role (bim mullion role) sized 0.07 by 0.1 round false of (the string form of "wood") to target
set mullionType to add bim linear type named (the string form of "Mullion 60x100") as role (bim mullion role) sized 0.06 by 0.1 round false of (the string form of "wood") to target
set transomType to add bim linear type named (the string form of "Transom 50x100") as role (bim mullion role) sized 0.05 by 0.1 round false of (the string form of "wood") to target
set quarter to 0.0 - 1.5707963267948966

set generated to the members of system systemId typed (the bim refused id) turning 0.0 in modelValue
check system profiles ((generated's count = 7) and generated's turned) named (the string form of "none chosen: all seven members generated, none turned")

set bim setting ((bim part type setting) + (bim frame part)) of systemId to frameType keeping true in target
set bim setting ((bim part type setting) + (bim mullion part)) of systemId to mullionType keeping true in target
set bim setting ((bim part type setting) + (bim transom part)) of systemId to transomType keeping true in target
set framed to the members of system systemId typed frameType turning quarter in modelValue
check system profiles ((framed's count = 4) and framed's turned) named (the string form of "the four outer members are of the frame type, the level ones turned")
set inner to the members of system systemId typed mullionType turning quarter in modelValue
check system profiles ((inner's count = 2) and inner's turned) named (the string form of "the two inner mullions are of the mullion type, not turned")
set across to the members of system systemId typed transomType turning quarter in modelValue
check system profiles ((across's count = 1) and across's turned) named (the string form of "the inner transom is of the transom type, turned")
check system profiles (((the members of system systemId typed (the bim refused id) turning 0.0 in modelValue)'s count) = 0) named (the string form of "no member is generated any more")

# The frame's choice cleared: the outer members are generated again.
set bim setting ((bim part type setting) + (bim frame part)) of systemId to (0 as a 64 bit integer) keeping false in target
check system profiles ((((the members of system systemId typed (the bim refused id) turning 0.0 in modelValue)'s count) = 4) and (((the members of system systemId typed mullionType turning quarter in modelValue)'s count) = 2)) named (the string form of "the frame's choice cleared: its members generated, the mullions kept")

# A type that is not in the model falls back to the generated one.
set bim setting ((bim part type setting) + (bim transom part)) of systemId to (987654 as a 64 bit integer) keeping true in target
check system profiles (((the members of system systemId typed (the bim refused id) turning 0.0 in modelValue)'s count) = 5) named (the string form of "a type not in the model: the generated one")

# Lying level (a ceiling at 2.5 m), nothing is turned.
set bim setting ((bim part type setting) + (bim transom part)) of systemId to transomType keeping true in target
set bim setting (bim system level setting) of systemId to (2500 as a 64 bit integer) keeping true in target
set flatMembers to the members of system systemId typed transomType turning 0.0 in modelValue
check system profiles ((flatMembers's count = 1) and flatMembers's turned) named (the string form of "a system lying level turns none")

check system profiles ((((the bim name of part slot (bim frame part)) = (the string form of "Frame")) and ((the bim name of part slot (bim mullion part)) = (the string form of "Mullion"))) and ((the bim name of part slot (bim transom part)) = (the string form of "Transom"))) named (the string form of "the roles are named Frame, Mullion and Transom")
