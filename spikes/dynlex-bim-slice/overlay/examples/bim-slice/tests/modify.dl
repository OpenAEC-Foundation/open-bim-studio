# SPDX-License-Identifier: MPL-2.0
# Rotate, mirror, offset, trim and extend, and Escape leaving the command,
# driven by simulated events.
import examples/bim-slice/bim_editor.dl

function click bim modify test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        refresh bim editor editor
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function type bim modify test digits {a string:digits} in {a pointer to a bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of digits:
            type bim editor key ((the character at cursor in digits) as an integer) in editor
        type bim editor key bim enter key code in editor

function the bim modify text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.3f", value)
        return the substring of buffer from 0 spanning written bytes

function show bim lines of {a pointer to a bim editor record:editor} labelled {a string:label}:
    execute:
        print label as a line
        loop cursor from 0 to the length of (editor's documentValue's current's sketches's values):
            set element to the item at cursor in (editor's documentValue's current's sketches's values)
            if element's kind = bim line sketch:
                set first to the item at 0 in (element's points's values)
                set second to the item at 1 in (element's points's values)
                print ((the string form of "  line ") + ((the bim modify text of first's x) + ((the string form of " ") + ((the bim modify text of first's y) + ((the string form of " -> ") + ((the bim modify text of second's x) + ((the string form of " ") + (the bim modify text of second's y)))))))) as a line

set editor to a new bim editor
set e to the address of editor
# A line, turned a quarter about its start by a typed angle.
type bim editor key 78 in e
click bim modify test at 0.0 and 0.0 in e
click bim modify test at 4.0 and 0.0 in e
type bim editor key bim enter key code in e
type bim editor key 83 in e
click bim modify test at 2.0 and 0.0 in e
type bim editor key 2010 in e
click bim modify test at 0.0 and 0.0 in e
type bim modify test digits (the string form of "90") in e
print editor's message as a line
show bim lines of e labelled (the string form of "rotated")
# A mirrored copy in the line x = 1.
type bim editor key 83 in e
click bim modify test at 0.0 and 2.0 in e
type bim editor key 2011 in e
click bim modify test at 1.0 and 0.0 in e
click bim modify test at 1.0 and 5.0 in e
print editor's message as a line
show bim lines of e labelled (the string form of "mirrored")
# An offset of 1.5 m to the west.
type bim editor key 2014 in e
type bim modify test digits (the string form of "1.5") in e
click bim modify test at 0.0 and 2.0 in e
click bim modify test at -1.0 and 2.0 in e
print editor's message as a line
type bim editor key bim escape key code in e
print ((the string form of "after Escape the select tool: ") + (the string form of (editor's tool = bim select tool))) as a line
# A boundary at x = 10: a short line extended to it, then TR trims the
# boundary and a long line to the corner where they meet.
type bim editor key 78 in e
click bim modify test at 10.0 and -5.0 in e
click bim modify test at 10.0 and 5.0 in e
type bim editor key bim enter key code in e
click bim modify test at 5.0 and 1.0 in e
click bim modify test at 6.0 and 1.0 in e
type bim editor key bim enter key code in e
click bim modify test at 8.0 and 3.0 in e
click bim modify test at 12.0 and 3.0 in e
type bim editor key bim enter key code in e
type bim editor key 2013 in e
click bim modify test at 10.0 and -2.0 in e
click bim modify test at 5.9 and 1.0 in e
print editor's message as a line
type bim editor key bim escape key code in e
type bim editor key 2012 in e
click bim modify test at 10.0 and -2.0 in e
click bim modify test at 11.5 and 3.0 in e
print editor's message as a line
type bim editor key bim escape key code in e
show bim lines of e labelled (the string form of "trimmed and extended")
# A wall with a window, mirrored: the copy runs the other way and its window
# keeps its place.
type bim editor key 87 in e
click bim modify test at 0.0 and 10.0 in e
click bim modify test at 6.0 and 10.0 in e
type bim editor key bim escape key code in e
type bim editor key 79 in e
click bim modify test at 1.5 and 10.0 in e
type bim editor key 83 in e
click bim modify test at 3.0 and 10.0 in e
type bim editor key 2011 in e
click bim modify test at 10.0 and 0.0 in e
click bim modify test at 10.0 and 20.0 in e
set modelValue to editor's documentValue's current
loop cursor from 0 to the length of (modelValue's walls's values):
    set wallValue to the item at cursor in (modelValue's walls's values)
    print ((the string form of "wall ") + ((the bim modify text of wallValue's start's x) + ((the string form of " -> ") + (the bim modify text of wallValue's finish's x)))) as a line
loop cursor from 0 to the length of (modelValue's openings's values):
    set openingValue to the item at cursor in (modelValue's openings's values)
    print ((the string form of "opening at ") + (the bim modify text of openingValue's offset)) as a line
type bim editor key 90 in e
print ((the string form of "after undo walls ") + (the string form of (the length of (editor's documentValue's current's walls's values)))) as a line
