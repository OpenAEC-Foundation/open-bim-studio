# SPDX-License-Identifier: MPL-2.0
# Building services as a network: five pipes meeting in a tee, a straight
# joint and a 90-degree bend give one tee, two joints and three open ends;
# assigned to a water system, they keep their system through .bim and .ifcx.
import examples/bim-slice/bim_network.dl
import examples/bim-slice/bim_schedule.dl
import examples/bim-slice/bim_file.dl
import examples/bim-slice/bim_ifcx.dl
import examples/bim-slice/bim_ifcx_read.dl

function show network test nodes of {bim model record:modelValue}:
    execute:
        set pipeNetwork to the bim network of modelValue
        print ((the string form of "connectors ") + ((the string form of (the length of (pipeNetwork's connectors's values))) + ((the string form of ", nodes ") + (the string form of (the length of (pipeNetwork's nodes's values)))))) as a line
        loop cursor from 0 to the length of (pipeNetwork's nodes's values):
            set networkNode to the item at cursor in (pipeNetwork's nodes's values)
            set nodeKind to the bim kind of node networkNode
            set label to the string form of "open end"
            if nodeKind = bim joint node:
                set label to (the string form of "joint turning ") + (the string form of (the rounded value of (the bim turn at joint networkNode in pipeNetwork)))
            if nodeKind = bim tee node:
                set label to the string form of "tee"
            print ((the string form of "  at ") + ((the string form of networkNode's spot's x) + ((the string form of ",") + ((the string form of networkNode's spot's y) + ((the string form of ": ") + label))))) as a line

function show network test systems of {bim model record:modelValue} labelled {a string:title}:
    execute:
        loop cursor from 0 to the length of (modelValue's systems's values):
            set systemValue to the item at cursor in (modelValue's systems's values)
            print ((title + (the string form of ": ")) + ((systemValue's name + (the string form of ", ")) + ((the bim name of discipline systemValue's discipline) + ((the string form of ", members ") + (the string form of (the length of (systemValue's members's values))))))) as a line

function add network test pipe from {a 64 bit floating-point number:x1} and {a 64 bit floating-point number:y1} to {a 64 bit floating-point number:x2} and {a 64 bit floating-point number:y2} typed {a 64 bit integer:typeId} on {a 64 bit integer:levelId} to {a pointer to a bim model record:target}:
    execute:
        return add bim linear typed typeId on levelId from (a cad vector3 with x x1, y y1 and z 2.5) to (a cad vector3 with x x2, y y2 and z 2.5) turned 0.0 to target

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to target
set pipeType to add bim linear type named (the string form of "Leiding 50") as role bim pipe role sized 0.05 by 0.05 round true of (the string form of "copper") to target
set pipes to an empty list of a 64 bit integer
append (add network test pipe from 0.0 and 0.0 to 4.0 and 0.0 typed pipeType on ground to target) to pipes
append (add network test pipe from 4.0 and 0.0 to 4.0 and 3.0 typed pipeType on ground to target) to pipes
append (add network test pipe from 4.0 and 0.0 to 8.0 and 0.0 typed pipeType on ground to target) to pipes
append (add network test pipe from 4.0 and 3.0 to 4.0 and 6.0 typed pipeType on ground to target) to pipes
append (add network test pipe from 4.0 and 6.0 to 6.0 and 6.0 typed pipeType on ground to target) to pipes
show network test nodes of modelValue
set water to add bim system named (the string form of "Water 1") of discipline bim water discipline to target
loop cursor from 0 to the length of pipes:
    ignore assign bim element (the item at cursor in pipes) to system water in target
show network test systems of modelValue labelled (the string form of "system")
print ((the string form of "pipe 3 in system ") + (the string form of ((the bim system of element (the item at 2 in pipes) in modelValue) = water))) as a line
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", ") + reread's message))) as a line
show network test systems of reread's modelValue labelled (the string form of "from .bim")
set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "n.ifcx") for project (the string form of "n") by (the string form of "test") at (the string form of "2026-10-09T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of ", ") + fromIfcx's message))) as a line
show network test systems of fromIfcx's modelValue labelled (the string form of "from .ifcx")

# Fittings: a junction at the tee, a bend at the 90-degree joint, and a
# transition where a 32 mm pipe continues the 50 mm one; none at the straight
# joint. The building services schedule lists the water system's pipes and
# fittings.
set smallType to add bim linear type named (the string form of "Leiding 32") as role bim pipe role sized 0.032 by 0.032 round true of (the string form of "copper") to target
set smallPipe to add network test pipe from 6.0 and 6.0 to 8.0 and 6.0 typed smallType on ground to target
ignore assign bim element smallPipe to system water in target
set finalNetwork to the bim network of modelValue
set derivedFittings to the bim fittings of finalNetwork in modelValue
loop cursor from 0 to the length of (derivedFittings's values):
    set fittingValue to the item at cursor in (derivedFittings's values)
    set atNode to the item at fittingValue's nodeIndex in (finalNetwork's nodes's values)
    print ((the string form of "fitting: ") + ((the bim name of fitting fittingValue's kind) + ((the string form of " at ") + ((the string form of atNode's spot's x) + ((the string form of ",") + ((the string form of atNode's spot's y) + ((the string form of ", stubs ") + (the string form of (the length of (fittingValue's stubs's values)))))))))) as a line
set servicesRows to an empty list of a bim schedule row record
append bim services rows of modelValue to servicesRows
loop cursor from 0 to the length of servicesRows:
    set row to the item at cursor in servicesRows
    print ((row's group + (the string form of " | ")) + ((row's name + (the string form of " | ")) + ((the string form of row's count) + ((the string form of " | ") + (the bim schedule text of row's length))))) as a line
