# SPDX-License-Identifier: MPL-2.0
# Persistent spaces without walls: stable identity, immutable snapshots,
# native/IFCX roundtrips, invalid input and owned metadata cleanup.
import examples/bim-slice/bim_file.dl
import examples/bim-slice/bim_ifcx.dl
import examples/bim-slice/bim_ifcx_read.dl

function check space object {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set levelId to add bim level named (the string form of "First") at 3.1 with height 3.0 to target
set corners to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to corners
append (a cad vector2 with x 4.0 and y 0.0) to corners
append (a cad vector2 with x 4.0 and y 3.0) to corners
append (a cad vector2 with x 0.0 and y 3.0) to corners
set spaceId to add bim space object named (the string form of "Living \"room\"\nNorth") numbered (the string form of "01 A") on levelId around corners high 2.7 to target
check space object (spaceId != the bim refused id) named (the string form of "standalone space needs no walls")
set original to the item at 0 in (modelValue's spaceObjects's values)
check space object ((original's name = (the string form of "Living \"room\" North")) and (original's number = (the string form of "01 A"))) named (the string form of "labels retain quotes and spaces; line breaks normalize")
check space object (((the absolute value of (the cad signed area of (original's outline's values))) = 12.0) and (original's height = 2.7)) named (the string form of "contour and height describe the space")
replace item at index 0 in corners with (a cad vector2 with x (-2.0) and y (-2.0))
check space object (((the item at 0 in (original's outline's values))'s x) = 0.0) named (the string form of "caller does not own stored contour")
set earlier to the bim snapshot of modelValue
ignore rename bim space object spaceId to (the string form of "Office") numbered (the string form of "02") in target
ignore set bim space object spaceId height to 2.9 in target
check space object (((the item at 0 in (earlier's spaceObjects's values))'s height = 2.7) and ((the item at 0 in (earlier's spaceObjects's values))'s name = original's name)) named (the string form of "snapshot retains old name and height")
check space object ((the item at 0 in (modelValue's spaceObjects's values))'s id = spaceId) named (the string form of "edits keep identity")
check space object ((set bim space object spaceId height to 0.0 in target) = false) named (the string form of "zero height refused")
check space object ((add bim space object named (the string form of "Bad") numbered (the string form of "") on (999 as a 64 bit integer) around corners high 2.0 to target) = the bim refused id) named (the string form of "missing level refused")
set nextBefore to modelValue's nextId
set bowtie to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to bowtie
append (a cad vector2 with x 4.0 and y 3.0) to bowtie
append (a cad vector2 with x 4.0 and y 0.0) to bowtie
append (a cad vector2 with x 0.0 and y 3.0) to bowtie
check space object ((add bim space object named (the string form of "Bad") numbered (the string form of "") on levelId around bowtie high 2.0 to target) = the bim refused id) named (the string form of "crossing contour refused")
check space object (modelValue's nextId = nextBefore) named (the string form of "invalid creation consumes no ID")
set fileText to the bim file text of modelValue
set nativeReading to the bim model parsed from fileText
check space object (nativeReading's valid and ((the bim file text of nativeReading's modelValue) = fileText)) named (the string form of "native roundtrip exact")
set ifcxText to the bim ifcx text of modelValue identified as (the string form of "space.ifcx") for project (the string form of "Spaces") by (the string form of "test") at (the string form of "2026-10-21T00:00:00Z")
set nativeResult to the bim native text of ifcx ifcxText
check space object nativeResult's valid named (the string form of "IFCX contains native spatial object")
set fromIfcx to the bim model parsed from nativeResult's text
check space object (fromIfcx's valid and ((the bim file text of fromIfcx's modelValue) = fileText)) named (the string form of "IFCX roundtrip preserves all space fields")
set legacy to the bim model parsed from (the string form of "BIM-SLICE 1\nnext 2\nlevel 1 0 3 Ground\n")
check space object (legacy's valid and ((the length of (legacy's modelValue's spaceObjects's values)) = 0)) named (the string form of "old native model has empty spaces")
set tagId to add bim tag of spaceId at (a cad vector2 with x 2.0 and y 1.5) to target
set bim setting 777 of spaceId to (1 as a 64 bit integer) keeping true in target
set bim property (the string form of "Use") of set (the string form of "Space") of spaceId to (the string form of "Office") typed (the string form of "IfcLabel") in target
check space object (delete bim space object spaceId from target) named (the string form of "space deleted")
check space object ((((the length of (modelValue's tags's values)) = 0) and ((the length of (modelValue's settings's values)) = 0)) and ((the length of (modelValue's properties's values)) = 0)) named (the string form of "delete removes owned tags settings and properties")
