# SPDX-License-Identifier: MPL-2.0
# Bending a wall keeps the walls that meet it along its length (T joins)
# meeting it, so its rooms stay apart; spaces are reported per bend.
import examples/bim-slice/bim_editor.dl

function report bim probe {a pointer to a bim editor record:editor} labelled {a string:label}:
    execute:
        refresh bim editor editor
        print ((label + (the string form of " spaces ")) + (the string form of (the length of (editor's spaces's values)))) as a line
        loop cursor from 0 to the length of (editor's spaces's values):
            set space to the item at cursor in (editor's spaces's values)
            set lowX to 1e9
            set highX to -1e9
            set lowY to 1e9
            set highY to -1e9
            loop corner from 0 to the length of (space's outline's values):
                set point to the item at corner in (space's outline's values)
                set lowX to the minimum of lowX and point's x
                set highX to the maximum of highX and point's x
                set lowY to the minimum of lowY and point's y
                set highY to the maximum of highY and point's y
            print ((the string form of "  area ") + ((the string form of space's area) + ((the string form of " corners ") + ((the string form of (the length of (space's outline's values))) + ((the string form of " x ") + ((the string form of lowX) + ((the string form of " .. ") + ((the string form of highX) + ((the string form of " y ") + ((the string form of lowY) + ((the string form of " .. ") + (the string form of highY)))))))))))) as a line

set editor to a new bim editor
set e to the address of editor
add bim example building to e
report bim probe e labelled (the string form of "example")
set target to the address of (editor's documentValue's current)
loop cursor from 0 to the length of (target's walls's values):
    set wallValue to the item at cursor in (target's walls's values)
    print ((the string form of "wall ") + ((the string form of wallValue's id) + ((the string form of " ") + ((the string form of wallValue's start's x) + ((the string form of ",") + ((the string form of wallValue's start's y) + ((the string form of " -> ") + ((the string form of wallValue's finish's x) + ((the string form of ",") + (the string form of wallValue's finish's y)))))))))) as a line
# Bend the south wall outward (away from the building) and the east wall.
loop step from 1 to 4:
    begin bim transaction in (the address of (editor's documentValue))
    ignore bend bim wall (5 as a 64 bit integer) keeping its joins by ((step as a 64 bit floating-point number) * 0.5) in target
    commit bim transaction in (the address of (editor's documentValue))
    report bim probe e labelled ((the string form of "south bulge ") + (the string form of step))
    begin bim transaction in (the address of (editor's documentValue))
    ignore bend bim wall (5 as a 64 bit integer) keeping its joins by ((step as a 64 bit floating-point number) * -0.5) in target
    commit bim transaction in (the address of (editor's documentValue))
    report bim probe e labelled ((the string form of "south bulge -") + (the string form of step))
