# SPDX-License-Identifier: MPL-2.0
# The building system types (`bim_system_types.dl`): every type of the
# library side by side, each with what it is made of (its parts and the
# materials the 3D view colours), a timber frame's boards as layers, a
# type given again replacing the layers of the one before; a system
# changed on its own shows "(custom)". The gallery is written as
# build/system-types.obj, each piece in its material's colour, to look at.
import examples/bim-slice/bim_editor.dl

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set gallery to add bim system type gallery at (a cad vector2 with x 0.0 and y 0.0) on editor's levelId in target
commit bim transaction in (the address of (editor's documentValue))
set library to the bim system types
print ((the string form of "types: ") + (the string form of (the length of library))) as a line
set modelValue to editor's documentValue's current
set objectRows to an empty list of a string
set vertexCount to 0
loop typeCursor from 0 to the length of (gallery's values):
    set systemId to the item at typeCursor in (gallery's values)
    set systemValue to the item at (the bim curtain index of systemId in modelValue)'s position in (modelValue's curtains's values)
    set systemParts to the bim parts of curtain wall systemValue in modelValue
    set layerCount to 0
    loop curtainCursor from 0 to the length of (modelValue's curtains's values):
        set reading to the bim setting (bim layer host setting) of (the item at curtainCursor in (modelValue's curtains's values))'s id in modelValue
        if reading's found:
            if reading's value = systemId:
                set layerCount to layerCount + 1
    set pieceList to the bim curtain pieces of systemValue in modelValue within 0.001
    set materialNames to an empty list of a string
    loop pieceCursor from 0 to the length of (pieceList's values):
        set piece to the item at pieceCursor in (pieceList's values)
        append piece's material to materialNames
        set colour to the bim material colour of piece's material
        set colourText to (((the string form of (colour's x / 255.0)) + (the string form of " ")) + ((the string form of (colour's y / 255.0)) + (the string form of " "))) + (the string form of (colour's z / 255.0))
        loop corner from 0 to the length of (piece's shape's positions's values):
            set point to the item at corner in (piece's shape's positions's values)
            append ((((the string form of "v ") + (the string form of point's x)) + (the string form of " ")) + ((((the string form of point's y) + (the string form of " ")) + (the string form of point's z)) + ((the string form of " ") + colourText))) to objectRows
        set triangleCorners to piece's shape's triangles's values
        set face to 0
        loop while (face + 2) < (the length of triangleCorners):
            append ((((the string form of "f ") + (the string form of ((vertexCount + (the item at face in triangleCorners)) + 1))) + (the string form of " ")) + (((the string form of ((vertexCount + (the item at (face + 1) in triangleCorners)) + 1)) + (the string form of " ")) + (the string form of ((vertexCount + (the item at (face + 2) in triangleCorners)) + 1)))) to objectRows
            set face to face + 3
        set vertexCount to vertexCount + (the length of (piece's shape's positions's values))
    print ((the bim system type name of systemValue in modelValue) + (the string form of ": parts ")) + (((the string form of (the length of (systemParts's values))) + ((the string form of ", layers ") + (the string form of layerCount))) + ((the string form of ", materials ") + (materialNames joined with " "))) as a line
    free materialNames
# The layers too, in the picture.
loop curtainCursor from 0 to the length of (modelValue's curtains's values):
    set layerValue to the item at curtainCursor in (modelValue's curtains's values)
    if (the bim setting (bim layer host setting) of layerValue's id in modelValue)'s found:
        set pieceList to the bim curtain pieces of layerValue in modelValue within 0.001
        loop pieceCursor from 0 to the length of (pieceList's values):
            set piece to the item at pieceCursor in (pieceList's values)
            set colour to the bim material colour of piece's material
            set colourText to (((the string form of (colour's x / 255.0)) + (the string form of " ")) + ((the string form of (colour's y / 255.0)) + (the string form of " "))) + (the string form of (colour's z / 255.0))
            loop corner from 0 to the length of (piece's shape's positions's values):
                set point to the item at corner in (piece's shape's positions's values)
                append ((((the string form of "v ") + (the string form of point's x)) + (the string form of " ")) + ((((the string form of point's y) + (the string form of " ")) + (the string form of point's z)) + ((the string form of " ") + colourText))) to objectRows
            set triangleCorners to piece's shape's triangles's values
            set face to 0
            loop while (face + 2) < (the length of triangleCorners):
                append ((((the string form of "f ") + (the string form of ((vertexCount + (the item at face in triangleCorners)) + 1))) + (the string form of " ")) + (((the string form of ((vertexCount + (the item at (face + 1) in triangleCorners)) + 1)) + (the string form of " ")) + (the string form of ((vertexCount + (the item at (face + 2) in triangleCorners)) + 1)))) to objectRows
                set face to face + 3
            set vertexCount to vertexCount + (the length of (piece's shape's positions's values))
ignore write bim text (objectRows joined with "\n") to file (the string form of "build/system-types.obj")
free objectRows

# The timber frame given masonry instead: its layers go.
set timberId to the item at 6 in (gallery's values)
begin bim transaction in (the address of (editor's documentValue))
ignore give bim system timberId type 8 in target
commit bim transaction in (the address of (editor's documentValue))
set layersLeft to 0
loop curtainCursor from 0 to the length of (editor's documentValue's current's curtains's values):
    set reading to the bim setting (bim layer host setting) of (the item at curtainCursor in (editor's documentValue's current's curtains's values))'s id in editor's documentValue's current
    if reading's found:
        if reading's value = timberId:
            set layersLeft to layersLeft + 1
set retyped to the item at (the bim curtain index of timberId in editor's documentValue's current)'s position in (editor's documentValue's current's curtains's values)
print ((the string form of "retyped: ") + (the bim system type name of retyped in editor's documentValue's current)) + ((the string form of ", layers ") + (the string form of layersLeft)) as a line
# Its bays changed on their own: a custom system.
begin bim transaction in (the address of (editor's documentValue))
grid bim example system timberId in bays of 0.3 by 0.0625 in target
commit bim transaction in (the address of (editor's documentValue))
set retyped to the item at (the bim curtain index of timberId in editor's documentValue's current)'s position in (editor's documentValue's current's curtains's values)
print ((the string form of "changed: ") + (the bim system type name of retyped in editor's documentValue's current)) as a line
