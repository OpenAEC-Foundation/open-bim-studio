# SPDX-License-Identifier: MPL-2.0
# Reinforcement in the 3D view as its bars' centre lines: a mesh of lines
# (pairs of points, no triangles) per reinforcement object, one line per bar
# segment, on its storey and following its host as the round shape does;
# the round shape (with the diameter) is still made for export and the
# detail view. A ray passing a line picks the object; the section box keeps
# the lines inside it.
import examples/bim-slice/test_support/reinforcement_fixture.dl
import examples/bim-slice/bim_scene.dl

function the line test entry of {a 64 bit integer:wanted} among {a pointer to a list:sceneMeshes}:
    execute:
        loop cursor from 0 to the length of sceneMeshes:
            if (the item at cursor in sceneMeshes)'s elementId = wanted:
                return cursor
        return -1

function the line test low of {fast mesh record:shape}:
    execute:
        set infinity to 1.0 / 0.0
        set lowest to a cad vector3 with x infinity, y infinity and z infinity
        loop cursor from 0 to the length of (shape's positions's values):
            set spot to the item at cursor in (shape's positions's values)
            set lowest to a cad vector3 with x (the minimum of lowest's x and spot's x), y (the minimum of lowest's y and spot's y) and z (the minimum of lowest's z and spot's z)
        return lowest

function the line test high of {fast mesh record:shape}:
    execute:
        set infinity to 1.0 / 0.0
        set highest to a cad vector3 with x (0.0 - infinity), y (0.0 - infinity) and z (0.0 - infinity)
        loop cursor from 0 to the length of (shape's positions's values):
            set spot to the item at cursor in (shape's positions's values)
            set highest to a cad vector3 with x (the maximum of highest's x and spot's x), y (the maximum of highest's y and spot's y) and z (the maximum of highest's z and spot's z)
        return highest

# Whether `inner` to `innerHigh` lies within `outer` to `outerHigh` widened
# by `margin` on every side.
function line test box {cad vector3:inner} to {cad vector3:innerHigh} lies within {cad vector3:outer} to {cad vector3:outerHigh} widened {a 64 bit floating-point number:margin}:
    execute:
        set lowInside to ((inner's x >= (outer's x - margin)) and (inner's y >= (outer's y - margin))) and (inner's z >= (outer's z - margin))
        set highInside to ((innerHigh's x <= (outerHigh's x + margin)) and (innerHigh's y <= (outerHigh's y + margin))) and (innerHigh's z <= (outerHigh's z + margin))
        return lowInside and highInside

set modelValue to the reinforcement fixture named (the string form of "reinforcement-column-footing.bim") counting 2
set lineMeshes to the bim sketch meshes of modelValue within 0.002 with reinforcement detail false
set roundMeshes to the bim sketch meshes of modelValue within 0.002
set allFound to true
set allLines to true
set allCounted to true
set allInside to true
set allReaching to true
set allRound to true
set allPicked to true
set noneWithoutReach to true
loop specCursor from 0 to the length of (modelValue's reinforcements's values):
    set spec to the item at specCursor in (modelValue's reinforcements's values)
    set lineIndex to the line test entry of spec's id among (lineMeshes's values)
    set roundIndex to the line test entry of spec's id among (roundMeshes's values)
    if (lineIndex < 0) or (roundIndex < 0):
        set allFound to false
    else:
        set lineEntry to the item at lineIndex in (lineMeshes's values)
        set roundEntry to the item at roundIndex in (roundMeshes's values)
        set linePoints to lineEntry's shape's positions's values
        if ((bim scene mesh lineEntry draws lines) = false) or ((the remainder of (the length of linePoints) divided by 2) != 0):
            set allLines to false
        # One line per bar segment, of the bars as the host makes them.
        set generated to the bim reinforcement paths of (the bim hostbound reinforcement spec in modelValue) in modelValue
        set segments to 0
        set thickest to 0.0
        loop barCursor from 0 to the length of (generated's bars's values):
            set barValue to the item at barCursor in (generated's bars's values)
            set segments to segments + ((the length of (barValue's points's values)) - 1)
            set thickest to the maximum of thickest and barValue's diameter
        if ((the length of linePoints) / 2) != segments:
            set allCounted to false
        # The centre lines lie inside the round shape's extent and reach it
        # within a bar's diameter: the same storey, host and place.
        set lineLow to the line test low of lineEntry's shape
        set lineHigh to the line test high of lineEntry's shape
        set roundLow to the line test low of roundEntry's shape
        set roundHigh to the line test high of roundEntry's shape
        if (line test box lineLow to lineHigh lies within roundLow to roundHigh widened 0.000001) = false:
            set allInside to false
        if (line test box roundLow to roundHigh lies within lineLow to lineHigh widened (thickest + 0.000001)) = false:
            set allReaching to false
        # The round shape is made as export makes it.
        set exported to the bim reinforcement shape of spec in modelValue
        if ((the length of (roundEntry's shape's triangles's values)) = 0) or ((the length of (roundEntry's shape's triangles's values)) != (the length of (exported's triangles's values))):
            set allRound to false
        # A ray crossing the middle of the first line, from just beside it.
        set first to the item at 0 in linePoints
        set second to the item at 1 in linePoints
        set middle to (the cad sum of first and second) scaled by 0.5
        set along to the cad difference of second and first
        set across to the cad cross of along and (a cad vector3 with x 0.0, y 0.0 and z 1.0)
        if (the cad length of across) < 1e-9:
            set across to the cad cross of along and (a cad vector3 with x 1.0, y 0.0 and z 0.0)
        set across to across scaled by (1.0 / (the cad length of across))
        set ray to @intrinsic("construct", a bim ray record, (the cad sum of middle and (across scaled by -0.005)), across)
        set onlyThis to an empty list of a bim scene mesh record
        append lineEntry to onlyThis
        set noSpaces to an empty list of a bim space record
        set picked to the bim pick along ray among onlyThis in modelValue with noSpaces reaching lines within 0.01
        if (picked's kind != 30) or (picked's id != spec's id):
            set allPicked to false
        set unreached to the bim pick along ray among onlyThis in modelValue with noSpaces
        if unreached's kind != bim nothing picked:
            set noneWithoutReach to false
        free onlyThis
        free noSpaces
check reinforcement fixture allFound named (the string form of "every reinforcement object has a line mesh and a round one")
check reinforcement fixture allLines named (the string form of "line meshes hold pairs of points and no triangles")
check reinforcement fixture allCounted named (the string form of "one line per bar segment")
check reinforcement fixture allInside named (the string form of "lines lie inside the round shape")
check reinforcement fixture allReaching named (the string form of "lines reach the round shape within a bar diameter")
check reinforcement fixture allRound named (the string form of "the round shape is still made as export makes it")
check reinforcement fixture allPicked named (the string form of "a ray beside a line picks its reinforcement")
check reinforcement fixture noneWithoutReach named (the string form of "without a reach for lines nothing is picked")

# The section box: one round everything keeps every line, one far off
# keeps none.
set everywhere to the bim scene meshes of (lineMeshes's values) clipped to box from (a cad vector3 with x -100.0, y -100.0 and z -100.0) to (a cad vector3 with x 100.0, y 100.0 and z 100.0)
set nowhere to the bim scene meshes of (lineMeshes's values) clipped to box from (a cad vector3 with x 500.0, y 500.0 and z 500.0) to (a cad vector3 with x 501.0, y 501.0 and z 501.0)
set keptLines to 0
set allLinesBefore to 0
loop cursor from 0 to the length of (everywhere's values):
    if bim scene mesh (the item at cursor in (everywhere's values)) draws lines:
        set keptLines to keptLines + (the length of ((the item at cursor in (everywhere's values))'s shape's positions's values))
loop cursor from 0 to the length of (lineMeshes's values):
    if bim scene mesh (the item at cursor in (lineMeshes's values)) draws lines:
        set allLinesBefore to allLinesBefore + (the length of ((the item at cursor in (lineMeshes's values))'s shape's positions's values))
check reinforcement fixture ((keptLines = allLinesBefore) and (allLinesBefore > 0)) named (the string form of "a box round everything keeps every line")
check reinforcement fixture ((the length of (nowhere's values)) = 0) named (the string form of "a box far off keeps no line")
