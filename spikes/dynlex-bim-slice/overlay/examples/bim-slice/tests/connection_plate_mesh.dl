# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/bim_demo_steel_hall.dl
import examples/bim-slice/bim_plate_mesh.dl

function check plate mesh {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set hallModel to the bim demo steel hall
set allDirect to true
set plateCount to 0
loop cursor from 0 to the length of (hallModel's connections's values):
    set spec to the item at cursor in (hallModel's connections's values)
    set generated to the bim connection evaluation of spec in hallModel
    set holes to an empty list of a connection void
    loop cutCursor from 0 to the length of (generated's voids's values):
        set cutValue to the item at cutCursor in (generated's voids's values)
        if cutValue's kind = 1:
            append cutValue to holes
    set derived to the bim parts of connection spec in hallModel
    loop partCursor from 0 to the length of (derived's values):
        set partValue to the item at partCursor in (derived's values)
        if partValue's kind's name = (the string form of "Connection plate"):
            set built to the bim perforated flat plate of partValue's element typed partValue's kind in hallModel cut by holes
            if built's valid = false:
                print (((the string form of "Unsupported hall plate at node ") + (the string form of cursor)) + ((the string form of " part ") + (the string form of partCursor))) as a line
                set allDirect to false
            else:
                set plateCount to plateCount + 1
                if (the length of (built's shape's triangles's values)) = 0:
                    set allDirect to false
                if (the fast mesh flaw of built's shape) != 0:
                    print (((the string form of "Nonclosed hall plate at node ") + (the string form of cursor)) + ((the string form of " part ") + (the string form of partCursor))) as a line
                    set allDirect to false
    free holes
check plate mesh (allDirect and (plateCount >= 60)) named (the string form of "all flat hall plates mesh directly")

set spec to the item at 4 in (hallModel's connections's values)
set generated to the bim connection evaluation of spec in hallModel
set holes to an empty list of a connection void
loop cursor from 0 to the length of (generated's voids's values):
    set cutValue to the item at cursor in (generated's voids's values)
    if cutValue's kind = 1:
        append cutValue to holes
set derived to the bim parts of connection spec in hallModel
set platePart to the item at 0 in (derived's values)
set plateFrame to the bim frame of linear platePart's element in hallModel
set built to the bim perforated flat plate of platePart's element typed platePart's kind in hallModel cut by holes
set holeRadius to (the item at 0 in holes)'s diameter * 0.5
set expectedVolume to ((platePart's kind's width * platePart's kind's depth) - ((4.0 * 3.0) * (holeRadius * holeRadius))) * plateFrame's length
check plate mesh ((the absolute value of ((the fast mesh volume of built's shape) - expectedVolume)) < 1e-9) named (the string form of "four through holes preserve plate volume")
set blind to an empty list of a connection void
append (@intrinsic("construct", a connection void, 0 as a 64 bit integer, 1, plateFrame's first, plateFrame's along, 0.01, (plateFrame's length * 0.5), 0)) to blind
set refused to the bim perforated flat plate of platePart's element typed platePart's kind in hallModel cut by blind
check plate mesh (refused's valid = false) named (the string form of "blind holes retain the general BREP path")
set skew to an empty list of a connection void
set skewAxis to (the cad sum of plateFrame's along and plateFrame's widthAxis) scaled by 0.7071067811865476
append (@intrinsic("construct", a connection void, 0 as a 64 bit integer, 1, (the cad difference of plateFrame's first and (skewAxis scaled by plateFrame's length)), skewAxis, 0.01, (plateFrame's length * 4.0), 0)) to skew
set refused to the bim perforated flat plate of platePart's element typed platePart's kind in hallModel cut by skew
check plate mesh (refused's valid = false) named (the string form of "skew holes retain the general BREP path")
set edgeCuts to an empty list of a connection void
set edgeSpot to the cad sum of plateFrame's first and (plateFrame's widthAxis scaled by (platePart's kind's width * 0.5))
append (@intrinsic("construct", a connection void, 0 as a 64 bit integer, 1, edgeSpot, plateFrame's along, 0.01, plateFrame's length, 0)) to edgeCuts
set refused to the bim perforated flat plate of platePart's element typed platePart's kind in hallModel cut by edgeCuts
check plate mesh (refused's valid = false) named (the string form of "edge holes retain the general BREP path")
free holes
free blind
free skew
free edgeCuts
