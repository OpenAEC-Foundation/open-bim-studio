# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/bim_network.dl
function check detail {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set levelId to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set pipeType to add bim linear type named (the string form of "Pipe") as role bim pipe role sized 0.05 by 0.05 round true of (the string form of "copper") to target
set ductType to add bim linear type named (the string form of "Duct") as role bim duct role sized 0.20 by 0.20 round false of (the string form of "steel") to target
set firstId to add bim linear typed pipeType on levelId from (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (a cad vector3 with x 1.0, y 0.0 and z 0.0) turned 0.0 to target
set secondId to add bim linear typed ductType on levelId from (a cad vector3 with x 1.0, y 0.0 and z 0.0) to (a cad vector3 with x 2.0, y 0.0 and z 0.0) turned 0.0 to target
set network to the bim network of modelValue
check detail ((the length of (network's nodes's values)) = 4) named (the string form of "pipe and duct remain separate")
set second to the item at 1 in (modelValue's linears's values)
set second's typeId to pipeType
replace item at index 1 in (modelValue's linears's values) with second
set network to the bim network of modelValue
check detail ((the length of (network's nodes's values)) = 3) named (the string form of "compatible unassigned pipes connect")
set water to add bim system named (the string form of "Cold water") of discipline bim water discipline to target
set hotWater to add bim system named (the string form of "Hot water") of discipline bim water discipline to target
ignore assign bim element firstId to system water in target
ignore assign bim element secondId to system hotWater in target
set network to the bim network of modelValue
check detail ((the length of (network's nodes's values)) = 4) named (the string form of "different systems remain separate")
ignore assign bim element secondId to system water in target
set network to the bim network of modelValue
check detail ((the length of (network's nodes's values)) = 3) named (the string form of "same system reconnects")
