# SPDX-License-Identifier: MPL-2.0
# The same house, turned by an angle, built around the origin and far from it.
# Every derived result of the far copy is moved back by the offset and
# compared with the near copy:
# wall statuses and volumes, plan and section cut polygons, and spaces. Then
# one corner of each is moved 5 cm and the incremental update is compared.
# Prints the largest deviations in metres (square and cubic metres for areas
# and volumes) and the evaluation times.
import examples/bim-slice/bim_editor.dl

class:
    patterns:
        [a|] far test house record
    members:
        modelValue as a bim model record
        corner as a 64 bit integer
        cornerNeighbour as a 64 bit integer

# Places the house: turned by `angle` about the origin, then moved by `offset`.
class:
    patterns:
        [a|] far test placement record
    members:
        move as a cad vector2
        turnCosine as a 64 bit floating-point number
        turnSine as a 64 bit floating-point number

function the far test point {a 64 bit floating-point number:x} {a 64 bit floating-point number:y} shifted {far test placement record:offset}:
    execute:
        return a cad vector2 with x ((((offset's turnCosine) * x) - ((offset's turnSine) * y)) + offset's move's x) and y ((((offset's turnSine) * x) + ((offset's turnCosine) * y)) + offset's move's y)

function a far test house shifted {far test placement record:offset}:
    execute:
        set modelValue to an empty bim model
        set target to the address of modelValue
        set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
        set layerValues to an empty list of a bim layer record
        append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
        append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.12)) to layerValues
        append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.1)) to layerValues
        set cavity to add bim wall type named (the string form of "Cavity wall") with layerValues to target
        free layerValues
        set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
        set south to add bim wall typed cavity on storey from (the far test point -2.0 -1.5 shifted offset) to (the far test point 8.0 -1.5 shifted offset) to target
        set east to add bim wall typed cavity on storey from (the far test point 8.0 -1.5 shifted offset) to (the far test point 8.0 5.5 shifted offset) to target
        set north to add bim wall typed cavity on storey from (the far test point 8.0 5.5 shifted offset) to (the far test point -2.0 5.5 shifted offset) to target
        set west to add bim wall typed cavity on storey from (the far test point -2.0 5.5 shifted offset) to (the far test point -2.0 -1.5 shifted offset) to target
        ignore add bim wall typed cavity on storey from (the far test point 3.0 -1.5 shifted offset) to (the far test point 3.0 5.5 shifted offset) to target
        ignore add bim wall typed cavity on storey from (the far test point 3.0 2.0 shifted offset) to (the far test point 8.0 2.0 shifted offset) to target
        ignore add bim opening typed windowType in south at 2.5 to target
        ignore add bim opening typed windowType in south at 7.5 to target
        ignore add bim opening typed windowType in east at 1.75 to target
        ignore add bim opening typed windowType in east at 5.25 to target
        ignore add bim opening typed windowType in north at 2.5 to target
        ignore add bim opening typed windowType in north at 8.0 to target
        ignore add bim opening typed windowType in west at 4.5 to target
        return @intrinsic("construct", a far test house record, modelValue, south, east)

function the far test text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.3f", value)
        return the substring of buffer from 0 spanning written bytes

local function the far test scientific text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.3g", value)
        return the substring of buffer from 0 spanning written bytes

class:
    patterns:
        [a|] far test deviation record
    members:
        worst as a 64 bit floating-point number
        mismatches as an integer

function note far test difference {a 64 bit floating-point number:difference} in {a pointer to a far test deviation record:deviation}:
    execute:
        if difference != difference:
            set deviation's mismatches to deviation's mismatches + 1
        else:
            set magnitude to the absolute value of difference
            if magnitude > deviation's worst:
                set deviation's worst to magnitude

function compare far test views {bim view record:nearView} with {bim view record:farView} shifted by {cad vector2:shift} into {a pointer to a far test deviation record:deviation}:
    execute:
        if (the length of (nearView's sources's values)) != (the length of (farView's sources's values)):
            set deviation's mismatches to deviation's mismatches + 1
            return nothing
        loop sourceCursor from 0 to the length of (nearView's sources's values):
            set nearPolygons to (the item at sourceCursor in (nearView's sources's values))'s polygons's values
            set farPolygons to (the item at sourceCursor in (farView's sources's values))'s polygons's values
            if (the length of nearPolygons) != (the length of farPolygons):
                set deviation's mismatches to deviation's mismatches + 1
            else:
                loop polygonCursor from 0 to the length of nearPolygons:
                    set nearPoints to (the item at polygonCursor in nearPolygons)'s points's values
                    set farPoints to (the item at polygonCursor in farPolygons)'s points's values
                    if (the length of nearPoints) != (the length of farPoints):
                        set deviation's mismatches to deviation's mismatches + 1
                    else:
                        loop pointCursor from 0 to the length of nearPoints:
                            set nearPoint to the item at pointCursor in nearPoints
                            set farPoint to the item at pointCursor in farPoints
                            note far test difference ((farPoint's x - shift's x) - nearPoint's x) in deviation
                            note far test difference ((farPoint's y - shift's y) - nearPoint's y) in deviation

function report far test deviation {far test deviation record:deviation} labelled {a string:label}:
    execute:
        set line to (label + (the string form of " worst ")) + (the far test scientific text of deviation's worst)
        print ((line + (the string form of " mismatches ")) + (the string form of deviation's mismatches)) as a line

function measure far test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} turned {a 64 bit floating-point number:angle}:
    execute:
        set shift to a cad vector2 with x x and y y
        set origin to a cad vector2 with x 0.0 and y 0.0
        set here to @intrinsic("construct", a far test placement record, origin, the cosine of angle, the sine of angle)
        set offset to @intrinsic("construct", a far test placement record, shift, the cosine of angle, the sine of angle)
        set nearHouse to a far test house shifted here
        set farHouse to a far test house shifted offset
        set began to the bim microseconds now
        set nearEvaluation to the bim evaluation of nearHouse's modelValue after (an empty bim evaluation)
        set nearTime to (the bim microseconds now) - began
        set began to the bim microseconds now
        set farEvaluation to the bim evaluation of farHouse's modelValue after (an empty bim evaluation)
        set farTime to (the bim microseconds now) - began
        set heading to ((the string form of "offset ") + (the far test text of x)) + (the string form of " ")
        print (((heading + (the far test text of y)) + (the string form of " turned ")) + (the string form of angle)) as a line
        set statuses to (the string form of "statuses near")
        loop cursor from 0 to the length of (nearEvaluation's elements's values):
            set statuses to (statuses + (the string form of " ")) + (the string form of (the item at cursor in (nearEvaluation's elements's values))'s status)
        set statuses to statuses + (the string form of " far")
        loop cursor from 0 to the length of (farEvaluation's elements's values):
            set statuses to (statuses + (the string form of " ")) + (the string form of (the item at cursor in (farEvaluation's elements's values))'s status)
        print statuses as a line
        set volumes to @intrinsic("construct", a far test deviation record, 0.0, 0)
        loop cursor from 0 to the length of (nearEvaluation's elements's values):
            note far test difference ((the bim volume of (the item at cursor in (farEvaluation's elements's values))) - (the bim volume of (the item at cursor in (nearEvaluation's elements's values)))) in (the address of volumes)
        report far test deviation volumes labelled (the string form of "wall volume m3")
        set plans to @intrinsic("construct", a far test deviation record, 0.0, 0)
        compare far test views (the bim plan of nearEvaluation at 0.0 cut at 1.2) with (the bim plan of farEvaluation at 0.0 cut at 1.2) shifted by shift into (the address of plans)
        report far test deviation plans labelled (the string form of "plan point m")
        set sections to @intrinsic("construct", a far test deviation record, 0.0, 0)
        set nearSection to the bim section of nearEvaluation from (the far test point 0.5 -3.0 shifted here) to (the far test point 0.5 7.0 shifted here)
        set farSection to the bim section of farEvaluation from (the far test point 0.5 -3.0 shifted offset) to (the far test point 0.5 7.0 shifted offset)
        compare far test views nearSection with farSection shifted by origin into (the address of sections)
        report far test deviation sections labelled (the string form of "section point m")
        set nearSpaces to the bim spaces of nearHouse's modelValue on level (1 as a 64 bit integer) using nearEvaluation's index
        set farSpaces to the bim spaces of farHouse's modelValue on level (1 as a 64 bit integer) using farEvaluation's index
        set spaces to @intrinsic("construct", a far test deviation record, 0.0, 0)
        if (the length of (nearSpaces's values)) != (the length of (farSpaces's values)):
            set spaces's mismatches to spaces's mismatches + 1
        else:
            loop cursor from 0 to the length of (nearSpaces's values):
                note far test difference ((the item at cursor in (farSpaces's values))'s area - (the item at cursor in (nearSpaces's values))'s area) in (the address of spaces)
        set spaceLine to (the string form of "spaces near ") + (the string form of (the length of (nearSpaces's values)))
        print ((spaceLine + (the string form of " far ")) + (the string form of (the length of (farSpaces's values)))) as a line
        report far test deviation spaces labelled (the string form of "space area m2")
        # Move the corner between the south and east walls 5 cm east.
        set nearTarget to the address of (nearHouse's modelValue)
        set farTarget to the address of (farHouse's modelValue)
        set corner to the far test point 8.05 -1.5 shifted here
        ignore move bim wall nearHouse's corner to (the far test point -2.0 -1.5 shifted here) and corner in nearTarget
        ignore move bim wall nearHouse's cornerNeighbour to corner and (the far test point 8.0 5.5 shifted here) in nearTarget
        set farCorner to the far test point 8.05 -1.5 shifted offset
        ignore move bim wall farHouse's corner to (the far test point -2.0 -1.5 shifted offset) and farCorner in farTarget
        ignore move bim wall farHouse's cornerNeighbour to farCorner and (the far test point 8.0 5.5 shifted offset) in farTarget
        set began to the bim microseconds now
        update bim evaluation (the address of nearEvaluation) to nearHouse's modelValue
        set nearMove to (the bim microseconds now) - began
        set began to the bim microseconds now
        update bim evaluation (the address of farEvaluation) to farHouse's modelValue
        set farMove to (the bim microseconds now) - began
        set moved to @intrinsic("construct", a far test deviation record, 0.0, 0)
        loop cursor from 0 to the length of (nearEvaluation's elements's values):
            note far test difference ((the bim volume of (the item at cursor in (farEvaluation's elements's values))) - (the bim volume of (the item at cursor in (nearEvaluation's elements's values)))) in (the address of moved)
        set line to (the string form of "after move rebuilt near ") + (the string form of nearEvaluation's rebuilt)
        print ((line + (the string form of " far ")) + (the string form of farEvaluation's rebuilt)) as a line
        report far test deviation moved labelled (the string form of "moved wall volume m3")
        set line to ((the string form of "evaluation us near ") + (the string form of nearTime)) + (the string form of " far ")
        set line to ((line + (the string form of farTime)) + (the string form of " move near ")) + (the string form of nearMove)
        print ((line + (the string form of " far ")) + (the string form of farMove)) as a line

measure far test at 500000.0 and 500000.0 turned 0.0
measure far test at 500000.123 and 499999.987 turned 0.3
measure far test at 155000.0 and 463000.0 turned 1.1
