# SPDX-License-Identifier: MPL-2.0
# GUI route deliberately receives an unusable converter path: DXF is native.
import examples/bim-slice/bim_editor.dl

function check dxf editor {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set path to the string form of "/tmp/obs-native-dxf-reference-editor-test.dxf"
set source to the string form of "0\nSECTION\n2\nHEADER\n9\n$INSUNITS\n70\n4\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n0\nLINE\n8\nReference\n10\n0\n20\n0\n11\n1000\n21\n0\n0\nENDSEC\n0\nEOF\n"
ignore (write bim text source to file path)
set editor to a new bim editor
set e to the address of editor
set editor's lengthUnit to bim metre unit
set count to import bim drawing at path through (the string form of "/nonexistent-converter") in e
check dxf editor ((count = 1) and (editor's selectionKind = bim instance picked)) named (the string form of "DXF GUI route is native and selects the reference")
set id to editor's selectionId
start bim editor property bim instance x property in e
set editor's propertyText to the string form of "2"
apply bim editor property in e
start bim editor property bim instance y property in e
set editor's propertyText to the string form of "3"
apply bim editor property in e
start bim editor property bim instance angle property in e
set editor's propertyText to the string form of "90"
apply bim editor property in e
set placed to the item at (the bim instance index of id in editor's documentValue's current)'s position in (editor's documentValue's current's instances's values)
check dxf editor ((placed's origin's x = 2.0) and (placed's origin's y = 3.0)) named (the string form of "reference origin is numerically editable")
set snapped to the bim snap of (a cad vector2 with x 2.004 and y 4.003) in editor within 0.01
check dxf editor (((the absolute value of (snapped's point's x - 2.0)) < 1e-9) and ((the absolute value of (snapped's point's y - 4.0)) < 1e-9)) named (the string form of "rotated reference endpoints participate in object snaps")
set before to editor's documentValue's revision
ignore (write bim text (the string form of "broken\nDXF\n") to file path)
set refused to import bim drawing at path through (the string form of "/nonexistent-converter") in e
check dxf editor ((refused = -1) and (editor's documentValue's revision = before)) named (the string form of "malformed DXF cannot create an undo entry or partial model")
ignore undo bim transaction in (the address of (editor's documentValue))
ignore undo bim transaction in (the address of (editor's documentValue))
ignore undo bim transaction in (the address of (editor's documentValue))
ignore undo bim transaction in (the address of (editor's documentValue))
check dxf editor ((the length of (editor's documentValue's current's instances's values)) = 0) named (the string form of "origin rotation and import each undo")
