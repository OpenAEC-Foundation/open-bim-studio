# SPDX-License-Identifier: MPL-2.0
# The 3D view's zoom queue meshes round shapes again a few at a time
# (`the bim sketch meshes of … refreshing …`): three columns, the first and
# the last made round, meshed coarse, then the first two made again fine.
# The first comes out as a fine mesh made whole, the square second as it
# was, the third stays coarse.
import examples/bim-slice/bim_editor.dl

function click zoom test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function make zoom test column at {a 64 bit floating-point number:x} round in {a pointer to a bim editor record:editor} as {a 64 bit integer:roundType}:
    execute:
        type bim editor key bim escape key code in editor
        click zoom test at x and 0.0 in editor
        choose bim editor linear type roundType in editor

function the zoom test corners of {a pointer to a list:sceneMeshes} at {integer:position}:
    execute:
        return the length of ((the item at position in sceneMeshes)'s shape's triangles's values)

set editor to a new bim editor
set e to the address of editor
type bim editor key 2070 in e
click zoom test at 0.0 and 0.0 in e
click zoom test at 3.0 and 0.0 in e
click zoom test at 6.0 and 0.0 in e
set roundType to the bim refused id
loop cursor from 0 to the length of (editor's documentValue's current's linearTypes's values):
    set linearType to the item at cursor in (editor's documentValue's current's linearTypes's values)
    if linearType's name = (the string form of "Beton rond 300"):
        set roundType to linearType's id
make zoom test column at 0.0 round in e as roundType
make zoom test column at 6.0 round in e as roundType
set modelValue to editor's documentValue's current
set coarse to the bim sketch meshes of modelValue within 0.01
set fine to the bim sketch meshes of modelValue within 0.0005
set remade to an empty list of a boolean
loop cursor from 0 to the length of (coarse's values):
    append (cursor < 2) to remade
set refreshed to the bim sketch meshes of modelValue within 0.0005 reusing (coarse's values) refreshing remade
print ((the string form of "meshes: ") + (the string form of (the length of (refreshed's values)))) as a line
loop cursor from 0 to the length of (refreshed's values):
    set writtenLine to ((the string form of "column ") + (the string form of cursor)) + (the string form of ": coarse ")
    set writtenLine to (writtenLine + (the string form of (the zoom test corners of (coarse's values) at cursor))) + (the string form of ", fine ")
    set writtenLine to (writtenLine + (the string form of (the zoom test corners of (fine's values) at cursor))) + (the string form of ", refreshed ")
    set writtenLine to writtenLine + (the string form of (the zoom test corners of (refreshed's values) at cursor))
    set writtenLine to (writtenLine + (the string form of ", as fine ")) + (the string form of (bim scene mesh (the item at cursor in (refreshed's values)) repeats (the item at cursor in (fine's values))))
    set writtenLine to (writtenLine + (the string form of ", as coarse ")) + (the string form of (bim scene mesh (the item at cursor in (refreshed's values)) repeats (the item at cursor in (coarse's values))))
    print writtenLine as a line
