import examples/bim-slice/bim_section_caps.dl

function check cut case {boolean:accepted} named {a string:description}:
    execute:
        if accepted = false:
            print ((the string form of "FAIL: ") + description) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + description) as a line

function the cut test area of {fast mesh record:testedShape}:
    execute:
        set accumulatedArea to 0.0
        set faceCursor to 0
        loop while (faceCursor + 2) < (the length of (testedShape's triangles's values)):
            set firstSpot to the item at (the item at faceCursor in (testedShape's triangles's values)) in (testedShape's positions's values)
            set nextSpot to the item at (the item at (faceCursor + 1) in (testedShape's triangles's values)) in (testedShape's positions's values)
            set lastSpot to the item at (the item at (faceCursor + 2) in (testedShape's triangles's values)) in (testedShape's positions's values)
            set crossValue to the cad cross of (the cad difference of nextSpot and firstSpot) and (the cad difference of lastSpot and firstSpot)
            set accumulatedArea to accumulatedArea + ((the square root of (the cad dot of crossValue and crossValue)) / 2.0)
            set faceCursor to faceCursor + 3
        return accumulatedArea

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set typeId to add bim linear type named (the string form of "Square") as role (bim generic linear role) sized 2.0 by 2.0 round false of (the string form of "concrete") to target
set beamId to add bim linear typed typeId on ground from (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (a cad vector3 with x 0.0, y 0.0 and z 4.0) turned 0.0 to target
set beamValue to the item at (the bim linear index of beamId in modelValue)'s position in (modelValue's linears's values)
set originalShape to the bim linear shape of beamValue in modelValue
set originalCount to the length of (originalShape's triangles's values)
set lowerLimit to a cad vector3 with x -3.0, y -3.0 and z -1.0
set upperLimit to a cad vector3 with x 3.0, y 3.0 and z 2.0
set capShape to the bim cut caps of originalShape from lowerLimit to upperLimit
check cut case ((the absolute value of ((the cut test area of capShape) - 4.0)) < 1e-7) named (the string form of "one cut closes the square with area four")
set facingUp to true
loop spotCursor from 0 to the length of (capShape's positions's values):
    set spotValue to the item at spotCursor in (capShape's positions's values)
    set normalValue to the item at spotCursor in (capShape's normals's values)
    if ((the absolute value of (spotValue's z - 2.0)) > 1e-7) or (normalValue's z < 0.99):
        set facingUp to false
check cut case facingUp named (the string form of "cap lies on the plane facing the removed half")
set twoCaps to the bim cut caps of originalShape from (a cad vector3 with x -3.0, y -3.0 and z 1.0) to upperLimit
check cut case ((the absolute value of ((the cut test area of twoCaps) - 8.0)) < 1e-7) named (the string form of "two opposing cuts each close their face")
set tangentCaps to the bim cut caps of originalShape from lowerLimit to (a cad vector3 with x 3.0, y 3.0 and z 4.0)
check cut case ((the length of (tangentCaps's triangles's values)) = 0) named (the string form of "a tangent box creates no duplicate coplanar face")
check cut case ((the length of (originalShape's triangles's values)) = originalCount) named (the string form of "view cuts leave source geometry unchanged")
set looseEnds to an empty list of a cad vector3
append (a cad vector3 with x 0.0, y 0.0 and z 0.0) to looseEnds
append (a cad vector3 with x 1.0, y 0.0 and z 0.0) to looseEnds
set openCap to the bim closed cut face from looseEnds at (a cad vector3 with x 0.0, y 0.0 and z 0.0) facing (a cad vector3 with x 0.0, y 0.0 and z 1.0)
check cut case ((the length of (openCap's triangles's values)) = 0) named (the string form of "an open section is never invented as a solid face")
free looseEnds
