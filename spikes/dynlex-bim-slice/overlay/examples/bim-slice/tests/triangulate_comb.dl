# SPDX-License-Identifier: MPL-2.0
# Ear clipping of a face with many corners (`lib/cadkernel/triangulate2.dl`
# in the overlay): a comb of 450 teeth, 1,804 corners, as Sixty5's largest
# faces have. Testing every corner against every point at each cut took
# about 6 s for it; keeping each corner's state takes a fraction of a second.
# Its 1,802 triangles cover its area, 7,200.
import lib/cadkernel/triangulate2.dl

set outline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to outline
loop tooth from 0 to 450:
    set toothLeft to ((tooth * 2) as a 64 bit floating-point number) + 0.5
    append (a cad vector2 with x toothLeft and y 0.0) to outline
    append (a cad vector2 with x toothLeft and y 10.0) to outline
    append (a cad vector2 with x (toothLeft + 1.0) and y 10.0) to outline
    append (a cad vector2 with x (toothLeft + 1.0) and y 0.0) to outline
append (a cad vector2 with x 900.0 and y 0.0) to outline
append (a cad vector2 with x 900.0 and y -3.0) to outline
append (a cad vector2 with x 0.0 and y -3.0) to outline
set noHoles to an empty list of the type of outline
set mesh to the cad triangulation of outline with holes noHoles
set covered to 0.0
loop face from 0 to the length of the triangles of mesh:
    set corners to the item at face in the triangles of mesh
    set a to the item at (the first of corners) in the points of mesh
    set b to the item at (the second of corners) in the points of mesh
    set c to the item at (the third of corners) in the points of mesh
    set doubled to (((the x of b) - (the x of a)) * ((the y of c) - (the y of a))) - (((the x of c) - (the x of a)) * ((the y of b) - (the y of a)))
    set covered to covered + (doubled * 0.5)
print ((the string form of "corners: ") + (the string form of (the length of outline))) as a line
print ((the string form of "triangles: ") + (the string form of (the length of the triangles of mesh))) as a line
print ((the string form of "area: ") + (the string form of ((covered + 0.5) as an integer))) as a line
free cad triangulation mesh
free noHoles
free outline
