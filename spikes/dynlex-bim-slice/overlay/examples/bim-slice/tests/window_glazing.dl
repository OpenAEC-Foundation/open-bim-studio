import examples/bim-slice/bim_system_types.dl
import examples/bim-slice/bim_file.dl
import examples/bim-slice/bim_view.dl

function check window glazing {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the count of glazing parts named {a string:partName} in {a pointer to a list:parts}:
    execute:
        set total to 0
        loop cursor from 0 to the length of parts:
            if (the item at cursor in parts)'s kind's name = partName:
                set total to total + 1
        return total

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
# Rotated in plan: positive normal offsets move along x, not world y.
set systemId to add bim curtain wall on ground from (a cad vector2 with x 4.0 and y 2.0) to (a cad vector2 with x 4.0 and y 3.2) rising 1.5 in bays of 2.0 by 2.0 of (the string form of "timber") to target
ignore give bim system systemId type 21 in target
set categoryCode to the bim category of element systemId in modelValue
check window glazing (categoryCode = bim wall category) named (the string form of "hosted frame category matches the scene visibility rule")
set fixedParts to the bim parts of curtain wall (the item at 0 in (modelValue's curtains's values)) in modelValue
check window glazing (((the count of glazing parts named (the string form of "Glazing bead") in (fixedParts's values)) = 8) and ((the count of glazing parts named (the string form of "Glazing seal") in (fixedParts's values)) = 8)) named (the string form of "fixed glazing has complete interior and exterior rings")
set clearGlass to true
set bounded to true
set owned to true
set seals to true
loop cursor from 0 to the length of (fixedParts's values):
    set partValue to the item at cursor in (fixedParts's values)
    if partValue's element's id != systemId:
        set owned to false
    if partValue's kind's name = (the string form of "Glazing bead"):
        set distance to the absolute value of (partValue's element's start's x - 4.0)
        set halfDepth to partValue's kind's depth * 0.5
        if (the absolute value of (partValue's element's start's z - partValue's element's finish's z)) < 1e-9:
            set halfDepth to partValue's kind's width * 0.5
        if (distance - halfDepth) < 0.01499:
            set clearGlass to false
        if (distance + halfDepth) > 0.057001:
            set bounded to false
    if partValue's kind's name = (the string form of "Glazing seal"):
        if (partValue's kind's material != (the string form of "rubber")) or ((the absolute value of ((the absolute value of (partValue's element's start's x - 4.0)) - 0.0135)) > 1e-9):
            set seals to false
check window glazing clearGlass named (the string form of "beads sit beyond the glass faces without coplanar surfaces")
check window glazing bounded named (the string form of "beads stay inside the nominal frame depth")
check window glazing seals named (the string form of "rubber seals follow the rotated system normal")
check window glazing owned named (the string form of "all detail belongs to one editable building system")
set reread to the bim model parsed from (the bim file text of modelValue)
set restoredParts to the bim parts of curtain wall (the item at 0 in (reread's modelValue's curtains's values)) in reread's modelValue
check window glazing (reread's valid and ((the length of (restoredParts's values)) = 21)) named (the string form of "native roundtrip regenerates the complete detail")
ignore give bim system systemId type 3 in target
grid bim example system systemId in bays of 2.0 by 2.0 in target
set legacyParts to the bim parts of curtain wall (the item at 0 in (modelValue's curtains's values)) in modelValue
check window glazing ((the count of glazing parts named (the string form of "Glazing bead") in (legacyParts's values)) = 8) named (the string form of "legacy window grids receive detail without changing layout")
ignore give bim system systemId type 28 in target
set opaqueParts to the bim parts of curtain wall (the item at 0 in (modelValue's curtains's values)) in modelValue
check window glazing ((the count of glazing parts named (the string form of "Glazing bead") in (opaqueParts's values)) = 0) named (the string form of "opaque door panels do not acquire glazing beads")
ignore give bim system systemId type 0 in target
set facadeParts to the bim parts of curtain wall (the item at 0 in (modelValue's curtains's values)) in modelValue
check window glazing ((the count of glazing parts named (the string form of "Glazing bead") in (facadeParts's values)) = 0) named (the string form of "unrelated curtain walls retain their original construction")
ignore give bim system systemId type 21 in target
set bim setting (bim joint depth setting) of systemId to (24 as a 64 bit integer) keeping true in target
set thinParts to the bim parts of curtain wall (the item at 0 in (modelValue's curtains's values)) in modelValue
check window glazing ((the count of glazing parts named (the string form of "Glazing bead") in (thinParts's values)) = 0) named (the string form of "thin profiles keep plain glass instead of protruding detail")
