# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/bim_svg.dl
import examples/bim-slice/bim_drawing_standard.dl

function check paper units {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set screen to a new bim canvas
check paper units ((the bim symbol scale of screen) = 1.0) named (the string form of "screen symbols retain pixel dimensions")
set sheet to a new bim canvas
set sheet's paperScale to 1.0
check paper units ((the bim symbol scale of sheet) = 0.25) named (the string form of "millimetre sheet converts screen symbol units")
set points to an empty list of a cad vector2
append (a cad vector2 with x 10.0 and y 20.0) to points
append (a cad vector2 with x 30.0 and y 20.0) to points
record bim strokes points coloured 0, 0 and 0 wide 0.7 on (the address of sheet)
set batch to the item at 0 in (sheet's batches's values)
set firstPoint to the item at 0 in (batch's pixels's values)
check paper units ((the absolute value of (firstPoint's y - 20.0875)) < 1e-9) named (the string form of "dimension hairline is 0.175 mm")
record bim dimension text (the string form of "2000") between (the item at 0 in points) and (the item at 1 in points) on (the address of sheet)
set label to the item at 0 in (sheet's texts's values)
check paper units ((the absolute value of (label's y - 18.75)) < 1e-9) named (the string form of "dimension text offset is 1.25 mm")
set ticks to an empty list of a cad vector2
append bim dimension ends at (the item at 0 in points) and (the item at 1 in points) along 1.0 and 0.0 under (bim nen standard) scaled 0.25 into ticks
set tickStart to the item at 0 in ticks
check paper units ((the absolute value of (tickStart's x - 9.2925)) < 1e-9) named (the string form of "dimension tick is scaled in paper units")
set sheet's paperScale to 2.0
check paper units ((the bim symbol scale of sheet) = 0.5) named (the string form of "higher export density preserves physical symbol size")
