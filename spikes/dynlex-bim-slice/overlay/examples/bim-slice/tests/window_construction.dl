# SPDX-License-Identifier: MPL-2.0
# Native derived parts, no editor/window imports.
import examples/bim-slice/bim_system_types.dl
import examples/bim-slice/bim_file.dl
function check window construction {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line
function the count of window parts named {a string:partName} in {a pointer to a list:parts}:
    execute:
        set total to 0
        loop cursor from 0 to the length of parts:
            if (the item at cursor in parts)'s kind's name = partName:
                set total to total + 1
        return total
set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set systemId to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 3.6 and y 0.0) rising 2.4 in bays of 1.2 by 1.2 of (the string form of "timber") to target
ignore give bim system systemId type 33 in target
set fixedParts to the bim parts of curtain wall (the item at 0 in (modelValue's curtains's values)) in modelValue
check window construction ((the length of (fixedParts's values)) = 21) named (the string form of "fixed window includes frame glass beads and seals")
ignore give bim system systemId type 34 in target
set casementParts to the bim parts of curtain wall (the item at 0 in (modelValue's curtains's values)) in modelValue
check window construction (((the count of window parts named (the string form of "Sash stile") in (casementParts's values)) = 4) and ((the count of window parts named (the string form of "Sash rail") in (casementParts's values)) = 4)) named (the string form of "double casement generates two real four-sided sashes")
set validGlass to true
set glassCount to 0
loop cursor from 0 to the length of (casementParts's values):
    set partValue to the item at cursor in (casementParts's values)
    if partValue's kind's material = (the string form of "glass"):
        set glassCount to glassCount + 1
        if ((the absolute value of (partValue's kind's width - 1.584)) > 0.0001) or ((the absolute value of ((partValue's element's finish's z - partValue's element's start's z) - 2.184)) > 0.0001):
            set validGlass to false
check window construction (validGlass and (glassCount = 2)) named (the string form of "glazing is inset inside the sash rather than overlapping its profiles")
ignore give bim system systemId type 42 in target
set slidingParts to the bim parts of curtain wall (the item at 0 in (modelValue's curtains's values)) in modelValue
check window construction ((the count of window parts named (the string form of "Sliding guide") in (slidingParts's values)) = 6) named (the string form of "three tracks generate sill and head guides")
set previousDepth to 1e100
set separated to true
set owned to true
set glassCount to 0
loop cursor from 0 to the length of (slidingParts's values):
    set partValue to the item at cursor in (slidingParts's values)
    if partValue's element's id != systemId:
        set owned to false
    if partValue's kind's material = (the string form of "glass"):
        set glassCount to glassCount + 1
        set actualDepth to partValue's element's start's y
        if (previousDepth - actualDepth) <= partValue's kind's depth:
            set separated to false
        set previousDepth to actualDepth
check window construction (separated and (glassCount = 3)) named (the string form of "sliding glazing occupies three separated depth planes")
check window construction owned named (the string form of "all generated parts retain the editable system identity")
set reread to the bim model parsed from (the bim file text of modelValue)
set restoredParts to the bim parts of curtain wall (the item at 0 in (reread's modelValue's curtains's values)) in reread's modelValue
check window construction (reread's valid and ((the length of (restoredParts's values)) = (the length of (slidingParts's values)))) named (the string form of "saved recipe regenerates complete sash and track construction")
set bim setting ((bim unpinned line setting) + 2000) of systemId to (1 as a 64 bit integer) keeping true in target
set reducedParts to the bim parts of curtain wall (the item at 0 in (modelValue's curtains's values)) in modelValue
check window construction ((the count of window parts named (the string form of "Sash stile") in (reducedParts's values)) = 4) named (the string form of "unpinning a panel removes its derived sash")
ignore give bim system systemId type 33 in target
set retypedParts to the bim parts of curtain wall (the item at 0 in (modelValue's curtains's values)) in modelValue
check window construction (((the count of window parts named (the string form of "Sliding guide") in (retypedParts's values)) = 0) and ((the count of window parts named (the string form of "Sash stile") in (retypedParts's values)) = 0)) named (the string form of "retyping fixed removes operable construction")
set narrowId to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 5.0) to (a cad vector2 with x 0.5 and y 5.0) rising 0.5 in bays of 1.0 by 1.0 of (the string form of "timber") to target
ignore give bim system narrowId type 24 in target
grid bim example system narrowId in bays of 0.1 by 0.5 in target
set narrowParts to the bim parts of curtain wall (the item at (the bim curtain index of narrowId in modelValue)'s position in (modelValue's curtains's values)) in modelValue
check window construction (((the count of window parts named (the string form of "Panel") in (narrowParts's values)) = 5) and ((the count of window parts named (the string form of "Sash stile") in (narrowParts's values)) = 0)) named (the string form of "tiny cells retain safe plain glazing")
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layers
set wallType to add bim wall type named (the string form of "Brick") with layers to target
set wallId to add bim wall typed wallType on ground from (a cad vector2 with x 10.0 and y 0.0) to (a cad vector2 with x 16.0 and y 0.0) to target
set openingType to add bim opening type named (the string form of "Window") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
set openingId to add bim opening typed openingType in wallId at 3.0 to target
set hostedId to add bim system in opening openingId with joint (10 as a 64 bit integer) in bays of 0.6 by 0.75 of (the string form of "timber") to target
ignore give bim system hostedId type 34 in target
ignore set bim system hostedId depth in its wall to (50 as a 64 bit integer) in target
set hostedParts to the bim parts of curtain wall (the item at (the bim curtain index of hostedId in modelValue)'s position in (modelValue's curtains's values)) in modelValue
set hostedCorrect to true
set hostedSashes to 0
loop cursor from 0 to the length of (hostedParts's values):
    set partValue to the item at cursor in (hostedParts's values)
    if partValue's kind's name = (the string form of "Sash stile"):
        set hostedSashes to hostedSashes + 1
        if ((the absolute value of (partValue's element's start's z - 0.958)) > 0.000001) or ((the absolute value of (partValue's element's start's y + 0.05)) > 0.000001):
            set hostedCorrect to false
check window construction (hostedCorrect and (hostedSashes = 4)) named (the string form of "hosted sashes follow the opening sill and frame depth")
