# SPDX-License-Identifier: MPL-2.0
import examples/bim-slice/bim_type_manager.dl

function check manager unicode {boolean:accepted} named {a string:captionText}:
    execute:
        if accepted = false:
            print ((the string form of "FAIL: ") + captionText) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + captionText) as a line

set workEditor to a new bim editor
set editorPointer to the address of workEditor
set chosenType to add bim managed type on tab 0 in editorPointer
check manager unicode (set bim managed type chosenType on tab 0 layer 0 field 0 to (the string form of "QA shared wall é") in editorPointer) named (the string form of "UTF8 type name is accepted")
check manager unicode ((the bim managed type chosenType on tab 0 in workEditor's documentValue's current)'s name = (the string form of "QA shared wall é")) named (the string form of "UTF8 name bytes are preserved")
check manager unicode (set bim managed type chosenType on tab 0 layer 0 field 1 to (the string form of "béton") in editorPointer) named (the string form of "UTF8 material is accepted")
check manager unicode ((the bim managed field 1 of (the bim managed type chosenType on tab 0 in workEditor's documentValue's current) layer 0 in workEditor) = (the string form of "béton")) named (the string form of "UTF8 material bytes are preserved")
set controlByte to a new string buffer containing 1 bytes
store (10 as a byte) into the data of controlByte at 0
set undoCount to the length of (workEditor's documentValue's undoStack's values)
check manager unicode ((set bim managed type chosenType on tab 0 layer 0 field 0 to ((the string form of "bad") + controlByte) in editorPointer) = false) named (the string form of "ASCII control bytes remain refused")
check manager unicode ((the length of (workEditor's documentValue's undoStack's values)) = undoCount) named (the string form of "refused control byte creates no transaction")
set managerState to a new bim type manager
set managerPointer to the address of managerState
open bim type manager in managerPointer for editorPointer
set managerState's chosenId to chosenType
refresh bim type manager managerPointer for workEditor
set managerState's field to 0
set managerState's text to the string form of "é"
set managerState's replaceText to false
type bim type manager key 259 in managerPointer for editorPointer
check manager unicode ((the length of managerState's text) = 0) named (the string form of "Backspace removes one complete two byte character")
set managerState's text to the string form of "A"
type bim type manager character 8364 in managerPointer
check manager unicode ((the length of managerState's text) = 4) named (the string form of "three byte character is encoded after ASCII")
type bim type manager key 259 in managerPointer for editorPointer
check manager unicode (managerState's text = (the string form of "A")) named (the string form of "Backspace removes all three bytes and keeps ASCII")
type bim type manager character 128512 in managerPointer
check manager unicode ((the length of managerState's text) = 5) named (the string form of "four byte character is encoded after ASCII")
type bim type manager key 259 in managerPointer for editorPointer
check manager unicode (managerState's text = (the string form of "A")) named (the string form of "Backspace removes all four bytes and keeps ASCII")
type bim type manager character 233 in managerPointer
type bim type manager key (bim enter key code) in managerPointer for editorPointer
check manager unicode ((managerState's field = -1) and ((the bim managed type chosenType on tab 0 in workEditor's documentValue's current)'s name = (the string form of "Aé"))) named (the string form of "Enter saves a valid UTF8 name after multibyte editing")
set managerState's field to 1
set managerState's text to the string form of "café"
set managerState's replaceText to false
type bim type manager key 259 in managerPointer for editorPointer
type bim type manager character 233 in managerPointer
type bim type manager key (bim enter key code) in managerPointer for editorPointer
check manager unicode ((managerState's field = -1) and ((the bim managed field 1 of (the bim managed type chosenType on tab 0 in workEditor's documentValue's current) layer 0 in workEditor) = (the string form of "café"))) named (the string form of "Enter saves a valid UTF8 material after Backspace")
set undoCount to the length of (workEditor's documentValue's undoStack's values)
check manager unicode ((set bim managed type chosenType on tab 0 layer 0 field 0 to (the string form of "") in editorPointer) = false) named (the string form of "empty type name is refused without reading a byte")
check manager unicode ((set bim managed type chosenType on tab 0 layer 0 field 0 to (the string form of "   ") in editorPointer) = false) named (the string form of "space only type name is refused without reading past the end")
check manager unicode ((the length of (workEditor's documentValue's undoStack's values)) = undoCount) named (the string form of "empty names create no transaction")
set managerState's field to 0
set managerState's text to the string form of ""
set managerState's replaceText to false
type bim type manager key 259 in managerPointer for editorPointer
check manager unicode ((the length of managerState's text) = 0) named (the string form of "Backspace on an empty field keeps it empty")
set managerState's text to the string form of "café"
set managerState's replaceText to true
type bim type manager key 259 in managerPointer for editorPointer
check manager unicode (((the length of managerState's text) = 0) and (managerState's replaceText = false)) named (the string form of "first Backspace clears replacement text without reading a negative index")
type bim type manager key 259 in managerPointer for editorPointer
check manager unicode ((the length of managerState's text) = 0) named (the string form of "Backspace remains safe after replacement text was cleared")
