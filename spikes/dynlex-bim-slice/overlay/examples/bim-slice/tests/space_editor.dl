# SPDX-License-Identifier: MPL-2.0
# Explicit Space selection, editable properties, undo and matching 3D wires.
import examples/bim-slice/bim_editor.dl
import examples/bim-slice/bim_app_parts.dl

function check space editor {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set corners to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to corners
append (a cad vector2 with x 4.0 and y 0.0) to corners
append (a cad vector2 with x 4.0 and y 3.0) to corners
append (a cad vector2 with x 0.0 and y 3.0) to corners
set spaceId to add bim space object named (the string form of "Space") numbered (the string form of "1") on editor's levelId around corners high 2.7 to target
if (bim category bim space category is visible in editor's planRules) = false:
    toggle bim category bim space category visibility in (the address of (editor's planRules))
select bim editor element at (a cad vector2 with x 2.0 and y 1.5) in e
check space editor ((editor's selectionKind = bim space object picked) and (editor's selectionId = spaceId)) named (the string form of "plan selects standalone object")
start bim editor property bim space name property in e
set editor's propertyText to the string form of "Library"
apply bim editor property in e
ignore undo bim transaction in (the address of (editor's documentValue))
check space editor ((the item at 0 in (editor's documentValue's current's spaceObjects's values))'s name = (the string form of "Space")) named (the string form of "name edit undo")
ignore redo bim transaction in (the address of (editor's documentValue))
start bim editor property bim space number property in e
set editor's propertyText to the string form of "A 01"
apply bim editor property in e
set current to the item at 0 in (editor's documentValue's current's spaceObjects's values)
check space editor ((current's name = (the string form of "Library")) and (current's number = (the string form of "A 01"))) named (the string form of "name and number editable")
start bim editor property bim space height property in e
set editor's propertyText to the string form of "2.9"
apply bim editor property in e
check space editor ((the item at 0 in (editor's documentValue's current's spaceObjects's values))'s height = 2.9) named (the string form of "height editable")
ignore undo bim transaction in (the address of (editor's documentValue))
check space editor ((the item at 0 in (editor's documentValue's current's spaceObjects's values))'s height = 2.7) named (the string form of "height edit undo")
ignore redo bim transaction in (the address of (editor's documentValue))
set current to the item at 0 in (editor's documentValue's current's spaceObjects's values)
set shapeValue to the bim wire of space object current in editor's documentValue's current
check space editor ((the length of (shapeValue's positions's values)) = 24) named (the string form of "wire has floor ceiling and vertical edges")
set levelValue to the item at (the bim level index of editor's levelId in editor's documentValue's current)'s position in (editor's documentValue's current's levels's values)
set ray to @intrinsic("construct", a bim ray record, (a cad vector3 with x (-1.0), y 0.0 and z (levelValue's elevation + 1.0)), (a cad vector3 with x 1.0, y 0.0 and z 0.0))
set low to a cad vector3 with x 1.0, y (-1.0) and z (levelValue's elevation + 0.5)
set high to a cad vector3 with x 2.0, y 4.0 and z (levelValue's elevation + 2.0)
set hit to the bim space object pick along ray in editor's documentValue's current on level editor's levelId within 0.05 clipped false from low to high
check space editor ((hit's kind = bim space object picked) and (hit's id = spaceId)) named (the string form of "3D wire selectable")
set clippedHit to the bim space object pick along ray in editor's documentValue's current on level editor's levelId within 0.05 clipped true from low to high
check space editor (clippedHit's kind = bim nothing picked) named (the string form of "section box removes invisible wire picks")
set otherStoreyHit to the bim space object pick along ray in editor's documentValue's current on level (999 as a 64 bit integer) within 0.05 clipped false from low to high
check space editor (otherStoreyHit's kind = bim nothing picked) named (the string form of "isolated storey filters wire picks")
type bim editor key bim delete key code in e
check space editor ((the length of (editor's documentValue's current's spaceObjects's values)) = 0) named (the string form of "Delete removes selected Space")
ignore undo bim transaction in (the address of (editor's documentValue))
check space editor ((the item at 0 in (editor's documentValue's current's spaceObjects's values))'s id = spaceId) named (the string form of "Delete undo restores same identity")

# Fit must not leave a Space-only project outside the camera.
set layout to @intrinsic("construct", a bim screen layout record, 1200.0, 800.0, 0.0, 600.0, 100.0, 750.0)
set camera to @intrinsic("construct", a bim camera record, (a cad vector2 with x 100.0 and y 100.0), 1.0, 0.5, 0.5, (a cad vector3 with x 100.0, y 100.0 and z 100.0), 1.0)
set fitted to the bim camera fitting editor in layout keeping camera
check space editor (((the absolute value of (fitted's target's x - 2.0)) < 1e-9) and ((the absolute value of (fitted's target's z - (levelValue's elevation + 1.45))) < 1e-9)) named (the string form of "3D fit includes Space-only contour and own height")

# The actual UI route: a real closed wall region, explicitly selected,
# becomes one persisted Space and is undoable as a single action.
set roomEditor to a new bim editor
set re to the address of roomEditor
set roomModel to the address of (roomEditor's documentValue's current)
set wallType to (the item at 0 in (roomModel's wallTypes's values))'s id
loop corner from 0 to the length of corners:
    set first to the item at corner in corners
    set next to the item at (the remainder of (corner + 1) divided by (the length of corners)) in corners
    ignore add bim wall typed wallType on roomEditor's levelId from first to next to roomModel
refresh bim editor re
check space editor ((the length of (roomEditor's spaces's values)) > 0) named (the string form of "closed walls supply a detected room")
set room to the item at 0 in (roomEditor's spaces's values)
select bim editor bim space picked numbered (the bim identity of room) in re
type bim editor key 2139 in re
check space editor (((the length of (roomEditor's documentValue's current's spaceObjects's values)) = 1) and (roomEditor's selectionKind = bim space object picked)) named (the string form of "Space command creates selected room object")
set createdId to roomEditor's selectionId
ignore undo bim transaction in (the address of (roomEditor's documentValue))
check space editor ((the length of (roomEditor's documentValue's current's spaceObjects's values)) = 0) named (the string form of "Space creation undo")
ignore redo bim transaction in (the address of (roomEditor's documentValue))
check space editor ((the item at 0 in (roomEditor's documentValue's current's spaceObjects's values))'s id = createdId) named (the string form of "Space creation redo keeps identity")
select bim editor bim space picked numbered (the bim identity of room) in re
type bim editor key 2139 in re
check space editor ((the length of (roomEditor's documentValue's current's spaceObjects's values)) = 1) named (the string form of "repeat conversion selects existing Space")

set rayDown to @intrinsic("construct", a bim ray record, (a cad vector3 with x 2.0, y 1.5 and z 10.0), (a cad vector3 with x 0.0, y 0.0 and z (-1.0)))
set noMeshes to an empty list of a bim scene mesh record
set derivedHit to the bim pick along rayDown among noMeshes in roomEditor's documentValue's current with (roomEditor's spaces's values)
check space editor (derivedHit's kind = bim nothing picked) named (the string form of "saved Space does not leave derived floor pick behind")
check space editor ((the length of (roomEditor's spaces's values)) > 0) named (the string form of "derived editor cache remains available")

# Floor creation must work after room conversion, and for standalone Spaces.
select bim editor bim space object picked numbered spaceId in e
set floorCountBefore to the length of (editor's documentValue's current's slabs's values)
type bim editor key 66 in e
check space editor ((editor's selectionKind = bim slab picked) and ((the length of (editor's documentValue's current's slabs's values)) = (floorCountBefore + 1))) named (the string form of "Floor command accepts saved Space")
set createdFloorId to editor's selectionId
set createdFloor to the item at (the bim slab index of createdFloorId in editor's documentValue's current)'s position in (editor's documentValue's current's slabs's values)
check space editor ((createdFloor's levelId = current's levelId) and ((the absolute value of ((the bim slab area of createdFloor) - 12.0)) < 1e-9)) named (the string form of "Floor keeps Space level and footprint")
ignore undo bim transaction in (the address of (editor's documentValue))
check space editor (((the length of (editor's documentValue's current's slabs's values)) = floorCountBefore) and ((the bim space object index of spaceId in editor's documentValue's current)'s valid)) named (the string form of "Floor undo preserves saved Space")
ignore redo bim transaction in (the address of (editor's documentValue))
check space editor ((the bim slab index of createdFloorId in editor's documentValue's current)'s valid) named (the string form of "Floor redo restores identity")
set editor's selectionKind to bim space object picked
set editor's selectionId to 999999 as a 64 bit integer
type bim editor key 66 in e
check space editor ((the length of (editor's documentValue's current's slabs's values)) = (floorCountBefore + 1)) named (the string form of "stale Space selection cannot create Floor")
