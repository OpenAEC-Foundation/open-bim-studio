# SPDX-License-Identifier: MPL-2.0
# Stairs as generators of linear elements. A straight flight climbs its
# storey's height in equal risers; each tread is a plank (a linear element
# with a rectangular profile, level across the flight) and the two stringers
# run along the slope under the treads' ends. Nothing here is stored: the
# parts are derived from the stair record each time, so the stair stays one
# element to edit and the parts reuse the linear element's geometry, plan
# drawing and material.
import examples/bim-slice/bim_model.dl

# One derived part: a linear element and the type it is of.
class:
    patterns:
        [a|] bim stair part record
    members:
        element as a bim linear record
        kind as a bim linear type record

function the bim tread thickness:
    replacement:
        0.04
function the bim tread nosing:
    replacement:
        0.02
function the bim stringer breadth:
    replacement:
        0.05
function the bim stringer depth:
    replacement:
        0.25

# The height `stairValue` climbs: its storey's height (to the storey above).
function the bim climb of stair {bim stair record:stairValue} in {bim model record:modelValue}:
    execute:
        set found to the bim level index of stairValue's levelId in modelValue
        if found's valid = false:
            return 0.0
        return (the item at found's position in (modelValue's levels's values))'s height

# Each riser's height.
function the bim riser height of stair {bim stair record:stairValue} in {bim model record:modelValue}:
    execute:
        return (the bim climb of stair stairValue in modelValue) / (stairValue's riserCount as a 64 bit floating-point number)

# Each tread's going: the run over the treads, one fewer than the risers
# (the last riser lands on the floor above).
function the bim going of stair {bim stair record:stairValue}:
    execute:
        return (the cad distance from stairValue's start to stairValue's finish) / ((stairValue's riserCount - 1) as a 64 bit floating-point number)

# The treads and stringers of `stairValue`, in its storey's coordinates
# (heights above the storey), each with its own type.
function the bim parts of stair {bim stair record:stairValue} in {bim model record:modelValue}:
    execute:
        set derived to a cad topology list of a bim stair part record
        set run to the cad distance from stairValue's start to stairValue's finish
        if (run < 1e-9) or (stairValue's riserCount < 2):
            return derived
        set ux to (stairValue's finish's x - stairValue's start's x) / run
        set uy to (stairValue's finish's y - stairValue's start's y) / run
        # Across the flight, to its left.
        set vx to 0.0 - uy
        set vy to ux
        set rise to the bim riser height of stair stairValue in modelValue
        set treadGoing to the bim going of stair stairValue
        set halfWidth to stairValue's width * 0.5
        set treadType to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Tread", bim generic linear role, treadGoing + (the bim tread nosing), the bim tread thickness, false, stairValue's material)
        loop step from 0 to (stairValue's riserCount - 1):
            set middle to (treadGoing * (step as a 64 bit floating-point number)) + (treadGoing * 0.5)
            set centreX to stairValue's start's x + (ux * middle)
            set centreY to stairValue's start's y + (uy * middle)
            set top to rise * ((step + 1) as a 64 bit floating-point number)
            set axisHeight to top - ((the bim tread thickness) * 0.5)
            set fromSpot to a cad vector3 with x (centreX - (vx * halfWidth)), y (centreY - (vy * halfWidth)) and z axisHeight
            set toSpot to a cad vector3 with x (centreX + (vx * halfWidth)), y (centreY + (vy * halfWidth)) and z axisHeight
            set treadPart to @intrinsic("construct", a bim linear record, stairValue's id, the bim refused id, stairValue's levelId, fromSpot, toSpot, 0.0)
            append (@intrinsic("construct", a bim stair part record, treadPart, treadType)) to (derived's values)
        # The stringers: under the treads' ends, from the first riser's
        # middle to the last tread's.
        set stringerType to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Stringer", bim generic linear role, the bim stringer breadth, the bim stringer depth, false, stairValue's material)
        set side to halfWidth + ((the bim stringer breadth) * 0.5)
        set lowHeight to (rise * 0.5)
        set highHeight to (rise * ((stairValue's riserCount - 1) as a 64 bit floating-point number)) - ((the bim stringer depth) * 0.5)
        set endAlong to treadGoing * ((stairValue's riserCount - 1) as a 64 bit floating-point number)
        loop sideCursor from 0 to 2:
            set sign to -1.0
            if sideCursor = 1:
                set sign to 1.0
            set fromSpot to a cad vector3 with x (stairValue's start's x + ((vx * side) * sign)), y (stairValue's start's y + ((vy * side) * sign)) and z lowHeight
            set toSpot to a cad vector3 with x ((stairValue's start's x + (ux * endAlong)) + ((vx * side) * sign)), y ((stairValue's start's y + (uy * endAlong)) + ((vy * side) * sign)) and z highHeight
            set stringerPart to @intrinsic("construct", a bim linear record, stairValue's id, the bim refused id, stairValue's levelId, fromSpot, toSpot, 0.0)
            append (@intrinsic("construct", a bim stair part record, stringerPart, stringerType)) to (derived's values)
        return derived

# ---------------------------------------------------------------- railings

function the bim post size:
    replacement:
        0.04
function the bim rail size:
    replacement:
        0.04
function the bim post spacing:
    replacement:
        1.0

# How high a railing's foot stands at plan point `location`: on the floor, or
# on its stair's nosing line (rising one riser per going from the foot of
# the run).
function the bim foot height at {cad vector2:location} under {bim railing record:railingValue} in {bim model record:modelValue}:
    execute:
        set found to the bim stair index of railingValue's hostId in modelValue
        if found's valid = false:
            return 0.0
        set stairValue to the item at found's position in (modelValue's stairs's values)
        set run to the cad distance from stairValue's start to stairValue's finish
        if run < 1e-9:
            return 0.0
        set ux to (stairValue's finish's x - stairValue's start's x) / run
        set uy to (stairValue's finish's y - stairValue's start's y) / run
        set along to ((location's x - stairValue's start's x) * ux) + ((location's y - stairValue's start's y) * uy)
        set along to the maximum of 0.0 and (the minimum of run and along)
        return along * ((the bim riser height of stair stairValue in modelValue) / (the bim going of stair stairValue))

# The posts and rails of `railingValue`: on every segment posts at most a
# metre apart (and at every corner), and a round rail on top.
function the bim parts of railing {bim railing record:railingValue} in {bim model record:modelValue}:
    execute:
        set derived to a cad topology list of a bim stair part record
        set postType to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Post", bim generic linear role, the bim post size, the bim post size, false, railingValue's material)
        set railType to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Rail", bim generic linear role, the bim rail size, the bim rail size, true, railingValue's material)
        set pathPoints to railingValue's points's values
        loop segment from 0 to ((the length of pathPoints) - 1):
            set from to the item at segment in pathPoints
            set onto to the item at (segment + 1) in pathPoints
            set segmentLength to the cad distance from from to onto
            if segmentLength > 1e-9:
                set postCount to 1
                loop while ((segmentLength / (postCount as a 64 bit floating-point number)) > (the bim post spacing)):
                    set postCount to postCount + 1
                set firstPost to 1
                if segment = 0:
                    set firstPost to 0
                loop postCursor from firstPost to (postCount + 1):
                    set fraction to (postCursor as a 64 bit floating-point number) / (postCount as a 64 bit floating-point number)
                    set spot to a cad vector2 with x (from's x + ((onto's x - from's x) * fraction)) and y (from's y + ((onto's y - from's y) * fraction))
                    set footHeight to the bim foot height at spot under railingValue in modelValue
                    set postFoot to a cad vector3 with x spot's x, y spot's y and z footHeight
                    set postTop to a cad vector3 with x spot's x, y spot's y and z (footHeight + railingValue's height)
                    set postElement to @intrinsic("construct", a bim linear record, railingValue's id, the bim refused id, railingValue's levelId, postFoot, postTop, 0.0)
                    append (@intrinsic("construct", a bim stair part record, postElement, postType)) to (derived's values)
                set fromTop to (the bim foot height at from under railingValue in modelValue) + railingValue's height
                set ontoTop to (the bim foot height at onto under railingValue in modelValue) + railingValue's height
                set railStart to a cad vector3 with x from's x, y from's y and z fromTop
                set railFinish to a cad vector3 with x onto's x, y onto's y and z ontoTop
                set railElement to @intrinsic("construct", a bim linear record, railingValue's id, the bim refused id, railingValue's levelId, railStart, railFinish, 0.0)
                append (@intrinsic("construct", a bim stair part record, railElement, railType)) to (derived's values)
        return derived

# The two sides of `stairValue` as railing paths, 50 mm inside its edges.
function the bim railing paths of stair {bim stair record:stairValue}:
    execute:
        set sidePaths to an empty list of the type of (an empty list of a cad vector2)
        set run to the cad distance from stairValue's start to stairValue's finish
        if run < 1e-9:
            return sidePaths
        set ux to (stairValue's finish's x - stairValue's start's x) / run
        set uy to (stairValue's finish's y - stairValue's start's y) / run
        set inset to (stairValue's width * 0.5) - 0.05
        loop sideCursor from 0 to 2:
            set sign to -1.0
            if sideCursor = 1:
                set sign to 1.0
            set sidePath to an empty list of a cad vector2
            append (a cad vector2 with x (stairValue's start's x - ((uy * inset) * sign)) and y (stairValue's start's y + ((ux * inset) * sign))) to sidePath
            append (a cad vector2 with x (stairValue's finish's x - ((uy * inset) * sign)) and y (stairValue's finish's y + ((ux * inset) * sign))) to sidePath
            append sidePath to sidePaths
        return sidePaths

# ---------------------------------------------------------------- curtain walls

function the bim mullion width:
    replacement:
        0.05
function the bim mullion depth:
    replacement:
        0.15
function the bim glass thickness:
    replacement:
        0.024

# How many equal divisions of `span` keep each at most `limit`.
function the bim divisions of {a 64 bit floating-point number:span} at most {a 64 bit floating-point number:limit}:
    execute:
        set count to 1
        loop while (span / (count as a 64 bit floating-point number)) > (limit + 1e-9):
            set count to count + 1
        return count

# The mullions (upright, at every bay's edge), transoms (level, at every
# row's edge) and glass panels (one per bay and row, between the frame) of
# `curtainValue`, all linear elements.
function the bim parts of curtain wall {bim curtain record:curtainValue} in {bim model record:modelValue}:
    execute:
        set derived to a cad topology list of a bim stair part record
        set wallLength to the cad distance from curtainValue's start to curtainValue's finish
        if wallLength < 1e-9:
            return derived
        set ux to (curtainValue's finish's x - curtainValue's start's x) / wallLength
        set uy to (curtainValue's finish's y - curtainValue's start's y) / wallLength
        set turn to @intrinsic("atan2", uy, ux)
        set bays to the bim divisions of wallLength at most curtainValue's bayWidth
        set rows to the bim divisions of curtainValue's height at most curtainValue's rowHeight
        set bayWide to wallLength / (bays as a 64 bit floating-point number)
        set rowHigh to curtainValue's height / (rows as a 64 bit floating-point number)
        set mullionType to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Mullion", bim mullion role, the bim mullion width, the bim mullion depth, false, curtainValue's material)
        set transomType to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Transom", bim mullion role, the bim mullion depth, the bim mullion width, false, curtainValue's material)
        set panelType to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Panel", bim generic linear role, bayWide - (the bim mullion width), the bim glass thickness, false, the string form of "glass")
        loop bayCursor from 0 to (bays + 1):
            set along to bayWide * (bayCursor as a 64 bit floating-point number)
            set foot to a cad vector3 with x (curtainValue's start's x + (ux * along)), y (curtainValue's start's y + (uy * along)) and z 0.0
            set head to a cad vector3 with x foot's x, y foot's y and z curtainValue's height
            set mullionPart to @intrinsic("construct", a bim linear record, curtainValue's id, the bim refused id, curtainValue's levelId, foot, head, turn)
            append (@intrinsic("construct", a bim stair part record, mullionPart, mullionType)) to (derived's values)
        loop rowCursor from 0 to (rows + 1):
            set level to rowHigh * (rowCursor as a 64 bit floating-point number)
            set transomStart to a cad vector3 with x curtainValue's start's x, y curtainValue's start's y and z level
            set transomFinish to a cad vector3 with x curtainValue's finish's x, y curtainValue's finish's y and z level
            set transomPart to @intrinsic("construct", a bim linear record, curtainValue's id, the bim refused id, curtainValue's levelId, transomStart, transomFinish, 0.0)
            append (@intrinsic("construct", a bim stair part record, transomPart, transomType)) to (derived's values)
        loop bayCursor from 0 to bays:
            set middle to bayWide * ((bayCursor as a 64 bit floating-point number) + 0.5)
            loop rowCursor from 0 to rows:
                set bottom to (rowHigh * (rowCursor as a 64 bit floating-point number)) + ((the bim mullion width) * 0.5)
                set top to (rowHigh * ((rowCursor + 1) as a 64 bit floating-point number)) - ((the bim mullion width) * 0.5)
                set panelFoot to a cad vector3 with x (curtainValue's start's x + (ux * middle)), y (curtainValue's start's y + (uy * middle)) and z bottom
                set panelHead to a cad vector3 with x panelFoot's x, y panelFoot's y and z top
                set panelPart to @intrinsic("construct", a bim linear record, curtainValue's id, the bim refused id, curtainValue's levelId, panelFoot, panelHead, turn)
                append (@intrinsic("construct", a bim stair part record, panelPart, panelType)) to (derived's values)
        return derived
