# SPDX-License-Identifier: MPL-2.0
# Stairs as generators of linear elements. A straight flight climbs its
# storey's height in equal risers; each tread is a plank (a linear element
# with a rectangular profile, level across the flight) and the two stringers
# run along the slope under the treads' ends. Nothing here is stored: the
# parts are derived from the stair record each time, so the stair stays one
# element to edit and the parts reuse the linear element's geometry, plan
# drawing and material.
import examples/bim-slice/bim_model.dl

# One derived part: a linear element and the type it is of.
class:
    patterns:
        [a|] bim stair part record
    members:
        element as a bim linear record
        kind as a bim linear type record

function the bim tread thickness:
    replacement:
        0.04
function the bim tread nosing:
    replacement:
        0.02
function the bim stringer breadth:
    replacement:
        0.05
function the bim stringer depth:
    replacement:
        0.25

# The height `stairValue` climbs: its storey's height (to the storey above).
function the bim climb of stair {bim stair record:stairValue} in {bim model record:modelValue}:
    execute:
        set found to the bim level index of stairValue's levelId in modelValue
        if found's valid = false:
            return 0.0
        return (the item at found's position in (modelValue's levels's values))'s height

# Each riser's height.
function the bim riser height of stair {bim stair record:stairValue} in {bim model record:modelValue}:
    execute:
        return (the bim climb of stair stairValue in modelValue) / (stairValue's riserCount as a 64 bit floating-point number)

# Each tread's going: the run over the treads, one fewer than the risers
# (the last riser lands on the floor above).
function the bim going of stair {bim stair record:stairValue}:
    execute:
        return (the cad distance from stairValue's start to stairValue's finish) / ((stairValue's riserCount - 1) as a 64 bit floating-point number)

# The treads and stringers of `stairValue`, in its storey's coordinates
# (heights above the storey), each with its own type.
# The parts of stairs and railings, by slot (`bim part type setting`).
function bim tread part:
    replacement:
        0
function bim stringer part:
    replacement:
        1
function bim post part:
    replacement:
        2
function bim rail part:
    replacement:
        3
function bim baluster part:
    replacement:
        4

function the bim name of part slot {integer:partSlot}:
    execute:
        if partSlot = bim tread part:
            return the string form of "Tread"
        if partSlot = bim stringer part:
            return the string form of "Stringer"
        if partSlot = bim post part:
            return the string form of "Post"
        if partSlot = bim rail part:
            return the string form of "Rail"
        return the string form of "Baluster"

# The linear type element `elementId` (a stair or railing) builds its part
# `slot` of: the one chosen from the model's linear types, else `fallback`.
function the bim part type {integer:partSlot} of {a 64 bit integer:elementId} or {bim linear type record:fallback} in {bim model record:modelValue}:
    execute:
        set chosen to the bim setting ((bim part type setting) + partSlot) of elementId in modelValue
        if chosen's found:
            set typeFound to the bim linear type index of chosen's value in modelValue
            if typeFound's valid:
                return the item at typeFound's position in (modelValue's linearTypes's values)
        return fallback

function the bim parts of stair {bim stair record:stairValue} in {bim model record:modelValue}:
    execute:
        set derived to a cad topology list of a bim stair part record
        set run to the cad distance from stairValue's start to stairValue's finish
        if (run < 1e-9) or (stairValue's riserCount < 2):
            return derived
        set ux to (stairValue's finish's x - stairValue's start's x) / run
        set uy to (stairValue's finish's y - stairValue's start's y) / run
        # Across the flight, to its left.
        set vx to 0.0 - uy
        set vy to ux
        set rise to the bim riser height of stair stairValue in modelValue
        set treadGoing to the bim going of stair stairValue
        set halfWidth to stairValue's width * 0.5
        # A tread is a plank as deep as its going (with its nosing): a chosen
        # linear type gives its thickness and material.
        set treadDefault to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Tread", bim generic linear role, treadGoing + (the bim tread nosing), the bim tread thickness, false, stairValue's material)
        set treadChosen to the bim part type (bim tread part) of stairValue's id or treadDefault in modelValue
        set treadThickness to treadChosen's depth
        set treadType to @intrinsic("construct", a bim linear type record, treadChosen's id, treadChosen's name, bim generic linear role, treadGoing + (the bim tread nosing), treadThickness, false, treadChosen's material)
        loop step from 0 to (stairValue's riserCount - 1):
            set middle to (treadGoing * (step as a 64 bit floating-point number)) + (treadGoing * 0.5)
            set centreX to stairValue's start's x + (ux * middle)
            set centreY to stairValue's start's y + (uy * middle)
            set top to rise * ((step + 1) as a 64 bit floating-point number)
            set axisHeight to top - (treadThickness * 0.5)
            set fromSpot to a cad vector3 with x (centreX - (vx * halfWidth)), y (centreY - (vy * halfWidth)) and z axisHeight
            set toSpot to a cad vector3 with x (centreX + (vx * halfWidth)), y (centreY + (vy * halfWidth)) and z axisHeight
            set treadPart to @intrinsic("construct", a bim linear record, stairValue's id, the bim refused id, stairValue's levelId, fromSpot, toSpot, 0.0, 0.0, (a cad vector2 with x 1.0 and y 1.0))
            append (@intrinsic("construct", a bim stair part record, treadPart, treadType)) to (derived's values)
        # The stringers: under the treads' ends, from the first riser's
        # middle to the last tread's.
        set stringerDefault to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Stringer", bim generic linear role, the bim stringer breadth, the bim stringer depth, false, stairValue's material)
        set stringerType to the bim part type (bim stringer part) of stairValue's id or stringerDefault in modelValue
        set side to halfWidth + (stringerType's width * 0.5)
        set lowHeight to (rise * 0.5)
        set highHeight to (rise * ((stairValue's riserCount - 1) as a 64 bit floating-point number)) - (stringerType's depth * 0.5)
        set endAlong to treadGoing * ((stairValue's riserCount - 1) as a 64 bit floating-point number)
        loop sideCursor from 0 to 2:
            set sign to -1.0
            if sideCursor = 1:
                set sign to 1.0
            set fromSpot to a cad vector3 with x (stairValue's start's x + ((vx * side) * sign)), y (stairValue's start's y + ((vy * side) * sign)) and z lowHeight
            set toSpot to a cad vector3 with x ((stairValue's start's x + (ux * endAlong)) + ((vx * side) * sign)), y ((stairValue's start's y + (uy * endAlong)) + ((vy * side) * sign)) and z highHeight
            set stringerPart to @intrinsic("construct", a bim linear record, stairValue's id, the bim refused id, stairValue's levelId, fromSpot, toSpot, 0.0, 0.0, (a cad vector2 with x 1.0 and y 1.0))
            append (@intrinsic("construct", a bim stair part record, stringerPart, stringerType)) to (derived's values)
        return derived

# ---------------------------------------------------------------- railings

function the bim post size:
    replacement:
        0.04
function the bim rail size:
    replacement:
        0.04
function the bim post spacing:
    replacement:
        1.0

# How high a railing's foot stands at plan point `location`: on the floor, or
# on its stair's nosing line (rising one riser per going from the foot of
# the run).
function the bim foot height at {cad vector2:location} under {bim railing record:railingValue} in {bim model record:modelValue}:
    execute:
        set found to the bim stair index of railingValue's hostId in modelValue
        if found's valid = false:
            return 0.0
        set stairValue to the item at found's position in (modelValue's stairs's values)
        set run to the cad distance from stairValue's start to stairValue's finish
        if run < 1e-9:
            return 0.0
        set ux to (stairValue's finish's x - stairValue's start's x) / run
        set uy to (stairValue's finish's y - stairValue's start's y) / run
        set along to ((location's x - stairValue's start's x) * ux) + ((location's y - stairValue's start's y) * uy)
        set along to the maximum of 0.0 and (the minimum of run and along)
        return along * ((the bim riser height of stair stairValue in modelValue) / (the bim going of stair stairValue))

# The posts and rails of `railingValue`: on every segment posts at most a
# metre apart (and at every corner), and a round rail on top.
function the bim parts of railing {bim railing record:railingValue} in {bim model record:modelValue}:
    execute:
        set derived to a cad topology list of a bim stair part record
        set postDefault to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Post", bim generic linear role, the bim post size, the bim post size, false, railingValue's material)
        set railDefault to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Rail", bim generic linear role, the bim rail size, the bim rail size, true, railingValue's material)
        set balusterDefault to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Baluster", bim generic linear role, 0.02, 0.02, true, railingValue's material)
        set postType to the bim part type (bim post part) of railingValue's id or postDefault in modelValue
        set railType to the bim part type (bim rail part) of railingValue's id or railDefault in modelValue
        set balusterType to the bim part type (bim baluster part) of railingValue's id or balusterDefault in modelValue
        # Balusters at this spacing between the posts (none when unset).
        set balusterSpacing to ((the bim setting (bim baluster spacing setting) of railingValue's id in modelValue)'s value as a 64 bit floating-point number) / 1000.0
        set pathPoints to railingValue's points's values
        loop segment from 0 to ((the length of pathPoints) - 1):
            set from to the item at segment in pathPoints
            set onto to the item at (segment + 1) in pathPoints
            set segmentLength to the cad distance from from to onto
            if segmentLength > 1e-9:
                set postCount to 1
                loop while ((segmentLength / (postCount as a 64 bit floating-point number)) > (the bim post spacing)):
                    set postCount to postCount + 1
                set firstPost to 1
                if segment = 0:
                    set firstPost to 0
                loop postCursor from firstPost to (postCount + 1):
                    set fraction to (postCursor as a 64 bit floating-point number) / (postCount as a 64 bit floating-point number)
                    set spot to a cad vector2 with x (from's x + ((onto's x - from's x) * fraction)) and y (from's y + ((onto's y - from's y) * fraction))
                    set footHeight to the bim foot height at spot under railingValue in modelValue
                    set postFoot to a cad vector3 with x spot's x, y spot's y and z footHeight
                    set postTop to a cad vector3 with x spot's x, y spot's y and z (footHeight + railingValue's height)
                    set postElement to @intrinsic("construct", a bim linear record, railingValue's id, the bim refused id, railingValue's levelId, postFoot, postTop, 0.0, 0.0, (a cad vector2 with x 1.0 and y 1.0))
                    append (@intrinsic("construct", a bim stair part record, postElement, postType)) to (derived's values)
                set fromTop to (the bim foot height at from under railingValue in modelValue) + railingValue's height
                set ontoTop to (the bim foot height at onto under railingValue in modelValue) + railingValue's height
                set railStart to a cad vector3 with x from's x, y from's y and z fromTop
                set railFinish to a cad vector3 with x onto's x, y onto's y and z ontoTop
                set railElement to @intrinsic("construct", a bim linear record, railingValue's id, the bim refused id, railingValue's levelId, railStart, railFinish, 0.0, 0.0, (a cad vector2 with x 1.0 and y 1.0))
                append (@intrinsic("construct", a bim stair part record, railElement, railType)) to (derived's values)
                if balusterSpacing > 0.02:
                    set postGap to segmentLength / (postCount as a 64 bit floating-point number)
                    set balusterAlong to balusterSpacing
                    loop while balusterAlong < (segmentLength - 0.01):
                        # None where a post stands.
                        set fromPost to balusterAlong - ((the floor of (balusterAlong / postGap)) * postGap)
                        if (fromPost > ((postType's width * 0.5) + 0.01)) and ((postGap - fromPost) > ((postType's width * 0.5) + 0.01)):
                            set fraction to balusterAlong / segmentLength
                            set spot to a cad vector2 with x (from's x + ((onto's x - from's x) * fraction)) and y (from's y + ((onto's y - from's y) * fraction))
                            set footHeight to the bim foot height at spot under railingValue in modelValue
                            set balusterFoot to a cad vector3 with x spot's x, y spot's y and z (footHeight + 0.05)
                            set balusterTop to a cad vector3 with x spot's x, y spot's y and z ((footHeight + railingValue's height) - (railType's width * 0.5))
                            set balusterElement to @intrinsic("construct", a bim linear record, railingValue's id, the bim refused id, railingValue's levelId, balusterFoot, balusterTop, 0.0, 0.0, (a cad vector2 with x 1.0 and y 1.0))
                            append (@intrinsic("construct", a bim stair part record, balusterElement, balusterType)) to (derived's values)
                        set balusterAlong to balusterAlong + balusterSpacing
        return derived

# The two sides of `stairValue` as railing paths, 50 mm inside its edges.
function the bim railing paths of stair {bim stair record:stairValue}:
    execute:
        set sidePaths to an empty list of the type of (an empty list of a cad vector2)
        set run to the cad distance from stairValue's start to stairValue's finish
        if run < 1e-9:
            return sidePaths
        set ux to (stairValue's finish's x - stairValue's start's x) / run
        set uy to (stairValue's finish's y - stairValue's start's y) / run
        set inset to (stairValue's width * 0.5) - 0.05
        loop sideCursor from 0 to 2:
            set sign to -1.0
            if sideCursor = 1:
                set sign to 1.0
            set sidePath to an empty list of a cad vector2
            append (a cad vector2 with x (stairValue's start's x - ((uy * inset) * sign)) and y (stairValue's start's y + ((ux * inset) * sign))) to sidePath
            append (a cad vector2 with x (stairValue's finish's x - ((uy * inset) * sign)) and y (stairValue's finish's y + ((ux * inset) * sign))) to sidePath
            append sidePath to sidePaths
        return sidePaths

# ---------------------------------------------------------------- curtain walls

function the bim mullion width:
    replacement:
        0.05
function the bim mullion depth:
    replacement:
        0.15
function the bim glass thickness:
    replacement:
        0.024

# A building system's line: straight, or (`curved`) the arc about `centre`
# of `radius` from `startAngle` turning `sweep` radians; `length` measured
# along it. Grid lines are placed by that length.
class:
    patterns:
        [a|] bim system path record
    members:
        curved as a boolean
        centre as a cad vector2
        radius as a 64 bit floating-point number
        startAngle as a 64 bit floating-point number
        sweep as a 64 bit floating-point number
        length as a 64 bit floating-point number

function the bim system path of {bim curtain record:curtainValue}:
    execute:
        set chordX to curtainValue's finish's x - curtainValue's start's x
        set chordY to curtainValue's finish's y - curtainValue's start's y
        set chordLength to the square root of ((chordX * chordX) + (chordY * chordY))
        set rise to curtainValue's bulge
        if ((the absolute value of rise) <= 1e-9) or (chordLength <= 1e-9):
            return @intrinsic("construct", a bim system path record, false, curtainValue's start, 0.0, 0.0, 0.0, chordLength)
        # As a wall's arc: the sagitta s over a chord c spans 4 atan(2 s / c).
        set halfChord to chordLength * 0.5
        set sweep to 4.0 * @intrinsic("atan2", rise, halfChord)
        set radius to ((halfChord * halfChord) + (rise * rise)) / (2.0 * (the absolute value of rise))
        set nx to chordY / chordLength
        set ny to (0.0 - chordX) / chordLength
        set side to 1.0
        if rise < 0.0:
            set side to -1.0
        set apexX to ((curtainValue's start's x + curtainValue's finish's x) * 0.5) + (rise * nx)
        set apexY to ((curtainValue's start's y + curtainValue's finish's y) * 0.5) + (rise * ny)
        set pivotPoint to a cad vector2 with x (apexX - ((side * radius) * nx)) and y (apexY - ((side * radius) * ny))
        set startAngle to @intrinsic("atan2", curtainValue's start's y - pivotPoint's y, curtainValue's start's x - pivotPoint's x)
        return @intrinsic("construct", a bim system path record, true, pivotPoint, radius, startAngle, sweep, radius * (the absolute value of sweep))

# The length of building system `curtainValue`'s line, along it.
function the bim system length of {bim curtain record:curtainValue}:
    execute:
        return (the bim system path of curtainValue)'s length

# The point `along` metres along building system `curtainValue`'s line.
function the bim system point at {a 64 bit floating-point number:along} of {bim curtain record:curtainValue}:
    execute:
        set course to the bim system path of curtainValue
        if course's curved = false:
            set run to the maximum of 1e-9 and course's length
            set share to along / run
            return a cad vector2 with x (curtainValue's start's x + (share * (curtainValue's finish's x - curtainValue's start's x))) and y (curtainValue's start's y + (share * (curtainValue's finish's y - curtainValue's start's y)))
        set bearing to course's startAngle + (course's sweep * (along / course's length))
        return a cad vector2 with x (course's centre's x + (course's radius * (the cosine of bearing))) and y (course's centre's y + (course's radius * (the sine of bearing)))

# The direction of building system `curtainValue`'s line `along` metres
# along it, as an bearing in plan.
function the bim system heading at {a 64 bit floating-point number:along} of {bim curtain record:curtainValue}:
    execute:
        set course to the bim system path of curtainValue
        if course's curved = false:
            return @intrinsic("atan2", curtainValue's finish's y - curtainValue's start's y, curtainValue's finish's x - curtainValue's start's x)
        set bearing to course's startAngle + (course's sweep * (along / course's length))
        if course's sweep > 0.0:
            return bearing + 1.5707963267948966
        return bearing - 1.5707963267948966

# How far along building system `curtainValue`'s line the point nearest
# `location` lies, and how far from the line `location` is (as x and y).
function the bim system station of {cad vector2:location} on {bim curtain record:curtainValue}:
    execute:
        set course to the bim system path of curtainValue
        if course's curved = false:
            set run to the maximum of 1e-9 and course's length
            set ux to (curtainValue's finish's x - curtainValue's start's x) / run
            set uy to (curtainValue's finish's y - curtainValue's start's y) / run
            set along to ((location's x - curtainValue's start's x) * ux) + ((location's y - curtainValue's start's y) * uy)
            set clamped to the maximum of 0.0 and (the minimum of run and along)
            set nearest to a cad vector2 with x (curtainValue's start's x + (ux * clamped)) and y (curtainValue's start's y + (uy * clamped))
            return a cad vector2 with x along and y (the cad distance from location to nearest)
        set bearing to @intrinsic("atan2", location's y - course's centre's y, location's x - course's centre's x)
        set turned to bearing - course's startAngle
        # The turn into the sweep's sense, between minus and plus a full turn.
        loop while turned > 3.141592653589793:
            set turned to turned - 6.283185307179586
        loop while turned < -3.141592653589793:
            set turned to turned + 6.283185307179586
        set along to (turned / course's sweep) * course's length
        set clamped to the maximum of 0.0 and (the minimum of course's length and along)
        return a cad vector2 with x along and y (the cad distance from location to (the bim system point at clamped of curtainValue))

# How many equal divisions of `span` keep each at most `limit`.
function the bim divisions of {a 64 bit floating-point number:span} at most {a 64 bit floating-point number:limit}:
    execute:
        set count to 1
        loop while (span / (count as a 64 bit floating-point number)) > (limit + 1e-9):
            set count to count + 1
        return count

# The number of bays and of rows of `curtainValue`.
function the bim bay count of {bim curtain record:curtainValue}:
    execute:
        return the bim divisions of (the bim system length of curtainValue) at most curtainValue's bayWidth
function the bim row count of {bim curtain record:curtainValue}:
    execute:
        return the bim divisions of curtainValue's height at most curtainValue's rowHeight

# How far along its line mullion `lineIndex` of `curtainValue` stands, and
# how high above its storey transom `lineIndex` lies, in metres: evenly
# spaced unless the line was moved (a `bim grid line setting`).
function the bim mullion {integer:lineIndex} along {bim curtain record:curtainValue} in {bim model record:modelValue}:
    execute:
        return the bim system line lineIndex of (the bim bay count of curtainValue) across (the bim system length of curtainValue) coded lineIndex for system curtainValue's id in modelValue
function the bim transom {integer:lineIndex} along {bim curtain record:curtainValue} in {bim model record:modelValue}:
    execute:
        return the bim system line lineIndex of (the bim row count of curtainValue) across curtainValue's height coded (1000 + lineIndex) for system curtainValue's id in modelValue

# A building system as it stands: a system nested in a panel of another
# takes that panel's opening (between the frame) as its line and height,
# `lift` metres above the storey; any other stands as stored, lift 0.
class:
    patterns:
        [a|] bim placed system record
    members:
        curtain as a bim curtain record
        lift as a 64 bit floating-point number

# The system nested in panel `panelIndex` of building system `curtainId`, or
# the refused id.
function the bim system nested in panel {integer:panelIndex} of {a 64 bit integer:curtainId} in {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's settings's values):
            set entry to the item at cursor in (modelValue's settings's values)
            if (entry's code = bim host system setting) and (entry's value = curtainId):
                if ((the bim setting (bim host panel setting) of entry's elementId in modelValue)'s value as an integer) = panelIndex:
                    return entry's elementId
        return the bim refused id

# A building system standing in a wall's opening (a window): valid when it
# is hosted there (`bim host opening setting`) and the opening, its type and
# its straight wall are there; `curtain` is then the system as it stands in
# the opening and `lift` its foot above the wall's storey.
class:
    patterns:
        [a|] bim hosted system record
    members:
        valid as a boolean
        curtain as a bim curtain record
        lift as a 64 bit floating-point number

# Where building system `curtainValue` stands in the wall opening it is
# hosted in: on the wall's line across the opening's rough width less the
# joint (`bim host joint setting`, millimetres) at either side, its foot the
# opening's sill (above the storey) plus the joint, its height the rough
# height less a joint at the head and the sill, on the wall's storey. It
# follows the wall and the opening wherever they go. Invalid when it is not
# hosted, the opening, its type or its wall are gone, the wall is curved, or
# the joints leave less than a centimetre.
function the bim system {bim curtain record:curtainValue} hosted in its opening in {bim model record:modelValue}:
    execute:
        set notHosted to @intrinsic("construct", a bim hosted system record, false, curtainValue, 0.0)
        set hostReading to the bim setting (bim host opening setting) of curtainValue's id in modelValue
        if hostReading's found = false:
            return notHosted
        set openingFound to the bim opening index of (hostReading's value) in modelValue
        if openingFound's valid = false:
            return notHosted
        set openingValue to the item at openingFound's position in (modelValue's openings's values)
        set wallFound to the bim wall index of (openingValue's hostId) in modelValue
        set typeFound to the bim opening type index of (openingValue's typeId) in modelValue
        if (wallFound's valid = false) or (typeFound's valid = false):
            return notHosted
        set wallValue to the item at wallFound's position in (modelValue's walls's values)
        set openingType to the item at typeFound's position in (modelValue's openingTypes's values)
        if wallValue's bulge != 0.0:
            return notHosted
        set run to the cad distance from (wallValue's start) to (wallValue's finish)
        if run < 1e-9:
            return notHosted
        set ux to (wallValue's finish's x - wallValue's start's x) / run
        set uy to (wallValue's finish's y - wallValue's start's y) / run
        set joint to ((the bim setting (bim host joint setting) of curtainValue's id in modelValue)'s value as a 64 bit floating-point number) / 1000.0
        set halfRough to (the bim rough width of openingType) * 0.5
        set fromAlong to ((openingValue's offset) - halfRough) + joint
        set untilAlong to ((openingValue's offset) + halfRough) - joint
        set clearHeight to (the bim rough height of openingType) - (2.0 * joint)
        if ((untilAlong - fromAlong) < 0.01) or (clearHeight < 0.01):
            return notHosted
        set standingValue to curtainValue
        set standingValue's levelId to wallValue's levelId
        set standingValue's start to a cad vector2 with x (wallValue's start's x + (ux * fromAlong)) and y (wallValue's start's y + (uy * fromAlong))
        set standingValue's finish to a cad vector2 with x (wallValue's start's x + (ux * untilAlong)) and y (wallValue's start's y + (uy * untilAlong))
        set standingValue's bulge to 0.0
        set standingValue's height to clearHeight
        return @intrinsic("construct", a bim hosted system record, true, standingValue, (openingType's sill) + joint)

function the bim placed system {bim curtain record:curtainValue} in {bim model record:modelValue}:
    execute:
        # A layer of another system takes that system's line, height and
        # curve, moved across its face by its offset (up, lying level).
        set layerHost to the bim setting (bim layer host setting) of curtainValue's id in modelValue
        if layerHost's found:
            set layerHostFound to the bim curtain index of layerHost's value in modelValue
            if layerHostFound's valid:
                set hostValue to the item at layerHostFound's position in (modelValue's curtains's values)
                # A host standing in a wall's opening is taken where it stands.
                set hostLift to 0.0
                set hostHosting to the bim system hostValue hosted in its opening in modelValue
                if hostHosting's valid:
                    set hostValue to hostHosting's curtain
                    set hostLift to hostHosting's lift
                set offsetMetres to ((the bim setting (bim layer offset setting) of curtainValue's id in modelValue)'s value as a 64 bit floating-point number) / 1000.0
                set layered to curtainValue
                set layered's levelId to hostValue's levelId
                set layered's height to hostValue's height
                set layered's start to hostValue's start
                set layered's finish to hostValue's finish
                set layered's bulge to hostValue's bulge
                if bim system hostValue's id lies level in modelValue:
                    return @intrinsic("construct", a bim placed system record, layered, offsetMetres + hostLift)
                set startHeading to the bim system heading at 0.0 of hostValue
                set finishHeading to the bim system heading at (the bim system length of hostValue) of hostValue
                set layered's start to a cad vector2 with x (hostValue's start's x + (offsetMetres * (the sine of startHeading))) and y (hostValue's start's y - (offsetMetres * (the cosine of startHeading)))
                set layered's finish to a cad vector2 with x (hostValue's finish's x + (offsetMetres * (the sine of finishHeading))) and y (hostValue's finish's y - (offsetMetres * (the cosine of finishHeading)))
                # An arc's sagitta grows with its radius: outward to the right
                # of a bulge to the right, inward to the right of one to the
                # left.
                set hostCourse to the bim system path of hostValue
                if hostCourse's curved:
                    set grown to hostCourse's radius + offsetMetres
                    if hostValue's bulge < 0.0:
                        set grown to hostCourse's radius - offsetMetres
                    set layered's bulge to hostValue's bulge * (grown / hostCourse's radius)
                return @intrinsic("construct", a bim placed system record, layered, hostLift)
        # The chain of hosts, from this system up to one standing alone.
        set chain to a cad topology list of a bim curtain record
        append curtainValue to (chain's values)
        set climbing to true
        loop while climbing and ((the length of (chain's values)) < 16):
            set climbing to false
            set lowest to the item at ((the length of (chain's values)) - 1) in (chain's values)
            set hostReading to the bim setting (bim host system setting) of lowest's id in modelValue
            if hostReading's found:
                set hostFound to the bim curtain index of hostReading's value in modelValue
                if hostFound's valid:
                    append (the item at hostFound's position in (modelValue's curtains's values)) to (chain's values)
                    set climbing to true
        # Down again: each nested system fills its host's panel. The one
        # standing alone stands in its wall opening when it is hosted there.
        set standing to the item at ((the length of (chain's values)) - 1) in (chain's values)
        set lift to 0.0
        set hosting to the bim system standing hosted in its opening in modelValue
        if hosting's valid:
            set standing to hosting's curtain
            set lift to hosting's lift
        set step to (the length of (chain's values)) - 2
        loop while step >= 0:
            set nestedValue to the item at step in (chain's values)
            set panelIndex to (the bim setting (bim host panel setting) of nestedValue's id in modelValue)'s value as an integer
            set rows to the bim row count of standing
            set bay to panelIndex / rows
            set row to panelIndex - (bay * rows)
            set half to (the bim joint width of system standing's id in modelValue) * 0.5
            set bottom to (the bim transom row along standing in modelValue) + half
            set top to (the bim transom (row + 1) along standing in modelValue) - half
            # Across the panel's opening; straight, as a panel of a curved
            # system is.
            set nestedValue's start to the bim system point at ((the bim mullion bay along standing in modelValue) + half) of standing
            set nestedValue's finish to the bim system point at ((the bim mullion (bay + 1) along standing in modelValue) - half) of standing
            set nestedValue's bulge to 0.0
            set nestedValue's height to top - bottom
            set nestedValue's levelId to standing's levelId
            set lift to lift + bottom
            set standing to nestedValue
            set step to step - 1
        return @intrinsic("construct", a bim placed system record, standing, lift)

# How far plan point `location` lies from building system `curtainValue`'s
# footprint, as it is placed (in a wall's opening, a layer beside its host,
# a nested system in its host's panel); 0 on it. An upright system's footprint is its line
# widened by half its depth, a level one's its face, across its line to the
# left.
function the bim footprint gap of {cad vector2:location} to {bim curtain record:curtainValue} in {bim model record:modelValue}:
    execute:
        set placed to (the bim placed system curtainValue in modelValue)'s curtain
        set station to the bim system station of location on placed
        if bim system curtainValue's id lies level in modelValue:
            set run to the bim system length of placed
            set beyond to the maximum of 0.0 and (the maximum of (0.0 - station's x) and (station's x - run))
            set across to station's y
            set course to the bim system path of placed
            if course's curved = false:
                set ux to (placed's finish's x - placed's start's x) / (the maximum of 1e-9 and run)
                set uy to (placed's finish's y - placed's start's y) / (the maximum of 1e-9 and run)
                set across to (ux * (location's y - placed's start's y)) - (uy * (location's x - placed's start's x))
            set outside to the maximum of 0.0 and (the maximum of (0.0 - across) and (across - placed's height))
            return the maximum of beyond and outside
        set halfDepth to (the maximum of 0.05 and (the bim joint depth of system curtainValue's id in modelValue)) * 0.5
        return the maximum of 0.0 and (station's y - halfDepth)

# Hosts building system `curtainId` in wall opening `openingId` with a
# joint of `jointMillimetres` round it (`the bim system … hosted in its
# opening in`): from now on it stands where the opening is. Its stored line,
# storey and height are set to where it stands now, so that what reads them
# finds the same. False, and nothing changed, when it cannot stand there
# (no such system or opening, a curved wall, joints wider than the opening).
function host bim system {a 64 bit integer:curtainId} in opening {a 64 bit integer:openingId} with joint {a 64 bit integer:jointMillimetres} in {a pointer to a bim model record:target}:
    execute:
        set curtainFound to the bim curtain index of curtainId in (@intrinsic("dereference", target))
        if (curtainFound's valid = false) or (jointMillimetres < (0 as a 64 bit integer)):
            return false
        set previousOpening to the bim setting (bim host opening setting) of curtainId in (@intrinsic("dereference", target))
        set previousJoint to the bim setting (bim host joint setting) of curtainId in (@intrinsic("dereference", target))
        set bim setting (bim host opening setting) of curtainId to openingId keeping true in target
        set bim setting (bim host joint setting) of curtainId to jointMillimetres keeping true in target
        set hosting to the bim system (the item at curtainFound's position in (target's curtains's values)) hosted in its opening in (@intrinsic("dereference", target))
        if hosting's valid = false:
            set bim setting (bim host opening setting) of curtainId to (previousOpening's value) keeping (previousOpening's found) in target
            set bim setting (bim host joint setting) of curtainId to (previousJoint's value) keeping (previousJoint's found) in target
            return false
        replace item at index curtainFound's position in (target's curtains's values) with hosting's curtain
        return true

# Building system `curtainId` no longer hosted in a wall opening: it keeps
# standing where it last stood.
function unhost bim system {a 64 bit integer:curtainId} in {a pointer to a bim model record:target}:
    execute:
        set curtainFound to the bim curtain index of curtainId in (@intrinsic("dereference", target))
        if curtainFound's valid:
            set hosting to the bim system (the item at curtainFound's position in (target's curtains's values)) hosted in its opening in (@intrinsic("dereference", target))
            if hosting's valid:
                replace item at index curtainFound's position in (target's curtains's values) with hosting's curtain
        set bim setting (bim host opening setting) of curtainId to (0 as a 64 bit integer) keeping false in target
        set bim setting (bim host joint setting) of curtainId to (0 as a 64 bit integer) keeping false in target

# A new building system standing in wall opening `openingId` with a joint
# of `jointMillimetres` round it, in bays of at most `bay` and rows of at
# most `row` metres, its frame of `materialName`: a window. Its id, or the
# refused id (nothing added) when it cannot stand there.
function add bim system in opening {a 64 bit integer:openingId} with joint {a 64 bit integer:jointMillimetres} in bays of {a 64 bit floating-point number:bay} by {a 64 bit floating-point number:row} of {a string:materialName} to {a pointer to a bim model record:target}:
    execute:
        set openingFound to the bim opening index of openingId in (@intrinsic("dereference", target))
        if openingFound's valid = false:
            return the bim refused id
        set wallFound to the bim wall index of ((the item at openingFound's position in (target's openings's values))'s hostId) in (@intrinsic("dereference", target))
        if wallFound's valid = false:
            return the bim refused id
        set wallValue to the item at wallFound's position in (target's walls's values)
        # Laid first along the wall, then put where the opening is.
        set made to add bim curtain wall on (wallValue's levelId) from (wallValue's start) to (wallValue's finish) rising 1.0 in bays of bay by row of materialName to target
        if made = the bim refused id:
            return made
        if (host bim system made in opening openingId with joint jointMillimetres in target) = false:
            ignore delete bim curtain wall made from target
            return the bim refused id
        return made

# A new building system laid as a layer of building system `hostId`,
# `offsetMillimetres` across its face (to the right of its line, or up when
# it lies level), in its bays and rows and of its material. Its id, or the
# refused id.
function add bim layer to system {a 64 bit integer:hostId} offset {a 64 bit integer:offsetMillimetres} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim curtain index of hostId in (@intrinsic("dereference", target))
        if found's valid = false:
            return the bim refused id
        set hostValue to the item at found's position in (target's curtains's values)
        set fresh to add bim curtain wall on hostValue's levelId from hostValue's start to hostValue's finish rising hostValue's height in bays of hostValue's bayWidth by hostValue's rowHeight of hostValue's material to target
        if fresh = the bim refused id:
            return fresh
        set bim setting (bim layer host setting) of fresh to hostId keeping true in target
        set bim setting (bim layer offset setting) of fresh to offsetMillimetres keeping true in target
        set flat to the bim setting (bim system level setting) of hostId in (@intrinsic("dereference", target))
        if flat's found:
            set bim setting (bim system level setting) of fresh to flat's value keeping true in target
        # Stored as it stands, so that what reads the record alone sees it.
        set freshFound to the bim curtain index of fresh in (@intrinsic("dereference", target))
        set standing to the bim placed system (the item at freshFound's position in (target's curtains's values)) in (@intrinsic("dereference", target))
        replace item at index freshFound's position in (target's curtains's values) with standing's curtain
        return fresh

# A new building system nested in panel `panelIndex` of building system
# `curtainId`, in bays and rows half its host's (at least 0.3 m), of the
# host's material; it replaces the panel. Its id, or the refused id when
# the panel is off the system or already holds one.
function nest bim system in panel {integer:panelIndex} of {a 64 bit integer:curtainId} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim curtain index of curtainId in (@intrinsic("dereference", target))
        if found's valid = false:
            return the bim refused id
        set hostValue to the item at found's position in (target's curtains's values)
        if (panelIndex < 0) or (panelIndex >= ((the bim bay count of hostValue) * (the bim row count of hostValue))):
            return the bim refused id
        if (the bim system nested in panel panelIndex of curtainId in (@intrinsic("dereference", target))) != the bim refused id:
            return the bim refused id
        set fresh to add bim curtain wall on hostValue's levelId from hostValue's start to hostValue's finish rising hostValue's height in bays of (the maximum of 0.3 and (hostValue's bayWidth * 0.5)) by (the maximum of 0.3 and (hostValue's rowHeight * 0.5)) of hostValue's material to target
        if fresh = the bim refused id:
            return fresh
        set bim setting (bim host system setting) of fresh to curtainId keeping true in target
        set bim setting (bim host panel setting) of fresh to (panelIndex as a 64 bit integer) keeping true in target
        # Stored as it stands, so that what reads the record alone sees it in
        # its panel.
        set standing to the bim placed system (the item at ((the bim curtain index of fresh in (@intrinsic("dereference", target)))'s position) in (target's curtains's values)) in (@intrinsic("dereference", target))
        set freshFound to the bim curtain index of fresh in (@intrinsic("dereference", target))
        replace item at index freshFound's position in (target's curtains's values) with standing's curtain
        return fresh

# Part `lineCode` of building system `curtainId` (a mullion's index, 1000
# plus a transom's or 2000 plus a panel's) is the system's own, not unpinned.
function bim system line {integer:lineCode} of {a 64 bit integer:curtainId} is pinned in {bim model record:modelValue}:
    execute:
        return ((the bim setting ((bim unpinned line setting) + lineCode) of curtainId in modelValue)'s found) = false

# Grid line `lineCode` of `curtainValue` as a linear element on its storey:
# a mullion upright at its bay edge, a transom level along the whole line.
function the bim system line {integer:lineCode} of {bim curtain record:curtainValue} in {bim model record:modelValue}:
    execute:
        if lineCode >= 1000:
            return the bim system member of curtainValue at (the bim transom (lineCode - 1000) along curtainValue in modelValue) from 0.0 until (the bim system length of curtainValue) level true in modelValue
        return the bim system member of curtainValue at (the bim mullion lineCode along curtainValue in modelValue) from 0.0 until curtainValue's height level false in modelValue

# Grid line `lineCode` of building system `curtainId` unpinned: it becomes a
# free linear element of a mullion type of its profile and material (added
# once, named by the model's naming rule), which
# can then be moved, joined or deleted on its own. Its id, or the refused id.
function unpin bim system line {integer:lineCode} of {a 64 bit integer:curtainId} in {a pointer to a bim model record:target}:
    execute:
        set curtainFound to the bim curtain index of curtainId in (@intrinsic("dereference", target))
        if (curtainFound's valid = false) or ((bim system line lineCode of curtainId is pinned in (@intrinsic("dereference", target))) = false):
            return the bim refused id
        set curtainValue to the item at curtainFound's position in (target's curtains's values)
        set lineValue to the bim system line lineCode of curtainValue in (@intrinsic("dereference", target))
        set typeName to the string form of "Mullion"
        set wide to the bim joint width of system curtainId in (@intrinsic("dereference", target))
        set deep to the bim joint depth of system curtainId in (@intrinsic("dereference", target))
        if lineCode >= 1000:
            set typeName to the string form of "Transom"
            set wide to the bim joint depth of system curtainId in (@intrinsic("dereference", target))
            set deep to the bim joint width of system curtainId in (@intrinsic("dereference", target))
        set typeId to the bim refused id
        loop cursor from 0 to the length of (target's linearTypes's values):
            set candidate to the item at cursor in (target's linearTypes's values)
            if ((candidate's role = bim mullion role) and (candidate's material = curtainValue's material)) and (((the absolute value of (candidate's width - wide)) < 1e-6) and ((the absolute value of (candidate's depth - deep)) < 1e-6)):
                set typeId to candidate's id
        if typeId = the bim refused id:
            set typeId to add bim linear type named typeName as role bim mullion role sized wide by deep round false of curtainValue's material to target
        set freeId to add bim linear typed typeId on curtainValue's levelId from lineValue's start to lineValue's finish turned lineValue's angle to target
        set bim setting ((bim unpinned line setting) + lineCode) of curtainId to freeId keeping true in target
        return freeId

# Panel `panelIndex` of upright building system `curtainId` unpinned: it
# becomes a free wall of the panel's planar type (glass: a "Glass" type of
# 24 mm, added once) over the panel's place between the grid lines, which
# can then be moved, changed or deleted on its own. Its id, or the refused
# id (a level-lying system's panels stay).
function unpin bim system panel {integer:panelIndex} of {a 64 bit integer:curtainId} in {a pointer to a bim model record:target}:
    execute:
        set curtainFound to the bim curtain index of curtainId in (@intrinsic("dereference", target))
        if (curtainFound's valid = false) or ((bim system line (2000 + panelIndex) of curtainId is pinned in (@intrinsic("dereference", target))) = false):
            return the bim refused id
        if bim system curtainId lies level in (@intrinsic("dereference", target)):
            return the bim refused id
        set placement to the bim placed system (the item at curtainFound's position in (target's curtains's values)) in (@intrinsic("dereference", target))
        set curtainValue to placement's curtain
        set rows to the bim row count of curtainValue
        if (rows < 1) or ((panelIndex < 0) or (panelIndex >= ((the bim bay count of curtainValue) * rows))):
            return the bim refused id
        set bayCursor to panelIndex / rows
        set rowCursor to panelIndex - (bayCursor * rows)
        set half to (the bim joint width of system curtainId in (@intrinsic("dereference", target))) * 0.5
        set fromAlong to (the bim mullion bayCursor along curtainValue in (@intrinsic("dereference", target))) + half
        set untilAlong to (the bim mullion (bayCursor + 1) along curtainValue in (@intrinsic("dereference", target))) - half
        set foot to (the bim transom rowCursor along curtainValue in (@intrinsic("dereference", target))) + half
        set head to (the bim transom (rowCursor + 1) along curtainValue in (@intrinsic("dereference", target))) - half
        if ((untilAlong - fromAlong) < 0.01) or ((head - foot) < 0.01):
            return the bim refused id
        set typeId to the bim panel type of panel panelIndex of system curtainId in (@intrinsic("dereference", target))
        if (the bim wall type index of typeId in (@intrinsic("dereference", target)))'s valid = false:
            set typeId to the bim example type named (the string form of "Glass") of (the string form of "glass") 0.024 in target
        set fromPoint to the bim system point at fromAlong of curtainValue
        set untilPoint to the bim system point at untilAlong of curtainValue
        set freeId to add bim wall typed typeId on curtainValue's levelId from fromPoint to untilPoint to target
        if freeId = the bim refused id:
            return the bim refused id
        ignore (set bim wall freeId base to (foot + placement's lift) and height to (head - foot) in target)
        set bim setting ((bim unpinned line setting) + (2000 + panelIndex)) of curtainId to freeId keeping true in target
        return freeId

# Where free element `linearId` (a linear element or a wall) came from: the
# building system and the part it was unpinned from.
class:
    patterns:
        [a|] bim pinning record
    members:
        found as a boolean
        curtainId as a 64 bit integer
        lineCode as an integer

function the bim pinning of element {a 64 bit integer:linearId} in {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's settings's values):
            set entry to the item at cursor in (modelValue's settings's values)
            if ((entry's code >= (bim unpinned line setting)) and (entry's code < ((bim unpinned line setting) + 100000))) and (entry's value = linearId):
                return @intrinsic("construct", a bim pinning record, true, entry's elementId, entry's code - (bim unpinned line setting))
        return @intrinsic("construct", a bim pinning record, false, the bim refused id, 0)

# Free element `linearId` pinned back to the building system it came from:
# it is deleted and the system draws the grid line or panel again. Whether
# it was one.
function pin bim element {a 64 bit integer:linearId} back in {a pointer to a bim model record:target}:
    execute:
        set pinning to the bim pinning of element linearId in (@intrinsic("dereference", target))
        if pinning's found = false:
            return false
        set bim setting ((bim unpinned line setting) + pinning's lineCode) of pinning's curtainId to (0 as a 64 bit integer) keeping false in target
        if pinning's lineCode >= 2000:
            return delete bim wall linearId from target
        return delete bim linear linearId from target

# A building system's rule for the openings hosted in it: cut and frame (the
# grid lines stop at a frame of jambs, head and sill around the opening and
# the panels are cut to it), replace panels (the panels it touches go) or
# ignore.
function bim cut and frame rule:
    replacement:
        0
function bim replace panels rule:
    replacement:
        1
function bim ignore openings rule:
    replacement:
        2

function the bim name of opening rule {integer:ruleCode}:
    execute:
        if ruleCode = bim replace panels rule:
            return the string form of "Replace panels"
        if ruleCode = bim ignore openings rule:
            return the string form of "Ignore"
        return the string form of "Cut and frame"

function the bim opening rule of system {a 64 bit integer:curtainId} in {bim model record:modelValue}:
    execute:
        return (the bim setting (bim opening rule setting) of curtainId in modelValue)'s value as an integer

# A building system's pattern: a grid (every row's joints in line, as a
# curtain wall or stack bond) or a running bond (every other row's joints
# halfway along the bays, as half-brick masonry).
function bim grid pattern:
    replacement:
        0
function bim running bond pattern:
    replacement:
        1
function bim diamond pattern:
    replacement:
        2
function bim pattern count:
    replacement:
        3

function the bim name of pattern {integer:patternCode}:
    execute:
        if patternCode = bim running bond pattern:
            return the string form of "Running bond"
        if patternCode = bim diamond pattern:
            return the string form of "Diamond"
        return the string form of "Grid"

function the bim pattern of system {a 64 bit integer:curtainId} in {bim model record:modelValue}:
    execute:
        return (the bim setting (bim system pattern setting) of curtainId in modelValue)'s value as an integer

# A member of building system `curtainValue` straight across its face from
# `fromAlong`, `fromUp` to `untilAlong`, `untilUp` (along its line, up its
# face), its width lying in the face: a diamond's joints and cells.
function the bim face member of {bim curtain record:curtainValue} from {cad vector2:fromSpot} to {cad vector2:toSpot} in {bim model record:modelValue}:
    execute:
        set first to the bim face point of curtainValue at fromSpot's x up fromSpot's y in modelValue
        set last to the bim face point of curtainValue at toSpot's x up toSpot's y in modelValue
        set turn to 1.5707963267948966
        if bim system curtainValue's id lies level in modelValue:
            set turn to 0.0
        return @intrinsic("construct", a bim linear record, curtainValue's id, the bim refused id, curtainValue's levelId, first, last, turn, 0.0, (a cad vector2 with x 1.0 and y 1.0))

# A diamond pattern's parts over a face `faceLength` along by `faceHeight` up,
# its diagonals `spacing` apart along the line: joints at 45 and 135 degrees
# from edge to edge (when `withJoints`), and a cell in every whole diamond
# (when `withCells`), of `panelTypeId` or glass, short of the joints by
# `jointWidth`.
function append bim diamond parts of {bim curtain record:curtainValue} spaced {a 64 bit floating-point number:spacing} over {a 64 bit floating-point number:faceLength} by {a 64 bit floating-point number:faceHeight} joints {boolean:withJoints} of {bim linear type record:jointType} cells {boolean:withCells} typed {a 64 bit integer:panelTypeId} in {bim model record:modelValue} into {a pointer to a list:partList}:
    execute:
        if spacing < 0.01:
            return nothing
        set jointWidth to jointType's width
        if withJoints:
            # Rising lines v = u - c and falling lines v = c - u, clipped to
            # the face.
            set offset to 0.0 - (the floor of (faceHeight / spacing)) * spacing
            loop while offset <= faceLength:
                set riseFrom to the maximum of 0.0 and offset
                set riseTo to the minimum of faceLength and (faceHeight + offset)
                if (riseTo - riseFrom) > 0.001:
                    append (@intrinsic("construct", a bim stair part record, the bim face member of curtainValue from (a cad vector2 with x riseFrom and y (riseFrom - offset)) to (a cad vector2 with x riseTo and y (riseTo - offset)) in modelValue, jointType)) to partList
                set offset to offset + spacing
            set offset to 0.0
            loop while offset <= (faceLength + faceHeight):
                set fallFrom to the maximum of 0.0 and (offset - faceHeight)
                set fallTo to the minimum of faceLength and offset
                if (fallTo - fallFrom) > 0.001:
                    append (@intrinsic("construct", a bim stair part record, the bim face member of curtainValue from (a cad vector2 with x fallFrom and y (offset - fallFrom)) to (a cad vector2 with x fallTo and y (offset - fallTo)) in modelValue, jointType)) to partList
                set offset to offset + spacing
        if withCells = false:
            return nothing
        # Each cell: a square turned 45 degrees, its axis across it from the
        # middle of one side to the middle of the opposite one.
        set thickness to the bim glass thickness
        set cellMaterial to the string form of "glass"
        set layered to the bim wall type index of panelTypeId in modelValue
        if layered's valid:
            set planarType to the item at layered's position in (modelValue's wallTypes's values)
            set thickness to the bim thickness of planarType
            if (the length of (planarType's layers's values)) > 0:
                set cellMaterial to (the item at 0 in (planarType's layers's values))'s material
        set halfDiagonal to spacing * 0.5
        set side to (spacing / 1.4142135623730951) - jointWidth
        if side <= 0.001:
            return nothing
        set cellType to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Panel", bim generic linear role, side, thickness, false, cellMaterial)
        set reach to side / (2.0 * 1.4142135623730951)
        set inset to jointWidth * 0.5
        # Diamonds whose diamondCentre lies on an edge are cut in half there, and
        # those centred on a corner in four: the part inside the face is a
        # triangle, a panel tapering from its long side to its point.
        set reachIndex to ((the ceiling of ((faceLength + faceHeight) / spacing)) as an integer) + 1
        set riseIndex to 0 - reachIndex
        loop while riseIndex <= reachIndex:
            set fallIndex to 0 - reachIndex
            loop while fallIndex <= reachIndex:
                set riseOffset to ((riseIndex as a 64 bit floating-point number) + 0.5) * spacing
                set fallOffset to ((fallIndex as a 64 bit floating-point number) + 0.5) * spacing
                set centreAlong to (fallOffset + riseOffset) * 0.5
                set centreUp to (fallOffset - riseOffset) * 0.5
                set inLength to ((centreAlong - halfDiagonal) >= -0.0001) and ((centreAlong + halfDiagonal) <= (faceLength + 0.0001))
                set inHeight to ((centreUp - halfDiagonal) >= -0.0001) and ((centreUp + halfDiagonal) <= (faceHeight + 0.0001))
                set onLeft to (the absolute value of centreAlong) < 0.0001
                set onRight to (the absolute value of (centreAlong - faceLength)) < 0.0001
                set onBottom to (the absolute value of centreUp) < 0.0001
                set onTop to (the absolute value of (centreUp - faceHeight)) < 0.0001
                set acrossLength to (centreAlong >= -0.0001) and (centreAlong <= (faceLength + 0.0001))
                set acrossHeight to (centreUp >= -0.0001) and (centreUp <= (faceHeight + 0.0001))
                set diamondCentre to a cad vector2 with x centreAlong and y centreUp
                if inLength and inHeight:
                    set cell to the bim face member of curtainValue from (a cad vector2 with x (centreAlong - reach) and y (centreUp - reach)) to (a cad vector2 with x (centreAlong + reach) and y (centreUp + reach)) in modelValue
                    append (@intrinsic("construct", a bim stair part record, cell, cellType)) to partList
                else if (onLeft or onRight) and (onBottom or onTop):
                    # A corner's quarter: legs along the two edges, its long
                    # side a joint; every side kept off its joint.
                    set inward to a cad vector2 with x 0.7071067811865476 and y 0.7071067811865476
                    if onRight:
                        set inward's x to -0.7071067811865476
                    if onTop:
                        set inward's y to -0.7071067811865476
                    set tall to halfDiagonal * 0.7071067811865476
                    set inRadius to halfDiagonal * (1.0 - 0.7071067811865476)
                    set shrink to (inRadius - inset) / inRadius
                    if shrink > 0.01:
                        set inCentre to the cad sum of diamondCentre and (inward scaled by (inRadius * 1.4142135623730951))
                        set tipPoint to the cad sum of inCentre and (inward scaled by (0.0 - (shrink * (inRadius * 1.4142135623730951))))
                        set basePoint to the cad sum of inCentre and (inward scaled by (shrink * (tall - (inRadius * 1.4142135623730951))))
                        append bim wedge of curtainValue from basePoint to tipPoint wide (2.0 * (shrink * tall)) as cellType in modelValue into partList
                else if (((onBottom or onTop) and inLength) and acrossHeight) or (((onLeft or onRight) and inHeight) and acrossLength):
                    # An edge's half: its long side along the edge.
                    set inward to a cad vector2 with x 0.0 and y 1.0
                    if onTop:
                        set inward to a cad vector2 with x 0.0 and y -1.0
                    if onLeft:
                        set inward to a cad vector2 with x 1.0 and y 0.0
                    if onRight:
                        set inward to a cad vector2 with x -1.0 and y 0.0
                    set inRadius to halfDiagonal * (1.4142135623730951 - 1.0)
                    set shrink to (inRadius - inset) / inRadius
                    if shrink > 0.01:
                        set basePoint to the cad sum of diamondCentre and (inward scaled by inset)
                        set tipPoint to the cad sum of basePoint and (inward scaled by (shrink * halfDiagonal))
                        append bim wedge of curtainValue from basePoint to tipPoint wide (2.0 * (shrink * halfDiagonal)) as cellType in modelValue into partList
                set fallIndex to fallIndex + 1
            set riseIndex to riseIndex + 1

# A triangular cell on `curtainValue`'s face: a panel of `cellType` from the
# middle of its long side `basePoint`, `width` wide, tapering to its point
# `tipPoint` (face coordinates).
function append bim wedge of {bim curtain record:curtainValue} from {cad vector2:basePoint} to {cad vector2:tipPoint} wide {a 64 bit floating-point number:width} as {bim linear type record:cellType} in {bim model record:modelValue} into {a pointer to a list:partList}:
    execute:
        set cell to the bim face member of curtainValue from basePoint to tipPoint in modelValue
        set cell's taper to a cad vector2 with x 0.002 and y 1.0
        set triangleType to cellType
        set triangleType's width to width
        append (@intrinsic("construct", a bim stair part record, cell, triangleType)) to partList

# The width and depth of building system `curtainId`'s joints (its mullions
# and transoms, or a masonry's mortar joints): settings in millimetres, else
# 50 by 150 mm.
function the bim joint width of system {a 64 bit integer:curtainId} in {bim model record:modelValue}:
    execute:
        set reading to the bim setting (bim joint width setting) of curtainId in modelValue
        if reading's found:
            return (reading's value as a 64 bit floating-point number) / 1000.0
        return the bim mullion width
function the bim joint depth of system {a 64 bit integer:curtainId} in {bim model record:modelValue}:
    execute:
        set reading to the bim setting (bim joint depth setting) of curtainId in modelValue
        if reading's found:
            return (reading's value as a 64 bit floating-point number) / 1000.0
        return the bim mullion depth

# Where the joints of row `rowIndex` of `curtainValue` stand along its line,
# in order, from its start to its end: the mullions; in a running bond's odd
# rows, halfway between them instead (half cells at the ends).
function the bim joints of row {integer:rowIndex} of {bim curtain record:curtainValue} patterned {integer:patternCode} in {bim model record:modelValue}:
    execute:
        set jointList to a cad topology list of a 64 bit floating-point number
        set bays to the bim bay count of curtainValue
        set shifted to (patternCode = bim running bond pattern) and ((the remainder of rowIndex divided by 2) = 1)
        if shifted = false:
            loop lineCursor from 0 to (bays + 1):
                append (the bim mullion lineCursor along curtainValue in modelValue) to (jointList's values)
            return jointList
        append (the bim mullion 0 along curtainValue in modelValue) to (jointList's values)
        loop lineCursor from 0 to bays:
            append (((the bim mullion lineCursor along curtainValue in modelValue) + (the bim mullion (lineCursor + 1) along curtainValue in modelValue)) * 0.5) to (jointList's values)
        append (the bim mullion bays along curtainValue in modelValue) to (jointList's values)
        return jointList

# A rectangle on a building system's face: `fromAlong` to `untilAlong`
# metres along its line, `bottom` to `top` up from its foot.
class:
    patterns:
        [a|] bim face rectangle record
    members:
        fromAlong as a 64 bit floating-point number
        untilAlong as a 64 bit floating-point number
        bottom as a 64 bit floating-point number
        top as a 64 bit floating-point number

# The rough openings of the openings hosted in building system `curtainId`.
function the bim openings in system {a 64 bit integer:curtainId} in {bim model record:modelValue}:
    execute:
        set found to a cad topology list of a bim face rectangle record
        loop cursor from 0 to the length of (modelValue's openings's values):
            set openingValue to the item at cursor in (modelValue's openings's values)
            if openingValue's hostId = curtainId:
                set typeFound to the bim opening type index of openingValue's typeId in modelValue
                if typeFound's valid:
                    set openingType to the item at typeFound's position in (modelValue's openingTypes's values)
                    set halfWidth to (the bim rough width of openingType) * 0.5
                    append (@intrinsic("construct", a bim face rectangle record, openingValue's offset - halfWidth, openingValue's offset + halfWidth, openingType's sill, the bim head height of openingType)) to (found's values)
        return found

# A rough opening grown by the frame around it (`frameWidth` each side; no
# sill frame at the foot, the opening then reaching below it).
function the bim framed {bim face rectangle record:roughBox} widened by {a 64 bit floating-point number:frameWidth}:
    execute:
        set foot to roughBox's bottom - frameWidth
        if roughBox's bottom <= frameWidth:
            set foot to -1.0
        return @intrinsic("construct", a bim face rectangle record, roughBox's fromAlong - frameWidth, roughBox's untilAlong + frameWidth, foot, roughBox's top + frameWidth)

# The pieces of the run `low` to `high` left outside the gaps `gapList`
# (cad vector2s: x from, y until), longer than a millimetre.
function the bim pieces of {a 64 bit floating-point number:low} until {a 64 bit floating-point number:high} outside {a pointer to a list:gapList}:
    execute:
        set pieceList to a cad topology list of a cad vector2
        append (a cad vector2 with x low and y high) to (pieceList's values)
        loop gapCursor from 0 to the length of gapList:
            set gap to the item at gapCursor in gapList
            set kept to a cad topology list of a cad vector2
            loop pieceCursor from 0 to the length of (pieceList's values):
                set piece to the item at pieceCursor in (pieceList's values)
                if (gap's y <= piece's x) or (gap's x >= piece's y):
                    append piece to (kept's values)
                else:
                    if (gap's x - piece's x) > 0.001:
                        append (a cad vector2 with x piece's x and y gap's x) to (kept's values)
                    if (piece's y - gap's y) > 0.001:
                        append (a cad vector2 with x gap's y and y piece's y) to (kept's values)
            set pieceList to kept
        return pieceList

# The pieces of rectangle `whole` left outside rectangles `holeList`, each
# hole taking a left and right strip and what lies below and above it.
function the bim areas of {bim face rectangle record:whole} outside rectangles {a pointer to a list:holeList}:
    execute:
        set pieceList to a cad topology list of a bim face rectangle record
        append whole to (pieceList's values)
        loop holeCursor from 0 to the length of holeList:
            set hole to the item at holeCursor in holeList
            set kept to a cad topology list of a bim face rectangle record
            loop pieceCursor from 0 to the length of (pieceList's values):
                set piece to the item at pieceCursor in (pieceList's values)
                if ((hole's untilAlong <= piece's fromAlong) or (hole's fromAlong >= piece's untilAlong)) or ((hole's top <= piece's bottom) or (hole's bottom >= piece's top)):
                    append piece to (kept's values)
                else:
                    set innerFrom to the maximum of piece's fromAlong and hole's fromAlong
                    set innerUntil to the minimum of piece's untilAlong and hole's untilAlong
                    if (hole's fromAlong - piece's fromAlong) > 0.01:
                        append (@intrinsic("construct", a bim face rectangle record, piece's fromAlong, hole's fromAlong, piece's bottom, piece's top)) to (kept's values)
                    if (piece's untilAlong - hole's untilAlong) > 0.01:
                        append (@intrinsic("construct", a bim face rectangle record, hole's untilAlong, piece's untilAlong, piece's bottom, piece's top)) to (kept's values)
                    if (hole's bottom - piece's bottom) > 0.01:
                        append (@intrinsic("construct", a bim face rectangle record, innerFrom, innerUntil, piece's bottom, hole's bottom)) to (kept's values)
                    if (piece's top - hole's top) > 0.01:
                        append (@intrinsic("construct", a bim face rectangle record, innerFrom, innerUntil, hole's top, piece's top)) to (kept's values)
            set pieceList to kept
        return pieceList

# One straight member of building system `curtainValue` as a linear part:
# upright at `along` from `low` to `high` up, or (`level`) level at height
# `along` from `low` to `high` along its line.
function the bim system member of {bim curtain record:curtainValue} at {a 64 bit floating-point number:along} from {a 64 bit floating-point number:low} until {a 64 bit floating-point number:high} level {boolean:lying} in {bim model record:modelValue}:
    execute:
        set flat to bim system curtainValue's id lies level in modelValue
        if lying:
            # Along the line at height `along` on the face: straight from the
            # point at `low` to the point at `high` (a chord where it curves).
            set first to the bim face point of curtainValue at low up along in modelValue
            set last to the bim face point of curtainValue at high up along in modelValue
            return @intrinsic("construct", a bim linear record, curtainValue's id, the bim refused id, curtainValue's levelId, first, last, 0.0, 0.0, (a cad vector2 with x 1.0 and y 1.0))
        set first to the bim face point of curtainValue at along up low in modelValue
        set last to the bim face point of curtainValue at along up high in modelValue
        set turn to the bim system heading at along of curtainValue
        if flat:
            set turn to 0.0
        return @intrinsic("construct", a bim linear record, curtainValue's id, the bim refused id, curtainValue's levelId, first, last, turn, 0.0, (a cad vector2 with x 1.0 and y 1.0))

# Whether building system `curtainId` lies level (a floor or ceiling system).
function bim system {a 64 bit integer:curtainId} lies level in {bim model record:modelValue}:
    execute:
        return (the bim setting (bim system level setting) of curtainId in modelValue)'s found

# The point of building system `curtainValue`'s face `along` metres along its
# line and `height` up its face: upright, above the line's point; lying
# level, that far across the line to its left, at the system's height.
function the bim face point of {bim curtain record:curtainValue} at {a 64 bit floating-point number:along} up {a 64 bit floating-point number:height} in {bim model record:modelValue}:
    execute:
        set footPoint to the bim system point at along of curtainValue
        set flat to the bim setting (bim system level setting) of curtainValue's id in modelValue
        if flat's found = false:
            return a cad vector3 with x footPoint's x, y footPoint's y and z height
        set faceHeading to the bim system heading at along of curtainValue
        set flatHeight to (flat's value as a 64 bit floating-point number) / 1000.0
        return a cad vector3 with x (footPoint's x - (height * (the sine of faceHeading))), y (footPoint's y + (height * (the cosine of faceHeading))) and z flatHeight

# Where model point `spot` (its height above the system's storey) lies on
# building system `storedValue`'s face as placed: metres along its line (x)
# and up its face (y); the inverse of `the bim face point of`.
function the bim face place of {cad vector3:spot} on {bim curtain record:storedValue} in {bim model record:modelValue}:
    execute:
        set placement to the bim placed system storedValue in modelValue
        set curtainValue to placement's curtain
        set station to the bim system station of (a cad vector2 with x spot's x and y spot's y) on curtainValue
        if bim system curtainValue's id lies level in modelValue:
            return a cad vector2 with x station's x and y station's y
        return a cad vector2 with x station's x and y (spot's z - placement's lift)

# A panel of building system `curtainValue` over rectangle `area` (inside
# the frame): one part per layer of planar type `panelTypeId`, stacked
# across the line from its exterior side (the right of the line), the whole
# centred on the line; glass when the type is not a planar type.
function append bim panel of {bim curtain record:curtainValue} typed {a 64 bit integer:panelTypeId} over {bim face rectangle record:area} in {bim model record:modelValue} into {a pointer to a list:partList}:
    execute:
        # Flat between its edges' points: a chord where the line curves.
        set fromPoint to the bim face point of curtainValue at area's fromAlong up area's bottom in modelValue
        set toPoint to the bim face point of curtainValue at area's untilAlong up area's bottom in modelValue
        set panelWide to the cad distance from fromPoint to toPoint
        if panelWide < 1e-9:
            return nothing
        set ux to (toPoint's x - fromPoint's x) / panelWide
        set uy to (toPoint's y - fromPoint's y) / panelWide
        set turn to @intrinsic("atan2", uy, ux)
        # Its layers stack across the face: across the plan upright, up
        # lying level.
        set nx to uy
        set ny to 0.0 - ux
        set nz to 0.0
        if bim system curtainValue's id lies level in modelValue:
            set turn to 0.0
            set nx to 0.0
            set ny to 0.0
            set nz to 1.0
        set middle to (area's fromAlong + area's untilAlong) * 0.5
        set panelFoot to the bim face point of curtainValue at middle up area's bottom in modelValue
        set panelHead to the bim face point of curtainValue at middle up area's top in modelValue
        set layered to the bim wall type index of panelTypeId in modelValue
        if layered's valid:
            set planarType to the item at layered's position in (modelValue's wallTypes's values)
            set total to the bim thickness of planarType
            set reached to 0.0
            loop layerCursor from 0 to the length of (planarType's layers's values):
                set layer to the item at layerCursor in (planarType's layers's values)
                set across to (total * 0.5) - (reached + (layer's thickness * 0.5))
                set reached to reached + layer's thickness
                set layerFoot to a cad vector3 with x (panelFoot's x + (nx * across)), y (panelFoot's y + (ny * across)) and z (panelFoot's z + (nz * across))
                set layerHead to a cad vector3 with x (panelHead's x + (nx * across)), y (panelHead's y + (ny * across)) and z (panelHead's z + (nz * across))
                set layerType to @intrinsic("construct", a bim linear type record, the bim refused id, planarType's name, bim generic linear role, panelWide, layer's thickness, false, layer's material)
                set layerPart to @intrinsic("construct", a bim linear record, curtainValue's id, the bim refused id, curtainValue's levelId, layerFoot, layerHead, turn, 0.0, (a cad vector2 with x 1.0 and y 1.0))
                append (@intrinsic("construct", a bim stair part record, layerPart, layerType)) to partList
        else:
            set panelType to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Panel", bim generic linear role, panelWide, the bim glass thickness, false, the string form of "glass")
            set panelPart to @intrinsic("construct", a bim linear record, curtainValue's id, the bim refused id, curtainValue's levelId, panelFoot, panelHead, turn, 0.0, (a cad vector2 with x 1.0 and y 1.0))
            append (@intrinsic("construct", a bim stair part record, panelPart, panelType)) to partList

# ---------------------------------------------------------------- contour

# The outline of building system `curtainValue`'s face: its contour, or the
# rectangle of its length by its height.
function the bim face outline of {bim curtain record:curtainValue} in {bim model record:modelValue}:
    execute:
        set faceOutline to the bim face contour of curtainValue's id in modelValue
        if (the length of faceOutline) >= 3:
            return faceOutline
        set wallLength to the bim system length of curtainValue
        append (a cad vector2 with x 0.0 and y 0.0) to faceOutline
        append (a cad vector2 with x wallLength and y 0.0) to faceOutline
        append (a cad vector2 with x wallLength and y curtainValue's height) to faceOutline
        append (a cad vector2 with x 0.0 and y curtainValue's height) to faceOutline
        return faceOutline

# The stretches of the line through `position` inside polygon `outline`
# (in face coordinates), between `low` and `high`: upright (x = `position`)
# or, `lying`, level (y = `position`). Each a vector, from x to y.
function the bim inside runs of {a pointer to a list:outline} at {a 64 bit floating-point number:position} lying {boolean:isLying} from {a 64 bit floating-point number:low} until {a 64 bit floating-point number:high}:
    execute:
        set crossings to an empty list of a 64 bit floating-point number
        set count to the length of outline
        loop cursor from 0 to count:
            set here to the item at cursor in outline
            set next to the item at (the remainder of (cursor + 1) divided by count) in outline
            set hereAcross to here's x
            set nextAcross to next's x
            set hereRun to here's y
            set nextRun to next's y
            if isLying:
                set hereAcross to here's y
                set nextAcross to next's y
                set hereRun to here's x
                set nextRun to next's x
            if ((hereAcross <= position) and (nextAcross > position)) or ((nextAcross <= position) and (hereAcross > position)):
                set share to (position - hereAcross) / (nextAcross - hereAcross)
                set crossing to hereRun + ((nextRun - hereRun) * share)
                # Kept in order.
                append crossing to crossings
                set slot to (the length of crossings) - 1
                set moving to true
                loop while moving:
                    if slot = 0:
                        set moving to false
                    else:
                        set before to the item at (slot - 1) in crossings
                        if before > crossing:
                            replace item at index slot in crossings with before
                            set slot to slot - 1
                        else:
                            set moving to false
                replace item at index slot in crossings with crossing
        set runList to a cad topology list of a cad vector2
        set pair to 0
        loop while (pair + 1) < the length of crossings:
            set runLow to the maximum of low and (the item at pair in crossings)
            set runHigh to the minimum of high and (the item at (pair + 1) in crossings)
            if runHigh > (runLow + 1e-9):
                append (a cad vector2 with x runLow and y runHigh) to (runList's values)
            set pair to pair + 2
        free crossings
        return runList

# Appends to `gapList` the stretches between `low` and `high` outside
# `runs` (see `the bim inside runs of`), as gaps for `the bim pieces of`.
function append bim gaps between {a pointer to a list:runs} from {a 64 bit floating-point number:low} until {a 64 bit floating-point number:high} into {a pointer to a list:gapList}:
    execute:
        set reached to low
        loop cursor from 0 to the length of runs:
            set run to the item at cursor in runs
            if run's x > reached:
                append (a cad vector2 with x reached and y run's x) to gapList
            set reached to the maximum of reached and run's y
        if high > reached:
            append (a cad vector2 with x reached and y high) to gapList

# Polygon `outline` cut to rectangle `area` (Sutherland and Hodgman).
function the bim polygon {a pointer to a list:outline} cut to {bim face rectangle record:area}:
    execute:
        set current to an empty list of a cad vector2
        loop cursor from 0 to the length of outline:
            append (the item at cursor in outline) to current
        loop side from 0 to 4:
            set kept to an empty list of a cad vector2
            set count to the length of current
            loop cursor from 0 to count:
                set here to the item at cursor in current
                set next to the item at (the remainder of (cursor + 1) divided by count) in current
                set hereIn to bim face point here lies within side side of area
                set nextIn to bim face point next lies within side side of area
                if hereIn:
                    append here to kept
                if hereIn != nextIn:
                    append (the bim crossing of here and next on side side of area) to kept
            free current
            set current to kept
        return current

function bim face point {cad vector2:spot} lies within side {integer:sideCode} of {bim face rectangle record:area}:
    execute:
        if sideCode = 0:
            return spot's x >= area's fromAlong
        if sideCode = 1:
            return spot's x <= area's untilAlong
        if sideCode = 2:
            return spot's y >= area's bottom
        return spot's y <= area's top

function the bim crossing of {cad vector2:here} and {cad vector2:next} on side {integer:sideCode} of {bim face rectangle record:area}:
    execute:
        set edge to area's top
        if sideCode = 0:
            set edge to area's fromAlong
        if sideCode = 1:
            set edge to area's untilAlong
        if sideCode = 2:
            set edge to area's bottom
        if sideCode < 2:
            set share to (edge - here's x) / (next's x - here's x)
            return a cad vector2 with x edge and y (here's y + ((next's y - here's y) * share))
        set share to (edge - here's y) / (next's y - here's y)
        return a cad vector2 with x (here's x + ((next's x - here's x) * share)) and y edge

# The area of polygon `outline`.
function the bim face area of {a pointer to a list:outline}:
    execute:
        set twice to 0.0
        set count to the length of outline
        loop cursor from 0 to count:
            set here to the item at cursor in outline
            set next to the item at (the remainder of (cursor + 1) divided by count) in outline
            set twice to twice + ((here's x * next's y) - (next's x * here's y))
        return (the absolute value of twice) * 0.5

# How much of rectangle `area` the contour `outline` covers: 0 none, 1
# all, 2 part (the panel is then cut to it).
function the bim cover of {a pointer to a list:outline} over {bim face rectangle record:area}:
    execute:
        set clipped to the bim polygon outline cut to area
        set covered to 0.0
        if (the length of clipped) >= 3:
            set covered to the bim face area of clipped
        free clipped
        set whole to (area's untilAlong - area's fromAlong) * (area's top - area's bottom)
        if covered <= (whole * 1e-6):
            return 0
        if covered >= (whole * (1.0 - 1e-6)):
            return 1
        return 2

# The panels of building system `storedValue` its contour crosses: each
# panel's rectangle (inside the frame) cut to the contour, in face
# coordinates, with the panel's planar type.
class:
    patterns:
        [a|] bim contour panel record
    members:
        outline as the type of (a cad topology list of a cad vector2)
        typeId as a 64 bit integer

function the bim contour panels of {bim curtain record:storedValue} in {bim model record:modelValue}:
    execute:
        set found to a cad topology list of a bim contour panel record
        set contourList to the bim face contour of storedValue's id in modelValue
        if (the length of contourList) < 3:
            free contourList
            return found
        set placement to the bim placed system storedValue in modelValue
        set curtainValue to placement's curtain
        set wallLength to the bim system length of curtainValue
        set patternCode to the bim pattern of system curtainValue's id in modelValue
        set celled to ((the bim setting (bim system cells setting) of curtainValue's id in modelValue)'s value) = (0 as a 64 bit integer)
        if ((wallLength < 1e-9) or (celled = false)) or (patternCode != bim grid pattern):
            free contourList
            return found
        set bays to the bim divisions of wallLength at most curtainValue's bayWidth
        set rows to the bim divisions of curtainValue's height at most curtainValue's rowHeight
        set half to (the bim joint width of system curtainValue's id in modelValue) * 0.5
        loop bayCursor from 0 to bays:
            loop rowCursor from 0 to rows:
                set panelIndex to (bayCursor * rows) + rowCursor
                if ((the bim system nested in panel panelIndex of curtainValue's id in modelValue) = the bim refused id) and (bim system line (2000 + panelIndex) of curtainValue's id is pinned in modelValue):
                    set panelArea to @intrinsic("construct", a bim face rectangle record, (the bim mullion bayCursor along curtainValue in modelValue) + half, (the bim mullion (bayCursor + 1) along curtainValue in modelValue) - half, (the bim transom rowCursor along curtainValue in modelValue) + half, (the bim transom (rowCursor + 1) along curtainValue in modelValue) - half)
                    if (the bim cover of contourList over panelArea) = 2:
                        set cut to a cad topology list of a cad vector2
                        set clipped to the bim polygon contourList cut to panelArea
                        loop cursor from 0 to the length of clipped:
                            append (the item at cursor in clipped) to (cut's values)
                        free clipped
                        append (@intrinsic("construct", a bim contour panel record, cut, the bim panel type of panel panelIndex of system curtainValue's id in modelValue)) to (found's values)
        free contourList
        return found

# The frame members of building system `curtainValue` along the edges of
# its contour that do not lie on a grid line: upright, level or sloped
# along its face (a chord between mullions where the line curves).
function append bim contour frame of {bim curtain record:curtainValue} along {a pointer to a list:contourList} bays {integer:bayCount} rows {integer:rowCount} upright {bim linear type record:mullionType} level {bim linear type record:transomType} in {bim model record:modelValue} into {a pointer to a list:partList}:
    execute:
        set count to the length of contourList
        set curving to (the bim system path of curtainValue)'s curved
        loop cursor from 0 to count:
            set here to the item at cursor in contourList
            set next to the item at (the remainder of (cursor + 1) divided by count) in contourList
            set isUpright to (the absolute value of (here's x - next's x)) < 0.0005
            set isLevel to (the absolute value of (here's y - next's y)) < 0.0005
            set onGrid to false
            if isUpright:
                loop lineCursor from 0 to (bayCount + 1):
                    if (the absolute value of (here's x - (the bim mullion lineCursor along curtainValue in modelValue))) < 0.001:
                        set onGrid to true
            if isLevel:
                loop lineCursor from 0 to (rowCount + 1):
                    if (the absolute value of (here's y - (the bim transom lineCursor along curtainValue in modelValue))) < 0.001:
                        set onGrid to true
            if (onGrid = false) and ((the cad distance from here to next) > 0.001):
                if isUpright:
                    append (@intrinsic("construct", a bim stair part record, the bim system member of curtainValue at here's x from (the minimum of here's y and next's y) until (the maximum of here's y and next's y) level false in modelValue, mullionType)) to partList
                else:
                    # Level or sloped: straight between mullions where the
                    # line curves.
                    set fromAlong to the minimum of here's x and next's x
                    set untilAlong to the maximum of here's x and next's x
                    set cuts to a cad topology list of a cad vector2
                    if curving:
                        loop lineCursor from 1 to bayCount:
                            set mullionAlong to the bim mullion lineCursor along curtainValue in modelValue
                            append (a cad vector2 with x mullionAlong and y mullionAlong) to (cuts's values)
                    set stretches to the bim pieces of fromAlong until untilAlong outside (cuts's values)
                    loop stretchCursor from 0 to the length of (stretches's values):
                        set stretch to the item at stretchCursor in (stretches's values)
                        set lowUp to here's y + ((next's y - here's y) * ((stretch's x - here's x) / (next's x - here's x)))
                        set highUp to here's y + ((next's y - here's y) * ((stretch's y - here's x) / (next's x - here's x)))
                        set first to the bim face point of curtainValue at stretch's x up lowUp in modelValue
                        set last to the bim face point of curtainValue at stretch's y up highUp in modelValue
                        append (@intrinsic("construct", a bim stair part record, (@intrinsic("construct", a bim linear record, curtainValue's id, the bim refused id, curtainValue's levelId, first, last, 0.0, 0.0, (a cad vector2 with x 1.0 and y 1.0))), transomType)) to partList

# The mullions (upright, at every bay's edge), transoms (level, at every
# row's edge) and panels (one per bay and row, between the frame) of
# `storedValue`, all linear elements, as it stands (nested in a panel, it
# fills that panel). Openings hosted in it follow its opening rule.
function the bim parts of curtain wall {bim curtain record:storedValue} in {bim model record:modelValue}:
    execute:
        set derived to a cad topology list of a bim stair part record
        set placement to the bim placed system storedValue in modelValue
        set curtainValue to placement's curtain
        set wallLength to the bim system length of curtainValue
        set curving to (the bim system path of curtainValue)'s curved
        if wallLength < 1e-9:
            return derived
        set bays to the bim divisions of wallLength at most curtainValue's bayWidth
        set rows to the bim divisions of curtainValue's height at most curtainValue's rowHeight
        set frameWidth to the bim joint width of system curtainValue's id in modelValue
        set frameDepth to the bim joint depth of system curtainValue's id in modelValue
        set half to frameWidth * 0.5
        # A contour: the grid lines stop at it, and panels it crosses are
        # cut to it (`the bim contour panels of`).
        set contour to the bim face contour of curtainValue's id in modelValue
        set contoured to (the length of contour) >= 3
        set mullionType to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Mullion", bim mullion role, frameWidth, frameDepth, false, curtainValue's material)
        set transomType to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Transom", bim mullion role, frameDepth, frameWidth, false, curtainValue's material)
        # Lying level, a transom's width lies in the face and its depth up.
        if bim system curtainValue's id lies level in modelValue:
            set transomType to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Transom", bim mullion role, frameWidth, frameDepth, false, curtainValue's material)
        # Joints of no width are left out (a layer of panels alone), and
        # cells can be left out (a layer of studs, ties or hangers alone).
        set jointed to frameWidth > 0.0005
        set celled to ((the bim setting (bim system cells setting) of curtainValue's id in modelValue)'s value) = (0 as a 64 bit integer)
        # The openings, as rough openings and with their frames.
        set openingRule to the bim opening rule of system curtainValue's id in modelValue
        set roughList to a cad topology list of a bim face rectangle record
        if openingRule != bim ignore openings rule:
            set roughList to the bim openings in system curtainValue's id in modelValue
        set framedList to a cad topology list of a bim face rectangle record
        loop cursor from 0 to the length of (roughList's values):
            append (the bim framed (the item at cursor in (roughList's values)) widened by frameWidth) to (framedList's values)
        set framing to ((openingRule = bim cut and frame rule) and ((the length of (framedList's values)) > 0)) and jointed
        # The grid lines; an unpinned one is a free linear element of its
        # own instead. With framing, each stops at the frame's members.
        set patternCode to the bim pattern of system curtainValue's id in modelValue
        set bonded to patternCode = bim running bond pattern
        set diamond to patternCode = bim diamond pattern
        # A running bond's inner joints stand row by row, from bed joint to
        # bed joint; its two ends run the full height as a grid's do.
        if bonded and jointed:
            loop rowCursor from 0 to rows:
                set rowJoints to the bim joints of row rowCursor of curtainValue patterned patternCode in modelValue
                set jointFoot to the bim transom rowCursor along curtainValue in modelValue
                set jointHead to the bim transom (rowCursor + 1) along curtainValue in modelValue
                loop jointCursor from 1 to ((the length of (rowJoints's values)) - 1):
                    append (@intrinsic("construct", a bim stair part record, the bim system member of curtainValue at (the item at jointCursor in (rowJoints's values)) from jointFoot until jointHead level false in modelValue, mullionType)) to (derived's values)
        loop bayCursor from 0 to (bays + 1):
            set ownLine to ((bonded = false) and (diamond = false)) or ((bayCursor = 0) or (bayCursor = bays))
            if (ownLine and jointed) and (bim system line bayCursor of curtainValue's id is pinned in modelValue):
                set mullionAlong to the bim mullion bayCursor along curtainValue in modelValue
                set gaps to a cad topology list of a cad vector2
                if framing:
                    loop cursor from 0 to the length of (framedList's values):
                        set frameBox to the item at cursor in (framedList's values)
                        if ((mullionAlong + half) > frameBox's fromAlong) and ((mullionAlong - half) < frameBox's untilAlong):
                            append (a cad vector2 with x (frameBox's bottom + half) and y (frameBox's top - half)) to (gaps's values)
                if contoured:
                    set inside to the bim inside runs of contour at (the maximum of 0.001 and (the minimum of (wallLength - 0.001) and mullionAlong)) lying false from 0.0 until curtainValue's height
                    append bim gaps between (inside's values) from 0.0 until curtainValue's height into (gaps's values)
                set runs to the bim pieces of 0.0 until curtainValue's height outside (gaps's values)
                loop runCursor from 0 to the length of (runs's values):
                    set run to the item at runCursor in (runs's values)
                    append (@intrinsic("construct", a bim stair part record, the bim system member of curtainValue at mullionAlong from (the maximum of 0.0 and run's x) until run's y level false in modelValue, mullionType)) to (derived's values)
        loop rowCursor from 0 to (rows + 1):
            set ownRow to (diamond = false) or ((rowCursor = 0) or (rowCursor = rows))
            if (jointed and ownRow) and (bim system line (1000 + rowCursor) of curtainValue's id is pinned in modelValue):
                set transomHeight to the bim transom rowCursor along curtainValue in modelValue
                set gaps to a cad topology list of a cad vector2
                if framing:
                    loop cursor from 0 to the length of (framedList's values):
                        set frameBox to the item at cursor in (framedList's values)
                        if ((transomHeight + half) > frameBox's bottom) and ((transomHeight - half) < frameBox's top):
                            append (a cad vector2 with x (frameBox's fromAlong + half) and y (frameBox's untilAlong - half)) to (gaps's values)
                if contoured:
                    set inside to the bim inside runs of contour at (the maximum of 0.001 and (the minimum of (curtainValue's height - 0.001) and transomHeight)) lying true from 0.0 until wallLength
                    append bim gaps between (inside's values) from 0.0 until wallLength into (gaps's values)
                # Where the line curves, a transom is straight from mullion to
                # mullion.
                if curving:
                    loop bayCursor from 1 to bays:
                        set mullionAlong to the bim mullion bayCursor along curtainValue in modelValue
                        append (a cad vector2 with x mullionAlong and y mullionAlong) to (gaps's values)
                set runs to the bim pieces of 0.0 until wallLength outside (gaps's values)
                loop runCursor from 0 to the length of (runs's values):
                    set run to the item at runCursor in (runs's values)
                    append (@intrinsic("construct", a bim stair part record, the bim system member of curtainValue at transomHeight from run's x until run's y level true in modelValue, transomType)) to (derived's values)
        if contoured and jointed:
            append bim contour frame of curtainValue along contour bays bays rows rows upright mullionType level transomType in modelValue into (derived's values)
        # The frames: jambs from the sill (or the foot) to the head, a head
        # and, off the foot, a sill, each on the frame's middle.
        if framing:
            loop cursor from 0 to the length of (framedList's values):
                set frameBox to the item at cursor in (framedList's values)
                set jambFoot to the maximum of 0.0 and (frameBox's bottom + half)
                set headHeight to frameBox's top - half
                append (@intrinsic("construct", a bim stair part record, the bim system member of curtainValue at (frameBox's fromAlong + half) from jambFoot until headHeight level false in modelValue, mullionType)) to (derived's values)
                append (@intrinsic("construct", a bim stair part record, the bim system member of curtainValue at (frameBox's untilAlong - half) from jambFoot until headHeight level false in modelValue, mullionType)) to (derived's values)
                append (@intrinsic("construct", a bim stair part record, the bim system member of curtainValue at headHeight from (frameBox's fromAlong + half) until (frameBox's untilAlong - half) level true in modelValue, transomType)) to (derived's values)
                if frameBox's bottom >= 0.0:
                    append (@intrinsic("construct", a bim stair part record, the bim system member of curtainValue at (frameBox's bottom + half) from (frameBox's fromAlong + half) until (frameBox's untilAlong - half) level true in modelValue, transomType)) to (derived's values)
        # The panels between the frame; a nested system fills its panel
        # instead. Framing cuts them around each frame; replacing leaves out
        # those an opening touches.
        # A running bond's cells follow each row's joints, all of the
        # system's panel type.
        if bonded and celled:
            loop rowCursor from 0 to rows:
                set rowJoints to the bim joints of row rowCursor of curtainValue patterned patternCode in modelValue
                set cellFoot to (the bim transom rowCursor along curtainValue in modelValue) + half
                set cellHead to (the bim transom (rowCursor + 1) along curtainValue in modelValue) - half
                loop jointCursor from 0 to ((the length of (rowJoints's values)) - 1):
                    set cellArea to @intrinsic("construct", a bim face rectangle record, (the item at jointCursor in (rowJoints's values)) + half, (the item at (jointCursor + 1) in (rowJoints's values)) - half, cellFoot, cellHead)
                    set cellAreas to a cad topology list of a bim face rectangle record
                    if framing:
                        set cellAreas to the bim areas of cellArea outside rectangles (framedList's values)
                    else:
                        append cellArea to (cellAreas's values)
                    loop areaCursor from 0 to the length of (cellAreas's values):
                        append bim panel of curtainValue typed (the bim panel type of panel -1 of system curtainValue's id in modelValue) over (the item at areaCursor in (cellAreas's values)) in modelValue into (derived's values)
        # A diamond pattern: its diagonals and its whole diamonds.
        if diamond:
            append bim diamond parts of curtainValue spaced curtainValue's bayWidth over wallLength by curtainValue's height joints jointed of mullionType cells celled typed (the bim panel type of panel -1 of system curtainValue's id in modelValue) in modelValue into (derived's values)
        if ((bonded = false) and (diamond = false)) and celled:
            loop bayCursor from 0 to bays:
                set bayStart to (the bim mullion bayCursor along curtainValue in modelValue) + half
                set bayFinish to (the bim mullion (bayCursor + 1) along curtainValue in modelValue) - half
                loop rowCursor from 0 to rows:
                    set panelIndex to (bayCursor * rows) + rowCursor
                    if ((the bim system nested in panel panelIndex of curtainValue's id in modelValue) = the bim refused id) and (bim system line (2000 + panelIndex) of curtainValue's id is pinned in modelValue):
                        set panelArea to @intrinsic("construct", a bim face rectangle record, bayStart, bayFinish, (the bim transom rowCursor along curtainValue in modelValue) + half, (the bim transom (rowCursor + 1) along curtainValue in modelValue) - half)
                        # Outside the contour the panel goes; across it, it
                        # is cut (`the bim contour panels of`).
                        set panelCover to 1
                        if contoured:
                            set panelCover to the bim cover of contour over panelArea
                        set panelTypeId to the bim panel type of panel panelIndex of system curtainValue's id in modelValue
                        set areas to a cad topology list of a bim face rectangle record
                        if framing:
                            set areas to the bim areas of panelArea outside rectangles (framedList's values)
                        else:
                            set touched to false
                            loop cursor from 0 to the length of (roughList's values):
                                set roughBox to the item at cursor in (roughList's values)
                                if ((roughBox's untilAlong > panelArea's fromAlong) and (roughBox's fromAlong < panelArea's untilAlong)) and ((roughBox's top > panelArea's bottom) and (roughBox's bottom < panelArea's top)):
                                    set touched to true
                            if touched = false:
                                append panelArea to (areas's values)
                        if panelCover = 1:
                            loop areaCursor from 0 to the length of (areas's values):
                                append bim panel of curtainValue typed panelTypeId over (the item at areaCursor in (areas's values)) in modelValue into (derived's values)
        # Point objects (wall ties, hangers) at every node of the grid, as
        # short round rods: across the face upright, upward lying level.
        set pointLength to ((the bim setting (bim system points setting) of curtainValue's id in modelValue)'s value as a 64 bit floating-point number) / 1000.0
        if (the absolute value of pointLength) > 0.0005:
            set sizeReading to the bim setting (bim system point size setting) of curtainValue's id in modelValue
            set pointSize to 0.006
            if sizeReading's found:
                set pointSize to (sizeReading's value as a 64 bit floating-point number) / 1000.0
            set pointType to @intrinsic("construct", a bim linear type record, the bim refused id, the string form of "Point", bim generic linear role, pointSize, pointSize, true, the string form of "steel")
            set flatSystem to bim system curtainValue's id lies level in modelValue
            loop bayCursor from 0 to (bays + 1):
                set nodeAlong to the bim mullion bayCursor along curtainValue in modelValue
                set nodeHeading to the bim system heading at nodeAlong of curtainValue
                loop rowCursor from 0 to (rows + 1):
                    set nodeFoot to the bim face point of curtainValue at nodeAlong up (the bim transom rowCursor along curtainValue in modelValue) in modelValue
                    set nodeTip to a cad vector3 with x (nodeFoot's x + (pointLength * (the sine of nodeHeading))), y (nodeFoot's y - (pointLength * (the cosine of nodeHeading))) and z nodeFoot's z
                    if flatSystem:
                        set nodeTip to a cad vector3 with x nodeFoot's x, y nodeFoot's y and z (nodeFoot's z + pointLength)
                    set pointRod to @intrinsic("construct", a bim linear record, curtainValue's id, the bim refused id, curtainValue's levelId, nodeFoot, nodeTip, 0.0, 0.0, (a cad vector2 with x 1.0 and y 1.0))
                    append (@intrinsic("construct", a bim stair part record, pointRod, pointType)) to (derived's values)
        if placement's lift != 0.0:
            loop cursor from 0 to the length of (derived's values):
                set lifted to the item at cursor in (derived's values)
                set raised to lifted's element
                set raised's start to a cad vector3 with x raised's start's x, y raised's start's y and z (raised's start's z + placement's lift)
                set raised's finish to a cad vector3 with x raised's finish's x, y raised's finish's y and z (raised's finish's z + placement's lift)
                set lifted's element to raised
                replace item at index cursor in (derived's values) with lifted
        return derived

# ---------------------------------------------------------------- building system examples

# The planar type named `typeName`, one layer of `materialName`
# `thickness` metres thick: found, or added.
function the bim example type named {a string:typeName} of {a string:materialName} {a 64 bit floating-point number:thickness} in {a pointer to a bim model record:target}:
    execute:
        loop cursor from 0 to the length of (target's wallTypes's values):
            set candidate to the item at cursor in (target's wallTypes's values)
            if candidate's name = typeName:
                return candidate's id
        set exampleLayers to an empty list of a bim layer record
        append (@intrinsic("construct", a bim layer record, materialName, thickness)) to exampleLayers
        set made to add bim wall type named typeName with exampleLayers to target
        free exampleLayers
        return made

# Settings of building system `systemId` in one go: its pattern, its joints'
# width and depth (millimetres, 0 wide for none), whether it has cells, and
# its panels' type.
function shape bim example system {a 64 bit integer:systemId} patterned {integer:patternCode} joints {integer:jointWide} by {integer:jointDeep} celled {boolean:withCells} of type {a 64 bit integer:panelTypeId} in {a pointer to a bim model record:target}:
    execute:
        set bim setting (bim system pattern setting) of systemId to (patternCode as a 64 bit integer) keeping (patternCode != bim grid pattern) in target
        set bim setting (bim joint width setting) of systemId to (jointWide as a 64 bit integer) keeping true in target
        set bim setting (bim joint depth setting) of systemId to (jointDeep as a 64 bit integer) keeping true in target
        set bim setting (bim system cells setting) of systemId to (1 as a 64 bit integer) keeping (withCells = false) in target
        if panelTypeId != the bim refused id:
            set bim panel -1 of system systemId to type panelTypeId in target

# Building system `systemId` divided in bays of at most `bayValue` and rows
# of at most `rowValue` metres.
function grid bim example system {a 64 bit integer:systemId} in bays of {a 64 bit floating-point number:bayValue} by {a 64 bit floating-point number:rowValue} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim curtain index of systemId in (@intrinsic("dereference", target))
        if found's valid:
            set gridded to the item at found's position in (target's curtains's values)
            set gridded's bayWidth to bayValue
            set gridded's rowHeight to rowValue
            replace item at index found's position in (target's curtains's values) with gridded

# Point objects of `systemId`: rods `lengthMillimetres` long (across its face,
# or up when it lies level) and `sizeMillimetres` thick at its grid's nodes.
function give bim example system {a 64 bit integer:systemId} points {integer:lengthMillimetres} thick {integer:sizeMillimetres} in {a pointer to a bim model record:target}:
    execute:
        set bim setting (bim system points setting) of systemId to (lengthMillimetres as a 64 bit integer) keeping true in target
        set bim setting (bim system point size setting) of systemId to (sizeMillimetres as a 64 bit integer) keeping true in target

# The building system examples, side by side from `origin` on storey
# `levelId`: a timber-frame wall (studs 38 x 140 at 600 with insulation
# between, plywood outside, plasterboard inside), a hollow-core floor of
# 1200 mm planks 3 m up, a suspended ceiling of 600 mm tiles in T-bars with
# hangers at 1200, and half-brick masonry with wall ties. The ids made.
function add bim system examples at {cad vector2:origin} on {a 64 bit integer:levelId} in {a pointer to a bim model record:target}:
    execute:
        set made to a cad topology list of a 64 bit integer
        set insulation to the bim example type named (the string form of "Isolatie 140") of (the string form of "mineral wool") 0.14 in target
        set plywood to the bim example type named (the string form of "Multiplex 18") of (the string form of "plywood") 0.018 in target
        set plaster to the bim example type named (the string form of "Gipsplaat 12.5") of (the string form of "gypsum") 0.0125 in target
        set plank to the bim example type named (the string form of "Kanaalplaat 200") of (the string form of "concrete") 0.2 in target
        set tile to the bim example type named (the string form of "Plafondplaat 15") of (the string form of "mineral fibre") 0.015 in target
        set brick to the bim example type named (the string form of "Baksteen 100") of (the string form of "brick") 0.1 in target
        # Timber frame: studs with insulation, then the boards as layers.
        set frameId to add bim curtain wall on levelId from origin to (a cad vector2 with x (origin's x + 3.6) and y origin's y) rising 2.7 in bays of 0.6 by 2.7 of (the string form of "timber") to target
        shape bim example system frameId patterned (bim grid pattern) joints 38 by 140 celled true of type insulation in target
        append frameId to (made's values)
        set outsideBoard to add bim layer to system frameId offset (79 as a 64 bit integer) in target
        shape bim example system outsideBoard patterned (bim grid pattern) joints 0 by 18 celled true of type plywood in target
        grid bim example system outsideBoard in bays of 1.2 by 2.7 in target
        append outsideBoard to (made's values)
        set insideBoard to add bim layer to system frameId offset (-76 as a 64 bit integer) in target
        shape bim example system insideBoard patterned (bim grid pattern) joints 0 by 13 celled true of type plaster in target
        grid bim example system insideBoard in bays of 1.2 by 2.7 in target
        append insideBoard to (made's values)
        # Hollow-core floor: 1200 mm planks spanning 6 m, 20 mm joints, 3 m up.
        set floorId to add bim curtain wall on levelId from (a cad vector2 with x (origin's x + 5.0) and y origin's y) to (a cad vector2 with x (origin's x + 11.0) and y origin's y) rising 6.0 in bays of 1.2 by 6.0 of (the string form of "grout") to target
        set bim setting (bim system level setting) of floorId to (3000 as a 64 bit integer) keeping true in target
        shape bim example system floorId patterned (bim grid pattern) joints 20 by 200 celled true of type plank in target
        append floorId to (made's values)
        # Suspended ceiling: 600 mm tiles in T-bars 2.6 m up, hangers at 1200.
        set ceilingId to add bim curtain wall on levelId from (a cad vector2 with x (origin's x + 12.0) and y origin's y) to (a cad vector2 with x (origin's x + 15.6) and y origin's y) rising 3.6 in bays of 0.6 by 0.6 of (the string form of "steel") to target
        set bim setting (bim system level setting) of ceilingId to (2600 as a 64 bit integer) keeping true in target
        shape bim example system ceilingId patterned (bim grid pattern) joints 24 by 38 celled true of type tile in target
        append ceilingId to (made's values)
        set hangers to add bim layer to system ceilingId offset (0 as a 64 bit integer) in target
        grid bim example system hangers in bays of 1.2 by 1.2 in target
        shape bim example system hangers patterned (bim grid pattern) joints 0 by 0 celled false of type (the bim refused id) in target
        give bim example system hangers points 400 thick 4 in target
        append hangers to (made's values)
        # Half-brick masonry, 2.4 x 1.25 m, with wall ties into the cavity.
        set brickId to add bim curtain wall on levelId from (a cad vector2 with x (origin's x + 17.0) and y origin's y) to (a cad vector2 with x (origin's x + 19.4) and y origin's y) rising 1.25 in bays of 0.22 by 0.0625 of (the string form of "mortar") to target
        shape bim example system brickId patterned (bim running bond pattern) joints 10 by 100 celled true of type brick in target
        append brickId to (made's values)
        set ties to add bim layer to system brickId offset (-50 as a 64 bit integer) in target
        grid bim example system ties in bays of 0.6 by 0.45 in target
        shape bim example system ties patterned (bim grid pattern) joints 0 by 0 celled false of type (the bim refused id) in target
        give bim example system ties points -150 thick 4 in target
        append ties to (made's values)
        return made

# A building system's name: its bays and rows (at most, in millimetres) and
# its frame's material, as "Building system 1200 x 1500 aluminium".
function the bim system name of {bim curtain record:systemValue}:
    execute:
        set bayMillimetres to ((systemValue's bayWidth * 1000.0) + 0.5) as an integer
        set rowMillimetres to ((systemValue's rowHeight * 1000.0) + 0.5) as an integer
        set text to (the string form of "Building system ") + ((the string form of bayMillimetres) + ((the string form of " x ") + (the string form of rowMillimetres)))
        return (text + (the string form of " ")) + systemValue's material
