# A sheet recording depends on its placement, framebuffer and view visibility.
import examples/bim-slice/bim_file.dl

function the bim sheet recording key at revision {a 64 bit integer:revision} for {a 64 bit integer:sheetId} density {a 64 bit floating-point number:density} at {cad vector2:corner} sized {integer:width} by {integer:height} hiding {a string:visibilityKey}:
    execute:
        set written to ((the string form of revision) + (the string form of " sheet ")) + (the string form of sheetId)
        set written to (written + (the string form of " density ")) + (the bim exact text of density)
        set written to (written + (the string form of " x ")) + (the bim exact text of corner's x)
        set written to (written + (the string form of " y ")) + (the bim exact text of corner's y)
        set written to (written + (the string form of " frame ")) + (the string form of width)
        set written to (written + (the string form of "x")) + (the string form of height)
        return (written + (the string form of " hidden ")) + visibilityKey
