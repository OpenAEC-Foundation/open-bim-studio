# SPDX-License-Identifier: MPL-2.0
# Reviewable bending schedule, generated from the same paths as the model.
import examples/bim-slice/bim_reinforcement_schedule.dl

function the bim bending cell of {a string:valueText}:
    execute:
        return (((valueText with "&" replaced by "&amp;") with "<" replaced by "&lt;") with ">" replaced by "&gt;") with "\"" replaced by "&quot;"

function the bim reinforcing mass of {bim reinforcing schedule row:rowValue}:
    execute:
        return (the bim reinforcing total length of rowValue) * (((rowValue's diameter * rowValue's diameter) * 0.7853981633974483) * 7850.0)

# Orthogonal centreline preview using the two widest coordinate spans.
function the bim bending preview of {bim reinforcing schedule row:rowValue} in {bim model record:modelValue}:
    execute:
        set found to the bim reinforcement index of rowValue's ownerId in modelValue
        if found's valid = false:
            return the string form of ""
        set spec to the bim hostbound reinforcement (the item at found's position in (modelValue's reinforcements's values)) in modelValue
        set generated to the reinforcement of spec
        loop barIndex from 0 to the length of (generated's bars's values):
            set barValue to the item at barIndex in (generated's bars's values)
            if ((barValue's mark = rowValue's mark) and (barValue's diameter = rowValue's diameter)) and (barValue's length = rowValue's length):
                set points to barValue's points's values
                if (the length of points) < 2:
                    return the string form of ""
                set low to the item at 0 in points
                set high to low
                loop cursor from 1 to the length of points:
                    set pointValue to the item at cursor in points
                    set low's x to the minimum of low's x and pointValue's x
                    set low's y to the minimum of low's y and pointValue's y
                    set low's z to the minimum of low's z and pointValue's z
                    set high's x to the maximum of high's x and pointValue's x
                    set high's y to the maximum of high's y and pointValue's y
                    set high's z to the maximum of high's z and pointValue's z
                set span to the cad difference of high and low
                set mode to 0
                if span's z > span's y:
                    set mode to 1
                if (span's x < span's y) and (span's x < span's z):
                    set mode to 2
                set widthValue to span's x
                set heightValue to span's y
                if mode = 1:
                    set heightValue to span's z
                if mode = 2:
                    set widthValue to span's y
                    set heightValue to span's z
                set scaleValue to the minimum of (160.0 / (the maximum of widthValue and 0.001)) and (64.0 / (the maximum of heightValue and 0.001))
                set coordinates to an empty list of a string
                loop cursor from 0 to the length of points:
                    set pointValue to the cad difference of (the item at cursor in points) and low
                    set xValue to pointValue's x
                    set yValue to pointValue's y
                    if mode = 1:
                        set yValue to pointValue's z
                    if mode = 2:
                        set xValue to pointValue's y
                        set yValue to pointValue's z
                    append ((the string form of (10.0 + xValue * scaleValue)) + ((the string form of ",") + (the string form of (74.0 - yValue * scaleValue)))) to coordinates
                set resultText to (the string form of "<svg viewBox='0 0 180 84' width='180' height='84'><polyline fill='none' stroke='#194d6b' stroke-width='2' points='") + ((coordinates joined with " ") + (the string form of "'/></svg>"))
                free coordinates
                set dimensions to ((the string form of (the reinforcement millimetres of span's x)) + (the string form of " × ")) + ((the string form of (the reinforcement millimetres of span's y)) + ((the string form of " × ") + (the string form of (the reinforcement millimetres of span's z))))
                return resultText + ((the string form of "<small>Envelope XYZ: ") + (dimensions + (the string form of " mm</small>")))
        return the string form of ""

function the bim bending html of {bim model record:modelValue}:
    execute:
        set scheduled to the bim reinforcing schedule of modelValue
        if scheduled's valid = false:
            return (the string form of "<p>Cannot generate schedule: ") + ((the bim bending cell of scheduled's message) + (the string form of "</p>"))
        set lines to an empty list of a string
        append (the string form of "<!doctype html><html lang='en'><meta charset='utf-8'><title>Open BIM Studio — bending schedule</title><style>body{font:14px system-ui;margin:32px;color:#183342}table{border-collapse:collapse;width:100%}th,td{padding:8px;border:1px solid #ccd5da;text-align:left}th{background:#e9f0f4}small{display:block}tr{break-inside:avoid}@media print{body{margin:0;font-size:10px}thead{display:table-header-group}}svg{display:block}</style><h1>Reinforcement bending schedule</h1><p>Model centreline lengths; nominal mass at 7850 kg/m³. Shape codes remain unverified. Preview dimensions are coordinate envelopes, not fabrication leg dimensions. Closed hoops have no closing hooks. No automatic lap or anchorage allowance.</p><table><thead><tr><th>Owner / mark</th><th>Qty</th><th>Ø mm</th><th>Shape / preview</th><th>Length mm</th><th>Total m</th><th>Mass kg</th><th>Steel</th></tr></thead><tbody>") to lines
        set totalMass to 0.0
        loop rowIndex from 0 to the length of (scheduled's rows's values):
            set rowValue to the item at rowIndex in (scheduled's rows's values)
            set rowText to (the string form of "<tr><td>") + ((the string form of rowValue's ownerId) + ((the string form of " / ") + (the bim bending cell of rowValue's mark)))
            set rowText to rowText + ((the string form of "</td><td>") + (the string form of rowValue's count))
            set rowText to rowText + ((the string form of "</td><td>") + (the string form of (the reinforcement millimetres of rowValue's diameter)))
            set rowText to rowText + ((the string form of "</td><td>") + ((the bim bending cell of rowValue's shape) + (the bim bending preview of rowValue in modelValue)))
            set rowText to rowText + ((the string form of "</td><td>") + (the string form of (the reinforcement millimetres of rowValue's length)))
            set rowText to rowText + ((the string form of "</td><td>") + (the string form of (the bim reinforcing total length of rowValue)))
            set rowText to rowText + ((the string form of "</td><td>") + (the string form of (the bim reinforcing mass of rowValue)))
            set rowText to rowText + ((the string form of "</td><td>") + ((the bim bending cell of rowValue's steel) + (the string form of "</td></tr>")))
            append rowText to lines
            set totalMass to totalMass + (the bim reinforcing mass of rowValue)
        append ((the string form of "</tbody></table><p>Total mass: ") + ((the string form of totalMass) + (the string form of " kg</p></html>"))) to lines
        set resultText to lines joined with "\n"
        free lines
        return resultText
