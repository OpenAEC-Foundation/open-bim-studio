            set sideRay to the bim view ray through pixel in viewLayout with camera
            set sideHit to the bim pick along sideRay among (shownMeshes's values) in editor's documentValue's current with (editor's spaces's values)
            if sideHit's kind = bim sketch picked:
                set hitZ to sideRay's origin's z + (sideHit's distance * sideRay's direction's z)
                set hitPoint to a cad vector2 with x (sideRay's origin's x + (sideHit's distance * sideRay's direction's x)) and y (sideRay's origin's y + (sideHit's distance * sideRay's direction's y))
                set massFound to the bim sketch index of sideHit's id in editor's documentValue's current
                if massFound's valid:
                    set massElement to the item at massFound's position in (editor's documentValue's current's sketches's values)
                    set floorZ to the bim storey elevation of editor
                    if ((massElement's height > 0.0) and (hitZ > (floorZ + 0.001))) and (hitZ < ((floorZ + massElement's height) - 0.001)):
                        set ring to massElement's points's values
                        set nearestEdge to 0
                        set nearestGap to 1.0 / 0.0
                        loop edgeCursor from 0 to the length of ring:
                            set gap to the cad distance from hitPoint to the segment from (the item at edgeCursor in ring) to (the item at (the remainder of (edgeCursor + 1) divided by (the length of ring)) in ring)
                            if gap < nearestGap:
                                set nearestGap to gap
                                set nearestEdge to edgeCursor
                        set editor's pushEdge to nearestEdge
                        set pushPlaneZ to hitZ
                        move bim editor pointer to hitPoint within 0.0001 in (the address of editor)
        if clickHandled = false:
            press bim editor pointer in (the address of editor)
    set overSection to ((pixel's x > layout's planRight) and ((pixel's y > lowerLayout's top) and (pixel's y < lowerLayout's bottom))) and (showSection and editor's hasSection)
    if ((leftDown and (previousLeft = false)) and overSection) and (panelClicked = false):
        # A handle of the selection under the pointer starts a drag; else
        # the press picks.
        set sectionFit to the bim section fit of editor in lowerLayout
        set grabbed to false
        if sectionFit's valid:
            set sectionGrips to the bim section handles of editor
            loop gripCursor from 0 to the length of sectionGrips:
                set sectionGrip to the item at gripCursor in sectionGrips
                set sectionGripPixel to the bim pixel of sectionGrip's spot through sectionFit's transform
                if (grabbed = false) and ((the cad distance from sectionGripPixel to pixel) <= 8.0):
                    set grabbed to true
                    set sectionDragKind to sectionGrip's kind
                    set sectionDragId to sectionGrip's elementId
                    set sectionDragY to pixel's y
                    set sectionDragX to pixel's x
            free sectionGrips
        if ((grabbed = false) and (editor's tool = bim align tool)) and sectionFit's valid:
            # AL in the section: the first click takes a height (a level, or
