                    set floorZ to the bim storey elevation of editor
                    if ((massElement's height > 0.0) and (hitZ > (floorZ + 0.001))) and (hitZ < ((floorZ + massElement's height) - 0.001)):
                        set ring to massElement's points's values
                        set nearestEdge to 0
                        set nearestGap to 1.0 / 0.0
                        loop edgeCursor from 0 to the length of ring:
                            set gap to the cad distance from hitPoint to the segment from (the item at edgeCursor in ring) to (the item at (the remainder of (edgeCursor + 1) divided by (the length of ring)) in ring)
                            if gap < nearestGap:
                                set nearestGap to gap
                                set nearestEdge to edgeCursor
                        set editor's pushEdge to nearestEdge
                        set pushPlaneZ to hitZ
                        move bim editor pointer to hitPoint within 0.0001 in (the address of editor)
        if clickHandled = false:
            press bim editor pointer in (the address of editor)
    set overSection to ((pixel's x > layout's planRight) and ((pixel's y > lowerLayout's top) and (pixel's y < lowerLayout's bottom))) and (showSection and editor's hasSection)
    if ((leftDown and (previousLeft = false)) and overSection) and (panelClicked = false):
        # A handle of the selection under the pointer starts a drag; else
        # the press picks.
        set sectionFit to the bim section fit of editor in lowerLayout
        set grabbed to false
        if sectionFit's valid:
            set sectionGrips to the bim section handles of editor
            loop gripCursor from 0 to the length of sectionGrips:
                set sectionGrip to the item at gripCursor in sectionGrips
                set sectionGripPixel to the bim pixel of sectionGrip's spot through sectionFit's transform
                if (grabbed = false) and ((the cad distance from sectionGripPixel to pixel) <= 8.0):
                    set grabbed to true
                    set sectionDragKind to sectionGrip's kind
                    set sectionDragId to sectionGrip's elementId
                    set sectionDragY to pixel's y
                    set sectionDragX to pixel's x
            free sectionGrips
        if ((grabbed = false) and (editor's tool = bim align tool)) and sectionFit's valid:
            # AL in the section: the first click takes a height (a level, or
            # a top or underside it snaps to), the next a level moves there.
            set alignSnap to the bim section snap at pixel's y through sectionFit's transform for editor leaving out (the bim refused id)
            if sectionAlignSet = false:
                set sectionAlignHeight to alignSnap's height
                set sectionAlignSet to true
                set editor's message to (the string form of "Align: now click the level to bring to ") + (the bim length alignSnap's height in units editor's lengthUnit)
            else:
                pick bim section element of editor at pixel in lowerLayout
                if editor's selectionKind = bim level picked:
                    set editor's propertyCode to -1
                    align bim editor level editor's selectionId to height sectionAlignHeight in (the address of editor)
                else:
                    set editor's message to the string form of "Align: click a level's line or label"
            set grabbed to true
        if editor's tool != bim align tool:
            set sectionAlignSet to false
        if grabbed = false:
            pick bim section element of editor at pixel in lowerLayout
    if (sectionDragKind > 0) and leftDown:
        set sectionDragY to pixel's y
        set sectionDragX to pixel's x
    if (sectionDragKind > 0) and (leftDown = false):
        set sectionFit to the bim section fit of editor in lowerLayout
        if sectionFit's valid:
            if bim section handle sectionDragKind slides:
                apply bim section handle sectionDragKind of sectionDragId at (the bim section distance at sectionDragX through sectionFit's transform) on (the bim refused id) in (the address of editor)
            else:
                apply bim section handle sectionDragKind of sectionDragId at (the bim section snap at sectionDragY through sectionFit's transform for editor leaving out sectionDragId)'s height on (the bim section snap at sectionDragY through sectionFit's transform for editor leaving out sectionDragId)'s levelId in (the address of editor)
        set sectionDragKind to 0
    # A selected level: a press on a handle of its extent drags those sides
    # across its plane; every level locked to the shared extent follows.
    if ((leftDown and (previousLeft = false)) and (overView and (drawingInView = false))) and (panelClicked = false):
        set levelGrip to the bim level grip at pixel of editor around gpuScene in viewLayout with camera
        if levelGrip >= 0:
            set panelClicked to true
            set levelDragSides to the bim sides moved by level handle levelGrip
            set levelDragId to editor's selectionId
            begin bim transaction in (the address of (editor's documentValue))
    if (levelDragSides > 0) and leftDown:
        set levelFound to the bim level index of levelDragId in editor's documentValue's current
        if levelFound's valid:
            set draggedLevel to the item at levelFound's position in (editor's documentValue's current's levels's values)
            set levelSpot to the bim plane hit of (the bim view ray through pixel in viewLayout with camera) at height draggedLevel's elevation
            set shownLevelExtent to the bim level extent of levelDragId in editor's documentValue's current around (the bim automatic level extent around gpuScene)
            set movedLevelExtent to the bim level extent shownLevelExtent with sides levelDragSides at levelSpot
            ignore (set bim level extent of levelDragId from movedLevelExtent's low to movedLevelExtent's high in (the address of (editor's documentValue's current)))
        set panelClicked to true
    if (levelDragSides > 0) and (leftDown = false):
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to the string form of "Level extent changed"
        set levelDragSides to 0
    # The section box: a press on a face's handle drags that face along its
    # axis (in centimetres), the box keeping at least 10 cm deep.
    if (sectionBoxOn and (leftDown and (previousLeft = false))) and ((overView and (drawingInView = false)) and (panelClicked = false)):
        set pressedFace to the bim box face at pixel from sectionBoxLow to sectionBoxHigh in viewLayout with camera
        if pressedFace >= 0:
            set panelClicked to true
            set boxDragFace to pressedFace
            set boxDragPixel to pixel
            set faceCentre to the bim box face centre pressedFace from sectionBoxLow to sectionBoxHigh
            set faceNormal to the bim box face normal pressedFace
            set boxDragValue to the bim coordinate (pressedFace / 2) of faceCentre
            set fromPixel to the bim view point (faceCentre's x) (faceCentre's y) (faceCentre's z) in viewLayout with camera
            set toPixel to the bim view point (faceCentre's x + faceNormal's x) (faceCentre's y + faceNormal's y) (faceCentre's z + faceNormal's z) in viewLayout with camera
            set faceRun to the cad distance from fromPixel to toPixel
            if faceRun > 1e-6:
                set boxDragDirection to a cad vector2 with x ((toPixel's x - fromPixel's x) / faceRun) and y ((toPixel's y - fromPixel's y) / faceRun)
                set boxDragScale to faceRun
    if (boxDragFace >= 0) and leftDown:
        set movedPixels to ((pixel's x - boxDragPixel's x) * boxDragDirection's x) + ((pixel's y - boxDragPixel's y) * boxDragDirection's y)
        set faceSign to 1.0
        if (the remainder of boxDragFace divided by 2) = 0:
            set faceSign to -1.0
        set faceValue to (the floor of (((boxDragValue + ((faceSign * movedPixels) / boxDragScale)) * 100.0) + 0.5)) / 100.0
        set faceAxis to boxDragFace / 2
        if (the remainder of boxDragFace divided by 2) = 0:
            set faceValue to the minimum of faceValue and ((the bim coordinate faceAxis of sectionBoxHigh) - 0.1)
            if faceAxis = 0:
                set sectionBoxLow to a cad vector3 with x faceValue, y sectionBoxLow's y and z sectionBoxLow's z
            else if faceAxis = 1:
                set sectionBoxLow to a cad vector3 with x sectionBoxLow's x, y faceValue and z sectionBoxLow's z
            else:
                set sectionBoxLow to a cad vector3 with x sectionBoxLow's x, y sectionBoxLow's y and z faceValue
        else:
            set faceValue to the maximum of faceValue and ((the bim coordinate faceAxis of sectionBoxLow) + 0.1)
            if faceAxis = 0:
                set sectionBoxHigh to a cad vector3 with x faceValue, y sectionBoxHigh's y and z sectionBoxHigh's z
            else if faceAxis = 1:
                set sectionBoxHigh to a cad vector3 with x sectionBoxHigh's x, y faceValue and z sectionBoxHigh's z
            else:
                set sectionBoxHigh to a cad vector3 with x sectionBoxHigh's x, y sectionBoxHigh's y and z faceValue
    if (boxDragFace >= 0) and (leftDown = false):
        set boxDragFace to -1
    # The gizmo: a press on an arrow drags the selection along X, Y or Z, on
    # its square across the plane (in 10 mm steps), on its ring turns it
    # about its middle (in whole degrees).
    if ((leftDown and (previousLeft = false)) and (overView and (drawingInView = false))) and ((panelClicked = false) and ((editor's tool = bim select tool) and (editor's editMode = false))):
        set pressCentre to the bim selection centre of editor
        if pressCentre's found:
            set pressHeight to pressCentre's point's z + (the bim storey elevation of editor)
            set pressGizmo to the bim gizmo at (a cad vector3 with x pressCentre's point's x, y pressCentre's point's y and z pressHeight) in viewLayout with camera
            set pressHandle to the bim gizmo handle of pressGizmo at pixel
            if pressHandle > 0:
                set gizmoAxis to pressHandle
                set gizmoHeight to pressHeight
                set gizmoPivot to a cad vector2 with x pressCentre's point's x and y pressCentre's point's y
                set gizmoStart to the bim plane hit of (the bim view ray through pixel in viewLayout with camera) at height pressHeight
                set gizmoPressPixel to pixel
                set riseRun to the cad distance from pressGizmo's middle to pressGizmo's zTip
                if riseRun > 1.0:
                    set gizmoRiseDirection to a cad vector2 with x ((pressGizmo's zTip's x - pressGizmo's middle's x) / riseRun) and y ((pressGizmo's zTip's y - pressGizmo's middle's y) / riseRun)
                    set gizmoRiseScale to riseRun / (70.0 / camera's viewScale)
                begin bim editor gizmo drag in (the address of editor)
                set panelClicked to true
    if (gizmoAxis > 0) and leftDown:
        set gizmoNow to the bim plane hit of (the bim view ray through pixel in viewLayout with camera) at height gizmoHeight
        set stepX to (the floor of (((gizmoNow's x - gizmoStart's x) * 100.0) + 0.5)) / 100.0
        set stepY to (the floor of (((gizmoNow's y - gizmoStart's y) * 100.0) + 0.5)) / 100.0
        if gizmoAxis = bim gizmo x handle:
            drag bim editor gizmo by (a cad vector2 with x stepX and y 0.0) lifting 0.0 turning 0.0 about gizmoPivot in (the address of editor)
        if gizmoAxis = bim gizmo y handle:
            drag bim editor gizmo by (a cad vector2 with x 0.0 and y stepY) lifting 0.0 turning 0.0 about gizmoPivot in (the address of editor)
        if gizmoAxis = bim gizmo plane handle:
            drag bim editor gizmo by (a cad vector2 with x stepX and y stepY) lifting 0.0 turning 0.0 about gizmoPivot in (the address of editor)
        if gizmoAxis = bim gizmo z handle:
            set risePixels to ((pixel's x - gizmoPressPixel's x) * gizmoRiseDirection's x) + ((pixel's y - gizmoPressPixel's y) * gizmoRiseDirection's y)
            set stepZ to (the floor of (((risePixels / gizmoRiseScale) * 100.0) + 0.5)) / 100.0
            drag bim editor gizmo by (a cad vector2 with x 0.0 and y 0.0) lifting stepZ turning 0.0 about gizmoPivot in (the address of editor)
        if gizmoAxis = bim gizmo ring handle:
            set turnNow to @intrinsic("atan2", gizmoNow's y - gizmoPivot's y, gizmoNow's x - gizmoPivot's x)
            set turnStart to @intrinsic("atan2", gizmoStart's y - gizmoPivot's y, gizmoStart's x - gizmoPivot's x)
            set wholeDegrees to the floor of ((((turnNow - turnStart) * 180.0) / 3.141592653589793) + 0.5)
            if wholeDegrees != 0.0:
                drag bim editor gizmo by (a cad vector2 with x 0.0 and y 0.0) lifting 0.0 turning ((wholeDegrees * 3.141592653589793) / 180.0) about gizmoPivot in (the address of editor)
    if (gizmoAxis > 0) and (leftDown = false):
        finish bim editor gizmo drag in (the address of editor)
        set gizmoAxis to 0
    if ((leftDown and (previousLeft = false)) and (overView and (drawingInView = false))) and (panelClicked = false):
        # A handle of the selection drags it across its storey's plane;
        # elsewhere the press orbits or selects.
        set handles to the bim grips of editor
        set gripIndex to the bim grip near pixel among (handles's values) in viewLayout with camera
        if gripIndex >= 0:
            set gripElevation to (the item at gripIndex in (handles's values))'s location's z
            start bim editor drag of (the item at gripIndex in (handles's values)) in (the address of editor)
            set viewGripActive to true
        else:
            set viewPressActive to true
            set viewDragged to false
            set viewPressPixel to pixel
    if viewGripActive and leftDown:
        set ray to the bim view ray through pixel in viewLayout with camera
        if (the absolute value of ray's direction's z) > 1e-9:
            set reach to (gripElevation - ray's origin's z) / ray's direction's z
            set onPlane to a cad vector2 with x (ray's origin's x + (reach * ray's direction's x)) and y (ray's origin's y + (reach * ray's direction's y))
            move bim editor pointer to onPlane within (8.0 / camera's viewScale) in (the address of editor)
    set dx to (cursorPosition's x - previousCursor's x) as a 64 bit floating-point number
    set dy to (cursorPosition's y - previousCursor's y) as a 64 bit floating-point number
    set shiftHeld to (key 340 is down in window) or (key 344 is down in window)
    # The left button selects in the 3D view, as in the plan: a drag is a
    # selection box (orbit with the right button or Shift and the middle).
    if viewPressActive and leftDown:
        if (the cad distance from pixel to viewPressPixel) > 4.0:
            set viewDragged to true
    if planBoxActive and leftDown:
        if (the cad distance from pixel to planBoxPixel) > 4.0:
            set planBoxDragged to true
    if (leftDown = false) and previousLeft:
        if viewGripActive:
            release bim editor pointer in (the address of editor)
            set viewGripActive to false
        else if viewPressActive:
            if viewDragged and editor's editMode:
                # In edit mode the box picks the points inside it on screen.
                set editPoints to the bim edit points of editor
                set editPixels to an empty list of a cad vector2
                set editLift to the bim storey elevation of editor
                loop pointCursor from 0 to the length of (editPoints's values):
                    set editPoint to the item at pointCursor in (editPoints's values)
                    append (the bim view point (editPoint's x) (editPoint's y) (editPoint's z + editLift) in viewLayout with camera) to editPixels
                set editor's extending to shiftHeld
                pick bim editor points among editPixels in box from viewPressPixel to pixel in (the address of editor)
                set editor's extending to false
                free editPixels
            else if viewDragged:
                set boxOutlines to the bim selection outlines of editor in plan false
                loop outlineCursor from 0 to the length of boxOutlines:
                    set boxOutline to the item at outlineCursor in boxOutlines
                    loop edgeCursor from 0 to the length of (boxOutline's segments's values):
                        set edgeSpot to the item at edgeCursor in (boxOutline's segments's values)
                        append (the bim view point (edgeSpot's x) (edgeSpot's y) (edgeSpot's z) in viewLayout with camera) to (boxOutline's flat's values)
                set editor's extending to shiftHeld
                ignore select bim editor in box from viewPressPixel to pixel among boxOutlines in (the address of editor)
                set editor's extending to false
            else:
                set picked to the bim pick along (the bim view ray through viewPressPixel in viewLayout with camera) among (shownMeshes's values) in editor's documentValue's current with (editor's spaces's values)
                # A grid line, drawn at datum level, is picked within six
                # pixels of it before what lies behind.
                set gridPicked to the bim grid near pixel viewPressPixel of editor in viewLayout with camera
                if gridPicked != the bim refused id:
                    select bim editor bim grid picked numbered gridPicked in (the address of editor)
                else if (the bim level near pixel viewPressPixel of editor around gpuScene in viewLayout with camera) != the bim refused id:
                    select bim editor bim level picked numbered (the bim level near pixel viewPressPixel of editor around gpuScene in viewLayout with camera) in (the address of editor)
                else if ((picked's kind = bim curtain picked) and (editor's selectionKind = bim curtain picked)) and (picked's id = editor's selectionId):
                    # A click on the selected building system chooses the
                    # part where the sight meets its plane.
                    set partRay to the bim view ray through viewPressPixel in viewLayout with camera
                    set systemFound to the bim curtain index of picked's id in editor's documentValue's current
                    if systemFound's valid:
                        set pickedSystem to the item at systemFound's position in (editor's documentValue's current's curtains's values)
                        set systemRun to the maximum of 1e-9 and (the cad distance from pickedSystem's start to pickedSystem's finish)
                        set sux to (pickedSystem's finish's x - pickedSystem's start's x) / systemRun
                        set suy to (pickedSystem's finish's y - pickedSystem's start's y) / systemRun
                        set facing to (partRay's direction's x * suy) - (partRay's direction's y * sux)
                        if (the absolute value of facing) > 1e-9:
                            set partReach to (((pickedSystem's start's x - partRay's origin's x) * suy) - ((pickedSystem's start's y - partRay's origin's y) * sux)) / facing
                            set hitX to partRay's origin's x + (partReach * partRay's direction's x)
                            set hitY to partRay's origin's y + (partReach * partRay's direction's y)
                            set hitZ to partRay's origin's z + (partReach * partRay's direction's z)
                            set systemLevel to 0.0
                            set systemLevelFound to the bim level index of pickedSystem's levelId in editor's documentValue's current
                            if systemLevelFound's valid:
                                set systemLevel to (the item at systemLevelFound's position in (editor's documentValue's current's levels's values))'s elevation
                            choose bim editor part of system pickedSystem's id at (((hitX - pickedSystem's start's x) * sux) + ((hitY - pickedSystem's start's y) * suy)) and (hitZ - systemLevel) in (the address of editor)
                else:
                    select bim editor picked's kind numbered picked's id in (the address of editor)
            set viewPressActive to false
        else:
            release bim editor pointer in (the address of editor)
            if (planBoxActive and planBoxDragged) and editor's editMode:
                # In edit mode the box picks the points inside it.
                set editPoints to the bim edit points of editor
                set editPixels to an empty list of a cad vector2
                loop pointCursor from 0 to the length of (editPoints's values):
                    set editPoint to the item at pointCursor in (editPoints's values)
                    append (the bim plan pixel of (a cad vector2 with x editPoint's x and y editPoint's y) in layout with camera) to editPixels
                set editor's extending to shiftHeld
                pick bim editor points among editPixels in box from planBoxPixel to pixel in (the address of editor)
                set editor's extending to false
                free editPixels
            else if planBoxActive and planBoxDragged:
                set boxOutlines to the bim selection outlines of editor in plan true
                project bim selection outlines boxOutlines from above
                set editor's extending to shiftHeld
                ignore select bim editor in box from planBoxStart to editor's pointerLocation among boxOutlines in (the address of editor)
                set editor's extending to false
        set planBoxActive to false
    set rightDown to the right mouse button is pressed in window
    # A right click that does not drag opens the context menu at the
    # pointer, on the selection or else on what is under the pointer.
    if rightDown and (previousRight = false):
        set rightPressPixel to pixel
        set rightDragged to false
        set contextOpen to false
    if rightDown and ((the cad distance from pixel to rightPressPixel) > 4.0):
        set rightDragged to true
    if ((rightDown = false) and previousRight) and ((rightDragged = false) and (overPlan or overView)):
        if editor's selectionKind = bim nothing picked:
            if overPlan:
                select bim editor element at editor's pointerLocation in (the address of editor)
            else:
                set rightPicked to the bim pick along (the bim view ray through pixel in viewLayout with camera) among (shownMeshes's values) in editor's documentValue's current with (editor's spaces's values)
                select bim editor rightPicked's kind numbered rightPicked's id in (the address of editor)
        set contextOpen to true
        set contextAt to pixel
        set contextHover to -1
    if rightDown and previousRight:
        # Shift and the right button drag the 3D cursor, as in Blender: in
        # the plan to the snapped pointer, in the 3D view over the storey.
        if ((key 340 is down in window) or (key 344 is down in window)) and (overPlan or overView):
            if overPlan:
                place bim editor cursor at editor's snap's point in (the address of editor)
            else:
                place bim editor cursor at (the bim plane hit of (the bim view ray through pixel in viewLayout with camera) at height (the bim storey elevation of editor)) in (the address of editor)
        else if overSection:
            set editor's sectionPanX to editor's sectionPanX + dx
            set editor's sectionPanY to editor's sectionPanY + dy
        else if overPlan:
            set camera's centre to a cad vector2 with x (camera's centre's x - (dx / camera's scale)) and y (camera's centre's y + (dy / camera's scale))
        else if overView and (elevationLocked = false):
            set camera to the bim camera camera orbited by dx and dy
    # The middle button pans; with Shift held it orbits the 3D view.
    set middleDown to the middle mouse button is pressed in window
    if middleDown and previousMiddle:
        if overSection:
            set editor's sectionPanX to editor's sectionPanX + dx
            set editor's sectionPanY to editor's sectionPanY + dy
        else if overPlan:
            set camera's centre to a cad vector2 with x (camera's centre's x - (dx / camera's scale)) and y (camera's centre's y + (dy / camera's scale))
        else if (overView and (elevationLocked = false)) and ((key 340 is down in window) or (key 344 is down in window)):
            set camera to the bim camera camera orbited by dx and dy
        else if overView:
            set camera to the bim camera camera panned by dx and dy
    set previousMiddle to middleDown
    set wheel to the scroll taken from window
    if propertiesSelection != editor's selectionId:
        set propertiesScroll to 0.0
        set propertiesSelection to editor's selectionId
    if wheel != 0.0:
        set factor to 1.15 raised to the power of wheel
        set overBrowser to (browserOpen and (pixel's x < layout's planLeft)) and ((pixel's y > layout's top) and (pixel's y < layout's bottom))
        if (propertiesShown and (pixel's x >= layout's width)) and ((pixel's y > layout's top) and (pixel's y < layout's bottom)):
            # Over the properties: they scroll.
            set visibleProperties to the bim property rows of editor
            set propertiesHeight to ((the length of visibleProperties) as a 64 bit floating-point number) * 21.0
            free visibleProperties
            set maximumScroll to the maximum of 0.0 and ((propertiesHeight - (layout's bottom - ((the bim ui canvas top folded ribbonFolded) + 82.0))) + 21.0)
            set propertiesScroll to the minimum of maximumScroll and (the maximum of 0.0 and (propertiesScroll - (wheel * 42.0)))
        else if overBrowser:
            set browserScroll to the maximum of 0.0 and (browserScroll - (wheel * 40.0))
        else if overSection:
            # Zooms about the pointer: the point under it stays there.
            set zoomFit to the bim section fit of editor in lowerLayout
            set newZoom to the minimum of 50.0 and (the maximum of 0.2 and (editor's sectionZoom * factor))
            set applied to newZoom / editor's sectionZoom
            set restX to (zoomFit's transform's centre's x - editor's sectionPanX)
            set restY to (zoomFit's transform's centre's y - editor's sectionPanY)
            set editor's sectionPanX to ((editor's sectionPanX - (pixel's x - restX)) * applied) + (pixel's x - restX)
            set editor's sectionPanY to ((editor's sectionPanY - (pixel's y - restY)) * applied) + (pixel's y - restY)
            set editor's sectionZoom to newZoom
        else if overPlan:
            set camera to the bim camera camera zoomed by factor in plan at pixel in layout
        else if overView:
            set camera to the bim camera camera zoomed by factor in view at pixel in viewLayout
    # The commands of the keys pressed this frame and of a ribbon button
    # clicked; Ctrl adds `bim ui control command`.
    set pressedCodes to an empty list of an integer
    loop cursor from 0 to the length of codes:
        set code to the item at cursor in codes
        set down to key code is down in window
        if down and ((the item at cursor in previousKeys) = false):
            if (key 341 is down in window) or (key 345 is down in window):
                append (code + (bim ui control command)) to pressedCodes
            else if (((code = 67) and ((key 340 is down in window) or (key 344 is down in window))) and (editor's textActive = false)) and ((bim editor edits reinforcement text editor) = false):
                # Shift+C takes the 3D cursor home, as in Blender.
                place bim editor cursor at (a cad vector2 with x 0.0 and y 0.0) in (the address of editor)
            else if ((code >= 65) and (code <= 90)) and ((editor's textActive and (editor's tool = bim text tool)) = false):
                # Letters go through the two-letter commands of Open 2D
                # Studio first.
                set resolved to resolve bim editor letter code at (the bim microseconds now) in (the address of editor)
                loop resolvedCursor from 0 to the length of resolved:
                    append (the item at resolvedCursor in resolved) to pressedCodes
                free resolved
            else if (bim editor takes a typed value editor) and (((code = 61) or ((code >= 48) and (code <= 57))) and ((key 340 is down in window) or (key 344 is down in window))):
                # While a value is typed, a shifted digit or = is an
                # operator or bracket (+ * ( )), which comes as a character.
                set code to code
            else if (bim editor takes a typed value editor) and (code = 61):
                set code to code
            else:
                append code to pressedCodes
        replace item at index cursor in previousKeys with down
    set expired to the bim letters timed out at (the bim microseconds now) in (the address of editor)
    loop expiredCursor from 0 to the length of expired:
        append (the item at expiredCursor in expired) to pressedCodes
    free expired
    if uiCommand >= 0:
        append uiCommand to pressedCodes
        set uiCommand to -1
    # Escape closes the context menu first, unless a property in it is
    # being typed (then it cancels the typing).
    if contextOpen and (editor's propertyCode < 0):
        set escaping to -1
        loop escapeCursor from 0 to the length of pressedCodes:
            if (the item at escapeCursor in pressedCodes) = bim escape key code:
                set escaping to escapeCursor
        if escaping >= 0:
            remove item escaping from pressedCodes
            set contextOpen to false
    # 2129 turns the section box on (around the whole model) or off.
    loop boxCursor from 0 to the length of pressedCodes:
        if (the item at boxCursor in pressedCodes) = 2129:
            set sectionBoxOn to sectionBoxOn = false
            if sectionBoxOn:
                set sectionBoxLow to the cad difference of gpuScene's low and (a cad vector3 with x 0.5, y 0.5 and z 0.5)
                set sectionBoxHigh to the cad sum of gpuScene's high and (a cad vector3 with x 0.5, y 0.5 and z 0.5)
                set editor's message to the string form of "Section box: drag a face's handle to cut the model"
            else:
                set editor's message to the string form of "Section box off"
    # 2127 imports a 2D drawing (DXF, DWG or PDF) picked in a file dialog.
    loop drawingCursor from 0 to the length of pressedCodes:
        if (the item at drawingCursor in pressedCodes) = 2127:
            set pickedDrawing to the bim drawing picked
            if (the length of pickedDrawing) > 0:
                ignore (import bim drawing at pickedDrawing through drawingScript in (the address of editor))
                set fitting to true
    # 2120 opens the Drawing Rules window, on the plan's drawing type (the
    # library added when the model has none). While it is open it takes the
    # keys: Escape closes it, and a name being typed takes Enter, Backspace
    # and Escape.
    set opensRules to false
    loop rulesCursor from 0 to the length of pressedCodes:
        if (the item at rulesCursor in pressedCodes) = 2120:
            set opensRules to true
    if opensRules:
        set rulesTarget to the address of (editor's documentValue's current)
        if (the length of (rulesTarget's drawingTypes's values)) = 0:
            begin bim transaction in (the address of (editor's documentValue))
            ensure bim drawing types in rulesTarget
            commit bim transaction in (the address of (editor's documentValue))
        set rulesOpen to true
        set rulesRenaming to false
        set rulesTypeId to the bim plan drawing type of editor
        if (the bim drawing type index of rulesTypeId in editor's documentValue's current)'s valid = false:
            set rulesTypeId to (the item at 0 in (editor's documentValue's current's drawingTypes's values))'s id
        set editor's message to the string form of "Drawing Rules: click a cell to set or inherit it"
        clear pressedCodes
    if rulesOpen:
        loop rulesCursor from 0 to the length of pressedCodes:
            set rulesKey to the item at rulesCursor in pressedCodes
            if rulesRenaming:
                if rulesKey = bim enter key code:
                    rename bim editor drawing type rulesTypeId to rulesText in (the address of editor)
                    set rulesRenaming to false
                else if rulesKey = bim escape key code:
                    set rulesRenaming to false
                else if (rulesKey = bim backspace key code) and ((the length of rulesText) > 0):
                    set rulesText to the substring of rulesText from 0 spanning ((the length of rulesText) - 1) bytes
            else if rulesKey = bim escape key code:
                set rulesOpen to false
        clear pressedCodes
    loop pressedCursor from 0 to the length of pressedCodes:
        set entry to the item at pressedCursor in pressedCodes
        set control to entry >= (bim ui control command)
        set code to the remainder of entry divided by (bim ui control command)
        # Reinforcement text fields own letters which would otherwise fit/change a view.
        if (bim editor edits reinforcement text editor) and (entry < 1000):
            type bim editor key entry in (the address of editor)
            set code to -1
        # While a text is written, keys only edit it.
        if editor's textActive and (editor's tool = bim text tool):
            set code to -1
            if ((entry = 257) or (entry = 259)) or (entry = 256):
                type bim editor key entry in (the address of editor)
        # F7 shows and hides the plan's grid, as in CAD.
        if entry = 296:
            set gridShown to gridShown = false
            set code to -1
            if gridShown:
                set editor's message to the string form of "Grid on (F7)"
            else:
                set editor's message to the string form of "Grid off (F7)"
        # WT tiles the views, TW shows them as tabs.
        if (entry = 2090) or (entry = 2091):
            set tiledViews to entry = 2090
            set code to -1
            if tiledViews:
                set editor's message to the string form of "Views tiled (TW: tabs)"
            else:
                set editor's message to the string form of "Views as tabs (WT: tiled)"
        # ES: the sheet open written as SVG, in millimetres.
        else if entry = 2115:
            set code to -1
            set svgFound to the bim sheet index of editor's sheetId in editor's documentValue's current
            if svgFound's valid:
                set svgSheet to the item at svgFound's position in (editor's documentValue's current's sheets's values)
                set svgSize to the bim size of sheet svgSheet
                set svgCanvas to a new bim canvas
                record bim sheet svgSheet of editor among (sketchMeshes's values) from (a cad vector2 with x 0.0 and y svgSize's y) at 1.0 using typeface on (the address of svgCanvas)
                set svgPath to ((svgSheet's number with " " replaced by "_") with "/" replaced by "_") + (the string form of ".svg")
                if write bim text (the bim svg of svgCanvas sized svgSize's x by svgSize's y with text 2.5 high) to file svgPath:
                    set editor's message to (the string form of "Sheet exported to ") + svgPath
                else:
                    set editor's message to (the string form of "Could not write ") + svgPath
            else:
                set editor's message to the string form of "Export SVG: open a sheet first"
        # EP: the sheet open written as a PDF, in points, next to the model.
        else if entry = 2098:
            set code to -1
            set exportFound to the bim sheet index of editor's sheetId in editor's documentValue's current
            if exportFound's valid:
                set exportSheet to the item at exportFound's position in (editor's documentValue's current's sheets's values)
                set exportSize to the bim size of sheet exportSheet
                set pointsPerMillimetre to 72.0 / 25.4
                set exportCanvas to a new bim canvas
                record bim sheet exportSheet of editor among (sketchMeshes's values) from (a cad vector2 with x 0.0 and y (exportSize's y * pointsPerMillimetre)) at pointsPerMillimetre using typeface on (the address of exportCanvas)
                set exportText to the bim pdf of exportCanvas sized (exportSize's x * pointsPerMillimetre) by (exportSize's y * pointsPerMillimetre) with text 7.0 high
                set exportPath to ((exportSheet's number with " " replaced by "_") with "/" replaced by "_") + (the string form of ".pdf")
                if write bim text exportText to file exportPath:
                    set editor's message to (the string form of "Sheet exported to ") + exportPath
                else:
                    set editor's message to (the string form of "Could not write ") + exportPath
            else:
                set editor's message to the string form of "Export PDF: open a sheet first"
        # Commands of their own (two-letter commands) go to the editor.
        else if entry >= 2000:
            type bim editor key entry in (the address of editor)
        else if control and (code = 83):
            save bim editor to filePath in (the address of editor)
        else if code = 256:
            # Escape cancels what is under way and clears the selection;
            # it never closes the window.
            set showVisibility to false
            type bim editor key code in (the address of editor)
        else if control and (code = 79):
            open bim editor from filePath in (the address of editor)
            add bim type library to (the address of editor)
            set fitting to true
        else if (code = 45) and ((editor's grabbing = false) and (editor's propertyCode < 0)):
            set camera's scale to camera's scale / 1.2
        else if code = 61:
            set camera's scale to camera's scale * 1.2
        else if (code = 86) and editor's hasSection:
            set existing to the bim tab of kind bim section tab detail editor's sectionViewId among tabKinds and tabDetails
            if existing < 0:
                append bim section tab to tabKinds
                append editor's sectionViewId to tabDetails
                set existing to (the length of tabKinds) - 1
            set activeTab to existing
        else if code = 70:
            set fitting to true
            set editor's sectionZoom to 1.0
            set editor's sectionPanX to 0.0
            set editor's sectionPanY to 0.0
        else if code = 76:
            set showVisibility to showVisibility = false
        else if code = 75:
            set fineDetail to fineDetail = false
            set meshes to a cad topology list of a bim scene mesh record
            set meshedRevision to (-1) as a 64 bit integer
            if fineDetail:
                set editor's message to the string form of "3D detail: fine (wall layers)"
            else:
                set editor's message to the string form of "3D detail: coarse"
        else if code = 84:
            set existing to the bim tab of kind bim schedule tab detail (0 as a 64 bit integer) among tabKinds and tabDetails
            if existing < 0:
                append bim schedule tab to tabKinds
                append (0 as a 64 bit integer) to tabDetails
                set existing to (the length of tabKinds) - 1
            set activeTab to existing
        else if control and ((code >= 49) and (code <= 52)):
            set viewMode to code - 49
            set editor's message to (the string form of "3D view: ") + (the bim name of view mode viewMode)
        else if control and (((((code = 71) or (code = 73)) or (code = 69)) or (code = 85)) or (code = 88)):
            type bim editor key (code + (bim ui control command)) in (the address of editor)
        else if (code = 69) and showSchedule:
            if write bim text (the bim schedule csv of (scheduleRows's values)) to file (the string form of "bim-schedule.csv"):
                set editor's message to the string form of "Schedule exported to bim-schedule.csv"
            else:
                set editor's message to the string form of "Could not write bim-schedule.csv"
        else if control and (code = 81):
            request that window close
        else if control and (code = 84):
            type bim editor key 1084 in (the address of editor)
        else if code < 0:
            set code to -1
        else:
            type bim editor key code in (the address of editor)
    free pressedCodes
    # Characters typed go to the text being written.
    set typedNow to the characters typed into window
    loop cursor from 0 to the length of typedNow:
        if rulesOpen:
            set typedCode to the item at cursor in typedNow
            if rulesRenaming and ((typedCode >= 32) and (typedCode < 127)):
                set typedLetter to a new string buffer containing 1 bytes
                store (typedCode as a byte) into the data of typedLetter at 0
                set rulesText to rulesText + typedLetter
        else:
            type bim editor character (the item at cursor in typedNow) in (the address of editor)
    free typedNow
    set previousLeft to leftDown
    set previousRight to rightDown
    set previousCursor to cursorPosition
    refresh bim editor (the address of editor)
    # Round shapes are meshed for the 3D view's zoom: a chord leaves the
    # true surface by at most half a pixel, in steps of a factor of 2, so
    # zooming in adds segments and zooming out drops them.
    set lodTier to 0
    set lodTolerance to 1.0
    set halfPixel to 0.5 / (the maximum of camera's viewScale and 1e-6)
    loop while (lodTier < 24) and (lodTolerance > halfPixel):
        set lodTolerance to lodTolerance * 0.5
        set lodTier to lodTier + 1
    if (editor's documentValue's revision != meshedRevision) or (editor's dragging or (lodTier != meshedTier)):
        set meshes to the bim scene meshes of editor's evaluation after (meshes's values) layered fineDetail
        if ((editor's documentValue's revision = meshedRevision) and (editor's dragging = false)) and (gizmoAxis = 0):
            set sketchMeshes to the bim sketch meshes of editor's documentValue's current within lodTolerance reusing (sketchMeshes's values)
        else:
            set sketchMeshes to the bim sketch meshes of editor's documentValue's current within lodTolerance
        set meshedTier to lodTier
        loop cursor from 0 to the length of (sketchMeshes's values):
            append (the item at cursor in (sketchMeshes's values)) to (meshes's values)
        set meshedRevision to editor's documentValue's revision
        set meshGeneration to meshGeneration + (1 as a 64 bit integer)
    # The meshes of the categories the 3D view shows; picking sees only these.
    # They are filtered again only when the meshes or the 3D view's rules
    # change.
    set shownKey to (the string form of meshGeneration) + (the bim rule text of editor's modelRules)
    if sectionBoxOn:
        set shownKey to ((shownKey + (the string form of " box ")) + ((the string form of sectionBoxLow's x) + (the string form of sectionBoxLow's y))) + (((the string form of sectionBoxLow's z) + (the string form of sectionBoxHigh's x)) + ((the string form of sectionBoxHigh's y) + (the string form of sectionBoxHigh's z)))
    if shownKey != shownMeshesKey:
        set shownMeshes to the bim meshes of (meshes's values) and (imported's meshes's values) shown by editor's modelRules
        if (the length of (editor's documentValue's current's phases's values)) > 0:
            set shownMeshes to the bim meshes of (shownMeshes's values) kept by phase of editor
        # The section box cuts away what lies outside it.
        if sectionBoxOn:
            set shownMeshes to the bim scene meshes of (shownMeshes's values) clipped to box from sectionBoxLow to sectionBoxHigh
        set shownMeshesKey to shownKey
    set frame to a new graphics frame in window with background red 1.0, green 1.0, blue 1.0 and alpha 1.0
    use screen coordinates in frame
    # A section drawn opens its tab.
    # A sheet made (NS) opens its tab.
    if ((the bim sheet index of editor's sheetId in editor's documentValue's current)'s valid) and ((the bim tab of kind bim sheet tab detail editor's sheetId among tabKinds and tabDetails) < 0):
        append bim sheet tab to tabKinds
        append editor's sheetId to tabDetails
        set activeTab to (the length of tabKinds) - 1
    if editor's hasSection and ((the bim tab of kind bim section tab detail editor's sectionViewId among tabKinds and tabDetails) < 0):
        append bim section tab to tabKinds
        append editor's sectionViewId to tabDetails
        set activeTab to (the length of tabKinds) - 1
    set planTransform to the bim plan transform of layout with camera
    if gridShown:
        draw bim grid in layout with camera in frame
    # The plan is recorded again only when what it shows changes; panning
    # replays the recording shifted.
    set planKey to the bim plan key of editor at camera's scale
    set originPixel to the bim pixel of (a cad vector2 with x 0.0 and y 0.0) through planTransform
    if planKey != recordedPlanKey:
        set planCanvas to a new bim canvas
        set planCanvas's sketchy to bim view editor's planViewId is sketchy in editor's documentValue's current
        if bim category bim space category is visible in editor's planRules:
            draw bim spaces of editor through planTransform on (the address of planCanvas)
        if bim category bim wall category is visible in editor's planRules:
            draw bim storey below of editor through planTransform on (the address of planCanvas)
        draw bim hatched cut faces of editor's plan for editor through planTransform as section false following editor's planRules on (the address of planCanvas)
        draw bim openings in plan of editor through planTransform on (the address of planCanvas)
        draw bim grids in plan of editor through planTransform on (the address of planCanvas)
        draw bim section marks in plan of editor through planTransform on (the address of planCanvas)
        draw bim sketches of editor through planTransform on (the address of planCanvas) using typeface
        draw bim linears in plan of editor through planTransform on (the address of planCanvas)
        draw bim annotations in plan of editor through planTransform on (the address of planCanvas)
        draw bim area measures in plan of editor through planTransform on (the address of planCanvas)
        draw bim stairs in plan of editor through planTransform on (the address of planCanvas)
        draw bim folded components in plan of editor among (sketchMeshes's values) through planTransform on (the address of planCanvas)
        draw bim dimensions in plan of editor through planTransform on (the address of planCanvas)
        draw bim tags in plan of editor through planTransform on (the address of planCanvas)
        set recordedPlanKey to planKey
        set recordedOrigin to originPixel
    # The recorded plan is kept on the GPU and drawn shifted; it is written
    # there again only when it was recorded again.
    if frame's drawable and (uploadedPlanKey != recordedPlanKey):
        begin gpu canvas recording in (the gpu context of window)
        replay bim canvas planCanvas shifted by 0.0 and 0.0 with typeface in frame
        end gpu canvas recording in (the gpu context of window)
        set uploadedPlanKey to recordedPlanKey
    # Slab edges first, so that the cut outlines over them stay black.
    draw bim slabs of editor through planTransform in frame
    draw gpu canvas shifted by (originPixel's x - recordedOrigin's x) and (originPixel's y - recordedOrigin's y) in (the gpu context of window)
    draw bim selection in plan of editor through planTransform in frame
    # A cropped plan view shows only its crop: the plan outside is covered,
    # and the crop drawn as a thin frame.
    set cropFound to the bim view index of editor's planViewId in editor's documentValue's current
    if cropFound's valid:
        set cropView to the item at cropFound's position in (editor's documentValue's current's views's values)
        if cropView's cropped:
            set cropTopLeft to the bim pixel of (a cad vector2 with x cropView's cropLow's x and y cropView's cropHigh's y) through planTransform
            set cropBottomRight to the bim pixel of (a cad vector2 with x cropView's cropHigh's x and y cropView's cropLow's y) through planTransform
            set cropLeft to the maximum of layout's planLeft and cropTopLeft's x
            set cropRight to the minimum of layout's planRight and cropBottomRight's x
            set cropTop to the maximum of layout's top and cropTopLeft's y
            set cropBottom to the minimum of layout's bottom and cropBottomRight's y
            draw a rectangle at x layout's planLeft and y layout's top with width (layout's planRight - layout's planLeft) and height (the maximum of 0.0 and (cropTop - layout's top)) in color red 255, green 255 and blue 255 in frame
            draw a rectangle at x layout's planLeft and y cropBottom with width (layout's planRight - layout's planLeft) and height (the maximum of 0.0 and (layout's bottom - cropBottom)) in color red 255, green 255 and blue 255 in frame
            draw a rectangle at x layout's planLeft and y cropTop with width (the maximum of 0.0 and (cropLeft - layout's planLeft)) and height (the maximum of 0.0 and (cropBottom - cropTop)) in color red 255, green 255 and blue 255 in frame
            draw a rectangle at x cropRight and y cropTop with width (the maximum of 0.0 and (layout's planRight - cropRight)) and height (the maximum of 0.0 and (cropBottom - cropTop)) in color red 255, green 255 and blue 255 in frame
            start triangles in frame
            use vertex color red 150, green 150 and blue 150 in frame
            add bim stroke from cropTopLeft to (a cad vector2 with x cropBottomRight's x and y cropTopLeft's y) wide 1.0 in frame
            add bim stroke from (a cad vector2 with x cropBottomRight's x and y cropTopLeft's y) to cropBottomRight wide 1.0 in frame
            add bim stroke from cropBottomRight to (a cad vector2 with x cropTopLeft's x and y cropBottomRight's y) wide 1.0 in frame
            add bim stroke from (a cad vector2 with x cropTopLeft's x and y cropBottomRight's y) to cropTopLeft wide 1.0 in frame
            finish triangles in frame
        else:
            # Not cropped, the view's extent still shows as its outline: the
            # building with 3 m around it, where the elevation marks stand.
            set planExtent to the bim plan extent of editor's documentValue's current
            if planExtent's valid:
                set outlineTopLeft to the bim pixel of (a cad vector2 with x (planExtent's low's x - 3.0) and y (planExtent's high's y + 3.0)) through planTransform
                set outlineBottomRight to the bim pixel of (a cad vector2 with x (planExtent's high's x + 3.0) and y (planExtent's low's y - 3.0)) through planTransform
                start triangles in frame
                use vertex color red 185, green 190 and blue 200 in frame
                add bim stroke from outlineTopLeft to (a cad vector2 with x outlineBottomRight's x and y outlineTopLeft's y) wide 1.0 in frame
                add bim stroke from (a cad vector2 with x outlineBottomRight's x and y outlineTopLeft's y) to outlineBottomRight wide 1.0 in frame
                add bim stroke from outlineBottomRight to (a cad vector2 with x outlineTopLeft's x and y outlineBottomRight's y) wide 1.0 in frame
                add bim stroke from (a cad vector2 with x outlineTopLeft's x and y outlineBottomRight's y) to outlineTopLeft wide 1.0 in frame
                finish triangles in frame
    if planBoxActive and planBoxDragged:
        draw bim selection box from planBoxPixel to pixel in frame
    draw bim gesture of editor in layout with camera using typeface showing the pointer pointerHidden in frame
    set planBarView to the bim view index of editor's planViewId in editor's documentValue's current
    if planBarView's valid:
        set planBarValue to the item at planBarView's position in (editor's documentValue's current's views's values)
        draw bim view bar ending at (layout's planRight - 8.0) and (layout's bottom - 26.0) scale planBarValue's scale display planBarValue's displayMode scaled true sketchy (bim view editor's planViewId is sketchy in editor's documentValue's current) shadows false using typeface in frame
    draw bim cursor mark at (the bim plan pixel of (a cad vector2 with x editor's cursorPoint's x and y editor's cursorPoint's y) in layout with camera) in frame
    if showVisibility:
        draw bim visibility panel of editor in layout using typeface in frame
    # Each panel keeps to its area: the right panel is cleared over whatever
    # the plan drew into it, and the bars over whatever either panel drew.
    draw a rectangle at x layout's planRight and y 0 with width (layout's width - layout's planRight) and height layout's height in color red 247, green 249 and blue 252 in frame
    if drawModel:
        # The model lives on the GPU: it is written again only when the shown
        # meshes change, and each frame sets the camera and draws it. The
        # ground and the shadows are recorded per camera and drawn under it.
        if (shownMeshesKey != uploadedKey) or (viewMode != uploadedMode):
            set gpuScene to upload bim gpu scene of (shownMeshes's values) for editor in mode viewMode to window
            set uploadedKey to shownMeshesKey
            set uploadedMode to viewMode
        set viewKey to the bim view key of editor with camera in viewLayout at meshGeneration showing (the length of (shownMeshes's values))
        if viewKey != recordedViewKey:
            set viewRecording to a new bim depth recording
            set cornerTotal to 0
            loop cursor from 0 to the length of (shownMeshes's values):
                set cornerTotal to cornerTotal + (the length of ((the item at cursor in (shownMeshes's values))'s shape's triangles's values))
            if ((camera's pitch > 0.05) and shadowsOn) and ((cornerTotal > 0) and (cornerTotal <= 450000)):
                draw bim ground and shadows of (shownMeshes's values) toward (the bim direction toward the sun) in viewLayout with camera on (the address of viewRecording)
            set recordedViewKey to viewKey
        replay bim depth recording viewRecording flat in frame
        set selectedForGpu to an empty list of a 64 bit integer
        if editor's selectionKind != bim nothing picked:
            append editor's selectionId to selectedForGpu
            loop gpuChosenCursor from 0 to the length of (editor's chosenSketches's values):
                append (the item at gpuChosenCursor in (editor's chosenSketches's values)) to selectedForGpu
        set bim gpu camera camera in viewLayout for gpuScene selecting selectedForGpu on window
        free selectedForGpu
        if viewMode != bim wireframe view mode:
            draw gpu mesh within viewLayout's planRight, viewLayout's top, (viewLayout's width - viewLayout's planRight) and (viewLayout's bottom - viewLayout's top) in (the gpu context of window)
        if viewMode != bim shaded view mode:
            draw bim edges of gpuScene in viewLayout with camera hidden (viewMode != bim wireframe view mode) in frame
        draw bim grid lines in view of editor around gpuScene in viewLayout with camera in frame
        draw bim label ((the string form of "3D  ") + ((the bim name of view mode viewMode) + (the string form of " (Ctrl+1-4)   drag: select (right: window, left: crossing)   right or Shift+middle: orbit, middle: pan, wheel: zoom"))) at (viewLayout's planRight + 16.0) and (viewLayout's top + 30.0) using typeface in frame
        draw bim view bar ending at (layout's width - 8.0) and (viewLayout's bottom - 26.0) scale 0 display (the bim display of view mode viewMode) scaled false sketchy false shadows shadowsOn using typeface in frame
        if bim category bim space category is visible in editor's modelRules:
            if editor's documentValue's revision != roomRevision:
                set roomSpaces to the bim rooms of editor's documentValue's current using editor's evaluation's index
                set roomRevision to editor's documentValue's revision
            draw bim rooms (roomSpaces's values) of editor in viewLayout with camera in frame
        draw bim selection in view of editor in viewLayout with camera in frame
        # The 3D cursor, and the gizmo on the selection.
        set storeyLift to the bim storey elevation of editor
        draw bim cursor mark in view at (a cad vector3 with x editor's cursorPoint's x, y editor's cursorPoint's y and z (editor's cursorPoint's z + storeyLift)) in viewLayout with camera in frame
        set gizmoCentre to the bim selection centre of editor
        if (gizmoCentre's found and (editor's tool = bim select tool)) and (editor's editMode = false):
            # The handle being dragged, else the one under the pointer, lights up.
            set shownGizmo to the bim gizmo at (a cad vector3 with x gizmoCentre's point's x, y gizmoCentre's point's y and z (gizmoCentre's point's z + storeyLift)) in viewLayout with camera
            set litHandle to gizmoAxis
            if (litHandle = 0) and overView:
                set litHandle to the bim gizmo handle of shownGizmo at pixel
            draw bim gizmo shownGizmo active litHandle in frame
        # Canvas first: the active storey's plan at the 3D view's lower left,
        # with an arrow where the camera looks from and to.
        set insetExtent to the bim plan extent of editor's documentValue's current
        set insetLeft to layout's planRight + 12.0
        set insetTop to viewLayout's bottom - 212.0
        set insetWidth to 260.0
        set insetHeight to 200.0
        if insetFolded:
            set insetTop to viewLayout's bottom - 38.0
            set insetHeight to 26.0
        if ((tiledViews = false) and (activeKind = bim model tab)) and insetExtent's valid:
            draw a rectangle at x insetLeft and y insetTop with width insetWidth and height insetHeight in color red 34, green 36 and blue 40 in frame
            draw bim label (the bim storey name of editor) at (insetLeft + 10.0) and (insetTop + 18.0) using typeface in frame
            # The fold button: a bar to fold, a square to unfold.
            set foldLeft to (insetLeft + insetWidth) - 20.0
            set foldOver to ((pixel's x >= (foldLeft - 6.0)) and (pixel's x < (insetLeft + insetWidth))) and ((pixel's y >= insetTop) and (pixel's y < (insetTop + 26.0)))
            set foldShade to 170
            if foldOver:
                set foldShade to 255
            if insetFolded:
                draw a rectangle at x foldLeft and y (insetTop + 8.0) with width 10.0 and height 10.0 in color red foldShade, green foldShade and blue foldShade in frame
                draw a rectangle at x (foldLeft + 1.5) and y (insetTop + 9.5) with width 7.0 and height 7.0 in color red 34, green 36 and blue 40 in frame
            else:
                draw a rectangle at x foldLeft and y (insetTop + 12.0) with width 10.0 and height 2.0 in color red foldShade, green foldShade and blue foldShade in frame
        if (((tiledViews = false) and (activeKind = bim model tab)) and insetExtent's valid) and (insetFolded = false):
            draw a rectangle at x (insetLeft + 6.0) and y (insetTop + 26.0) with width (insetWidth - 12.0) and height (insetHeight - 32.0) in color red 255, green 255 and blue 255 in frame
            set insetTransform to the bim inset transform at insetLeft and insetTop over insetExtent
            set wantedInset to (((the string form of editor's documentValue's revision) + (the string form of " ")) + ((the string form of editor's levelId) + (the string form of " "))) + ((the string form of insetLeft) + ((the string form of " ") + (the string form of insetTop)))
            if wantedInset != insetKey:
                set insetCanvas to a new bim canvas
                draw bim hatched cut faces of editor's plan for editor through insetTransform as section false following editor's planRules on (the address of insetCanvas)
                set insetKey to wantedInset
            replay bim canvas insetCanvas shifted by 0.0 and 0.0 with typeface in frame
            # The camera: an arrow at its target, along the line of sight.
            set sightRay to the bim view ray through (a cad vector2 with x ((layout's planRight + layout's width) * 0.5) and y ((viewLayout's top + viewLayout's bottom) * 0.5)) in viewLayout with camera
            set sightRun to the square root of ((sightRay's direction's x * sightRay's direction's x) + (sightRay's direction's y * sightRay's direction's y))
            if sightRun > 1e-6:
                set lookX to sightRay's direction's x / sightRun
                set lookY to (0.0 - sightRay's direction's y) / sightRun
                set eyeSpot to the bim pixel of (a cad vector2 with x camera's target's x and y camera's target's y) through insetTransform
                start triangles in frame
                use vertex color red 0, green 120 and blue 215 in frame
                add a vertex at x (eyeSpot's x + (lookX * 14.0)) and y (eyeSpot's y + (lookY * 14.0)) to frame
                add a vertex at x ((eyeSpot's x - (lookX * 8.0)) - (lookY * 8.0)) and y ((eyeSpot's y - (lookY * 8.0)) + (lookX * 8.0)) to frame
                add a vertex at x ((eyeSpot's x - (lookX * 8.0)) + (lookY * 8.0)) and y ((eyeSpot's y - (lookY * 8.0)) - (lookX * 8.0)) to frame
                finish triangles in frame
        if sectionBoxOn:
            set litFace to boxDragFace
            if (litFace < 0) and overView:
                set litFace to the bim box face at pixel from sectionBoxLow to sectionBoxHigh in viewLayout with camera
            draw bim section box from sectionBoxLow to sectionBoxHigh lit litFace in viewLayout with camera in frame
        set viewCanvas to a new bim canvas
        draw bim levels of editor around gpuScene in viewLayout with camera on (the address of viewCanvas)
        draw bim grids in view of editor among (shownMeshes's values) remembering headCovers afresh (viewKey != headCoversKey) in viewLayout with camera on (the address of viewCanvas)
        set headCoversKey to viewKey
        if imported's valid:
            draw bim curves (imported's curves's values) in viewLayout with camera on (the address of viewCanvas)
        replay bim canvas viewCanvas shifted by 0.0 and 0.0 with typeface in frame
        set handles to the bim grips of editor
        draw bim grips (handles's values) in view of viewLayout with camera in frame
        if drawingInView:
            draw bim gesture in view of editor in viewLayout with camera in frame
        if viewPressActive and viewDragged:
            draw bim selection box from viewPressPixel to pixel in frame
            # A line across a mesh face: its first point, the outline point
            # under the pointer, and the line between them.
            if editor's tool = bim line tool:
                start triangles in frame
                if meshLineActive:
                    set lineStartPixel to the bim view point (meshLineSpot's x) (meshLineSpot's y) (meshLineSpot's z + meshLineZ) in viewLayout with camera
                    use vertex color red 255, green 140 and blue 0 in frame
                    add bim square at lineStartPixel sized 8.0 in frame
                    if meshLineHover:
                        add bim stroke from lineStartPixel to (the bim view point (meshLineHoverSpot's x) (meshLineHoverSpot's y) (meshLineHoverSpot's z + meshLineHoverZ) in viewLayout with camera) wide 2.0 in frame
                if meshLineHover:
                    use vertex color red 40, green 160 and blue 60 in frame
                    add bim square at (the bim view point (meshLineHoverSpot's x) (meshLineHoverSpot's y) (meshLineHoverSpot's z + meshLineHoverZ) in viewLayout with camera) sized 9.0 in frame
                finish triangles in frame
    # The section or schedule: after the 3D view, so that in a split column
    # it is drawn over its own cleared lower half.
    if splitViews:
        draw a rectangle at x layout's planRight and y splitAt with width (layout's width - layout's planRight) and height (layout's height - splitAt) in color red 247, green 249 and blue 252 in frame
    if showSection and editor's hasSection:
        draw bim section of editor in lowerLayout dragging sectionDragKind of sectionDragId at sectionDragX and sectionDragY using typeface in frame
        set sectionBarView to the bim view index of editor's sectionViewId in editor's documentValue's current
        if sectionBarView's valid:
            set sectionBarValue to the item at sectionBarView's position in (editor's documentValue's current's views's values)
            draw bim view bar ending at (layout's width - 8.0) and (lowerLayout's bottom - 26.0) scale sectionBarValue's scale display sectionBarValue's displayMode scaled true sketchy (bim view editor's sectionViewId is sketchy in editor's documentValue's current) shadows false using typeface in frame
    else if showSchedule:
        if editor's evaluation's generation != scheduleGeneration:
            set scheduleRows to the bim schedule of editor's documentValue's current with editor's evaluation and (editor's spaces's values)
            set scheduleGeneration to editor's evaluation's generation
        set chosenRows to the bim rows of (scheduleRows's values) in schedule scheduleCode
        draw bim schedule (chosenRows's values) in lowerLayout using typeface in frame
    if splitViews:
        draw a rectangle at x layout's planRight and y splitAt with width (layout's width - layout's planRight) and height 3 in color red 200, green 206 and blue 216 in frame
    # A sheet: fitted into the pane on a grey ground, recorded again when the
    # model or the pane changes.
    if showSheet:
        set sheetFound to the bim sheet index of editor's sheetId in editor's documentValue's current
        draw a rectangle at x layout's planRight and y layout's top with width (layout's width - layout's planRight) and height (layout's bottom - layout's top) in color red 200, green 203 and blue 208 in frame
        if sheetFound's valid:
            set openSheet to the item at sheetFound's position in (editor's documentValue's current's sheets's values)
            set openSize to the bim size of sheet openSheet
            set paneWidth to (layout's width - layout's planRight) - 40.0
            set paneHeight to (layout's bottom - layout's top) - 40.0
            set perMillimetre to the minimum of (paneWidth / openSize's x) and (paneHeight / openSize's y)
            set sheetCorner to a cad vector2 with x (((layout's planRight + layout's width) * 0.5) - ((openSize's x * perMillimetre) * 0.5)) and y (((layout's top + layout's bottom) * 0.5) + ((openSize's y * perMillimetre) * 0.5))
            set wantedSheetKey to (((the string form of editor's documentValue's revision) + (the string form of " ")) + ((the string form of editor's sheetId) + (the string form of " "))) + ((the string form of perMillimetre) + ((the string form of " ") + (the string form of sheetCorner's x)))
            if wantedSheetKey != sheetKey:
                set sheetCanvas to a new bim canvas
                record bim sheet openSheet of editor among (sketchMeshes's values) from sheetCorner at perMillimetre using typeface on (the address of sheetCanvas)
                set sheetKey to wantedSheetKey
            replay bim canvas sheetCanvas shifted by 0.0 and 0.0 with typeface in frame
    draw a rectangle at x 0 and y 0 with width windowWidth and height layout's top in color red 247, green 249 and blue 252 in frame
    draw a rectangle at x 0 and y layout's bottom with width windowWidth and height (layout's height - layout's bottom) in color red 247, green 249 and blue 252 in frame
    draw a rectangle at x layout's planRight and y 0 with width 2 and height layout's height in color red 200, green 206 and blue 216 in frame
    # The tab bar: the open views, the active one raised; x closes a tab.
    set barTop to layout's top - (the bim tab bar height)
    if tiledViews:
        set barTop to barTop - (the bim pane caption height)
        set captionTop to layout's top - (the bim pane caption height)
        draw bim pane caption (the bim tab label of kind (bim plan tab) detail editor's planViewId for editor) from layout's planLeft to layout's planRight at captionTop active (activeKind = bim plan tab) using typeface in frame
        if (sideTab >= 0) and (sideTab < (the length of tabKinds)):
            draw bim pane caption (the bim tab label of kind (the item at sideTab in tabKinds) detail (the item at sideTab in tabDetails) for editor) from (layout's planRight + 2.0) to layout's width at captionTop active (activeTab = sideTab) using typeface in frame
        if splitViews:
            draw bim pane caption (the bim tab label of kind (the item at lowerTab in tabKinds) detail (the item at lowerTab in tabDetails) for editor) from (layout's planRight + 2.0) to layout's width at lowerTop active (activeTab = lowerTab) using typeface in frame
    draw a rectangle at x layout's planLeft and y barTop with width (layout's width - layout's planLeft) and height (the bim tab bar height) in color red 228, green 231 and blue 236 in frame
    set tabEdges to the bim tab edges of tabKinds and tabDetails for editor from (layout's planLeft + 4.0) using typeface
    loop tabCursor from 0 to the length of tabKinds:
        set tabLeft to the item at tabCursor in tabEdges
        set tabWidth to ((the item at (tabCursor + 1) in tabEdges) - tabLeft) - 2.0
        set tabText to the bim tab label of kind (the item at tabCursor in tabKinds) detail (the item at tabCursor in tabDetails) for editor
        if tabCursor = activeTab:
            draw a rectangle at x tabLeft and y (barTop + 3.0) with width tabWidth and height ((the bim tab bar height) - 3.0) in color red 255, green 255 and blue 255 in frame
            draw a rectangle at x tabLeft and y (barTop + 3.0) with width tabWidth and height 2 in color red 0, green 120 and blue 215 in frame
        else if tiledViews and ((tabCursor = sideTab) or (splitViews and (tabCursor = lowerTab))):
            draw a rectangle at x tabLeft and y (barTop + 3.0) with width tabWidth and height ((the bim tab bar height) - 3.0) in color red 242, green 244 and blue 247 in frame
        draw bim text tabText at (tabLeft + 10.0) and (barTop + 18.0) in face (bim text small) with typeface coloured 35, 40 and 50 in frame
        if (the length of tabKinds) > 1:
            draw bim text (the string form of "x") at ((tabLeft + tabWidth) - 15.0) and (barTop + 18.0) in face (bim text small) with typeface coloured 120, 125 and 135 in frame
    free tabEdges
    set status to ((the bim storey name of editor) + (the string form of " (PgUp/PgDn)   ")) + (the bim tool name of editor's tool)
    set status to status + (the string form of "   snap ")
    if editor's orthoOn:
        set status to status + (the string form of "[ortho] ")
    if editor's polarOn:
        set status to status + (the string form of "[polar] ")
    set status to ((status + editor's snap's label) + (the string form of "   rebuilt ")) + (the string form of editor's lastRebuilt)
    set status to ((status + (the string form of " elements in ")) + (the string form of editor's lastMicroseconds)) + (the string form of " us   revision ")
    set status to (status + (the string form of editor's documentValue's revision)) + (the string form of "   spaces ")
    set status to (status + (the string form of (the length of (editor's spaces's values)))) + (the string form of "   frame ")
    set status to (status + (the string form of frameMicroseconds)) + (the string form of " us   ")
    set typeFound to the bim opening type index of editor's openingTypeId in editor's documentValue's current
    if typeFound's valid:
        set currentType to the item at typeFound's position in (editor's documentValue's current's openingTypes's values)
        set kindName to the string form of " window   "
        if currentType's isDoor:
            set kindName to the string form of " door   "
        set status to ((((status + (the bim number currentType's width in units editor's lengthUnit)) + (the string form of "x")) + (the bim length currentType's height in units editor's lengthUnit)) + kindName)
    set status to (status + (the string form of "units ")) + (the bim name of unit editor's lengthUnit)
    set uiStatus to status
    set selected to the bim selection description of editor
    if (editor's selectionKind = bim imported picked) and imported's valid:
        set importIndex to (editor's selectionId - (the bim imported id base)) as an integer
        if (importIndex >= 0) and (importIndex < (the length of (imported's labels's values))):
            set selected to (the string form of "imported ") + (the item at importIndex in (imported's labels's values))
    if (the length of importMessage) > 0:
        draw bim label importMessage at (layout's planRight + 16.0) and (layout's top + 42.0) using typeface in frame
    if (editor's selectionKind = bim imported picked) and ((the length of selected) > 0):
        set uiStatus to (uiStatus + (the string form of "   ")) + selected
    # Tiled, the dividers between the views, lit under the pointer and while
    # dragged.
    if tiledViews:
        set dividerShade to 200
        if (dividerDragged = 1) or ((dividerDragged = 0) and ((the absolute value of (pixel's x - layout's planRight)) < 5.0)):
            draw a rectangle at x (layout's planRight - 2.0) and y layout's top with width 4 and height (layout's bottom - layout's top) in color red 6, green 150 and blue 215 in frame
        else:
            draw a rectangle at x (layout's planRight - 1.0) and y layout's top with width 2 and height (layout's bottom - layout's top) in color red dividerShade, green 205 and blue 215 in frame
        if splitViews:
            if (dividerDragged = 2) or ((dividerDragged = 0) and (((pixel's x > layout's planRight) and (pixel's y > (splitAt - 2.0))) and (pixel's y < (lowerTop + 2.0)))):
                draw a rectangle at x layout's planRight and y splitAt with width (layout's width - layout's planRight) and height 3 in color red 6, green 150 and blue 215 in frame
            else:
                draw a rectangle at x layout's planRight and y splitAt with width (layout's width - layout's planRight) and height 3 in color red dividerShade, green 205 and blue 215 in frame
    # An open graphics menu, over its view.
    if graphicsMenu = 1:
        draw bim graphics menu from (layout's planRight - 334.0) above (layout's bottom - 26.0) flat true sketchy (bim view editor's planViewId is sketchy in editor's documentValue's current) along (bim view editor's planViewId hatches along objects in editor's documentValue's current) shadows false using typeface in frame
    if graphicsMenu = 2:
        draw bim graphics menu from (layout's width - 334.0) above (lowerLayout's bottom - 26.0) flat true sketchy (bim view editor's sectionViewId is sketchy in editor's documentValue's current) along (bim view editor's sectionViewId hatches along objects in editor's documentValue's current) shadows false using typeface in frame
    if graphicsMenu = 3:
        draw bim graphics menu from (layout's width - 234.0) above (viewLayout's bottom - 26.0) flat false sketchy false along false shadows shadowsOn using typeface in frame
    # The chrome, over the edges of the panels; what a click there hits is
    # handled at the next press.
    set prompt to editor's message
    if (the length of editor's numeric) > 0:
        set prompt to (the string form of "Length: ") + editor's numeric
    set uiHit to draw bim ribbon of tab ribbonTab under (the item at ribbonTab in ribbonSubs) folded ribbonFolded for editor pointing at pixel's x and pixel's y across windowWidth using typeface in frame
    draw bim document bar named filePath across windowWidth folded ribbonFolded using typeface in frame
    set chromeBottom to the bim ui canvas top folded ribbonFolded
    # The selection's actions float over the canvas, centred on the active
    # view.
    set toolbarMiddle to (layout's planLeft + layout's width) * 0.5
    if tiledViews:
        set toolbarMiddle to (layout's planLeft + layout's planRight) * 0.5
    set toolbarHit to draw bim selection toolbar of editor centred on toolbarMiddle at (layout's top + 10.0) pointing at pixel's x and pixel's y using typeface in frame
    if toolbarHit's inChrome:
        set uiHit to toolbarHit
    set railHit to draw bim rail from chromeBottom down to layout's bottom browsing browserOpen on browserGroup with properties propertiesShown pointing at pixel's x and pixel's y using typeface in frame
    if railHit's inChrome:
        set uiHit to railHit
    if browserOpen:
        set explorerHit to draw bim explorer of editor closing browserClosed scrolled browserScroll choosing typeSelectorOpen pointing at pixel's x and pixel's y below chromeBottom down to layout's bottom using typeface in frame
        if explorerHit's inChrome:
            set uiHit to explorerHit
    if propertiesShown:
        set propertiesHit to draw bim properties of editor scrolled propertiesScroll choosing typeSelectorOpen folding headingsClosed pointing at pixel's x and pixel's y from layout's width below chromeBottom down to layout's bottom using typeface in frame
        if propertiesHit's inChrome:
            set uiHit to propertiesHit
    draw bim command line saying prompt and status uiStatus in windowWidth by layout's height using typeface in frame
    if rulesOpen:
        set rulesHit to draw bim drawing rules of editor choosing rulesTypeId on tab rulesTab renaming rulesRenaming as rulesText across windowWidth by layout's height pointing at pixel's x and pixel's y using typeface in frame
    set snapHover to draw bim snap toggles of editor grid gridShown in windowWidth by layout's height pointing at pixel's x and pixel's y using typeface in frame
    set contextHover to -1
    if contextOpen:
        set contextRows to the bim context entries of editor
        set contextCorner to the bim context menu corner of contextRows opened at contextAt's x and contextAt's y within windowWidth by layout's height
        set contextHover to draw bim context menu contextRows cornered at contextCorner for editor pointing at pixel's x and pixel's y using typeface in frame
        free contextRows
    set frameMicroseconds to (the bim microseconds now) - frameStarted
    display frame
free previousKeys
release bim text atlas typeface
close window
