            set editor's extending to (key 340 is down in window) or (key 344 is down in window)
            set editedFound to the bim mesh index of editor's editSketchId in editor's documentValue's current
            if editedFound's valid:
                set editedMesh to the item at editedFound's position in (editor's documentValue's current's meshes's values)
                set nearestPoint to -1
                set nearestGap to 9.0
                loop pointCursor from 0 to the length of (editedMesh's vertices's values):
                    set onScreen to the bim pixel of mesh point (the item at pointCursor in (editedMesh's vertices's values)) of editor in viewLayout with camera in view true
                    set gap to the cad distance from onScreen to pixel
                    if gap < nearestGap:
                        set nearestGap to gap
                        set nearestPoint to pointCursor
                if nearestPoint >= 0:
                    pick bim editor mesh point nearestPoint in (the address of editor)
                else:
                    set faceRay to the bim view ray through pixel in viewLayout with camera
                    set faceHit to the bim pick along faceRay among (shownMeshes's values) in editor's documentValue's current with (editor's spaces's values)
                    set hitFace to -1
                    if (faceHit's kind = bim mesh picked) and (faceHit's id = editedMesh's id):
                        set hitSpot to the cad sum of faceRay's origin and (faceRay's direction scaled by faceHit's distance)
                        set hitFace to the bim face of mesh editedMesh through (a cad vector3 with x hitSpot's x, y hitSpot's y and z (hitSpot's z - (the bim storey elevation of editor)))
                    if hitFace >= 0:
                        pick bim editor mesh face hitFace in (the address of editor)
                    else:
                        if editor's extending = false:
                            set editor's editPicked to a cad topology list of an integer
                        set editor's message to the string form of "Nothing picked"
            set editor's extending to false
        # The line tool on a mesh face's outline: the first click starts a line
        # across the face, the second, on the same face, cuts it there.
        if editor's tool != bim line tool:
            set meshLineActive to false
        if ((editor's tool = bim line tool) and meshLineHover) and (clickHandled = false):
            set clickHandled to true
            if (meshLineActive and (meshLineId = meshLineHoverId)) and (meshLineFace = meshLineHoverFace):
                ignore split bim editor mesh meshLineId face meshLineFace from meshLineSpot to meshLineHoverSpot in (the address of editor)
                set meshLineActive to false
            else:
                set lineMeshId to meshLineHoverId
                # A line begun on a mass makes it a mesh, with the same faces.
                if meshLineHoverMass:
                    begin bim transaction in (the address of (editor's documentValue))
                    set lineMeshId to make bim mesh of mass meshLineHoverId in (the address of (editor's documentValue's current))
                    if lineMeshId = the bim refused id:
                        roll back bim transaction in (the address of (editor's documentValue))
                    else:
                        commit bim transaction in (the address of (editor's documentValue))
                set meshLineActive to lineMeshId != the bim refused id
                set meshLineId to lineMeshId
                set meshLineFace to meshLineHoverFace
                set meshLineSpot to meshLineHoverSpot
                set meshLineZ to meshLineHoverZ
                set editor's message to the string form of "Line on a face: click a second point on the same face's outline"
        else if (editor's tool = bim line tool) and (clickHandled = false):
            set meshLineActive to false
        # A push/pull on a face of a mesh pushes that face along its normal.
        if ((editor's tool = bim push tool) and (editor's pushId = the bim refused id)) and (clickHandled = false):
            set meshRay to the bim view ray through pixel in viewLayout with camera
            set meshHit to the bim pick along meshRay among (shownMeshes's values) in editor's documentValue's current with (editor's spaces's values)
            if meshHit's kind = bim mesh picked:
                set hitMeshFound to the bim mesh index of meshHit's id in editor's documentValue's current
                if hitMeshFound's valid:
                    set hitMesh to the item at hitMeshFound's position in (editor's documentValue's current's meshes's values)
                    set floorZ to the bim storey elevation of editor
                    set levelFound to the bim level index of hitMesh's levelId in editor's documentValue's current
                    if levelFound's valid:
                        set floorZ to (the item at levelFound's position in (editor's documentValue's current's levels's values))'s elevation
                    set hitSpot to the cad sum of meshRay's origin and (meshRay's direction scaled by meshHit's distance)
                    set hitFace to the bim face of mesh hitMesh through (a cad vector3 with x hitSpot's x, y hitSpot's y and z (hitSpot's z - floorZ))
                    if hitFace >= 0:
                        set faceNormal to the bim normal of mesh face hitFace of hitMesh
                        set fromPixel to the bim view point (hitSpot's x) (hitSpot's y) (hitSpot's z) in viewLayout with camera
                        set toPixel to the bim view point (hitSpot's x + faceNormal's x) (hitSpot's y + faceNormal's y) (hitSpot's z + faceNormal's z) in viewLayout with camera
                        set meshPushStep to a cad vector2 with x (toPixel's x - fromPixel's x) and y (toPixel's y - fromPixel's y)
                        start bim editor push of mesh hitMesh's id face hitFace in (the address of editor)
                        set clickHandled to true
        # A push/pull that starts on a mass's side pushes that side, as in
