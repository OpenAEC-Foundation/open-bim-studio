# SPDX-License-Identifier: MPL-2.0
# Lightweight cosmetic thread: one helix, never a swept thread solid.
# Pitch is a visual approximation, not a manufacturing specification.
import examples/bim-slice/connections.dl

function the bim cosmetic helix of {connection fastener:fastener}:
    execute:
        set points to a cad topology list of a cad vector3
        set axisLength to the cad length of fastener's axis
        if ((axisLength < 1e-9) or (fastener's diameter <= 0.0)) or (fastener's length <= 0.0):
            return points
        set forward to fastener's axis scaled by (1.0 / axisLength)
        set across to the cad cross of (a cad vector3 with x 0.0, y 0.0 and z 1.0) and forward
        if (the cad length of across) < 1e-9:
            set across to a cad vector3 with x 1.0, y 0.0 and z 0.0
        else:
            set across to across scaled by (1.0 / (the cad length of across))
        set upward to the cad cross of forward and across
        # Bound detail to the first two diameters (192 segments maximum).
        # Anchor origins are at the exposed end above the base plate.
        set threadLength to the minimum of fastener's length and (fastener's diameter * 2.0)
        set pitch to fastener's diameter * 0.125
        set radius to fastener's diameter * 0.505
        set steps to 192
        loop cursor from 0 to (steps + 1):
            set distance to threadLength * ((cursor as a 64 bit floating-point number) / (steps as a 64 bit floating-point number))
            set angle to (distance / pitch) * 6.283185307179586
            set radial to the cad sum of (across scaled by (radius * (the cosine of angle))) and (upward scaled by (radius * (the sine of angle)))
            set point to the cad sum of fastener's origin and (the cad sum of (forward scaled by distance) and radial)
            append point to (points's values)
        return points
