# SPDX-License-Identifier: MPL-2.0
# View-bound source artwork, stored as ordinary native/IFCX properties.
# Each ordered property in OpenBIM_VectorTriangles contains RGB followed by
# model-space triangle corners. Source artwork is deliberately separate from
# editable building geometry; it is never evaluated or uploaded to the 3D scene.
import examples/bim-slice/bim_vector_data.dl
import examples/bim-slice/bim_view.dl
import examples/bim-slice/bim_canvas.dl

function record bim decoded vector {bim vector batch record:batch} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        if batch's valid = false:
            return false
        set pixels to an empty list of a cad vector2
        loop cursor from 0 to the length of (batch's corners's values):
            append (the bim pixel of (the item at cursor in (batch's corners's values)) through transform) to pixels
        record bim triangles pixels coloured batch's red, batch's green and batch's blue on canvas
        free pixels
        return true

function record bim vector batch {a string:payload} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        set decodedValue to the bim decoded vector payload named (the string form of "") for (0 as a 64 bit integer)
        return record bim decoded vector decodedValue through transform on canvas

function record cached bim vectors of view {a 64 bit integer:viewId} in {bim vector cache record:cache} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        loop cursor from 0 to the length of (cache's batches's values):
            set batch to the item at cursor in (cache's batches's values)
            if batch's viewId = viewId:
                ignore (record bim decoded vector batch through transform on canvas)

function record bim vector reference of view {a 64 bit integer:viewId} in {bim model record:modelValue} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        loop cursor from 0 to the length of (modelValue's properties's values):
            set entry to the item at cursor in (modelValue's properties's values)
            if (entry's elementId = viewId) and (entry's setName = (the string form of "OpenBIM_VectorTriangles")):
                ignore (record bim vector batch entry's value through transform on canvas)

function bim sheet {a 64 bit integer:sheetId} uses source artwork in {bim model record:modelValue}:
    execute:
        return (the bim property value (the string form of "SourceArtwork") of set (the string form of "OpenBIM_Drawing") of sheetId in modelValue) = (the string form of "true")

# A custom sheet frame can accompany editable model viewports. It only
# replaces the standard border/legend/title, not the model drawing itself.
function bim sheet {a 64 bit integer:sheetId} has a custom frame in {bim model record:modelValue}:
    execute:
        if bim sheet sheetId uses source artwork in modelValue:
            return true
        return (the bim property value (the string form of "CustomFrame") of set (the string form of "OpenBIM_Drawing") of sheetId in modelValue) = (the string form of "true")
