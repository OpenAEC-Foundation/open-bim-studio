local function a bim ribbon button {a string:label} sending {integer:command} with icon {integer:picture}:
    execute:
        return @intrinsic("construct", a bim ribbon button record, label, command, picture, false)

local function a small bim ribbon button {a string:label} sending {integer:command} with icon {integer:picture}:
    execute:
        return @intrinsic("construct", a bim ribbon button record, label, command, picture, true)

local function a bim ribbon group titled {a string:title}:
    execute:
        return @intrinsic("construct", a bim ribbon group record, title, an empty list of a bim ribbon button record)

# The sub-tabs of ribbon tab `chosenTab`, the first showing every group;
# none for a tab with few groups.
function the bim ribbon subtab names of tab {integer:chosenTab}:
    execute:
        set labels to an empty list of a string
        if chosenTab = 0:
            append (the string form of "All") to labels
            append (the string form of "Architecture") to labels
            append (the string form of "Structure") to labels
        if chosenTab = 2:
            append (the string form of "All") to labels
            append (the string form of "Draw") to labels
            append (the string form of "Components") to labels
        if chosenTab = 5:
            append (the string form of "All") to labels
            append (the string form of "Create") to labels
            append (the string form of "Graphics") to labels
            append (the string form of "Navigate") to labels
        if chosenTab = 7:
            append (the string form of "All") to labels
            append (the string form of "Exchange") to labels
            append (the string form of "Coordinate") to labels
        return labels

# The sub-tab (its index) group `title` of tab `chosenTab` belongs to; 0 for
# a group shown under every sub-tab.
function the bim subtab of group {a string:title} in tab {integer:chosenTab}:
    execute:
        if chosenTab = 0:
            if ((title = (the string form of "Build")) or (title = (the string form of "Openings"))) or (title = (the string form of "Circulation")):
                return 1
            if (title = (the string form of "Structure")) or (title = (the string form of "Linear")):
                return 2
        if chosenTab = 2:
            if (title = (the string form of "Draw")) or (title = (the string form of "Edit")):
                return 1
            if (title = (the string form of "Components")) or (title = (the string form of "Solids")):
                return 2
        if chosenTab = 5:
            if ((title = (the string form of "Create")) or (title = (the string form of "Drawing types"))) or (title = (the string form of "Sheets")):
                return 1
            if ((title = (the string form of "Display")) or (title = (the string form of "3D mode"))) or (title = (the string form of "Phasing")):
                return 2
            if (title = (the string form of "Windows")) or (title = (the string form of "Storey")):
                return 3
        if chosenTab = 7:
            if (title = (the string form of "Import")) or (title = (the string form of "Export")):
                return 1
            if title = (the string form of "Coordinate"):
                return 2
        return 0

function the bim ribbon tab names:
    execute:
        set labels to an empty list of a string
        append (the string form of "BIM") to labels
        append (the string form of "MEP") to labels
        append (the string form of "Sketch") to labels
        append (the string form of "Modify") to labels
        append (the string form of "Annotate") to labels
        append (the string form of "View") to labels
        append (the string form of "Manage") to labels
        append (the string form of "Collaborate") to labels
        append (the string form of "Reinforcement") to labels
        append (the string form of "Connections") to labels
        return labels

# The groups of ribbon tab `chosenTab` (0 to 9, as `the bim ribbon tab names`).
function the bim ribbon groups of tab {integer:chosenTab}:
    execute:
        set made to an empty list of a bim ribbon group record
        if chosenTab = 9:
            set group to a bim ribbon group titled (the string form of "Simple")
            append (a bim ribbon button (the string form of "Butt") sending 2300 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "Miter") sending 2301 with icon bim icon line) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Complex: 2-6 members")
            append (a bim ribbon button (the string form of "Node") sending 2302 with icon bim icon table) to (group's buttons)
            append (a bim ribbon button (the string form of "Plate") sending 2310 with icon bim icon wall) to (group's buttons)
            append (a bim ribbon button (the string form of "Bolts") sending 2311 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "Screws") sending 2312 with icon bim icon line) to (group's buttons)
            append group to made
        if chosenTab = 8:
            set group to a bim ribbon group titled (the string form of "Reinforcement")
            append (a bim ribbon button (the string form of "Bar") sending 2200 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "L bar") sending 2203 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "U bar") sending 2204 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "Cage") sending 2201 with icon bim icon wall) to (group's buttons)
            append (a bim ribbon button (the string form of "Mesh") sending 2202 with icon bim icon table) to (group's buttons)
            append (a bim ribbon button (the string form of "Area") sending 2205 with icon bim icon floor) to (group's buttons)
            append group to made
        if chosenTab = 0:
            set group to a bim ribbon group titled (the string form of "Select")
            append (a bim ribbon button (the string form of "Select") sending 83 with icon bim icon select) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Build")
            append (a bim ribbon button (the string form of "Wall") sending 87 with icon bim icon wall) to (group's buttons)
            append (a bim ribbon button (the string form of "Floor") sending 66 with icon bim icon floor) to (group's buttons)
            append (a bim ribbon button (the string form of "Roof") sending 2080 with icon bim icon roof) to (group's buttons)
            append (a bim ribbon button (the string form of "Ceiling") sending 2081 with icon bim icon floor) to (group's buttons)
            append (a bim ribbon button (the string form of "Building system CW") sending 2112 with icon bim icon facade) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Openings")
            append (a bim ribbon button (the string form of "Window") sending 79 with icon bim icon window) to (group's buttons)
            append (a bim ribbon button (the string form of "Door") sending 68 with icon bim icon door) to (group's buttons)
            append (a small bim ribbon button (the string form of "NL doors") sending 2134 with icon bim icon door) to (group's buttons)
            append (a bim ribbon button (the string form of "Opening") sending -1 with icon bim icon opening) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Structure")
            append (a bim ribbon button (the string form of "Grid") sending 73 with icon bim icon grid) to (group's buttons)
            append (a bim ribbon button (the string form of "Column") sending 2070 with icon bim icon column) to (group's buttons)
            append (a bim ribbon button (the string form of "Beam") sending 2071 with icon bim icon beam) to (group's buttons)
            append (a bim ribbon button (the string form of "Pile PI") sending 2077 with icon bim icon column) to (group's buttons)
            append (a small bim ribbon button (the string form of "EU steel") sending 2135 with icon bim icon beam) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Linear")
            append (a bim ribbon button (the string form of "Mullion") sending 2072 with icon bim icon column) to (group's buttons)
            append (a bim ribbon button (the string form of "Skirting") sending 2073 with icon bim icon beam) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Circulation")
            append (a bim ribbon button (the string form of "Stair ST") sending 2099 with icon bim icon layers) to (group's buttons)
            append (a bim ribbon button (the string form of "Railing RL") sending 2110 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "On stair RS") sending 2111 with icon bim icon line) to (group's buttons)
            append group to made
        # Building services: pipes, ducts and cable trays (linear elements
        # joined by fittings) and the systems they belong to.
        if chosenTab = 1:
            set group to a bim ribbon group titled (the string form of "Piping")
            append (a bim ribbon button (the string form of "Pipe") sending 2074 with icon bim icon beam) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "HVAC")
            append (a bim ribbon button (the string form of "Duct") sending 2075 with icon bim icon beam) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Electrical")
            append (a bim ribbon button (the string form of "Cable tray") sending 2076 with icon bim icon beam) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Systems")
            append (a bim ribbon button (the string form of "System SY") sending 2113 with icon bim icon layers) to (group's buttons)
            append group to made
        if chosenTab = 2:
            set group to a bim ribbon group titled (the string form of "Draw")
            append (a bim ribbon button (the string form of "Line") sending 78 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "Rectangle") sending 82 with icon bim icon rectangle) to (group's buttons)
            append (a bim ribbon button (the string form of "Text") sending ((bim ui control command) + 84) with icon bim icon text) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Edit")
            append (a bim ribbon button (the string form of "Push/Pull") sending 80 with icon bim icon push) to (group's buttons)
            append (a bim ribbon button (the string form of "Move") sending 77 with icon bim icon move) to (group's buttons)
            append (a bim ribbon button (the string form of "Delete") sending 261 with icon bim icon delete) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Components")
            append (a bim ribbon button (the string form of "Make") sending ((bim ui control command) + 71) with icon bim icon component) to (group's buttons)
            append (a bim ribbon button (the string form of "Place") sending ((bim ui control command) + 73) with icon bim icon place) to (group's buttons)
            append (a bim ribbon button (the string form of "Edit") sending ((bim ui control command) + 69) with icon bim icon component) to (group's buttons)
            append (a bim ribbon button (the string form of "Explode") sending ((bim ui control command) + 85) with icon bim icon explode) to (group's buttons)
            append (a bim ribbon button (the string form of "Detail DC") sending 2116 with icon bim icon component) to (group's buttons)
            append group to made
            # Solid parts of a component, as B-rep: drawn into the selected
            # instance's component, or into a new one.
            set group to a bim ribbon group titled (the string form of "Solids")
            append (a bim ribbon button (the string form of "Box BX") sending 2100 with icon bim icon cube) to (group's buttons)
            append (a bim ribbon button (the string form of "Cylinder CY") sending 2101 with icon bim icon column) to (group's buttons)
            append (a bim ribbon button (the string form of "Sphere SH") sending 2102 with icon bim icon component) to (group's buttons)
            append (a bim ribbon button (the string form of "Add") sending 2104 with icon bim icon push) to (group's buttons)
            append (a bim ribbon button (the string form of "Cut") sending 2105 with icon bim icon delete) to (group's buttons)
            append (a bim ribbon button (the string form of "Intersect") sending 2106 with icon bim icon layers) to (group's buttons)
            append group to made
        if chosenTab = 3:
            set group to a bim ribbon group titled (the string form of "Modify")
            append (a bim ribbon button (the string form of "Move G") sending 77 with icon bim icon move) to (group's buttons)
            append (a bim ribbon button (the string form of "Copy CO") sending 2002 with icon bim icon component) to (group's buttons)
            append (a bim ribbon button (the string form of "Similar CS") sending 2001 with icon bim icon select) to (group's buttons)
            append (a bim ribbon button (the string form of "Delete") sending 261 with icon bim icon delete) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Edit")
            append (a bim ribbon button (the string form of "Rotate RO") sending 2010 with icon bim icon redo) to (group's buttons)
            append (a bim ribbon button (the string form of "Mirror MM") sending 2011 with icon bim icon move) to (group's buttons)
            append (a bim ribbon button (the string form of "Trim TR") sending 2012 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "Extend EX") sending 2013 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "Offset OF") sending 2014 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "Align AL") sending 2024 with icon bim icon line) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "History")
            append (a bim ribbon button (the string form of "Undo") sending 90 with icon bim icon undo) to (group's buttons)
            append (a bim ribbon button (the string form of "Redo") sending 89 with icon bim icon redo) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Window type")
            append (a bim ribbon button (the string form of "Narrower") sending 91 with icon bim icon window) to (group's buttons)
            append (a bim ribbon button (the string form of "Wider") sending 93 with icon bim icon window) to (group's buttons)
            append (a bim ribbon button (the string form of "Lower") sending 59 with icon bim icon window) to (group's buttons)
            append (a bim ribbon button (the string form of "Higher") sending 39 with icon bim icon window) to (group's buttons)
            append group to made
        if chosenTab = 4:
            set group to a bim ribbon group titled (the string form of "Annotate")
            append (a bim ribbon button (the string form of "Dimension DI") sending 2015 with icon bim icon dimension) to (group's buttons)
            append (a bim ribbon button (the string form of "Text") sending 1084 with icon bim icon text) to (group's buttons)
            append (a bim ribbon button (the string form of "Tag TG") sending 2030 with icon bim icon text) to (group's buttons)
            append (a bim ribbon button (the string form of "Tag all TA") sending 2031 with icon bim icon text) to (group's buttons)
            append group to made
        if chosenTab = 5:
            set group to a bim ribbon group titled (the string form of "Create")
            append (a bim ribbon button (the string form of "Section") sending 67 with icon bim icon section) to (group's buttons)
            append (a bim ribbon button (the string form of "Area plan") sending 2122 with icon bim icon table) to (group's buttons)
