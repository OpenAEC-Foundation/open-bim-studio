            append group to made
        if chosenTab = 6:
            set group to a bim ribbon group titled (the string form of "File")
            append (a bim ribbon button (the string form of "Save") sending ((bim ui control command) + 83) with icon bim icon save) to (group's buttons)
            append (a bim ribbon button (the string form of "Open") sending ((bim ui control command) + 79) with icon bim icon open) to (group's buttons)
            append group to made
