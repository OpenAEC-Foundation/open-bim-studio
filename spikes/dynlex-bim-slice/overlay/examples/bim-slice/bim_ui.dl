# SPDX-License-Identifier: MPL-2.0
# The application frame of the BIM slice, after the Open BIM Studio frontend
# that adapts Open CAD Studio's interface (`OpenCADStudio/docs/open-bim-ui.md`
# in the workspace): the Fusion Black chrome (background #1A1A1A, text
# #F2F2F2, accent #0696D7) around a white model canvas.
#
# - A top bar with quick-access buttons and the ribbon's tabs.
# - The ribbon: per tab, groups of large tool buttons. A button sends the
#   editor the command its key sends; tools the editor does not have yet are
#   shown dimmed.
# - A project explorer on the left (244 pixels): the project's storeys (a
#   click makes one active), its views and the selected element's properties.
# - A command line and a status bar at the bottom.
import examples/bim-slice/bim_editor.dl
import examples/bim-slice/bim_text.dl

function bim ui top bar height:
    replacement:
        30.0
function bim ui ribbon height:
    replacement:
        92.0
function bim ui document bar height:
    replacement:
        24.0
function bim ui explorer width:
    replacement:
        244.0
function bim ui command line height:
    replacement:
        24.0
function bim ui status bar height:
    replacement:
        28.0

# Where the canvas starts below the chrome.
function bim ui canvas top:
    replacement:
        ((bim ui top bar height + bim ui ribbon height) + bim ui document bar height)

# Where the canvas ends above the chrome, in a window `height` high.
function the bim ui canvas bottom in {a 64 bit floating-point number:height}:
    execute:
        return (height - (bim ui command line height)) - (bim ui status bar height)

# Commands with Ctrl held are their key code plus this.
function bim ui control command:
    replacement:
        1000

# One ribbon button: its label, the command (a key code, or a key code plus
# `bim ui control command` for Ctrl, or -1 for a tool not available yet) and
# the icon drawn on it.
class:
    patterns:
        [a|] bim ribbon button record
    members:
        label as a string
        command as an integer
        icon as an integer

class:
    patterns:
        [a|] bim ribbon group record
    members:
        title as a string
        buttons as the type of (an empty list of a bim ribbon button record)

# The icons.
function bim icon select:
    replacement:
        0
function bim icon wall:
    replacement:
        1
function bim icon floor:
    replacement:
        2
function bim icon roof:
    replacement:
        3
function bim icon window:
    replacement:
        4
function bim icon door:
    replacement:
        5
function bim icon opening:
    replacement:
        6
function bim icon grid:
    replacement:
        7
function bim icon column:
    replacement:
        8
function bim icon beam:
    replacement:
        9
function bim icon section:
    replacement:
        10
function bim icon cube:
    replacement:
        11
function bim icon eye:
    replacement:
        12
function bim icon table:
    replacement:
        13
function bim icon layers:
    replacement:
        14
function bim icon fit:
    replacement:
        15
function bim icon undo:
    replacement:
        16
function bim icon redo:
    replacement:
        17
function bim icon delete:
    replacement:
        18
function bim icon save:
    replacement:
        19
function bim icon open:
    replacement:
        20
function bim icon export:
    replacement:
        21
function bim icon up:
    replacement:
        22
function bim icon down:
    replacement:
        23
function bim icon move:
    replacement:
        24
function bim icon text:
    replacement:
        25
function bim icon dimension:
    replacement:
        26
function bim icon facade:
    replacement:
        27
function bim icon line:
    replacement:
        28
function bim icon rectangle:
    replacement:
        29
function bim icon push:
    replacement:
        30
function bim icon component:
    replacement:
        31
function bim icon place:
    replacement:
        32
function bim icon explode:
    replacement:
        33

local function a bim ribbon button {a string:label} sending {integer:command} with icon {integer:picture}:
    execute:
        return @intrinsic("construct", a bim ribbon button record, label, command, picture)

local function a bim ribbon group titled {a string:title}:
    execute:
        return @intrinsic("construct", a bim ribbon group record, title, an empty list of a bim ribbon button record)

function the bim ribbon tab names:
    execute:
        set labels to an empty list of a string
        append (the string form of "BIM") to labels
        append (the string form of "Sketch") to labels
        append (the string form of "Modify") to labels
        append (the string form of "Annotate") to labels
        append (the string form of "View") to labels
        append (the string form of "Manage") to labels
        return labels

# The groups of ribbon tab `tab` (0 to 4).
function the bim ribbon groups of tab {integer:chosenTab}:
    execute:
        set made to an empty list of a bim ribbon group record
        if chosenTab = 0:
            set group to a bim ribbon group titled (the string form of "Select")
            append (a bim ribbon button (the string form of "Select") sending 83 with icon bim icon select) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Planar")
            append (a bim ribbon button (the string form of "Wall") sending 87 with icon bim icon wall) to (group's buttons)
            append (a bim ribbon button (the string form of "Floor") sending 66 with icon bim icon floor) to (group's buttons)
            append (a bim ribbon button (the string form of "Roof") sending -1 with icon bim icon roof) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Objects")
            append (a bim ribbon button (the string form of "Window") sending 79 with icon bim icon window) to (group's buttons)
            append (a bim ribbon button (the string form of "Door") sending 68 with icon bim icon door) to (group's buttons)
            append (a bim ribbon button (the string form of "Opening") sending -1 with icon bim icon opening) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Linear")
            append (a bim ribbon button (the string form of "Grid") sending 73 with icon bim icon grid) to (group's buttons)
            append (a bim ribbon button (the string form of "Column") sending 2100 with icon bim icon column) to (group's buttons)
            append (a bim ribbon button (the string form of "Beam") sending 2101 with icon bim icon beam) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Steel")
            append (a bim ribbon button (the string form of "Brace") sending 2102 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "Join") sending 2103 with icon bim icon beam) to (group's buttons)
            append (a bim ribbon button (the string form of "Swap") sending 2104 with icon bim icon redo) to (group's buttons)
            append (a bim ribbon button (the string form of "Turn") sending 2105 with icon bim icon redo) to (group's buttons)
            append (a bim ribbon button (the string form of "Justify") sending 2106 with icon bim icon move) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Systems")
            append (a bim ribbon button (the string form of "Facade") sending -1 with icon bim icon facade) to (group's buttons)
            append group to made
        if chosenTab = 1:
            set group to a bim ribbon group titled (the string form of "Draw")
            append (a bim ribbon button (the string form of "Line") sending 78 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "Rectangle") sending 82 with icon bim icon rectangle) to (group's buttons)
            append (a bim ribbon button (the string form of "Text") sending ((bim ui control command) + 84) with icon bim icon text) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Edit")
            append (a bim ribbon button (the string form of "Push/Pull") sending 80 with icon bim icon push) to (group's buttons)
            append (a bim ribbon button (the string form of "Move") sending 77 with icon bim icon move) to (group's buttons)
            append (a bim ribbon button (the string form of "Delete") sending 261 with icon bim icon delete) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Components")
            append (a bim ribbon button (the string form of "Make") sending ((bim ui control command) + 71) with icon bim icon component) to (group's buttons)
            append (a bim ribbon button (the string form of "Place") sending ((bim ui control command) + 73) with icon bim icon place) to (group's buttons)
            append (a bim ribbon button (the string form of "Edit") sending ((bim ui control command) + 69) with icon bim icon component) to (group's buttons)
            append (a bim ribbon button (the string form of "Explode") sending ((bim ui control command) + 85) with icon bim icon explode) to (group's buttons)
            append group to made
        if chosenTab = 2:
            set group to a bim ribbon group titled (the string form of "Modify")
            append (a bim ribbon button (the string form of "Move G") sending 77 with icon bim icon move) to (group's buttons)
            append (a bim ribbon button (the string form of "Copy CO") sending 2002 with icon bim icon component) to (group's buttons)
            append (a bim ribbon button (the string form of "Similar CS") sending 2001 with icon bim icon select) to (group's buttons)
            append (a bim ribbon button (the string form of "Delete") sending 261 with icon bim icon delete) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Edit")
            append (a bim ribbon button (the string form of "Rotate RO") sending 2010 with icon bim icon redo) to (group's buttons)
            append (a bim ribbon button (the string form of "Mirror MM") sending 2011 with icon bim icon move) to (group's buttons)
            append (a bim ribbon button (the string form of "Trim TR") sending 2012 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "Extend EX") sending 2013 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "Offset OF") sending 2014 with icon bim icon line) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "History")
            append (a bim ribbon button (the string form of "Undo") sending 90 with icon bim icon undo) to (group's buttons)
            append (a bim ribbon button (the string form of "Redo") sending 89 with icon bim icon redo) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Window type")
            append (a bim ribbon button (the string form of "Narrower") sending 91 with icon bim icon window) to (group's buttons)
            append (a bim ribbon button (the string form of "Wider") sending 93 with icon bim icon window) to (group's buttons)
            append (a bim ribbon button (the string form of "Lower") sending 59 with icon bim icon window) to (group's buttons)
            append (a bim ribbon button (the string form of "Higher") sending 39 with icon bim icon window) to (group's buttons)
            append group to made
        if chosenTab = 3:
            set group to a bim ribbon group titled (the string form of "Annotate")
            append (a bim ribbon button (the string form of "Section") sending 67 with icon bim icon section) to (group's buttons)
            append (a bim ribbon button (the string form of "Dimension") sending -1 with icon bim icon dimension) to (group's buttons)
            append (a bim ribbon button (the string form of "Text") sending -1 with icon bim icon text) to (group's buttons)
            append group to made
        if chosenTab = 4:
            set group to a bim ribbon group titled (the string form of "Panels")
            append (a bim ribbon button (the string form of "3D/Section") sending 86 with icon bim icon cube) to (group's buttons)
            append (a bim ribbon button (the string form of "Schedule") sending 84 with icon bim icon table) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Display")
            append (a bim ribbon button (the string form of "Visibility") sending 76 with icon bim icon eye) to (group's buttons)
            append (a bim ribbon button (the string form of "Detail") sending 75 with icon bim icon layers) to (group's buttons)
            append (a bim ribbon button (the string form of "Fit") sending 70 with icon bim icon fit) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "3D mode")
            append (a bim ribbon button (the string form of "Shaded") sending ((bim ui control command) + 49) with icon bim icon cube) to (group's buttons)
            append (a bim ribbon button (the string form of "Edges") sending ((bim ui control command) + 50) with icon bim icon cube) to (group's buttons)
            append (a bim ribbon button (the string form of "Hidden line") sending ((bim ui control command) + 51) with icon bim icon layers) to (group's buttons)
            append (a bim ribbon button (the string form of "Wireframe") sending ((bim ui control command) + 52) with icon bim icon grid) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Storey")
            append (a bim ribbon button (the string form of "Up") sending 266 with icon bim icon up) to (group's buttons)
            append (a bim ribbon button (the string form of "Down") sending 267 with icon bim icon down) to (group's buttons)
            append group to made
        if chosenTab = 5:
            set group to a bim ribbon group titled (the string form of "File")
            append (a bim ribbon button (the string form of "Save") sending ((bim ui control command) + 83) with icon bim icon save) to (group's buttons)
            append (a bim ribbon button (the string form of "Open") sending ((bim ui control command) + 79) with icon bim icon open) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Exchange")
            append (a bim ribbon button (the string form of "IFC export") sending 88 with icon bim icon export) to (group's buttons)
            append (a bim ribbon button (the string form of "IFC5 export") sending ((bim ui control command) + 88) with icon bim icon export) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Units")
            append (a bim ribbon button (the string form of "mm") sending 2050 with icon bim icon dimension) to (group's buttons)
            append (a bim ribbon button (the string form of "cm") sending 2051 with icon bim icon dimension) to (group's buttons)
            append (a bim ribbon button (the string form of "m") sending 2052 with icon bim icon dimension) to (group's buttons)
            append group to made
        return made

# ---------------------------------------------------------------- drawing

local function draw bim ui rectangle {a 64 bit floating-point number:left} {a 64 bit floating-point number:top} {a 64 bit floating-point number:across} {a 64 bit floating-point number:tall} coloured {integer:r}, {integer:g} and {integer:b} in {graphics frame:frame}:
    execute:
        draw a rectangle at x left and y top with width across and height tall in color red r, green g and blue b in frame

# A line `breadth` pixels wide from `ax`, `ay` to `bx`, `by`.
local function draw bim ui line from {a 64 bit floating-point number:ax} {a 64 bit floating-point number:ay} to {a 64 bit floating-point number:bx} {a 64 bit floating-point number:by} wide {a 64 bit floating-point number:breadth} coloured {integer:r}, {integer:g} and {integer:b} in {graphics frame:frame}:
    execute:
        set dx to bx - ax
        set dy to by - ay
        set magnitude to the square root of ((dx * dx) + (dy * dy))
        if magnitude <= 0.0:
            return nothing
        set ox to (0.0 - dy) * (breadth / (2.0 * magnitude))
        set oy to dx * (breadth / (2.0 * magnitude))
        start triangles in frame
        use vertex color red r, green g and blue b in frame
        add a vertex at x (ax + ox) and y (ay + oy) to frame
        add a vertex at x (ax - ox) and y (ay - oy) to frame
        add a vertex at x (bx + ox) and y (by + oy) to frame
        add a vertex at x (bx + ox) and y (by + oy) to frame
        add a vertex at x (ax - ox) and y (ay - oy) to frame
        add a vertex at x (bx - ox) and y (by - oy) to frame
        finish triangles in frame

# An outlined rectangle.
local function draw bim ui frame {a 64 bit floating-point number:left} {a 64 bit floating-point number:top} {a 64 bit floating-point number:across} {a 64 bit floating-point number:tall} coloured {integer:r}, {integer:g} and {integer:b} in {graphics frame:frame}:
    execute:
        draw bim ui line from left top to (left + across) top wide 1.5 coloured r, g and b in frame
        draw bim ui line from (left + across) top to (left + across) (top + tall) wide 1.5 coloured r, g and b in frame
        draw bim ui line from (left + across) (top + tall) to left (top + tall) wide 1.5 coloured r, g and b in frame
        draw bim ui line from left (top + tall) to left top wide 1.5 coloured r, g and b in frame

# The icon `icon` in the 32 x 32 box at `x`, `y`.
function draw bim icon {integer:glyph} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} coloured {integer:r}, {integer:g} and {integer:b} in {graphics frame:frame}:
    execute:
        if glyph = bim icon select:
            draw bim ui line from (x + 8.0) (y + 4.0) to (x + 8.0) (y + 26.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from (x + 8.0) (y + 4.0) to (x + 24.0) (y + 20.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from (x + 8.0) (y + 26.0) to (x + 14.0) (y + 20.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from (x + 14.0) (y + 20.0) to (x + 24.0) (y + 20.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from (x + 15.0) (y + 21.0) to (x + 20.0) (y + 29.0) wide 2.0 coloured r, g and b in frame
        if glyph = bim icon wall:
            draw bim ui rectangle (x + 3.0) (y + 6.0) 26.0 7.0 coloured r, g and b in frame
            draw bim ui rectangle (x + 3.0) (y + 15.0) 26.0 3.0 coloured r, g and b in frame
            draw bim ui rectangle (x + 3.0) (y + 20.0) 26.0 7.0 coloured r, g and b in frame
        if glyph = bim icon floor:
            draw bim ui line from (x + 2.0) (y + 20.0) to (x + 12.0) (y + 12.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from (x + 12.0) (y + 12.0) to (x + 30.0) (y + 12.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from (x + 30.0) (y + 12.0) to (x + 20.0) (y + 20.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from (x + 20.0) (y + 20.0) to (x + 2.0) (y + 20.0) wide 2.0 coloured r, g and b in frame
            draw bim ui rectangle (x + 2.0) (y + 20.0) 18.0 5.0 coloured r, g and b in frame
        if glyph = bim icon roof:
            draw bim ui line from (x + 2.0) (y + 18.0) to (x + 16.0) (y + 5.0) wide 2.5 coloured r, g and b in frame
            draw bim ui line from (x + 16.0) (y + 5.0) to (x + 30.0) (y + 18.0) wide 2.5 coloured r, g and b in frame
            draw bim ui frame (x + 7.0) (y + 17.0) 18.0 11.0 coloured r, g and b in frame
        if glyph = bim icon window:
            draw bim ui frame (x + 5.0) (y + 4.0) 22.0 24.0 coloured r, g and b in frame
            draw bim ui line from (x + 16.0) (y + 4.0) to (x + 16.0) (y + 28.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 5.0) (y + 15.0) to (x + 27.0) (y + 15.0) wide 1.5 coloured r, g and b in frame
        if glyph = bim icon door:
            draw bim ui frame (x + 8.0) (y + 3.0) 16.0 26.0 coloured r, g and b in frame
            draw bim ui rectangle (x + 19.0) (y + 15.0) 3.0 3.0 coloured r, g and b in frame
        if glyph = bim icon opening:
            draw bim ui frame (x + 4.0) (y + 6.0) 24.0 20.0 coloured r, g and b in frame
            draw bim ui line from (x + 4.0) (y + 6.0) to (x + 28.0) (y + 26.0) wide 1.0 coloured r, g and b in frame
            draw bim ui line from (x + 28.0) (y + 6.0) to (x + 4.0) (y + 26.0) wide 1.0 coloured r, g and b in frame
        if glyph = bim icon grid:
            draw bim ui line from (x + 16.0) (y + 12.0) to (x + 16.0) (y + 31.0) wide 1.5 coloured r, g and b in frame
            draw bim ui frame (x + 9.0) (y + 1.0) 14.0 12.0 coloured r, g and b in frame
            draw bim ui line from (x + 2.0) (y + 22.0) to (x + 30.0) (y + 22.0) wide 1.0 coloured r, g and b in frame
        if glyph = bim icon column:
            draw bim ui rectangle (x + 11.0) (y + 3.0) 10.0 26.0 coloured r, g and b in frame
        if glyph = bim icon beam:
            draw bim ui rectangle (x + 2.0) (y + 12.0) 28.0 8.0 coloured r, g and b in frame
        if glyph = bim icon section:
            draw bim ui line from (x + 4.0) (y + 28.0) to (x + 28.0) (y + 4.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from (x + 4.0) (y + 28.0) to (x + 4.0) (y + 18.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from (x + 28.0) (y + 4.0) to (x + 28.0) (y + 14.0) wide 2.0 coloured r, g and b in frame
        if glyph = bim icon cube:
            draw bim ui line from (x + 16.0) (y + 3.0) to (x + 28.0) (y + 9.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 28.0) (y + 9.0) to (x + 28.0) (y + 23.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 28.0) (y + 23.0) to (x + 16.0) (y + 29.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 16.0) (y + 29.0) to (x + 4.0) (y + 23.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 4.0) (y + 23.0) to (x + 4.0) (y + 9.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 4.0) (y + 9.0) to (x + 16.0) (y + 3.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 4.0) (y + 9.0) to (x + 16.0) (y + 15.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 16.0) (y + 15.0) to (x + 28.0) (y + 9.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 16.0) (y + 15.0) to (x + 16.0) (y + 29.0) wide 1.5 coloured r, g and b in frame
        if glyph = bim icon eye:
            draw bim ui line from (x + 2.0) (y + 16.0) to (x + 16.0) (y + 7.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 16.0) (y + 7.0) to (x + 30.0) (y + 16.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 30.0) (y + 16.0) to (x + 16.0) (y + 25.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 16.0) (y + 25.0) to (x + 2.0) (y + 16.0) wide 1.5 coloured r, g and b in frame
            draw bim ui rectangle (x + 13.0) (y + 13.0) 6.0 6.0 coloured r, g and b in frame
        if glyph = bim icon table:
            draw bim ui frame (x + 3.0) (y + 5.0) 26.0 22.0 coloured r, g and b in frame
            draw bim ui line from (x + 3.0) (y + 12.0) to (x + 29.0) (y + 12.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 3.0) (y + 19.0) to (x + 29.0) (y + 19.0) wide 1.0 coloured r, g and b in frame
            draw bim ui line from (x + 12.0) (y + 5.0) to (x + 12.0) (y + 27.0) wide 1.0 coloured r, g and b in frame
        if glyph = bim icon layers:
            draw bim ui rectangle (x + 4.0) (y + 4.0) 6.0 24.0 coloured 205, 140 and 115 in frame
            draw bim ui rectangle (x + 11.0) (y + 4.0) 9.0 24.0 coloured 240, 225 and 150 in frame
            draw bim ui rectangle (x + 21.0) (y + 4.0) 7.0 24.0 coloured 185, 185 and 185 in frame
        if glyph = bim icon fit:
            draw bim ui line from (x + 3.0) (y + 3.0) to (x + 11.0) (y + 3.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from (x + 3.0) (y + 3.0) to (x + 3.0) (y + 11.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from (x + 29.0) (y + 29.0) to (x + 21.0) (y + 29.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from (x + 29.0) (y + 29.0) to (x + 29.0) (y + 21.0) wide 2.0 coloured r, g and b in frame
            draw bim ui frame (x + 10.0) (y + 10.0) 12.0 12.0 coloured r, g and b in frame
        if (glyph = bim icon undo) or (glyph = bim icon redo):
            set sign to 1.0
            set base to x + 6.0
            if glyph = bim icon redo:
                set sign to -1.0
                set base to x + 26.0
            draw bim ui line from base (y + 12.0) to (base + (sign * 14.0)) (y + 12.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from (base + (sign * 14.0)) (y + 12.0) to (base + (sign * 20.0)) (y + 18.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from (base + (sign * 20.0)) (y + 18.0) to (base + (sign * 14.0)) (y + 25.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from base (y + 12.0) to (base + (sign * 6.0)) (y + 6.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from base (y + 12.0) to (base + (sign * 6.0)) (y + 18.0) wide 2.0 coloured r, g and b in frame
        if glyph = bim icon delete:
            draw bim ui line from (x + 7.0) (y + 7.0) to (x + 25.0) (y + 25.0) wide 3.0 coloured 229, 57 and 53 in frame
            draw bim ui line from (x + 25.0) (y + 7.0) to (x + 7.0) (y + 25.0) wide 3.0 coloured 229, 57 and 53 in frame
        if glyph = bim icon save:
            draw bim ui frame (x + 4.0) (y + 4.0) 24.0 24.0 coloured r, g and b in frame
            draw bim ui rectangle (x + 9.0) (y + 4.0) 14.0 8.0 coloured r, g and b in frame
            draw bim ui frame (x + 8.0) (y + 17.0) 16.0 11.0 coloured r, g and b in frame
        if glyph = bim icon open:
            draw bim ui line from (x + 3.0) (y + 8.0) to (x + 12.0) (y + 8.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from (x + 12.0) (y + 8.0) to (x + 15.0) (y + 11.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from (x + 15.0) (y + 11.0) to (x + 29.0) (y + 11.0) wide 2.0 coloured r, g and b in frame
            draw bim ui frame (x + 3.0) (y + 8.0) 26.0 19.0 coloured r, g and b in frame
        if glyph = bim icon export:
            draw bim ui frame (x + 4.0) (y + 10.0) 18.0 18.0 coloured r, g and b in frame
            draw bim ui line from (x + 14.0) (y + 18.0) to (x + 28.0) (y + 4.0) wide 2.0 coloured 6, 150 and 215 in frame
            draw bim ui line from (x + 28.0) (y + 4.0) to (x + 20.0) (y + 4.0) wide 2.0 coloured 6, 150 and 215 in frame
            draw bim ui line from (x + 28.0) (y + 4.0) to (x + 28.0) (y + 12.0) wide 2.0 coloured 6, 150 and 215 in frame
        if (glyph = bim icon up) or (glyph = bim icon down):
            set tip to y + 6.0
            set tail to y + 26.0
            if glyph = bim icon down:
                set tip to y + 26.0
                set tail to y + 6.0
            draw bim ui line from (x + 16.0) tail to (x + 16.0) tip wide 2.5 coloured r, g and b in frame
            draw bim ui line from (x + 16.0) tip to (x + 8.0) (tip + ((tail - tip) * 0.4)) wide 2.5 coloured r, g and b in frame
            draw bim ui line from (x + 16.0) tip to (x + 24.0) (tip + ((tail - tip) * 0.4)) wide 2.5 coloured r, g and b in frame
        if glyph = bim icon move:
            draw bim ui line from (x + 16.0) (y + 3.0) to (x + 16.0) (y + 29.0) wide 2.0 coloured r, g and b in frame
            draw bim ui line from (x + 3.0) (y + 16.0) to (x + 29.0) (y + 16.0) wide 2.0 coloured r, g and b in frame
        if glyph = bim icon text:
            draw bim ui line from (x + 6.0) (y + 6.0) to (x + 26.0) (y + 6.0) wide 3.0 coloured r, g and b in frame
            draw bim ui line from (x + 16.0) (y + 6.0) to (x + 16.0) (y + 27.0) wide 3.0 coloured r, g and b in frame
        if glyph = bim icon dimension:
            draw bim ui line from (x + 3.0) (y + 18.0) to (x + 29.0) (y + 18.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 3.0) (y + 10.0) to (x + 3.0) (y + 26.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 29.0) (y + 10.0) to (x + 29.0) (y + 26.0) wide 1.5 coloured r, g and b in frame
        if glyph = bim icon line:
            draw bim ui line from (x + 5.0) (y + 26.0) to (x + 27.0) (y + 6.0) wide 2.0 coloured r, g and b in frame
            draw bim ui rectangle (x + 3.0) (y + 24.0) 4.0 4.0 coloured r, g and b in frame
            draw bim ui rectangle (x + 25.0) (y + 4.0) 4.0 4.0 coloured r, g and b in frame
        if glyph = bim icon rectangle:
            draw bim ui frame (x + 4.0) (y + 7.0) 24.0 18.0 coloured r, g and b in frame
        if glyph = bim icon push:
            draw bim ui line from (x + 4.0) (y + 24.0) to (x + 14.0) (y + 18.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 14.0) (y + 18.0) to (x + 28.0) (y + 24.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 28.0) (y + 24.0) to (x + 18.0) (y + 30.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 18.0) (y + 30.0) to (x + 4.0) (y + 24.0) wide 1.5 coloured r, g and b in frame
            draw bim ui line from (x + 16.0) (y + 20.0) to (x + 16.0) (y + 3.0) wide 2.0 coloured 6, 150 and 215 in frame
            draw bim ui line from (x + 16.0) (y + 3.0) to (x + 11.0) (y + 8.0) wide 2.0 coloured 6, 150 and 215 in frame
            draw bim ui line from (x + 16.0) (y + 3.0) to (x + 21.0) (y + 8.0) wide 2.0 coloured 6, 150 and 215 in frame
        if glyph = bim icon component:
            draw bim ui frame (x + 4.0) (y + 10.0) 14.0 14.0 coloured r, g and b in frame
            draw bim ui frame (x + 14.0) (y + 4.0) 14.0 14.0 coloured 6, 150 and 215 in frame
            draw bim ui line from (x + 4.0) (y + 10.0) to (x + 14.0) (y + 4.0) wide 1.0 coloured r, g and b in frame
            draw bim ui line from (x + 18.0) (y + 24.0) to (x + 28.0) (y + 18.0) wide 1.0 coloured r, g and b in frame
        if glyph = bim icon place:
            draw bim ui frame (x + 3.0) (y + 14.0) 10.0 10.0 coloured r, g and b in frame
            draw bim ui frame (x + 19.0) (y + 14.0) 10.0 10.0 coloured 6, 150 and 215 in frame
            draw bim ui line from (x + 16.0) (y + 4.0) to (x + 16.0) (y + 12.0) wide 2.0 coloured 6, 150 and 215 in frame
            draw bim ui line from (x + 12.0) (y + 8.0) to (x + 20.0) (y + 8.0) wide 2.0 coloured 6, 150 and 215 in frame
        if glyph = bim icon explode:
            draw bim ui frame (x + 11.0) (y + 11.0) 10.0 10.0 coloured r, g and b in frame
            draw bim ui line from (x + 9.0) (y + 9.0) to (x + 3.0) (y + 3.0) wide 2.0 coloured 6, 150 and 215 in frame
            draw bim ui line from (x + 23.0) (y + 9.0) to (x + 29.0) (y + 3.0) wide 2.0 coloured 6, 150 and 215 in frame
            draw bim ui line from (x + 9.0) (y + 23.0) to (x + 3.0) (y + 29.0) wide 2.0 coloured 6, 150 and 215 in frame
            draw bim ui line from (x + 23.0) (y + 23.0) to (x + 29.0) (y + 29.0) wide 2.0 coloured 6, 150 and 215 in frame
        if glyph = bim icon facade:
            draw bim ui frame (x + 4.0) (y + 4.0) 24.0 24.0 coloured r, g and b in frame
            draw bim ui line from (x + 12.0) (y + 4.0) to (x + 12.0) (y + 28.0) wide 1.0 coloured r, g and b in frame
            draw bim ui line from (x + 20.0) (y + 4.0) to (x + 20.0) (y + 28.0) wide 1.0 coloured r, g and b in frame
            draw bim ui line from (x + 4.0) (y + 16.0) to (x + 28.0) (y + 16.0) wide 1.0 coloured r, g and b in frame

# The width of a ribbon button with `label`.
local function the bim ribbon button width of {a string:label} with {bim text atlas record:atlas}:
    execute:
        return the maximum of 52.0 and ((the bim text width of label in face (bim text small) of atlas) + 18.0)

# What a click at `x`, `y` hits in the chrome.
class:
    patterns:
        [a|] bim ui hit record
    members:
        command as an integer
        tab as an integer
        storey as a 64 bit integer
        inChrome as a boolean
        wallType as a 64 bit integer
        floorType as an integer
        # A project browser action (`bim browser ...`) and what it acts on.
        action as an integer
        actionId as a 64 bit integer

function no bim ui hit:
    execute:
        return @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, false, (-1) as a 64 bit integer, -1, 0, (-1) as a 64 bit integer)

# Draws the top bar and the ribbon of tab `activeTab`, the button under
# `pointerX`, `pointerY` highlighted, and returns what a click there hits.
function draw bim ribbon of tab {integer:activeTab} for {bim editor record:editor} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} across {a 64 bit floating-point number:width} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set hit to no bim ui hit
        # Top bar: quick-access buttons, then the tabs.
        draw bim ui rectangle 0.0 0.0 width (bim ui top bar height) coloured 38, 38 and 38 in frame
        set quick to an empty list of a bim ribbon button record
        append (a bim ribbon button (the string form of "Save") sending ((bim ui control command) + 83) with icon bim icon save) to quick
        append (a bim ribbon button (the string form of "Open") sending ((bim ui control command) + 79) with icon bim icon open) to quick
        append (a bim ribbon button (the string form of "Undo") sending 90 with icon bim icon undo) to quick
        append (a bim ribbon button (the string form of "Redo") sending 89 with icon bim icon redo) to quick
        set x to 8.0
        loop cursor from 0 to the length of quick:
            set button to the item at cursor in quick
            set over to ((pointerX >= x) and (pointerX < (x + 34.0))) and (pointerY < (bim ui top bar height))
            if over:
                draw bim ui rectangle x 0.0 34.0 30.0 coloured 64, 64 and 64 in frame
                set hit to @intrinsic("construct", a bim ui hit record, button's command, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, 0, (-1) as a 64 bit integer)
            draw bim icon button's icon at (x + 1.0) and -1.0 coloured 220, 220 and 220 in frame
            set x to x + 36.0
        free quick
        set x to x + 16.0
        set names to the bim ribbon tab names
        loop tabIndex from 0 to the length of names:
            set name to the item at tabIndex in names
            set tabWidth to (the bim text width of name in face (bim text body) of atlas) + 28.0
            set over to ((pointerX >= x) and (pointerX < (x + tabWidth))) and (pointerY < (bim ui top bar height))
            if tabIndex = activeTab:
                draw bim ui rectangle x 3.0 tabWidth 24.0 coloured 26, 26 and 26 in frame
                draw bim ui frame x 3.0 tabWidth 24.0 coloured 6, 150 and 215 in frame
                draw bim text name at (x + 14.0) and 20.0 in face (bim text bold) with atlas coloured 242, 242 and 242 in frame
            else:
                if over:
                    draw bim ui rectangle x 3.0 tabWidth 24.0 coloured 58, 58 and 58 in frame
                draw bim text name at (x + 14.0) and 20.0 in face (bim text body) with atlas coloured 200, 200 and 200 in frame
            if over:
                set hit to @intrinsic("construct", a bim ui hit record, -1, tabIndex, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, 0, (-1) as a 64 bit integer)
            set x to (x + tabWidth) + 4.0
        free names
        # The ribbon.
        set ribbonTop to bim ui top bar height
        draw bim ui rectangle 0.0 ribbonTop width (bim ui ribbon height) coloured 58, 58 and 58 in frame
        draw bim ui rectangle 0.0 (ribbonTop + (bim ui ribbon height) - 1.0) width 1.0 coloured 30, 30 and 30 in frame
        set tabGroups to the bim ribbon groups of tab activeTab
        set x to 6.0
        loop groupCursor from 0 to the length of tabGroups:
            set group to the item at groupCursor in tabGroups
            set groupStart to x
            loop cursor from 0 to the length of (group's buttons):
                set button to the item at cursor in (group's buttons)
                set buttonWidth to the bim ribbon button width of button's label with atlas
                set over to ((pointerX >= x) and (pointerX < (x + buttonWidth))) and ((pointerY >= ribbonTop) and (pointerY < (ribbonTop + 70.0)))
                set available to button's command >= 0
                set active to false
                if (button's command = 83) and (editor's tool = bim select tool):
                    set active to true
                if (button's command = 87) and (editor's tool = bim wall tool):
                    set active to true
                if (button's command = 79) and (editor's tool = bim opening tool):
                    set active to editor's openingTypeId = editor's windowTypeId
                if (button's command = 68) and (editor's tool = bim opening tool):
                    set active to editor's openingTypeId = editor's doorTypeId
                if (button's command = 73) and (editor's tool = bim grid tool):
                    set active to true
                if (button's command = 67) and (editor's tool = bim section tool):
                    set active to true
                if (button's command = 78) and (editor's tool = bim line tool):
                    set active to true
                if (button's command = 82) and (editor's tool = bim rectangle tool):
                    set active to true
                if (button's command = 80) and (editor's tool = bim push tool):
                    set active to true
                if (button's command = 77) and (editor's tool = bim move tool):
                    set active to true
                if (button's command = ((bim ui control command) + 84)) and (editor's tool = bim text tool):
                    set active to true
                if active:
                    draw bim ui rectangle x (ribbonTop + 4.0) buttonWidth 64.0 coloured 22, 74 and 104 in frame
                    draw bim ui frame x (ribbonTop + 4.0) buttonWidth 64.0 coloured 6, 150 and 215 in frame
                else if over and available:
                    draw bim ui rectangle x (ribbonTop + 4.0) buttonWidth 64.0 coloured 76, 76 and 76 in frame
                set shade to 230
                if available = false:
                    set shade to 120
                draw bim icon button's icon at (x + ((buttonWidth - 32.0) * 0.5)) and (ribbonTop + 8.0) coloured shade, shade and shade in frame
                set labelWidth to the bim text width of button's label in face (bim text small) of atlas
                draw bim text button's label at (x + ((buttonWidth - labelWidth) * 0.5)) and (ribbonTop + 59.0) in face (bim text small) with atlas coloured shade, shade and shade in frame
                if over and available:
                    set hit to @intrinsic("construct", a bim ui hit record, button's command, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, 0, (-1) as a 64 bit integer)
                set x to (x + buttonWidth) + 2.0
            # The group's title, centred under its buttons, and a separator.
            set titleWidth to the bim text width of group's title in face (bim text caption) of atlas
            set groupWidth to the maximum of (x - groupStart) and (titleWidth + 12.0)
            set x to groupStart + groupWidth
            draw bim text group's title at (groupStart + ((groupWidth - titleWidth) * 0.5)) and (ribbonTop + 84.0) in face (bim text caption) with atlas coloured 160, 160 and 160 in frame
            draw bim ui rectangle (x + 3.0) (ribbonTop + 8.0) 1.0 (bim ui ribbon height - 16.0) coloured 90, 90 and 90 in frame
            set x to x + 8.0
        if ((pointerY >= ribbonTop) and (pointerY < (ribbonTop + (bim ui ribbon height)))) and (hit's command < 0):
            set hit's inChrome to true
        if pointerY < (bim ui top bar height):
            set hit's inChrome to true
        return hit

# The document bar: one tab naming the open model.
function draw bim document bar named {a string:name} across {a 64 bit floating-point number:width} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set top to (bim ui top bar height) + (bim ui ribbon height)
        draw bim ui rectangle 0.0 top width (bim ui document bar height) coloured 26, 26 and 26 in frame
        set tabWidth to (the bim text width of name in face (bim text small) of atlas) + 24.0
        draw bim ui rectangle 4.0 (top + 2.0) tabWidth ((bim ui document bar height) - 2.0) coloured 6, 150 and 215 in frame
        draw bim text name at 16.0 and (top + 17.0) in face (bim text small) with atlas coloured 255, 255 and 255 in frame

# The project explorer: the storeys (the active one marked, a click activates
# one), the views and the selected element's properties. Returns what a click
# at the pointer hits.
# The project browser's actions.
function bim browser toggle:
    replacement:
        1
function bim browser plan:
    replacement:
        2
function bim browser model view:
    replacement:
        3
function bim browser section view:
    replacement:
        4
function bim browser schedule view:
    replacement:
        5
function bim browser opening type:
    replacement:
        6
function bim browser component:
    replacement:
        7
# A steel profile family opens or closes (the id is its index among the
# families), a profile becomes current (its index in the library), a
# connection becomes current (its index among the connection templates).
function bim browser profile family:
    replacement:
        8
function bim browser profile:
    replacement:
        9
function bim browser connection:
    replacement:
        10
# A connection type parameter of the selected joint stepped down or up: the
# id is twice the parameter's index, plus 1 for up.
function bim browser parameter:
    replacement:
        11

# The project browser's groups, by index into the open/closed flags.
function bim browser views group:
    replacement:
        0
function bim browser plans group:
    replacement:
        1
function bim browser families group:
    replacement:
        2
function bim browser walls group:
    replacement:
        3
function bim browser floors group:
    replacement:
        4
function bim browser openings group:
    replacement:
        5
function bim browser components group:
    replacement:
        6
function bim browser profiles group:
    replacement:
        7
function bim browser connections group:
    replacement:
        8
function the bim browser group count:
    replacement:
        9

# One row of the project browser at `rowTop` (scrolled), `depth` steps in:
# drawn when it lies between `top` and `limit`, highlighted when `current`,
# with a + or - when it is a group (`expander` 1 closed, 0 open, -1 none).
# Whether the pointer is over it.
local function draw bim browser row {a string:label} at {a 64 bit floating-point number:rowTop} depth {integer:indent} current {boolean:isCurrent} expander {integer:expanderState} between {a 64 bit floating-point number:top} and {a 64 bit floating-point number:limit} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        if (rowTop < top) or ((rowTop + 20.0) > limit):
            return false
        set panelWidth to bim ui explorer width
        set over to ((pointerX < panelWidth) and (pointerY >= rowTop)) and (pointerY < (rowTop + 20.0))
        if isCurrent:
            draw bim ui rectangle 6.0 rowTop (panelWidth - 12.0) 20.0 coloured 22, 74 and 104 in frame
        else if over:
            draw bim ui rectangle 6.0 rowTop (panelWidth - 12.0) 20.0 coloured 50, 50 and 50 in frame
        set x to 10.0 + ((indent as a 64 bit floating-point number) * 14.0)
        if expanderState >= 0:
            set sign to the string form of "-"
            if expanderState = 1:
                set sign to the string form of "+"
            draw bim text sign at x and (rowTop + 15.0) in face (bim text bold) with atlas coloured 150, 150 and 150 in frame
        if (expanderState >= 0) and (indent = 0):
            draw bim text label at (x + 14.0) and (rowTop + 15.0) in face (bim text caption) with atlas coloured 170, 170 and 170 in frame
        else:
            draw bim text label at (x + 14.0) and (rowTop + 15.0) in face (bim text small) with atlas coloured 230, 230 and 230 in frame
        return over

# The project browser, as in Revit: the views (floor plans per storey, the 3D
# view, the section, the schedule) and the families (wall, floor, door and
# window types, components), in groups that open and close (`closed`, one flag
# per group), scrolled up by `scrolled` pixels; then the selection's
# properties. A click opens a view, makes a type current, or starts placing a
# component.
function draw bim explorer of {bim editor record:editor} closing {a pointer to a list:closed} scrolled {a 64 bit floating-point number:scrolled} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} down to {a 64 bit floating-point number:bottom} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set hit to no bim ui hit
        set top to bim ui canvas top
        set panelWidth to bim ui explorer width
        draw bim ui rectangle 0.0 top panelWidth (bottom - top) coloured 26, 26 and 26 in frame
        draw bim ui rectangle (panelWidth - 1.0) top 1.0 (bottom - top) coloured 64, 64 and 64 in frame
        if (pointerX < panelWidth) and ((pointerY >= top) and (pointerY < bottom)):
            set hit's inChrome to true
        draw bim text (the string form of "PROJECT BROWSER") at 12.0 and (top + 22.0) in face (bim text bold) with atlas coloured 242, 242 and 242 in frame
        # The tree takes the panel down to the properties.
        set treeTop to top + 32.0
        set treeLimit to bottom - 150.0
        if editor's selectionKind = bim joint picked:
            set treeLimit to bottom - 330.0
        set y to treeTop - scrolled
        set modelValue to editor's documentValue's current
        set rows to 0
        # Views.
        set groupOpen to (the item at bim browser views group in closed) = false
        set marker to 0
        if groupOpen = false:
            set marker to 1
        if draw bim browser row (the string form of "VIEWS") at y depth 0 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
            set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser views group) as a 64 bit integer)
        set y to y + 20.0
        if groupOpen:
            set plansOpen to (the item at bim browser plans group in closed) = false
            set marker to 0
            if plansOpen = false:
                set marker to 1
            if draw bim browser row (the string form of "Floor plans") at y depth 1 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser plans group) as a 64 bit integer)
            set y to y + 20.0
            if plansOpen:
                # Highest storey first, as in a section through the building.
                set levels to modelValue's levels's values
                set levelIndex to (the length of levels) - 1
                loop while levelIndex >= 0:
                    set level to the item at levelIndex in levels
                    if draw bim browser row level's name at y depth 2 current (level's id = editor's levelId) expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                        set hit to @intrinsic("construct", a bim ui hit record, -1, -1, level's id, true, (-1) as a 64 bit integer, -1, bim browser plan, level's id)
                    set y to y + 20.0
                    set levelIndex to levelIndex - 1
            if draw bim browser row (the string form of "3D view") at y depth 1 current false expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser model view, (-1) as a 64 bit integer)
            set y to y + 20.0
            if editor's hasSection:
                if draw bim browser row (the string form of "Section") at y depth 1 current false expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                    set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser section view, (-1) as a 64 bit integer)
                set y to y + 20.0
            if draw bim browser row (the string form of "Schedule: quantities") at y depth 1 current false expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser schedule view, (-1) as a 64 bit integer)
            set y to y + 20.0
        # Families.
        set groupOpen to (the item at bim browser families group in closed) = false
        set marker to 0
        if groupOpen = false:
            set marker to 1
        if draw bim browser row (the string form of "FAMILIES") at y depth 0 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
            set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser families group) as a 64 bit integer)
        set y to y + 20.0
        if groupOpen:
            # Wall types; the current one is the selected wall's, if any.
            set currentType to editor's wallTypeId
            if editor's selectionKind = bim wall picked:
                set selectedWall to the bim wall index of editor's selectionId in modelValue
                if selectedWall's valid:
                    set currentType to (the item at selectedWall's position in (modelValue's walls's values))'s typeId
            set wallsOpen to (the item at bim browser walls group in closed) = false
            set marker to 0
            if wallsOpen = false:
                set marker to 1
            if draw bim browser row ((the string form of "Walls (") + ((the string form of (the length of (modelValue's wallTypes's values))) + (the string form of ")"))) at y depth 1 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser walls group) as a 64 bit integer)
            set y to y + 20.0
            if wallsOpen:
                loop typeIndex from 0 to the length of (modelValue's wallTypes's values):
                    set wallType to the item at typeIndex in (modelValue's wallTypes's values)
                    set millimetres to ((the bim thickness of wallType) * 1000.0) + 0.5
                    set label to (wallType's name + (the string form of "  ")) + ((the string form of (millimetres as an integer)) + (the string form of " mm"))
                    if draw bim browser row label at y depth 2 current (wallType's id = currentType) expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                        set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, wallType's id, -1, 0, (-1) as a 64 bit integer)
                    set y to y + 20.0
            set floorsOpen to (the item at bim browser floors group in closed) = false
            set marker to 0
            if floorsOpen = false:
                set marker to 1
            if draw bim browser row (the string form of "Floors") at y depth 1 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser floors group) as a 64 bit integer)
            set y to y + 20.0
            if floorsOpen:
                set floorTypes to the bim floor types
                loop typeIndex from 0 to the length of floorTypes:
                    if draw bim browser row (the item at typeIndex in floorTypes)'s name at y depth 2 current (typeIndex = editor's floorTypeIndex) expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                        set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, typeIndex, 0, (-1) as a 64 bit integer)
                    set y to y + 20.0
            set openingsOpen to (the item at bim browser openings group in closed) = false
            set marker to 0
            if openingsOpen = false:
                set marker to 1
            if draw bim browser row (the string form of "Doors and windows") at y depth 1 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser openings group) as a 64 bit integer)
            set y to y + 20.0
            if openingsOpen:
                loop typeIndex from 0 to the length of (modelValue's openingTypes's values):
                    set openingType to the item at typeIndex in (modelValue's openingTypes's values)
                    if draw bim browser row openingType's name at y depth 2 current (openingType's id = editor's openingTypeId) expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                        set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser opening type, openingType's id)
                    set y to y + 20.0
            set componentsOpen to (the item at bim browser components group in closed) = false
            set marker to 0
            if componentsOpen = false:
                set marker to 1
            if draw bim browser row ((the string form of "Components (") + ((the string form of (the length of (modelValue's components's values))) + (the string form of ")"))) at y depth 1 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser components group) as a 64 bit integer)
            set y to y + 20.0
            if componentsOpen:
                loop typeIndex from 0 to the length of (modelValue's components's values):
                    set definition to the item at typeIndex in (modelValue's components's values)
                    if draw bim browser row definition's name at y depth 2 current (definition's id = editor's placeComponentId) expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                        set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser component, definition's id)
                    set y to y + 20.0
            # Profiles (steel, timber, concrete) by family; the open family lists its sizes, the
            # current one the selected member's or new members'.
            set profilesOpen to (the item at bim browser profiles group in closed) = false
            set marker to 0
            if profilesOpen = false:
                set marker to 1
            if draw bim browser row ((the string form of "Profiles (") + ((the string form of (the length of (editor's profiles's values))) + (the string form of ")"))) at y depth 1 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser profiles group) as a 64 bit integer)
            set y to y + 20.0
            if profilesOpen:
                set currentProfile to the bim current profile name of editor
                if editor's selectionKind = bim member picked:
                    set selectedMember to the bim member choice of editor's selectionId in modelValue
                    if selectedMember's valid:
                        set currentProfile to selectedMember's profile's name
                set families to the bim profile families of editor
                loop familyIndex from 0 to the length of families:
                    set family to the item at familyIndex in families
                    set familyMarker to 1
                    if family = editor's profileFamily:
                        set familyMarker to 0
                    if draw bim browser row family at y depth 2 current false expander familyMarker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                        set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser profile family, familyIndex as a 64 bit integer)
                    set y to y + 20.0
                    if family = editor's profileFamily:
                        loop profileIndex from 0 to the length of (editor's profiles's values):
                            set profile to the item at profileIndex in (editor's profiles's values)
                            if profile's family = family:
                                if draw bim browser row profile's name at y depth 3 current (profile's name = currentProfile) expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                                    set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser profile, profileIndex as a 64 bit integer)
                                set y to y + 20.0
            # Connections; the current one the selected joint's or new joints'.
            set connectionsOpen to (the item at bim browser connections group in closed) = false
            set marker to 0
            if connectionsOpen = false:
                set marker to 1
            if draw bim browser row (the string form of "Connections") at y depth 1 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser connections group) as a 64 bit integer)
            set y to y + 20.0
            if connectionsOpen:
                set currentConnection to the bim current connection name of editor
                if editor's selectionKind = bim joint picked:
                    set selectedJoint to the bim joint index of editor's selectionId in modelValue
                    if selectedJoint's valid:
                        set jointTypeFound to the bim connection type index of (the item at selectedJoint's position in (modelValue's joints's values))'s typeId in modelValue
                        if jointTypeFound's valid:
                            set currentConnection to (the item at jointTypeFound's position in (modelValue's connectionTypes's values))'s name
                set templates to the bim connection templates
                loop templateIndex from 0 to the length of templates:
                    set template to the item at templateIndex in templates
                    if draw bim browser row template's name at y depth 2 current (template's name = currentConnection) expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                        set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser connection, templateIndex as a 64 bit integer)
                    set y to y + 20.0
                free templates
        # The properties of the selection, under the tree.
        set y to treeLimit + 22.0
        draw bim ui rectangle 0.0 treeLimit panelWidth 1.0 coloured 64, 64 and 64 in frame
        draw bim text (the string form of "PROPERTIES") at 12.0 and y in face (bim text caption) with atlas coloured 150, 150 and 150 in frame
        set y to y + 20.0
        set description to the bim selection description of editor
        if (the length of description) = 0:
            set description to the string form of "Nothing selected"
        # The description wrapped at commas into lines that fit the panel.
        set line to the string form of ""
        set position to 0
        loop while position < the length of description:
            set character to the character at position in description
            set line to line + (the string form of (the substring of description from position spanning 1 bytes))
            set full to ((the bim text width of line in atlas) >= 190.0) and (character = 32)
            if (character = 44) or full:
                if y < (bottom - 8.0):
                    draw bim text line at 20.0 and y with atlas coloured 230, 230 and 230 in frame
                set y to y + 18.0
                set line to the string form of ""
            set position to position + 1
        if ((the length of line) > 0) and (y < (bottom - 8.0)):
            draw bim text line at 20.0 and y with atlas coloured 230, 230 and 230 in frame
        # The selected joint's type parameters, each with a step down and up.
        if editor's selectionKind = bim joint picked:
            set jointFound to the bim joint index of editor's selectionId in modelValue
            if jointFound's valid:
                set typeFound to the bim connection type index of (the item at jointFound's position in (modelValue's joints's values))'s typeId in modelValue
                if typeFound's valid:
                    set connection to the item at typeFound's position in (modelValue's connectionTypes's values)
                    set y to y + 22.0
                    draw bim text (the string form of "TYPE PARAMETERS") at 12.0 and y in face (bim text caption) with atlas coloured 150, 150 and 150 in frame
                    loop parameterIndex from 0 to the length of (connection's parameters's values):
                        set y to y + 18.0
                        if y < (bottom - 8.0):
                            set entry to the item at parameterIndex in (connection's parameters's values)
                            set valueText to the bim parameter text of entry's value named entry's name
                            draw bim text ((entry's name + (the string form of ": ")) + valueText) at 20.0 and y in face (bim text small) with atlas coloured 230, 230 and 230 in frame
                            loop button from 0 to 2:
                                set buttonLeft to panelWidth - 44.0
                                set glyph to the string form of "-"
                                if button = 1:
                                    set buttonLeft to panelWidth - 24.0
                                    set glyph to the string form of "+"
                                set buttonTop to y - 12.0
                                set over to ((pointerX >= buttonLeft) and (pointerX < (buttonLeft + 18.0))) and ((pointerY >= buttonTop) and (pointerY < (buttonTop + 16.0)))
                                if over:
                                    draw bim ui rectangle buttonLeft buttonTop 18.0 16.0 coloured 70, 90 and 120 in frame
                                    set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser parameter, ((parameterIndex * 2) + button) as a 64 bit integer)
                                else:
                                    draw bim ui rectangle buttonLeft buttonTop 18.0 16.0 coloured 52, 52 and 52 in frame
                                draw bim text glyph at (buttonLeft + 6.0) and (y + 1.0) in face (bim text bold) with atlas coloured 242, 242 and 242 in frame
        return hit

# The command line (`prompt` and the typed input) and the status bar.
function draw bim command line saying {a string:prompt} and status {a string:statusText} in {a 64 bit floating-point number:width} by {a 64 bit floating-point number:height} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set lineTop to the bim ui canvas bottom in height
        draw bim ui rectangle 0.0 lineTop width (bim ui command line height) coloured 34, 34 and 34 in frame
        draw bim text (the string form of "Command:") at 10.0 and (lineTop + 17.0) in face (bim text bold) with atlas coloured 6, 150 and 215 in frame
        draw bim text prompt at 90.0 and (lineTop + 17.0) with atlas coloured 242, 242 and 242 in frame
        set barTop to lineTop + (bim ui command line height)
        draw bim ui rectangle 0.0 barTop width (bim ui status bar height) coloured 26, 26 and 26 in frame
        draw bim text statusText at 10.0 and (barTop + 18.0) in face (bim text small) with atlas coloured 200, 200 and 200 in frame
