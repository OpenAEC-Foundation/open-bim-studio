local function a bim ribbon button {a string:label} sending {integer:command} with icon {integer:picture}:
    execute:
        return @intrinsic("construct", a bim ribbon button record, label, command, picture, false, the string form of "")

local function a small bim ribbon button {a string:label} sending {integer:command} with icon {integer:picture}:
    execute:
        return @intrinsic("construct", a bim ribbon button record, label, command, picture, true, the string form of "")

local function a bim ribbon button {a string:label} keyed {a string:letters} sending {integer:command} with icon {integer:picture}:
    execute:
        return @intrinsic("construct", a bim ribbon button record, label, command, picture, false, letters)

local function a small bim ribbon button {a string:label} keyed {a string:letters} sending {integer:command} with icon {integer:picture}:
    execute:
        return @intrinsic("construct", a bim ribbon button record, label, command, picture, true, letters)

local function a bim ribbon group titled {a string:title}:
    execute:
        return @intrinsic("construct", a bim ribbon group record, title, an empty list of a bim ribbon button record)

# The sub-tabs of ribbon tab `chosenTab`, the first showing every group;
# none for a tab with few groups.
function the bim ribbon subtab names of tab {integer:chosenTab}:
    execute:
        set labels to an empty list of a string
        if chosenTab = 0:
            append (the string form of "All") to labels
            append (the string form of "Architecture") to labels
            append (the string form of "Structure") to labels
        if chosenTab = 2:
            append (the string form of "All") to labels
            append (the string form of "Draw") to labels
            append (the string form of "Components") to labels
        if chosenTab = 5:
            append (the string form of "All") to labels
            append (the string form of "Create") to labels
            append (the string form of "Graphics") to labels
            append (the string form of "Navigate") to labels
        if chosenTab = 7:
            append (the string form of "All") to labels
            append (the string form of "Exchange") to labels
            append (the string form of "Coordinate") to labels
        return labels

# The sub-tab (its index) group `title` of tab `chosenTab` belongs to; 0 for
# a group shown under every sub-tab.
function the bim subtab of group {a string:title} in tab {integer:chosenTab}:
    execute:
        if chosenTab = 0:
            if ((title = (the string form of "Build")) or (title = (the string form of "Openings"))) or (title = (the string form of "Circulation")):
                return 1
            if (title = (the string form of "Structure")) or (title = (the string form of "Linear")):
                return 2
        if chosenTab = 2:
            if (title = (the string form of "Draw")) or (title = (the string form of "Edit")):
                return 1
            if (title = (the string form of "Components")) or (title = (the string form of "Solids")):
                return 2
        if chosenTab = 5:
            if ((title = (the string form of "Create")) or (title = (the string form of "Drawing types"))) or (title = (the string form of "Sheets")):
                return 1
            if ((title = (the string form of "Display")) or (title = (the string form of "3D mode"))) or (title = (the string form of "Phasing")):
                return 2
            if (title = (the string form of "Windows")) or (title = (the string form of "Storey")):
                return 3
        if chosenTab = 7:
            if (title = (the string form of "Import")) or (title = (the string form of "Export")):
                return 1
            if title = (the string form of "Coordinate"):
                return 2
        return 0

function the bim ribbon tab names:
    execute:
        set labels to an empty list of a string
        append (the string form of "BIM") to labels
        append (the string form of "MEP") to labels
        append (the string form of "Sketch") to labels
        append (the string form of "Modify") to labels
        append (the string form of "Annotate") to labels
        append (the string form of "View") to labels
        append (the string form of "Manage") to labels
        append (the string form of "Collaborate") to labels
        append (the string form of "Reinforcement") to labels
        append (the string form of "Connections") to labels
        return labels

# The groups of ribbon tab `chosenTab` (0 to 9, as `the bim ribbon tab names`).
function the bim ribbon groups of tab {integer:chosenTab}:
    execute:
        set made to an empty list of a bim ribbon group record
        if chosenTab = 9:
            set group to a bim ribbon group titled (the string form of "Simple")
            append (a bim ribbon button (the string form of "Butt") sending 2300 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "Miter") sending 2301 with icon bim icon line) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Complex: 2-6 members")
            append (a bim ribbon button (the string form of "Node") sending 2302 with icon bim icon table) to (group's buttons)
            append (a bim ribbon button (the string form of "Plate") sending 2310 with icon bim icon wall) to (group's buttons)
            append (a bim ribbon button (the string form of "Bolts") sending 2311 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "Screws") sending 2312 with icon bim icon line) to (group's buttons)
            append group to made
        if chosenTab = 8:
            set group to a bim ribbon group titled (the string form of "Reinforcement")
            append (a bim ribbon button (the string form of "Bar") sending 2200 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "L bar") sending 2203 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "U bar") sending 2204 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "Cage") sending 2201 with icon bim icon wall) to (group's buttons)
            append (a bim ribbon button (the string form of "Mesh") sending 2202 with icon bim icon table) to (group's buttons)
            append (a bim ribbon button (the string form of "Area") sending 2205 with icon bim icon floor) to (group's buttons)
            append group to made
        if chosenTab = 0:
            set group to a bim ribbon group titled (the string form of "Select")
            append (a bim ribbon button (the string form of "Select") sending 83 with icon bim icon select) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Build")
            append (a bim ribbon button (the string form of "Wall") sending 87 with icon bim icon wall) to (group's buttons)
            append (a bim ribbon button (the string form of "Floor") sending 66 with icon bim icon floor) to (group's buttons)
            append (a bim ribbon button (the string form of "Roof") sending 2080 with icon bim icon roof) to (group's buttons)
            append (a bim ribbon button (the string form of "Ceiling") sending 2081 with icon bim icon floor) to (group's buttons)
            append (a bim ribbon button (the string form of "Building system") keyed (the string form of "CW") sending 2112 with icon bim icon facade) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Openings")
            append (a bim ribbon button (the string form of "Window") sending 79 with icon bim icon window) to (group's buttons)
            append (a bim ribbon button (the string form of "Door") sending 68 with icon bim icon door) to (group's buttons)
            append (a small bim ribbon button (the string form of "NL doors") sending 2134 with icon bim icon door) to (group's buttons)
            append (a bim ribbon button (the string form of "Opening") sending -1 with icon bim icon opening) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Structure")
            append (a bim ribbon button (the string form of "Grid") sending 73 with icon bim icon grid) to (group's buttons)
            append (a bim ribbon button (the string form of "Column") sending 2070 with icon bim icon column) to (group's buttons)
            append (a bim ribbon button (the string form of "Beam") sending 2071 with icon bim icon beam) to (group's buttons)
            append (a bim ribbon button (the string form of "Pile") keyed (the string form of "PI") sending 2077 with icon bim icon pile) to (group's buttons)
            append (a small bim ribbon button (the string form of "EU steel") sending 2135 with icon bim icon beam) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Linear")
            append (a bim ribbon button (the string form of "Mullion") sending 2072 with icon bim icon column) to (group's buttons)
            append (a bim ribbon button (the string form of "Skirting") sending 2073 with icon bim icon beam) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Circulation")
            append (a bim ribbon button (the string form of "Stair") keyed (the string form of "ST") sending 2099 with icon bim icon stair) to (group's buttons)
            append (a bim ribbon button (the string form of "Railing") keyed (the string form of "RL") sending 2110 with icon bim icon railing) to (group's buttons)
            append (a bim ribbon button (the string form of "On stair") keyed (the string form of "RS") sending 2111 with icon bim icon railing) to (group's buttons)
            append group to made
        # Building services: pipes, ducts and cable trays (linear elements
        # joined by fittings) and the systems they belong to.
        if chosenTab = 1:
            set group to a bim ribbon group titled (the string form of "Piping")
            append (a bim ribbon button (the string form of "Pipe") sending 2074 with icon bim icon beam) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "HVAC")
            append (a bim ribbon button (the string form of "Duct") sending 2075 with icon bim icon beam) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Electrical")
            append (a bim ribbon button (the string form of "Cable tray") sending 2076 with icon bim icon beam) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Systems")
            append (a bim ribbon button (the string form of "System") keyed (the string form of "SY") sending 2113 with icon bim icon zone) to (group's buttons)
            append group to made
        if chosenTab = 2:
            set group to a bim ribbon group titled (the string form of "Draw")
            append (a bim ribbon button (the string form of "Line") sending 78 with icon bim icon line) to (group's buttons)
            append (a bim ribbon button (the string form of "Rectangle") sending 82 with icon bim icon rectangle) to (group's buttons)
            append (a bim ribbon button (the string form of "Text") sending ((bim ui control command) + 84) with icon bim icon text) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Edit")
            append (a bim ribbon button (the string form of "Push/Pull") sending 80 with icon bim icon push) to (group's buttons)
            append (a bim ribbon button (the string form of "Move") sending 77 with icon bim icon move) to (group's buttons)
            append (a bim ribbon button (the string form of "Delete") sending 261 with icon bim icon delete) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Components")
            append (a bim ribbon button (the string form of "Make") sending ((bim ui control command) + 71) with icon bim icon component) to (group's buttons)
            append (a bim ribbon button (the string form of "Place") sending ((bim ui control command) + 73) with icon bim icon place) to (group's buttons)
            append (a bim ribbon button (the string form of "Edit") sending ((bim ui control command) + 69) with icon bim icon component) to (group's buttons)
            append (a bim ribbon button (the string form of "Explode") sending ((bim ui control command) + 85) with icon bim icon explode) to (group's buttons)
            append (a bim ribbon button (the string form of "Detail") keyed (the string form of "DC") sending 2116 with icon bim icon detail) to (group's buttons)
            append group to made
            # Solid parts of a component, as B-rep: drawn into the selected
            # instance's component, or into a new one.
            set group to a bim ribbon group titled (the string form of "Solids")
            append (a bim ribbon button (the string form of "Box") keyed (the string form of "BX") sending 2100 with icon bim icon cube) to (group's buttons)
            append (a bim ribbon button (the string form of "Cylinder") keyed (the string form of "CY") sending 2101 with icon bim icon column) to (group's buttons)
            append (a bim ribbon button (the string form of "Sphere") keyed (the string form of "SH") sending 2102 with icon bim icon component) to (group's buttons)
            append (a bim ribbon button (the string form of "Add") sending 2104 with icon bim icon push) to (group's buttons)
            append (a bim ribbon button (the string form of "Cut") sending 2105 with icon bim icon cut) to (group's buttons)
            append (a bim ribbon button (the string form of "Intersect") sending 2106 with icon bim icon join) to (group's buttons)
            append group to made
        if chosenTab = 3:
            set group to a bim ribbon group titled (the string form of "Modify")
            append (a bim ribbon button (the string form of "Move") keyed (the string form of "G") sending 77 with icon bim icon move) to (group's buttons)
            append (a bim ribbon button (the string form of "Copy") keyed (the string form of "CO") sending 2002 with icon bim icon copy) to (group's buttons)
            append (a bim ribbon button (the string form of "Similar") keyed (the string form of "CS") sending 2001 with icon bim icon select) to (group's buttons)
            append (a bim ribbon button (the string form of "Delete") sending 261 with icon bim icon delete) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Edit")
            append (a bim ribbon button (the string form of "Rotate") keyed (the string form of "RO") sending 2010 with icon bim icon rotate) to (group's buttons)
            append (a bim ribbon button (the string form of "Mirror") keyed (the string form of "MM") sending 2011 with icon bim icon mirror) to (group's buttons)
            append (a bim ribbon button (the string form of "Trim") keyed (the string form of "TR") sending 2012 with icon bim icon trim) to (group's buttons)
            append (a bim ribbon button (the string form of "Extend") keyed (the string form of "EX") sending 2013 with icon bim icon extend) to (group's buttons)
            append (a bim ribbon button (the string form of "Offset") keyed (the string form of "OF") sending 2014 with icon bim icon offset) to (group's buttons)
            append (a bim ribbon button (the string form of "Align") keyed (the string form of "AL") sending 2024 with icon bim icon align) to (group's buttons)
            append group to made
            # Imported IFC elements become editable elements of the model's
            # own, keeping their IFC class, GlobalId, name and PSets: the
            # selected one (2170) or all of them (2171).
            set group to a bim ribbon group titled (the string form of "IFC")
            append (a bim ribbon button (the string form of "Make editable") sending 2170 with icon bim icon explode) to (group's buttons)
            append (a bim ribbon button (the string form of "All editable") sending 2171 with icon bim icon ifc import) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "History")
            append (a bim ribbon button (the string form of "Undo") sending 90 with icon bim icon undo) to (group's buttons)
            append (a bim ribbon button (the string form of "Redo") sending 89 with icon bim icon redo) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Window type")
            append (a bim ribbon button (the string form of "Narrower") sending 91 with icon bim icon window) to (group's buttons)
            append (a bim ribbon button (the string form of "Wider") sending 93 with icon bim icon window) to (group's buttons)
            append (a bim ribbon button (the string form of "Lower") sending 59 with icon bim icon window) to (group's buttons)
            append (a bim ribbon button (the string form of "Higher") sending 39 with icon bim icon window) to (group's buttons)
            append group to made
        if chosenTab = 4:
            set group to a bim ribbon group titled (the string form of "Annotate")
            append (a bim ribbon button (the string form of "Dimension") keyed (the string form of "DI") sending 2015 with icon bim icon dimension) to (group's buttons)
            append (a bim ribbon button (the string form of "Text") sending 1084 with icon bim icon text) to (group's buttons)
            append (a bim ribbon button (the string form of "Tag") keyed (the string form of "TG") sending 2030 with icon bim icon tag) to (group's buttons)
            append (a bim ribbon button (the string form of "Tag all") keyed (the string form of "TA") sending 2031 with icon bim icon tag) to (group's buttons)
            append group to made
        if chosenTab = 5:
            set group to a bim ribbon group titled (the string form of "Create")
            append (a bim ribbon button (the string form of "Section") sending 67 with icon bim icon section) to (group's buttons)
            append (a bim ribbon button (the string form of "Area plan") sending 2122 with icon bim icon space) to (group's buttons)
            append (a small bim ribbon button (the string form of "Structural plan") sending 2117 with icon bim icon plan) to (group's buttons)
            append (a small bim ribbon button (the string form of "Pile plan") sending 2118 with icon bim icon pile) to (group's buttons)
            append (a small bim ribbon button (the string form of "3D/Section") sending 86 with icon bim icon cube) to (group's buttons)
            append (a small bim ribbon button (the string form of "Schedule") sending 84 with icon bim icon schedule) to (group's buttons)
            append (a small bim ribbon button (the string form of "Duplicate") keyed (the string form of "DV") sending 2092 with icon bim icon copy) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Windows")
            append (a small bim ribbon button (the string form of "Tile") keyed (the string form of "WT") sending 2090 with icon bim icon layers) to (group's buttons)
            append (a small bim ribbon button (the string form of "Tabs") keyed (the string form of "TW") sending 2091 with icon bim icon table) to (group's buttons)
            append (a small bim ribbon button (the string form of "Crop") keyed (the string form of "CV") sending 2093 with icon bim icon fit) to (group's buttons)
            append (a small bim ribbon button (the string form of "Uncrop") keyed (the string form of "UC") sending 2094 with icon bim icon fit) to (group's buttons)
            append (a small bim ribbon button (the string form of "Zoom region") keyed (the string form of "ZR") sending 2130 with icon bim icon zoom) to (group's buttons)
            append (a small bim ribbon button (the string form of "Zoom previous") keyed (the string form of "ZP") sending 2138 with icon bim icon back) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Drawing types")
            append (a bim ribbon button (the string form of "Automatic") sending 2119 with icon bim icon layers) to (group's buttons)
            append (a bim ribbon button (the string form of "Drawing Rules") sending 2120 with icon bim icon table) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Phasing")
            append (a bim ribbon button (the string form of "Demolish") keyed (the string form of "DM") sending 2121 with icon bim icon phasing) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Sheets")
            append (a bim ribbon button (the string form of "New sheet") keyed (the string form of "NS") sending 2095 with icon bim icon sheet) to (group's buttons)
            append (a bim ribbon button (the string form of "Place view") keyed (the string form of "PV") sending 2096 with icon bim icon place) to (group's buttons)
            append (a bim ribbon button (the string form of "Place schedule") keyed (the string form of "PS") sending 2097 with icon bim icon schedule) to (group's buttons)
            append (a bim ribbon button (the string form of "Export PDF") keyed (the string form of "EP") sending 2098 with icon bim icon export) to (group's buttons)
            append (a bim ribbon button (the string form of "Export SVG") keyed (the string form of "ES") sending 2115 with icon bim icon export) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Display")
            append (a bim ribbon button (the string form of "Visibility") sending 76 with icon bim icon eye) to (group's buttons)
            append (a bim ribbon button (the string form of "Detail") sending 75 with icon bim icon detail) to (group's buttons)
            append (a bim ribbon button (the string form of "Fit") sending 70 with icon bim icon fit) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "3D mode")
            append (a bim ribbon button (the string form of "Section box") sending 2129 with icon bim icon clip box) to (group's buttons)
            append (a bim ribbon button (the string form of "Box from selection") sending 2172 with icon bim icon fit selection) to (group's buttons)
            append (a bim ribbon button (the string form of "Isolate storey") sending 2131 with icon bim icon storey) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Storey")
            append (a bim ribbon button (the string form of "Up") sending 266 with icon bim icon up) to (group's buttons)
            append (a bim ribbon button (the string form of "Down") sending 267 with icon bim icon down) to (group's buttons)
            append group to made
        if chosenTab = 6:
            set group to a bim ribbon group titled (the string form of "File")
            append (a bim ribbon button (the string form of "Save") sending ((bim ui control command) + 83) with icon bim icon save) to (group's buttons)
            append (a bim ribbon button (the string form of "Open") sending ((bim ui control command) + 79) with icon bim icon open) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Checks")
            append (a bim ribbon button (the string form of "Decimals") sending 2125 with icon bim icon dimension) to (group's buttons)
            append (a bim ribbon button (the string form of "Round to mm") sending 2126 with icon bim icon measure) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Library")
            append (a bim ribbon button (the string form of "Export library") sending 2136 with icon bim icon export) to (group's buttons)
            append (a bim ribbon button (the string form of "Import library") sending 2137 with icon bim icon import) to (group's buttons)
            append (a small bim ribbon button (the string form of "EU steel") sending 2135 with icon bim icon beam) to (group's buttons)
            append (a small bim ribbon button (the string form of "NL doors") sending 2134 with icon bim icon door) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Units")
            append (a small bim ribbon button (the string form of "mm") sending 2050 with icon bim icon dimension) to (group's buttons)
            append (a small bim ribbon button (the string form of "cm") sending 2051 with icon bim icon dimension) to (group's buttons)
            append (a small bim ribbon button (the string form of "m") sending 2052 with icon bim icon dimension) to (group's buttons)
            append group to made
        # Collaborate: exchange with other software in one place. DWG, DXF
        # and PDF drawings import as sketch lines (one command, 2127); IFC
        # imports as read-only elements (2128), and its storeys can become the
        # model's (2132).
        if chosenTab = 7:
            set group to a bim ribbon group titled (the string form of "Import")
            append (a bim ribbon button (the string form of "DWG/DXF") sending 2127 with icon bim icon import) to (group's buttons)
            append (a bim ribbon button (the string form of "PDF") sending 2127 with icon bim icon import) to (group's buttons)
            append (a bim ribbon button (the string form of "IFC") sending 2128 with icon bim icon ifc import) to (group's buttons)
            append (a small bim ribbon button (the string form of "Storeys from IFC") sending 2132 with icon bim icon storey) to (group's buttons)
            append (a bim ribbon button (the string form of "Open IfcX") sending ((bim ui control command) + 79) with icon bim icon open) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Export")
            append (a bim ribbon button (the string form of "DWG/DXF 2D") sending -1 with icon bim icon export) to (group's buttons)
            append (a bim ribbon button (the string form of "DWG/DXF 3D") sending -1 with icon bim icon export) to (group's buttons)
            append (a small bim ribbon button (the string form of "IFC") sending 88 with icon bim icon ifc export) to (group's buttons)
            append (a small bim ribbon button (the string form of "IFC5") sending ((bim ui control command) + 88) with icon bim icon ifc export) to (group's buttons)
            append (a small bim ribbon button (the string form of "PDF") sending 2098 with icon bim icon export) to (group's buttons)
            append (a small bim ribbon button (the string form of "SVG") sending 2115 with icon bim icon export) to (group's buttons)
            append group to made
            set group to a bim ribbon group titled (the string form of "Coordinate")
            append (a bim ribbon button (the string form of "Clashes") keyed (the string form of "CK") sending 2114 with icon bim icon clash) to (group's buttons)
            append group to made
            # Other programs (an AI assistant through the MCP server) drive
            # the editor through the automation API.
            set group to a bim ribbon group titled (the string form of "Automation")
            append (a bim ribbon button (the string form of "API / MCP") sending (bim ui api command) with icon bim icon settings) to (group's buttons)
            append group to made
        return made

# ---------------------------------------------------------------- theme

# A colour of the OpenAEC style's tokens.
class:
    patterns:
        [a|] bim ui colour record
    members:
        red as an integer
        green as an integer
        blue as an integer

# The tokens of one theme of the OpenAEC style (Style Repo 0.4,
# design/ontwerp-0.4/tokens-0.4.json) that the chrome is drawn in.
class:
    patterns:
        [a|] bim ui palette record
    members:
        # The title bar and the ribbon's tabs (`frame`).
        chrome as a bim ui colour record
        panel as a bim ui colour record
        raised as a bim ui colour record
        docbar as a bim ui colour record
        workspace as a bim ui colour record
        workspaceInk as a bim ui colour record
        # Text: `text`, `text-secondary`, `text-disabled`.
        ink as a bim ui colour record
        inkSecondary as a bim ui colour record
        inkDisabled as a bim ui colour record
        border as a bim ui colour record
        # `border-strong`.
        strong as a bim ui colour record
        hover as a bim ui colour record
        pressed as a bim ui colour record
        accent as a bim ui colour record
        # `accent-text`: an icon's accent part, an active tool's icon.
        accentInk as a bim ui colour record
        # `text-on-accent`.
        onAccent as a bim ui colour record
        selected as a bim ui colour record
        selectedBar as a bim ui colour record
        statusbar as a bim ui colour record
        statusbarInk as a bim ui colour record
        focus as a bim ui colour record
        accentHover as a bim ui colour record
        accentPressed as a bim ui colour record

# The look the chrome is drawn in, as the application's settings choose it
# (`use bim ui theme`, from `appSettings`): the theme, 0 Light or 1 Dark
# (the style's themes of the same names, Dark by default); the workspace, 0
# following the theme, 1 always light, 2 always dark; the status bar, 0
# following the theme, 1 always dark.
class:
    patterns:
        [a|] bim ui look record
    members:
        theme as an integer
        workspace as an integer
        statusbar as an integer

set bimUiLook to @intrinsic("construct", a bim ui look record, 1, 0, 0)

function use bim ui theme {integer:themeChoice} workspace {integer:workspaceChoice} statusbar {integer:statusChoice}:
    globals: bimUiLook
    execute:
        set bimUiLook to @intrinsic("construct", a bim ui look record, themeChoice, workspaceChoice, statusChoice)

function bim ui theme:
    globals: bimUiLook
    execute:
        return bimUiLook's theme

function the bim ui colour {integer:r} {integer:g} {integer:b}:
    execute:
        return @intrinsic("construct", a bim ui colour record, r, g, b)

# The tokens of the theme the look chooses, its workspace and status bar
# as the look chooses them (tokens-0.4.json, `workspace-setting` and
# `statusbar-setting`).
function the bim ui palette:
    globals: bimUiLook
    execute:
        set made to @intrinsic("construct", a bim ui palette record, the bim ui colour 241 238 234, the bim ui colour 255 255 255, the bim ui colour 255 255 255, the bim ui colour 241 238 234, the bim ui colour 255 255 255, the bim ui colour 42 42 50, the bim ui colour 42 42 50, the bim ui colour 95 95 101, the bim ui colour 170 170 173, the bim ui colour 234 234 234, the bim ui colour 127 127 132, the bim ui colour 242 242 243, the bim ui colour 229 229 230, the bim ui colour 217 119 6, the bim ui colour 146 64 14, the bim ui colour 28 25 23, the bim ui colour 251 241 230, the bim ui colour 180 83 9, the bim ui colour 255 255 255, the bim ui colour 95 95 101, the bim ui colour 180 83 9, the bim ui colour 231 138 8, the bim ui colour 195 107 5)
        if bimUiLook's theme = 1:
            set made to @intrinsic("construct", a bim ui palette record, the bim ui colour 42 42 50, the bim ui colour 51 51 60, the bim ui colour 59 59 69, the bim ui colour 42 42 50, the bim ui colour 38 38 45, the bim ui colour 237 235 232, the bim ui colour 237 235 232, the bim ui colour 190 189 189, the bim ui colour 125 125 129, the bim ui colour 71 71 80, the bim ui colour 135 134 137, the bim ui colour 62 62 70, the bim ui colour 73 73 81, the bim ui colour 217 119 6, the bim ui colour 251 191 36, the bim ui colour 28 25 23, the bim ui colour 81 63 50, the bim ui colour 217 119 6, the bim ui colour 42 42 50, the bim ui colour 189 186 181, the bim ui colour 245 158 11, the bim ui colour 231 138 8, the bim ui colour 195 107 5)
        if bimUiLook's workspace = 1:
            set made's workspace to the bim ui colour 255 255 255
            set made's workspaceInk to the bim ui colour 42 42 50
        else if bimUiLook's workspace = 2:
            set made's workspace to the bim ui colour 38 38 45
            set made's workspaceInk to the bim ui colour 237 235 232
        if bimUiLook's statusbar = 1:
            set made's statusbar to the bim ui colour 42 42 50
            set made's statusbarInk to the bim ui colour 212 209 204
        return made

# ---------------------------------------------------------------- drawing

function draw bim ui rectangle {a 64 bit floating-point number:left} {a 64 bit floating-point number:top} {a 64 bit floating-point number:across} {a 64 bit floating-point number:tall} coloured {integer:r}, {integer:g} and {integer:b} in {graphics frame:frame}:
    execute:
        draw a rectangle at x left and y top with width across and height tall in color red r, green g and blue b in frame

# A filled rectangle with corners rounded `corner` pixels: a pixel row per
# step of each corner's quarter circle, the middle in one piece; only the
# top corners rounded when `topOnly`.
function fill bim ui box at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:upperEdge} sized {a 64 bit floating-point number:across} by {a 64 bit floating-point number:tall} rounded {a 64 bit floating-point number:corner} on top only {boolean:topOnly} coloured {integer:r}, {integer:g} and {integer:b} in {graphics frame:frame}:
    execute:
        set rounding to the minimum of corner and (the minimum of (across * 0.5) and (tall * 0.5))
        set steps to rounding as an integer
        loop step from 0 to steps:
            set rise to (rounding - (step as a 64 bit floating-point number)) - 0.5
            set inset to rounding - (the square root of (the maximum of 0.0 and ((rounding * rounding) - (rise * rise))))
            draw a rectangle at x (left + inset) and y (upperEdge + (step as a 64 bit floating-point number)) with width (across - (2.0 * inset)) and height 1.0 in color red r, green g and blue b in frame
            if topOnly = false:
                draw a rectangle at x (left + inset) and y ((upperEdge + tall) - ((step + 1) as a 64 bit floating-point number)) with width (across - (2.0 * inset)) and height 1.0 in color red r, green g and blue b in frame
        set bottomSteps to steps
        if topOnly:
            set bottomSteps to 0
        draw a rectangle at x left and y (upperEdge + (steps as a 64 bit floating-point number)) with width across and height (tall - ((steps + bottomSteps) as a 64 bit floating-point number)) in color red r, green g and blue b in frame

function draw bim ui rounded rectangle {a 64 bit floating-point number:left} {a 64 bit floating-point number:upperEdge} {a 64 bit floating-point number:across} {a 64 bit floating-point number:tall} radius {a 64 bit floating-point number:corner} coloured {integer:r}, {integer:g} and {integer:b} in {graphics frame:frame}:
    execute:
        fill bim ui box at left and upperEdge sized across by tall rounded corner on top only false coloured r, g and b in frame

function draw bim ui top rounded rectangle {a 64 bit floating-point number:left} {a 64 bit floating-point number:upperEdge} {a 64 bit floating-point number:across} {a 64 bit floating-point number:tall} radius {a 64 bit floating-point number:corner} coloured {integer:r}, {integer:g} and {integer:b} in {graphics frame:frame}:
    execute:
        fill bim ui box at left and upperEdge sized across by tall rounded corner on top only true coloured r, g and b in frame

# A line `breadth` pixels wide from `ax`, `ay` to `bx`, `by`.
function draw bim ui line from {a 64 bit floating-point number:ax} {a 64 bit floating-point number:ay} to {a 64 bit floating-point number:bx} {a 64 bit floating-point number:by} wide {a 64 bit floating-point number:breadth} coloured {integer:r}, {integer:g} and {integer:b} in {graphics frame:frame}:
    execute:
        set dx to bx - ax
        set dy to by - ay
        set magnitude to the square root of ((dx * dx) + (dy * dy))
        if magnitude <= 0.0:
            return nothing
        set ox to (0.0 - dy) * (breadth / (2.0 * magnitude))
        set oy to dx * (breadth / (2.0 * magnitude))
        start triangles in frame
        use vertex color red r, green g and blue b in frame
        add a vertex at x (ax + ox) and y (ay + oy) to frame
        add a vertex at x (ax - ox) and y (ay - oy) to frame
        add a vertex at x (bx + ox) and y (by + oy) to frame
        add a vertex at x (bx + ox) and y (by + oy) to frame
        add a vertex at x (ax - ox) and y (ay - oy) to frame
        add a vertex at x (bx - ox) and y (by - oy) to frame
        finish triangles in frame

# An outlined rectangle.
function draw bim ui frame {a 64 bit floating-point number:left} {a 64 bit floating-point number:top} {a 64 bit floating-point number:across} {a 64 bit floating-point number:tall} coloured {integer:r}, {integer:g} and {integer:b} in {graphics frame:frame}:
    execute:
        draw bim ui line from left top to (left + across) top wide 1.5 coloured r, g and b in frame
        draw bim ui line from (left + across) top to (left + across) (top + tall) wide 1.5 coloured r, g and b in frame
        draw bim ui line from (left + across) (top + tall) to left (top + tall) wide 1.5 coloured r, g and b in frame
        draw bim ui line from left (top + tall) to left top wide 1.5 coloured r, g and b in frame

# The primitives above in a colour of the palette.
function draw bim ui rectangle {a 64 bit floating-point number:left} {a 64 bit floating-point number:top} {a 64 bit floating-point number:across} {a 64 bit floating-point number:tall} painted {bim ui colour record:paint} in {graphics frame:frame}:
    execute:
        draw a rectangle at x left and y top with width across and height tall in color red paint's red, green paint's green and blue paint's blue in frame

function draw bim ui rounded rectangle {a 64 bit floating-point number:left} {a 64 bit floating-point number:upperEdge} {a 64 bit floating-point number:across} {a 64 bit floating-point number:tall} radius {a 64 bit floating-point number:corner} painted {bim ui colour record:paint} in {graphics frame:frame}:
    execute:
        fill bim ui box at left and upperEdge sized across by tall rounded corner on top only false coloured paint's red, paint's green and paint's blue in frame

function draw bim ui top rounded rectangle {a 64 bit floating-point number:left} {a 64 bit floating-point number:upperEdge} {a 64 bit floating-point number:across} {a 64 bit floating-point number:tall} radius {a 64 bit floating-point number:corner} painted {bim ui colour record:paint} in {graphics frame:frame}:
    execute:
        fill bim ui box at left and upperEdge sized across by tall rounded corner on top only true coloured paint's red, paint's green and paint's blue in frame

function draw bim ui text {a string:message} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in face {integer:faceIndex} with {bim text atlas record:atlas} painted {bim ui colour record:paint} in {graphics frame:frame}:
    execute:
        draw bim text message at x and y in face faceIndex with atlas coloured paint's red, paint's green and paint's blue in frame

function draw bim ui caps {a string:message} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} with {bim text atlas record:atlas} painted {bim ui colour record:paint} in {graphics frame:frame}:
    execute:
        draw bim caps message at x and y with atlas coloured paint's red, paint's green and paint's blue in frame

# A box filled with `fill` inside a border `edgeWidth` pixels wide in
# `edge`, its corners rounded `corner` pixels: a field, a menu, a tooltip.
function draw bim ui box {a 64 bit floating-point number:left} {a 64 bit floating-point number:upperEdge} {a 64 bit floating-point number:across} {a 64 bit floating-point number:tall} radius {a 64 bit floating-point number:corner} painted {bim ui colour record:fill} edged {bim ui colour record:edge} wide {a 64 bit floating-point number:edgeWidth} in {graphics frame:frame}:
    execute:
        draw bim ui rounded rectangle left upperEdge across tall radius corner painted edge in frame
        draw bim ui rounded rectangle (left + edgeWidth) (upperEdge + edgeWidth) (across - (2.0 * edgeWidth)) (tall - (2.0 * edgeWidth)) radius (the maximum of 0.0 and (corner - edgeWidth)) painted fill in frame

# A chevron 8 pixels across round (`x`, `y`): pointing down when `isOpen`,
# else right.
function draw bim ui chevron at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} open {boolean:isOpen} painted {bim ui colour record:paint} in {graphics frame:frame}:
    execute:
        if isOpen:
            draw bim ui line from (x - 4.0) (y - 2.0) to x (y + 2.0) wide 1.5 coloured paint's red, paint's green and paint's blue in frame
            draw bim ui line from x (y + 2.0) to (x + 4.0) (y - 2.0) wide 1.5 coloured paint's red, paint's green and paint's blue in frame
        else:
            draw bim ui line from (x - 2.0) (y - 4.0) to (x + 2.0) y wide 1.5 coloured paint's red, paint's green and paint's blue in frame
            draw bim ui line from (x + 2.0) y to (x - 2.0) (y + 4.0) wide 1.5 coloured paint's red, paint's green and paint's blue in frame

# Icon `glyph` at `size` pixels (16 or 22) with its top left at `x`, `y`:
# from the Style Repo's icons in the atlas, its primary part in `paint` and
# its accent part in `accentPaint`; the drawn icon, in `paint`, for a glyph
# the atlas lacks.
function draw bim ui icon {integer:glyph} sized {integer:size} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} painted {bim ui colour record:paint} accented {bim ui colour record:accentPaint} with {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        if the bim pictogram glyph sized size is in atlas:
            draw bim pictogram glyph sized size at x and y with atlas coloured paint's red, paint's green and paint's blue accented accentPaint's red, accentPaint's green and accentPaint's blue in frame
        else:
            draw bim icon glyph at x and y scaled ((size as a 64 bit floating-point number) / 32.0) coloured paint's red, paint's green and paint's blue in frame

# A filled four-cornered shape, its corners in order.
function fill bim ui quad {cad vector2:a} {cad vector2:b} {cad vector2:c} {cad vector2:d} coloured {integer:r}, {integer:g} and {integer:b2} in {graphics frame:frame}:
    execute:
        start triangles in frame
        use vertex color red r, green g and blue b2 in frame
        add a vertex at x a's x and y a's y to frame
        add a vertex at x b's x and y b's y to frame
        add a vertex at x c's x and y c's y to frame
        add a vertex at x a's x and y a's y to frame
        add a vertex at x c's x and y c's y to frame
        add a vertex at x d's x and y d's y to frame
        finish triangles in frame

# A point of the 32 x 32 icon box at `x`, `y`, `factor` times its size.
local function the bim icon point {a 64 bit floating-point number:u} {a 64 bit floating-point number:v} from {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} scaled {a 64 bit floating-point number:factor}:
    execute:
        return a cad vector2 with x (x + (u * factor)) and y (y + (v * factor))

# The colours under an icon's lines, in the materials of what it stands
# for: brick bands in a wall, a grey slab, red tiles, blue glass, timber, a
# concrete column, a steel beam; dimmed when the button is not available.
function draw bim icon colours of {integer:glyph} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} scaled {a 64 bit floating-point number:factor} dimmed {boolean:dimmed} in {graphics frame:frame}:
    execute:
        if dimmed:
            return nothing
        if glyph = bim icon wall:
            draw bim ui rectangle (x + (3.0 * factor)) (y + (6.0 * factor)) (26.0 * factor) (7.0 * factor) coloured 196, 104 and 72 in frame
            draw bim ui rectangle (x + (3.0 * factor)) (y + (15.0 * factor)) (26.0 * factor) (3.0 * factor) coloured 236, 214 and 128 in frame
            draw bim ui rectangle (x + (3.0 * factor)) (y + (20.0 * factor)) (26.0 * factor) (7.0 * factor) coloured 205, 200 and 188 in frame
        if glyph = bim icon floor:
            fill bim ui quad (the bim icon point 2.0 20.0 from x and y scaled factor) (the bim icon point 12.0 12.0 from x and y scaled factor) (the bim icon point 30.0 12.0 from x and y scaled factor) (the bim icon point 20.0 20.0 from x and y scaled factor) coloured 190, 194 and 200 in frame
            draw bim ui rectangle (x + (2.0 * factor)) (y + (20.0 * factor)) (18.0 * factor) (5.0 * factor) coloured 150, 154 and 162 in frame
        if glyph = bim icon roof:
            fill bim ui quad (the bim icon point 2.0 18.0 from x and y scaled factor) (the bim icon point 16.0 5.0 from x and y scaled factor) (the bim icon point 16.0 5.0 from x and y scaled factor) (the bim icon point 30.0 18.0 from x and y scaled factor) coloured 200, 80 and 60 in frame
            draw bim ui rectangle (x + (7.0 * factor)) (y + (17.0 * factor)) (18.0 * factor) (11.0 * factor) coloured 236, 228 and 214 in frame
        if glyph = bim icon window:
            draw bim ui rectangle (x + (5.0 * factor)) (y + (4.0 * factor)) (22.0 * factor) (24.0 * factor) coloured 120, 180 and 230 in frame
        if glyph = bim icon door:
            draw bim ui rectangle (x + (8.0 * factor)) (y + (3.0 * factor)) (16.0 * factor) (26.0 * factor) coloured 176, 128 and 80 in frame
        if glyph = bim icon column:
            draw bim ui rectangle (x + (11.0 * factor)) (y + (3.0 * factor)) (10.0 * factor) (26.0 * factor) coloured 175, 175 and 172 in frame
            draw bim ui rectangle (x + (11.0 * factor)) (y + (3.0 * factor)) (3.0 * factor) (26.0 * factor) coloured 205, 205 and 200 in frame
        if glyph = bim icon beam:
            draw bim ui rectangle (x + (2.0 * factor)) (y + (12.0 * factor)) (28.0 * factor) (8.0 * factor) coloured 90, 120 and 160 in frame
            draw bim ui rectangle (x + (2.0 * factor)) (y + (12.0 * factor)) (28.0 * factor) (2.0 * factor) coloured 130, 160 and 200 in frame
        if glyph = bim icon grid:
            draw bim ui rectangle (x + (9.0 * factor)) (y + (1.0 * factor)) (14.0 * factor) (12.0 * factor) coloured 250, 250 and 250 in frame
        if glyph = bim icon section:
            # The section head's flag, looking down onto the house it cuts:
            # its rooms light, its roof grey, its cut walls solid.
            fill bim ui quad (the bim icon point 1.5 12.0 from x and y scaled factor) (the bim icon point 10.5 12.0 from x and y scaled factor) (the bim icon point 6.0 20.0 from x and y scaled factor) (the bim icon point 6.0 20.0 from x and y scaled factor) coloured 220, 60 and 60 in frame
            draw bim ui rectangle (x + (15.0 * factor)) (y + (23.0 * factor)) (14.0 * factor) (6.0 * factor) coloured 236, 228 and 214 in frame
            fill bim ui quad (the bim icon point 15.0 23.0 from x and y scaled factor) (the bim icon point 22.0 17.0 from x and y scaled factor) (the bim icon point 22.0 17.0 from x and y scaled factor) (the bim icon point 29.0 23.0 from x and y scaled factor) coloured 190, 194 and 204 in frame
            draw bim ui rectangle (x + (15.0 * factor)) (y + (23.0 * factor)) (2.5 * factor) (6.0 * factor) coloured 70, 70 and 76 in frame
            draw bim ui rectangle (x + (26.5 * factor)) (y + (23.0 * factor)) (2.5 * factor) (6.0 * factor) coloured 70, 70 and 76 in frame
        if glyph = bim icon cube:
            fill bim ui quad (the bim icon point 16.0 3.0 from x and y scaled factor) (the bim icon point 28.0 9.0 from x and y scaled factor) (the bim icon point 16.0 15.0 from x and y scaled factor) (the bim icon point 4.0 9.0 from x and y scaled factor) coloured 214, 222 and 236 in frame
            fill bim ui quad (the bim icon point 4.0 9.0 from x and y scaled factor) (the bim icon point 16.0 15.0 from x and y scaled factor) (the bim icon point 16.0 29.0 from x and y scaled factor) (the bim icon point 4.0 23.0 from x and y scaled factor) coloured 140, 160 and 196 in frame
            fill bim ui quad (the bim icon point 16.0 15.0 from x and y scaled factor) (the bim icon point 28.0 9.0 from x and y scaled factor) (the bim icon point 28.0 23.0 from x and y scaled factor) (the bim icon point 16.0 29.0 from x and y scaled factor) coloured 100, 124 and 168 in frame
        if glyph = bim icon facade:
            draw bim ui rectangle (x + (4.0 * factor)) (y + (3.0 * factor)) (24.0 * factor) (26.0 * factor) coloured 120, 180 and 230 in frame
        if glyph = bim icon eye:
            draw bim ui rectangle (x + (13.0 * factor)) (y + (13.0 * factor)) (6.0 * factor) (6.0 * factor) coloured 6, 150 and 215 in frame
        if glyph = bim icon delete:
            draw bim ui rectangle (x + (9.0 * factor)) (y + (9.0 * factor)) (14.0 * factor) (18.0 * factor) coloured 220, 90 and 80 in frame
        if glyph = bim icon save:
            draw bim ui rectangle (x + (6.0 * factor)) (y + (5.0 * factor)) (20.0 * factor) (22.0 * factor) coloured 70, 120 and 190 in frame
        if glyph = bim icon component:
            draw bim ui rectangle (x + (6.0 * factor)) (y + (8.0 * factor)) (20.0 * factor) (18.0 * factor) coloured 150, 190 and 120 in frame

# The icon `icon` in the 32 x 32 box at `x`, `y`.
function draw bim icon {integer:glyph} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} coloured {integer:r}, {integer:g} and {integer:b} in {graphics frame:frame}:
    execute:
        draw bim icon glyph at x and y scaled 1.0 coloured r, g and b in frame

# The icon `glyph` drawn `factor` times its 32-pixel size (0.5 for a small
# ribbon button).
function draw bim icon {integer:glyph} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} scaled {a 64 bit floating-point number:factor} coloured {integer:r}, {integer:g} and {integer:b} in {graphics frame:frame}:
    execute:
        if glyph = bim icon select:
            draw bim ui line from (x + (8.0 * factor)) (y + (4.0 * factor)) to (x + (8.0 * factor)) (y + (26.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (8.0 * factor)) (y + (4.0 * factor)) to (x + (24.0 * factor)) (y + (20.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (8.0 * factor)) (y + (26.0 * factor)) to (x + (14.0 * factor)) (y + (20.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (14.0 * factor)) (y + (20.0 * factor)) to (x + (24.0 * factor)) (y + (20.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (15.0 * factor)) (y + (21.0 * factor)) to (x + (20.0 * factor)) (y + (29.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
        if glyph = bim icon wall:
            draw bim ui frame (x + (3.0 * factor)) (y + (6.0 * factor)) (26.0 * factor) (7.0 * factor) coloured r, g and b in frame
            draw bim ui frame (x + (3.0 * factor)) (y + (15.0 * factor)) (26.0 * factor) (3.0 * factor) coloured r, g and b in frame
            draw bim ui frame (x + (3.0 * factor)) (y + (20.0 * factor)) (26.0 * factor) (7.0 * factor) coloured r, g and b in frame
        if glyph = bim icon floor:
            draw bim ui line from (x + (2.0 * factor)) (y + (20.0 * factor)) to (x + (12.0 * factor)) (y + (12.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (12.0 * factor)) (y + (12.0 * factor)) to (x + (30.0 * factor)) (y + (12.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (30.0 * factor)) (y + (12.0 * factor)) to (x + (20.0 * factor)) (y + (20.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (20.0 * factor)) (y + (20.0 * factor)) to (x + (2.0 * factor)) (y + (20.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui frame (x + (2.0 * factor)) (y + (20.0 * factor)) (18.0 * factor) (5.0 * factor) coloured r, g and b in frame
        if glyph = bim icon roof:
            draw bim ui line from (x + (2.0 * factor)) (y + (18.0 * factor)) to (x + (16.0 * factor)) (y + (5.0 * factor)) wide (2.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (16.0 * factor)) (y + (5.0 * factor)) to (x + (30.0 * factor)) (y + (18.0 * factor)) wide (2.5 * factor) coloured r, g and b in frame
            draw bim ui frame (x + (7.0 * factor)) (y + (17.0 * factor)) (18.0 * factor) (11.0 * factor) coloured r, g and b in frame
        if glyph = bim icon window:
            draw bim ui frame (x + (5.0 * factor)) (y + (4.0 * factor)) (22.0 * factor) (24.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (16.0 * factor)) (y + (4.0 * factor)) to (x + (16.0 * factor)) (y + (28.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (5.0 * factor)) (y + (15.0 * factor)) to (x + (27.0 * factor)) (y + (15.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
        if glyph = bim icon door:
            draw bim ui frame (x + (8.0 * factor)) (y + (3.0 * factor)) (16.0 * factor) (26.0 * factor) coloured r, g and b in frame
            draw bim ui rectangle (x + (19.0 * factor)) (y + (15.0 * factor)) (3.0 * factor) (3.0 * factor) coloured r, g and b in frame
        if glyph = bim icon opening:
            draw bim ui frame (x + (4.0 * factor)) (y + (6.0 * factor)) (24.0 * factor) (20.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (4.0 * factor)) (y + (6.0 * factor)) to (x + (28.0 * factor)) (y + (26.0 * factor)) wide (1.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (28.0 * factor)) (y + (6.0 * factor)) to (x + (4.0 * factor)) (y + (26.0 * factor)) wide (1.0 * factor) coloured r, g and b in frame
        if glyph = bim icon grid:
            draw bim ui line from (x + (16.0 * factor)) (y + (12.0 * factor)) to (x + (16.0 * factor)) (y + (31.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui frame (x + (9.0 * factor)) (y + (1.0 * factor)) (14.0 * factor) (12.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (2.0 * factor)) (y + (22.0 * factor)) to (x + (30.0 * factor)) (y + (22.0 * factor)) wide (1.0 * factor) coloured r, g and b in frame
        if glyph = bim icon column:
            draw bim ui frame (x + (11.0 * factor)) (y + (3.0 * factor)) (10.0 * factor) (26.0 * factor) coloured r, g and b in frame
        if glyph = bim icon beam:
            draw bim ui frame (x + (2.0 * factor)) (y + (12.0 * factor)) (28.0 * factor) (8.0 * factor) coloured r, g and b in frame
        if glyph = bim icon section:
            # A section mark as on a plan: the head (a circle with its flag)
            # and the dash-dotted cut line, over the house it cuts.
            loop step from 0 to 12:
                set fromAngle to (6.283185307179586 * (step as a 64 bit floating-point number)) / 12.0
                set toAngle to (6.283185307179586 * ((step + 1) as a 64 bit floating-point number)) / 12.0
                draw bim ui line from (x + ((6.0 + (4.5 * (the cosine of fromAngle))) * factor)) (y + ((12.0 + (4.5 * (the sine of fromAngle))) * factor)) to (x + ((6.0 + (4.5 * (the cosine of toAngle))) * factor)) (y + ((12.0 + (4.5 * (the sine of toAngle))) * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (10.5 * factor)) (y + (12.0 * factor)) to (x + (19.0 * factor)) (y + (12.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (21.0 * factor)) (y + (12.0 * factor)) to (x + (23.0 * factor)) (y + (12.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (25.0 * factor)) (y + (12.0 * factor)) to (x + (31.0 * factor)) (y + (12.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (15.0 * factor)) (y + (23.0 * factor)) to (x + (22.0 * factor)) (y + (17.0 * factor)) wide (1.2 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (22.0 * factor)) (y + (17.0 * factor)) to (x + (29.0 * factor)) (y + (23.0 * factor)) wide (1.2 * factor) coloured r, g and b in frame
            draw bim ui frame (x + (15.0 * factor)) (y + (23.0 * factor)) (14.0 * factor) (6.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (11.0 * factor)) (y + (29.5 * factor)) to (x + (31.0 * factor)) (y + (29.5 * factor)) wide (1.5 * factor) coloured r, g and b in frame
        if glyph = bim icon cube:
            draw bim ui line from (x + (16.0 * factor)) (y + (3.0 * factor)) to (x + (28.0 * factor)) (y + (9.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (28.0 * factor)) (y + (9.0 * factor)) to (x + (28.0 * factor)) (y + (23.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (28.0 * factor)) (y + (23.0 * factor)) to (x + (16.0 * factor)) (y + (29.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (16.0 * factor)) (y + (29.0 * factor)) to (x + (4.0 * factor)) (y + (23.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (4.0 * factor)) (y + (23.0 * factor)) to (x + (4.0 * factor)) (y + (9.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (4.0 * factor)) (y + (9.0 * factor)) to (x + (16.0 * factor)) (y + (3.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (4.0 * factor)) (y + (9.0 * factor)) to (x + (16.0 * factor)) (y + (15.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (16.0 * factor)) (y + (15.0 * factor)) to (x + (28.0 * factor)) (y + (9.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (16.0 * factor)) (y + (15.0 * factor)) to (x + (16.0 * factor)) (y + (29.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
        if glyph = bim icon eye:
            draw bim ui line from (x + (2.0 * factor)) (y + (16.0 * factor)) to (x + (16.0 * factor)) (y + (7.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (16.0 * factor)) (y + (7.0 * factor)) to (x + (30.0 * factor)) (y + (16.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (30.0 * factor)) (y + (16.0 * factor)) to (x + (16.0 * factor)) (y + (25.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (16.0 * factor)) (y + (25.0 * factor)) to (x + (2.0 * factor)) (y + (16.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui rectangle (x + (13.0 * factor)) (y + (13.0 * factor)) (6.0 * factor) (6.0 * factor) coloured r, g and b in frame
        if glyph = bim icon table:
            draw bim ui frame (x + (3.0 * factor)) (y + (5.0 * factor)) (26.0 * factor) (22.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (3.0 * factor)) (y + (12.0 * factor)) to (x + (29.0 * factor)) (y + (12.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (3.0 * factor)) (y + (19.0 * factor)) to (x + (29.0 * factor)) (y + (19.0 * factor)) wide (1.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (12.0 * factor)) (y + (5.0 * factor)) to (x + (12.0 * factor)) (y + (27.0 * factor)) wide (1.0 * factor) coloured r, g and b in frame
        if glyph = bim icon layers:
            draw bim ui rectangle (x + (4.0 * factor)) (y + (4.0 * factor)) (6.0 * factor) (24.0 * factor) coloured 205, 140 and 115 in frame
            draw bim ui rectangle (x + (11.0 * factor)) (y + (4.0 * factor)) (9.0 * factor) (24.0 * factor) coloured 240, 225 and 150 in frame
            draw bim ui rectangle (x + (21.0 * factor)) (y + (4.0 * factor)) (7.0 * factor) (24.0 * factor) coloured 185, 185 and 185 in frame
        if glyph = bim icon fit:
            draw bim ui line from (x + (3.0 * factor)) (y + (3.0 * factor)) to (x + (11.0 * factor)) (y + (3.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (3.0 * factor)) (y + (3.0 * factor)) to (x + (3.0 * factor)) (y + (11.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (29.0 * factor)) (y + (29.0 * factor)) to (x + (21.0 * factor)) (y + (29.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (29.0 * factor)) (y + (29.0 * factor)) to (x + (29.0 * factor)) (y + (21.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui frame (x + (10.0 * factor)) (y + (10.0 * factor)) (12.0 * factor) (12.0 * factor) coloured r, g and b in frame
        if (glyph = bim icon undo) or (glyph = bim icon redo):
            set sign to 1.0
            set base to x + (6.0 * factor)
            if glyph = bim icon redo:
                set sign to -1.0
                set base to x + (26.0 * factor)
            draw bim ui line from base (y + (12.0 * factor)) to (base + (sign * (14.0 * factor))) (y + (12.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (base + (sign * (14.0 * factor))) (y + (12.0 * factor)) to (base + (sign * (20.0 * factor))) (y + (18.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (base + (sign * (20.0 * factor))) (y + (18.0 * factor)) to (base + (sign * (14.0 * factor))) (y + (25.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from base (y + (12.0 * factor)) to (base + (sign * (6.0 * factor))) (y + (6.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from base (y + (12.0 * factor)) to (base + (sign * (6.0 * factor))) (y + (18.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
        if glyph = bim icon delete:
            draw bim ui line from (x + (7.0 * factor)) (y + (7.0 * factor)) to (x + (25.0 * factor)) (y + (25.0 * factor)) wide (3.0 * factor) coloured 229, 57 and 53 in frame
            draw bim ui line from (x + (25.0 * factor)) (y + (7.0 * factor)) to (x + (7.0 * factor)) (y + (25.0 * factor)) wide (3.0 * factor) coloured 229, 57 and 53 in frame
        if glyph = bim icon save:
            draw bim ui frame (x + (4.0 * factor)) (y + (4.0 * factor)) (24.0 * factor) (24.0 * factor) coloured r, g and b in frame
            draw bim ui rectangle (x + (9.0 * factor)) (y + (4.0 * factor)) (14.0 * factor) (8.0 * factor) coloured r, g and b in frame
            draw bim ui frame (x + (8.0 * factor)) (y + (17.0 * factor)) (16.0 * factor) (11.0 * factor) coloured r, g and b in frame
        if glyph = bim icon open:
            draw bim ui line from (x + (3.0 * factor)) (y + (8.0 * factor)) to (x + (12.0 * factor)) (y + (8.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (12.0 * factor)) (y + (8.0 * factor)) to (x + (15.0 * factor)) (y + (11.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (15.0 * factor)) (y + (11.0 * factor)) to (x + (29.0 * factor)) (y + (11.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui frame (x + (3.0 * factor)) (y + (8.0 * factor)) (26.0 * factor) (19.0 * factor) coloured r, g and b in frame
        if glyph = bim icon export:
            draw bim ui frame (x + (4.0 * factor)) (y + (10.0 * factor)) (18.0 * factor) (18.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (14.0 * factor)) (y + (18.0 * factor)) to (x + (28.0 * factor)) (y + (4.0 * factor)) wide (2.0 * factor) coloured 6, 150 and 215 in frame
            draw bim ui line from (x + (28.0 * factor)) (y + (4.0 * factor)) to (x + (20.0 * factor)) (y + (4.0 * factor)) wide (2.0 * factor) coloured 6, 150 and 215 in frame
            draw bim ui line from (x + (28.0 * factor)) (y + (4.0 * factor)) to (x + (28.0 * factor)) (y + (12.0 * factor)) wide (2.0 * factor) coloured 6, 150 and 215 in frame
        if (glyph = bim icon up) or (glyph = bim icon down):
            set tip to y + (6.0 * factor)
            set tail to y + (26.0 * factor)
            if glyph = bim icon down:
                set tip to y + (26.0 * factor)
                set tail to y + (6.0 * factor)
            draw bim ui line from (x + (16.0 * factor)) tail to (x + (16.0 * factor)) tip wide (2.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (16.0 * factor)) tip to (x + (8.0 * factor)) (tip + ((tail - tip) * 0.4)) wide (2.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (16.0 * factor)) tip to (x + (24.0 * factor)) (tip + ((tail - tip) * 0.4)) wide (2.5 * factor) coloured r, g and b in frame
        if glyph = bim icon move:
            draw bim ui line from (x + (16.0 * factor)) (y + (3.0 * factor)) to (x + (16.0 * factor)) (y + (29.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (3.0 * factor)) (y + (16.0 * factor)) to (x + (29.0 * factor)) (y + (16.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
        if glyph = bim icon text:
            draw bim ui line from (x + (6.0 * factor)) (y + (6.0 * factor)) to (x + (26.0 * factor)) (y + (6.0 * factor)) wide (3.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (16.0 * factor)) (y + (6.0 * factor)) to (x + (16.0 * factor)) (y + (27.0 * factor)) wide (3.0 * factor) coloured r, g and b in frame
        if glyph = bim icon dimension:
            draw bim ui line from (x + (3.0 * factor)) (y + (18.0 * factor)) to (x + (29.0 * factor)) (y + (18.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (3.0 * factor)) (y + (10.0 * factor)) to (x + (3.0 * factor)) (y + (26.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (29.0 * factor)) (y + (10.0 * factor)) to (x + (29.0 * factor)) (y + (26.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
        if glyph = bim icon line:
            draw bim ui line from (x + (5.0 * factor)) (y + (26.0 * factor)) to (x + (27.0 * factor)) (y + (6.0 * factor)) wide (2.0 * factor) coloured r, g and b in frame
            draw bim ui rectangle (x + (3.0 * factor)) (y + (24.0 * factor)) (4.0 * factor) (4.0 * factor) coloured r, g and b in frame
            draw bim ui rectangle (x + (25.0 * factor)) (y + (4.0 * factor)) (4.0 * factor) (4.0 * factor) coloured r, g and b in frame
        if glyph = bim icon rectangle:
            draw bim ui frame (x + (4.0 * factor)) (y + (7.0 * factor)) (24.0 * factor) (18.0 * factor) coloured r, g and b in frame
        if glyph = bim icon push:
            draw bim ui line from (x + (4.0 * factor)) (y + (24.0 * factor)) to (x + (14.0 * factor)) (y + (18.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (14.0 * factor)) (y + (18.0 * factor)) to (x + (28.0 * factor)) (y + (24.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (28.0 * factor)) (y + (24.0 * factor)) to (x + (18.0 * factor)) (y + (30.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (18.0 * factor)) (y + (30.0 * factor)) to (x + (4.0 * factor)) (y + (24.0 * factor)) wide (1.5 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (16.0 * factor)) (y + (20.0 * factor)) to (x + (16.0 * factor)) (y + (3.0 * factor)) wide (2.0 * factor) coloured 6, 150 and 215 in frame
            draw bim ui line from (x + (16.0 * factor)) (y + (3.0 * factor)) to (x + (11.0 * factor)) (y + (8.0 * factor)) wide (2.0 * factor) coloured 6, 150 and 215 in frame
            draw bim ui line from (x + (16.0 * factor)) (y + (3.0 * factor)) to (x + (21.0 * factor)) (y + (8.0 * factor)) wide (2.0 * factor) coloured 6, 150 and 215 in frame
        if glyph = bim icon component:
            draw bim ui frame (x + (4.0 * factor)) (y + (10.0 * factor)) (14.0 * factor) (14.0 * factor) coloured r, g and b in frame
            draw bim ui frame (x + (14.0 * factor)) (y + (4.0 * factor)) (14.0 * factor) (14.0 * factor) coloured 6, 150 and 215 in frame
            draw bim ui line from (x + (4.0 * factor)) (y + (10.0 * factor)) to (x + (14.0 * factor)) (y + (4.0 * factor)) wide (1.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (18.0 * factor)) (y + (24.0 * factor)) to (x + (28.0 * factor)) (y + (18.0 * factor)) wide (1.0 * factor) coloured r, g and b in frame
        if glyph = bim icon place:
            draw bim ui frame (x + (3.0 * factor)) (y + (14.0 * factor)) (10.0 * factor) (10.0 * factor) coloured r, g and b in frame
            draw bim ui frame (x + (19.0 * factor)) (y + (14.0 * factor)) (10.0 * factor) (10.0 * factor) coloured 6, 150 and 215 in frame
            draw bim ui line from (x + (16.0 * factor)) (y + (4.0 * factor)) to (x + (16.0 * factor)) (y + (12.0 * factor)) wide (2.0 * factor) coloured 6, 150 and 215 in frame
            draw bim ui line from (x + (12.0 * factor)) (y + (8.0 * factor)) to (x + (20.0 * factor)) (y + (8.0 * factor)) wide (2.0 * factor) coloured 6, 150 and 215 in frame
        if glyph = bim icon explode:
            draw bim ui frame (x + (11.0 * factor)) (y + (11.0 * factor)) (10.0 * factor) (10.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (9.0 * factor)) (y + (9.0 * factor)) to (x + (3.0 * factor)) (y + (3.0 * factor)) wide (2.0 * factor) coloured 6, 150 and 215 in frame
            draw bim ui line from (x + (23.0 * factor)) (y + (9.0 * factor)) to (x + (29.0 * factor)) (y + (3.0 * factor)) wide (2.0 * factor) coloured 6, 150 and 215 in frame
            draw bim ui line from (x + (9.0 * factor)) (y + (23.0 * factor)) to (x + (3.0 * factor)) (y + (29.0 * factor)) wide (2.0 * factor) coloured 6, 150 and 215 in frame
            draw bim ui line from (x + (23.0 * factor)) (y + (23.0 * factor)) to (x + (29.0 * factor)) (y + (29.0 * factor)) wide (2.0 * factor) coloured 6, 150 and 215 in frame
        if glyph = bim icon facade:
            draw bim ui frame (x + (4.0 * factor)) (y + (4.0 * factor)) (24.0 * factor) (24.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (12.0 * factor)) (y + (4.0 * factor)) to (x + (12.0 * factor)) (y + (28.0 * factor)) wide (1.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (20.0 * factor)) (y + (4.0 * factor)) to (x + (20.0 * factor)) (y + (28.0 * factor)) wide (1.0 * factor) coloured r, g and b in frame
            draw bim ui line from (x + (4.0 * factor)) (y + (16.0 * factor)) to (x + (28.0 * factor)) (y + (16.0 * factor)) wide (1.0 * factor) coloured r, g and b in frame

# What a click at `x`, `y` hits in the chrome.
class:
    patterns:
        [a|] bim ui hit record
    members:
        command as an integer
        tab as an integer
        storey as a 64 bit integer
        inChrome as a boolean
        wallType as a 64 bit integer
        floorType as an integer
        # A project browser action (`bim browser ...`) and what it acts on.
        action as an integer
        actionId as a 64 bit integer

function no bim ui hit:
    execute:
        return @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, false, (-1) as a 64 bit integer, -1, 0, (-1) as a 64 bit integer)

# Draws the title bar, the ribbon's tabs and the ribbon of tab `activeTab`
# in the OpenAEC style (Style Repo 0.4, ribbon variant B: flat, tabs as
# text over an accent line, File as a rounded accent button before them,
# pressed while the File menu shows (`fileShown`), an active tool's icon in
# a tile): the button under `pointerX`, `pointerY` highlighted. Returns what
# a click there hits.
function draw bim ribbon of tab {integer:activeTab} under {integer:activeSub} folded {boolean:isFolded} from group {integer:firstGroup} filing {boolean:fileShown} for {bim editor record:editor} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} across {a 64 bit floating-point number:width} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set hit to no bim ui hit
        set scheme to the bim ui palette
        set titleHeight to bim ui title bar height
        set barHeight to bim ui top bar height
        # The title bar: the logo and the quick actions on the left, the
        # application's name in the middle.
        draw bim ui rectangle 0.0 0.0 width barHeight painted scheme's chrome in frame
        draw bim icon colours of (bim icon cube) at 8.0 and 6.0 scaled 0.625 dimmed false in frame
        draw bim icon (bim icon cube) at 8.0 and 6.0 scaled 0.625 coloured scheme's ink's red, scheme's ink's green and scheme's ink's blue in frame
        set x to 38.0
        set quick to the bim header buttons
        loop cursor from 0 to the length of quick:
            set button to the item at cursor in quick
            set over to ((pointerX >= x) and (pointerX < (x + 24.0))) and ((pointerY >= 4.0) and (pointerY < 28.0))
            if over:
                draw bim ui rounded rectangle x 4.0 24.0 24.0 radius 3.0 painted scheme's hover in frame
                set hit to @intrinsic("construct", a bim ui hit record, button's command, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, 0, (-1) as a 64 bit integer)
            draw bim ui icon button's icon sized 16 at (x + 4.0) and 8.0 painted scheme's ink accented scheme's accentInk with atlas in frame
            set x to x + 26.0
        free quick
        set title to the string form of "Open BIM Studio"
        set titleWidth to the bim text width of title in face (bim text medium) of atlas
        if ((width - titleWidth) * 0.5) > (x + 12.0):
            draw bim ui text title at ((width - titleWidth) * 0.5) and 21.0 in face (bim text medium) with atlas painted scheme's ink in frame
        # File: a rounded accent button 22 pixels high before the tabs; it
        # opens and closes the File menu (`bim_ui_files.dl`, command 2140).
        set fileText to the string form of "File"
        set fileWidth to (the bim text width of fileText in face (bim text semibold) of atlas) + 24.0
        set fileOver to ((pointerX >= 8.0) and (pointerX < (8.0 + fileWidth))) and ((pointerY >= (titleHeight + 3.0)) and (pointerY < (titleHeight + 25.0)))
        set fileFill to scheme's accent
        if fileShown:
            set fileFill to scheme's accentPressed
        else if fileOver:
            set fileFill to scheme's accentHover
        draw bim ui rounded rectangle 8.0 (titleHeight + 3.0) fileWidth 22.0 radius 6.0 painted fileFill in frame
        draw bim ui text fileText at 20.0 and (titleHeight + 18.0) in face (bim text semibold) with atlas painted scheme's onAccent in frame
        if fileOver:
            set hit to @intrinsic("construct", a bim ui hit record, 2140, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, 0, (-1) as a 64 bit integer)
        # The tabs: text, the active one semibold over an accent line. In a
        # narrow window they close up, then their letters are smaller.
        set names to the bim ribbon tab names
        set lettering to 0.0
        loop tabIndex from 0 to the length of names:
            set lettering to lettering + (the bim text width of (the item at tabIndex in names) in face (bim text medium) of atlas)
        set tabCount to (the length of names) as a 64 bit floating-point number
        set rowRoom to width - ((fileWidth + 20.0) + 46.0)
        set padding to the minimum of 24.0 and ((rowRoom - lettering) / tabCount)
        set tabLetters to bim text medium
        if padding < 12.0:
            set padding to 12.0
            set tabLetters to bim text caption
        set x to fileWidth + 16.0
        loop tabIndex from 0 to the length of names:
            set name to the item at tabIndex in names
            set tabFace to tabLetters
            if (tabIndex = activeTab) and (tabLetters = bim text medium):
                set tabFace to bim text semibold
            set textWidth to the bim text width of name in face tabFace of atlas
            set tabWidth to textWidth + padding
            set inset to padding * 0.5
            set over to ((pointerX >= x) and (pointerX < (x + tabWidth))) and ((pointerY >= titleHeight) and (pointerY < barHeight))
            set tabInk to scheme's inkSecondary
            if (tabIndex = activeTab) or over:
                set tabInk to scheme's ink
            draw bim ui text name at (x + inset) and (titleHeight + 18.0) in face tabFace with atlas painted tabInk in frame
            if tabIndex = activeTab:
                draw bim ui rectangle (x + inset) (barHeight - 2.0) textWidth 2.0 painted scheme's accent in frame
            if over:
                set hit to @intrinsic("construct", a bim ui hit record, -1, tabIndex, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, 0, (-1) as a 64 bit integer)
            set x to x + tabWidth
        free names
        set tabsEnd to x
        # The fold button at the band's right end: the ribbon away, for more
        # canvas, or back; the active tab's sub-tabs before it.
        set foldLeft to width - 34.0
        set foldOver to ((pointerX >= foldLeft) and (pointerX < (foldLeft + 24.0))) and ((pointerY >= (titleHeight + 2.0)) and (pointerY < (barHeight - 2.0)))
        if foldOver:
            draw bim ui rounded rectangle foldLeft (titleHeight + 2.0) 24.0 24.0 radius 3.0 painted scheme's hover in frame
            set hit to @intrinsic("construct", a bim ui hit record, bim ui fold command, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, 0, (-1) as a 64 bit integer)
        set foldMark to the string form of "^"
        if isFolded:
            set foldMark to the string form of "v"
        draw bim ui text foldMark at (foldLeft + 8.0) and (titleHeight + 19.0) in face (bim text semibold) with atlas painted scheme's inkSecondary in frame
        set subNames to the bim ribbon subtab names of tab activeTab
        set subRight to foldLeft - 8.0
        set subCursor to (the length of subNames) - 1
        loop while (subCursor >= 0) and (isFolded = false):
            set subName to the item at subCursor in subNames
            set subWidth to (the bim text width of subName in face (bim text caption) of atlas) + 16.0
            set subLeft to subRight - subWidth
            # In a narrow window the sub-tabs that would run into the tabs
            # are left out (the ribbon scrolls to every group instead).
            if subLeft < (tabsEnd + 8.0):
                set subCursor to -1
            else:
                set subOver to ((pointerX >= subLeft) and (pointerX < subRight)) and ((pointerY >= (titleHeight + 4.0)) and (pointerY < (barHeight - 4.0)))
                set subInk to scheme's inkSecondary
                if subCursor = activeSub:
                    draw bim ui rounded rectangle subLeft (titleHeight + 4.0) subWidth 20.0 radius 3.0 painted scheme's selected in frame
                    set subInk to scheme's ink
                else if subOver:
                    draw bim ui rounded rectangle subLeft (titleHeight + 4.0) subWidth 20.0 radius 3.0 painted scheme's hover in frame
                    set subInk to scheme's ink
                draw bim ui text subName at (subLeft + 8.0) and (titleHeight + 18.0) in face (bim text caption) with atlas painted subInk in frame
                if subOver:
                    set hit to @intrinsic("construct", a bim ui hit record, (bim ui subtab command) + subCursor, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, 0, (-1) as a 64 bit integer)
                set subRight to subLeft - 4.0
                set subCursor to subCursor - 1
        set shownSub to activeSub
        if shownSub >= (the length of subNames):
            set shownSub to 0
        free subNames
        if pointerY < barHeight:
            set hit's inChrome to true
        if isFolded:
            draw bim ui rectangle 0.0 (barHeight - 1.0) width 1.0 painted scheme's border in frame
            return hit
        # The ribbon of the chosen tab's groups.
        set ribbonTop to barHeight
        draw bim ui rectangle 0.0 ribbonTop width (bim ui ribbon height) painted scheme's panel in frame
        draw bim ui rectangle 0.0 ((ribbonTop + (bim ui ribbon height)) - 1.0) width 1.0 painted scheme's border in frame
        set tabGroups to the bim ribbon groups of tab activeTab
        # The groups of the sub-tab, at full size; when they are wider than
        # the window, compact (buttons stacked three to a column) from the
        # last one back, as far as needed; when even that is too wide, shown
        # from `firstGroup` on, with arrows to scroll by a group.
        set shownGroups to an empty list of a bim ribbon group record
        loop groupCursor from 0 to the length of tabGroups:
            set candidateGroup to the item at groupCursor in tabGroups
            set groupSub to the bim subtab of group candidateGroup's title in tab activeTab
            if ((shownSub = 0) or (groupSub = 0)) or (groupSub = shownSub):
                append candidateGroup to shownGroups
        set fullWidths to an empty list of a 64 bit floating-point number
        set compactWidths to an empty list of a 64 bit floating-point number
        set needed to 0.0
        loop groupCursor from 0 to the length of shownGroups:
            set candidateGroup to the item at groupCursor in shownGroups
            set fullWidth to the bim ribbon group width of candidateGroup using atlas
            append fullWidth to fullWidths
            append (the bim ribbon group width of (the compact form of bim ribbon group candidateGroup) using atlas) to compactWidths
            set needed to needed + fullWidth
        set room to width - 12.0
        set compactFrom to the length of shownGroups
        loop while (needed > room) and (compactFrom > 0):
            set compactFrom to compactFrom - 1
            set needed to (needed - (the item at compactFrom in fullWidths)) + (the item at compactFrom in compactWidths)
        set scrolling to needed > room
        set startGroup to 0
        if scrolling:
            set startGroup to the maximum of 0 and (the minimum of firstGroup and ((the length of shownGroups) - 1))
        set x to 6.0
        if scrolling and (startGroup > 0):
            set hit to draw bim ribbon arrow (the string form of "<") at 2.0 from ribbonTop sending (bim ui ribbon scroll command) pointing at pointerX and pointerY keeping hit using atlas in frame
            set x to 30.0
        set lastShown to (the length of shownGroups) - 1
        set stopped to false
        loop groupCursor from startGroup to the length of shownGroups:
            if stopped = false:
                set shownGroup to the item at groupCursor in shownGroups
                set shownWidth to the item at groupCursor in fullWidths
                if groupCursor >= compactFrom:
                    set shownGroup to the compact form of bim ribbon group shownGroup
                    set shownWidth to the item at groupCursor in compactWidths
                if (scrolling and ((x + shownWidth) > (width - 30.0))) and (groupCursor > startGroup):
                    set stopped to true
                    set lastShown to groupCursor - 1
                else:
                    set x to draw bim ribbon group shownGroup at x from ribbonTop for editor pointing at pointerX and pointerY using atlas into (the address of hit) in frame
        if scrolling and (lastShown < ((the length of shownGroups) - 1)):
            set hit to draw bim ribbon arrow (the string form of ">") at (width - 28.0) from ribbonTop sending ((bim ui ribbon scroll command) + 1) pointing at pointerX and pointerY keeping hit using atlas in frame
        free fullWidths
        free compactWidths
        free shownGroups
        free tabGroups
        if ((pointerY >= barHeight) and (pointerY < (ribbonTop + (bim ui ribbon height)))) and (hit's command < 0):
            set hit's inChrome to true
        return hit

# The quick actions in the title bar.
function the bim header buttons:
    execute:
        set quick to an empty list of a bim ribbon button record
        append (a bim ribbon button (the string form of "Save") sending ((bim ui control command) + 83) with icon bim icon save) to quick
        append (a bim ribbon button (the string form of "Undo") sending 90 with icon bim icon undo) to quick
        append (a bim ribbon button (the string form of "Redo") sending 89 with icon bim icon redo) to quick
        return quick

# The lines a large button's label takes: two, split at the space that
# leaves the wider line narrowest, when it is wider than 60 pixels; else one.
local function the bim wrapped caption of {a string:buttonText} with {bim text atlas record:atlas}:
    execute:
        set lineList to an empty list of a string
        set whole to the bim text width of buttonText in face (bim text caption) of atlas
        set count to the length of buttonText
        set bestSplit to -1
        set bestWidth to whole
        if whole > 60.0:
            loop position from 1 to (count - 1):
                if (the substring of buttonText from position spanning 1 bytes) = (the string form of " "):
                    set firstWidth to the bim text width of (the substring of buttonText from 0 spanning position bytes) in face (bim text caption) of atlas
                    set secondWidth to the bim text width of (the substring of buttonText from (position + 1) spanning ((count - position) - 1) bytes) in face (bim text caption) of atlas
                    set wider to the maximum of firstWidth and secondWidth
                    if wider < bestWidth:
                        set bestWidth to wider
                        set bestSplit to position
        if bestSplit < 0:
            append buttonText to lineList
            return lineList
        append (the substring of buttonText from 0 spanning bestSplit bytes) to lineList
        append (the substring of buttonText from (bestSplit + 1) spanning ((count - bestSplit) - 1) bytes) to lineList
        return lineList

# The width of a large button with `label`: 56 pixels, or its label's.
local function the bim large tile width of {a string:buttonText} with {bim text atlas record:atlas}:
    execute:
        set labelLines to the bim wrapped caption of buttonText with atlas
        set labelWidth to 0.0
        loop lineCursor from 0 to the length of labelLines:
            set labelWidth to the maximum of labelWidth and (the bim text width of (the item at lineCursor in labelLines) in face (bim text caption) of atlas)
        free labelLines
        return the maximum of 56.0 and (labelWidth + 12.0)

# The width ribbon group `ribbonGroup` takes, as `draw bim ribbon group`
# lays it out, its separator included.
local function the bim ribbon group width of {bim ribbon group record:ribbonGroup} using {bim text atlas record:atlas}:
    execute:
        set x to 0.0
        set smallRow to 0
        set columnLeft to 0.0
        set columnWidth to 0.0
        loop cursor from 0 to the length of (ribbonGroup's buttons):
            set button to the item at cursor in (ribbonGroup's buttons)
            if button's small:
                if smallRow = 0:
                    set columnLeft to x
                    set columnWidth to 0.0
                set columnWidth to the maximum of columnWidth and ((the bim text width of button's label in face (bim text caption) of atlas) + 30.0)
                set smallRow to smallRow + 1
                set nextSmall to false
                if (cursor + 1) < (the length of (ribbonGroup's buttons)):
                    set nextSmall to (the item at (cursor + 1) in (ribbonGroup's buttons))'s small
                if (smallRow = 3) or (nextSmall = false):
                    set x to (columnLeft + columnWidth) + 2.0
                    set smallRow to 0
            else:
                set x to (x + (the bim large tile width of button's label with atlas)) + 2.0
        set titleWidth to the bim caps width of ribbonGroup's title with atlas
        return (the maximum of (x - 2.0) and (titleWidth + 12.0)) + 11.0

# Ribbon group `ribbonGroup` with every button small, three to a column.
local function the compact form of bim ribbon group {bim ribbon group record:ribbonGroup}:
    execute:
        set smallGroup to a bim ribbon group titled ribbonGroup's title
        loop cursor from 0 to the length of (ribbonGroup's buttons):
            set button to the item at cursor in (ribbonGroup's buttons)
            append (a small bim ribbon button button's label keyed button's key sending button's command with icon button's icon) to (smallGroup's buttons)
        return smallGroup

# An arrow that scrolls the ribbon, 26 pixels wide at `left`, sending
# `arrowCommand`; `hit` with the arrow when the pointer is over it.
local function draw bim ribbon arrow {a string:mark} at {a 64 bit floating-point number:left} from {a 64 bit floating-point number:ribbonTop} sending {integer:arrowCommand} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} keeping {bim ui hit record:hit} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        set arrowHit to hit
        set over to ((pointerX >= left) and (pointerX < (left + 26.0))) and ((pointerY >= (ribbonTop + 4.0)) and (pointerY < ((ribbonTop + (bim ui ribbon height)) - 4.0)))
        set arrowInk to scheme's inkSecondary
        if over:
            draw bim ui rounded rectangle left (ribbonTop + 4.0) 26.0 ((bim ui ribbon height) - 8.0) radius 3.0 painted scheme's hover in frame
            set arrowHit to @intrinsic("construct", a bim ui hit record, arrowCommand, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, 0, (-1) as a 64 bit integer)
            set arrowInk to scheme's ink
        draw bim ui text mark at (left + 9.0) and ((ribbonTop + ((bim ui ribbon height) * 0.5)) + 5.0) in face (bim text semibold) with atlas painted arrowInk in frame
        return arrowHit

# Draws ribbon group `ribbonGroup` from `left` on the ribbon at `ribbonTop`:
# its buttons (large ones 66 pixels high, a 22 pixel icon in a 32 pixel tile
# over a label of one or two lines; small ones 22 high, three to a column,
# a 16 pixel icon beside the label), its title at the foot in mono capitals
# and a short separator; the button under the pointer goes to `hitTarget`.
# Where the next group starts.
function draw bim ribbon group {bim ribbon group record:ribbonGroup} at {a 64 bit floating-point number:left} from {a 64 bit floating-point number:ribbonTop} for {bim editor record:editor} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} using {bim text atlas record:atlas} into {a pointer to a bim ui hit record:hitTarget} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        set groupStart to left + 4.0
        set x to groupStart
        set contentTop to ribbonTop + 4.0
        set smallRow to 0
        set columnLeft to x
        set columnWidth to 0.0
        loop cursor from 0 to the length of (ribbonGroup's buttons):
            set button to the item at cursor in (ribbonGroup's buttons)
            set available to button's command >= 0
            set buttonInk to scheme's ink
            set buttonAccent to scheme's accentInk
            if available = false:
                set buttonInk to scheme's inkDisabled
                set buttonAccent to scheme's inkDisabled
            if button's small:
                # Small buttons fill a column of three, top to bottom.
                if smallRow = 0:
                    set columnLeft to x
                    set columnWidth to 0.0
                set rowTop to contentTop + ((smallRow as a 64 bit floating-point number) * 22.0)
                set smallWidth to (the bim text width of button's label in face (bim text caption) of atlas) + 30.0
                set columnWidth to the maximum of columnWidth and smallWidth
                set smallOver to ((pointerX >= columnLeft) and (pointerX < (columnLeft + smallWidth))) and ((pointerY >= rowTop) and (pointerY < (rowTop + 22.0)))
                if smallOver and available:
                    draw bim ui rounded rectangle columnLeft rowTop smallWidth 22.0 radius 3.0 painted scheme's hover in frame
                    set hitTarget's command to button's command
                    set hitTarget's inChrome to true
                draw bim ui icon button's icon sized 16 at (columnLeft + 4.0) and (rowTop + 3.0) painted buttonInk accented buttonAccent with atlas in frame
                draw bim ui text button's label at (columnLeft + 24.0) and (rowTop + 15.0) in face (bim text caption) with atlas painted buttonInk in frame
                set smallRow to smallRow + 1
                set nextSmall to false
                if (cursor + 1) < (the length of (ribbonGroup's buttons)):
                    set nextSmall to (the item at (cursor + 1) in (ribbonGroup's buttons))'s small
                if (smallRow = 3) or (nextSmall = false):
                    set x to (columnLeft + columnWidth) + 2.0
                    set smallRow to 0
            else:
                set labelLines to the bim wrapped caption of button's label with atlas
                set buttonWidth to the bim large tile width of button's label with atlas
                set over to ((pointerX >= x) and (pointerX < (x + buttonWidth))) and ((pointerY >= contentTop) and (pointerY < (contentTop + 66.0)))
                set active to the bim ribbon tool button's command is on for editor
                if over and available:
                    draw bim ui rounded rectangle x contentTop buttonWidth 66.0 radius 6.0 painted scheme's hover in frame
                set tileLeft to x + ((buttonWidth - 32.0) * 0.5)
                if active:
                    # The active tool: its icon in a tile with an accent rim.
                    draw bim ui rounded rectangle tileLeft (contentTop + 3.0) 32.0 32.0 radius 6.0 painted scheme's selectedBar in frame
                    draw bim ui rounded rectangle (tileLeft + 1.0) (contentTop + 4.0) 30.0 30.0 radius 5.0 painted scheme's selected in frame
                    set buttonInk to scheme's accentInk
                draw bim ui icon button's icon sized 22 at (tileLeft + 5.0) and (contentTop + 8.0) painted buttonInk accented buttonAccent with atlas in frame
                set labelInk to scheme's ink
                if available = false:
                    set labelInk to scheme's inkDisabled
                set firstBaseline to contentTop + 52.0
                if (the length of labelLines) > 1:
                    set firstBaseline to contentTop + 48.0
                loop lineCursor from 0 to the length of labelLines:
                    set lineText to the item at lineCursor in labelLines
                    set lineWidth to the bim text width of lineText in face (bim text caption) of atlas
                    draw bim ui text lineText at (x + ((buttonWidth - lineWidth) * 0.5)) and (firstBaseline + ((lineCursor as a 64 bit floating-point number) * 13.0)) in face (bim text caption) with atlas painted labelInk in frame
                free labelLines
                if over and available:
                    set hitTarget's command to button's command
                    set hitTarget's inChrome to true
                set x to (x + buttonWidth) + 2.0
        # The group's title centred at the foot, and a short separator.
        set titleWidth to the bim caps width of ribbonGroup's title with atlas
        set groupWidth to the maximum of ((x - 2.0) - groupStart) and (titleWidth + 12.0)
        draw bim ui caps ribbonGroup's title at (groupStart + ((groupWidth - titleWidth) * 0.5)) and (ribbonTop + 87.0) with atlas painted scheme's inkSecondary in frame
        set separatorX to (groupStart + groupWidth) + 5.0
        draw bim ui rectangle separatorX (ribbonTop + 10.0) 1.0 ((bim ui ribbon height) - 20.0) painted scheme's border in frame
        return separatorX + 2.0

# Whether the tool ribbon command `sent` starts is the editor's tool now.
local function the bim ribbon tool {integer:sent} is on for {bim editor record:editor}:
    execute:
        if (sent = 83) and (editor's tool = bim select tool):
            return true
        if (sent = 87) and (editor's tool = bim wall tool):
            return true
        if (sent = 79) and (editor's tool = bim opening tool):
            return editor's openingTypeId = editor's windowTypeId
        if (sent = 68) and (editor's tool = bim opening tool):
            return editor's openingTypeId = editor's doorTypeId
        if (sent = 73) and (editor's tool = bim grid tool):
            return true
        if (sent = 67) and (editor's tool = bim section tool):
            return true
        if (sent = 78) and (editor's tool = bim line tool):
            return true
        if (sent = 82) and (editor's tool = bim rectangle tool):
            return true
        if (sent = 80) and (editor's tool = bim push tool):
            return true
        if (sent = 77) and (editor's tool = bim move tool):
            return true
        if (sent = 2112) and (editor's tool = bim curtain tool):
            return true
        if (sent = ((bim ui control command) + 84)) and (editor's tool = bim text tool):
            return true
        return false

# The key that sends `sent`, for its tooltip: a letter, Ctrl and a
# letter, Del; empty for none.
function the bim key name sending {integer:sent}:
    execute:
        set letter to sent
        set prefix to the string form of ""
        if (sent >= (bim ui control command)) and (sent < ((bim ui control command) + 256)):
            set letter to sent - (bim ui control command)
            set prefix to the string form of "Ctrl+"
        if (letter >= 65) and (letter <= 90):
            set written to a new string buffer containing 1 bytes
            store (letter as a byte) into the data of written at 0
            return prefix + written
        if sent = 261:
            return the string form of "Del"
        return the string form of ""

# The tooltip of the ribbon button that sends `sent` (on tab `activeTab`
# or among the quick actions): its label and, in mono, its key, below the
# pointer; nothing when no button sends it.
function draw bim ribbon tooltip of tab {integer:activeTab} for command {integer:sent} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} across {a 64 bit floating-point number:width} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        if sent < 0:
            return nothing
        set scheme to the bim ui palette
        set tipLabel to the string form of ""
        set tipKey to the string form of ""
        set quick to the bim header buttons
        loop cursor from 0 to the length of quick:
            set button to the item at cursor in quick
            if button's command = sent:
                set tipLabel to button's label
        free quick
        set tabGroups to the bim ribbon groups of tab activeTab
        loop groupCursor from 0 to the length of tabGroups:
            set ribbonGroup to the item at groupCursor in tabGroups
            loop cursor from 0 to the length of (ribbonGroup's buttons):
                set button to the item at cursor in (ribbonGroup's buttons)
                if (button's command = sent) and ((the length of tipLabel) = 0):
                    set tipLabel to button's label
                    set tipKey to button's key
        free tabGroups
        if (the length of tipLabel) = 0:
            return nothing
        if (the length of tipKey) = 0:
            set tipKey to the bim key name sending sent
        set labelWidth to the bim text width of tipLabel in face (bim text caption) of atlas
        set keyWidth to 0.0
        if (the length of tipKey) > 0:
            set keyWidth to (the bim text width of tipKey in face (bim text mono label) of atlas) + 12.0
        set boxWidth to (labelWidth + keyWidth) + 16.0
        set boxLeft to the minimum of (pointerX + 4.0) and ((width - boxWidth) - 4.0)
        set boxTop to pointerY + 20.0
        draw bim ui rounded rectangle (boxLeft - 1.0) (boxTop - 1.0) (boxWidth + 2.0) 26.0 radius 4.0 painted scheme's strong in frame
        draw bim ui rounded rectangle boxLeft boxTop boxWidth 24.0 radius 3.0 painted scheme's raised in frame
        draw bim ui text tipLabel at (boxLeft + 8.0) and (boxTop + 16.0) in face (bim text caption) with atlas painted scheme's ink in frame
        if (the length of tipKey) > 0:
            draw bim ui text tipKey at ((boxLeft + labelWidth) + 20.0) and (boxTop + 16.0) in face (bim text mono label) with atlas painted scheme's inkSecondary in frame

# The document bar: one tab naming the open model, in the workspace's
# colour so that it runs into the canvas, with an accent dot while it has
# changes not saved (`hasChanges`).
function draw bim document bar named {a string:name} unsaved {boolean:hasChanges} across {a 64 bit floating-point number:width} folded {boolean:isFolded} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        set top to (the bim ui canvas top folded isFolded) - (bim ui document bar height)
        draw bim ui rectangle 0.0 top width (bim ui document bar height) painted scheme's docbar in frame
        set nameWidth to the bim text width of name in face (bim text semibold) of atlas
        set tabWidth to nameWidth + 24.0
        if hasChanges:
            set tabWidth to tabWidth + 14.0
        draw bim ui top rounded rectangle 8.0 (top + 6.0) tabWidth ((bim ui document bar height) - 6.0) radius 6.0 painted scheme's workspace in frame
        draw bim ui text name at 20.0 and (top + 22.0) in face (bim text semibold) with atlas painted scheme's workspaceInk in frame
        if hasChanges:
            draw bim ui rounded rectangle ((20.0 + nameWidth) + 8.0) (top + 15.0) 6.0 6.0 radius 3.0 painted scheme's accent in frame

# The project explorer: the storeys (the active one marked, a click activates
# one), the views and the selected element's properties. Returns what a click
# at the pointer hits.
# The project browser's actions.
function bim browser toggle:
    replacement:
        1
function bim browser plan:
    replacement:
        2
function bim browser model view:
    replacement:
        3
function bim browser section view:
    replacement:
        4
function bim browser schedule view:
    replacement:
        5
function bim browser opening type:
    replacement:
        6
function bim browser component:
    replacement:
        7
function bim browser type selector:
    replacement:
        8
function bim browser property:
    replacement:
        9
# A linear type chosen in the type selector.
function bim browser linear type:
    replacement:
        10
# A planar type of a floor, roof or ceiling chosen.
function bim browser plate type:
    replacement:
        11
function bim browser sheet:
    replacement:
        12
# A building system chosen in the browser: it is selected.
function bim browser building system:
    replacement:
        13
# A building system type chosen in the type selector (its index in `the
# bim system types`).
function bim browser system type:
    replacement:
        14
# A stair or railing type chosen in the type selector (its index in `the
# bim stair types`).
function bim browser stair type:
    replacement:
        15

# The project browser's groups, by index into the open/closed flags.
function bim browser views group:
    replacement:
        0
function bim browser plans group:
    replacement:
        1
function bim browser families group:
    replacement:
        2
function bim browser walls group:
    replacement:
        3
function bim browser floors group:
    replacement:
        4
function bim browser openings group:
    replacement:
        5
function bim browser components group:
    replacement:
        6
function bim browser schedules group:
    replacement:
        7
function bim browser sheets group:
    replacement:
        8
function bim browser elevations group:
    replacement:
        9
function bim browser systems group:
    replacement:
        10
function the bim browser group count:
    replacement:
        11

# One row of the project browser at `rowTop` (scrolled), `depth` steps in:
# drawn when it lies between `top` and `limit`, highlighted when `current`,
# with a + or - when it is a group (`expander` 1 closed, 0 open, -1 none).
# Whether the pointer is over it.
local function draw bim browser row {a string:label} at {a 64 bit floating-point number:rowTop} depth {integer:indent} current {boolean:isCurrent} expander {integer:expanderState} between {a 64 bit floating-point number:top} and {a 64 bit floating-point number:limit} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        if (rowTop < top) or ((rowTop + 20.0) > limit):
            return false
        set panelWidth to bim ui explorer width
        set panelLeft to bim ui rail width
        set over to (((pointerX >= panelLeft) and (pointerX < (panelLeft + panelWidth))) and (pointerY >= rowTop)) and (pointerY < (rowTop + 20.0))
        if isCurrent:
            draw bim ui rectangle (panelLeft + 6.0) rowTop (panelWidth - 12.0) 20.0 coloured 22, 74 and 104 in frame
        else if over:
            draw bim ui rectangle (panelLeft + 6.0) rowTop (panelWidth - 12.0) 20.0 coloured 50, 50 and 50 in frame
        set x to (panelLeft + 10.0) + ((indent as a 64 bit floating-point number) * 14.0)
        if expanderState >= 0:
            set sign to the string form of "-"
            if expanderState = 1:
                set sign to the string form of "+"
            draw bim text sign at x and (rowTop + 15.0) in face (bim text bold) with atlas coloured 150, 150 and 150 in frame
        if (expanderState >= 0) and (indent = 0):
            draw bim text label at (x + 14.0) and (rowTop + 15.0) in face (bim text caption) with atlas coloured 170, 170 and 170 cut at ((panelLeft + panelWidth) - 8.0) in frame
        else:
            draw bim text label at (x + 14.0) and (rowTop + 15.0) in face (bim text small) with atlas coloured 230, 230 and 230 cut at ((panelLeft + panelWidth) - 8.0) in frame
        return over

# The project browser, as in Revit: the views (floor plans per storey, the 3D
# view, the section, the schedule) and the families (wall, floor, door and
# window types, components), in groups that open and close (`closed`, one flag
# per group), scrolled up by `scrolled` pixels; then the selection's
# properties. A click opens a view, makes a type current, or starts placing a
# component.
function draw bim explorer of {bim editor record:editor} closing {a pointer to a list:closed} scrolled {a 64 bit floating-point number:scrolled} choosing {boolean:selectorOpen} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} below {a 64 bit floating-point number:chromeBottom} down to {a 64 bit floating-point number:bottom} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set hit to no bim ui hit
        set top to chromeBottom
        set panelWidth to bim ui explorer width
        set panelLeft to bim ui rail width
        draw bim ui rectangle panelLeft top panelWidth (bottom - top) coloured 26, 26 and 26 in frame
        draw bim ui rectangle ((panelLeft + panelWidth) - 1.0) top 1.0 (bottom - top) coloured 64, 64 and 64 in frame
        if ((pointerX >= panelLeft) and (pointerX < (panelLeft + panelWidth))) and ((pointerY >= top) and (pointerY < bottom)):
            set hit's inChrome to true
        draw bim text (the string form of "PROJECT BROWSER") at (panelLeft + 12.0) and (top + 22.0) in face (bim text bold) with atlas coloured 242, 242 and 242 in frame
        # The tree takes the whole panel; the properties are on the right
        # (`draw bim properties of`).
        set treeTop to top + 32.0
        set treeLimit to bottom - 8.0
        set y to treeTop - scrolled
        set modelValue to editor's documentValue's current
        set rows to 0
        # Views.
        set groupOpen to (the item at bim browser views group in closed) = false
        set marker to 0
        if groupOpen = false:
            set marker to 1
        if draw bim browser row (the string form of "VIEWS") at y depth 0 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
            set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser views group) as a 64 bit integer)
        set y to y + 20.0
        if groupOpen:
            set plansOpen to (the item at bim browser plans group in closed) = false
            set marker to 0
            if plansOpen = false:
                set marker to 1
            if draw bim browser row (the string form of "Floor plans") at y depth 1 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser plans group) as a 64 bit integer)
            set y to y + 20.0
            if plansOpen:
                # The plan views, highest storey first, as in a section
                # through the building.
                set levels to modelValue's levels's values
                set levelIndex to (the length of levels) - 1
                loop while levelIndex >= 0:
                    set level to the item at levelIndex in levels
                    loop viewCursor from 0 to the length of (modelValue's views's values):
                        set planView to the item at viewCursor in (modelValue's views's values)
                        set typedOther to (planView's drawingTypeId != the bim refused id) and ((the bim drawing type named (the string form of "Floor plan") in modelValue) != planView's drawingTypeId)
                        if ((planView's kind = bim plan view) and (planView's levelId = level's id)) and (typedOther = false):
                            if draw bim browser row planView's name at y depth 2 current (planView's id = editor's planViewId) expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, level's id, true, (-1) as a 64 bit integer, -1, bim browser plan, planView's id)
                            set y to y + 20.0
                    set levelIndex to levelIndex - 1
            # The plans following another drawing type, under its name, as
            # Revit groups views by their type.
            loop typeCursor from 0 to the length of (modelValue's drawingTypes's values):
                set drawingType to the item at typeCursor in (modelValue's drawingTypes's values)
                set typeViews to an empty list of a 64 bit integer
                set typeLevels to an empty list of a 64 bit integer
                set typeNames to an empty list of a string
                if drawingType's name != (the string form of "Floor plan"):
                    loop viewCursor from 0 to the length of (modelValue's views's values):
                        set typedView to the item at viewCursor in (modelValue's views's values)
                        if (typedView's kind = bim plan view) and (typedView's drawingTypeId = drawingType's id):
                            append typedView's id to typeViews
                            append typedView's levelId to typeLevels
                            append typedView's name to typeNames
                if (the length of typeViews) > 0:
                    ignore draw bim browser row drawingType's name at y depth 1 current false expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame
                    set y to y + 20.0
                    loop typedCursor from 0 to the length of typeViews:
                        if draw bim browser row (the item at typedCursor in typeNames) at y depth 2 current ((the item at typedCursor in typeViews) = editor's planViewId) expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                            set hit to @intrinsic("construct", a bim ui hit record, -1, -1, the item at typedCursor in typeLevels, true, (-1) as a 64 bit integer, -1, bim browser plan, the item at typedCursor in typeViews)
                        set y to y + 20.0
                free typeViews
                free typeLevels
                free typeNames
            if draw bim browser row (the string form of "3D view") at y depth 1 current false expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser model view, (-1) as a 64 bit integer)
            set y to y + 20.0
            # The elevations, a group of their own: views looking level at a
            # side of the building, drawn as 2D views.
            set elevationsOpen to (the item at bim browser elevations group in closed) = false
            set marker to 0
            if elevationsOpen = false:
                set marker to 1
            if draw bim browser row (the string form of "Elevations") at y depth 1 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser elevations group) as a 64 bit integer)
            set y to y + 20.0
            if elevationsOpen:
                loop viewCursor from 0 to the length of (modelValue's views's values):
                    set elevationView to the item at viewCursor in (modelValue's views's values)
                    if (elevationView's kind = bim model view) and (elevationView's detail > (0 as a 64 bit integer)):
                        if draw bim browser row elevationView's name at y depth 2 current false expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                            set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser model view, elevationView's id)
                        set y to y + 20.0
            # The section views, each opening in its own tab.
            loop viewCursor from 0 to the length of (modelValue's views's values):
                set sectionView to the item at viewCursor in (modelValue's views's values)
                if sectionView's kind = bim section view:
                    if draw bim browser row sectionView's name at y depth 1 current (sectionView's id = editor's sectionViewId) expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                        set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser section view, sectionView's id)
                    set y to y + 20.0
            # The schedules, each opening in its own tab.
            set schedulesOpen to (the item at bim browser schedules group in closed) = false
            set marker to 0
            if schedulesOpen = false:
                set marker to 1
            if draw bim browser row (the string form of "Schedules") at y depth 1 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser schedules group) as a 64 bit integer)
            set y to y + 20.0
            if schedulesOpen:
                loop scheduleCode from 0 to the bim schedule count:
                    if draw bim browser row (the bim schedule name of scheduleCode) at y depth 2 current false expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                        set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser schedule view, scheduleCode as a 64 bit integer)
                    set y to y + 20.0
            # The sheets, each opening in its own tab.
            set sheetsOpen to (the item at bim browser sheets group in closed) = false
            set marker to 0
            if sheetsOpen = false:
                set marker to 1
            if draw bim browser row (the string form of "Sheets") at y depth 1 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser sheets group) as a 64 bit integer)
            set y to y + 20.0
            if sheetsOpen:
                loop sheetCursor from 0 to the length of (modelValue's sheets's values):
                    set sheetValue to the item at sheetCursor in (modelValue's sheets's values)
                    if draw bim browser row ((sheetValue's number + (the string form of " ")) + sheetValue's name) at y depth 2 current (sheetValue's id = editor's sheetId) expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                        set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser sheet, sheetValue's id)
                    set y to y + 20.0
        # Building components: the types, and the building systems.
        set groupOpen to (the item at bim browser families group in closed) = false
        set marker to 0
        if groupOpen = false:
            set marker to 1
        if draw bim browser row (the string form of "BUILDING COMPONENTS") at y depth 0 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
            set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser families group) as a 64 bit integer)
        set y to y + 20.0
        if groupOpen:
            # Wall types; the current one is the selected wall's, if any.
            set currentType to editor's wallTypeId
            if editor's selectionKind = bim wall picked:
                set selectedWall to the bim wall index of editor's selectionId in modelValue
                if selectedWall's valid:
                    set currentType to (the item at selectedWall's position in (modelValue's walls's values))'s typeId
            set wallsOpen to (the item at bim browser walls group in closed) = false
            set marker to 0
            if wallsOpen = false:
                set marker to 1
            set wallTypeCount to 0
            loop typeIndex from 0 to the length of (modelValue's wallTypes's values):
                if (the item at typeIndex in (modelValue's wallTypes's values))'s role = bim wall planar role:
                    set wallTypeCount to wallTypeCount + 1
            if draw bim browser row ((the string form of "Walls (") + ((the string form of wallTypeCount) + (the string form of ")"))) at y depth 1 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser walls group) as a 64 bit integer)
            set y to y + 20.0
            if wallsOpen:
                loop typeIndex from 0 to the length of (modelValue's wallTypes's values):
                    set wallType to the item at typeIndex in (modelValue's wallTypes's values)
                    if wallType's role = bim wall planar role:
                        set millimetres to ((the bim thickness of wallType) * 1000.0) + 0.5
                        # The thickness, unless the name already says it.
                        set label to wallType's name
                        if (the index of (the string form of (millimetres as an integer)) in wallType's name) < 0:
                            set label to (wallType's name + (the string form of "  ")) + ((the string form of (millimetres as an integer)) + (the string form of " mm"))
                        if draw bim browser row label at y depth 2 current (wallType's id = currentType) expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                            set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, wallType's id, -1, 0, (-1) as a 64 bit integer)
                        set y to y + 20.0
            set floorsOpen to (the item at bim browser floors group in closed) = false
            set marker to 0
            if floorsOpen = false:
                set marker to 1
            if draw bim browser row (the string form of "Floors, roofs, ceilings") at y depth 1 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser floors group) as a 64 bit integer)
            set y to y + 20.0
            if floorsOpen:
                loop typeIndex from 0 to the length of (modelValue's wallTypes's values):
                    set plateType to the item at typeIndex in (modelValue's wallTypes's values)
                    if plateType's role != bim wall planar role:
                        if draw bim browser row plateType's name at y depth 2 current (plateType's id = editor's plateTypeId) expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                            set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser plate type, plateType's id)
                        set y to y + 20.0
            set openingsOpen to (the item at bim browser openings group in closed) = false
            set marker to 0
            if openingsOpen = false:
                set marker to 1
            if draw bim browser row (the string form of "Doors and windows") at y depth 1 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser openings group) as a 64 bit integer)
            set y to y + 20.0
            if openingsOpen:
                loop typeIndex from 0 to the length of (modelValue's openingTypes's values):
                    set openingType to the item at typeIndex in (modelValue's openingTypes's values)
                    if draw bim browser row openingType's name at y depth 2 current (openingType's id = editor's openingTypeId) expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                        set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser opening type, openingType's id)
                    set y to y + 20.0
            set componentsOpen to (the item at bim browser components group in closed) = false
            set marker to 0
            if componentsOpen = false:
                set marker to 1
            if draw bim browser row ((the string form of "Components (") + ((the string form of (the length of (modelValue's components's values))) + (the string form of ")"))) at y depth 1 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser components group) as a 64 bit integer)
            set y to y + 20.0
            if componentsOpen:
                loop typeIndex from 0 to the length of (modelValue's components's values):
                    set definition to the item at typeIndex in (modelValue's components's values)
                    if draw bim browser row definition's name at y depth 2 current (definition's id = editor's placeComponentId) expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                        set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser component, definition's id)
                    set y to y + 20.0
            # The building systems, each named by its grid and frame; a click
            # selects it.
            set systemsOpen to (the item at bim browser systems group in closed) = false
            set marker to 0
            if systemsOpen = false:
                set marker to 1
            if draw bim browser row ((the string form of "Building systems (") + ((the string form of (the length of (modelValue's curtains's values))) + (the string form of ")"))) at y depth 1 current false expander marker between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser toggle, (bim browser systems group) as a 64 bit integer)
            set y to y + 20.0
            if systemsOpen:
                loop typeIndex from 0 to the length of (modelValue's curtains's values):
                    set systemValue to the item at typeIndex in (modelValue's curtains's values)
                    set chosenSystem to (editor's selectionKind = bim curtain picked) and (editor's selectionId = systemValue's id)
                    if draw bim browser row (the bim system name of systemValue) at y depth 2 current chosenSystem expander -1 between treeTop and treeLimit pointing at pointerX and pointerY using atlas in frame:
                        set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser building system, systemValue's id)
                    set y to y + 20.0
        return hit

# The width of the properties panel on the right (the style's 240 pixels).
function bim ui properties width:
    replacement:
        240.0

# A type's picture, 24 by 14 pixels at (`left`, `top`): a wall or floor type
# its layers as bands in their materials' colours, a linear type its
# profile, a door or window type a frame with its sash, a component a box.
local function draw bim type picture of kind {integer:kindCode} numbered {a 64 bit integer:typeId} in {bim model record:modelValue} at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:top} in {graphics frame:frame}:
    execute:
        if (kindCode = 0) or (kindCode = 2):
            set typeFound to the bim wall type index of typeId in modelValue
            if typeFound's valid:
                set layeredType to the item at typeFound's position in (modelValue's wallTypes's values)
                set total to the bim thickness of layeredType
                if total > 0.0:
                    set reached to 0.0
                    loop layerCursor from 0 to the length of (layeredType's layers's values):
                        set layer to the item at layerCursor in (layeredType's layers's values)
                        set bandTop to top + ((reached / total) * 14.0)
                        set reached to reached + layer's thickness
                        set bandHeight to the maximum of 1.0 and ((top + ((reached / total) * 14.0)) - bandTop)
                        set bandColour to the bim material colour of layer's material
                        draw bim ui rectangle left bandTop 24.0 bandHeight coloured (bandColour's x as an integer), (bandColour's y as an integer) and (bandColour's z as an integer) in frame
            return nothing
        if kindCode = 4:
            set linearFound to the bim linear type index of typeId in modelValue
            if linearFound's valid:
                set linearType to the item at linearFound's position in (modelValue's linearTypes's values)
                set longest to the maximum of linearType's width and linearType's depth
                if longest > 0.0:
                    set profileColour to the bim material colour of linearType's material
                    set across to the maximum of 2.0 and ((linearType's width / longest) * 14.0)
                    set tall to the maximum of 2.0 and ((linearType's depth / longest) * 14.0)
                    draw bim ui rectangle (left + ((24.0 - across) * 0.5)) (top + ((14.0 - tall) * 0.5)) across tall coloured (profileColour's x as an integer), (profileColour's y as an integer) and (profileColour's z as an integer) in frame
            return nothing
        if kindCode = 1:
            draw bim ui rectangle (left + 4.0) top 16.0 14.0 coloured 200, 200 and 200 in frame
            draw bim ui rectangle (left + 6.0) (top + 2.0) 12.0 10.0 coloured 120, 170 and 215 in frame
            return nothing
        if (kindCode = 5) or (kindCode = 6):
            # A building system: glass in a frame of two bays and two rows.
            draw bim ui rectangle left top 24.0 14.0 coloured 190, 195 and 205 in frame
            draw bim ui rectangle (left + 1.5) (top + 1.5) 9.75 4.75 coloured 120, 170 and 215 in frame
            draw bim ui rectangle (left + 12.75) (top + 1.5) 9.75 4.75 coloured 120, 170 and 215 in frame
            draw bim ui rectangle (left + 1.5) (top + 7.75) 9.75 4.75 coloured 120, 170 and 215 in frame
            draw bim ui rectangle (left + 12.75) (top + 7.75) 9.75 4.75 coloured 120, 170 and 215 in frame
            return nothing
        draw bim ui rectangle (left + 5.0) (top + 1.0) 14.0 12.0 coloured 170, 175 and 190 in frame

# The properties panel on the right, from `panelLeft` down to `bottom`, as in
# Revit: the type selector, then the selection's properties (or, with nothing
# selected, the active storey's and the drawing's). A click on the selector
# opens its list; a click on a field begins typing it.
function draw bim properties of {bim editor record:editor} choosing {boolean:selectorOpen} folding {a pointer to a list:closedHeadings} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} from {a 64 bit floating-point number:panelLeft} below {a 64 bit floating-point number:chromeBottom} down to {a 64 bit floating-point number:bottom} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        return draw bim properties of editor scrolled 0.0 choosing selectorOpen folding closedHeadings pointing at pointerX and pointerY from panelLeft below chromeBottom down to bottom using atlas in frame

# The same, its rows scrolled up by `scrollOffset` pixels.
function draw bim properties of {bim editor record:editor} scrolled {a 64 bit floating-point number:scrollOffset} choosing {boolean:selectorOpen} folding {a pointer to a list:closedHeadings} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} from {a 64 bit floating-point number:panelLeft} below {a 64 bit floating-point number:chromeBottom} down to {a 64 bit floating-point number:bottom} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set propertyRows to the bim property rows of editor
        set hit to draw bim properties of editor listing propertyRows scrolled scrollOffset choosing selectorOpen folding closedHeadings pointing at pointerX and pointerY from panelLeft below chromeBottom down to bottom using atlas in frame
        free propertyRows
        return hit

# `message` as it fits in `room` pixels of face `faceIndex`: whole, or cut
# short with "..." after what fits.
function the bim fitted form of {a string:message} in {a 64 bit floating-point number:room} pixels of face {integer:faceIndex} with {bim text atlas record:atlas}:
    execute:
        if (the bim text width of message in face faceIndex of atlas) <= room:
            return message
        set dots to the string form of "..."
        set kept to (the length of message) - 1
        loop while kept > 0:
            set shortened to (the substring of message from 0 spanning kept bytes) + dots
            if (the bim text width of shortened in face faceIndex of atlas) <= room:
                return shortened
            set kept to kept - 1
        return dots

# Whether `shown` begins as a number does (a digit, or a sign or point
# before one), to be set in mono on the right.
local function the bim figure flag of {a string:shown}:
    execute:
        if (the length of shown) = 0:
            return false
        set lead to the character at 0 in shown
        if (lead >= 48) and (lead <= 57):
            return true
        if ((lead = 45) or (lead = 46)) and ((the length of shown) > 1):
            set second to the character at 1 in shown
            return (second >= 48) and (second <= 57)
        return false

# The same with the rows given (`the bim property rows of`, or an imported
# element's, which the editor does not hold).
function draw bim properties of {bim editor record:editor} listing {a pointer to a list:propertyRows} scrolled {a 64 bit floating-point number:scrollOffset} choosing {boolean:selectorOpen} folding {a pointer to a list:closedHeadings} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} from {a 64 bit floating-point number:panelLeft} below {a 64 bit floating-point number:chromeBottom} down to {a 64 bit floating-point number:bottom} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set hit to no bim ui hit
        set top to chromeBottom
        set panelWidth to bim ui properties width
        set modelValue to editor's documentValue's current
        set scheme to the bim ui palette
        draw bim ui rectangle panelLeft top panelWidth (bottom - top) painted scheme's panel in frame
        draw bim ui rectangle panelLeft top 1.0 (bottom - top) painted scheme's border in frame
        if ((pointerX >= panelLeft) and (pointerX < (panelLeft + panelWidth))) and ((pointerY >= top) and (pointerY < bottom)):
            set hit's inChrome to true
        # The panel's head, 24 pixels: its name in mono capitals and a close
        # button (the canvas takes the room; the rail's Properties brings it
        # back).
        draw bim ui rectangle (panelLeft + 1.0) (top + 23.0) (panelWidth - 1.0) 1.0 painted scheme's border in frame
        draw bim ui caps (the string form of "Properties") at (panelLeft + 10.0) and (top + 16.0) with atlas painted scheme's inkSecondary in frame
        set closeLeft to (panelLeft + panelWidth) - 24.0
        set closeOver to ((pointerX >= closeLeft) and (pointerX < (closeLeft + 20.0))) and ((pointerY >= (top + 2.0)) and (pointerY < (top + 22.0)))
        set closeInk to scheme's inkSecondary
        if closeOver:
            draw bim ui rounded rectangle closeLeft (top + 2.0) 20.0 20.0 radius 3.0 painted scheme's hover in frame
            set closeInk to scheme's ink
            set hit to @intrinsic("construct", a bim ui hit record, bim ui properties command, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, 0, (-1) as a 64 bit integer)
        draw bim ui line from (closeLeft + 6.5) (top + 8.5) to (closeLeft + 13.5) (top + 15.5) wide 1.5 coloured closeInk's red, closeInk's green and closeInk's blue in frame
        draw bim ui line from (closeLeft + 13.5) (top + 8.5) to (closeLeft + 6.5) (top + 15.5) wide 1.5 coloured closeInk's red, closeInk's green and closeInk's blue in frame
        set y to top + 32.0
        # The type selector, as in Revit: the type of the selection, or of
        # what the tool draws next; a click opens the list of that category's
        # types, downward over the properties, each with a small picture.
        set category to 0
        if (editor's selectionKind = bim opening picked) or ((editor's selectionKind = bim nothing picked) and (editor's tool = bim opening tool)):
            set category to 1
        if editor's selectionKind = bim slab picked:
            set category to 2
        if (editor's selectionKind = bim instance picked) or ((editor's selectionKind = bim nothing picked) and (editor's tool = bim place tool)):
            set category to 3
        if (editor's selectionKind = bim linear picked) or ((editor's selectionKind = bim nothing picked) and (editor's tool = bim linear tool)):
            set category to 4
        if (editor's selectionKind = bim curtain picked) or ((editor's selectionKind = bim nothing picked) and (editor's tool = bim curtain tool)):
            set category to 5
        if (editor's selectionKind = bim stair picked) or ((editor's selectionKind = bim nothing picked) and (editor's tool = bim stair tool)):
            set category to 8
        if (editor's selectionKind = bim railing picked) or ((editor's selectionKind = bim nothing picked) and (editor's tool = bim railing tool)):
            set category to 9
        # An imported element has no type to choose: its IFC class shows.
        if editor's selectionKind = bim imported picked:
            set category to 10
        if editor's selectionKind = bim level picked:
            set category to 11
        set names to an empty list of a string
        set kinds to an empty list of an integer
        set targets to an empty list of a 64 bit integer
        set chosenRow to -1
        if category = 0:
            set currentType to editor's wallTypeId
            if editor's selectionKind = bim wall picked:
                set selectedWall to the bim wall index of editor's selectionId in modelValue
                if selectedWall's valid:
                    set currentType to (the item at selectedWall's position in (modelValue's walls's values))'s typeId
            loop typeIndex from 0 to the length of (modelValue's wallTypes's values):
                set wallType to the item at typeIndex in (modelValue's wallTypes's values)
                if wallType's role = bim wall planar role:
                    if wallType's id = currentType:
                        set chosenRow to the length of names
                    set millimetres to ((the bim thickness of wallType) * 1000.0) + 0.5
                    if (the index of (the string form of (millimetres as an integer)) in wallType's name) < 0:
                        append ((wallType's name + (the string form of "  ")) + ((the string form of (millimetres as an integer)) + (the string form of " mm"))) to names
                    else:
                        append wallType's name to names
                    append 0 to kinds
                    append wallType's id to targets
        if category = 1:
            set currentType to editor's openingTypeId
            if editor's selectionKind = bim opening picked:
                set selectedOpening to the bim opening index of editor's selectionId in modelValue
                if selectedOpening's valid:
                    set currentType to (the item at selectedOpening's position in (modelValue's openings's values))'s typeId
            loop typeIndex from 0 to the length of (modelValue's openingTypes's values):
                set openingType to the item at typeIndex in (modelValue's openingTypes's values)
                if openingType's id = currentType:
                    set chosenRow to the length of names
                append openingType's name to names
                append 1 to kinds
                append openingType's id to targets
        if category = 2:
            # The planar types of the selected plate's role (a floor's when
            # nothing is selected).
            set wantedRole to bim floor planar role
            set currentPlate to editor's plateTypeId
            if editor's selectionKind = bim slab picked:
                set selectedSlab to the bim slab index of editor's selectionId in modelValue
                if selectedSlab's valid:
                    set slabValue to the item at selectedSlab's position in (modelValue's slabs's values)
                    set wantedRole to the bim role of plate slabValue in modelValue
                    set currentPlate to slabValue's typeId
            loop typeIndex from 0 to the length of (modelValue's wallTypes's values):
                set plateType to the item at typeIndex in (modelValue's wallTypes's values)
                if plateType's role = wantedRole:
                    if plateType's id = currentPlate:
                        set chosenRow to the length of names
                    append plateType's name to names
                    append 2 to kinds
                    append plateType's id to targets
        if category = 3:
            loop typeIndex from 0 to the length of (modelValue's components's values):
                set definition to the item at typeIndex in (modelValue's components's values)
                if definition's id = editor's placeComponentId:
                    set chosenRow to the length of names
                append definition's name to names
                append 3 to kinds
                append definition's id to targets
        if category = 4:
            # The types of the selected element's role, or of the tool's.
            set currentLinear to editor's linearTypeId
            set wantedRole to editor's linearRole
            if editor's selectionKind = bim linear picked:
                set selectedLinear to the bim linear index of editor's selectionId in modelValue
                if selectedLinear's valid:
                    set currentLinear to (the item at selectedLinear's position in (modelValue's linears's values))'s typeId
                    set wantedRole to (the bim type of linear (the item at selectedLinear's position in (modelValue's linears's values)) in modelValue)'s role
            loop typeIndex from 0 to the length of (modelValue's linearTypes's values):
                set linearType to the item at typeIndex in (modelValue's linearTypes's values)
                if linearType's role = wantedRole:
                    if linearType's id = currentLinear:
                        set chosenRow to the length of names
                    append linearType's name to names
                    append 4 to kinds
                    append linearType's id to targets
        if category = 5:
            # The building system types of the library, by group; the
            # selected system's type (or the tool's) marked.
            set currentSystemType to editor's systemTypeIndex
            if editor's selectionKind = bim curtain picked:
                set currentSystemType to the bim system type index of editor's selectionId in modelValue
            set library to the bim system types
            loop typeIndex from 0 to the length of library:
                set systemType to the item at typeIndex in library
                if typeIndex = currentSystemType:
                    set chosenRow to the length of names
                append systemType's name to names
                append 6 to kinds
                append (typeIndex as a 64 bit integer) to targets
            free library
        if (category = 8) or (category = 9):
            # The stair or railing types of the library.
            set currentStairType to editor's stairTypeIndex
            if category = 9:
                set currentStairType to editor's railingTypeIndex
            if (editor's selectionKind = bim stair picked) or (editor's selectionKind = bim railing picked):
                set currentStairType to the bim stair type index of editor's selectionId in modelValue
            set stairLibrary to the bim stair types
            loop typeIndex from 0 to the length of stairLibrary:
                set stairType to the item at typeIndex in stairLibrary
                if stairType's isRailing = (category = 9):
                    if typeIndex = currentStairType:
                        set chosenRow to the length of names
                    append stairType's name to names
                    append 7 to kinds
                    append (typeIndex as a 64 bit integer) to targets
            free stairLibrary
        set captions to an empty list of a string
        if editor's selectionKind = 30:
            set category to 6
        if editor's selectionKind = 31:
            set category to 7
        append (the string form of "Wall type") to captions
        append (the string form of "Door or window type") to captions
        append (the string form of "Floor, roof or ceiling type") to captions
        append (the string form of "Component") to captions
        append (the string form of "Linear type") to captions
        append (the string form of "Building system type") to captions
        append (the string form of "Reinforcement") to captions
        append (the string form of "Connection") to captions
        append (the string form of "Stair type") to captions
        append (the string form of "Railing type") to captions
        append (the string form of "Imported element") to captions
        append (the string form of "Level") to captions
        set fixedType to ((category = 6) or (category = 7)) or (category >= 10)
        set boxTop to y
        set overBox to (((pointerX >= panelLeft) and (pointerX < (panelLeft + panelWidth))) and (pointerY >= boxTop)) and (pointerY < (boxTop + 44.0))
        if fixedType:
            set overBox to false
            set chosenRow to -1
            set selectorOpen to false
        # A drop-down field of the style, 44 pixels: `raised` in a border of
        # `border-strong`, `text` under the pointer, the accent while open; a
        # fixed type sits flat in `border`.
        set boxLeft to panelLeft + 8.0
        set boxWidth to panelWidth - 16.0
        set boxFill to scheme's raised
        set boxEdge to scheme's strong
        set boxEdgeWidth to 1.0
        if overBox:
            set boxEdge to scheme's ink
        if selectorOpen:
            set boxEdge to scheme's accent
            set boxEdgeWidth to 2.0
        if fixedType:
            set boxFill to scheme's panel
            set boxEdge to scheme's border
        draw bim ui box boxLeft boxTop boxWidth 44.0 radius 6.0 painted boxFill edged boxEdge wide boxEdgeWidth in frame
        draw bim ui text (the item at category in captions) at (boxLeft + 10.0) and (boxTop + 16.0) in face (bim text caption) with atlas painted scheme's inkSecondary in frame
        set shownName to the string form of "(none)"
        if (category = 6) or (category = 7):
            set shownName to the bim selection description of editor
        if (category >= 10) and ((the length of propertyRows) > 0):
            set shownName to (the item at 0 in propertyRows)'s value
        if chosenRow >= 0:
            set shownName to the item at chosenRow in names
        if chosenRow >= 0:
            draw bim type picture of kind (the item at chosenRow in kinds) numbered (the item at chosenRow in targets) in modelValue at (boxLeft + 10.0) and (boxTop + 22.0) in frame
            set fittedName to the bim fitted form of shownName in (boxWidth - 70.0) pixels of face (bim text small) with atlas
            draw bim ui text fittedName at (boxLeft + 42.0) and (boxTop + 34.0) in face (bim text small) with atlas painted scheme's ink in frame
        else:
            set fittedName to the bim fitted form of shownName in (boxWidth - 38.0) pixels of face (bim text small) with atlas
            draw bim ui text fittedName at (boxLeft + 10.0) and (boxTop + 34.0) in face (bim text small) with atlas painted scheme's ink in frame
        if fixedType = false:
            set arrowInk to scheme's inkSecondary
            if overBox or selectorOpen:
                set arrowInk to scheme's ink
            draw bim ui chevron at ((boxLeft + boxWidth) - 16.0) and (boxTop + 22.0) open true painted arrowInk in frame
        if overBox:
            set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser type selector, (-1) as a 64 bit integer)
        if selectorOpen:
            # The list, downward from the box, the current type marked.
            # A menu of the style: `raised` in a border, rows of 24 pixels,
            # the current type in `selected` with a bar in `selected-bar`.
            set listTop to boxTop + 48.0
            set rowCount to the length of names
            set listBottom to the minimum of (bottom - 4.0) and ((listTop + 8.0) + ((rowCount as a 64 bit floating-point number) * 24.0))
            draw bim ui box boxLeft listTop boxWidth (listBottom - listTop) radius 6.0 painted scheme's raised edged scheme's border wide 1.0 in frame
            set rowTop to listTop + 4.0
            loop typeIndex from 0 to rowCount:
                if (rowTop + 24.0) <= (listBottom - 4.0):
                    set overRow to (((pointerX >= boxLeft) and (pointerX < (boxLeft + boxWidth))) and (pointerY >= rowTop)) and (pointerY < (rowTop + 24.0))
                    if typeIndex = chosenRow:
                        draw bim ui rounded rectangle (boxLeft + 4.0) rowTop (boxWidth - 8.0) 24.0 radius 3.0 painted scheme's selected in frame
                        draw bim ui rectangle (boxLeft + 4.0) (rowTop + 4.0) 2.0 16.0 painted scheme's selectedBar in frame
                    else if overRow:
                        draw bim ui rounded rectangle (boxLeft + 4.0) rowTop (boxWidth - 8.0) 24.0 radius 3.0 painted scheme's hover in frame
                    draw bim type picture of kind (the item at typeIndex in kinds) numbered (the item at typeIndex in targets) in modelValue at (boxLeft + 10.0) and (rowTop + 5.0) in frame
                    set fittedName to the bim fitted form of (the item at typeIndex in names) in (boxWidth - 50.0) pixels of face (bim text small) with atlas
                    draw bim ui text fittedName at (boxLeft + 42.0) and (rowTop + 16.0) in face (bim text small) with atlas painted scheme's ink in frame
                    if overRow:
                        set rowKind to the item at typeIndex in kinds
                        set chosenTarget to the item at typeIndex in targets
                        if rowKind = 0:
                            set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, chosenTarget, -1, 0, (-1) as a 64 bit integer)
                        if rowKind = 1:
                            set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser opening type, chosenTarget)
                        if rowKind = 2:
                            set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser plate type, chosenTarget)
                        if rowKind = 3:
                            set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser component, chosenTarget)
                        if rowKind = 4:
                            set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser linear type, chosenTarget)
                        if rowKind = 5:
                            set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser building system, chosenTarget)
                        if rowKind = 6:
                            set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser system type, chosenTarget)
                        if rowKind = 7:
                            set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser stair type, chosenTarget)
                set rowTop to rowTop + 24.0
        free names
        free kinds
        free targets
        free captions
        set y to boxTop + 54.0
        # The properties grid of the style: section headings of 24 pixels in
        # mono capitals with a chevron, a click opening or closing them; rows
        # of 28 pixels, the names in the left two fifths in `text-secondary`,
        # the values in the project's units, figures in mono on the right. A
        # value that can be changed sits in a field of 24 pixels, and a click
        # begins typing it. Both are cut short with "..." where they would not
        # fit, and show whole beside the pointer.
        set rowsTop to y
        set totalHeight to 0.0
        set countedOrder to -1
        set countedHidden to false
        loop rowCursor from 0 to the length of propertyRows:
            if (the item at rowCursor in propertyRows)'s code = -1:
                set countedOrder to countedOrder + 1
                set countedHidden to false
                if countedOrder < (the length of closedHeadings):
                    set countedHidden to the item at countedOrder in closedHeadings
                set totalHeight to totalHeight + 24.0
            else if countedHidden = false:
                set totalHeight to totalHeight + 28.0
        set visibleHeight to the maximum of 28.0 and (bottom - rowsTop)
        set maximumOffset to the maximum of 0.0 and ((totalHeight - visibleHeight) + 8.0)
        set appliedOffset to the minimum of maximumOffset and scrollOffset
        set y to y - appliedOffset
        set gridLeft to panelLeft + 10.0
        set gridRight to (panelLeft + panelWidth) - 10.0
        if maximumOffset > 0.0:
            # The scroll bar, 10 pixels at the edge, its grip round.
            set gridRight to (panelLeft + panelWidth) - 14.0
            set thumbHeight to the maximum of 24.0 and (visibleHeight * (visibleHeight / (totalHeight + 8.0)))
            set thumbTop to rowsTop + ((visibleHeight - thumbHeight) * (appliedOffset / maximumOffset))
            draw bim ui rounded rectangle ((panelLeft + panelWidth) - 8.0) (thumbTop + 2.0) 6.0 (thumbHeight - 4.0) radius 3.0 painted scheme's strong in frame
        set labelRoom to (gridRight - gridLeft) * 0.4
        set valueLeft to (gridLeft + labelRoom) + 4.0
        set headingOrder to -1
        set hiding to false
        set tipText to the string form of ""
        set tipTop to 0.0
        loop rowCursor from 0 to the length of propertyRows:
            set propertyRow to the item at rowCursor in propertyRows
            set isHeading to propertyRow's code = -1
            set rowHeight to 28.0
            if isHeading:
                set rowHeight to 24.0
                set headingOrder to headingOrder + 1
                set hiding to false
                if headingOrder < (the length of closedHeadings):
                    set hiding to the item at headingOrder in closedHeadings
            set rowShown to (((y + rowHeight) <= bottom) and (y >= rowsTop)) and (selectorOpen = false)
            if rowShown and isHeading:
                set headingOver to (((pointerX >= panelLeft) and (pointerX < (panelLeft + panelWidth))) and (pointerY >= y)) and (pointerY < (y + 24.0))
                set headingInk to scheme's inkSecondary
                if headingOver:
                    draw bim ui rounded rectangle (panelLeft + 4.0) (y + 1.0) (panelWidth - 8.0) 22.0 radius 3.0 painted scheme's hover in frame
                    set headingInk to scheme's ink
                    set hit to @intrinsic("construct", a bim ui hit record, (bim ui heading command) + headingOrder, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, 0, (-1) as a 64 bit integer)
                draw bim ui chevron at (gridLeft + 4.0) and (y + 12.0) open (hiding = false) painted headingInk in frame
                draw bim ui caps propertyRow's label at (gridLeft + 14.0) and (y + 16.0) with atlas painted headingInk in frame
            else if (rowShown and (isHeading = false)) and (hiding = false):
                set fittedLabel to the bim fitted form of propertyRow's label in (labelRoom - 4.0) pixels of face (bim text small) with atlas
                draw bim ui text fittedLabel at gridLeft and (y + 18.0) in face (bim text small) with atlas painted scheme's inkSecondary in frame
                set shown to propertyRow's value
                set numeric to the bim figure flag of propertyRow's value
                set valueFace to bim text small
                if numeric:
                    set valueFace to bim text mono
                if propertyRow's code > 0:
                    set fieldOver to (((pointerX >= valueLeft) and (pointerX < gridRight)) and (pointerY >= (y + 2.0))) and (pointerY < (y + 26.0))
                    set fieldEdge to scheme's strong
                    set fieldEdgeWidth to 1.0
                    if fieldOver:
                        set fieldEdge to scheme's ink
                    if editor's propertyCode = propertyRow's code:
                        set fieldEdge to scheme's accent
                        set fieldEdgeWidth to 2.0
                        set shown to editor's propertyText + (the string form of "_")
                    draw bim ui box valueLeft (y + 2.0) (gridRight - valueLeft) 24.0 radius 6.0 painted scheme's raised edged fieldEdge wide fieldEdgeWidth in frame
                    if fieldOver:
                        set hit to @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, bim browser property, (propertyRow's code) as a 64 bit integer)
                set fittedValue to the bim fitted form of shown in ((gridRight - valueLeft) - 16.0) pixels of face valueFace with atlas
                set valueX to valueLeft + 8.0
                if numeric:
                    set valueX to (gridRight - 8.0) - (the bim text width of fittedValue in face valueFace of atlas)
                draw bim ui text fittedValue at valueX and (y + 18.0) in face valueFace with atlas painted scheme's ink in frame
                set rowOver to (((pointerX >= panelLeft) and (pointerX < (panelLeft + panelWidth))) and (pointerY >= y)) and (pointerY < (y + 28.0))
                set cutShort to ((fittedLabel = propertyRow's label) = false) or ((fittedValue = shown) = false)
                if rowOver and cutShort:
                    set tipText to (propertyRow's label + (the string form of ": ")) + shown
                    set tipTop to y + 28.0
            if isHeading:
                set y to y + 24.0
            else if hiding = false:
                set y to y + 28.0
        if (the length of tipText) > 0:
            # A tooltip of the style: `raised`, a border, 11 pixel text.
            set tipWidth to (the bim text width of tipText in face (bim text caption) of atlas) + 16.0
            set tipLeft to ((panelLeft + panelWidth) - 8.0) - tipWidth
            draw bim ui box tipLeft tipTop tipWidth 22.0 radius 3.0 painted scheme's raised edged scheme's border wide 1.0 in frame
            draw bim ui text tipText at (tipLeft + 8.0) and (tipTop + 15.0) in face (bim text caption) with atlas painted scheme's ink in frame
        return hit

# The command line (`prompt` and the typed input) and the status bar.
function draw bim command line saying {a string:prompt} and status {a string:statusText} in {a 64 bit floating-point number:width} by {a 64 bit floating-point number:height} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        set lineTop to the bim ui canvas bottom in height
        draw bim ui rectangle 0.0 lineTop width (bim ui command line height) painted scheme's panel in frame
        draw bim ui rectangle 0.0 lineTop width 1.0 painted scheme's border in frame
        draw bim ui text (the string form of "Command:") at 10.0 and (lineTop + 17.0) in face (bim text bold) with atlas painted scheme's accentInk in frame
        draw bim ui text prompt at 90.0 and (lineTop + 17.0) in face (bim text body) with atlas painted scheme's ink in frame
        # The status bar follows the theme, with a line above it, unless the
        # settings keep it dark.
        set barTop to lineTop + (bim ui command line height)
        draw bim ui rectangle 0.0 barTop width (bim ui status bar height) painted scheme's statusbar in frame
        draw bim ui rectangle 0.0 barTop width 1.0 painted scheme's border in frame
        draw bim ui text statusText at 10.0 and (barTop + 18.0) in face (bim text small) with atlas painted scheme's statusbarInk in frame

# ------------------------------------------------------------ context menu

# One row of the context menu a right click opens in a view: a heading, a
# property of the selection (`propertyCode` above 0 can be typed), a command
# (sent as its key would send it) or a separator.
class:
    patterns:
        [a|] bim context entry record
    members:
        label as a string
        value as a string
        kind as an integer
        command as an integer
        propertyCode as an integer

function bim context heading:
    replacement:
        0
function bim context property:
    replacement:
        1
function bim context command:
    replacement:
        2
function bim context separator:
    replacement:
        3

local function append bim context command {a string:label} shortcut {a string:shortcut} sending {integer:code} to {a pointer to a list:rows}:
    execute:
        append (@intrinsic("construct", a bim context entry record, label, shortcut, bim context command, code, 0)) to rows

local function append bim context separator to {a pointer to a list:rows}:
    execute:
        append (@intrinsic("construct", a bim context entry record, the string form of "", the string form of "", bim context separator, -1, 0)) to rows

# The rows of the context menu for what `editor` has selected: its
# description and properties, as in the explorer, then what can be done with
# it; with nothing selected the active storey's properties and the drawing
# tools.
function the bim context entries of {bim editor record:editor}:
    execute:
        set rows to an empty list of a bim context entry record
        set described to the bim selection description of editor
        set hasSelection to (editor's selectionKind != bim nothing picked) and ((the length of described) > 0)
        set title to the string form of "View"
        if hasSelection:
            set title to described
            loop scan from 0 to the length of described:
                if (the character at scan in described) = 58:
                    if (the length of title) = (the length of described):
                        set title to the substring of described from 0 spanning scan bytes
            if (the length of title) > 40:
                set title to (the substring of title from 0 spanning 38 bytes) + (the string form of "..")
        append (@intrinsic("construct", a bim context entry record, title, the string form of "", bim context heading, -1, 0)) to rows
        set propertyRows to the bim property rows of editor
        loop rowCursor from 0 to the length of propertyRows:
            set propertyRow to the item at rowCursor in propertyRows
            if (editor's selectionKind != 31) or (rowCursor < 8):
                append (@intrinsic("construct", a bim context entry record, propertyRow's label, propertyRow's value, bim context property, -1, propertyRow's code)) to rows
        if (editor's selectionKind = 31) and ((the length of propertyRows) > 8):
            append (@intrinsic("construct", a bim context entry record, the string form of "All fields in Properties panel", the string form of "", bim context heading, -1, 0)) to rows
        free propertyRows
        append bim context separator to rows
        if hasSelection:
            append bim context command (the string form of "Move") shortcut (the string form of "G") sending 71 to rows
            append bim context command (the string form of "Copy") shortcut (the string form of "CO") sending 2002 to rows
            append bim context command (the string form of "Rotate") shortcut (the string form of "RO") sending 2010 to rows
            append bim context command (the string form of "Mirror") shortcut (the string form of "MM") sending 2011 to rows
            append bim context command (the string form of "Create similar") shortcut (the string form of "CS") sending 2001 to rows
            append bim context command (the string form of "Tag") shortcut (the string form of "TG") sending 2030 to rows
            append bim context separator to rows
            if editor's selectionKind = bim instance picked:
                append bim context command (the string form of "Edit component") shortcut (the string form of "Ctrl+E") sending 1069 to rows
                append bim context command (the string form of "Explode") shortcut (the string form of "Ctrl+U") sending 1085 to rows
            else:
                append bim context command (the string form of "Make component") shortcut (the string form of "Ctrl+G") sending 1071 to rows
            append bim context command (the string form of "Delete") shortcut (the string form of "Del") sending bim delete key code to rows
            append bim context separator to rows
            append bim context command (the string form of "Deselect") shortcut (the string form of "Esc") sending bim escape key code to rows
        else:
            append bim context command (the string form of "Select") shortcut (the string form of "S") sending 83 to rows
            append bim context command (the string form of "Wall") shortcut (the string form of "W") sending 87 to rows
            append bim context command (the string form of "Line") shortcut (the string form of "N") sending 78 to rows
            append bim context command (the string form of "Rectangle") shortcut (the string form of "R") sending 82 to rows
            append bim context command (the string form of "Grid") shortcut (the string form of "I") sending 73 to rows
            append bim context command (the string form of "Section") shortcut (the string form of "C") sending 67 to rows
            append bim context separator to rows
            append bim context command (the string form of "Undo") shortcut (the string form of "Z") sending 90 to rows
            append bim context command (the string form of "Redo") shortcut (the string form of "Y") sending 89 to rows
        append bim context command (the string form of "Fit view") shortcut (the string form of "F") sending 70 to rows
        append bim context command (the string form of "Visibility") shortcut (the string form of "L") sending 76 to rows
        append bim context command (the string form of "Drawing Rules") shortcut (the string form of "") sending 2120 to rows
        return rows

function bim context menu width:
    replacement:
        280.0

local function the bim context row height of {integer:entryKind}:
    execute:
        if entryKind = bim context separator:
            return 7.0
        if entryKind = bim context heading:
            return 24.0
        return 20.0

# Where the context menu opened at `openX`, `openY` sits: moved left and up
# when it would leave the `width` by `height` window.
function the bim context menu corner of {a pointer to a list:entries} opened at {a 64 bit floating-point number:openX} and {a 64 bit floating-point number:openY} within {a 64 bit floating-point number:width} by {a 64 bit floating-point number:height}:
    execute:
        set tall to 8.0
        loop entryCursor from 0 to the length of entries:
            set tall to tall + (the bim context row height of (the item at entryCursor in entries)'s kind)
        set cornerX to openX
        set cornerY to openY
        if (cornerX + (bim context menu width)) > (width - 4.0):
            set cornerX to the maximum of 4.0 and ((openX - (bim context menu width)))
        if (cornerY + tall) > (height - 4.0):
            set cornerY to the maximum of 4.0 and ((height - 4.0) - tall)
        return a cad vector2 with x cornerX and y cornerY

# Draws the context menu `entries` with its corner at `corner`, the row under
# the pointer lit, and returns the index of that row (-1 for none, -2 when
# the pointer is on the menu but not on a row that acts).
function draw bim context menu {a pointer to a list:entries} cornered at {cad vector2:corner} for {bim editor record:editor} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set across to bim context menu width
        set tall to 8.0
        loop entryCursor from 0 to the length of entries:
            set tall to tall + (the bim context row height of (the item at entryCursor in entries)'s kind)
        set result to -1
        if (((pointerX >= corner's x) and (pointerX < (corner's x + across))) and (pointerY >= corner's y)) and (pointerY < (corner's y + tall)):
            set result to -2
        draw bim ui rectangle (corner's x + 3.0) (corner's y + 3.0) across tall coloured 10, 10 and 10 in frame
        draw bim ui rectangle corner's x corner's y across tall coloured 38, 38 and 40 in frame
        draw bim ui frame corner's x corner's y across tall coloured 70, 70 and 74 in frame
        set rowTop to corner's y + 4.0
        loop entryCursor from 0 to the length of entries:
            set choice to the item at entryCursor in entries
            set rowTall to the bim context row height of choice's kind
            set over to ((((pointerX >= corner's x) and (pointerX < (corner's x + across))) and (pointerY >= rowTop)) and (pointerY < (rowTop + rowTall)))
            if choice's kind = bim context separator:
                draw bim ui rectangle (corner's x + 8.0) (rowTop + 3.0) (across - 16.0) 1.0 coloured 70, 70 and 74 in frame
            else if choice's kind = bim context heading:
                draw bim ui rectangle (corner's x + 1.0) rowTop (across - 2.0) rowTall coloured 22, 74 and 104 in frame
                draw bim text choice's label at (corner's x + 10.0) and (rowTop + 17.0) in face (bim text bold) with atlas coloured 242, 242 and 242 in frame
            else if choice's kind = bim context property:
                draw bim text choice's label at (corner's x + 10.0) and (rowTop + 14.0) in face (bim text small) with atlas coloured 170, 170 and 170 in frame
                set shown to choice's value
                if choice's propertyCode > 0:
                    set shade to 46
                    if over:
                        set shade to 62
                        set result to entryCursor
                    draw bim ui rectangle (corner's x + 118.0) (rowTop + 1.0) (across - 126.0) 18.0 coloured shade, shade and (shade + 6) in frame
                    if editor's propertyCode = choice's propertyCode:
                        draw bim ui rectangle (corner's x + 118.0) (rowTop + 18.0) (across - 126.0) 1.0 coloured 6, 150 and 215 in frame
                        set shown to editor's propertyText + (the string form of "_")
                draw bim text shown at (corner's x + 124.0) and (rowTop + 14.0) in face (bim text small) with atlas coloured 235, 235 and 235 in frame
            else:
                if over:
                    draw bim ui rectangle (corner's x + 1.0) rowTop (across - 2.0) rowTall coloured 6, 150 and 215 in frame
                    set result to entryCursor
                draw bim text choice's label at (corner's x + 26.0) and (rowTop + 14.0) in face (bim text small) with atlas coloured 242, 242 and 242 in frame
                set keyWidth to the bim text width of choice's value in face (bim text small) of atlas
                draw bim text choice's value at ((corner's x + across) - (keyWidth + 12.0)) and (rowTop + 14.0) in face (bim text small) with atlas coloured 160, 160 and 160 in frame
            set rowTop to rowTop + rowTall
        return result

# ------------------------------------------------------------ snap toggles

# The snap settings as buttons at the right of the command line, as in Open
# 2D Studio's status bar: snapping (F3), ortho (F8), polar tracking (F10)
# and the plan's grid (F7), then each object snap. Returns what the button
# under the pointer sends: a key code, or 3000 plus the rank of an object
# snap to turn it on or off; -1 when the pointer is on none.
function draw bim snap toggles of {bim editor record:editor} grid {boolean:gridOn} in {a 64 bit floating-point number:screenWidth} by {a 64 bit floating-point number:screenHeight} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set captions to an empty list of a string
        set sent to an empty list of an integer
        set lit to an empty list of a boolean
        append (the string form of "SNAP") to captions
        append 292 to sent
        append (editor's snapOff = false) to lit
        append (the string form of "ORTHO") to captions
        append 297 to sent
        append editor's orthoOn to lit
        append (the string form of "POLAR") to captions
        append 299 to sent
        append editor's polarOn to lit
        append (the string form of "GRID") to captions
        append 296 to sent
        append gridOn to lit
        set snapNames to [the string form of "End", the string form of "Mid", the string form of "Int", the string form of "Perp", the string form of "Near", the string form of "Step"]
        loop rankCursor from 0 to the length of snapNames:
            append (the item at rankCursor in snapNames) to captions
            append (3000 + rankCursor) to sent
            append (((editor's snapRefused bitwise and (the bim snap bit of rankCursor)) = 0) and (editor's snapOff = false)) to lit
        set lineTop to the bim ui canvas bottom in screenHeight
        set right to screenWidth - 8.0
        set result to -1
        set buttonCursor to (the length of captions) - 1
        loop while buttonCursor >= 0:
            set caption to the item at buttonCursor in captions
            set across to (the bim text width of caption in face (bim text small) of atlas) + 14.0
            set left to right - across
            set over to (((pointerX >= left) and (pointerX < right)) and (pointerY >= (lineTop + 3.0))) and (pointerY < (lineTop + 23.0))
            set fillShade to 48
            set ink to 150
            if the item at buttonCursor in lit:
                draw bim ui rectangle left (lineTop + 3.0) across 20.0 coloured 6, 110 and 170 in frame
                set ink to 242
            else:
                if over:
                    set fillShade to 64
                draw bim ui rectangle left (lineTop + 3.0) across 20.0 coloured fillShade, fillShade and fillShade in frame
            if over:
                draw bim ui frame left (lineTop + 3.0) across 20.0 coloured 6, 150 and 215 in frame
                set result to the item at buttonCursor in sent
            draw bim text caption at (left + 7.0) and (lineTop + 17.0) in face (bim text small) with atlas coloured ink, ink and ink in frame
            set right to left - 4.0
            if buttonCursor = 4:
                set right to right - 8.0
            set buttonCursor to buttonCursor - 1
        free captions
        free sent
        free lit
        return result

# ---------------------------------------------------------------- canvas first

# The rail on the window's left edge, from `top` down to `bottom`: a button
# per browser section (Views, Components, Schedules, Sheets), the open one
# marked while the browser shows (`browsing`, on `openGroup`), and below a
# button for the properties panel (lit while it shows). What a click hits.
function draw bim rail from {a 64 bit floating-point number:top} down to {a 64 bit floating-point number:bottom} browsing {boolean:browsing} on {integer:openGroup} with properties {boolean:propertiesShown} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set hit to no bim ui hit
        set railWidth to bim ui rail width
        draw bim ui rectangle 0.0 top railWidth (bottom - top) coloured 34, 34 and 36 in frame
        draw bim ui rectangle (railWidth - 1.0) top 1.0 (bottom - top) coloured 60, 60 and 60 in frame
        if (pointerX < railWidth) and ((pointerY >= top) and (pointerY < bottom)):
            set hit's inChrome to true
        set labels to an empty list of a string
        set groups to an empty list of an integer
        set pictures to an empty list of an integer
        append (the string form of "Views") to labels
        append (bim browser views group) to groups
        append (bim icon eye) to pictures
        append (the string form of "Parts") to labels
        append (bim browser families group) to groups
        append (bim icon component) to pictures
        append (the string form of "Tables") to labels
        append (bim browser schedules group) to groups
        append (bim icon table) to pictures
        append (the string form of "Sheets") to labels
        append (bim browser sheets group) to groups
        append (bim icon layers) to pictures
        append (the string form of "Props") to labels
        append -1 to groups
        append (bim icon text) to pictures
        set y to top + 8.0
        loop cursor from 0 to the length of labels:
            set label to the item at cursor in labels
            set groupIndex to the item at cursor in groups
            set marked to browsing and (groupIndex = openGroup)
            if groupIndex < 0:
                # The properties' button stands apart, lower down.
                set y to y + 16.0
                set marked to propertiesShown
            set over to ((pointerX < railWidth) and (pointerY >= y)) and (pointerY < (y + 58.0))
            if marked:
                draw bim ui rectangle 0.0 y 3.0 58.0 coloured 6, 150 and 215 in frame
                draw bim ui rectangle 3.0 y (railWidth - 4.0) 58.0 coloured 48, 52 and 58 in frame
            else if over:
                draw bim ui rectangle 3.0 y (railWidth - 4.0) 58.0 coloured 50, 50 and 52 in frame
            draw bim icon colours of (the item at cursor in pictures) at ((railWidth - 32.0) * 0.5) and (y + 4.0) scaled 1.0 dimmed false in frame
            draw bim icon (the item at cursor in pictures) at ((railWidth - 32.0) * 0.5) and (y + 4.0) coloured 225, 225 and 225 in frame
            set labelWidth to the bim text width of label in face (bim text small) of atlas
            draw bim text label at ((railWidth - labelWidth) * 0.5) and (y + 50.0) in face (bim text small) with atlas coloured 210, 210 and 210 in frame
            if over:
                set railCommand to (bim ui rail command) + groupIndex
                if groupIndex < 0:
                    set railCommand to bim ui properties command
                set hit to @intrinsic("construct", a bim ui hit record, railCommand, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, 0, (-1) as a 64 bit integer)
            set y to y + 62.0
        free labels
        free groups
        free pictures
        return hit

# The toolbar floating over the canvas while something is selected, centred
# on `middle` at `top`: the selection's name, then its actions (edit points,
# move, copy, rotate, mirror, delete, properties). What a click hits.
function draw bim selection toolbar of {bim editor record:editor} centred on {a 64 bit floating-point number:middle} at {a 64 bit floating-point number:top} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set hit to no bim ui hit
        if editor's selectionKind = bim nothing picked:
            return hit
        set actions to an empty list of a bim ribbon button record
        append (a bim ribbon button (the string form of "Edit") sending 258 with icon bim icon push) to actions
        append (a bim ribbon button (the string form of "Move") sending 71 with icon bim icon move) to actions
        append (a bim ribbon button (the string form of "Copy") sending 2002 with icon bim icon copy) to actions
        append (a bim ribbon button (the string form of "Rotate") sending 2010 with icon bim icon rotate) to actions
        append (a bim ribbon button (the string form of "Mirror") sending 2011 with icon bim icon mirror) to actions
        append (a bim ribbon button (the string form of "Delete") sending 261 with icon bim icon delete) to actions
        append (a bim ribbon button (the string form of "Properties") sending (bim ui properties command) with icon bim icon text) to actions
        set title to the bim selection kind name of editor
        set titleWidth to (the bim text width of title in face (bim text bold) of atlas) + 24.0
        set buttonWidth to 62.0
        set barWidth to titleWidth + (buttonWidth * ((the length of actions) as a 64 bit floating-point number))
        set left to middle - (barWidth * 0.5)
        draw bim ui rectangle left top barWidth 58.0 coloured 34, 36 and 40 in frame
        draw bim ui frame left top barWidth 58.0 coloured 70, 74 and 82 in frame
        if ((pointerX >= left) and (pointerX < (left + barWidth))) and ((pointerY >= top) and (pointerY < (top + 58.0))):
            set hit's inChrome to true
        draw bim text title at (left + 12.0) and (top + 34.0) in face (bim text bold) with atlas coloured 235, 235 and 240 in frame
        set x to left + titleWidth
        loop cursor from 0 to the length of actions:
            set action to the item at cursor in actions
            set over to ((pointerX >= x) and (pointerX < (x + buttonWidth))) and ((pointerY >= top) and (pointerY < (top + 58.0)))
            if over:
                draw bim ui rectangle x (top + 3.0) buttonWidth 52.0 coloured 58, 62 and 70 in frame
                set hit to @intrinsic("construct", a bim ui hit record, action's command, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, 0, (-1) as a 64 bit integer)
            draw bim icon action's icon at (x + ((buttonWidth - 32.0) * 0.5)) and (top + 2.0) coloured 225, 225 and 225 in frame
            set labelWidth to the bim text width of action's label in face (bim text small) of atlas
            draw bim text action's label at (x + ((buttonWidth - labelWidth) * 0.5)) and (top + 50.0) in face (bim text small) with atlas coloured 210, 210 and 210 in frame
            set x to x + buttonWidth
        free actions
        return hit

# A short name for what is selected: Wall, Floor, Building system...
function the bim selection kind name of {bim editor record:editor}:
    execute:
        set kindCode to editor's selectionKind
        if kindCode = bim wall picked:
            return the string form of "Wall"
        if kindCode = bim slab picked:
            return the string form of "Floor"
        if kindCode = bim opening picked:
            return the string form of "Opening"
        if kindCode = bim linear picked:
            return the string form of "Linear"
        if kindCode = bim curtain picked:
            return the string form of "Building system"
        if kindCode = bim grid picked:
            return the string form of "Grid"
        if kindCode = bim level picked:
            return the string form of "Level"
        if kindCode = bim mesh picked:
            return the string form of "Mesh"
        if kindCode = bim instance picked:
            return the string form of "Component"
        return the string form of "Selection"

# What the window's input is now, as text: the pointer, the mouse buttons,
# the keys of `keyCodes` held down, the scroll and typed characters not yet
# taken, and the window's size. The same text before and after waiting for
# events means nothing happened that could change what is drawn.
function the bim input mark of {pointer:window} over {a pointer to a list:keyCodes}:
    execute:
        set spot to the cursor position of window
        set inputText to ((the string form of spot's x) + (the string form of " ")) + (the string form of spot's y)
        set buttons to 0
        if the left mouse button is pressed in window:
            set buttons to buttons + 1
        if the right mouse button is pressed in window:
            set buttons to buttons + 2
        if the middle mouse button is pressed in window:
            set buttons to buttons + 4
        set inputText to (inputText + (the string form of " b")) + (the string form of buttons)
        set held to the string form of " k"
        loop keyCursor from 0 to the length of keyCodes:
            if key (the item at keyCursor in keyCodes) is down in window:
                set held to (held + (the string form of (the item at keyCursor in keyCodes))) + (the string form of ",")
        set inputText to inputText + held
        set state to the gpu context of window
        set inputText to ((inputText + (the string form of " s")) + (the bim exact text of state's scroll)) + ((the string form of " t") + (the string form of state's typedCount))
        set inputText to ((inputText + (the string form of " w")) + (the string form of (the framebuffer width of window))) + ((the string form of "x") + (the string form of (the framebuffer height of window)))
        return inputText

# `microseconds` as milliseconds with one decimal, for the status bar.
function the bim milliseconds text of {a 64 bit integer:microseconds}:
    execute:
        set tenths to (microseconds + (50 as a 64 bit integer)) / (100 as a 64 bit integer)
        return ((the string form of (tenths / (10 as a 64 bit integer))) + (the string form of ".")) + (the string form of (the remainder of tenths divided by (10 as a 64 bit integer)))
