# SPDX-License-Identifier: MPL-2.0
# The application frame of the BIM slice, after the Open BIM Studio frontend
# that adapts Open CAD Studio's interface (`OpenCADStudio/docs/open-bim-ui.md`
# in the workspace): the Fusion Black chrome (background #1A1A1A, text
# #F2F2F2, accent #0696D7) around a white model canvas.
#
# - A top bar with quick-access buttons and the ribbon's tabs.
# - The ribbon: per tab, groups of large tool buttons. A button sends the
#   editor the command its key sends; tools the editor does not have yet are
#   shown dimmed.
# - A project explorer on the left (244 pixels): the project's storeys (a
#   click makes one active), its views and the selected element's properties.
# - A command line and a status bar at the bottom.
import examples/bim-slice/bim_editor.dl
import examples/bim-slice/bim_text.dl
import examples/bim-slice/bim_schedule.dl

function bim ui top bar height:
    replacement:
        30.0
function bim ui ribbon height:
    replacement:
        92.0
function bim ui document bar height:
    replacement:
        24.0
function bim ui explorer width:
    replacement:
        244.0
# The rail of section buttons on the window's left edge (canvas first: the
# browser opens beside it only when asked).
function bim ui rail width:
    replacement:
        52.0
# The row of sub-tabs at the ribbon's top.
function bim ui subtab height:
    replacement:
        22.0
function bim ui command line height:
    replacement:
        24.0
function bim ui status bar height:
    replacement:
        28.0

# Where the canvas starts below the chrome: under the ribbon and its
# sub-tabs, or, the ribbon folded, under the tabs alone.
function the bim ui canvas top folded {boolean:isFolded}:
    execute:
        if isFolded:
            return (bim ui top bar height) + (bim ui document bar height)
        return (((bim ui top bar height) + (bim ui ribbon height)) + (bim ui subtab height)) + (bim ui document bar height)

# Commands the window handles itself, not the editor: the properties panel
# shown or hidden, the ribbon folded or unfolded, a ribbon sub-tab (plus its
# index), a rail section (plus its browser group).
function bim ui properties command:
    replacement:
        3001
function bim ui fold command:
    replacement:
        3002
function bim ui subtab command:
    replacement:
        3100
function bim ui rail command:
    replacement:
        3200
# A properties heading (plus its order) opened or closed.
function bim ui heading command:
    replacement:
        3300

# Where the canvas ends above the chrome, in a window `height` high.
function the bim ui canvas bottom in {a 64 bit floating-point number:height}:
    execute:
        return (height - (bim ui command line height)) - (bim ui status bar height)

# Commands with Ctrl held are their key code plus this.
function bim ui control command:
    replacement:
        1000

# One ribbon button: its label, the command (a key code, or a key code plus
# `bim ui control command` for Ctrl, or -1 for a tool not available yet) and
# the icon drawn on it.
class:
    patterns:
        [a|] bim ribbon button record
    members:
        label as a string
        command as an integer
        icon as an integer
        # A small button: three stacked in a column, a 16-pixel icon with
        # its label beside it, as in Revit's ribbon.
        small as a boolean

class:
    patterns:
        [a|] bim ribbon group record
    members:
        title as a string
        buttons as the type of (an empty list of a bim ribbon button record)

