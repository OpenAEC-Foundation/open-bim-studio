# SPDX-License-Identifier: MPL-2.0
# Vertex shader of the GPU-resident 3D view. Inputs: the position (location 0),
# the unit face normal ("Attribute1", location 1) and the colour ("Attribute2",
# location 2, red, green, blue in 0..1). The parameters are floats of the
# storage buffer at binding 0: 0 to 15 the view-projection matrix by rows, 16
# to 18 the direction toward the sun and 19 to 21 the direction toward the
# viewer. The face is lit by the sun with a
# weaker light from the viewer, as the CPU renderer lit it.
import lib/shader.dl

set px to the vertex x
set py to the vertex y
set pz to the vertex z
set clipX to (((@intrinsic("shader buffer read", 0, 0) * px) + (@intrinsic("shader buffer read", 0, 1) * py)) + (@intrinsic("shader buffer read", 0, 2) * pz)) + @intrinsic("shader buffer read", 0, 3)
set clipY to (((@intrinsic("shader buffer read", 0, 4) * px) + (@intrinsic("shader buffer read", 0, 5) * py)) + (@intrinsic("shader buffer read", 0, 6) * pz)) + @intrinsic("shader buffer read", 0, 7)
set clipZ to (((@intrinsic("shader buffer read", 0, 8) * px) + (@intrinsic("shader buffer read", 0, 9) * py)) + (@intrinsic("shader buffer read", 0, 10) * pz)) + @intrinsic("shader buffer read", 0, 11)
set clipW to (((@intrinsic("shader buffer read", 0, 12) * px) + (@intrinsic("shader buffer read", 0, 13) * py)) + (@intrinsic("shader buffer read", 0, 14) * pz)) + @intrinsic("shader buffer read", 0, 15)
set nx to the vertex input named "Attribute1" x
set ny to the vertex input named "Attribute1" y
set nz to the vertex input named "Attribute1" z
set sunlight to ((nx * @intrinsic("shader buffer read", 0, 16)) + (ny * @intrinsic("shader buffer read", 0, 17))) + (nz * @intrinsic("shader buffer read", 0, 18))
set facing to ((nx * @intrinsic("shader buffer read", 0, 19)) + (ny * @intrinsic("shader buffer read", 0, 20))) + (nz * @intrinsic("shader buffer read", 0, 21))
set lit to sunlight
if lit < 0.0:
    set lit to 0.0
set seen to facing
if seen < 0.0:
    set seen to 0.0
set shade to (0.42 + (0.4 * lit)) + (0.18 * seen)
set the shader interpolant named "colour" with an x coordinate of ((the vertex input named "Attribute2" x) * shade), a y coordinate of ((the vertex input named "Attribute2" y) * shade), a z coordinate of ((the vertex input named "Attribute2" z) * shade) and a w coordinate of 1.0
set the output position with x clipX, y clipY, z clipZ and w clipW
