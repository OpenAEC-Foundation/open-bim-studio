# Workload 1 — triangle/triangle intersection over 1 million random pairs.
#
# The test is Moeller-Trumbore ray/triangle (1997) applied edge-wise: the two
# triangles are reported as intersecting when any of the three edges of A, taken
# as a segment, pierces B, or any edge of B pierces A. This is the variant the
# brief allows; it is not the full Moeller 1997 tri-tri overlap test and it does
# not detect coplanar overlap. Both languages run exactly this test.
#
# Triangles are three uniform random points in the unit cube.

import common.dl

function the pair count:
    replacement:
        1000000 as a 64 bit integer

function the parallel epsilon:
    replacement:
        0.000000000001

# --- Vector algebra on the point record -----------------------------------

function the difference of {a sample point:left} and {a sample point:right}:
    execute:
        return a sample point at (left's x - right's x), (left's y - right's y) and (left's z - right's z)

function the cross of {a sample point:left} and {a sample point:right}:
    execute:
        set cx to (left's y * right's z) - (left's z * right's y)
        set cy to (left's z * right's x) - (left's x * right's z)
        set cz to (left's x * right's y) - (left's y * right's x)
        return a sample point at cx, cy and cz

function the dot of {a sample point:left} and {a sample point:right}:
    execute:
        return (left's x * right's x) + ((left's y * right's y) + (left's z * right's z))

# --- Moeller-Trumbore, segment form ---------------------------------------

function the segment from {a sample point:orig} to {a sample point:dest} pierces {a sample point:va}, {a sample point:vb} and {a sample point:vc}:
    execute:
        set dir to the difference of dest and orig
        set edgeone to the difference of vb and va
        set edgetwo to the difference of vc and va
        set pvec to the cross of dir and edgetwo
        set det to the dot of edgeone and pvec
        if (the absolute value of det) < the parallel epsilon:
            return false
        set inv to 1.0 / det
        set tvec to the difference of orig and va
        set bary to (the dot of tvec and pvec) * inv
        if bary < 0.0:
            return false
        if bary > 1.0:
            return false
        set qvec to the cross of tvec and edgeone
        set bartwo to (the dot of dir and qvec) * inv
        if bartwo < 0.0:
            return false
        if (bary + bartwo) > 1.0:
            return false
        set along to (the dot of edgetwo and qvec) * inv
        if along < 0.0:
            return false
        if along > 1.0:
            return false
        return true

function the triangle {a sample point:pa}, {a sample point:pb} and {a sample point:pc} meets the triangle {a sample point:qa}, {a sample point:qb} and {a sample point:qc}:
    execute:
        if the segment from pa to pb pierces qa, qb and qc:
            return true
        if the segment from pb to pc pierces qa, qb and qc:
            return true
        if the segment from pc to pa pierces qa, qb and qc:
            return true
        if the segment from qa to qb pierces pa, pb and pc:
            return true
        if the segment from qb to qc pierces pa, pb and pc:
            return true
        if the segment from qc to qa pierces pa, pb and pc:
            return true
        return false

# --- Driver ----------------------------------------------------------------

reseed with 88172645463325252

set hits to 0 as a 64 bit integer
set started to the clock milliseconds
set index to 0 as a 64 bit integer
loop while index < the pair count:
    set pa to the next random sample point
    set pb to the next random sample point
    set pc to the next random sample point
    set qa to the next random sample point
    set qb to the next random sample point
    set qc to the next random sample point
    if the triangle pa, pb and pc meets the triangle qa, qb and qc:
        set hits to hits + 1
    set index to index + 1
set finished to the clock milliseconds

print integer hits
print real the input checksum
print integer the generator state
print integer (finished - started)
