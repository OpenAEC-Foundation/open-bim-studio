# Shared prelude for the three DynLex workloads.
#
# Throwaway spike code. It exists to answer R-19 and nothing else.
#
# Every pattern here has a line-for-line counterpart in common.hpp so the two
# languages run the same algorithm on the same numbers.

import lib/std.dl
import lib/array.dl

# --- Output ---------------------------------------------------------------

function print integer {a 64 bit integer:message}:
    execute:
        @intrinsic("discard", @intrinsic("variadic call", "libc", "printf", a 32 bit integer, 1, "%lld\n", message))

function print real {a floating-point number:message}:
    execute:
        @intrinsic("discard", @intrinsic("variadic call", "libc", "printf", a 32 bit integer, 1, "%.17g\n", message))

# --- Clock ----------------------------------------------------------------
#
# libc clock(). On this toolchain (UCRT) CLOCKS_PER_SEC is 1000, so a tick is
# one millisecond; calibrated in FINDINGS.md. The C++ side calls the same
# function through the same UCRT, so the two timings are the same measurement.

function the clock milliseconds:
    execute:
        return @intrinsic("call", "libc", "clock", a 64 bit integer)

# --- Logical right shift --------------------------------------------------
#
# DynLex has no unsigned integer type and "shift right" lowers to LLVM ashr,
# so a logical shift has to be spelled out as an arithmetic shift with the
# sign-extended bits masked off. Recorded in FINDINGS.md as a missing facility.

function {a 64 bit integer:value} logically shifted right by {fixed integer:distance}:
    execute:
        return (value >> distance) & (((1 as a 64 bit integer) << (64 - distance)) - 1)

# --- xorshift64* ----------------------------------------------------------
#
# Marsaglia xorshift64 with Vigna's 2685821657736338717 multiplier. Signed
# 64-bit wrapping arithmetic reproduces the unsigned sequence bit for bit.

set seedstate to 88172645463325252 as a 64 bit integer
set inputsum to 0.0

function reseed with {a 64 bit integer:value}:
    globals:
        seedstate
        inputsum
    execute:
        set seedstate to value
        set inputsum to 0.0

function the next random bits:
    globals:
        seedstate
    execute:
        set s to seedstate
        set s to s ^ (s logically shifted right by 12)
        set s to s ^ (s << 25)
        set s to s ^ (s logically shifted right by 27)
        set seedstate to s
        return s * 2685821657736338717

# 2 ** -53. DynLex has no scientific-notation float literals (see FINDINGS.md),
# so it is written as an exact division of two exactly representable doubles;
# the C++ side is written the same way rather than as 0x1.0p-53.
function the unit scale:
    replacement:
        (1.0 / 9007199254740992.0)

# A double in [0, 1), and the input checksum accumulator.
function the next random unit number:
    globals:
        inputsum
    execute:
        set draw to (((the next random bits) logically shifted right by 11) as a floating-point number) * the unit scale
        set inputsum to inputsum + draw
        return draw

function the input checksum:
    globals:
        inputsum
    execute:
        return inputsum

function the generator state:
    globals:
        seedstate
    execute:
        return seedstate

# --- A point-like record --------------------------------------------------
#
# Three f64 members, the shape the kernel's geometry types will have.

class:
    patterns:
        a sample point
    members:
        x as a floating-point number
        y as a floating-point number
        z as a floating-point number

function a sample point at {a floating-point number:px}, {a floating-point number:py} and {a floating-point number:pz}:
    execute:
        return @intrinsic("construct", a sample point, px, py, pz)

function the next random sample point:
    execute:
        set px to the next random unit number
        set py to the next random unit number
        set pz to the next random unit number
        return a sample point at px, py and pz
