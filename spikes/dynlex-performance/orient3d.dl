# Workload 3 — plain f64 orient3d over 10 million random point quadruples.
#
# Non-adaptive: the 4x4 determinant in Shewchuk's translated-to-d form, with no
# error bound and no exact fallback. Counts the quadruples with a positive
# determinant.

import common.dl

function the orient3d of {a sample point:pa}, {a sample point:pb}, {a sample point:pc} and {a sample point:pd}:
    execute:
        set adx to pa's x - pd's x
        set bdx to pb's x - pd's x
        set cdx to pc's x - pd's x
        set ady to pa's y - pd's y
        set bdy to pb's y - pd's y
        set cdy to pc's y - pd's y
        set adz to pa's z - pd's z
        set bdz to pb's z - pd's z
        set cdz to pc's z - pd's z
        return (adx * ((bdy * cdz) - (bdz * cdy))) + ((bdx * ((cdy * adz) - (cdz * ady))) + (cdx * ((ady * bdz) - (adz * bdy))))

function the quadruple count:
    replacement:
        10000000 as a 64 bit integer

reseed with 88172645463325252

set positives to 0 as a 64 bit integer
set started to the clock milliseconds
set index to 0 as a 64 bit integer
loop while index < the quadruple count:
    set pa to the next random sample point
    set pb to the next random sample point
    set pc to the next random sample point
    set pd to the next random sample point
    if (the orient3d of pa, pb, pc and pd) > 0.0:
        set positives to positives + 1
    set index to index + 1
set finished to the clock milliseconds

print integer positives
print real the input checksum
print integer the generator state
print integer (finished - started)
