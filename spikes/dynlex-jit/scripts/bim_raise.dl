# Throwaway spike (spikes/dynlex-jit): a script run against the editor's model.
import lib/std.dl
import generated/model.dl

# Raises the walls that start at x >= 8 m to 4.5 m; returns how many changed.
exposed function obs script on {a pointer to a bim model record:model}:
    execute:
        set changed to 0
        loop cursor from 0 to the length of (model's walls's values):
            set wallValue to the item at cursor in (model's walls's values)
            if wallValue's start's x >= 8.0:
                set wallValue's height to 4.5
                replace item at index cursor in (model's walls's values) with wallValue
                set changed to changed + 1
        return changed
