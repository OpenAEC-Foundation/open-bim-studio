# Throwaway spike (spikes/dynlex-jit): a script run against the editor's model.
import lib/std.dl
import bim/bim_model.dl

# Adds a row of five walls with the model's first wall type on its first level.
exposed function obs script on {a pointer to a bim model record:model}:
    execute:
        set typeId to (the item at 0 in (model's wallTypes's values))'s id
        set levelId to (the item at 0 in (model's levels's values))'s id
        loop step from 0 to 5:
            set x to (step as a 64 bit floating-point number) * 4.0
            ignore add bim wall typed typeId on levelId from (a cad vector2 with x x and y 0.0) to (a cad vector2 with x x and y 6.0) to model
        return the length of (model's walls's values)
