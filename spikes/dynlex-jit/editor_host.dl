# Throwaway spike (spikes/dynlex-jit): the stand-in for the editor.
import lib/std.dl
import lib/string.dl
import bim/bim_model.dl

# Stand-in for the editor: a real model, then a script run against it in place.
function the jit result of {a string:scriptPath} on {a pointer to a bim model record:target}:
    execute:
        return @intrinsic("call", "obsjit", "obs_jit_run_script", a 64 bit integer, the data of scriptPath, "obs_script_on_3a_pointer_to_a_bim_model_record8model5_callable_bim_20_model_20_record_2a_", target)

set model to an empty bim model
set target to the address of model
ignore add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to layers
ignore add bim wall type named (the string form of "Default wall") with layers to target
free layers
print "walls before: "
print (the length of (model's walls's values)) as a line
set answer to the jit result of (the string form of "spikes/dynlex-jit/scripts/bim_add.dl") on target
print "script answered: "
print answer as a line
set raised to the jit result of (the string form of "spikes/dynlex-jit/scripts/bim_raise.dl") on target
print "second script raised: "
print raised as a line
print "walls after: "
print (the length of (model's walls's values)) as a line
loop cursor from 0 to the length of (model's walls's values):
    set wallValue to the item at cursor in (model's walls's values)
    print "  wall "
    print wallValue's id
    print " x="
    print wallValue's start's x
    print " height="
    print wallValue's height as a line
