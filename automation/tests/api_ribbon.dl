# SPDX-License-Identifier: MPL-2.0
# `ribbon [TAB/]LABEL` clicks a ribbon button through the window: the answer
# names the command, and the window part tells the window to press it on
# its next frame, so the shell's own commands (Tile, Export, panels) run
# too. "Tab/Label" picks a label several tabs share.
import automation/bim_api.dl

function check api ribbon {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set editor to a new bim editor
set e to the address of editor
set tiled to the bim api answer to (the string form of "1\nribbon\nView/Tile\n") for e
check api ribbon ((the index of (the string form of "\"pressed\":2090") in tiled) >= 0) named (the string form of "ribbon View/Tile answers the command 2090")
set part to the bim api window part of (the string form of "1\nribbon\nView/Tile\n")
check api ribbon ((part's verb = (the string form of "press")) and (part's number = 2090)) named (the string form of "and asks the window to press it")
check api ribbon (editor's tool = bim select tool) named (the string form of "the editor itself did nothing yet")
set sketchDelete to the bim api window part of (the string form of "2\nribbon\nSketch/Delete\n")
check api ribbon ((sketchDelete's verb = (the string form of "press")) and (sketchDelete's number = 261)) named (the string form of "Tab/Label finds a label several tabs share")
set missing to the bim api answer to (the string form of "3\nribbon\nNo such button\n") for e
check api ribbon ((the index of (the string form of "no such button") in missing) >= 0) named (the string form of "an unknown label is refused")
set unknownPart to the bim api window part of (the string form of "3\nribbon\nNo such button\n")
check api ribbon ((the length of unknownPart's verb) = 0) named (the string form of "and the window does nothing")
set stateAnswer to the bim api answer to (the string form of "4\nstate\n") for e
check api ribbon (((the index of (the string form of "\"sketching\":false") in stateAnswer) >= 0) and ((the index of (the string form of "\"cursorFresh\":false") in stateAnswer) >= 0)) named (the string form of "state reports the sketch and the 3D cursor")
# The commands behind the Create view, Import and Export choosers are found
# by their labels as the separate buttons were (issues #110 and #120).
set sectionPart to the bim api window part of (the string form of "5\nribbon\nView/Section\n")
check api ribbon ((sectionPart's verb = (the string form of "press")) and (sectionPart's number = 67)) named (the string form of "View/Section is in the Create view chooser")
set ifcPart to the bim api window part of (the string form of "6\nribbon\nCollaborate/IFC 4.3\n")
check api ribbon ((ifcPart's verb = (the string form of "press")) and (ifcPart's number = 2383)) named (the string form of "Collaborate/IFC 4.3 is in the Export chooser")
set exportPart to the bim api window part of (the string form of "7\nribbon\nCollaborate/Export\n")
check api ribbon ((exportPart's verb = (the string form of "press")) and (exportPart's number = 3503)) named (the string form of "Collaborate/Export opens the chooser itself")
# The sheetview's commands (#135) are found by their labels in the View
# tab's Sheetview chooser.
set bookPart to the bim api window part of (the string form of "8\nribbon\nView/New sheetview\n")
check api ribbon ((bookPart's verb = (the string form of "press")) and (bookPart's number = 2282)) named (the string form of "View/New sheetview is in the Sheetview chooser")
