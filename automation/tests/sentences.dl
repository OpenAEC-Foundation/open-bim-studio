# SPDX-License-Identifier: MPL-2.0
# The command line's sentences (`bim_sentences.dl`): suggestions ranked for
# what is typed and Tab's completion; sentences run against an editor (walls
# drawn, a wall selected by kind and its height set, a section drawn and
# opened, a sheet opened and exported, the ribbon pressed, undo and redo);
# refused sentences named with the closest pattern; the command line's keys
# (Tab, Enter, history, Escape, UTF-8 and Backspace); and `run SENTENCE`
# served through the API's folder, as the MCP server's `run_sentence` sends it.
import automation/bim_sentences.dl

function check sentence {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function show suggestions for {a string:typedText}:
    execute:
        set offered to the bim sentence suggestions for typedText at most 4
        print (((the string form of "suggest '") + typedText) + ((the string form of "': ") + (offered joined with " | "))) as a line
        free offered

function show completion of {a string:typedText}:
    execute:
        set ruleTable to the bim sentence rules
        set ranked to the bim sentence suggestion rules for typedText in ruleTable
        set added to the bim sentence completion of typedText by rule (the item at (the item at 0 in ranked) in ruleTable)
        print (((the string form of "tab '") + typedText) + (((the string form of "' adds '") + added) + (the string form of "'"))) as a line
        free ranked
        free ruleTable

function say {a string:typedLine} to {a pointer to a bim editor record:editor}:
    execute:
        set outcome to run bim command sentence typedLine for editor
        set verdict to the string form of "ok"
        if outcome's ok = false:
            set verdict to the string form of "refused"
        set windowText to the string form of ""
        if (the length of outcome's windowPart's verb) > 0:
            set windowText to ((((the string form of " [window ") + outcome's windowPart's verb) + (the string form of " ")) + (the string form of outcome's windowPart's number)) + (((the string form of " ") + outcome's windowPart's text) + (the string form of "]"))
        print (((((the string form of "> ") + typedLine) + (the string form of "\n  ")) + ((verdict + (the string form of ": ")) + outcome's message)) + windowText) as a line
        return outcome

# Suggestions and completion, without an editor.
show suggestions for (the string form of "dra")
show suggestions for (the string form of "sel")
show suggestions for (the string form of "set the h")
show suggestions for (the string form of "open the s")
show suggestions for (the string form of "zzz")
set firstOffered to the bim sentence suggestions for (the string form of "dra") at most 1
check sentence ((the item at 0 in firstOffered) = (the string form of "draw a wall from (x, y) to (x, y)")) named (the string form of "'dra' suggests drawing a wall first")
free firstOffered
show completion of (the string form of "dra")
show completion of (the string form of "draw")
show completion of (the string form of "draw ")
show completion of (the string form of "draw a wall from (0, 0")
show completion of (the string form of "draw a wall from (0, 0) ")
show completion of (the string form of "start the wall t")
show completion of (the string form of "open the view \"A-")

set editor to a new bim editor
set e to the address of editor
# The window's own unit at start: values typed in millimetres.
set editor's lengthUnit to bim millimetre unit

# Drawing, articles optional, units in points.
ignore say (the string form of "draw a wall from (0, 0) to (5, 0)") to e
ignore say (the string form of "Draw the wall from (5 m, 0) to (5000 mm, 4000 mm).") to e
ignore say (the string form of "draw wall from (0,4) to (5,4)") to e
check sentence ((the length of (editor's documentValue's current's walls's values)) = 3) named (the string form of "three walls drawn")
set firstWall to (the item at 0 in (editor's documentValue's current's walls's values))'s id
set secondWall to (the item at 1 in (editor's documentValue's current's walls's values))'s id
check sentence (((the item at 1 in (editor's documentValue's current's walls's values))'s finish's y) = 4.0) named (the string form of "4000 mm read as 4 metres")

# Selection by kind, and properties by label.
ignore say ((the string form of "select the wall ") + (the string form of firstWall)) to e
check sentence (editor's selectionId = firstWall) named (the string form of "the wall is selected")
ignore say ((the string form of "select the floor ") + (the string form of secondWall)) to e
ignore say (the string form of "select the wall 999") to e
ignore say (the string form of "set the height of the selected wall to 2750") to e
check sentence ((the absolute value of (((the item at 0 in (editor's documentValue's current's walls's values))'s height) - 2.75)) < 0.000001) named (the string form of "the height is 2.75 m")
ignore say (the string form of "set the heigth of the selected wall to 2750") to e
ignore say (the string form of "set the height of the selected floor to 2750") to e
ignore say (the string form of "undo") to e
check sentence ((the absolute value of (((the item at 0 in (editor's documentValue's current's walls's values))'s height) - 3.0)) < 0.000001) named (the string form of "undo gives the height back")
ignore say (the string form of "redo") to e
check sentence ((the absolute value of (((the item at 0 in (editor's documentValue's current's walls's values))'s height) - 2.75)) < 0.000001) named (the string form of "redo sets it again")
ignore say (the string form of "select nothing") to e
check sentence (editor's selectionKind = bim nothing picked) named (the string form of "select nothing clears the selection")
ignore say (the string form of "set the height of the selected wall to 2750") to e

# Views, sheets and the ribbon: the window's part comes back with them.
ignore say (the string form of "draw a section from (2, -1) to (2, 5)") to e
ignore say (the string form of "escape") to e
ignore say (the string form of "open the view \"Section 1\"") to e
add bim editor sheet in e
ignore say (the string form of "open the sheet \"A-101\"") to e
ignore say (the string form of "open the view \"Nowhere\"") to e
set exported to say (the string form of "export the sheet to PDF") to e
check sentence ((exported's windowPart's verb = (the string form of "press")) and (exported's windowPart's number = 2098)) named (the string form of "export the sheet to PDF presses the sheet's PDF export")
ignore say (the string form of "press \"View/Section\"") to e
ignore say (the string form of "show the view tab") to e
ignore say (the string form of "save") to e
ignore say (the string form of "start the wall tool") to e
check sentence (editor's tool = bim wall tool) named (the string form of "start the wall tool starts it")
ignore say (the string form of "cancel") to e

# Refused: the closest pattern, and where the words go astray.
ignore say (the string form of "drw a wall from (0, 0) to (5, 0)") to e
ignore say (the string form of "draw a wall from (0, 0)") to e
ignore say (the string form of "draw a wall from (0, 0) to (5, 0) now") to e
ignore say (the string form of "draw a wall from (0, x) to (5, 0)") to e
ignore say (the string form of "open the sheet") to e
ignore say (the string form of "> set x to 3") to e
check sentence ((the length of (editor's documentValue's current's walls's values)) = 3) named (the string form of "refused sentences change nothing")

# The command line's keys.
set prompter to a new bim command line
set p to the address of prompter
set prompter's focused to true
type bim command line character 100 in p
type bim command line character 114 in p
type bim command line character 97 in p
ignore press bim command line key (bim sentence tab key code) in p for e
check sentence (prompter's typed = (the string form of "draw ")) named (the string form of "Tab completes 'dra' to 'draw '")
ignore press bim command line key (bim sentence down key code) in p for e
check sentence (prompter's choice = 1) named (the string form of "Down highlights the next suggestion")
ignore press bim command line key (bim sentence up key code) in p for e
check sentence (prompter's choice = 0) named (the string form of "Up the one before")
ignore press bim command line key (bim sentence tab key code) in p for e
check sentence (prompter's typed = (the string form of "draw a wall ")) named (the string form of "Tab adds 'a wall '")
set ghostNow to the bim command line ghost of prompter
check sentence (ghostNow = (the string form of "from ")) named (the string form of "the ghost shows 'from '")
set typedSentence to the string form of "from (1, 1) to (1, 3)"
loop letterCursor from 0 to the length of typedSentence:
    type bim command line character (the bim sentence byte at letterCursor in typedSentence) in p
set entered to press bim command line key (bim enter key code) in p for e
check sentence ((entered's ok) and ((the length of (editor's documentValue's current's walls's values)) = 4)) named (the string form of "Enter runs the line")
check sentence (((the length of prompter's typed) = 0) and ((the length of (prompter's sentences's values)) = 1)) named (the string form of "and keeps it in the history")
ignore press bim command line key (bim sentence up key code) in p for e
check sentence (prompter's typed = (the string form of "draw a wall from (1, 1) to (1, 3)")) named (the string form of "Up recalls it")
ignore press bim command line key (bim escape key code) in p for e
check sentence ((the length of prompter's typed) = 0) named (the string form of "Escape clears the line")
type bim command line character 75 in p
type bim command line character 252 in p
check sentence ((the length of prompter's typed) = 3) named (the string form of "a typed u-umlaut is two UTF-8 bytes")
ignore press bim command line key (bim backspace key code) in p for e
check sentence (prompter's typed = (the string form of "K")) named (the string form of "Backspace takes the whole character")
ignore press bim command line key (bim escape key code) in p for e
ignore press bim command line key (bim escape key code) in p for e
check sentence (prompter's focused = false) named (the string form of "Escape on an empty line gives the keys back")

# `run SENTENCE` through the API's folder.
ignore @intrinsic("call", "libc", "mkdir", integer, the data of (the string form of "build/sentence-test"), 493)
ignore write bim text (the string form of "41\nrun\ndraw a wall from (0, 6) to (4, 6)\n") to file (the string form of "build/sentence-test/request")
ignore serve bim api in (the string form of "build/sentence-test") for e
print ((the string form of "run response: ") + ((the bim file content at (the string form of "build/sentence-test/response"))'s text with "\n" replaced by " | ")) as a line
ignore write bim text (the string form of "42\nrun\nopen the sheet A-101\n") to file (the string form of "build/sentence-test/request")
set servedOpen to serve bim api in (the string form of "build/sentence-test") for e
print ((the string form of "run response: ") + ((the bim file content at (the string form of "build/sentence-test/response"))'s text with "\n" replaced by " | ")) as a line
check sentence ((servedOpen's verb = (the string form of "open")) and (servedOpen's text = (the string form of "A-101"))) named (the string form of "run passes the window's part on")
ignore write bim text (the string form of "43\nrun\nfly to the moon\n") to file (the string form of "build/sentence-test/request")
ignore serve bim api in (the string form of "build/sentence-test") for e
print ((the string form of "run response: ") + ((the bim file content at (the string form of "build/sentence-test/response"))'s text with "\n" replaced by " | ")) as a line
