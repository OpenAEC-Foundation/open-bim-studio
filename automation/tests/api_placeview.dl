# SPDX-License-Identifier: MPL-2.0
# A view placed on a sheet through an actual native request (`placeview`):
# by the sheet's number and the view's name, centred in millimetres from the
# sheet's lower left corner, as one undoable step; refused without changing
# the model for a view already on a sheet, an unknown sheet or view, or
# coordinates that are no numbers.
import automation/bim_api.dl

function check api placeview {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function api placeview response {a string:answer} succeeds:
    execute:
        return (the index of (the string form of "\"ok\":true") in answer) >= 0

set editor to a new bim editor
set target to the address of editor
begin bim transaction in (the address of (editor's documentValue))
set levelId to (the item at 0 in (editor's documentValue's current's levels's values))'s id
ignore add bim view of kind (bim plan view) named (the string form of "Plattegrond test") on levelId to (the address of (editor's documentValue's current))
set sheetId to add bim sheet numbered (the string form of "A-101") named (the string form of "Blad een") on paper 1 landscape true to (the address of (editor's documentValue's current))
commit bim transaction in (the address of (editor's documentValue))
set beforeUndo to the length of (editor's documentValue's undoStack's values)
set answer to the bim api answer to (the string form of "1\nplaceview\nA-101\nPlattegrond test\n300\n250\n") for target
set sheetValue to the item at (the bim sheet index of sheetId in editor's documentValue's current)'s position in (editor's documentValue's current's sheets's values)
check api placeview ((api placeview response answer succeeds) and ((the length of (sheetValue's viewports's values)) = 1)) named (the string form of "a view is placed on the sheet by number and name")
check api placeview ((the index of (the string form of "\"viewports\":1") in answer) >= 0) named (the string form of "the answer counts the sheet's viewports")
check api placeview ((the length of (editor's documentValue's undoStack's values)) = (beforeUndo + 1)) named (the string form of "placing is one undoable step")
set answer to the bim api answer to (the string form of "2\nplaceview\nBlad een\nplattegrond TEST\n500\n250\n") for target
set sheetValue to the item at (the bim sheet index of sheetId in editor's documentValue's current)'s position in (editor's documentValue's current's sheets's values)
check api placeview (((api placeview response answer succeeds) = false) and ((the length of (sheetValue's viewports's values)) = 1)) named (the string form of "a view already on a sheet is refused, found by the sheet's name too")
check api placeview ((the length of (editor's documentValue's undoStack's values)) = (beforeUndo + 1)) named (the string form of "a refusal leaves no undo step")
set answer to the bim api answer to (the string form of "3\nplaceview\nZ-9\nPlattegrond test\n300\n250\n") for target
check api placeview ((api placeview response answer succeeds) = false) named (the string form of "an unknown sheet is refused")
set answer to the bim api answer to (the string form of "4\nplaceview\nA-101\nGeen view\n300\n250\n") for target
check api placeview ((api placeview response answer succeeds) = false) named (the string form of "an unknown view is refused")
set answer to the bim api answer to (the string form of "5\nplaceview\nA-101\nPlattegrond test\nlinks\n250\n") for target
check api placeview ((api placeview response answer succeeds) = false) named (the string form of "coordinates that are no numbers are refused")
set answer to the bim api answer to (the string form of "6\nplaceview\nA-101\nPlattegrond test\n") for target
check api placeview ((api placeview response answer succeeds) = false) named (the string form of "missing arguments are refused")
