# SPDX-License-Identifier: MPL-2.0
# The automation API (`bim_api.dl`): requests answered as JSON, a wall and
# a building system made, an element selected and its properties read, a
# ribbon button pressed and the plan clicked with its tool, undo; then a
# request served through the folder, as the MCP server sends it.
import automation/bim_api.dl

function ask api test {a string:requestText} of {a pointer to a bim editor record:editor}:
    execute:
        print (the bim api answer to requestText for editor) as a line

set editor to a new bim editor
set e to the address of editor
ask api test (the string form of "1\nping\n") of e
ask api test (the string form of "2\nwall\n0\n0\n5\n0\n") of e
ask api test (the string form of "3\nsystem\n0\n4\n6\n4\n8\n") of e
ask api test (the string form of "4\nelements\n") of e
set wallId to (the item at 0 in (editor's documentValue's current's walls's values))'s id
ask api test ((the string form of "5\nselect\n") + (the string form of wallId)) of e
set propertyAnswer to the bim api answer to (the string form of "6\nproperties\n") for e
print ((the string form of "properties answer has Height: ") + (the string form of ((the index of (the string form of "Height") in propertyAnswer) >= 0))) as a line
ask api test (the string form of "7\nbutton\nwall\n") of e
ask api test (the string form of "8\nclick\n0\n2\n") of e
ask api test (the string form of "9\nclick\n4\n2\n") of e
print ((the string form of "walls after the clicks: ") + (the string form of (the length of (editor's documentValue's current's walls's values)))) as a line
ask api test (the string form of "10\nkey\n27\n") of e
ask api test (the string form of "11\nundo\n") of e
ask api test (the string form of "12\nbutton\nno such button\n") of e
ask api test (the string form of "13\nwall\n0\n0\n") of e
ask api test (the string form of "14\nfly\n") of e

# Through the folder: a request file in, a response file out, the window's
# part ("tab 3") handed back.
ignore @intrinsic("call", "libc", "mkdir", integer, the data of (the string form of "build/api-test"), 493)
ignore @intrinsic("call", "libc", "remove", integer, the data of (the string form of "build/api-test/request"))
ignore write bim text (the string form of "15\ntab\n3\n") to file (the string form of "build/api-test/request.tmp")
print ((the string form of "temporary request wakes: ") + (the string form of (bim api has a request in (the string form of "build/api-test")))) as a line
ignore @intrinsic("call", "libc", "remove", integer, the data of (the string form of "build/api-test/request.tmp"))
ignore write bim text (the string form of "15\ntab\n3\n") to file (the string form of "build/api-test/request")
print ((the string form of "published request wakes: ") + (the string form of (bim api has a request in (the string form of "build/api-test")))) as a line
set windowPart to serve bim api in (the string form of "build/api-test") for e
print (((the string form of "window part: ") + windowPart's verb) + ((the string form of " ") + (the string form of windowPart's number))) as a line
set served to the bim file content at (the string form of "build/api-test/response")
print ((the string form of "response: ") + (served's text with "\n" replaced by " | ")) as a line
print ((the string form of "request left: ") + (the string form of ((the bim file content at (the string form of "build/api-test/request"))'s valid))) as a line
set idle to serve bim api in (the string form of "build/api-test") for e
print ((the string form of "served request wakes: ") + (the string form of (bim api has a request in (the string form of "build/api-test")))) as a line
print (((the string form of "nothing waiting: '") + idle's verb) + (the string form of "'")) as a line

# Columns and beams are listed with their axis ends in space, and several
# ids select together in their order, as Shift-clicking them would (a steel
# connection's primary member first).
set steel to a new bim editor
set s to the address of steel
set steelTarget to the address of (steel's documentValue's current)
set postType to add bim linear type named (the string form of "Post 200") as role bim column role sized 0.2 by 0.2 round false of (the string form of "steel") to steelTarget
set girderType to add bim linear type named (the string form of "Girder 300") as role bim beam role sized 0.15 by 0.3 round false of (the string form of "steel") to steelTarget
set post to add bim linear typed postType on steel's levelId from (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (a cad vector3 with x 0.0, y 0.0 and z 3.0) turned 0.0 to steelTarget
set girder to add bim linear typed girderType on steel's levelId from (a cad vector3 with x 0.0, y 0.0 and z 3.0) to (a cad vector3 with x 5.0, y 0.0 and z 3.0) turned 0.0 to steelTarget
set listed to the bim api answer to (the string form of "20\nelements\n") for s
set linearsAt to the index of (the string form of "\"linears\"") in listed
set connectionsAt to the index of (the string form of "\"connections\"") in listed
print (the substring of listed from linearsAt spanning (connectionsAt - linearsAt) bytes) as a line
ignore the bim api answer to (((the string form of "21\nselect\n") + (the string form of post)) + ((the string form of "\n") + (the string form of girder))) for s
set together to the bim ordered connection members of steel
print ((the string form of "selected together: ") + (the string form of (the length of together))) as a line
print ((the string form of "primary first: ") + (the string form of (((the item at 0 in together) = post) and (steel's selectionId = girder)))) as a line
ignore the bim api answer to ((the string form of "22\nselect\n") + (the string form of post)) for s
set alone to the bim ordered connection members of steel
print ((the string form of "selected alone: ") + (the string form of (the length of alone))) as a line
ask api test (the string form of "23\nselect\n999999\n") of s
