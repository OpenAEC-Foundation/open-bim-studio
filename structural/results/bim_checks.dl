# SPDX-License-Identifier: MPL-2.0
# Checks on the model. Needless decimals: building dimensions are whole
# millimetres, so a coordinate or size with a fraction of a millimetre is
# almost always a slip (a drag that missed its snap, a value typed in the
# wrong unit, an import). The check lists each such value; rounding puts
# them all on whole millimetres as one edit.
import bim/bim_model.dl

# `value` metres on the nearest whole millimetre.
function the bim whole millimetres of {a 64 bit floating-point number:value}:
    execute:
        return (the floor of ((value * 1000.0) + 0.5)) / 1000.0

# Whether `value` metres lies off a whole millimetre (by more than a
# millionth of one, so binary rounding does not count).
function bim {a 64 bit floating-point number:value} has needless decimals:
    execute:
        set millimetres to value * 1000.0
        return (the absolute value of (millimetres - (the floor of (millimetres + 0.5)))) > 0.000001

# A value with needless decimals: on which element, which value, how much.
class:
    patterns:
        [a|] bim decimal warning record
    members:
        elementId as a 64 bit integer
        what as a string
        value as a 64 bit floating-point number

local function note bim decimal {a 64 bit floating-point number:value} named {a string:label} of {a 64 bit integer:elementId} into {a pointer to a list:found}:
    execute:
        if bim value has needless decimals:
            append (@intrinsic("construct", a bim decimal warning record, elementId, label, value)) to found

# Every value of `modelValue` with needless decimals: storeys' elevations
# and heights, walls' ends, heights and feet, openings' places, floors'
# corners and tops, grids' ends and linear elements' ends.
function the bim decimal warnings of {bim model record:modelValue}:
    execute:
        set found to a cad topology list of a bim decimal warning record
        loop cursor from 0 to the length of (modelValue's levels's values):
            set levelValue to the item at cursor in (modelValue's levels's values)
            note bim decimal levelValue's elevation named (the string form of "elevation") of levelValue's id into (found's values)
            note bim decimal levelValue's height named (the string form of "storey height") of levelValue's id into (found's values)
        loop cursor from 0 to the length of (modelValue's walls's values):
            set wallValue to the item at cursor in (modelValue's walls's values)
            note bim decimal wallValue's start's x named (the string form of "start x") of wallValue's id into (found's values)
            note bim decimal wallValue's start's y named (the string form of "start y") of wallValue's id into (found's values)
            note bim decimal wallValue's finish's x named (the string form of "finish x") of wallValue's id into (found's values)
            note bim decimal wallValue's finish's y named (the string form of "finish y") of wallValue's id into (found's values)
            note bim decimal wallValue's height named (the string form of "height") of wallValue's id into (found's values)
            note bim decimal wallValue's baseOffset named (the string form of "base offset") of wallValue's id into (found's values)
        loop cursor from 0 to the length of (modelValue's openings's values):
            set openingValue to the item at cursor in (modelValue's openings's values)
            note bim decimal openingValue's offset named (the string form of "offset") of openingValue's id into (found's values)
        loop cursor from 0 to the length of (modelValue's slabs's values):
            set slabValue to the item at cursor in (modelValue's slabs's values)
            loop corner from 0 to the length of (slabValue's outline's values):
                set cornerPoint to the item at corner in (slabValue's outline's values)
                note bim decimal cornerPoint's x named (the string form of "corner x") of slabValue's id into (found's values)
                note bim decimal cornerPoint's y named (the string form of "corner y") of slabValue's id into (found's values)
            note bim decimal slabValue's top named (the string form of "top") of slabValue's id into (found's values)
        loop cursor from 0 to the length of (modelValue's grids's values):
            set gridValue to the item at cursor in (modelValue's grids's values)
            note bim decimal gridValue's start's x named (the string form of "start x") of gridValue's id into (found's values)
            note bim decimal gridValue's start's y named (the string form of "start y") of gridValue's id into (found's values)
            note bim decimal gridValue's finish's x named (the string form of "finish x") of gridValue's id into (found's values)
            note bim decimal gridValue's finish's y named (the string form of "finish y") of gridValue's id into (found's values)
        loop cursor from 0 to the length of (modelValue's linears's values):
            set linearValue to the item at cursor in (modelValue's linears's values)
            note bim decimal linearValue's start's x named (the string form of "start x") of linearValue's id into (found's values)
            note bim decimal linearValue's start's y named (the string form of "start y") of linearValue's id into (found's values)
            note bim decimal linearValue's start's z named (the string form of "start z") of linearValue's id into (found's values)
            note bim decimal linearValue's finish's x named (the string form of "finish x") of linearValue's id into (found's values)
            note bim decimal linearValue's finish's y named (the string form of "finish y") of linearValue's id into (found's values)
            note bim decimal linearValue's finish's z named (the string form of "finish z") of linearValue's id into (found's values)
        return found

local function the bim whole point of {cad vector2:flatPoint}:
    execute:
        return a cad vector2 with x (the bim whole millimetres of flatPoint's x) and y (the bim whole millimetres of flatPoint's y)

local function the bim whole spot of {cad vector3:raisedSpot}:
    execute:
        return a cad vector3 with x (the bim whole millimetres of raisedSpot's x), y (the bim whole millimetres of raisedSpot's y) and z (the bim whole millimetres of raisedSpot's z)

# Puts every value the check looks at on whole millimetres; the number of
# elements changed.
function round bim model to whole millimetres in {a pointer to a bim model record:target}:
    execute:
        set changed to 0
        loop cursor from 0 to the length of (target's levels's values):
            set levelValue to the item at cursor in (target's levels's values)
            if (bim levelValue's elevation has needless decimals) or (bim levelValue's height has needless decimals):
                set levelValue's elevation to the bim whole millimetres of levelValue's elevation
                set levelValue's height to the bim whole millimetres of levelValue's height
                replace item at index cursor in (target's levels's values) with levelValue
                note bim change of levelValue's id in target
                set changed to changed + 1
        loop cursor from 0 to the length of (target's walls's values):
            set wallValue to the item at cursor in (target's walls's values)
            set wallOff to ((bim wallValue's start's x has needless decimals) or (bim wallValue's start's y has needless decimals)) or ((bim wallValue's finish's x has needless decimals) or (bim wallValue's finish's y has needless decimals))
            if (wallOff or (bim wallValue's height has needless decimals)) or (bim wallValue's baseOffset has needless decimals):
                set wallValue's start to the bim whole point of wallValue's start
                set wallValue's finish to the bim whole point of wallValue's finish
                set wallValue's height to the bim whole millimetres of wallValue's height
                set wallValue's baseOffset to the bim whole millimetres of wallValue's baseOffset
                replace item at index cursor in (target's walls's values) with wallValue
                note bim change of wallValue's id in target
                set changed to changed + 1
        loop cursor from 0 to the length of (target's openings's values):
            set openingValue to the item at cursor in (target's openings's values)
            if bim openingValue's offset has needless decimals:
                set openingValue's offset to the bim whole millimetres of openingValue's offset
                replace item at index cursor in (target's openings's values) with openingValue
                note bim change of openingValue's id in target
                set changed to changed + 1
        loop cursor from 0 to the length of (target's slabs's values):
            set slabValue to the item at cursor in (target's slabs's values)
            set slabOff to bim slabValue's top has needless decimals
            loop corner from 0 to the length of (slabValue's outline's values):
                set cornerPoint to the item at corner in (slabValue's outline's values)
                if (bim cornerPoint's x has needless decimals) or (bim cornerPoint's y has needless decimals):
                    set slabOff to true
            if slabOff:
                set roundedCorners to a cad topology list of a cad vector2
                loop corner from 0 to the length of (slabValue's outline's values):
                    append (the bim whole point of (the item at corner in (slabValue's outline's values))) to (roundedCorners's values)
                set slabValue's outline to roundedCorners
                set slabValue's top to the bim whole millimetres of slabValue's top
                replace item at index cursor in (target's slabs's values) with slabValue
                note bim change of slabValue's id in target
                set changed to changed + 1
        loop cursor from 0 to the length of (target's grids's values):
            set gridValue to the item at cursor in (target's grids's values)
            if ((bim gridValue's start's x has needless decimals) or (bim gridValue's start's y has needless decimals)) or ((bim gridValue's finish's x has needless decimals) or (bim gridValue's finish's y has needless decimals)):
                set gridValue's start to the bim whole point of gridValue's start
                set gridValue's finish to the bim whole point of gridValue's finish
                replace item at index cursor in (target's grids's values) with gridValue
                note bim change of gridValue's id in target
                set changed to changed + 1
        loop cursor from 0 to the length of (target's linears's values):
            set linearValue to the item at cursor in (target's linears's values)
            set roundedStart to the bim whole spot of linearValue's start
            set roundedFinish to the bim whole spot of linearValue's finish
            if ((the cad distance from roundedStart to linearValue's start) > 0.000000001) or ((the cad distance from roundedFinish to linearValue's finish) > 0.000000001):
                set linearValue's start to roundedStart
                set linearValue's finish to roundedFinish
                replace item at index cursor in (target's linears's values) with linearValue
                note bim change of linearValue's id in target
                set changed to changed + 1
        return changed
