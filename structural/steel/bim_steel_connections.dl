# SPDX-License-Identifier: MPL-2.0
# Author steel recipes against semantic axes, including end-to-interior joints.
import elements/connection/bim_connections.dl
import elements/linear/bim_profiles.dl
import structural/steel/bim_baseplate.dl

# Keep a recipe's parts in the clear web bay beside a coped end: between
# `lowest` and `highest` along the secondary's depth (local y), and no further
# out than the leading plate reached. Plates and welds are shortened and
# shifted; bolt groups keep 1.5 hole diameters to those bounds, closing their
# pitch and then dropping lines down to 2.2 hole diameters apart.
function fit steel connection parts {a pointer to a list:parts} between {a 64 bit floating-point number:lowest} and {a 64 bit floating-point number:highest}:
    execute:
        set floorValue to lowest
        set ceilingValue to highest
        set seekingPlate to true
        loop cursor from 0 to the length of parts:
            set part to the item at cursor in parts
            set sideOn to (the absolute value of part's axis's x) > 0.9
            set faceOn to (the absolute value of part's axis's z) > 0.9
            if (part's kind = 0) and (sideOn or faceOn):
                set extent to part's height
                if sideOn:
                    set extent to part's width
                if seekingPlate:
                    set seekingPlate to false
                    set floorValue to the maximum of floorValue and (part's origin's y - (extent * 0.5))
                    set ceilingValue to the minimum of ceilingValue and (part's origin's y + (extent * 0.5))
                    if (ceilingValue - floorValue) < 0.02:
                        return nothing
                set extent to the minimum of extent and (ceilingValue - floorValue)
                set part's origin's y to (part's origin's y clamped between (floorValue + (extent * 0.5)) and (ceilingValue - (extent * 0.5)))
                if sideOn:
                    set part's width to extent
                else:
                    set part's height to extent
            else if (seekingPlate = false) and ((part's kind >= 4) and ((the absolute value of part's axis's y) > 0.9)):
                set beginning to part's origin's y
                set ending to part's origin's y + (part's length * part's axis's y)
                set flipped to ending < beginning
                if flipped:
                    set beginning to ending
                    set ending to part's origin's y
                set extent to the minimum of (ending - beginning) and (ceilingValue - floorValue)
                set beginning to (beginning clamped between floorValue and (ceilingValue - extent))
                set part's length to extent
                set part's origin's y to beginning
                if flipped:
                    set part's origin's y to beginning + extent
            else if (seekingPlate = false) and (((part's kind >= 1) and (part's kind <= 3)) and (sideOn or faceOn)):
                set lineCount to part's rows
                set pitchValue to part's rowPitch
                if sideOn:
                    set lineCount to part's columns
                    set pitchValue to part's columnPitch
                set roomValue to (ceilingValue - floorValue) - (3.0 * part's holeDiameter)
                if roomValue < 0.0:
                    set roomValue to 0.0
                loop while (lineCount > 1) and ((roomValue / ((lineCount - 1) as a 64 bit floating-point number)) < (2.2 * part's holeDiameter)):
                    set lineCount to lineCount - 1
                set spanValue to 0.0
                if lineCount > 1:
                    set pitchValue to the minimum of pitchValue and (roomValue / ((lineCount - 1) as a 64 bit floating-point number))
                    set spanValue to pitchValue * ((lineCount - 1) as a 64 bit floating-point number)
                set midValue to (floorValue + ceilingValue) * 0.5
                if roomValue > spanValue:
                    set midValue to (part's origin's y clamped between ((floorValue + (1.5 * part's holeDiameter)) + (spanValue * 0.5)) and ((ceilingValue - (1.5 * part's holeDiameter)) - (spanValue * 0.5)))
                set part's origin's y to midValue
                if sideOn:
                    set part's columns to lineCount
                    set part's columnPitch to pitchValue
                else:
                    set part's rows to lineCount
                    set part's rowPitch to pitchValue
            replace item at index cursor in parts with part
        return nothing

function add bim steel connection among {a pointer to a list:identities} style {integer:styleCode} in {a pointer to a bim model record:target}:
    execute:
        set count to the length of identities
        if (styleCode < 3) or (styleCode > 8):
            return the bim refused id
        if (count != 2) and (((styleCode = 8) and (count = 1)) = false):
            return the bim refused id
        set modelValue to @intrinsic("dereference", target)
        loop cursor from 0 to count:
            if (the bim linear index of (the item at cursor in identities) in modelValue)'s valid = false:
                return the bim refused id
        set primaryHost to the item at (the bim linear index of (the item at 0 in identities) in modelValue)'s position in (modelValue's linears's values)
        set primaryFrame to the bim frame of linear primaryHost in modelValue
        set secondaryHost to primaryHost
        set secondaryFrame to primaryFrame
        set anchor to primaryFrame's last
        set secondaryEnd to 1
        if count = 2:
            set secondaryHost to the item at (the bim linear index of (the item at 1 in identities) in modelValue)'s position in (modelValue's linears's values)
            set secondaryFrame to the bim frame of linear secondaryHost in modelValue
            set firstShare to ((the cad dot of (the cad difference of secondaryFrame's first and primaryFrame's first) and primaryFrame's along) / primaryFrame's length) clamped between 0.0 and 1.0
            set lastShare to ((the cad dot of (the cad difference of secondaryFrame's last and primaryFrame's first) and primaryFrame's along) / primaryFrame's length) clamped between 0.0 and 1.0
            set firstProjection to the cad sum of primaryFrame's first and (primaryFrame's along scaled by (primaryFrame's length * firstShare))
            set lastProjection to the cad sum of primaryFrame's first and (primaryFrame's along scaled by (primaryFrame's length * lastShare))
            set firstDistance to the cad distance from firstProjection to secondaryFrame's first
            set lastDistance to the cad distance from lastProjection to secondaryFrame's last
            set anchor to firstProjection
            set secondaryEnd to 0
            if lastDistance < firstDistance:
                set anchor to lastProjection
                set secondaryEnd to 1
            if (the minimum of firstDistance and lastDistance) > 0.001:
                # A plate or cleat recipe also takes an end beside the axis
                # within the primary's section (a top-flush floor beam).
                if (styleCode < 3) or (styleCode > 5):
                    return the bim refused id
                set endSpot to secondaryFrame's first
                if secondaryEnd = 1:
                    set endSpot to secondaryFrame's last
                if (bim connection point endSpot lies in the section of primaryHost around anchor in modelValue) = false:
                    return the bim refused id
        set primaryEnd to 2
        set positionValue to (the cad dot of (the cad difference of anchor and primaryFrame's first) and primaryFrame's along) / primaryFrame's length
        if (the cad distance from anchor to primaryFrame's first) <= 0.001:
            set primaryEnd to 0
            set positionValue to 0.0
            set anchor to primaryFrame's first
        else if (the cad distance from anchor to primaryFrame's last) <= 0.001:
            set primaryEnd to 1
            set positionValue to 0.0
            set anchor to primaryFrame's last
        if (styleCode != 6) and (styleCode != 8):
            # A supporting axis does not own its end, even at an endpoint.
            set primaryEnd to 2
            set positionValue to ((the cad dot of (the cad difference of anchor and primaryFrame's first) and primaryFrame's along) / primaryFrame's length) clamped between 0.0 and 1.0
        set members to a cad topology list of a connection member
        append (@intrinsic("construct", a connection member, primaryHost's id, primaryEnd, 0.0, positionValue)) to (members's values)
        if count = 2:
            append (@intrinsic("construct", a connection member, secondaryHost's id, secondaryEnd, 0.0, 0.0)) to (members's values)
        set sectionType to the bim type of linear secondaryHost in modelValue
        set shape to the bim profile of linear type sectionType in modelValue
        set webSize to shape's web
        if (webSize <= 0.0) or (shape's kind != bim i shape profile):
            set webSize to sectionType's width
        set recipeAdditions to the steel connection parts for style styleCode on secondaryHost's id wide sectionType's width deep sectionType's depth web webSize
        if (styleCode = 3) or (styleCode = 5):
            # Axial fasteners attach plates/cleat feet to the primary.
            loop cursor from 0 to the length of (recipeAdditions's values):
                set bolts to the item at cursor in (recipeAdditions's values)
                if (bolts's kind = 1) and ((the absolute value of bolts's axis's z) > 0.999):
                    set bolts's memberId to primaryHost's id
                    replace item at index cursor in (recipeAdditions's values) with bolts
        if (count = 2) and ((styleCode >= 3) and (styleCode <= 5)):
            set copeValue to the bim connection cope of secondaryHost end secondaryEnd at primaryHost in modelValue
            if copeValue's state = 1:
                fit steel connection parts (recipeAdditions's values) between copeValue's low and copeValue's high
        set label to ((the steel connection style name of styleCode) + (the string form of " ")) + (the string form of target's nextId)
        set spec to @intrinsic("construct", a connection definition, the bim refused id, primaryHost's levelId, label, 1, styleCode, anchor, members, recipeAdditions)
        return store bim connection spec in target

# Capture edited local recipes as named model types. Definitions own their lists;
# instances remain editable copies, so changing one cannot mutate another/undo.
function save bim connection {a 64 bit integer:nodeId} as type named {a string:typeName} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim connection index of nodeId in (@intrinsic("dereference", target))
        if found's valid = false:
            return the bim refused id
        set source to the item at found's position in (target's connections's values)
        if (source's style < 2) or (typeName = (the string form of "")):
            return the bim refused id
        set spec to source
        set spec's id to the bim new id in target
        set spec's name to typeName
        set spec's levelId to 0 as a 64 bit integer
        set spec's origin to a cad vector3 with x 0.0, y 0.0 and z 0.0
        set spec's members to the cad clone of source's members
        set spec's additions to the cad clone of source's additions
        loop cursor from 0 to the length of (spec's members's values):
            set memberValue to the item at cursor in (spec's members's values)
            set oldId to memberValue's elementId
            set memberValue's elementId to (cursor + 1) as a 64 bit integer
            replace item at index cursor in (spec's members's values) with memberValue
            loop partCursor from 0 to the length of (spec's additions's values):
                set part to the item at partCursor in (spec's additions's values)
                if part's memberId = oldId:
                    # Remap from the original, avoiding collision with slot numbers.
                    set part's memberId to 0 - ((cursor + 1) as a 64 bit integer)
                    replace item at index partCursor in (spec's additions's values) with part
        loop cursor from 0 to the length of (spec's additions's values):
            set part to the item at cursor in (spec's additions's values)
            set part's memberId to 0 - part's memberId
            replace item at index cursor in (spec's additions's values) with part
        append spec to (target's connectionTypes's values)
        return spec's id

function apply bim connection type {a 64 bit integer:typeId} among {a pointer to a list:identities} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim position of typeId among (target's connectionTypes's values)
        if found's valid = false:
            return the bim refused id
        set template to the item at found's position in (target's connectionTypes's values)
        if (the length of identities) != (the length of (template's members's values)):
            return the bim refused id
        # Build on a private model first: a failed type application is atomic.
        set scratch to the bim snapshot of (@intrinsic("dereference", target))
        set scratch's journal to a cad topology list of a 64 bit integer
        set nodeId to add bim steel connection among identities style template's style in (the address of scratch)
        if (template's style = 2) and ((the length of identities) = 1):
            set nodeId to add bim base plate below (the item at 0 in identities) in (the address of scratch)
        if nodeId = the bim refused id:
            return the bim refused id
        set nodeFound to the bim connection index of nodeId in scratch
        set spec to the item at nodeFound's position in (scratch's connections's values)
        set spec's additions to the cad clone of template's additions
        loop cursor from 0 to the length of (spec's additions's values):
            set part to the item at cursor in (spec's additions's values)
            set slot to (part's memberId as an integer) - 1
            if (slot < 0) or (slot >= (the length of identities)):
                return the bim refused id
            set part's memberId to the item at slot in identities
            replace item at index cursor in (spec's additions's values) with part
        set spec's members to the cad clone of spec's members
        loop cursor from 0 to the length of (spec's members's values):
            set memberValue to the item at cursor in (spec's members's values)
            set memberValue's setback to (the item at cursor in (template's members's values))'s setback
            replace item at index cursor in (spec's members's values) with memberValue
        set spec's id to the bim refused id
        set spec's name to template's name + ((the string form of " ") + (the string form of target's nextId))
        return store bim connection spec in target
