# SPDX-License-Identifier: MPL-2.0
# Native connection gallery: illustrative editable modelling recipes, not engineering designs.
import structural/steel/bim_baseplate.dl
import elements/connection/bim_fastener_gallery.dl
import structural/steel/bim_steel_connections.dl

function the bim connection gallery with library {boolean:withLibrary}:
    execute:
        set modelValue to an empty bim model
        set offsetY to 0.0
        if withLibrary:
            set modelValue to the bim fastener gallery
            set offsetY to 6.0
        set target to the address of modelValue
        set ground to add bim level named (the string form of "Applied connections") at 0.0 with height 1.0 to target
        loop caseCursor from 0 to 5:
            set xValue to ((the remainder of caseCursor divided by 3) as a 64 bit floating-point number) * 1.4
            set yValue to offsetY + (((caseCursor / 3) as a 64 bit floating-point number) * 1.4)
            set labelValue to the string form of "HEA 200"
            set widthValue to 0.20
            set depthValue to 0.19
            set webValue to 0.0065
            set flangeValue to 0.010
            set filletValue to 0.018
            set profileKind to bim i shape profile
            set roundValue to false
            if caseCursor = 1:
                set labelValue to the string form of "HEA 240 stiffened"
                set widthValue to 0.24
                set depthValue to 0.23
                set webValue to 0.0075
                set flangeValue to 0.012
                set filletValue to 0.021
            if caseCursor = 2:
                set labelValue to the string form of "RHS 200x200x10"
                set widthValue to 0.20
                set depthValue to 0.20
                set webValue to 0.010
                set flangeValue to 0.020
                set profileKind to bim rectangle hollow profile
            if caseCursor = 3:
                set labelValue to the string form of "CHS 219.1x8 - circular weld pending"
                set widthValue to 0.2191
                set depthValue to widthValue
                set webValue to 0.008
                set profileKind to bim circle hollow profile
                set roundValue to true
            if caseCursor = 4:
                set labelValue to the string form of "HEA 200 with wind brace"
            set columnType to add bim linear type named labelValue as role bim column role sized widthValue by depthValue round roundValue of (the string form of "steel") to target
            give bim linear type columnType profile profileKind web webValue flange flangeValue fillet filletValue fourth 0.0 series 0 in target
            set columnId to add bim linear typed columnType on ground from (a cad vector3 with x xValue, y yValue and z 0.0) to (a cad vector3 with x xValue, y yValue and z 0.85) turned 0.0 to target
            set nodeId to add bim base plate below columnId in target
            set foundValue to the bim connection index of nodeId in modelValue
            set nodeValue to the item at foundValue's position in (target's connections's values)
            set nodeValue's name to (the string form of "Base ") + labelValue
            set nodeValue's additions to the cad clone of nodeValue's additions
            set anchorValue to the item at 1 in (nodeValue's additions's values)
            set anchorValue's diameter to 0.024
            set anchorValue's length to 0.55
            set anchorValue's origin's z to 0.06
            set anchorValue's parameters's grip to 0.06
            set anchorValue's holeDiameter to 0.028
            set anchorValue's parameters's coating to 1
            set anchorValue's parameters's anchorShape to 0
            if (caseCursor = 1) or (caseCursor = 4):
                set anchorValue's parameters's anchorShape to 3
            if caseCursor = 2:
                set anchorValue's parameters's anchorShape to 1
            if caseCursor = 3:
                set anchorValue's parameters's anchorShape to 2
            replace item at index 1 in (nodeValue's additions's values) with anchorValue
            # Straight runs on flat faces. CHS needs a circular weld path;
            # do not substitute floating straight beads on its bounding square.
            set weldCount to 2
            if roundValue:
                set weldCount to 0
            loop weldCursor from 0 to weldCount:
                set directionValue to 1.0
                if weldCursor = 1:
                    set directionValue to -1.0
                set originValue to a cad vector3 with x ((0.0 - directionValue) * widthValue * 0.5), y (directionValue * ((depthValue * 0.5) + 0.003)) and z 0.003
                append (@intrinsic("construct", a connection addition, 10 + weldCursor, columnId, 4, originValue, (a cad vector3 with x directionValue, y 0.0 and z 0.0), 0.01, 0.01, 0.006, 0.02, widthValue, 1, 1, 0.1, 0.1, 0.024, default connection fastener parameters)) to (nodeValue's additions's values)
            if caseCursor = 1:
                loop sideCursor from 0 to 2:
                    set sideValue to -1.0
                    if sideCursor = 1:
                        set sideValue to 1.0
                    set stiffenerWidth to (widthValue - webValue) * 0.5
                    set stiffenerX to sideValue * ((webValue * 0.5) + (stiffenerWidth * 0.5))
                    append (@intrinsic("construct", a connection addition, 20 + sideCursor, columnId, 0, (a cad vector3 with x stiffenerX, y 0.0 and z 0.10), (a cad vector3 with x 0.0, y 1.0 and z 0.0), stiffenerWidth, 0.20, 0.010, 0.02, 0.20, 1, 1, 0.1, 0.1, 0.024, default connection fastener parameters)) to (nodeValue's additions's values)
                    loop faceCursor from 0 to 2:
                        set direction to 1.0
                        if faceCursor = 1:
                            set direction to -1.0
                        set root to a cad vector3 with x (stiffenerX - ((direction * stiffenerWidth) * 0.5)), y (direction * 0.008) and z 0.003
                        append (@intrinsic("construct", a connection addition, (30 + (sideCursor * 2)) + faceCursor, columnId, 4, root, (a cad vector3 with x direction, y 0.0 and z 0.0), 0.01, 0.01, 0.006, 0.02, stiffenerWidth, 1, 1, 0.1, 0.1, 0.024, default connection fastener parameters)) to (nodeValue's additions's values)
            ignore store bim connection nodeValue in target
            ignore save bim connection nodeId as type named nodeValue's name in target
            if caseCursor = 4:
                set braceType to add bim linear type named (the string form of "RHS 80x80x5 wind brace") as role bim generic linear role sized 0.08 by 0.08 round false of (the string form of "steel") to target
                give bim linear type braceType profile bim rectangle hollow profile web 0.005 flange 0.010 fillet 0.0 fourth 0.0 series 0 in target
                set braceId to add bim linear typed braceType on ground from (a cad vector3 with x xValue, y yValue and z 0.16) to (a cad vector3 with x (xValue + 0.85), y yValue and z 0.80) turned 0.0 to target
                set memberIds to an empty list of a 64 bit integer
                append columnId to memberIds
                append braceId to memberIds
                ignore add bim steel connection among memberIds style 7 in target
                free memberIds
        # Four further applied joints, with their semantic members retained.
        loop caseCursor from 0 to 4:
            set xValue to (caseCursor as a 64 bit floating-point number) * 1.4
            set yValue to offsetY + 3.0
            set columnType to add bim linear type named (the string form of "Gallery supporting column") as role bim column role sized 0.20 by 0.20 round false of (the string form of "steel") to target
            set beamType to add bim linear type named (the string form of "Gallery I beam") as role bim beam role sized 0.18 by 0.30 round false of (the string form of "steel") to target
            give bim linear type beamType profile bim i shape profile web 0.008 flange 0.012 fillet 0.0 fourth 0.0 series 0 in target
            set primaryId to the bim refused id
            if caseCursor != 3:
                set primaryId to add bim linear typed columnType on ground from (a cad vector3 with x xValue, y yValue and z 0.0) to (a cad vector3 with x xValue, y yValue and z 1.0) turned 0.0 to target
            set secondaryId to add bim linear typed beamType on ground from (a cad vector3 with x xValue, y yValue and z 0.5) to (a cad vector3 with x (xValue + 1.0), y yValue and z 0.5) turned 0.0 to target
            set styleCode to caseCursor + 3
            if styleCode = 6:
                set primaryId to add bim linear typed beamType on ground from (a cad vector3 with x (xValue - 0.5), y yValue and z 0.5) to (a cad vector3 with x xValue, y yValue and z 0.5) turned 0.0 to target
            set identities to an empty list of a 64 bit integer
            append primaryId to identities
            append secondaryId to identities
            set jointId to add bim steel connection among identities style styleCode in target
            free identities
        loop jointCursor from 0 to the length of (target's connections's values):
            set joint to the item at jointCursor in (target's connections's values)
            if (joint's style = 3) or ((joint's style = 4) or (joint's style = 7)):
                set joint's additions to the cad clone of joint's additions
                loop partCursor from 0 to the length of (joint's additions's values):
                    set bead to the item at partCursor in (joint's additions's values)
                    if bead's kind = 4:
                        set side to 1.0
                        if bead's origin's x < 0.0:
                            set side to -1.0
                            set bead's origin's y to bead's origin's y + bead's length
                            set bead's axis's y to 0.0 - bead's axis's y
                        set bead's origin's x to bead's origin's x + ((bead's thickness * 0.5) * side)
                        set bead's origin's z to bead's origin's z + (bead's thickness * 0.5)
                        replace item at index partCursor in (joint's additions's values) with bead
                ignore store bim connection joint in target
            if (joint's style >= 3) and (joint's style <= 6):
                ignore save bim connection joint's id as type named (the steel connection style name of joint's style) in target
        set defaultLayers to an empty list of a bim layer record
        append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to defaultLayers
        ignore add bim wall type named (the string form of "Default wall") with defaultLayers to target
        free defaultLayers
        ignore add bim opening type named (the string form of "Default window") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
        ignore add bim door type named (the string form of "Default door") sized 0.9 by 2.1 with frame 0.05 to target
        return modelValue

function the bim connection gallery:
    execute:
        return the bim connection gallery with library false

function the bim connection workbench:
    execute:
        return the bim connection gallery with library true
