# SPDX-License-Identifier: MPL-2.0
import elements/linear/bim_profiles.dl
import kernel/fast/prism.dl

set modelValue to an empty bim model
set typeId to add bim linear type named (the string form of "SHS 80x80x5") as role bim generic linear role sized 0.08 by 0.08 round false of (the string form of "steel") to (the address of modelValue)
give bim linear type typeId profile bim rectangle hollow profile web 0.005 flange 0.0075 fillet 0.0 fourth 0.0 series 11 in (the address of modelValue)
set kind to the item at 0 in (modelValue's linearTypes's values)
set rings to the bim rings of linear type kind in modelValue at 24 round corners
set sideCount to 0
loop ringCursor from 0 to the length of rings:
    set ring to the item at ringCursor in rings
    if (the length of ring) != 28:
        print "FAIL: each rounded profile needs eight tangent points" as a line
        @intrinsic("call", "libc", "exit", nothing, 1)
    loop cursor from 0 to the length of ring:
        set first to the item at cursor in ring
        set last to the item at (the remainder of (cursor + 1) divided by (the length of ring)) in ring
        if (the cad distance from first to last) > 0.06:
            if ((the absolute value of (first's x - last's x)) < 1e-10) or ((the absolute value of (first's y - last's y)) < 1e-10):
                set sideCount to sideCount + 1
if sideCount != 8:
    print "FAIL: all eight long hollow-profile sides must remain axial" as a line
    @intrinsic("call", "libc", "exit", nothing, 1)
print "PASS: outer and inner rounded profiles retain all straight tangent sides" as a line
set holes to an empty list of the type of (an empty list of a cad vector2)
append (the item at 1 in rings) to holes
set built to the fast prism over (the item at 0 in rings) with holes holes from 0.0 rising 1.0 within 1e-9
set roundingFactor to 4.0 - (12.0 * (the sine of (3.141592653589793 / 12.0)))
set expectedVolume to (0.08 * 0.08) - ((0.07 * 0.07) + (roundingFactor * ((0.0075 * 0.0075) - (0.0025 * 0.0025))))
if (the absolute value of ((the fast volume of built's shape) - expectedVolume)) > 1e-10:
    print "FAIL: rounded hollow section area differs from analytic polygon area" as a line
    @intrinsic("call", "libc", "exit", nothing, 1)
print "PASS: rounded hollow section retains its analytic polygon volume" as a line
