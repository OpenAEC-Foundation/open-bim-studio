# SPDX-License-Identifier: MPL-2.0
import structural/steel/steel_connections.dl

set zero to a cad vector3 with x 0.0, y 0.0 and z 0.0
loop code from 3 to 9:
    set references to a cad topology list of a connection member
    set frames to an empty list of a connection member frame
    append (@intrinsic("construct", a connection member, 10 as a 64 bit integer, 0, 0.0, 0.0)) to (references's values)
    append (@intrinsic("construct", a connection member frame, 10 as a 64 bit integer, zero, (a cad vector3 with x 0.0, y 0.0 and z 1.0), 4.0)) to frames
    set secondId to 10 as a 64 bit integer
    if code != 8:
        set secondId to 20 as a 64 bit integer
        append (@intrinsic("construct", a connection member, secondId, 0, 0.0, 0.0)) to (references's values)
        append (@intrinsic("construct", a connection member frame, secondId, zero, (a cad vector3 with x 1.0, y 0.0 and z 0.0), 4.0)) to frames
    set recipeAdditions to the steel connection parts for style code on secondId wide 0.18 deep 0.3 web 0.008
    if (code = 3) or (code = 8):
        loop cursor from 0 to the length of (recipeAdditions's values):
            set part to the item at cursor in (recipeAdditions's values)
            if part's kind = 4:
                if (the absolute value of ((the absolute value of part's origin's x) - 0.004)) > 1e-12:
                    print (the string form of "Weld is detached from the web") as a line
                    @intrinsic("call", "libc", "exit", nothing, 1)
    set node to @intrinsic("construct", a connection definition, 1 as a 64 bit integer, 2 as a 64 bit integer, the string form of "Recipe", 1, code, zero, references, recipeAdditions)
    set generated to the connection of node using frames
    if generated's valid = false:
        print generated's message as a line
        @intrinsic("call", "libc", "exit", nothing, 1)
    print ((the steel connection style name of code) + (the string form of " valid")) as a line
    free frames
