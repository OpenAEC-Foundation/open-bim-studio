# SPDX-License-Identifier: MPL-2.0
import kernel/fast/perforation.dl
import kernel/fast/prism.dl

function check fast boring {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set outline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to outline
append (a cad vector2 with x 1.0 and y 0.0) to outline
append (a cad vector2 with x 1.0 and y 1.0) to outline
append (a cad vector2 with x 0.0 and y 1.0) to outline
set emptyRings to an empty list of the type of (an empty list of a cad vector2)
set cube to the fast prism over outline with holes emptyRings from 0.0 rising 1.0 within 1e-9
set bores to an empty list of a fast bore record
append (@intrinsic("construct", a fast bore record, (a cad vector3 with x 0.25, y 0.25 and z -0.1), (a cad vector3 with x 0.0, y 0.0 and z 1.0), 0.05, 1.2)) to bores
append (@intrinsic("construct", a fast bore record, (a cad vector3 with x 0.75, y 0.75 and z -0.1), (a cad vector3 with x 0.0, y 0.0 and z 1.0), 0.05, 1.2)) to bores
set resultValue to the fast stock cube's shape perforated by bores within 1e-8
check fast boring resultValue's valid named (the string form of "two perpendicular through bores")
check fast boring ((the absolute value of ((the fast volume of resultValue's shape) - 0.985)) < 1e-10) named (the string form of "twelve-sided cutter volume is retained")
set mesh to an empty fast mesh
append fast mesh of resultValue's shape to (the address of mesh)
check fast boring ((the fast mesh flaw of mesh) = 0) named (the string form of "drilled display mesh is watertight")
set blind to an empty list of a fast bore record
append (@intrinsic("construct", a fast bore record, (a cad vector3 with x 0.5, y 0.5 and z 0.5), (a cad vector3 with x 0.0, y 0.0 and z 1.0), 0.05, 0.1)) to blind
set refused to the fast stock cube's shape perforated by blind within 1e-8
check fast boring (refused's valid = false) named (the string form of "fully internal blind bore is left to BREP")
set edgeCut to an empty list of a fast bore record
append (@intrinsic("construct", a fast bore record, (a cad vector3 with x 0.01, y 0.5 and z -0.1), (a cad vector3 with x 0.0, y 0.0 and z 1.0), 0.05, 1.2)) to edgeCut
set refused to the fast stock cube's shape perforated by edgeCut within 1e-8
check fast boring (refused's valid = false) named (the string form of "edge-grazing cylinder is left to BREP")
set intersecting to an empty list of a fast bore record
append (@intrinsic("construct", a fast bore record, (a cad vector3 with x -0.1, y 0.5 and z 0.5), (a cad vector3 with x 1.0, y 0.0 and z 0.0), 0.05, 1.2)) to intersecting
append (@intrinsic("construct", a fast bore record, (a cad vector3 with x 0.5, y -0.1 and z 0.5), (a cad vector3 with x 0.0, y 1.0 and z 0.0), 0.05, 1.2)) to intersecting
set refused to the fast stock cube's shape perforated by intersecting within 1e-8
check fast boring (refused's valid = false) named (the string form of "intersecting bores are left to BREP")
set inner to an empty list of a cad vector2
append (a cad vector2 with x 0.2 and y 0.2) to inner
append (a cad vector2 with x 0.8 and y 0.2) to inner
append (a cad vector2 with x 0.8 and y 0.8) to inner
append (a cad vector2 with x 0.2 and y 0.8) to inner
set cavities to an empty list of the type of (an empty list of a cad vector2)
append inner to cavities
set tube to the fast prism over outline with holes cavities from 0.0 rising 1.0 within 1e-9
set across to an empty list of a fast bore record
append (@intrinsic("construct", a fast bore record, (a cad vector3 with x -0.1, y 0.5 and z 0.5), (a cad vector3 with x 1.0, y 0.0 and z 0.0), 0.05, 1.2)) to across
set drilledTube to the fast stock tube's shape perforated by across within 1e-8
check fast boring drilledTube's valid named (the string form of "both hollow-section walls are bored")
check fast boring ((the absolute value of ((the fast volume of drilledTube's shape) - 0.637)) < 1e-10) named (the string form of "hollow cavity and both bore volumes are preserved")
set mesh to an empty fast mesh
append fast mesh of drilledTube's shape to (the address of mesh)
check fast boring ((the fast mesh flaw of mesh) = 0) named (the string form of "bored hollow-section mesh is watertight")
set oblique to an empty list of a fast bore record
set diagonalAxis to a cad vector3 with x 0.2, y 0.0 and z 1.0
set diagonalAxis to diagonalAxis scaled by (1.0 / (the cad length of diagonalAxis))
append (@intrinsic("construct", a fast bore record, (a cad vector3 with x 0.4, y 0.5 and z -0.1), diagonalAxis, 0.05, 1.3)) to oblique
set slanted to the fast stock cube's shape perforated by oblique within 1e-8
check fast boring slanted's valid named (the string form of "oblique through bore projects onto both faces")
check fast boring ((the absolute value of ((the fast volume of slanted's shape) - (1.0 - (0.0075 / diagonalAxis's z)))) < 1e-10) named (the string form of "oblique bore volume includes projected depth")
set angledMesh to an empty fast mesh
append fast mesh of slanted's shape to (the address of angledMesh)
check fast boring ((the fast mesh flaw of angledMesh) = 0) named (the string form of "oblique bore mesh is watertight")
free oblique
free outline
free emptyRings
free bores
free blind
free edgeCut
free intersecting
free inner
free cavities
free across
