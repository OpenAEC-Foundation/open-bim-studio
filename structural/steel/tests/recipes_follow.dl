# SPDX-License-Identifier: MPL-2.0
# Parametric steel nodes: their parts are their recipe's for the profiles
# their members have, until a part is edited by hand.
import structural/steel/bim_steel_connections.dl

function check recipe following {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The height of the plate keyed 1 of node `nodeId`.
function the tested plate height of {a 64 bit integer:nodeId} in {bim model record:modelValue}:
    execute:
        set found to the bim connection index of nodeId in modelValue
        set spec to the item at found's position in (modelValue's connections's values)
        loop cursor from 0 to the length of (spec's additions's values):
            set part to the item at cursor in (spec's additions's values)
            if (part's key = 1) and (part's kind = 0):
                return part's height
        return -1.0

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Follow test") at 0.0 with height 6.0 to target
set columnType to add bim linear type named (the string form of "Column") as role bim column role sized 0.3 by 0.3 round false of (the string form of "steel") to target
set beamType to add bim linear type named (the string form of "Beam") as role bim beam role sized 0.18 by 0.3 round false of (the string form of "steel") to target
set deepType to add bim linear type named (the string form of "Deep beam") as role bim beam role sized 0.2 by 0.5 round false of (the string form of "steel") to target
set columnId to add bim linear typed columnType on ground from (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (a cad vector3 with x 0.0, y 0.0 and z 6.0) turned 0.0 to target
set beamId to add bim linear typed beamType on ground from (a cad vector3 with x 0.0, y 0.0 and z 3.0) to (a cad vector3 with x 4.0, y 0.0 and z 3.0) turned 0.0 to target
# A beam cut 20 mm short of the column's face: beside the section, within the
# erection clearance.
set shortId to add bim linear typed beamType on ground from (a cad vector3 with x -0.17, y 0.0 and z 3.0) to (a cad vector3 with x -4.0, y 0.0 and z 3.0) turned 0.0 to target
# And one 100 mm short of it: no joint.
set farId to add bim linear typed beamType on ground from (a cad vector3 with x 0.0, y 0.25 and z 5.0) to (a cad vector3 with x 0.0, y 4.0 and z 5.0) turned 0.0 to target
set ids to an empty list of a 64 bit integer
append columnId to ids
append beamId to ids
set nodeId to add bim steel connection among ids style 3 in target
set nodeFound to the bim connection index of nodeId in modelValue
check recipe following (nodeFound's valid and ((the item at nodeFound's position in (modelValue's connections's values))'s category = 2)) named (the string form of "a recipe makes a Parametric node")
check recipe following ((the absolute value of ((the tested plate height of nodeId in modelValue) - 0.38)) < 1e-9) named (the string form of "the end plate is the beam's depth and 80 mm")
check recipe following ((follow bim steel recipes in target) = 0) named (the string form of "nothing to follow while the profiles stand")
ignore set bim linear beamId type to deepType in target
check recipe following ((follow bim steel recipes in target) = 1) named (the string form of "a deeper beam changes its node")
check recipe following ((the absolute value of ((the tested plate height of nodeId in modelValue) - 0.58)) < 1e-9) named (the string form of "the end plate follows the deeper beam")
check recipe following ((follow bim steel recipes in target) = 0) named (the string form of "following settles")
ignore size bim linear type deepType to 0.2 by 0.4 in target
check recipe following ((follow bim steel recipes in target) = 1) named (the string form of "a resized type changes its node")
check recipe following ((the absolute value of ((the tested plate height of nodeId in modelValue) - 0.48)) < 1e-9) named (the string form of "the end plate follows the resized type")
# A part added by hand makes the node Complex: it no longer follows.
check recipe following (add bim connection part of kind 0 to node nodeId in target) named (the string form of "a plate is added by hand")
set nodeFound to the bim connection index of nodeId in modelValue
check recipe following ((the item at nodeFound's position in (modelValue's connections's values))'s category = 1) named (the string form of "the edited node is Complex")
ignore set bim linear beamId type to beamType in target
check recipe following ((follow bim steel recipes in target) = 0) named (the string form of "an edited node keeps its parts")
check recipe following ((the absolute value of ((the tested plate height of nodeId in modelValue) - 0.48)) < 1e-9) named (the string form of "its end plate stays as it was")
clear ids
append columnId to ids
append shortId to ids
check recipe following ((add bim steel connection among ids style 4 in target) != the bim refused id) named (the string form of "a beam 20 mm short of the column's face takes a fin plate")
clear ids
append columnId to ids
append farId to ids
check recipe following ((add bim steel connection among ids style 4 in target) = the bim refused id) named (the string form of "a beam 100 mm short of it takes none")
free ids
