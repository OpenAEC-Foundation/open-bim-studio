import structural/steel/bim_connection_gallery.dl
import elements/connection/bim_fastener_gallery.dl
import elements/connection/connection_detail.dl
import elements/connection/bim_connection_geometry.dl
import exchange/ifcx/bim_file.dl

function check connection gallery {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print label as a line

set library to the bim fastener gallery
check connection gallery (((the length of (library's fastenerComponents's values)) = 135) and ((the length of (library's instances's values)) = 135)) named (the string form of "120 catalogue types and 15 assembled bolts placed")
set supported to true
loop cursor from 0 to the length of (library's fastenerComponents's values):
    set binding to the item at cursor in (library's fastenerComponents's values)
    set fastener to @intrinsic("construct", a connection fastener, 1, binding's componentId, binding's kind, the cad zero vector3, the cad z axis, binding's diameter, binding's length, binding's parameters)
    if (the connection analytic detail issue of fastener) != (the string form of ""):
        set supported to false
check connection gallery supported named (the string form of "Every library family supports analytic inspection")
set source to the bim file text of library
set reopened to the bim model parsed from source
check connection gallery (reopened's valid and ((the bim file text of reopened's modelValue) = source)) named (the string form of "Complete native library round trips")
check connection gallery (write bim text source to file (the string form of "build/connection-gallery/01-fastener-library.bim")) named (the string form of "Native library saved")
set gallery to the bim connection gallery
check connection gallery ((the length of (gallery's connections's values)) = 10) named (the string form of "Five bases, a brace and four further applied joints")
set valid to true
set baseCount to 0
set weldedBases to 0
loop cursor from 0 to the length of (gallery's connections's values):
    set node to the item at cursor in (gallery's connections's values)
    set result to the bim connection evaluation of node in gallery
    set packet to the analytic assembly of connection node in gallery
    if (the item at 31 in packet) < 0.5:
        print ((the string form of "Unsupported assembly ") + node's name) as a line
        set valid to false
    if (the length of packet) != (64 + (((the item at 31 in packet) as an integer) * 64)):
        set valid to false
    free packet
    if result's valid = false:
        print result's message as a line
        set valid to false
    if node's style = 2:
        set baseCount to baseCount + 1
        set holes to the bim plate perforations of connection node in gallery
        if (the length of holes) != 4:
            set valid to false
        free holes
        if (the length of (result's welds's values)) = 2:
            set weldedBases to weldedBases + 1
        loop anchorCursor from 0 to the length of (result's fasteners's values):
            set anchor to the item at anchorCursor in (result's fasteners's values)
            set size to the connection metric fastener size of anchor's diameter
            set seat to ((the connection nut station of anchor) + (size's nutHeight * (anchor's parameters's nuts as a 64 bit floating-point number))) + size's washerThickness
            if (the absolute value of (anchor's origin's z - seat)) > 0.00000001:
                set valid to false
check connection gallery valid named (the string form of "Every assembly supports CSG, plate holes and seated anchor washers")
check connection gallery ((baseCount = 5) and (weldedBases = 5)) named (the string form of "All five bases retain independent weld additions")
check connection gallery ((the length of (gallery's connectionTypes's values)) = 9) named (the string form of "Nine reusable connection types retained")
set weldBodiesValid to true
loop nodeCursor from 0 to the length of (gallery's connections's values):
    set parts to the bim parts of connection (the item at nodeCursor in (gallery's connections's values)) in gallery
    loop partCursor from 0 to the length of (parts's values):
        set part to the item at partCursor in (parts's values)
        if part's kind's name = (the string form of "Fillet weld"):
            set solid to the bim fillet weld solid of part's element typed part's kind in gallery
            if solid's valid = false:
                set weldBodiesValid to false
check connection gallery weldBodiesValid named (the string form of "All fillet welds build as exact triangular prisms")
set source to the bim file text of gallery
set reopened to the bim model parsed from source
check connection gallery (reopened's valid and ((the bim file text of reopened's modelValue) = source)) named (the string form of "Applied joints and types round trip")
check connection gallery (write bim text source to file (the string form of "build/connection-gallery/02-applied-connections.bim")) named (the string form of "Native applied connections saved")
set scratch to the bim snapshot of gallery
set target to the address of scratch
set firstColumn to the item at 0 in (scratch's linears's values)
set newColumn to add bim linear typed firstColumn's typeId on firstColumn's levelId from (a cad vector3 with x 10.0, y 0.0 and z 0.0) to (a cad vector3 with x 10.0, y 0.0 and z 1.0) turned 1.5707963267948966 to target
set identities to an empty list of a 64 bit integer
append newColumn to identities
set newBase to apply bim connection type (the item at 0 in (scratch's connectionTypes's values))'s id among identities in target
check connection gallery (newBase != the bim refused id) named (the string form of "Saved base plate type applies to another column")
set newNode to the item at (the bim connection index of newBase in scratch)'s position in (scratch's connections's values)
set result to the bim connection evaluation of newNode in scratch
set firstWeld to the item at 0 in (result's welds's values)
check connection gallery (((the absolute value of firstWeld's axis's x) < 0.00000001) and ((the absolute value of (firstWeld's axis's y - 1.0)) < 0.00000001)) named (the string form of "Weld runs rotate with their column")
set before to the bim file text of scratch
check connection gallery ((add bim connection part of kind 1 to node newBase in target) = false) named (the string form of "Additional unsupported bolt groups are refused")
check connection gallery ((the bim file text of scratch) = before) named (the string form of "Refused base plate edit is atomic")
free identities

set workbench to the bim connection workbench
set combinedText to the bim file text of workbench
set reopenedWorkbench to the bim model parsed from combinedText
check connection gallery reopenedWorkbench's valid named (the string form of "Combined library and connections reopen in one model")
check connection gallery (write bim text combinedText to file (the string form of "build/connection-gallery/00-library-and-connections.bim")) named (the string form of "Combined native workbench saved")
set previewPacket to the analytic assembly of connection (the item at 1 in (gallery's connections's values)) in gallery
set previewText to the string form of ""
loop slot from 0 to the length of previewPacket:
    set previewText to previewText + ((the string form of (the item at slot in previewPacket)) + (the string form of " "))
ignore write bim text previewText to file (the string form of "build/connection-gallery/preview-parameters.txt")
free previewPacket
