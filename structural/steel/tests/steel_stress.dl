# SPDX-License-Identifier: MPL-2.0
# Generic large model; no customer data. Geometry/serialization stress, not an FPS benchmark.
import model/bim_baseplate.dl
import model/bim_steel_profiles.dl
import formats/bim_file.dl

function check steel stress {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Steel test datum") at 0.0 with height 4.0 to target
ignore add bim eu steel profiles to target
set columnType to the bim refused id
set beamType to the bim refused id
loop typeCursor from 0 to the length of (modelValue's linearTypes's values):
    set candidate to the item at typeCursor in (modelValue's linearTypes's values)
    if (candidate's name = (the string form of "HEA 200")) and (candidate's role = bim column role):
        set columnType to candidate's id
    if (candidate's name = (the string form of "IPE 300")) and (candidate's role = bim beam role):
        set beamType to candidate's id
check steel stress ((columnType != the bim refused id) and (beamType != the bim refused id)) named (the string form of "European steel profiles loaded")
set allValid to true
loop stationIndex from 0 to 2000:
    set xValue to ((the remainder of stationIndex divided by 50) as a 64 bit floating-point number) * 12.0
    set yValue to ((stationIndex / 50) as a 64 bit floating-point number) * 12.0
    set foot to a cad vector3 with x xValue, y yValue and z 0.0
    set head to a cad vector3 with x xValue, y yValue and z 4.0
    set angleValue to ((the remainder of stationIndex divided by 12) as a 64 bit floating-point number) * 0.2617993877991494
    set columnId to add bim linear typed columnType on ground from foot to head turned angleValue to target
    if (the remainder of stationIndex divided by 2) = 1:
        ignore move bim linear columnId to head and foot turned angleValue in target
    set baseId to add bim base plate below columnId in target
    if baseId = the bim refused id:
        set allValid to false
    set identities to an empty list of a 64 bit integer
    append columnId to identities
    set memberCount to 2 + (the remainder of stationIndex divided by 5)
    loop branchIndex from 0 to (memberCount - 1):
        set turn to angleValue + ((branchIndex as a 64 bit floating-point number) * (6.283185307179586 / ((memberCount - 1) as a 64 bit floating-point number)))
        set tilt to ((the remainder of (stationIndex + branchIndex) divided by 3) as a 64 bit floating-point number) - 1.0
        set ending to a cad vector3 with x (xValue + 4.0 * (the cosine of turn)), y (yValue + 4.0 * (the sine of turn)) and z (4.0 + tilt * 0.75)
        set beamId to add bim linear typed beamType on ground from head to ending turned angleValue to target
        append beamId to identities
    if (add bim connection among identities category 1 style 0 in target) = the bim refused id:
        set allValid to false
    free identities
check steel stress allValid named (the string form of "2000 bases and mixed 2 to 6 member nodes created")
check steel stress ((the length of (modelValue's linears's values)) = 8000) named (the string form of "8000 rotated and inclined steel members")
check steel stress ((the length of (modelValue's connections's values)) = 4000) named (the string form of "4000 connection nodes retained")
set fastenerCount to 0
set validCount to 0
loop nodeCursor from 0 to the length of (modelValue's connections's values):
    set generated to the bim connection evaluation of (the item at nodeCursor in (modelValue's connections's values)) in modelValue
    if generated's valid:
        set validCount to validCount + 1
    set fastenerCount to fastenerCount + (the length of (generated's fasteners's values))
check steel stress (validCount = 4000) named (the string form of "every generated connection validates")
check steel stress (fastenerCount = 8000) named (the string form of "8000 generated anchors")
set savedText to the bim file text of modelValue
check steel stress (write bim text savedText to file (the string form of "mega-steel-connections.bim")) named (the string form of "large model written")
set reloaded to the bim model parsed from savedText
check steel stress reloaded's valid named (the string form of "large model reloads")
check steel stress ((the bim file text of reloaded's modelValue) = savedText) named (the string form of "large model round trip preserves parameters")
