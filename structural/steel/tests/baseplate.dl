# SPDX-License-Identifier: MPL-2.0
import structural/steel/bim_baseplate.dl
import exchange/ifcx/bim_file.dl

function check base plate {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set documentValue to a new bim document
set target to the address of (documentValue's current)
set levelId to add bim level named (the string form of "Base") at 4.0 with height 3.0 to target
set typeId to add bim linear type named (the string form of "Steel column") as role bim column role sized 0.20 by 0.30 round false of (the string form of "steel") to target
# Reversed endpoint order and a quarter-turn exercise host coordinates.
set columnId to add bim linear typed typeId on levelId from (a cad vector3 with x 2.0, y 3.0 and z 3.0) to (a cad vector3 with x 2.0, y 3.0 and z 0.0) turned 1.5707963267948966 to target
begin bim transaction in (the address of documentValue)
set nodeId to add bim base plate below columnId in target
check base plate (nodeId != the bim refused id) named (the string form of "create base plate on reversed column")
commit bim transaction in (the address of documentValue)
set spec to the item at 0 in (target's connections's values)
check base plate ((the item at 0 in (spec's members's values))'s end = 1) named (the string form of "uses lower endpoint")
set generated to the bim connection evaluation of spec in documentValue's current
check base plate (generated's valid and ((the length of (generated's fasteners's values)) = 4)) named (the string form of "four anchors generated")
check base plate ((the length of (generated's voids's values)) = 1) named (the string form of "anchors do not drill the column")
set firstAnchor to the item at 0 in (generated's fasteners's values)
check base plate (((the absolute value of (firstAnchor's origin's x - 2.2)) < 1e-9) and ((the absolute value of (firstAnchor's origin's z - 4.04)) < 1e-9)) named (the string form of "anchors follow rotation and storey elevation")
set parts to the bim parts of connection spec in documentValue's current
check base plate ((the length of (parts's values)) = 9) named (the string form of "plate plus four rods and heads")
set platePart to the item at 0 in (parts's values)
check base plate ((the absolute value of platePart's element's start's z) < 1e-9) named (the string form of "plate top touches column foot")
set savedText to the bim file text of documentValue's current
set readback to the bim model parsed from savedText
check base plate readback's valid named (the string form of "base plate file parses")
check base plate ((the bim file text of readback's modelValue) = savedText) named (the string form of "base plate parameters round trip")
check base plate ((add bim base plate below columnId in target) = the bim refused id) named (the string form of "duplicate lower-end connection refused")
set edited to spec
set edited's additions to the cad clone of spec's additions
set plateValue to the item at 0 in (edited's additions's values)
set plateValue's width to 0.21
replace item at index 0 in (edited's additions's values) with plateValue
check base plate ((store bim connection edited in target) = the bim refused id) named (the string form of "holes outside plate refused")
set plateValue's width to 0.4
set plateValue's thickness to 0.04
replace item at index 0 in (edited's additions's values) with plateValue
begin bim transaction in (the address of documentValue)
check base plate ((store bim connection edited in target) = nodeId) named (the string form of "plate thickness editable")
commit bim transaction in (the address of documentValue)
ignore undo bim transaction in (the address of documentValue)
check base plate ((the bim file text of documentValue's current) = savedText) named (the string form of "undo restores parameters")
begin bim transaction in (the address of documentValue)
ignore move bim linear columnId to (a cad vector3 with x 5.0, y 6.0 and z 3.0) and (a cad vector3 with x 5.0, y 6.0 and z 0.0) turned 0.0 in target
commit bim transaction in (the address of documentValue)
set generated to the bim connection evaluation of spec in documentValue's current
set firstAnchor to the item at 0 in (generated's fasteners's values)
check base plate ((the absolute value of (firstAnchor's origin's x - 4.85)) < 1e-9) named (the string form of "connection follows moved host")
