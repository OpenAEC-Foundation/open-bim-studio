# Synthetic modelling example: 20 HEB 200 columns on a 5 x 4, 6 m grid.
# Dimensions are illustrative; no structural resistance is claimed.
import structural/steel/bim_baseplate.dl
import elements/linear/bim_profiles.dl

function the bim demo column bases:
    execute:
        set modelValue to an empty bim model
        set target to the address of modelValue
        set ground to add bim level named (the string form of "Column bases") at 0.0 with height 6.0 to target
        set columnType to add bim linear type named (the string form of "HEB 200") as role bim column role sized 0.20 by 0.20 round false of (the string form of "steel") to target
        give bim linear type columnType profile bim i shape profile web 0.009 flange 0.015 fillet 0.018 fourth 0.0 series 4 in target
        set bim setting (bim steel designation setting) of columnType to (200 as a 64 bit integer) keeping true in target
        loop xCursor from 0 to 5:
            loop yCursor from 0 to 4:
                set xValue to (xCursor as a 64 bit floating-point number) * 6.0
                set yValue to (yCursor as a 64 bit floating-point number) * 6.0
                set columnId to add bim linear typed columnType on ground from (a cad vector3 with x xValue, y yValue and z 0.0) to (a cad vector3 with x xValue, y yValue and z 6.0) turned 0.0 to target
                set nodeId to add bim base plate below columnId in target
                set nodeFound to the bim connection index of nodeId in modelValue
                if nodeFound's valid:
                    set nodeValue to the item at nodeFound's position in (target's connections's values)
                    set nodeValue's name to ((the string form of "Base ") + (the string form of (xCursor + 1))) + ((the string form of "-") + (the string form of (yCursor + 1)))
                    set nodeValue's additions to the cad clone of nodeValue's additions
                    set plateValue to the item at 0 in (nodeValue's additions's values)
                    set plateValue's holeDiameter to 0.028
                    replace item at index 0 in (nodeValue's additions's values) with plateValue
                    set anchorValue to the item at 1 in (nodeValue's additions's values)
                    set anchorValue's diameter to 0.024
                    set anchorValue's length to 0.60
                    set anchorValue's holeDiameter to 0.028
                    set anchorValue's parameters's anchorShape to yCursor
                    set anchorValue's parameters's coating to 1 + (the remainder of xCursor divided by 2)
                    if xCursor >= 3:
                        set anchorValue's parameters's grade to 88
                    replace item at index 1 in (nodeValue's additions's values) with anchorValue
                    ignore store bim connection nodeValue in target
        set defaultLayers to an empty list of a bim layer record
        append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to defaultLayers
        ignore add bim wall type named (the string form of "Default wall") with defaultLayers to target
        free defaultLayers
        ignore add bim opening type named (the string form of "Default window") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
        ignore add bim door type named (the string form of "Default door") sized 0.9 by 2.1 with frame 0.05 to target
        return modelValue
