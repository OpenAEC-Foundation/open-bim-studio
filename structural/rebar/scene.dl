# SPDX-License-Identifier: MPL-2.0
# The rebar module's part of the scene: reinforcement, round or as centre lines, kept whenever it is
# in `previous` (fixed detail). Called by the
# composed dispatcher (`append bim module scene meshes of`) in layer order;
# the order does not matter, kept meshes are found by element id and part.
import viewer/bim_scene.dl

function append bim scene meshes of {bim model record:modelValue} within {a 64 bit floating-point number:tolerance} reusing {a pointer to a list:previous} keyed {a pointer to a list:keys} refreshing {a pointer to a list:remadeIds} with reinforcement detail {boolean:rebarDetail} into {a pointer to a list:result} with structural_rebar elements:
    execute:
        # Reinforcement: fixed detail as well.
        loop cursor from 0 to the length of (modelValue's reinforcements's values):
            set spec to the item at cursor in (modelValue's reinforcements's values)
            set rebarSlot to the bim kept slot of spec's id part (bim reinforcement part) among keys
            if rebarSlot >= 0:
                append (the item at rebarSlot in previous) to result
            else:
                set rebarShape to an empty fast mesh
                if rebarDetail:
                    set rebarShape to the bim reinforcement shape of spec in modelValue
                else:
                    set rebarShape to the bim reinforcement line shape of spec in modelValue
                append (@intrinsic("construct", a bim scene mesh record, spec's id, 0 as a 64 bit integer, bim reinforcement part, rebarShape, bim other category, the bim material colour of (the string form of "steel"), the string form of "steel")) to result
