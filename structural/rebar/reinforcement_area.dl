# SPDX-License-Identifier: MPL-2.0
# Area and mesh share a surface mapping, while retaining distinct object kinds.
# Floor: local X/Y with Z normal. Wall: local X/Z with Y normal.
# Radius is signed; zero is flat. X is developed length along the surface.
function the area reinforcement issue of {reinforcement definition:spec}:
    execute:
        set extent to the cad distance from spec's start to spec's finish
        if (spec's areaMode < 0) or (spec's areaMode > 1):
            return the string form of "Surface mode: 0 floor, 1 wall"
        if (spec's faceMask < 1) or (spec's faceMask > 3):
            return the string form of "Faces: 1 lower/front, 2 upper/back, 3 both"
        if ((spec's width > 0.0) and (spec's width < 100000.0)) = false:
            return the string form of "Invalid area width or height"
        if ((spec's depth > 0.0) and (spec's depth < 1000.0)) = false:
            return the string form of "Invalid surface thickness"
        if spec's curveRadius != 0.0:
            if (((the absolute value of spec's curveRadius) > (spec's depth * 2.0)) and ((the absolute value of spec's curveRadius) < 10000000.0)) = false:
                return the string form of "Curve radius must exceed twice the thickness"
            if (extent / (the absolute value of spec's curveRadius)) > 3.141592653589793:
                return the string form of "Surface arc exceeds half a circle"
        loop faceIndex from 0 to 2:
            set active to true
            if (faceIndex = 0) and (spec's faceMask = 2):
                set active to false
            if (faceIndex = 1) and (spec's faceMask = 1):
                set active to false
            if active:
                set mainSize to spec's diameter
                set crossSize to spec's secondaryDiameter
                set alongSpacing to spec's spacing
                set acrossSpacing to spec's crossSpacing
                if faceIndex = 1:
                    set mainSize to spec's farDiameter
                    set crossSize to spec's farSecondaryDiameter
                    set alongSpacing to spec's farSpacing
                    set acrossSpacing to spec's farCrossSpacing
                if ((mainSize > 0.0) and (mainSize < 1.0)) = false:
                    return the string form of "Invalid area main diameter"
                if ((crossSize > 0.0) and (crossSize < 1.0)) = false:
                    return the string form of "Invalid area cross diameter"
                if ((alongSpacing > 0.000001) and (alongSpacing < 10000.0)) = false:
                    return the string form of "Invalid area main spacing"
                if ((acrossSpacing > 0.000001) and (acrossSpacing < 10000.0)) = false:
                    return the string form of "Invalid area cross spacing"
                if (extent <= (2.0 * spec's cover + crossSize)) or (spec's width <= (2.0 * spec's cover + mainSize)):
                    return the string form of "Cover does not fit the area"
                if (extent / alongSpacing + spec's width / acrossSpacing) > 10000.0:
                    return the string form of "Area exceeds 10000 distribution intervals"
                set estimatedSamples to 1.0
                if spec's curveRadius != 0.0:
                    set estimatedSamples to 1.0 + ((extent / (the absolute value of spec's curveRadius)) / (the square root of (0.008 / ((the absolute value of spec's curveRadius) + spec's depth))))
                set estimatedPoints to ((spec's width / acrossSpacing + 2.0) * (estimatedSamples + 1.0)) + ((extent / alongSpacing + 2.0) * 2.0)
                if spec's faceMask = 3:
                    set estimatedPoints to estimatedPoints * 2.0
                if estimatedPoints > 50000.0:
                    return the string form of "Area exceeds preview budget; split the region or increase spacing"
                if spec's depth <= (2.0 * (spec's cover + mainSize + crossSize)):
                    return the string form of "Reinforcement faces do not fit the thickness"
        return the string form of ""

function the area reinforcement position u {a 64 bit floating-point number:uValue} v {a 64 bit floating-point number:vValue} offset {a 64 bit floating-point number:offsetValue} in {reinforcement definition:spec}:
    execute:
        set longitudinal to uValue
        set normalPosition to offsetValue
        if spec's curveRadius != 0.0:
            set theta to uValue / spec's curveRadius
            set longitudinal to (spec's curveRadius - offsetValue) * (the sine of theta)
            set normalPosition to spec's curveRadius - ((spec's curveRadius - offsetValue) * (the cosine of theta))
        set localPoint to a cad vector3 with x longitudinal, y vValue and z normalPosition
        if spec's areaMode = 1:
            set localPoint to a cad vector3 with x longitudinal, y normalPosition and z vValue
        return the reinforcement position localPoint in spec

function the area reinforcement of {reinforcement definition:spec}:
    execute:
        set output to @intrinsic("construct", a reinforcement result, true, the string form of "", a cad topology list of a reinforcement bar)
        set extent to the cad distance from spec's start to spec's finish
        loop faceIndex from 0 to 2:
            set active to true
            if (faceIndex = 0) and (spec's faceMask = 2):
                set active to false
            if (faceIndex = 1) and (spec's faceMask = 1):
                set active to false
            if active:
                set mainSize to spec's diameter
                set crossSize to spec's secondaryDiameter
                set alongSpacing to spec's spacing
                set acrossSpacing to spec's crossSpacing
                if faceIndex = 1:
                    set mainSize to spec's farDiameter
                    set crossSize to spec's farSecondaryDiameter
                    set alongSpacing to spec's farSpacing
                    set acrossSpacing to spec's farCrossSpacing
                loop directionIndex from 0 to 2:
                    set barSize to mainSize
                    set offsetValue to spec's cover + mainSize * 0.5
                    set rangeStart to spec's cover + mainSize * 0.5
                    set rangeEnd to spec's width - rangeStart
                    set maxSpacing to acrossSpacing
                    set pathStart to spec's cover
                    set pathEnd to extent - spec's cover
                    if directionIndex = 1:
                        set barSize to crossSize
                        set offsetValue to (spec's cover + mainSize) + crossSize * 0.5
                        set rangeStart to spec's cover + crossSize * 0.5
                        set rangeEnd to extent - rangeStart
                        set maxSpacing to alongSpacing
                        set pathEnd to spec's width - spec's cover
                    if faceIndex = 1:
                        set offsetValue to spec's depth - offsetValue
                    set intervals to the reinforcement intervals over (rangeEnd - rangeStart) at maxSpacing
                    set samples to 1
                    set analyticLength to pathEnd - pathStart
                    if (directionIndex = 0) and (spec's curveRadius != 0.0):
                        set sweepAngle to (pathEnd - pathStart) / (the absolute value of spec's curveRadius)
                        set radiusValue to the absolute value of (spec's curveRadius - offsetValue)
                        set stepAngle to the square root of (0.008 / radiusValue)
                        set samples to (the maximum of 1.0 and (@intrinsic("call", "libc", "ceil", a 64 bit floating-point number, sweepAngle / stepAngle))) as an integer
                        set analyticLength to radiusValue * sweepAngle
                    loop barIndex from 0 to (intervals + 1):
                        set stationValue to rangeStart + ((rangeEnd - rangeStart) * ((barIndex as a 64 bit floating-point number) / (intervals as a 64 bit floating-point number)))
                        set vertices to a cad topology list of a cad vector3
                        loop pointIndex from 0 to (samples + 1):
                            set pathValue to pathStart + ((pathEnd - pathStart) * ((pointIndex as a 64 bit floating-point number) / (samples as a 64 bit floating-point number)))
                            set uValue to pathValue
                            set vValue to stationValue
                            if directionIndex = 1:
                                set uValue to stationValue
                                set vValue to pathValue
                            append (the area reinforcement position u uValue v vValue offset offsetValue in spec) to (vertices's values)
                        set label to ((spec's mark + (the string form of "-F")) + (the string form of faceIndex)) + (the string form of "-D")
                        set label to label + (the string form of directionIndex)
                        append (@intrinsic("construct", a reinforcement bar, label, barSize, vertices, analyticLength, false)) to (output's bars's values)
        return output

function the area reinforcement annotation of {reinforcement definition:spec}:
    execute:
        set label to (the string form of "Area ") + spec's mark
        if spec's kind = 2:
            set label to (((the string form of "Mesh ") + spec's meshType) + (the string form of " / ")) + spec's mark
        loop faceIndex from 0 to 2:
            set active to true
            if (faceIndex = 0) and (spec's faceMask = 2):
                set active to false
            if (faceIndex = 1) and (spec's faceMask = 1):
                set active to false
            if active:
                set faceLabel to the string form of " bottom"
                set mainSize to spec's diameter
                set crossSize to spec's secondaryDiameter
                set alongSpacing to spec's spacing
                set acrossSpacing to spec's crossSpacing
                if spec's areaMode = 1:
                    set faceLabel to the string form of " front"
                if faceIndex = 1:
                    set faceLabel to the string form of " top"
                    if spec's areaMode = 1:
                        set faceLabel to the string form of " back"
                    set mainSize to spec's farDiameter
                    set crossSize to spec's farSecondaryDiameter
                    set alongSpacing to spec's farSpacing
                    set acrossSpacing to spec's farCrossSpacing
                set label to ((label + faceLabel) + (the string form of " X D")) + (the reinforcement millimetres of mainSize)
                set label to (label + (the string form of " @ ")) + (the reinforcement millimetres of acrossSpacing)
                set label to (label + (the string form of " Y D")) + (the reinforcement millimetres of crossSize)
                set label to (label + (the string form of " @ ")) + (the reinforcement millimetres of alongSpacing)
        if (spec's curveRadius != 0.0) and (spec's hostId = ((-1) as a 64 bit integer)):
            set label to (label + (the string form of " R")) + (the reinforcement millimetres of spec's curveRadius)
        return label
