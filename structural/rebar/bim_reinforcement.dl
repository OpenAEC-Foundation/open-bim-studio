# Adapter from pure reinforcement definitions to BIM transactions and linear parts.
import bim/bim_model.dl
import architectural/stairs/bim_stair.dl
import mep/common/bim_network.dl
import elements/planar/bim_evaluate.dl

function the bim reinforcement index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's reinforcements's values)

# Hosted cages derive axes and envelope from the current member and its type.
function the bim hostbound reinforcement {reinforcement definition:spec} in {bim model record:modelValue}:
    execute:
        set resolved to spec
        if ((spec's kind = 2) or (spec's kind = 5)) and (spec's hostId != the bim refused id):
            set wallFound to the bim wall index of spec's hostId in modelValue
            if wallFound's valid:
                set wallValue to the item at wallFound's position in (modelValue's walls's values)
                set resolved's finish to resolved's start
                if (wallValue's lean != 0.0) or (wallValue's rise != 0.0):
                    return resolved
                # Until void clipping is available, refuse a perforated host.
                loop openingIndex from 0 to the length of (modelValue's openings's values):
                    if (the item at openingIndex in (modelValue's openings's values))'s hostId = wallValue's id:
                        return resolved
                set levelFound to the bim level index of wallValue's levelId in modelValue
                if levelFound's valid = false:
                    return resolved
                set elevation to (the item at levelFound's position in (modelValue's levels's values))'s elevation + wallValue's baseOffset
                set thicknessValue to the bim wall thickness of wallValue in modelValue
                set tangentValue to the bim tangent of wallValue at finish false
                set spanValue to the bim centreline length of wallValue
                set arcValue to the bim arc of wallValue
                set resolved's curveRadius to 0.0
                if arcValue's curved:
                    set signedRadius to arcValue's radius
                    if arcValue's sweep < 0.0:
                        set signedRadius to 0.0 - signedRadius
                    set resolved's curveRadius to signedRadius + thicknessValue * 0.5
                    set spanValue to spanValue * (resolved's curveRadius / signedRadius)
                set resolved's start to a cad vector3 with x (wallValue's start's x + tangentValue's y * thicknessValue * 0.5), y (wallValue's start's y - tangentValue's x * thicknessValue * 0.5) and z elevation
                set resolved's finish to the cad sum of resolved's start and (a cad vector3 with x (spanValue * tangentValue's x), y (spanValue * tangentValue's y) and z 0.0)
                set resolved's width to wallValue's height
                set resolved's depth to thicknessValue
                set resolved's levelId to wallValue's levelId
                set resolved's areaMode to 1
                return resolved
            set slabFound to the bim slab index of spec's hostId in modelValue
            if slabFound's valid:
                set slabValue to the item at slabFound's position in (modelValue's slabs's values)
                set resolved's finish to resolved's start
                if ((the length of (slabValue's outline's values)) != 4) or (slabValue's pitch != 0.0):
                    return resolved
                set firstCorner to the item at 0 in (slabValue's outline's values)
                set secondCorner to the item at 1 in (slabValue's outline's values)
                set thirdCorner to the item at 2 in (slabValue's outline's values)
                set fourthCorner to the item at 3 in (slabValue's outline's values)
                set edgeValue to the cad difference of secondCorner and firstCorner
                set sideValue to the cad difference of fourthCorner and firstCorner
                set edgeLength to the cad length of edgeValue
                if edgeLength < 0.000001:
                    return resolved
                if (the absolute value of (the cad dot of edgeValue and sideValue)) > 0.000001:
                    return resolved
                if (the cad distance from thirdCorner to (the cad sum of secondCorner and sideValue)) > 0.000001:
                    return resolved
                set acrossValue to a cad vector2 with x (0.0 - edgeValue's y / edgeLength) and y (edgeValue's x / edgeLength)
                set breadthValue to the cad dot of sideValue and acrossValue
                if breadthValue < 0.0:
                    set firstCorner to fourthCorner
                    set secondCorner to thirdCorner
                    set breadthValue to 0.0 - breadthValue
                set levelFound to the bim level index of slabValue's levelId in modelValue
                if levelFound's valid = false:
                    return resolved
                set thicknessValue to the bim thickness of plate slabValue in modelValue
                set elevation to ((the item at levelFound's position in (modelValue's levels's values))'s elevation + slabValue's top) - thicknessValue
                set resolved's start to a cad vector3 with x firstCorner's x, y firstCorner's y and z elevation
                set resolved's finish to a cad vector3 with x secondCorner's x, y secondCorner's y and z elevation
                set resolved's width to breadthValue
                set resolved's depth to thicknessValue
                set resolved's levelId to slabValue's levelId
                set resolved's areaMode to 0
                set resolved's curveRadius to 0.0
                return resolved
            set resolved's finish to resolved's start
            return resolved
        if spec's hostId != the bim refused id:
            set found to the bim linear index of spec's hostId in modelValue
            if found's valid:
                set hostValue to the item at found's position in (modelValue's linears's values)
                set profile to the bim type of linear hostValue in modelValue
                set resolved's start to hostValue's start
                set resolved's finish to hostValue's finish
                set resolved's levelId to hostValue's levelId
                set resolved's width to profile's width
                set resolved's depth to profile's depth
            else:
                set resolved's finish to resolved's start
        return resolved

# Shared type parameters exclude placement, dimensions and local additions.
function the bim reinforcement {reinforcement definition:placement} using cage parameters {reinforcement definition:prototype}:
    execute:
        set result to placement
        set result's topCount to prototype's topCount
        set result's bottomCount to prototype's bottomCount
        set result's topDiameter to prototype's topDiameter
        set result's bottomDiameter to prototype's bottomDiameter
        set result's diameter to prototype's diameter
        set result's secondaryDiameter to prototype's secondaryDiameter
        set result's spacing to prototype's spacing
        set result's cover to prototype's cover
        set result's bendRadius to prototype's bendRadius
        set result's steelKey to prototype's steelKey
        set result's secondarySteelKey to prototype's secondarySteelKey
        return result

function the bim reinforcement adopting type of {reinforcement definition:placement} in {bim model record:modelValue}:
    execute:
        if (placement's kind = 1) and (placement's cageType != (the string form of "-")):
            loop cursor from 0 to the length of (modelValue's reinforcements's values):
                set prototype to the item at cursor in (modelValue's reinforcements's values)
                if ((prototype's kind = 1) and (prototype's cageType = placement's cageType)) and (prototype's id != placement's id):
                    return the bim reinforcement placement using cage parameters prototype
        return placement

function store bim reinforcement {reinforcement definition:spec} in {a pointer to a bim model record:target}:
    execute:
        if (the reinforcement issue of (the bim hostbound reinforcement spec in (@intrinsic("dereference", target)))) != (the string form of ""):
            return the bim refused id
        if (the bim level index of spec's levelId in (@intrinsic("dereference", target)))'s valid = false:
            return the bim refused id
        # Validate the complete type edit before changing any placement.
        if (spec's kind = 1) and (spec's cageType != (the string form of "-")):
            loop cursor from 0 to the length of (target's reinforcements's values):
                set sibling to the item at cursor in (target's reinforcements's values)
                if ((sibling's kind = 1) and (sibling's cageType = spec's cageType)) and (sibling's id != spec's id):
                    set candidate to the bim reinforcement sibling using cage parameters spec
                    if (the reinforcement issue of (the bim hostbound reinforcement candidate in (@intrinsic("dereference", target)))) != (the string form of ""):
                        return the bim refused id
        set replacement to spec
        set found to the bim reinforcement index of spec's id in (@intrinsic("dereference", target))
        if found's valid:
            replace item at index found's position in (target's reinforcements's values) with replacement
        else:
            set replacement's id to the bim new id in target
            append replacement to (target's reinforcements's values)
        if (spec's kind = 1) and (spec's cageType != (the string form of "-")):
            loop cursor from 0 to the length of (target's reinforcements's values):
                set sibling to the item at cursor in (target's reinforcements's values)
                if ((sibling's kind = 1) and (sibling's cageType = spec's cageType)) and (sibling's id != replacement's id):
                    replace item at index cursor in (target's reinforcements's values) with (the bim reinforcement sibling using cage parameters spec)
                    note bim change of sibling's id in target
        note bim change of replacement's id in target
        return replacement's id

function delete bim reinforcement {a 64 bit integer:wanted} from {a pointer to a bim model record:target}:
    execute:
        set found to the bim reinforcement index of wanted in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        drop bim reinforcement tags of wanted in target
        remove item found's position from (target's reinforcements's values)
        note bim change of wanted in target
        return true

# Generated paths follow the host's local section axes, including its roll.
function the bim reinforcement paths of {reinforcement definition:spec} in {bim model record:modelValue}:
    execute:
        set resolved to the bim hostbound reinforcement spec in modelValue
        set generated to the reinforcement of resolved
        if generated's valid = false:
            return generated
        set found to the bim linear index of spec's hostId in modelValue
        if found's valid:
            set hostValue to the item at found's position in (modelValue's linears's values)
            set frameValue to the bim frame of linear hostValue in modelValue
            set originalAcross to the cad difference of (the reinforcement position (a cad vector3 with x 0.0, y 1.0 and z 0.0) in resolved) and resolved's start
            set originalUpward to the cad difference of (the reinforcement position (a cad vector3 with x 0.0, y 0.0 and z 1.0) in resolved) and resolved's start
            loop barCursor from 0 to the length of (generated's bars's values):
                set barValue to the item at barCursor in (generated's bars's values)
                loop pointCursor from 0 to the length of (barValue's points's values):
                    set relative to the cad difference of (the item at pointCursor in (barValue's points's values)) and resolved's start
                    set longitudinal to frameValue's along scaled by (the cad dot of relative and frameValue's along)
                    set transverse to frameValue's widthAxis scaled by (the cad dot of relative and originalAcross)
                    set vertical to frameValue's depthAxis scaled by (the cad dot of relative and originalUpward)
                    set positioned to the cad sum of resolved's start and (the cad sum of longitudinal and (the cad sum of transverse and vertical))
                    replace item at index pointCursor in (barValue's points's values) with positioned
        return generated

# Derived segments share the parent's pick id. No generated segments are stored.
function the bim parts of reinforcement {reinforcement definition:spec} in {bim model record:modelValue}:
    execute:
        set derived to a cad topology list of a bim stair part record
        set generated to the bim reinforcement paths of spec in modelValue
        loop cursor from 0 to the length of (generated's bars's values):
            set itemValue to the item at cursor in (generated's bars's values)
            set profile to @intrinsic("construct", a bim linear type record, the bim refused id, itemValue's mark, bim generic linear role, itemValue's diameter, itemValue's diameter, true, the string form of "steel")
            loop edge from 0 to ((the length of (itemValue's points's values)) - 1):
                set firstPoint to the item at edge in (itemValue's points's values)
                set lastPoint to the item at (edge + 1) in (itemValue's points's values)
                set segmentValue to @intrinsic("construct", a bim linear record, spec's id, the bim refused id, spec's levelId, firstPoint, lastPoint, 0.0, 0.0, (a cad vector2 with x 1.0 and y 1.0))
                append (@intrinsic("construct", a bim stair part record, segmentValue, profile)) to (derived's values)
        return derived
