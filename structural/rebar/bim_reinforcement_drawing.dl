# SPDX-License-Identifier: MPL-2.0
# Drawing callouts for explicitly tagged reinforcement. No editor or canvas import.
import structural/rebar/bim_reinforcement_schedule.dl

class:
    patterns:
        [a|] bim reinforcement drawing label
    members:
        ownerId as a 64 bit integer
        levelId as a 64 bit integer
        text as a string
        anchor as a cad vector3
        place as a cad vector2
        lineIndex as an integer

class:
    patterns:
        [a|] bim reinforcement drawing labels
    members:
        valid as a boolean
        labels as the type of (a cad topology list of a bim reinforcement drawing label)

function the bim reinforcement plan labels of {bim model record:modelValue} ascii {boolean:asciiOnly}:
    execute:
        set output to @intrinsic("construct", a bim reinforcement drawing labels, true, a cad topology list of a bim reinforcement drawing label)
        # Skip geometry and scheduling entirely when there are no rebar tags.
        set hasTags to false
        loop tagIndex from 0 to the length of (modelValue's tags's values):
            set tagValue to the item at tagIndex in (modelValue's tags's values)
            if (the bim reinforcement index of tagValue's elementId in modelValue)'s valid:
                set hasTags to true
        if hasTags = false:
            return output
        set scheduled to the bim reinforcing schedule of modelValue
        if scheduled's valid = false:
            set output's valid to false
            return output
        loop tagIndex from 0 to the length of (modelValue's tags's values):
            set tagValue to the item at tagIndex in (modelValue's tags's values)
            set found to the bim reinforcement index of tagValue's elementId in modelValue
            if found's valid:
                set spec to the item at found's position in (modelValue's reinforcements's values)
                set resolved to the bim hostbound reinforcement spec in modelValue
                set generated to the bim reinforcement paths of spec in modelValue
                if generated's valid = false:
                    set output's valid to false
                    clear (output's labels's values)
                    return output
                set lineIndex to 0
                loop rowIndex from 0 to the length of (scheduled's rows's values):
                    set rowValue to the item at rowIndex in (scheduled's rows's values)
                    if rowValue's ownerId = spec's id:
                        set placed to false
                        loop barIndex from 0 to the length of (generated's bars's values):
                            set barValue to the item at barIndex in (generated's bars's values)
                            set matches to (barValue's mark = rowValue's mark) and ((barValue's diameter = rowValue's diameter) and (barValue's length = rowValue's length))
                            if matches and (placed = false):
                                if (the length of (barValue's points's values)) > 0:
                                    set anchor to the item at 0 in (barValue's points's values)
                                    set labelText to the bim reinforcing row text rowValue in modelValue ascii asciiOnly
                                    append (@intrinsic("construct", a bim reinforcement drawing label, spec's id, resolved's levelId, labelText, anchor, tagValue's place, lineIndex)) to (output's labels's values)
                                    set lineIndex to lineIndex + 1
                                    set placed to true
                        if placed = false:
                            set output's valid to false
                            clear (output's labels's values)
                            return output
        return output
