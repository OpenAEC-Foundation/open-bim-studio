# SPDX-License-Identifier: MPL-2.0
import model/bim_reinforcement_schedule.dl
import formats/bim_file.dl

function check rebar schedule {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set loaded to the bim model parsed from (the string form of "BIM-SLICE 1\nnext 3\nlevel 1 0 3 Ground\nreinforcement 2 1 -1 1 0 0 0 3 0 0 0.3 0.5 0.016 0.008 0.15 0.15 0.035 0.024 A\n")
check rebar schedule loaded's valid named (the string form of "schedule fixture loads")
set spec to the item at 0 in (loaded's modelValue's reinforcements's values)
set spec's topCount to 3
set spec's topDiameter to 0.012
set spec's bottomCount to 3
set spec's steelKey to the string form of "B500B"
set spec's secondarySteelKey to the string form of "QR24"
set target to the address of (loaded's modelValue)
ignore store bim reinforcement spec in target
set scheduled to the bim reinforcing schedule of loaded's modelValue
check rebar schedule (scheduled's valid and ((the length of (scheduled's rows's values)) = 3)) named (the string form of "cage groups top bottom and hoops separately")
set upperRow to the item at 0 in (scheduled's rows's values)
set lowerRow to the item at 1 in (scheduled's rows's values)
set hoopRow to the item at 2 in (scheduled's rows's values)
check rebar schedule ((upperRow's count = 3) and (upperRow's diameter = 0.012)) named (the string form of "top layer count and diameter")
check rebar schedule ((lowerRow's count = 3) and (lowerRow's diameter = 0.016)) named (the string form of "bottom layer count and diameter")
check rebar schedule ((upperRow's steel = (the string form of "B500B")) and (hoopRow's steel = (the string form of "QR24"))) named (the string form of "main and stirrup steel retained")
check rebar schedule ((hoopRow's shape = (the string form of "HOOP_NO_HOOKS")) and (hoopRow's shapeCode = (the string form of "UNVERIFIED"))) named (the string form of "ideal hoop is not assigned a fabricated standard code")
set generated to the reinforcement of spec
set summedLength to 0.0
set summedCount to 0
loop rowIndex from 0 to the length of (scheduled's rows's values):
    set rowValue to the item at rowIndex in (scheduled's rows's values)
    set summedLength to summedLength + (the bim reinforcing total length of rowValue)
    set summedCount to summedCount + rowValue's count
check rebar schedule (summedCount = (the length of (generated's bars's values))) named (the string form of "schedule accounts for every generated bar")
check rebar schedule ((the absolute value of (summedLength - (the reinforcement total length of generated))) < 1e-9) named (the string form of "schedule conserves analytic centreline length")
set spec's startZoneLength to 0.6
ignore store bim reinforcement spec in target
set zoned to the bim reinforcing schedule of loaded's modelValue
set zonedHoops to the item at 2 in (zoned's rows's values)
check rebar schedule (zonedHoops's spacing = 0.0) named (the string form of "varying stirrup zones do not claim one uniform spacing")
set spec's id to the bim refused id
set spec's start's y to 2.0
set spec's finish's y to 2.0
ignore store bim reinforcement spec in target
set doubled to the bim reinforcing schedule of loaded's modelValue
check rebar schedule ((the length of (doubled's rows's values)) = 6) named (the string form of "matching marks in different owners remain separate")
set invalidSpec to the item at 1 in (target's reinforcements's values)
set invalidSpec's finish to invalidSpec's start
replace item at index 1 in (target's reinforcements's values) with invalidSpec
set refused to the bim reinforcing schedule of loaded's modelValue
check rebar schedule ((refused's valid = false) and ((the length of (refused's rows's values)) = 0)) named (the string form of "invalid geometry refuses the complete report")
