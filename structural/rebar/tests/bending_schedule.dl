import structural/rebar/bim_bending_schedule.dl
import exchange/ifcx/bim_file.dl

function check bending schedule {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set loaded to the bim model parsed from (the string form of "BIM-SLICE 1\nnext 3\nlevel 1 0 3 Ground\nreinforcement 2 1 -1 1 0 0 0 3 0 0 0.3 0.5 0.016 0.008 0.15 0.15 0.035 0.024 A\n")
check bending schedule loaded's valid named (the string form of "bending fixture loads")
set scheduled to the bim reinforcing schedule of loaded's modelValue
set firstRow to the item at 0 in (scheduled's rows's values)
check bending schedule ((the bim reinforcing mass of firstRow) > 0.0) named (the string form of "nominal mass derives from count diameter and length")
check bending schedule ((the bim bending cell of (the string form of "<A&B>")) = (the string form of "&lt;A&amp;B&gt;")) named (the string form of "model text escaped in HTML")
set htmlText to the bim bending html of loaded's modelValue
check bending schedule ((the length of htmlText) > 1000) named (the string form of "schedule contains shape previews")
check bending schedule (write bim text htmlText to file (the string form of "bending-schedule-preview.html")) named (the string form of "write printable bending schedule")
check bending schedule (write bim text (the bim reinforcing table of loaded's modelValue) to file (the string form of "bending-schedule-preview.tsv")) named (the string form of "write matching tabular quantities")
