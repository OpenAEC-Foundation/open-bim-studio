# SPDX-License-Identifier: MPL-2.0
# Source-only regression coverage; compilation is deliberately deferred.
import model/bim_reinforcement.dl
import formats/bim_file.dl

function check reinforcement library {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set modern to the reinforcement steel named (the string form of "B500B")
check reinforcement library (modern's valid and (modern's nominalYieldMPa = 500.0)) named (the string form of "modern class nominal value")
set historic to the reinforcement steel named (the string form of "QR40")
check reinforcement library (historic's historical and (historic's archivalYieldKgfCm2 = 4000.0)) named (the string form of "historical value retains archival units")
check reinforcement library ((historic's nominalYieldMPa = 0.0) and (historic's ductility = (the string form of "Unverified"))) named (the string form of "no inferred modern resistance or ductility")
check reinforcement library ((the reinforcement steel named (the string form of "B500D"))'s valid = false) named (the string form of "unknown class rejected")
set loaded to the bim model parsed from (the string form of "BIM-SLICE 1\nnext 3\nlevel 1 0 3 Ground\nreinforcement 2 1 -1 1 0 0 0 3 0 0 0.3 0.5 0.016 0.008 0.15 0.15 0.035 0.024 OldCage\n")
check reinforcement library loaded's valid named (the string form of "legacy model loads")
set spec to the item at 0 in (loaded's modelValue's reinforcements's values)
check reinforcement library ((spec's steelKey = (the string form of "UNKNOWN")) and (spec's secondarySteelKey = (the string form of "UNKNOWN"))) named (the string form of "legacy materials remain unassigned")
set spec's steelKey to the string form of "FEB500HWL"
set spec's secondarySteelKey to the string form of "QR24"
set spec to the reinforcement spec applying library preset (the string form of "CAGE_A")
check reinforcement library ((spec's topCount = 3) and (spec's bottomDiameter = 0.016)) named (the string form of "cage preset geometry")
check reinforcement library ((spec's steelKey = (the string form of "FEB500HWL")) and (spec's secondarySteelKey = (the string form of "QR24"))) named (the string form of "preset preserves separate materials")
set target to the address of (loaded's modelValue)
ignore store bim reinforcement spec in target
set saved to the bim file text of loaded's modelValue
set readback to the bim model parsed from saved
check reinforcement library (readback's valid and ((the bim file text of readback's modelValue) = saved)) named (the string form of "library keys round trip exactly")
set invalid to the reinforcement spec applying library preset (the string form of "MESH6_150")
check reinforcement library ((store bim reinforcement invalid in target) = the bim refused id) named (the string form of "wrong preset kind rejected")
set spec's kind to 2
set spec's width to 2.0
set spec to the reinforcement spec applying library preset (the string form of "MESH8_150")
check reinforcement library ((spec's diameter = 0.008) and (spec's farCrossSpacing = 0.15)) named (the string form of "mesh preset updates both faces")
set spec's steelKey to the string form of "INVALID"
check reinforcement library ((the reinforcement issue of spec) != (the string form of "")) named (the string form of "invalid material rejected before geometry")
set first to the item at 0 in (target's reinforcements's values)
set first's cageType to the string form of "A"
ignore store bim reinforcement first in target
set second to first
set second's id to the bim refused id
set second's start's y to 2.0
set second's finish's y to 2.0
ignore store bim reinforcement second in target
set first's steelKey to the string form of "B500B"
ignore store bim reinforcement first in target
check reinforcement library ((the item at 1 in (target's reinforcements's values))'s steelKey = (the string form of "B500B")) named (the string form of "shared type propagates main material")
check reinforcement library ((the item at 1 in (target's reinforcements's values))'s secondarySteelKey = (the string form of "QR24")) named (the string form of "shared type retains distinct stirrup material")
set badReadback to the bim model parsed from (saved with "FEB500HWL" replaced by "UNRECOGNIZED")
check reinforcement library (badReadback's valid = false) named (the string form of "unknown persisted material rejected")
