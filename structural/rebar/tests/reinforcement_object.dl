# SPDX-License-Identifier: MPL-2.0
import ui/editor/bim_editor.dl

function check rebar object {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set editor to a new bim editor
set control to the address of editor
set target to the address of (editor's documentValue's current)
type bim editor key 2201 in control
place bim editor reinforcement at (a cad vector2 with x 0.0 and y 0.0) in control
place bim editor reinforcement at (a cad vector2 with x 3.0 and y 0.0) in control
set cageId to editor's selectionId
set spec to the item at 0 in (target's reinforcements's values)
set beforePaths to the bim reinforcement paths of spec in editor's documentValue's current
set entries to the bim sketch meshes of editor's documentValue's current
check rebar object ((the length of (entries's values)) = 1) named (the string form of "cage has one scene object")
set entry to the item at 0 in (entries's values)
check rebar object (entry's elementId = cageId) named (the string form of "scene identity is the cage identity")
loop sampleIndex from 0 to 2:
    set cornerIndex to 0
    if sampleIndex = 1:
        set cornerIndex to (the length of (entry's shape's triangles's values)) - 3
    set firstPoint to the item at (the item at cornerIndex in (entry's shape's triangles's values)) in (entry's shape's positions's values)
    set secondPoint to the item at (the item at (cornerIndex + 1) in (entry's shape's triangles's values)) in (entry's shape's positions's values)
    set thirdPoint to the item at (the item at (cornerIndex + 2) in (entry's shape's triangles's values)) in (entry's shape's positions's values)
    set middlePoint to (the cad sum of firstPoint and (the cad sum of secondPoint and thirdPoint)) scaled by (1.0 / 3.0)
    set normalValue to the cad cross of (the cad difference of secondPoint and firstPoint) and (the cad difference of thirdPoint and firstPoint)
    set normalValue to normalValue scaled by (1.0 / (the cad length of normalValue))
    set ray to @intrinsic("construct", a bim ray record, (the cad sum of middlePoint and (normalValue scaled by 0.05)), (normalValue scaled by -1.0))
    set picked to the bim pick along ray among (entries's values) in editor's documentValue's current with (editor's spaces's values)
    check rebar object ((picked's kind = 30) and (picked's id = cageId)) named ((the string form of "bar or hoop picks whole cage ") + (the string form of sampleIndex))
check rebar object (the bim selection centre of editor)'s found named (the string form of "cage exposes one transform gizmo")
begin bim editor gizmo drag in control
drag bim editor gizmo by (a cad vector2 with x 5.0 and y 2.0) lifting 0.0 turning 0.0 about (a cad vector2 with x 0.0 and y 0.0) in control
finish bim editor gizmo drag in control
set movedSpec to the item at 0 in (target's reinforcements's values)
set afterPaths to the bim reinforcement paths of movedSpec in editor's documentValue's current
set allMoved to (the length of (beforePaths's bars's values)) = (the length of (afterPaths's bars's values))
loop barIndex from 0 to the length of (beforePaths's bars's values):
    set beforeBar to the item at barIndex in (beforePaths's bars's values)
    set afterBar to the item at barIndex in (afterPaths's bars's values)
    loop pointIndex from 0 to the length of (beforeBar's points's values):
        set expected to the cad sum of (the item at pointIndex in (beforeBar's points's values)) and (a cad vector3 with x 5.0, y 2.0 and z 0.0)
        if (the cad distance from expected to (the item at pointIndex in (afterBar's points's values))) > 1e-9:
            set allMoved to false
check rebar object allMoved named (the string form of "all cage bars and hoops move together")
check rebar object ((movedSpec's id = cageId) and ((the length of (target's reinforcements's values)) = 1)) named (the string form of "moving preserves single object identity")
ignore undo bim transaction in (the address of (editor's documentValue))
set restored to the item at 0 in (target's reinforcements's values)
check rebar object ((the cad distance from restored's start to spec's start) < 1e-9) named (the string form of "one undo restores whole cage")

# Sentinels stand in for already evaluated solids: a zoom must retain them,
# including drilled members, rather than invoking expensive boolean geometry.
set zero to a cad vector3 with x 0.0, y 0.0 and z 0.0
set typeId to add bim linear type named (the string form of "Steel") as role bim beam role sized 0.2 by 0.4 round false of (the string form of "steel") to target
set firstId to add bim linear typed typeId on editor's levelId from zero to (a cad vector3 with x 3.0, y 0.0 and z 0.0) turned 0.0 to target
set secondId to add bim linear typed typeId on editor's levelId from zero to (a cad vector3 with x 0.0, y 3.0 and z 0.0) turned 0.0 to target
set identities to an empty list of a 64 bit integer
append firstId to identities
append secondId to identities
set nodeId to add bim connection among identities category 1 style 0 in target
ignore add bim connection part of kind 0 to node nodeId in target
ignore add bim connection part of kind 2 to node nodeId in target
append nodeId to identities
append cageId to identities
set cached to an empty list of a bim scene mesh record
set sentinel to an empty fast mesh
append (a cad vector3 with x 123.0, y 456.0 and z 789.0) to (sentinel's positions's values)
loop idIndex from 0 to the length of identities:
    append (@intrinsic("construct", a bim scene mesh record, the item at idIndex in identities, 0 as a 64 bit integer, sentinel, bim other category, zero, the string form of "")) to cached
set retained to true
set fineTolerance to 1.0
loop zoomIndex from 0 to 18:
    set fineTolerance to fineTolerance * 0.5
    set zoomed to the bim sketch meshes of editor's documentValue's current within fineTolerance reusing cached
    if (the length of (zoomed's values)) != 4:
        set retained to false
    loop meshIndex from 0 to the length of (zoomed's values):
        set shapeValue to (the item at meshIndex in (zoomed's values))'s shape
        if (the length of (shapeValue's positions's values)) != 1:
            set retained to false
        else if (the item at 0 in (shapeValue's positions's values))'s x != 123.0:
            set retained to false
check rebar object retained named (the string form of "18 zoom levels reuse cage node and drilled member geometry")
free identities
free cached
