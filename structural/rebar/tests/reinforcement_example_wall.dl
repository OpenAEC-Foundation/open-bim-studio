# SPDX-License-Identifier: MPL-2.0
import structural/rebar/tests/support/reinforcement_fixture.dl

set modelValue to the reinforcement fixture named (the string form of "reinforcement-wall-opening.bim") counting 8
check reinforcement fixture (((the length of (modelValue's walls's values)) = 1) and ((the length of (modelValue's openings's values)) = 1)) named (the string form of "wall and opening load")
set clearOpening to true
loop index from 0 to the length of (modelValue's reinforcements's values):
    set spec to the item at index in (modelValue's reinforcements's values)
    # Every fixture bar is straight. Its entire segment must lie outside one
    # aperture boundary, including its radius; endpoint-only checks would miss crossings.
    set radius to spec's diameter * 0.5
    set below to ((spec's start's z + radius) < 1.0) and ((spec's finish's z + radius) < 1.0)
    set above to ((spec's start's z - radius) > 2.0) and ((spec's finish's z - radius) > 2.0)
    set leftSide to ((spec's start's x + radius) < 1.5) and ((spec's finish's x + radius) < 1.5)
    set rightSide to ((spec's start's x - radius) > 2.5) and ((spec's finish's x - radius) > 2.5)
    if (spec's kind != 0) or (((below or above) or (leftSide or rightSide)) = false):
        set clearOpening to false
check reinforcement fixture clearOpening named (the string form of "all eight edge bars clear the opening")
set area to the item at 0 in (modelValue's reinforcements's values)
set area's kind to 5
set area's hostId to 10 as a 64 bit integer
set refused to the reinforcement of (the bim hostbound reinforcement area in modelValue)
check reinforcement fixture (refused's valid = false) named (the string form of "automatic area reinforcement refuses perforated wall")
