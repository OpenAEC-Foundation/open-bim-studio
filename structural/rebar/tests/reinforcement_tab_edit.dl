# SPDX-License-Identifier: MPL-2.0
# Tab on reinforcement (bim_editor_core.dl). A free bar enters edit mode
# with its axis's two ends as points; moving an end is one edit, undone and
# redone; an axis of no length is refused, also as a grab (G), which then
# leaves no edit and no undo step, while a grab that moves it is kept. A cage on a beam has no points of
# its own and its ends are refused: Tab selects the beam and edits the
# beam's geometry, saying so, and the cage follows the lengthened beam,
# still hosted.
import ui/editor/bim_editor.dl

function the rebar end position of {a 64 bit integer:rebarId} in {bim editor record:editor}:
    execute:
        set rebarFound to the bim reinforcement index of rebarId in editor's documentValue's current
        return (the item at rebarFound's position in (editor's documentValue's current's reinforcements's values))'s finish's x

function the rebar ends from {cad vector3:fromSpot} to {cad vector3:toSpot}:
    execute:
        set endList to an empty list of a cad vector3
        append fromSpot to endList
        append toSpot to endList
        return endList

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set levelId to editor's levelId
begin bim transaction in (the address of (editor's documentValue))
set freeSpec to @intrinsic("construct", a reinforcement definition, the bim refused id, levelId, the bim refused id, 0, the string form of "R-FREE", (a cad vector3 with x 0.0, y 0.0 and z 0.5), (a cad vector3 with x 3.0, y 0.0 and z 0.5), 0.3, 0.5, 0.016, 0.008, 0.15, 0.15, 0.035, 0.024, 2, 2, 0.016, 0.016, the string form of "-", 0.0, 0.1, 0.0, 0.1, 0, 0.012, 0, 0.016, 0.3, 1.0, 0, 1, 0.012, 0.012, 0.15, 0.15, 0.0, the string form of "Custom", the string form of "B500B", the string form of "B500B")
set freeId to store bim reinforcement freeSpec in target
set beamType to add bim linear type named (the string form of "Balk 300x500") as role bim beam role sized 0.3 by 0.5 round false of (the string form of "concrete") to target
set beamId to add bim linear typed beamType on levelId from (a cad vector3 with x 0.0, y 2.0 and z 2.75) to (a cad vector3 with x 4.0, y 2.0 and z 2.75) turned 0.0 to target
set cageSpec to freeSpec
set cageSpec's kind to 1
set cageSpec's mark to the string form of "K-1"
set cageSpec's hostId to beamId
set cageSpec's start to a cad vector3 with x 0.0, y 2.0 and z 2.75
set cageSpec's finish to a cad vector3 with x 4.0, y 2.0 and z 2.75
set cageId to store bim reinforcement cageSpec in target
commit bim transaction in (the address of (editor's documentValue))
print ((the string form of "stored: ") + (the string form of ((freeId != the bim refused id) and (cageId != the bim refused id)))) as a line

# Tab on the free bar: its two ends.
select bim editor (bim reinforcement picked) numbered freeId in e
set editor's tool to 30
set editor's moveStage to 1
type bim editor key 258 in e
print ((the string form of "placement stopped: ") + (the string form of ((editor's tool = bim select tool) and (editor's moveStage = 0)))) as a line
set freePoints to the bim handles of (bim reinforcement picked) numbered freeId in editor's documentValue's current
print ((the string form of "free bar: edit mode ") + ((the string form of editor's editMode) + ((the string form of ", points ") + (the string form of (the length of (freePoints's values)))))) as a line
print editor's message as a line
begin bim transaction in (the address of (editor's documentValue))
set movedEnds to the rebar ends from (a cad vector3 with x 0.0, y 0.0 and z 0.5) to (a cad vector3 with x 5.0, y 0.0 and z 0.5)
print ((the string form of "end moved: ") + (the string form of (set bim handles of (bim reinforcement picked) numbered freeId to movedEnds in target))) as a line
free movedEnds
commit bim transaction in (the address of (editor's documentValue))
print ((the string form of "finish x: ") + (the string form of (the rebar end position of freeId in editor))) as a line
begin bim transaction in (the address of (editor's documentValue))
set collapsedEnds to the rebar ends from (a cad vector3 with x 0.0, y 0.0 and z 0.5) to (a cad vector3 with x 0.0, y 0.0 and z 0.5)
print ((the string form of "no length refused: ") + (the string form of ((set bim handles of (bim reinforcement picked) numbered freeId to collapsedEnds in target) = false))) as a line
free collapsedEnds
roll back bim transaction in (the address of (editor's documentValue))
print ((the string form of "finish x kept: ") + (the string form of (the rebar end position of freeId in editor))) as a line
ignore undo bim transaction in (the address of (editor's documentValue))
print ((the string form of "after undo: ") + (the string form of (the rebar end position of freeId in editor))) as a line
ignore redo bim transaction in (the address of (editor's documentValue))
print ((the string form of "after redo: ") + (the string form of (the rebar end position of freeId in editor))) as a line
# A grab (G) of the finish onto the start: refused and rolled back, no undo
# step; a grab of 1 m along: kept, one undo step.
set undoBefore to the length of (editor's documentValue's undoStack's values)
set editor's editPicked to a cad topology list of an integer
append 1 to (editor's editPicked's values)
start bim editor grab in e
set editor's pointerLocation to a cad vector2 with x -5.0 and y 0.0
apply bim editor grab by (a cad vector2 with x -5.0 and y 0.0) lifting 0.0 in e
finish bim editor grab in e
print editor's message as a line
print ((the string form of "after refused grab: ") + ((the string form of (the rebar end position of freeId in editor)) + ((the string form of ", undo steps added ") + (the string form of ((the length of (editor's documentValue's undoStack's values)) - undoBefore))))) as a line
start bim editor grab in e
finish bim editor grab in e
print editor's message as a line
start bim editor grab in e
set editor's pointerLocation to a cad vector2 with x 1.0 and y 0.0
apply bim editor grab by (a cad vector2 with x 1.0 and y 0.0) lifting 0.0 in e
finish bim editor grab in e
print editor's message as a line
print ((the string form of "after grab: ") + ((the string form of (the rebar end position of freeId in editor)) + ((the string form of ", undo steps added ") + (the string form of ((the length of (editor's documentValue's undoStack's values)) - undoBefore))))) as a line
type bim editor key 258 in e
print ((the string form of "Tab leaves: ") + (the string form of (editor's editMode = false))) as a line

# Tab on the cage: the beam's geometry, the cage following.
select bim editor (bim reinforcement picked) numbered cageId in e
set cagePoints to the bim handles of (bim reinforcement picked) numbered cageId in editor's documentValue's current
print ((the string form of "cage points: ") + (the string form of (the length of (cagePoints's values)))) as a line
begin bim transaction in (the address of (editor's documentValue))
set cageEnds to the rebar ends from (a cad vector3 with x 0.0, y 2.0 and z 2.75) to (a cad vector3 with x 1.0, y 2.0 and z 2.75)
print ((the string form of "cage ends refused: ") + (the string form of ((set bim handles of (bim reinforcement picked) numbered cageId to cageEnds in target) = false))) as a line
free cageEnds
roll back bim transaction in (the address of (editor's documentValue))
type bim editor key 258 in e
print ((the string form of "host selected: ") + ((the string form of ((editor's selectionKind = bim linear picked) and (editor's selectionId = beamId))) + ((the string form of ", edit mode ") + (the string form of editor's editMode)))) as a line
print editor's message as a line
begin bim transaction in (the address of (editor's documentValue))
set beamEnds to the rebar ends from (a cad vector3 with x 0.0, y 2.0 and z 2.75) to (a cad vector3 with x 6.0, y 2.0 and z 2.75)
print ((the string form of "beam lengthened: ") + (the string form of (set bim handles of (bim linear picked) numbered beamId to beamEnds in target))) as a line
free beamEnds
commit bim transaction in (the address of (editor's documentValue))
set cageFound to the bim reinforcement index of cageId in editor's documentValue's current
set cageNow to the item at cageFound's position in (editor's documentValue's current's reinforcements's values)
set generated to the bim reinforcement paths of cageNow in editor's documentValue's current
set farthest to 0.0
loop barCursor from 0 to the length of (generated's bars's values):
    set barValue to the item at barCursor in (generated's bars's values)
    loop pointCursor from 0 to the length of (barValue's points's values):
        set farthest to the maximum of farthest and ((the item at pointCursor in (barValue's points's values))'s x)
print ((the string form of "cage follows the beam: ") + ((the string form of (farthest > 5.0)) + ((the string form of ", still hosted ") + (the string form of (cageNow's hostId = beamId))))) as a line
