# SPDX-License-Identifier: MPL-2.0
import formats/bim_file.dl
import model/bim_reinforcement_schedule.dl

function check reinforcement fixture {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the reinforcement fixture named {a string:filename} counting {an integer:expectedCount}:
    execute:
        set content to the bim file content at ((the string form of "tests/models/") + filename)
        check reinforcement fixture content's valid named (the string form of "example file opens")
        set parsed to the bim model parsed from content's text
        check reinforcement fixture parsed's valid named (the string form of "example model loads")
        set modelValue to parsed's modelValue
        check reinforcement fixture ((the length of (modelValue's reinforcements's values)) = expectedCount) named (the string form of "reinforcement object count")
        check reinforcement fixture ((the length of (modelValue's tags's values)) = expectedCount) named (the string form of "each reinforcement object has a tag")
        set barCount to 0
        set barLength to 0.0
        set allValid to true
        loop index from 0 to the length of (modelValue's reinforcements's values):
            set spec to the item at index in (modelValue's reinforcements's values)
            set generated to the bim reinforcement paths of spec in modelValue
            if (generated's valid = false) or ((the length of (generated's bars's values)) = 0):
                set allValid to false
            set barCount to barCount + (the length of (generated's bars's values))
            set barLength to barLength + (the reinforcement total length of generated)
        check reinforcement fixture allValid named (the string form of "every object generates bars")
        set scheduled to the bim reinforcing schedule of modelValue
        check reinforcement fixture scheduled's valid named (the string form of "schedule accepts example")
        set scheduledCount to 0
        set scheduledLength to 0.0
        loop index from 0 to the length of (scheduled's rows's values):
            set rowValue to the item at index in (scheduled's rows's values)
            set scheduledCount to scheduledCount + rowValue's count
            set scheduledLength to scheduledLength + (the bim reinforcing total length of rowValue)
        check reinforcement fixture (scheduledCount = barCount) named (the string form of "schedule counts every generated bar")
        check reinforcement fixture ((the absolute value of (scheduledLength - barLength)) < 0.000001) named (the string form of "schedule conserves total bar length")
        set saved to the bim file text of modelValue
        set readback to the bim model parsed from saved
        check reinforcement fixture readback's valid named (the string form of "saved example reopens")
        check reinforcement fixture ((the bim file text of readback's modelValue) = saved) named (the string form of "canonical persistence is stable")
        return modelValue
