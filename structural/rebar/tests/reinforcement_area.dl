# SPDX-License-Identifier: MPL-2.0
import structural/rebar/reinforcement.dl

function require reinforcement test {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set spec to @intrinsic("construct", a reinforcement definition, 1 as a 64 bit integer, 2 as a 64 bit integer, (-1) as a 64 bit integer, 0, the string form of "B01", (a cad vector3 with x 0.0, y 0.0 and z 0.0), (a cad vector3 with x 3.0, y 0.0 and z 0.0), 0.3, 0.5, 0.016, 0.008, 0.15, 0.15, 0.035, 0.024, 2, 2, 0.016, 0.016, the string form of "-", 0.0, 0.1, 0.0, 0.1, 0, 0.012, 0, 0.016, 0.3, 1.0, 0, 1, 0.012, 0.012, 0.15, 0.15, 0.0, the string form of "Custom", the string form of "UNKNOWN", the string form of "UNKNOWN")
set spec's kind to 5
set spec's width to 2.0
set spec's depth to 0.2
set spec's faceMask to 3
set spec's diameter to 0.01
set spec's secondaryDiameter to 0.012
set spec's farDiameter to 0.014
set spec's farSecondaryDiameter to 0.016
set spec's farSpacing to 0.2
set spec's farCrossSpacing to 0.25
set made to the reinforcement of spec
require reinforcement test made's valid named (the string form of "area produces both faces")
set sizesCorrect to true
set sizesSeen to 0
loop barIndex from 0 to the length of (made's bars's values):
    set barValue to the item at barIndex in (made's bars's values)
    set pointValue to the item at 0 in (barValue's points's values)
    if (pointValue's z < spec's cover) or (pointValue's z > (spec's depth - spec's cover)):
        set sizesCorrect to false
    if barValue's diameter = 0.01:
        set sizesSeen to sizesSeen + 1
    if ((barValue's diameter = 0.014) or (barValue's diameter = 0.016)) and (pointValue's z < 0.1):
        set sizesCorrect to false
require reinforcement test (sizesCorrect and (sizesSeen > 0)) named (the string form of "four independent layer diameters respect face cover")
set spec's areaMode to 1
set spec's curveRadius to 4.0
set made to the reinforcement of spec
set followsCurve to made's valid
set sampledCurve to false
loop barIndex from 0 to the length of (made's bars's values):
    set barValue to the item at barIndex in (made's bars's values)
    if (the length of (barValue's points's values)) > 2:
        set sampledCurve to true
    set firstPoint to the item at 0 in (barValue's points's values)
    set expectedRadius to the square root of ((firstPoint's x * firstPoint's x) + ((firstPoint's y - 4.0) * (firstPoint's y - 4.0)))
    loop pointIndex from 0 to the length of (barValue's points's values):
        set pointValue to the item at pointIndex in (barValue's points's values)
        set radiusValue to the square root of ((pointValue's x * pointValue's x) + ((pointValue's y - 4.0) * (pointValue's y - 4.0)))
        if (the absolute value of (radiusValue - expectedRadius)) > 1e-10:
            set followsCurve to false
require reinforcement test (followsCurve and sampledCurve) named (the string form of "front and back bars follow cylindrical wall surface")
set spec's faceMask to 2
set farOnly to the reinforcement of spec
require reinforcement test ((the length of (farOnly's bars's values)) < (the length of (made's bars's values))) named (the string form of "individual face can be disabled")
set spec's kind to 2
set spec's meshType to the string form of "Q188"
set meshLabel to the reinforcement annotation of spec
require reinforcement test ((the substring of meshLabel from 0 spanning 9 bytes) = (the string form of "Mesh Q188")) named (the string form of "mesh retains distinct type notation")
set spec's curveRadius to 0.1
require reinforcement test ((the reinforcement of spec)'s valid = false) named (the string form of "self-intersecting curved thickness refused")
set spec's kind to 5
set spec's width to 100.0
set spec's finish to a cad vector3 with x 100.0, y 0.0 and z 0.0
set spec's curveRadius to 40.0
require reinforcement test ((the reinforcement of spec)'s valid = false) named (the string form of "dense curved region is refused before excessive allocation")
