# SPDX-License-Identifier: MPL-2.0
import structural/rebar/tests/support/reinforcement_fixture.dl

set modelValue to the reinforcement fixture named (the string form of "reinforcement-beam.bim") counting 1
set cage to the item at 0 in (modelValue's reinforcements's values)
check reinforcement fixture (((cage's topCount = 3) and (cage's topDiameter = 0.012)) and ((cage's bottomCount = 3) and (cage's bottomDiameter = 0.016))) named (the string form of "beam retains asymmetric longitudinal layers")
check reinforcement fixture ((cage's extraTopCount = 2) and ((cage's startZoneLength = 0.8) and (cage's endZoneLength = 0.8))) named (the string form of "beam retains extra bars and end stirrup zones")
set scheduled to the bim reinforcing schedule of modelValue
check reinforcement fixture ((the length of (scheduled's rows's values)) = 4) named (the string form of "beam schedules four bar families")
