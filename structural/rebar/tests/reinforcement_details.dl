# SPDX-License-Identifier: MPL-2.0
import structural/rebar/bim_reinforcement.dl
import exchange/ifcx/bim_file.dl

function check reinforcement integration {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set documentValue to a new bim document
set target to the address of (documentValue's current)
set levelId to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set spec to @intrinsic("construct", a reinforcement definition, the bim refused id, levelId, the bim refused id, 1, the string form of "A1", (a cad vector3 with x 0.0, y 0.0 and z 0.0), (a cad vector3 with x 3.0, y 0.0 and z 0.0), 0.3, 0.5, 0.016, 0.008, 0.15, 0.15, 0.035, 0.024, 2, 2, 0.016, 0.016, the string form of "-", 0.0, 0.1, 0.0, 0.1, 0, 0.012, 0, 0.016, 0.3, 1.0, 0, 1, 0.012, 0.012, 0.15, 0.15, 0.0, the string form of "Custom", the string form of "UNKNOWN", the string form of "UNKNOWN")
set spec's cageType to the string form of "A"
set spec's topCount to 3
set spec's bottomCount to 3
set spec's topDiameter to 0.012
set firstId to store bim reinforcement spec in target
set spec's start's y to 2.0
set spec's mark to the string form of "A2"
set spec's finish's y to 2.0
set spec's extraTopCount to 2
set spec's startZoneLength to 0.6
set secondId to store bim reinforcement spec in target
set edited to the item at 0 in (target's reinforcements's values)
set edited's topDiameter to 0.014
begin bim transaction in (the address of documentValue)
ignore store bim reinforcement edited in target
commit bim transaction in (the address of documentValue)
set sibling to the item at 1 in (target's reinforcements's values)
check reinforcement integration (sibling's topDiameter = 0.014) named (the string form of "shared type edit updates every placement")
check reinforcement integration ((sibling's extraTopCount = 2) and (sibling's startZoneLength = 0.6)) named (the string form of "type edit preserves local additions and stirrup zones")
ignore undo bim transaction in (the address of documentValue)
check reinforcement integration ((the item at 1 in (target's reinforcements's values))'s topDiameter = 0.012) named (the string form of "one undo restores all type placements")
set saved to the bim file text of documentValue's current
set readback to the bim model parsed from saved
check reinforcement integration (readback's valid and ((the bim file text of readback's modelValue) = saved)) named (the string form of "type and local details round trip exactly")
set legacy to the bim model parsed from (the string form of "BIM-SLICE 1\nnext 3\nlevel 1 0 3 Ground\nreinforcement 2 1 -1 1 0 0 0 3 0 0 0.3 0.5 0.020 0.008 0.15 0.15 0.035 0.024 Legacy\n")
check reinforcement integration legacy's valid named (the string form of "legacy cage record remains readable")
set legacySpec to the item at 0 in (legacy's modelValue's reinforcements's values)
check reinforcement integration ((legacySpec's topCount = 2) and (legacySpec's topDiameter = 0.020)) named (the string form of "legacy cage retains four bars and original diameter")
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.3)) to layers
set wallType to add bim wall type named (the string form of "Concrete") with layers to target
free layers
set wallId to add bim wall typed wallType on levelId from (a cad vector2 with x 0.0 and y 5.0) to (a cad vector2 with x 4.0 and y 5.0) to target
ignore bend bim wall wallId by 0.5 in target
set spec's id to the bim refused id
set spec's kind to 5
set spec's mark to the string form of "WallArea"
set spec's hostId to wallId
set spec's diameter to 0.012
set spec's secondaryDiameter to 0.012
set spec's faceMask to 3
set spec to the bim hostbound reinforcement spec in documentValue's current
set areaId to store bim reinforcement spec in target
check reinforcement integration (areaId != the bim refused id) named (the string form of "area attaches to curved wall")
set made to the bim reinforcement paths of spec in documentValue's current
check reinforcement integration (made's valid and (spec's curveRadius != 0.0)) named (the string form of "host wall curvature generates both reinforcement faces")
set saved to the bim file text of documentValue's current
set readback to the bim model parsed from saved
check reinforcement integration readback's valid named (the string form of "hosted area persistence accepts wall reference")
ignore add bim tag of areaId at (a cad vector2 with x 0.0 and y 4.0) to target
begin bim transaction in (the address of documentValue)
ignore delete bim wall wallId from target
commit bim transaction in (the address of documentValue)
check reinforcement integration ((the bim reinforcement index of areaId in documentValue's current)'s valid = false) named (the string form of "host deletion removes area object")
check reinforcement integration (the bim model parsed from (the bim file text of documentValue's current))'s valid named (the string form of "host deletion leaves no dangling reinforcement tags")
ignore undo bim transaction in (the address of documentValue)
check reinforcement integration (the bim reinforcement index of areaId in documentValue's current)'s valid named (the string form of "undo restores wall and area together")
set corners to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 8.0) to corners
append (a cad vector2 with x 4.0 and y 8.0) to corners
append (a cad vector2 with x 4.0 and y 11.0) to corners
append (a cad vector2 with x 0.0 and y 11.0) to corners
set slabId to add bim slab on levelId around corners thick 0.25 to target
free corners
set spec's hostId to slabId
set spec's mark to the string form of "FloorArea"
set spec to the bim hostbound reinforcement spec in documentValue's current
set slabAreaId to store bim reinforcement spec in target
check reinforcement integration ((slabAreaId != the bim refused id) and ((spec's width = 3.0) and (spec's depth = 0.25))) named (the string form of "area derives floor envelope and thickness")
# The review fixture includes A/B/C, local details, floor/wall areas and a net.
set reviewCage to the item at 0 in (target's reinforcements's values)
set reviewCage's id to the bim refused id
set reviewCage's cageType to the string form of "B"
set reviewCage's mark to the string form of "B1"
set reviewCage's topCount to 4
set reviewCage's bottomCount to 4
set reviewCage's start's y to -2.0
set reviewCage's finish's y to -2.0
ignore store bim reinforcement reviewCage in target
set reviewCage's cageType to the string form of "C"
set reviewCage's mark to the string form of "C1"
set reviewCage's topCount to 2
set reviewCage's bottomCount to 3
set reviewCage's start's y to -4.0
set reviewCage's finish's y to -4.0
ignore store bim reinforcement reviewCage in target
set spec's hostId to the bim refused id
set spec's start to a cad vector3 with x 5.0, y 3.0 and z 0.0
set spec's finish to a cad vector3 with x 8.0, y 3.0 and z 0.0
set spec's width to 2.0
set spec's depth to 0.2
set spec's curveRadius to 4.0
set spec's mark to the string form of "CurvedFloor"
ignore store bim reinforcement spec in target
set spec's kind to 2
set spec's faceMask to 1
set spec's curveRadius to 0.0
set spec's mark to the string form of "Net1"
set spec's start's y to 8.0
set spec's finish's y to 8.0
ignore store bim reinforcement spec in target
loop detailIndex from 0 to the length of (target's reinforcements's values):
    set detailSpec to the item at detailIndex in (target's reinforcements's values)
    if detailSpec's id != areaId:
        ignore add bim tag of detailSpec's id at (a cad vector2 with x detailSpec's start's x and y (detailSpec's start's y - 0.5)) to target
set reviewText to the bim file text of documentValue's current
check reinforcement integration (the bim model parsed from reviewText)'s valid named (the string form of "complete review fixture reopens")
check reinforcement integration (write bim text (the bim file text of documentValue's current) to file (the string form of "../reinforcement-details.bim")) named (the string form of "write integrated reinforcement review model")
