# SPDX-License-Identifier: MPL-2.0
import structural/rebar/reinforcement.dl

function require reinforcement test {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set spec to @intrinsic("construct", a reinforcement definition, 1 as a 64 bit integer, 2 as a 64 bit integer, (-1) as a 64 bit integer, 0, the string form of "B01", (a cad vector3 with x 0.0, y 0.0 and z 0.0), (a cad vector3 with x 3.0, y 0.0 and z 0.0), 0.3, 0.5, 0.016, 0.008, 0.15, 0.15, 0.035, 0.024, 2, 2, 0.016, 0.016, the string form of "-", 0.0, 0.1, 0.0, 0.1, 0, 0.012, 0, 0.016, 0.3, 1.0, 0, 1, 0.012, 0.012, 0.15, 0.15, 0.0, the string form of "Custom", the string form of "UNKNOWN", the string form of "UNKNOWN")
set made to the reinforcement of spec
require reinforcement test (made's valid and ((the reinforcement total length of made) = 3.0)) named (the string form of "straight bar analytical length")
set spec's kind to 1
set made to the reinforcement of spec
require reinforcement test (made's valid and ((the length of (made's bars's values)) = 25)) named (the string form of "cage four bars and 21 hoops")
set hoop to the item at 4 in (made's bars's values)
set exactPerimeter to (4.0 * ((0.111 + 0.211) - 0.048)) + ((2.0 * 3.141592653589793) * 0.024)
require reinforcement test ((the absolute value of (hoop's length - exactPerimeter)) < 1e-12) named (the string form of "hoop length uses exact bends")
require reinforcement test ((the cad distance from (the item at 0 in (hoop's points's values)) to (the item at 36 in (hoop's points's values))) < 1e-12) named (the string form of "hoop path closes")
set spec's spacing to 0.0
require reinforcement test ((the reinforcement of spec)'s valid = false) named (the string form of "zero spacing refused")
set spec's spacing to 0.15
set spec's cover to 0.2
require reinforcement test ((the reinforcement of spec)'s valid = false) named (the string form of "impossible cover refused")
set spec's cover to 0.035
set spec's kind to 2
set spec's width to 2.0
set made to the reinforcement of spec
require reinforcement test (made's valid and ((the length of (made's bars's values)) = 35)) named (the string form of "mesh boundary bars in both directions")
set spec's finish to a cad vector3 with x 0.0, y 0.0 and z 3.0
set made to the reinforcement of spec
require reinforcement test made's valid named (the string form of "vertical frame supported")
set spec's finish to spec's start
require reinforcement test ((the reinforcement of spec)'s valid = false) named (the string form of "zero axis refused")
set spec's finish to a cad vector3 with x 3.0, y 0.0 and z 0.0
set spec's width to 0.6
set spec's kind to 3
set made to the reinforcement of spec
set expectedLength to (3.6 - (2.0 * spec's bendRadius)) + (1.570796326794897 * spec's bendRadius)
require reinforcement test (made's valid and ((the absolute value of ((the reinforcement total length of made) - expectedLength)) < 1e-12)) named (the string form of "L bar exact tangent and arc length")
set spec's kind to 4
set made to the reinforcement of spec
set expectedLength to (6.6 - (4.0 * spec's bendRadius)) + (3.141592653589793 * spec's bendRadius)
require reinforcement test (made's valid and ((the absolute value of ((the reinforcement total length of made) - expectedLength)) < 1e-12)) named (the string form of "U bar two exact bends")
set spec's width to 0.02
require reinforcement test ((the reinforcement of spec)'s valid = false) named (the string form of "overlapping bends refused")
set spec's kind to 0
set spec's diameter to 0.0065
require reinforcement test ((the reinforcement annotation of spec) = (the string form of "B01 / D6.5")) named (the string form of "notation preserves fractional millimetres")
set spec's kind to 1
set spec's width to 0.3
set spec's diameter to 0.016
set spec's topCount to 3
set spec's bottomCount to 3
set spec's topDiameter to 0.012
set spec's bottomDiameter to 0.016
set made to the reinforcement of spec
require reinforcement test (made's valid and ((the length of (made's bars's values)) = 27)) named (the string form of "parametric cage six bars and 21 hoops")
set layerCorrect to true
loop barIndex from 0 to 6:
    set barValue to the item at barIndex in (made's bars's values)
    set pointValue to the item at 0 in (barValue's points's values)
    if barIndex < 3:
        if (barValue's diameter != 0.012) or (pointValue's z <= 0.0):
            set layerCorrect to false
    else:
        if (barValue's diameter != 0.016) or (pointValue's z >= 0.0):
            set layerCorrect to false
require reinforcement test layerCorrect named (the string form of "three D12 above and three D16 below")
set spec's startZoneLength to 0.6
set spec's endZoneLength to 0.6
set spec's startZoneSpacing to 0.075
set spec's endZoneSpacing to 0.075
set spec's extraTopCount to 2
set spec's extraFrom to 0.1
set spec's extraTo to 1.0
set made to the reinforcement of spec
require reinforcement test made's valid named (the string form of "local added bars and end stirrup zones")
set extraBar to the item at 6 in (made's bars's values)
require reinforcement test ((the absolute value of (extraBar's length - 0.9)) < 1e-12) named (the string form of "additional bars respect local range")
set lastStation to -1.0
set stationsValid to true
loop hoopIndex from 8 to the length of (made's bars's values):
    set hoopValue to the item at hoopIndex in (made's bars's values)
    set stationValue to (the item at 0 in (hoopValue's points's values))'s x
    if stationValue <= lastStation:
        set stationsValid to false
    if lastStation >= 0.0:
        set allowedGap to 0.150001
        if (stationValue <= 0.639001) or (lastStation >= 2.360999):
            set allowedGap to 0.075001
        if (stationValue - lastStation) > allowedGap:
            set stationsValid to false
    set lastStation to stationValue
require reinforcement test stationsValid named (the string form of "stirrup zones have bounded spacing and no duplicate boundary hoops")
set spec's topCount to 100
require reinforcement test ((the reinforcement of spec)'s valid = false) named (the string form of "overlapping layer bars refused")
