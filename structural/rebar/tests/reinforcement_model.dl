# SPDX-License-Identifier: MPL-2.0
import model/bim_reinforcement.dl
import formats/bim_file.dl

function check reinforcement integration {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set documentValue to a new bim document
set target to the address of (documentValue's current)
set levelId to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set spec to @intrinsic("construct", a reinforcement definition, the bim refused id, levelId, the bim refused id, 1, the string form of "K01", (a cad vector3 with x 0.0, y 0.0 and z 0.0), (a cad vector3 with x 3.0, y 0.0 and z 0.0), 0.3, 0.5, 0.016, 0.008, 0.15, 0.15, 0.035, 0.024, 2, 2, 0.016, 0.016, the string form of "-", 0.0, 0.1, 0.0, 0.1, 0, 0.012, 0, 0.016, 0.3, 1.0, 0, 1, 0.012, 0.012, 0.15, 0.15, 0.0, the string form of "Custom", the string form of "UNKNOWN", the string form of "UNKNOWN")
begin bim transaction in (the address of documentValue)
set elementId to store bim reinforcement spec in target
commit bim transaction in (the address of documentValue)
check reinforcement integration (elementId != the bim refused id) named (the string form of "store cage")
set saved to the bim file text of documentValue's current
set readback to the bim model parsed from saved
check reinforcement integration readback's valid named (the string form of "native file parses")
check reinforcement integration ((the bim file text of readback's modelValue) = saved) named (the string form of "exact parameter round trip")
ignore undo bim transaction in (the address of documentValue)
check reinforcement integration ((the length of (documentValue's current's reinforcements's values)) = 0) named (the string form of "undo removes cage")
ignore redo bim transaction in (the address of documentValue)
check reinforcement integration ((the length of (documentValue's current's reinforcements's values)) = 1) named (the string form of "redo restores cage")
set retrieved to the item at 0 in (documentValue's current's reinforcements's values)
check reinforcement integration (retrieved's id = elementId) named (the string form of "stable identity")
check reinforcement integration ((the reinforcement annotation of retrieved) = (the string form of "K01 / 2D16 top + 2D16 bottom + D8 @ max 150")) named (the string form of "associative notation")
set tagId to add bim tag of elementId at (a cad vector2 with x 1.0 and y 1.0) to target
set taggedText to the bim file text of documentValue's current
set taggedReadback to the bim model parsed from taggedText
check reinforcement integration (taggedReadback's valid and (tagId != the bim refused id)) named (the string form of "reinforcement tag round trip")
set typeId to add bim linear type named (the string form of "Host") as role bim beam role sized 0.3 by 0.5 round false of (the string form of "concrete") to target
set hostId to add bim linear typed typeId on levelId from spec's start to spec's finish turned 1.570796326794897 to target
set spec's hostId to hostId
set before to the reinforcement of spec
set after to the bim reinforcement paths of spec in documentValue's current
set beforePoint to the item at 0 in ((the item at 0 in (before's bars's values))'s points's values)
set afterPoint to the item at 0 in ((the item at 0 in (after's bars's values))'s points's values)
check reinforcement integration ((the absolute value of (afterPoint's y + beforePoint's z)) < 1e-12) named (the string form of "host roll rotates cage section")
