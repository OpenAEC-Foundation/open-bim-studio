# SPDX-License-Identifier: MPL-2.0
# Unicode scalar decoding shared by catalogues and the native text renderer.
import lib/string.dl

class:
    patterns:
        [a|] bim unicode step record
    members:
        valid as a boolean
        codepoint as an integer
        size as an integer

function the bim unicode step of {a string:message} at {integer:position}:
    execute:
        set refused to @intrinsic("construct", a bim unicode step record, false, 65533, 1)
        if (position < 0) or (position >= (the length of message)):
            return @intrinsic("construct", a bim unicode step record, false, 65533, 0)
        set lead to (((the character at position in message) as an integer) bitwise and 255)
        if lead < 128:
            return @intrinsic("construct", a bim unicode step record, true, lead, 1)
        set size to 0
        set codepoint to 0
        set minimum to 0
        if (lead >= 194) and (lead <= 223):
            set size to 2
            set codepoint to lead - 192
            set minimum to 128
        else if (lead >= 224) and (lead <= 239):
            set size to 3
            set codepoint to lead - 224
            set minimum to 2048
        else if (lead >= 240) and (lead <= 244):
            set size to 4
            set codepoint to lead - 240
            set minimum to 65536
        if (size = 0) or ((position + size) > (the length of message)):
            return refused
        loop cursor from 1 to size:
            set octet to (((the character at (position + cursor) in message) as an integer) bitwise and 255)
            if (octet < 128) or (octet > 191):
                return refused
            set codepoint to (codepoint * 64) + (octet - 128)
        if (codepoint < minimum) or (codepoint > 1114111):
            return refused
        if (codepoint >= 55296) and (codepoint <= 57343):
            return refused
        return @intrinsic("construct", a bim unicode step record, true, codepoint, size)

function bim text {a string:message} is valid utf8:
    execute:
        set cursor to 0
        loop while cursor < (the length of message):
            set step to the bim unicode step of message at cursor
            if step's valid = false:
                return false
            set cursor to cursor + step's size
        return true

function bim text {a string:message} contains Lao:
    execute:
        set cursor to 0
        loop while cursor < (the length of message):
            set step to the bim unicode step of message at cursor
            if (step's codepoint >= 3712) and (step's codepoint <= 3839):
                return true
            if step's size <= 0:
                return false
            set cursor to cursor + step's size
        return false
