# SPDX-License-Identifier: MPL-2.0
# Runtime UTF-8 JSON catalogues. Translation keys are stable identifiers;
# model names and property values are never translation keys. Lookups use
# an open-addressed table loaded once, rather than parsing files per frame.
import lib/json.dl
import localisation/bim_utf8.dl

class:
    patterns:
        [a|] bim message catalogue record
    members:
        valid as a boolean
        locale as a string
        name as a string
        keys as the type of (an empty list of a string)
        messages as the type of (an empty list of a string)

function an empty bim message catalogue:
    execute:
        return @intrinsic("construct", a bim message catalogue record, false, the string form of "en", the string form of "English", an empty list of a string, an empty list of a string)

function the bim message hash of {a string:key}:
    execute:
        set value to 0 as a 64 bit integer
        loop cursor from 0 to the length of key:
            set octet to ((((the character at cursor in key) as an integer) bitwise and 255) as a 64 bit integer)
            set value to the remainder of ((value * (131 as a 64 bit integer)) + octet) divided by (2147483647 as a 64 bit integer)
        return value

function bim message key {a string:key} is valid:
    execute:
        if ((the length of key) = 0) or ((the length of key) > 128):
            return false
        loop cursor from 0 to the length of key:
            set octet to ((the character at cursor in key) as an integer) bitwise and 255
            set letter to ((octet >= 65) and (octet <= 90)) or ((octet >= 97) and (octet <= 122))
            set digit to (octet >= 48) and (octet <= 57)
            if ((letter or digit) or (((octet = 46) or (octet = 45)) or (octet = 95))) = false:
                return false
        return true

function the bim message catalogue parsed from {a string:content}:
    execute:
        set result to an empty bim message catalogue
        if ((the length of content) > 1048576) or ((bim text content is valid utf8) = false):
            return result
        set jsonResult to the JSON document parsed from content
        if jsonResult failed:
            free jsonResult
            return result
        set root to the value of jsonResult
        if root's kind != the JSON object kind:
            free jsonResult
            return result
        set locale to the JSON member named (the string form of "locale") in root
        set name to the JSON member named (the string form of "name") in root
        set messages to the JSON member named (the string form of "messages") in root
        if ((locale = (0 as a pointer to a JSON value)) or (name = (0 as a pointer to a JSON value))) or (messages = (0 as a pointer to a JSON value)):
            free jsonResult
            return result
        if ((locale's kind != the JSON text kind) or (name's kind != the JSON text kind)) or (messages's kind != the JSON object kind):
            free jsonResult
            return result
        if ((the length of locale's text) = 0) or ((messages's length > 4096) or (messages's length < 1)):
            free jsonResult
            return result
        if ((bim text locale's text is valid utf8) = false) or ((bim text name's text is valid utf8) = false):
            free jsonResult
            return result
        set result's locale to locale's text
        set result's name to name's text
        set capacity to (messages's length * 2) + 1
        loop cursor from 0 to capacity:
            append (the string form of "") to (result's keys)
            append (the string form of "") to (result's messages)
        set valid to true
        loop cursor from 0 to messages's length:
            set member to the item at cursor in (messages's members)
            if ((bim message key member's name is valid) = false) or (member's value = (0 as a pointer to a JSON value)):
                set valid to false
            else if member's value's kind != the JSON text kind:
                set valid to false
            else if ((bim text member's value's text is valid utf8) = false) or ((the length of member's value's text) > 65536):
                set valid to false
            else:
                set slot to (the remainder of (the bim message hash of member's name) divided by (capacity as a 64 bit integer)) as an integer
                set probing to true
                loop while probing:
                    set key to the item at slot in (result's keys)
                    if (the length of key) = 0:
                        replace item at index slot in (result's keys) with member's name
                        replace item at index slot in (result's messages) with member's value's text
                        set probing to false
                    else if key = member's name:
                        set valid to false
                        set probing to false
                    else:
                        set slot to the remainder of (slot + 1) divided by capacity
        free jsonResult
        if valid = false:
            return an empty bim message catalogue
        set result's valid to true
        return result

function the bim message {a string:key} defaulting to {a string:english} in {bim message catalogue record:catalogue}:
    execute:
        if catalogue's valid = false:
            return english
        set capacity to the length of (catalogue's keys)
        if capacity = 0:
            return english
        set slot to (the remainder of (the bim message hash of key) divided by (capacity as a 64 bit integer)) as an integer
        loop attempt from 0 to capacity:
            set present to the item at slot in (catalogue's keys)
            if (the length of present) = 0:
                return english
            if present = key:
                set translated to the item at slot in (catalogue's messages)
                if (the length of translated) > 0:
                    return translated
                return english
            set slot to the remainder of (slot + 1) divided by capacity
        return english
