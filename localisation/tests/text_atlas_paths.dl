# SPDX-License-Identifier: MPL-2.0
# Compile real font loading and shaped drawing with dynamic atlas values.
# Empty mock atlases let inference omit the Lao path, hiding diagnostics.
import views/drawings/bim_text.dl

set nativeGate to @intrinsic("call", "obs_platform", "obs_platform_has_text_shaper", a 64 bit integer)
# The platform contract returns only 0 or 1. Keep this branch opaque to
# DynLex inference; it must compile without creating a graphics window.
if nativeGate > (100 as a 64 bit integer):
    set loading to the bim text atlas from regular font at (the string form of "ui/shell/fonts/Inter-Regular.ttf") and bold font at (the string form of "ui/shell/fonts/Inter-SemiBold.ttf") and drawing font at (the string form of "ui/shell/fonts/osifont.ttf") and mono font at (the string form of "ui/shell/fonts/JetBrainsMono-Regular.ttf") and medium font at (the string form of "ui/shell/fonts/Inter-Medium.ttf") and Lao font at (the string form of "ui/shell/fonts/NotoSansLao.ttf") with icons from (the string form of "ui/shell/icons/ui-icons.txt") for (0 as a pointer)
    set frame to @intrinsic("construct", a graphics frame, 0 as a pointer, false)
    draw bim text (the string form of "ຕັ້ງຄ່າ") at 20.0 and 30.0 in face (bim text heading) with loading's atlas coloured 255, 255 and 255 in frame
if (nativeGate < (0 as a 64 bit integer)) or (nativeGate > (1 as a 64 bit integer)):
    @intrinsic("call", "libc", "exit", nothing, 1)
print "PASS: dynamic atlas loading and Lao drawing compile without diagnostics" as a line
