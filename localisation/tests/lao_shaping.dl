# SPDX-License-Identifier: MPL-2.0
# Cross-platform integration of the platform shaping ABI and bundled Lao font.
import views/drawings/bim_text.dl

function check Lao shaping {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set library to 0 as a pointer
set face to 0 as a pointer
check Lao shaping ((@intrinsic("call", "freetype", "FT_Init_FreeType", an integer, the address of library)) = 0) named (the string form of "FreeType starts")
check Lao shaping ((@intrinsic("call", "freetype", "FT_New_Face", an integer, library, "ui/shell/fonts/NotoSansLao.ttf", 0 as a C long integer, the address of face)) = 0) named (the string form of "bundled Lao font loads")
check Lao shaping ((@intrinsic("call", "freetype", "FT_Set_Pixel_Sizes", an integer, face, 0 as a 32 bit integer, 15 as a 32 bit integer)) = 0) named (the string form of "Lao face has a fixed pixel size")
set shaped to the bim shaped text (the string form of "ຕັ້ງຄ່າ") using face
check Lao shaping shaped's valid named (the string form of "native HarfBuzz shapes Lao")
set covered to true
set zeroAdvance to false
set positioned to false
set totalAdvance to 0 as a 64 bit integer
loop cursor from 0 to shaped's count:
    set glyph to the item at cursor in shaped's glyphs
    if glyph's glyph <= (0 as a 64 bit integer):
        set covered to false
    if glyph's advanceX = (0 as a 64 bit integer):
        set zeroAdvance to true
    if (glyph's offsetX != (0 as a 64 bit integer)) or (glyph's offsetY != (0 as a 64 bit integer)):
        set positioned to true
    set totalAdvance to totalAdvance + glyph's advanceX
check Lao shaping covered named (the string form of "all contextual glyphs are present")
check Lao shaping (zeroAdvance and positioned) named (the string form of "combining marks have shaped offsets and zero advance")
check Lao shaping (totalAdvance > (0 as a 64 bit integer)) named (the string form of "text measurement uses positive shaped advances")
@intrinsic("call", "libc", "free", nothing, shaped's glyphs)
ignore @intrinsic("call", "freetype", "FT_Done_Face", an integer, face)
ignore @intrinsic("call", "freetype", "FT_Done_FreeType", an integer, library)
