# SPDX-License-Identifier: MPL-2.0
# The Dutch type library (#92): the editor's own build-ups with the layers
# their names promise, and every wall, slab, column and beam type of the INB
# template (localisation/nl/types/catalogue.json) under its template name,
# with its IFC predefined type kept and written to IFC; added once.
import ui/editor/bim_editor.dl

function the bim library test text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.4f", value)
        return the substring of buffer from 0 spanning written bytes

# The predefined type kept for type `typeId`, or "".
function the bim library test predefined type of {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        return the bim property value (the string form of "PredefinedType") of set (the string form of "IFC attributes") of typeId in modelValue

# How many types of the template the model holds, by IFC class.
function print bim library test counts of {bim model record:modelValue}:
    execute:
        set wallCount to 0
        set slabCount to 0
        set roofCount to 0
        set columnCount to 0
        set beamCount to 0
        loop cursor from 0 to the length of (modelValue's wallTypes's values):
            set planarType to the item at cursor in (modelValue's wallTypes's values)
            if (the length of (the bim library test predefined type of planarType's id in modelValue)) > 0:
                if planarType's role = bim wall planar role:
                    set wallCount to wallCount + 1
                else:
                    set slabCount to slabCount + 1
                    if planarType's role = bim roof planar role:
                        set roofCount to roofCount + 1
        loop cursor from 0 to the length of (modelValue's linearTypes's values):
            set linearType to the item at cursor in (modelValue's linearTypes's values)
            if (the length of (the bim library test predefined type of linearType's id in modelValue)) > 0:
                if linearType's role = bim column role:
                    set columnCount to columnCount + 1
                if linearType's role = bim beam role:
                    set beamCount to beamCount + 1
        print ((the string form of "IfcWallType ") + (the string form of wallCount)) as a line
        print ((the string form of "IfcSlabType ") + ((the string form of slabCount) + ((the string form of " (roofs ") + ((the string form of roofCount) + (the string form of ")"))))) as a line
        print ((the string form of "IfcColumnType ") + (the string form of columnCount)) as a line
        print ((the string form of "IfcBeamType ") + (the string form of beamCount)) as a line

# Planar type `wanted` of role `roleCode`: its thickness, layers and
# predefined type, or that it is missing.
function print bim library test planar type {a string:wanted} of role {integer:roleCode} in {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's wallTypes's values):
            set planarType to the item at cursor in (modelValue's wallTypes's values)
            if (planarType's role = roleCode) and (planarType's name = wanted):
                set text to ((wanted + (the string form of " (")) + (the bim name of planar role roleCode)) + ((the string form of ") ") + (the bim library test text of (the bim thickness of planarType)))
                loop layerCursor from 0 to the length of (planarType's layers's values):
                    set layerValue to the item at layerCursor in (planarType's layers's values)
                    set text to ((text + (the string form of ", ")) + layerValue's material) + ((the string form of " ") + (the bim millimetre text of layerValue's thickness))
                set kept to the bim library test predefined type of planarType's id in modelValue
                if (the length of kept) > 0:
                    set text to (text + (the string form of "; ")) + kept
                print text as a line
                return nothing
        print (wanted + (the string form of ": missing")) as a line

function print bim library test linear type {a string:wanted} of role {integer:roleCode} in {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's linearTypes's values):
            set linearType to the item at cursor in (modelValue's linearTypes's values)
            if (linearType's role = roleCode) and (linearType's name = wanted):
                set text to ((wanted + (the string form of " (")) + (the bim name of linear role roleCode)) + ((the string form of ") ") + linearType's material)
                set text to (text + (the string form of " ")) + (((the bim millimetre text of linearType's width) + (the string form of "x")) + (the bim millimetre text of linearType's depth))
                set kept to the bim library test predefined type of linearType's id in modelValue
                if (the length of kept) > 0:
                    set text to (text + (the string form of "; ")) + kept
                print text as a line
                return nothing
        print (wanted + (the string form of ": missing")) as a line

set editor to a new bim editor
set e to the address of editor
add bim type library to e
set modelValue to editor's documentValue's current
print bim library test counts of modelValue
set planarTotal to the length of (modelValue's wallTypes's values)
set linearTotal to the length of (modelValue's linearTypes's values)
print ((the string form of "planar types ") + ((the string form of planarTotal) + ((the string form of ", linear types ") + (the string form of linearTotal)))) as a line

print (the string form of "The editor's own build-ups:") as a line
print bim library test planar type (the string form of "Metselwerk-spouw-isolatie PIR-kalkzandsteen 360") of role bim wall planar role in modelValue
print bim library test planar type (the string form of "Metselwerk-spouw-isolatie-kalkzandsteen 300") of role bim wall planar role in modelValue
print bim library test planar type (the string form of "Hout-spouw-hout-isolatie-gips 204.5") of role bim wall planar role in modelValue
print bim library test planar type (the string form of "Gips-isolatie-gips 100") of role bim wall planar role in modelValue

print (the string form of "From the template:") as a line
print bim library test planar type (the string form of "kzst_100") of role bim wall planar role in modelValue
print bim library test planar type (the string form of "clt_100") of role bim wall planar role in modelValue
print bim library test planar type (the string form of "fermacell_12.5") of role bim wall planar role in modelValue
print bim library test planar type (the string form of "und") of role bim wall planar role in modelValue
print bim library test planar type (the string form of "kpv_200") of role bim floor planar role in modelValue
print bim library test planar type (the string form of "gen_100") of role bim floor planar role in modelValue
print bim library test planar type (the string form of "clt_100") of role bim floor planar role in modelValue
print bim library test planar type (the string form of "zandcement_50") of role bim floor planar role in modelValue
print bim library test planar type (the string form of "isolatie_eps_100") of role bim roof planar role in modelValue
print bim library test linear type (the string form of "BK 300x300") of role bim column role in modelValue
print bim library test linear type (the string form of "GL 120x550") of role bim column role in modelValue
print bim library test linear type (the string form of "BB 400x500") of role bim beam role in modelValue
print bim library test linear type (the string form of "HEA160") of role bim beam role in modelValue

# The editor's own floor and linear types are there besides the template's.
print bim library test planar type (the string form of "Beton 250") of role bim floor planar role in modelValue
print bim library test linear type (the string form of "Beton 300x300") of role bim column role in modelValue

add bim type library to e
set again to editor's documentValue's current
print ((the string form of "added again: ") + (the string form of (((the length of (again's wallTypes's values)) - planarTotal) + ((the length of (again's linearTypes's values)) - linearTotal)))) as a line
print ((the string form of "undo after the library: ") + (the string form of (undo bim transaction in (the address of (editor's documentValue))))) as a line

set ifcText to the bim ifc text of again
print ((the string form of "IFC clt_100 wall type ELEMENTEDWALL: ") + (the string form of (ifcText contains "'clt_100',$,$,$,$,$,$,.ELEMENTEDWALL.)"))) as a line
print ((the string form of "IFC gen_100 slab type BASESLAB: ") + (the string form of (ifcText contains "'gen_100',$,$,$,$,$,$,.BASESLAB.)"))) as a line
print ((the string form of "IFC BK 300x300 column type COLUMN: ") + (the string form of (ifcText contains "'BK 300x300',$,$,$,$,$,$,.COLUMN.)"))) as a line
print ((the string form of "IFC own wall type STANDARD: ") + (the string form of (ifcText contains "'Beton 150',$,$,$,$,$,$,.STANDARD.)"))) as a line
