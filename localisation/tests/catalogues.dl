# SPDX-License-Identifier: MPL-2.0
import localisation/bim_catalogue.dl
import exchange/ifcx/bim_file.dl

function check catalogue {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set englishFile to the bim file content at (the string form of "localisation/messages/en.json")
set laoFile to the bim file content at (the string form of "localisation/messages/lo.json")
set dutchFile to the bim file content at (the string form of "localisation/messages/nl.json")
set english to the bim message catalogue parsed from englishFile's text
set lao to the bim message catalogue parsed from laoFile's text
set dutch to the bim message catalogue parsed from dutchFile's text
check catalogue (english's valid and (lao's valid and dutch's valid)) named (the string form of "English Dutch and Lao JSON catalogues load")
check catalogue ((the bim message (the string form of "app.save") defaulting to (the string form of "Save") in lao) = (the string form of "ບັນທຶກ")) named (the string form of "Lao text survives parsing and JSON tree cleanup")
check catalogue ((the bim message (the string form of "app.copy") defaulting to (the string form of "Copy") in dutch) = (the string form of "Kopiëren")) named (the string form of "Dutch accents survive parsing")
check catalogue ((the bim message (the string form of "missing.key") defaulting to (the string form of "English fallback") in lao) = (the string form of "English fallback")) named (the string form of "missing keys fall back to the supplied English text")
set blank to the bim message catalogue parsed from (the string form of "{\"locale\":\"lo\",\"name\":\"Lao\",\"messages\":{\"app.save\":\"\"}}")
check catalogue ((the bim message (the string form of "app.save") defaulting to (the string form of "Save") in blank) = (the string form of "Save")) named (the string form of "empty translations fall back to English")
set duplicate to the bim message catalogue parsed from (the string form of "{\"locale\":\"lo\",\"name\":\"Lao\",\"messages\":{\"app.save\":\"one\",\"app.save\":\"two\"}}")
check catalogue (duplicate's valid = false) named (the string form of "duplicate keys reject the complete catalogue")
set wrongType to the bim message catalogue parsed from (the string form of "{\"locale\":\"lo\",\"name\":\"Lao\",\"messages\":{\"app.save\":true}}")
check catalogue (wrongType's valid = false) named (the string form of "non-string translations reject the complete catalogue")
set truncated to the bim message catalogue parsed from (the string form of "{\"locale\":\"lo\"")
check catalogue (truncated's valid = false) named (the string form of "truncated JSON safely falls back")
check catalogue (bim text (the string form of "ລາວ – Kopiëren 😀") is valid utf8) named (the string form of "UTF-8 supports two three and four byte scalars")
check catalogue (bim text (the string form of "ຕັ້ງຄ່າ") contains Lao) named (the string form of "Lao text selects the shaping path")
set first to the bim unicode step of (the string form of "ລາວ") at 0
check catalogue (first's valid and ((first's codepoint = 3749) and (first's size = 3))) named (the string form of "Lao decodes to a Unicode scalar rather than question marks")
set invalid to a new string buffer containing 2 bytes
store (192 as a byte) into the data of invalid at 0
store (175 as a byte) into the data of invalid at 1
check catalogue ((bim text invalid is valid utf8) = false) named (the string form of "overlong UTF-8 is rejected")
set escaped to the bim message catalogue parsed from (the string form of "{\"locale\":\"lo\",\"name\":\"Lao\",\"messages\":{\"app.save\":\"\\u0e9a\\u0eb1\\u0e99\\u0e97\\u0eb6\\u0e81\"}}")
check catalogue ((the bim message (the string form of "app.save") defaulting to (the string form of "Save") in escaped) = (the string form of "ບັນທຶກ")) named (the string form of "escaped JSON and literal UTF-8 translate identically")
check catalogue ((the bim message (the string form of "model.object.12") defaulting to (the string form of "My wall") in lao) = (the string form of "My wall")) named (the string form of "model names passed as fallback text remain unchanged")
