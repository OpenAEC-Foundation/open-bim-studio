# SPDX-License-Identifier: MPL-2.0
# The NL door library: Dutch standard doors added once as door types named
# by the rules with their frame and leaf ("Deur 830x2015 stomp staal"); the
# command draws doors of it; the properties show frame, leaf and leaves.
import ui/editor/bim_editor.dl

set editor to a new bim editor
set e to the address of editor
type bim editor key 2134 in e
print editor's message as a line
loop cursor from 0 to the length of (editor's documentValue's current's openingTypes's values):
    set openingType to the item at cursor in (editor's documentValue's current's openingTypes's values)
    if openingType's isDoor:
        print ((openingType's name + (the string form of ": rough ")) + (the bim metres text of (the bim rough width of openingType))) as a line
type bim editor key 2134 in e
print editor's message as a line
