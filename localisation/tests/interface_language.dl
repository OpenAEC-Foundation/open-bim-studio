# SPDX-License-Identifier: MPL-2.0
import ui/shell/bim_ui_files.dl

function check interface language {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set defaults to the bim default app settings
check interface language (defaults's language = 0) named (the string form of "older settings default to English")
set dutch to the bim choices defaults after setting ((bim language setting command) + 1)
set lao to the bim choices dutch after setting ((bim language setting command) + 2)
check interface language ((dutch's language = 1) and (lao's language = 2)) named (the string form of "language commands select Dutch and Lao")
check interface language ((lao's theme = defaults's theme) and (lao's units = defaults's units)) named (the string form of "language changes preserve other preferences")
check interface language (bim command ((bim language setting command) + 2) sets a setting) named (the string form of "language controls are handled by the settings path")
set missing to the bim interface catalogue for 2 below (the string form of "build/no-such-language-folder/")
check interface language (missing's valid = false) named (the string form of "missing catalogue uses the English fallback")
set atlas to @intrinsic("construct", a bim text atlas record, @intrinsic("construct", a graphics texture, 0 as a pointer to a byte, 0, 0), an empty list of a bim text face record, 0, 0, an empty list of a bim icon cell record, an empty bim message catalogue, an empty list of a pointer, -1)
set atlas's messages to the bim interface catalogue for 2 below (the string form of "localisation/messages/")
check interface language ((the bim chrome label (the string form of "Save") using atlas) = (the string form of "ບັນທຶກ")) named (the string form of "static chrome uses the selected catalogue")
check interface language ((the bim chrome label (the string form of "Uncatalogued action") using atlas) = (the string form of "Uncatalogued action")) named (the string form of "unmigrated chrome remains English")
# Compile the actual settings/ribbon drawing paths; the GUI smoke test draws them.
set width to 1440.0
set frame to @intrinsic("construct", a graphics frame, 0 as a pointer, false)
set screens to the bim file screens at rest
set screens's settingsPage to 1
set editor to a new bim editor
if width < 0.0:
    ignore (draw bim settings dialog of screens with lao across width by 900.0 pointing at 855.0 and 478.0 using atlas in frame)
    ignore (draw bim ribbon of tab 0 under 0 folded false from group 0 filing false for editor in discipline 0 pointing at 0.0 and 0.0 across width using atlas in frame)
