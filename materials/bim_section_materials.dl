# SPDX-License-Identifier: MPL-2.0
# Material-aware section solids, independent of the window and GPU.
import viewer/bim_section_caps.dl

function the bim cap meshes among {a pointer to a list:sourceEntries} from {cad vector3:lowCorner} to {cad vector3:highCorner} for {bim evaluation record:evaluation}:
    execute:
        set capEntries to a cad topology list of a bim scene mesh record
        set layeredIds to an empty list of a 64 bit integer
        loop entryCursor from 0 to the length of sourceEntries:
            set sourceEntry to the item at entryCursor in sourceEntries
            set alreadyLayered to false
            loop seenCursor from 0 to the length of layeredIds:
                if (the item at seenCursor in layeredIds) = sourceEntry's elementId:
                    set alreadyLayered to true
            if ((bim scene mesh sourceEntry draws lines) = false) and (alreadyLayered = false):
                set layers to a cad topology list of a bim layer solid record
                set wallFound to the bim wall index of sourceEntry's elementId in evaluation's modelValue
                if wallFound's valid:
                    set layers to the bim layer solids of (the item at wallFound's position in (evaluation's modelValue's walls's values)) in evaluation's modelValue using evaluation's index
                set slabFound to the bim slab index of sourceEntry's elementId in evaluation's modelValue
                if slabFound's valid:
                    set layers to the bim layer solids of plate (the item at slabFound's position in (evaluation's modelValue's slabs's values)) in evaluation's modelValue
                if (the length of (layers's values)) > 0:
                    append sourceEntry's elementId to layeredIds
                    loop layerCursor from 0 to the length of (layers's values):
                        set layer to the item at layerCursor in (layers's values)
                        set triangles to an empty fast mesh
                        append fast mesh of layer's shape to (the address of triangles)
                        set capEntry to sourceEntry
                        set capEntry's material to layer's material
                        set capEntry's shape to the bim cut caps of triangles from lowCorner to highCorner
                        if (the length of (capEntry's shape's triangles's values)) > 0:
                            append capEntry to (capEntries's values)
                else:
                    set sourceEntry's shape to the bim cut caps of sourceEntry's shape from lowCorner to highCorner
                    if (the length of (sourceEntry's shape's triangles's values)) > 0:
                        append sourceEntry to (capEntries's values)
        free layeredIds
        return capEntries
