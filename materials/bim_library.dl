# SPDX-License-Identifier: MPL-2.0
# Libraries: a project's types in a file of their own, the same IfcX as a
# project (`.ifcx`, or compressed `.ifcxb`) holding only types: the wall,
# floor, roof and ceiling types with their layers, the door and window
# types, the linear types with their profiles and steel designations, the
# drawing types, each with its settings (assembly codes, profiles, door
# frames). A project file holds its library the same way, as its types.
# Exported from a project, a library is imported into another by adding
# every type it lacks (by name and role), with its settings.
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl
import exchange/ifcx/bim_ifcx_binary.dl

# Whether element `elementId` is one of `modelValue`'s types (or the
# project, element 0, whose settings a library keeps too).
function bim element {a 64 bit integer:elementId} is a type in {bim model record:modelValue}:
    execute:
        if elementId = (0 as a 64 bit integer):
            return true
        if (the bim wall type index of elementId in modelValue)'s valid:
            return true
        if (the bim opening type index of elementId in modelValue)'s valid:
            return true
        if (the bim linear type index of elementId in modelValue)'s valid:
            return true
        return (the bim drawing type index of elementId in modelValue)'s valid

# The library of `modelValue`: a model of its types alone, with their
# settings.
function the bim library of {bim model record:modelValue}:
    execute:
        set libraryModel to an empty bim model
        set libraryModel's nextId to modelValue's nextId
        loop cursor from 0 to the length of (modelValue's wallTypes's values):
            append (the item at cursor in (modelValue's wallTypes's values)) to (libraryModel's wallTypes's values)
        loop cursor from 0 to the length of (modelValue's openingTypes's values):
            append (the item at cursor in (modelValue's openingTypes's values)) to (libraryModel's openingTypes's values)
        loop cursor from 0 to the length of (modelValue's linearTypes's values):
            append (the item at cursor in (modelValue's linearTypes's values)) to (libraryModel's linearTypes's values)
        loop cursor from 0 to the length of (modelValue's drawingTypes's values):
            append (the item at cursor in (modelValue's drawingTypes's values)) to (libraryModel's drawingTypes's values)
        loop cursor from 0 to the length of (modelValue's settings's values):
            set entry to the item at cursor in (modelValue's settings's values)
            if bim element entry's elementId is a type in modelValue:
                append entry to (libraryModel's settings's values)
        return libraryModel

# The library of `modelValue` written to `path` (IfcX, compressed when the
# path ends in "b"); false when it could not be written.
function write bim library of {bim model record:modelValue} to {a string:path}:
    execute:
        set stamp to the bim utc timestamp
        set libraryText to the bim ifcx text of (the bim library of modelValue) identified as ((the string form of "open-bim-studio-library/") + (path + ((the string form of "@") + stamp))) for project (the string form of "open-bim-studio-library") by (the string form of "Open BIM Studio") at stamp
        if ((the length of path) > 0) and ((the character at ((the length of path) - 1) in path) = 98):
            set encoded to the bim cbor ifcx of libraryText
            if encoded's valid = false:
                return false
            return write bim compressed text encoded's text to file path
        return write bim text libraryText to file path

# The library read from `path` (any IfcX the slice writes); not valid when
# it does not read.
class:
    patterns:
        [a|] bim library reading record
    members:
        valid as a boolean
        message as a string
        library as a bim model record

function the bim library read from {a string:path}:
    execute:
        set loaded to the bim uncompressed content at path
        if loaded's valid = false:
            return @intrinsic("construct", a bim library reading record, false, (the string form of "could not read ") + path, an empty bim model)
        set rebuilt to the bim native text of ifcx loaded's text
        if rebuilt's valid = false:
            return @intrinsic("construct", a bim library reading record, false, rebuilt's message, an empty bim model)
        set parsed to the bim model parsed from rebuilt's text
        if parsed's valid = false:
            return @intrinsic("construct", a bim library reading record, false, parsed's message, an empty bim model)
        return @intrinsic("construct", a bim library reading record, true, the string form of "", parsed's modelValue)

# The settings of `fromId` in `library` given to `toId` in `target`.
local function copy bim library settings of {a 64 bit integer:fromId} in {bim model record:sourceLibrary} to {a 64 bit integer:toId} in {a pointer to a bim model record:target}:
    execute:
        loop cursor from 0 to the length of (sourceLibrary's settings's values):
            set entry to the item at cursor in (sourceLibrary's settings's values)
            if entry's elementId = fromId:
                set bim setting entry's code of toId to entry's value keeping true in target

# Every type of `library` that `target` lacks (the same name and role)
# added to it with its settings. The number added.
function add bim library {bim model record:libraryModel} to {a pointer to a bim model record:target}:
    execute:
        set added to 0
        loop cursor from 0 to the length of (libraryModel's wallTypes's values):
            set wallType to the item at cursor in (libraryModel's wallTypes's values)
            set present to false
            loop haveCursor from 0 to the length of (target's wallTypes's values):
                set have to the item at haveCursor in (target's wallTypes's values)
                if (have's name = wallType's name) and (have's role = wallType's role):
                    set present to true
            if present = false:
                set fresh to the bim new id in target
                set copied to wallType
                set copied's id to fresh
                append copied to (target's wallTypes's values)
                copy bim library settings of wallType's id in libraryModel to fresh in target
                set added to added + 1
        loop cursor from 0 to the length of (libraryModel's openingTypes's values):
            set openingType to the item at cursor in (libraryModel's openingTypes's values)
            set present to false
            loop haveCursor from 0 to the length of (target's openingTypes's values):
                if (the item at haveCursor in (target's openingTypes's values))'s name = openingType's name:
                    set present to true
            if present = false:
                set fresh to the bim new id in target
                set copiedOpening to openingType
                set copiedOpening's id to fresh
                append copiedOpening to (target's openingTypes's values)
                copy bim library settings of openingType's id in libraryModel to fresh in target
                set added to added + 1
        loop cursor from 0 to the length of (libraryModel's linearTypes's values):
            set linearType to the item at cursor in (libraryModel's linearTypes's values)
            set present to false
            loop haveCursor from 0 to the length of (target's linearTypes's values):
                set have to the item at haveCursor in (target's linearTypes's values)
                if (have's name = linearType's name) and (have's role = linearType's role):
                    set present to true
            if present = false:
                set fresh to the bim new id in target
                set copiedLinear to linearType
                set copiedLinear's id to fresh
                append copiedLinear to (target's linearTypes's values)
                copy bim library settings of linearType's id in libraryModel to fresh in target
                set added to added + 1
        if added > 0:
            name bim types by the rules in target
        return added
