# SPDX-License-Identifier: MPL-2.0
# The 3D view's section box kept with the model and fitted to a selection.
#
# The box is a setting of the project (element 0), in whole millimetres, so
# that a saved model opens with its box as it was left, and an edit of the
# box is undone with the model: whether it is on (1810001) and its low and
# high corners (1810002 to 1810007). The window (`main.dl`) reads it when
# the model's stored box changes (opened, undone) and writes it when the box
# is turned on or off, dragged or fitted.
import ui/editor/bim_editor.dl

function bim section box setting:
    replacement:
        1810001

# The section box: on or off, and its corners in metres.
class:
    patterns:
        [a|] bim view box state record
    members:
        shown as a boolean
        low as a cad vector3
        high as a cad vector3

# The stored box as text (empty when the model keeps none), to see when it
# changed.
function the bim stored section box key of {bim model record:modelValue}:
    execute:
        return the bim settings text of (0 as a 64 bit integer) from (bim section box setting) below ((bim section box setting) + 7) in modelValue

local function the bim stored box metres {integer:slot} of {bim model record:modelValue} or {a 64 bit floating-point number:fallback}:
    execute:
        set reading to the bim setting ((bim section box setting) + slot) of (0 as a 64 bit integer) in modelValue
        if reading's found:
            return (reading's value as a 64 bit floating-point number) / 1000.0
        return fallback

# The box `modelValue` keeps (off, around nothing, when it keeps none).
function the bim stored section box of {bim model record:modelValue}:
    execute:
        set onReading to the bim setting (bim section box setting) of (0 as a 64 bit integer) in modelValue
        set shownNow to onReading's found and (onReading's value = (1 as a 64 bit integer))
        set lowCorner to a cad vector3 with x (the bim stored box metres 1 of modelValue or 0.0), y (the bim stored box metres 2 of modelValue or 0.0) and z (the bim stored box metres 3 of modelValue or 0.0)
        set highCorner to a cad vector3 with x (the bim stored box metres 4 of modelValue or 1.0), y (the bim stored box metres 5 of modelValue or 1.0) and z (the bim stored box metres 6 of modelValue or 1.0)
        return @intrinsic("construct", a bim view box state record, shownNow, lowCorner, highCorner)

local function the bim box millimetres of {a 64 bit floating-point number:metres}:
    execute:
        return (the floor of ((metres * 1000.0) + 0.5)) as a 64 bit integer

# `target` keeping the box (`shownNow`, from `lowCorner` to `highCorner`).
function keep bim section box {boolean:shownNow} from {cad vector3:lowCorner} to {cad vector3:highCorner} in {a pointer to a bim model record:target}:
    execute:
        set onValue to 0 as a 64 bit integer
        if shownNow:
            set onValue to 1 as a 64 bit integer
        set bim setting (bim section box setting) of (0 as a 64 bit integer) to onValue keeping true in target
        set bim setting ((bim section box setting) + 1) of (0 as a 64 bit integer) to (the bim box millimetres of lowCorner's x) keeping true in target
        set bim setting ((bim section box setting) + 2) of (0 as a 64 bit integer) to (the bim box millimetres of lowCorner's y) keeping true in target
        set bim setting ((bim section box setting) + 3) of (0 as a 64 bit integer) to (the bim box millimetres of lowCorner's z) keeping true in target
        set bim setting ((bim section box setting) + 4) of (0 as a 64 bit integer) to (the bim box millimetres of highCorner's x) keeping true in target
        set bim setting ((bim section box setting) + 5) of (0 as a 64 bit integer) to (the bim box millimetres of highCorner's y) keeping true in target
        set bim setting ((bim section box setting) + 6) of (0 as a 64 bit integer) to (the bim box millimetres of highCorner's z) keeping true in target

# The box around the meshes of the elements `chosenIds` (native, or imported
# with their scene ids) among `firstMeshes` and `secondMeshes`, widened by
# `margin`; `shown` false when none of them has a mesh.
function the bim fitted section box around {a pointer to a list:chosenIds} among {a pointer to a list:firstMeshes} and {a pointer to a list:secondMeshes} widened by {a 64 bit floating-point number:margin}:
    execute:
        set lowCorner to a cad vector3 with x 1000000000.0, y 1000000000.0 and z 1000000000.0
        set highCorner to a cad vector3 with x -1000000000.0, y -1000000000.0 and z -1000000000.0
        set anyFound to false
        loop listCursor from 0 to 2:
            set meshList to firstMeshes
            if listCursor = 1:
                set meshList to secondMeshes
            loop meshCursor from 0 to the length of meshList:
                set entry to the item at meshCursor in meshList
                set chosen to false
                loop chosenCursor from 0 to the length of chosenIds:
                    if (the item at chosenCursor in chosenIds) = entry's elementId:
                        set chosen to true
                if chosen:
                    loop pointCursor from 0 to the length of (entry's shape's positions's values):
                        set spot to the item at pointCursor in (entry's shape's positions's values)
                        set lowCorner to a cad vector3 with x (the minimum of lowCorner's x and spot's x), y (the minimum of lowCorner's y and spot's y) and z (the minimum of lowCorner's z and spot's z)
                        set highCorner to a cad vector3 with x (the maximum of highCorner's x and spot's x), y (the maximum of highCorner's y and spot's y) and z (the maximum of highCorner's z and spot's z)
                        set anyFound to true
        set widening to a cad vector3 with x margin, y margin and z margin
        return @intrinsic("construct", a bim view box state record, anyFound, the cad difference of lowCorner and widening, the cad sum of highCorner and widening)
