# SPDX-License-Identifier: MPL-2.0
# Elements hidden in a view (`bim_hidden.dl`): hiding nothing changes
# nothing; hiding twice hides once; a view's hidden elements stay in that
# view; several are hidden at once; restoring a view shows its elements
# again and leaves the other view's hidden; the ids asked to hide are left
# as they were; the key names the set, not only its size.
import views/common/bim_hidden.dl

function show hidden test {a pointer to a list:hiddenPairs} labelled {a string:title}:
    execute:
        set planIds to the bim hidden ids in view (10 as a 64 bit integer) among hiddenPairs
        set modelIds to the bim hidden ids in view (20 as a 64 bit integer) among hiddenPairs
        set planText to the string form of ""
        loop cursor from 0 to the length of (planIds's values):
            set planText to (planText + (the string form of " ")) + (the string form of (the item at cursor in (planIds's values)))
        set modelText to the string form of ""
        loop cursor from 0 to the length of (modelIds's values):
            set modelText to (modelText + (the string form of " ")) + (the string form of (the item at cursor in (modelIds's values)))
        print (((title + (the string form of ": plan [")) + planText) + (((the string form of " ] 3D [") + modelText) + (the string form of " ]"))) as a line

set hiddenSet to no bim hidden elements
set planView to 10 as a 64 bit integer
set modelView to 20 as a 64 bit integer

# Nothing selected: nothing hidden.
set nothingChosen to an empty list of a 64 bit integer
print ((the string form of "nothing selected, added ") + (the string form of (hide bim elements nothingChosen in view planView among (hiddenSet's values)))) as a line
show hidden test (hiddenSet's values) labelled (the string form of "after nothing")

# One wall hidden in the plan, then again: hidden once.
set wallOnly to an empty list of a 64 bit integer
append (101 as a 64 bit integer) to wallOnly
print ((the string form of "first HH, added ") + (the string form of (hide bim elements wallOnly in view planView among (hiddenSet's values)))) as a line
print ((the string form of "second HH, added ") + (the string form of (hide bim elements wallOnly in view planView among (hiddenSet's values)))) as a line
show hidden test (hiddenSet's values) labelled (the string form of "after HH twice")
print ((the string form of "hidden in the plan: ") + (the string form of (bim element (101 as a 64 bit integer) is hidden in view planView among (hiddenSet's values)))) as a line
print ((the string form of "hidden in 3D: ") + (the string form of (bim element (101 as a 64 bit integer) is hidden in view modelView among (hiddenSet's values)))) as a line

# Several chosen together, hidden in 3D, one of them already hidden there
# once before.
set chosen to an empty list of a 64 bit integer
append (101 as a 64 bit integer) to chosen
append (205 as a 64 bit integer) to chosen
append (307 as a 64 bit integer) to chosen
print ((the string form of "HH of three in 3D, added ") + (the string form of (hide bim elements chosen in view modelView among (hiddenSet's values)))) as a line
show hidden test (hiddenSet's values) labelled (the string form of "after HH in 3D")
print ((the string form of "the three asked are left: ") + (the string form of (((the length of chosen) = 3) and ((the item at 1 in chosen) = (205 as a 64 bit integer))))) as a line

# The key names the set: another element of the same count, another key.
set otherHidden to no bim hidden elements
set otherWall to an empty list of a 64 bit integer
append (102 as a 64 bit integer) to otherWall
ignore hide bim elements otherWall in view planView among (otherHidden's values)
print ((the string form of "plan key ") + (the bim hidden key in view planView among (hiddenSet's values))) as a line
print ((the string form of "another set of one, another key: ") + (the string form of ((the bim hidden key in view planView among (hiddenSet's values)) != (the bim hidden key in view planView among (otherHidden's values))))) as a line

# HR in 3D: the plan keeps its wall hidden.
print ((the string form of "HR in 3D, restored ") + (the string form of (restore bim hidden elements in view modelView among (hiddenSet's values)))) as a line
show hidden test (hiddenSet's values) labelled (the string form of "after HR in 3D")
print ((the string form of "HR in 3D again, restored ") + (the string form of (restore bim hidden elements in view modelView among (hiddenSet's values)))) as a line
print ((the string form of "HR in the plan, restored ") + (the string form of (restore bim hidden elements in view planView among (hiddenSet's values)))) as a line
show hidden test (hiddenSet's values) labelled (the string form of "after HR in the plan")
print ((the string form of "plan key ") + (the bim hidden key in view planView among (hiddenSet's values))) as a line
