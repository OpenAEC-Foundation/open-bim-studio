# SPDX-License-Identifier: MPL-2.0
# The view cube's face names lie on their faces: every point of a name in the
# face's plane, inside the face's flat square, the name centred on the face,
# read left to right as seen from outside (right x up is the outward normal),
# all names equally high.
import ui/panels/bim_view_panel.dl

function check cube labels {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set faces to an empty list of a cad vector3
append (a cad vector3 with x 1.0, y 0.0 and z 0.0) to faces
append (a cad vector3 with x -1.0, y 0.0 and z 0.0) to faces
append (a cad vector3 with x 0.0, y 1.0 and z 0.0) to faces
append (a cad vector3 with x 0.0, y -1.0 and z 0.0) to faces
append (a cad vector3 with x 0.0, y 0.0 and z 1.0) to faces
append (a cad vector3 with x 0.0, y 0.0 and z -1.0) to faces
set onPlane to true
set withinFace to true
set centred to true
set facingOut to true
set readsRight to true
set sameHeight to true
set firstHeight to -1.0
loop faceCursor from 0 to the length of faces:
    set normal to the item at faceCursor in faces
    set reading to the bim view cube label axes toward normal
    set turned to the cad cross of (reading's right) and (reading's up)
    if (the cad distance from turned to normal) > 1e-9:
        set facingOut to false
    set labelLines to the bim view cube label lines toward normal
    if ((the length of labelLines) = 0) or ((the remainder of (the length of labelLines) divided by 2) != 0):
        set onPlane to false
    set lowestRight to 9.0
    set highestRight to -9.0
    set lowestUp to 9.0
    set highestUp to -9.0
    loop pointCursor from 0 to the length of labelLines:
        set spot to the item at pointCursor in labelLines
        if (the absolute value of ((the cad dot of spot and normal) - 1.0)) > 1e-9:
            set onPlane to false
        set rightward to the cad dot of spot and (reading's right)
        set upward to the cad dot of spot and (reading's up)
        set lowestRight to the minimum of lowestRight and rightward
        set highestRight to the maximum of highestRight and rightward
        set lowestUp to the minimum of lowestUp and upward
        set highestUp to the maximum of highestUp and upward
    if ((lowestRight < -0.7) or (highestRight > 0.7)) or ((lowestUp < -0.7) or (highestUp > 0.7)):
        set withinFace to false
    if ((the absolute value of (lowestRight + highestRight)) > 1e-9) or ((the absolute value of (lowestUp + highestUp)) > 1e-9):
        set centred to false
    if (the cad dot of (the item at 0 in labelLines) and (reading's right)) >= 0.0:
        set readsRight to false
    if firstHeight < 0.0:
        set firstHeight to highestUp - lowestUp
    else if (the absolute value of ((highestUp - lowestUp) - firstHeight)) > 1e-9:
        set sameHeight to false
    free labelLines
check cube labels facingOut named (the string form of "each name reads with right x up out of its face")
check cube labels onPlane named (the string form of "each name's lines lie in its face's plane")
check cube labels withinFace named (the string form of "each name stays inside its face")
check cube labels centred named (the string form of "each name is centred on its face")
check cube labels readsRight named (the string form of "each name starts at its left")
check cube labels sameHeight named (the string form of "all names are equally high")
