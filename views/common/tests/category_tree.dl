# SPDX-License-Identifier: MPL-2.0
# The Visibility/Graphics category tree (issue #124): floors and walls open
# into structural and non-structural parts, told apart by LoadBearing or the
# type's materials. Overrides of shown, halftone and the lines' colour and
# weight are set per node on a drawing type; a part inherits from its
# category, a type from its parent, and the overrides survive the file.
import views/common/bim_category_tree.dl
import exchange/ifcx/bim_file.dl

function bim tree yes no {boolean:flag}:
    execute:
        if flag:
            return the string form of "yes"
        return the string form of "no"

function describe tree node {integer:key} of drawing type {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        set rules to the bim rules of drawing type typeId in modelValue
        set resolved to the bim tree node key in rules
        set line to (the string form of "  ") + (the bim name of node key)
        set line to (line + (the string form of ": shown ")) + (bim tree yes no resolved's visible)
        set line to (line + (the string form of ", halftone ")) + (bim tree yes no resolved's halftone)
        set line to (line + (the string form of ", cut ")) + ((the bim name of colour resolved's cutColour) + ((the string form of " ") + (the bim name of weight resolved's cutWeight)))
        set line to (line + (the string form of ", projection ")) + ((the bim name of colour resolved's projectionColour) + ((the string form of " ") + (the bim name of weight resolved's projectionWeight)))
        print line as a line

function describe element {a 64 bit integer:elementId} named {a string:label} by drawing type {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        set rules to the bim rules of drawing type typeId in modelValue
        set node to the bim node of element elementId by rules in modelValue
        set line to ((the string form of "  ") + label) + (the string form of ": ")
        set line to (line + (the bim name of node node's key)) + (the string form of ", shown ")
        set line to (line + (bim tree yes no node's visible)) + (the string form of ", cut ")
        set line to line + (the bim name of colour node's cutColour)
        print line as a line

set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
ensure bim drawing types in target
set structural to the bim drawing type named (the string form of "Structural") in modelValue
set pilePlan to the bim drawing type named (the string form of "Pile plan") in modelValue

print (the string form of "tree of walls and floors:") as a line
loop categoryCode from 0 to 2:
    loop part from 0 to the bim part count of category categoryCode:
        print ((the string form of "  ") + (the bim name of node (the bim node key of category categoryCode part part))) as a line

set concreteLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to concreteLayers
set timberLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "gypsum", 0.0125)) to timberLayers
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.07)) to timberLayers
set concreteFloorType to add bim planar type named (the string form of "Concrete floor") as role bim floor planar role with concreteLayers to target
set timberFloorType to add bim planar type named (the string form of "Timber floor") as role bim floor planar role with timberLayers to target
set masonryWallType to add bim wall type named (the string form of "Concrete wall") with concreteLayers to target
set partitionType to add bim wall type named (the string form of "Partition") with timberLayers to target
set outline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to outline
append (a cad vector2 with x 6.0 and y 0.0) to outline
append (a cad vector2 with x 6.0 and y 4.0) to outline
append (a cad vector2 with x 0.0 and y 4.0) to outline
set concreteFloor to add bim plate typed concreteFloorType on storey around outline at top 0.0 to target
set timberFloor to add bim plate typed timberFloorType on storey around outline at top 0.0 to target
set bearingWall to add bim wall typed masonryWallType on storey from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set partition to add bim wall typed partitionType on storey from (a cad vector2 with x 0.0 and y 2.0) to (a cad vector2 with x 6.0 and y 2.0) to target
set declared to add bim wall typed masonryWallType on storey from (a cad vector2 with x 0.0 and y 4.0) to (a cad vector2 with x 6.0 and y 4.0) to target
set bim property (the string form of "LoadBearing") of set (the string form of "Pset_WallCommon") of declared to (the string form of ".F.") typed (the string form of "IFCBOOLEAN") in target
print (the string form of "load-bearing:") as a line
print ((the string form of "  concrete floor ") + (bim tree yes no (bim element concreteFloor bears load in modelValue))) as a line
print ((the string form of "  timber floor ") + (bim tree yes no (bim element timberFloor bears load in modelValue))) as a line
print ((the string form of "  concrete wall ") + (bim tree yes no (bim element bearingWall bears load in modelValue))) as a line
print ((the string form of "  partition ") + (bim tree yes no (bim element partition bears load in modelValue))) as a line
print ((the string form of "  concrete wall declared not load-bearing ") + (bim tree yes no (bim element declared bears load in modelValue))) as a line

set floorsKey to the bim node key of category bim slab category part bim whole category part
set structuralFloors to the bim node key of category bim slab category part bim structural part
set otherFloors to the bim node key of category bim slab category part bim non structural part
print (the string form of "Structural: floors cut in red; Pile plan: non-structural floors hidden, structural ones 0.50 mm projection:") as a line
set bim override (bim cut colour field) of node floorsKey on structural to (the bim override colour 1) in target
set bim override (bim node visible field) of node otherFloors on pilePlan to (0 as a 64 bit integer) in target
cycle bim override (bim projection weight field) of node structuralFloors on pilePlan in target
cycle bim override (bim projection weight field) of node structuralFloors on pilePlan in target
cycle bim override (bim projection weight field) of node structuralFloors on pilePlan in target
cycle bim override (bim projection weight field) of node structuralFloors on pilePlan in target
cycle bim override (bim projection weight field) of node structuralFloors on pilePlan in target
print (the string form of "Pile plan:") as a line
describe tree node floorsKey of drawing type pilePlan in modelValue
describe tree node structuralFloors of drawing type pilePlan in modelValue
describe tree node otherFloors of drawing type pilePlan in modelValue
describe element concreteFloor named (the string form of "concrete floor") by drawing type pilePlan in modelValue
describe element timberFloor named (the string form of "timber floor") by drawing type pilePlan in modelValue
print (the string form of "Structural plan (no override of its own):") as a line
set structuralPlan to the bim drawing type named (the string form of "Structural plan") in modelValue
describe tree node otherFloors of drawing type structuralPlan in modelValue
print ((the string form of "  floors split: ") + (bim tree yes no (bim category bim slab category is split in (the bim rules of drawing type structuralPlan in modelValue)))) as a line
print (the string form of "Pile plan floors cut in blue: its own category beats the parent's:") as a line
set bim override (bim cut colour field) of node floorsKey on pilePlan to (the bim override colour 2) in target
describe tree node structuralFloors of drawing type pilePlan in modelValue
print (the string form of "Structural's structural floors cut in green: the child's category still wins:") as a line
set bim override (bim cut colour field) of node structuralFloors on structural to (the bim override colour 3) in target
describe tree node structuralFloors of drawing type pilePlan in modelValue
describe tree node structuralFloors of drawing type structuralPlan in modelValue
print (the string form of "a click cycles back to inherited:") as a line
set entries to the bim tree settings of modelValue
set owned to the bim own override (bim node visible field) of node otherFloors on pilePlan among entries in modelValue
print ((the string form of "  non-structural shown on Pile plan: ") + (the string form of owned)) as a line
cycle bim override (bim node visible field) of node otherFloors on pilePlan in target
set entries to the bim tree settings of modelValue
print ((the string form of "  after a click: ") + (the string form of (the bim own override (bim node visible field) of node otherFloors on pilePlan among entries in modelValue))) as a line
set chain to the bim rule chain of pilePlan in modelValue
print ((the string form of "  inherited: ") + (the string form of (the bim resolved override (bim node visible field) of node otherFloors along chain skipping own true among entries in modelValue))) as a line
print (the string form of "hidden again, then after the file:") as a line
set bim override (bim node visible field) of node otherFloors on pilePlan to (0 as a 64 bit integer) in target
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + (the string form of reread's valid)) as a line
describe tree node structuralFloors of drawing type pilePlan in reread's modelValue
describe tree node otherFloors of drawing type pilePlan in reread's modelValue
