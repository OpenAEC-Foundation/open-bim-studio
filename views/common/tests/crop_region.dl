# SPDX-License-Identifier: MPL-2.0
import views/common/bim_crop.dl

function check crop region {boolean:condition} named {a string:name}:
    execute:
        if condition:
            print ((the string form of "PASS ") + name) as a line
        else:
            print ((the string form of "FAIL ") + name) as a line

set modelValue to an empty bim model
set viewId to add bim view of kind (bim plan view) named (the string form of "Plan") on (1 as a 64 bit integer) to (the address of modelValue)
set viewValue to the item at 0 in (modelValue's views's values)
set viewValue's cropped to true
set viewValue's cropLow to a cad vector2 with x 0.0 and y 0.0
set viewValue's cropHigh to a cad vector2 with x 10.0 and y 8.0
set changed to the bim crop viewValue dragged at handle 2 by (a cad vector2 with x 2.0 and y 3.0)
check crop region ((changed's cropHigh's x = 12.0) and (changed's cropHigh's y = 11.0)) named (the string form of "corner resizes both axes")
set changed to the bim crop viewValue dragged at handle 4 by (a cad vector2 with x 3.0 and y 4.0)
check crop region ((changed's cropLow's x = 3.0) and (changed's cropLow's y = 0.0)) named (the string form of "side resizes one axis")
set changed to the bim crop viewValue dragged at handle 8 by (a cad vector2 with x 2.0 and y -3.0)
check crop region ((changed's cropLow's x = 2.0) and (changed's cropHigh's y = 5.0)) named (the string form of "centre translates region")
set changed to the bim crop viewValue dragged at handle 0 by (a cad vector2 with x 20.0 and y 20.0)
check crop region ((changed's cropLow's x < changed's cropHigh's x) and (changed's cropLow's y < changed's cropHigh's y)) named (the string form of "handles cannot invert crop")
set transform to @intrinsic("construct", a bim drawing transform record, a cad vector2 with x 0.0 and y 0.0, a cad vector2 with x 0.0 and y 0.0, 10.0)
check crop region ((the bim crop handle near (a cad vector2 with x 104.0 and y -80.0) of viewValue through transform with centre false) = 2) named (the string form of "handle hit tolerance is in pixels")
check crop region ((the bim crop handle near (a cad vector2 with x 50.0 and y -40.0) of viewValue through transform with centre false) = -1) named (the string form of "hidden centre does not intercept selection")
