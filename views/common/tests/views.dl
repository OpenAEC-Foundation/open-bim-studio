# SPDX-License-Identifier: MPL-2.0
# Views kept with the model: every storey gets a plan and the model a 3D
# view; a plan duplicated, given its own rules (walls in halftone, grids
# hidden), scale and crop, keeps them through .bim and .ifcx.
import formats/bim_file.dl
import formats/bim_ifcx.dl
import formats/bim_ifcx_read.dl

function list view test views of {bim model record:modelValue} labelled {a string:title}:
    execute:
        print title as a line
        loop cursor from 0 to the length of (modelValue's views's values):
            set viewValue to the item at cursor in (modelValue's views's values)
            set viewRules to the bim rules of view viewValue
            set line to (the string form of "  ") + ((viewValue's name + (the string form of ", kind ")) + (the string form of viewValue's kind))
            set line to (line + (the string form of ", 1:")) + (the string form of viewValue's scale)
            set line to (line + (the string form of ", walls shown ")) + ((the string form of (bim category bim wall category is visible in viewRules)) + ((the string form of " halftone ") + (the string form of (bim category bim wall category is halftone in viewRules))))
            set line to (line + (the string form of ", grids shown ")) + (the string form of (bim category bim grid category is visible in viewRules))
            set line to (line + (the string form of ", cropped ")) + (the string form of viewValue's cropped)
            print line as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Begane grond") at 0.0 with height 3.0 to target
set first to add bim level named (the string form of "Eerste verdieping") at 3.0 with height 3.0 to target
set made to ensure bim default views in target
print ((the string form of "default views made: ") + (the string form of (the length of made))) as a line
set again to ensure bim default views in target
print ((the string form of "made again: ") + (the string form of (the length of again))) as a line
set groundPlan to the item at 0 in made
set copy to duplicate bim view groundPlan named (the string form of "Begane grond - installaties") in target
set found to the bim view index of copy in modelValue
set copied to the item at found's position in (modelValue's views's values)
set copiedRules to the bim rules of view copied
toggle bim category bim wall category halftone in (the address of copiedRules)
toggle bim category bim grid category visibility in (the address of copiedRules)
set changed to the bim view copied ruled by copiedRules
set changed's scale to 50
set changed's cropped to true
set changed's cropLow to a cad vector2 with x -1.0 and y -1.0
set changed's cropHigh to a cad vector2 with x 10.0 and y 8.0
store bim view changed in target
list view test views of modelValue labelled (the string form of "views:")
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", ") + reread's message))) as a line
list view test views of reread's modelValue labelled (the string form of "from .bim:")
set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "v.ifcx") for project (the string form of "v") by (the string form of "test") at (the string form of "2026-10-09T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of ", ") + fromIfcx's message))) as a line
list view test views of fromIfcx's modelValue labelled (the string form of "from .ifcx:")
