# SPDX-License-Identifier: MPL-2.0
# Hit testing follows the visible 28px bar and 46px graphics rows.
import ui/panels/bim_view_panel.dl

function check view graphics {boolean:passed} named {a string:caption}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

check view graphics ((the bim view bar hit at (a cad vector2 with x 450.0 and y 610.0) ending at 800.0 and 600.0 scaled false) = 21) named (the string form of "section box has a direct control")
check view graphics ((the bim view bar hit at (a cad vector2 with x 520.0 and y 610.0) ending at 800.0 and 600.0 scaled false) = 13) named (the string form of "shadows remains directly accessible")
check view graphics ((the bim view bar hit at (a cad vector2 with x 600.0 and y 625.0) ending at 800.0 and 600.0 scaled false) = 20) named (the string form of "graphics uses full larger hit area")
check view graphics ((the bim view bar hit at (a cad vector2 with x 600.0 and y 628.0) ending at 800.0 and 600.0 scaled false) = -1) named (the string form of "bar does not consume clicks below it")
check view graphics ((the bim view bar hit at (a cad vector2 with x 450.0 and y 610.0) ending at 800.0 and 600.0 scaled true) = -1) named (the string form of "section box is not offered in flat views")
check view graphics ((the bim graphics choice at (a cad vector2 with x 410.0 and y 450.0) from 400.0 above 600.0 flat false) = -1) named (the string form of "graphics heading is not an option")
check view graphics ((the bim graphics choice at (a cad vector2 with x 660.0 and y 480.0) from 400.0 above 600.0 flat false) = 13) named (the string form of "shadow switch uses its visible row")
check view graphics ((the bim graphics choice at (a cad vector2 with x 410.0 and y 526.0) from 400.0 above 600.0 flat false) = 15) named (the string form of "model edges row maps correctly")
check view graphics ((the bim graphics choice at (a cad vector2 with x 410.0 and y 572.0) from 400.0 above 600.0 flat false) = 16) named (the string form of "rebar detail row maps correctly")
check view graphics ((the bim graphics choice at (a cad vector2 with x 410.0 and y 520.0) from 400.0 above 600.0 flat true) = 12) named (the string form of "flat graphics first row maps correctly")
check view graphics ((the bim graphics choice at (a cad vector2 with x 410.0 and y 570.0) from 400.0 above 600.0 flat true) = 14) named (the string form of "flat hatch row maps correctly")
