# SPDX-License-Identifier: MPL-2.0
# A crop edited as a sketch (#98): a polygon is kept as the view's outline
# and its box becomes the crop rectangle; a rectangle keeps no outline; a
# crossing polygon is refused; a handle scales the outline with its box; a
# click near the frame touches it; the mask covers the box outside the
# outline.
import views/common/bim_crop.dl

function check crop outline {boolean:condition} named {a string:name}:
    execute:
        if condition:
            print ((the string form of "PASS ") + name) as a line
        else:
            print ((the string form of "FAIL ") + name) as a line

function the crop outline test triangle area of {a pointer to a list:triangles}:
    execute:
        set total to 0.0
        set cursor to 0
        loop while (cursor + 2) < (the length of triangles):
            set first to the item at cursor in triangles
            set second to the item at (cursor + 1) in triangles
            set third to the item at (cursor + 2) in triangles
            set total to total + (the absolute value of ((((second's x - first's x) * (third's y - first's y)) - ((third's x - first's x) * (second's y - first's y))) * 0.5))
            set cursor to cursor + 3
        return total

function the crop outline test view of {a 64 bit integer:viewId} in {bim model record:modelValue}:
    execute:
        return the item at (the bim view index of viewId in modelValue)'s position in (modelValue's views's values)

set modelValue to an empty bim model
set target to the address of modelValue
set viewId to add bim view of kind (bim plan view) named (the string form of "Plan") on (1 as a 64 bit integer) to target

# An L: 10 by 8 with the upper right 4 by 3 left out, drawn clockwise.
set lShape to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to lShape
append (a cad vector2 with x 0.0 and y 8.0) to lShape
append (a cad vector2 with x 6.0 and y 8.0) to lShape
append (a cad vector2 with x 6.0 and y 5.0) to lShape
append (a cad vector2 with x 10.0 and y 5.0) to lShape
append (a cad vector2 with x 10.0 and y 0.0) to lShape
check crop outline (keep bim crop outline lShape of view viewId in target) named (the string form of "an L outline is accepted")
set viewValue to the crop outline test view of viewId in modelValue
check crop outline (viewValue's cropped and ((viewValue's cropLow's x = 0.0) and (viewValue's cropHigh's y = 8.0))) named (the string form of "the view is cropped to the outline's box")
check crop outline ((viewValue's cropHigh's x = 10.0) and (viewValue's cropLow's y = 0.0)) named (the string form of "the box reaches the outline's far corner")
check crop outline (bim crop view viewId has an outline in modelValue) named (the string form of "the outline is kept")
set kept to the bim crop outline of view viewId in modelValue
check crop outline ((the length of kept) = 6) named (the string form of "six corners are kept")
free kept
set drawn to the bim crop corners of viewValue in modelValue
set doubledArea to 0.0
loop cursor from 0 to the length of drawn:
    set here to the item at cursor in drawn
    set following to the item at (the remainder of (cursor + 1) divided by (the length of drawn)) in drawn
    set doubledArea to doubledArea + ((here's x * following's y) - (following's x * here's y))
check crop outline (doubledArea > 0.0) named (the string form of "the outline is kept anticlockwise")
free drawn

# The mask: the box (80) less the L (68), all of it on screen.
set mask to the bim crop mask of viewValue in modelValue within (a cad vector2 with x -100.0 and y -100.0) and (a cad vector2 with x 100.0 and y 100.0)
check crop outline ((the absolute value of ((the crop outline test triangle area of mask) - 12.0)) < 0.000001) named (the string form of "the mask covers the box outside the outline")
free mask
# Only the part on screen: the right half of the plan.
set mask to the bim crop mask of viewValue in modelValue within (a cad vector2 with x 8.0 and y -100.0) and (a cad vector2 with x 100.0 and y 100.0)
check crop outline ((the absolute value of ((the crop outline test triangle area of mask) - 6.0)) < 0.000001) named (the string form of "the mask is cut to the screen")
free mask

# A click near the frame touches it, also on the notch; inside does not.
set transform to @intrinsic("construct", a bim drawing transform record, a cad vector2 with x 0.0 and y 0.0, a cad vector2 with x 0.0 and y 0.0, 10.0)
check crop outline (bim crop of viewValue is touched at (a cad vector2 with x 80.0 and y -52.0) in modelValue through transform) named (the string form of "a click on the notch's edge touches the frame")
check crop outline ((bim crop of viewValue is touched at (a cad vector2 with x 30.0 and y -30.0) in modelValue through transform) = false) named (the string form of "a click inside does not")
check crop outline ((bim crop of viewValue is touched at (a cad vector2 with x 98.0 and y -78.0) in modelValue through transform) = false) named (the string form of "a click in the cut-away corner does not")

# The upper right handle scales the outline with its box.
drag bim crop of view viewId at handle 2 by (a cad vector2 with x 10.0 and y 8.0) in target
set viewValue to the crop outline test view of viewId in modelValue
check crop outline ((viewValue's cropHigh's x = 20.0) and (viewValue's cropHigh's y = 16.0)) named (the string form of "a handle drags the box")
set kept to the bim crop outline of view viewId in modelValue
set notch to the item at 3 in kept
check crop outline (((the length of kept) = 6) and ((notch's x = 12.0) or (notch's y = 10.0))) named (the string form of "the outline scales with it")
free kept
# The centre handle moves it.
drag bim crop of view viewId at handle 8 by (a cad vector2 with x 1.0 and y 2.0) in target
set viewValue to the crop outline test view of viewId in modelValue
check crop outline ((viewValue's cropLow's x = 1.0) and (viewValue's cropLow's y = 2.0)) named (the string form of "the centre handle moves the box")
set kept to the bim crop outline of view viewId in modelValue
set moved to the item at 5 in kept
check crop outline ((moved's x = 1.0) and (moved's y = 2.0)) named (the string form of "and the outline with it")
free kept

# A crossing outline is refused and leaves the crop as it was.
set bowTie to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to bowTie
append (a cad vector2 with x 4.0 and y 4.0) to bowTie
append (a cad vector2 with x 4.0 and y 0.0) to bowTie
append (a cad vector2 with x 0.0 and y 4.0) to bowTie
check crop outline ((keep bim crop outline bowTie of view viewId in target) = false) named (the string form of "a crossing outline is refused")
check crop outline (bim crop view viewId has an outline in modelValue) named (the string form of "the outline stays")

# A rectangle, with a corner on a straight run, keeps no outline.
set square to an empty list of a cad vector2
append (a cad vector2 with x 2.0 and y 1.0) to square
append (a cad vector2 with x 5.0 and y 1.0) to square
append (a cad vector2 with x 7.0 and y 1.0) to square
append (a cad vector2 with x 7.0 and y 4.0) to square
append (a cad vector2 with x 2.0 and y 4.0) to square
check crop outline (keep bim crop outline square of view viewId in target) named (the string form of "a rectangle is accepted")
set viewValue to the crop outline test view of viewId in modelValue
check crop outline ((bim crop view viewId has an outline in modelValue) = false) named (the string form of "a rectangle keeps no outline")
check crop outline ((viewValue's cropLow's x = 2.0) and (viewValue's cropHigh's x = 7.0)) named (the string form of "it is the crop rectangle")
set mask to the bim crop mask of viewValue in modelValue within (a cad vector2 with x -100.0 and y -100.0) and (a cad vector2 with x 100.0 and y 100.0)
check crop outline ((the length of mask) = 0) named (the string form of "a rectangle has no mask")
free mask
