# SPDX-License-Identifier: MPL-2.0
import materials/bim_section_materials.dl

function check section material {boolean:accepted} named {a string:label}:
    execute:
        if accepted = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the section material area of {fast mesh record:shape}:
    execute:
        set total to 0.0
        set cursor to 0
        loop while (cursor + 2) < (the length of (shape's triangles's values)):
            set a to the item at (the item at cursor in (shape's triangles's values)) in (shape's positions's values)
            set b to the item at (the item at (cursor + 1) in (shape's triangles's values)) in (shape's positions's values)
            set c to the item at (the item at (cursor + 2) in (shape's triangles's values)) in (shape's positions's values)
            set total to total + ((the cad length of (the cad cross of (the cad difference of b and a) and (the cad difference of c and a))) * 0.5)
            set cursor to cursor + 3
        return total

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "Baksteen", 0.1)) to layers
append (@intrinsic("construct", a bim layer record, the string form of "air", 0.05)) to layers
append (@intrinsic("construct", a bim layer record, the string form of "Isolatie", 0.12)) to layers
append (@intrinsic("construct", a bim layer record, the string form of "Beton", 0.2)) to layers
set wallType to add bim wall type named (the string form of "Layered wall") with layers to target
set wallId to add bim wall typed wallType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set windowType to add bim opening type named (the string form of "Window") sized 1.2 by 1.4 with sill 0.8 and frame 0.0 to target
ignore add bim opening typed windowType in wallId at 3.0 to target
set evaluation to the bim evaluation of modelValue after (an empty bim evaluation)
set previous to an empty list of a bim scene mesh record
set coarse to the bim scene meshes of evaluation after previous layered false
set fine to the bim scene meshes of evaluation after previous layered true
set low to a cad vector3 with x -1.0, y -1.0 and z -1.0
set high to a cad vector3 with x 7.0, y 1.0 and z 1.5
set coarseCaps to the bim cap meshes among (coarse's values) from low to high for evaluation
set fineCaps to the bim cap meshes among (fine's values) from low to high for evaluation
check section material ((the length of (coarseCaps's values)) = 3) named (the string form of "coarse walls retain three material cuts and an empty cavity")
check section material ((the length of (fineCaps's values)) = 3) named (the string form of "fine walls do not duplicate their layer cuts")
set layerAreasCorrect to true
set materialNamesCorrect to true
loop cursor from 0 to the length of (coarseCaps's values):
    set cap to the item at cursor in (coarseCaps's values)
    set thickness to 0.0
    if cap's material = (the string form of "Baksteen"):
        set thickness to 0.1
    else if cap's material = (the string form of "Isolatie"):
        set thickness to 0.12
    else if cap's material = (the string form of "Beton"):
        set thickness to 0.2
    else:
        set materialNamesCorrect to false
    if (the absolute value of ((the section material area of cap's shape) - (4.8 * thickness))) > 1e-7:
        set layerAreasCorrect to false
check section material materialNamesCorrect named (the string form of "cut solids preserve their original material names")
check section material layerAreasCorrect named (the string form of "each material cut excludes the window opening")
# Move the top face out of the wall, back through the window and below it.
# Every step starts from the same uncut source, as a live box drag must.
set movingCutsCorrect to true
loop dragStep from 0 to 4:
    set dragHeight to 1.5
    set expectedCutArea to 2.016
    if dragStep = 0:
        set dragHeight to 4.0
        set expectedCutArea to 0.0
    else if dragStep = 2:
        set dragHeight to 0.5
        set expectedCutArea to 2.52
    set movingCaps to the bim cap meshes among (coarse's values) from low to (a cad vector3 with x 7.0, y 1.0 and z dragHeight) for evaluation
    set movingArea to 0.0
    loop capCursor from 0 to the length of (movingCaps's values):
        set movingCap to the item at capCursor in (movingCaps's values)
        set movingArea to movingArea + (the section material area of movingCap's shape)
        loop pointCursor from 0 to the length of (movingCap's shape's positions's values):
            set cutPoint to the item at pointCursor in (movingCap's shape's positions's values)
            if (the absolute value of (cutPoint's z - dragHeight)) > 1e-7:
                set movingCutsCorrect to false
    if (the absolute value of (movingArea - expectedCutArea)) > 1e-7:
        set movingCutsCorrect to false
check section material movingCutsCorrect named (the string form of "moving box cuts follow the face and restore window gaps on reversal")
set firstCap to the item at 0 in (coarseCaps's values)
set changedCap to firstCap
set changedCap's material to the string form of "Timber"
check section material ((bim scene mesh changedCap repeats firstCap) = false) named (the string form of "same-colour material changes invalidate scene mesh reuse")
check section material (bim scene mesh firstCap repeats firstCap) named (the string form of "unchanged material geometry can reuse its mesh")
set floorModel to an empty bim model
set floorTarget to the address of floorModel
set floorLevel to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to floorTarget
set floorType to add bim planar type named (the string form of "Layered floor") as role bim floor planar role with layers to floorTarget
set outline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to outline
append (a cad vector2 with x 6.0 and y 0.0) to outline
append (a cad vector2 with x 6.0 and y 4.0) to outline
append (a cad vector2 with x 0.0 and y 4.0) to outline
set floorId to add bim plate typed floorType on floorLevel around outline at top 0.5 to floorTarget
set hole to an empty list of a cad vector2
append (a cad vector2 with x 2.5 and y 1.0) to hole
append (a cad vector2 with x 3.5 and y 1.0) to hole
append (a cad vector2 with x 3.5 and y 2.0) to hole
append (a cad vector2 with x 2.5 and y 2.0) to hole
set holeId to add bim plate opening on floorId around hole in floorTarget
check section material (holeId > 0) named (the string form of "the layered floor accepts a through opening")
set floorEvaluation to the bim evaluation of floorModel after (an empty bim evaluation)
set floorMeshes to the bim scene meshes of floorEvaluation after previous layered false
set floorCaps to the bim cap meshes among (floorMeshes's values) from low to (a cad vector3 with x 3.0, y 5.0 and z 5.0) for floorEvaluation
check section material ((the length of (floorCaps's values)) = 3) named (the string form of "coarse floors retain their individual material cuts")
set floorAreasCorrect to true
loop cursor from 0 to the length of (floorCaps's values):
    set cap to the item at cursor in (floorCaps's values)
    set thickness to 0.0
    if cap's material = (the string form of "Baksteen"):
        set thickness to 0.1
    else if cap's material = (the string form of "Isolatie"):
        set thickness to 0.12
    else if cap's material = (the string form of "Beton"):
        set thickness to 0.2
    if (the absolute value of ((the section material area of cap's shape) - (3.0 * thickness))) > 1e-7:
        set floorAreasCorrect to false
check section material floorAreasCorrect named (the string form of "every floor layer cut excludes the through opening")
ignore delete bim plate opening holeId on floorId in floorTarget
set closedEvaluation to the bim evaluation of floorModel after floorEvaluation
set closedMeshes to the bim scene meshes of closedEvaluation after (floorMeshes's values) layered false
set closedCaps to the bim cap meshes among (closedMeshes's values) from low to (a cad vector3 with x 3.0, y 5.0 and z 5.0) for closedEvaluation
set closedArea to 0.0
loop cursor from 0 to the length of (closedCaps's values):
    set closedArea to closedArea + (the section material area of ((the item at cursor in (closedCaps's values))'s shape))
check section material ((the absolute value of (closedArea - (4.0 * 0.42))) < 1e-7) named (the string form of "deleting an opening updates the evaluated layer cuts")
check section material (closedEvaluation's rebuilt = 1) named (the string form of "a settings-only opening edit rebuilds its host geometry")
check section material (bim plate floorId has openings in floorEvaluation's modelValue) named (the string form of "an earlier evaluation retains its opening settings")
set restoredModel to the bim snapshot of floorEvaluation's modelValue
set restoredModel's journal to a cad topology list of a 64 bit integer
set restoredEvaluation to the bim evaluation of restoredModel after closedEvaluation
set restoredMeshes to the bim scene meshes of restoredEvaluation after (closedMeshes's values) layered false
set restoredCaps to the bim cap meshes among (restoredMeshes's values) from low to (a cad vector3 with x 3.0, y 5.0 and z 5.0) for restoredEvaluation
set restoredArea to 0.0
loop cursor from 0 to the length of (restoredCaps's values):
    set restoredArea to restoredArea + (the section material area of ((the item at cursor in (restoredCaps's values))'s shape))
check section material ((restoredEvaluation's rebuilt = 1) and ((the absolute value of (restoredArea - (3.0 * 0.42))) < 1e-7)) named (the string form of "undo-style journal replacement restores opening geometry and cuts")
set typePosition to (the bim wall type index of floorType in floorModel)'s position
set changedType to the item at typePosition in (floorModel's wallTypes's values)
set changedType's layers to the cad clone of changedType's layers
set changedLayer to the item at 0 in (changedType's layers's values)
set changedLayer's material to the string form of "Timber"
replace item at index 0 in (changedType's layers's values) with changedLayer
replace item at index typePosition in (floorModel's wallTypes's values) with changedType
note bim change of floorType in floorTarget
set materialEvaluation to the bim evaluation of floorModel after closedEvaluation
check section material (materialEvaluation's rebuilt = 1) named (the string form of "changing layer material without thickness invalidates cached geometry")
free outline
free hole
free layers
free previous
