# SPDX-License-Identifier: MPL-2.0
# Elements hidden in a view for this session (HH hides the selection in the
# active view, HR restores what that view hides): pairs of a view and an
# element, kept by the editor, never in the model, its file or its undo.
# Nothing here draws or reads the model, so it is tested alone.
import kernel/core/topology_list.dl

class:
    patterns:
        [a|] bim hidden element record
    members:
        viewId as a 64 bit integer
        elementId as a 64 bit integer

# An empty set of hidden elements.
function no bim hidden elements:
    execute:
        return a cad topology list of a bim hidden element record

# Whether element `wanted` is hidden in view `viewId` among `hiddenPairs`.
function bim element {a 64 bit integer:wanted} is hidden in view {a 64 bit integer:viewId} among {a pointer to a list:hiddenPairs}:
    execute:
        loop cursor from 0 to the length of hiddenPairs:
            set pair to the item at cursor in hiddenPairs
            if (pair's viewId = viewId) and (pair's elementId = wanted):
                return true
        return false

# Hides the elements `elementIds` in view `viewId`: each once, however often
# it is asked. How many were not hidden there before.
function hide bim elements {a pointer to a list:elementIds} in view {a 64 bit integer:viewId} among {a pointer to a list:hiddenPairs}:
    execute:
        set added to 0
        loop cursor from 0 to the length of elementIds:
            set wanted to the item at cursor in elementIds
            if (bim element wanted is hidden in view viewId among hiddenPairs) = false:
                append (@intrinsic("construct", a bim hidden element record, viewId, wanted)) to hiddenPairs
                set added to added + 1
        return added

# Shows again every element hidden in view `viewId`; the other views keep
# theirs. How many were restored.
function restore bim hidden elements in view {a 64 bit integer:viewId} among {a pointer to a list:hiddenPairs}:
    execute:
        set restored to 0
        set cursor to (the length of hiddenPairs) - 1
        loop while cursor >= 0:
            if (the item at cursor in hiddenPairs)'s viewId = viewId:
                remove item cursor from hiddenPairs
                set restored to restored + 1
            set cursor to cursor - 1
        return restored

# The elements hidden in view `viewId`, in the order they were hidden.
function the bim hidden ids in view {a 64 bit integer:viewId} among {a pointer to a list:hiddenPairs}:
    execute:
        set found to a cad topology list of a 64 bit integer
        loop cursor from 0 to the length of hiddenPairs:
            set pair to the item at cursor in hiddenPairs
            if pair's viewId = viewId:
                append pair's elementId to (found's values)
        return found

# What a cache depends on of the elements hidden in view `viewId`: their
# ids, so that another set of as many elements gives another key.
function the bim hidden key in view {a 64 bit integer:viewId} among {a pointer to a list:hiddenPairs}:
    execute:
        set written to the string form of "hidden"
        loop cursor from 0 to the length of hiddenPairs:
            set pair to the item at cursor in hiddenPairs
            if pair's viewId = viewId:
                set written to (written + (the string form of ",")) + (the string form of pair's elementId)
        return written
