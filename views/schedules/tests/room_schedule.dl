# SPDX-License-Identifier: MPL-2.0
# The room schedule (drawing quality plan, item 9): one row per room across
# all storeys, with its number, name, storey and net floor area. A two-storey
# model: on the ground floor a saved region (0.01) and a kitchen (0.02, added
# first), on the first floor a bedroom (1.01) and a region no explicit space
# claims. The explicit spaces come by number, then the unsaved regions.
import views/schedules/bim_schedule.dl

function check room schedule {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function a room schedule rectangle from {a 64 bit floating-point number:left} to {a 64 bit floating-point number:right} by {a 64 bit floating-point number:depth}:
    execute:
        set corners to an empty list of a cad vector2
        append (a cad vector2 with x left and y 0.0) to corners
        append (a cad vector2 with x right and y 0.0) to corners
        append (a cad vector2 with x right and y depth) to corners
        append (a cad vector2 with x left and y depth) to corners
        return corners

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
set upper to add bim level named (the string form of "First floor") at 3.0 with height 3.0 to target
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to layerValues
set typeId to add bim wall type named (the string form of "Wall") with layerValues to target
set footprint to a room schedule rectangle from 0.0 to 6.0 by 4.0
loop corner from 0 to 4:
    ignore add bim wall typed typeId on ground from (the item at corner in footprint) to (the item at (the remainder of (corner + 1) divided by 4) in footprint) to target
    ignore add bim wall typed typeId on upper from (the item at corner in footprint) to (the item at (the remainder of (corner + 1) divided by 4) in footprint) to target
set groundRegions to the bim spaces of modelValue on level ground using (the bim join index of modelValue)
set kitchen to a room schedule rectangle from 10.0 to 13.0 by 3.0
ignore add bim space object named (the string form of "Kitchen") numbered (the string form of "0.02") on ground around kitchen high 2.5 to target
ignore add bim space object named (the string form of "Living room") numbered (the string form of "0.01") on ground around ((the item at 0 in (groundRegions's values))'s outline's values) high 2.5 to target
set bedroom to a room schedule rectangle from 10.0 to 14.0 by 3.0
ignore add bim space object named (the string form of "Bedroom") numbered (the string form of "1.01") on upper around bedroom high 2.75 to target

set evaluation to the bim evaluation of modelValue after (an empty bim evaluation)
set allRows to the bim schedule of modelValue with evaluation
set rooms to the bim rows of (allRows's values) in schedule 5
loop cursor from 0 to the length of (rooms's values):
    set row to the item at cursor in (rooms's values)
    set text to ((row's number + (the string form of " | ")) + row's name) + (the string form of " | ")
    set text to ((text + row's storey) + (the string form of " | ")) + (the bim schedule text of row's area)
    print ((text + (the string form of " | ")) + (the bim schedule text of row's volume)) as a line
check room schedule ((the length of (rooms's values)) = 4) named (the string form of "one row per room on both storeys")
set firstRoom to the item at 0 in (rooms's values)
check room schedule ((firstRoom's number = (the string form of "0.01")) and (firstRoom's count = 1)) named (the string form of "rooms by number within a storey")
check room schedule ((the item at 2 in (rooms's values))'s storey = (the string form of "First floor")) named (the string form of "the first floor after the ground floor")
check room schedule ((the absolute value of ((the item at 1 in (rooms's values))'s area - 9.0)) < 1e-9) named (the string form of "the kitchen's net floor area")
check room schedule ((the absolute value of ((the item at 3 in (rooms's values))'s area - (5.8 * 3.8))) < 1e-9) named (the string form of "the unsaved region's net floor area")
print (the bim schedule csv of (rooms's values)) as a line
