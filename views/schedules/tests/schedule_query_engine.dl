# SPDX-License-Identifier: MPL-2.0
# The SQL schedule engine (#129) over a hand-made table of walls: projection,
# WHERE, GROUP BY with the aggregates, HAVING, ORDER BY, LIMIT, DISTINCT, the
# operators and functions, a property column by "quoted name", and each kind
# of mistake reported as a message.
import views/schedules/bim_query.dl

function add engine wall {integer:wallId} typed {a string:typeName} on {a string:levelName} long {a 64 bit floating-point number:run} fire {a string:rating} to {a pointer to a bim query state record:target}:
    execute:
        add bim query cell (a bim query amount (wallId as a 64 bit floating-point number) with 0 decimals) to target
        add bim query cell (a bim query words typeName) to target
        add bim query cell (a bim query words levelName) to target
        add bim query cell (a bim query amount run with 2 decimals) to target
        if (the length of rating) = 0:
            add bim query cell (the bim query null) to target
        else:
            add bim query cell (a bim query words rating) to target

# The query over the five walls, printed as a table or as its message.
function run engine query {a string:sourceText}:
    execute:
        set prepared to a bim query read from sourceText
        if prepared's failed = false:
            add bim query column (the string form of "id") to (the address of prepared)
            add bim query column (the string form of "type") to (the address of prepared)
            add bim query column (the string form of "level") to (the address of prepared)
            add bim query column (the string form of "length") to (the address of prepared)
            add bim query column (the string form of "Pset_WallCommon.FireRating") to (the address of prepared)
            add engine wall 11 typed (the string form of "Brick 100") on (the string form of "00") long 4.0 fire (the string form of "60") to (the address of prepared)
            add engine wall 12 typed (the string form of "Brick 100") on (the string form of "00") long 2.5 fire (the string form of "") to (the address of prepared)
            add engine wall 13 typed (the string form of "Concrete 200") on (the string form of "00") long 6.25 fire (the string form of "90") to (the address of prepared)
            add engine wall 14 typed (the string form of "Brick 100") on (the string form of "01") long 3.0 fire (the string form of "30") to (the address of prepared)
            add engine wall 15 typed (the string form of "Concrete 200") on (the string form of "01") long 1.0 fire (the string form of "90") to (the address of prepared)
        set result to the bim query table evaluated from (the address of prepared)
        print (((the string form of "> ") + sourceText) trimmed) as a line
        if result's valid = false:
            print result's message as a line
            return nothing
        set headerLine to the string form of ""
        loop cursor from 0 to result's width:
            if cursor > 0:
                set headerLine to headerLine + (the string form of " | ")
            set headerLine to headerLine + (the item at cursor in (result's headers's values))
            if the item at cursor in (result's numeric's values):
                set headerLine to headerLine + (the string form of " (n)")
        print headerLine as a line
        loop rowCursor from 0 to the bim query rows of result:
            set rowLine to the string form of ""
            loop cursor from 0 to result's width:
                if cursor > 0:
                    set rowLine to rowLine + (the string form of " | ")
                set rowLine to rowLine + (the item at ((rowCursor * result's width) + cursor) in (result's cells's values))
            print (rowLine trimmed) as a line

run engine query (the string form of "SELECT * FROM walls")
run engine query (the string form of "select type, count(*), sum(length) from walls where level = '00' group by type")
run engine query (the string form of "SELECT level, COUNT(*) AS walls, SUM(length) AS total, AVG(length) AS mean, MIN(length), MAX(length) FROM walls GROUP BY level ORDER BY total DESC")
run engine query (the string form of "SELECT type, SUM(length) AS run FROM walls GROUP BY type HAVING COUNT(*) > 2")
run engine query (the string form of "SELECT id, length * 2 AS doubled, length / 3, -length, ROUND(length, 1), ROUND(length) FROM walls ORDER BY 2 DESC LIMIT 3")
run engine query (the string form of "SELECT COUNT(*), SUM(length), COUNT(\"Pset_WallCommon.FireRating\") FROM walls")
run engine query (the string form of "SELECT id, \"Pset_WallCommon.FireRating\" AS fire FROM walls WHERE \"pset_wallcommon.firerating\" >= 60 ORDER BY id DESC")
run engine query (the string form of "SELECT id FROM walls WHERE \"Pset_WallCommon.FireRating\" IS NULL OR type LIKE 'conc%' ORDER BY id")
run engine query (the string form of "SELECT id, type FROM walls WHERE level IN ('01', '02') AND NOT length BETWEEN 2 AND 3")
run engine query (the string form of "SELECT DISTINCT type, level FROM walls ORDER BY type, level DESC")
run engine query (the string form of "SELECT UPPER(type) || ' / ' || level AS label, LENGTH(type), COALESCE(\"Pset_WallCommon.FireRating\", 'none') FROM walls WHERE id <> 13 AND id != 15 -- a comment")
run engine query (the string form of "SELECT SUM(length) FROM walls WHERE id > 99")
run engine query (the string form of "SELECT type, level FROM walls ORDER BY type DESC, id")
run engine query (the string form of "SELECT 'it''s', 1.5 + 1, 7 / 2, 10 - 3 * 2, (10 - 3) * 2 FROM walls LIMIT 1")
# Output aliases take precedence in ORDER BY, including a source-column name.
run engine query (the string form of "SELECT id, -length AS length FROM walls ORDER BY length LIMIT 2")
# Mistakes, each a message.
run engine query (the string form of "SELECT length AS doubled FROM walls WHERE doubled > 0")
run engine query (the string form of "SELECT id FROM walls ORDER BY missing")
run engine query (the string form of "SELECT type walls")
run engine query (the string form of "SELECT colour FROM walls")
run engine query (the string form of "SELECT type FROM walls WHERE SUM(length) > 1")
run engine query (the string form of "SELECT type FROM walls WHERE level = '00")
run engine query (the string form of "SELECT MEDIAN(length) FROM walls")
run engine query (the string form of "SELECT type FROM walls ORDER BY")
run engine query (the string form of "SELECT type FROM walls LIMIT 2.5")
run engine query (the string form of "SELECT type FROM walls extra")
run engine query (the string form of "SELECT type # FROM walls")
run engine query (the string form of "")
set invalidQuery to a bim query read from (the string form of "SELECT a FROM")
print (the bim query csv of (the bim query table evaluated from (the address of invalidQuery)))
set csvQuery to a bim query read from (the string form of "SELECT name, area FROM rooms")
add bim query column (the string form of "name") to (the address of csvQuery)
add bim query column (the string form of "area") to (the address of csvQuery)
add bim query cell (a bim query words (the string form of "Living, dining")) to (the address of csvQuery)
add bim query cell (a bim query amount 31.5 with 2 decimals) to (the address of csvQuery)
add bim query cell (a bim query words (the string form of "The \"den\"")) to (the address of csvQuery)
add bim query cell (a bim query amount 9.0 with 2 decimals) to (the address of csvQuery)
print (the bim query csv of (the bim query table evaluated from (the address of csvQuery)))
