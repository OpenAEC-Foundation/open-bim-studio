# SPDX-License-Identifier: MPL-2.0
# A floor that runs into the walls under it is scheduled less what lies
# inside them (a wall takes precedence over the floor, as a section draws
# it): four walls of 200 mm round 4 by 3 m carry a floor of 250 mm drawn on
# their centrelines, so the inner halves of the walls lie in the floor.
import views/schedules/bim_schedule.dl

function the net floor test cubic {a 64 bit floating-point number:value}:
    execute:
        return (@intrinsic("call", "libc", "round", a 64 bit floating-point number, value * 10000.0)) / 10000.0

set floorModel to an empty bim model
set modelAddress to the address of floorModel
set lowerLevel to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to modelAddress
set upperLevel to add bim level named (the string form of "First") at 3.0 with height 3.0 to modelAddress
set panelLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.2)) to panelLayers
set panelType to add bim wall type named (the string form of "Panel 200") with panelLayers to modelAddress
ignore add bim wall typed panelType on lowerLevel from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to modelAddress
ignore add bim wall typed panelType on lowerLevel from (a cad vector2 with x 4.0 and y 0.0) to (a cad vector2 with x 4.0 and y 3.0) to modelAddress
ignore add bim wall typed panelType on lowerLevel from (a cad vector2 with x 4.0 and y 3.0) to (a cad vector2 with x 0.0 and y 3.0) to modelAddress
ignore add bim wall typed panelType on lowerLevel from (a cad vector2 with x 0.0 and y 3.0) to (a cad vector2 with x 0.0 and y 0.0) to modelAddress
set floorOutline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to floorOutline
append (a cad vector2 with x 4.0 and y 0.0) to floorOutline
append (a cad vector2 with x 4.0 and y 3.0) to floorOutline
append (a cad vector2 with x 0.0 and y 3.0) to floorOutline
set floorId to add bim slab on upperLevel around floorOutline thick 0.25 to modelAddress
set floorValue to the item at (the bim slab index of floorId in floorModel)'s position in (floorModel's slabs's values)
set insideWalls to the bim volume of plate floorValue inside the walls of floorModel using (the bim join index of floorModel)
print ((the string form of "floor inside the walls: ") + (the string form of (the net floor test cubic insideWalls))) as a line
set evaluation to the bim evaluation of floorModel after (an empty bim evaluation)
set schedule to the bim schedule of floorModel with evaluation
loop rowCursor from 0 to the length of (schedule's values):
    set row to the item at rowCursor in (schedule's values)
    if row's area > 0.0:
        print ((((row's group + (the string form of " / ")) + row's name) + ((the string form of ": area ") + (the string form of (the net floor test cubic row's area)))) + ((the string form of ", volume ") + (the string form of (the net floor test cubic row's volume)))) as a line
