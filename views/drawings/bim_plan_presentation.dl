# A view-local technical palette, shared by the model plan and sheet output.
import bim/bim_model.dl

function bim technical plan setting:
    replacement:
        2400400

# Whether view `viewId` uses the technical palette: as its setting says (1
# technical, 0 the model review), or, when it has none, when it is a plan
# with a drawing type, which is a drawing for paper (NEN black on white).
function bim view {a 64 bit integer:viewId} uses a technical palette in {bim model record:modelValue}:
    execute:
        set reading to the bim setting (bim technical plan setting) of viewId in modelValue
        if reading's found:
            return reading's value = (1 as a 64 bit integer)
        set found to the bim view index of viewId in modelValue
        if found's valid = false:
            return false
        set viewValue to the item at found's position in (modelValue's views's values)
        return (viewValue's kind = bim plan view) and (viewValue's drawingTypeId != the bim refused id)

# Head mask: 0 none, 1 start, 2 finish, 3 both. Missing means both.
function bim grid head setting:
    replacement:
        2400410

function the bim head mask of grid {a 64 bit integer:gridId} in {bim model record:modelValue}:
    execute:
        set reading to the bim setting (bim grid head setting) of gridId in modelValue
        if reading's found:
            if (reading's value >= (0 as a 64 bit integer)) and (reading's value <= (3 as a 64 bit integer)):
                return reading's value as an integer
        return 3

function the bim name of grid head mask {integer:mask}:
    execute:
        if mask = 0:
            return the string form of "None"
        if mask = 1:
            return the string form of "Start"
        if mask = 2:
            return the string form of "Finish"
        return the string form of "Both"
