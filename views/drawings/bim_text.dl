# SPDX-License-Identifier: MPL-2.0
# Text drawing through a glyph atlas. Latin-1 characters and shaped Lao
# glyphs of several faces (a font file at a pixel size) are rendered once,
# at start, into one single-channel texture; a line of text is then one batch
# of textured triangles. Glyphs are rendered with FreeType's light hinting,
# which keeps proportional text crisp at small sizes without distorting its
# shapes. Widths come from the glyphs' advances, so layouts can measure text.
# The window has one texture, so the interface's icons (`icons/ui-icons.txt`)
# sit in the same atlas, below the faces.
import viewer/vulkan/graphics.dl
import lib/string.dl
import lib/text.dl
import localisation/bim_utf8.dl
import localisation/bim_catalogue.dl

# FreeType's face and glyph slot records, as far as the atlas reads them.
# FT_FaceRec — font face metadata
# Mirrors the C struct field-by-field up to 'glyph'
class:
    patterns:
        [an|] FT face
    members:
        face count as a C long integer
        face index as a C long integer
        face flags as a C long integer
        style flags as a C long integer
        glyph count as a C long integer
        family name as a pointer
        style name as a pointer
        fixed size count as an integer
        available sizes as a pointer
        character map count as an integer
        charmaps as a pointer
        generic data as a pointer
        generic finalizer as a pointer
        bounding box minimum x as a C long integer
        bounding box minimum y as a C long integer
        bounding box maximum x as a C long integer
        bounding box maximum y as a C long integer
        units per EM as a 16 bit integer
        ascender as a 16 bit integer
        descender as a 16 bit integer
        height as a 16 bit integer
        maximum horizontal advance as a 16 bit integer
        maximum vertical advance as a 16 bit integer
        underline position as a 16 bit integer
        underline thickness as a 16 bit integer
        glyph as a pointer

# FT_GlyphSlotRec — rendered glyph data
# Mirrors the C struct field-by-field up to 'bitmap_top'
class:
    patterns:
        [an|] FT glyph slot
    members:
        library as a pointer
        face as a pointer
        next as a pointer
        glyph index as an integer
        generic data as a pointer
        generic finalizer as a pointer
        metrics width as a C long integer
        metrics height as a C long integer
        horizontal bearing x as a C long integer
        horizontal bearing y as a C long integer
        horizontal advance as a C long integer
        vertical bearing x as a C long integer
        vertical bearing y as a C long integer
        vertical advance as a C long integer
        linear horizontal advance as a C long integer
        linear vertical advance as a C long integer
        advance x as a C long integer
        advance y as a C long integer
        format as an integer
        padding:
            8
        bitmap rows as an integer
        bitmap width as an integer
        bitmap pitch as an integer
        bitmap buffer as a pointer
        bitmap number of gray levels as a 16 bit integer
        bitmap pixel mode as a byte
        bitmap palette mode as a byte
        bitmap palette as a pointer
        bitmap left as an integer
        bitmap top as an integer


# One printable character: its bitmap's size and offsets from the pen in
# pixels, the pen's advance, and its cell in the atlas.
class:
    patterns:
        [a|] bim glyph record
    members:
        width as an integer
        height as an integer
        left as an integer
        top as an integer
        advance as an integer
        column as an integer
        row as an integer

# One face of the atlas: its glyphs, its cells' size, where its rows start in
# the atlas, and its line height (ascender to descender) and ascender.
class:
    patterns:
        [a|] bim text face record
    members:
        glyphs as the type of (an empty list of a bim glyph record)
        cellWidth as an integer
        cellHeight as an integer
        top as an integer
        lineHeight as an integer
        ascent as an integer

# One interface icon as `icons/ui-icons.txt` holds it: its glyph (as `bim
# icon ...` in bim_ui.dl), its size in pixels, its part (0 drawn in the
# primary colour, 1 in the accent) and its coverage, a byte per pixel.
class:
    patterns:
        [a|] bim icon image record
    members:
        glyph as an integer
        size as an integer
        part as an integer
        coverage as a string

# Where an icon image sits in the atlas: its top left pixel.
class:
    patterns:
        [a|] bim icon cell record
    members:
        glyph as an integer
        size as an integer
        part as an integer
        x as an integer
        y as an integer

class:
    patterns:
        [a|] bim text atlas record
    members:
        texture as a graphics texture
        faces as the type of (an empty list of a bim text face record)
        atlasWidth as an integer
        atlasHeight as an integer
        icons as the type of (an empty list of a bim icon cell record)
        messages as a bim message catalogue record
        fallbackFaces as the type of (an empty list of a pointer)
        fallbackBase as an integer

# The faces every atlas holds, by index.
function bim text body:
    replacement:
        0
function bim text small:
    replacement:
        1
function bim text caption:
    replacement:
        2
function bim text bold:
    replacement:
        3
function bim text heading:
    replacement:
        4
# Text in the drawing (osifont, 13 pixels), as Open 2D Studio letters it.
function bim text drawing:
    replacement:
        5
# The OpenAEC style's faces (Style Repo 0.4): mono labels (JetBrains Mono,
# 11 pixels, drawn in capitals), mono figures (12), semibold (Inter, 12)
# and medium (12).
function bim text mono label:
    replacement:
        6
function bim text mono:
    replacement:
        7
function bim text semibold:
    replacement:
        8
function bim text medium:
    replacement:
        9

function the bim first printable code:
    replacement:
        32
function the bim printable count:
    replacement:
        95
function the bim atlas columns:
    replacement:
        64

# Keep ASCII and the two diameter glyphs stable, then Latin-1 and the euro.
# Lao uses shaped glyph IDs in a separate fallback face, not character slots.
function the bim atlas glyph count:
    replacement:
        192

function the bim atlas code at {integer:index}:
    execute:
        if index < (the bim printable count):
            return (the bim first printable code) + index
        if index = (the bim printable count):
            return 216
        if index = ((the bim printable count) + 1):
            return 248
        if index = 191:
            return 8364
        set unicodeCode to 160 + (index - 97)
        if unicodeCode >= 216:
            set unicodeCode to unicodeCode + 1
        if unicodeCode >= 248:
            set unicodeCode to unicodeCode + 1
        return unicodeCode

# Light hinting (FT_LOAD_TARGET_LIGHT) and rendering (FT_LOAD_RENDER).
local function load bim glyph {integer:code} of {pointer:face}:
    execute:
        set error to @intrinsic("call", "freetype", "FT_Load_Char", an integer, face, code as a C long integer, 65540)
        if error != 0:
            print ((the string form of "Could not render character ") + (the string form of code)) as a line
            @intrinsic("call", "libc", "abort", nothing)

local function load bim indexed glyph {integer:index} of {pointer:face}:
    execute:
        set error to @intrinsic("call", "freetype", "FT_Load_Glyph", an integer, face, index as a 32 bit unsigned integer, 65540)
        if error != 0:
            @intrinsic("call", "libc", "abort", nothing)

local function the bim glyph slot of {pointer:face}:
    execute:
        set metadata to face as a pointer to an FT face
        return (the glyph of metadata) as a pointer to an FT glyph slot

class:
    patterns:
        [a|] bim text atlas result record
    members:
        valid as a boolean
        atlas as a bim text atlas record

# A face of the font at `path`, `size` pixels high, or no face (a null
# pointer) when FreeType cannot load it.
local function the bim font face at {a string:path} sized {integer:size} through {pointer:library}:
    execute:
        set loaded to 0 as a pointer
        if (@intrinsic("call", "freetype", "FT_New_Face", an integer, library, the data of path, 0 as a C long integer, the address of loaded)) != 0:
            return 0 as a pointer
        if (@intrinsic("call", "freetype", "FT_Set_Pixel_Sizes", an integer, loaded, 0 as a 32 bit integer, size as a 32 bit integer)) != 0:
            return 0 as a pointer
        return loaded

function the bim text atlas from regular font at {a string:regularPath} and bold font at {a string:boldPath} for {pointer:window}:
    execute:
        return the bim text atlas from regular font at regularPath and bold font at boldPath and drawing font at (the string form of "") for window

# `wanted` when a file is there, else `fallback`.
function the bim font file {a string:wanted} falling back to {a string:fallback}:
    execute:
        set handle to @intrinsic("call", "libc", "fopen", a pointer to a byte, the data of wanted, "rb")
        if handle = (0 as a pointer to a byte):
            return fallback
        ignore @intrinsic("call", "libc", "fclose", integer, handle)
        return wanted

function the bim text atlas from regular font at {a string:regularPath} and bold font at {a string:boldPath} and drawing font at {a string:drawingPath} for {pointer:window}:
    execute:
        set none to the string form of ""
        return the bim text atlas from regular font at regularPath and bold font at boldPath and drawing font at drawingPath and mono font at none and medium font at none with icons from none for window

# The atlas of the faces body (13 pixels), small (12), caption (11), bold (13),
# heading (15 bold), drawing (13, the font at `drawingPath`), mono label (11,
# the font at `monoPath`), mono (12), semibold (12, the bold font) and medium
# (12, the font at `mediumPath`) from the fonts at `regularPath` and
# `boldPath`, the regular font standing in for a missing one; and below them
# the icons in the file at `iconPath`, none when it cannot be read. Invalid
# when the regular font cannot be loaded.
function the bim text atlas from regular font at {a string:regularPath} and bold font at {a string:boldPath} and drawing font at {a string:drawingPath} and mono font at {a string:monoPath} and medium font at {a string:mediumPath} with icons from {a string:iconPath} for {pointer:window}:
    execute:
        return the bim text atlas from regular font at regularPath and bold font at boldPath and drawing font at drawingPath and mono font at monoPath and medium font at mediumPath and Lao font at (the string form of "") with icons from iconPath for window

function the bim text atlas from regular font at {a string:regularPath} and bold font at {a string:boldPath} and drawing font at {a string:drawingPath} and mono font at {a string:monoPath} and medium font at {a string:mediumPath} and Lao font at {a string:laoPath} with icons from {a string:iconPath} for {pointer:window}:
    execute:
        set library to 0 as a pointer
        set nothingLoaded to @intrinsic("construct", a bim text atlas record, @intrinsic("construct", a graphics texture, 0 as a pointer to a byte, 0, 0), an empty list of a bim text face record, 0, 0, an empty list of a bim icon cell record, an empty bim message catalogue, an empty list of a pointer, -1)
        if (@intrinsic("call", "freetype", "FT_Init_FreeType", an integer, the address of library)) != 0:
            return @intrinsic("construct", a bim text atlas result record, false, nothingLoaded)
        set sources to an empty list of a pointer
        append (the bim font face at regularPath sized 13 through library) to sources
        append (the bim font face at regularPath sized 12 through library) to sources
        append (the bim font face at regularPath sized 11 through library) to sources
        append (the bim font face at boldPath sized 13 through library) to sources
        append (the bim font face at boldPath sized 15 through library) to sources
        append (the bim font face at drawingPath sized 13 through library) to sources
        append (the bim font face at monoPath sized 11 through library) to sources
        append (the bim font face at monoPath sized 12 through library) to sources
        append (the bim font face at boldPath sized 12 through library) to sources
        append (the bim font face at mediumPath sized 12 through library) to sources
        if (the item at 0 in sources) = (0 as a pointer):
            free sources
            return @intrinsic("construct", a bim text atlas result record, false, nothingLoaded)
        set sizes to an empty list of an integer
        append 13 to sizes
        append 12 to sizes
        append 11 to sizes
        append 13 to sizes
        append 15 to sizes
        append 13 to sizes
        append 11 to sizes
        append 12 to sizes
        append 12 to sizes
        append 12 to sizes
        loop faceCursor from 3 to the length of sources:
            if (the item at faceCursor in sources) = (0 as a pointer):
                replace item at index faceCursor in sources with (the bim font face at regularPath sized (the item at faceCursor in sizes) through library)
        set fallbackFaces to an empty list of a pointer
        set fallbackBase to -1
        if ((the length of laoPath) > 0) and ((@intrinsic("call", "obs_platform", "obs_platform_has_text_shaper", a 64 bit integer)) = (1 as a 64 bit integer)):
            set loaded to true
            loop cursor from 0 to the length of sizes:
                set fallbackFace to the bim font face at laoPath sized (the item at cursor in sizes) through library
                if fallbackFace = (0 as a pointer):
                    set loaded to false
                append fallbackFace to fallbackFaces
            if loaded:
                set fallbackBase to the length of sources
                loop cursor from 0 to the length of fallbackFaces:
                    append (the item at cursor in fallbackFaces) to sources
            else:
                clear fallbackFaces
        free sizes
        set iconImages to the bim icon images at iconPath
        set made to the bim text atlas of sources indexed from fallbackBase with icons iconImages for window
        set made's fallbackFaces to fallbackFaces
        set made's fallbackBase to fallbackBase
        free iconImages
        free sources
        return @intrinsic("construct", a bim text atlas result record, true, made)

# The byte at `spot` of `content`, or a line end past its end.
local function the bim icon byte {integer:spot} of {a string:content}:
    execute:
        if (spot < 0) or (spot >= (the length of content)):
            return 10
        return (the character at spot in content) as an integer

# The value of hexadecimal digit `letter` (a character code).
local function the bim hex digit {integer:letter}:
    execute:
        if (letter >= 48) and (letter <= 57):
            return letter - 48
        if (letter >= 97) and (letter <= 102):
            return letter - 87
        if (letter >= 65) and (letter <= 70):
            return letter - 55
        return 0

# The icon images in the file at `path`, as tools/make_ui_icons.py writes
# them: a line per image, "glyph size part" and the coverage in hex; lines
# starting with # are comments. None when the file cannot be read.
function the bim icon images at {a string:path}:
    execute:
        set found to an empty list of a bim icon image record
        if (the length of path) = 0:
            return found
        set handle to @intrinsic("call", "libc", "fopen", a pointer to a byte, the data of path, "rb")
        if handle = (0 as a pointer to a byte):
            return found
        # Its size in 64 bits on every platform, read from the start again
        # (`platform/obs_platform.c`).
        set stored to @intrinsic("call", "obs_platform", "obs_platform_file_size", a 64 bit integer, handle)
        if stored <= (0 as a 64 bit integer):
            ignore @intrinsic("call", "libc", "fclose", integer, handle)
            return found
        set content to a new string buffer containing (stored as an integer) bytes
        set got to @intrinsic("call", "libc", "fread", a word sized integer, the data of content, 1 as a word sized integer, stored as a word sized integer, handle)
        ignore @intrinsic("call", "libc", "fclose", integer, handle)
        set total to got as an integer
        set cursor to 0
        loop while cursor < total:
            set first to the bim icon byte cursor of content
            if (first < 48) or (first > 57):
                # A comment or an empty line: on to the next line.
                loop while (the bim icon byte cursor of content) != 10:
                    set cursor to cursor + 1
                set cursor to cursor + 1
            else:
                set fields to an empty list of an integer
                loop while (the length of fields) < 3:
                    set number to 0
                    set letter to the bim icon byte cursor of content
                    loop while (letter >= 48) and (letter <= 57):
                        set number to (number * 10) + (letter - 48)
                        set cursor to cursor + 1
                        set letter to the bim icon byte cursor of content
                    append number to fields
                    if letter = 32:
                        set cursor to cursor + 1
                set side to the item at 1 in fields
                set pixels to a new string buffer containing (side * side) bytes
                loop dot from 0 to side * side:
                    set high to the bim hex digit (the bim icon byte (cursor + (dot * 2)) of content)
                    set low to the bim hex digit (the bim icon byte ((cursor + (dot * 2)) + 1) of content)
                    store (((high * 16) + low) as a byte) into the data of pixels at dot
                append (@intrinsic("construct", a bim icon image record, the item at 0 in fields, side, the item at 2 in fields, pixels)) to found
                free fields
                set cursor to cursor + ((side * side) * 2)
                loop while (the bim icon byte cursor of content) != 10:
                    set cursor to cursor + 1
                set cursor to cursor + 1
        return found

# The atlas of the FreeType faces `sources`, each at its pixel size, and the
# icon images `images` stacked in one texture of `window`.
function the bim text atlas of {a pointer to a list:sources} with icons {a pointer to a list:images} for {pointer:window}:
    execute:
        return the bim text atlas of sources indexed from -1 with icons images for window

function the bim text atlas of {a pointer to a list:sources} indexed from {integer:fallbackBase} with icons {a pointer to a list:images} for {pointer:window}:
    execute:
        set faces to an empty list of a bim text face record
        set atlasWidth to 1
        set atlasHeight to 0
        loop faceCursor from 0 to the length of sources:
            set face to the item at faceCursor in sources
            set glyphs to an empty list of a bim glyph record
            set widest to 1
            set tallest to 1
            set usesIndexedGlyphs to (fallbackBase >= 0) and (faceCursor >= fallbackBase)
            set glyphCount to the bim atlas glyph count
            if usesIndexedGlyphs:
                set metadata to face as a pointer to an FT face
                set glyphCount to (the glyph count of metadata) as an integer
            loop index from 0 to glyphCount:
                if usesIndexedGlyphs:
                    load bim indexed glyph index of face
                else:
                    load bim glyph (the bim atlas code at index) of face
                set slot to the bim glyph slot of face
                set width to the bitmap width of slot
                set height to the bitmap rows of slot
                set widest to the maximum of widest and width
                set tallest to the maximum of tallest and height
                set advance to (((the advance x of slot) + (32 as a C long integer)) / (64 as a C long integer)) as an integer
                append (@intrinsic("construct", a bim glyph record, width, height, the bitmap left of slot, the bitmap top of slot, advance, the remainder of index divided by (the bim atlas columns), index / (the bim atlas columns))) to glyphs
            # A blank pixel around each cell keeps filtering from bleeding.
            set cellWidth to widest + 2
            set cellHeight to tallest + 2
            set rows to (glyphCount + ((the bim atlas columns) - 1)) / (the bim atlas columns)
            set lineHeight to cellHeight
            set ascent to tallest
            append (@intrinsic("construct", a bim text face record, glyphs, cellWidth, cellHeight, atlasHeight, lineHeight, ascent)) to faces
            set atlasWidth to the maximum of atlasWidth and (cellWidth * (the bim atlas columns))
            set atlasHeight to atlasHeight + (cellHeight * rows)
        # The icons on shelves below the faces, a blank pixel around each.
        set cells to an empty list of a bim icon cell record
        set shelfX to 0
        set shelfY to atlasHeight
        set shelfHeight to 0
        loop imageCursor from 0 to the length of images:
            set image to the item at imageCursor in images
            set span to image's size + 2
            if (shelfX + span) > atlasWidth:
                set shelfX to 0
                set shelfY to shelfY + shelfHeight
                set shelfHeight to 0
            append (@intrinsic("construct", a bim icon cell record, image's glyph, image's size, image's part, shelfX + 1, shelfY + 1)) to cells
            set shelfX to shelfX + span
            set shelfHeight to the maximum of shelfHeight and span
        set atlasHeight to shelfY + shelfHeight
        set pixels to a new string buffer containing (atlasWidth * atlasHeight) bytes
        loop cursor from 0 to atlasWidth * atlasHeight:
            store (0 as a byte) into the data of pixels at cursor
        loop faceCursor from 0 to the length of sources:
            set face to the item at faceCursor in sources
            set entry to the item at faceCursor in faces
            set usesIndexedGlyphs to (fallbackBase >= 0) and (faceCursor >= fallbackBase)
            set glyphCount to the bim atlas glyph count
            if usesIndexedGlyphs:
                set metadata to face as a pointer to an FT face
                set glyphCount to (the glyph count of metadata) as an integer
            loop index from 0 to glyphCount:
                if usesIndexedGlyphs:
                    load bim indexed glyph index of face
                else:
                    load bim glyph (the bim atlas code at index) of face
                set slot to the bim glyph slot of face
                set glyph to the item at index in (entry's glyphs)
                set source to (the bitmap buffer of slot) as a pointer to a byte
                set pitch to the bitmap pitch of slot
                set originX to (glyph's column * entry's cellWidth) + 1
                set originY to (entry's top + (glyph's row * entry's cellHeight)) + 1
                loop line from 0 to glyph's height:
                    loop dot from 0 to glyph's width:
                        set value to @intrinsic("dereference", source + ((line * pitch) + dot))
                        store value into the data of pixels at (((originY + line) * atlasWidth) + (originX + dot))
        loop imageCursor from 0 to the length of images:
            set image to the item at imageCursor in images
            set cell to the item at imageCursor in cells
            loop line from 0 to image's size:
                loop dot from 0 to image's size:
                    store (the character at ((line * image's size) + dot) in image's coverage) into the data of pixels at (((cell's y + line) * atlasWidth) + (cell's x + dot))
        set texture to a new red texture sized atlasWidth by atlasHeight from ((the data of pixels) as a pointer) for window
        return @intrinsic("construct", a bim text atlas record, texture, faces, atlasWidth, atlasHeight, cells, an empty bim message catalogue, an empty list of a pointer, -1)

local function add bim atlas corner {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} at texture {a 64 bit floating-point number:u} and {a 64 bit floating-point number:v} to {graphics frame:frame}:
    execute:
        use texture coordinates x (u as a floating-point number) and y (v as a floating-point number) in frame
        add a vertex at x x and y y to frame

local function the bim glyph number of {integer:code}:
    execute:
        if (code >= 32) and (code <= 126):
            return code - 32
        if code = 216:
            return 95
        if code = 248:
            return 96
        if code = 8364:
            return 191
        if (code >= 160) and (code <= 255):
            set index to 97 + (code - 160)
            if code > 216:
                set index to index - 1
            if code > 248:
                set index to index - 1
            return index
        return 31

class:
    patterns:
        [a|] bim glyph step record
    members:
        glyph as an integer
        size as an integer

function the bim character step of {a string:message} at {integer:position}:
    execute:
        set decoded to the bim unicode step of message at position
        return @intrinsic("construct", a bim glyph step record, the bim glyph number of decoded's codepoint, the maximum of 1 and decoded's size)

# Exactly six int64 fields, matching obs_shaped_glyph in the platform bridge.
class:
    patterns:
        [a|] bim shaped glyph record
    members:
        glyph as a 64 bit integer
        cluster as a 64 bit integer
        advanceX as a 64 bit integer
        advanceY as a 64 bit integer
        offsetX as a 64 bit integer
        offsetY as a 64 bit integer

class:
    patterns:
        [a|] bim shaped run record
    members:
        valid as a boolean
        glyphs as a pointer to a bim shaped glyph record
        count as an integer

function the bim shaped text {a string:message} using {pointer:fontFace}:
    execute:
        set missing to @intrinsic("construct", a bim shaped run record, false, 0 as a pointer to a bim shaped glyph record, 0)
        set count to @intrinsic("call", "obs_platform", "obs_platform_shape_utf8", a 64 bit integer, fontFace, the data of message, (the length of message) as a 64 bit integer, 0 as a pointer to a bim shaped glyph record, 0 as a 64 bit integer)
        if (count <= (0 as a 64 bit integer)) or (count > (4096 as a 64 bit integer)):
            return missing
        set glyphs to @intrinsic("call", "libc", "malloc", a pointer to a bim shaped glyph record, (count * (48 as a 64 bit integer)) as a word sized unsigned integer)
        if glyphs = (0 as a pointer to a bim shaped glyph record):
            return missing
        set copied to @intrinsic("call", "obs_platform", "obs_platform_shape_utf8", a 64 bit integer, fontFace, the data of message, (the length of message) as a 64 bit integer, glyphs, count)
        if copied != count:
            @intrinsic("call", "libc", "free", nothing, glyphs)
            return missing
        return @intrinsic("construct", a bim shaped run record, true, glyphs, count as an integer)

function the bim text width of {a string:message} in face {integer:faceIndex} of {bim text atlas record:atlas}:
    execute:
        if (the length of atlas's faces) = 0:
            return 0.0
        if ((faceIndex >= 0) and (faceIndex < (the length of atlas's fallbackFaces))) and (bim text message contains Lao):
            set shaped to the bim shaped text message using (the item at faceIndex in atlas's fallbackFaces)
            if shaped's valid:
                set advance to 0 as a 64 bit integer
                loop cursor from 0 to shaped's count:
                    set advance to advance + (the item at cursor in shaped's glyphs)'s advanceX
                @intrinsic("call", "libc", "free", nothing, shaped's glyphs)
                return (advance as a 64 bit floating-point number) / 64.0
        set entry to the item at faceIndex in (atlas's faces)
        set total to 0
        set position to 0
        loop while position < (the length of message):
            set stepped to the bim character step of message at position
            set total to total + (the item at (stepped's glyph) in (entry's glyphs))'s advance
            set position to position + (stepped's size)
        return total as a 64 bit floating-point number

# The width in pixels of `message` in the body face of `atlas`.
function the bim text width of {a string:message} in {bim text atlas record:atlas}:
    execute:
        return the bim text width of message in face (bim text body) of atlas

# Draws `message` in face `faceIndex` with its baseline starting at `x`, `y` in
# pixels, in one batch. Unsupported scripts fall back to `?`.
# Lao marks are positioned by HarfBuzz in 26.6 pixels; atlas slots here
# contain all glyph IDs of the fallback font, including contextual forms.
function draw bim shaped text {a string:message} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in face {integer:faceIndex} with {bim text atlas record:atlas} coloured {integer:red}, {integer:green} and {integer:blue} cut at {a 64 bit floating-point number:rightEdge} in {graphics frame:frame}:
    execute:
        if ((atlas's fallbackBase < 0) or (faceIndex < 0)) or (faceIndex >= (the length of atlas's fallbackFaces)):
            return false
        set shapedRun to the bim shaped text message using (the item at faceIndex in atlas's fallbackFaces)
        if shapedRun's valid = false:
            return false
        set entry to the item at (atlas's fallbackBase + faceIndex) in atlas's faces
        set penX to x
        set penY to y
        start triangles using atlas's texture in frame
        use vertex color red red, green green and blue blue in frame
        loop cursor from 0 to shapedRun's count:
            set placed to the item at cursor in shapedRun's glyphs
            if (placed's glyph >= (0 as a 64 bit integer)) and (placed's glyph < ((the length of entry's glyphs) as a 64 bit integer)):
                set glyph to the item at (placed's glyph as an integer) in entry's glyphs
                set west to penX + ((placed's offsetX as a 64 bit floating-point number) / 64.0) + (glyph's left as a 64 bit floating-point number)
                set north to penY - ((placed's offsetY as a 64 bit floating-point number) / 64.0) - (glyph's top as a 64 bit floating-point number)
                set east to west + (glyph's width as a 64 bit floating-point number)
                set south to north + (glyph's height as a 64 bit floating-point number)
                if ((glyph's width > 0) and (glyph's height > 0)) and (east <= rightEdge):
                    set u0 to (((glyph's column * entry's cellWidth) + 1) as a 64 bit floating-point number) / (atlas's atlasWidth as a 64 bit floating-point number)
                    set v0 to (((entry's top + (glyph's row * entry's cellHeight)) + 1) as a 64 bit floating-point number) / (atlas's atlasHeight as a 64 bit floating-point number)
                    set u1 to u0 + ((glyph's width as a 64 bit floating-point number) / (atlas's atlasWidth as a 64 bit floating-point number))
                    set v1 to v0 + ((glyph's height as a 64 bit floating-point number) / (atlas's atlasHeight as a 64 bit floating-point number))
                    add bim atlas corner west and north at texture u0 and v0 to frame
                    add bim atlas corner east and north at texture u1 and v0 to frame
                    add bim atlas corner east and south at texture u1 and v1 to frame
                    add bim atlas corner west and north at texture u0 and v0 to frame
                    add bim atlas corner east and south at texture u1 and v1 to frame
                    add bim atlas corner west and south at texture u0 and v1 to frame
            set penX to penX + ((placed's advanceX as a 64 bit floating-point number) / 64.0)
            set penY to penY - ((placed's advanceY as a 64 bit floating-point number) / 64.0)
        finish triangles in frame
        @intrinsic("call", "libc", "free", nothing, shapedRun's glyphs)
        return true

function draw bim text {a string:message} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in face {integer:faceIndex} with {bim text atlas record:atlas} coloured {integer:red}, {integer:green} and {integer:blue} in {graphics frame:frame}:
    execute:
        draw bim text message at x and y in face faceIndex with atlas coloured red, green and blue cut at 1000000.0 in frame

# The same, leaving out the glyphs that would reach past `rightEdge`.
function draw bim text {a string:message} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in face {integer:faceIndex} with {bim text atlas record:atlas} coloured {integer:red}, {integer:green} and {integer:blue} cut at {a 64 bit floating-point number:rightEdge} in {graphics frame:frame}:
    execute:
        draw bim text message at x and y in face faceIndex with atlas coloured red, green and blue cut at rightEdge spaced 0.0 in frame

# The same, `tracking` pixels added after every character.
function draw bim text {a string:message} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in face {integer:faceIndex} with {bim text atlas record:atlas} coloured {integer:red}, {integer:green} and {integer:blue} cut at {a 64 bit floating-point number:rightEdge} spaced {a 64 bit floating-point number:tracking} in {graphics frame:frame}:
    execute:
        if ((the length of message) = 0) or ((the length of atlas's faces) = 0):
            return nothing
        if bim text message contains Lao:
            if draw bim shaped text message at x and y in face faceIndex with atlas coloured red, green and blue cut at rightEdge in frame:
                return nothing
        set entry to the item at faceIndex in (atlas's faces)
        set pen to (x as an integer) as a 64 bit floating-point number
        set baseline to (y as an integer) as a 64 bit floating-point number
        set atlasWidth to atlas's atlasWidth as a 64 bit floating-point number
        set atlasHeight to atlas's atlasHeight as a 64 bit floating-point number
        start triangles using atlas's texture in frame
        use vertex color red red, green green and blue blue in frame
        set position to 0
        loop while position < (the length of message):
            set stepped to the bim character step of message at position
            set position to position + (stepped's size)
            set glyph to the item at (stepped's glyph) in (entry's glyphs)
            if ((glyph's width > 0) and (glyph's height > 0)) and ((pen + (glyph's advance as a 64 bit floating-point number)) <= rightEdge):
                set west to pen + (glyph's left as a 64 bit floating-point number)
                set north to baseline - (glyph's top as a 64 bit floating-point number)
                set east to west + (glyph's width as a 64 bit floating-point number)
                set south to north + (glyph's height as a 64 bit floating-point number)
                set u0 to (((glyph's column * entry's cellWidth) + 1) as a 64 bit floating-point number) / atlasWidth
                set v0 to (((entry's top + (glyph's row * entry's cellHeight)) + 1) as a 64 bit floating-point number) / atlasHeight
                set u1 to u0 + ((glyph's width as a 64 bit floating-point number) / atlasWidth)
                set v1 to v0 + ((glyph's height as a 64 bit floating-point number) / atlasHeight)
                add bim atlas corner west and north at texture u0 and v0 to frame
                add bim atlas corner east and north at texture u1 and v0 to frame
                add bim atlas corner east and south at texture u1 and v1 to frame
                add bim atlas corner west and north at texture u0 and v0 to frame
                add bim atlas corner east and south at texture u1 and v1 to frame
                add bim atlas corner west and south at texture u0 and v1 to frame
            set pen to (pen + (glyph's advance as a 64 bit floating-point number)) + tracking
        finish triangles in frame

# Draws `message` in the body face.
function draw bim text {a string:message} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} with {bim text atlas record:atlas} coloured {integer:red}, {integer:green} and {integer:blue} in {graphics frame:frame}:
    execute:
        draw bim text message at x and y in face (bim text body) with atlas coloured red, green and blue in frame

# The OpenAEC style's mono label (group titles, panel headings): `message`
# in capitals in the mono label face, letters 0.08 em (one pixel) apart.
function the bim caps width of {a string:message} with {bim text atlas record:atlas}:
    execute:
        if bim text message contains Lao:
            return the bim text width of message in face (bim text mono label) of atlas
        set capitals to the uppercase form of message
        return (the bim text width of capitals in face (bim text mono label) of atlas) + ((the length of capitals) as a 64 bit floating-point number)

function draw bim caps {a string:message} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} with {bim text atlas record:atlas} coloured {integer:red}, {integer:green} and {integer:blue} in {graphics frame:frame}:
    execute:
        if bim text message contains Lao:
            draw bim text message at x and y in face (bim text mono label) with atlas coloured red, green and blue in frame
            return nothing
        set capitals to the uppercase form of message
        draw bim text capitals at x and y in face (bim text mono label) with atlas coloured red, green and blue cut at 1000000.0 spaced 1.0 in frame

# Whether the atlas holds icon `glyph` at `size` pixels.
function the bim pictogram {integer:glyph} sized {integer:size} is in {bim text atlas record:atlas}:
    execute:
        loop cellCursor from 0 to the length of (atlas's icons):
            set cell to the item at cellCursor in (atlas's icons)
            if (cell's glyph = glyph) and (cell's size = size):
                return true
        return false

# Draws icon `glyph` at `size` pixels (16 or 22) with its top left at `x`,
# `y`: its primary part in `red`, `green`, `blue`, its accent part in
# `accentRed`, `accentGreen`, `accentBlue`. Nothing when the atlas lacks it.
function draw bim pictogram {integer:glyph} sized {integer:size} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} with {bim text atlas record:atlas} coloured {integer:red}, {integer:green} and {integer:blue} accented {integer:accentRed}, {integer:accentGreen} and {integer:accentBlue} in {graphics frame:frame}:
    execute:
        draw bim pictogram glyph sized size displayed size at x and y with atlas coloured red, green and blue accented accentRed, accentGreen and accentBlue in frame

# Display size changes only the quad; source size still selects the atlas cell
# and its texture coordinates, preserving both parts of the original icon.
function draw bim pictogram {integer:glyph} sized {integer:size} displayed {integer:displaySize} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} with {bim text atlas record:atlas} coloured {integer:red}, {integer:green} and {integer:blue} accented {integer:accentRed}, {integer:accentGreen} and {integer:accentBlue} in {graphics frame:frame}:
    execute:
        set west to ((x + 0.5) as an integer) as a 64 bit floating-point number
        set north to ((y + 0.5) as an integer) as a 64 bit floating-point number
        set east to west + (displaySize as a 64 bit floating-point number)
        set south to north + (displaySize as a 64 bit floating-point number)
        set atlasWidth to atlas's atlasWidth as a 64 bit floating-point number
        set atlasHeight to atlas's atlasHeight as a 64 bit floating-point number
        loop cellCursor from 0 to the length of (atlas's icons):
            set cell to the item at cellCursor in (atlas's icons)
            if (cell's glyph = glyph) and (cell's size = size):
                set u0 to (cell's x as a 64 bit floating-point number) / atlasWidth
                set v0 to (cell's y as a 64 bit floating-point number) / atlasHeight
                set u1 to u0 + ((size as a 64 bit floating-point number) / atlasWidth)
                set v1 to v0 + ((size as a 64 bit floating-point number) / atlasHeight)
                start triangles using atlas's texture in frame
                if cell's part = 1:
                    use vertex color red accentRed, green accentGreen and blue accentBlue in frame
                else:
                    use vertex color red red, green green and blue blue in frame
                add bim atlas corner west and north at texture u0 and v0 to frame
                add bim atlas corner east and north at texture u1 and v0 to frame
                add bim atlas corner east and south at texture u1 and v1 to frame
                add bim atlas corner west and north at texture u0 and v0 to frame
                add bim atlas corner east and south at texture u1 and v1 to frame
                add bim atlas corner west and south at texture u0 and v1 to frame
                finish triangles in frame

function release bim text atlas {bim text atlas record:atlas}:
    execute:
        release atlas's texture

# Rotated drawing labels share the same glyph atlas as ordinary UI text.
function draw bim rotated text {a string:message} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} offset {a 64 bit floating-point number:advance} turned {a 64 bit floating-point number:angle} in face {integer:faceIndex} with {bim text atlas record:atlas} coloured {integer:red}, {integer:green} and {integer:blue} in {graphics frame:frame}:
    execute:
        draw bim rotated text message at x and y offset advance turned angle scaled 1.0 in face faceIndex with atlas coloured red, green and blue in frame

# Scale glyph geometry, keeping atlas texture coordinates unchanged. Sheets
# use paper-sized lettering; ordinary model annotations retain scale 1.
function draw bim rotated text {a string:message} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} offset {a 64 bit floating-point number:advance} turned {a 64 bit floating-point number:angle} scaled {a 64 bit floating-point number:letterScale} in face {integer:faceIndex} with {bim text atlas record:atlas} coloured {integer:red}, {integer:green} and {integer:blue} in {graphics frame:frame}:
    execute:
        if ((the length of message) = 0) or ((the length of atlas's faces) = 0):
            return nothing
        set entry to the item at faceIndex in (atlas's faces)
        set pen to advance
        set baseline to 0.0
        set cosine to (the cosine of angle) * letterScale
        set sine to (the sine of angle) * letterScale
        set atlasWidth to atlas's atlasWidth as a 64 bit floating-point number
        set atlasHeight to atlas's atlasHeight as a 64 bit floating-point number
        start triangles using atlas's texture in frame
        use vertex color red red, green green and blue blue in frame
        set position to 0
        loop while position < (the length of message):
            set stepped to the bim character step of message at position
            set position to position + (stepped's size)
            set glyph to the item at (stepped's glyph) in (entry's glyphs)
            if (glyph's width > 0) and (glyph's height > 0):
                set west to pen + (glyph's left as a 64 bit floating-point number)
                set north to baseline - (glyph's top as a 64 bit floating-point number)
                set east to west + (glyph's width as a 64 bit floating-point number)
                set south to north + (glyph's height as a 64 bit floating-point number)
                set u0 to (((glyph's column * entry's cellWidth) + 1) as a 64 bit floating-point number) / atlasWidth
                set v0 to (((entry's top + (glyph's row * entry's cellHeight)) + 1) as a 64 bit floating-point number) / atlasHeight
                set u1 to u0 + ((glyph's width as a 64 bit floating-point number) / atlasWidth)
                set v1 to v0 + ((glyph's height as a 64 bit floating-point number) / atlasHeight)
                add bim atlas corner (x + ((west * cosine) - (north * sine))) and (y + ((west * sine) + (north * cosine))) at texture u0 and v0 to frame
                add bim atlas corner (x + ((east * cosine) - (north * sine))) and (y + ((east * sine) + (north * cosine))) at texture u1 and v0 to frame
                add bim atlas corner (x + ((east * cosine) - (south * sine))) and (y + ((east * sine) + (south * cosine))) at texture u1 and v1 to frame
                add bim atlas corner (x + ((west * cosine) - (north * sine))) and (y + ((west * sine) + (north * cosine))) at texture u0 and v0 to frame
                add bim atlas corner (x + ((east * cosine) - (south * sine))) and (y + ((east * sine) + (south * cosine))) at texture u1 and v1 to frame
                add bim atlas corner (x + ((west * cosine) - (south * sine))) and (y + ((west * sine) + (south * cosine))) at texture u0 and v1 to frame
            set pen to pen + (glyph's advance as a 64 bit floating-point number)
        finish triangles in frame
