# SPDX-License-Identifier: MPL-2.0
# Issue #64: relative level marks and mapped datum heights, including native
# IFCX persistence and the actual IfcBuildingStorey/IfcMapConversion numbers.
import views/drawings/bim_drawing_standard.dl
import ifc/bim_ifc.dl
import exchange/step/bim_step.dl
import exchange/ifcx/bim_file.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl

function require level datum {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set modelValue to an empty bim model
set target to the address of modelValue
ignore add bim level named (the string form of "Basement") at -3.0 with height 3.0 to target
ignore add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
ignore add bim level named (the string form of "First") at 3.0 with height 3.0 to target
require level datum ((the bim level text of 3.0 under (bim iso standard) in modelValue) = (the string form of "FFL +3.000")) named (the string form of "without a CRS the relative level mark is unchanged")
set bim project setting (bim project crs setting) to (28992 as a 64 bit integer) unless (0 as a 64 bit integer) in target
set bim project setting (bim project height setting) to (2420 as a 64 bit integer) unless (0 as a 64 bit integer) in target
require level datum ((the bim level text of 3.0 under (bim iso standard) in modelValue) = (the string form of "FFL +3.000 / datum +5.420 m")) named (the string form of "the mapped height adds the project datum offset")
require level datum ((the bim level text of 3.0 under (bim nen standard) in modelValue) = (the string form of "P +3,000 / datum +5,420 m")) named (the string form of "both heights follow the drawing standard decimal separator")
require level datum ((the bim level text of -3.0 under (bim iso standard) in modelValue) = (the string form of "FFL -3.000 / datum -0.580 m")) named (the string form of "negative mapped heights retain their sign")

set exported to the bim step file of (the bim ifc text of modelValue)
set storeys to the bim step instances of type (the string form of "IFCBUILDINGSTOREY") in exported
require level datum ((the length of storeys) = 3) named (the string form of "IFC contains every level as an IfcBuildingStorey")
set elevationsMatch to true
loop cursor from 0 to the length of storeys:
    set entity to the bim step instance (the item at cursor in storeys) in exported
    set elevation to the bim step number of (the bim step argument 9 of entity) in entity
    set levelValue to the item at cursor in (modelValue's levels's values)
    if (the absolute value of (elevation - levelValue's elevation)) > 0.000000001:
        set elevationsMatch to false
require level datum elevationsMatch named (the string form of "IFC storey elevations stay relative to the project datum")
free storeys
set conversions to the bim step instances of type (the string form of "IFCMAPCONVERSION") in exported
require level datum ((the length of conversions) = 1) named (the string form of "IFC includes the project map conversion")
set conversion to the bim step instance (the item at 0 in conversions) in exported
set height to the bim step number of (the bim step argument 4 of conversion) in conversion
require level datum ((the absolute value of (height - 2.42)) < 0.000000001) named (the string form of "IFC map conversion retains the datum offset independently")
free conversions

set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "levels.ifcx") for project (the string form of "Levels") by (the string form of "test") at (the string form of "2026-10-31T00:00:00Z"))
require level datum native's valid named (the string form of "IFCX reads back the project settings")
set reread to the bim model parsed from native's text
require level datum (reread's valid and ((the bim level text of 3.0 under (bim iso standard) in reread's modelValue) = (the string form of "FFL +3.000 / datum +5.420 m"))) named (the string form of "IFCX preserves the relative and mapped level heights")
