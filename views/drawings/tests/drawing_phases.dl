# SPDX-License-Identifier: MPL-2.0
# Drawing types by discipline and design phase (issue #123): the library
# adds MEP beside Architectural and Structural, with HVAC, Plumbing and
# Electrical plans that draw the building in halftone, and the design
# phases VO, DO and TO beneath Structural plan and Floor plan, each
# inheriting from its plan what it does not change. A model made with the
# older library gets the new types once, keeps its own settings, and gets
# no duplicates on a second pass or after the .bim file.
import exchange/ifcx/bim_file.dl

function bim phase test word {boolean:flag}:
    execute:
        if flag:
            return the string form of "yes"
        return the string form of "no"

function describe bim phase type named {a string:title} in {bim model record:modelValue}:
    execute:
        set typeId to the bim drawing type named title in modelValue
        if typeId = the bim refused id:
            print (title + (the string form of ": missing")) as a line
            return nothing
        set rules to the bim rules of drawing type typeId in modelValue
        set line to title + (the string form of ":")
        set line to (line + (the string form of " walls ")) + (bim phase test word (bim category bim wall category is visible in rules))
        set line to (line + (the string form of "/halftone ")) + (bim phase test word (bim category bim wall category is halftone in rules))
        set line to (line + (the string form of ", doors ")) + (bim phase test word (bim category bim door category is visible in rules))
        set line to (line + (the string form of "/halftone ")) + (bim phase test word (bim category bim door category is halftone in rules))
        set line to (line + (the string form of ", furniture ")) + (bim phase test word (bim category bim furniture category is visible in rules))
        set line to (line + (the string form of ", ceilings ")) + (bim phase test word (bim category bim ceiling category is visible in rules))
        set line to (line + (the string form of "/halftone ")) + (bim phase test word (bim category bim ceiling category is halftone in rules))
        set line to (line + (the string form of ", services ")) + (bim phase test word (bim category bim other category is visible in rules))
        set line to (line + (the string form of ", dimensions ")) + (bim phase test word (bim category bim dimension category is visible in rules))
        print line as a line
        set line to the string form of "    annotations:"
        loop ruleCode from 0 to the bim annotation count:
            if bim annotation ruleCode applies to drawing type typeId in modelValue:
                set line to (line + (the string form of " ")) + (the bim name of annotation ruleCode)
        print line as a line

function list bim phase types of {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's drawingTypes's values):
            set drawingType to the item at cursor in (modelValue's drawingTypes's values)
            set parentName to the string form of "-"
            set parentFound to the bim drawing type index of drawingType's parentId in modelValue
            if parentFound's valid:
                set parentName to (the item at parentFound's position in (modelValue's drawingTypes's values))'s name
            print (((the string form of "  ") + drawingType's name) + ((the string form of " < ") + parentName)) as a line

function count bim types named {a string:title} in {bim model record:modelValue}:
    execute:
        set counted to 0
        loop cursor from 0 to the length of (modelValue's drawingTypes's values):
            if (the item at cursor in (modelValue's drawingTypes's values))'s name = title:
                set counted to counted + 1
        return counted

# A new model: the whole library.
set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
ensure bim drawing types in target
print ((the string form of "drawing types: ") + (the string form of (the length of (modelValue's drawingTypes's values)))) as a line
list bim phase types of modelValue
loop phaseCode from 0 to the bim design phase count:
    print ((the bim abbreviation of design phase phaseCode) + ((the string form of " = ") + (the bim name of design phase phaseCode))) as a line
describe bim phase type named (the string form of "MEP") in modelValue
describe bim phase type named (the string form of "HVAC plan") in modelValue
describe bim phase type named (the string form of "Plumbing plan") in modelValue
describe bim phase type named (the string form of "Electrical plan") in modelValue
describe bim phase type named (the string form of "Structural plan") in modelValue
describe bim phase type named (the string form of "Structural plan VO") in modelValue
describe bim phase type named (the string form of "Structural plan DO") in modelValue
describe bim phase type named (the string form of "Structural plan TO") in modelValue
describe bim phase type named (the string form of "Floor plan") in modelValue
describe bim phase type named (the string form of "Floor plan VO") in modelValue
describe bim phase type named (the string form of "Floor plan DO") in modelValue
describe bim phase type named (the string form of "Floor plan TO") in modelValue

# A phase inherits what it does not set: grids hidden on Structural are
# hidden on Structural plan DO.
set structuralRoot to the bim drawing type named (the string form of "Structural") in modelValue
set phaseDo to the bim drawing type named (the string form of "Structural plan DO") in modelValue
ignore set bim drawing type structuralRoot setting 0 at bim grid category to 0 in target
print ((the string form of "grids hidden on Structural, on Structural plan DO shown: ") + (bim phase test word (bim category bim grid category is visible in (the bim rules of drawing type phaseDo in modelValue)))) as a line
ignore set bim drawing type structuralRoot setting 0 at bim grid category to 1 in target

# A plan following a phase draws by its rules.
set phaseVo to the bim drawing type named (the string form of "Structural plan VO") in modelValue
set voView to add bim plan view following drawing type phaseVo named (the string form of "Structural plan VO - Ground floor") on storey to target
set voValue to the item at (the bim view index of voView in modelValue)'s position in (modelValue's views's values)
print ((the string form of "VO plan dimensions shown: ") + (bim phase test word (bim category bim dimension category is visible in (the bim rules of view voValue in modelValue)))) as a line

# A second pass adds nothing.
set before to the length of (modelValue's drawingTypes's values)
ensure bim drawing types in target
print ((the string form of "second pass adds: ") + (the string form of ((the length of (modelValue's drawingTypes's values)) - before))) as a line

# A model made with the older library: its types, one changed by hand.
set olderModel to an empty bim model
set older to the address of olderModel
set architecturalOld to add bim drawing type named (the string form of "Architectural") under (the bim refused id) to older
set floorOld to add bim drawing type named (the string form of "Floor plan") under architecturalOld to older
ignore set bim drawing type floorOld setting 0 at bim furniture category to 0 in older
set structuralOld to add bim drawing type named (the string form of "Structural") under (the bim refused id) to older
ignore add bim drawing type named (the string form of "Structural plan") under structuralOld to older
ignore add bim drawing type named (the string form of "Area plan") under architecturalOld to older
print ((the string form of "older model types: ") + (the string form of (the length of (olderModel's drawingTypes's values)))) as a line
ensure bim drawing types in older
print ((the string form of "after ensure: ") + (the string form of (the length of (olderModel's drawingTypes's values)))) as a line
list bim phase types of olderModel
print ((the string form of "its Floor plan keeps furniture hidden: ") + (bim phase test word ((bim category bim furniture category is visible in (the bim rules of drawing type floorOld in olderModel)) = false))) as a line
set olderDo to the bim drawing type named (the string form of "Floor plan DO") in olderModel
print ((the string form of "Floor plan DO inherits it: ") + (bim phase test word ((bim category bim furniture category is visible in (the bim rules of drawing type olderDo in olderModel)) = false))) as a line

# Through the .bim file and once more: nothing doubles.
set reread to the bim model parsed from (the bim file text of olderModel)
print ((the string form of ".bim read: ") + (the string form of reread's valid)) as a line
set rereadModel to reread's modelValue
ensure bim drawing types in (the address of rereadModel)
print ((the string form of "after reading and ensure: ") + (the string form of (the length of (rereadModel's drawingTypes's values)))) as a line
print ((the string form of "MEP types: ") + (the string form of (count bim types named (the string form of "MEP") in rereadModel))) as a line
print ((the string form of "Floor plan VO types: ") + (the string form of (count bim types named (the string form of "Floor plan VO") in rereadModel))) as a line
describe bim phase type named (the string form of "Floor plan TO") in rereadModel
