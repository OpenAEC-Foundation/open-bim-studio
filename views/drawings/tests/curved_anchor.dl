# SPDX-License-Identifier: MPL-2.0
# A wall end's anchor points along the wall's tangent there: on a curved wall
# that differs from the chord, on a straight wall it is the chord.
import views/drawings/bim_drawing.dl
import generated/compose.dl

function the anchor test text of {a 64 bit floating-point number:value}:
    execute:
        set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, value * 1000.0)
        return the string form of (scaled / 1000.0)

function anchor test vectors {cad vector2:first} and {cad vector2:second} agree:
    execute:
        return ((the absolute value of (first's x - second's x)) < 1e-9) and ((the absolute value of (first's y - second's y)) < 1e-9)

set modelValue to an empty bim model
set target to the address of modelValue
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
set wallType to add bim wall type named (the string form of "Brick") with layerValues to target
free layerValues
set straight to add bim wall typed wallType on storey from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set curved to add bim wall typed wallType on storey from (a cad vector2 with x 0.0 and y 4.0) to (a cad vector2 with x 6.0 and y 4.0) to target
set curvedFound to the bim wall index of curved in modelValue
set bent to the item at curvedFound's position in (modelValue's walls's values)
set bent's bulge to 0.5
replace item at index curvedFound's position in (target's walls's values) with bent
set index to the bim join index of modelValue
set straightStart to the bim feature of (a bim reference to straight feature bim wall start feature) in modelValue using index
set curvedStart to the bim feature of (a bim reference to curved feature bim wall start feature) in modelValue using index
set curvedFinish to the bim feature of (a bim reference to curved feature bim wall finish feature) in modelValue using index
print ((the string form of "straight start direction ") + ((the anchor test text of straightStart's direction's x) + ((the string form of " ") + (the anchor test text of straightStart's direction's y)))) as a line
print ((the string form of "curved start follows tangent ") + (the string form of ((anchor test vectors curvedStart's direction and (the bim tangent of bent at finish false) agree) as an integer))) as a line
print ((the string form of "curved start differs from chord ") + (the string form of (((anchor test vectors curvedStart's direction and (the bim direction of bent) agree) = false) as an integer))) as a line
print ((the string form of "curved finish follows tangent ") + (the string form of ((anchor test vectors curvedFinish's direction and (the bim tangent of bent at finish true) agree) as an integer))) as a line
