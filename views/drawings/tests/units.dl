# SPDX-License-Identifier: MPL-2.0
# The project's length units: lengths shown and typed in millimetres, kept in
# metres, and the units saved with the file and read back.
import ui/editor/bim_editor.dl

set editor to a new bim editor
set e to the address of editor
type bim editor key 2050 in e
print editor's message as a line
# A wall 2500 mm long, typed.
type bim editor key 87 in e
move bim editor pointer to (a cad vector2 with x 0.0 and y 0.0) within 0.1 in e
press bim editor pointer in e
move bim editor pointer to (a cad vector2 with x 1.0 and y 0.0) within 0.1 in e
type bim editor key 50 in e
type bim editor key 53 in e
type bim editor key 48 in e
type bim editor key 48 in e
type bim editor key bim enter key code in e
type bim editor key bim escape key code in e
set wallValue to the item at 0 in (editor's documentValue's current's walls's values)
print ((the string form of "kept in metres: ") + (the string form of wallValue's finish's x)) as a line
select bim editor bim wall picked numbered wallValue's id in e
print editor's message as a line
type bim editor key 2051 in e
select bim editor bim wall picked numbered wallValue's id in e
print editor's message as a line
type bim editor key 2050 in e
save bim editor to (the string form of "build/bim-slice-units-test.bim") in e
set other to a new bim editor
open bim editor from (the string form of "build/bim-slice-units-test.bim") in (the address of other)
print ((the string form of "reopened in ") + (the bim name of unit other's lengthUnit)) as a line
