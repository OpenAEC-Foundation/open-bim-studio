# SPDX-License-Identifier: MPL-2.0
# A dimension whose references point at an element the model does not have
# measures invalid and draws no line, without failing; deleting a wall drops
# the dimensions that refer to it, so a stale reference only arrives from
# outside (a file, a caller holding an old id).
import views/drawings/bim_drawing.dl
import generated/compose.dl

set modelValue to an empty bim model
set storey to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to (the address of modelValue)
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.1)) to layerValues
set wallType to add bim wall type named (the string form of "Brick") with layerValues to (the address of modelValue)
free layerValues
set wall to add bim wall typed wallType on storey from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to (the address of modelValue)
set lengthDimension to add bim dimension from (a bim reference to wall feature bim wall start feature) to (a bim reference to wall feature bim wall finish feature) to (the address of modelValue)
set lengthValue to the item at (the bim dimension index of lengthDimension in modelValue)'s position in (modelValue's dimensions's values)
print ((the string form of "measure valid ") + (the string form of ((the bim measure of lengthValue in modelValue)'s valid as an integer))) as a line
ignore delete bim wall wall from (the address of modelValue)
print ((the string form of "dimensions after delete ") + (the string form of (the length of (modelValue's dimensions's values)))) as a line
set absent to 424242 as a 64 bit integer
set stale to @intrinsic("construct", a bim dimension record, 1 as a 64 bit integer, a bim reference to absent feature bim wall start feature, a bim reference to absent feature bim wall finish feature, false, a cad vector2 with x 0.0 and y 0.0)
print ((the string form of "stale measure valid ") + (the string form of ((the bim measure of stale in modelValue)'s valid as an integer))) as a line
set drawn to the bim dimension line of stale in modelValue using (the bim join index of modelValue)
print ((the string form of "stale line valid ") + (the string form of (drawn's valid as an integer))) as a line
