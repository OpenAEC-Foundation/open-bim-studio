# SPDX-License-Identifier: MPL-2.0
# A small sheet as a PDF, drawn with the pen table (bim/bim_pens.dl): an A6
# page in points (a paper scale of 72 / 25.4 points per millimetre) with a
# white page, a border 10 mm in, a wall's cut outline, a door leaf, a pane,
# hatching and a dimension line. Each stroked batch must come out as real
# stroked lines, `w` / `J` / `j` / `S`, as wide as its pen on paper, and a
# rectangle as one closed subpath; the page itself stays a filled path. The
# same strokes recorded on screen keep their pixel widths. The page's content
# stream is printed whole and the file written to pdf-pens-test.pdf.
import views/export/bim_pdf.dl
import bim/bim_pens.dl

function check pdf pens {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# How often `fragment` stands in `content`.
function the pdf count of {a string:fragment} within {a string:content}:
    execute:
        set found to 0
        set cursor to 0
        loop while (cursor + (the length of fragment)) <= (the length of content):
            if content has fragment at offset cursor:
                set found to found + 1
            set cursor to cursor + 1
        return found

# The four sides of the rectangle from `low` to `high`, in order, as pairs.
function append test rectangle from {cad vector2:low} to {cad vector2:high} into {a pointer to a list:pairs}:
    execute:
        set lowRight to a cad vector2 with x high's x and y low's y
        set highLeft to a cad vector2 with x low's x and y high's y
        append low to pairs
        append lowRight to pairs
        append lowRight to pairs
        append high to pairs
        append high to pairs
        append highLeft to pairs
        append highLeft to pairs
        append low to pairs

set perMillimetre to 72.0 / 25.4
set pageWidth to 148.0 * perMillimetre
set pageHeight to 105.0 * perMillimetre
set sheet to a new bim canvas
set sheet's paperScale to perMillimetre

# The white page, as filled triangles.
set paper to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to paper
append (a cad vector2 with x pageWidth and y 0.0) to paper
append (a cad vector2 with x pageWidth and y pageHeight) to paper
record bim triangles paper coloured 255, 255 and 255 on (the address of sheet)

# The border, 10 mm in.
set border to an empty list of a cad vector2
append test rectangle from (a cad vector2 with x (10.0 * perMillimetre) and y (10.0 * perMillimetre)) to (a cad vector2 with x (138.0 * perMillimetre) and y (95.0 * perMillimetre)) into border
record bim pen (bim border pen) strokes border coloured 0, 0 and 0 wide 1.2 on (the address of sheet)

# A wall's cut, 30 by 5 mm on paper.
set wall to an empty list of a cad vector2
append test rectangle from (a cad vector2 with x (40.0 * perMillimetre) and y (40.0 * perMillimetre)) to (a cad vector2 with x (70.0 * perMillimetre) and y (45.0 * perMillimetre)) into wall
record bim pen (bim cut pen) strokes wall coloured 0, 0 and 0 wide 1.0 on (the address of sheet)

# A door leaf and a pane, thinner than the cut.
set leaf to an empty list of a cad vector2
append (a cad vector2 with x (75.0 * perMillimetre) and y (45.0 * perMillimetre)) to leaf
append (a cad vector2 with x (75.0 * perMillimetre) and y (54.0 * perMillimetre)) to leaf
record bim pen (bim visible pen) strokes leaf coloured 0, 0 and 0 wide 1.0 on (the address of sheet)
set pane to an empty list of a cad vector2
append (a cad vector2 with x (80.0 * perMillimetre) and y (42.5 * perMillimetre)) to pane
append (a cad vector2 with x (90.0 * perMillimetre) and y (42.5 * perMillimetre)) to pane
record bim pen (bim thin pen) strokes pane coloured 0, 0 and 0 wide 1.0 on (the address of sheet)

# Hatching inside the wall: two separate lines.
set hatching to an empty list of a cad vector2
append (a cad vector2 with x (45.0 * perMillimetre) and y (40.0 * perMillimetre)) to hatching
append (a cad vector2 with x (50.0 * perMillimetre) and y (45.0 * perMillimetre)) to hatching
append (a cad vector2 with x (55.0 * perMillimetre) and y (40.0 * perMillimetre)) to hatching
append (a cad vector2 with x (60.0 * perMillimetre) and y (45.0 * perMillimetre)) to hatching
record bim pen (bim hatch pen) strokes hatching coloured 0, 0 and 0 wide 0.5 on (the address of sheet)

# A dimension line under the wall.
set dimension to an empty list of a cad vector2
append (a cad vector2 with x (40.0 * perMillimetre) and y (35.0 * perMillimetre)) to dimension
append (a cad vector2 with x (70.0 * perMillimetre) and y (35.0 * perMillimetre)) to dimension
record bim pen (bim dimension pen) strokes dimension coloured 0, 0 and 0 wide 0.7 on (the address of sheet)

# A line weight override of 0.50 mm, as a view's rules give it.
set override to an empty list of a cad vector2
append (a cad vector2 with x (40.0 * perMillimetre) and y (60.0 * perMillimetre)) to override
append (a cad vector2 with x (70.0 * perMillimetre) and y (60.0 * perMillimetre)) to override
record bim strokes override coloured 0, 0 and 0 wide ((the bim paper width of weight (50 as a 64 bit integer)) * 4.0) on (the address of sheet)

record bim text (the string form of "Sheet 1") at (100.0 * perMillimetre) and (90.0 * perMillimetre) coloured 0, 0 and 0 on (the address of sheet)

set content to the bim pdf content of sheet on a page pageHeight high with text 7.0 high
print content
check pdf pens ((the pdf count of (the string form of "\nS\n") within content) = 7) named (the string form of "every stroked batch is stroked once with S")
check pdf pens ((the pdf count of (the string form of "\nf\n") within content) = 1) named (the string form of "only the page is a filled path")
check pdf pens ((the pdf count of (the string form of " RG\n") within content) = 7) named (the string form of "each stroked batch sets its stroke colour")
check pdf pens ((the pdf count of (the string form of "1.98 w 1 J 0 j\n") within content) = 1) named (the string form of "the border is 0.70 mm")
check pdf pens ((the pdf count of (the string form of "1.42 w 1 J 0 j\n") within content) = 2) named (the string form of "the cut and a 0.50 mm override are 0.50 mm")
check pdf pens ((the pdf count of (the string form of "0.71 w 1 J 0 j\n") within content) = 1) named (the string form of "the door leaf is 0.25 mm")
check pdf pens ((the pdf count of (the string form of "0.51 w 1 J 0 j\n") within content) = 2) named (the string form of "the pane and the dimension line are 0.18 mm")
check pdf pens ((the pdf count of (the string form of "0.37 w 1 J 0 j\n") within content) = 1) named (the string form of "the hatching is 0.13 mm")
check pdf pens ((the pdf count of (the string form of " h\n") within content) = 3) named (the string form of "the border and the cut each close as one subpath, as the page's triangle does")
check pdf pens ((the pdf count of (the string form of " m ") within content) = 9) named (the string form of "one subpath per rectangle, per open line and for the page's triangle")

# The same cut recorded on screen keeps the drawing standard's pixel width.
set screen to a new bim canvas
record bim pen (bim cut pen) strokes wall coloured 0, 0 and 0 wide 1.0 on (the address of screen)
set screenContent to the bim pdf content of screen on a page pageHeight high with text 7.0 high
check pdf pens ((the pdf count of (the string form of "1.00 w 1 J 0 j\n") within screenContent) = 1) named (the string form of "on screen the cut keeps its pixel width")

set file to the bim pdf of sheet sized pageWidth by pageHeight with text 7.0 high
set writtenOk to false
set handle to @intrinsic("call", "libc", "fopen", a pointer to a byte, "pdf-pens-test.pdf", "wb")
if handle != (0 as a pointer to a byte):
    set written to @intrinsic("call", "libc", "fwrite", a word sized integer, the data of file, 1 as a word sized integer, (the length of file) as a word sized integer, handle)
    set closed to @intrinsic("call", "libc", "fclose", an integer, handle)
    set writtenOk to (written = ((the length of file) as a word sized integer)) and (closed = 0)
check pdf pens writtenOk named (the string form of "the sheet PDF is written")
free paper
free border
free wall
free leaf
free pane
free hatching
free dimension
free override
