# SPDX-License-Identifier: MPL-2.0
# A recorded drawing as SVG: a black stroke as a filled path and a label with
# an ampersand and brackets, on a 100 by 50 mm page; printed whole and written
# to svg-test.svg, which an XML parser reads.
import formats/bim_svg.dl
import formats/bim_file.dl

set canvas to a new bim canvas
set pairs to an empty list of a cad vector2
append (a cad vector2 with x 10.0 and y 40.0) to pairs
append (a cad vector2 with x 90.0 and y 40.0) to pairs
record bim strokes pairs coloured 0, 0 and 0 wide 1.0 on (the address of canvas)
record bim centred text (the string form of "Plan & <1:100>") at 50.0 and 20.0 coloured 0, 0 and 0 on (the address of canvas)
set file to the bim svg of canvas sized 100.0 by 50.0 with text 2.5 high
print file as a line
print ((the string form of "written ") + (the string form of (write bim text file to file (the string form of "svg-test.svg")))) as a line
