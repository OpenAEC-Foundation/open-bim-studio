# SPDX-License-Identifier: MPL-2.0
import views/export/bim_pdf.dl

set encoded to the bim pdf string of (the string form of "øØé°")
print ((the string form of "encoded bytes: ") + (the string form of (the length of encoded))) as a line
loop cursor from 0 to the length of encoded:
    set octet to (the character at cursor in encoded) as an integer
    if octet < 0:
        set octet to octet + 256
    print octet as a line
print (the bim pdf string of (the string form of "(1:50)")) as a line
set canvas to a new bim canvas
record bim text (the string form of "pos 3: 5 ø12-150 (B)") at 10.0 and 20.0 coloured 0, 0 and 0 on (the address of canvas)
set pdfText to the bim pdf of canvas sized 240.0 by 50.0 with text 7.0 high
# Keep the PDF check independent of the entire BIM model/file parser.
set writtenOk to false
set handle to @intrinsic("call", "libc", "fopen", a pointer to a byte, "pdf-reinforcement-text.pdf", "wb")
if handle != (0 as a pointer to a byte):
    set written to @intrinsic("call", "libc", "fwrite", a word sized integer, the data of pdfText, 1 as a word sized integer, (the length of pdfText) as a word sized integer, handle)
    set closed to @intrinsic("call", "libc", "fclose", an integer, handle)
    set writtenOk to (written = ((the length of pdfText) as a word sized integer)) and (closed = 0)
print ((the string form of "written: ") + (the string form of writtenOk)) as a line
