# SPDX-License-Identifier: MPL-2.0
# The drawing font in the PDF (drawing quality plan, items 8 and 10): the
# labels of a page are lettered in osifont, embedded as a TrueType CID font
# (Type0, Identity-H, FontFile2) with a ToUnicode map, so characters outside
# WinAnsi (ü, ß, ², Ø, ±, ⌀, ≤) print and copy as they are; the font program
# holds only the glyphs the page uses; a centred label is centred on
# osifont's own advances; without the font the page letters in Helvetica.
# The file is written to pdf-font-test.pdf, which pdftotext reads back.
import views/export/bim_pdf.dl

function check pdf font {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# How often `fragment` stands in `content`.
function the pdf font count of {a string:fragment} within {a string:content}:
    execute:
        set found to 0
        set cursor to 0
        loop while (cursor + (the length of fragment)) <= (the length of content):
            if content has fragment at offset cursor:
                set found to found + 1
            set cursor to cursor + 1
        return found

# The ToUnicode entry of the character `codePoint` in `drawingFont`:
# `<glyph> <UTF-16>`.
function the pdf font map entry of {integer:codePoint} in {bim pdf font record:drawingFont}:
    execute:
        return ((((the string form of "<") + (the bim pdf hex of (the bim pdf glyph of character codePoint in drawingFont))) + (the string form of "> <")) + (the bim pdf hex of codePoint)) + (the string form of ">")

# The decimal number `digitsText` stands for.
function the pdf font number in {a string:digitsText}:
    execute:
        set total to 0
        loop digitCursor from 0 to the length of digitsText:
            set total to (total * 10) + ((((the character at digitCursor in digitsText) as an integer) bitwise and 255) - 48)
        return total

set drawingFont to the bim pdf drawing font
set probes to [252, 223, 178, 216, 177, 8960, 8804]
check pdf font drawingFont's valid named (the string form of "osifont is found and read")
print ((the string form of "units per em ") + (the string form of drawingFont's unitsPerEm)) as a line
print ((the string form of "glyphs ") + (the string form of drawingFont's glyphCount)) as a line
set outsideWinAnsi to the string form of "Straße ü 12 m² Ø16 ±0 ⌀ ≤"
loop codeCursor from 0 to 7:
    set probe to the item at codeCursor in probes
    print ((the string form of "glyph of U+") + ((the bim pdf hex of probe) + ((the string form of ": ") + (the string form of (the bim pdf glyph of character probe in drawingFont))))) as a line
check pdf font ((the bim pdf glyph of character 252 in drawingFont) > 0) named (the string form of "osifont has ü")
check pdf font ((the bim pdf glyph of character 8804 in drawingFont) > 0) named (the string form of "osifont has ≤")
check pdf font ((the bim pdf glyph of character 9731 in drawingFont) = 0) named (the string form of "a character osifont lacks takes the missing glyph")

# Its own advances, the same as the lettering table measures for ASCII.
set measured to the bim pdf width of (the string form of "Plan (1:100)") in drawingFont
set tabled to the bim lettering width of (the string form of "Plan (1:100)") in face (bim osifont lettering)
print ((the string form of "width of Plan (1:100): ") + ((the bim pdf number of (measured * 1000.0)) + (the string form of " thousandths of an em"))) as a line
check pdf font ((the absolute value of (measured - tabled)) < 0.005) named (the string form of "the advances agree with the lettering table")

set canvas to a new bim canvas
set pairs to an empty list of a cad vector2
append (a cad vector2 with x 10.0 and y 40.0) to pairs
append (a cad vector2 with x 190.0 and y 40.0) to pairs
record bim strokes pairs coloured 0, 0 and 0 wide 1.0 on (the address of canvas)
record bim text (the string form of "Plan (1:100)") at 10.0 and 20.0 coloured 0, 0 and 0 on (the address of canvas)
record bim text outsideWinAnsi at 10.0 and 35.0 coloured 0, 0 and 0 on (the address of canvas)
record bim centred text (the string form of "A-101") at 100.0 and 10.0 coloured 0, 0 and 0 on (the address of canvas)
set content to the bim pdf content of canvas on a page 50.0 high with text 7.0 high in drawingFont
print content
check pdf font ((the pdf font count of (the bim pdf glyph string of outsideWinAnsi in drawingFont) within content) = 1) named (the string form of "the label is shown as its glyph numbers")
# "A-101" centred on x = 100 at 7 points: half its osifont advance to the left.
set centredWidth to (the bim pdf width of (the string form of "A-101") in drawingFont) * 7.0
set centredStart to the bim pdf number of (100.0 - (centredWidth * 0.5))
print ((the string form of "A-101 starts at ") + centredStart) as a line
check pdf font ((the pdf font count of (((the string form of "BT /F1 7.00 Tf ") + centredStart) + (the string form of " 40.00 Td")) within content) = 1) named (the string form of "a centred label is centred on osifont's advances")

set file to the bim pdf of canvas sized 200.0 by 50.0 with text 7.0 high
check pdf font ((the pdf font count of (the string form of "/Subtype /Type0 /BaseFont /") within file) = 1) named (the string form of "the font is a Type0 font")
check pdf font ((the pdf font count of (the string form of "+osifont /Encoding /Identity-H") within file) = 1) named (the string form of "named as a subset of osifont, Identity-H")
check pdf font ((the pdf font count of (the string form of "/Subtype /CIDFontType2") within file) = 1) named (the string form of "its CID font is TrueType")
check pdf font ((the pdf font count of (the string form of "/FontFile2 6 0 R") within file) = 1) named (the string form of "the font program is embedded as FontFile2")
check pdf font ((the pdf font count of (the string form of "/ToUnicode 7 0 R") within file) = 1) named (the string form of "the font has a ToUnicode map")
check pdf font ((the pdf font count of (the string form of "/Helvetica") within file) = 0) named (the string form of "Helvetica is not named")
loop codeCursor from 0 to 7:
    set probe to the item at codeCursor in probes
    set mapEntry to the pdf font map entry of probe in drawingFont
    check pdf font ((the pdf font count of mapEntry within file) = 1) named ((the string form of "ToUnicode maps ") + mapEntry)
set lengthAt to (the index of "/Length1 " in file) + 9
set lengthText to the substring of file from lengthAt spanning ((the index of " >>" in (the substring of file from lengthAt spanning 20 bytes))) bytes
print ((the string form of "font program bytes: ") + lengthText) as a line
print ((the string form of "whole osifont bytes: ") + (the string form of (the length of drawingFont's fontBytes))) as a line
print ((the string form of "PDF bytes: ") + (the string form of (the length of file))) as a line

# The subset is a font of its own: read back, it letters the same glyphs
# with the same advances.
set programAt to (the index of "stream\n" in (the substring of file from lengthAt spanning 40 bytes)) + (lengthAt + 7)
set subsetFont to the bim pdf font from (the substring of file from programAt spanning (the pdf font number in lengthText) bytes)
check pdf font subsetFont's valid named (the string form of "the embedded program reads as a TrueType font")
check pdf font ((the bim pdf glyph of character 223 in subsetFont) = (the bim pdf glyph of character 223 in drawingFont)) named (the string form of "it keeps the glyph numbers")
check pdf font ((the absolute value of ((the bim pdf width of outsideWinAnsi in subsetFont) - (the bim pdf width of outsideWinAnsi in drawingFont))) < 0.000001) named (the string form of "it keeps the advances")

# Without the font: Helvetica, its WinAnsi string.
set fallback to the bim pdf content of canvas on a page 50.0 high with text 7.0 high in (no bim pdf font)
check pdf font ((the pdf font count of (the string form of "(Plan \\(1:100\\)) Tj") within fallback) = 1) named (the string form of "without osifont the label is a Helvetica string")

set writtenOk to false
set handle to @intrinsic("call", "libc", "fopen", a pointer to a byte, "pdf-font-test.pdf", "wb")
if handle != (0 as a pointer to a byte):
    set written to @intrinsic("call", "libc", "fwrite", a word sized integer, the data of file, 1 as a word sized integer, (the length of file) as a word sized integer, handle)
    set closed to @intrinsic("call", "libc", "fclose", an integer, handle)
    set writtenOk to (written = ((the length of file) as a word sized integer)) and (closed = 0)
check pdf font writtenOk named (the string form of "the PDF is written")
free pairs
