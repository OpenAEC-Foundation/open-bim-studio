# SPDX-License-Identifier: MPL-2.0
# A sheetview's book as one PDF (#135): two recorded pages of different
# sizes in one file, the page tree listing both, each page its own size and
# content stream, the font shared. The file is printed whole (its offsets
# are checked by reading it with pdftotext) and written to pdf-book-test.pdf.
import views/export/bim_pdf.dl

set firstCanvas to a new bim canvas
set pairs to an empty list of a cad vector2
append (a cad vector2 with x 10.0 and y 40.0) to pairs
append (a cad vector2 with x 90.0 and y 40.0) to pairs
record bim strokes pairs coloured 0, 0 and 0 wide 1.0 on (the address of firstCanvas)
record bim text (the string form of "D-01 Contents") at 10.0 and 20.0 coloured 0, 0 and 0 on (the address of firstCanvas)
set secondCanvas to a new bim canvas
record bim text (the string form of "D-02 Walls") at 10.0 and 20.0 coloured 0, 0 and 0 on (the address of secondCanvas)
set canvases to an empty list of a bim canvas record
append firstCanvas to canvases
append secondCanvas to canvases
set sizes to an empty list of a cad vector2
append (a cad vector2 with x 100.0 and y 50.0) to sizes
append (a cad vector2 with x 60.0 and y 40.0) to sizes
set file to the bim pdf of pages canvases sized sizes with text 7.0 high
print file as a line
set writtenOk to false
set handle to @intrinsic("call", "libc", "fopen", a pointer to a byte, "pdf-book-test.pdf", "wb")
if handle != (0 as a pointer to a byte):
    set written to @intrinsic("call", "libc", "fwrite", a word sized integer, the data of file, 1 as a word sized integer, (the length of file) as a word sized integer, handle)
    set closed to @intrinsic("call", "libc", "fclose", an integer, handle)
    set writtenOk to (written = ((the length of file) as a word sized integer)) and (closed = 0)
print ((the string form of "written ") + (the string form of writtenOk)) as a line
