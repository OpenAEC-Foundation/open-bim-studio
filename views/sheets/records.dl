# SPDX-License-Identifier: MPL-2.0
# The sheets module's records.
# They were in bim/bim_model.dl until the module split's phase C2.
import bim/bim_model.dl

# A drawing sheet: its number and name for the title block, its paper (`bim
# a0 paper` … `bim a4 paper`, landscape or portrait) and the views placed on
# it.
class:
    patterns:
        [a|] bim sheet record
    members:
        id as a 64 bit integer
        number as a string
        name as a string
        paper as an integer
        landscape as a boolean
        viewports as the type of (a cad topology list of a bim viewport record)

# A sheetview (#135): a book of sheets, such as a detail book or a set of
# workshop drawings. Its pages are sheets, in order; each is numbered from
# the book's prefix and its place in it ("D-" and the third page: "D-03").
# New pages take the book's paper. `contentsId` is the page that lists the
# others, or the refused id when the book has none. A sheet in no book is a
# sheetview of one page by itself, so models from before books load as they
# were.
class:
    patterns:
        [a|] bim sheetview record
    members:
        id as a 64 bit integer
        name as a string
        prefix as a string
        paper as an integer
        landscape as a boolean
        contentsId as a 64 bit integer
        pages as the type of (a cad topology list of a 64 bit integer)
