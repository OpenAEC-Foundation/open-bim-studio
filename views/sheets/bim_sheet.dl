# SPDX-License-Identifier: MPL-2.0
# Sheets: the geometry of paper, title block and viewports, in millimetres
# from the sheet's lower left corner. A viewport places a view at the view's
# scale: one model metre is 1000 / scale millimetres on the sheet.
import bim/bim_model.dl
import views/sheets/bim_sheetview.dl
import localisation/bim_catalogue.dl

class:
    patterns:
        [a|] bim sheet frame record
    members:
        valid as a boolean
        low as a cad vector2
        high as a cad vector2

# The size of `paperCode` in millimetres, landscape: width and height.
function the bim paper size of {integer:paperCode}:
    execute:
        if paperCode = 0:
            return a cad vector2 with x 1189.0 and y 841.0
        if paperCode = 1:
            return a cad vector2 with x 841.0 and y 594.0
        if paperCode = 2:
            return a cad vector2 with x 594.0 and y 420.0
        if paperCode = 3:
            return a cad vector2 with x 420.0 and y 297.0
        return a cad vector2 with x 297.0 and y 210.0

# The sheet's width and height in millimetres, as it is turned.
function the bim size of sheet {bim sheet record:sheetValue}:
    execute:
        set landscapeSize to the bim paper size of sheetValue's paper
        if sheetValue's landscape:
            return landscapeSize
        return a cad vector2 with x landscapeSize's y and y landscapeSize's x

# The drawing frame of NEN-EN-ISO 5457: 20 mm from the left edge (the
# filing margin), 10 mm from the others, on every paper size.
function the bim sheet filing margin:
    replacement:
        20.0
function the bim sheet margin:
    replacement:
        10.0

# The drawing frame of sheet `sheetValue`, in millimetres.
function the bim drawing frame of sheet {bim sheet record:sheetValue}:
    execute:
        set sheetSize to the bim size of sheet sheetValue
        return @intrinsic("construct", a bim sheet frame record, true, a cad vector2 with x (the bim sheet filing margin) and y (the bim sheet margin), a cad vector2 with x (sheetSize's x - (the bim sheet margin)) and y (sheetSize's y - (the bim sheet margin)))

# The title block's stamp (NEN-EN-ISO 7200): 180 mm wide in the lower right
# corner of the drawing frame, as narrow sheets allow; five rows, 48 mm
# high (`record bim title block`).
function the bim stamp height:
    replacement:
        48.0
# Each row of the revision table above the stamp, its heading's too.
function the bim revision row height:
    replacement:
        5.0
# The most revisions the table lists: the latest ones.
function the bim revision rows shown:
    replacement:
        8

function the bim title block of sheet {bim sheet record:sheetValue}:
    execute:
        set sheetSize to the bim size of sheet sheetValue
        set rightEdge to sheetSize's x - (the bim sheet margin)
        set blockWidth to the minimum of 180.0 and (rightEdge - (the bim sheet filing margin))
        set lowEdge to the bim sheet margin
        return @intrinsic("construct", a bim sheet frame record, true, a cad vector2 with x (rightEdge - blockWidth) and y lowEdge, a cad vector2 with x rightEdge and y (lowEdge + (the bim stamp height)))

# The whole title block of sheet `sheetValue`: the stamp and the revision
# table over it, a heading and a row per revision listed.
function the bim title block of sheet {bim sheet record:sheetValue} in {bim model record:modelValue}:
    execute:
        set stamp to the bim title block of sheet sheetValue
        set listed to the minimum of (the bim revision count of sheet sheetValue's id in modelValue) and (the bim revision rows shown)
        set tableHeight to ((listed + 1) as a 64 bit floating-point number) * (the bim revision row height)
        return @intrinsic("construct", a bim sheet frame record, true, stamp's low, a cad vector2 with x stamp's high's x and y (stamp's high's y + tableHeight))

# ---------------------------------------------------------------- title block data

# What a sheet's title block states besides its number, name and scale:
# its date and who drew and checked it, and its revisions. They are text,
# kept as properties of the sheet (the set "Title block" and the set
# "Revisions"), so that the native file and IfcX keep them and the sheet's
# properties show them.
function the bim title block set:
    execute:
        return the string form of "Title block"
function the bim revisions set:
    execute:
        return the string form of "Revisions"

function the bim sheet date field:
    execute:
        return the string form of "Date"
function the bim sheet drawn field:
    execute:
        return the string form of "DrawnBy"
function the bim sheet checked field:
    execute:
        return the string form of "CheckedBy"

# Title block field `fieldName` of sheet `sheetId`, "" when it has none.
function the bim sheet field {a string:fieldName} of sheet {a 64 bit integer:sheetId} in {bim model record:modelValue}:
    execute:
        return the bim property value fieldName of set (the bim title block set) of sheetId in modelValue

# Title block field `fieldName` of sheet `sheetId` set to `fieldValue`, or
# removed when that is empty.
function set bim sheet field {a string:fieldName} of sheet {a 64 bit integer:sheetId} to {a string:fieldValue} in {a pointer to a bim model record:target}:
    execute:
        set wantedSet to the bim title block set
        if (the length of fieldValue) > 0:
            set bim property fieldName of set wantedSet of sheetId to fieldValue typed (the string form of "IFCLABEL") in target
            return nothing
        set cursor to (the length of (target's properties's values)) - 1
        loop while cursor >= 0:
            set entry to the item at cursor in (target's properties's values)
            if ((entry's elementId = sheetId) and (entry's setName = wantedSet)) and (entry's name = fieldName):
                remove item cursor from (target's properties's values)
            set cursor to cursor - 1
        note bim change of sheetId in target

# The property of revision `ordinal` (1 for the first) that holds
# `partName` (Revision, Date, Description, DrawnBy, CheckedBy): "1.Revision".
function the bim revision property {integer:ordinal} part {a string:partName}:
    execute:
        return ((the string form of ordinal) + (the string form of ".")) + partName

# How many revisions sheet `sheetId` has: they are numbered from 1 without
# a gap.
function the bim revision count of sheet {a 64 bit integer:sheetId} in {bim model record:modelValue}:
    execute:
        set counted to 0
        set reading to true
        loop while reading:
            set codeText to the bim property value (the bim revision property (counted + 1) part (the string form of "Revision")) of set (the bim revisions set) of sheetId in modelValue
            if (the length of codeText) = 0:
                set reading to false
            else:
                set counted to counted + 1
        return counted

# The revisions of sheet `sheetId`, the first first.
function the bim revisions of sheet {a 64 bit integer:sheetId} in {bim model record:modelValue}:
    execute:
        set revisionList to an empty list of a bim sheet revision record
        set wantedSet to the bim revisions set
        loop ordinal from 1 to ((the bim revision count of sheet sheetId in modelValue) + 1):
            set codeText to the bim property value (the bim revision property ordinal part (the string form of "Revision")) of set wantedSet of sheetId in modelValue
            set dateText to the bim property value (the bim revision property ordinal part (the string form of "Date")) of set wantedSet of sheetId in modelValue
            set aboutText to the bim property value (the bim revision property ordinal part (the string form of "Description")) of set wantedSet of sheetId in modelValue
            set drawnText to the bim property value (the bim revision property ordinal part (the string form of "DrawnBy")) of set wantedSet of sheetId in modelValue
            set checkedText to the bim property value (the bim revision property ordinal part (the string form of "CheckedBy")) of set wantedSet of sheetId in modelValue
            append (@intrinsic("construct", a bim sheet revision record, codeText, dateText, aboutText, drawnText, checkedText)) to revisionList
        return revisionList

# The code the next revision of sheet `sheetId` takes: A for the first,
# then B and on to Z, then R27 and on.
function the bim next revision code of sheet {a 64 bit integer:sheetId} in {bim model record:modelValue}:
    execute:
        set counted to the bim revision count of sheet sheetId in modelValue
        if counted >= 26:
            return (the string form of "R") + (the string form of (counted + 1))
        set letter to a new string buffer containing 1 bytes
        store ((65 + counted) as a byte) into the data of letter at 0
        return letter

# The current revision of sheet `sheetId`: its last revision's code, "" when
# it has none.
function the bim current revision of sheet {a 64 bit integer:sheetId} in {bim model record:modelValue}:
    execute:
        set counted to the bim revision count of sheet sheetId in modelValue
        if counted = 0:
            return the string form of ""
        return the bim property value (the bim revision property counted part (the string form of "Revision")) of set (the bim revisions set) of sheetId in modelValue

# A revision added to sheet `sheetId` after its others: code
# `revisionCode` (the next one when empty), dated `revisionDate`, saying
# what changed, drawn and checked by whom. The revision's code; "" and
# nothing changed for no such sheet.
function add bim revision {a string:revisionCode} dated {a string:revisionDate} saying {a string:about} drawn by {a string:drawer} checked by {a string:checker} to sheet {a 64 bit integer:sheetId} in {a pointer to a bim model record:target}:
    execute:
        if (the bim sheet index of sheetId in (@intrinsic("dereference", target)))'s valid = false:
            return the string form of ""
        set chosenCode to revisionCode
        if (the length of chosenCode) = 0:
            set chosenCode to the bim next revision code of sheet sheetId in (@intrinsic("dereference", target))
        set ordinal to (the bim revision count of sheet sheetId in (@intrinsic("dereference", target))) + 1
        set wantedSet to the bim revisions set
        set labelType to the string form of "IFCLABEL"
        set bim property (the bim revision property ordinal part (the string form of "Revision")) of set wantedSet of sheetId to chosenCode typed labelType in target
        set bim property (the bim revision property ordinal part (the string form of "Date")) of set wantedSet of sheetId to revisionDate typed labelType in target
        set bim property (the bim revision property ordinal part (the string form of "Description")) of set wantedSet of sheetId to about typed labelType in target
        set bim property (the bim revision property ordinal part (the string form of "DrawnBy")) of set wantedSet of sheetId to drawer typed labelType in target
        set bim property (the bim revision property ordinal part (the string form of "CheckedBy")) of set wantedSet of sheetId to checker typed labelType in target
        return chosenCode

# The scale of view `viewId` (100 for 1:100), or 100 when it is gone.
function the bim scale of view {a 64 bit integer:viewId} in {bim model record:modelValue}:
    execute:
        set found to the bim view index of viewId in modelValue
        if found's valid = false:
            return 100.0
        set viewScale to (the item at found's position in (modelValue's views's values))'s scale
        if viewScale < 1:
            return 100.0
        return viewScale as a 64 bit floating-point number

# Where model point `location` of a viewport's view lands on the sheet.
function the bim sheet point of {cad vector2:location} through {bim viewport record:viewport} in {bim model record:modelValue}:
    execute:
        set factor to 1000.0 / (the bim scale of view viewport's viewId in modelValue)
        return a cad vector2 with x (viewport's centre's x + ((location's x - viewport's modelCentre's x) * factor)) and y (viewport's centre's y + ((location's y - viewport's modelCentre's y) * factor))

# How far a section's extent reaches beyond its line's ends, so that its
# level lines run past what is cut (as the section panel draws them), and
# beyond its lowest foot and highest top.
function the bim section extent overrun:
    replacement:
        1.5
function the bim section extent headroom:
    replacement:
        1.0

# The heights a section or an elevation spans: from the lowest level, wall
# foot or plate underside to the highest level, wall top or plate top (a
# roof's ridge), as x and y; both 0 when the model has none.
local function the bim drawn heights of {bim model record:modelValue}:
    execute:
        set bottomHeight to 1e300
        set topHeight to -1e300
        loop cursor from 0 to the length of (modelValue's levels's values):
            set levelValue to the item at cursor in (modelValue's levels's values)
            set bottomHeight to the minimum of bottomHeight and levelValue's elevation
            set topHeight to the maximum of topHeight and levelValue's elevation
        loop cursor from 0 to the length of (modelValue's walls's values):
            set wallValue to the item at cursor in (modelValue's walls's values)
            set levelFound to the bim level index of wallValue's levelId in modelValue
            if levelFound's valid:
                set footHeight to ((the item at levelFound's position in (modelValue's levels's values))'s elevation) + wallValue's baseOffset
                set bottomHeight to the minimum of bottomHeight and footHeight
                set topHeight to the maximum of topHeight and (footHeight + wallValue's height)
        # A roof's ridge above the walls, a floor below the lowest level.
        loop cursor from 0 to the length of (modelValue's slabs's values):
            set plateValue to the item at cursor in (modelValue's slabs's values)
            set plateThickness to the bim thickness of plate plateValue in modelValue
            loop corner from 0 to the length of (plateValue's outline's values):
                set underside to the bim underside of plate plateValue at (the item at corner in (plateValue's outline's values)) in modelValue
                set bottomHeight to the minimum of bottomHeight and underside
                set topHeight to the maximum of topHeight and (underside + plateThickness)
        if topHeight < bottomHeight:
            set bottomHeight to 0.0
            set topHeight to 0.0
        return a cad vector2 with x bottomHeight and y topHeight

# The extent of section `viewValue` in section coordinates (metres along its
# line, height): along the line from its start to its end, in height
# `the bim drawn heights of` the model, with room around; not valid for a
# line of no length.
local function the bim extent of section {bim view definition record:viewValue} in {bim model record:modelValue}:
    execute:
        set run to the cad distance from viewValue's lineStart to viewValue's lineFinish
        if run <= 1e-9:
            return @intrinsic("construct", a bim sheet frame record, false, a cad vector2 with x 0.0 and y 0.0, a cad vector2 with x 0.0 and y 0.0)
        set heights to the bim drawn heights of modelValue
        set beyondEnds to the bim section extent overrun
        set aroundHeights to the bim section extent headroom
        return @intrinsic("construct", a bim sheet frame record, true, a cad vector2 with x (0.0 - beyondEnds) and y (heights's x - aroundHeights), a cad vector2 with x (run + beyondEnds) and y (heights's y + aroundHeights))

# The extent of elevation `viewValue` in its drawing coordinates: along its
# whole line (`the bim elevation line of`, views/common/bim_view.dl, which
# runs the elevation line margin past the model either side), in height as
# a section; not valid when the model has nothing in plan.
local function the bim extent of elevation {bim view definition record:viewValue} in {bim model record:modelValue}:
    execute:
        set elevationLine to the bim elevation line of (viewValue's detail as an integer) in modelValue
        set run to the cad distance from elevationLine's lineStart to elevationLine's lineFinish
        if (elevationLine's valid = false) or (run <= 1e-9):
            return @intrinsic("construct", a bim sheet frame record, false, a cad vector2 with x 0.0 and y 0.0, a cad vector2 with x 0.0 and y 0.0)
        set heights to the bim drawn heights of modelValue
        set aroundHeights to the bim section extent headroom
        return @intrinsic("construct", a bim sheet frame record, true, a cad vector2 with x 0.0 and y (heights's x - aroundHeights), a cad vector2 with x run and y (heights's y + aroundHeights))

# The model extent a view shows: its crop; else for a section its line and
# heights in section coordinates (`the bim extent of section`), for an
# elevation its line and those heights (`the bim extent of elevation`), and for a
# plan the walls of its storey with a metre around them; not valid when
# there is nothing to show.
# Metres kept free around a plan's walls in its viewport for its annotation
# (dimension chains, elevation marks).
function bim plan annotation margin:
    replacement:
        3.5

function the bim model extent of view {a 64 bit integer:viewId} in {bim model record:modelValue}:
    execute:
        set none to @intrinsic("construct", a bim sheet frame record, false, a cad vector2 with x 0.0 and y 0.0, a cad vector2 with x 0.0 and y 0.0)
        set found to the bim view index of viewId in modelValue
        if found's valid = false:
            return none
        set viewValue to the item at found's position in (modelValue's views's values)
        if viewValue's cropped:
            return @intrinsic("construct", a bim sheet frame record, true, viewValue's cropLow, viewValue's cropHigh)
        if viewValue's kind = bim section view:
            return the bim extent of section viewValue in modelValue
        if bim view viewValue is an elevation:
            return the bim extent of elevation viewValue in modelValue
        set lowX to 1e300
        set lowY to 1e300
        set highX to -1e300
        set highY to -1e300
        loop cursor from 0 to the length of (modelValue's walls's values):
            set wallValue to the item at cursor in (modelValue's walls's values)
            if (wallValue's levelId = viewValue's levelId) or (viewValue's kind != bim plan view):
                set lowX to the minimum of lowX and (the minimum of wallValue's start's x and wallValue's finish's x)
                set lowY to the minimum of lowY and (the minimum of wallValue's start's y and wallValue's finish's y)
                set highX to the maximum of highX and (the maximum of wallValue's start's x and wallValue's finish's x)
                set highY to the maximum of highY and (the maximum of wallValue's start's y and wallValue's finish's y)
        if highX < lowX:
            return none
        # Around the walls the room a plan's annotation takes: the exterior
        # dimension chains up to 2 m out with their text, and the elevation
        # marks 3 m out; the viewport's title and north arrow then sit clear
        # of them.
        set margin to bim plan annotation margin
        return @intrinsic("construct", a bim sheet frame record, true, a cad vector2 with x (lowX - margin) and y (lowY - margin), a cad vector2 with x (highX + margin) and y (highY + margin))

# The middle of what view `viewId` shows, to place it by.
function the bim model centre of view {a 64 bit integer:viewId} in {bim model record:modelValue}:
    execute:
        set shownExtent to the bim model extent of view viewId in modelValue
        if shownExtent's valid = false:
            return a cad vector2 with x 0.0 and y 0.0
        return a cad vector2 with x ((shownExtent's low's x + shownExtent's high's x) * 0.5) and y ((shownExtent's low's y + shownExtent's high's y) * 0.5)

# The rectangle a viewport takes on its sheet: its view's extent at its scale.
function the bim frame of viewport {bim viewport record:viewport} in {bim model record:modelValue}:
    execute:
        set shownExtent to the bim model extent of view viewport's viewId in modelValue
        if shownExtent's valid = false:
            return shownExtent
        return @intrinsic("construct", a bim sheet frame record, true, the bim sheet point of shownExtent's low through viewport in modelValue, the bim sheet point of shownExtent's high through viewport in modelValue)

# ---------------------------------------------------------------- legend

# What a sheet's legend explains, one entry each: cut elements, grids,
# levels, section lines, elevation marks, dimensions and tags.
function bim cut legend entry:
    replacement:
        0
function bim grid legend entry:
    replacement:
        1
function bim level legend entry:
    replacement:
        2
function bim section legend entry:
    replacement:
        3
function bim elevation legend entry:
    replacement:
        4
function bim dimension legend entry:
    replacement:
        5
function bim tag legend entry:
    replacement:
        6

function the bim legend name of entry {integer:entryCode}:
    execute:
        if entryCode = bim cut legend entry:
            return the string form of "Cut element, hatched"
        if entryCode = bim grid legend entry:
            return the string form of "Grid line and head"
        if entryCode = bim level legend entry:
            return the string form of "Level line, head and height"
        if entryCode = bim section legend entry:
            return the string form of "Section line, number and direction"
        if entryCode = bim elevation legend entry:
            return the string form of "Elevation mark"
        if entryCode = bim dimension legend entry:
            return the string form of "Dimension in millimetres"
        return the string form of "Tags: type / rebar mark, count, diameter, pitch; representative bars"

# The catalogue key of legend entry `entryCode`.
function the bim legend key of entry {integer:entryCode}:
    execute:
        if entryCode = bim cut legend entry:
            return the string form of "legend.cut"
        if entryCode = bim grid legend entry:
            return the string form of "legend.grid"
        if entryCode = bim level legend entry:
            return the string form of "legend.level"
        if entryCode = bim section legend entry:
            return the string form of "legend.section"
        if entryCode = bim elevation legend entry:
            return the string form of "legend.elevation"
        if entryCode = bim dimension legend entry:
            return the string form of "legend.dimension"
        return the string form of "legend.tags"

# The name of legend entry `entryCode` in the language of `catalogue`.
function the bim legend name of entry {integer:entryCode} in {bim message catalogue record:catalogue}:
    execute:
        return the bim message (the bim legend key of entry entryCode) defaulting to (the bim legend name of entry entryCode) in catalogue

# Whether sheet `sheetValue` shows a view of `viewKind`.
function bim view kind {integer:viewKind} is placed on {bim sheet record:sheetValue} in {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (sheetValue's viewports's values):
            set found to the bim view index of (the item at cursor in (sheetValue's viewports's values))'s viewId in modelValue
            if found's valid:
                if (the item at found's position in (modelValue's views's values))'s kind = viewKind:
                    return true
        return false

# The legend entries of sheet `sheetValue`: what its plans and sections draw,
# as far as the model has it.
function the bim legend entries of sheet {bim sheet record:sheetValue} in {bim model record:modelValue}:
    execute:
        set legendList to an empty list of an integer
        set planShown to bim view kind (bim plan view) is placed on sheetValue in modelValue
        set sectionShown to bim view kind (bim section view) is placed on sheetValue in modelValue
        set sectionsExist to false
        set elevationsExist to false
        loop cursor from 0 to the length of (modelValue's views's values):
            set viewValue to the item at cursor in (modelValue's views's values)
            if viewValue's kind = bim section view:
                set sectionsExist to true
            if (viewValue's kind = bim model view) and (viewValue's detail > (0 as a 64 bit integer)):
                set elevationsExist to true
        if planShown or sectionShown:
            append (bim cut legend entry) to legendList
            if (the length of (modelValue's grids's values)) > 0:
                append (bim grid legend entry) to legendList
        if sectionShown and ((the length of (modelValue's levels's values)) > 0):
            append (bim level legend entry) to legendList
        if planShown:
            if sectionsExist:
                append (bim section legend entry) to legendList
            if elevationsExist:
                append (bim elevation legend entry) to legendList
            if (the length of (modelValue's dimensions's values)) > 0:
                append (bim dimension legend entry) to legendList
            if (the length of (modelValue's tags's values)) > 0:
                append (bim tag legend entry) to legendList
        return legendList

# The height of one legend row, and of the legend's heading, in millimetres.
function the bim legend row height:
    replacement:
        7.0
function the bim legend heading height:
    replacement:
        12.0

# The legend: as wide as the title block, standing 4 mm above it, a heading
# and a row per entry; not valid when there is nothing to explain.
function the bim legend block of sheet {bim sheet record:sheetValue} in {bim model record:modelValue}:
    execute:
        set legendList to the bim legend entries of sheet sheetValue in modelValue
        set rowCount to the length of legendList
        free legendList
        set titleBlock to the bim title block of sheet sheetValue in modelValue
        set bottom to titleBlock's high's y + 4.0
        set top to bottom + ((the bim legend heading height) + ((rowCount as a 64 bit floating-point number) * (the bim legend row height)))
        return @intrinsic("construct", a bim sheet frame record, (rowCount > 0), a cad vector2 with x titleBlock's low's x and y bottom, a cad vector2 with x titleBlock's high's x and y top)

# ---------------------------------------------------------------- title block

# The paper's name, A0 to A4.
function the bim format name of {integer:paperCode}:
    execute:
        return (the string form of "A") + (the string form of paperCode)

# Sheet `sheetId` numbered `sheetNumber`, named `title`, on paper
# `paperCode` (A0 to A4), turned landscape when `wide`; its viewports kept.
# False, and the sheet unchanged, for a missing sheet, an unknown paper, an
# empty number or a number another sheet already has.
function set bim sheet {a 64 bit integer:sheetId} number {a string:sheetNumber} name {a string:title} paper {integer:paperCode} landscape {boolean:wide} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim sheet index of sheetId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        if ((paperCode < bim a0 paper) or (paperCode > bim a4 paper)) or ((the length of sheetNumber) = 0):
            return false
        loop sheetCursor from 0 to the length of (target's sheets's values):
            set otherSheet to the item at sheetCursor in (target's sheets's values)
            if (otherSheet's id != sheetId) and (otherSheet's number = sheetNumber):
                return false
        set sheetValue to the item at found's position in (target's sheets's values)
        set keptViewports to the cad clone of sheetValue's viewports
        replace item at index found's position in (target's sheets's values) with (@intrinsic("construct", a bim sheet record, sheetValue's id, sheetNumber, title, paperCode, wide, keptViewports))
        note bim change of sheetId in target
        return true

# The scale the title block states: the scale of the plans and sections on
# sheet `sheetValue` when they share one ("1:50"), "As indicated" when they
# differ, and empty when it has none.
function the bim scale text of sheet {bim sheet record:sheetValue} in {bim model record:modelValue}:
    execute:
        return the bim scale text of sheet sheetValue in modelValue saying (the string form of "As indicated") when mixed

# The same, saying `mixedText` when the scales differ.
function the bim scale text of sheet {bim sheet record:sheetValue} in {bim model record:modelValue} saying {a string:mixedText} when mixed:
    execute:
        set sharedScale to 0
        set differing to false
        loop cursor from 0 to the length of (sheetValue's viewports's values):
            set found to the bim view index of (the item at cursor in (sheetValue's viewports's values))'s viewId in modelValue
            if found's valid:
                set viewValue to the item at found's position in (modelValue's views's values)
                if ((viewValue's kind = bim plan view) or (viewValue's kind = bim section view)) or (bim view viewValue is an elevation):
                    set viewScale to (the bim scale of view viewValue's id in modelValue) as an integer
                    if sharedScale = 0:
                        set sharedScale to viewScale
                    else if sharedScale != viewScale:
                        set differing to true
        if differing:
            return mixedText
        if sharedScale = 0:
            return the string form of ""
        return (the string form of "1:") + (the string form of sharedScale)

# ---------------------------------------------------------------- placement

function bim frame {bim sheet frame record:first} overlaps frame {bim sheet frame record:second}:
    execute:
        set acrossOverlap to (first's low's x < second's high's x) and (second's low's x < first's high's x)
        set upOverlap to (first's low's y < second's high's y) and (second's low's y < first's high's y)
        return acrossOverlap and upOverlap

# The clear areas of sheet `sheetValue`, where views go: the drawing frame
# less the column its title block (with the revision table) and its legend
# take at the lower right. Area 0 runs the frame's full height left of that
# column, area 1 its full width above it.
function the bim clear area {integer:areaIndex} of sheet {bim sheet record:sheetValue} in {bim model record:modelValue}:
    execute:
        set drawingFrame to the bim drawing frame of sheet sheetValue
        set titleBlock to the bim title block of sheet sheetValue in modelValue
        set columnLeft to titleBlock's low's x
        set columnTop to titleBlock's high's y
        set legendBlock to the bim legend block of sheet sheetValue in modelValue
        if legendBlock's valid:
            set columnLeft to the minimum of columnLeft and legendBlock's low's x
            set columnTop to the maximum of columnTop and legendBlock's high's y
        if areaIndex = 0:
            return @intrinsic("construct", a bim sheet frame record, true, drawingFrame's low, a cad vector2 with x columnLeft and y drawingFrame's high's y)
        return @intrinsic("construct", a bim sheet frame record, true, a cad vector2 with x drawingFrame's low's x and y columnTop, drawingFrame's high)

# Where a newly placed view `viewId` goes on sheet `sheetValue`: the middle
# of the clear area (`the bim clear area … of sheet`) its frame fits best, the
# one that leaves the most room around it at its scale; the area left of
# the title block when the view shows nothing yet.
function the bim clear middle for view {a 64 bit integer:viewId} on sheet {bim sheet record:sheetValue} in {bim model record:modelValue}:
    execute:
        set origin to a cad vector2 with x 0.0 and y 0.0
        set probe to the bim frame of viewport (@intrinsic("construct", a bim viewport record, viewId, origin, the bim model centre of view viewId in modelValue)) in modelValue
        set probeWidth to 0.0
        set probeHeight to 0.0
        if probe's valid:
            set probeWidth to probe's high's x - probe's low's x
            set probeHeight to probe's high's y - probe's low's y
        set chosenArea to the bim clear area 0 of sheet sheetValue in modelValue
        set chosenRoom to -1e300
        loop areaIndex from 0 to 2:
            set candidate to the bim clear area areaIndex of sheet sheetValue in modelValue
            set candidateRoom to the minimum of ((candidate's high's x - candidate's low's x) - probeWidth) and ((candidate's high's y - candidate's low's y) - probeHeight)
            if candidateRoom > chosenRoom:
                set chosenArea to candidate
                set chosenRoom to candidateRoom
        return a cad vector2 with x ((chosenArea's low's x + chosenArea's high's x) * 0.5) and y ((chosenArea's low's y + chosenArea's high's y) * 0.5)

# What is wrong with how views are placed on sheet `sheetValue`: a viewport
# of a missing view or one without an extent, a view outside the drawing
# frame, over the title block (its revision table too) or the legend, or
# over another view. Empty
# when the placement is sound.
function the bim placement fault of sheet {bim sheet record:sheetValue} in {bim model record:modelValue}:
    execute:
        set drawingFrame to the bim drawing frame of sheet sheetValue
        set titleBlock to the bim title block of sheet sheetValue in modelValue
        set legendBlock to the bim legend block of sheet sheetValue in modelValue
        set placedList to sheetValue's viewports's values
        loop cursor from 0 to the length of placedList:
            set placedViewport to the item at cursor in placedList
            set label to (the string form of "viewport ") + (the string form of cursor)
            if (the bim view index of placedViewport's viewId in modelValue)'s valid = false:
                return label + (the string form of " shows a missing view")
            set placedFrame to the bim frame of viewport placedViewport in modelValue
            if placedFrame's valid = false:
                return label + (the string form of " has nothing to show")
            set insideAcross to (placedFrame's low's x >= drawingFrame's low's x) and (placedFrame's high's x <= drawingFrame's high's x)
            set insideUp to (placedFrame's low's y >= drawingFrame's low's y) and (placedFrame's high's y <= drawingFrame's high's y)
            if (insideAcross and insideUp) = false:
                return label + (the string form of " runs past the border")
            if bim frame placedFrame overlaps frame titleBlock:
                return label + (the string form of " lies over the title block")
            if legendBlock's valid:
                if bim frame placedFrame overlaps frame legendBlock:
                    return label + (the string form of " lies over the legend")
            loop otherCursor from 0 to cursor:
                set otherFrame to the bim frame of viewport (the item at otherCursor in placedList) in modelValue
                if otherFrame's valid:
                    if bim frame placedFrame overlaps frame otherFrame:
                        return (label + (the string form of " lies over viewport ")) + (the string form of otherCursor)
        return the string form of ""
