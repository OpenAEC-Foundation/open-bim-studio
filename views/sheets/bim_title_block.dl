# SPDX-License-Identifier: MPL-2.0
# A sheet's drawing frame and title block on paper (drawing quality plan,
# item 10), recorded on a canvas the screen, the PDF and the SVG share:
# - the drawing frame of NEN-EN-ISO 5457, 20 mm from the left edge and 10
#   mm from the others, 0.7 mm wide, with a centring mark on each side;
# - the stamp of NEN-EN-ISO 7200 in its lower right corner, 180 mm by 48
#   mm in five rows: the project and its number; the client, the architect
#   and the phase; the drawing's title; its date, who drew and checked it,
#   its scale; its number, current revision and paper;
# - the revision table over the stamp: a heading and the latest revisions,
#   the newest on top.
# Every label has its height in millimetres (ISO 3098): captions 1.8,
# values 2.5, the project and the title 3.5, the drawing number 7. The
# captions come from the message catalogue, so a Dutch interface writes a
# Dutch title block. Needs no editor, font or geometry evaluation.
import views/sheets/bim_sheet.dl
import views/sheets/bim_sheet_paper.dl
import viewer/bim_canvas.dl
import localisation/bim_catalogue.dl
import localisation/bim_utf8.dl
import bim/bim_project_settings.dl

# Text heights in millimetres.
function the bim caption height:
    replacement:
        1.8
function the bim title height:
    replacement:
        3.5
function the bim drawing number height:
    replacement:
        7.0

# Line widths, in the canvas's stroke units (a quarter of a millimetre on
# paper): the frame and the title block's outline 0.7 mm, its rules 0.25 mm.
function the bim frame line width:
    replacement:
        2.8
function the bim rule line width:
    replacement:
        1.0

# How far a centring mark reaches into the drawing frame, in millimetres.
function the bim centring mark reach:
    replacement:
        5.0

# `cellText` cut to what fits `cellWidth` millimetres at `textHeight` (at
# 0.6 of the height per character, the average of a sans serif face), never
# inside a UTF-8 character.
function the bim stamp text {a string:cellText} fitted to {a 64 bit floating-point number:cellWidth} at {a 64 bit floating-point number:textHeight}:
    execute:
        set fitting to ((cellWidth - 3.0) / (textHeight * 0.6)) as an integer
        if (the length of cellText) <= fitting:
            return cellText
        set kept to the bim utf8 prefix limit of cellText at fitting
        return the substring of cellText from 0 spanning kept bytes

# Column `columnIndex` of the revision table for `shownRevision`: its
# code, date, description, drawn and checked by.
local function the bim revision column {integer:columnIndex} of {bim sheet revision record:shownRevision}:
    execute:
        if columnIndex = 1:
            return shownRevision's date
        if columnIndex = 2:
            return shownRevision's description
        if columnIndex = 3:
            return shownRevision's drawnBy
        if columnIndex = 4:
            return shownRevision's checkedBy
        return shownRevision's code

# A cell of the title block between `cellLow` and `cellHigh` (sheet
# millimetres): its caption in the upper left corner, its text on the
# baseline 1.8 mm above its bottom (2 mm for the drawing number).
local function record bim stamp cell {a string:captionText} saying {a string:cellText} sized {a 64 bit floating-point number:textHeight} between {cad vector2:cellLow} and {cad vector2:cellHigh} on paper at {cad vector2:corner} scaled {a 64 bit floating-point number:perMillimetre} onto {a pointer to a bim canvas record:canvas}:
    execute:
        set cellWidth to cellHigh's x - cellLow's x
        if (the length of captionText) > 0:
            set captionAt to the bim sheet pixel of (a cad vector2 with x (cellLow's x + 1.5) and y (cellHigh's y - 2.4)) from corner at perMillimetre
            record bim text (the bim stamp text captionText fitted to cellWidth at (the bim caption height)) at captionAt's x and captionAt's y sized (the bim caption height) coloured 0, 0 and 0 on canvas
        if (the length of cellText) > 0:
            set lift to 1.8
            if textHeight > 5.0:
                set lift to 2.0
            set textAt to the bim sheet pixel of (a cad vector2 with x (cellLow's x + 1.5) and y (cellLow's y + lift)) from corner at perMillimetre
            record bim text (the bim stamp text cellText fitted to cellWidth at textHeight) at textAt's x and textAt's y sized textHeight coloured 0, 0 and 0 on canvas

# The pixels of the line from `first` to `second` (sheet millimetres),
# appended to `pairs`.
local function append bim paper line from {cad vector2:first} to {cad vector2:second} on paper at {cad vector2:corner} scaled {a 64 bit floating-point number:perMillimetre} into {a pointer to a list:pairs}:
    execute:
        append (the bim sheet pixel of first from corner at perMillimetre) to pairs
        append (the bim sheet pixel of second from corner at perMillimetre) to pairs

# The drawing frame of sheet `sheetValue` and its four centring marks.
function record bim drawing frame of sheet {bim sheet record:sheetValue} from {cad vector2:corner} at {a 64 bit floating-point number:perMillimetre} on {a pointer to a bim canvas record:canvas}:
    execute:
        set canvas's paperScale to perMillimetre
        set sheetSize to the bim size of sheet sheetValue
        set drawingFrame to the bim drawing frame of sheet sheetValue
        set lowCorner to drawingFrame's low
        set highCorner to drawingFrame's high
        set framePixels to an empty list of a cad vector2
        append bim paper line from lowCorner to (a cad vector2 with x highCorner's x and y lowCorner's y) on paper at corner scaled perMillimetre into framePixels
        append bim paper line from (a cad vector2 with x highCorner's x and y lowCorner's y) to highCorner on paper at corner scaled perMillimetre into framePixels
        append bim paper line from highCorner to (a cad vector2 with x lowCorner's x and y highCorner's y) on paper at corner scaled perMillimetre into framePixels
        append bim paper line from (a cad vector2 with x lowCorner's x and y highCorner's y) to lowCorner on paper at corner scaled perMillimetre into framePixels
        # Centring marks: from the paper's edge to 5 mm into the frame, at
        # the middle of each side.
        set middleX to sheetSize's x * 0.5
        set middleY to sheetSize's y * 0.5
        set reachIn to the bim centring mark reach
        append bim paper line from (a cad vector2 with x 0.0 and y middleY) to (a cad vector2 with x (lowCorner's x + reachIn) and y middleY) on paper at corner scaled perMillimetre into framePixels
        append bim paper line from (a cad vector2 with x sheetSize's x and y middleY) to (a cad vector2 with x (highCorner's x - reachIn) and y middleY) on paper at corner scaled perMillimetre into framePixels
        append bim paper line from (a cad vector2 with x middleX and y 0.0) to (a cad vector2 with x middleX and y (lowCorner's y + reachIn)) on paper at corner scaled perMillimetre into framePixels
        append bim paper line from (a cad vector2 with x middleX and y sheetSize's y) to (a cad vector2 with x middleX and y (highCorner's y - reachIn)) on paper at corner scaled perMillimetre into framePixels
        record bim pen (bim border pen) strokes framePixels coloured 0, 0 and 0 wide (the bim frame line width) on canvas
        free framePixels

# The title block of sheet `sheetValue`: its stamp and its revision table,
# their captions in the language of `catalogue`.
function record bim title block of sheet {bim sheet record:sheetValue} in {bim model record:modelValue} with {bim message catalogue record:catalogue} from {cad vector2:corner} at {a 64 bit floating-point number:perMillimetre} on {a pointer to a bim canvas record:canvas}:
    execute:
        set canvas's paperScale to perMillimetre
        set stampFrame to the bim title block of sheet sheetValue
        set whole to the bim title block of sheet sheetValue in modelValue
        set left to stampFrame's low's x
        set across to (stampFrame's high's x - left) / 180.0
        set base to stampFrame's low's y
        # The rows' tops: 12 mm for the drawing number, 9 mm for the others.
        set rowTops to [base + 12.0, base + 21.0, base + 30.0, base + 39.0, base + 48.0]
        set outline to an empty list of a cad vector2
        set rules to an empty list of a cad vector2
        append bim paper line from whole's low to (a cad vector2 with x whole's high's x and y whole's low's y) on paper at corner scaled perMillimetre into outline
        append bim paper line from (a cad vector2 with x whole's high's x and y whole's low's y) to whole's high on paper at corner scaled perMillimetre into outline
        append bim paper line from whole's high to (a cad vector2 with x whole's low's x and y whole's high's y) on paper at corner scaled perMillimetre into outline
        append bim paper line from (a cad vector2 with x whole's low's x and y whole's high's y) to whole's low on paper at corner scaled perMillimetre into outline
        # The stamp's top, under the revision table, is drawn as wide as the
        # outline.
        append bim paper line from (a cad vector2 with x left and y (base + 48.0)) to (a cad vector2 with x stampFrame's high's x and y (base + 48.0)) on paper at corner scaled perMillimetre into outline
        loop rowCursor from 0 to 4:
            set ruleY to the item at rowCursor in rowTops
            append bim paper line from (a cad vector2 with x left and y ruleY) to (a cad vector2 with x stampFrame's high's x and y ruleY) on paper at corner scaled perMillimetre into rules
        # Columns: each row's dividers in millimetres of a 180 mm stamp.
        set dividerRows to [0, 0, 0, 1, 1, 1, 3, 3, 4]
        set dividerAt to [80.0, 110.0, 135.0, 45.0, 90.0, 135.0, 70.0, 135.0, 135.0]
        loop dividerCursor from 0 to 9:
            set rowIndex to the item at dividerCursor in dividerRows
            set dividerX to left + ((the item at dividerCursor in dividerAt) * across)
            set rowBottom to base
            if rowIndex > 0:
                set rowBottom to the item at (rowIndex - 1) in rowTops
            append bim paper line from (a cad vector2 with x dividerX and y rowBottom) to (a cad vector2 with x dividerX and y (the item at rowIndex in rowTops)) on paper at corner scaled perMillimetre into rules
        set sheetId to sheetValue's id
        set valueHeight to the bim paper text height
        # Row 1: the drawing number, the current revision, the paper and
        # the page of a sheetview's book.
        record bim stamp cell (the bim message (the string form of "sheet.sheet") defaulting to (the string form of "Sheet") in catalogue) saying sheetValue's number sized (the bim drawing number height) between (a cad vector2 with x left and y base) and (a cad vector2 with x (left + (80.0 * across)) and y (base + 12.0)) on paper at corner scaled perMillimetre onto canvas
        record bim stamp cell (the bim message (the string form of "sheet.revision") defaulting to (the string form of "Revision") in catalogue) saying (the bim current revision of sheet sheetId in modelValue) sized (the bim title height) between (a cad vector2 with x (left + (80.0 * across)) and y base) and (a cad vector2 with x (left + (110.0 * across)) and y (base + 12.0)) on paper at corner scaled perMillimetre onto canvas
        record bim stamp cell (the bim message (the string form of "sheet.format") defaulting to (the string form of "Format") in catalogue) saying (the bim format name of (sheetValue's paper)) sized (the bim title height) between (a cad vector2 with x (left + (110.0 * across)) and y base) and (a cad vector2 with x (left + (135.0 * across)) and y (base + 12.0)) on paper at corner scaled perMillimetre onto canvas
        record bim stamp cell (the string form of "Open BIM Studio") saying (the bim page text of sheet sheetId in modelValue) sized valueHeight between (a cad vector2 with x (left + (135.0 * across)) and y base) and (a cad vector2 with x stampFrame's high's x and y (base + 12.0)) on paper at corner scaled perMillimetre onto canvas
        # Row 2: date, drawn, checked and scale.
        set scaleText to the bim scale text of sheet sheetValue in modelValue saying (the bim message (the string form of "sheet.as_indicated") defaulting to (the string form of "As indicated") in catalogue) when mixed
        set rowLow to base + 12.0
        set rowHigh to base + 21.0
        record bim stamp cell (the bim message (the string form of "sheet.date") defaulting to (the string form of "Date") in catalogue) saying (the bim sheet field (the bim sheet date field) of sheet sheetId in modelValue) sized valueHeight between (a cad vector2 with x left and y rowLow) and (a cad vector2 with x (left + (45.0 * across)) and y rowHigh) on paper at corner scaled perMillimetre onto canvas
        record bim stamp cell (the bim message (the string form of "sheet.drawn") defaulting to (the string form of "Drawn") in catalogue) saying (the bim sheet field (the bim sheet drawn field) of sheet sheetId in modelValue) sized valueHeight between (a cad vector2 with x (left + (45.0 * across)) and y rowLow) and (a cad vector2 with x (left + (90.0 * across)) and y rowHigh) on paper at corner scaled perMillimetre onto canvas
        record bim stamp cell (the bim message (the string form of "sheet.checked") defaulting to (the string form of "Checked") in catalogue) saying (the bim sheet field (the bim sheet checked field) of sheet sheetId in modelValue) sized valueHeight between (a cad vector2 with x (left + (90.0 * across)) and y rowLow) and (a cad vector2 with x (left + (135.0 * across)) and y rowHigh) on paper at corner scaled perMillimetre onto canvas
        record bim stamp cell (the bim message (the string form of "sheet.scale") defaulting to (the string form of "Scale") in catalogue) saying scaleText sized valueHeight between (a cad vector2 with x (left + (135.0 * across)) and y rowLow) and (a cad vector2 with x stampFrame's high's x and y rowHigh) on paper at corner scaled perMillimetre onto canvas
        # Row 3: the drawing's title.
        set rowLow to base + 21.0
        set rowHigh to base + 30.0
        record bim stamp cell (the bim message (the string form of "sheet.title") defaulting to (the string form of "Title") in catalogue) saying sheetValue's name sized (the bim title height) between (a cad vector2 with x left and y rowLow) and (a cad vector2 with x stampFrame's high's x and y rowHigh) on paper at corner scaled perMillimetre onto canvas
        # Row 4: client, architect and phase.
        set rowLow to base + 30.0
        set rowHigh to base + 39.0
        record bim stamp cell (the bim message (the string form of "sheet.client") defaulting to (the string form of "Client") in catalogue) saying (the bim project text (bim project client field) of modelValue) sized valueHeight between (a cad vector2 with x left and y rowLow) and (a cad vector2 with x (left + (70.0 * across)) and y rowHigh) on paper at corner scaled perMillimetre onto canvas
        record bim stamp cell (the bim message (the string form of "sheet.architect") defaulting to (the string form of "Architect") in catalogue) saying (the bim project text (bim project architect field) of modelValue) sized valueHeight between (a cad vector2 with x (left + (70.0 * across)) and y rowLow) and (a cad vector2 with x (left + (135.0 * across)) and y rowHigh) on paper at corner scaled perMillimetre onto canvas
        record bim stamp cell (the bim message (the string form of "sheet.phase") defaulting to (the string form of "Phase") in catalogue) saying (the bim project text (bim project phase field) of modelValue) sized valueHeight between (a cad vector2 with x (left + (135.0 * across)) and y rowLow) and (a cad vector2 with x stampFrame's high's x and y rowHigh) on paper at corner scaled perMillimetre onto canvas
        # Row 5: the project and its number.
        set rowLow to base + 39.0
        set rowHigh to base + 48.0
        record bim stamp cell (the bim message (the string form of "sheet.project") defaulting to (the string form of "Project") in catalogue) saying (the bim project text (bim project name field) of modelValue) sized (the bim title height) between (a cad vector2 with x left and y rowLow) and (a cad vector2 with x (left + (135.0 * across)) and y rowHigh) on paper at corner scaled perMillimetre onto canvas
        record bim stamp cell (the bim message (the string form of "sheet.project_number") defaulting to (the string form of "Project number") in catalogue) saying (the bim project text (bim project number field) of modelValue) sized valueHeight between (a cad vector2 with x (left + (135.0 * across)) and y rowLow) and (a cad vector2 with x stampFrame's high's x and y rowHigh) on paper at corner scaled perMillimetre onto canvas
        # The revision table: its heading on the stamp, the latest
        # revisions over it, the newest on top.
        set tableColumns to [0.0, 15.0, 45.0, 130.0, 155.0, 180.0]
        set tableKeys to [the string form of "sheet.rev", the string form of "sheet.date", the string form of "sheet.description", the string form of "sheet.drawn", the string form of "sheet.checked"]
        set tableEnglish to [the string form of "Rev.", the string form of "Date", the string form of "Description", the string form of "Drawn", the string form of "Checked"]
        set revisionList to the bim revisions of sheet sheetId in modelValue
        set listed to the minimum of (the length of revisionList) and (the bim revision rows shown)
        set firstListed to (the length of revisionList) - listed
        set rowStep to the bim revision row height
        set tableBottom to base + 48.0
        loop rowCursor from 0 to (listed + 1):
            set ruleY to tableBottom + (((rowCursor + 1) as a 64 bit floating-point number) * rowStep)
            if rowCursor < listed:
                append bim paper line from (a cad vector2 with x left and y ruleY) to (a cad vector2 with x stampFrame's high's x and y ruleY) on paper at corner scaled perMillimetre into rules
        loop columnCursor from 1 to 5:
            set columnX to left + ((the item at columnCursor in tableColumns) * across)
            append bim paper line from (a cad vector2 with x columnX and y tableBottom) to (a cad vector2 with x columnX and y whole's high's y) on paper at corner scaled perMillimetre into rules
        loop columnCursor from 0 to 5:
            set headingAt to the bim sheet pixel of (a cad vector2 with x ((left + ((the item at columnCursor in tableColumns) * across)) + 1.5) and y (tableBottom + 1.6)) from corner at perMillimetre
            record bim text (the bim message (the item at columnCursor in tableKeys) defaulting to (the item at columnCursor in tableEnglish) in catalogue) at headingAt's x and headingAt's y sized (the bim caption height) coloured 0, 0 and 0 on canvas
        loop rowCursor from 0 to listed:
            set listedRevision to the item at (firstListed + rowCursor) in revisionList
            set rowFoot to tableBottom + (((rowCursor + 1) as a 64 bit floating-point number) * rowStep)
            loop columnCursor from 0 to 5:
                set columnLeft to left + ((the item at columnCursor in tableColumns) * across)
                set columnWidth to ((the item at (columnCursor + 1) in tableColumns) - (the item at columnCursor in tableColumns)) * across
                set entryAt to the bim sheet pixel of (a cad vector2 with x (columnLeft + 1.5) and y (rowFoot + 1.4)) from corner at perMillimetre
                record bim text (the bim stamp text (the bim revision column columnCursor of listedRevision) fitted to columnWidth at valueHeight) at entryAt's x and entryAt's y sized valueHeight coloured 0, 0 and 0 on canvas
        free revisionList
        record bim pen (bim thin pen) strokes rules coloured 0, 0 and 0 wide (the bim rule line width) on canvas
        record bim pen (bim frame pen) strokes outline coloured 0, 0 and 0 wide (the bim frame line width) on canvas
        free rules
        free outline
