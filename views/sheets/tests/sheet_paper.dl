# SPDX-License-Identifier: MPL-2.0
import views/sheets/bim_sheet_paper.dl
set modelValue to an empty bim model
set id to add bim sheet numbered (the string form of "A1") named (the string form of "Paper") on paper 3 landscape true to (the address of modelValue)
set sheetValue to the item at 0 in (modelValue's sheets's values)
set canvas to a new bim canvas
record bim sheet paper sheetValue from (a cad vector2 with x 20.0 and y 644.0) at 2.0 on (the address of canvas)
set batchValue to the item at 0 in (canvas's batches's values)
set first to the item at 0 in (batchValue's pixels's values)
set third to the item at 2 in (batchValue's pixels's values)
if ((first's x != 20.0) or (first's y != 50.0)) or ((third's x != 860.0) or (third's y != 644.0)):
    @intrinsic("call", "libc", "exit", nothing, 1)
if (the length of (batchValue's pixels's values)) != 6:
    @intrinsic("call", "libc", "exit", nothing, 1)
print "sheet paper geometry PASS" as a line
