# SPDX-License-Identifier: MPL-2.0
# A view dragged from the project browser onto a sheet (#128): it is placed
# where it is dropped, on the sheet's 5 mm grid or lined up with another
# viewport's edge or middle within the snap reach; a view already on a sheet
# is refused, since a view sits on one sheet; a schedule may stand on many,
# its view made the first time.
import views/sheets/bim_sheet_workspace.dl
import exchange/ifcx/bim_file.dl

function check sheet drop {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# Whether viewport `index` of sheet `sheetId` is centred at `expected`.
function viewport {integer:index} of {a 64 bit integer:sheetId} in {bim model record:modelValue} sits at {cad vector2:expected}:
    execute:
        set sheetFound to the bim sheet index of sheetId in modelValue
        set viewportList to (the item at sheetFound's position in (modelValue's sheets's values))'s viewports's values
        if index >= (the length of viewportList):
            return false
        return (the cad distance from (the item at index in viewportList)'s centre to expected) < 1e-9

# A plan cropped to 10 by 6 metres: at 1:100 a frame of 100 by 60 mm.
function the cropped plan named {a string:title} on {a 64 bit integer:levelId} in {a pointer to a bim model record:target}:
    execute:
        set fresh to add bim view of kind bim plan view named title on levelId to target
        set made to the item at (the bim view index of fresh in (@intrinsic("dereference", target)))'s position in (target's views's values)
        set made's cropped to true
        set made's cropLow to a cad vector2 with x 0.0 and y 0.0
        set made's cropHigh to a cad vector2 with x 10.0 and y 6.0
        store bim view made in target
        return fresh

set modelValue to an empty bim model
set target to the address of modelValue
set levelId to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set planA to the cropped plan named (the string form of "Plan A") on levelId in target
set planB to the cropped plan named (the string form of "Plan B") on levelId in target
set sheetId to add bim sheet numbered (the string form of "A101") named (the string form of "Plans") on paper 3 landscape true to target
set otherSheet to add bim sheet numbered (the string form of "A102") named (the string form of "More plans") on paper 3 landscape true to target

# Alone on the sheet, a view lands on the grid.
check sheet drop ((the bim drop of view planA on sheet sheetId at (a cad vector2 with x 101.7 and y 150.9) within 4.0 in target) = bim view dropped) named (the string form of "a plan dropped on a sheet is placed")
check sheet drop (viewport 0 of sheetId in modelValue sits at (a cad vector2 with x 100.0 and y 150.0)) named (the string form of "its centre lands on the 5 mm grid")
check sheet drop ((the bim sheet showing view planA in modelValue) = sheetId) named (the string form of "the sheet showing the view is found")
check sheet drop ((the bim sheet showing view planB in modelValue) = the bim refused id) named (the string form of "a view on no sheet is on none")

# A view sits on one sheet.
check sheet drop ((the bim drop of view planA on sheet otherSheet at (a cad vector2 with x 100.0 and y 150.0) within 4.0 in target) = bim view already on a sheet) named (the string form of "a view already on a sheet is refused on another")
check sheet drop ((the bim drop of view planA on sheet sheetId at (a cad vector2 with x 300.0 and y 150.0) within 4.0 in target) = bim view already on a sheet) named (the string form of "and on its own sheet again")
check sheet drop ((the length of ((the item at (the bim sheet index of otherSheet in modelValue)'s position in (modelValue's sheets's values))'s viewports's values)) = 0) named (the string form of "a refused drop places nothing")

# Plan B (100 by 60 mm) dropped 3.1 mm right of Plan A's right edge and 3.4
# mm above its middle: its left edge and middle line up with Plan A's, not
# the grid's 205 and 155.
check sheet drop ((the bim drop of view planB on sheet sheetId at (a cad vector2 with x 203.1 and y 153.4) within 4.0 in target) = bim view dropped) named (the string form of "a second plan dropped beside the first")
check sheet drop (viewport 1 of sheetId in modelValue sits at (a cad vector2 with x 200.0 and y 150.0)) named (the string form of "it lines up with the first's edge and middle")
check sheet drop ((the bim placement fault of sheet (the item at (the bim sheet index of sheetId in modelValue)'s position in (modelValue's sheets's values)) in modelValue) = (the string form of "")) named (the string form of "the two touch without overlapping")

# A schedule may stand on many sheets; its view is made once.
set doorSchedule to the made bim view of schedule 2 named (the string form of "Door schedule") in target
check sheet drop ((the made bim view of schedule 2 named (the string form of "Door schedule") in target) = doorSchedule) named (the string form of "a schedule's view is made once")
check sheet drop ((the bim drop of view doorSchedule on sheet sheetId at (a cad vector2 with x 30.2 and y 280.1) within 4.0 in target) = bim view dropped) named (the string form of "a schedule dropped on a sheet is placed")
check sheet drop (viewport 2 of sheetId in modelValue sits at (a cad vector2 with x 30.0 and y 280.0)) named (the string form of "its top left corner lands on the grid")
check sheet drop ((the bim drop of view doorSchedule on sheet otherSheet at (a cad vector2 with x 30.0 and y 280.0) within 4.0 in target) = bim view dropped) named (the string form of "and again on another sheet")

check sheet drop ((the bim drop of view (987654 as a 64 bit integer) on sheet sheetId at (a cad vector2 with x 30.0 and y 30.0) within 4.0 in target) = bim view drop refused) named (the string form of "a missing view is refused")
check sheet drop ((the bim drop of view planB on sheet (987654 as a 64 bit integer) at (a cad vector2 with x 30.0 and y 30.0) within 4.0 in target) = bim view drop refused) named (the string form of "a missing sheet is refused")

# The title types by name, for the properties and the menus (#112).
print (((the bim name of viewport title type 0) + (the string form of " / ")) + ((the bim name of viewport title type 1) + ((the string form of " / ") + (the bim name of viewport title type 2)))) as a line
