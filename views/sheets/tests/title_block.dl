# SPDX-License-Identifier: MPL-2.0
# Title block, project data and revisions (drawing quality plan, item 10):
# the project's name, number, client, architect and phase and a sheet's
# date, drawn and checked by and two revisions, kept through .bim and
# .ifcx and written to IFC; the drawing frame of NEN-EN-ISO 5457 and the
# stamp with its revision table recorded with a Dutch catalogue and read
# back from the PDF and the SVG: the captions in Dutch, each label at its
# own height in millimetres, UTF-8 (ß, ø, ²) kept in the SVG and lettered
# in the PDF's embedded osifont, which maps them back to Unicode.
import views/sheets/bim_title_block.dl
import views/export/bim_svg.dl
import exchange/ifcx/bim_file.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl

function check title block {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The line of `document` that holds `wanted`, "" when none does.
function the title test line of {a string:document} holding {a string:wanted}:
    execute:
        set documentLines to document split at "\n"
        set found to the string form of ""
        loop cursor from 0 to the length of documentLines:
            set candidate to the item at cursor in documentLines
            if ((the length of found) = 0) and ((the index of wanted in candidate) >= 0):
                set found to candidate
        free documentLines
        return found

# The size the PDF writes the label `wanted` at ("" when it is not there):
# the number between "/F1 " and " Tf" on its line, which shows its glyphs
# in osifont.
function the title test pdf size of {a string:wanted} in {a string:document}:
    execute:
        set shown to the title test line of document holding ((the bim pdf glyph string of wanted in (the bim pdf drawing font)) + (the string form of " Tj"))
        if (the length of shown) = 0:
            return the string form of ""
        set fontAt to (the index of "/F1 " in shown) + 4
        set sizeEnd to the index of " Tf" in shown
        return the substring of shown from fontAt spanning (sizeEnd - fontAt) bytes

# The font size the SVG writes the label `wanted` at ("" when it is not
# there).
function the title test svg size of {a string:wanted} in {a string:document}:
    execute:
        set shown to the title test line of document holding (((the string form of ">") + wanted) + (the string form of "</text>"))
        if (the length of shown) = 0:
            return the string form of ""
        set sizeAt to (the index of "font-size=\"" in shown) + 11
        set rest to the substring of shown from sizeAt spanning ((the length of shown) - sizeAt) bytes
        return the substring of rest from 0 spanning (the index of "\"" in rest) bytes

function show title test data of {bim model record:modelValue} for sheet {a 64 bit integer:sheetId} labelled {a string:heading}:
    execute:
        print heading as a line
        set fieldTexts to the string form of " "
        loop fieldCursor from 0 to (bim project field count):
            set fieldTexts to (fieldTexts + (the string form of " | ")) + (the bim project text fieldCursor of modelValue)
        print ((the string form of "  project") + fieldTexts) as a line
        print ((the string form of "  sheet: ") + (((the bim sheet field (the bim sheet date field) of sheet sheetId in modelValue) + (the string form of " | ")) + (((the bim sheet field (the bim sheet drawn field) of sheet sheetId in modelValue) + (the string form of " | ")) + (the bim sheet field (the bim sheet checked field) of sheet sheetId in modelValue)))) as a line
        set revisionList to the bim revisions of sheet sheetId in modelValue
        loop revisionCursor from 0 to the length of revisionList:
            set listedRevision to the item at revisionCursor in revisionList
            print ((the string form of "  revision ") + ((listedRevision's code + (the string form of " | ")) + ((listedRevision's date + (the string form of " | ")) + ((listedRevision's description + (the string form of " | ")) + ((listedRevision's drawnBy + (the string form of " | ")) + listedRevision's checkedBy))))) as a line
        free revisionList

set modelValue to an empty bim model
set target to the address of modelValue
set sheetId to add bim sheet numbered (the string form of "A-101") named (the string form of "Plattegrond begane grond") on paper 1 landscape true to target
set bim project text (bim project name field) to (the string form of "Woning Straße") in target
set bim project text (bim project number field) to (the string form of "2026-014") in target
set bim project text (bim project client field) to (the string form of "Gemeente Delft") in target
set bim project text (bim project architect field) to (the string form of "Bureau Ørsted") in target
set bim project text (bim project phase field) to (the string form of "Definitief ontwerp") in target
set bim sheet field (the bim sheet date field) of sheet sheetId to (the string form of "2026-11-06") in target
set bim sheet field (the bim sheet drawn field) of sheet sheetId to (the string form of "EV") in target
set bim sheet field (the bim sheet checked field) of sheet sheetId to (the string form of "MV") in target
check title block ((the bim revision count of sheet sheetId in modelValue) = 0) named (the string form of "a new sheet has no revisions")
check title block ((the bim next revision code of sheet sheetId in modelValue) = (the string form of "A")) named (the string form of "its first revision is A")
set firstCode to add bim revision (the string form of "") dated (the string form of "2026-11-01") saying (the string form of "Eerste uitgave") drawn by (the string form of "EV") checked by (the string form of "MV") to sheet sheetId in target
set secondCode to add bim revision (the string form of "") dated (the string form of "2026-11-06") saying (the string form of "Kozijnen aangepast, 12 m²") drawn by (the string form of "EV") checked by (the string form of "MV") to sheet sheetId in target
check title block ((firstCode = (the string form of "A")) and (secondCode = (the string form of "B"))) named (the string form of "revisions take A and B")
check title block ((the bim current revision of sheet sheetId in modelValue) = (the string form of "B")) named (the string form of "the current revision is the last")
check title block ((the bim next revision code of sheet sheetId in modelValue) = (the string form of "C")) named (the string form of "the next is C")
# An empty value removes a field.
set bim project text (bim project phase field) to (the string form of "") in target
check title block ((the length of (the bim project text (bim project phase field) of modelValue)) = 0) named (the string form of "an empty phase removes it")
set bim project text (bim project phase field) to (the string form of "Definitief ontwerp") in target
show title test data of modelValue for sheet sheetId labelled (the string form of "model:")

# The frame and the title block on A1 (841 by 594 mm).
set sheetValue to the item at 0 in (modelValue's sheets's values)
set drawingFrame to the bim drawing frame of sheet sheetValue
set stampFrame to the bim title block of sheet sheetValue
set wholeFrame to the bim title block of sheet sheetValue in modelValue
print ((the string form of "drawing frame ") + ((the string form of drawingFrame's low's x) + ((the string form of ",") + ((the string form of drawingFrame's low's y) + ((the string form of " to ") + ((the string form of drawingFrame's high's x) + ((the string form of ",") + (the string form of drawingFrame's high's y)))))))) as a line
print ((the string form of "stamp ") + ((the string form of stampFrame's low's x) + ((the string form of ",") + ((the string form of stampFrame's low's y) + ((the string form of " to ") + ((the string form of stampFrame's high's x) + ((the string form of ",") + (the string form of stampFrame's high's y)))))))) as a line
print ((the string form of "with revision table to ") + (the string form of wholeFrame's high's y)) as a line

# Recorded in points, as the sheet export does, with the Dutch catalogue.
set dutchFile to the bim file content at (the string form of "localisation/messages/nl.json")
set dutch to the bim message catalogue parsed from dutchFile's text
check title block dutch's valid named (the string form of "the Dutch catalogue loads")
set pointsPerMillimetre to 72.0 / 25.4
set pointsWide to 841.0 * pointsPerMillimetre
set pointsHigh to 594.0 * pointsPerMillimetre
set paperCorner to a cad vector2 with x 0.0 and y pointsHigh
set canvas to a new bim canvas
record bim sheet paper sheetValue from paperCorner at pointsPerMillimetre on (the address of canvas)
record bim drawing frame of sheet sheetValue from paperCorner at pointsPerMillimetre on (the address of canvas)
record bim title block of sheet sheetValue in modelValue with dutch from paperCorner at pointsPerMillimetre on (the address of canvas)
set labelPoints to (the bim paper text height) * pointsPerMillimetre
set pdfText to the bim pdf of canvas sized pointsWide by pointsHigh with text labelPoints high
set svgText to the bim svg of canvas spanning pointsWide by pointsHigh on a page 841.0 by 594.0 with text labelPoints high
print (the string form of "PDF sizes (points):") as a line
set pdfLabels to [the string form of "Blad", the string form of "A-101", the string form of "Schaal", the string form of "Datum", the string form of "2026-11-06", the string form of "Getekend", the string form of "Gecontroleerd", the string form of "Tekening", the string form of "Plattegrond begane grond", the string form of "Opdrachtgever", the string form of "Gemeente Delft", the string form of "Architect", the string form of "Bureau Ørsted", the string form of "Fase", the string form of "Definitief ontwerp", the string form of "Project", the string form of "Woning Straße", the string form of "Projectnummer", the string form of "2026-014", the string form of "Revisie", the string form of "B", the string form of "Formaat", the string form of "A1", the string form of "Omschrijving", the string form of "Eerste uitgave", the string form of "Kozijnen aangepast, 12 m²"]
loop labelCursor from 0 to 26:
    set wanted to the item at labelCursor in pdfLabels
    print ((the string form of "  ") + (wanted + ((the string form of ": ") + (the title test pdf size of wanted in pdfText)))) as a line
check title block ((the title test pdf size of (the string form of "A-101") in pdfText) = (the string form of "19.84")) named (the string form of "the drawing number is 7 mm high in the PDF")
check title block ((the title test pdf size of (the string form of "Plattegrond begane grond") in pdfText) = (the string form of "9.92")) named (the string form of "the title is 3.5 mm high in the PDF")
check title block ((the title test pdf size of (the string form of "Gemeente Delft") in pdfText) = (the string form of "7.09")) named (the string form of "values are 2.5 mm high in the PDF")
check title block ((the title test pdf size of (the string form of "Blad") in pdfText) = (the string form of "5.10")) named (the string form of "captions are 1.8 mm high in the PDF")
set sharpS to the bim pdf glyph of character 223 in (the bim pdf drawing font)
check title block ((sharpS > 0) and ((the index of (((the string form of "<") + (the bim pdf hex of sharpS)) + (the string form of "> <00DF>")) in pdfText) >= 0)) named (the string form of "ß has its own glyph in the PDF and maps back to U+00DF")
print (the string form of "SVG:") as a line
print ((the string form of "  ") + (the title test line of svgText holding (the string form of ">Woning Straße</text>"))) as a line
print ((the string form of "  ") + (the title test line of svgText holding (the string form of ">Bureau Ørsted</text>"))) as a line
print ((the string form of "  ") + (the title test line of svgText holding (the string form of ">Kozijnen aangepast, 12 m²</text>"))) as a line
check title block ((the title test svg size of (the string form of "A-101") in svgText) = (the string form of "19.84")) named (the string form of "the drawing number is 7 mm high in the SVG")
check title block ((the title test svg size of (the string form of "Woning Straße") in svgText) = (the string form of "9.92")) named (the string form of "the project name keeps ß in the SVG at 3.5 mm")
check title block ((the length of (the title test svg size of (the string form of "Bureau Ørsted") in svgText)) > 0) named (the string form of "the architect keeps ø in the SVG")
check title block ((the length of (the title test svg size of (the string form of "Kozijnen aangepast, 12 m²") in svgText)) > 0) named (the string form of "the revision keeps ² in the SVG")

# Without a catalogue the captions are English.
set english to a new bim canvas
record bim title block of sheet sheetValue in modelValue with (an empty bim message catalogue) from paperCorner at pointsPerMillimetre on (the address of english)
set englishPdf to the bim pdf of english sized pointsWide by pointsHigh with text labelPoints high
set englishCaptions to [the string form of "Sheet", the string form of "Scale", the string form of "Date", the string form of "Drawn", the string form of "Checked", the string form of "Client", the string form of "Phase", the string form of "Project number", the string form of "Revision", the string form of "Rev.", the string form of "Description"]
set allEnglish to true
loop captionCursor from 0 to 11:
    if (the length of (the title test pdf size of (the item at captionCursor in englishCaptions) in englishPdf)) = 0:
        print ((the string form of "  missing: ") + (the item at captionCursor in englishCaptions)) as a line
        set allEnglish to false
check title block allEnglish named (the string form of "without a catalogue the captions are English")

# The frame: its line and the four centring marks, 0.7 mm wide.
set frameBatch to the item at 1 in (canvas's batches's values)
check title block ((the length of (frameBatch's pixels's values)) = (8 * 6)) named (the string form of "the frame is four lines and four centring marks")
set firstCorner to the item at 0 in (frameBatch's pixels's values)
set secondCorner to the item at 1 in (frameBatch's pixels's values)
set frameWidth to (the absolute value of (firstCorner's y - secondCorner's y)) / pointsPerMillimetre
check title block ((the absolute value of (frameWidth - 0.7)) < 0.001) named (the string form of "the frame line is 0.7 mm")

# Kept through .bim and .ifcx.
set reread to the bim model parsed from (the bim file text of modelValue)
show title test data of reread's modelValue for sheet sheetId labelled (the string form of "from .bim:")
set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "t.ifcx") for project (the string form of "t") by (the string form of "test") at (the string form of "2026-11-06T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
show title test data of fromIfcx's modelValue for sheet sheetId labelled (the string form of "from .ifcx:")
set ifcxText to the bim ifcx text of modelValue identified as (the string form of "t.ifcx") for project (the string form of "t") by (the string form of "test") at (the string form of "2026-11-06T00:00:00Z")
check title block ((the index of "\"bsi::ifc::prop::Name\": \"Woning Straße\"" in ifcxText) >= 0) named (the string form of "IfcX names the project")

# IFC: IfcProject's Name, LongName and Phase, the client and the architect.
set ifcLines to (the bim ifc text of modelValue) split at "\n"
loop cursor from 0 to the length of ifcLines:
    set ifcLine to the item at cursor in ifcLines
    if (((the index of "IFCPROJECT(" in ifcLine) >= 0) or ((the index of "IFCACTOR" in ifcLine) >= 0)) or (((the index of "IFCORGANIZATION(" in ifcLine) >= 0) or ((the index of "IFCRELASSIGNSTOACTOR(" in ifcLine) >= 0)):
        print ifcLine as a line
free ifcLines
