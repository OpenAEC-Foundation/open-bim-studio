# SPDX-License-Identifier: MPL-2.0
# Sheetviews (#135): a book of sheets. Its pages are numbered after its
# prefix and their place (D-01, D-02, ...) and renumbered when a page is
# added, moved or removed, or a contents page is put in front; a number
# another sheet has is refused. A sheet in no book stands aloneIds, as before.
# The books are read back from .bim and .ifcx, a file without them loads as
# it did, and a book naming a missing sheet is refused.
import views/sheets/bim_sheet.dl
import exchange/ifcx/bim_file.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_ifcx_read.dl

function check sheet books {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# Each book with its pages (number and name), then the sheets in no book.
function show sheet books of {bim model record:modelValue} labelled {a string:title}:
    execute:
        print title as a line
        loop bookCursor from 0 to the length of (modelValue's sheetviews's values):
            set bookValue to the item at bookCursor in (modelValue's sheetviews's values)
            set shown to (the string form of "  ") + bookValue's name
            loop pageCursor from 0 to the length of (bookValue's pages's values):
                set pageFound to the bim sheet index of (the item at pageCursor in (bookValue's pages's values)) in modelValue
                set pageSheet to the item at pageFound's position in (modelValue's sheets's values)
                set shown to ((shown + (the string form of " | ")) + pageSheet's number) + ((the string form of " ") + pageSheet's name)
                if pageSheet's id = bookValue's contentsId:
                    set shown to shown + (the string form of " (contents)")
            print shown as a line
        loop sheetCursor from 0 to the length of (modelValue's sheets's values):
            set sheetValue to the item at sheetCursor in (modelValue's sheets's values)
            if (the bim sheetview of sheet sheetValue's id in modelValue) = the bim refused id:
                print ((the string form of "  alone: ") + sheetValue's number) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set looseSheet to add bim sheet numbered (the string form of "A-101") named (the string form of "Ground floor") on paper 1 landscape true to target
set oldSheet to add bim sheet numbered (the string form of "D-03") named (the string form of "Old detail") on paper 1 landscape true to target
set bookId to add bim sheetview named (the string form of "Detail book") numbered after (the string form of "D-") on paper 2 landscape true to target
check sheet books (bookId != the bim refused id) named (the string form of "a sheetview is made")
check sheet books ((add bim sheetview named (the string form of "Other") numbered after (the string form of "D-") on paper 1 landscape true to target) = the bim refused id) named (the string form of "a prefix another sheetview has is refused")
check sheet books ((add bim sheetview named (the string form of "Other") numbered after (the string form of "") on paper 1 landscape true to target) = the bim refused id) named (the string form of "and an empty one")
set foundationsPage to add bim page named (the string form of "Foundations") to sheetview bookId after (the bim refused id) in target
set wallsPage to add bim page named (the string form of "Walls") to sheetview bookId after foundationsPage in target
check sheet books ((foundationsPage != the bim refused id) and (wallsPage != the bim refused id)) named (the string form of "two pages are added")
check sheet books ((add bim page named (the string form of "Roof") to sheetview bookId after wallsPage in target) = the bim refused id) named (the string form of "a third is refused: D-03 is another sheet's")
check sheet books ((the length of (modelValue's sheets's values)) = 4) named (the string form of "and leaves no sheet behind")
show sheet books of modelValue labelled (the string form of "two pages:")
set pageFound to the bim sheet index of wallsPage in modelValue
check sheet books ((the item at pageFound's position in (modelValue's sheets's values))'s paper = 2) named (the string form of "a page takes the book's paper")
check sheet books ((the bim page text of sheet wallsPage in modelValue) = (the string form of "page 2 of 2")) named (the string form of "a page knows its place: page 2 of 2")
check sheet books ((the length of (the bim page text of sheet looseSheet in modelValue)) = 0) named (the string form of "a sheet alone has no page text")

# The oldSheet sheet renamed, the roofPage page fits; one put in floorsPage.
check sheet books (set bim sheet oldSheet number (the string form of "X-01") name (the string form of "Old detail") paper 1 landscape true in target) named (the string form of "the old D-03 is renumbered")
set roofPage to add bim page named (the string form of "Roof") to sheetview bookId after wallsPage in target
set floorsPage to add bim page named (the string form of "Floors") to sheetview bookId after foundationsPage in target
show sheet books of modelValue labelled (the string form of "four pages, Floors after Foundations:")

# Moving and removing renumber the pages.
check sheet books (move bim page roofPage by (-2) in target) named (the string form of "Roof moves two places earlier")
check sheet books ((move bim page foundationsPage by (-1) in target) = false) named (the string form of "the first page moves no earlier")
check sheet books ((move bim page looseSheet by 1 in target) = false) named (the string form of "a sheet alone is no page to move")
show sheet books of modelValue labelled (the string form of "Roof moved:")
check sheet books (remove bim sheet floorsPage in target) named (the string form of "Floors is removed")
check sheet books ((the bim sheet index of floorsPage in modelValue)'s valid = false) named (the string form of "its sheet is gone")
show sheet books of modelValue labelled (the string form of "Floors removed:")

# A contents page in front, listing the others; one only.
set contentsPage to add bim contents page to sheetview bookId in target
check sheet books (contentsPage != the bim refused id) named (the string form of "a contents page is added")
check sheet books ((add bim contents page to sheetview bookId in target) = the bim refused id) named (the string form of "a second is refused")
check sheet books ((the bim sheetview listed on sheet contentsPage in modelValue) = bookId) named (the string form of "it lists its book")
set listedIds to the bim listed pages of sheetview bookId in modelValue
check sheet books (((the length of listedIds) = 3) and ((the item at 0 in listedIds) = foundationsPage)) named (the string form of "the other three pages, in order")
free listedIds
show sheet books of modelValue labelled (the string form of "with contents:")
set bookIds to the bim book pages of sheet roofPage in modelValue
check sheet books ((the length of bookIds) = 4) named (the string form of "the book exports its four pages")
free bookIds
set aloneIds to the bim book pages of sheet looseSheet in modelValue
check sheet books (((the length of aloneIds) = 1) and ((the item at 0 in aloneIds) = looseSheet)) named (the string form of "a sheet alone exports itself")
free aloneIds

# Renaming the book renumbers its pages.
check sheet books (set bim sheetview bookId name (the string form of "Steel details") prefix (the string form of "S-") in target) named (the string form of "the book is renamed and renumbered")
check sheet books ((set bim sheetview bookId name (the string form of "Steel details") prefix (the string form of "X-") in target) = false) named (the string form of "a prefix giving X-01 twice is refused")
show sheet books of modelValue labelled (the string form of "renamed:")
check sheet books ((the length of (the bim sheetview fault in modelValue)) = 0) named (the string form of "the books are sound")

# Read back from .bim and .ifcx.
set saved to the bim file text of modelValue
check sheet books ((the index of (the string form of "\nsheetview ") in saved) >= 0) named (the string form of "the .bim file has a sheetview line")
set reread to the bim model parsed from saved
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", ") + reread's message))) as a line
show sheet books of reread's modelValue labelled (the string form of "from .bim:")
set native to the bim native text of ifcx (the bim ifcx text of modelValue identified as (the string form of "b.ifcx") for project (the string form of "b") by (the string form of "test") at (the string form of "2026-10-31T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of ", ") + fromIfcx's message))) as a line
show sheet books of fromIfcx's modelValue labelled (the string form of "from .ifcx:")

# A file from before books, and a book naming a missing sheet.
set older to the bim model parsed from (the string form of "BIM-SLICE 1\nnext 3\nsheet 1 1 1 0 A-101 Ground floor\nsheet 2 1 1 0 A-102 First floor\n")
print ((the string form of "older file read: ") + (the string form of older's valid)) as a line
show sheet books of older's modelValue labelled (the string form of "from the older file:")
set broken to the bim model parsed from (the string form of "BIM-SLICE 1\nnext 4\nsheet 1 1 1 0 D-01 Details\nsheetview 3 1 1 0 2 1 2 D- Detail book\n")
print ((the string form of "missing page read: ") + ((the string form of broken's valid) + ((the string form of ", ") + broken's message))) as a line

# Dissolving the book leaves its pages as sheets aloneIds.
check sheet books (remove bim sheetview bookId in target) named (the string form of "the book is dissolved")
show sheet books of modelValue labelled (the string form of "dissolved:")
