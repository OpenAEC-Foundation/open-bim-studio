# SPDX-License-Identifier: MPL-2.0
# Sheetviews (#135): a book of sheets, such as a detail book or a set of
# workshop drawings (`bim sheetview record`). Its pages are ordinary sheets,
# so placing views on them, the tabs and the export of one sheet work on a
# page as on any sheet. A page's number is the book's prefix and its place:
# "D-" and the third page give "D-03"; every change of the pages renumbers
# them. A sheet in no book is a sheetview of one page by itself.
import bim/bim_model.dl

function the bim sheetview index of {a 64 bit integer:wanted} in {bim model record:modelValue}:
    execute:
        return the bim position of wanted among (modelValue's sheetviews's values)

# Where sheet `sheetId` stands among the pages of `bookValue`, or -1.
function the bim place of page {a 64 bit integer:sheetId} in {bim sheetview record:bookValue}:
    execute:
        loop pageCursor from 0 to the length of (bookValue's pages's values):
            if (the item at pageCursor in (bookValue's pages's values)) = sheetId:
                return pageCursor
        return -1

# The sheetview sheet `sheetId` is a page of, or the refused id when it
# stands alone.
function the bim sheetview of sheet {a 64 bit integer:sheetId} in {bim model record:modelValue}:
    execute:
        loop bookCursor from 0 to the length of (modelValue's sheetviews's values):
            set bookValue to the item at bookCursor in (modelValue's sheetviews's values)
            if (the bim place of page sheetId in bookValue) >= 0:
                return bookValue's id
        return the bim refused id

# The number of page `pageIndex` (from 0) of a book numbered from
# `prefixText`: the prefix and the page, two digits at least ("D-01").
function the bim page number {integer:pageIndex} after {a string:prefixText}:
    execute:
        set digits to the string form of (pageIndex + 1)
        if (pageIndex + 1) < 10:
            set digits to (the string form of "0") + digits
        return prefixText + digits

# Whether numbering `pageList` from `prefixText` would give a page the
# number of a sheet that is not among them.
function bim pages {a pointer to a list:pageList} after {a string:prefixText} clash in {bim model record:modelValue}:
    execute:
        loop sheetCursor from 0 to the length of (modelValue's sheets's values):
            set otherSheet to the item at sheetCursor in (modelValue's sheets's values)
            set inBook to false
            loop pageCursor from 0 to the length of pageList:
                if (the item at pageCursor in pageList) = otherSheet's id:
                    set inBook to true
            if inBook = false:
                loop pageCursor from 0 to the length of pageList:
                    if otherSheet's number = (the bim page number pageCursor after prefixText):
                        return true
        return false

# Sheet `sheetId` numbered `sheetNumber`, the rest of it kept.
local function renumber bim sheet {a 64 bit integer:sheetId} as {a string:sheetNumber} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim sheet index of sheetId in (@intrinsic("dereference", target))
        if found's valid = false:
            return nothing
        set sheetValue to the item at found's position in (target's sheets's values)
        if sheetValue's number = sheetNumber:
            return nothing
        replace item at index found's position in (target's sheets's values) with (@intrinsic("construct", a bim sheet record, sheetValue's id, sheetNumber, sheetValue's name, sheetValue's paper, sheetValue's landscape, the cad clone of sheetValue's viewports))
        note bim change of sheetId in target

# Sheetview `bookValue` stored at `position` with `pageList` as its pages
# and `contentsPage` as its contents, its pages numbered after its prefix.
local function store bim sheetview {bim sheetview record:bookValue} at {integer:position} with pages {the type of (a cad topology list of a 64 bit integer):pageList} and contents {a 64 bit integer:contentsPage} in {a pointer to a bim model record:target}:
    execute:
        replace item at index position in (target's sheetviews's values) with (@intrinsic("construct", a bim sheetview record, bookValue's id, bookValue's name, bookValue's prefix, bookValue's paper, bookValue's landscape, contentsPage, pageList))
        loop pageCursor from 0 to the length of (pageList's values):
            renumber bim sheet (the item at pageCursor in (pageList's values)) as (the bim page number pageCursor after bookValue's prefix) in target
        note bim change of bookValue's id in target

# Whether `prefixText` numbers another sheetview than `bookId`.
local function bim prefix {a string:prefixText} is taken beside {a 64 bit integer:bookId} in {bim model record:modelValue}:
    execute:
        loop bookCursor from 0 to the length of (modelValue's sheetviews's values):
            set otherBook to the item at bookCursor in (modelValue's sheetviews's values)
            if (otherBook's id != bookId) and (otherBook's prefix = prefixText):
                return true
        return false

# A new sheetview named `title`, without pages: its pages numbered after
# `prefixText`, made on paper `paperCode` (A0 to A4), landscape when `wide`;
# its id. Refused for an unknown paper, an empty prefix or one another
# sheetview has.
function add bim sheetview named {a string:title} numbered after {a string:prefixText} on paper {integer:paperCode} landscape {boolean:wide} to {a pointer to a bim model record:target}:
    execute:
        if ((paperCode < bim a0 paper) or (paperCode > bim a4 paper)) or ((the length of prefixText) = 0):
            return the bim refused id
        if bim prefix prefixText is taken beside (the bim refused id) in (@intrinsic("dereference", target)):
            return the bim refused id
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim sheetview record, fresh, title, prefixText, paperCode, wide, the bim refused id, a cad topology list of a 64 bit integer)) to (target's sheetviews's values)
        note bim change of fresh in target
        return fresh

# Sheetview `bookId` named `title` and numbered after `prefixText`, its pages
# renumbered. False, and nothing changed, for a missing book, an empty
# prefix, one another sheetview has, or a page number another sheet has.
function set bim sheetview {a 64 bit integer:bookId} name {a string:title} prefix {a string:prefixText} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim sheetview index of bookId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((the length of prefixText) = 0):
            return false
        if bim prefix prefixText is taken beside bookId in (@intrinsic("dereference", target)):
            return false
        set bookValue to the item at found's position in (target's sheetviews's values)
        if bim pages (bookValue's pages's values) after prefixText clash in (@intrinsic("dereference", target)):
            return false
        set renamed to @intrinsic("construct", a bim sheetview record, bookValue's id, title, prefixText, bookValue's paper, bookValue's landscape, bookValue's contentsId, bookValue's pages)
        store bim sheetview renamed at found's position with pages (the cad clone of bookValue's pages) and contents bookValue's contentsId in target
        return true

# A new page of sheetview `bookId` named `title`, on the book's paper, after
# page `afterPage` (at the end when that is not one of its pages); its sheet
# id. Refused for a missing book, or when the pages' numbers would clash
# with another sheet's.
function add bim page named {a string:title} to sheetview {a 64 bit integer:bookId} after {a 64 bit integer:afterPage} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim sheetview index of bookId in (@intrinsic("dereference", target))
        if found's valid = false:
            return the bim refused id
        set bookValue to the item at found's position in (target's sheetviews's values)
        set slot to (the bim place of page afterPage in bookValue) + 1
        if slot <= 0:
            set slot to the length of (bookValue's pages's values)
        set kept to the cad clone of bookValue's pages
        # The page's number is settled below; a placeholder until then.
        set fresh to add bim sheet numbered bookValue's prefix named title on paper bookValue's paper landscape bookValue's landscape to target
        if fresh = the bim refused id:
            return the bim refused id
        insert fresh into (kept's values) at index slot
        if bim pages (kept's values) after bookValue's prefix clash in (@intrinsic("dereference", target)):
            remove bim plain sheet fresh in target
            return the bim refused id
        store bim sheetview bookValue at found's position with pages kept and contents bookValue's contentsId in target
        return fresh

# Sheet `sheetId`, standing alone, made the last page of sheetview `bookId`
# and numbered as such. False, and nothing changed, for a missing sheet or
# book, a sheet already in a book, or a number another sheet has.
function add bim sheet {a 64 bit integer:sheetId} to sheetview {a 64 bit integer:bookId} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim sheetview index of bookId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((the bim sheet index of sheetId in (@intrinsic("dereference", target)))'s valid = false):
            return false
        if (the bim sheetview of sheet sheetId in (@intrinsic("dereference", target))) != the bim refused id:
            return false
        set bookValue to the item at found's position in (target's sheetviews's values)
        set kept to the cad clone of bookValue's pages
        append sheetId to (kept's values)
        if bim pages (kept's values) after bookValue's prefix clash in (@intrinsic("dereference", target)):
            return false
        store bim sheetview bookValue at found's position with pages kept and contents bookValue's contentsId in target
        return true

# Page `sheetId` moved `steps` places within its sheetview (negative:
# earlier), stopping at the first and last place; the pages renumbered.
# False when it is in no book or does not move.
function move bim page {a 64 bit integer:sheetId} by {integer:steps} in {a pointer to a bim model record:target}:
    execute:
        set bookId to the bim sheetview of sheet sheetId in (@intrinsic("dereference", target))
        set found to the bim sheetview index of bookId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        set bookValue to the item at found's position in (target's sheetviews's values)
        set startPlace to the bim place of page sheetId in bookValue
        set endPlace to startPlace + steps
        if endPlace < 0:
            set endPlace to 0
        if endPlace >= (the length of (bookValue's pages's values)):
            set endPlace to (the length of (bookValue's pages's values)) - 1
        if endPlace = startPlace:
            return false
        set kept to the cad clone of bookValue's pages
        remove item startPlace from (kept's values)
        insert sheetId into (kept's values) at index endPlace
        store bim sheetview bookValue at found's position with pages kept and contents bookValue's contentsId in target
        return true

# Sheet `sheetId` taken out of the sheet list, its settings with it.
local function remove bim plain sheet {a 64 bit integer:sheetId} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim sheet index of sheetId in (@intrinsic("dereference", target))
        if found's valid = false:
            return nothing
        remove item (found's position) from (target's sheets's values)
        drop bim settings of sheetId in target
        note bim change of sheetId in target

# Sheet `sheetId` deleted: the views on it stay in the model; a page leaves
# its book, whose other pages are renumbered. False for a missing sheet.
function remove bim sheet {a 64 bit integer:sheetId} in {a pointer to a bim model record:target}:
    execute:
        if (the bim sheet index of sheetId in (@intrinsic("dereference", target)))'s valid = false:
            return false
        set bookId to the bim sheetview of sheet sheetId in (@intrinsic("dereference", target))
        remove bim plain sheet sheetId in target
        set found to the bim sheetview index of bookId in (@intrinsic("dereference", target))
        if found's valid:
            set bookValue to the item at found's position in (target's sheetviews's values)
            set kept to a cad topology list of a 64 bit integer
            loop pageCursor from 0 to the length of (bookValue's pages's values):
                set pageId to the item at pageCursor in (bookValue's pages's values)
                if pageId != sheetId:
                    append pageId to (kept's values)
            set contentsPage to bookValue's contentsId
            if contentsPage = sheetId:
                set contentsPage to the bim refused id
            store bim sheetview bookValue at found's position with pages kept and contents contentsPage in target
        return true

# Sheetview `bookId` dissolved: its pages stay, each a sheet by itself,
# keeping its number. False for a missing book.
function remove bim sheetview {a 64 bit integer:bookId} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim sheetview index of bookId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        remove item (found's position) from (target's sheetviews's values)
        note bim change of bookId in target
        return true

# A contents page put before the other pages of sheetview `bookId`, named
# "Contents"; its sheet id. Refused for a missing book, one that has a
# contents page, or when the pages' numbers would clash with another sheet's.
function add bim contents page to sheetview {a 64 bit integer:bookId} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim sheetview index of bookId in (@intrinsic("dereference", target))
        if found's valid = false:
            return the bim refused id
        set bookValue to the item at found's position in (target's sheetviews's values)
        if (the bim place of page bookValue's contentsId in bookValue) >= 0:
            return the bim refused id
        set fresh to add bim sheet numbered bookValue's prefix named (the string form of "Contents") on paper bookValue's paper landscape bookValue's landscape to target
        if fresh = the bim refused id:
            return the bim refused id
        set kept to the cad clone of bookValue's pages
        insert fresh into (kept's values) at index 0
        if bim pages (kept's values) after bookValue's prefix clash in (@intrinsic("dereference", target)):
            remove bim plain sheet fresh in target
            return the bim refused id
        store bim sheetview bookValue at found's position with pages kept and contents fresh in target
        return fresh

# The sheetview whose contents page sheet `sheetId` is, or the refused id.
function the bim sheetview listed on sheet {a 64 bit integer:sheetId} in {bim model record:modelValue}:
    execute:
        if sheetId = the bim refused id:
            return the bim refused id
        loop bookCursor from 0 to the length of (modelValue's sheetviews's values):
            set bookValue to the item at bookCursor in (modelValue's sheetviews's values)
            if bookValue's contentsId = sheetId:
                return bookValue's id
        return the bim refused id

# The pages the contents page of sheetview `bookId` lists, in order: all of
# them but the contents page itself. The caller frees the list.
function the bim listed pages of sheetview {a 64 bit integer:bookId} in {bim model record:modelValue}:
    execute:
        set listedIds to an empty list of a 64 bit integer
        set found to the bim sheetview index of bookId in modelValue
        if found's valid:
            set bookValue to the item at found's position in (modelValue's sheetviews's values)
            loop pageCursor from 0 to the length of (bookValue's pages's values):
                set pageId to the item at pageCursor in (bookValue's pages's values)
                if pageId != bookValue's contentsId:
                    append pageId to listedIds
        return listedIds

# "page 3 of 10" for a page of a book, empty for a sheet by itself.
function the bim page text of sheet {a 64 bit integer:sheetId} in {bim model record:modelValue}:
    execute:
        set found to the bim sheetview index of (the bim sheetview of sheet sheetId in modelValue) in modelValue
        if found's valid = false:
            return the string form of ""
        set bookValue to the item at found's position in (modelValue's sheetviews's values)
        return (((the string form of "page ") + (the string form of ((the bim place of page sheetId in bookValue) + 1))) + (the string form of " of ")) + (the string form of (the length of (bookValue's pages's values)))

# The sheets sheetview export writes for sheet `sheetId`, in order: every
# page of its book, or the sheet alone when it is in none. The caller frees
# the list.
function the bim book pages of sheet {a 64 bit integer:sheetId} in {bim model record:modelValue}:
    execute:
        set pageList to an empty list of a 64 bit integer
        set found to the bim sheetview index of (the bim sheetview of sheet sheetId in modelValue) in modelValue
        if found's valid:
            set bookValue to the item at found's position in (modelValue's sheetviews's values)
            loop pageCursor from 0 to the length of (bookValue's pages's values):
                append (the item at pageCursor in (bookValue's pages's values)) to pageList
        else if (the bim sheet index of sheetId in modelValue)'s valid:
            append sheetId to pageList
        return pageList

# What is wrong with the sheetviews of `modelValue`: a page that is no
# sheet, a sheet in two books or twice in one, a contents page that is not
# one of its book's pages. Empty when they are sound.
function the bim sheetview fault in {bim model record:modelValue}:
    execute:
        set seen to an empty list of a 64 bit integer
        set faultText to the string form of ""
        loop bookCursor from 0 to the length of (modelValue's sheetviews's values):
            set bookValue to the item at bookCursor in (modelValue's sheetviews's values)
            set bookName to (the string form of "sheetview ") + (the string form of bookValue's id)
            loop pageCursor from 0 to the length of (bookValue's pages's values):
                set pageId to the item at pageCursor in (bookValue's pages's values)
                if (the length of faultText) = 0:
                    if (the bim sheet index of pageId in modelValue)'s valid = false:
                        set faultText to bookName + (the string form of " has a page that is no sheet")
                    else:
                        loop seenCursor from 0 to the length of seen:
                            if (the item at seenCursor in seen) = pageId:
                                set faultText to bookName + (the string form of " shares a page")
                append pageId to seen
            if (the length of faultText) = 0:
                if (bookValue's contentsId != the bim refused id) and ((the bim place of page bookValue's contentsId in bookValue) < 0):
                    set faultText to bookName + (the string form of " lists its contents on a sheet outside it")
        free seen
        return faultText
