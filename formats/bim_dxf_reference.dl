# SPDX-License-Identifier: MPL-2.0
# Native, bounded text DXF reference reader. Geometry is flattened once on
# import, never while painting. Coordinates become metres; unsupported
# entities and paperspace are counted rather than mistaken for model lines.
# DXF INSERT / INSUNITS: Autodesk DXF reference, group codes 10/20,41/42,50,
# 70/71,44/45,210/220/230. Non-XY OCS is not silently projected.
# Math calls use DynLex's libc runtime convention, as the CAD kernel does;
# a literal libm dependency would incorrectly request -llibm at link time.
import formats/bim_file.dl

class:
    patterns:
        [a|] bim dxf pair record
    members:
        code as an integer
        value as a string
class:
    patterns:
        [a|] bim dxf entity record
    members:
        kind as a string
        first as an integer
        last as an integer
        owner as an integer
class:
    patterns:
        [a|] bim dxf block record
    members:
        name as a string
        base as a cad vector2
        first as an integer
        last as an integer
        unsupported as a boolean
class:
    patterns:
        [a|] bim dxf document record
    members:
        valid as a boolean
        message as a string
        units as an integer
        factor as a 64 bit floating-point number
        codepage as a string
        pairs as the type of (a cad topology list of a bim dxf pair record)
        entities as the type of (a cad topology list of a bim dxf entity record)
        blocks as the type of (a cad topology list of a bim dxf block record)
class:
    patterns:
        [a|] bim dxf transform record
    members:
        a as a 64 bit floating-point number
        b as a 64 bit floating-point number
        c as a 64 bit floating-point number
        d as a 64 bit floating-point number
        x as a 64 bit floating-point number
        y as a 64 bit floating-point number
class:
    patterns:
        [a|] bim dxf segment record
    members:
        first as a cad vector2
        last as a cad vector2
        layer as a string
        handle as a string
class:
    patterns:
        [a|] bim dxf reading record
    members:
        valid as a boolean
        message as a string
        units as an integer
        factor as a 64 bit floating-point number
        codepage as a string
        segments as the type of (a cad topology list of a bim dxf segment record)
        unsupported as an integer
        paper as an integer
        inserts as an integer
        missing as an integer
        visits as an integer

function the bim dxf trimmed {a string:source}:
    execute:
        set first to 0
        set last to the length of source
        set trimming to true
        loop while (first < last) and trimming:
            set letter to the substring of source from first spanning 1 bytes
            set trimming to ((letter = (the string form of " ")) or (letter = (the string form of "\t"))) or (letter = (the string form of "\r"))
            if trimming:
                set first to first + 1
        set trimming to true
        loop while (last > first) and trimming:
            set letter to the substring of source from (last - 1) spanning 1 bytes
            set trimming to ((letter = (the string form of " ")) or (letter = (the string form of "\t"))) or (letter = (the string form of "\r"))
            if trimming:
                set last to last - 1
        return the substring of source from first spanning (last - first) bytes

function the bim dxf text {integer:wanted} of {bim dxf entity record:entity} in {bim dxf document record:documentValue} or {a string:fallback}:
    execute:
        loop cursor from entity's first to entity's last:
            set pair to the item at cursor in (documentValue's pairs's values)
            if pair's code = wanted:
                return pair's value
        return fallback

function the bim dxf number {integer:wanted} of {bim dxf entity record:entity} in {bim dxf document record:documentValue} or {a 64 bit floating-point number:fallback}:
    execute:
        set value to the bim dxf text wanted of entity in documentValue or (the string form of "")
        if (the length of value) = 0:
            return fallback
        return (the bim real reading of value)'s value

function the bim dxf metres of units {integer:code}:
    execute:
        if code = 1:
            return 0.0254
        if code = 2:
            return 0.3048
        if code = 3:
            return 1609.344
        if code = 4:
            return 0.001
        if code = 5:
            return 0.01
        if code = 6:
            return 1.0
        if code = 7:
            return 1000.0
        if code = 10:
            return 0.9144
        if code = 13:
            return 0.000001
        if code = 14:
            return 0.1
        return 0.0

# Text DXF since AC1021 uses UTF-8 even when DWGCODEPAGE says ANSI_1252.
# Legacy Windows-1252 is decoded explicitly; undefined bytes are refused.
function the bim dxf windows point of {integer:octet}:
    execute:
        if (octet < 128) or (octet >= 160):
            return octet
        if octet = 128:
            return 8364
        if octet = 130:
            return 8218
        if octet = 131:
            return 402
        if octet = 132:
            return 8222
        if octet = 133:
            return 8230
        if octet = 134:
            return 8224
        if octet = 135:
            return 8225
        if octet = 136:
            return 710
        if octet = 137:
            return 8240
        if octet = 138:
            return 352
        if octet = 139:
            return 8249
        if octet = 140:
            return 338
        if octet = 142:
            return 381
        if octet = 145:
            return 8216
        if octet = 146:
            return 8217
        if octet = 147:
            return 8220
        if octet = 148:
            return 8221
        if octet = 149:
            return 8226
        if octet = 150:
            return 8211
        if octet = 151:
            return 8212
        if octet = 152:
            return 732
        if octet = 153:
            return 8482
        if octet = 154:
            return 353
        if octet = 155:
            return 8250
        if octet = 156:
            return 339
        if octet = 158:
            return 382
        if octet = 159:
            return 376
        return 0

function the bim dxf utf8 validity of {a string:source}:
    execute:
        set cursor to 0
        loop while cursor < (the length of source):
            set lead to (((the character at cursor in source) as a 32 bit integer) bitwise and 255) as an integer
            set count to 0
            set point to lead
            set minimum to 0
            if lead >= 128:
                if (lead >= 194) and (lead <= 223):
                    set count to 1
                    set point to lead - 192
                    set minimum to 128
                else if (lead >= 224) and (lead <= 239):
                    set count to 2
                    set point to lead - 224
                    set minimum to 2048
                else if (lead >= 240) and (lead <= 244):
                    set count to 3
                    set point to lead - 240
                    set minimum to 65536
                else:
                    return false
            if (cursor + count) >= (the length of source):
                return false
            loop offset from 1 to (count + 1):
                set continuation to (((the character at (cursor + offset) in source) as a 32 bit integer) bitwise and 255) as an integer
                if (continuation < 128) or (continuation > 191):
                    return false
                set point to (point * 64) + (continuation - 128)
            if ((point < minimum) or (point > 1114111)) or ((point >= 55296) and (point <= 57343)):
                return false
            set cursor to cursor + (count + 1)
        return true

function the bim dxf decoded {a string:source} modern {a boolean:modern} codepage {a string:codepage}:
    execute:
        set failure to @intrinsic("construct", a bim text reading record, false, the string form of "")
        set nonAscii to false
        loop cursor from 0 to the length of source:
            set octet to (((the character at cursor in source) as a 32 bit integer) bitwise and 255) as an integer
            if octet >= 128:
                set nonAscii to true
        if nonAscii = false:
            return @intrinsic("construct", a bim text reading record, true, source)
        if modern:
            return @intrinsic("construct", a bim text reading record, the bim dxf utf8 validity of source, source)
        if codepage != (the string form of "ANSI_1252"):
            return failure
        set size to 0
        loop cursor from 0 to the length of source:
            set octet to (((the character at cursor in source) as a 32 bit integer) bitwise and 255) as an integer
            set point to the bim dxf windows point of octet
            if point = 0:
                return failure
            if point < 128:
                set size to size + 1
            else if point < 2048:
                set size to size + 2
            else:
                set size to size + 3
        if size > 64000000:
            return failure
        set result to a new string buffer containing size bytes
        set position to 0
        loop cursor from 0 to the length of source:
            set octet to (((the character at cursor in source) as a 32 bit integer) bitwise and 255) as an integer
            set point to the bim dxf windows point of octet
            if point < 128:
                store (point as a byte) into the data of result at position
                set position to position + 1
            else:
                if point >= 2048:
                    store ((224 + (point / 4096)) as a byte) into the data of result at position
                    set position to position + 1
                    store ((128 + (the remainder of (point / 64) divided by 64)) as a byte) into the data of result at position
                else:
                    store ((192 + (point / 64)) as a byte) into the data of result at position
                set position to position + 1
                store ((128 + (the remainder of point divided by 64)) as a byte) into the data of result at position
                set position to position + 1
        return @intrinsic("construct", a bim text reading record, true, result)

function the bim dxf document from {a string:source}:
    execute:
        set made to @intrinsic("construct", a bim dxf document record, false, the string form of "DXF refused", 0, 0.0, the string form of "unspecified ASCII", a cad topology list of a bim dxf pair record, a cad topology list of a bim dxf entity record, a cad topology list of a bim dxf block record)
        if (the length of source) > 64000000:
            set made's message to the string form of "DXF exceeds 64 MB input limit"
            return made
        loop cursor from 0 to the length of source:
            set octet to (((the character at cursor in source) as a 32 bit integer) bitwise and 255) as an integer
            if octet = 0:
                set made's message to the string form of "Binary DXF or embedded NUL is not supported"
                return made
        set rows to source split at "\n"
        set row to 0
        loop while (row + 1) < (the length of rows):
            set codeText to the bim dxf trimmed (the item at row in rows)
            set value to the bim dxf trimmed (the item at (row + 1) in rows)
            set codeReading to the bim whole reading of codeText
            if ((codeReading's valid = false) or (codeReading's value < 0)) or (codeReading's value > 1071):
                set made's message to the string form of "Malformed DXF group code"
                free rows
                return made
            set code to codeReading's value as an integer
            set numeric to (((code >= 10) and (code <= 59)) or ((code >= 70) and (code <= 99))) or ((code >= 210) and (code <= 239))
            if numeric:
                if (the bim real reading of value)'s valid = false:
                    set made's message to the string form of "Malformed DXF numeric value"
                    free rows
                    return made
            append (@intrinsic("construct", a bim dxf pair record, code, value)) to (made's pairs's values)
            if (the length of (made's pairs's values)) > 1000000:
                set made's message to the string form of "DXF exceeds one million group pairs"
                free rows
                return made
            set row to row + 2
        if row < (the length of rows):
            if (the length of (the bim dxf trimmed (the item at row in rows))) > 0:
                set made's message to the string form of "DXF has an unmatched final group code"
                free rows
                return made
        free rows
        # Resolve the HEADER before interpreting any layer or BLOCK names.
        set headerSection to the string form of ""
        set pendingSection to false
        set modernText to false
        loop headerCursor from 0 to the length of (made's pairs's values):
            set headerPair to the item at headerCursor in (made's pairs's values)
            if (headerPair's code = 0) and (headerPair's value = (the string form of "SECTION")):
                set pendingSection to true
            else if pendingSection and (headerPair's code = 2):
                set headerSection to headerPair's value
                set pendingSection to false
            else if (headerPair's code = 0) and (headerPair's value = (the string form of "ENDSEC")):
                set headerSection to the string form of ""
            if ((headerSection = (the string form of "HEADER")) and (headerPair's code = 9)) and ((headerCursor + 1) < (the length of (made's pairs's values))):
                set headerValue to (the item at (headerCursor + 1) in (made's pairs's values))'s value
                if headerPair's value = (the string form of "$DWGCODEPAGE"):
                    set made's codepage to headerValue
                if headerPair's value = (the string form of "$ACADVER"):
                    if (the length of headerValue) = 6:
                        if (the substring of headerValue from 0 spanning 2 bytes) = (the string form of "AC"):
                            set version to the bim whole reading of (the substring of headerValue from 2 spanning 4 bytes)
                            set modernText to version's valid and (version's value >= 1021)
        set decodedBytes to 0
        loop textCursor from 0 to the length of (made's pairs's values):
            set textPair to the item at textCursor in (made's pairs's values)
            set decoded to the bim dxf decoded textPair's value modern modernText codepage made's codepage
            if decoded's valid = false:
                set made's message to the string form of "Invalid UTF-8 or unsupported legacy DXF codepage; non-ASCII legacy text requires ANSI_1252"
                return made
            set decodedBytes to decodedBytes + (the length of decoded's text)
            if decodedBytes > 64000000:
                set made's message to the string form of "Decoded DXF exceeds 64 MB text limit"
                return made
            set textPair's value to decoded's text
            replace item at index textCursor in (made's pairs's values) with textPair
        set section to the string form of ""
        set owner to -1
        set cursor to 0
        set ended to false
        loop while cursor < (the length of (made's pairs's values)):
            set pair to the item at cursor in (made's pairs's values)
            if pair's code = 9:
                if (section = (the string form of "HEADER")) and ((cursor + 1) < (the length of (made's pairs's values))):
                    set next to the item at (cursor + 1) in (made's pairs's values)
                    if pair's value = (the string form of "$INSUNITS"):
                        set made's units to (the bim real reading of next's value)'s value as an integer
                    if pair's value = (the string form of "$DWGCODEPAGE"):
                        set made's codepage to next's value
            if pair's code = 0:
                set nextCursor to cursor + 1
                set seekingNext to true
                loop while (nextCursor < (the length of (made's pairs's values))) and seekingNext:
                    set seekingNext to (the item at nextCursor in (made's pairs's values))'s code != 0
                    if seekingNext:
                        set nextCursor to nextCursor + 1
                set entity to @intrinsic("construct", a bim dxf entity record, pair's value, cursor + 1, nextCursor, owner)
                if pair's value = (the string form of "SECTION"):
                    set section to the bim dxf text 2 of entity in made or (the string form of "")
                else if pair's value = (the string form of "ENDSEC"):
                    set section to the string form of ""
                    set owner to -1
                else if pair's value = (the string form of "EOF"):
                    set ended to true
                else if (section = (the string form of "BLOCKS")) and (pair's value = (the string form of "BLOCK")):
                    set blockName to the bim dxf text 2 of entity in made or (the string form of "")
                    set base to a cad vector2 with x (the bim dxf number 10 of entity in made or 0.0) and y (the bim dxf number 20 of entity in made or 0.0)
                    set unsupported to ((the bim dxf number 30 of entity in made or 0.0) != 0.0) or ((the length of (the bim dxf text 1 of entity in made or (the string form of ""))) > 0)
                    set owner to the length of (made's blocks's values)
                    append (@intrinsic("construct", a bim dxf block record, blockName, base, the length of (made's entities's values), the length of (made's entities's values), unsupported)) to (made's blocks's values)
                else if (section = (the string form of "BLOCKS")) and (pair's value = (the string form of "ENDBLK")):
                    if owner >= 0:
                        set blockValue to the item at owner in (made's blocks's values)
                        set blockValue's last to the length of (made's entities's values)
                        replace item at index owner in (made's blocks's values) with blockValue
                    set owner to -1
                else if (section = (the string form of "ENTITIES")) or ((section = (the string form of "BLOCKS")) and (owner >= 0)):
                    set entity's owner to owner
                    append entity to (made's entities's values)
                    if (the length of (made's entities's values)) > 100000:
                        set made's message to the string form of "DXF exceeds 100000 source entities"
                        return made
                # Header variables are 9 groups inside the SECTION record.
                if pair's value != (the string form of "SECTION"):
                    set cursor to nextCursor - 1
            set cursor to cursor + 1
        set made's factor to the bim dxf metres of units made's units
        if made's factor <= 0.0:
            set made's message to the string form of "DXF needs explicit supported INSUNITS (no unitless scale assumption)"
            return made
        if ended = false:
            set made's message to the string form of "DXF has no EOF marker"
            return made
        set made's valid to true
        set made's message to the string form of "ASCII DXF parsed"
        return made

function the bim dxf point {cad vector2:point} transformed by {bim dxf transform record:transform}:
    execute:
        return a cad vector2 with x (((transform's a * point's x) + (transform's c * point's y)) + transform's x) and y (((transform's b * point's x) + (transform's d * point's y)) + transform's y)

function the bim dxf transform {bim dxf transform record:inner} inside {bim dxf transform record:outer}:
    execute:
        set offset to the bim dxf point (a cad vector2 with x inner's x and y inner's y) transformed by outer
        return @intrinsic("construct", a bim dxf transform record, (outer's a * inner's a) + (outer's c * inner's b), (outer's b * inner's a) + (outer's d * inner's b), (outer's a * inner's c) + (outer's c * inner's d), (outer's b * inner's c) + (outer's d * inner's d), offset's x, offset's y)

function append bim dxf line from {cad vector2:first} to {cad vector2:last} with {bim dxf transform record:transform} on {a string:layer} handle {a string:handle} into {a pointer to a bim dxf reading record:reading}:
    execute:
        if reading's valid = false:
            return nothing
        if (the length of (reading's segments's values)) >= 100000:
            set reading's valid to false
            set reading's message to the string form of "DXF exceeds 100000 flattened segments"
            return nothing
        set a to the bim dxf point first transformed by transform
        set b to the bim dxf point last transformed by transform
        if (((a's x - a's x) != 0.0) or ((a's y - a's y) != 0.0)) or (((b's x - b's x) != 0.0) or ((b's y - b's y) != 0.0)):
            set reading's valid to false
            set reading's message to the string form of "DXF transform overflow"
            return nothing
        if ((a's x - b's x) * (a's x - b's x)) + ((a's y - b's y) * (a's y - b's y)) > 1e-20:
            append (@intrinsic("construct", a bim dxf segment record, a, b, layer, handle)) to (reading's segments's values)

function append bim dxf arc at {cad vector2:centre} radius {a 64 bit floating-point number:radius} from {a 64 bit floating-point number:startAngle} sweeping {a 64 bit floating-point number:sweep} with {bim dxf transform record:transform} on {a string:layer} handle {a string:handle} into {a pointer to a bim dxf reading record:reading}:
    execute:
        # Bound sagitta to 0.5 mm after the full affine transform. The
        # Frobenius norm safely bounds nonuniform scale and nested shear.
        set stretch to @intrinsic("call", "libc", "sqrt", a 64 bit floating-point number, ((transform's a * transform's a) + (transform's b * transform's b)) + ((transform's c * transform's c) + (transform's d * transform's d)))
        set outerRadius to radius * stretch
        set stepAngle to 0.08726646259971647
        if outerRadius > 0.0005:
            set cosineLimit to 1.0 - (0.0005 / outerRadius)
            set stepAngle to the minimum of stepAngle and (2.0 * (@intrinsic("call", "libc", "acos", a 64 bit floating-point number, cosineLimit)))
        if ((stepAngle <= 0.0) or ((outerRadius - outerRadius) != 0.0)) or (((the absolute value of sweep) / stepAngle) > 4095.0):
            set reading's valid to false
            set reading's message to the string form of "DXF arc exceeds bounded 0.5 mm tessellation tolerance"
            return nothing
        set steps to (((the absolute value of sweep) / stepAngle) as an integer) + 1
        set previous to a cad vector2 with x (centre's x + (radius * (@intrinsic("call", "libc", "cos", a 64 bit floating-point number, startAngle)))) and y (centre's y + (radius * (@intrinsic("call", "libc", "sin", a 64 bit floating-point number, startAngle))))
        loop part from 1 to (steps + 1):
            set angle to startAngle + (sweep * ((part as a 64 bit floating-point number) / (steps as a 64 bit floating-point number)))
            set next to a cad vector2 with x (centre's x + (radius * (@intrinsic("call", "libc", "cos", a 64 bit floating-point number, angle)))) and y (centre's y + (radius * (@intrinsic("call", "libc", "sin", a 64 bit floating-point number, angle))))
            append bim dxf line from previous to next with transform on layer handle handle into reading
            set previous to next

function append bim dxf chord from {cad vector2:first} to {cad vector2:last} bulge {a 64 bit floating-point number:bulge} with {bim dxf transform record:transform} on {a string:layer} handle {a string:handle} into {a pointer to a bim dxf reading record:reading}:
    execute:
        if (the absolute value of bulge) < 1e-12:
            append bim dxf line from first to last with transform on layer handle handle into reading
            return nothing
        set dx to last's x - first's x
        set dy to last's y - first's y
        set chordLength to @intrinsic("call", "libc", "sqrt", a 64 bit floating-point number, (dx * dx) + (dy * dy))
        if chordLength < 1e-12:
            return nothing
        set offset to (1.0 - (bulge * bulge)) / (4.0 * bulge)
        set centre to a cad vector2 with x (((first's x + last's x) * 0.5) - (dy * offset)) and y (((first's y + last's y) * 0.5) + (dx * offset))
        set radius to (chordLength * (1.0 + (bulge * bulge))) / (4.0 * (the absolute value of bulge))
        set startAngle to @intrinsic("call", "libc", "atan2", a 64 bit floating-point number, first's y - centre's y, first's x - centre's x)
        set sweep to 4.0 * (@intrinsic("call", "libc", "atan", a 64 bit floating-point number, bulge))
        append bim dxf arc at centre radius radius from startAngle sweeping sweep with transform on layer handle handle into reading

function flatten bim dxf entity {bim dxf entity record:entity} of {bim dxf document record:documentValue} with {bim dxf transform record:transform} layer {a string:inheritedLayer} depth {integer:depth} into {a pointer to a bim dxf reading record:reading}:
    execute:
        if reading's valid = false:
            return nothing
        set reading's visits to reading's visits + 1
        if (depth > 16) or (reading's visits > 200000):
            set reading's valid to false
            set reading's message to the string form of "DXF block recursion or expansion limit exceeded"
            return nothing
        set layout to the bim dxf text 410 of entity in documentValue or (the string form of "Model")
        if ((the bim dxf number 67 of entity in documentValue or 0.0) != 0.0) or ((the uppercase form of layout) != (the string form of "MODEL")):
            set reading's paper to reading's paper + 1
            return nothing
        set nonplanar to ((the bim dxf number 210 of entity in documentValue or 0.0) != 0.0) or ((the bim dxf number 220 of entity in documentValue or 0.0) != 0.0)
        if ((the bim dxf number 230 of entity in documentValue or 1.0) != 1.0) or ((the bim dxf number 30 of entity in documentValue or 0.0) != 0.0):
            set nonplanar to true
        if nonplanar:
            set reading's unsupported to reading's unsupported + 1
            return nothing
        set entityLayer to the bim dxf text 8 of entity in documentValue or (the string form of "0")
        if entityLayer = (the string form of "0"):
            set entityLayer to inheritedLayer
        set handle to the bim dxf text 5 of entity in documentValue or (the string form of "")
        set origin to a cad vector2 with x (the bim dxf number 10 of entity in documentValue or 0.0) and y (the bim dxf number 20 of entity in documentValue or 0.0)
        if entity's kind = (the string form of "INSERT"):
            set reading's inserts to reading's inserts + 1
            if reading's inserts > 20000:
                set reading's valid to false
                set reading's message to the string form of "DXF exceeds 20000 expanded INSERTs"
                return nothing
            set blockName to the bim dxf text 2 of entity in documentValue or (the string form of "")
            set found to -1
            loop blockCursor from 0 to the length of (documentValue's blocks's values):
                if (the item at blockCursor in (documentValue's blocks's values))'s name = blockName:
                    set found to blockCursor
            if found < 0:
                set reading's missing to reading's missing + 1
                return nothing
            set blockValue to the item at found in (documentValue's blocks's values)
            if blockValue's unsupported:
                set reading's unsupported to reading's unsupported + 1
                return nothing
            set sx to the bim dxf number 41 of entity in documentValue or 1.0
            set sy to the bim dxf number 42 of entity in documentValue or 1.0
            set angle to (the bim dxf number 50 of entity in documentValue or 0.0) * 0.017453292519943295
            set cosine to @intrinsic("call", "libc", "cos", a 64 bit floating-point number, angle)
            set sine to @intrinsic("call", "libc", "sin", a 64 bit floating-point number, angle)
            set columnsValue to the bim dxf number 70 of entity in documentValue or 1.0
            set rowsValue to the bim dxf number 71 of entity in documentValue or 1.0
            if ((columnsValue < 1.0) or (rowsValue < 1.0)) or ((columnsValue * rowsValue) > 20000.0):
                set reading's valid to false
                set reading's message to the string form of "DXF INSERT array count is invalid or exceeds 20000"
                return nothing
            set columns to columnsValue as an integer
            set rows to rowsValue as an integer
            if (columnsValue != (columns as a 64 bit floating-point number)) or (rowsValue != (rows as a 64 bit floating-point number)):
                set reading's valid to false
                set reading's message to the string form of "DXF INSERT array count is not an integer"
                return nothing
            set columnGap to the bim dxf number 44 of entity in documentValue or 0.0
            set rowGap to the bim dxf number 45 of entity in documentValue or 0.0
            loop row from 0 to rows:
                loop column from 0 to columns:
                    set gapX to (column as a 64 bit floating-point number) * columnGap
                    set gapY to (row as a 64 bit floating-point number) * rowGap
                    set offsetX to ((origin's x + (cosine * gapX)) - (sine * gapY)) - (((cosine * sx) * blockValue's base's x) - ((sine * sy) * blockValue's base's y))
                    set offsetY to ((origin's y + (sine * gapX)) + (cosine * gapY)) - (((sine * sx) * blockValue's base's x) + ((cosine * sy) * blockValue's base's y))
                    set localTransform to @intrinsic("construct", a bim dxf transform record, cosine * sx, sine * sx, (0.0 - sine) * sy, cosine * sy, offsetX, offsetY)
                    set nested to the bim dxf transform localTransform inside transform
                    loop member from blockValue's first to blockValue's last:
                        flatten bim dxf entity (the item at member in (documentValue's entities's values)) of documentValue with nested layer entityLayer depth (depth + 1) into reading
                        if reading's valid = false:
                            return nothing
            return nothing
        if entity's kind = (the string form of "LINE"):
            if (the bim dxf number 31 of entity in documentValue or 0.0) != 0.0:
                set reading's unsupported to reading's unsupported + 1
                return nothing
            set finish to a cad vector2 with x (the bim dxf number 11 of entity in documentValue or 0.0) and y (the bim dxf number 21 of entity in documentValue or 0.0)
            append bim dxf line from origin to finish with transform on entityLayer handle handle into reading
            return nothing
        if (entity's kind = (the string form of "ARC")) or (entity's kind = (the string form of "CIRCLE")):
            set radius to the bim dxf number 40 of entity in documentValue or 0.0
            if radius <= 0.0:
                set reading's unsupported to reading's unsupported + 1
                return nothing
            set startAngle to 0.0
            set sweep to 6.283185307179586
            if entity's kind = (the string form of "ARC"):
                set startAngle to (the bim dxf number 50 of entity in documentValue or 0.0) * 0.017453292519943295
                set endAngle to (the bim dxf number 51 of entity in documentValue or 0.0) * 0.017453292519943295
                set sweep to @intrinsic("call", "libc", "fmod", a 64 bit floating-point number, endAngle - startAngle, 6.283185307179586)
                if sweep <= 0.0:
                    set sweep to sweep + 6.283185307179586
            append bim dxf arc at origin radius radius from startAngle sweeping sweep with transform on entityLayer handle handle into reading
            return nothing
        if entity's kind = (the string form of "LWPOLYLINE"):
            if (the bim dxf number 38 of entity in documentValue or 0.0) != 0.0:
                set reading's unsupported to reading's unsupported + 1
                return nothing
            set points to an empty list of a cad vector2
            set bulges to an empty list of a 64 bit floating-point number
            set current to a cad vector2 with x 0.0 and y 0.0
            set bulge to 0.0
            set haveX to false
            set haveY to false
            loop pairCursor from entity's first to entity's last:
                set pair to the item at pairCursor in (documentValue's pairs's values)
                if pair's code = 10:
                    if haveX:
                        if haveY = false:
                            set reading's valid to false
                            set reading's message to the string form of "LWPOLYLINE vertex has no Y coordinate"
                            return nothing
                        append current to points
                        append bulge to bulges
                    set current to a cad vector2 with x (the bim real reading of pair's value)'s value and y 0.0
                    set haveX to true
                    set haveY to false
                    set bulge to 0.0
                else if pair's code = 20:
                    set current's y to (the bim real reading of pair's value)'s value
                    set haveY to true
                else if pair's code = 42:
                    set bulge to (the bim real reading of pair's value)'s value
            if haveX and haveY:
                append current to points
                append bulge to bulges
            else if haveX:
                set reading's valid to false
                set reading's message to the string form of "LWPOLYLINE vertex has no Y coordinate"
                return nothing
            set count to the length of points
            set edges to count - 1
            if (((the bim dxf number 70 of entity in documentValue or 0.0) as an integer) bitwise and 1) != 0:
                set edges to count
            if count > 1:
                loop edge from 0 to edges:
                    set next to the remainder of (edge + 1) divided by count
                    append bim dxf chord from (the item at edge in points) to (the item at next in points) bulge (the item at edge in bulges) with transform on entityLayer handle handle into reading
            free points
            free bulges
            return nothing
        set reading's unsupported to reading's unsupported + 1

function the bim dxf reference read from {a string:source}:
    execute:
        set documentValue to the bim dxf document from source
        set reading to @intrinsic("construct", a bim dxf reading record, documentValue's valid, documentValue's message, documentValue's units, documentValue's factor, documentValue's codepage, a cad topology list of a bim dxf segment record, 0, 0, 0, 0, 0)
        if documentValue's valid = false:
            return reading
        set scale to documentValue's factor
        set transform to @intrinsic("construct", a bim dxf transform record, scale, 0.0, 0.0, scale, 0.0, 0.0)
        loop cursor from 0 to the length of (documentValue's entities's values):
            set entity to the item at cursor in (documentValue's entities's values)
            if entity's owner < 0:
                flatten bim dxf entity entity of documentValue with transform layer (the string form of "0") depth 0 into (the address of reading)
            if reading's valid = false:
                return reading
        if (the length of (reading's segments's values)) = 0:
            set reading's valid to false
            set reading's message to the string form of "DXF has no supported modelspace reference geometry"
            return reading
        set reading's message to (the string form of "Native DXF reference: ") + (the string form of (the length of (reading's segments's values)))
        set reading's message to reading's message + ((the string form of " segments; unsupported ") + (the string form of reading's unsupported))
        set reading's message to reading's message + ((the string form of "; paperspace ignored ") + (the string form of reading's paper))
        set reading's message to reading's message + ((the string form of "; INSERTs ") + (the string form of reading's inserts))
        set reading's message to reading's message + ((the string form of "; missing blocks ") + (the string form of reading's missing))
        return reading

# The caller owns the transaction. Refusal does not add anything. Parts are
# stored once; the instance carries the exact DXF origin, rotation and layer
# mapping. Component-local coordinates remain close to the reference bounds.
function add bim dxf reference {bim dxf reading record:reading} named {a string:nameValue} from {a string:sourcePath} on {a 64 bit integer:levelId} to {a pointer to a bim model record:target}:
    execute:
        if reading's valid = false:
            return the bim refused id
        if ((the length of (reading's segments's values)) = 0) or ((the length of (reading's segments's values)) > 100000):
            return the bim refused id
        if (the bim level index of levelId in (@intrinsic("dereference", target)))'s valid = false:
            return the bim refused id
        set low to a cad vector2 with x 1e300 and y 1e300
        loop cursor from 0 to the length of (reading's segments's values):
            set segment to the item at cursor in (reading's segments's values)
            set low's x to the minimum of low's x and (the minimum of segment's first's x and segment's last's x)
            set low's y to the minimum of low's y and (the minimum of segment's first's y and segment's last's y)
        set componentId to add bim component named nameValue to target
        set parts to an empty list of a bim sketch record
        set layerRows to an empty list of a string
        loop cursor from 0 to the length of (reading's segments's values):
            set segment to the item at cursor in (reading's segments's values)
            set fresh to the bim new id in target
            set points to a cad topology list of a cad vector2
            append (a cad vector2 with x (segment's first's x - low's x) and y (segment's first's y - low's y)) to (points's values)
            append (a cad vector2 with x (segment's last's x - low's x) and y (segment's last's y - low's y)) to (points's values)
            append (@intrinsic("construct", a bim sketch record, fresh, 0 as a 64 bit integer, bim line sketch, points, 0.0, the string form of "")) to parts
            append (((the string form of fresh) + (the string form of "\t")) + ((segment's layer + (the string form of "\t")) + segment's handle)) to layerRows
        ignore (set bim component componentId contents to parts in target)
        free parts
        set layers to layerRows joined with "\n"
        free layerRows
        set instanceId to place bim component componentId on levelId at low turned 0.0 to target
        if instanceId = the bim refused id:
            return instanceId
        set pset to the string form of "OBS_DXFReference"
        set bim property (the string form of "Source") of set pset of instanceId to sourcePath typed (the string form of "IfcText") in target
        set bim property (the string form of "INSUNITS") of set pset of instanceId to (the string form of reading's units) typed (the string form of "IfcInteger") in target
        set bim property (the string form of "MetresPerUnit") of set pset of instanceId to (the bim exact text of reading's factor) typed (the string form of "IfcReal") in target
        set bim property (the string form of "Codepage") of set pset of instanceId to reading's codepage typed (the string form of "IfcLabel") in target
        set bim property (the string form of "PartLayerHandleTSV") of set pset of instanceId to layers typed (the string form of "IfcText") in target
        set bim property (the string form of "ImportReport") of set pset of instanceId to reading's message typed (the string form of "IfcText") in target
        set bim property (the string form of "SourceAnchorX") of set pset of instanceId to (the bim exact text of low's x) typed (the string form of "IfcReal") in target
        set bim property (the string form of "SourceAnchorY") of set pset of instanceId to (the bim exact text of low's y) typed (the string form of "IfcReal") in target
        return instanceId

# Refuse huge files before allocating their contents, not after parsing.
function the bim dxf file content at {a string:path}:
    execute:
        set failure to @intrinsic("construct", a bim text reading record, false, the string form of "")
        set handle to @intrinsic("call", "libc", "fopen", a pointer to a byte, the data of path, "rb")
        if handle = (0 as a pointer to a byte):
            return failure
        set size to (-1) as a 64 bit integer
        if (@intrinsic("call", "libc", "fseek", integer, handle, 0 as a 64 bit integer, 2)) = 0:
            set size to @intrinsic("call", "libc", "ftell", a 64 bit integer, handle)
        if (size < (0 as a 64 bit integer)) or (size > (64000000 as a 64 bit integer)):
            ignore @intrinsic("call", "libc", "fclose", integer, handle)
            return failure
        if (@intrinsic("call", "libc", "fseek", integer, handle, 0 as a 64 bit integer, 0)) != 0:
            ignore @intrinsic("call", "libc", "fclose", integer, handle)
            return failure
        set fileBytes to a new string buffer containing (size as an integer) bytes
        set got to @intrinsic("call", "libc", "fread", a word sized integer, the data of fileBytes, 1 as a word sized integer, size as a word sized integer, handle)
        ignore @intrinsic("call", "libc", "fclose", integer, handle)
        if got != (size as a word sized integer):
            return failure
        return @intrinsic("construct", a bim text reading record, true, fileBytes)
