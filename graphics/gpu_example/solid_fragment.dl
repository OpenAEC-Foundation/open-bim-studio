# Fragment shader of the GPU-resident 3D view: the lit colour from the vertex
# shader.
import lib/shader.dl

set the fragment color with a red channel of (shader interpolant x named "colour"), a green channel of (shader interpolant y named "colour"), a blue channel of (shader interpolant z named "colour") and an alpha channel of 1.0
