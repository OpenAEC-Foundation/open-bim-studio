@@ -42,5 +42,11 @@
 		if (library == ":libpng16.so.16")
 			return {"-llibpng16"};
 	}
-	return {"-l" + library.str()};
+	// A program's own library (`"obskernel"`) may use the maths library while
+	// the program itself does not; libm is separate on Linux, so every named
+	// library brings it along there.
+	std::vector<std::string> arguments = {"-l" + library.str()};
+	if (!targetTriple.isOSWindows() && !targetTriple.isOSDarwin())
