--- a/lib/json.dl
+++ b/lib/json.dl
@@ -214,7 +214,25 @@
 local function the JSON text read by {a pointer to a JSON parser:parser}:
     execute:
         set opening to the position of parser
-        set limit to ((the length of the source of parser) - opening)
+        # Bound storage by this encoded string, not the remaining document.
+        # Escaped quotes do not terminate it; decoding can only shorten it.
+        set ending to opening + 1
+        set scanning to true
+        set scanEscaped to false
+        loop while scanning and ending < (the length of the source of parser):
+            set code to the unsigned JSON byte value of the character at ending in the source of parser
+            if (code = 34) and (scanEscaped = false):
+                set scanning to false
+            else:
+                if scanEscaped:
+                    set scanEscaped to false
+                else:
+                    set scanEscaped to code = 92
+                set ending to ending + 1
+        if scanning:
+            record a JSON error at ending for parser
+            return an empty JSON string
+        set limit to ending - (opening + 1)
         set output to a new string buffer containing limit bytes
         set writer to 0
         set the position of parser to (opening + 1)
