# SPDX-License-Identifier: MPL-2.0
# The boundary sketch (`bim_boundary_sketch.dl`): a three-point arc's bulge;
# segments chained into one loop whatever their order and direction; an
# open sketch and a second loop refused; an arc's polygon and the arc found
# back from it, also mirrored. Then Tab on a floor: its outline as a sketch,
# a side picked and removed, an arc drawn in its place, Tab making it the
# floor's outline; Tab again finds the arc back; an open sketch is refused
# and Esc leaves it as it was.
import ui/editor/bim_editor.dl

function the sketch test text of {a 64 bit floating-point number:value}:
    execute:
        set rounded to (@intrinsic("ceil", (value * 1000.0) - 0.5)) / 1000.0
        if (the absolute value of rounded) < 0.0005:
            set rounded to 0.0
        return the string form of rounded

function the sketch test point {cad vector2:spot}:
    execute:
        return ((the string form of "(") + (the sketch test text of spot's x)) + (((the string form of ", ") + (the sketch test text of spot's y)) + (the string form of ")"))

function show sketch test segments {a pointer to a list:pieces} labelled {a string:label}:
    execute:
        print ((label + (the string form of ": ")) + (the string form of (the length of pieces))) as a line
        loop cursor from 0 to the length of pieces:
            set piece to the item at cursor in pieces
            print (((the string form of "  ") + ((the sketch test point piece's start) + (the string form of " -> "))) + ((the sketch test point piece's finish) + ((the string form of " bulge ") + (the sketch test text of piece's bulge)))) as a line

function show sketch test loop {bim boundary loop record:chained} labelled {a string:label}:
    execute:
        if chained's valid = false:
            print ((label + (the string form of ": refused, ")) + chained's message) as a line
            return nothing
        set spanText to an empty list of a string
        loop cursor from 0 to the length of (chained's spans's values):
            append (the string form of (the item at cursor in (chained's spans's values))) to spanText
        print (((label + (the string form of ": ")) + ((the string form of (the length of (chained's corners's values))) + (the string form of " corners, spans "))) + (spanText joined with " ")) as a line
        free spanText

function click sketch test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function show sketch test floor {a 64 bit integer:slabId} of {bim model record:modelValue} labelled {a string:label}:
    execute:
        set found to the bim slab index of slabId in modelValue
        set slabValue to the item at found's position in (modelValue's slabs's values)
        set spans to the bim boundary spans of slabId in modelValue
        set spanText to an empty list of a string
        loop cursor from 0 to the length of spans:
            append (the string form of (the item at cursor in spans)) to spanText
        print (((label + (the string form of ": ")) + ((the string form of (the length of (slabValue's outline's values))) + (the string form of " corners, kept spans "))) + (spanText joined with " ")) as a line
        free spanText
        free spans

# A three-point arc: through (7, 2) from (6, 0) to (6, 4) bulges 1 to the
# right; through a point on the chord it is a line.
print ((the string form of "bulge right: ") + (the sketch test text of (the bim boundary bulge from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 6.0 and y 4.0) through (a cad vector2 with x 7.0 and y 2.0)))) as a line
print ((the string form of "bulge left: ") + (the sketch test text of (the bim boundary bulge from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 6.0 and y 4.0) through (a cad vector2 with x 5.0 and y 2.0)))) as a line
print ((the string form of "bulge past half: ") + (the sketch test text of (the bim boundary bulge from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 2.0 and y 0.0) through (a cad vector2 with x 1.0 and y -1.5)))) as a line
print ((the string form of "bulge on the chord: ") + (the sketch test text of (the bim boundary bulge from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 2.0 and y 0.0) through (a cad vector2 with x 1.0 and y 0.0)))) as a line
set halfCircle to the bim boundary arc from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 2.0 and y 0.0) bulging 1.0
print ((the string form of "half circle middle: ") + (the sketch test point (the bim middle of boundary segment halfCircle))) as a line

# Four sides out of order, two run backwards, one side a tiny stub.
set pieces to an empty list of a bim boundary segment record
append (the bim boundary line from (a cad vector2 with x 6.0 and y 4.0) to (a cad vector2 with x 0.0 and y 4.0)) to pieces
append (the bim boundary line from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 0.0 and y 0.0)) to pieces
append (the bim boundary line from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 0.0)) to pieces
append (the bim boundary arc from (a cad vector2 with x 6.0 and y 4.0) to (a cad vector2 with x 6.0 and y 0.0) bulging -1.0) to pieces
append (the bim boundary line from (a cad vector2 with x 0.0005 and y 4.0) to (a cad vector2 with x 0.0 and y 0.0)) to pieces
set chained to the bim boundary loop of pieces
show sketch test loop chained labelled (the string form of "loop")
set back to the bim boundary segments of (chained's corners's values) spanned (chained's spans's values)
show sketch test segments (back's values) labelled (the string form of "found back")
# Mirrored across x = 0, the arc bulges the other way round its chord.
set mirrored to an empty list of a cad vector2
set cornerCursor to (the length of (chained's corners's values)) - 1
loop while cornerCursor >= 0:
    set corner to the item at cornerCursor in (chained's corners's values)
    append (a cad vector2 with x (0.0 - corner's x) and y corner's y) to mirrored
    set cornerCursor to cornerCursor - 1
set mirroredSpans to an empty list of an integer
set spanCursor to (the length of (chained's spans's values)) - 1
loop while spanCursor >= 0:
    append (the item at spanCursor in (chained's spans's values)) to mirroredSpans
    set spanCursor to spanCursor - 1
# The polygon reversed starts at its old last corner: the spans start one
# corner on.
set rolled to an empty list of a cad vector2
append (the item at ((the length of mirrored) - 1) in mirrored) to rolled
loop cornerCursor from 0 to (the length of mirrored) - 1:
    append (the item at cornerCursor in mirrored) to rolled
set mirroredBack to the bim boundary segments of rolled spanned mirroredSpans
show sketch test segments (mirroredBack's values) labelled (the string form of "mirrored")
# Spans that do not cover the polygon: one line per edge.
set wrongSpans to an empty list of an integer
append 2 to wrongSpans
set uncovered to the bim boundary segments of rolled spanned wrongSpans
print ((the string form of "uncovered spans: ") + (the string form of (the length of (uncovered's values)))) as a line

# Refused: an open boundary, and two loops.
set open to an empty list of a bim boundary segment record
append (the bim boundary line from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0)) to open
append (the bim boundary line from (a cad vector2 with x 4.0 and y 0.0) to (a cad vector2 with x 4.0 and y 4.0)) to open
append (the bim boundary line from (a cad vector2 with x 4.0 and y 4.0) to (a cad vector2 with x 0.0 and y 4.0)) to open
show sketch test loop (the bim boundary loop of open) labelled (the string form of "open")
set twice to an empty list of a bim boundary segment record
append (the bim boundary arc from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 2.0 and y 0.0) bulging 1.0) to twice
append (the bim boundary arc from (a cad vector2 with x 2.0 and y 0.0) to (a cad vector2 with x 0.0 and y 0.0) bulging 1.0) to twice
append (the bim boundary arc from (a cad vector2 with x 5.0 and y 0.0) to (a cad vector2 with x 7.0 and y 0.0) bulging 1.0) to twice
append (the bim boundary arc from (a cad vector2 with x 7.0 and y 0.0) to (a cad vector2 with x 5.0 and y 0.0) bulging 1.0) to twice
show sketch test loop (the bim boundary loop of twice) labelled (the string form of "two loops")
set circle to an empty list of a bim boundary segment record
append (the item at 0 in twice) to circle
append (the item at 1 in twice) to circle
show sketch test loop (the bim boundary loop of circle) labelled (the string form of "circle")

# Tab on a floor 6 by 4: its sides as a sketch.
set editor to a new bim editor
set e to the address of editor
set square to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to square
append (a cad vector2 with x 6.0 and y 0.0) to square
append (a cad vector2 with x 6.0 and y 4.0) to square
append (a cad vector2 with x 0.0 and y 4.0) to square
begin bim transaction in (the address of (editor's documentValue))
set floorId to add bim slab on editor's levelId around square thick 0.25 to (the address of (editor's documentValue's current))
commit bim transaction in (the address of (editor's documentValue))
refresh bim editor e
select bim editor bim slab picked numbered floorId in e
type bim editor key 258 in e
print ((the string form of "sketching: ") + (the string form of (bim editor sketches a boundary editor))) as a line
show sketch test segments (editor's sketchSegments's values) labelled (the string form of "opened")
# Tab starts in pick mode; the right side is picked and removed.
click sketch test at 6.02 and 2.0 in e
print ((the string form of "picked: ") + (the string form of editor's sketchPicked)) as a line
type bim editor key bim delete key code in e
# A: an arc from (6, 0) to (6, 4) through (7, 2), its ends caught on the
# sides' ends.
type bim editor key 65 in e
click sketch test at 6.03 and 0.02 in e
click sketch test at 5.98 and 4.01 in e
click sketch test at 7.0 and 2.0 in e
print ((the string form of "after the arc, clicked: ") + (the string form of (the length of (editor's sketchPending's values)))) as a line
show sketch test segments (editor's sketchSegments's values) labelled (the string form of "drawn")
type bim editor key 258 in e
print editor's message as a line
print ((the string form of "sketching: ") + (the string form of (bim editor sketches a boundary editor))) as a line
show sketch test floor floorId of editor's documentValue's current labelled (the string form of "floor")
# Tab again: the arc found back.
type bim editor key 258 in e
show sketch test segments (editor's sketchSegments's values) labelled (the string form of "reopened")
# A line from the arc's middle out: then the boundary branches, refused.
type bim editor key 76 in e
click sketch test at 7.0 and 2.0 in e
click sketch test at 9.0 and 2.0 in e
type bim editor key 258 in e
print editor's message as a line
print ((the string form of "sketching: ") + (the string form of (bim editor sketches a boundary editor))) as a line
# Esc Esc Esc: the chain, the line tool, the sketch; the floor as it was.
type bim editor key bim escape key code in e
type bim editor key bim escape key code in e
type bim editor key bim escape key code in e
print editor's message as a line
show sketch test floor floorId of editor's documentValue's current labelled (the string form of "floor kept")
# One undo takes the arc away again.
ignore undo bim transaction in (the address of (editor's documentValue))
show sketch test floor floorId of editor's documentValue's current labelled (the string form of "undone")
