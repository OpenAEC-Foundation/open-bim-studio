# SPDX-License-Identifier: MPL-2.0
# The dimension tool (DI): two parallel wall faces dimensioned square to them,
# two wall ends point to point, and a wall end to a face; each placed through
# a third click. The dimensions are associative: moving a wall changes the
# value. They survive .bim and .ifcx with their place.
import ui/editor/bim_editor.dl

function click dimension test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function list dimension test values of {bim model record:modelValue} labelled {a string:title}:
    execute:
        print title as a line
        set index to the bim join index of modelValue
        loop cursor from 0 to the length of (modelValue's dimensions's values):
            set dimensionValue to the item at cursor in (modelValue's dimensions's values)
            set shape to the bim dimension line of dimensionValue in modelValue using index
            set line to (the string form of "  ") + (the string form of shape's valid)
            set line to (line + (the string form of " ")) + (the bim millimetre text of shape's value)
            set line to (line + (the string form of " from ")) + ((the bim millimetre text of shape's start's x) + ((the string form of ",") + (the bim millimetre text of shape's start's y)))
            set line to (line + (the string form of " to ")) + ((the bim millimetre text of shape's finish's x) + ((the string form of ",") + (the bim millimetre text of shape's finish's y)))
            print line as a line

set editor to a new bim editor
set e to the address of editor
# Two parallel walls 4 m apart, drawn as separate chains.
type bim editor key 87 in e
click dimension test at 0.0 and 0.0 in e
click dimension test at 6.0 and 0.0 in e
type bim editor key bim escape key code in e
type bim editor key 87 in e
click dimension test at 0.0 and 4.0 in e
click dimension test at 6.0 and 4.0 in e
type bim editor key bim escape key code in e
refresh bim editor e
set walls to editor's documentValue's current's walls's values
print ((the string form of "walls ") + (the string form of (the length of walls))) as a line
# Face to face, its line through x = 3.
type bim editor key 2015 in e
print editor's message as a line
set halfWall to 0.05
click dimension test at 3.0 and halfWall in e
print editor's message as a line
click dimension test at 3.0 and (4.0 - halfWall) in e
print editor's message as a line
click dimension test at 3.0 and 2.0 in e
print editor's message as a line
# End to end along the first wall, its line 1 m below.
click dimension test at 0.0 and 0.0 in e
click dimension test at 6.0 and 0.0 in e
click dimension test at 3.0 and -1.0 in e
print editor's message as a line
# Nothing there.
click dimension test at 3.0 and 2.0 in e
print editor's message as a line
list dimension test values of editor's documentValue's current labelled (the string form of "placed:")
# Associative: the second wall moves 1 m further out.
set second to the item at 1 in (editor's documentValue's current's walls's values)
begin bim transaction in (the address of (editor's documentValue))
ignore move bim wall second's id to (a cad vector2 with x 0.0 and y 5.0) and (a cad vector2 with x 6.0 and y 5.0) in (the address of (editor's documentValue's current))
commit bim transaction in (the address of (editor's documentValue))
list dimension test values of editor's documentValue's current labelled (the string form of "after moving the second wall:")
set reread to the bim model parsed from (the bim file text of editor's documentValue's current)
list dimension test values of reread's modelValue labelled (the string form of "from .bim:")
set native to the bim native text of ifcx (the bim ifcx text of editor's documentValue's current identified as (the string form of "d.ifcx") for project (the string form of "d") by (the string form of "test") at (the string form of "2026-10-09T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
list dimension test values of fromIfcx's modelValue labelled (the string form of "from .ifcx:")
