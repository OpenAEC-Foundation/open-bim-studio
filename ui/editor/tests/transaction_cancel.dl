# SPDX-License-Identifier: MPL-2.0
import model/bim_model.dl

function check cancelled edit {boolean:accepted} named {a string:caption}:
    execute:
        if accepted = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set documentValue to a new bim document
set doc to the address of documentValue
begin bim transaction in doc
ignore add bim grid named (the string form of "A") from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 5.0) reaching 0.0 to 3.0 to (the address of (documentValue's current))
commit bim transaction in doc
ignore undo bim transaction in doc
check cancelled edit ((the length of (documentValue's redoStack's values)) = 1) named (the string form of "undo creates a redo branch")
begin bim transaction in doc
ignore add bim grid named (the string form of "B") from (a cad vector2 with x 2.0 and y 0.0) to (a cad vector2 with x 2.0 and y 5.0) reaching 0.0 to 3.0 to (the address of (documentValue's current))
check cancelled edit ((the length of (documentValue's redoStack's values)) = 1) named (the string form of "a provisional preview keeps the redo branch")
roll back bim transaction in doc
check cancelled edit (((the length of (documentValue's current's grids's values)) = 0) and ((the length of (documentValue's undoStack's values)) = 0)) named (the string form of "cancel removes provisional geometry and undo entry")
check cancelled edit ((redo bim transaction in doc) and (((the item at 0 in (documentValue's current's grids's values))'s name) = (the string form of "A"))) named (the string form of "redo still restores the original edit after cancel")
ignore undo bim transaction in doc
begin bim transaction in doc
ignore add bim grid named (the string form of "B") from (a cad vector2 with x 2.0 and y 0.0) to (a cad vector2 with x 2.0 and y 5.0) reaching 0.0 to 3.0 to (the address of (documentValue's current))
commit bim transaction in doc
check cancelled edit ((the length of (documentValue's redoStack's values)) = 0) named (the string form of "committing a different edit discards the old branch")
ignore undo bim transaction in doc
check cancelled edit ((redo bim transaction in doc) and (((the item at 0 in (documentValue's current's grids's values))'s name) = (the string form of "B"))) named (the string form of "the new edit retains normal undo and redo")

set capped to a new bim document
loop cursor from 0 to the bim undo depth:
    begin bim transaction in (the address of capped)
    set x to cursor as a 64 bit floating-point number
    ignore add bim grid named (the string form of cursor) from (a cad vector2 with x x and y 0.0) to (a cad vector2 with x x and y 5.0) reaching 0.0 to 3.0 to (the address of (capped's current))
    commit bim transaction in (the address of capped)
begin bim transaction in (the address of capped)
roll back bim transaction in (the address of capped)
check cancelled edit ((the length of (capped's undoStack's values)) = (the bim undo depth)) named (the string form of "cancelling at the history limit keeps every undo entry")
check cancelled edit ((the length of ((the item at 0 in (capped's undoStack's values))'s grids's values)) = 0) named (the string form of "a cancelled preview does not discard the oldest undo state")
