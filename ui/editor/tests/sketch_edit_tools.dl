# SPDX-License-Identifier: MPL-2.0
# The sketch's edit tools (#89): arcs by start, end and radius, by centre,
# start and end, and tangent to the segment before; values typed while
# drawing, moving, and for a picked arc, circle, ellipse quarter or line;
# Trim/Extend to corner; window and crossing selection of segments, which
# then move and are deleted together; dragging an arc's end, keeping its
# bulge or (K) its radius.
import ui/editor/bim_editor.dl

function check sketch edit {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function point sketch edit at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.05 in editor

function click sketch edit at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        point sketch edit at x and y in editor
        press bim editor boundary sketch in editor

# Types `typedText` key by key, without Enter.
function key sketch edit {a string:typedText} in {a pointer to a bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of typedText:
            type bim editor key ((the character at cursor in typedText) as an integer) in editor

function enter sketch edit {a string:typedText} in {a pointer to a bim editor record:editor}:
    execute:
        key sketch edit typedText in editor
        type bim editor key (bim enter key code) in editor

function sketch edit segment {integer:index} of {bim editor record:editor}:
    execute:
        return the item at index in (editor's sketchSegments's values)

function sketch edit spot {cad vector2:spotGiven} is {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y}:
    execute:
        return ((the absolute value of (spotGiven's x - x)) < 1e-6) and ((the absolute value of (spotGiven's y - y)) < 1e-6)

set editor to a new bim editor
set e to the address of editor
# A new floor's sketch, the line tool ready.
type bim editor key 66 in e

# Start, end, radius: the radius typed, the arc on the pointer's side.
type bim editor key 68 in e
check sketch edit (editor's sketchTool = bim sketch radius arc tool) named (the string form of "D chooses the arc by radius")
click sketch edit at 0.0 and 0.0 in e
click sketch edit at 4.0 and 0.0 in e
point sketch edit at 2.0 and 1.0 in e
key sketch edit (the string form of "2.5") in e
check sketch edit ((the substring of editor's message from 0 spanning 9 bytes) = (the string form of "Typed 2.5")) named (the string form of "the value typed shows in the hint")
type bim editor key (bim enter key code) in e
set arcPiece to sketch edit segment 0 of editor
check sketch edit ((the length of (editor's sketchSegments's values)) = 1) named (the string form of "Enter makes the arc")
check sketch edit ((the absolute value of (arcPiece's bulge + 1.0)) < 1e-9) named (the string form of "radius 2.5 over a 4 m chord bulges 1 m, to the pointer's side")
check sketch edit ((the absolute value of ((the bim arc of boundary segment arcPiece)'s radius - 2.5)) < 1e-9) named (the string form of "its radius is the one typed")

# Centre, start, end: the radius typed, the end clicked (a quarter), then
# an angle typed (a half circle).
type bim editor key 79 in e
check sketch edit ((the length of (editor's sketchPending's values)) = 0) named (the string form of "O chooses the centre arc afresh")
click sketch edit at 10.0 and 0.0 in e
point sketch edit at 12.0 and 0.0 in e
enter sketch edit (the string form of "2") in e
click sketch edit at 10.0 and 5.0 in e
set arcPiece to sketch edit segment 1 of editor
check sketch edit ((sketch edit spot arcPiece's start is 12.0 and 0.0) and (sketch edit spot arcPiece's finish is 10.0 and 2.0)) named (the string form of "the centre arc runs from the start typed to the end's ray")
check sketch edit ((the absolute value of (arcPiece's bulge - (2.0 * (1.0 - (the cosine of 0.7853981633974483))))) < 1e-9) named (the string form of "a quarter anticlockwise")
click sketch edit at 20.0 and 0.0 in e
click sketch edit at 22.0 and 0.0 in e
enter sketch edit (the string form of "180") in e
set arcPiece to sketch edit segment 2 of editor
check sketch edit ((sketch edit spot arcPiece's finish is 18.0 and 0.0) and ((the absolute value of (arcPiece's bulge - 2.0)) < 1e-9)) named (the string form of "an angle typed turns 180 degrees")

# A tangent arc on from a line's end.
type bim editor key 76 in e
click sketch edit at 30.0 and 0.0 in e
click sketch edit at 34.0 and 0.0 in e
type bim editor key (bim enter key code) in e
type bim editor key 78 in e
click sketch edit at 50.0 and 50.0 in e
check sketch edit ((the length of (editor's sketchPending's values)) = 0) named (the string form of "a tangent arc starts only at a segment's end")
click sketch edit at 34.0 and 0.0 in e
set rubber to the bim sketch rubber band of editor reaching (a cad vector2 with x 34.0 and y 4.0)
check sketch edit ((the length of rubber) > 2) named (the string form of "the tangent arc's rubber band is curved")
free rubber
click sketch edit at 34.0 and 4.0 in e
set arcPiece to sketch edit segment 4 of editor
set leaving to the bim start direction of boundary segment arcPiece
check sketch edit ((the absolute value of (arcPiece's bulge - 2.0)) < 1e-9) named (the string form of "the tangent arc is the half circle on")
check sketch edit ((the absolute value of (leaving's x - 1.0)) < 1e-9) named (the string form of "it leaves along the line")

# A line's length typed toward the pointer.
type bim editor key 76 in e
click sketch edit at 40.0 and 0.0 in e
point sketch edit at 45.0 and 0.0 in e
enter sketch edit (the string form of "3") in e
check sketch edit (sketch edit spot (sketch edit segment 5 of editor)'s finish is 43.0 and 0.0) named (the string form of "a line typed 3 m long")

# A circle's radius typed, then typed again with a half picked.
type bim editor key 67 in e
click sketch edit at 60.0 and 0.0 in e
point sketch edit at 61.0 and 0.0 in e
enter sketch edit (the string form of "1.5") in e
check sketch edit ((the absolute value of ((the bim arc of boundary segment (sketch edit segment 6 of editor))'s radius - 1.5)) < 1e-9) named (the string form of "a circle typed 1.5 in radius")
type bim editor key (bim escape key code) in e
check sketch edit (editor's sketchTool = bim sketch pick tool) named (the string form of "Esc picks")
click sketch edit at 60.0 and 1.5 in e
check sketch edit (editor's sketchPicked = 6) named (the string form of "a half of the circle picked")
enter sketch edit (the string form of "2") in e
set firstHalf to the bim arc of boundary segment (sketch edit segment 6 of editor)
set secondHalf to the bim arc of boundary segment (sketch edit segment 7 of editor)
check sketch edit (((the absolute value of (firstHalf's radius - 2.0)) < 1e-9) and ((the absolute value of (secondHalf's radius - 2.0)) < 1e-9)) named (the string form of "the whole circle takes the radius typed")
check sketch edit (sketch edit spot firstHalf's centre is 60.0 and 0.0) named (the string form of "about its centre")

# An ellipse's semi-axis through the picked quarter's start.
type bim editor key 69 in e
click sketch edit at 70.0 and 0.0 in e
click sketch edit at 73.0 and 0.0 in e
click sketch edit at 70.0 and 1.0 in e
type bim editor key (bim escape key code) in e
set quarterMiddle to the bim ellipse quarter point of (sketch edit segment 8 of editor) at 0.5
point sketch edit at quarterMiddle's x and quarterMiddle's y in e
press bim editor boundary sketch in e
check sketch edit (editor's sketchPicked = 8) named (the string form of "an ellipse quarter picked")
enter sketch edit (the string form of "2") in e
check sketch edit ((sketch edit spot (sketch edit segment 8 of editor)'s start is 72.0 and 0.0) and (sketch edit spot (sketch edit segment 9 of editor)'s finish is 68.0 and 0.0)) named (the string form of "the semi-axis typed moves both ends of that axis")
check sketch edit (sketch edit spot (sketch edit segment 8 of editor)'s finish is 70.0 and 1.0) named (the string form of "the other axis stays")

# Trim/Extend to corner: two lines run to where they cross.
type bim editor key 76 in e
click sketch edit at 80.0 and 0.0 in e
click sketch edit at 85.0 and 0.0 in e
type bim editor key (bim enter key code) in e
click sketch edit at 90.0 and 1.0 in e
click sketch edit at 90.0 and 5.0 in e
type bim editor key (bim enter key code) in e
type bim editor key 84 in e
check sketch edit (editor's sketchTool = bim sketch trim tool) named (the string form of "T chooses Trim/Extend")
click sketch edit at 82.0 and 0.0 in e
click sketch edit at 90.0 and 3.0 in e
check sketch edit (sketch edit spot (sketch edit segment 12 of editor)'s finish is 90.0 and 0.0) named (the string form of "the first line extends to the corner")
check sketch edit (sketch edit spot (sketch edit segment 13 of editor)'s start is 90.0 and 0.0) named (the string form of "the second line runs down to it")

# Window (to the right) and crossing (to the left) selection.
type bim editor key (bim escape key code) in e
ignore select bim sketch segments in box from (a cad vector2 with x 79.0 and y -1.0) to (a cad vector2 with x 91.0 and y 6.0) in e
check sketch edit ((the bim sketch chosen count of editor) = 2) named (the string form of "a window round both lines chooses them")
ignore select bim sketch segments in box from (a cad vector2 with x 86.0 and y -0.5) to (a cad vector2 with x 84.0 and y 0.5) in e
check sketch edit ((the bim sketch chosen count of editor) = 1) named (the string form of "a crossing over one line chooses it")
ignore select bim sketch segments in box from (a cad vector2 with x 84.0 and y -0.5) to (a cad vector2 with x 86.0 and y 0.5) in e
check sketch edit ((the bim sketch chosen count of editor) = 0) named (the string form of "a window over part of it chooses nothing")
ignore select bim sketch segments in box from (a cad vector2 with x 91.0 and y 6.0) to (a cad vector2 with x 85.0 and y -1.0) in e
check sketch edit ((the bim sketch chosen count of editor) = 2) named (the string form of "a crossing touching both chooses both")
# G and a distance typed move both, joined.
point sketch edit at 90.0 and 0.0 in e
type bim editor key 71 in e
point sketch edit at 90.0 and -5.0 in e
enter sketch edit (the string form of "2") in e
check sketch edit ((sketch edit spot (sketch edit segment 12 of editor)'s start is 80.0 and -2.0) and (sketch edit spot (sketch edit segment 13 of editor)'s finish is 90.0 and 3.0)) named (the string form of "the lines chosen move 2 m toward the pointer")
check sketch edit (sketch edit spot (sketch edit segment 13 of editor)'s start is 90.0 and -2.0) named (the string form of "and stay joined")
set before to the length of (editor's sketchSegments's values)
ignore select bim sketch segments in box from (a cad vector2 with x 91.0 and y 6.0) to (a cad vector2 with x 85.0 and y -3.0) in e
type bim editor key (bim delete key code) in e
check sketch edit ((the length of (editor's sketchSegments's values)) = (before - 2)) named (the string form of "Delete removes the segments chosen")

# Dragging an arc's end: it keeps its bulge, or with K its radius.
click sketch edit at 0.0 and 0.0 in e
check sketch edit (bim boundary point selected in editor) named (the string form of "the arc's start picked")
check sketch edit (begin bim sketch drag from (a cad vector2 with x 0.0 and y 0.0) in e) named (the string form of "a drag begins on the point picked")
point sketch edit at 0.0 and -1.0 in e
place bim boundary move in e
set arcPiece to sketch edit segment 0 of editor
check sketch edit ((sketch edit spot arcPiece's start is 0.0 and -1.0) and ((the absolute value of (arcPiece's bulge + 1.0)) < 1e-9)) named (the string form of "the dragged end keeps the bulge")
type bim editor key 75 in e
check sketch edit editor's sketchKeepsRadius named (the string form of "K keeps the radius")
set radiusBefore to (the bim arc of boundary segment arcPiece)'s radius
click sketch edit at 4.0 and 0.0 in e
check sketch edit (begin bim sketch drag from (a cad vector2 with x 4.0 and y 0.0) in e) named (the string form of "a drag begins on the arc's end")
point sketch edit at 3.0 and -1.0 in e
place bim boundary move in e
set arcPiece to sketch edit segment 0 of editor
check sketch edit (sketch edit spot arcPiece's finish is 3.0 and -1.0) named (the string form of "the end lands where let go")
check sketch edit ((the absolute value of ((the bim arc of boundary segment arcPiece)'s radius - radiusBefore)) < 1e-9) named (the string form of "the arc keeps its radius")
