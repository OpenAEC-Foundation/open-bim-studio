# SPDX-License-Identifier: MPL-2.0
# Exterior dimension chains (2461) on a 6 x 4 m box of 200 mm walls drawn on
# their centrelines, with an inner wall meeting the south wall at x = 2.5
# and a 1.2 m window (1.34 m with its frame joints) centred at x = 4.5 in it.
# Outer faces lie 0.1 m outside the centrelines. The south wall gets three
# chains: corner, window edges, corner (3.93 + 1.34 + 0.93 = 6.2); corner,
# inner wall faces, corner (2.6 + 0.2 + 3.4); and 6.2 whole. The north wall,
# which the inner wall also meets, gets its walls chain and its whole; the
# east and west walls only their whole length (4.2).
import ui/editor/bim_editor.dl

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.2)) to layers
set wallType to add bim wall type named (the string form of "Test 200") with layers to target
free layers
set south to add bim wall typed wallType on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
ignore add bim wall typed wallType on editor's levelId from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 6.0 and y 4.0) to target
ignore add bim wall typed wallType on editor's levelId from (a cad vector2 with x 6.0 and y 4.0) to (a cad vector2 with x 0.0 and y 4.0) to target
ignore add bim wall typed wallType on editor's levelId from (a cad vector2 with x 0.0 and y 4.0) to (a cad vector2 with x 0.0 and y 0.0) to target
ignore add bim wall typed wallType on editor's levelId from (a cad vector2 with x 2.6 and y 0.0) to (a cad vector2 with x 2.6 and y 4.0) to target
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.2 with sill 0.9 and frame 0.07 to target
ignore add bim opening typed windowType in south at 4.5 to target
commit bim transaction in (the address of (editor's documentValue))
type bim editor key 2461 in e
print editor's message as a line
set modelValue to editor's documentValue's current
set index to the bim join index of modelValue
set measures to the string form of "measures:"
loop cursor from 0 to the length of (modelValue's dimensions's values):
    set measured to the bim measure of (the item at cursor in (modelValue's dimensions's values)) in modelValue using index
    if measured's valid:
        set measures to (measures + (the string form of " ")) + (the bim length measured's value in units 0)
    else:
        set measures to measures + (the string form of " invalid")
print measures as a line
type bim editor key 90 in e
print ((the string form of "undone: ") + (the string form of (the length of (editor's documentValue's current's dimensions's values)))) as a line
