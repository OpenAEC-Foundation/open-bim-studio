# SPDX-License-Identifier: MPL-2.0
# ZR zooms the plan onto a region: the command picks the zoom region tool,
# the first click a corner, the second the opposite one, after which the
# region waits for the window and the select tool returns. ZR typed as two
# letters gives the same command.
import ui/editor/bim_editor.dl

function click bim zoom test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        refresh bim editor editor
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

set editor to a new bim editor
set e to the address of editor
print ((the string form of "ZR is ") + (the string form of (the bim two letter command of 90 then 82))) as a line
type bim editor key 2130 in e
print editor's message as a line
print ((the string form of "zoom region tool: ") + (the string form of (editor's tool = bim zoom region tool))) as a line
click bim zoom test at 1.0 and 2.0 in e
print editor's message as a line
click bim zoom test at 5.0 and 4.0 in e
print editor's message as a line
print ((the string form of "ready: ") + ((the string form of editor's zoomReady) + ((the string form of ", from ") + ((the string form of editor's zoomFrom's x) + ((the string form of ",") + ((the string form of editor's zoomFrom's y) + ((the string form of " to ") + ((the string form of editor's zoomTo's x) + ((the string form of ",") + (the string form of editor's zoomTo's y)))))))))) as a line
print ((the string form of "back to select: ") + (the string form of (editor's tool = bim select tool))) as a line
