# SPDX-License-Identifier: MPL-2.0
# Snapping as in Open 2D Studio: end and mid points, intersections,
# perpendicular from the tracking origin, nearest on an edge, horizontal and
# polar tracking, ortho, and snapping off.
import ui/editor/bim_editor.dl

function show bim snap at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor} labelled {a string:caption}:
    execute:
        refresh bim editor editor
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        set point to editor's snap's point
        print ((caption + (the string form of ": ")) + ((editor's snap's label + (the string form of " ")) + ((the string form of point's x) + ((the string form of " ") + (the string form of point's y))))) as a line

function click bim snapping test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        refresh bim editor editor
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

set editor to a new bim editor
set e to the address of editor
# Two lines crossing at (2, 1) (not a middle of either), and a wall from (0, 4) to (6, 4).
type bim editor key 78 in e
click bim snapping test at 0.0 and 0.0 in e
click bim snapping test at 6.0 and 3.0 in e
type bim editor key bim enter key code in e
click bim snapping test at 1.0 and 2.0 in e
click bim snapping test at 4.0 and -1.0 in e
type bim editor key bim escape key code in e
type bim editor key 87 in e
click bim snapping test at 0.0 and 4.0 in e
click bim snapping test at 6.0 and 4.0 in e
type bim editor key bim escape key code in e
show bim snap at 5.97 and 3.03 in e labelled (the string form of "near a line end")
show bim snap at 2.96 and 4.04 in e labelled (the string form of "near the wall middle")
show bim snap at 2.04 and 0.97 in e labelled (the string form of "near the crossing")
show bim snap at 5.0 and 4.05 in e labelled (the string form of "on the wall")
show bim snap at 7.33 and 8.21 in e labelled (the string form of "in the open")
# Drawing a line from (5, 0): perpendicular to the wall, then tracking.
type bim editor key 78 in e
click bim snapping test at 5.0 and 0.0 in e
show bim snap at 5.03 and 3.96 in e labelled (the string form of "perpendicular to the wall")
show bim snap at 8.02 and 0.06 in e labelled (the string form of "tracking east")
show bim snap at 7.03 and 1.97 in e labelled (the string form of "tracking 45 degrees")
type bim editor key 297 in e
print editor's message as a line
show bim snap at 7.2 and 1.0 in e labelled (the string form of "ortho")
type bim editor key 297 in e
type bim editor key 292 in e
print editor's message as a line
show bim snap at 5.97 and 3.03 in e labelled (the string form of "snapping off")
