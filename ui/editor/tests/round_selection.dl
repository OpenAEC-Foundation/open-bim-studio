# A round linear's selection outline has the corners the mesh has at the
# view's level of detail (issue 44: a pipe's outline was a 24-sided
# polygon while its mesh, meshed for the zoom, was smooth).
import ui/editor/bim_editor.dl

function check round selection {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The corners of the one linear's outline: three edges per corner (the two
# rings and the side between them), two points per edge.
function the round selection corners of {a pointer to a list:outlines}:
    execute:
        loop cursor from 0 to the length of outlines:
            set outline to the item at cursor in outlines
            if outline's kind = bim linear picked:
                return (the length of (outline's segments's values)) / 6
        return 0

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set levelId to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
set pipeType to add bim linear type named (the string form of "Pipe 300") as role bim pipe role sized 0.3 by 0.3 round true of (the string form of "steel") to target
set pipeId to add bim linear typed pipeType on levelId from (a cad vector3 with x 0.0, y 0.0 and z 1.0) to (a cad vector3 with x 2.0, y 0.0 and z 1.0) turned 0.0 to target

set plainOutlines to the bim selection outlines of editor in plan false
check round selection ((the round selection corners of plainOutlines) = 24) named (the string form of "without a tolerance the outline keeps its 24 corners")
set fineOutlines to the bim selection outlines of editor in plan false within 0.0005
check round selection ((the round selection corners of fineOutlines) = (the bim round corners for radius 0.15 within 0.0005)) named (the string form of "with a tolerance the outline has the mesh's corners")
check round selection ((the round selection corners of fineOutlines) = 40) named (the string form of "a half-millimetre chord on a 300 mm pipe gives 40 corners")
set coarseOutlines to the bim selection outlines of editor in plan false within 0.05
check round selection ((the round selection corners of coarseOutlines) = 12) named (the string form of "a coarse chord gives the fewest, 12")
check round selection ((the bim lod tolerance at 2000.0) = 0.000244140625) named (the string form of "at 2000 pixels a metre the chord is 2^-12 m")
check round selection ((the bim lod tolerance at 100.0) = 0.00390625) named (the string form of "at 100 pixels a metre the chord is 2^-8 m")
set zoomedOutlines to the bim selection outlines of editor in plan false within (the bim lod tolerance at 2000.0)
check round selection ((the round selection corners of zoomedOutlines) = (the bim round corners for radius 0.15 within 0.000244140625)) named (the string form of "at 2000 pixels a metre the outline has that chord's corners")
