# SPDX-License-Identifier: MPL-2.0
# Delete on a selected level: an empty level goes with its plan view, the
# storey below becomes active and undo brings it back; a level a wall stands
# on, and the last level, stay with a message saying why. Page Up past the
# top storey adds a level and says so.
import ui/editor/bim_editor.dl

function show bim level test levels of {bim editor record:editor} labelled {a string:label}:
    execute:
        set names to the string form of ""
        loop cursor from 0 to the length of (editor's documentValue's current's levels's values):
            set names to (names + (the string form of " ")) + (the item at cursor in (editor's documentValue's current's levels's values))'s name
        print ((label + (the string form of ":")) + names) as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set groundId to (the item at 0 in (editor's documentValue's current's levels's values))'s id
set editor's levelId to groundId
# Page Up past the top storey: a new level, named in the message.
type bim editor key bim page up key code in e
print editor's message as a line
set upperId to editor's levelId
show bim level test levels of editor labelled (the string form of "levels")
# The empty upper level goes; the ground floor becomes active.
select bim editor bim level picked numbered upperId in e
type bim editor key bim delete key code in e
print editor's message as a line
show bim level test levels of editor labelled (the string form of "after delete")
print ((the string form of "active is the ground floor: ") + (the string form of (editor's levelId = groundId))) as a line
type bim editor key 90 in e
show bim level test levels of editor labelled (the string form of "after undo")
# A wall on it keeps it.
begin bim transaction in (the address of (editor's documentValue))
ignore add bim wall typed editor's wallTypeId on upperId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to target
commit bim transaction in (the address of (editor's documentValue))
select bim editor bim level picked numbered upperId in e
type bim editor key bim delete key code in e
print editor's message as a line
show bim level test levels of editor labelled (the string form of "kept")
# The last level stays.
set lone to a new bim editor
set loneId to (the item at 0 in (lone's documentValue's current's levels's values))'s id
select bim editor bim level picked numbered loneId in (the address of lone)
type bim editor key bim delete key code in (the address of lone)
print lone's message as a line
