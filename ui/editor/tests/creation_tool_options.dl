# SPDX-License-Identifier: MPL-2.0
# One creation tool per element with its draw options (#101). The Wall tool
# draws a rectangle of four walls or a circle of two half arcs as one edit,
# a tangent arc on from a wall's end (the chain going on straight after),
# and a wall along a picked line. A new floor's sketch picks walls (their
# inner faces, joined at the corners) and a roof's adds a space's outline.
import ui/editor/bim_editor.dl

function check creation options {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function click creation options at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.001 in editor
        press bim editor pointer in editor

# A click with a pick radius of 5 cm, as a zoomed-in plan gives.
function pick creation options at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.05 in editor
        press bim editor pointer in editor

function bim test point {cad vector2:point} is {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y}:
    execute:
        return ((the absolute value of (point's x - x)) < 1e-6) and ((the absolute value of (point's y - y)) < 1e-6)

function the creation options wall count of {bim editor record:editor}:
    execute:
        return the length of (editor's documentValue's current's walls's values)

function the creation options last wall of {bim editor record:editor}:
    execute:
        return the item at ((the creation options wall count of editor) - 1) in (editor's documentValue's current's walls's values)

function the creation options selected area of {bim editor record:editor}:
    execute:
        set made to the item at (the bim slab index of editor's selectionId in editor's documentValue's current)'s position in (editor's documentValue's current's slabs's values)
        return the absolute value of (the bim signed area of (made's outline's values))

set editor to a new bim editor
set e to the address of editor
set editor's wallLine to bim wall centre line
set start to the creation options wall count of editor

# Rectangle: two corners, four walls meeting end to end, one undo.
type bim editor key 87 in e
type bim editor key 2396 in e
check creation options ((editor's tool = bim rectangle wall tool) and (bim tool editor's tool draws walls)) named (the string form of "Rectangle is a draw option of the Wall tool")
click creation options at 0.0 and 0.0 in e
check creation options ((the creation options wall count of editor) = start) named (the string form of "one corner makes nothing yet")
set preview to the bim wall shape preview of e to (a cad vector2 with x 6.0 and y 4.0)
check creation options ((the length of (preview's values)) = 4) named (the string form of "the plan previews four walls")
click creation options at 6.0 and 4.0 in e
check creation options ((the creation options wall count of editor) = (start + 4)) named (the string form of "the opposite corner makes four walls")
set firstWall to the item at start in (editor's documentValue's current's walls's values)
set lastWall to the creation options last wall of editor
check creation options ((bim test point firstWall's start is 0.0 and 0.0) and (bim test point firstWall's finish is 6.0 and 0.0)) named (the string form of "they run anticlockwise from the first corner")
check creation options (bim test point lastWall's finish is 0.0 and 0.0) named (the string form of "and close on it")
check creation options ((editor's tool = bim rectangle wall tool) and (editor's moveStage = 0)) named (the string form of "the tool stays for another rectangle")
type bim editor key 90 in e
check creation options ((the creation options wall count of editor) = start) named (the string form of "one undo takes the four walls back")
type bim editor key 89 in e
check creation options ((the creation options wall count of editor) = (start + 4)) named (the string form of "and redo brings them again")

# Circle: centre and a point, two half arcs.
type bim editor key 2397 in e
click creation options at 20.0 and 0.0 in e
click creation options at 23.0 and 0.0 in e
check creation options ((the creation options wall count of editor) = (start + 6)) named (the string form of "a circle is two walls")
set halfArc to the creation options last wall of editor
check creation options ((the absolute value of (halfArc's bulge - 3.0)) < 1e-6) named (the string form of "each a half arc of the radius")
click creation options at 30.0 and 0.0 in e
click creation options at 30.1 and 0.0 in e
check creation options ((the creation options wall count of editor) = (start + 6)) named (the string form of "a circle narrower than the wall is refused")
type bim editor key (bim escape key code) in e

# Tangent arc on from a straight wall, then straight again.
type bim editor key 87 in e
click creation options at 0.0 and 10.0 in e
click creation options at 5.0 and 10.0 in e
set straightCount to the creation options wall count of editor
type bim editor key 2395 in e
check creation options ((editor's tool = bim tangent arc wall tool) and editor's chainActive) named (the string form of "Tangent arc goes on from the chain")
click creation options at 2.0 and 7.0 in e
check creation options ((the creation options wall count of editor) = straightCount) named (the string form of "an end behind the wall is refused")
click creation options at 8.0 and 13.0 in e
set tangentWall to the creation options last wall of editor
check creation options (((the creation options wall count of editor) = (straightCount + 1)) and (bim test point tangentWall's start is 5.0 and 10.0)) named (the string form of "the arc leaves the wall's end")
check creation options ((the absolute value of (tangentWall's bulge - (3.0 * (1.0 - (the square root of 0.5))))) < 1e-6) named (the string form of "as a quarter circle tangent to the wall")
type bim editor key 87 in e
check creation options ((editor's tool = bim wall tool) and editor's chainActive) named (the string form of "Line goes on from the arc")
click creation options at 8.0 and 16.0 in e
set onward to the creation options last wall of editor
check creation options ((bim test point onward's start is 8.0 and 13.0) and (onward's bulge = 0.0)) named (the string form of "a straight wall from the arc's end")
type bim editor key (bim escape key code) in e
check creation options ((editor's tool = bim select tool) and (editor's chainActive = false)) named (the string form of "Esc leaves the Wall tool")

# Tangent arc with no chain: a click on a wall's end starts it.
type bim editor key 2395 in e
check creation options (editor's chainActive = false) named (the string form of "Tangent arc alone waits for a wall's end")
click creation options at 8.0 and 16.0 in e
click creation options at 5.0 and 19.0 in e
set fromEnd to the creation options last wall of editor
check creation options ((bim test point fromEnd's start is 8.0 and 16.0) and ((the absolute value of (fromEnd's bulge - (3.0 * (1.0 - (the square root of 0.5))))) < 1e-6)) named (the string form of "and the arc turns on from it")
type bim editor key (bim escape key code) in e

# Pick lines: a wall along a drawn line.
begin bim transaction in (the address of (editor's documentValue))
ignore add bim line on editor's levelId from (a cad vector2 with x 0.0 and y 30.0) to (a cad vector2 with x 4.0 and y 30.0) to (the address of (editor's documentValue's current))
commit bim transaction in (the address of (editor's documentValue))
type bim editor key 2398 in e
set beforeLine to the creation options wall count of editor
pick creation options at 2.0 and 30.02 in e
set alongLine to the creation options last wall of editor
check creation options (((the creation options wall count of editor) = (beforeLine + 1)) and ((bim test point alongLine's start is 0.0 and 30.0) and (bim test point alongLine's finish is 4.0 and 30.0))) named (the string form of "Pick lines puts a wall along the line")
pick creation options at 2.0 and 33.0 in e
check creation options ((the creation options wall count of editor) = (beforeLine + 1)) named (the string form of "a click off any line makes nothing")
type bim editor key (bim escape key code) in e

# Floor: pick the rectangle's four walls; their inner faces close the loop.
refresh bim editor e
set slabsBefore to the length of (editor's documentValue's current's slabs's values)
type bim editor key 66 in e
type bim editor boundary key 87 in e
check creation options (editor's sketchTool = bim sketch pick walls tool) named (the string form of "W picks walls in a floor's sketch")
click creation options at 3.0 and 0.0 in e
click creation options at 6.0 and 2.0 in e
click creation options at 3.0 and 4.0 in e
check creation options ((the length of (editor's sketchSegments's values)) = 3) named (the string form of "three walls give three faces")
click creation options at 0.0 and 2.0 in e
check creation options ((the length of (editor's sketchSegments's values)) = 4) named (the string form of "the fourth closes the loop")
set firstFace to the item at 0 in (editor's sketchSegments's values)
check creation options ((bim test point firstFace's start is 0.18 and 0.18) and (bim test point firstFace's finish is 5.82 and 0.18)) named (the string form of "on the walls' inner faces, mitred at the corners")
click creation options at 3.0 and 4.0 in e
check creation options ((the length of (editor's sketchSegments's values)) = 3) named (the string form of "a wall picked again leaves the loop")
click creation options at 3.0 and 4.0 in e
type bim editor key 258 in e
check creation options ((the length of (editor's documentValue's current's slabs's values)) = (slabsBefore + 1)) named (the string form of "Tab makes the floor")
check creation options ((the absolute value of ((the creation options selected area of editor) - (5.64 * 3.64))) < 1e-6) named (the string form of "inside the walls")

# Roof: From space adds the room's outline.
select bim editor bim nothing picked numbered (the bim refused id) in e
refresh bim editor e
type bim editor key 2080 in e
type bim editor boundary key 83 in e
check creation options (editor's sketchTool = bim sketch space tool) named (the string form of "S takes a space's outline")
click creation options at 3.0 and 2.0 in e
check creation options ((the length of (editor's sketchSegments's values)) >= 4) named (the string form of "the room's sides join the sketch")
type bim editor key 258 in e
check creation options ((the length of (editor's documentValue's current's slabs's values)) = (slabsBefore + 2)) named (the string form of "Tab makes the roof")
check creation options ((the absolute value of ((the creation options selected area of editor) - (5.64 * 3.64))) < 1e-4) named (the string form of "over the room")
