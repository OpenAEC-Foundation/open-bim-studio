# SPDX-License-Identifier: MPL-2.0
# Real ghost renderer input, without a graphics window or model mutation.
import editor/bim_modify_preview.dl

function check ghost case {boolean:accepted} named {a string:captionText}:
    execute:
        if accepted = false:
            print ((the string form of "FAIL: ") + captionText) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + captionText) as a line

set boxLow to a cad vector2 with x 0.0 and y 0.0
set boxHigh to a cad vector2 with x 100.0 and y 100.0
set clippedEdge to the bim ghost edge from (a cad vector2 with x -10.0 and y 20.0) to (a cad vector2 with x 110.0 and y 20.0) clipped between boxLow and boxHigh
check ghost case (clippedEdge's visible and ((clippedEdge's first's x = 0.0) and (clippedEdge's last's x = 100.0))) named (the string form of "crossing ghost edge is clipped at both viewport sides")
set clippedEdge to the bim ghost edge from (a cad vector2 with x -10.0 and y -2.0) to (a cad vector2 with x 110.0 and y -2.0) clipped between boxLow and boxHigh
check ghost case (clippedEdge's visible = false) named (the string form of "parallel outside ghost cannot paint chrome")
set clippedEdge to the bim ghost edge from boxLow to boxLow clipped between boxLow and boxHigh
check ghost case (clippedEdge's visible = false) named (the string form of "zero length ghost edge is omitted")

set workEditor to a new bim editor
set modelPointer to the address of (workEditor's documentValue's current)
set gridId to add bim grid named (the string form of "A") from (a cad vector2 with x 0.0 and y -1.0) to (a cad vector2 with x 0.0 and y 1.0) reaching 0.0 to 3.0 to modelPointer
select bim editor bim grid picked numbered gridId in (the address of workEditor)
set sourceId to modelPointer's nextId
set undoCount to the length of (workEditor's documentValue's undoStack's values)
set testLayout to @intrinsic("construct", a bim screen layout record, 200.0, 100.0, 0.0, 100.0, 0.0, 100.0)
set testCamera to @intrinsic("construct", a bim camera record, (a cad vector2 with x 0.0 and y 0.0), 10.0, 0.5, 0.6, (a cad vector3 with x 0.0, y 0.0 and z 0.0), 10.0)
set workEditor's tool to bim copy tool
set workEditor's moveStage to 2
set workEditor's moveBase to a cad vector2 with x 0.0 and y 0.0
set workEditor's snap's point to a cad vector2 with x 2.0 and y 1.0
set ghostValues to the bim modification preview segments of workEditor in view false in testLayout with testCamera
check ghost case ((the length of ghostValues) = 1) named (the string form of "single selected grid gets an actual copy ghost")
set firstGhost to the item at 0 in ghostValues
check ghost case (((the cad distance from firstGhost's first to (a cad vector2 with x 70.0 and y 50.0)) < 1e-9) and ((the cad distance from firstGhost's last to (a cad vector2 with x 70.0 and y 30.0)) < 1e-9)) named (the string form of "copy ghost projects translated endpoints")
check ghost case firstGhost's gridStyle named (the string form of "grid ghost retains its dash style")
free ghostValues
set workEditor's tool to bim array tool
set workEditor's modify's count to 3
set workEditor's snap's point to a cad vector2 with x 4.0 and y 0.0
set ghostValues to the bim modification preview segments of workEditor in view false in testLayout with testCamera
check ghost case ((the length of ghostValues) = 2) named (the string form of "array count includes the original without a duplicate ghost")
check ghost case (((the item at 0 in ghostValues)'s first's x = 70.0) and ((the item at 1 in ghostValues)'s first's x = 90.0)) named (the string form of "array ghosts match evenly spaced commit transforms")
free ghostValues
set workEditor's tool to bim mirror tool
set workEditor's moveBase to a cad vector2 with x 1.0 and y 0.0
set workEditor's snap's point to a cad vector2 with x 1.0 and y 1.0
set ghostValues to the bim modification preview segments of workEditor in view false in testLayout with testCamera
check ghost case (((the length of ghostValues) = 1) and ((the absolute value of ((the item at 0 in ghostValues)'s first's x - 70.0)) < 1e-9)) named (the string form of "mirror ghost reflects real endpoints across the axis")
free ghostValues
set workEditor's tool to bim scale tool
set workEditor's moveBase to a cad vector2 with x 0.0 and y 0.0
set workEditor's modify's factor to 2.0
set workEditor's modify's copyMode to true
set workEditor's modify's typed to true
set ghostValues to the bim modification preview segments of workEditor in view false in testLayout with testCamera
check ghost case (((the length of ghostValues) = 1) and (((the item at 0 in ghostValues)'s first's y = 70.0) and ((the item at 0 in ghostValues)'s last's y = 30.0))) named (the string form of "scale copy ghost uses the explicit transform factor")
free ghostValues
set workEditor's tool to bim copy tool
set workEditor's snap's point to a cad vector2 with x 0.0 and y 0.0
set ghostValues to the bim modification preview segments of workEditor in view true in testLayout with testCamera
set withinView to (the length of ghostValues) > 0
loop ghostCursor from 0 to the length of ghostValues:
    set ghostValue to the item at ghostCursor in ghostValues
    if (((ghostValue's first's x < 101.0) or (ghostValue's first's x > 199.0)) or ((ghostValue's last's x < 101.0) or (ghostValue's last's x > 199.0))) or (((ghostValue's first's y < 1.0) or (ghostValue's first's y > 99.0)) or ((ghostValue's last's y < 1.0) or (ghostValue's last's y > 99.0))):
        set withinView to false
check ghost case withinView named (the string form of "3D ghost input stays inside its own viewport")
free ghostValues
set retainedGrid to the item at 0 in (modelPointer's grids's values)
check ghost case ((modelPointer's nextId = sourceId) and (((the length of (modelPointer's grids's values)) = 1) and ((retainedGrid's start's x = 0.0) and (retainedGrid's start's y = -1.0)))) named (the string form of "previews never add or move source geometry")
check ghost case ((the length of (workEditor's documentValue's undoStack's values)) = undoCount) named (the string form of "previews never create an undo transaction")

set stretchEditor to a new bim editor
set stretchTarget to the address of (stretchEditor's documentValue's current)
set stretchId to add bim line on stretchEditor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 2.0 and y 0.0) to stretchTarget
select bim editor bim sketch picked numbered stretchId in (the address of stretchEditor)
set stretchEditor's tool to bim stretch tool
set stretchEditor's moveStage to 3
set stretchEditor's solidCorner to a cad vector2 with x 1.5 and y -0.5
set stretchEditor's solidReach to a cad vector2 with x 2.5 and y 0.5
set stretchEditor's moveBase to a cad vector2 with x 0.0 and y 0.0
set stretchEditor's snap's point to a cad vector2 with x 1.0 and y 1.0
set stretchNextId to stretchTarget's nextId
set stretchRevision to stretchEditor's documentValue's revision
set stretchUndo to the length of (stretchEditor's documentValue's undoStack's values)
set stretchRedo to the length of (stretchEditor's documentValue's redoStack's values)
set ghostValues to the bim modification preview segments of stretchEditor in view false in testLayout with testCamera
check ghost case ((the length of ghostValues) = 5) named (the string form of "stretch shows one control wire and four selection box edges")
set firstGhost to the item at 0 in ghostValues
check ghost case ((the cad distance from firstGhost's first to (a cad vector2 with x 50.0 and y 50.0)) < 1e-9) named (the string form of "stretch endpoint outside box stays stationary")
check ghost case ((the cad distance from firstGhost's last to (a cad vector2 with x 80.0 and y 40.0)) < 1e-9) named (the string form of "stretch endpoint inside box follows displacement")
check ghost case (the item at 1 in ghostValues)'s gridStyle named (the string form of "stretch selection guide uses dashed strokes")
free ghostValues
set ghostValues to the bim modification preview segments of stretchEditor in view true in testLayout with testCamera
set withinView to (the length of ghostValues) > 0
loop ghostCursor from 0 to the length of ghostValues:
    set ghostValue to the item at ghostCursor in ghostValues
    if (((ghostValue's first's x < 101.0) or (ghostValue's first's x > 199.0)) or ((ghostValue's last's x < 101.0) or (ghostValue's last's x > 199.0))) or (((ghostValue's first's y < 1.0) or (ghostValue's first's y > 99.0)) or ((ghostValue's last's y < 1.0) or (ghostValue's last's y > 99.0))):
        set withinView to false
check ghost case withinView named (the string form of "stretch wires and guide stay in the 3D viewport")
free ghostValues
set retainedLine to the item at (the bim sketch index of stretchId in stretchEditor's documentValue's current)'s position in (stretchTarget's sketches's values)
check ghost case (((the item at 0 in (retainedLine's points's values))'s x = 0.0) and (((the item at 1 in (retainedLine's points's values))'s x = 2.0) and ((the item at 1 in (retainedLine's points's values))'s y = 0.0))) named (the string form of "stretch ghost leaves both source endpoints unchanged")
check ghost case ((stretchTarget's nextId = stretchNextId) and ((stretchEditor's documentValue's revision = stretchRevision) and (((the length of (stretchEditor's documentValue's undoStack's values)) = stretchUndo) and ((the length of (stretchEditor's documentValue's redoStack's values)) = stretchRedo)))) named (the string form of "stretch ghost preserves source revision undo and redo")
select bim editor bim nothing picked numbered (the bim refused id) in (the address of stretchEditor)
set stretchEditor's moveStage to 1
set ghostValues to the bim modification preview segments of stretchEditor in view false in testLayout with testCamera
check ghost case ((the length of ghostValues) = 4) named (the string form of "stretch box guide appears before there is a selection")
free ghostValues
