# SPDX-License-Identifier: MPL-2.0
# Explicit mark labels survive generated type names and property edits.
import formats/bim_file.dl

function check annotation text {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS ") + label) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set frameType to add bim opening type named (the string form of "Frame") sized 1.766 by 1.229 with sill 1.171 and frame 0.0 to target
append (@intrinsic("construct", a bim opening record, 99 as a 64 bit integer, frameType, 98 as a 64 bit integer, 1.0)) to (modelValue's openings's values)
set original to the bim tag text of (99 as a 64 bit integer) in modelValue
set bim property (the string form of "Text") of set (the string form of "OpenBIM_Annotation") of (99 as a 64 bit integer) to (the string form of "C") typed (the string form of "IfcLabel") in target
name bim types by the rules in target
check annotation text ((the bim tag text of (99 as a 64 bit integer) in modelValue) = (the string form of "C")) named (the string form of "mark survives type naming")
set bim property (the string form of "Text") of set (the string form of "OpenBIM_Annotation") of (99 as a 64 bit integer) to (the string form of "C1") typed (the string form of "IfcLabel") in target
check annotation text ((the bim tag text of (99 as a 64 bit integer) in modelValue) = (the string form of "C1")) named (the string form of "property edit changes label")
set bim property (the string form of "Text") of set (the string form of "OpenBIM_Annotation") of (99 as a 64 bit integer) to (the string form of "") typed (the string form of "IfcLabel") in target
check annotation text ((the bim tag text of (99 as a 64 bit integer) in modelValue) = original) named (the string form of "empty override restores type label")
