# SPDX-License-Identifier: MPL-2.0
# Room separation lines (2460): a 6 x 4 m room of 200 mm walls is one
# space; a separator drawn across it at x = 3 splits it in two, each ending
# at the line as at a wall, and the line is no bounding wall. A plain line
# drawn the same way does not split it. Undo takes the separator back.
import ui/editor/bim_editor.dl

function click bim separation test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        refresh bim editor editor
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.01 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function show bim separation test spaces of {bim editor record:editor} labelled {a string:caption}:
    execute:
        set modelValue to editor's documentValue's current
        set found to the bim spaces of modelValue on level editor's levelId using (the bim join index of modelValue)
        set summary to (caption + (the string form of ": ")) + (the string form of (the length of (found's values)))
        loop cursor from 0 to the length of (found's values):
            set spaceValue to the item at cursor in (found's values)
            set squareDecimetres to ((spaceValue's area * 100.0) + 0.5) as an integer
            set summary to ((summary + (the string form of " ")) + (the string form of squareDecimetres)) + (the string form of " dm2")
            set summary to (summary + (the string form of " walls ")) + (the string form of (the length of (spaceValue's boundingWalls's values)))
        print summary as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.2)) to layers
set wallType to add bim wall type named (the string form of "Test 200") with layers to target
free layers
ignore add bim wall typed wallType on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
ignore add bim wall typed wallType on editor's levelId from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 6.0 and y 4.0) to target
ignore add bim wall typed wallType on editor's levelId from (a cad vector2 with x 6.0 and y 4.0) to (a cad vector2 with x 0.0 and y 4.0) to target
ignore add bim wall typed wallType on editor's levelId from (a cad vector2 with x 0.0 and y 4.0) to (a cad vector2 with x 0.0 and y 0.0) to target
commit bim transaction in (the address of (editor's documentValue))
show bim separation test spaces of editor labelled (the string form of "walls only")
# A plain line across: still one room.
begin bim transaction in (the address of (editor's documentValue))
set plainLine to add bim line on editor's levelId from (a cad vector2 with x 2.0 and y 0.1) to (a cad vector2 with x 2.0 and y 3.9) to target
commit bim transaction in (the address of (editor's documentValue))
show bim separation test spaces of editor labelled (the string form of "a plain line")
# The separator, drawn with the tool from wall face to wall face.
type bim editor key 2460 in e
print editor's message as a line
click bim separation test at 3.0 and 0.1 in e
click bim separation test at 3.0 and 3.9 in e
print editor's message as a line
type bim editor key bim escape key code in e
show bim separation test spaces of editor labelled (the string form of "with a separator")
type bim editor key 90 in e
show bim separation test spaces of editor labelled (the string form of "undone")
