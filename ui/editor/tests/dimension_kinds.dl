# SPDX-License-Identifier: MPL-2.0
# The dimension tools by kind, with the click flow of Open 2D Studio: a
# linear dimension (DL) between two wall ends measures horizontally or
# vertically by the way the ends lie; a chain (DH) adds a dimension on the
# line of the first with every further click, each one undo step, until
# Enter. A dimension is selected by a click on its line; the handle on the
# line's middle drags the line, a handle on an end drags that end onto
# another feature, Delete removes it, and each is one undo step. Linear
# dimensions survive .bim and .ifcx with their axis.
import ui/editor/bim_editor.dl

function click dimension kinds at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

# Presses at (x, y) and lets go at (towardX, towardY).
function drag dimension kinds from {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} to {a 64 bit floating-point number:towardX} and {a 64 bit floating-point number:towardY} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        move bim editor pointer to (a cad vector2 with x towardX and y towardY) within 0.1 in editor
        release bim editor pointer in editor

function list dimension kinds of {bim model record:modelValue} labelled {a string:heading}:
    execute:
        print heading as a line
        set index to the bim join index of modelValue
        loop cursor from 0 to the length of (modelValue's dimensions's values):
            set dimensionValue to the item at cursor in (modelValue's dimensions's values)
            set shape to the bim dimension line of dimensionValue in modelValue using index
            set line to (the string form of "  ") + (the string form of shape's valid)
            set line to (line + (the string form of " ")) + (the bim millimetre text of shape's value)
            set line to (line + (the string form of " from ")) + ((the bim millimetre text of shape's start's x) + ((the string form of ",") + (the bim millimetre text of shape's start's y)))
            set line to (line + (the string form of " to ")) + ((the bim millimetre text of shape's finish's x) + ((the string form of ",") + (the bim millimetre text of shape's finish's y)))
            print line as a line

set editor to a new bim editor
set e to the address of editor
# Four separate walls: two parallel 4 m apart, one upright east of them and
# one in line with the first.
begin bim transaction in (the address of (editor's documentValue))
set target to the address of (editor's documentValue's current)
ignore add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
ignore add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 0.0 and y 4.0) to (a cad vector2 with x 6.0 and y 4.0) to target
ignore add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 8.0 and y 1.0) to (a cad vector2 with x 8.0 and y 7.0) to target
ignore add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 9.0 and y 0.0) to (a cad vector2 with x 12.0 and y 0.0) to target
commit bim transaction in (the address of (editor's documentValue))
refresh bim editor e

# The keys: each kind its own command.
print ((the string form of "DI ") + (the string form of (the bim two letter command of 68 then 73))) as a line
print ((the string form of "DL ") + (the string form of (the bim two letter command of 68 then 76))) as a line
print ((the string form of "DA ") + (the string form of (the bim two letter command of 68 then 65))) as a line
print ((the string form of "DR ") + (the string form of (the bim two letter command of 68 then 82))) as a line
print ((the string form of "DD ") + (the string form of (the bim two letter command of 68 then 68))) as a line
print ((the string form of "DH ") + (the string form of (the bim two letter command of 68 then 72))) as a line
type bim editor key 2061 in e
print editor's message as a line

# Linear: from the first wall's start to the second wall's finish, further
# apart across than up, so horizontal, its line 1 m below.
type bim editor key 2060 in e
print editor's message as a line
click dimension kinds at 0.0 and 0.0 in e
print editor's message as a line
click dimension kinds at 6.0 and 4.0 in e
print editor's message as a line
click dimension kinds at 3.0 and -1.0 in e
print editor's message as a line
# From the first wall's finish to the upright wall's finish: vertical, its
# line at x = 9.5.
click dimension kinds at 6.0 and 0.0 in e
click dimension kinds at 8.0 and 7.0 in e
click dimension kinds at 9.5 and 3.0 in e
print editor's message as a line
# Aligned between the same two ends as the first: point to point.
type bim editor key 2015 in e
click dimension kinds at 0.0 and 0.0 in e
click dimension kinds at 6.0 and 4.0 in e
click dimension kinds at 2.0 and 3.0 in e
print editor's message as a line
list dimension kinds of editor's documentValue's current labelled (the string form of "linear and aligned:")

# A chain along the first wall, its line 1.5 m below: every further click
# adds a dimension on that line, also to an end that lies off it.
type bim editor key 2064 in e
print editor's message as a line
click dimension kinds at 0.0 and 0.0 in e
click dimension kinds at 6.0 and 0.0 in e
click dimension kinds at 3.0 and -1.5 in e
print editor's message as a line
click dimension kinds at 8.0 and 1.0 in e
print editor's message as a line
click dimension kinds at 9.0 and 0.0 in e
click dimension kinds at 12.0 and 0.0 in e
print editor's message as a line
# Nothing there: the chain waits.
click dimension kinds at 14.0 and -3.0 in e
print editor's message as a line
list dimension kinds of editor's documentValue's current labelled (the string form of "with the chain:")
# Enter ends the chain; one undo takes its last dimension only.
type bim editor key bim enter key code in e
print editor's message as a line
print ((the string form of "stage ") + (the string form of editor's moveStage)) as a line
ignore undo bim transaction in (the address of (editor's documentValue))
print ((the string form of "after one undo: ") + (the string form of (the length of (editor's documentValue's current's dimensions's values)))) as a line
ignore redo bim transaction in (the address of (editor's documentValue))

# Selecting: a click on the horizontal dimension's line.
type bim editor key bim escape key code in e
click dimension kinds at 2.0 and -1.0 in e
print ((the string form of "selected a dimension: ") + (the string form of (editor's selectionKind = bim dimension picked))) as a line
print editor's message as a line
set chosenId to editor's selectionId
set spots to the bim dimension handles of chosenId in editor
print ((the string form of "handles ") + (the string form of (the length of (spots's values)))) as a line
# The line's middle handle dragged 1.2 m further down.
drag dimension kinds from 3.0 and -1.0 to 3.0 and -2.2 in e
print editor's message as a line
list dimension kinds of editor's documentValue's current labelled (the string form of "line dragged:")
ignore undo bim transaction in (the address of (editor's documentValue))
list dimension kinds of editor's documentValue's current labelled (the string form of "one undo:")
# A press on the handle let go where it stood changes nothing.
set stepsBefore to the length of (editor's documentValue's undoStack's values)
click dimension kinds at 3.0 and -1.0 in e
print ((the string form of "a click on a handle is no step: ") + (the string form of ((the length of (editor's documentValue's undoStack's values)) = stepsBefore))) as a line
# Its finish handle dragged onto the far end of the wall in line: the
# dimension measures to that end.
drag dimension kinds from 6.0 and -1.0 to 12.0 and 0.0 in e
print editor's message as a line
list dimension kinds of editor's documentValue's current labelled (the string form of "end dragged:")
# Dragged to where no feature is, it stays.
drag dimension kinds from 12.0 and -1.0 to 14.0 and -3.0 in e
list dimension kinds of editor's documentValue's current labelled (the string form of "end dragged to nothing:")
set reread to the bim model parsed from (the bim file text of editor's documentValue's current)
list dimension kinds of reread's modelValue labelled (the string form of "from .bim:")
set native to the bim native text of ifcx (the bim ifcx text of editor's documentValue's current identified as (the string form of "k.ifcx") for project (the string form of "k") by (the string form of "test") at (the string form of "2026-11-28T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
list dimension kinds of fromIfcx's modelValue labelled (the string form of "from .ifcx:")
# Delete removes the selected dimension; undo brings it back.
set countBefore to the length of (editor's documentValue's current's dimensions's values)
type bim editor key bim delete key code in e
print editor's message as a line
print ((the string form of "deleted one: ") + (the string form of ((the length of (editor's documentValue's current's dimensions's values)) = (countBefore - 1)))) as a line
print ((the string form of "nothing selected: ") + (the string form of (editor's selectionKind = bim nothing picked))) as a line
ignore undo bim transaction in (the address of (editor's documentValue))
print ((the string form of "undo restores it: ") + (the string form of ((the bim dimension index of chosenId in editor's documentValue's current)'s valid))) as a line
