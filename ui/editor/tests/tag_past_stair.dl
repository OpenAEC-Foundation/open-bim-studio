# SPDX-License-Identifier: MPL-2.0
# A window's tag stands clear of a stair beside its wall.
#
# A wall along x 9 from y 0 to 7 with a window at its middle (y 3.5). Its
# tag stands beside the wall on the inner side. A stair is then put along
# the wall where the tag stood, 4 m long around the window's middle: the
# tag now stands along the wall past the stair's end, the shortest way
# that clears the flight (its lettering 125 mm high: 2.25 m along the
# wall), and no further from the wall than before.
import ui/editor/bim_editor.dl

function check tag stair {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
        else:
            print ((the string form of "PASS: ") + label) as a line

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.16)) to layerValues
set wallType to add bim wall type named (the string form of "CLT 160") with layerValues to target
set eastWall to add bim wall typed wallType on editor's levelId from (a cad vector2 with x 9.0 and y 0.0) to (a cad vector2 with x 9.0 and y 7.0) to target
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
set windowId to add bim opening typed windowType in eastWall at 3.5 to target
refresh bim editor (the address of editor)
set freePlace to the bim tag place of opening windowId in editor
print ((the string form of "without a stair, along the wall (mm): ") + (the bim millimetre text of freePlace's y)) as a line
ignore (add bim stair on editor's levelId from (a cad vector2 with x freePlace's x and y 1.5) to (a cad vector2 with x freePlace's x and y 5.5) wide 1.0 in 17 risers of (the string form of "timber") to target)
refresh bim editor (the address of editor)
set clearPlace to the bim tag place of opening windowId in editor
print ((the string form of "beside a stair, along the wall (mm): ") + (the bim millimetre text of clearPlace's y)) as a line
check tag stair (bim lettering at freePlace reaching 0.9 by 0.125 covers a stair on level editor's levelId in editor's documentValue's current) named (the string form of "the stair lies where the tag stood")
check tag stair ((bim lettering at clearPlace reaching 0.9 by 0.125 covers a stair on level editor's levelId in editor's documentValue's current) = false) named (the string form of "the tag stands clear of the stair")
check tag stair ((the absolute value of (clearPlace's x - freePlace's x)) < 0.000001) named (the string form of "as far from the wall as before")
check tag stair ((the absolute value of ((the absolute value of (clearPlace's y - freePlace's y)) - 2.25)) < 0.000001) named (the string form of "2.25 m along the wall")
# The same beside an opening in the floor: a floor with a stairwell 1.2 m
# wide from y 2 to 5 where the tag stood; the tag stands along the wall
# clear of the opening.
set wellEditor to a new bim editor
set wellTarget to the address of (wellEditor's documentValue's current)
set wellWallType to add bim wall type named (the string form of "CLT 160") with layerValues to wellTarget
set wellWall to add bim wall typed wellWallType on wellEditor's levelId from (a cad vector2 with x 9.0 and y 0.0) to (a cad vector2 with x 9.0 and y 7.0) to wellTarget
set wellWindowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to wellTarget
set wellWindow to add bim opening typed wellWindowType in wellWall at 3.5 to wellTarget
set floorType to add bim planar type named (the string form of "Floor") as role bim floor planar role with layerValues to wellTarget
set floorCorners to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to floorCorners
append (a cad vector2 with x 9.0 and y 0.0) to floorCorners
append (a cad vector2 with x 9.0 and y 7.0) to floorCorners
append (a cad vector2 with x 0.0 and y 7.0) to floorCorners
set floorId to add bim plate typed floorType on wellEditor's levelId around floorCorners at top 0.0 to wellTarget
set wellCorners to an empty list of a cad vector2
append (a cad vector2 with x (freePlace's x - 0.6) and y 2.0) to wellCorners
append (a cad vector2 with x (freePlace's x + 0.6) and y 2.0) to wellCorners
append (a cad vector2 with x (freePlace's x + 0.6) and y 5.0) to wellCorners
append (a cad vector2 with x (freePlace's x - 0.6) and y 5.0) to wellCorners
print ((the string form of "stairwell added: ") + (the string form of ((add bim plate opening on floorId around wellCorners in wellTarget) = 1))) as a line
refresh bim editor (the address of wellEditor)
set wellPlace to the bim tag place of opening wellWindow in wellEditor
print ((the string form of "beside a stairwell, along the wall (mm): ") + (the bim millimetre text of wellPlace's y)) as a line
check tag stair ((bim lettering at wellPlace reaching 0.9 by 0.125 covers a stair on level wellEditor's levelId in wellEditor's documentValue's current) = false) named (the string form of "the tag stands clear of the stairwell")
