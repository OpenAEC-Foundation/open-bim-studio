# SPDX-License-Identifier: MPL-2.0
# Issue #85: the editor's binary save/open path retains the complete gallery,
# including all nine reusable types and ten applied connections.
import ui/editor/bim_editor.dl
import structural/steel/bim_connection_gallery.dl

function check binary gallery {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set gallery to the bim connection gallery
check binary gallery ((the length of (gallery's connectionTypes's values)) = 9) named (the string form of "the source has nine reusable connection types")
check binary gallery ((the length of (gallery's connections's values)) = 10) named (the string form of "the source has ten applied connections")
set original to the bim file text of gallery
set editor to a new bim editor
load bim editor from text original named (the string form of "Connection gallery") in (the address of editor)
check binary gallery ((the bim file text of editor's documentValue's current) = original) named (the string form of "the gallery opens in the editor")

set binaryPath to the string form of "build/connection-gallery-binary.ifcxb"
save bim editor to binaryPath in (the address of editor)
check binary gallery (editor's message = ((the string form of "Saved ") + binaryPath)) named (the string form of "the editor saves the gallery as binary IFCX")
set stored to the bim file content at binaryPath
set compressed to false
if stored's valid:
    if (the length of stored's text) >= 2:
        set firstByte to ((the character at 0 in stored's text) as a 32 bit integer) bitwise and 255
        set secondByte to ((the character at 1 in stored's text) as a 32 bit integer) bitwise and 255
        set compressed to (firstByte = 31) and (secondByte = 139)
check binary gallery compressed named (the string form of "the file is gzip compressed")
set unpacked to the bim uncompressed content at binaryPath
check binary gallery (unpacked's valid and (bim content unpacked's text is binary ifcx)) named (the string form of "the payload is binary CBOR rather than JSON")

set reopened to a new bim editor
open bim editor from binaryPath in (the address of reopened)
check binary gallery (reopened's message = ((the string form of "Opened ") + binaryPath)) named (the string form of "the editor reopens the binary file")
check binary gallery ((the length of (reopened's documentValue's current's connectionTypes's values)) = 9) named (the string form of "all nine reusable connection types survive")
check binary gallery ((the length of (reopened's documentValue's current's connections's values)) = 10) named (the string form of "all ten applied connections survive")
check binary gallery ((the bim file text of reopened's documentValue's current) = original) named (the string form of "the complete reopened native model equals the original")
