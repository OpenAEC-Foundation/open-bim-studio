# SPDX-License-Identifier: MPL-2.0
# Instance placements cannot represent a reflection of asymmetric geometry.
import ui/editor/bim_editor.dl

function check mirror instance {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set editor to a new bim editor
set editTarget to the address of editor
set modelTarget to the address of (editor's documentValue's current)
set componentId to add bim component named (the string form of "Asymmetric triangular prism") to modelTarget
set triangle to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to triangle
append (a cad vector2 with x 3.0 and y 0.0) to triangle
append (a cad vector2 with x 0.0 and y 1.0) to triangle
ignore add bim solid of kind bim extrusion solid as bim add operation at (a cad vector3 with x 0.0, y 0.0 and z 0.0) sized (a cad vector3 with x 1.0, y 1.0 and z 1.0) turned 0.0 along triangle of (the string form of "timber") to component componentId in modelTarget
free triangle
set instanceId to place bim component componentId on editor's levelId at (a cad vector2 with x 4.0 and y 2.0) turned 0.3 to modelTarget
set lineId to add bim line on editor's levelId from (a cad vector2 with x 10.0 and y 0.0) to (a cad vector2 with x 11.0 and y 0.0) to modelTarget
# Keep a real redo snapshot to detect accidental commits even on a refusal.
begin bim transaction in (the address of (editor's documentValue))
ignore add bim line on editor's levelId from (a cad vector2 with x 20.0 and y 0.0) to (a cad vector2 with x 21.0 and y 0.0) to modelTarget
commit bim transaction in (the address of (editor's documentValue))
ignore undo bim transaction in (the address of (editor's documentValue))
set beforeRevision to editor's documentValue's revision
set beforeUndo to the length of (editor's documentValue's undoStack's values)
set beforeRedo to the length of (editor's documentValue's redoStack's values)
set beforeId to editor's documentValue's current's nextId
set mirrorChange to the bim mirror transform from (a cad vector2 with x 0.0 and y 0.0) through (a cad vector2 with x 0.0 and y 1.0)
select bim editor bim instance picked numbered instanceId in editTarget
check mirror instance ((copy bim editor selection changed by mirrorChange in editTarget) = 0) named (the string form of "asymmetric instance mirror copy is refused")
check mirror instance ((the index of (the string form of "component instances") in editor's message) >= 0) named (the string form of "mirror refusal explains unsupported instance reflection")
check mirror instance ((editor's selectionId = instanceId) and (editor's selectionKind = bim instance picked)) named (the string form of "refusal preserves the selected instance")
# The supported native element is first, exposing a partial-loop mutation.
select bim editor bim sketch picked numbered lineId in editTarget
append instanceId to (editor's chosenSketches's values)
check mirror instance ((copy bim editor selection changed by mirrorChange in editTarget) = 0) named (the string form of "mixed mirror copy refuses the whole selection")
begin bim transaction in (the address of (editor's documentValue))
check mirror instance ((place bim editor selection by mirrorChange in editTarget) = false) named (the string form of "mixed in-place mirror refuses before changing native geometry")
check mirror instance ((copy bim editor selection changed by mirrorChange committing false in editTarget) = 0) named (the string form of "caller-owned mirror copy also refuses atomically")
check mirror instance ((the length of (editor's documentValue's undoStack's values)) = (beforeUndo + 1)) named (the string form of "refusal leaves the caller transaction open without nesting")
roll back bim transaction in (the address of (editor's documentValue))
set originalLine to the item at 0 in (editor's documentValue's current's sketches's values)
set originalInstance to the item at 0 in (editor's documentValue's current's instances's values)
check mirror instance (((the item at 0 in (originalLine's points's values))'s x = 10.0) and ((originalInstance's origin's x = 4.0) and (originalInstance's angle = 0.3))) named (the string form of "refused mirror preserves real line and instance placement")
check mirror instance (((editor's documentValue's revision = beforeRevision) and (editor's documentValue's current's nextId = beforeId)) and (((the length of (editor's documentValue's undoStack's values)) = beforeUndo) and ((the length of (editor's documentValue's redoStack's values)) = beforeRedo))) named (the string form of "refused mirrors preserve revision ids undo and redo")
loop mode from 0 to 2:
    set editor's tool to bim mirror tool
    set editor's moveStage to 2
    set editor's moveBase to a cad vector2 with x 0.0 and y 0.0
    set editor's snap to the bim snap (a cad vector2 with x 0.0 and y 4.0) labelled "Free"
    set editor's modify's copyMode to mode = 1
    set previews to the bim modify preview changes of editor
    check mirror instance ((the length of previews) = 0) named ((the string form of "invalid mixed mirror ghost is hidden ") + (the string form of mode))
    free previews
    press bim editor pointer in editTarget
    check mirror instance (((the index of (the string form of "Mirror refused") in editor's message) >= 0) and ((editor's tool = bim mirror tool) and (editor's moveStage = 2))) named ((the string form of "UI mirror reports refusal without completing a false edit ") + (the string form of mode))
check mirror instance (((editor's documentValue's revision = beforeRevision) and (editor's documentValue's current's nextId = beforeId)) and (((the length of (editor's documentValue's undoStack's values)) = beforeUndo) and ((the length of (editor's documentValue's redoStack's values)) = beforeRedo))) named (the string form of "UI mirror refusal does not create no-op history or copies")
check mirror instance ((editor's selectionId = lineId) and ((the length of (editor's chosenSketches's values)) = 2)) named (the string form of "UI mirror refusal retains the complete mixed selection")
set editor's tool to bim select tool
set editor's moveStage to 0
set editor's modify's copyMode to false
check mirror instance ((copy bim editor selection changed by (the bim shift transform by (a cad vector2 with x 2.0 and y 3.0)) in editTarget) = 2) named (the string form of "ordinary mixed copy still supports instances")
set shiftedInstance to the item at 1 in (editor's documentValue's current's instances's values)
check mirror instance ((shiftedInstance's componentId = componentId) and ((shiftedInstance's origin's x = 6.0) and (shiftedInstance's origin's y = 5.0))) named (the string form of "ordinary copy preserves the component and exact displacement")
ignore undo bim transaction in (the address of (editor's documentValue))
select bim editor bim instance picked numbered instanceId in editTarget
set quarterTurn to 3.141592653589793 * 0.5
check mirror instance ((copy bim editor selection changed by (the bim turn transform about (a cad vector2 with x 0.0 and y 0.0) by quarterTurn) in editTarget) = 1) named (the string form of "rotated instance copy remains supported")
set rotatedInstance to the item at 1 in (editor's documentValue's current's instances's values)
check mirror instance ((the absolute value of (rotatedInstance's angle - (0.3 + quarterTurn))) < 1e-9) named (the string form of "rotated copy retains representable placement angle")
ignore undo bim transaction in (the address of (editor's documentValue))
begin bim transaction in (the address of (editor's documentValue))
check mirror instance (place bim editor selection by (the bim shift transform by (a cad vector2 with x 1.0 and y 0.0)) in editTarget) named (the string form of "in-place instance move remains supported")
commit bim transaction in (the address of (editor's documentValue))
check mirror instance ((the item at 0 in (editor's documentValue's current's instances's values))'s origin's x = 5.0) named (the string form of "in-place move changes the real instance origin")
ignore undo bim transaction in (the address of (editor's documentValue))
set editor's tool to bim array tool
set editor's moveStage to 2
set editor's moveBase to a cad vector2 with x 0.0 and y 0.0
set editor's snap to the bim snap (a cad vector2 with x 6.0 and y 0.0) labelled "Free"
set editor's modify's count to 3
set editor's modify's radial to false
check mirror instance (apply bim editor array in editTarget) named (the string form of "instance array remains supported")
check mirror instance ((the length of (editor's documentValue's current's instances's values)) = 3) named (the string form of "instance array creates the requested real copies")
