# SPDX-License-Identifier: MPL-2.0
# A wall is made longer or shorter in the plan by an end handle: with the
# wall selected, a press on one of its ends drags that end along the
# wall's own axis, so the wall keeps its direction; a wall joined at that
# end goes along, the wall stays at least 0.1 m long, and the drag is one
# undo step.
import ui/editor/bim_editor.dl

function check wall end drag {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the wall end drag ends of {a 64 bit integer:wallId} in {bim editor record:editor}:
    execute:
        set found to the bim wall index of wallId in editor's documentValue's current
        set wallValue to the item at found's position in (editor's documentValue's current's walls's values)
        return ((((the string form of "(") + (the string form of wallValue's start's x)) + ((the string form of ", ") + (the string form of wallValue's start's y))) + ((the string form of ") to (") + (the string form of wallValue's finish's x))) + (((the string form of ", ") + (the string form of wallValue's finish's y)) + (the string form of ")"))

function the wall end drag wall {a 64 bit integer:wallId} in {bim editor record:editor}:
    execute:
        set found to the bim wall index of wallId in editor's documentValue's current
        return the item at found's position in (editor's documentValue's current's walls's values)

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set typeId to editor's wallTypeId
# A wall along x from (0, 0) to (4, 0), and a second one joined at its
# finish, running up from (4, 0) to (4, 3).
set alongWall to add bim wall typed typeId on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to target
set upWall to add bim wall typed typeId on editor's levelId from (a cad vector2 with x 4.0 and y 0.0) to (a cad vector2 with x 4.0 and y 3.0) to target
refresh bim editor e
select bim editor bim wall picked numbered alongWall in e

# Its start dragged out to (-2, 0.4): the wall grows along its axis to 6 m.
move bim editor pointer to (a cad vector2 with x 0.0 and y 0.0) within 0.08 in e
press bim editor pointer in e
check wall end drag (editor's axisDragWallId = alongWall) named (the string form of "a press on the selected wall's end takes that end")
move bim editor pointer to (a cad vector2 with x -1.0 and y 0.2) within 0.08 in e
move bim editor pointer to (a cad vector2 with x -2.0 and y 0.4) within 0.08 in e
release bim editor pointer in e
print (the wall end drag ends of alongWall in editor) as a line
print editor's message as a line
set grown to the wall end drag wall alongWall in editor
check wall end drag (((the absolute value of (grown's start's x + 2.0)) < 0.06) and ((the absolute value of grown's start's y) < 1e-9)) named (the string form of "the start moves along the axis, not across")
check wall end drag ((the absolute value of (grown's finish's x - 4.0)) < 1e-9) named (the string form of "the other end stays")

# Its finish, where the second wall joins, dragged to (5, 0): the joined
# wall's start goes along, so the join holds.
select bim editor bim wall picked numbered alongWall in e
move bim editor pointer to (a cad vector2 with x 4.0 and y 0.0) within 0.08 in e
press bim editor pointer in e
move bim editor pointer to (a cad vector2 with x 4.5 and y -0.3) within 0.08 in e
move bim editor pointer to (a cad vector2 with x 5.0 and y -0.6) within 0.08 in e
release bim editor pointer in e
print (the wall end drag ends of alongWall in editor) as a line
print (the wall end drag ends of upWall in editor) as a line
set extended to the wall end drag wall alongWall in editor
set joined to the wall end drag wall upWall in editor
check wall end drag (((the absolute value of (extended's finish's x - 5.0)) < 0.06) and ((the cad distance from extended's finish to joined's start) < 1e-9)) named (the string form of "the joined wall goes along")

# Dragged past its other end: the wall keeps 0.1 m.
select bim editor bim wall picked numbered alongWall in e
set startNow to (the wall end drag wall alongWall in editor)'s start
move bim editor pointer to startNow within 0.08 in e
press bim editor pointer in e
move bim editor pointer to (a cad vector2 with x 3.0 and y 0.0) within 0.08 in e
move bim editor pointer to (a cad vector2 with x 9.0 and y 0.0) within 0.08 in e
release bim editor pointer in e
set shortest to the wall end drag wall alongWall in editor
check wall end drag ((the absolute value of ((the cad distance from shortest's start to shortest's finish) - 0.1)) < 1e-6) named (the string form of "the wall stays at least 0.1 m long")

# One undo step brings the shortening back.
ignore undo bim transaction in (the address of (editor's documentValue))
print (the wall end drag ends of alongWall in editor) as a line
check wall end drag ((the absolute value of ((the wall end drag wall alongWall in editor)'s start's x + 2.0)) < 0.06) named (the string form of "undo restores the start")
