# SPDX-License-Identifier: MPL-2.0
# Extension and parallel snapping, as in CAD: past the end of a line, the
# pointer snaps onto the line's extension; drawing from a point, it snaps
# onto the direction of a line within reach.
import ui/editor/bim_editor.dl

function show bim snap of {a pointer to a bim editor record:editor} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        set buffer to a new string buffer containing 64 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 4, the data of buffer, 65 as a word sized unsigned integer, "%.3f %.3f", editor's snap's point's x, editor's snap's point's y)
        print ((editor's snap's label + (the string form of " at ")) + (the substring of buffer from 0 spanning written bytes)) as a line

function click bim snap test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

set editor to a new bim editor
set e to the address of editor
# A sloping line from (0, 0) to (4, 1).
type bim editor key 78 in e
click bim snap test at 0.0 and 0.0 in e
click bim snap test at 4.0 and 1.0 in e
type bim editor key bim enter key code in e
# Past its end, near its line: on the extension.
show bim snap of e at 6.0 and 1.52
# Off the line: the grid.
show bim snap of e at 6.0 and 2.0
# A new line from (0, 2): toward (4, 3) it runs parallel to the first.
click bim snap test at 0.0 and 2.0 in e
show bim snap of e at 4.02 and 3.0
