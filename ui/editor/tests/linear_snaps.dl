# SPDX-License-Identifier: MPL-2.0
# The ends and middle of a beam and the point of a column are object snaps,
# so a move goes from and to them; the selection carried by a move is no
# snap for itself.
import ui/editor/bim_editor_core.dl

function check linear snap {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set editor's levelId to ground
set editor's snapRefused to 0
set beamType to add bim linear type named (the string form of "Beam 200x200") as role bim beam role sized 0.2 by 0.2 round false of (the string form of "steel") to target
set columnType to add bim linear type named (the string form of "Column 200x200") as role bim column role sized 0.2 by 0.2 round false of (the string form of "steel") to target
set beamId to add bim linear typed beamType on ground from (a cad vector3 with x 1.0, y 2.0 and z 2.8) to (a cad vector3 with x 5.0, y 2.0 and z 2.8) turned 0.0 to target
set otherId to add bim linear typed beamType on ground from (a cad vector3 with x 8.0, y 0.0 and z 2.8) to (a cad vector3 with x 8.0, y 6.0 and z 2.8) turned 0.0 to target
set columnId to add bim linear typed columnType on ground from (a cad vector3 with x 12.0, y 3.0 and z 0.0) to (a cad vector3 with x 12.0, y 3.0 and z 3.0) turned 0.0 to target

set snapped to the bim snap of (a cad vector2 with x 1.04 and y 2.03) in editor within 0.1
check linear snap ((snapped's label = (the string form of "End point")) and ((the cad distance from snapped's point to (a cad vector2 with x 1.0 and y 2.0)) < 1e-9)) named (the string form of "a beam's end is an end point snap")
set snapped to the bim snap of (a cad vector2 with x 3.03 and y 1.97) in editor within 0.1
check linear snap ((snapped's label = (the string form of "Mid point")) and ((the cad distance from snapped's point to (a cad vector2 with x 3.0 and y 2.0)) < 1e-9)) named (the string form of "a beam's middle is a mid point snap")
set snapped to the bim snap of (a cad vector2 with x 12.04 and y 3.03) in editor within 0.1
check linear snap ((the cad distance from snapped's point to (a cad vector2 with x 12.0 and y 3.0)) < 1e-9) named (the string form of "a column's point is a snap")

# Move: the base point snaps on the selected beam's own end; while the move
# carries the beam, its own ends are no snap but another beam's are.
set editor's selectionKind to bim linear picked
set editor's selectionId to beamId
set editor's tool to bim move tool
set editor's moveStage to 1
set snapped to the bim snap of (a cad vector2 with x 5.03 and y 2.04) in editor within 0.1
check linear snap ((snapped's label = (the string form of "End point")) and ((the cad distance from snapped's point to (a cad vector2 with x 5.0 and y 2.0)) < 1e-9)) named (the string form of "the base point of a move snaps to the selected beam's end")
set editor's moveBase to a cad vector2 with x 5.0 and y 2.0
set editor's moveStage to 2
set snapped to the bim snap of (a cad vector2 with x 1.04 and y 2.03) in editor within 0.1
check linear snap ((snapped's label != (the string form of "End point")) or ((the cad distance from snapped's point to (a cad vector2 with x 1.0 and y 2.0)) > 1e-6)) named (the string form of "a beam carried by a move does not catch on its own end")
set snapped to the bim snap of (a cad vector2 with x 8.03 and y 5.96) in editor within 0.1
check linear snap ((snapped's label = (the string form of "End point")) and ((the cad distance from snapped's point to (a cad vector2 with x 8.0 and y 6.0)) < 1e-9)) named (the string form of "the destination of a move snaps to another beam's end")
