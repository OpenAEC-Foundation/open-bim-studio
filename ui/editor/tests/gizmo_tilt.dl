# SPDX-License-Identifier: MPL-2.0
# The 3D gizmo lifts and tilts the selection (#137). A wall whose top is held
# at the level above rises as a whole on the Z arrow, its height kept, and
# holds its top again when the lift comes back to nothing; two linear
# elements selected together both rise. The X ring leans a wall about its
# own line; its Y ring is refused. A roof pitches about its Y axis, a linear
# element rolls about its own axis and turns about its level Y axis. The
# placement the properties show reads the same values and, typed, does
# what the gizmo does.
import ui/editor/bim_editor.dl

function the gizmo test millimetres of {a 64 bit floating-point number:metres}:
    execute:
        return the string form of ((the floor of ((metres * 1000.0) + 0.5)) as an integer)

function the gizmo test degrees of {a 64 bit floating-point number:radians}:
    execute:
        return the string form of ((the floor of (((radians * 180.0) / 3.141592653589793) + 0.5)) as an integer)

function show gizmo test wall {a 64 bit integer:wallId} of {bim model record:modelValue} labelled {a string:label}:
    execute:
        set found to the bim wall index of wallId in modelValue
        set wallValue to the item at found's position in (modelValue's walls's values)
        set held to wallValue's topLevelId != the bim refused id
        set footText to (the string form of ": base ") + (the gizmo test millimetres of wallValue's baseOffset)
        set heightText to (the string form of ", height ") + (the gizmo test millimetres of wallValue's height)
        set leanText to (the string form of ", lean ") + (the gizmo test millimetres of wallValue's lean)
        print ((label + footText) + ((heightText + leanText) + ((the string form of ", top held ") + (the string form of held)))) as a line

function show gizmo test linear {a 64 bit integer:linearId} of {bim model record:modelValue} labelled {a string:label}:
    execute:
        set found to the bim linear index of linearId in modelValue
        set member to the item at found's position in (modelValue's linears's values)
        set startText to (the gizmo test millimetres of member's start's x) + ((the string form of ",") + (the gizmo test millimetres of member's start's z))
        set finishText to (the gizmo test millimetres of member's finish's x) + ((the string form of ",") + (the gizmo test millimetres of member's finish's z))
        print ((label + (the string form of ": ")) + ((startText + (the string form of " -> ")) + ((finishText + (the string form of ", roll ")) + (the gizmo test degrees of member's angle)))) as a line

function show gizmo test placement of {bim editor record:editor} labelled {a string:label}:
    execute:
        set shownPlacement to the bim selection placement of editor
        set located to (the gizmo test millimetres of shownPlacement's position's x) + ((the string form of ",") + ((the gizmo test millimetres of shownPlacement's position's y) + ((the string form of ",") + (the gizmo test millimetres of shownPlacement's position's z))))
        set turned to (the gizmo test degrees of shownPlacement's rotation's x) + ((the string form of ",") + ((the gizmo test degrees of shownPlacement's rotation's y) + ((the string form of ",") + (the gizmo test degrees of shownPlacement's rotation's z))))
        print ((label + (the string form of ": at ")) + ((located + (the string form of " turned ")) + ((turned + (the string form of ", editable ")) + (the string form of shownPlacement's editable)))) as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set radian to 3.141592653589793 / 180.0
begin bim transaction in (the address of (editor's documentValue))
set upperId to add bim level named (the string form of "Upper") at 3.0 with height 3.0 to target
set wallType to (the item at 0 in (target's wallTypes's values))'s id
set wallId to add bim wall typed wallType on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to target
ignore (hold bim wall wallId top at level upperId in target)
commit bim transaction in (the address of (editor's documentValue))
select bim editor bim wall picked numbered wallId in e
show gizmo test wall wallId of editor's documentValue's current labelled (the string form of "held wall")

# The Z arrow: the wall rises as a whole; back to nothing, it holds again.
begin bim editor gizmo drag in e
drag bim editor gizmo by (a cad vector2 with x 0.0 and y 0.0) lifting 0.5 turning 0.0 about (a cad vector2 with x 0.0 and y 0.0) in e
show gizmo test wall wallId of editor's documentValue's current labelled (the string form of "lifted 0.5 m")
drag bim editor gizmo by (a cad vector2 with x 0.0 and y 0.0) lifting 0.0 turning 0.0 about (a cad vector2 with x 0.0 and y 0.0) in e
show gizmo test wall wallId of editor's documentValue's current labelled (the string form of "lifted back")
drag bim editor gizmo by (a cad vector2 with x 0.0 and y 0.0) lifting 0.3 turning 0.0 about (a cad vector2 with x 0.0 and y 0.0) in e
finish bim editor gizmo drag in e
show gizmo test wall wallId of editor's documentValue's current labelled (the string form of "kept at 0.3 m")
ignore undo bim transaction in (the address of (editor's documentValue))
show gizmo test wall wallId of editor's documentValue's current labelled (the string form of "undone")

# The X ring leans the wall about its own line; its Y ring is refused.
set wallFrame to the bim object frame of editor
print ((the string form of "wall tilt axes ") + (the string form of (the bim tilt axes of editor))) as a line
begin bim editor gizmo drag in e
drag bim editor gizmo tilting (10.0 * radian) about wallFrame's xAxis through wallFrame's origin in e
print editor's message as a line
finish bim editor gizmo drag in e
show gizmo test wall wallId of editor's documentValue's current labelled (the string form of "X ring 10 deg")
begin bim editor gizmo drag in e
drag bim editor gizmo tilting (10.0 * radian) about wallFrame's yAxis through wallFrame's origin in e
print editor's message as a line
finish bim editor gizmo drag in e
show gizmo test wall wallId of editor's documentValue's current labelled (the string form of "Y ring refused")
show gizmo test placement of editor labelled (the string form of "wall placement")

# Typed as the properties do: up 1 m, turned to face north, leaning 5 deg.
print ((the string form of "typed Z: ") + (the string form of (set bim editor placement 2 to 1.0 in e))) as a line
print ((the string form of "typed turn Z: ") + (the string form of (set bim editor placement 5 to (90.0 * radian) in e))) as a line
print ((the string form of "typed turn X: ") + (the string form of (set bim editor placement 3 to (5.0 * radian) in e))) as a line
print ((the string form of "typed turn Y: ") + (the string form of (set bim editor placement 4 to (5.0 * radian) in e))) as a line
show gizmo test placement of editor labelled (the string form of "wall typed")
show gizmo test wall wallId of editor's documentValue's current labelled (the string form of "wall typed")

# A roof pitches about its Y axis, its outline kept.
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.2)) to layers
begin bim transaction in (the address of (editor's documentValue))
set roofType to add bim planar type named (the string form of "Roof") as role bim roof planar role with layers to target
set outline to an empty list of a cad vector2
append (a cad vector2 with x 10.0 and y 0.0) to outline
append (a cad vector2 with x 14.0 and y 0.0) to outline
append (a cad vector2 with x 14.0 and y 4.0) to outline
append (a cad vector2 with x 10.0 and y 4.0) to outline
set roofId to add bim plate typed roofType on editor's levelId around outline at top 3.0 to target
commit bim transaction in (the address of (editor's documentValue))
select bim editor bim slab picked numbered roofId in e
set roofFrame to the bim object frame of editor
begin bim editor gizmo drag in e
drag bim editor gizmo tilting (-20.0 * radian) about roofFrame's yAxis through roofFrame's origin in e
finish bim editor gizmo drag in e
show gizmo test placement of editor labelled (the string form of "roof Y ring -20 deg")
print ((the string form of "typed roof turn Y: ") + (the string form of (set bim editor placement 4 to (-30.0 * radian) in e))) as a line
set roofValue to the item at (the bim slab index of roofId in editor's documentValue's current)'s position in (editor's documentValue's current's slabs's values)
print ((the string form of "roof pitch ") + ((the gizmo test degrees of roofValue's pitch) + ((the string form of ", heading ") + ((the gizmo test degrees of roofValue's heading) + ((the string form of ", top ") + (the gizmo test millimetres of roofValue's top)))))) as a line

# Two linear elements chosen together both rise on the Z arrow; one rolls
# about its own axis on the X ring and, typed, turns about its level Y axis.
begin bim transaction in (the address of (editor's documentValue))
set beamType to add bim linear type named (the string form of "Beam") as role (bim beam role) sized 0.2 by 0.4 round false of (the string form of "steel") to target
set firstBeam to add bim linear typed beamType on editor's levelId from (a cad vector3 with x 0.0, y 6.0 and z 2.0) to (a cad vector3 with x 4.0, y 6.0 and z 2.0) turned 0.0 to target
set secondBeam to add bim linear typed beamType on editor's levelId from (a cad vector3 with x 0.0, y 8.0 and z 2.0) to (a cad vector3 with x 4.0, y 8.0 and z 2.0) turned 0.0 to target
commit bim transaction in (the address of (editor's documentValue))
select bim editor bim linear picked numbered firstBeam in e
set editor's extending to true
select bim editor bim linear picked numbered secondBeam in e
set editor's extending to false
begin bim editor gizmo drag in e
drag bim editor gizmo by (a cad vector2 with x 0.0 and y 0.0) lifting 0.25 turning 0.0 about (a cad vector2 with x 0.0 and y 0.0) in e
finish bim editor gizmo drag in e
show gizmo test linear firstBeam of editor's documentValue's current labelled (the string form of "first beam lifted")
show gizmo test linear secondBeam of editor's documentValue's current labelled (the string form of "second beam lifted")
select bim editor bim linear picked numbered firstBeam in e
set beamFrame to the bim object frame of editor
begin bim editor gizmo drag in e
drag bim editor gizmo tilting (15.0 * radian) about beamFrame's xAxis through beamFrame's origin in e
finish bim editor gizmo drag in e
show gizmo test linear firstBeam of editor's documentValue's current labelled (the string form of "X ring rolls 15 deg")
print ((the string form of "typed beam turn Y: ") + (the string form of (set bim editor placement 4 to (-30.0 * radian) in e))) as a line
show gizmo test linear firstBeam of editor's documentValue's current labelled (the string form of "beam turned -30 deg about Y, rising")
show gizmo test placement of editor labelled (the string form of "beam placement")
