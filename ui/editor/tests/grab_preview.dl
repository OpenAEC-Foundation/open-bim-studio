import ui/editor/bim_editor_core.dl

function check grab preview {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set editorValue to a new bim editor
set editTarget to the address of editorValue
set modelTarget to the address of (editorValue's documentValue's current)
set zeroMove to a cad vector2 with x 0.0 and y 0.0
set oneMove to a cad vector2 with x 1.0 and y 0.0
set gridId to add bim grid named (the string form of "A") from zeroMove to (a cad vector2 with x 0.0 and y 5.0) reaching 0.0 to 3.0 to modelTarget
set editorValue's editKind to bim grid picked
set editorValue's editSketchId to gridId
append 1 to (editorValue's editPicked's values)
start bim editor grab in editTarget
set initialRevision to editorValue's documentValue's revision
apply bim editor grab by zeroMove lifting 0.0 in editTarget
check grab preview (editorValue's documentValue's revision = initialRevision) named (the string form of "unchanged handles do not invalidate the scene")
apply bim editor grab by oneMove lifting 0.0 in editTarget
set movedRevision to editorValue's documentValue's revision
loop sample from 0 to 100:
    apply bim editor grab by oneMove lifting 0.0 in editTarget
check grab preview (editorValue's documentValue's revision = movedRevision) named (the string form of "one hundred repeated handle previews do not rebuild")
finish bim editor grab in editTarget
ignore undo bim transaction in (the address of (editorValue's documentValue))
check grab preview ((the item at 0 in (modelTarget's grids's values))'s finish's x = 0.0) named (the string form of "undo restores the moved handle")

set outline to an empty list of a cad vector2
append zeroMove to outline
append (a cad vector2 with x 4.0 and y 0.0) to outline
append (a cad vector2 with x 4.0 and y 3.0) to outline
append (a cad vector2 with x 0.0 and y 3.0) to outline
set faceId to add bim face on editorValue's levelId around outline to modelTarget
free outline
ignore set bim face faceId height to 2.0 in modelTarget
set editorValue's editKind to bim sketch picked
set editorValue's editSketchId to faceId
start bim editor grab in editTarget
apply bim editor grab by zeroMove lifting 1.0 in editTarget
set liftedRevision to editorValue's documentValue's revision
apply bim editor grab by zeroMove lifting 1.0 in editTarget
check grab preview (editorValue's documentValue's revision = liftedRevision) named (the string form of "repeated solid height preview keeps the same revision")
apply bim editor grab by zeroMove lifting 0.0 in editTarget
check grab preview ((the item at (the bim sketch index of faceId in editorValue's documentValue's current)'s position in (modelTarget's sketches's values))'s height = 2.0) named (the string form of "returning the lift to zero restores the original height")
apply bim editor grab by oneMove lifting 0.0 in editTarget
set faceRevision to editorValue's documentValue's revision
apply bim editor grab by oneMove lifting 0.0 in editTarget
check grab preview (editorValue's documentValue's revision = faceRevision) named (the string form of "repeated sketch point preview keeps the same revision")
type bim editor grab key bim escape key code in editTarget
check grab preview ((the item at 1 in ((the item at (the bim sketch index of faceId in editorValue's documentValue's current)'s position in (modelTarget's sketches's values))'s points's values))'s x = 4.0) named (the string form of "cancel restores the sketch points")

set meshId to make bim mesh of mass faceId in modelTarget
set editorValue's editKind to bim mesh picked
set editorValue's editMesh to true
set editorValue's editSketchId to meshId
start bim editor grab in editTarget
apply bim editor grab by oneMove lifting 0.0 in editTarget
set meshRevision to editorValue's documentValue's revision
apply bim editor grab by oneMove lifting 0.0 in editTarget
check grab preview (editorValue's documentValue's revision = meshRevision) named (the string form of "repeated mesh point preview keeps the same revision")
type bim editor grab key bim escape key code in editTarget
check grab preview (editorValue's grabbing = false) named (the string form of "mesh grab can still be cancelled")
