# SPDX-License-Identifier: MPL-2.0
# Placing a building system vertical, horizontal or tilted. The Building
# System tool's floating toolbar offers Vertical (2370), Horizontal (2371)
# and Tilted (2372), the orientation it places in lit. Horizontal sketches
# the outline on the plan: a 4 x 5 m rectangle becomes a 4 m line 5 m deep
# with no contour, an L-shape its bounding 6 x 4 m with a 6-corner contour.
# Tilted takes a typed pitch (from level, as a roof's), the line and the
# side it rises to: at a pitch of 60 degrees a click 2 m to the side rises
# 4 m up the slope; a click on the right turns the line round; a typed
# length sets the slope. A floor recipe chosen with no orientation places
# level by line and side, as the recipe lies; Vertical chosen first keeps
# it upright. Create similar keeps the source's tilt. The properties show
# the orientation (a click takes the next), the pitch and the base, and a
# typed pitch sets the tilt. Fit takes in a tilted system's face.
import ui/shell/bim_app_parts.dl
import views/schedules/bim_query.dl

function check orientation placement {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the placement test text of {a 64 bit floating-point number:value}:
    execute:
        set shown to value
        if (the absolute value of shown) < 0.0005:
            set shown to 0.0
        return the bim query printed shown to 3 decimals

# The toolbar as one line: its title, its buttons (the lit one starred).
function show orientation toolbar of {bim editor record:editor}:
    execute:
        set buttons to the bim floating toolbar buttons of editor
        set chosen to the bim floating toolbar choice of editor
        set shown to (the bim floating toolbar title of editor) + (the string form of ":")
        if (the length of buttons) = 0:
            set shown to the string form of "(hidden)"
        loop cursor from 0 to the length of buttons:
            set button to the item at cursor in buttons
            set shown to (shown + (the string form of " ")) + button's label
            if button's command = chosen:
                set shown to shown + (the string form of "*")
        free buttons
        print shown as a line

# The selected building system: its line, height, orientation settings and
# contour corners.
function show placed system of {bim editor record:editor} labelled {a string:title}:
    execute:
        set modelValue to editor's documentValue's current
        set found to the bim curtain index of editor's selectionId in modelValue
        if found's valid = false:
            print (title + (the string form of ": no system selected")) as a line
            return nothing
        set placedValue to the item at found's position in (modelValue's curtains's values)
        set described to (title + (the string form of ": line ")) + ((the placement test text of placedValue's start's x) + ((the string form of " ") + (the placement test text of placedValue's start's y)))
        set described to (described + (the string form of " -> ")) + ((the placement test text of placedValue's finish's x) + ((the string form of " ") + (the placement test text of placedValue's finish's y)))
        set described to (described + (the string form of " height ")) + (the placement test text of placedValue's height)
        set chosenReading to the bim setting (bim system orientation setting) of placedValue's id in modelValue
        set chosenText to the string form of "-"
        if chosenReading's found:
            set chosenText to the string form of chosenReading's value
        set described to (described + (the string form of " orientation ")) + ((the string form of (the bim system orientation of placedValue's id in modelValue)) + ((the string form of " (set ") + (chosenText + (the string form of ")"))))
        set described to (described + (the string form of " tilt ")) + (the string form of (the bim setting (bim system tilt setting) of placedValue's id in modelValue)'s value)
        set baseReading to the bim setting (bim system level setting) of placedValue's id in modelValue
        set baseText to the string form of "-"
        if baseReading's found:
            set baseText to the string form of baseReading's value
        set described to (described + (the string form of " base ")) + baseText
        set contourCorners to the bim face contour of placedValue's id in modelValue
        set described to (described + (the string form of " contour ")) + (the string form of (the length of contourCorners))
        free contourCorners
        print described as a line

# The selection's rows about its orientation.
function show orientation rows of {bim editor record:editor}:
    execute:
        set rowList to the bim own property rows of editor
        loop cursor from 0 to the length of rowList:
            set rowItem to the item at cursor in rowList
            set wanted to (((rowItem's label = (the string form of "Orientation (click)")) or (rowItem's label = (the string form of "Pitch"))) or (rowItem's label = (the string form of "Base above storey"))) or (((rowItem's label = (the string form of "Height")) or (rowItem's label = (the string form of "Depth"))) or (rowItem's label = (the string form of "Length up slope")))
            if wanted:
                print ((the string form of "  ") + ((rowItem's label + (the string form of ": ")) + ((rowItem's value + (the string form of " #")) + (the string form of rowItem's code)))) as a line
        free rowList

function type placement digits {a string:digits} in {a pointer to a bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of digits:
            set character to the substring of digits from cursor spanning 1 bytes
            set code to 48
            loop digit from 0 to 10:
                if character = (the string form of (digit as a 64 bit integer)):
                    set code to 48 + digit
            if character = (the string form of "."):
                set code to 46
            type bim editor key code in editor

function sketch placement edge from {cad vector2:fromPoint} to {cad vector2:toPoint} in {a pointer to a bim editor record:editor}:
    execute:
        append (the bim boundary line from fromPoint to toPoint) to (editor's sketchSegments's values)

function the placement point {a 64 bit floating-point number:eastValue} {a 64 bit floating-point number:northValue}:
    execute:
        return a cad vector2 with x eastValue and y northValue

set editor to a new bim editor
set e to the address of editor

# The tool and its toolbar.
type bim editor key 2112 in e
show orientation toolbar of editor
check orientation placement ((editor's tool = bim curtain tool) and ((the bim floating toolbar choice of editor) = 2370)) named (the string form of "Building System offers Vertical, Horizontal and Tilted, Vertical lit")

# Horizontal: the outline sketched on the plan.
type bim editor key 2371 in e
show orientation toolbar of editor
check orientation placement ((bim editor sketches a new system editor) and (editor's sketchHostKind = 850)) named (the string form of "Horizontal opens a new system's sketch (host 850)")
check orientation placement ((bim editor sketches upright editor) = false) named (the string form of "the sketch lies on the plan, Pick walls and From space offered")
sketch placement edge from (the placement point 0.0 0.0) to (the placement point 4.0 0.0) in e
sketch placement edge from (the placement point 4.0 0.0) to (the placement point 4.0 5.0) in e
sketch placement edge from (the placement point 4.0 5.0) to (the placement point 0.0 5.0) in e
sketch placement edge from (the placement point 0.0 5.0) to (the placement point 0.0 0.0) in e
type bim editor key 258 in e
print editor's message as a line
show placed system of editor labelled (the string form of "4 x 5 rectangle")
check orientation placement ((bim editor sketches a boundary editor) = false) named (the string form of "Tab closes the sketch")

type bim editor key 2371 in e
sketch placement edge from (the placement point 10.0 0.0) to (the placement point 16.0 0.0) in e
sketch placement edge from (the placement point 16.0 0.0) to (the placement point 16.0 2.0) in e
sketch placement edge from (the placement point 16.0 2.0) to (the placement point 13.0 2.0) in e
sketch placement edge from (the placement point 13.0 2.0) to (the placement point 13.0 4.0) in e
sketch placement edge from (the placement point 13.0 4.0) to (the placement point 10.0 4.0) in e
sketch placement edge from (the placement point 10.0 4.0) to (the placement point 10.0 0.0) in e
type bim editor key 258 in e
show placed system of editor labelled (the string form of "L-shape")

# An open outline is refused and the sketch stays.
type bim editor key 2371 in e
sketch placement edge from (the placement point 20.0 0.0) to (the placement point 24.0 0.0) in e
sketch placement edge from (the placement point 24.0 0.0) to (the placement point 24.0 3.0) in e
type bim editor key 258 in e
check orientation placement (bim editor sketches a new system editor) named (the string form of "an open outline keeps the sketch open")
type bim editor key 2520 in e
check orientation placement ((bim editor sketches a new system editor) and ((editor's systemTypeIndex = 20) and ((the length of (editor's sketchSegments's values)) = 2))) named (the string form of "a recipe chosen in the sketch keeps it and its lines")
type bim editor key 2371 in e
check orientation placement ((the length of (editor's sketchSegments's values)) = 2) named (the string form of "Horizontal again keeps the sketch as it is")
type bim editor key 2372 in e
check orientation placement (((bim editor sketches a boundary editor) = false) and (editor's tool = bim curtain tool)) named (the string form of "Tilted leaves the sketch for the tool")

# Tilted: the pitch typed, the line, the side.
show orientation toolbar of editor
print editor's message as a line
type placement digits (the string form of "60") in e
type bim editor key (bim enter key code) in e
print editor's message as a line
check orientation placement (editor's systemTilt = (30000 as a 64 bit integer)) named (the string form of "a typed pitch of 60 degrees is a tilt of 30 from upright")
place bim editor curtain at (the placement point 0.0 10.0) in e
place bim editor curtain at (the placement point 6.0 10.0) in e
print editor's message as a line
place bim editor curtain at (the placement point 0.0 12.0) in e
show placed system of editor labelled (the string form of "tilted, side to the left")
place bim editor curtain at (the placement point 0.0 20.0) in e
place bim editor curtain at (the placement point 6.0 20.0) in e
place bim editor curtain at (the placement point 0.0 18.0) in e
show placed system of editor labelled (the string form of "tilted, side to the right")
place bim editor curtain at (the placement point 0.0 30.0) in e
place bim editor curtain at (the placement point 6.0 30.0) in e
type placement digits (the string form of "5") in e
type bim editor key (bim enter key code) in e
show placed system of editor labelled (the string form of "tilted, 5 m typed")
set tiltedId to editor's selectionId

# The properties of the tilted system: the orientation, its pitch and base.
show orientation rows of editor
start bim editor property 12811 in e
set editor's propertyText to the string form of "30"
apply bim editor property in e
show placed system of editor labelled (the string form of "pitch 30 typed")
start bim editor property 12812 in e
set editor's propertyText to the string form of "0.5"
apply bim editor property in e
show orientation rows of editor
start bim editor property 12810 in e
print editor's message as a line
start bim editor property 12810 in e
print editor's message as a line
show orientation rows of editor
start bim editor property 12810 in e
print editor's message as a line
show placed system of editor labelled (the string form of "cycled back to tilted")

# Create similar of the tilted system.
select bim editor bim curtain picked numbered tiltedId in e
type bim editor key 2001 in e
show orientation toolbar of editor
place bim editor curtain at (the placement point 0.0 40.0) in e
place bim editor curtain at (the placement point 6.0 40.0) in e
place bim editor curtain at (the placement point 0.0 41.0) in e
show placed system of editor labelled (the string form of "similar to the tilted")
type bim editor key (bim escape key code) in e

# A floor recipe with no orientation chosen lies level, as before, by its
# line and the side it spans to; Vertical chosen first keeps it upright.
type bim editor key (bim escape key code) in e
type bim editor key 2515 in e
show orientation toolbar of editor
check orientation placement ((editor's tool = bim curtain tool) and ((the bim floating toolbar choice of editor) = 2371)) named (the string form of "a floor recipe draws with the tool, Horizontal lit")
place bim editor curtain at (the placement point 0.0 50.0) in e
place bim editor curtain at (the placement point 4.0 50.0) in e
place bim editor curtain at (the placement point 1.0 53.0) in e
show placed system of editor labelled (the string form of "floor recipe")
type bim editor key 2370 in e
type bim editor key 2515 in e
check orientation placement ((editor's tool = bim curtain tool) and ((the bim floating toolbar choice of editor) = 2370)) named (the string form of "Vertical chosen, the floor recipe keeps it")
place bim editor curtain at (the placement point 0.0 60.0) in e
place bim editor curtain at (the placement point 4.0 60.0) in e
show placed system of editor labelled (the string form of "floor recipe, vertical")
type bim editor key (bim escape key code) in e
type bim editor key 2112 in e
check orientation placement (((the bim floating toolbar choice of editor) = 2371) and (editor's systemOrientation = -1)) named (the string form of "Building System forgets the orientation chosen and follows the last recipe again")

# Fit takes in a tilted system's face: 4 m along, 3 m up a slope of 60
# degrees, its top 1.5 m to the left and 2.598 m up.
set fitEditor to a new bim editor
set fitTarget to the address of (fitEditor's documentValue's current)
set fitLevel to the item at (the bim level index of fitEditor's levelId in fitEditor's documentValue's current)'s position in (fitEditor's documentValue's current's levels's values)
set fitLayout to @intrinsic("construct", a bim screen layout record, 1200.0, 800.0, 0.0, 600.0, 100.0, 750.0)
set fitCamera to @intrinsic("construct", a bim camera record, (a cad vector2 with x 100.0 and y 100.0), 1.0, 0.5, 0.5, (a cad vector3 with x 100.0, y 100.0 and z 100.0), 1.0)
set slopeId to add bim curtain wall on fitEditor's levelId from (the placement point 0.0 0.0) to (the placement point 4.0 0.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "aluminium") to fitTarget
ignore (set bim system slopeId orientation (bim tilted orientation) tilted (30000 as a 64 bit integer) based (0 as a 64 bit integer) in fitTarget)
set slopeFit to the bim camera fitting fitEditor in fitLayout keeping fitCamera
print ((the string form of "tilted fit target: ") + ((the placement test text of slopeFit's target's x) + ((the string form of " ") + ((the placement test text of slopeFit's target's y) + ((the string form of " ") + (the placement test text of (slopeFit's target's z - fitLevel's elevation))))))) as a line
