# SPDX-License-Identifier: MPL-2.0
# The sketch's closed shapes (#89): a circle (two half arcs), an ellipse
# with turned axes (four elliptic quarters) and a rectangle (four lines),
# each made into a floor through the new-plate sketch of #101.
import ui/editor/bim_editor.dl

function check sketch shapes {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function click sketch shapes at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.001 in editor
        press bim editor boundary sketch in editor

function the sketch shapes area of {bim editor record:editor}:
    execute:
        set made to the item at (the bim slab index of editor's selectionId in editor's documentValue's current)'s position in (editor's documentValue's current's slabs's values)
        return the absolute value of (the bim signed area of (made's outline's values))

set editor to a new bim editor
set e to the address of editor
# A circle of radius 2 m.
type bim editor key 66 in e
type bim editor boundary key 67 in e
check sketch shapes (editor's sketchTool = bim sketch circle tool) named (the string form of "C chooses the circle")
click sketch shapes at 10.0 and 10.0 in e
click sketch shapes at 12.0 and 10.0 in e
check sketch shapes ((the length of (editor's sketchSegments's values)) = 2) named (the string form of "a circle is two half arcs")
type bim editor key 258 in e
check sketch shapes ((editor's selectionKind = bim slab picked) and ((the absolute value of ((the sketch shapes area of editor) - 12.566)) < 0.05)) named (the string form of "Tab makes a round floor of about pi r squared")
# An ellipse with axes 3 m and 1 m, turned (points on the 5 cm snap grid).
select bim editor bim nothing picked numbered (the bim refused id) in e
type bim editor key 66 in e
type bim editor boundary key 69 in e
click sketch shapes at 0.0 and 0.0 in e
click sketch shapes at 1.8 and 2.4 in e
click sketch shapes at -0.8 and 0.6 in e
check sketch shapes ((the length of (editor's sketchSegments's values)) = 4) named (the string form of "an ellipse is four quarters")
set quarter to the item at 0 in (editor's sketchSegments's values)
check sketch shapes quarter's elliptic named (the string form of "its segments are elliptic")
type bim editor key 258 in e
check sketch shapes ((the absolute value of ((the sketch shapes area of editor) - 9.4248)) < 0.05) named (the string form of "Tab makes an elliptic floor of about pi a b")
check sketch shapes (editor's message = (the string form of "Floor made: 0 lines, 4 curves")) named (the string form of "the message counts the quarters as curves")
# A rectangle 4 by 3.
select bim editor bim nothing picked numbered (the bim refused id) in e
type bim editor key 66 in e
type bim editor boundary key 82 in e
click sketch shapes at 20.0 and 0.0 in e
click sketch shapes at 24.0 and 3.0 in e
check sketch shapes ((the length of (editor's sketchSegments's values)) = 4) named (the string form of "a rectangle is four lines")
type bim editor key 258 in e
check sketch shapes ((the absolute value of ((the sketch shapes area of editor) - 12.0)) < 1e-6) named (the string form of "Tab makes a 12 square metre floor")
