# SPDX-License-Identifier: MPL-2.0
# Whole-system selection, Create similar and temporary Shift constraints.
import ui/editor/bim_editor.dl

function check system interaction {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set editor to a new bim editor
set ep to the address of editor
set target to the address of (editor's documentValue's current)
set sourceId to add bim curtain wall on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) rising 2.8 in bays of 0.22 by 0.0625 of (the string form of "mortar") to target
set brickType to the bim example type named (the string form of "Interaction brick") of (the string form of "brick") 0.1 in target
shape bim example system sourceId patterned (bim running bond pattern) joints 10 by 90 celled true of type brickType in target
set layerId to add bim layer to system sourceId offset (120 as a 64 bit integer) in target
set child to the item at (the bim curtain index of layerId in editor's documentValue's current)'s position in (target's curtains's values)
set child's material to the string form of "timber"
set child's bayWidth to 0.4
set child's rowHeight to 0.6
replace item at index (the bim curtain index of layerId in editor's documentValue's current)'s position in (target's curtains's values) with child
set original to the bim file text of editor's documentValue's current
set baselineUndo to the length of (editor's documentValue's undoStack's values)
select bim editor bim nothing picked numbered (the bim refused id) in ep
pick bim editor system sourceId seen at (a cad vector3 with x 0.1, y 0.0 and z 1.03) in ep
check system interaction ((editor's selectionId = sourceId) and (editor's partCode = -1)) named (the string form of "the first click selects the whole building system")
pick bim editor system sourceId seen at (a cad vector3 with x 0.1, y 0.0 and z 1.03) in ep
check system interaction ((editor's selectionId = sourceId) and (editor's partCode >= 0)) named (the string form of "another click selects its generated part")
type bim editor key (bim escape key code) in ep
check system interaction ((editor's selectionId = sourceId) and (editor's partCode = -1)) named (the string form of "Escape returns to the whole system")
select bim editor bim nothing picked numbered (the bim refused id) in ep
pick bim editor system layerId seen at (a cad vector3 with x 0.1, y 0.12 and z 1.03) in ep
check system interaction ((editor's selectionId = sourceId) and (editor's partCode = -1)) named (the string form of "a layer first selects its complete carrier")
pick bim editor system layerId seen at (a cad vector3 with x 0.1, y 0.12 and z 1.03) in ep
type bim editor key (bim escape key code) in ep
check system interaction ((editor's selectionId = sourceId) and (editor's partCode = -1)) named (the string form of "Escape from a layer part returns to its carrier")
check system interaction (((the bim file text of editor's documentValue's current) = original) and ((the length of (editor's documentValue's undoStack's values)) = baselineUndo)) named (the string form of "selection does not change model data or history")
check system interaction ((the bim two letter command of 67 then 83) = 2001) named (the string form of "CS resolves to Create similar")
type bim editor key 2001 in ep
check system interaction ((editor's tool = bim curtain tool) and (editor's similarSystemId = sourceId)) named (the string form of "Create similar starts the building system tool")
check system interaction (((the bim file text of editor's documentValue's current) = original) and ((the length of (editor's documentValue's undoStack's values)) = baselineUndo)) named (the string form of "Create similar prepares placement without editing the source")
place bim editor curtain at (a cad vector2 with x 10.0 and y 0.0) in ep
place bim editor curtain at (a cad vector2 with x 14.0 and y 0.0) in ep
set freshId to editor's selectionId
set fresh to the item at (the bim curtain index of freshId in editor's documentValue's current)'s position in (target's curtains's values)
check system interaction ((freshId != sourceId) and ((fresh's height = 2.8) and ((fresh's bayWidth = 0.22) and ((fresh's rowHeight = 0.0625) and (fresh's material = (the string form of "mortar")))))) named (the string form of "a similar system keeps custom dimensions and material")
check system interaction (((the bim pattern of system freshId in editor's documentValue's current) = bim running bond pattern) and ((the bim panel type of panel -1 of system freshId in editor's documentValue's current) = brickType)) named (the string form of "a similar system keeps its bond and panel type")
set copiedLayers to 0
loop cursor from 0 to the length of (target's curtains's values):
    set candidate to the item at cursor in (target's curtains's values)
    set host to the bim setting (bim layer host setting) of candidate's id in editor's documentValue's current
    if host's found and (host's value = freshId):
        if (candidate's material = (the string form of "timber")) and ((candidate's bayWidth = 0.4) and (candidate's rowHeight = 0.6)):
            set copiedLayers to copiedLayers + 1
check system interaction ((copiedLayers = 1) and ((the length of (editor's documentValue's undoStack's values)) = (baselineUndo + 1))) named (the string form of "its layers are new instances in the same undo step")
ignore undo bim transaction in (the address of (editor's documentValue))
check system interaction ((the bim file text of editor's documentValue's current) = original) named (the string form of "one undo restores the original system and its layers")
ignore redo bim transaction in (the address of (editor's documentValue))
type bim editor key (bim escape key code) in ep
check system interaction (editor's similarSystemId = the bim refused id) named (the string form of "Escape clears the pending similar definition")
set editor's tool to bim curtain tool
set editor's moveStage to 1
set editor's solidCorner to a cad vector2 with x 30.0 and y 30.0
set editor's orthoOn to false
set editor's orthoHeld to true
set snapped to the bim snap of (a cad vector2 with x 37.0 and y 32.0) in editor within 0.01
check system interaction ((the absolute value of (snapped's point's y - 30.0)) < 0.000001) named (the string form of "Shift constrains building system placement from its first point")
set editor's orthoHeld to false
set released to the bim snap of (a cad vector2 with x 37.0 and y 32.0) in editor within 0.01
check system interaction (((the absolute value of (released's point's y - 32.0)) < 0.000001) and (editor's orthoOn = false)) named (the string form of "releasing Shift restores free placement without changing F8")
prepare bim editor views in ep
set extent to the bim plan extent of editor's documentValue's current
set selectedElevations to 0
loop cursor from 0 to the length of (target's views's values):
    set viewValue to the item at cursor in (target's views's values)
    if (viewValue's kind = bim model view) and (viewValue's detail > (0 as a 64 bit integer)):
        set mark to the bim elevation mark of (viewValue's detail as an integer) around extent
        select bim editor element at mark in ep
        if editor's propertiesViewId = viewValue's id:
            set selectedElevations to selectedElevations + 1
check system interaction (selectedElevations = 4) named (the string form of "all four elevation marks select their view properties")
