import ui/editor/bim_editor_core.dl

function check element lock {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function the lock test grid {a 64 bit integer:gridId} of {bim editor record:editor}:
    execute:
        return the item at ((the bim grid index of gridId in editor's documentValue's current)'s position) in (editor's documentValue's current's grids's values)

set editor to a new bim editor
set e to the address of editor
set gridId to add bim grid named (the string form of "A") from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 10.0 and y 0.0) reaching -1.0 to 4.0 to (the address of (editor's documentValue's current))
set editor's selectionKind to bim grid picked
set editor's selectionId to gridId
check element lock ((bim editor selection is locked editor) = false) named (the string form of "a new element is not locked")

# Locked, the gizmo moves nothing and the selection says so.
keep bim editor selection locked true in e
check element lock (bim editor selection is locked editor) named (the string form of "PN locks the selection")
set undoBefore to the length of (editor's documentValue's undoStack's values)
begin bim editor gizmo drag in e
drag bim editor gizmo by (a cad vector2 with x 0.0 and y 2.0) lifting 0.0 turning 0.0 about (a cad vector2 with x 0.0 and y 0.0) in e
finish bim editor gizmo drag in e
check element lock ((the absolute value of ((the lock test grid gridId of editor)'s start's y)) < 1e-9) named (the string form of "a locked element keeps its place under the gizmo")
ignore undo bim transaction in (the address of (editor's documentValue))
check element lock (bim editor selection is locked editor) named (the string form of "undoing the refused move leaves the lock")

# Unlocked, it moves again.
keep bim editor selection locked false in e
check element lock ((bim editor selection is locked editor) = false) named (the string form of "UP unlocks the selection")
begin bim editor gizmo drag in e
drag bim editor gizmo by (a cad vector2 with x 0.0 and y 2.0) lifting 0.0 turning 0.0 about (a cad vector2 with x 0.0 and y 0.0) in e
finish bim editor gizmo drag in e
check element lock ((the absolute value of (((the lock test grid gridId of editor)'s start's y) - 2.0)) < 1e-9) named (the string form of "an unlocked element moves")

# The lock is one undoable edit.
keep bim editor selection locked true in e
ignore undo bim transaction in (the address of (editor's documentValue))
check element lock ((bim editor selection is locked editor) = false) named (the string form of "undo takes the lock off")
ignore redo bim transaction in (the address of (editor's documentValue))
check element lock (bim editor selection is locked editor) named (the string form of "redo puts it back")
