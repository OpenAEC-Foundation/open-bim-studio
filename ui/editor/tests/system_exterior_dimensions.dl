# SPDX-License-Identifier: MPL-2.0
# Exterior dimensions along building systems that stand as outer walls.
#
# Four curtain walls around 6 by 4 m with one across at x 2.6, no wall
# among them, and a window 1.2 m wide in the south one at 4.5 m along it.
# Annotate > Exterior dimensions (2461) gives each outer system its whole
# length to the outer faces of the systems that close its corners (the
# mullions are 150 mm deep: 6150 and 4150 mm), and the south one the chain
# of its opening's edges besides (the rough opening, 1340 mm with its
# frame): 3905, 1340 and 905 mm. The south and north ones also get the
# chain of the faces of the system across (at x 2.6, 150 mm deep): 2600,
# 150 and 3400 mm. The inner system gets none. The model
# reads back from its files. Pressed again nothing is doubled, and one
# undo takes the chains away.
import ui/editor/bim_editor.dl

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set south to add bim curtain wall on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
ignore (add bim curtain wall on editor's levelId from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 6.0 and y 4.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target)
ignore (add bim curtain wall on editor's levelId from (a cad vector2 with x 6.0 and y 4.0) to (a cad vector2 with x 0.0 and y 4.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target)
ignore (add bim curtain wall on editor's levelId from (a cad vector2 with x 0.0 and y 4.0) to (a cad vector2 with x 0.0 and y 0.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target)
ignore (add bim curtain wall on editor's levelId from (a cad vector2 with x 2.6 and y 0.0) to (a cad vector2 with x 2.6 and y 4.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target)
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.2 with sill 0.9 and frame 0.07 to target
ignore (add bim opening typed windowType in south at 4.5 to target)
commit bim transaction in (the address of (editor's documentValue))
type bim editor key 2461 in e
print editor's message as a line
set modelValue to editor's documentValue's current
set joinIndex to the bim join index of modelValue
set measureLine to the string form of "measures:"
loop cursor from 0 to the length of (modelValue's dimensions's values):
    set measured to the bim measure of (the item at cursor in (modelValue's dimensions's values)) in modelValue using joinIndex
    if measured's valid:
        set measureLine to (measureLine + (the string form of " ")) + (the bim length measured's value in units 0)
    else:
        set measureLine to measureLine + (the string form of " invalid")
print measureLine as a line
# The model with these chains reads back from .bim and from .ifcx.
set reread to the bim model parsed from (the bim file text of editor's documentValue's current)
print ((the string form of ".bim read: ") + ((the string form of reread's valid) + ((the string form of ", dimensions ") + (the string form of (the length of (reread's modelValue's dimensions's values)))))) as a line
set native to the bim native text of ifcx (the bim ifcx text of editor's documentValue's current identified as (the string form of "t.ifcx") for project (the string form of "t") by (the string form of "test") at (the string form of "2026-11-25T00:00:00Z"))
set fromIfcx to the bim model parsed from native's text
print ((the string form of ".ifcx read: ") + ((the string form of fromIfcx's valid) + ((the string form of ", dimensions ") + (the string form of (the length of (fromIfcx's modelValue's dimensions's values)))))) as a line
type bim editor key 2461 in e
print editor's message as a line
print ((the string form of "dimensions after pressing again: ") + (the string form of (the length of (editor's documentValue's current's dimensions's values)))) as a line
type bim editor key 90 in e
print ((the string form of "undone: ") + (the string form of (the length of (editor's documentValue's current's dimensions's values)))) as a line
# Grid heads in the way of the chains move out: two grids along x 0 and x
# 6 that end half a metre past the south and north systems are lengthened
# to 2.6 m past them (26 mm on paper at 1:100) when the chains are made,
# and the chain between the grids, made before, stands beyond their ends
# still.
set gridEditor to a new bim editor
set ge to the address of gridEditor
set gridTarget to the address of (gridEditor's documentValue's current)
begin bim transaction in (the address of (gridEditor's documentValue))
ignore (add bim grid named (the string form of "1") from (a cad vector2 with x 0.0 and y -0.5) to (a cad vector2 with x 0.0 and y 4.5) reaching 0.0 to 3.0 to gridTarget)
ignore (add bim grid named (the string form of "2") from (a cad vector2 with x 6.0 and y -0.5) to (a cad vector2 with x 6.0 and y 4.5) reaching 0.0 to 3.0 to gridTarget)
commit bim transaction in (the address of (gridEditor's documentValue))
type bim editor key 2461 in ge
print gridEditor's message as a line
begin bim transaction in (the address of (gridEditor's documentValue))
ignore (add bim curtain wall on gridEditor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to gridTarget)
ignore (add bim curtain wall on gridEditor's levelId from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 6.0 and y 4.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to gridTarget)
ignore (add bim curtain wall on gridEditor's levelId from (a cad vector2 with x 6.0 and y 4.0) to (a cad vector2 with x 0.0 and y 4.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to gridTarget)
ignore (add bim curtain wall on gridEditor's levelId from (a cad vector2 with x 0.0 and y 4.0) to (a cad vector2 with x 0.0 and y 0.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to gridTarget)
commit bim transaction in (the address of (gridEditor's documentValue))
type bim editor key 2461 in ge
print gridEditor's message as a line
loop gridCursor from 0 to the length of (gridEditor's documentValue's current's grids's values):
    set gridValue to the item at gridCursor in (gridEditor's documentValue's current's grids's values)
    set gridLine to ((the string form of "grid ") + gridValue's name) + (the string form of ": y ")
    set gridLine to (gridLine + (the bim millimetre text of gridValue's start's y)) + (the string form of " to ")
    print (gridLine + (the bim millimetre text of gridValue's finish's y)) as a line
loop cursor from 0 to the length of (gridEditor's documentValue's current's dimensions's values):
    set kept to the item at cursor in (gridEditor's documentValue's current's dimensions's values)
    if kept's first's feature = bim grid line feature:
        print ((the string form of "grid chain stands off y ") + (the bim millimetre text of kept's place's y)) as a line
