# SPDX-License-Identifier: MPL-2.0
# Push/pull of a mass's side, as in SketchUp: the east side of a rectangle
# pushed out 1 m and pulled in 0.5 m (it grows and shrinks), and a side of an
# L-shaped mass pushed out, which adds a step.
import ui/editor/bim_editor.dl

function click bim side test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function show bim side outline of {a pointer to a bim editor record:editor} labelled {a string:label}:
    execute:
        set element to the item at 0 in (editor's documentValue's current's sketches's values)
        loop cursor from 0 to the length of (editor's documentValue's current's sketches's values):
            set candidate to the item at cursor in (editor's documentValue's current's sketches's values)
            if candidate's kind = bim face sketch:
                set element to candidate
        set line to label + (the string form of ":")
        loop cursor from 0 to the length of (element's points's values):
            set point to the item at cursor in (element's points's values)
            set line to (line + (the string form of " (")) + (((the string form of point's x) + (the string form of " ")) + ((the string form of point's y) + (the string form of ")")))
        print ((line + (the string form of " height ")) + (the string form of element's height)) as a line

function push bim side test edge {integer:edgeIndex} by {a string:digits} in {a pointer to a bim editor record:editor}:
    execute:
        type bim editor key 80 in editor
        move bim editor pointer to (a cad vector2 with x 1.0 and y 1.0) within 0.1 in editor
        set editor's pushEdge to edgeIndex
        press bim editor pointer in editor
        loop cursor from 0 to the length of digits:
            type bim editor key ((the character at cursor in digits) as an integer) in editor
        type bim editor key bim enter key code in editor
        print editor's message as a line

set editor to a new bim editor
set e to the address of editor
type bim editor key 82 in e
click bim side test at 0.0 and 0.0 in e
click bim side test at 4.0 and 3.0 in e
type bim editor key 80 in e
click bim side test at 1.0 and 1.0 in e
type bim editor key 50 in e
type bim editor key bim enter key code in e
show bim side outline of e labelled (the string form of "mass")
push bim side test edge 1 by (the string form of "1") in e
show bim side outline of e labelled (the string form of "east side out 1 m")
push bim side test edge 1 by (the string form of "-0.5") in e
show bim side outline of e labelled (the string form of "east side in 0.5 m")
push bim side test edge 0 by (the string form of "-9") in e
show bim side outline of e labelled (the string form of "after a refused push")
