# SPDX-License-Identifier: MPL-2.0
import ui/editor/bim_editor_core.dl

function check modify corner {boolean:passed} named {a string:caption}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set firstId to add bim line on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 10.0 and y 0.0) to target
set secondId to add bim line on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 10.0) to target
set editor's boundaryId to firstId
set editor's moveBase to a cad vector2 with x 5.0 and y 0.0
set editor's modify's chamfer to 2.0
check modify corner (apply bim editor corner with secondId at (a cad vector2 with x 0.0 and y 5.0) rounded false in e) named (the string form of "chamfer trims both lines and inserts an editable bridge")
check modify corner ((the length of (target's sketches's values)) = 3) named (the string form of "chamfer produces three native lines")
ignore undo bim transaction in (the address of (editor's documentValue))
check modify corner ((the length of (target's sketches's values)) = 2) named (the string form of "one undo restores both original corner lines")
set beforeRejected to the length of (editor's documentValue's undoStack's values)
check modify corner ((join bim editor first firstId with secondId in e) = false) named (the string form of "join refuses non-collinear lines")
check modify corner ((the length of (editor's documentValue's undoStack's values)) = beforeRejected) named (the string form of "invalid join leaves undo history intact")
set thirdId to add bim line on editor's levelId from (a cad vector2 with x 10.0 and y 0.0) to (a cad vector2 with x 15.0 and y 0.0) to target
check modify corner (join bim editor first firstId with thirdId in e) named (the string form of "touching collinear lines join into one element")
set merged to the bim segment of firstId in editor's documentValue's current
check modify corner ((the cad distance from merged's finish to (a cad vector2 with x 15.0 and y 0.0)) < 1e-9) named (the string form of "joined line spans the complete source extent")
set editor's solidCorner to a cad vector2 with x 14.0 and y -1.0
set editor's solidReach to a cad vector2 with x 16.0 and y 1.0
select bim editor stretch points in e
check modify corner (apply bim editor stretch by (a cad vector2 with x 3.0 and y 2.0) in e) named (the string form of "stretch changes only points in the indicated box")
set stretched to the bim segment of firstId in editor's documentValue's current
check modify corner (((the cad distance from stretched's start to (a cad vector2 with x 0.0 and y 0.0)) < 1e-9) and ((the cad distance from stretched's finish to (a cad vector2 with x 18.0 and y 2.0)) < 1e-9)) named (the string form of "stretch preserves the unselected endpoint")
ignore undo bim transaction in (the address of (editor's documentValue))
select bim editor bim sketch picked numbered firstId in e
check modify corner (split bim editor selected line at (a cad vector2 with x 5.0 and y 0.0) in e) named (the string form of "split creates two editable pieces at an interior point")

set shortLine to add bim line on editor's levelId from (a cad vector2 with x 30.0 and y 0.0) to (a cad vector2 with x 31.0 and y 0.0) to target
set editor's solidCorner to a cad vector2 with x 30.5 and y -0.5
set editor's solidReach to a cad vector2 with x 31.5 and y 0.5
select bim editor stretch points in e
check modify corner ((apply bim editor stretch by (a cad vector2 with x -1.0 and y 0.0) in e) = false) named (the string form of "stretch refuses a collapsed sketch line")
set stillShort to the bim segment of shortLine in editor's documentValue's current
check modify corner ((the cad distance from stillShort's start to stillShort's finish) = 1.0) named (the string form of "failed stretch restores its original endpoints")
set splitWall to add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 40.0 and y 0.0) to (a cad vector2 with x 50.0 and y 0.0) to target
ignore set bim wall splitWall base to 0.5 and height to 4.0 in target
ignore set bim wall splitWall lean to 0.2 and rise to 0.1 in target
select bim editor bim wall picked numbered splitWall in e
check modify corner (split bim editor selected line at (a cad vector2 with x 45.0 and y 0.0) in e) named (the string form of "split supports walls with instance geometry settings")
set splitTail to the item at ((the length of (target's walls's values)) - 1) in (target's walls's values)
check modify corner (((splitTail's baseOffset = 0.5) and (splitTail's height = 4.0)) and ((splitTail's lean = 0.2) and (splitTail's rise = 0.1))) named (the string form of "split wall pieces preserve height base lean and rise")
ignore set bim wall splitTail's id lean to 0.3 and rise to 0.1 in target
check modify corner ((join bim editor first splitWall with splitTail's id in e) = false) named (the string form of "join refuses walls with incompatible instance geometry")

set upperLevel to add bim level named (the string form of "Upper floor") at 3.0 with height 3.0 to target
set upperLine to add bim line on upperLevel from (a cad vector2 with x 30.0 and y 0.0) to (a cad vector2 with x 31.0 and y 0.0) to target
set hiddenLine to add bim line on editor's levelId from (a cad vector2 with x 30.0 and y 0.0) to (a cad vector2 with x 31.0 and y 0.0) to target
append (@intrinsic("construct", a bim hidden element record, editor's planViewId, hiddenLine)) to (editor's hiddenElements's values)
select bim editor stretch points in e
check modify corner (((the length of (editor's chosenSketches's values)) = 1) and (editor's selectionId = shortLine)) named (the string form of "stretch box excludes hidden geometry and other storeys")
check modify corner (apply bim editor stretch by (a cad vector2 with x 1.0 and y 0.0) in e) named (the string form of "stretch changes visible points on the active storey")
set upperAfter to the bim segment of upperLine in editor's documentValue's current
set hiddenAfter to the bim segment of hiddenLine in editor's documentValue's current
check modify corner ((upperAfter's finish's x = 31.0) and (hiddenAfter's finish's x = 31.0)) named (the string form of "stretch preserves hidden and cross-storey endpoints")

set reverseFirst to add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 60.0 and y 0.0) to (a cad vector2 with x 65.0 and y 0.0) to target
set reverseSecond to add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 70.0 and y 0.0) to (a cad vector2 with x 65.0 and y 0.0) to target
ignore set bim wall reverseFirst lean to 0.2 and rise to 0.1 in target
ignore set bim wall reverseSecond lean to 0.2 and rise to 0.1 in target
check modify corner ((join bim editor first reverseFirst with reverseSecond in e) = false) named (the string form of "join refuses reversed shaped walls with different physical normals")
