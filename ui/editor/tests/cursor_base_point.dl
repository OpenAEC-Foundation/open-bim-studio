# SPDX-License-Identifier: MPL-2.0
# A 3D cursor moved by the user is the next move's base point and the next
# wall's first point, once (#90); Shift+C takes it home without making it a
# base point.
import ui/editor/bim_editor.dl

function check cursor base {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set wallId to add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to target
select bim editor bim wall picked numbered wallId in e
# Move without a fresh cursor asks for a base point.
type bim editor key 77 in e
check cursor base (editor's moveStage = 1) named (the string form of "without a moved cursor Move asks for its base point")
type bim editor key bim escape key code in e
type bim editor key bim escape key code in e
select bim editor bim wall picked numbered wallId in e
# The cursor moved to the wall's start: Move goes straight to the destination.
place bim editor cursor at (a cad vector2 with x 0.0 and y 0.0) in e
type bim editor key 77 in e
check cursor base ((editor's moveStage = 2) and ((the cad distance from editor's moveBase to (a cad vector2 with x 0.0 and y 0.0)) < 1e-9)) named (the string form of "with a moved cursor Move takes it as its base point")
move bim editor pointer to (a cad vector2 with x 7.0 and y 3.0) within 0.001 in e
press bim editor pointer in e
set moved to the item at (the bim wall index of wallId in editor's documentValue's current)'s position in (editor's documentValue's current's walls's values)
check cursor base (((the absolute value of (moved's start's x - 7.0)) < 1e-6) and ((the absolute value of (moved's start's y - 3.0)) < 1e-6)) named (the string form of "the wall moves from the cursor to the click")
# The cursor is spent: the next Move asks for a base point again.
select bim editor bim wall picked numbered wallId in e
type bim editor key 77 in e
check cursor base (editor's moveStage = 1) named (the string form of "a used cursor is spent")
type bim editor key bim escape key code in e
type bim editor key bim escape key code in e
# Wall: a moved cursor is its first point.
select bim editor bim nothing picked numbered (the bim refused id) in e
place bim editor cursor at (a cad vector2 with x 2.0 and y 5.0) in e
type bim editor key 87 in e
check cursor base (editor's chainActive and ((the cad distance from editor's chainStart to (a cad vector2 with x 2.0 and y 5.0)) < 1e-9)) named (the string form of "with a moved cursor Wall starts there")
type bim editor key bim escape key code in e
type bim editor key bim escape key code in e
# Shift+C home: no base point.
place bim editor cursor at (a cad vector2 with x 1.0 and y 1.0) in e
home bim editor cursor in e
type bim editor key 87 in e
check cursor base (editor's chainActive = false) named (the string form of "a cursor taken home is not a first point")
