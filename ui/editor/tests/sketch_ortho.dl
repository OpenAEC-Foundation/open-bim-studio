# SPDX-License-Identifier: MPL-2.0
import editor/bim_editor_core.dl

function check sketch ortho {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set editor to a new bim editor
set editor's sketchTool to bim sketch line tool
append (a cad vector2 with x 1.25 and y 2.0) to (editor's sketchPending's values)
set location to a cad vector2 with x 6.27 and y 4.13
set editor's orthoHeld to true
set snapped to the bim sketch snap at location of editor
check sketch ortho ((snapped's label = (the string form of "Horizontal")) and ((the absolute value of (snapped's point's y - 2.0)) < 1e-9)) named (the string form of "Shift constrains a boundary line from its pending point")
check sketch ortho ((the absolute value of (snapped's point's x - 6.25)) < 1e-9) named (the string form of "boundary ortho retains the normal grid step")
set snapped to the bim sketch snap at (a cad vector2 with x 2.13 and y 8.27) of editor
check sketch ortho ((snapped's label = (the string form of "Vertical")) and ((the absolute value of (snapped's point's x - 1.25)) < 1e-9)) named (the string form of "Shift also constrains the vertical direction")
set editor's orthoHeld to false
set snapped to the bim sketch snap at location of editor
check sketch ortho ((snapped's label != (the string form of "Horizontal")) and (editor's orthoOn = false)) named (the string form of "releasing Shift restores free sketch movement without changing F8")
set editor's orthoOn to true
set snapped to the bim sketch snap at location of editor
check sketch ortho (snapped's label = (the string form of "Horizontal")) named (the string form of "latched F8 constrains boundary sketches too")
append (the bim boundary line from location to (a cad vector2 with x 7.27 and y 5.13)) to (editor's sketchSegments's values)
set snapped to the bim sketch snap at location of editor
check sketch ortho ((snapped's label = (the string form of "End point")) and ((the cad distance from snapped's point to location) < 1e-9)) named (the string form of "boundary object snaps retain priority over ortho")
set editor's sketchSegments to a cad topology list of a bim boundary segment record
set editor's sketchPending to a cad topology list of a cad vector2
set editor's sketchTool to bim sketch move tool
set editor's moveBase to a cad vector2 with x 10.0 and y 20.0
set editor's orthoOn to false
set editor's orthoHeld to true
set snapped to the bim sketch snap at (a cad vector2 with x 15.27 and y 22.13) of editor
check sketch ortho ((snapped's label = (the string form of "Horizontal")) and ((the absolute value of (snapped's point's y - 20.0)) < 1e-9)) named (the string form of "boundary moves constrain from their move base")
set editor's snapOff to true
set snapped to the bim sketch snap at location of editor
check sketch ortho ((snapped's label = (the string form of "Free")) and ((the cad distance from snapped's point to location) < 1e-9)) named (the string form of "F3 retains its existing sketch snap override")
