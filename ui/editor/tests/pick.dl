# SPDX-License-Identifier: MPL-2.0
# Picking along rays and selecting in the plan, on the example house near the
# origin and 500 km away: a wall from above, a window through its hole and the
# wall below its sill, the ground slab under a room, a miss; the room's floor
# once the selected slab is deleted; then plan selection, its description,
# deleting a selected window, and clearing.
import ui/editor/bim_editor.dl

function the pick test kind name of {integer:kindCode}:
    execute:
        if kindCode = bim wall picked:
            return the string form of "wall"
        if kindCode = bim opening picked:
            return the string form of "opening"
        if kindCode = bim space picked:
            return the string form of "space"
        if kindCode = bim slab picked:
            return the string form of "slab"
        return the string form of "nothing"

function report pick from {a 64 bit floating-point number:fromX}, {a 64 bit floating-point number:fromY}, {a 64 bit floating-point number:fromZ} toward {a 64 bit floating-point number:dx}, {a 64 bit floating-point number:dy}, {a 64 bit floating-point number:dz} in {bim editor record:editor} shifted {cad vector2:base} with {a pointer to a list:meshes} labelled {a string:label}:
    execute:
        set ray to @intrinsic("construct", a bim ray record, (a cad vector3 with x (fromX + base's x), y (fromY + base's y) and z fromZ), (a cad vector3 with x dx, y dy and z dz))
        set picked to the bim pick along ray among meshes in editor's documentValue's current with (editor's spaces's values)
        set line to ((label + (the string form of ": ")) + (the pick test kind name of picked's kind)) + (the string form of " ")
        if picked's kind = bim space picked:
            set line to line + (the string form of "(space)")
        else if picked's kind != bim nothing picked:
            set line to line + (the string form of picked's id)
        print line as a line

function run pick test shifted by {cad vector2:base} labelled {a string:label}:
    execute:
        set editor to a new bim editor
        add bim example building to (the address of editor) at base
        refresh bim editor (the address of editor)
        set meshes to the bim scene meshes of editor's evaluation after (a cad topology list of a bim scene mesh record)'s values
        print ((label + (the string form of " meshes ")) + (the string form of (the length of (meshes's values)))) as a line
        report pick from 5.0, -1.5, 10.0 toward 0.0, 0.0, -1.0 in editor shifted base with (meshes's values) labelled (the string form of "south wall from above")
        report pick from 0.5, -10.0, 1.5 toward 0.0, 1.0, 0.0 in editor shifted base with (meshes's values) labelled (the string form of "south window from outside")
        report pick from 0.5, -10.0, 0.5 toward 0.0, 1.0, 0.0 in editor shifted base with (meshes's values) labelled (the string form of "below the sill")
        report pick from 0.0, 2.0, 10.0 toward 0.0, 0.0, -1.0 in editor shifted base with (meshes's values) labelled (the string form of "west room from above")
        report pick from 0.5, -10.0, 1.5 toward 0.0, 0.6, 0.8 in editor shifted base with (meshes's values) labelled (the string form of "steeply over the house")
        report pick from 20.0, 20.0, 10.0 toward 0.0, 0.0, -1.0 in editor shifted base with (meshes's values) labelled (the string form of "outside the house")
        set slabId to (the item at 0 in (editor's documentValue's current's slabs's values))'s id
        select bim editor bim slab picked numbered slabId in (the address of editor)
        print editor's message as a line
        type bim editor key bim delete key code in (the address of editor)
        refresh bim editor (the address of editor)
        set remaining to the bim scene meshes of editor's evaluation after (meshes's values)
        print ((label + (the string form of " meshes without the slab ")) + (the string form of (the length of (remaining's values)))) as a line
        report pick from 0.0, 2.0, 10.0 toward 0.0, 0.0, -1.0 in editor shifted base with (remaining's values) labelled (the string form of "west room without the slab")

set origin to a cad vector2 with x 0.0 and y 0.0
run pick test shifted by origin labelled (the string form of "near")
run pick test shifted by (a cad vector2 with x 500000.0 and y 500000.0) labelled (the string form of "far")

# Plan selection with the select tool, away from wall end points.
set editor to a new bim editor
add bim example building to (the address of editor) at origin
refresh bim editor (the address of editor)
set e to the address of editor
type bim editor key 83 in e
move bim editor pointer to (a cad vector2 with x 2.0 and y -1.5) within 0.1 in e
press bim editor pointer in e
release bim editor pointer in e
print editor's message as a line
move bim editor pointer to (a cad vector2 with x 0.5 and y -1.5) within 0.1 in e
press bim editor pointer in e
release bim editor pointer in e
print editor's message as a line
set openingsBefore to the length of (editor's documentValue's current's openings's values)
type bim editor key bim delete key code in e
set openingsAfter to the length of (editor's documentValue's current's openings's values)
print (((the string form of "openings ") + (the string form of openingsBefore)) + ((the string form of " -> ") + (the string form of openingsAfter))) as a line
move bim editor pointer to (a cad vector2 with x 0.0 and y 2.5) within 0.1 in e
press bim editor pointer in e
release bim editor pointer in e
refresh bim editor e
print editor's message as a line
type bim editor key bim escape key code in e
print ((the string form of "after escape ") + (the pick test kind name of editor's selectionKind)) as a line
type bim editor key 90 in e
refresh bim editor e
print ((the string form of "after undo openings ") + (the string form of (the length of (editor's documentValue's current's openings's values)))) as a line
