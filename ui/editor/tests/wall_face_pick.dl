# A click on a wall's cut face in the plan picks the wall, also where the
# face lies farther from the centreline than the pick tolerance (#88: a
# click on a thick wall's face picked nothing).
import ui/editor/bim_editor.dl

function check wall face pick {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set levelId to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
set editor's levelId to levelId
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.4)) to layerValues
set thickType to add bim wall type named (the string form of "Thick wall") with layerValues to target
free layerValues
set wallId to add bim wall typed thickType on levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
# A tolerance of 0.05 m, as eight pixels at 160 pixels a metre: the face
# lies 0.2 m from the centreline.
move bim editor pointer to (a cad vector2 with x 3.0 and y 0.15) within 0.05 in e
check wall face pick (editor's hoverWall = wallId) named (the string form of "a point on the face, beyond the tolerance from the centreline, finds the wall")
select bim editor element at (a cad vector2 with x 3.0 and y 0.15) in e
check wall face pick ((editor's selectionKind = bim wall picked) and (editor's selectionId = wallId)) named (the string form of "a click there selects the wall")
move bim editor pointer to (a cad vector2 with x 3.0 and y 0.24) within 0.05 in e
check wall face pick (editor's hoverWall = wallId) named (the string form of "within the tolerance outside the face still finds it")
move bim editor pointer to (a cad vector2 with x 3.0 and y 0.3) within 0.05 in e
check wall face pick (editor's hoverWall = the bim refused id) named (the string form of "farther outside the face finds nothing")
set otherId to add bim wall typed thickType on levelId from (a cad vector2 with x 0.0 and y 0.3) to (a cad vector2 with x 6.0 and y 0.3) to target
move bim editor pointer to (a cad vector2 with x 3.0 and y 0.12) within 0.05 in e
check wall face pick (editor's hoverWall = wallId) named (the string form of "where two walls overlap, the nearer centreline wins")
move bim editor pointer to (a cad vector2 with x 3.0 and y 0.18) within 0.05 in e
check wall face pick (editor's hoverWall = otherId) named (the string form of "and past the middle the other wall wins")
