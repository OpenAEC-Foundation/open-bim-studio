# SPDX-License-Identifier: MPL-2.0
# A view's crop region selected and edited as a sketch (#98): selected, it
# takes Tab to open the boundary sketch with its rectangle as one loop; Tab
# makes the loop the crop, an arc kept; reopened, the sketch has the arc
# back; a crossing loop is refused; Esc leaves the sketch as it was; undo
# brings the rectangle back; the properties turn the crop and its frame
# over; a duplicated view keeps the outline; CV draws a plain rectangle
# again.
import ui/editor/bim_editor.dl

function check crop sketch {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function click crop sketch at {a 64 bit floating-point number:across} and {a 64 bit floating-point number:up} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x across and y up) within 0.0001 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function add crop sketch line from {cad vector2:fromPoint} to {cad vector2:toPoint} in {a pointer to a bim editor record:editor}:
    execute:
        append (the bim boundary line from fromPoint to toPoint) to (editor's sketchSegments's values)

function the crop sketch view of {bim editor record:editor}:
    execute:
        return the item at (the bim view index of editor's planViewId in editor's documentValue's current)'s position in (editor's documentValue's current's views's values)

function leave crop sketch with escape in {a pointer to a bim editor record:editor}:
    execute:
        set presses to 0
        loop while (bim editor sketches a boundary (@intrinsic("dereference", editor))) and (presses < 4):
            type bim editor key bim escape key code in editor
            set presses to presses + 1

function the crop sketch arcs of {bim editor record:editor}:
    execute:
        set arcCount to 0
        loop cursor from 0 to the length of (editor's sketchSegments's values):
            if (the item at cursor in (editor's sketchSegments's values))'s bulge != 0.0:
                set arcCount to arcCount + 1
        return arcCount

set editor to a new bim editor
set e to the address of editor
prepare bim editor views in e
set viewId to editor's planViewId

# CV: a rectangle of two clicks.
type bim editor key 2093 in e
click crop sketch at 0.0 and 0.0 in e
click crop sketch at 10.0 and 8.0 in e
check crop sketch ((the crop sketch view of editor)'s cropped) named (the string form of "CV crops the plan view")

# Tab with nothing chosen does not open the crop's sketch.
check crop sketch ((bim editor has a crop selected editor) = false) named (the string form of "the crop region starts unselected")

# A click on its frame (the shell) selects it: nothing else, its view's
# properties.
select bim editor crop of view viewId in e
check crop sketch ((bim editor has a crop selected editor) and (editor's selectionKind = bim nothing picked)) named (the string form of "the crop region is selected alone")
check crop sketch ((the bim properties view of editor) = viewId) named (the string form of "its view's properties show")

# Tab: the sketch, the rectangle as four lines.
type bim editor key 258 in e
check crop sketch (bim editor sketches a crop editor) named (the string form of "Tab opens the crop's sketch")
check crop sketch ((the length of (editor's sketchSegments's values)) = 4) named (the string form of "the rectangle is one loop of four lines")

# An L with an arc over its inner corner's lower edge.
clear (editor's sketchSegments's values)
add crop sketch line from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 10.0 and y 0.0) in e
add crop sketch line from (a cad vector2 with x 10.0 and y 0.0) to (a cad vector2 with x 10.0 and y 5.0) in e
append (the bim boundary arc from (a cad vector2 with x 10.0 and y 5.0) to (a cad vector2 with x 6.0 and y 5.0) bulging 0.5) to (editor's sketchSegments's values)
add crop sketch line from (a cad vector2 with x 6.0 and y 5.0) to (a cad vector2 with x 6.0 and y 8.0) in e
add crop sketch line from (a cad vector2 with x 6.0 and y 8.0) to (a cad vector2 with x 0.0 and y 8.0) in e
add crop sketch line from (a cad vector2 with x 0.0 and y 8.0) to (a cad vector2 with x 0.0 and y 0.0) in e
type bim editor key 258 in e
check crop sketch ((bim editor sketches a boundary editor) = false) named (the string form of "Tab finishes the sketch")
check crop sketch (bim crop view viewId has an outline in editor's documentValue's current) named (the string form of "the crop keeps the outline")
check crop sketch (bim editor has a crop selected editor) named (the string form of "the crop region stays selected")
set croppedView to the crop sketch view of editor
check crop sketch (((croppedView's cropLow's x = 0.0) and (croppedView's cropLow's y = 0.0)) and ((croppedView's cropHigh's x = 10.0) and (croppedView's cropHigh's y = 8.0))) named (the string form of "its rectangle is the outline's box")

# Reopened: six segments, the arc among them.
type bim editor key 258 in e
check crop sketch (((the length of (editor's sketchSegments's values)) = 6) and ((the crop sketch arcs of editor) = 1)) named (the string form of "reopened, the sketch has its six segments and the arc")

# A crossing loop is refused and the sketch stays open.
clear (editor's sketchSegments's values)
add crop sketch line from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 4.0) in e
add crop sketch line from (a cad vector2 with x 4.0 and y 4.0) to (a cad vector2 with x 4.0 and y 0.0) in e
add crop sketch line from (a cad vector2 with x 4.0 and y 0.0) to (a cad vector2 with x 0.0 and y 4.0) in e
add crop sketch line from (a cad vector2 with x 0.0 and y 4.0) to (a cad vector2 with x 0.0 and y 0.0) in e
type bim editor key 258 in e
check crop sketch (bim editor sketches a crop editor) named (the string form of "a crossing loop is refused and the sketch stays open")

# Esc leaves it as it was.
leave crop sketch with escape in e
check crop sketch ((bim editor sketches a boundary editor) = false) named (the string form of "Esc leaves the sketch")
set kept to the bim crop outline of view viewId in editor's documentValue's current
check crop sketch ((the length of kept) > 6) named (the string form of "the outline stays as it was")
free kept

# Undo: the rectangle again.
type bim editor key 90 in e
check crop sketch ((bim crop view viewId has an outline in editor's documentValue's current) = false) named (the string form of "undo brings the rectangle back")
check crop sketch ((the crop sketch view of editor)'s cropped) named (the string form of "still cropped")

# The properties: the frame hidden and shown, the crop off and on.
start bim editor property (bim crop region property) in e
check crop sketch (bim crop view viewId is hidden in editor's documentValue's current) named (the string form of "Crop region hides the frame")
start bim editor property (bim crop region property) in e
check crop sketch ((bim crop view viewId is hidden in editor's documentValue's current) = false) named (the string form of "and shows it again")
start bim editor property (bim crop view property) in e
check crop sketch (((the crop sketch view of editor)'s cropped) = false) named (the string form of "Crop view turns the crop off")
check crop sketch ((bim editor has a crop selected editor) = false) named (the string form of "an uncropped view has no crop region to select")
start bim editor property (bim crop view property) in e
check crop sketch ((the crop sketch view of editor)'s cropped) named (the string form of "and on again")

# Esc drops the crop region's selection.
select bim editor crop of view viewId in e
type bim editor key bim escape key code in e
check crop sketch ((bim editor has a crop selected editor) = false) named (the string form of "Esc drops the selection")

# A sketched outline, then CV: a plain rectangle again.
select bim editor crop of view viewId in e
type bim editor key 258 in e
clear (editor's sketchSegments's values)
add crop sketch line from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) in e
add crop sketch line from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 0.0 and y 6.0) in e
add crop sketch line from (a cad vector2 with x 0.0 and y 6.0) to (a cad vector2 with x 0.0 and y 0.0) in e
type bim editor key 258 in e
check crop sketch (bim crop view viewId has an outline in editor's documentValue's current) named (the string form of "a triangle is kept as the outline")
# DV: the copy keeps the outline; it is shown and cropped the same way.
type bim editor key 2092 in e
check crop sketch ((editor's planViewId != viewId) and (bim crop view editor's planViewId has an outline in editor's documentValue's current)) named (the string form of "a duplicated view keeps the outline")
show bim editor plan view viewId in e
type bim editor key 2093 in e
click crop sketch at 1.0 and 1.0 in e
click crop sketch at 5.0 and 4.0 in e
check crop sketch ((bim crop view viewId has an outline in editor's documentValue's current) = false) named (the string form of "CV draws a plain rectangle again")
