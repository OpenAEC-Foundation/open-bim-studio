# SPDX-License-Identifier: MPL-2.0
# A grid end's shape handle stands a set paper distance beyond its bubble
# (#61): a press on the bubble does not drag, a press on the handle of the
# selected line does. The ends in one row drag together unless the editor
# says alone; a dragged end snaps to the row of the other ends ("Grid ends")
# and onto a crossing line ("on 4").
import ui/editor/bim_editor_core.dl

function check grid handles {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function the test grid {a 64 bit integer:gridId} of {bim editor record:editor}:
    execute:
        set found to the bim grid index of gridId in editor's documentValue's current
        return the item at found's position in (editor's documentValue's current's grids's values)

function point {cad vector2:spot} is at x {a 64 bit floating-point number:wantedX} y {a 64 bit floating-point number:wantedY}:
    execute:
        return (the cad distance from spot to (a cad vector2 with x wantedX and y wantedY)) < 1e-6

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set levelId to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
set editor's levelId to levelId
set lineA to add bim grid named (the string form of "A") from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 10.0) reaching -1.0 to 4.0 to target
set lineB to add bim grid named (the string form of "B") from (a cad vector2 with x 5.0 and y 0.0) to (a cad vector2 with x 5.0 and y 10.0) reaching -1.0 to 4.0 to target
set lineC to add bim grid named (the string form of "C") from (a cad vector2 with x 10.0 and y 0.0) to (a cad vector2 with x 10.0 and y 12.0) reaching -1.0 to 4.0 to target
set lineD to add bim grid named (the string form of "4") from (a cad vector2 with x -2.0 and y 4.0) to (a cad vector2 with x 12.0 and y 4.0) reaching -1.0 to 4.0 to target

# A pick tolerance of 0.1 m stands for 8 pixels; the bubble is 11 pixels in
# radius (3 paper mm), the handle 3 paper mm beyond it: 22 pixels, 0.275 m.
set reachValue to the bim grid handle reach at tolerance 0.1
check grid handles ((the absolute value of (reachValue - 0.275)) < 1e-9) named (the string form of "the handle stands 3 paper mm beyond the bubble")
check grid handles (point (the bim grid handle of (the test grid lineA of editor) at end true reaching reachValue) is at x 0.0 y 10.275) named (the string form of "the finish handle lies beyond the finish")
check grid handles (point (the bim grid handle of (the test grid lineA of editor) at end false reaching reachValue) is at x 0.0 y -0.275) named (the string form of "the start handle lies beyond the start")

# Unselected, the handle is not there.
move bim editor pointer to (a cad vector2 with x 0.0 and y 10.275) within 0.1 in e
press bim editor pointer in e
check grid handles (editor's gridDragId = the bim refused id) named (the string form of "an unselected line has no handle")
release bim editor pointer in e

# The bubble selects; it does not drag the end.
select bim editor bim grid picked numbered lineA in e
move bim editor pointer to (a cad vector2 with x 0.0 and y 10.0) within 0.1 in e
press bim editor pointer in e
check grid handles (editor's gridDragId = the bim refused id) named (the string form of "a press on the bubble does not grab the end")
release bim editor pointer in e

# The handle drags the end by as much as the pointer moves; B's end stands
# in one row with A's and goes along; C's does not.
select bim editor bim grid picked numbered lineA in e
move bim editor pointer to (a cad vector2 with x 0.0 and y 10.275) within 0.1 in e
press bim editor pointer in e
check grid handles ((editor's gridDragId = lineA) and editor's gridDragAtFinish) named (the string form of "a press on the handle grabs the end")
move bim editor pointer to (a cad vector2 with x 0.0 and y 10.305) within 0.1 in e
check grid handles (point ((the test grid lineA of editor)'s finish) is at x 0.0 y 10.0) named (the string form of "a tremble moves nothing")
move bim editor pointer to (a cad vector2 with x 0.0 and y 11.275) within 0.1 in e
check grid handles (point ((the test grid lineA of editor)'s finish) is at x 0.0 y 11.0) named (the string form of "the end keeps its distance from the pointer")
check grid handles (point ((the test grid lineB of editor)'s finish) is at x 5.0 y 11.0) named (the string form of "an end in one row goes along")
check grid handles (point ((the test grid lineC of editor)'s finish) is at x 10.0 y 12.0) named (the string form of "an end out of the row stays")
check grid handles (point ((the test grid lineB of editor)'s start) is at x 5.0 y 0.0) named (the string form of "the other ends stay")
# Near C's end the dragged end snaps to its row.
move bim editor pointer to (a cad vector2 with x 0.02 and y 12.235) within 0.1 in e
check grid handles (editor's snap's label = (the string form of "Grid ends")) named (the string form of "the row of another line's end is a snap")
check grid handles (point (editor's snap's origin) is at x 10.0 y 12.0) named (the string form of "the guide runs from that end")
check grid handles (point ((the test grid lineA of editor)'s finish) is at x 0.0 y 12.0) named (the string form of "the end lands in the row")
release bim editor pointer in e
ignore undo bim transaction in (the address of (editor's documentValue))
check grid handles ((point ((the test grid lineA of editor)'s finish) is at x 0.0 y 10.0) and (point ((the test grid lineB of editor)'s finish) is at x 5.0 y 10.0)) named (the string form of "one undo restores every end")

# Alone, the other ends stay.
set editor's gridEndsAlone to true
select bim editor bim grid picked numbered lineA in e
move bim editor pointer to (a cad vector2 with x 0.0 and y 10.275) within 0.1 in e
press bim editor pointer in e
move bim editor pointer to (a cad vector2 with x 0.0 and y 11.275) within 0.1 in e
check grid handles ((point ((the test grid lineA of editor)'s finish) is at x 0.0 y 11.0) and (point ((the test grid lineB of editor)'s finish) is at x 5.0 y 10.0)) named (the string form of "an end dragged alone leaves the row")
release bim editor pointer in e
ignore undo bim transaction in (the address of (editor's documentValue))

# The start end snaps onto the crossing line 4.
select bim editor bim grid picked numbered lineA in e
move bim editor pointer to (a cad vector2 with x 0.0 and y -0.275) within 0.1 in e
press bim editor pointer in e
check grid handles ((editor's gridDragId = lineA) and (editor's gridDragAtFinish = false)) named (the string form of "the start handle grabs the start")
move bim editor pointer to (a cad vector2 with x 0.01 and y 3.755) within 0.1 in e
check grid handles (editor's snap's label = (the string form of "on 4")) named (the string form of "a crossing line is a snap named after it")
check grid handles (point ((the test grid lineA of editor)'s start) is at x 0.0 y 4.0) named (the string form of "the end lands on the crossing line")
release bim editor pointer in e
