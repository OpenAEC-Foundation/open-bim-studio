# Saving under a name that ends in .ifc is refused, whatever its case: an
# .ifc file is an export, and the native text under that name would open
# in no other program.
import ui/editor/bim_editor.dl

set editor to a new bim editor
save bim editor to (the string form of "refused-model.ifc") in (the address of editor)
print editor's message as a line
save bim editor to (the string form of "REFUSED-MODEL.IFC") in (the address of editor)
print editor's message as a line
