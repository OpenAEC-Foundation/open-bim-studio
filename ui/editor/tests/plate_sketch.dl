# SPDX-License-Identifier: MPL-2.0
# Floor, Roof and Ceiling with no space selected open an empty boundary
# sketch for a new plate (#101); Tab makes the plate from the drawn loop on
# the active storey at its role's height, keeping arcs; an open sketch is
# refused and makes nothing.
import ui/editor/bim_editor.dl

function check plate sketch {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function add plate sketch line from {cad vector2:fromPoint} to {cad vector2:toPoint} in {a pointer to a bim editor record:editor}:
    execute:
        append (the bim boundary line from fromPoint to toPoint) to (editor's sketchSegments's values)

set editor to a new bim editor
set e to the address of editor
set slabsBefore to the length of (editor's documentValue's current's slabs's values)
type bim editor key 66 in e
check plate sketch ((bim editor sketches a new plate editor) and ((the length of (editor's sketchSegments's values)) = 0)) named (the string form of "Floor with nothing selected opens an empty sketch")
check plate sketch (editor's sketchTool = bim sketch line tool) named (the string form of "the line tool is ready")
# An open sketch: two sides only.
add plate sketch line from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) in e
add plate sketch line from (a cad vector2 with x 4.0 and y 0.0) to (a cad vector2 with x 4.0 and y 3.0) in e
type bim editor key 258 in e
check plate sketch (((the length of (editor's documentValue's current's slabs's values)) = slabsBefore) and (bim editor sketches a new plate editor)) named (the string form of "an open sketch is refused and stays open")
# Close it with an arc and a line: four segments, one of them an arc.
append (the bim boundary arc from (a cad vector2 with x 4.0 and y 3.0) to (a cad vector2 with x 0.0 and y 3.0) bulging 0.5) to (editor's sketchSegments's values)
add plate sketch line from (a cad vector2 with x 0.0 and y 3.0) to (a cad vector2 with x 0.0 and y 0.0) in e
type bim editor key 258 in e
check plate sketch ((the length of (editor's documentValue's current's slabs's values)) = (slabsBefore + 1)) named (the string form of "Tab makes one floor")
check plate sketch ((editor's editMode = false) and (editor's selectionKind = bim slab picked)) named (the string form of "the sketch closes and the new floor is selected")
set made to the item at (the bim slab index of editor's selectionId in editor's documentValue's current)'s position in (editor's documentValue's current's slabs's values)
check plate sketch (made's levelId = editor's levelId) named (the string form of "the floor lies on the active storey")
set back to the bim boundary segments of slab editor's selectionId in editor's documentValue's current
set arcsBack to 0
loop cursor from 0 to the length of (back's values):
    if (the item at cursor in (back's values))'s bulge != 0.0:
        set arcsBack to arcsBack + 1
check plate sketch (((the length of (back's values)) = 4) and (arcsBack = 1)) named (the string form of "its outline keeps four segments and the arc")
# Roof: on top of the storey's walls.
select bim editor bim nothing picked numbered (the bim refused id) in e
type bim editor key 2080 in e
check plate sketch (bim editor sketches a new plate editor) named (the string form of "Roof with nothing selected opens a sketch")
add plate sketch line from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 5.0 and y 0.0) in e
add plate sketch line from (a cad vector2 with x 5.0 and y 0.0) to (a cad vector2 with x 5.0 and y 5.0) in e
add plate sketch line from (a cad vector2 with x 5.0 and y 5.0) to (a cad vector2 with x 0.0 and y 5.0) in e
add plate sketch line from (a cad vector2 with x 0.0 and y 5.0) to (a cad vector2 with x 0.0 and y 0.0) in e
type bim editor key 258 in e
set roofSlab to the item at (the bim slab index of editor's selectionId in editor's documentValue's current)'s position in (editor's documentValue's current's slabs's values)
check plate sketch ((the length of (editor's documentValue's current's slabs's values)) = (slabsBefore + 2)) named (the string form of "Tab makes the roof")
check plate sketch (roofSlab's top > 2.9) named (the string form of "a roof sits on top of the storey")
# Undo removes the roof as one step.
type bim editor key 90 in e
check plate sketch ((the length of (editor's documentValue's current's slabs's values)) = (slabsBefore + 1)) named (the string form of "one undo removes the roof")
