# SPDX-License-Identifier: MPL-2.0
# In edit mode the Move command moves the points picked, as G does: one
# node of a beam, not the whole beam.
import ui/editor/bim_editor.dl

function check edit mode move {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set editor's levelId to ground
set beamType to add bim linear type named (the string form of "Beam 200x200") as role bim beam role sized 0.2 by 0.2 round false of (the string form of "steel") to target
set beamId to add bim linear typed beamType on ground from (a cad vector3 with x 1.0, y 2.0 and z 2.8) to (a cad vector3 with x 5.0, y 2.0 and z 2.8) turned 0.0 to target
select bim editor bim linear picked numbered beamId in e
type bim editor key 258 in e
check edit mode move editor's editMode named (the string form of "Tab on a beam enters edit mode")
type bim editor key 77 in e
check edit mode move ((editor's editMode and (editor's grabbing = false)) and (editor's tool != bim move tool)) named (the string form of "Move without a picked node stays in edit mode and moves nothing")
add bim edit point 1 in e
move bim editor pointer to (a cad vector2 with x 5.0 and y 2.0) within 0.1 in e
type bim editor key 77 in e
check edit mode move (editor's editMode and editor's grabbing) named (the string form of "Move with a node picked grabs that node")
move bim editor pointer to (a cad vector2 with x 5.0 and y 4.0) within 0.1 in e
type bim editor key (bim enter key code) in e
set moved to the item at ((the bim linear index of beamId in editor's documentValue's current)'s position) in (editor's documentValue's current's linears's values)
print ((the string form of "start ") + ((the string form of moved's start's x) + ((the string form of ", ") + (the string form of moved's start's y)))) as a line
print ((the string form of "finish ") + ((the string form of moved's finish's x) + ((the string form of ", ") + (the string form of moved's finish's y)))) as a line
check edit mode move (((the absolute value of (moved's start's x - 1.0)) < 1e-9) and ((the absolute value of (moved's start's y - 2.0)) < 1e-9)) named (the string form of "the other node stays where it was")
check edit mode move ((the absolute value of (moved's finish's y - 2.0)) > 0.5) named (the string form of "the picked node moved")
