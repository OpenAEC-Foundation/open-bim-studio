# SPDX-License-Identifier: MPL-2.0
# The text atlas's characters: printable ASCII, then Ø and ø as glyphs of
# their own, Latin-1 and the euro decoded from complete UTF-8 scalars,
# as the atlas draws and measures labels such as a bar's "2 ø16".
import views/drawings/bim_text.dl

function show text test steps of {a string:message}:
    execute:
        set described to the string form of ""
        set position to 0
        loop while position < (the length of message):
            set stepped to the bim character step of message at position
            set described to ((described + (the string form of " ")) + (the string form of (stepped's glyph))) + ((the string form of "/") + (the string form of (stepped's size)))
            set position to position + (stepped's size)
        print described as a line

print ((the string form of "glyphs: ") + (the string form of (the bim atlas glyph count))) as a line
print ((the string form of "codes: ") + ((the string form of (the bim atlas code at 0)) + ((the string form of " ") + ((the string form of (the bim atlas code at 94)) + ((the string form of " ") + ((the string form of (the bim atlas code at 95)) + ((the string form of " ") + (the string form of (the bim atlas code at 96))))))))) as a line
show text test steps of (the string form of "A ø16")
show text test steps of (the string form of "Ø12")
show text test steps of (the string form of "é°")
show text test steps of (the string form of "€")
