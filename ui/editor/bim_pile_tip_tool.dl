# SPDX-License-Identifier: MPL-2.0
# The pile tip level tool (command 2240, the Structural tab's Piles group;
# issue #138). A click places a pile tip level there
# (`elements/linear/pile_tip_levels.dl`, reached through the composed scene
# point of the linear module): at the level typed before the click, in the
# project's length unit, else at the nearest tip level's, else at the toe of
# the nearest pile, else a pile length under the storey. A level typed after
# a click and Enter moves the last tip level placed to it. The piles take
# their toe from the nearest tip level, so their lengths follow.
import ui/editor/bim_editor_core.dl
import ui/editor/bim_point_input.dl

function bim pile tip level tool:
    replacement:
        90

function bim pile tip level command:
    replacement:
        2240

function start bim editor pile tip level tool in {a pointer to a bim editor record:editor}:
    execute:
        set editor's tool to bim pile tip level tool
        set editor's moveStage to 0
        set editor's numeric to the string form of ""
        set editor's message to ((the string form of "Pile tip level: type its level (NAP, in ") + (the bim name of unit editor's lengthUnit)) + (the string form of ") or click where it holds; piles take the nearest")

# The level typed for the tool, in metres, when one is typed.
local function the bim typed pile tip level of {bim editor record:editor}:
    execute:
        set reading to the bim scalar input of editor's numeric
        if reading's valid:
            set reading's value to reading's value * (the bim metres per editor's lengthUnit)
        return reading

function place bim editor pile tip level at {cad vector2:point} in {a pointer to a bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        set storeyElevation to 0.0
        set levelFound to the bim level index of editor's levelId in modelValue
        if levelFound's valid:
            set storeyElevation to (the item at levelFound's position in (modelValue's levels's values))'s elevation
        set fallback to (storeyElevation - (bim pile length)) + (the bim datum height of the origin in modelValue)
        set levelValue to the bim pile tip level suggested at point in modelValue or fallback
        set typed to the bim typed pile tip level of (@intrinsic("dereference", editor))
        if typed's valid:
            set levelValue to typed's value
        set editor's numeric to the string form of ""
        begin bim transaction in (the address of (editor's documentValue))
        set made to add bim pile tip level named (the string form of "PPN") at point level levelValue from (the string form of "") to (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        set placed to the item at (the bim pile tip level index of made in editor's documentValue's current)'s position in (editor's documentValue's current's pileTipLevels's values)
        set editor's message to (the bim marker text of pile tip level placed in editor's documentValue's current) + (the string form of " placed: type a level and Enter to change it, or click the next")

# Enter with a level typed: the last tip level placed moves to it.
function finish bim editor pile tip level typing in {a pointer to a bim editor record:editor}:
    execute:
        set typed to the bim typed pile tip level of (@intrinsic("dereference", editor))
        set editor's numeric to the string form of ""
        set count to the length of (editor's documentValue's current's pileTipLevels's values)
        if (typed's valid = false) or (count = 0):
            set editor's message to the string form of "Pile tip level: type its level, then click where it holds"
            return nothing
        set lastId to (the item at (count - 1) in (editor's documentValue's current's pileTipLevels's values))'s id
        begin bim transaction in (the address of (editor's documentValue))
        ignore set bim pile tip level lastId to level typed's value in (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        set changed to the item at (the bim pile tip level index of lastId in editor's documentValue's current)'s position in (editor's documentValue's current's pileTipLevels's values)
        set editor's message to (the bim marker text of pile tip level changed in editor's documentValue's current) + (the string form of ": the piles follow")
