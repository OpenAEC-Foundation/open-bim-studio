# SPDX-License-Identifier: MPL-2.0
# A plan view's crop region as something to select and edit (#98). A click
# on its frame selects it (`cropViewId`), with no element selected: the
# floating toolbar offers Edit sketch, Uncrop and Properties, and the
# properties panel shows the view, with whether it is cropped and whether
# the region's frame shows. Tab, or Edit sketch, opens the boundary sketch
# (`bim_boundary_sketch.dl`) on the plan with the crop's outline as one
# closed loop; Tab in the sketch makes the loop the crop (`bim_crop.dl`),
# a rectangle staying a rectangle with its eight handles.
import views/common/bim_view.dl
import ui/editor/bim_boundary_sketch.dl

# The sketch host kind (`sketchHostKind`) of a crop's sketch; its
# `editSketchId` is the view's id. Below `bim new plate sketch base`.
function bim crop sketch host:
    replacement:
        800

# The properties rows of a view's crop: cropped or not, and its frame shown
# or hidden; a click turns each over.
function bim crop view property:
    replacement:
        12650

function bim crop region property:
    replacement:
        12651

# The view whose crop region is selected: the plan view shown, while it is
# cropped; the refused id when none is.
function the bim selected crop view of {bim editor record:editor}:
    execute:
        if editor's cropViewId = the bim refused id:
            return the bim refused id
        if editor's cropViewId != editor's planViewId:
            return the bim refused id
        set viewFound to the bim view index of editor's cropViewId in editor's documentValue's current
        if viewFound's valid = false:
            return the bim refused id
        if ((the item at viewFound's position in (editor's documentValue's current's views's values))'s cropped) = false:
            return the bim refused id
        return editor's cropViewId

function bim editor has a crop selected {bim editor record:editor}:
    execute:
        return (the bim selected crop view of editor) != the bim refused id

# Whether the sketch open is a crop's.
function bim editor sketches a crop {bim editor record:editor}:
    execute:
        return (bim editor sketches a boundary editor) and (editor's sketchHostKind = bim crop sketch host)

# The crop region of view `viewId` selected, and nothing else.
function select bim editor crop of view {a 64 bit integer:viewId} in {a pointer to a bim editor record:editor}:
    execute:
        select bim editor bim nothing picked numbered (the bim refused id) in editor
        set editor's cropViewId to viewId
        set editor's propertiesViewId to viewId
        set editor's message to the string form of "Crop region: drag a handle; Tab edits its sketch, UC uncrops"

# Tab on the selected crop region: its outline (or rectangle) as the
# boundary sketch on the plan, its arcs found back.
function open bim editor crop sketch in {a pointer to a bim editor record:editor}:
    execute:
        set viewId to the bim selected crop view of (@intrinsic("dereference", editor))
        if viewId = the bim refused id:
            set editor's message to the string form of "Edit sketch: select a cropped view's crop region first"
            return nothing
        set modelValue to editor's documentValue's current
        set viewValue to the item at (the bim view index of viewId in modelValue)'s position in (modelValue's views's values)
        set cropCorners to the bim crop corners of viewValue in modelValue
        set spans to an empty list of an integer
        if bim crop view viewId has an outline in modelValue:
            free spans
            set spans to the bim boundary spans of viewId in modelValue
        set editor's sketchSegments to the bim boundary segments of cropCorners spanned spans
        free spans
        free cropCorners
        set editor's sketchHostKind to bim crop sketch host
        set editor's sketchInView to false
        set editor's sketchPending to a cad topology list of a cad vector2
        set editor's sketchTool to bim sketch pick tool
        set editor's sketchPicked to -1
        set editor's tool to bim select tool
        set editor's editMode to true
        set editor's editKind to bim boundary edit
        set editor's editMesh to false
        set editor's editSketchId to viewId
        set editor's editPicked to a cad topology list of an integer
        set editor's partCode to -1
        set editor's message to (the string form of "Sketch mode (crop region): ") + (the bim sketch hint of (@intrinsic("dereference", editor)))

# Tab in a crop's sketch: the loop of its segments becomes the view's crop,
# as one edit, its arcs kept; refused, the sketch kept open, when they do
# not make one closed loop that does not cross itself.
function finish bim editor crop sketch in {a pointer to a bim editor record:editor}:
    execute:
        set viewId to editor's editSketchId
        set chained to the bim anticlockwise boundary loop of (editor's sketchSegments's values)
        if chained's valid = false:
            set editor's message to ((the string form of "Sketch not finished: ") + chained's message) + (the string form of " (Esc Esc leaves the crop as it was)")
            return nothing
        set target to the address of (editor's documentValue's current)
        begin bim transaction in (the address of (editor's documentValue))
        if (keep bim crop outline (chained's corners's values) of view viewId in target) = false:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Sketch not finished: the crop crosses itself or has no width (Esc Esc leaves the crop as it was)"
            return nothing
        set outlined to bim crop view viewId has an outline in (@intrinsic("dereference", target))
        if outlined:
            keep bim boundary spans (chained's spans's values) of viewId in target
        else:
            set noSpans to an empty list of an integer
            keep bim boundary spans noSpans of viewId in target
            free noSpans
        commit bim transaction in (the address of (editor's documentValue))
        set cornerCount to the length of (chained's corners's values)
        leave bim editor boundary sketch in editor
        select bim editor crop of view viewId in editor
        if outlined:
            set editor's message to ((the string form of "Crop region finished: an outline of ") + (the string form of cornerCount)) + (the string form of " corners")
        else:
            set editor's message to the string form of "Crop region finished: a rectangle"

# View `copyId`, a duplicate of view `sourceId`, takes its crop's outline
# with its arcs, and whether its frame shows.
function copy bim crop of view {a 64 bit integer:sourceId} to view {a 64 bit integer:copyId} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        copy bim crop outline of view sourceId to view copyId in target
        set sourceSpans to the bim boundary spans of sourceId in (@intrinsic("dereference", target))
        keep bim boundary spans sourceSpans of copyId in target
        free sourceSpans

# A click on a crop row of the properties: cropped or not (refused when the
# view never had a crop: CV draws one), or its frame shown or hidden.
function start bim editor crop property {integer:code} in {a pointer to a bim editor record:editor}:
    execute:
        if (code != bim crop view property) and (code != bim crop region property):
            return false
        set editor's propertyCode to -1
        set target to the address of (editor's documentValue's current)
        set viewId to the bim properties view of (@intrinsic("dereference", editor))
        set viewFound to the bim view index of viewId in (@intrinsic("dereference", target))
        if viewFound's valid = false:
            return true
        set viewValue to the item at viewFound's position in (target's views's values)
        if code = bim crop region property:
            set hiding to (bim crop view viewId is hidden in (@intrinsic("dereference", target))) = false
            begin bim transaction in (the address of (editor's documentValue))
            set bim setting (bim crop hidden setting) of viewId to (1 as a 64 bit integer) keeping hiding in target
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Crop region shown"
            if hiding:
                set editor's cropViewId to the bim refused id
                set editor's message to the string form of "Crop region hidden; the view stays cropped"
            return true
        if (viewValue's cropped = false) and (((viewValue's cropHigh's x - viewValue's cropLow's x) < 0.01) or ((viewValue's cropHigh's y - viewValue's cropLow's y) < 0.01)):
            set editor's message to the string form of "Crop view: this view has no crop region yet; CV draws one"
            return true
        set viewValue's cropped to viewValue's cropped = false
        begin bim transaction in (the address of (editor's documentValue))
        store bim view viewValue in target
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to (the string form of "Uncropped ") + viewValue's name
        if viewValue's cropped:
            set editor's message to (the string form of "Cropped ") + viewValue's name
        return true
