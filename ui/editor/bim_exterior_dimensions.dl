# SPDX-License-Identifier: MPL-2.0
# Exterior dimension chains, as a Dutch floor plan has them along every
# facade ("maatvoering buitenwerks"): outside the facade's outer face, from
# corner to corner of the whole facade, however many walls in line make it
# up (a gable split into two walls is one facade),
# - the openings: every window and door edge in the facade;
# - the walls: the faces of the inner walls that meet it;
# - the whole: the outer corners alone.
# Each step of a chain is an ordinary dimension between two features (a
# wall face, a wall end, an opening edge), so the chains follow the model
# when a wall or an opening moves. The chains lie 8, 14 and 20 mm off the
# outer face on paper, whatever the scale of the view that draws them.
# A storey without outer walls (a structural plan of columns and beams)
# gets chains between the grids instead (`add bim grid dimensions`).
import ui/editor/bim_editor_core.dl

# How far outside the outer face the three chains lie, in millimetres on
# paper.
function bim exterior chain offset {integer:chainIndex}:
    execute:
        if chainIndex = 0:
            return 8.0
        if chainIndex = 1:
            return 14.0
        return 20.0

# A feature of a chain: its reference and where it lies along the facade.
class:
    patterns:
        [a|] bim chain stop record
    members:
        reference as a bim reference record
        along as a 64 bit floating-point number

local function a bim chain stop of {a 64 bit integer:elementId} feature {integer:featureCode} at {a 64 bit floating-point number:station}:
    execute:
        return @intrinsic("construct", a bim chain stop record, @intrinsic("construct", a bim reference record, elementId, featureCode), station)

local function the bim dot of {cad vector2:first} and {cad vector2:second}:
    execute:
        return (first's x * second's x) + (first's y * second's y)

# Where feature `featureCode` of element `elementId` lies along the line from
# `origin` in direction `along`; not a number when it does not resolve.
local function the bim station of {a 64 bit integer:elementId} feature {integer:featureCode} from {cad vector2:origin} along {cad vector2:alongDir} in {bim model record:modelValue} using {bim join index record:index}:
    execute:
        set anchor to the bim feature of (@intrinsic("construct", a bim reference record, elementId, featureCode)) in modelValue using index
        if anchor's valid = false:
            return 0.0 / 0.0
        return the bim dot of (the cad difference of anchor's origin and origin) and alongDir

# Whether the ray from `origin` along `heading` meets wall `wallValue`'s
# centreline within 100 m.
local function the bim ray from {cad vector2:origin} heading {cad vector2:heading} meets {bim wall record:wallValue}:
    execute:
        set run to the cad difference of wallValue's finish and wallValue's start
        set denominator to (heading's x * run's y) - (heading's y * run's x)
        if (the absolute value of denominator) < 1e-12:
            return false
        set offsetX to wallValue's start's x - origin's x
        set offsetY to wallValue's start's y - origin's y
        set rayReach to ((offsetX * run's y) - (offsetY * run's x)) / denominator
        set segmentReach to ((offsetX * heading's y) - (offsetY * heading's x)) / denominator
        return ((rayReach > 0.0) and (rayReach < 100.0)) and ((segmentReach >= 0.0) and (segmentReach <= 1.0))

# Whether the plans hold a dimension from `first` to `second` standing
# `paperMillimetres` off already (a section's dimensions are its own).
local function bim plans measure from {bim reference record:first} to {bim reference record:second} at {a 64 bit floating-point number:paperMillimetres} in {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's dimensions's values):
            set kept to the item at cursor in (modelValue's dimensions's values)
            if (kept's viewId = the bim refused id) and ((the absolute value of (kept's paperOffset - paperMillimetres)) < 0.001):
                if ((kept's first's elementId = first's elementId) and (kept's first's feature = first's feature)) and ((kept's second's elementId = second's elementId) and (kept's second's feature = second's feature)):
                    return true
        return false

# Whether the plans dimension a grid line (the chains between the grids).
local function bim plans measure the grids in {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's dimensions's values):
            set kept to the item at cursor in (modelValue's dimensions's values)
            if (kept's viewId = the bim refused id) and (kept's first's feature = bim grid line feature):
                return true
        return false

# Whether the plan of level `levelId` holds a dimension from one of its
# walls or their openings (the chains along its outer walls).
local function bim plans measure the walls of level {a 64 bit integer:levelId} in {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's dimensions's values):
            set kept to the item at cursor in (modelValue's dimensions's values)
            if kept's viewId = the bim refused id:
                set hostId to kept's first's elementId
                set openingFound to the bim opening index of hostId in modelValue
                if openingFound's valid:
                    set hostId to (the item at openingFound's position in (modelValue's openings's values))'s hostId
                set wallFound to the bim wall index of hostId in modelValue
                if wallFound's valid:
                    if (the item at wallFound's position in (modelValue's walls's values))'s levelId = levelId:
                        return true
        return false

# Adds the stops of `stops` in order of `along` as a chain of dimensions
# `paperMillimetres` on paper outside the face at `faceOrigin`; the number of
# dimensions made.
local function add bim chain {a pointer to a list:stops} beside {cad vector2:faceOrigin} along {cad vector2:alongDir} outward {cad vector2:outwardDir} at {a 64 bit floating-point number:paperMillimetres} to {a pointer to a bim model record:target}:
    execute:
        # Sorted by `along` (insertion: the chains are short).
        set count to the length of stops
        loop outer from 1 to count:
            set inner to outer
            loop while inner > 0:
                set before to the item at (inner - 1) in stops
                set here to the item at inner in stops
                if before's along > here's along:
                    replace item at index (inner - 1) in stops with here
                    replace item at index inner in stops with before
                    set inner to inner - 1
                else:
                    set inner to 0
        set made to 0
        loop cursor from 1 to count:
            set fromStop to the item at (cursor - 1) in stops
            set ontoStop to the item at cursor in stops
            if (ontoStop's along - fromStop's along) > 0.005:
                set middle to (fromStop's along + ontoStop's along) * 0.5
                set base to the cad sum of faceOrigin and (alongDir scaled by middle)
                # One that stands there already is not made twice.
                if (bim plans measure from fromStop's reference to ontoStop's reference at paperMillimetres in (@intrinsic("dereference", target))) = false:
                    ignore add bim dimension from fromStop's reference to ontoStop's reference through base outward outwardDir at paperMillimetres paper millimetres to target
                    set made to made + 1
        return made

# An outer wall of a storey and the facade it stands in: its outer side
# `outward`, its outer face `face` (that face's distance from the origin
# along `outward`), the reach `low` to `high` of its centreline along the
# facade (`the bim facade direction of`), and the facade's number once the
# walls are grouped (-1 before).
class:
    patterns:
        [a|] bim outer wall record
    members:
        wallValue as a bim wall record
        outward as a cad vector2
        face as a 64 bit floating-point number
        low as a 64 bit floating-point number
        high as a 64 bit floating-point number
        halfThick as a 64 bit floating-point number
        facadeIndex as an integer

# The direction along a facade whose outer side is `outwardDir`: a quarter
# turn anticlockwise, so that walls in line run the same way whichever way
# they were drawn.
local function the bim facade direction of {cad vector2:outwardDir}:
    execute:
        return a cad vector2 with x (0.0 - outwardDir's y) and y outwardDir's x

# Whether outer walls `first` and `second` stand in one facade: the same
# outer side, the same outer face within 20 mm, and touching or overlapping
# along it (within their half thicknesses and 50 mm, as walls meeting end
# to end, or at a wall between them, leave).
local function bim outer wall {bim outer wall record:first} lines up with {bim outer wall record:second}:
    execute:
        if (the bim dot of first's outward and second's outward) < 0.9999:
            return false
        if (the absolute value of (first's face - second's face)) > 0.02:
            return false
        set slack to (first's halfThick + second's halfThick) + 0.05
        return (first's low <= (second's high + slack)) and (second's low <= (first's high + slack))

# The three chains along every facade of straight outer walls on level
# `levelId`; the number of dimensions made.
function add bim exterior dimensions on level {a 64 bit integer:levelId} to {a pointer to a bim model record:target}:
    execute:
        set modelValue to @intrinsic("dereference", target)
        set index to the bim join index of modelValue
        set storeyWalls to an empty list of a bim wall record
        set centreX to 0.0
        set centreY to 0.0
        loop cursor from 0 to the length of (modelValue's walls's values):
            set wallValue to the item at cursor in (modelValue's walls's values)
            if (wallValue's levelId = levelId) and (wallValue's bulge = 0.0):
                append wallValue to storeyWalls
                set centreX to centreX + ((wallValue's start's x + wallValue's finish's x) * 0.5)
                set centreY to centreY + ((wallValue's start's y + wallValue's finish's y) * 0.5)
        set wallCount to the length of storeyWalls
        if wallCount = 0:
            free storeyWalls
            return 0
        set centre to a cad vector2 with x (centreX / (wallCount as a 64 bit floating-point number)) and y (centreY / (wallCount as a 64 bit floating-point number))
        set outerWalls to an empty list of a bim outer wall record
        loop wallCursor from 0 to wallCount:
            set outerWall to the item at wallCursor in storeyWalls
            set run to the cad difference of outerWall's finish and outerWall's start
            set span to the square root of ((run's x * run's x) + (run's y * run's y))
            if span >= 0.5:
                set alongDir to a cad vector2 with x (run's x / span) and y (run's y / span)
                set outwardDir to a cad vector2 with x (0.0 - alongDir's y) and y alongDir's x
                set middle to a cad vector2 with x ((outerWall's start's x + outerWall's finish's x) * 0.5) and y ((outerWall's start's y + outerWall's finish's y) * 0.5)
                if (the bim dot of outwardDir and (the cad difference of middle and centre)) < 0.0:
                    set outwardDir to a cad vector2 with x (0.0 - outwardDir's x) and y (0.0 - outwardDir's y)
                set halfThick to (the bim wall thickness of outerWall in modelValue) * 0.5
                # Outer: nothing stands beyond its outer face.
                set probe to the cad sum of middle and (outwardDir scaled by (halfThick + 0.01))
                set covered to false
                loop otherCursor from 0 to wallCount:
                    if otherCursor != wallCursor:
                        if the bim ray from probe heading outwardDir meets (the item at otherCursor in storeyWalls):
                            set covered to true
                if covered = false:
                    set facadeDir to the bim facade direction of outwardDir
                    set startAlong to the bim dot of outerWall's start and facadeDir
                    set finishAlong to the bim dot of outerWall's finish and facadeDir
                    set faceDistance to (the bim dot of outerWall's start and outwardDir) + halfThick
                    append (@intrinsic("construct", a bim outer wall record, outerWall, outwardDir, faceDistance, the minimum of startAlong and finishAlong, the maximum of startAlong and finishAlong, halfThick, -1)) to outerWalls
        # The facades: outer walls in line, each grown from a wall not yet in
        # one until no other wall lines up with a wall in it.
        set outerCount to the length of outerWalls
        set facadeCount to 0
        loop seedCursor from 0 to outerCount:
            set seed to the item at seedCursor in outerWalls
            if seed's facadeIndex < 0:
                set seed's facadeIndex to facadeCount
                replace item at index seedCursor in outerWalls with seed
                set growing to true
                loop while growing:
                    set growing to false
                    loop joinCursor from 0 to outerCount:
                        set joining to the item at joinCursor in outerWalls
                        if joining's facadeIndex < 0:
                            loop memberCursor from 0 to outerCount:
                                set inFacade to the item at memberCursor in outerWalls
                                if (inFacade's facadeIndex = facadeCount) and (joining's facadeIndex < 0):
                                    if bim outer wall inFacade lines up with joining:
                                        set joining's facadeIndex to facadeCount
                                        replace item at index joinCursor in outerWalls with joining
                                        set growing to true
                set facadeCount to facadeCount + 1
        set total to 0
        loop facadeCursor from 0 to facadeCount:
            set facadeWalls to an empty list of a bim outer wall record
            loop memberCursor from 0 to outerCount:
                if (the item at memberCursor in outerWalls)'s facadeIndex = facadeCursor:
                    append (the item at memberCursor in outerWalls) to facadeWalls
            set total to total + (add bim exterior chains of facade facadeWalls within storeyWalls in modelValue using index to target)
            free facadeWalls
        free outerWalls
        free storeyWalls
        return total

# The chains of the facade of outer walls `facadeWalls` (`bim outer wall
# record`s in line, at least one).
local function add bim exterior chains of facade {a pointer to a list:facadeWalls} within {a pointer to a list:storeyWalls} in {bim model record:modelValue} using {bim join index record:index} to {a pointer to a bim model record:target}:
    execute:
        set leading to the item at 0 in facadeWalls
        set outwardDir to leading's outward
        set alongDir to the bim facade direction of outwardDir
        set origin to leading's wallValue's start
        # The facade's own ends: the wall ends furthest along it either way,
        # unless a corner wall closes them.
        set firstStop to a bim chain stop of leading's wallValue's id feature (bim wall start feature) at (the bim station of leading's wallValue's id feature (bim wall start feature) from origin along alongDir in modelValue using index)
        set lastStop to firstStop
        loop memberCursor from 0 to the length of facadeWalls:
            set facadeWall to the item at memberCursor in facadeWalls
            set endFeatures to an empty list of an integer
            append (bim wall start feature) to endFeatures
            append (bim wall finish feature) to endFeatures
            loop endCursor from 0 to 2:
                set endFeature to the item at endCursor in endFeatures
                set endStop to a bim chain stop of facadeWall's wallValue's id feature endFeature at (the bim station of facadeWall's wallValue's id feature endFeature from origin along alongDir in modelValue using index)
                if endStop's along < firstStop's along:
                    set firstStop to endStop
                if endStop's along > lastStop's along:
                    set lastStop to endStop
            free endFeatures
        set lowest to firstStop's along
        set highest to lastStop's along
        set wallStops to an empty list of a bim chain stop record
        loop cursor from 0 to the length of storeyWalls:
            set otherWall to the item at cursor in storeyWalls
            set otherRun to the cad difference of otherWall's finish and otherWall's start
            set otherSpan to the square root of ((otherRun's x * otherRun's x) + (otherRun's y * otherRun's y))
            if otherSpan > 1e-6:
                set crossing to the absolute value of ((the bim dot of otherRun and alongDir) / otherSpan)
                if crossing < 0.1:
                    # A wall square to the facade meets it where one of its
                    # ends lies within reach of one of the facade's walls.
                    set otherHalf to (the bim wall thickness of otherWall in modelValue) * 0.5
                    set touching to false
                    set touchAt to 0.0
                    set touchReach to 0.0
                    set otherEnds to an empty list of a cad vector2
                    append otherWall's start to otherEnds
                    append otherWall's finish to otherEnds
                    loop memberCursor from 0 to the length of facadeWalls:
                        set facadeWall to the item at memberCursor in facadeWalls
                        set wallStart to facadeWall's wallValue's start
                        set reach to (facadeWall's halfThick + otherHalf) + 0.02
                        set wallAlong to the bim dot of (the cad difference of facadeWall's wallValue's finish and wallStart) and alongDir
                        set reachLow to (the minimum of 0.0 and wallAlong) - reach
                        set reachHigh to (the maximum of 0.0 and wallAlong) + reach
                        loop endCursor from 0 to 2:
                            set endPoint to the item at endCursor in otherEnds
                            set across to the bim dot of (the cad difference of endPoint and wallStart) and outwardDir
                            set ownStation to the bim dot of (the cad difference of endPoint and wallStart) and alongDir
                            if ((the absolute value of across) <= reach) and ((ownStation >= reachLow) and (ownStation <= reachHigh)):
                                set touching to true
                                set touchAt to the bim dot of (the cad difference of endPoint and origin) and alongDir
                                set touchReach to reach
                    free otherEnds
                    if touching:
                        set nearFace to a bim chain stop of otherWall's id feature (bim wall exterior feature) at (the bim station of otherWall's id feature (bim wall exterior feature) from origin along alongDir in modelValue using index)
                        set farFace to a bim chain stop of otherWall's id feature (bim wall interior feature) at (the bim station of otherWall's id feature (bim wall interior feature) from origin along alongDir in modelValue using index)
                        if farFace's along < nearFace's along:
                            set swapped to nearFace
                            set nearFace to farFace
                            set farFace to swapped
                        if touchAt <= (lowest + touchReach):
                            # A corner at the facade's start: its outer face.
                            set firstStop to nearFace
                        else if touchAt >= (highest - touchReach):
                            set lastStop to farFace
                        else:
                            append nearFace to wallStops
                            append farFace to wallStops
        set openingStops to an empty list of a bim chain stop record
        loop cursor from 0 to the length of (modelValue's openings's values):
            set openingValue to the item at cursor in (modelValue's openings's values)
            set hosted to false
            loop memberCursor from 0 to the length of facadeWalls:
                if openingValue's hostId = (the item at memberCursor in facadeWalls)'s wallValue's id:
                    set hosted to true
            if hosted:
                append (a bim chain stop of openingValue's id feature (bim opening left feature) at (the bim station of openingValue's id feature (bim opening left feature) from origin along alongDir in modelValue using index)) to openingStops
                append (a bim chain stop of openingValue's id feature (bim opening right feature) at (the bim station of openingValue's id feature (bim opening right feature) from origin along alongDir in modelValue using index)) to openingStops
        set faceOrigin to the cad sum of origin and (outwardDir scaled by leading's halfThick)
        set made to 0
        if (the length of openingStops) > 0:
            append firstStop to openingStops
            append lastStop to openingStops
            set made to made + (add bim chain openingStops beside faceOrigin along alongDir outward outwardDir at (bim exterior chain offset 0) to target)
        if (the length of wallStops) > 0:
            append firstStop to wallStops
            append lastStop to wallStops
            set made to made + (add bim chain wallStops beside faceOrigin along alongDir outward outwardDir at (bim exterior chain offset 1) to target)
        set wholeStops to an empty list of a bim chain stop record
        append firstStop to wholeStops
        append lastStop to wholeStops
        set made to made + (add bim chain wholeStops beside faceOrigin along alongDir outward outwardDir at (bim exterior chain offset 2) to target)
        free wholeStops
        free openingStops
        free wallStops
        return made

# Chains between the grids ("stramienmaten"), as a structural plan of
# columns and beams has them where no outer wall gives a facade to
# dimension. Per family of parallel grids with more than one line, beyond
# the ends the lines begin at (below lines that run up the sheet, left of
# lines that run across it):
# - the bays: from grid to grid, 8 mm on paper off those ends;
# - the whole: the outermost grids, 14 mm off, when there are several bays.
# Each step is an ordinary dimension between two grid lines, so the chains
# follow the grids. The number of dimensions made.
function add bim grid dimensions to {a pointer to a bim model record:target}:
    execute:
        set modelValue to @intrinsic("dereference", target)
        set gridCount to the length of (modelValue's grids's values)
        # Each grid's direction, turned to point right (up when it runs
        # straight up) so that lines drawn either way are parallel, and its
        # family (-1 before, and for a grid without length).
        set gridHeadings to an empty list of a cad vector2
        set gridFamilies to an empty list of an integer
        loop cursor from 0 to gridCount:
            set gridValue to the item at cursor in (modelValue's grids's values)
            set gridRun to the cad distance from gridValue's start to gridValue's finish
            set gridHeading to a cad vector2 with x 0.0 and y 0.0
            if gridRun > 1e-9:
                set gridHeading to a cad vector2 with x ((gridValue's finish's x - gridValue's start's x) / gridRun) and y ((gridValue's finish's y - gridValue's start's y) / gridRun)
                if (gridHeading's x < -1e-9) or (((the absolute value of gridHeading's x) <= 1e-9) and (gridHeading's y < 0.0)):
                    set gridHeading to a cad vector2 with x (0.0 - gridHeading's x) and y (0.0 - gridHeading's y)
            append gridHeading to gridHeadings
            append -1 to gridFamilies
        set familyHeadings to an empty list of a cad vector2
        loop seedCursor from 0 to gridCount:
            set seedHeading to the item at seedCursor in gridHeadings
            if ((the item at seedCursor in gridFamilies) < 0) and ((the bim dot of seedHeading and seedHeading) > 0.5):
                loop memberCursor from seedCursor to gridCount:
                    set memberHeading to the item at memberCursor in gridHeadings
                    set skew to (seedHeading's x * memberHeading's y) - (seedHeading's y * memberHeading's x)
                    if ((the item at memberCursor in gridFamilies) < 0) and (((the bim dot of seedHeading and memberHeading) > 0.5) and ((the absolute value of skew) < 1e-6)):
                        replace item at index memberCursor in gridFamilies with ((the length of familyHeadings) as an integer)
                append seedHeading to familyHeadings
        set total to 0
        loop familyCursor from 0 to the length of familyHeadings:
            set lineDir to the item at familyCursor in familyHeadings
            set outwardDir to a cad vector2 with x (0.0 - lineDir's x) and y (0.0 - lineDir's y)
            set alongDir to the bim facade direction of outwardDir
            # The face the chains stand off: through the lowest end of the
            # family's lines.
            set lowEnd to 1e300
            set gridStops to an empty list of a bim chain stop record
            loop cursor from 0 to gridCount:
                if (the item at cursor in gridFamilies) = familyCursor:
                    set gridValue to the item at cursor in (modelValue's grids's values)
                    set lowEnd to the minimum of lowEnd and (the minimum of (the bim dot of gridValue's start and lineDir) and (the bim dot of gridValue's finish and lineDir))
                    append (a bim chain stop of gridValue's id feature (bim grid line feature) at (the bim dot of gridValue's start and alongDir)) to gridStops
            if (the length of gridStops) > 1:
                set faceOrigin to lineDir scaled by lowEnd
                set bays to add bim chain gridStops beside faceOrigin along alongDir outward outwardDir at (bim exterior chain offset 0) to target
                set total to total + bays
                if bays > 1:
                    set wholeStops to an empty list of a bim chain stop record
                    append (the item at 0 in gridStops) to wholeStops
                    append (the last item of gridStops) to wholeStops
                    set total to total + (add bim chain wholeStops beside faceOrigin along alongDir outward outwardDir at (bim exterior chain offset 1) to target)
                    free wholeStops
            free gridStops
        free familyHeadings
        free gridFamilies
        free gridHeadings
        return total

# 2461 (Annotate > Exterior dimensions): the chains of the active storey, as
# one undo step. A storey without outer walls gets the chains between the
# grids instead.
function add bim editor exterior dimensions in {a pointer to a bim editor record:editor}:
    execute:
        begin bim transaction in (the address of (editor's documentValue))
        set made to add bim exterior dimensions on level editor's levelId to (the address of (editor's documentValue's current))
        if made = 0:
            # Pressed again: the chains made before stand, none is doubled.
            if bim plans measure the walls of level editor's levelId in editor's documentValue's current:
                roll back bim transaction in (the address of (editor's documentValue))
                set editor's message to the string form of "Exterior dimensions: the chains along the outer walls are there already"
                return nothing
            set gridMade to add bim grid dimensions to (the address of (editor's documentValue's current))
            if gridMade = 0:
                roll back bim transaction in (the address of (editor's documentValue))
                if bim plans measure the grids in editor's documentValue's current:
                    set editor's message to the string form of "Exterior dimensions: the chains between the grids are there already (every plan shows them)"
                else:
                    set editor's message to the string form of "Exterior dimensions: no outer walls on this storey and no parallel grids"
                return nothing
            commit bim transaction in (the address of (editor's documentValue))
            set editor's viewsDirty to true
            set editor's message to ((the string form of "Exterior dimensions: ") + (the string form of gridMade)) + (the string form of " dimensions in chains between the grids")
            return nothing
        commit bim transaction in (the address of (editor's documentValue))
        set editor's viewsDirty to true
        set editor's message to ((the string form of "Exterior dimensions: ") + (the string form of made)) + (the string form of " dimensions in chains along the outer walls")
