# SPDX-License-Identifier: MPL-2.0
# The boundary sketch: one object for the outline of every planar element, as
# Revit's sketch mode. A floor, roof or ceiling, a wall's elevation and a
# building system's face are each bounded by a closed loop of segments, each
# a line, circular arc or elliptic quarter, drawn on the element's work plane (`bim boundary plane
# record`): the plan for a plate, the vertical plane along the element for a
# wall or a building system. Tab on the element opens its sketch; Tab again
# chains the segments into one loop and gives the element that outline.
#
# An element keeps its outline as a polygon, so that everything that reads
# it (meshing, plans, areas, IFC) stays as it is; an arc becomes straight
# pieces within half a millimetre. Which corners of the polygon belong to
# which segment is kept as the element's settings (`bim boundary span
# setting`): the number of polygon edges each segment spans, one for a line;
# a negative count identifies an elliptic quarter.
# Opening the sketch again finds every arc back through its two ends and the
# polygon's corner at its middle, wherever the element has been moved,
# turned or mirrored since.
import elements/planar/bim_evaluate.dl
import architectural/stairs/bim_stair.dl

# A segment of a boundary sketch, in the work plane's coordinates: a line
# from `start` to `finish`, or, when `bulge` is not 0, the arc over that
# chord whose middle lies `bulge` metres off the chord's middle to its right
# (left when negative), as a curved wall's. An elliptic quarter instead uses
# `centre` and the two endpoint vectors as its affine axes; its bulge is zero.
class:
    patterns:
        [a|] bim boundary segment record
    members:
        start as a cad vector2
        finish as a cad vector2
        bulge as a 64 bit floating-point number
        elliptic as a boolean
        centre as a cad vector2

function the bim boundary line from {cad vector2:fromPoint} to {cad vector2:toPoint}:
    execute:
        return @intrinsic("construct", a bim boundary segment record, fromPoint, toPoint, 0.0, false, fromPoint)

function the bim boundary arc from {cad vector2:fromPoint} to {cad vector2:toPoint} bulging {a 64 bit floating-point number:rise}:
    execute:
        return @intrinsic("construct", a bim boundary segment record, fromPoint, toPoint, rise, false, fromPoint)

# Move selected endpoints; callers apply this to every incident segment.
function the bim boundary segment {bim boundary segment record:piece} moving endpoints {cad vector2:firstPoint} and {cad vector2:lastPoint} by {cad vector2:displacement}:
    execute:
        set movedPiece to piece
        if (bim boundary point piece's start meets firstPoint) or (bim boundary point piece's start meets lastPoint):
            set movedPiece's start to a cad vector2 with x (piece's start's x + displacement's x) and y (piece's start's y + displacement's y)
        if (bim boundary point piece's finish meets firstPoint) or (bim boundary point piece's finish meets lastPoint):
            set movedPiece's finish to a cad vector2 with x (piece's finish's x + displacement's x) and y (piece's finish's y + displacement's y)
        if piece's elliptic:
            set movedStart to (bim boundary point piece's start meets firstPoint) or (bim boundary point piece's start meets lastPoint)
            set movedFinish to (bim boundary point piece's finish meets firstPoint) or (bim boundary point piece's finish meets lastPoint)
            if movedStart and movedFinish:
                set movedPiece's centre to a cad vector2 with x (piece's centre's x + displacement's x) and y (piece's centre's y + displacement's y)
        return movedPiece

# The same curve traversed in the opposite direction.
function the bim boundary segment {bim boundary segment record:piece} reversed:
    execute:
        return @intrinsic("construct", a bim boundary segment record, piece's finish, piece's start, 0.0 - piece's bulge, piece's elliptic, piece's centre)

# The arc of a segment (see `the bim arc of` a wall); a line's is not
# `curved`.
function the bim arc of boundary segment {bim boundary segment record:piece}:
    execute:
        set chordX to piece's finish's x - piece's start's x
        set chordY to piece's finish's y - piece's start's y
        set chordLength to the square root of ((chordX * chordX) + (chordY * chordY))
        set rise to piece's bulge
        if ((the absolute value of rise) <= 1e-9) or (chordLength <= 1e-9):
            return @intrinsic("construct", a bim arc record, false, piece's start, 0.0, 0.0, 0.0)
        set halfChord to chordLength * 0.5
        set sweep to 4.0 * @intrinsic("atan2", rise, halfChord)
        set radius to ((halfChord * halfChord) + (rise * rise)) / (2.0 * (the absolute value of rise))
        set nx to chordY / chordLength
        set ny to (0.0 - chordX) / chordLength
        set side to 1.0
        if rise < 0.0:
            set side to -1.0
        set apexX to ((piece's start's x + piece's finish's x) * 0.5) + (rise * nx)
        set apexY to ((piece's start's y + piece's finish's y) * 0.5) + (rise * ny)
        set centre to a cad vector2 with x (apexX - ((side * radius) * nx)) and y (apexY - ((side * radius) * ny))
        set startAngle to @intrinsic("atan2", piece's start's y - centre's y, piece's start's x - centre's x)
        return @intrinsic("construct", a bim arc record, true, centre, radius, startAngle, sweep)

# The middle of a segment: its chord's middle moved by its bulge.
function the bim middle of boundary segment {bim boundary segment record:piece}:
    execute:
        if piece's elliptic:
            return the bim ellipse quarter point of piece at 0.5
        set chordX to piece's finish's x - piece's start's x
        set chordY to piece's finish's y - piece's start's y
        set chordLength to the square root of ((chordX * chordX) + (chordY * chordY))
        set middleX to (piece's start's x + piece's finish's x) * 0.5
        set middleY to (piece's start's y + piece's finish's y) * 0.5
        if chordLength <= 1e-12:
            return a cad vector2 with x middleX and y middleY
        return a cad vector2 with x (middleX + ((piece's bulge * chordY) / chordLength)) and y (middleY - ((piece's bulge * chordX) / chordLength))

# The bulge of the arc from `fromPoint` to `toPoint` through `throughPoint`
# (Revit's three-point arc); 0 when the three lie on a line.
function the bim boundary bulge from {cad vector2:fromPoint} to {cad vector2:toPoint} through {cad vector2:throughPoint}:
    execute:
        set chordX to toPoint's x - fromPoint's x
        set chordY to toPoint's y - fromPoint's y
        set chordLength to the square root of ((chordX * chordX) + (chordY * chordY))
        if chordLength <= 1e-9:
            return 0.0
        set ux to chordX / chordLength
        set uy to chordY / chordLength
        set offsetX to throughPoint's x - ((fromPoint's x + toPoint's x) * 0.5)
        set offsetY to throughPoint's y - ((fromPoint's y + toPoint's y) * 0.5)
        # In the chord's frame: `along` it, `across` to its right.
        set along to (offsetX * ux) + (offsetY * uy)
        set across to (offsetX * uy) - (offsetY * ux)
        if (the absolute value of across) <= (chordLength * 1e-9):
            return 0.0
        set halfChord to chordLength * 0.5
        # The centre lies on the chord's bisector, `centreAcross` to its right.
        set centreAcross to (((along * along) + (across * across)) - (halfChord * halfChord)) / (2.0 * across)
        set radius to the square root of ((halfChord * halfChord) + (centreAcross * centreAcross))
        if across > 0.0:
            return centreAcross + radius
        return centreAcross - radius

# The number of straight pieces a segment becomes: 1 for a line, an even
# number for an arc, so that a corner lies at its middle.
function the bim pieces of boundary segment {bim boundary segment record:piece}:
    execute:
        if piece's elliptic:
            set radius to (the cad distance from piece's start to piece's centre) + (the cad distance from piece's finish to piece's centre)
            set count to the maximum of 4 and ((@intrinsic("ceil", 1.5707963267948966 * (the square root of (radius / 0.004)))) as an integer)
            set count to the minimum of 2048 and count
            if (the remainder of count divided by 2) = 1:
                set count to count + 1
            return count
        set arc to the bim arc of boundary segment piece
        if arc's curved = false:
            return 1
        set count to the bim pieces of arc reaching 0.0
        if (the remainder of count divided by 2) = 1:
            set count to count + 1
        return count

# Appends a segment's corners to `corners`: its start and, for an arc, the
# corners along it, not its finish (the next segment's start).
function append bim boundary corners of {bim boundary segment record:piece} into {a pointer to a list:cornerList}:
    execute:
        append piece's start to cornerList
        set count to the bim pieces of boundary segment piece
        if count < 2:
            return nothing
        set arc to the bim arc of boundary segment piece
        if piece's elliptic:
            loop step from 1 to count:
                append (the bim ellipse quarter point of piece at ((step as a 64 bit floating-point number) / (count as a 64 bit floating-point number))) to cornerList
            return nothing
        loop step from 1 to count:
            append (the bim point of arc at ((step as a 64 bit floating-point number) / (count as a 64 bit floating-point number)) offset 0.0) to cornerList

# The points a segment is drawn through, its finish included.
function the bim drawn points of boundary segment {bim boundary segment record:piece}:
    execute:
        set pointList to an empty list of a cad vector2
        append bim boundary corners of piece into pointList
        append piece's finish to pointList
        return pointList

# ---------------------------------------------------------------- one loop

# Segments chained into one closed loop: its polygon (`corners`) and the
# polygon edges each segment spans (`spans`), or why not (`message`).
class:
    patterns:
        [a|] bim boundary loop record
    members:
        valid as a boolean
        message as a string
        corners as the type of (a cad topology list of a cad vector2)
        spans as the type of (a cad topology list of an integer)

function the bim boundary tolerance:
    replacement:
        0.001

function bim boundary point {cad vector2:first} meets {cad vector2:second}:
    execute:
        return (the cad distance from first to second) <= the bim boundary tolerance

function the bim refused boundary loop because {a string:reason}:
    execute:
        return @intrinsic("construct", a bim boundary loop record, false, reason, a cad topology list of a cad vector2, a cad topology list of an integer)

# The segments `pieces` chained end to end, each turned as it must be, into
# one closed loop. Segments shorter than the tolerance are left out. Refused
# when they leave a gap, branch, or make more than one loop.
function the bim boundary loop of {a pointer to a list:pieces}:
    execute:
        set kept to an empty list of a bim boundary segment record
        loop cursor from 0 to the length of pieces:
            set piece to the item at cursor in pieces
            if (bim boundary point piece's start meets piece's finish) = false:
                append piece to kept
        set count to the length of kept
        if count < 2:
            free kept
            return the bim refused boundary loop because (the string form of "a boundary needs at least two lines or arcs that close")
        set used to an empty list of a boolean
        loop cursor from 0 to count:
            append false to used
        set ordered to an empty list of a bim boundary segment record
        append (the item at 0 in kept) to ordered
        replace item at index 0 in used with true
        set loopStart to (the item at 0 in kept)'s start
        set reached to (the item at 0 in kept)'s finish
        set searching to true
        loop while searching and ((the length of ordered) < count):
            set next to -1
            set turned to false
            loop cursor from 0 to count:
                if (next < 0) and ((the item at cursor in used) = false):
                    set candidate to the item at cursor in kept
                    if bim boundary point candidate's start meets reached:
                        set next to cursor
                    else if bim boundary point candidate's finish meets reached:
                        set next to cursor
                        set turned to true
            if next < 0:
                set searching to false
            else:
                set chosen to the item at next in kept
                if turned:
                    set chosen to the bim boundary segment chosen reversed
                replace item at index next in used with true
                append chosen to ordered
                set reached to chosen's finish
                # Back at the start with segments left: a second loop.
                if (bim boundary point reached meets loopStart) and ((the length of ordered) < count):
                    set searching to false
        set closed to bim boundary point reached meets loopStart
        set complete to (the length of ordered) = count
        free used
        if (closed = false) or (complete = false):
            set reason to the string form of "the boundary is open: its ends do not meet"
            if closed:
                set reason to the string form of "the sketch has lines or arcs besides its one closed loop"
            else if (the length of ordered) < count:
                set reason to (the string form of "the boundary is open or branches near ") + ((the string form of reached's x) + ((the string form of ", ") + (the string form of reached's y)))
            free ordered
            free kept
            return the bim refused boundary loop because reason
        set corners to a cad topology list of a cad vector2
        set spans to a cad topology list of an integer
        loop cursor from 0 to count:
            set piece to the item at cursor in ordered
            append bim boundary corners of piece into (corners's values)
            set pieceCount to the bim pieces of boundary segment piece
            if piece's elliptic:
                set pieceCount to 0 - pieceCount
            append pieceCount to (spans's values)
        free ordered
        free kept
        return @intrinsic("construct", a bim boundary loop record, true, the string form of "", corners, spans)

# The segments of a polygon `corners` whose edges segments span as `spans`
# says (see `the bim boundary loop of`): each arc through its ends and the
# corner at its middle. Without spans that cover the polygon, one line per
# edge.
function the bim boundary segments of {a pointer to a list:corners} spanned {a pointer to a list:spans}:
    execute:
        set found to a cad topology list of a bim boundary segment record
        set count to the length of corners
        if count < 2:
            return found
        set covered to 0
        set usable to (the length of spans) > 0
        loop cursor from 0 to the length of spans:
            set span to the item at cursor in spans
            if span = 0:
                set usable to false
            set covered to covered + (the absolute value of span)
        if covered != count:
            set usable to false
        if usable = false:
            loop cursor from 0 to count:
                append (the bim boundary line from (the item at cursor in corners) to (the item at (the remainder of (cursor + 1) divided by count) in corners)) to (found's values)
            return found
        set first to 0
        loop cursor from 0 to the length of spans:
            set span to the item at cursor in spans
            set elliptic to span < 0
            set span to the absolute value of span
            set fromPoint to the item at first in corners
            set toPoint to the item at (the remainder of (first + span) divided by count) in corners
            if elliptic and ((the remainder of span divided by 2) = 0):
                set middle to the item at (first + (span / 2)) in corners
                set factor to 0.7071067811865476
                set centre to a cad vector2 with x ((middle's x - ((fromPoint's x + toPoint's x) * factor)) / (1.0 - (2.0 * factor))) and y ((middle's y - ((fromPoint's y + toPoint's y) * factor)) / (1.0 - (2.0 * factor)))
                append (the bim boundary ellipse quarter from fromPoint to toPoint around centre) to (found's values)
            else if span < 2:
                append (the bim boundary line from fromPoint to toPoint) to (found's values)
            else:
                set middle to the item at (first + (span / 2)) in corners
                append (the bim boundary arc from fromPoint to toPoint bulging (the bim boundary bulge from fromPoint to toPoint through middle)) to (found's values)
            set first to first + span
        return found

# ---------------------------------------------------------------- kept with the element

# The settings that keep a boundary's spans: segment `n` at the setting
# 1400000 plus `n`, its value the polygon edges it spans. An element whose
# boundary is all lines keeps none.
function bim boundary span setting:
    replacement:
        1400000

function bim boundary span setting limit:
    replacement:
        1500000

# The spans element `elementId` keeps, in order; empty when it keeps none.
function the bim boundary spans of {a 64 bit integer:elementId} in {bim model record:modelValue}:
    execute:
        set found to an empty list of an integer
        set slot to 0
        set reading to true
        loop while reading:
            set stored to the bim setting ((bim boundary span setting) + slot) of elementId in modelValue
            if stored's found:
                append (stored's value as an integer) to found
                set slot to slot + 1
            else:
                set reading to false
        return found

# Element `elementId` keeps `spans` (none when every segment is a line).
function keep bim boundary spans {a pointer to a list:spanList} of {a 64 bit integer:elementId} in {a pointer to a bim model record:target}:
    execute:
        set cursor to (the length of (target's settings's values)) - 1
        loop while cursor >= 0:
            set entry to the item at cursor in (target's settings's values)
            if (entry's elementId = elementId) and ((entry's code >= bim boundary span setting) and (entry's code < bim boundary span setting limit)):
                remove item cursor from (target's settings's values)
            set cursor to cursor - 1
        set curved to false
        loop cursor from 0 to the length of spanList:
            if (the absolute value of (the item at cursor in spanList)) > 1:
                set curved to true
        if curved and ((the length of spanList) < ((bim boundary span setting limit) - (bim boundary span setting))):
            loop cursor from 0 to the length of spanList:
                set bim setting ((bim boundary span setting) + cursor) of elementId to ((the item at cursor in spanList) as a 64 bit integer) keeping true in target
        note bim change of elementId in target

# The boundary sketch of plate `slabId`: its outline's segments, in the plan.
function the bim boundary segments of slab {a 64 bit integer:slabId} in {bim model record:modelValue}:
    execute:
        set found to the bim slab index of slabId in modelValue
        if found's valid = false:
            return a cad topology list of a bim boundary segment record
        set slabValue to the item at found's position in (modelValue's slabs's values)
        set spans to the bim boundary spans of slabId in modelValue
        set sketchSegments to the bim boundary segments of (slabValue's outline's values) spanned spans
        free spans
        return sketchSegments

# Plate `slabId` takes the loop of `pieces` as its outline, keeping its
# arcs. Returns why not, or an empty text.
function set bim slab {a 64 bit integer:slabId} boundary to {a pointer to a list:pieces} in {a pointer to a bim model record:target}:
    execute:
        set chained to the bim boundary loop of pieces
        if chained's valid = false:
            return chained's message
        if (set bim slab slabId outline to (chained's corners's values) in target) = false:
            return the string form of "the boundary crosses itself"
        keep bim boundary spans (chained's spans's values) of slabId in target
        return the string form of ""

# The signed area of polygon `corners`: positive counter-clockwise.
function the bim signed area of {a pointer to a list:corners}:
    execute:
        set twice to 0.0
        set count to the length of corners
        loop cursor from 0 to count:
            set here to the item at cursor in corners
            set next to the item at (the remainder of (cursor + 1) divided by count) in corners
            set twice to twice + ((here's x * next's y) - (next's x * here's y))
        return twice * 0.5

# The loop of `pieces` run anticlockwise.
function the bim anticlockwise boundary loop of {a pointer to a list:pieces}:
    execute:
        set chained to the bim boundary loop of pieces
        if (chained's valid = false) or ((the bim signed area of (chained's corners's values)) >= 0.0):
            return chained
        set turned to an empty list of a bim boundary segment record
        set cursor to (the length of pieces) - 1
        loop while cursor >= 0:
            append (the bim boundary segment (the item at cursor in pieces) reversed) to turned
            set cursor to cursor - 1
        set rechained to the bim boundary loop of turned
        free turned
        return rechained

# The boundary sketch of building system `curtainId`: its face's outline (its
# contour, or its rectangle) as segments, in face coordinates (metres along
# its line, up its face).
function the bim boundary segments of system {a 64 bit integer:curtainId} in {bim model record:modelValue}:
    execute:
        set found to the bim curtain index of curtainId in modelValue
        if found's valid = false:
            return a cad topology list of a bim boundary segment record
        set faceOutline to the bim face outline of (the item at found's position in (modelValue's curtains's values)) in modelValue
        set spans to the bim boundary spans of curtainId in modelValue
        set sketchSegments to the bim boundary segments of faceOutline spanned spans
        free spans
        free faceOutline
        return sketchSegments

# Building system `curtainId` takes the loop of `pieces` (in face
# coordinates) as its contour, keeping its arcs; it rises to the contour's
# top. A loop that is its rectangle leaves it without a contour. Returns why
# not, or an empty text.
function set bim system {a 64 bit integer:curtainId} boundary to {a pointer to a list:pieces} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim curtain index of curtainId in (@intrinsic("dereference", target))
        if found's valid = false:
            return the string form of "the building system is gone"
        set chained to the bim anticlockwise boundary loop of pieces
        if chained's valid = false:
            return chained's message
        if (bim outline (chained's corners's values) is simple) = false:
            return the string form of "the contour crosses itself"
        set curtainValue to the item at found's position in (target's curtains's values)
        set wallLength to the bim system length of curtainValue
        set top to 0.0
        loop cursor from 0 to the length of (chained's corners's values):
            set corner to the item at cursor in (chained's corners's values)
            if ((corner's x < -0.001) or (corner's x > (wallLength + 0.001))) or (corner's y < -0.001):
                return the string form of "keep the contour between the system's ends and above its foot"
            set top to the maximum of top and corner's y
        if top < 0.5:
            return the string form of "the contour is lower than half a metre"
        if (the absolute value of (top - curtainValue's height)) > 0.0005:
            if (set bim curtain wall curtainId height to top in target) = false:
                return the string form of "the system cannot rise to the contour's top"
        # Its own rectangle: no contour.
        set rectangle to (the length of (chained's corners's values)) = 4
        if rectangle:
            loop cursor from 0 to 4:
                set corner to the item at cursor in (chained's corners's values)
                set onSide to ((the absolute value of corner's x) < 0.001) or ((the absolute value of (corner's x - wallLength)) < 0.001)
                set onEnd to ((the absolute value of corner's y) < 0.001) or ((the absolute value of (corner's y - top)) < 0.001)
                if (onSide and onEnd) = false:
                    set rectangle to false
        if rectangle:
            set noCorners to an empty list of a cad vector2
            set noSpans to an empty list of an integer
            keep bim face contour noCorners of curtainId in target
            keep bim boundary spans noSpans of curtainId in target
            free noCorners
            free noSpans
            return the string form of ""
        keep bim face contour (chained's corners's values) of curtainId in target
        keep bim boundary spans (chained's spans's values) of curtainId in target
        return the string form of ""

# The boundary sketch of wall `wallId`: its profile (its contour, or the
# rectangle of its length from its foot to its top) as segments, in metres
# along it and up from its storey.
function the bim boundary segments of wall {a 64 bit integer:wallId} in {bim model record:modelValue}:
    execute:
        set found to the bim wall index of wallId in modelValue
        if found's valid = false:
            return a cad topology list of a bim boundary segment record
        set wallValue to the item at found's position in (modelValue's walls's values)
        set faceOutline to the bim face contour of wallId in modelValue
        if (the length of faceOutline) < 3:
            free faceOutline
            set faceOutline to an empty list of a cad vector2
            set wallLength to the bim centreline length of wallValue
            set top to wallValue's baseOffset + wallValue's height
            append (a cad vector2 with x 0.0 and y wallValue's baseOffset) to faceOutline
            append (a cad vector2 with x wallLength and y wallValue's baseOffset) to faceOutline
            append (a cad vector2 with x wallLength and y top) to faceOutline
            append (a cad vector2 with x 0.0 and y top) to faceOutline
        set spans to the bim boundary spans of wallId in modelValue
        set sketchSegments to the bim boundary segments of faceOutline spanned spans
        free spans
        free faceOutline
        return sketchSegments

# Wall `wallId` takes the loop of `pieces` (along it, up from its storey) as
# its profile, keeping its arcs: its foot and top go to the profile's lowest
# and highest points, and it is cut to the profile. A loop that is its
# rectangle leaves it without a contour. A curved, leaning or bowed wall
# keeps its rectangle. Returns why not, or an empty text.
function set bim wall {a 64 bit integer:wallId} boundary to {a pointer to a list:pieces} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim wall index of wallId in (@intrinsic("dereference", target))
        if found's valid = false:
            return the string form of "the wall is gone"
        set wallValue to the item at found's position in (target's walls's values)
        if ((wallValue's bulge != 0.0) or (wallValue's lean != 0.0)) or (wallValue's rise != 0.0):
            return the string form of "a curved, leaning or bowed wall keeps its rectangle"
        set chained to the bim anticlockwise boundary loop of pieces
        if chained's valid = false:
            return chained's message
        if (bim outline (chained's corners's values) is simple) = false:
            return the string form of "the profile crosses itself"
        set wallLength to the bim centreline length of wallValue
        set low to 1.0 / 0.0
        set top to 0.0 - (1.0 / 0.0)
        loop cursor from 0 to the length of (chained's corners's values):
            set corner to the item at cursor in (chained's corners's values)
            if (corner's x < -0.001) or (corner's x > (wallLength + 0.001)):
                return the string form of "keep the profile between the wall's ends"
            set low to the minimum of low and corner's y
            set top to the maximum of top and corner's y
        if (top - low) < 0.1:
            return the string form of "the profile is lower than 10 cm"
        if ((the absolute value of (low - wallValue's baseOffset)) > 0.0005) or ((the absolute value of ((top - low) - wallValue's height)) > 0.0005):
            if (set bim wall wallId base to low and height to (top - low) in target) = false:
                return the string form of "the wall cannot take the profile's foot and top"
        set rectangle to (the length of (chained's corners's values)) = 4
        if rectangle:
            loop cursor from 0 to 4:
                set corner to the item at cursor in (chained's corners's values)
                set onSide to ((the absolute value of corner's x) < 0.001) or ((the absolute value of (corner's x - wallLength)) < 0.001)
                set onEnd to ((the absolute value of (corner's y - low)) < 0.001) or ((the absolute value of (corner's y - top)) < 0.001)
                if (onSide and onEnd) = false:
                    set rectangle to false
        set noSpans to an empty list of an integer
        if rectangle:
            set noCorners to an empty list of a cad vector2
            keep bim face contour noCorners of wallId in target
            keep bim boundary spans noSpans of wallId in target
            free noCorners
        else:
            keep bim face contour (chained's corners's values) of wallId in target
            keep bim boundary spans (chained's spans's values) of wallId in target
        free noSpans
        return the string form of ""

# Four analytic quarters retain the ellipse on reopening. A negative span
# distinguishes an elliptic quarter from a circular arc; old readers still
# retain the tessellated outline. Its midpoint reconstructs the affine centre
# after translation, rotation or mirroring without storing world coordinates.
function the bim boundary ellipse quarter from {cad vector2:firstPoint} to {cad vector2:lastPoint} around {cad vector2:centre}:
    execute:
        return @intrinsic("construct", a bim boundary segment record, firstPoint, lastPoint, 0.0, true, centre)

function the bim ellipse quarter point of {bim boundary segment record:piece} at {a 64 bit floating-point number:share}:
    execute:
        set turn to share * 1.5707963267948966
        set c to the cosine of turn
        set s to the sine of turn
        return a cad vector2 with x (piece's centre's x + (((piece's start's x - piece's centre's x) * c) + ((piece's finish's x - piece's centre's x) * s))) and y (piece's centre's y + (((piece's start's y - piece's centre's y) * c) + ((piece's finish's y - piece's centre's y) * s)))

function the bim boundary ellipse between {cad vector2:firstPoint} and {cad vector2:lastPoint}:
    execute:
        set pieces to a cad topology list of a bim boundary segment record
        set radiusX to (the absolute value of (lastPoint's x - firstPoint's x)) * 0.5
        set radiusY to (the absolute value of (lastPoint's y - firstPoint's y)) * 0.5
        if (radiusX < 0.001) or (radiusY < 0.001):
            return pieces
        set centre to a cad vector2 with x ((firstPoint's x + lastPoint's x) * 0.5) and y ((firstPoint's y + lastPoint's y) * 0.5)
        set east to a cad vector2 with x (centre's x + radiusX) and y centre's y
        set north to a cad vector2 with x centre's x and y (centre's y + radiusY)
        set west to a cad vector2 with x (centre's x - radiusX) and y centre's y
        set south to a cad vector2 with x centre's x and y (centre's y - radiusY)
        append (the bim boundary ellipse quarter from east to north around centre) to (pieces's values)
        append (the bim boundary ellipse quarter from north to west around centre) to (pieces's values)
        append (the bim boundary ellipse quarter from west to south around centre) to (pieces's values)
        append (the bim boundary ellipse quarter from south to east around centre) to (pieces's values)
        return pieces

# ---------------------------------------------------------------- creation tool shapes (#101)

# The unit direction of `run`, or along x when it has no length.
local function the bim unit direction of {cad vector2:run}:
    execute:
        set runLength to the square root of ((run's x * run's x) + (run's y * run's y))
        if runLength <= 1e-12:
            return a cad vector2 with x 1.0 and y 0.0
        return a cad vector2 with x (run's x / runLength) and y (run's y / runLength)

# The bulge of the arc that leaves `fromPoint` along `tangent` and ends at
# `toPoint` (the wall tool's tangent arc): 0 when `toPoint` lies straight
# ahead. Positive to the right of the chord, as every bulge here.
function the bim tangent arc bulge from {cad vector2:fromPoint} along {cad vector2:tangent} to {cad vector2:toPoint}:
    execute:
        set chord to a cad vector2 with x (toPoint's x - fromPoint's x) and y (toPoint's y - fromPoint's y)
        set chordLength to the square root of ((chord's x * chord's x) + (chord's y * chord's y))
        if chordLength <= 1e-9:
            return 0.0
        set chordWay to the bim unit direction of chord
        set heading to the bim unit direction of tangent
        set turn to (chordWay's x * heading's y) - (chordWay's y * heading's x)
        set ahead to (chordWay's x * heading's x) + (chordWay's y * heading's y)
        if (1.0 + ahead) <= 1e-9:
            return 0.0
        return 0.0 - (((chordLength * 0.5) * turn) / (1.0 + ahead))

# Whether the tangent arc from `fromPoint` along `tangent` to `toPoint` has
# a length and turns at most a half circle, as a wall's arc does.
function bim tangent arc from {cad vector2:fromPoint} along {cad vector2:tangent} to {cad vector2:toPoint} stays within a half circle:
    execute:
        set chord to a cad vector2 with x (toPoint's x - fromPoint's x) and y (toPoint's y - fromPoint's y)
        if (the square root of ((chord's x * chord's x) + (chord's y * chord's y))) <= the bim boundary tolerance:
            return false
        set chordWay to the bim unit direction of chord
        set heading to the bim unit direction of tangent
        return ((chordWay's x * heading's x) + (chordWay's y * heading's y)) >= -1e-9

# The unit direction in which the arc from `fromPoint` to `toPoint` bulging
# `rise` (a line for 0) runs on at `toPoint`.
function the bim end direction of boundary arc from {cad vector2:fromPoint} to {cad vector2:toPoint} bulging {a 64 bit floating-point number:rise}:
    execute:
        set chord to a cad vector2 with x (toPoint's x - fromPoint's x) and y (toPoint's y - fromPoint's y)
        set chordLength to the square root of ((chord's x * chord's x) + (chord's y * chord's y))
        set chordWay to the bim unit direction of chord
        if chordLength <= 1e-9:
            return chordWay
        set k to (2.0 * rise) / chordLength
        set cosine to (1.0 - (k * k)) / (1.0 + (k * k))
        set sine to (2.0 * k) / (1.0 + (k * k))
        return a cad vector2 with x ((chordWay's x * cosine) - (chordWay's y * sine)) and y ((chordWay's x * sine) + (chordWay's y * cosine))

# The unit direction in which that arc leaves `fromPoint`.
function the bim start direction of boundary arc from {cad vector2:fromPoint} to {cad vector2:toPoint} bulging {a 64 bit floating-point number:rise}:
    execute:
        set chord to a cad vector2 with x (toPoint's x - fromPoint's x) and y (toPoint's y - fromPoint's y)
        set chordLength to the square root of ((chord's x * chord's x) + (chord's y * chord's y))
        set chordWay to the bim unit direction of chord
        if chordLength <= 1e-9:
            return chordWay
        set k to (2.0 * rise) / chordLength
        set cosine to (1.0 - (k * k)) / (1.0 + (k * k))
        set sine to (2.0 * k) / (1.0 + (k * k))
        return a cad vector2 with x ((chordWay's x * cosine) + (chordWay's y * sine)) and y ((chordWay's y * cosine) - (chordWay's x * sine))

# Where two lines cross, each through a point along a run; `found` false
# when they run parallel.
class:
    patterns:
        [a|] bim line crossing record
    members:
        found as a boolean
        point as a cad vector2

local function the bim crossing of line from {cad vector2:firstPoint} along {cad vector2:firstRun} with line from {cad vector2:secondPoint} along {cad vector2:secondRun}:
    execute:
        set denominator to (firstRun's x * secondRun's y) - (firstRun's y * secondRun's x)
        set firstLength to the square root of ((firstRun's x * firstRun's x) + (firstRun's y * firstRun's y))
        set secondLength to the square root of ((secondRun's x * secondRun's x) + (secondRun's y * secondRun's y))
        if (the absolute value of denominator) <= ((firstLength * secondLength) * 1e-9):
            return @intrinsic("construct", a bim line crossing record, false, firstPoint)
        set gapX to secondPoint's x - firstPoint's x
        set gapY to secondPoint's y - firstPoint's y
        set share to ((gapX * secondRun's y) - (gapY * secondRun's x)) / denominator
        set crossed to a cad vector2 with x (firstPoint's x + (share * firstRun's x)) and y (firstPoint's y + (share * firstRun's y))
        return @intrinsic("construct", a bim line crossing record, true, crossed)

# The faces of straight walls picked one after another, on one side, as
# sketch lines (Pick walls in a floor, roof or ceiling sketch, #101). A
# wall and the next (and, from three walls on, the last and the first)
# join when their centrelines cross within their two thicknesses of the
# ends that face each other; their faces then run to where they cross. The
# side is the inside of what the centrelines enclose, or, when they
# enclose nothing, each wall's interior side (left of its start to its
# finish). `starts` and `finishes` (cad vector2) and `thicknesses` hold one
# entry per wall, in any order.
function the bim inner face segments of walls from {a pointer to a list:starts} to {a pointer to a list:finishes} thick {a pointer to a list:thicknesses}:
    execute:
        set result to a cad topology list of a bim boundary segment record
        set count to the length of starts
        if count = 0:
            return result
        # The walls in the order they follow each other, whatever order they
        # were picked in: from the first picked, each time the wall with an
        # end nearest the free end of the last. Each runs toward the next
        # one: `heads` the end it comes from, `tails` the end toward the
        # next wall; turned when that is against its start to finish.
        set heads to an empty list of a cad vector2
        set tails to an empty list of a cad vector2
        set turnedList to an empty list of a boolean
        set breadths to an empty list of a 64 bit floating-point number
        set used to an empty list of a boolean
        loop cursor from 0 to count:
            append false to used
        set firstStart to the item at 0 in starts
        set firstFinish to the item at 0 in finishes
        # The first wall's tail: the end nearest another wall.
        set startGap to -1.0
        set finishGap to -1.0
        loop cursor from 1 to count:
            set otherStart to the item at cursor in starts
            set otherFinish to the item at cursor in finishes
            set gapHere to the minimum of (the cad distance from firstStart to otherStart) and (the cad distance from firstStart to otherFinish)
            if (startGap < 0.0) or (gapHere < startGap):
                set startGap to gapHere
            set gapHere to the minimum of (the cad distance from firstFinish to otherStart) and (the cad distance from firstFinish to otherFinish)
            if (finishGap < 0.0) or (gapHere < finishGap):
                set finishGap to gapHere
        set firstTurned to (count > 1) and (startGap < finishGap)
        if firstTurned:
            append firstFinish to heads
            append firstStart to tails
        else:
            append firstStart to heads
            append firstFinish to tails
        append firstTurned to turnedList
        append (the item at 0 in thicknesses) to breadths
        replace item at index 0 in used with true
        loop while (the length of heads) < count:
            set freeEnd to the last item of tails
            set chosen to -1
            set chosenGap to 0.0
            set chosenTurned to false
            loop cursor from 0 to count:
                set taken to the item at cursor in used
                if taken = false:
                    set toStart to the cad distance from freeEnd to (the item at cursor in starts)
                    set toFinish to the cad distance from freeEnd to (the item at cursor in finishes)
                    set gapHere to the minimum of toStart and toFinish
                    if (chosen < 0) or (gapHere < chosenGap):
                        set chosen to cursor
                        set chosenGap to gapHere
                        set chosenTurned to toFinish < toStart
            if chosenTurned:
                append (the item at chosen in finishes) to heads
                append (the item at chosen in starts) to tails
            else:
                append (the item at chosen in starts) to heads
                append (the item at chosen in finishes) to tails
            append chosenTurned to turnedList
            append (the item at chosen in thicknesses) to breadths
            replace item at index chosen in used with true
        free used
        # Where each wall's centreline meets the next one's, when they join.
        set joins to an empty list of a boolean
        set corners to an empty list of a cad vector2
        loop cursor from 0 to count:
            set following to the remainder of (cursor + 1) divided by count
            set meets to false
            set corner to the item at cursor in tails
            if ((cursor + 1) < count) or (count >= 3):
                set reach to ((the item at cursor in breadths) + (the item at following in breadths)) + (the bim boundary tolerance)
                set head to the item at cursor in heads
                set tail to the item at cursor in tails
                set nextHead to the item at following in heads
                set nextTail to the item at following in tails
                set crossing to the bim crossing of line from head along (a cad vector2 with x (tail's x - head's x) and y (tail's y - head's y)) with line from nextHead along (a cad vector2 with x (nextTail's x - nextHead's x) and y (nextTail's y - nextHead's y))
                if crossing's found:
                    if ((the cad distance from crossing's point to tail) <= reach) and ((the cad distance from crossing's point to nextHead) <= reach):
                        set meets to true
                        set corner to crossing's point
            append meets to joins
            append corner to corners
        # The inside: the side the centrelines turn round.
        set outline to an empty list of a cad vector2
        loop cursor from 0 to count:
            set previous to the remainder of ((cursor + count) - 1) divided by count
            set enteringJoined to the item at previous in joins
            if enteringJoined:
                append (the item at previous in corners) to outline
            else:
                append (the item at cursor in heads) to outline
            append (the item at cursor in corners) to outline
        set enclosed to the bim signed area of outline
        free outline
        # Each face line: the centreline moved half the wall's thickness to
        # the inside.
        set shifts to an empty list of a cad vector2
        loop cursor from 0 to count:
            set head to the item at cursor in heads
            set tail to the item at cursor in tails
            set chordWay to the bim unit direction of (a cad vector2 with x (tail's x - head's x) and y (tail's y - head's y))
            set side to 1.0
            if enclosed < -1e-9:
                set side to -1.0
            set wasTurned to the item at cursor in turnedList
            if ((the absolute value of enclosed) <= 1e-9) and wasTurned:
                set side to -1.0
            set half to ((the item at cursor in breadths) * 0.5) * side
            append (a cad vector2 with x ((0.0 - chordWay's y) * half) and y (chordWay's x * half)) to shifts
        loop cursor from 0 to count:
            set previous to the remainder of ((cursor + count) - 1) divided by count
            set following to the remainder of (cursor + 1) divided by count
            set head to the item at cursor in heads
            set tail to the item at cursor in tails
            set shift to the item at cursor in shifts
            set run to a cad vector2 with x (tail's x - head's x) and y (tail's y - head's y)
            set faceHead to a cad vector2 with x (head's x + shift's x) and y (head's y + shift's y)
            set faceStart to faceHead
            set faceFinish to a cad vector2 with x (tail's x + shift's x) and y (tail's y + shift's y)
            set enteringJoined to the item at previous in joins
            if enteringJoined:
                set previousHead to the item at previous in heads
                set previousTail to the item at previous in tails
                set previousShift to the item at previous in shifts
                set previousFace to a cad vector2 with x (previousHead's x + previousShift's x) and y (previousHead's y + previousShift's y)
                set entering to the bim crossing of line from previousFace along (a cad vector2 with x (previousTail's x - previousHead's x) and y (previousTail's y - previousHead's y)) with line from faceHead along run
                if entering's found:
                    set faceStart to entering's point
            set leavingJoined to the item at cursor in joins
            if leavingJoined:
                set nextHead to the item at following in heads
                set nextTail to the item at following in tails
                set nextShift to the item at following in shifts
                set nextFace to a cad vector2 with x (nextHead's x + nextShift's x) and y (nextHead's y + nextShift's y)
                set leaving to the bim crossing of line from faceHead along run with line from nextFace along (a cad vector2 with x (nextTail's x - nextHead's x) and y (nextTail's y - nextHead's y))
                if leaving's found:
                    set faceFinish to leaving's point
            if (bim boundary point faceStart meets faceFinish) = false:
                append (the bim boundary line from faceStart to faceFinish) to (result's values)
        free heads
        free tails
        free turnedList
        free joins
        free corners
        free shifts
        free breadths
        return result

# ---------------------------------------------------------------- sketch edit tools (#89)

# The size of the bulge of an arc over a chord `chordLength` long with radius
# `arcRadius`: the shorter way round, or the longer when `longWay`; a half
# circle when the radius is shorter than half the chord.
function the bim bulge over {a 64 bit floating-point number:chordLength} at radius {a 64 bit floating-point number:arcRadius} long {boolean:longWay}:
    execute:
        set halfChord to chordLength * 0.5
        if arcRadius <= halfChord:
            return halfChord
        set rest to the square root of ((arcRadius * arcRadius) - (halfChord * halfChord))
        if longWay:
            return arcRadius + rest
        return arcRadius - rest

# The bulge of the arc from `fromPoint` to `toPoint` with radius
# `arcRadius`, the shorter way round, to the side of the chord where
# `sidePoint` lies (start, end, radius); a half circle when the radius is
# shorter than half the chord.
function the bim boundary bulge from {cad vector2:fromPoint} to {cad vector2:toPoint} with radius {a 64 bit floating-point number:arcRadius} toward {cad vector2:sidePoint}:
    execute:
        set chordX to toPoint's x - fromPoint's x
        set chordY to toPoint's y - fromPoint's y
        set chordLength to the square root of ((chordX * chordX) + (chordY * chordY))
        if chordLength <= 1e-9:
            return 0.0
        set across to (((sidePoint's x - fromPoint's x) * chordY) - ((sidePoint's y - fromPoint's y) * chordX)) / chordLength
        set rise to the bim bulge over chordLength at radius arcRadius long false
        if across < 0.0:
            return 0.0 - rise
        return rise

# The arc round `centrePoint` from `startPoint`, turning `sweep` radians
# anticlockwise (centre, start, end). Its bulge is the radius times
# 1 - cos(sweep / 2), so it may turn more than a half circle; a segment of
# no length when it turns a whole circle or none.
function the bim boundary arc around {cad vector2:centrePoint} from {cad vector2:startPoint} sweeping {a 64 bit floating-point number:sweep}:
    execute:
        set arcRadius to the cad distance from centrePoint to startPoint
        set startAngle to @intrinsic("atan2", startPoint's y - centrePoint's y, startPoint's x - centrePoint's x)
        set endAngle to startAngle + sweep
        set endPoint to a cad vector2 with x (centrePoint's x + (arcRadius * (the cosine of endAngle))) and y (centrePoint's y + (arcRadius * (the sine of endAngle)))
        if (bim boundary point startPoint meets endPoint) or (sweep <= 0.0):
            return the bim boundary line from startPoint to startPoint
        return the bim boundary arc from startPoint to endPoint bulging (arcRadius * (1.0 - (the cosine of (sweep * 0.5))))

# The same, ending where the ray from the centre through `towardPoint`
# meets the circle.
function the bim boundary arc around {cad vector2:centrePoint} from {cad vector2:startPoint} toward {cad vector2:towardPoint}:
    execute:
        set startAngle to @intrinsic("atan2", startPoint's y - centrePoint's y, startPoint's x - centrePoint's x)
        set endAngle to @intrinsic("atan2", towardPoint's y - centrePoint's y, towardPoint's x - centrePoint's x)
        set turning to endAngle - startAngle
        if turning < 0.0:
            set turning to turning + 6.283185307179586
        return the bim boundary arc around centrePoint from startPoint sweeping turning

# The direction in which segment `piece` runs on at its finish, and the one
# in which it leaves its start, as unit vectors.
function the bim finish direction of boundary segment {bim boundary segment record:piece}:
    execute:
        if piece's elliptic:
            return the bim unit direction of (a cad vector2 with x (piece's centre's x - piece's start's x) and y (piece's centre's y - piece's start's y))
        return the bim end direction of boundary arc from piece's start to piece's finish bulging piece's bulge

function the bim start direction of boundary segment {bim boundary segment record:piece}:
    execute:
        if piece's elliptic:
            return the bim unit direction of (a cad vector2 with x (piece's finish's x - piece's centre's x) and y (piece's finish's y - piece's centre's y))
        return the bim start direction of boundary arc from piece's start to piece's finish bulging piece's bulge

# The direction a tangent arc from `spot` leaves in: on along the last
# segment of `pieces` that ends at `spot`, else back along the last that
# starts there; of no length when none does.
function the bim tangent at {cad vector2:spot} of boundary segments {a pointer to a list:pieces}:
    execute:
        set heading to a cad vector2 with x 0.0 and y 0.0
        set foundFinish to false
        loop cursor from 0 to the length of pieces:
            set piece to the item at cursor in pieces
            if bim boundary point piece's finish meets spot:
                set heading to the bim finish direction of boundary segment piece
                set foundFinish to true
            else if (foundFinish = false) and (bim boundary point piece's start meets spot):
                set leaving to the bim start direction of boundary segment piece
                set heading to a cad vector2 with x (0.0 - leaving's x) and y (0.0 - leaving's y)
        return heading

# The segment `piece` with each end that meets one of `movingPoints` moved
# by `displacement`; an elliptic quarter's centre moves along when both its
# ends do. An arc with one end moved keeps its bulge, or its radius when
# `keepingRadius` (a half circle when the new chord is too long for it).
function the bim boundary segment {bim boundary segment record:piece} moving any of {a pointer to a list:movingPoints} by {cad vector2:displacement} keeping radius {boolean:keepingRadius}:
    execute:
        set startMoves to false
        set finishMoves to false
        loop cursor from 0 to the length of movingPoints:
            set spot to the item at cursor in movingPoints
            if bim boundary point piece's start meets spot:
                set startMoves to true
            if bim boundary point piece's finish meets spot:
                set finishMoves to true
        set movedPiece to piece
        if startMoves:
            set movedPiece's start to a cad vector2 with x (piece's start's x + displacement's x) and y (piece's start's y + displacement's y)
        if finishMoves:
            set movedPiece's finish to a cad vector2 with x (piece's finish's x + displacement's x) and y (piece's finish's y + displacement's y)
        if (piece's elliptic and startMoves) and finishMoves:
            set movedPiece's centre to a cad vector2 with x (piece's centre's x + displacement's x) and y (piece's centre's y + displacement's y)
        if (keepingRadius and (startMoves != finishMoves)) and ((piece's elliptic = false) and (piece's bulge != 0.0)):
            set oldArc to the bim arc of boundary segment piece
            set oldChord to the cad distance from piece's start to piece's finish
            set newChord to the cad distance from movedPiece's start to movedPiece's finish
            set rise to the bim bulge over newChord at radius oldArc's radius long ((the absolute value of piece's bulge) > (oldChord * 0.5))
            if piece's bulge < 0.0:
                set rise to 0.0 - rise
            set movedPiece's bulge to rise
        return movedPiece

# Whether the straight piece from `runFrom` to `runTo` meets the box from
# `boxLow` to `boxHigh` (Liang and Barsky's clipping).
local function bim boundary run from {cad vector2:runFrom} to {cad vector2:runTo} meets box {cad vector2:boxLow} {cad vector2:boxHigh}:
    execute:
        set entering to 0.0
        set leaving to 1.0
        set dx to runTo's x - runFrom's x
        set dy to runTo's y - runFrom's y
        loop sideCursor from 0 to 4:
            set step to 0.0 - dx
            set limit to runFrom's x - boxLow's x
            if sideCursor = 1:
                set step to dx
                set limit to boxHigh's x - runFrom's x
            if sideCursor = 2:
                set step to 0.0 - dy
                set limit to runFrom's y - boxLow's y
            if sideCursor = 3:
                set step to dy
                set limit to boxHigh's y - runFrom's y
            if (the absolute value of step) <= 1e-15:
                if limit < 0.0:
                    return false
            else:
                set ratio to limit / step
                if step < 0.0:
                    set entering to the maximum of entering and ratio
                else:
                    set leaving to the minimum of leaving and ratio
        return entering <= leaving

# Whether segment `piece` lies wholly in the box from `boxLow` to `boxHigh`
# (a window selection takes it), or, `touchingToo`, meets it anywhere (a
# crossing selection).
function bim boundary segment {bim boundary segment record:piece} is in box {cad vector2:boxLow} {cad vector2:boxHigh} touching {boolean:touchingToo}:
    execute:
        set drawn to the bim drawn points of boundary segment piece
        set inside to 0
        loop cursor from 0 to the length of drawn:
            set spot to the item at cursor in drawn
            if ((spot's x >= boxLow's x) and (spot's x <= boxHigh's x)) and ((spot's y >= boxLow's y) and (spot's y <= boxHigh's y)):
                set inside to inside + 1
        set taken to inside = (the length of drawn)
        if touchingToo and (taken = false):
            set taken to inside > 0
            set corner to 0
            loop while (taken = false) and ((corner + 1) < (the length of drawn)):
                set taken to bim boundary run from (the item at corner in drawn) to (the item at (corner + 1) in drawn) meets box boxLow boxHigh
                set corner to corner + 1
        free drawn
        return taken

# Where the lines of straight segments `first` and `second` cross (Trim /
# Extend to corner); `found` false when they run parallel.
function the bim crossing of boundary line {bim boundary segment record:first} with boundary line {bim boundary segment record:second}:
    execute:
        return the bim crossing of line from first's start along (a cad vector2 with x (first's finish's x - first's start's x) and y (first's finish's y - first's start's y)) with line from second's start along (a cad vector2 with x (second's finish's x - second's start's x) and y (second's finish's y - second's start's y))

# Line `piece` trimmed or extended to `corner` on its line, keeping the side
# of `corner` where `keptPoint` lies: the end on the other side moves there.
function the bim boundary line {bim boundary segment record:piece} trimmed to {cad vector2:corner} keeping {cad vector2:keptPoint}:
    execute:
        set runX to piece's finish's x - piece's start's x
        set runY to piece's finish's y - piece's start's y
        set runSquared to (runX * runX) + (runY * runY)
        set cutLine to piece
        if runSquared <= 1e-18:
            return cutLine
        set cornerShare to (((corner's x - piece's start's x) * runX) + ((corner's y - piece's start's y) * runY)) / runSquared
        set keptShare to (((keptPoint's x - piece's start's x) * runX) + ((keptPoint's y - piece's start's y) * runY)) / runSquared
        if keptShare < cornerShare:
            set cutLine's finish to corner
        else:
            set cutLine's start to corner
        return cutLine

# Gives the elliptic quarters of `pieces` round `centrePoint` the semi-axis
# `semiAxis` along their axis through `axisPoint`: the ends on that axis
# move along it, each on its own side of the centre. How many ends moved.
function set bim ellipse round {cad vector2:centrePoint} axis through {cad vector2:axisPoint} to {a 64 bit floating-point number:semiAxis} in {a pointer to a list:pieces}:
    execute:
        set axisWay to the bim unit direction of (a cad vector2 with x (axisPoint's x - centrePoint's x) and y (axisPoint's y - centrePoint's y))
        set moved to 0
        loop cursor from 0 to the length of pieces:
            set piece to the item at cursor in pieces
            if piece's elliptic and (bim boundary point piece's centre meets centrePoint):
                loop endCursor from 0 to 2:
                    set endPoint to piece's start
                    if endCursor = 1:
                        set endPoint to piece's finish
                    set offsetX to endPoint's x - centrePoint's x
                    set offsetY to endPoint's y - centrePoint's y
                    set offAxis to (offsetX * axisWay's y) - (offsetY * axisWay's x)
                    set onAxis to (offsetX * axisWay's x) + (offsetY * axisWay's y)
                    if ((the absolute value of offAxis) <= the bim boundary tolerance) and ((the absolute value of onAxis) > the bim boundary tolerance):
                        set sense to 1.0
                        if onAxis < 0.0:
                            set sense to -1.0
                        set placed to a cad vector2 with x (centrePoint's x + ((sense * semiAxis) * axisWay's x)) and y (centrePoint's y + ((sense * semiAxis) * axisWay's y))
                        if endCursor = 0:
                            set piece's start to placed
                        else:
                            set piece's finish to placed
                        set moved to moved + 1
                replace item at index cursor in pieces with piece
        return moved

# Gives the circular arc at `chosen` in `pieces` the radius `arcRadius`.
# When the arcs on its circle close it (a circle drawn as half arcs), they
# all scale about its centre; else the arc keeps its ends and side, the
# longer way round when it was. False when it is no arc, or the radius is
# shorter than half its kept chord.
function set bim boundary arc {integer:chosen} radius to {a 64 bit floating-point number:arcRadius} in {a pointer to a list:pieces}:
    execute:
        set piece to the item at chosen in pieces
        set circle to the bim arc of boundary segment piece
        if (piece's elliptic or (circle's curved = false)) or (arcRadius <= the bim boundary tolerance):
            return false
        set turned to 0.0
        loop cursor from 0 to the length of pieces:
            set other to the item at cursor in pieces
            set otherArc to the bim arc of boundary segment other
            if ((other's elliptic = false) and otherArc's curved) and ((bim boundary point otherArc's centre meets circle's centre) and ((the absolute value of (otherArc's radius - circle's radius)) <= the bim boundary tolerance)):
                set turned to turned + (the absolute value of otherArc's sweep)
        if turned >= 6.2831:
            set factor to arcRadius / circle's radius
            loop cursor from 0 to the length of pieces:
                set other to the item at cursor in pieces
                set otherArc to the bim arc of boundary segment other
                if ((other's elliptic = false) and otherArc's curved) and ((bim boundary point otherArc's centre meets circle's centre) and ((the absolute value of (otherArc's radius - circle's radius)) <= the bim boundary tolerance)):
                    set other's start to a cad vector2 with x (circle's centre's x + ((other's start's x - circle's centre's x) * factor)) and y (circle's centre's y + ((other's start's y - circle's centre's y) * factor))
                    set other's finish to a cad vector2 with x (circle's centre's x + ((other's finish's x - circle's centre's x) * factor)) and y (circle's centre's y + ((other's finish's y - circle's centre's y) * factor))
                    set other's bulge to other's bulge * factor
                    replace item at index cursor in pieces with other
            return true
        set chordLength to the cad distance from piece's start to piece's finish
        if arcRadius < ((chordLength * 0.5) - 1e-9):
            return false
        set rise to the bim bulge over chordLength at radius arcRadius long ((the absolute value of piece's bulge) > (chordLength * 0.5))
        if piece's bulge < 0.0:
            set rise to 0.0 - rise
        set piece's bulge to rise
        replace item at index chosen in pieces with piece
        return true
