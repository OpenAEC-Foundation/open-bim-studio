import ui/panels/bim_ui.dl

class:
    patterns:
        [a|] bim modify option record
    members:
        label as a string
        command as an integer
        width as a 64 bit floating-point number
        active as a boolean

function bim editor shows input options {bim editor record:editor}:
    execute:
        set tool to editor's tool
        if (((tool = bim move tool) or (tool = bim copy tool)) or ((tool = bim rotate tool) or (tool = bim mirror tool))) or ((tool = bim array tool) or (tool = bim scale tool)):
            return true
        if (((tool = bim fillet tool) or (tool = bim chamfer tool)) or ((tool = bim stretch tool) or (tool = bim join tool))) or ((tool = bim lengthen tool) or (tool = bim split line tool)):
            return true
        return ((tool = bim grid tool) or (tool = bim wall tool)) or ((tool = bim line tool) or (tool = bim rectangle tool))

function the bim input tool name of {bim editor record:editor}:
    execute:
        if editor's tool = bim move tool:
            return the string form of "Move"
        if editor's tool = bim copy tool:
            return the string form of "Copy"
        if editor's tool = bim rotate tool:
            return the string form of "Rotate"
        if editor's tool = bim mirror tool:
            return the string form of "Mirror"
        if editor's tool = bim array tool:
            return the string form of "Array"
        if editor's tool = bim scale tool:
            return the string form of "Scale"
        if editor's tool = bim fillet tool:
            return the string form of "Fillet"
        if editor's tool = bim chamfer tool:
            return the string form of "Chamfer"
        if editor's tool = bim stretch tool:
            return the string form of "Stretch"
        if editor's tool = bim join tool:
            return the string form of "Join"
        if editor's tool = bim lengthen tool:
            return the string form of "Lengthen"
        if editor's tool = bim split line tool:
            return the string form of "Split"
        if editor's tool = bim grid tool:
            return the string form of "Grid"
        if editor's tool = bim wall tool:
            return the string form of "Wall"
        if editor's tool = bim rectangle tool:
            return the string form of "Rectangle"
        return the string form of "Line"

function the bim input options of {bim editor record:editor}:
    execute:
        set buttons to an empty list of a bim modify option record
        if editor's tool = bim array tool:
            set modeName to the string form of "Linear"
            if editor's modify's radial:
                set modeName to the string form of "Radial"
            append (@intrinsic("construct", a bim modify option record, modeName, 2401, 72.0, editor's modify's radial)) to buttons
            append (@intrinsic("construct", a bim modify option record, the string form of "-", 2402, 26.0, false)) to buttons
            append (@intrinsic("construct", a bim modify option record, (the string form of "Count ") + (the string form of editor's modify's count), -1, 76.0, false)) to buttons
            append (@intrinsic("construct", a bim modify option record, the string form of "+", 2403, 26.0, false)) to buttons
            if editor's modify's radial:
                append (@intrinsic("construct", a bim modify option record, (the string form of "Angle ") + (the bim metres text of editor's modify's sweep), 2404, 90.0, false)) to buttons
        else if ((editor's tool = bim mirror tool) or (editor's tool = bim rotate tool)) or ((editor's tool = bim scale tool) or (editor's tool = bim move tool)):
            append (@intrinsic("construct", a bim modify option record, the string form of "Copy", 2400, 62.0, editor's modify's copyMode)) to buttons
        if (((editor's tool = bim move tool) or (editor's tool = bim copy tool)) or (editor's tool = bim array tool)) or (editor's tool = bim stretch tool):
            append (@intrinsic("construct", a bim modify option record, the string form of "X", 2405, 28.0, editor's modify's axis = 1)) to buttons
            append (@intrinsic("construct", a bim modify option record, the string form of "Y", 2406, 28.0, editor's modify's axis = 2)) to buttons
            append (@intrinsic("construct", a bim modify option record, the string form of "Free", 2407, 46.0, editor's modify's axis = 0)) to buttons
        return buttons

function the bim input options width in {bim screen layout record:layout}:
    execute:
        set canvasWidth to layout's planRight - layout's planLeft
        if canvasWidth < 1.0:
            set canvasWidth to layout's width - layout's planRight
        return the minimum of 620.0 and (the maximum of 200.0 and (canvasWidth - 24.0))

function the bim input options hit of {bim editor record:editor} at {cad vector2:pixel} in {bim screen layout record:layout}:
    execute:
        set optionHit to no bim ui hit
        if (bim editor shows input options editor) = false:
            return optionHit
        set left to layout's planLeft + 12.0
        set top to layout's top + 10.0
        set optionsWidth to the bim input options width in layout
        if (((pixel's x < left) or (pixel's x > (left + optionsWidth))) or (pixel's y < top)) or (pixel's y > (top + 76.0)):
            return optionHit
        set optionHit's inChrome to true
        set x to left + 84.0
        set buttons to the bim input options of editor
        loop cursor from 0 to the length of buttons:
            set button to the item at cursor in buttons
            if ((x + button's width) <= ((left + optionsWidth) - 8.0)) and (((pixel's x >= x) and (pixel's x < (x + button's width))) and ((pixel's y >= (top + 7.0)) and (pixel's y < (top + 32.0)))):
                set optionHit's command to button's command
            set x to (x + button's width) + 4.0
        free buttons
        return optionHit

function draw bim input options of {bim editor record:editor} in {bim screen layout record:layout} pointing at {cad vector2:pixel} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        if (bim editor shows input options editor) = false:
            return nothing
        set scheme to the bim ui palette
        set left to layout's planLeft + 12.0
        set top to layout's top + 10.0
        set optionsWidth to the bim input options width in layout
        draw bim ui rectangle left top optionsWidth 76.0 painted scheme's panel in frame
        draw bim ui frame left top optionsWidth 76.0 coloured scheme's strong's red, scheme's strong's green and scheme's strong's blue in frame
        draw bim ui text (the bim input tool name of editor) at (left + 10.0) and (top + 24.0) in face (bim text bold) with atlas painted scheme's ink in frame
        set x to left + 84.0
        set buttons to the bim input options of editor
        loop cursor from 0 to the length of buttons:
            set button to the item at cursor in buttons
            if (x + button's width) <= ((left + optionsWidth) - 8.0):
                set paint to scheme's hover
                if button's active:
                    set paint to scheme's selected
                draw bim ui rectangle x (top + 7.0) button's width 25.0 painted paint in frame
                draw bim ui text button's label at (x + 6.0) and (top + 24.0) in face (bim text small) with atlas painted scheme's ink in frame
            set x to (x + button's width) + 4.0
        free buttons
        set hint to the string form of "x,y   @dx,dy   @distance<angle   Enter: confirm   Esc: cancel"
        if editor's tool = bim array tool:
            set hint to the string form of "Type count (including original); choose base and destination"
        else if editor's tool = bim scale tool:
            set hint to the string form of "Scale XY; heights/type sizes stay fixed. Pick pivot, then factor or reference length"
        else if editor's tool = bim fillet tool:
            set hint to (the string form of "Radius: ") + ((the bim length editor's modify's radius in units editor's lengthUnit) + (the string form of " | type radius, then pick two lines"))
        else if editor's tool = bim chamfer tool:
            set hint to (the string form of "Distance: ") + ((the bim length editor's modify's chamfer in units editor's lengthUnit) + (the string form of " | type distance, then pick two lines"))
        if (the length of editor's numeric) > 0:
            set hint to ((the string form of "> ") + editor's numeric) + (the string form of " |")
        draw bim text hint at (left + 10.0) and (top + 57.0) in face (bim text small) with atlas coloured scheme's accentInk's red, scheme's accentInk's green and scheme's accentInk's blue cut at ((left + optionsWidth) - 8.0) in frame
