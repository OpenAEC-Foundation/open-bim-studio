# SPDX-License-Identifier: MPL-2.0
# Included by bim_editor_properties: the groups of the properties panel
# (#96).
#
# The rows of the panel (`the bim property rows of`) come in groups, each
# under a heading row. A heading's code says what its rows belong to:
# `bim group heading code` heads rows of the element itself (the instance,
# its phasing, its property sets), `bim type group heading code` heads rows
# its type holds, which every element of that type shares: a change there
# changes them all. The panel marks the rows of a type group, and the type
# group's "Edit type" row opens the type in the type window.
#
# A click on a heading folds its group shut or opens it again. The editor
# keeps the names of the groups that are shut (`foldedGroups`), so that a
# group stays shut by its name, for every element that shows it.
import ui/editor/bim_editor_core.dl

# The code of a heading over rows of the element itself, and of a heading
# over rows its type holds.
function bim group heading code:
    replacement:
        -1
function bim type group heading code:
    replacement:
        -2

# The row under a type's heading that opens the type in the type window.
function bim edit type property:
    replacement:
        12632

# The command that opens the type window on the type of the selection, as
# the ribbon's IfcTypes button sends it.
function bim type manager command:
    replacement:
        3901

# Whether a row of code `rowCode` is a heading.
function bim property code {integer:rowCode} heads a group:
    execute:
        return (rowCode = bim group heading code) or (rowCode = bim type group heading code)

# A heading over rows that the type holds.
function append bim type group {a string:label} to {a pointer to a list:rows}:
    execute:
        append (@intrinsic("construct", a bim property row record, label, the string form of "", bim type group heading code)) to rows

# The row that opens the type in the type window.
function append bim edit type row to {a pointer to a list:rows}:
    execute:
        append (@intrinsic("construct", a bim property row record, the string form of "Edit type", the string form of "Open in type window", bim edit type property)) to rows

# The command the window runs itself for a click on the row of code
# `rowCode` (the type window for "Edit type"); -1 when the row goes to the
# editor.
function the bim window command of property {integer:rowCode}:
    execute:
        if rowCode = bim edit type property:
            return bim type manager command
        return -1

# Whether row number `rowIndex` of `rows` belongs to a type group: the
# nearest heading above it is a type's.
function bim property row {integer:rowIndex} among {a pointer to a list:rows} belongs to the type:
    execute:
        set cursor to the minimum of rowIndex and ((the length of rows) - 1)
        loop while cursor >= 0:
            set rowCode to (the item at cursor in rows)'s code
            if bim property code rowCode heads a group:
                return rowCode = bim type group heading code
            set cursor to cursor - 1
        return false

# Whether the group named `groupName` is folded shut.
function bim property group {a string:groupName} is folded for {bim editor record:editor}:
    execute:
        set foldedNames to editor's foldedGroups's values
        loop nameCursor from 0 to the length of foldedNames:
            if (the item at nameCursor in foldedNames) = groupName:
                return true
        return false

# The group named `groupName` folded shut, or opened when it was shut.
function fold or open bim property group {a string:groupName} in {a pointer to a bim editor record:editor}:
    execute:
        set foldedNames to editor's foldedGroups's values
        set slot to -1
        loop nameCursor from 0 to the length of foldedNames:
            if (the item at nameCursor in foldedNames) = groupName:
                set slot to nameCursor
        if slot >= 0:
            remove item slot from foldedNames
        else:
            append groupName to foldedNames

# The group of heading number `headingOrder` among `rows` (counted from 0
# over the headings only, as the panel counts them) folded or opened; true
# when there is such a heading.
function fold or open bim property heading {integer:headingOrder} among {a pointer to a list:rows} in {a pointer to a bim editor record:editor}:
    execute:
        set counted to -1
        loop rowCursor from 0 to the length of rows:
            set row to the item at rowCursor in rows
            if bim property code (row's code) heads a group:
                set counted to counted + 1
                if counted = headingOrder:
                    fold or open bim property group (row's label) in editor
                    return true
        return false
