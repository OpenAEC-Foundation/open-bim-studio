# SPDX-License-Identifier: MPL-2.0
# Included by bim_editor_psets: the property sets the properties panel
# offers to add to an element (#96), by its IFC class.
#
# Each element is offered the common set of its class (Pset_WallCommon for
# an IfcWall, and so on) and the sets IFC4 defines for every IfcElement:
# the manufacturer's type information (supplier, model, article number),
# the occurrence's manufacturer data, warranty and condition. A set is
# added with its properties empty; the user types their values. The names
# and value types follow the IFC4 property set definitions of
# buildingSMART (https://standards.buildingsmart.org/IFC/RELEASE/IFC4/ADD2_TC1/HTML/,
# annex B); only the single-value properties are listed, enumerations
# (Status, AssemblyPlace) are left out.
import ui/editor/bim_editor_core.dl
import lib/text.dl

# The common property set of IFC class `ifcClass`, or "" for a class that
# has none here.
function the bim common pset of class {a string:ifcClass}:
    execute:
        if ifcClass = (the string form of "IfcWall"):
            return the string form of "Pset_WallCommon"
        if ifcClass = (the string form of "IfcSlab"):
            return the string form of "Pset_SlabCommon"
        if ifcClass = (the string form of "IfcRoof"):
            return the string form of "Pset_RoofCommon"
        if ifcClass = (the string form of "IfcCovering"):
            return the string form of "Pset_CoveringCommon"
        if ifcClass = (the string form of "IfcDoor"):
            return the string form of "Pset_DoorCommon"
        if ifcClass = (the string form of "IfcWindow"):
            return the string form of "Pset_WindowCommon"
        if ifcClass = (the string form of "IfcBeam"):
            return the string form of "Pset_BeamCommon"
        if ifcClass = (the string form of "IfcColumn"):
            return the string form of "Pset_ColumnCommon"
        if ifcClass = (the string form of "IfcMember"):
            return the string form of "Pset_MemberCommon"
        if ifcClass = (the string form of "IfcPile"):
            return the string form of "Pset_PileCommon"
        if ifcClass = (the string form of "IfcPlate"):
            return the string form of "Pset_PlateCommon"
        if ifcClass = (the string form of "IfcCurtainWall"):
            return the string form of "Pset_CurtainWallCommon"
        if ifcClass = (the string form of "IfcStair"):
            return the string form of "Pset_StairCommon"
        if ifcClass = (the string form of "IfcRailing"):
            return the string form of "Pset_RailingCommon"
        if ifcClass = (the string form of "IfcBuildingElementProxy"):
            return the string form of "Pset_BuildingElementProxyCommon"
        if ifcClass = (the string form of "IfcSpace"):
            return the string form of "Pset_SpaceCommon"
        if ifcClass = (the string form of "IfcBuildingStorey"):
            return the string form of "Pset_BuildingStoreyCommon"
        return the string form of ""

# Whether IFC class `ifcClass` is an element (IfcElement), which every
# element's sets (manufacturer, warranty, condition) apply to.
function bim ifc class {a string:ifcClass} is an element:
    execute:
        if (the length of ifcClass) = 0:
            return false
        if (ifcClass = (the string form of "IfcSpace")) or (ifcClass = (the string form of "IfcBuildingStorey")):
            return false
        if (ifcClass = (the string form of "IfcAnnotation")) or (ifcClass = (the string form of "IfcGrid")):
            return false
        return true

# The property sets offered to an element of IFC class `ifcClass`, in the
# order the menu lists them.
function the bim pset templates for class {a string:ifcClass}:
    execute:
        set offeredSets to an empty list of a string
        set commonSet to the bim common pset of class ifcClass
        if (the length of commonSet) > 0:
            append commonSet to offeredSets
        if bim ifc class ifcClass is an element:
            append (the string form of "Pset_ManufacturerTypeInformation") to offeredSets
            append (the string form of "Pset_ManufacturerOccurrence") to offeredSets
            append (the string form of "Pset_Warranty") to offeredSets
            append (the string form of "Pset_Condition") to offeredSets
        return offeredSets

# The properties of set `setName` as "Name:IFCTYPE" pairs joined by commas;
# "" for a set not listed here.
local function the bim pset template text of {a string:setName}:
    execute:
        set rated to the string form of "AcousticRating:IFCLABEL,FireRating:IFCLABEL"
        set envelope to the string form of "IsExternal:IFCBOOLEAN,ThermalTransmittance:IFCTHERMALTRANSMITTANCEMEASURE"
        set reference to the string form of "Reference:IFCIDENTIFIER"
        set comma to the string form of ","
        if setName = (the string form of "Pset_WallCommon"):
            return ((((reference + comma) + rated) + comma) + envelope) + (the string form of ",Combustible:IFCBOOLEAN,SurfaceSpreadOfFlame:IFCLABEL,LoadBearing:IFCBOOLEAN,ExtendToStructure:IFCBOOLEAN,Compartmentation:IFCBOOLEAN")
        if setName = (the string form of "Pset_SlabCommon"):
            return ((((reference + comma) + rated) + comma) + envelope) + (the string form of ",Combustible:IFCBOOLEAN,SurfaceSpreadOfFlame:IFCLABEL,LoadBearing:IFCBOOLEAN,Compartmentation:IFCBOOLEAN,PitchAngle:IFCPLANEANGLEMEASURE")
        if setName = (the string form of "Pset_RoofCommon"):
            return (((reference + comma) + rated) + comma) + envelope
        if setName = (the string form of "Pset_CoveringCommon"):
            return ((((reference + comma) + rated) + comma) + envelope) + (the string form of ",Combustible:IFCBOOLEAN,SurfaceSpreadOfFlame:IFCLABEL,Finish:IFCLABEL")
        if setName = (the string form of "Pset_DoorCommon"):
            return ((((reference + comma) + rated) + comma) + envelope) + (the string form of ",SecurityRating:IFCLABEL,GlazingAreaFraction:IFCPOSITIVERATIOMEASURE,HandicapAccessible:IFCBOOLEAN,FireExit:IFCBOOLEAN,SelfClosing:IFCBOOLEAN,SmokeStop:IFCBOOLEAN")
        if setName = (the string form of "Pset_WindowCommon"):
            return ((((reference + comma) + rated) + comma) + envelope) + (the string form of ",SecurityRating:IFCLABEL,GlazingAreaFraction:IFCPOSITIVERATIOMEASURE,SmokeStop:IFCBOOLEAN")
        if setName = (the string form of "Pset_BeamCommon"):
            return (((reference + comma) + envelope) + (the string form of ",Span:IFCPOSITIVELENGTHMEASURE,Slope:IFCPLANEANGLEMEASURE,Roll:IFCPLANEANGLEMEASURE,LoadBearing:IFCBOOLEAN,FireRating:IFCLABEL"))
        if setName = (the string form of "Pset_ColumnCommon"):
            return (((reference + comma) + envelope) + (the string form of ",Slope:IFCPLANEANGLEMEASURE,Roll:IFCPLANEANGLEMEASURE,LoadBearing:IFCBOOLEAN,FireRating:IFCLABEL"))
        if setName = (the string form of "Pset_MemberCommon"):
            return (((reference + comma) + envelope) + (the string form of ",Span:IFCPOSITIVELENGTHMEASURE,Slope:IFCPLANEANGLEMEASURE,Roll:IFCPLANEANGLEMEASURE,LoadBearing:IFCBOOLEAN,FireRating:IFCLABEL"))
        if setName = (the string form of "Pset_PileCommon"):
            return reference + (the string form of ",LoadBearing:IFCBOOLEAN")
        if setName = (the string form of "Pset_PlateCommon"):
            return ((((reference + comma) + rated) + comma) + envelope) + (the string form of ",LoadBearing:IFCBOOLEAN")
        if setName = (the string form of "Pset_CurtainWallCommon"):
            return ((((reference + comma) + rated) + comma) + envelope) + (the string form of ",Combustible:IFCBOOLEAN,SurfaceSpreadOfFlame:IFCLABEL")
        if setName = (the string form of "Pset_StairCommon"):
            return reference + (the string form of ",NumberOfRiser:IFCCOUNTMEASURE,NumberOfTreads:IFCCOUNTMEASURE,RiserHeight:IFCPOSITIVELENGTHMEASURE,TreadLength:IFCPOSITIVELENGTHMEASURE,IsExternal:IFCBOOLEAN,FireRating:IFCLABEL,FireExit:IFCBOOLEAN,HandicapAccessible:IFCBOOLEAN")
        if setName = (the string form of "Pset_RailingCommon"):
            return reference + (the string form of ",Height:IFCPOSITIVELENGTHMEASURE,Diameter:IFCPOSITIVELENGTHMEASURE,IsExternal:IFCBOOLEAN")
        if setName = (the string form of "Pset_BuildingElementProxyCommon"):
            return ((reference + comma) + envelope) + (the string form of ",LoadBearing:IFCBOOLEAN,FireRating:IFCLABEL")
        if setName = (the string form of "Pset_SpaceCommon"):
            return reference + (the string form of ",IsExternal:IFCBOOLEAN,GrossPlannedArea:IFCAREAMEASURE,NetPlannedArea:IFCAREAMEASURE,PubliclyAccessible:IFCBOOLEAN,HandicapAccessible:IFCBOOLEAN")
        if setName = (the string form of "Pset_BuildingStoreyCommon"):
            return reference + (the string form of ",EntranceLevel:IFCBOOLEAN,AboveGround:IFCLOGICAL,SprinklerProtection:IFCBOOLEAN,SprinklerProtectionAutomatic:IFCBOOLEAN,GrossPlannedArea:IFCAREAMEASURE,NetPlannedArea:IFCAREAMEASURE")
        if setName = (the string form of "Pset_ManufacturerTypeInformation"):
            return the string form of "Manufacturer:IFCLABEL,ModelLabel:IFCLABEL,ModelReference:IFCLABEL,ArticleNumber:IFCIDENTIFIER,GlobalTradeItemNumber:IFCIDENTIFIER,ProductionYear:IFCLABEL"
        if setName = (the string form of "Pset_ManufacturerOccurrence"):
            return the string form of "SerialNumber:IFCIDENTIFIER,BatchReference:IFCIDENTIFIER,BarCode:IFCIDENTIFIER,AcquisitionDate:IFCDATE"
        if setName = (the string form of "Pset_Warranty"):
            return the string form of "WarrantyIdentifier:IFCIDENTIFIER,WarrantyStartDate:IFCDATE,WarrantyPeriod:IFCDURATION,IsExtendedWarranty:IFCBOOLEAN,WarrantyContent:IFCTEXT,PointOfContact:IFCLABEL,Exclusions:IFCTEXT"
        if setName = (the string form of "Pset_Condition"):
            return the string form of "AssessmentDate:IFCDATE,AssessmentCondition:IFCLABEL,AssessmentDescription:IFCTEXT"
        return the string form of ""

# The properties of set `setName`, each a `bim pset entry record` of
# `ownerId` with an empty value; empty for a set not listed here.
function the bim pset template {a string:setName} for {a 64 bit integer:ownerId}:
    execute:
        set entries to an empty list of a bim pset entry record
        set templateText to the bim pset template text of setName
        if (the length of templateText) = 0:
            return entries
        set pairs to templateText split at ","
        loop pairCursor from 0 to the length of pairs:
            set pair to the item at pairCursor in pairs
            set colon to the index of ":" in pair
            if colon > 0:
                set propertyName to the substring of pair from 0 spanning colon bytes
                set valueType to the substring of pair from (colon + 1) spanning (((the length of pair) - colon) - 1) bytes
                append (@intrinsic("construct", a bim pset entry record, ownerId, setName, propertyName, valueType, the string form of "")) to entries
        free pairs
        return entries
