# SPDX-License-Identifier: MPL-2.0
# The Profiles tab of the IfcTypes window (issue #95): every standard
# profile of the catalogue by series, folded until a series is opened; a
# search over all of them ("HEA 2"); a catalogue profile's dimensions; Add
# makes it a type of the project only then, and Apply gives it to the
# drawing; a drawn profile of the project made parametric there and its
# parameters typed, a length or "=" and an expression, each one undoable
# edit.
import ui/properties/bim_type_manager.dl

function check profile browser {boolean:passed} named {a string:caption}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function the line text of {bim type manager record:stateValue} in {bim model record:modelValue}:
    execute:
        set entries to the bim type manager entries of stateValue in modelValue
        set pieces to an empty list of a string
        loop cursor from 0 to the length of entries:
            set entryId to the item at cursor in entries
            if entryId < (0 as a 64 bit integer):
                set groupCode to ((((0 as a 64 bit integer) - entryId) - (1 as a 64 bit integer)) as an integer)
                append ((the string form of "[") + ((the bim manager name of group groupCode in family stateValue's family) + (the string form of "]"))) to pieces
            else:
                append (the bim managed type entryId in family stateValue's family in modelValue)'s name to pieces
        free entries
        set joined to pieces joined with " "
        free pieces
        return joined

# The list line of entry `wanted`, or -1.
function the list line of {a 64 bit integer:wanted} among {bim type manager record:stateValue} in {bim model record:modelValue}:
    execute:
        set entries to the bim type manager entries of stateValue in modelValue
        set found to -1
        loop cursor from 0 to the length of entries:
            if (the item at cursor in entries) = wanted:
                set found to cursor
        free entries
        return found

function the fields text of {bim managed type record:row} in {bim editor record:editor}:
    execute:
        set codes to the bim manager fields of row
        set pieces to an empty list of a string
        loop cursor from 0 to the length of codes:
            set fieldCode to the item at cursor in codes
            append (((the string form of fieldCode) + (the string form of ": ")) + (the bim managed field fieldCode of row layer 0 in editor)) to pieces
        free codes
        set joined to pieces joined with "\n  "
        free pieces
        return joined

set editor to a new bim editor
set e to the address of editor
set editor's lengthUnit to bim millimetre unit
set manager to a new bim type manager
set m to the address of manager
open bim type manager in m for e
set geometry to the bim type manager layout of manager across 1280.0 by 900.0
set typesBefore to the length of (editor's documentValue's current's linearTypes's values)

click bim type manager at (geometry's left + 480.0) and (geometry's top + 50.0) across 1280.0 by 900.0 in m for e
check profile browser (manager's family = bim profile family) named (the string form of "a click on the Profiles tab shows the profiles")
print ((the string form of "folded: ") + (the line text of manager in editor's documentValue's current)) as a line

# A click on the HEA header opens that series.
set headerLine to the list line of ((0 - 4) as a 64 bit integer) among manager in editor's documentValue's current
check profile browser (headerLine >= 0) named (the string form of "the HEA series has its header")
set listTop to the bim manager list top
set headerY to ((geometry's top + listTop) + (((headerLine - manager's scroll) as a 64 bit floating-point number) * 24.0)) + 10.0
click bim type manager at (geometry's left + 100.0) and headerY across 1280.0 by 900.0 in m for e
set opened to the line text of manager in editor's documentValue's current
check profile browser ((opened contains "HEA 100") and (opened contains "HEA 1000")) named (the string form of "a click on a series header opens it")
check profile browser ((opened contains "IPE 200") = false) named (the string form of "the other series stay folded")

# Typing filters every series.
type bim type manager character 72 in m
type bim type manager character 69 in m
type bim type manager character 65 in m
type bim type manager character 32 in m
type bim type manager character 50 in m
print ((the string form of "search HEA 2: ") + (the line text of manager in editor's documentValue's current)) as a line
check profile browser ((the length of (editor's documentValue's current's linearTypes's values)) = typesBefore) named (the string form of "browsing makes no types")

# HEA 200 chosen: its dimensions.
set found to the bim catalogue profiles matching (the string form of "HEA 200")
set heaId to (bim manager catalogue base) + (the bim catalogue key of (the item at 0 in found))
free found
set manager's chosenId to heaId
refresh bim type manager m for editor
set heaRow to the bim managed type heaId in family (bim profile family) in editor's documentValue's current
print ((the string form of "HEA 200: ") + heaRow's ifcClass) as a line
print ((the string form of "  ") + (the fields text of heaRow in editor)) as a line

# Add: a beam type of the project, chosen in the profiled family.
click bim type manager at (geometry's left + 40.0) and (geometry's top + 90.0) across 1280.0 by 900.0 in m for e
print manager's message as a line
set addedId to manager's chosenId
set addedFound to the bim linear type index of addedId in editor's documentValue's current
check profile browser (addedFound's valid and (manager's family = bim profiled family)) named (the string form of "Add makes the profile a type and shows it")
set addedType to the item at addedFound's position in (editor's documentValue's current's linearTypes's values)
print ((((the string form of "added: ") + addedType's name) + (the string form of ", ")) + (the bim name of linear role addedType's role)) as a line
check profile browser ((the length of (editor's documentValue's current's linearTypes's values)) = (typesBefore + 1)) named (the string form of "one type is added")

# Back on the Profiles tab: in the project, and Add again makes no second.
click bim type manager at (geometry's left + 480.0) and (geometry's top + 50.0) across 1280.0 by 900.0 in m for e
print ((the string form of "folded again: ") + (the line text of manager in editor's documentValue's current)) as a line
# A catalogue row must be visible before it can be selected. Switching
# tabs folded its series and Add cleared the previous search.
set manager's search to the string form of "HEA 200"
set manager's chosenId to heaId
refresh bim type manager m for editor
set heaRow to the bim managed type heaId in family (bim profile family) in editor's documentValue's current
print ((the string form of "in the project: ") + (the bim managed field 15 of heaRow layer 0 in editor)) as a line
check profile browser (manager's chosenId = heaId) named (the string form of "the existing catalogue profile is visible and selected")
click bim type manager at (geometry's left + 40.0) and (geometry's top + 90.0) across 1280.0 by 900.0 in m for e
check profile browser (((the length of (editor's documentValue's current's linearTypes's values)) = (typesBefore + 1)) and (manager's chosenId = addedId)) named (the string form of "adding it again chooses the type it has")

# Apply: a concrete column profile as a column type, the drawing default.
set editor's linearRole to bim column role
click bim type manager at (geometry's left + 480.0) and (geometry's top + 50.0) across 1280.0 by 900.0 in m for e
set found to the bim catalogue profiles matching (the string form of "Concrete 300x300")
set concreteId to (bim manager catalogue base) + (the bim catalogue key of (the item at 0 in found))
free found
set manager's search to the string form of "Concrete 300x300"
set manager's chosenId to concreteId
refresh bim type manager m for editor
click bim type manager at (geometry's left + 360.0) and (geometry's top + 90.0) across 1280.0 by 900.0 in m for e
print manager's message as a line
set appliedFound to the bim linear type index of editor's linearTypeId in editor's documentValue's current
check profile browser (appliedFound's valid and ((the item at appliedFound's position in (editor's documentValue's current's linearTypes's values))'s role = bim column role)) named (the string form of "Apply makes it a column type and the drawing default")

# A drawn profile of the project, made parametric in the window.
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set drawnId to add bim linear type named (the string form of "Rebated") as role (bim beam role) sized 0.06 by 0.05 round false of (the string form of "timber") to target
set corners to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to corners
append (a cad vector2 with x 0.06 and y 0.0) to corners
append (a cad vector2 with x 0.06 and y 0.03) to corners
append (a cad vector2 with x 0.04 and y 0.03) to corners
append (a cad vector2 with x 0.04 and y 0.05) to corners
append (a cad vector2 with x 0.0 and y 0.05) to corners
ignore give bim linear type drawnId outline corners in target
commit bim transaction in (the address of (editor's documentValue))
set manager's search to the string form of ""
set manager's chosenId to drawnId
refresh bim type manager m for editor
set drawnRow to the bim managed type drawnId in family (bim profile family) in editor's documentValue's current
check profile browser (drawnRow's drawn and (drawnRow's parameterCount = -1)) named (the string form of "a drawn profile is in the project's group, not yet parametric")
print ((the string form of "drawn: ") + (the bim managed field 14 of drawnRow layer 0 in editor)) as a line
check profile browser (make bim managed type drawnId parametric in e) named (the string form of "it is made parametric")
set drawnRow to the bim managed type drawnId in family (bim profile family) in editor's documentValue's current
print ((the string form of "  ") + (the fields text of drawnRow in editor)) as a line
check profile browser (set bim managed type drawnId on tab 8 layer 0 field 40 to (the string form of "90") in e) named (the string form of "its width is typed")
check profile browser (set bim managed type drawnId on tab 8 layer 0 field 41 to (the string form of "=b*0.5") in e) named (the string form of "its depth follows its width")
set drawnRow to the bim managed type drawnId in family (bim profile family) in editor's documentValue's current
print ((((the string form of "now: ") + (the bim managed field 40 of drawnRow layer 0 in editor)) + (the string form of "; ")) + (the bim managed field 41 of drawnRow layer 0 in editor)) as a line
check profile browser (((set bim managed type drawnId on tab 8 layer 0 field 41 to (the string form of "60") in e) = false) and ((set bim managed type drawnId on tab 8 layer 0 field 40 to (the string form of "=q") in e) = false)) named (the string form of "a driven value and an unknown name are refused")
check profile browser (undo bim transaction in (the address of (editor's documentValue))) named (the string form of "the expression is undone")
set drawnRow to the bim managed type drawnId in family (bim profile family) in editor's documentValue's current
print ((((the string form of "undone: ") + (the bim managed field 40 of drawnRow layer 0 in editor)) + (the string form of "; ")) + (the bim managed field 41 of drawnRow layer 0 in editor)) as a line
