# SPDX-License-Identifier: MPL-2.0
# The type editor in the properties window: a wall's type shows its layers;
# a layer's thickness typed, a layer's material clicked to the next, a layer
# added and removed; each renames the type by the rules, and undo takes a
# step back. A column's type takes the next material by a click.
import ui/editor/bim_editor.dl

function click type test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

function type type test {a string:keys} in {a pointer to a bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of keys:
            type bim editor key ((the character at cursor in keys) as an integer) in editor
        type bim editor key bim enter key code in editor

function show type test rows of {a pointer to a bim editor record:editor}:
    execute:
        set propertyRows to the bim property rows of (@intrinsic("dereference", editor))
        loop cursor from 0 to the length of propertyRows:
            set propertyRow to the item at cursor in propertyRows
            if propertyRow's code >= 40:
                print ((the string form of "  ") + ((propertyRow's label + (the string form of ": ")) + propertyRow's value)) as a line

set editor to a new bim editor
set e to the address of editor
type bim editor key 87 in e
click type test at 0.0 and 0.0 in e
click type test at 5.0 and 0.0 in e
type bim editor key bim escape key code in e
type bim editor key 83 in e
click type test at 2.5 and 0.0 in e
print ((the string form of "selected a wall ") + (the string form of (editor's selectionKind = bim wall picked))) as a line
show type test rows of e
start bim editor property ((bim layer thickness property) + 1) in e
type type test (the string form of "0.15") in e
print editor's message as a line
start bim editor property (bim layer material property) in e
print editor's message as a line
start bim editor property (bim add layer property) in e
print editor's message as a line
show type test rows of e
start bim editor property (bim remove layer property) in e
print editor's message as a line
type bim editor key 90 in e
set wallNow to the item at 0 in (editor's documentValue's current's walls's values)
set typeNow to the item at (the bim wall type index of wallNow's typeId in editor's documentValue's current)'s position in (editor's documentValue's current's wallTypes's values)
print ((the string form of "after undo: ") + typeNow's name) as a line
# A column's type: the next material.
type bim editor key bim escape key code in e
type bim editor key 2070 in e
click type test at 10.0 and 10.0 in e
type bim editor key bim escape key code in e
type bim editor key 83 in e
click type test at 10.0 and 10.0 in e
start bim editor property (bim linear material property) in e
print editor's message as a line
