# SPDX-License-Identifier: MPL-2.0
# The IfcTypes window (#91): one tab per type family, the role as a filter
# chip, a group in the list and a field of the type; the typed filter over
# the whole library; and the layer table, whose functions and core flags
# stay with their layers through every edit.
import ui/properties/bim_type_manager.dl

function check type window {boolean:passed} named {a string:caption}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

# Whether every type line of the list passes the window's filter and is of
# group `groupCode` (any group when -1).
function every entry of {bim type manager record:stateValue} in {bim model record:modelValue} is of group {integer:groupCode}:
    execute:
        set entries to the bim type manager entries of stateValue in modelValue
        set fine to (the length of entries) > 0
        loop cursor from 0 to the length of entries:
            set entryId to the item at cursor in entries
            if entryId < (0 as a 64 bit integer):
                set fine to false
            else:
                set row to the bim managed type entryId in family stateValue's family in modelValue
                if (bim managed row row passes stateValue in modelValue) = false:
                    set fine to false
                if (groupCode >= 0) and ((the bim manager group of row) != groupCode):
                    set fine to false
        free entries
        return fine

function the header count of {bim type manager record:stateValue} in {bim model record:modelValue}:
    execute:
        set entries to the bim type manager entries of stateValue in modelValue
        set headers to 0
        loop cursor from 0 to the length of entries:
            if (the item at cursor in entries) < (0 as a 64 bit integer):
                set headers to headers + 1
        free entries
        return headers

set editor to a new bim editor
set e to the address of editor
add bim type library to e
set manager to a new bim type manager
set m to the address of manager
open bim type manager in m for e
set modelValue to editor's documentValue's current

# Families and groups.
set layered to the bim managed types in family (bim layered family) in modelValue
set profiled to the bim managed types in family (bim profiled family) in modelValue
check type window (((the length of layered) >= 72) and ((the length of profiled) >= 14)) named (the string form of "the library's layered and profiled types are in their families")
check type window ((the length of layered) = (the length of (modelValue's wallTypes's values))) named (the string form of "walls, floors, roofs and ceilings are one layered family")
free layered
free profiled
check type window ((manager's family = bim layered family) and (manager's roleFilter = -1)) named (the string form of "the window opens on the layered family with every role")
set entries to the bim type manager entries of manager in modelValue
check type window ((the item at 0 in entries) = ((0 - ((bim wall planar role) + 1)) as a 64 bit integer)) named (the string form of "the list opens with the walls' header")
free entries
check type window ((the header count of manager in modelValue) = 4) named (the string form of "walls, floors, roofs and ceilings each have a header")
check type window (manager's chosenId >= (0 as a 64 bit integer)) named (the string form of "a type, not a header, is chosen")
set manager's roleFilter to bim floor planar role
refresh bim type manager m for editor
check type window (every entry of manager in modelValue is of group (bim floor planar role)) named (the string form of "the floor chip shows floors only")
check type window ((the header count of manager in modelValue) = 0) named (the string form of "a single role shows no headers")
check type window ((the bim managed type manager's chosenId in family (bim layered family) in modelValue)'s role = bim floor planar role) named (the string form of "the choice follows the chip")
check type window (manager's tab = bim floor planar role) named (the string form of "a floor type is edited through the floor category")
set manager's roleFilter to -1
fold bim manager group (bim wall planar role) in m
refresh bim type manager m for editor
set entries to the bim type manager entries of manager in modelValue
check type window (((the item at 0 in entries) = ((0 - ((bim wall planar role) + 1)) as a 64 bit integer)) and ((the item at 1 in entries) = ((0 - ((bim floor planar role) + 1)) as a 64 bit integer))) named (the string form of "a folded group keeps its header and hides its types")
free entries
fold bim manager group (bim wall planar role) in m
refresh bim type manager m for editor

# The typed filter.
type bim type manager character 99 in m
type bim type manager character 76 in m
type bim type manager character 116 in m
check type window ((manager's field = bim manager search field) and (manager's search = (the string form of "cLt"))) named (the string form of "typing with no field open filters the list")
check type window ((every entry of manager in modelValue is of group -1) = false) named (the string form of "headers stay while every role is shown")
set manager's roleFilter to bim wall planar role
refresh bim type manager m for editor
check type window (every entry of manager in modelValue is of group (bim wall planar role)) named (the string form of "the filter matches names and materials regardless of case")
set entries to the bim type manager entries of manager in modelValue
set brickFound to false
loop cursor from 0 to the length of entries:
    if ((the bim managed type (the item at cursor in entries) in family (bim layered family) in modelValue)'s name) contains "Kalkzandsteen 100":
        set brickFound to true
check type window ((brickFound = false) and ((the length of entries) >= 10)) named (the string form of "types without the text are filtered out")
free entries
type bim type manager key 259 in m for e
check type window (manager's search = (the string form of "cL")) named (the string form of "Backspace edits the filter")
type bim type manager key (bim escape key code) in m for e
check type window (((the length of manager's search) = 0) and ((manager's field = -1) and manager's open)) named (the string form of "Esc clears the filter and keeps the window open")
set manager's roleFilter to -1
refresh bim type manager m for editor

# Arrows step over headers: from the first wall, as many steps as there are
# walls reach the first floor.
set entries to the bim type manager entries of manager in modelValue
set floorHeader to -1
loop cursor from 0 to the length of entries:
    if (the item at cursor in entries) = ((0 - ((bim floor planar role) + 1)) as a 64 bit integer):
        set floorHeader to cursor
set manager's chosenId to the item at 1 in entries
set stepped to true
loop stepCursor from 1 to floorHeader:
    type bim type manager key 264 in m for e
    if manager's chosenId < (0 as a 64 bit integer):
        set stepped to false
check type window (stepped and (manager's chosenId = (the item at (floorHeader + 1) in entries))) named (the string form of "Down walks past the walls' end and over the next header")
type bim type manager key 265 in m for e
check type window (manager's chosenId = (the item at (floorHeader - 1) in entries)) named (the string form of "Up walks back over the header")
free entries

# The role is a field of the type.
set fresh to add bim managed type on tab 0 in e
set row to the bim managed type fresh in family (bim layered family) in editor's documentValue's current
check type window ((the bim managed next role of row in editor's documentValue's current) = bim floor planar role) named (the string form of "an unused wall type can become a floor")
check type window (set bim managed type fresh role to (bim floor planar role) in e) named (the string form of "changing the role is a field edit")
set row to the bim managed type fresh in family (bim layered family) in editor's documentValue's current
check type window (((row's role = bim floor planar role) and (row's ifcClass = (the string form of "IfcSlabType"))) and ((the bim manager tab of row in family (bim layered family)) = 1)) named (the string form of "the same type is now an IfcSlabType floor")
set outline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to outline
append (a cad vector2 with x 4.0 and y 0.0) to outline
append (a cad vector2 with x 4.0 and y 4.0) to outline
append (a cad vector2 with x 0.0 and y 4.0) to outline
begin bim transaction in (the address of (editor's documentValue))
set plateId to add bim plate typed fresh on editor's levelId around outline at top 3.0 to (the address of (editor's documentValue's current))
commit bim transaction in (the address of (editor's documentValue))
free outline
check type window (plateId != the bim refused id) named (the string form of "a floor is placed with the type")
check type window ((set bim managed type fresh role to (bim wall planar role) in e) = false) named (the string form of "a type its floors use cannot become a wall")
check type window (set bim managed type fresh role to (bim roof planar role) in e) named (the string form of "a type its floors use can become a roof")
set plateFound to the bim slab index of plateId in editor's documentValue's current
check type window ((the bim role of plate (the item at plateFound's position in (editor's documentValue's current's slabs's values)) in editor's documentValue's current) = bim roof planar role) named (the string form of "its plate follows the type's role")
set wallType to add bim managed type on tab 0 in e
begin bim transaction in (the address of (editor's documentValue))
ignore add bim wall typed wallType on editor's levelId from (a cad vector2 with x 0.0 and y 8.0) to (a cad vector2 with x 5.0 and y 8.0) to (the address of (editor's documentValue's current))
commit bim transaction in (the address of (editor's documentValue))
set row to the bim managed type wallType in family (bim layered family) in editor's documentValue's current
check type window (((the bim managed next role of row in editor's documentValue's current) = -1) and ((set bim managed type wallType role to (bim floor planar role) in e) = false)) named (the string form of "a type walls use stays a wall")
set columnType to add bim managed type on tab 4 in e
check type window (set bim managed type columnType role to (bim beam role) in e) named (the string form of "an unused column type can become a beam")
check type window ((the bim managed type columnType in family (bim profiled family) in editor's documentValue's current)'s ifcClass = (the string form of "IfcBeamType")) named (the string form of "the profiled type is now an IfcBeamType")

# The layer table.
set layeredType to add bim managed type on tab 0 in e
check type window (insert bim type layeredType layer of (the string form of "PIR insulation") 0.1 after 0 in e) named (the string form of "a layer is added under the chosen one")
set modelValue to editor's documentValue's current
check type window (((the bim function of layer 0 of type layeredType in modelValue) = bim structure layer function) and ((the bim function of layer 1 of type layeredType in modelValue) = bim insulation layer function)) named (the string form of "functions follow the materials until chosen")
check type window ((bim layer 0 of type layeredType is core in modelValue) and ((bim layer 1 of type layeredType is core in modelValue) = false)) named (the string form of "the structure is the core until chosen")
check type window (set bim type layeredType layer 1 function to (bim finish layer function) in e) named (the string form of "a layer's function is chosen")
check type window (set bim type layeredType layer 1 core to true in e) named (the string form of "a layer is put in the core")
set undoBefore to the length of (editor's documentValue's undoStack's values)
check type window (move bim type layeredType layer 1 by -1 in e) named (the string form of "a layer moves up")
set modelValue to editor's documentValue's current
set planarFound to the bim wall type index of layeredType in modelValue
set planarType to the item at planarFound's position in (modelValue's wallTypes's values)
check type window (((the item at 0 in (planarType's layers's values))'s material = (the string form of "PIR insulation")) and ((the bim function of layer 0 of type layeredType in modelValue) = bim finish layer function)) named (the string form of "the moved layer keeps its function")
check type window ((bim layer 0 of type layeredType is core in modelValue) and ((the bim function of layer 1 of type layeredType in modelValue) = bim structure layer function)) named (the string form of "the moved layer keeps its core flag and the other keeps its own")
check type window ((the length of (editor's documentValue's undoStack's values)) = (undoBefore + 1)) named (the string form of "a move is one undo step")
check type window (set bim type layeredType layer 1 material to (the string form of "brick") in e) named (the string form of "a layer's material is picked")
set copiedType to duplicate bim managed type layeredType on tab 0 in e
check type window ((the bim function of layer 0 of type copiedType in editor's documentValue's current) = bim finish layer function) named (the string form of "a duplicate keeps the layer functions")
check type window (remove bim type layeredType layer 0 in e) named (the string form of "a layer is removed")
set modelValue to editor's documentValue's current
set planarFound to the bim wall type index of layeredType in modelValue
set planarType to the item at planarFound's position in (modelValue's wallTypes's values)
set stale to the bim setting ((bim layer function setting) + 1) of layeredType in modelValue
check type window ((((the length of (planarType's layers's values)) = 1) and ((the item at 0 in (planarType's layers's values))'s material = (the string form of "brick"))) and (stale's found = false)) named (the string form of "removing a layer drops its settings and keeps the rest aligned")
check type window ((remove bim type layeredType layer 0 in e) = false) named (the string form of "the last layer stays")
ignore undo bim transaction in (the address of (editor's documentValue))
set modelValue to editor's documentValue's current
check type window ((the bim function of layer 0 of type layeredType in modelValue) = bim finish layer function) named (the string form of "undo brings the layer back with its function")
set choices to the bim material choices of modelValue at most 40
set timberSeen to 0
set brickSeen to 0
loop cursor from 0 to the length of choices:
    if (the item at cursor in choices) = (the string form of "timber CLT"):
        set timberSeen to timberSeen + 1
    if (the item at cursor in choices) = (the string form of "brick"):
        set brickSeen to brickSeen + 1
check type window ((timberSeen = 1) and (brickSeen = 1)) named (the string form of "the picker offers library and model materials once each")
free choices

# Clicks: the same geometry hits and draws.
set manager's chosenId to layeredType
set manager's family to bim layered family
set manager's search to the string form of ""
refresh bim type manager m for editor
set geometry to the bim type manager layout of manager across 1280.0 by 900.0
click bim type manager at (geometry's left + 180.0) and (geometry's top + 50.0) across 1280.0 by 900.0 in m for e
check type window (manager's family = bim profiled family) named (the string form of "a click on a family tab shows that family")
click bim type manager at (geometry's left + 30.0) and (geometry's top + 50.0) across 1280.0 by 900.0 in m for e
set manager's chosenId to layeredType
refresh bim type manager m for editor
click bim type manager at (geometry's left + 150.0) and (geometry's top + 128.0) across 1280.0 by 900.0 in m for e
check type window (manager's roleFilter = bim floor planar role) named (the string form of "a click on a role chip filters the list")
set manager's roleFilter to -1
set manager's chosenId to layeredType
refresh bim type manager m for editor
set functionBefore to the bim function of layer 1 of type layeredType in editor's documentValue's current
click bim type manager at (geometry's left + 380.0) and (geometry's top + 370.0) across 1280.0 by 900.0 in m for e
check type window ((manager's layer = 1) and ((the bim function of layer 1 of type layeredType in editor's documentValue's current) = (the bim layer function after functionBefore))) named (the string form of "a click on a function cell turns the layer's function")
click bim type manager at (geometry's left + 500.0) and (geometry's top + 340.0) across 1280.0 by 900.0 in m for e
check type window ((manager's picking = 0) and (manager's layer = 0)) named (the string form of "a click on a material cell opens the picker")
click bim type manager at (geometry's left + 340.0) and (geometry's top + 160.0) across 1280.0 by 900.0 in m for e
set planarFound to the bim wall type index of layeredType in editor's documentValue's current
set planarType to the item at planarFound's position in (editor's documentValue's current's wallTypes's values)
set firstChoice to the bim material after (the string form of "")
check type window ((manager's picking = -1) and ((the item at 0 in (planarType's layers's values))'s material = firstChoice)) named (the string form of "a picked material is the layer's")
click bim type manager at (geometry's left + 650.0) and (geometry's top + 345.0) across 1280.0 by 900.0 in m for e
check type window ((manager's field = 2) and (manager's replaceText and (manager's layer = 0))) named (the string form of "a click on a thickness cell edits it")
type bim type manager character 49 in m
type bim type manager character 50 in m
type bim type manager character 48 in m
set editor's lengthUnit to bim millimetre unit
type bim type manager key (bim enter key code) in m for e
set planarFound to the bim wall type index of layeredType in editor's documentValue's current
set planarType to the item at planarFound's position in (editor's documentValue's current's wallTypes's values)
check type window ((the absolute value of ((the item at 0 in (planarType's layers's values))'s thickness - 0.12)) < 0.000001) named (the string form of "Enter saves the typed thickness")
set countBefore to the length of (planarType's layers's values)
set addTop to (the bim manager layer top of countBefore) + 6.0
click bim type manager at (geometry's left + 360.0) and ((geometry's top + addTop) + 10.0) across 1280.0 by 900.0 in m for e
set planarFound to the bim wall type index of layeredType in editor's documentValue's current
set planarType to the item at planarFound's position in (editor's documentValue's current's wallTypes's values)
check type window ((the length of (planarType's layers's values)) = (countBefore + 1)) named (the string form of "the button under the table adds a layer")
check type window (manager's detailHeight > (the bim manager layer top of countBefore)) named (the string form of "the pane reaches past the table")

# The drawing code compiles with the rest; it runs only in the application.
if (the length of (editor's documentValue's current's walls's values)) > 100000:
    set atlas to @intrinsic("construct", a bim text atlas record, @intrinsic("construct", a graphics texture, 0 as a pointer to a byte, 0, 0), an empty list of a bim text face record, 0, 0, an empty list of a bim icon cell record)
    set frame to @intrinsic("construct", a graphics frame, 0 as a pointer, false)
    draw bim type manager manager for editor across 1280.0 by 900.0 pointing at 0.0 and 0.0 using atlas in frame
