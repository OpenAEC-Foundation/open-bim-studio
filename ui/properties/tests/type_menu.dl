import ui/properties/bim_type_menu.dl
function check type menu {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line
set rangeValue to the bim type menu among 43 showing 12 scrolled -1 marking 28
check type menu ((rangeValue's first = 22) and (rangeValue's count = 12)) named (the string form of "opening centres the selected window recipe")
set rangeValue to the bim type menu among 43 showing 12 scrolled 10000 marking 28
check type menu (((rangeValue's first = 31) and (rangeValue's count = 12)) and ((rangeValue's first + rangeValue's count) = 43)) named (the string form of "last page reaches every sliding recipe")
set rangeValue to the bim type menu among 43 showing 12 scrolled 28 marking 28
check type menu (rangeValue's first = 28) named (the string form of "scrolling back from the end responds immediately")
set rangeValue to the bim type menu among 3 showing 12 scrolled 31 marking 2
check type menu ((rangeValue's first = 0) and (rangeValue's count = 3)) named (the string form of "shorter libraries clamp an old offset")
set rangeValue to the bim type menu among 0 showing 12 scrolled -1 marking -1
check type menu ((rangeValue's first = 0) and (rangeValue's count = 0)) named (the string form of "empty libraries have no selectable rows")
set rangeValue to the bim type menu among 43 showing 0 scrolled 42 marking 42
check type menu ((rangeValue's first = 42) and (rangeValue's count = 1)) named (the string form of "small panes retain a valid row range")
