# SPDX-License-Identifier: MPL-2.0
# Fastener lengths keep their fractional millimetres in Properties (issue
# 79: an M16's 1.5 mm pitch read "2 mm"), while walls and drawings keep the
# whole-millimetre `the bim length … in units`.
import ui/properties/bim_editor_properties.dl

function check fastener lengths {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The shown value of the row `label` among `rows`, or "" when it is absent.
function the shown fastener value labelled {a string:wanted} among {a pointer to a list:listed}:
    execute:
        loop cursor from 0 to the length of listed:
            set entry to the item at cursor in listed
            if entry's label = wanted:
                return entry's value
        return the string form of ""

set millimetres to bim millimetre unit
check fastener lengths ((the bim fastener length 0.00125 in units millimetres) = (the string form of "1.25 mm")) named (the string form of "a 1.25 mm pitch reads 1.25 mm")
check fastener lengths ((the bim fastener length 0.0015 in units millimetres) = (the string form of "1.5 mm")) named (the string form of "a 1.5 mm pitch reads 1.5 mm")
check fastener lengths ((the bim fastener length 0.002 in units millimetres) = (the string form of "2 mm")) named (the string form of "a 2 mm pitch reads 2 mm")
check fastener lengths ((the bim fastener length 0.0016 in units millimetres) = (the string form of "1.6 mm")) named (the string form of "a 1.6 mm washer reads 1.6 mm")
check fastener lengths ((the bim fastener length 0.016 in units millimetres) = (the string form of "16 mm")) named (the string form of "an M16 reads 16 mm")
check fastener lengths ((the bim fastener length 0.0015 in units bim centimetre unit) = (the string form of "0.15 cm")) named (the string form of "in centimetres 0.15 cm")
check fastener lengths ((the bim length 0.0015 in units millimetres) = (the string form of "2 mm")) named (the string form of "the general length formatter is unchanged")

set parameters to catalogued connection fastener parameters
set parameters's pitch to 0.0015
set rows to an empty list of a bim property row record
append bim fastener rows of parameters diameter 0.016 length 0.08 kind 1 starting 62048 in units millimetres into rows
check fastener lengths ((the shown fastener value labelled (the string form of "Thread pitch") among rows) = (the string form of "1.5 mm")) named (the string form of "an M16 bolt with a 1.5 mm pitch shows 1.5 mm")
check fastener lengths (parameters's pitch = 0.0015) named (the string form of "showing the row leaves the stored pitch exact")
