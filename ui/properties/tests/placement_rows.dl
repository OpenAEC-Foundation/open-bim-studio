# SPDX-License-Identifier: MPL-2.0
# The properties show the selection's position and its rotation about X, Y
# and Z (#137); typed, a value does what a gizmo drag does. A wall's
# Rotation X is its lean, its Rotation Y cannot be typed; a roof's Rotation
# Y is its slope; a refused value leaves the element and the undo history
# as they were.
import ui/properties/bim_editor_properties.dl

function the placement row {a string:caption} of {bim editor record:editor}:
    execute:
        set shownRows to the bim property rows of editor
        set found to the string form of "(missing)"
        loop rowCursor from 0 to the length of shownRows:
            set shownRow to the item at rowCursor in shownRows
            if shownRow's label = caption:
                set found to (shownRow's value + (the string form of " [")) + ((the string form of shownRow's code) + (the string form of "]"))
        free shownRows
        return found

function type placement row {integer:rowCode} as {a string:typedText} in {a pointer to a bim editor record:editor}:
    execute:
        start bim editor property rowCode in editor
        set editor's propertyText to typedText
        apply bim editor property in editor
        print editor's message as a line

function show placement rows of {bim editor record:editor} labelled {a string:label}:
    execute:
        print label as a line
        set captions to (the string form of "Position X,Position Y,Position Z,Rotation X,Rotation Y,Rotation Z") split at ","
        loop cursor from 0 to the length of captions:
            print ((the string form of "  ") + ((the item at cursor in captions) + ((the string form of ": ") + (the placement row (the item at cursor in captions) of editor)))) as a line
        free captions

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set editor's lengthUnit to bim millimetre unit
begin bim transaction in (the address of (editor's documentValue))
set wallType to (the item at 0 in (target's wallTypes's values))'s id
set wallId to add bim wall typed wallType on editor's levelId from (a cad vector2 with x 1.0 and y 2.0) to (a cad vector2 with x 5.0 and y 2.0) to target
commit bim transaction in (the address of (editor's documentValue))
select bim editor bim wall picked numbered wallId in e
show placement rows of editor labelled (the string form of "wall")
type placement row ((bim placement property) + 3) as (the string form of "5") in e
type placement row ((bim placement property) + 2) as (the string form of "250") in e
type placement row ((bim placement property) + 0) as (the string form of "2000") in e
set steps to the length of (editor's documentValue's undoStack's values)
type placement row ((bim placement property) + 3) as (the string form of "80") in e
print ((the string form of "refused kept the undo history: ") + (the string form of ((the length of (editor's documentValue's undoStack's values)) = steps))) as a line
show placement rows of editor labelled (the string form of "wall typed")
set wallValue to the item at 0 in (editor's documentValue's current's walls's values)
print ((the string form of "lean (mm) ") + (the string form of ((the floor of ((wallValue's lean * 1000.0) + 0.5)) as an integer))) as a line
ignore undo bim transaction in (the address of (editor's documentValue))
show placement rows of editor labelled (the string form of "undone once")

set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.2)) to layers
begin bim transaction in (the address of (editor's documentValue))
set roofType to add bim planar type named (the string form of "Roof") as role bim roof planar role with layers to target
set outline to an empty list of a cad vector2
append (a cad vector2 with x 10.0 and y 0.0) to outline
append (a cad vector2 with x 14.0 and y 0.0) to outline
append (a cad vector2 with x 14.0 and y 4.0) to outline
append (a cad vector2 with x 10.0 and y 4.0) to outline
set roofId to add bim plate typed roofType on editor's levelId around outline at top 3.0 to target
commit bim transaction in (the address of (editor's documentValue))
select bim editor bim slab picked numbered roofId in e
type placement row ((bim placement property) + 4) as (the string form of "-25") in e
show placement rows of editor labelled (the string form of "roof sloped")
print ((the string form of "roof Pitch row: ") + (the placement row (the string form of "Pitch") of editor)) as a line
