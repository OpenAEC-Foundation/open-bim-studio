# SPDX-License-Identifier: MPL-2.0
# The properties panel's groups (#96) and its remaining choice menus (#99):
# a wall's rows come in groups, those its type holds marked apart from its
# own; a group folds shut by its name and stays shut for the next element
# that shows it; the type's "Edit type" row opens the type window; a
# property set of the wall's IFC class is added empty, filled in, written
# to IFC and removed again, each as one edit; a layer's material, a linear
# element's joint and material, its type's shape and a level's extent are
# chosen from menus; rows of other elements that share none of those codes
# stay typed.
import ui/editor/bim_editor.dl

function check property groups {boolean:passed} named {a string:caption}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

# The headings of what `editor` shows, in order, a type's marked "(type)".
function print groups of {bim editor record:editor}:
    execute:
        set shownRows to the bim property rows of editor
        set listed to the string form of ""
        loop rowCursor from 0 to the length of shownRows:
            set shownRow to the item at rowCursor in shownRows
            if bim property code (shownRow's code) heads a group:
                if (the length of listed) > 0:
                    set listed to listed + (the string form of " | ")
                set listed to listed + shownRow's label
                if shownRow's code = bim type group heading code:
                    set listed to listed + (the string form of " (type)")
        free shownRows
        print ((the string form of "  groups: ") + listed) as a line

# Where row `rowName` stands among what `editor` shows: -1 when missing.
function the row place of {a string:rowName} in {bim editor record:editor}:
    execute:
        set shownRows to the bim property rows of editor
        set found to -1
        loop rowCursor from 0 to the length of shownRows:
            if ((the item at rowCursor in shownRows)'s label = rowName) and (found < 0):
                set found to rowCursor
        free shownRows
        return found

function row {a string:rowName} belongs to the type in {bim editor record:editor}:
    execute:
        set shownRows to the bim property rows of editor
        set held to bim property row (the row place of rowName in editor) among shownRows belongs to the type
        free shownRows
        return held

function the shown value of {a string:rowName} in {bim editor record:editor}:
    execute:
        set shownRows to the bim property rows of editor
        set found to the string form of "(missing)"
        set place to the row place of rowName in editor
        if place >= 0:
            set found to (the item at place in shownRows)'s value
        free shownRows
        return found

function the row code of {a string:rowName} in {bim editor record:editor}:
    execute:
        set shownRows to the bim property rows of editor
        set found to 0
        set place to the row place of rowName in editor
        if place >= 0:
            set found to (the item at place in shownRows)'s code
        free shownRows
        return found

# The heading order (headings only, counted from 0) of group `groupName`.
function the heading order of {a string:groupName} in {bim editor record:editor}:
    execute:
        set shownRows to the bim property rows of editor
        set counted to -1
        set found to -1
        loop rowCursor from 0 to the length of shownRows:
            set shownRow to the item at rowCursor in shownRows
            if bim property code (shownRow's code) heads a group:
                set counted to counted + 1
                if (shownRow's label = groupName) and (found < 0):
                    set found to counted
        free shownRows
        return found

function print menu of {integer:rowCode} in {bim editor record:editor}:
    execute:
        set offeredNames to the bim menu offering of property rowCode for editor
        set listed to the string form of ""
        loop offerCursor from 0 to the length of offeredNames:
            if offerCursor > 0:
                set listed to listed + (the string form of " | ")
            set listed to listed + (the item at offerCursor in offeredNames)
        free offeredNames
        print ((the string form of "  options: ") + listed) as a line
        print ((the string form of "  holds option ") + (the string form of (the bim standing menu option of property rowCode for editor))) as a line

# The option of row `rowCode` named `optionName`, chosen from the panel.
function pick option {a string:optionName} of row {integer:rowCode} in {a pointer to a bim editor record:editor}:
    execute:
        set offeredNames to the bim menu offering of property rowCode for (@intrinsic("dereference", editor))
        set place to -1
        loop offerCursor from 0 to the length of offeredNames:
            if (the item at offerCursor in offeredNames) = optionName:
                set place to offerCursor
        free offeredNames
        start bim editor property (the bim menu toggle of property rowCode) in editor
        start bim editor property (the bim menu option place of property rowCode) in editor

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set firstWall to add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 5.0 and y 0.0) to target
set secondWall to add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 0.0 and y 3.0) to (a cad vector2 with x 5.0 and y 3.0) to target
select bim editor bim wall picked numbered firstWall in e

# Groups: the wall's own, then its type's, then phasing and property sets.
print (the string form of "wall:") as a line
print groups of editor
check property groups ((row (the string form of "Height") belongs to the type in editor) = false) named (the string form of "the wall's height is its own")
check property groups (row (the string form of "Width") belongs to the type in editor) named (the string form of "the width is the type's")
check property groups (row (the string form of "NL-SfB") belongs to the type in editor) named (the string form of "the classification is the type's")
check property groups (row (the string form of "Layer 1 thickness") belongs to the type in editor) named (the string form of "a layer is the type's")
check property groups ((row (the string form of "Phase built (click)") belongs to the type in editor) = false) named (the string form of "the phasing is the wall's own")
check property groups ((the row code of (the string form of "Edit type") in editor) = bim edit type property) named (the string form of "the type has an Edit type row")
check property groups ((the bim window command of property (bim edit type property)) = bim type manager command) named (the string form of "Edit type opens the type window")
check property groups ((the bim window command of property (bim wall height property)) = -1) named (the string form of "other rows go to the editor")

# Folding by name: Layers shut stays shut on the next wall, then opens.
set layersOrder to the heading order of (the string form of "Layers") in editor
set shownRows to the bim property rows of editor
check property groups (fold or open bim property heading layersOrder among shownRows in e) named (the string form of "a click on the Layers heading folds it")
free shownRows
check property groups (bim property group (the string form of "Layers") is folded for editor) named (the string form of "the Layers group is shut")
check property groups ((bim property group (the string form of "Type") is folded for editor) = false) named (the string form of "the other groups stay open")
select bim editor bim wall picked numbered secondWall in e
check property groups (bim property group (the string form of "Layers") is folded for editor) named (the string form of "the next wall's Layers stay shut")
fold or open bim property group (the string form of "Layers") in e
check property groups ((bim property group (the string form of "Layers") is folded for editor) = false) named (the string form of "a second click opens it")
select bim editor bim wall picked numbered firstWall in e

# A layer's material from its menu.
check property groups (bim property (bim layer material property) opens a menu) named (the string form of "a layer's material is a choice row")
check property groups ((bim property (bim layer edge property) opens a menu) = false) named (the string form of "a layer's edge stays typed")
check property groups (((bim property 90 opens a menu) = false) and ((bim property 96 opens a menu) = false)) named (the string form of "a reinforcement's rows stay typed")
print (the string form of "layer 1 material:") as a line
print menu of (bim layer material property) in editor
pick option (the string form of "timber") of row (bim layer material property) in e
print ((the string form of "  layer 1 now: ") + (the shown value of (the string form of "Layer 1 (click)") in editor)) as a line
check property groups ((the shown value of (the string form of "Layer 1 (click)") in editor) = (the string form of "timber")) named (the string form of "the layer takes the material chosen")

# Optional property sets: offered by the wall's IFC class.
print (the string form of "add property set:") as a line
print menu of (bim add pset property) in editor
pick option (the string form of "Pset_ManufacturerTypeInformation") of row (bim add pset property) in e
print editor's message as a line
set wallSets to the bim property set names of firstWall in editor's documentValue's current
check property groups ((the length of (wallSets's values)) = 1) named (the string form of "the wall has the set")
check property groups ((the shown value of (the string form of "Manufacturer") in editor) = (the string form of "-")) named (the string form of "its properties show empty")
start bim editor property (the row code of (the string form of "Manufacturer") in editor) in e
set editor's propertyText to the string form of "Xella"
apply bim editor property in e
check property groups ((the shown value of (the string form of "Manufacturer") in editor) = (the string form of "Xella")) named (the string form of "a property of the set is typed")
pick option (the string form of "Pset_ManufacturerTypeInformation") of row (bim add pset property) in e
print editor's message as a line
pick option (the string form of "Pset_WallCommon") of row (bim add pset property) in e
set ifcText to the bim ifc text of editor's documentValue's current
check property groups ((the index of (the string form of "IFCPROPERTYSINGLEVALUE('IsExternal',$,$,$)") in ifcText) >= 0) named (the string form of "a boolean not filled in is written unset")
check property groups ((the index of (the string form of "IFCPROPERTYSINGLEVALUE('Manufacturer',$,IFCLABEL('Xella'),$)") in ifcText) >= 0) named (the string form of "the manufacturer is written to IFC")
print (the string form of "remove property set:") as a line
print menu of (bim remove pset property) in editor
pick option (the string form of "Pset_ManufacturerTypeInformation") of row (bim remove pset property) in e
print editor's message as a line
check property groups ((the shown value of (the string form of "Manufacturer") in editor) = (the string form of "(missing)")) named (the string form of "the set is removed whole")
ignore undo bim transaction in (the address of (editor's documentValue))
check property groups ((the shown value of (the string form of "Manufacturer") in editor) = (the string form of "Xella")) named (the string form of "one undo brings the set back")
pick option (the string form of "Own property...") of row (bim add pset property) in e
check property groups (editor's propertyCode = bim new pset property) named (the string form of "an own property is typed on the New property row")
type bim editor key (bim escape key code) in e

# A linear element: its joints, its type's material and shape.
set beamType to add bim linear type named (the string form of "Beam 200x400") as role (bim beam role) sized 0.2 by 0.4 round false of (the string form of "concrete") to target
set beam to add bim linear typed beamType on editor's levelId from (a cad vector3 with x 0.0, y 6.0 and z 3.0) to (a cad vector3 with x 4.0, y 6.0 and z 3.0) turned 0.0 to target
select bim editor bim linear picked numbered beam in e
print (the string form of "beam:") as a line
print groups of editor
print (the string form of "start joint:") as a line
print menu of (bim start connection property) in editor
pick option (the string form of "Butt") of row (bim start connection property) in e
check property groups ((the shown value of (the string form of "Start joint (click)") in editor) = (the string form of "Butt")) named (the string form of "the start joint is chosen")
pick option (the string form of "steel") of row (bim linear material property) in e
check property groups ((the shown value of (the string form of "Material (click)") in editor) = (the string form of "steel")) named (the string form of "the type's material is chosen")
print (the string form of "shape:") as a line
print menu of (bim profile shape property) in editor
pick option (the string form of "I shape") of row (bim profile shape property) in e
print editor's message as a line
check property groups ((the shown value of (the string form of "Profile") in editor) = (the string form of "IfcIShapeProfileDef")) named (the string form of "the type takes an I shape")
check property groups ((the shown value of (the string form of "Shape (click)") in editor) = (the string form of "I shape")) named (the string form of "the shape row shows it")
pick option (the string form of "Circle") of row (bim profile shape property) in e
check property groups ((the shown value of (the string form of "Profile") in editor) = (the string form of "IfcCircleProfileDef")) named (the string form of "the type turns round")
check property groups (row (the string form of "Shape (click)") belongs to the type in editor) named (the string form of "the shape is the type's")

# A level's extent, chosen.
select bim editor bim level picked numbered editor's levelId in e
print (the string form of "level extent:") as a line
print menu of (bim level extent property) in editor
pick option (the string form of "Its own") of row (bim level extent property) in e
check property groups ((the shown value of (the string form of "Extent") in editor) = (the string form of "Its own")) named (the string form of "the level keeps an extent of its own")
pick option (the string form of "Its own") of row (bim level extent property) in e
check property groups ((the shown value of (the string form of "Extent") in editor) = (the string form of "Its own")) named (the string form of "choosing what it holds changes nothing")
print (the string form of "level property sets:") as a line
print menu of (bim add pset property) in editor
