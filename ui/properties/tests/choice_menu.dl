# SPDX-License-Identifier: MPL-2.0
# Choice rows open a menu of their options (#99): a view's display, phase
# and drawing type and the project's length unit are chosen with a click on
# an option or with the arrow keys and Enter, Esc closes without a change,
# and a row's own code still takes the next value. A sheet's number and name
# are typed and its paper and orientation chosen, each as one edit.
import ui/editor/bim_editor.dl

function check choice menu {boolean:passed} named {a string:caption}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function the shown value of {a string:rowName} in {bim editor record:editor}:
    execute:
        set shownRows to the bim property rows of editor
        set found to the string form of "(missing)"
        loop rowCursor from 0 to the length of shownRows:
            if (the item at rowCursor in shownRows)'s label = rowName:
                set found to (the item at rowCursor in shownRows)'s value
        free shownRows
        return found

function print menu of {integer:rowCode} in {bim editor record:editor}:
    execute:
        set offeredNames to the bim menu offering of property rowCode for editor
        set listed to the string form of ""
        loop offerCursor from 0 to the length of offeredNames:
            if offerCursor > 0:
                set listed to listed + (the string form of " | ")
            set listed to listed + (the item at offerCursor in offeredNames)
        free offeredNames
        print ((the string form of "  options: ") + listed) as a line
        print ((the string form of "  holds option ") + (the string form of (the bim standing menu option of property rowCode for editor))) as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set planId to add bim view of kind bim plan view kind named (the string form of "Ground plan") on editor's levelId to target
set editor's planViewId to planId
set editor's propertiesViewId to planId

check choice menu (bim property (bim view display property) opens a menu) named (the string form of "display is a choice row")
check choice menu ((bim property (bim view scale property) opens a menu) = false) named (the string form of "scale is typed, not a choice")
check choice menu ((the bim unhinted form of (the string form of "Phase (click)")) = (the string form of "Phase")) named (the string form of "the panel drops the click hint")

# Display: opened from the panel, the arrow down and Enter choose Hidden.
print (the string form of "display:") as a line
print menu of (bim view display property) in editor
start bim editor property (the bim menu toggle of property (bim view display property)) in e
check choice menu (bim editor shows a property menu editor) named (the string form of "a click on the field opens the menu")
check choice menu ((the bim highlighted menu option of editor) = 0) named (the string form of "the keys start on the option held")
type bim editor key (bim arrow down key code) in e
check choice menu ((the bim highlighted menu option of editor) = 1) named (the string form of "arrow down reaches the next option")
type bim editor key (bim enter key code) in e
check choice menu ((bim editor shows a property menu editor) = false) named (the string form of "Enter closes the menu")
check choice menu ((the shown value of (the string form of "Display (click)") in editor) = (the string form of "Hidden")) named (the string form of "Enter chooses the option reached")

# Esc closes without a change.
start bim editor property (the bim menu toggle of property (bim view display property)) in e
type bim editor key (bim arrow down key code) in e
type bim editor key (bim escape key code) in e
check choice menu ((bim editor shows a property menu editor) = false) named (the string form of "Esc closes the menu")
check choice menu ((the shown value of (the string form of "Display (click)") in editor) = (the string form of "Hidden")) named (the string form of "Esc leaves the value")

# A second click on the field shuts the menu.
start bim editor property (the bim menu toggle of property (bim view display property)) in e
start bim editor property (the bim menu toggle of property (bim view display property)) in e
check choice menu ((bim editor shows a property menu editor) = false) named (the string form of "a second click shuts the menu")

# The row's own code (context menu, API) still takes the next value.
start bim editor property (bim view display property) in e
check choice menu ((the shown value of (the string form of "Display (click)") in editor) = (the string form of "Wire")) named (the string form of "the row's code still steps")

# Phase: a click on the first option.
start bim editor property (the bim menu toggle of property (bim view phase property)) in e
print (the string form of "view phase:") as a line
print menu of (bim view phase property) in editor
start bim editor property (the bim menu option 0 of property (bim view phase property)) in e
check choice menu ((bim editor shows a property menu editor) = false) named (the string form of "an option chosen closes the menu")
print ((the string form of "  phase now: ") + (the shown value of (the string form of "Phase (click)") in editor)) as a line

# Drawing type: the menu adds the library's types when the model lacks them.
start bim editor property (the bim menu toggle of property (bim view drawing type property)) in e
print (the string form of "drawing type:") as a line
print menu of (bim view drawing type property) in editor
start bim editor property (the bim menu option 1 of property (bim view drawing type property)) in e
print ((the string form of "  drawing type now: ") + (the shown value of (the string form of "Drawing type (click)") in editor)) as a line

# The project's length unit: metres from the menu.
type bim editor key 2198 in e
print (the string form of "length unit:") as a line
print menu of (bim project length unit property) in editor
start bim editor property (the bim menu toggle of property (bim project length unit property)) in e
start bim editor property (the bim menu option 2 of property (bim project length unit property)) in e
check choice menu ((the shown value of (the string form of "Length (click)") in editor) = (the string form of "m")) named (the string form of "length unit chosen from the menu")
check choice menu ((the bim name of unit editor's lengthUnit) = (the string form of "m")) named (the string form of "the editor shows lengths in the unit chosen")

# A sheet: number and name typed, paper and orientation chosen.
set sheetId to add bim sheet numbered (the string form of "A01") named (the string form of "Plans") on paper 4 landscape false to target
set otherSheet to add bim sheet numbered (the string form of "A02") named (the string form of "Sections") on paper 4 landscape false to target
set editor's sheetId to sheetId
set editor's propertiesViewId to bim sheet properties context
start bim editor property (bim sheet name property) in e
set editor's propertyText to the string form of " Ground floor "
type bim editor key (bim enter key code) in e
start bim editor property (bim sheet number property) in e
set editor's propertyText to the string form of "A02"
type bim editor key (bim enter key code) in e
check choice menu ((the shown value of (the string form of "Number") in editor) = (the string form of "A01")) named (the string form of "a number another sheet has is refused")
start bim editor property (bim sheet number property) in e
set editor's propertyText to the string form of "A10"
type bim editor key (bim enter key code) in e
print (the string form of "sheet paper:") as a line
print menu of (bim sheet paper property) in editor
start bim editor property (the bim menu toggle of property (bim sheet paper property)) in e
start bim editor property (the bim menu option 3 of property (bim sheet paper property)) in e
start bim editor property (the bim menu toggle of property (bim sheet orientation property)) in e
start bim editor property (the bim menu option 1 of property (bim sheet orientation property)) in e
set sheetFound to the bim sheet index of sheetId in editor's documentValue's current
set sheetValue to the item at sheetFound's position in (editor's documentValue's current's sheets's values)
print ((the string form of "  sheet: ") + ((sheetValue's number + (the string form of " ")) + ((sheetValue's name + (the string form of " ")) + (the bim format name of sheetValue's paper)))) as a line
check choice menu (sheetValue's landscape and (sheetValue's paper = 3)) named (the string form of "sheet on A3, landscape")
check choice menu ((the shown value of (the string form of "Orientation") in editor) = (the string form of "Landscape")) named (the string form of "the panel shows the orientation chosen")
ignore undo bim transaction in (the address of (editor's documentValue))
set sheetFound to the bim sheet index of sheetId in editor's documentValue's current
set sheetValue to the item at sheetFound's position in (editor's documentValue's current's sheets's values)
check choice menu ((sheetValue's landscape = false) and (sheetValue's paper = 3)) named (the string form of "one undo takes back the orientation alone")
print ((the string form of "  after undo: ") + ((sheetValue's number + (the string form of " ")) + ((sheetValue's name + (the string form of " ")) + (the bim format name of sheetValue's paper)))) as a line
