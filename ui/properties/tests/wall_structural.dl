# SPDX-License-Identifier: MPL-2.0
# A wall's Structural row in the properties: it shows whether the wall
# bears load and a click toggles the wall's own LoadBearing, whatever its
# type says, as one undoable edit.
import ui/editor/bim_editor.dl

function check wall structural {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function the structural row of {bim editor record:editor}:
    execute:
        set shownRows to the bim property rows of editor
        set found to the string form of "missing"
        loop rowCursor from 0 to the length of shownRows:
            set shownRow to the item at rowCursor in shownRows
            if shownRow's label = (the string form of "Structural (click)"):
                set found to shownRow's value
        free shownRows
        return found

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set ground to add bim level named (the string form of "Street") at 0.0 with height 3.0 to target
set brickLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to brickLayers
set brickType to add bim wall type named (the string form of "Brick") with brickLayers to target
free brickLayers
set wallId to add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to target
set editor's levelId to ground
select bim editor bim wall picked numbered wallId in e

set before to bim element wallId bears load in editor's documentValue's current
set shownBefore to the structural row of editor
print ((the string form of "a new brick wall shows: ") + shownBefore) as a line
check wall structural (shownBefore != (the string form of "missing")) named (the string form of "a wall has a Structural row")
check wall structural ((shownBefore = (the string form of "Yes")) = before) named (the string form of "the row shows whether the wall bears load")
start bim editor property (bim wall structural property) in e
check wall structural ((bim element wallId bears load in editor's documentValue's current) != before) named (the string form of "a click toggles the wall's own LoadBearing")
check wall structural ((the structural row of editor) != shownBefore) named (the string form of "the row follows")
start bim editor property (bim wall structural property) in e
check wall structural ((bim element wallId bears load in editor's documentValue's current) = before) named (the string form of "a second click toggles it back")
ignore undo bim transaction in (the address of (editor's documentValue))
check wall structural ((bim element wallId bears load in editor's documentValue's current) != before) named (the string form of "each click is one undoable edit")
