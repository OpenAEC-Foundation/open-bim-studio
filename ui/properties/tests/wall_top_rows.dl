# SPDX-License-Identifier: MPL-2.0
# A wall's top constraint in the properties (issue #107): the Top constraint
# row is a menu of Unconnected, the levels above the foot and the floors,
# roofs and ceilings over the wall; held at a level or attached, the height
# is read-only and a Top offset row is typed; a choice that would put the
# top below the foot is refused; Unconnected keeps the height.
import ui/editor/bim_editor.dl

function show wall top rows of {bim editor record:editor} labelled {a string:caption}:
    execute:
        print caption as a line
        set shownRows to the bim property rows of editor
        loop rowCursor from 0 to the length of shownRows:
            set shownRow to the item at rowCursor in shownRows
            if ((shownRow's label = (the string form of "Height")) or (shownRow's label = (the string form of "Base offset"))) or ((shownRow's label = (the string form of "Top constraint (click)")) or (shownRow's label = (the string form of "Top offset"))):
                print ((the string form of "  ") + ((shownRow's label + (the string form of ": ")) + ((shownRow's value + (the string form of " #")) + (the string form of shownRow's code)))) as a line
        free shownRows

function show wall top menu of {bim editor record:editor}:
    execute:
        set offeredNames to the bim menu offering of property (bim wall top constraint property) for editor
        set listed to the string form of ""
        loop offerCursor from 0 to the length of offeredNames:
            if offerCursor > 0:
                set listed to listed + (the string form of " | ")
            set listed to listed + (the item at offerCursor in offeredNames)
        free offeredNames
        print ((the string form of "  options: ") + listed) as a line
        print ((the string form of "  holds option ") + (the string form of (the bim standing menu option of property (bim wall top constraint property) for editor))) as a line

function choose wall top option {integer:optionIndex} in {a pointer to a bim editor record:editor}:
    execute:
        start bim editor property (the bim menu toggle of property (bim wall top constraint property)) in editor
        start bim editor property (the bim menu option optionIndex of property (bim wall top constraint property)) in editor
        print ((the string form of "  ") + editor's message) as a line

function type wall top keys {a string:keys} into {integer:rowCode} in {a pointer to a bim editor record:editor}:
    execute:
        start bim editor property rowCode in editor
        loop cursor from 0 to the length of keys:
            type bim editor key ((the character at cursor in keys) as an integer) in editor
        type bim editor key bim enter key code in editor
        print ((the string form of "  ") + editor's message) as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set ground to add bim level named (the string form of "Street") at 0.0 with height 3.0 to target
set upper to add bim level named (the string form of "First") at 3.0 with height 3.0 to target
set brickLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to brickLayers
set brickType to add bim wall type named (the string form of "Brick") with brickLayers to target
free brickLayers
set concreteLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.25)) to concreteLayers
set floorType to add bim planar type named (the string form of "Floor 250") as role (bim floor planar role) with concreteLayers to target
free concreteLayers
set floorOutline to an empty list of a cad vector2
append (a cad vector2 with x -1.0 and y -1.0) to floorOutline
append (a cad vector2 with x 5.0 and y -1.0) to floorOutline
append (a cad vector2 with x 5.0 and y 1.0) to floorOutline
append (a cad vector2 with x -1.0 and y 1.0) to floorOutline
set floorId to add bim plate typed floorType on upper around floorOutline at top 0.0 to target
free floorOutline
set wallId to add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to target
ignore (set bim wall wallId height to 2.5 in target)
set editor's levelId to ground
select bim editor bim wall picked numbered wallId in e

print ((the string form of "top constraint is a choice row: ") + (the string form of (bim property (bim wall top constraint property) opens a menu))) as a line
show wall top rows of editor labelled (the string form of "unconnected")
show wall top menu of editor

# Up to the level First: the height follows and is read-only.
print (the string form of "up to First:") as a line
set firstOption to 0
set offeredNames to the bim menu offering of property (bim wall top constraint property) for editor
loop offerCursor from 0 to the length of offeredNames:
    if (the item at offerCursor in offeredNames) = (the string form of "Up to level: First"):
        set firstOption to offerCursor
free offeredNames
choose wall top option firstOption in e
show wall top rows of editor labelled (the string form of "held")
show wall top menu of editor
type wall top keys (the string form of "-0.15") into (bim wall top offset property) in e
show wall top rows of editor labelled (the string form of "offset typed")
type wall top keys (the string form of "-2.95") into (bim wall top offset property) in e
show wall top rows of editor labelled (the string form of "offset refused")
type wall top keys (the string form of "0") into (bim wall top offset property) in e

# Attached to the floor of First: its underside.
print (the string form of "attached:") as a line
set lastOption to 0
set offeredNames to the bim menu offering of property (bim wall top constraint property) for editor
set lastOption to (the length of offeredNames) - 1
free offeredNames
choose wall top option lastOption in e
show wall top rows of editor labelled (the string form of "attached")
show wall top menu of editor
# The floor raised in one edit: the wall follows it.
begin bim transaction in (the address of (editor's documentValue))
ignore (set bim plate floorId top to 0.4 pitch 0.0 heading 0.0 in target)
commit bim transaction in (the address of (editor's documentValue))
show wall top rows of editor labelled (the string form of "floor raised")

# A typed height is not taken while the top is constrained; Unconnected
# keeps it.
print (the string form of "unconnected again:") as a line
choose wall top option 0 in e
show wall top rows of editor labelled (the string form of "unconnected")
type wall top keys (the string form of "2") into (bim wall height property) in e
show wall top rows of editor labelled (the string form of "height typed")
