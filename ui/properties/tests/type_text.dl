import editor/bim_type_text.dl

function check type text {boolean:accepted} named {a string:captionText}:
    execute:
        if accepted = false:
            print ((the string form of "FAIL: ") + captionText) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + captionText) as a line

check type text ((the bim manager octet at 0 in (the string form of "é")) = 195) named (the string form of "UTF8 leading byte is unsigned 195")
check type text ((the bim manager octet at 1 in (the string form of "é")) = 169) named (the string form of "UTF8 continuation byte is unsigned 169")
check type text ((the bim managed clean name of (the string form of "")) = (the string form of "")) named (the string form of "empty trimming reads no byte")
check type text ((the bim managed clean name of (the string form of "   ")) = (the string form of "")) named (the string form of "space only trimming stays bounded")
check type text ((the bim managed clean name of (the string form of "  é  ")) = (the string form of "é")) named (the string form of "edge trimming preserves the multibyte character")
check type text ((the bim managed clean name of (the string form of " é  nom ")) = (the string form of "é  nom")) named (the string form of "trimming preserves internal spaces and UTF8 bytes")
check type text ((the bim text backspace prefix length of (the string form of "")) = 0) named (the string form of "empty Backspace prefix is zero")
check type text ((the bim text backspace prefix length of (the string form of "abc")) = 2) named (the string form of "ASCII Backspace drops one byte")
check type text ((the bim text backspace prefix length of (the string form of "é")) = 0) named (the string form of "single two byte character has empty prefix")
check type text ((the bim text backspace prefix length of (the string form of "Aé")) = 1) named (the string form of "two byte Backspace preserves the ASCII prefix")
check type text ((the bim text backspace prefix length of (the string form of "A€")) = 1) named (the string form of "three byte Backspace preserves the ASCII prefix")
check type text ((the bim text backspace prefix length of (the string form of "A😀")) = 1) named (the string form of "four byte Backspace preserves the ASCII prefix")
check type text ((the bim text backspace prefix length of (the string form of "A😀B")) = 5) named (the string form of "ASCII after a multibyte character keeps the entire UTF8 prefix")
