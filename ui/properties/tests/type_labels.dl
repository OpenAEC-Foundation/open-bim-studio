# SPDX-License-Identifier: MPL-2.0
import editor/bim_type_labels.dl
function check type label {boolean:condition} named {a string:caption}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line
set two to the bim compact type label of (the string form of "Reynaers ConceptPatio 130 - 2 rail layout")
set three to the bim compact type label of (the string form of "Reynaers ConceptPatio 130 - 3 rail layout")
check type label ((two = (the string form of "CP130 2 rail")) and (three = (the string form of "CP130 3 rail"))) named (the string form of "rail count stays visible in compact CP130 labels")
check type label ((the bim compact type label of (the string form of "Reynaers MasterPatio - 3 rail layout")) = (the string form of "MasterPatio 3 rail")) named (the string form of "MasterPatio keeps family and track count")
check type label ((the bim compact type label of (the string form of "Reynaers SlimPatio 68 - 2 rail layout")) = (the string form of "SlimPatio 68 2 rail")) named (the string form of "SlimPatio keeps series and track count")
check type label ((the bim compact type label of (the string form of "Fixed timber 90x139")) = (the string form of "Fixed timber 90x139")) named (the string form of "ordinary type labels keep their dimensions")
set original to the string form of "Fixed timber 90x139"
set unchanged to the bim compact type label of original
check type label ((the data of original) = (the data of unchanged)) named (the string form of "unchanged labels reuse the original string")
