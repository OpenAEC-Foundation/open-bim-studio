# SPDX-License-Identifier: MPL-2.0
# The project's data and a sheet's title block data in the properties
# (drawing quality plan, item 10):
# - the project's name, number, client (opdrachtgever), architect and
#   phase, typed, on the Project data page of the Project settings window
#   and in the project's properties (`bim_project_settings.dl`);
# - a sheet's date, who drew it and who checked it, typed, its current
#   revision, and a row that adds a revision: what changed is typed, the
#   revision takes the next code, the sheet's date (today when it has none)
#   and its drawn and checked by (`bim_sheet.dl`).
# Each change is one edit; an empty value removes the field.
import ui/editor/bim_editor_core.dl
import ui/properties/bim_editor_properties.dl
import views/sheets/bim_sheet.dl
import bim/bim_project_settings.dl
import exchange/ifcx/bim_ifcx.dl

# The project's fields (12820 plus `bim project name field` and on, up to
# 12824) and the sheet's (12825 to 12828).
function bim project data property:
    replacement:
        12820
function bim sheet date property:
    replacement:
        12825
function bim sheet drawn property:
    replacement:
        12826
function bim sheet checked property:
    replacement:
        12827
function bim sheet revision property:
    replacement:
        12828

# Whether property `code` is one of these, typed as text.
function bim title block property {integer:code} takes text:
    execute:
        return (code >= bim project data property) and (code <= bim sheet revision property)

# The project's data as rows: a heading and a typed row per field.
function append bim project data rows of {bim model record:modelValue} to {a pointer to a list:rowList}:
    execute:
        append bim heading (the string form of "Project data") to rowList
        set labels to [the string form of "Project name", the string form of "Project number", the string form of "Client (opdrachtgever)", the string form of "Architect", the string form of "Phase"]
        loop fieldCursor from 0 to (bim project field count):
            set shown to the bim project text fieldCursor of modelValue
            if (the length of shown) = 0:
                set shown to the string form of "-"
            append bim property (the item at fieldCursor in labels) showing shown as ((bim project data property) + fieldCursor) to rowList

# The title block rows of sheet `sheetId`: its date, drawn and checked by,
# its current revision and the row that adds one.
function append bim title block rows of sheet {a 64 bit integer:sheetId} in {bim model record:modelValue} to {a pointer to a list:rowList}:
    execute:
        append bim heading (the string form of "Title block") to rowList
        set fieldNames to [the bim sheet date field, the bim sheet drawn field, the bim sheet checked field]
        set labels to [the string form of "Date", the string form of "Drawn by", the string form of "Checked by"]
        loop fieldCursor from 0 to 3:
            set shown to the bim sheet field (the item at fieldCursor in fieldNames) of sheet sheetId in modelValue
            if (the length of shown) = 0:
                set shown to the string form of "-"
            append bim property (the item at fieldCursor in labels) showing shown as ((bim sheet date property) + fieldCursor) to rowList
        set currentCode to the bim current revision of sheet sheetId in modelValue
        if (the length of currentCode) = 0:
            set currentCode to the string form of "-"
        append bim property (the string form of "Revision") showing currentCode as 0 to rowList
        append bim property (the string form of "Add revision (type what changed)") showing (the bim next revision code of sheet sheetId in modelValue) as bim sheet revision property to rowList

# Today's date as the title block writes it: 2026-11-06.
function the bim date today:
    execute:
        set moment to the bim calendar of (the bim wall seconds) local true
        set buffer to a new string buffer containing 16 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 17 as a word sized unsigned integer, "%04d-%02d-%02d", moment's year as a 32 bit integer, moment's month as a 32 bit integer, moment's day as a 32 bit integer)
        return the substring of buffer from 0 spanning written bytes

# The typed text applied to property `code` when it is one of these, as
# one edit; true when it is.
function apply bim editor title block text {integer:code} in {a pointer to a bim editor record:editor}:
    execute:
        if (bim title block property code takes text) = false:
            return false
        set typedText to the bim trimmed grid label of editor's propertyText
        set target to the address of (editor's documentValue's current)
        if code < bim sheet date property:
            set fieldCode to code - (bim project data property)
            begin bim transaction in (the address of (editor's documentValue))
            set bim project text fieldCode to typedText in target
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to (the string form of "Project ") + (the bim project field name of fieldCode)
            return true
        set sheetId to editor's sheetId
        if (editor's propertiesViewId != bim sheet properties context) or ((the bim sheet index of sheetId in editor's documentValue's current)'s valid = false):
            set editor's message to the string form of "Open a sheet first"
            return true
        if code = bim sheet revision property:
            set sheetDate to the bim sheet field (the bim sheet date field) of sheet sheetId in editor's documentValue's current
            if (the length of sheetDate) = 0:
                set sheetDate to the bim date today
            set drawer to the bim sheet field (the bim sheet drawn field) of sheet sheetId in editor's documentValue's current
            set checker to the bim sheet field (the bim sheet checked field) of sheet sheetId in editor's documentValue's current
            begin bim transaction in (the address of (editor's documentValue))
            set added to add bim revision (the string form of "") dated sheetDate saying typedText drawn by drawer checked by checker to sheet sheetId in target
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to (the string form of "Revision ") + added
            return true
        set fieldNames to [the bim sheet date field, the bim sheet drawn field, the bim sheet checked field]
        set fieldName to the item at (code - (bim sheet date property)) in fieldNames
        begin bim transaction in (the address of (editor's documentValue))
        set bim sheet field fieldName of sheet sheetId to typedText in target
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to (the string form of "Title block: ") + fieldName
        return true
