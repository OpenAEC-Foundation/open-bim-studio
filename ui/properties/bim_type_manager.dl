# SPDX-License-Identifier: MPL-2.0
# Central type-library editing. Every operation addresses a type id directly;
# browsing, editing and duplication never create temporary occurrences.
import ui/editor/bim_editor.dl
import ui/panels/bim_ui.dl
import ui/properties/bim_type_menu.dl
import ui/properties/bim_type_text.dl
import ui/properties/bim_type_layers.dl

class:
    patterns:
        [a|] bim type manager record
    members:
        open as a boolean
        tab as an integer
        chosenId as a 64 bit integer
        scroll as an integer
        field as an integer
        text as a string
        message as a string
        layer as an integer
        revision as a 64 bit integer
        replaceText as a boolean
        detailScroll as an integer
        # The window shows one family at a time (`bim layered family` and
        # the others); `tab` is the category of the chosen type within it.
        family as an integer
        # The role chip: -1 for every role, or the group shown alone.
        roleFilter as an integer
        # The filter typed over the list: matches names and materials.
        search as a string
        # The groups folded away, one bit per group (2 to the group).
        collapsed as an integer
        # The material picker: -1 closed, a layer's index, or
        # `bim manager linear material` for a profiled type's material.
        picking as an integer
        # How far the detail pane's content reaches, set by the refresh.
        detailHeight as a 64 bit floating-point number

class:
    patterns:
        [a|] bim type manager layout record
    members:
        width as a 64 bit floating-point number
        height as a 64 bit floating-point number
        left as a 64 bit floating-point number
        top as a 64 bit floating-point number
        bodyTop as a 64 bit floating-point number
        bodyBottom as a 64 bit floating-point number
        detailShift as a 64 bit floating-point number
        detailLimit as a 64 bit floating-point number

class:
    patterns:
        [a|] bim managed type record
    members:
        id as a 64 bit integer
        family as an integer
        role as an integer
        name as a string
        ifcClass as a string
        material as a string
        width as a 64 bit floating-point number
        depth as a 64 bit floating-point number
        sill as a 64 bit floating-point number
        round as a boolean
        layerCount as an integer

# `bim type manager command`, which opens this window: `bim_property_groups.dl`.

function a new bim type manager:
    execute:
        return @intrinsic("construct", a bim type manager record, false, 0, the bim refused id, 0, -1, the string form of "", the string form of "", 0, ((-1) as a 64 bit integer), false, 0, 0, -1, the string form of "", 0, -1, 0.0)

# The families of types the window shows, one tab each: what a type is made
# of, not what it is for. Its role (wall or floor, column or beam) is a
# filter chip, a group in the list and a field of the type.
function bim layered family:
    replacement:
        0
function bim profiled family:
    replacement:
        1
function bim opening family:
    replacement:
        2
function bim profile family:
    replacement:
        3

# `field` while the filter over the list takes the typed characters.
function bim manager search field:
    replacement:
        20
# `picking` while the picker chooses a profiled type's material.
function bim manager linear material:
    replacement:
        1000

function the bim type manager family names:
    execute:
        return [the string form of "Layered", the string form of "Profiled", the string form of "Openings", the string form of "Profiles"]

# The family of category `tabIndex` (the categories of `the bim managed
# types on tab`).
function the bim family of manager tab {integer:tabIndex}:
    execute:
        if tabIndex <= 3:
            return bim layered family
        if tabIndex <= 6:
            return bim profiled family
        if tabIndex = 7:
            return bim opening family
        return bim profile family

# The categories of family `familyCode`, in the order the list shows them.
function the bim manager tabs of family {integer:familyCode}:
    execute:
        set familyTabs to an empty list of an integer
        if familyCode = bim layered family:
            loop cursor from 0 to 4:
                append cursor to familyTabs
        else if familyCode = bim profiled family:
            loop cursor from 4 to 7:
                append cursor to familyTabs
        else if familyCode = bim opening family:
            append 7 to familyTabs
        else:
            append 8 to familyTabs
        return familyTabs

# The groups of family `familyCode`, as its role chips and list headers show
# them: planar roles, linear roles, 0 window and 1 door. Profiles are one
# list without groups.
function the bim manager groups of family {integer:familyCode}:
    execute:
        set familyGroups to an empty list of an integer
        if familyCode = bim layered family:
            append bim wall planar role to familyGroups
            append bim floor planar role to familyGroups
            append bim roof planar role to familyGroups
            append bim ceiling planar role to familyGroups
        if familyCode = bim profiled family:
            append bim column role to familyGroups
            append bim beam role to familyGroups
            append bim pile role to familyGroups
        if familyCode = bim opening family:
            append 0 to familyGroups
            append 1 to familyGroups
        return familyGroups

function the bim manager group of {bim managed type record:row}:
    execute:
        if row's family = 2:
            if row's round:
                return 1
            return 0
        return row's role

function the bim manager name of group {integer:groupCode} in family {integer:familyCode}:
    execute:
        if familyCode = bim layered family:
            return the bim name of planar role groupCode
        if familyCode = bim opening family:
            if groupCode = 1:
                return the string form of "Door"
            return the string form of "Window"
        return the bim name of linear role groupCode

# The category type `row` of family `familyCode` is edited through.
function the bim manager tab of {bim managed type record:row} in family {integer:familyCode}:
    execute:
        if familyCode = bim profile family:
            return 8
        if row's family = 0:
            return row's role
        if row's family = 2:
            return 7
        if row's role = bim beam role:
            return 5
        if row's role = bim pile role:
            return 6
        return 4

# Every type of family `familyCode`, group after group.
function the bim managed types in family {integer:familyCode} in {bim model record:modelValue}:
    execute:
        set rows to an empty list of a bim managed type record
        set tabs to the bim manager tabs of family familyCode
        loop tabCursor from 0 to the length of tabs:
            set tabRows to the bim managed types on tab (the item at tabCursor in tabs) in modelValue
            if familyCode = bim opening family:
                loop pass from 0 to 2:
                    loop cursor from 0 to the length of tabRows:
                        set candidate to the item at cursor in tabRows
                        if (the bim manager group of candidate) = pass:
                            append candidate to rows
            else:
                loop cursor from 0 to the length of tabRows:
                    append (the item at cursor in tabRows) to rows
            free tabRows
        free tabs
        return rows

function the bim managed type {a 64 bit integer:typeId} in family {integer:familyCode} in {bim model record:modelValue}:
    execute:
        set rows to the bim managed types in family familyCode in modelValue
        set result to @intrinsic("construct", a bim managed type record, the bim refused id, -1, -1, the string form of "", the string form of "", the string form of "", 0.0, 0.0, 0.0, false, 0)
        loop cursor from 0 to the length of rows:
            if (the item at cursor in rows)'s id = typeId:
                set result to the item at cursor in rows
        free rows
        return result

# Whether `row` passes the window's role chip and typed filter. The filter
# matches the name and, for a layered type, any layer's material, without
# regard to case.
function bim managed row {bim managed type record:row} passes {bim type manager record:stateValue} in {bim model record:modelValue}:
    execute:
        if (stateValue's roleFilter >= 0) and ((the bim manager group of row) != stateValue's roleFilter):
            return false
        if (the length of stateValue's search) = 0:
            return true
        set wanted to the lowercase form of stateValue's search
        if (the lowercase form of row's name) contains wanted:
            return true
        if (the lowercase form of row's material) contains wanted:
            return true
        if row's family = 0:
            set found to the bim wall type index of row's id in modelValue
            if found's valid:
                set planarType to the item at found's position in (modelValue's wallTypes's values)
                loop cursor from 0 to the length of (planarType's layers's values):
                    if (the lowercase form of ((the item at cursor in (planarType's layers's values))'s material)) contains wanted:
                        return true
        return false

local function the bim manager bit of group {integer:groupCode}:
    execute:
        set groupBit to 1
        loop cursor from 0 to the minimum of 20 and (the maximum of 0 and groupCode):
            set groupBit to groupBit * 2
        return groupBit

function bim manager group {integer:groupCode} is folded in {bim type manager record:stateValue}:
    execute:
        set bit to the bim manager bit of group groupCode
        return (the remainder of (stateValue's collapsed / bit) divided by 2) = 1

# Folds group `groupCode` away, or unfolds it.
function fold bim manager group {integer:groupCode} in {a pointer to a bim type manager record:state}:
    execute:
        set bit to the bim manager bit of group groupCode
        if bim manager group groupCode is folded in (@intrinsic("dereference", state)):
            set state's collapsed to state's collapsed - bit
        else:
            set state's collapsed to state's collapsed + bit

# The lines of the list: a type's id, or a group's header as minus one more
# than the group. Headers show only while every role is shown; a folded
# group keeps its header and hides its types.
function the bim type manager entries of {bim type manager record:stateValue} in {bim model record:modelValue}:
    execute:
        set listEntries to an empty list of a 64 bit integer
        set rows to the bim managed types in family stateValue's family in modelValue
        set groups to the bim manager groups of family stateValue's family
        set headed to (stateValue's roleFilter < 0) and ((the length of groups) > 0)
        if headed:
            loop groupCursor from 0 to the length of groups:
                set groupCode to the item at groupCursor in groups
                set folded to bim manager group groupCode is folded in stateValue
                set headerShown to false
                loop cursor from 0 to the length of rows:
                    set row to the item at cursor in rows
                    if ((the bim manager group of row) = groupCode) and (bim managed row row passes stateValue in modelValue):
                        if headerShown = false:
                            append ((0 - (groupCode + 1)) as a 64 bit integer) to listEntries
                            set headerShown to true
                        if folded = false:
                            append row's id to listEntries
        else:
            loop cursor from 0 to the length of rows:
                set row to the item at cursor in rows
                if bim managed row row passes stateValue in modelValue:
                    append row's id to listEntries
        free groups
        free rows
        return listEntries

# How many types of group `groupCode` pass the filter, for its header.
local function the bim manager count of group {integer:groupCode} in {bim type manager record:stateValue} in {bim model record:modelValue}:
    execute:
        set rows to the bim managed types in family stateValue's family in modelValue
        set countValue to 0
        loop cursor from 0 to the length of rows:
            set row to the item at cursor in rows
            if ((the bim manager group of row) = groupCode) and (bim managed row row passes stateValue in modelValue):
                set countValue to countValue + 1
        free rows
        return countValue

# The use counts of `typeIds` in one pass over the model, counted as `the
# bim managed type use count of` counts them.
function the bim managed use counts of {a pointer to a list:typeIds} in {bim model record:modelValue}:
    execute:
        set used to an empty list of a 64 bit integer
        loop cursor from 0 to the length of (modelValue's walls's values):
            append (the item at cursor in (modelValue's walls's values))'s typeId to used
        loop cursor from 0 to the length of (modelValue's slabs's values):
            append (the item at cursor in (modelValue's slabs's values))'s typeId to used
        loop cursor from 0 to the length of (modelValue's linears's values):
            append (the item at cursor in (modelValue's linears's values))'s typeId to used
        loop cursor from 0 to the length of (modelValue's openings's values):
            append (the item at cursor in (modelValue's openings's values))'s typeId to used
        loop cursor from 0 to the length of (modelValue's settings's values):
            set entry to the item at cursor in (modelValue's settings's values)
            set panelReference to (entry's code >= bim panel type setting) and (entry's code < bim connection setting)
            set partReference to (entry's code >= bim part type setting) and (entry's code < ((bim part type setting) + 8))
            if panelReference or partReference:
                append entry's value to used
        set useTotals to an empty list of an integer
        loop cursor from 0 to the length of typeIds:
            set wanted to the item at cursor in typeIds
            set countValue to 0
            loop usedCursor from 0 to the length of used:
                if (the item at usedCursor in used) = wanted:
                    set countValue to countValue + 1
            append countValue to useTotals
        free used
        return useTotals

# The uses of type `typeId` by kind: walls, plates, and everything else.
local function the bim managed uses of {a 64 bit integer:typeId} by walls in {bim model record:modelValue}:
    execute:
        set countValue to 0
        loop cursor from 0 to the length of (modelValue's walls's values):
            if (the item at cursor in (modelValue's walls's values))'s typeId = typeId:
                set countValue to countValue + 1
        return countValue

local function the bim managed uses of {a 64 bit integer:typeId} by plates in {bim model record:modelValue}:
    execute:
        set countValue to 0
        loop cursor from 0 to the length of (modelValue's slabs's values):
            if (the item at cursor in (modelValue's slabs's values))'s typeId = typeId:
                set countValue to countValue + 1
        return countValue

# The role type `row` takes next when its role field is clicked, or -1 when
# it cannot change: a planar type used by walls stays a wall, one used by
# plates stays a floor, roof or ceiling (its plates follow), and a profiled
# type changes role only while nothing uses it. Openings switch between
# window and door through `toggle`.
function the bim managed next role of {bim managed type record:row} in {bim model record:modelValue}:
    execute:
        if row's id = the bim refused id:
            return -1
        set total to the bim managed type use count of row's id in modelValue
        if row's family = 0:
            set plates to the bim managed uses of row's id by plates in modelValue
            if total = 0:
                return the remainder of (row's role + 1) divided by 4
            if plates = total:
                set nextRole to row's role + 1
                if nextRole > (bim ceiling planar role):
                    set nextRole to bim floor planar role
                return nextRole
            return -1
        if (row's family = 1) and (total = 0):
            if row's role = bim column role:
                return bim beam role
            if row's role = bim beam role:
                return bim pile role
            return bim column role
        return -1

# Gives type `typeId` role `roleCode`: a field edit of the type, which keeps
# its id, name, layers or profile, settings and properties.
function set bim managed type {a 64 bit integer:typeId} role to {integer:roleCode} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set planarFound to the bim wall type index of typeId in (@intrinsic("dereference", target))
        set linearFound to the bim linear type index of typeId in (@intrinsic("dereference", target))
        if (planarFound's valid = false) and (linearFound's valid = false):
            return false
        if planarFound's valid:
            if ((roleCode < bim wall planar role) or (roleCode > bim ceiling planar role)) or ((the bim managed uses of typeId by walls in (@intrinsic("dereference", target))) > 0):
                return false
            if ((the bim managed uses of typeId by plates in (@intrinsic("dereference", target))) > 0) and (roleCode = bim wall planar role):
                return false
        else:
            if ((roleCode != bim column role) and (roleCode != bim beam role)) and (roleCode != bim pile role):
                return false
            if (the bim managed type use count of typeId in (@intrinsic("dereference", target))) > 0:
                return false
        begin bim transaction in (the address of (editor's documentValue))
        if planarFound's valid:
            set planarType to the item at planarFound's position in (target's wallTypes's values)
            replace item at index planarFound's position in (target's wallTypes's values) with (@intrinsic("construct", a bim wall type record, planarType's id, planarType's name, the cad clone of planarType's layers, roleCode))
        else:
            set linearType to the item at linearFound's position in (target's linearTypes's values)
            replace item at index linearFound's position in (target's linearTypes's values) with (@intrinsic("construct", a bim linear type record, linearType's id, linearType's name, roleCode, linearType's width, linearType's depth, linearType's round, linearType's material))
        name bim types by the rules in target
        note bim change of typeId in target
        commit bim transaction in (the address of (editor's documentValue))
        refresh bim editor editor
        return true

function the bim type manager tab names:
    execute:
        return [the string form of "Wall", the string form of "Slab", the string form of "Roof", the string form of "Ceiling", the string form of "Column", the string form of "Beam", the string form of "Pile", the string form of "Opening", the string form of "Profiles"]

function the bim managed types on tab {integer:tabIndex} in {bim model record:modelValue}:
    execute:
        set rows to an empty list of a bim managed type record
        if (tabIndex >= 0) and (tabIndex < 4):
            loop cursor from 0 to the length of (modelValue's wallTypes's values):
                set planarType to the item at cursor in (modelValue's wallTypes's values)
                if planarType's role = tabIndex:
                    set material to the string form of ""
                    if (the length of (planarType's layers's values)) > 0:
                        set material to (the item at 0 in (planarType's layers's values))'s material
                    append (@intrinsic("construct", a bim managed type record, planarType's id, 0, planarType's role, planarType's name, (the bim ifc class of planar role planarType's role) + (the string form of "Type"), material, the bim thickness of planarType, 0.0, 0.0, false, the length of (planarType's layers's values))) to rows
        if ((tabIndex >= 4) and (tabIndex <= 6)) or (tabIndex = 8):
            set wantedRole to bim column role
            if tabIndex = 5:
                set wantedRole to bim beam role
            if tabIndex = 6:
                set wantedRole to bim pile role
            loop cursor from 0 to the length of (modelValue's linearTypes's values):
                set linearType to the item at cursor in (modelValue's linearTypes's values)
                set fits to linearType's role = wantedRole
                if tabIndex = 8:
                    set fits to (the bim setting (bim steel series setting) of linearType's id in modelValue)'s found
                if fits:
                    append (@intrinsic("construct", a bim managed type record, linearType's id, 1, linearType's role, linearType's name, (the bim ifc class of linear role linearType's role) + (the string form of "Type"), linearType's material, linearType's width, linearType's depth, 0.0, linearType's round, 0)) to rows
        if tabIndex = 7:
            loop cursor from 0 to the length of (modelValue's openingTypes's values):
                set openingType to the item at cursor in (modelValue's openingTypes's values)
                set className to the string form of "IfcWindowType"
                if openingType's isDoor:
                    set className to the string form of "IfcDoorType"
                append (@intrinsic("construct", a bim managed type record, openingType's id, 2, 0, openingType's name, className, the string form of "Frame", openingType's width, openingType's height, openingType's sill, openingType's isDoor, 0)) to rows
        return rows

function the bim managed type {a 64 bit integer:typeId} on tab {integer:tabIndex} in {bim model record:modelValue}:
    execute:
        set rows to the bim managed types on tab tabIndex in modelValue
        set result to @intrinsic("construct", a bim managed type record, the bim refused id, -1, -1, the string form of "", the string form of "", the string form of "", 0.0, 0.0, 0.0, false, 0)
        loop cursor from 0 to the length of rows:
            set row to the item at cursor in rows
            if row's id = typeId:
                set result to row
        free rows
        return result

# Counts placed occurrences and panel/assembly references, not editor defaults.
function the bim managed type use count of {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        set countValue to 0
        loop cursor from 0 to the length of (modelValue's walls's values):
            if (the item at cursor in (modelValue's walls's values))'s typeId = typeId:
                set countValue to countValue + 1
        loop cursor from 0 to the length of (modelValue's slabs's values):
            if (the item at cursor in (modelValue's slabs's values))'s typeId = typeId:
                set countValue to countValue + 1
        loop cursor from 0 to the length of (modelValue's linears's values):
            if (the item at cursor in (modelValue's linears's values))'s typeId = typeId:
                set countValue to countValue + 1
        loop cursor from 0 to the length of (modelValue's openings's values):
            if (the item at cursor in (modelValue's openings's values))'s typeId = typeId:
                set countValue to countValue + 1
        loop cursor from 0 to the length of (modelValue's settings's values):
            set entry to the item at cursor in (modelValue's settings's values)
            set panelReference to (entry's code >= bim panel type setting) and (entry's code < bim connection setting)
            set partReference to (entry's code >= bim part type setting) and (entry's code < ((bim part type setting) + 8))
            if (panelReference or partReference) and (entry's value = typeId):
                set countValue to countValue + 1
        return countValue

# The category a new type of the window's family and role chip goes to.
function the bim manager adding tab of {bim type manager record:stateValue}:
    execute:
        if stateValue's family = bim layered family:
            if (stateValue's roleFilter >= 0) and (stateValue's roleFilter <= 3):
                return stateValue's roleFilter
            return 0
        if stateValue's family = bim profiled family:
            if stateValue's roleFilter = bim beam role:
                return 5
            if stateValue's roleFilter = bim pile role:
                return 6
            return 4
        if stateValue's family = bim opening family:
            return 7
        return 8

# The field codes the detail pane shows for `row`, top to bottom: 0 name,
# 7 role (window or door for an opening), 1 material, 2 width, 3 depth or
# height, 8 shape, 4 sill, 5 NL-SfB, 6 OmniClass. A layered type's
# materials and thicknesses are in its layer table instead.
function the bim manager fields of {bim managed type record:row}:
    execute:
        set codes to an empty list of an integer
        append 0 to codes
        append 7 to codes
        if row's family = 1:
            append 1 to codes
            append 2 to codes
            append 3 to codes
            append 8 to codes
        if row's family = 2:
            append 2 to codes
            append 3 to codes
            append 4 to codes
        append 5 to codes
        append 6 to codes
        return codes

# The detail pane's geometry, in pixels from the window's top before the
# pane is scrolled: the fields, the layer table's header and rows, the
# button under the table and the line under everything.
function the bim manager fields top of {bim managed type record:row}:
    execute:
        if row's family = 0:
            return 164.0
        return 258.0

function the bim manager field top of slot {integer:slotIndex} of {bim managed type record:row}:
    execute:
        return (the bim manager fields top of row) + ((slotIndex as a 64 bit floating-point number) * 34.0)

function the bim manager table top:
    execute:
        return 308.0

function the bim manager layer top of {integer:layerIndex}:
    execute:
        return 330.0 + ((layerIndex as a 64 bit floating-point number) * 30.0)

function the bim manager footer top of {bim managed type record:row}:
    execute:
        if row's family = 0:
            return (the bim manager layer top of row's layerCount) + 40.0
        set codes to the bim manager fields of row
        set slots to the length of codes
        free codes
        return (the bim manager field top of slot slots of row) + 6.0

function the bim manager detail bottom of {bim managed type record:row}:
    execute:
        if row's id = the bim refused id:
            return 0.0
        return (the bim manager footer top of row) + 24.0

# The layer table's columns: the left edge and width of column `columnIndex`
# (0 function, 1 material, 2 thickness, 3 core, 4 up, 5 down, 6 remove).
function the bim manager column left of {integer:columnIndex}:
    execute:
        if columnIndex = 0:
            return 344.0
        if columnIndex = 1:
            return 448.0
        if columnIndex = 2:
            return 616.0
        return 702.0 + (((columnIndex - 3) as a 64 bit floating-point number) * 26.0)

function the bim manager column width of {integer:columnIndex}:
    execute:
        if columnIndex = 0:
            return 100.0
        if columnIndex = 1:
            return 164.0
        if columnIndex = 2:
            return 80.0
        return 22.0

function the bim manager section left:
    execute:
        return 818.0

function refresh bim type manager {a pointer to a bim type manager record:state} for {bim editor record:editor}:
    execute:
        set state's family to the minimum of 3 and (the maximum of 0 and state's family)
        set modelValue to editor's documentValue's current
        set entries to the bim type manager entries of (@intrinsic("dereference", state)) in modelValue
        set found to false
        loop cursor from 0 to the length of entries:
            if ((the item at cursor in entries) = state's chosenId) and (state's chosenId >= (0 as a 64 bit integer)):
                set found to true
        if found = false:
            set state's chosenId to the bim refused id
            loop cursor from 0 to the length of entries:
                if (state's chosenId = the bim refused id) and ((the item at cursor in entries) >= (0 as a 64 bit integer)):
                    set state's chosenId to the item at cursor in entries
            if state's field != bim manager search field:
                set state's field to -1
            set state's layer to 0
            set state's picking to -1
        if (state's revision != editor's documentValue's revision) and ((state's field >= 0) and (state's field != bim manager search field)):
            set state's field to -1
            set state's message to the string form of "Model changed; choose a field again"
        set state's revision to editor's documentValue's revision
        set state's scroll to the minimum of (the maximum of 0 and ((the length of entries) - 1)) and (the maximum of 0 and state's scroll)
        set chosen to the bim managed type state's chosenId in family state's family in modelValue
        if chosen's id = the bim refused id:
            set state's tab to the bim manager adding tab of (@intrinsic("dereference", state))
        else:
            set state's tab to the bim manager tab of chosen in family state's family
        set state's layer to the minimum of (the maximum of 0 and (chosen's layerCount - 1)) and (the maximum of 0 and state's layer)
        set state's detailHeight to the bim manager detail bottom of chosen
        free entries

function open bim type manager in {a pointer to a bim type manager record:state} for {a pointer to a bim editor record:editor}:
    execute:
        set selectedKind to editor's selectionKind
        set selectedId to editor's selectionId
        set selectedPart to editor's partCode
        set provisional to ((editor's dragging or editor's grabbing) or (editor's pushId != the bim refused id)) or (((editor's tool = bim move tool) and (editor's moveStage = 2)) or ((editor's tool = bim rotate tool) and (editor's moveStage = 3)))
        if provisional:
            roll back bim transaction in (the address of (editor's documentValue))
        set editor's dragging to false
        set editor's grabbing to false
        set editor's pushId to the bim refused id
        set editor's moveStage to 0
        if bim editor sketches a boundary (@intrinsic("dereference", editor)):
            leave bim editor boundary sketch in editor
        set editor's editMode to false
        set editor's propertyCode to -1
        set editor's textActive to false
        set editor's partCode to -1
        set editor's gridDragId to the bim refused id
        set editor's bendWallId to the bim refused id
        set editor's slabCorner to -1
        type bim editor key (bim escape key code) in editor
        set editor's selectionKind to selectedKind
        set editor's selectionId to selectedId
        set editor's partCode to selectedPart
        set state's open to true
        set state's field to -1
        set state's message to the string form of "Edit shared types; Apply updates a compatible selection or the drawing default"
        set state's chosenId to the bim selected type id of (@intrinsic("dereference", editor))
        if selectedKind = bim slab picked:
            set plateFound to the bim slab index of selectedId in editor's documentValue's current
            if plateFound's valid:
                set state's tab to the bim role of plate (the item at plateFound's position in (editor's documentValue's current's slabs's values)) in editor's documentValue's current
        else if selectedKind = bim wall picked:
            set state's tab to 0
        else if selectedKind = bim opening picked:
            set state's tab to 7
        else if selectedKind = bim linear picked:
            set chosenType to the bim linear type index of state's chosenId in editor's documentValue's current
            if chosenType's valid:
                set roleCode to (the item at chosenType's position in (editor's documentValue's current's linearTypes's values))'s role
                set state's tab to 4
                if roleCode = bim beam role:
                    set state's tab to 5
                if roleCode = bim pile role:
                    set state's tab to 6
        set state's family to the bim family of manager tab state's tab
        set state's roleFilter to -1
        set state's search to the string form of ""
        set state's picking to -1
        set state's scroll to 0
        set state's detailScroll to 0
        refresh bim type manager state for (@intrinsic("dereference", editor))
        bring bim manager choice into view in state for (@intrinsic("dereference", editor))
        refresh bim editor editor

# Scrolls the list so that the chosen type is on it, a few lines down.
function bring bim manager choice into view in {a pointer to a bim type manager record:state} for {bim editor record:editor}:
    execute:
        set entries to the bim type manager entries of (@intrinsic("dereference", state)) in editor's documentValue's current
        loop cursor from 0 to the length of entries:
            if ((the item at cursor in entries) = state's chosenId) and (state's chosenId >= (0 as a 64 bit integer)):
                set state's scroll to the maximum of 0 and (cursor - 3)
        free entries

function add bim managed type on tab {integer:tabIndex} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        begin bim transaction in (the address of (editor's documentValue))
        set fresh to the bim refused id
        if (tabIndex >= 0) and (tabIndex <= 3):
            set layers to an empty list of a bim layer record
            append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to layers
            set fresh to add bim planar type named (the string form of "New type") as role tabIndex with layers to target
            free layers
        else if tabIndex = 7:
            set fresh to add bim opening type named (the string form of "New window") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
        else:
            set roleCode to bim column role
            if (tabIndex = 5) or (tabIndex = 8):
                set roleCode to bim beam role
            if tabIndex = 6:
                set roleCode to bim pile role
            set fresh to add bim linear type named (the string form of "New type") as role roleCode sized 0.3 by 0.3 round (tabIndex = 6) of (the string form of "concrete") to target
        if fresh = the bim refused id:
            roll back bim transaction in (the address of (editor's documentValue))
        else:
            note bim change of fresh in target
            commit bim transaction in (the address of (editor's documentValue))
        refresh bim editor editor
        return fresh

function duplicate bim managed type {a 64 bit integer:typeId} on tab {integer:tabIndex} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set row to the bim managed type typeId on tab tabIndex in (@intrinsic("dereference", target))
        if row's id = the bim refused id:
            return the bim refused id
        begin bim transaction in (the address of (editor's documentValue))
        set fresh to the bim refused id
        if row's family = 0:
            set fresh to copy bim wall type typeId in target
        else if row's family = 2:
            set fresh to copy bim opening type typeId in target
        else:
            set found to the bim linear type index of typeId in (@intrinsic("dereference", target))
            set original to the item at found's position in (target's linearTypes's values)
            set fresh to the bim new id in target
            append (@intrinsic("construct", a bim linear type record, fresh, original's name, original's role, original's width, original's depth, original's round, original's material)) to (target's linearTypes's values)
            set countBefore to the length of (target's settings's values)
            loop cursor from 0 to countBefore:
                set entry to the item at cursor in (target's settings's values)
                if entry's elementId = typeId:
                    set bim setting entry's code of fresh to entry's value keeping true in target
            copy bim properties of typeId to fresh in target
        if fresh = the bim refused id:
            roll back bim transaction in (the address of (editor's documentValue))
        else:
            set bim property (the string form of "Name") of set (the string form of "Type identity") of fresh to (row's name + (the string form of " (copy)")) typed (the string form of "IFCLABEL") in target
            name bim types by the rules in target
            note bim change of fresh in target
            commit bim transaction in (the address of (editor's documentValue))
        refresh bim editor editor
        return fresh

function delete bim managed type {a 64 bit integer:typeId} on tab {integer:tabIndex} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set row to the bim managed type typeId on tab tabIndex in (@intrinsic("dereference", target))
        if (row's id = the bim refused id) or ((the bim managed type use count of typeId in (@intrinsic("dereference", target))) > 0):
            return false
        begin bim transaction in (the address of (editor's documentValue))
        if row's family = 0:
            set found to the bim wall type index of typeId in (@intrinsic("dereference", target))
            remove item found's position from (target's wallTypes's values)
        else if row's family = 1:
            set found to the bim linear type index of typeId in (@intrinsic("dereference", target))
            remove item found's position from (target's linearTypes's values)
        else:
            set found to the bim opening type index of typeId in (@intrinsic("dereference", target))
            remove item found's position from (target's openingTypes's values)
        set cursor to (the length of (target's settings's values)) - 1
        loop while cursor >= 0:
            if (the item at cursor in (target's settings's values))'s elementId = typeId:
                remove item cursor from (target's settings's values)
            set cursor to cursor - 1
        set cursor to (the length of (target's properties's values)) - 1
        loop while cursor >= 0:
            if (the item at cursor in (target's properties's values))'s elementId = typeId:
                remove item cursor from (target's properties's values)
            set cursor to cursor - 1
        if editor's wallTypeId = typeId:
            set editor's wallTypeId to the bim refused id
        if editor's plateTypeId = typeId:
            set editor's plateTypeId to the bim refused id
        if editor's linearTypeId = typeId:
            set editor's linearTypeId to the bim refused id
        if editor's openingTypeId = typeId:
            set editor's openingTypeId to the bim refused id
        if editor's windowTypeId = typeId:
            set editor's windowTypeId to the bim refused id
        if editor's doorTypeId = typeId:
            set editor's doorTypeId to the bim refused id
        note bim change of typeId in target
        commit bim transaction in (the address of (editor's documentValue))
        refresh bim editor editor
        return true

function apply bim managed type {a 64 bit integer:typeId} on tab {integer:tabIndex} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set row to the bim managed type typeId on tab tabIndex in (@intrinsic("dereference", target))
        if row's id = the bim refused id:
            return false
        set compatible to false
        if row's family = 0:
            if row's role = bim wall planar role:
                set editor's wallTypeId to typeId
                set compatible to editor's selectionKind = bim wall picked
            else:
                set editor's plateTypeId to typeId
                set compatible to editor's selectionKind = bim slab picked
        if row's family = 1:
            set editor's linearTypeId to typeId
            set editor's linearRole to row's role
            if editor's selectionKind = bim linear picked:
                set memberFound to the bim linear index of editor's selectionId in (@intrinsic("dereference", target))
                if memberFound's valid:
                    set compatible to (the bim type of linear (the item at memberFound's position in (target's linears's values)) in (@intrinsic("dereference", target)))'s role = row's role
        if row's family = 2:
            set editor's openingTypeId to typeId
            if row's round:
                set editor's doorTypeId to typeId
            else:
                set editor's windowTypeId to typeId
            if editor's selectionKind = bim opening picked:
                set openingFound to the bim opening index of editor's selectionId in (@intrinsic("dereference", target))
                if openingFound's valid:
                    set openingValue to the item at openingFound's position in (target's openings's values)
                    set oldFound to the bim opening type index of openingValue's typeId in (@intrinsic("dereference", target))
                    if oldFound's valid:
                        set compatible to (the item at oldFound's position in (target's openingTypes's values))'s isDoor = row's round
        if compatible:
            begin bim transaction in (the address of (editor's documentValue))
            set changed to false
            if (row's family = 0) and (row's role = bim wall planar role):
                set changed to set bim wall editor's selectionId type to typeId in target
            else if row's family = 0:
                set changed to set bim plate editor's selectionId type to typeId in target
            else if row's family = 1:
                set changed to set bim linear editor's selectionId type to typeId in target
            else:
                set changed to set bim opening editor's selectionId type to typeId in target
            if changed:
                commit bim transaction in (the address of (editor's documentValue))
                set editor's message to (the string form of "Applied type: ") + row's name
            else:
                roll back bim transaction in (the address of (editor's documentValue))
                set editor's message to the string form of "Type set as drawing default; selection could not be changed"
        else:
            set editor's message to (the string form of "Drawing default: ") + row's name
        refresh bim editor editor
        return true

# Fields: 0 name, 1 material, 2 width/layer thickness, 3 depth/height,
# 4 opening sill, 5 NL-SfB, 6 OmniClass. Numeric lengths use project units.
function set bim managed type {a 64 bit integer:typeId} on tab {integer:tabIndex} layer {integer:layerIndex} field {integer:fieldCode} to {a string:rawText} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set row to the bim managed type typeId on tab tabIndex in (@intrinsic("dereference", target))
        if row's id = the bim refused id:
            return false
        set textValue to the bim managed clean name of rawText
        if (the length of textValue) = 0:
            return false
        loop cursor from 0 to the length of textValue:
            if (the bim manager octet at cursor in textValue) < 32:
                return false
        set numericText to textValue
        if fieldCode = 6:
            set numericText to (numericText with "-" replaced by "") with " " replaced by ""
        set reading to the bim real reading of numericText
        if (fieldCode >= 2) and (reading's valid = false):
            return false
        set metres to reading's value * (the bim metres per editor's lengthUnit)
        if ((fieldCode = 2) or (fieldCode = 3)) and (metres <= 0.0):
            return false
        if (fieldCode = 4) and (metres < 0.0):
            return false
        if (fieldCode < 0) or (fieldCode > 6):
            return false
        begin bim transaction in (the address of (editor's documentValue))
        set changed to false
        if fieldCode = 0:
            if (the length of textValue) <= 96:
                set bim property (the string form of "Name") of set (the string form of "Type identity") of typeId to textValue typed (the string form of "IFCLABEL") in target
                name bim types by the rules in target
                set changed to true
        else if (fieldCode = 5) or (fieldCode = 6):
            set settingCode to bim nlsfb setting
            set factor to 100.0
            if fieldCode = 6:
                set settingCode to bim omniclass setting
                set factor to 1.0
            set codeValue to (the floor of ((reading's value * factor) + 0.5)) as a 64 bit integer
            if codeValue >= (0 as a 64 bit integer):
                set bim setting settingCode of typeId to codeValue keeping (codeValue > (0 as a 64 bit integer)) in target
                set changed to true
        else if row's family = 0:
            if (fieldCode = 1) or (fieldCode = 2):
                set found to the bim wall type index of typeId in (@intrinsic("dereference", target))
                set original to the item at found's position in (target's wallTypes's values)
                set layers to an empty list of a bim layer record
                loop cursor from 0 to the length of (original's layers's values):
                    set layerValue to the item at cursor in (original's layers's values)
                    if cursor = layerIndex:
                        if fieldCode = 1:
                            set layerValue's material to textValue
                        else:
                            set layerValue's thickness to metres
                    append layerValue to layers
                if (layerIndex >= 0) and (layerIndex < (the length of layers)):
                    set changed to set bim wall type typeId layers to layers in target
                free layers
        else if row's family = 1:
            if fieldCode = 1:
                set changed to set bim linear type typeId material to textValue in target
            else if fieldCode = 2:
                set depthValue to row's depth
                if row's round:
                    set depthValue to metres
                set changed to size bim linear type typeId to metres by depthValue in target
            else if fieldCode = 3:
                if row's round = false:
                    set changed to size bim linear type typeId to row's width by metres in target
        else if row's family = 2:
            set widthValue to row's width
            set heightValue to row's depth
            set sillValue to row's sill
            if fieldCode = 2:
                set widthValue to metres
            if fieldCode = 3:
                set heightValue to metres
            if fieldCode = 4:
                set sillValue to metres
            if (fieldCode >= 2) and (fieldCode <= 4):
                set changed to set bim opening type typeId sized widthValue by heightValue with sill sillValue in target
        if changed:
            note bim change of typeId in target
            commit bim transaction in (the address of (editor's documentValue))
        else:
            roll back bim transaction in (the address of (editor's documentValue))
        refresh bim editor editor
        return changed

function change bim managed type {a 64 bit integer:typeId} layer {integer:layerIndex} by {integer:direction} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set found to the bim wall type index of typeId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        # Through the layer table's edits, so that each layer keeps its
        # function and core flag.
        if direction > 0:
            set countValue to the length of ((the item at found's position in (target's wallTypes's values))'s layers's values)
            return insert bim type typeId layer of (the string form of "insulation") 0.1 after (countValue - 1) in editor
        return remove bim type typeId layer layerIndex in editor

local function toggle bim managed type {a 64 bit integer:typeId} on tab {integer:tabIndex} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set row to the bim managed type typeId on tab tabIndex in (@intrinsic("dereference", target))
        if row's family < 1:
            return nothing
        begin bim transaction in (the address of (editor's documentValue))
        if row's family = 1:
            set found to the bim linear type index of typeId in (@intrinsic("dereference", target))
            set linearType to the item at found's position in (target's linearTypes's values)
            set depthValue to linearType's depth
            if linearType's round = false:
                set depthValue to linearType's width
            replace item at index found's position in (target's linearTypes's values) with (@intrinsic("construct", a bim linear type record, linearType's id, linearType's name, linearType's role, linearType's width, depthValue, (linearType's round = false), linearType's material))
            set bim setting (bim profile kind setting) of typeId to (0 as a 64 bit integer) keeping false in target
        else:
            set found to the bim opening type index of typeId in (@intrinsic("dereference", target))
            set openingType to the item at found's position in (target's openingTypes's values)
            replace item at index found's position in (target's openingTypes's values) with (@intrinsic("construct", a bim opening type record, openingType's id, openingType's name, openingType's width, openingType's height, openingType's sill, openingType's frame, (openingType's isDoor = false)))
        name bim types by the rules in target
        note bim change of typeId in target
        commit bim transaction in (the address of (editor's documentValue))
        refresh bim editor editor

function the bim managed field {integer:fieldCode} of {bim managed type record:row} layer {integer:layerIndex} in {bim editor record:editor}:
    execute:
        if fieldCode = 0:
            return row's name
        set material to row's material
        set widthValue to row's width
        if row's family = 0:
            set found to the bim wall type index of row's id in editor's documentValue's current
            if found's valid:
                set layers to (the item at found's position in (editor's documentValue's current's wallTypes's values))'s layers
                if (layerIndex >= 0) and (layerIndex < (the length of (layers's values))):
                    set material to (the item at layerIndex in (layers's values))'s material
                    set widthValue to (the item at layerIndex in (layers's values))'s thickness
        if fieldCode = 1:
            return material
        set numberValue to 0.0
        if fieldCode = 2:
            set numberValue to widthValue / (the bim metres per editor's lengthUnit)
        if fieldCode = 3:
            set numberValue to row's depth / (the bim metres per editor's lengthUnit)
        if fieldCode = 4:
            set numberValue to row's sill / (the bim metres per editor's lengthUnit)
        if (fieldCode = 5) or (fieldCode = 6):
            set code to bim nlsfb setting
            if fieldCode = 6:
                set code to bim omniclass setting
            set entry to the bim setting code of row's id in editor's documentValue's current
            if entry's found:
                return the bim assembly code text of entry's value in code
            return the string form of "0"
        return the bim metres text of numberValue

local function bim managed field {integer:fieldCode} is editable for {bim managed type record:row}:
    execute:
        if row's id = the bim refused id:
            return false
        if ((fieldCode = 1) and (row's family = 2)) or ((fieldCode = 3) and (row's family = 0)):
            return false
        if (fieldCode = 4) and (row's family != 2):
            return false
        if ((fieldCode = 3) and (row's family = 1)) and row's round:
            return false
        return (fieldCode >= 0) and (fieldCode <= 6)


function scroll bim type manager by {integer:rowsValue} in {a pointer to a bim type manager record:state} for {a pointer to a bim editor record:editor}:
    execute:
        set state's scroll to state's scroll + rowsValue
        refresh bim type manager state for (@intrinsic("dereference", editor))

# Starts editing field `fieldCode` from its value `current`. Name and
# material keep their text with the caret at its end, so one letter can be
# corrected; a number is replaced by the first key typed.
function begin bim type manager field {integer:fieldCode} with {a string:current} in {a pointer to a bim type manager record:state}:
    execute:
        set state's field to fieldCode
        set state's text to current
        set state's replaceText to fieldCode >= 2
        set state's message to the string form of "Edit value; Enter saves, Esc cancels"

# Character `code` as UTF-8.
local function the bim manager symbol of {integer:code}:
    execute:
        set countValue to 1
        if code >= 128:
            set countValue to 2
        if code >= 2048:
            set countValue to 3
        if code >= 65536:
            set countValue to 4
        set encoded to a new string buffer containing countValue bytes
        set remainderValue to code
        set cursor to countValue - 1
        loop while cursor > 0:
            set divided to (remainderValue / 64) as an integer
            store ((128 + (remainderValue - (divided * 64))) as a byte) into the data of encoded at cursor
            set remainderValue to divided
            set cursor to cursor - 1
        set prefixValue to 0
        if countValue = 2:
            set prefixValue to 192
        if countValue = 3:
            set prefixValue to 224
        if countValue = 4:
            set prefixValue to 240
        store ((prefixValue + remainderValue) as a byte) into the data of encoded at 0
        return encoded

# A typed character goes to the field being edited, or else to the filter
# over the list: typing while no field is open filters the types.
function type bim type manager character {integer:code} in {a pointer to a bim type manager record:state}:
    execute:
        if (state's open = false) or (state's picking >= 0):
            return nothing
        if (code < 32) or (code > 1114111):
            return nothing
        if state's field < 0:
            set state's field to bim manager search field
            set state's search to the string form of ""
        if state's field = bim manager search field:
            if (the length of state's search) < 60:
                set state's search to state's search + (the bim manager symbol of code)
                set state's scroll to 0
            return nothing
        if (the length of state's text) >= 160:
            return nothing
        if state's replaceText:
            set state's text to the string form of ""
            set state's replaceText to false
        set state's text to state's text + (the bim manager symbol of code)

# Moves the choice `step` types down the list (up when negative), over the
# groups' headers.
function move bim manager choice by {integer:step} in {a pointer to a bim type manager record:state} for {a pointer to a bim editor record:editor}:
    execute:
        set entries to the bim type manager entries of (@intrinsic("dereference", state)) in editor's documentValue's current
        set indexValue to -1
        loop cursor from 0 to the length of entries:
            if ((the item at cursor in entries) = state's chosenId) and (state's chosenId >= (0 as a 64 bit integer)):
                set indexValue to cursor
        set going to true
        loop while going:
            set indexValue to indexValue + step
            set going to false
            if (indexValue >= 0) and (indexValue < (the length of entries)):
                if (the item at indexValue in entries) < (0 as a 64 bit integer):
                    set going to true
        if (indexValue >= 0) and (indexValue < (the length of entries)):
            set state's chosenId to the item at indexValue in entries
            set state's scroll to the maximum of 0 and (indexValue - 3)
            set state's layer to 0
            set state's picking to -1
            if state's field != bim manager search field:
                set state's field to -1
        free entries
        refresh bim type manager state for (@intrinsic("dereference", editor))

function type bim type manager key {integer:code} in {a pointer to a bim type manager record:state} for {a pointer to a bim editor record:editor}:
    execute:
        refresh bim type manager state for (@intrinsic("dereference", editor))
        if code = bim escape key code:
            if state's picking >= 0:
                set state's picking to -1
            else if state's field = bim manager search field:
                set state's field to -1
                set state's search to the string form of ""
            else if state's field >= 0:
                set state's field to -1
            else:
                set state's open to false
            return nothing
        if (code = 265) or (code = 264):
            set step to 1
            if code = 265:
                set step to -1
            move bim manager choice by step in state for editor
            return nothing
        if state's field = bim manager search field:
            if (code = 259) and ((the length of state's search) > 0):
                set keptLength to the bim text backspace prefix length of (state's search)
                set state's search to the substring of state's search from 0 spanning keptLength bytes
            if code = bim enter key code:
                set state's field to -1
            refresh bim type manager state for (@intrinsic("dereference", editor))
            return nothing
        if state's field >= 0:
            if code = 259:
                if state's replaceText:
                    set state's text to the string form of ""
                    set state's replaceText to false
                if (the length of state's text) > 0:
                    set keptLength to the bim text backspace prefix length of (state's text)
                    set state's text to the substring of state's text from 0 spanning keptLength bytes
            if code = bim enter key code:
                if set bim managed type state's chosenId on tab state's tab layer state's layer field state's field to state's text in editor:
                    set state's field to -1
                    set state's message to the string form of "Type updated; every occurrence follows this definition"
                    set state's revision to editor's documentValue's revision
                else:
                    set state's message to the string form of "Invalid value; positive dimensions and a non-empty name are required"
            return nothing
        if code = bim enter key code:
            ignore apply bim managed type state's chosenId on tab state's tab in editor
            set state's message to editor's message

function the bim type manager layout of {bim type manager record:stateValue} across {a 64 bit floating-point number:screenWidth} by {a 64 bit floating-point number:screenHeight}:
    execute:
        set boxWidth to the minimum of 1080.0 and (the maximum of 760.0 and (screenWidth - 16.0))
        set boxHeight to the minimum of 720.0 and (the maximum of 240.0 and (screenHeight - 16.0))
        set leftEdge to the maximum of 8.0 and ((screenWidth - boxWidth) * 0.5)
        set topEdge to the maximum of 8.0 and ((screenHeight - boxHeight) * 0.5)
        set lowerEdge to boxHeight - 50.0
        set shiftLimit to the maximum of 0.0 and (stateValue's detailHeight - lowerEdge)
        set shiftValue to the minimum of shiftLimit and (the maximum of 0.0 and ((stateValue's detailScroll as a 64 bit floating-point number) * 36.0))
        return @intrinsic("construct", a bim type manager layout record, boxWidth, boxHeight, leftEdge, topEdge, 118.0, lowerEdge, shiftValue, shiftLimit)

function bim manager detail band at {a 64 bit floating-point number:bandTop} tall {a 64 bit floating-point number:bandHeight} is visible in {bim type manager layout record:layoutValue}:
    execute:
        return (bandTop >= layoutValue's bodyTop) and ((bandTop + bandHeight) <= layoutValue's bodyBottom)

function scroll bim type manager details by {integer:rowsValue} across {a 64 bit floating-point number:screenWidth} by {a 64 bit floating-point number:screenHeight} in {a pointer to a bim type manager record:state}:
    execute:
        set panelGeometry to the bim type manager layout of (@intrinsic("dereference", state)) across screenWidth by screenHeight
        set maximumRows to ((the ceiling of (panelGeometry's detailLimit / 36.0)) as an integer)
        set state's detailScroll to the minimum of maximumRows and (the maximum of 0 and (state's detailScroll + rowsValue))

# The list's first line and how many lines it shows.
function the bim manager list top:
    execute:
        return 176.0

function the bim manager visible lines in {bim type manager layout record:layoutValue}:
    execute:
        return the maximum of 1 and (((layoutValue's bodyBottom - (the bim manager list top)) / 24.0) as an integer)

# The material picker's tiles: how many fit across the detail pane.
function the bim manager picker columns across {a 64 bit floating-point number:boxWidth}:
    execute:
        return the maximum of 1 and ((((boxWidth - 20.0) - 320.0) / 170.0) as an integer)

# The same geometry serves hit testing and rendering. Actions: -1 close,
# -10 to -13 the toolbar, -22 a layer added, 100 + n family tab n, 300 + n
# role chip n (0 all), 310 the filter, 1000 + n line n of the list, 200 + c
# field c, 5000 + 10 l + c column c of layer l, 6000 + n material n of the
# picker and 5999 the picker's background.
function the bim type manager action at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} across {a 64 bit floating-point number:screenWidth} by {a 64 bit floating-point number:screenHeight} for {bim type manager record:stateValue} showing {bim managed type record:row}:
    execute:
        set panelGeometry to the bim type manager layout of stateValue across screenWidth by screenHeight
        set boxWidth to panelGeometry's width
        set boxHeight to panelGeometry's height
        set px to x - panelGeometry's left
        set py to y - panelGeometry's top
        if ((px < 0.0) or (px >= boxWidth)) or ((py < 0.0) or (py >= boxHeight)):
            return 0
        if (py < 32.0) and (px > (boxWidth - 36.0)):
            return -1
        if ((py >= 38.0) and (py < 68.0)) and (px >= 12.0):
            set indexValue to ((px - 12.0) / 150.0) as an integer
            if (indexValue >= 0) and (indexValue < 4):
                return 100 + indexValue
        if (py >= 78.0) and (py < 106.0):
            set indexValue to ((px - 12.0) / 106.0) as an integer
            if (px >= 12.0) and ((indexValue >= 0) and (indexValue < 4)):
                return -10 - indexValue
        if (px >= 12.0) and (px < 302.0):
            if (py >= 118.0) and (py < 140.0):
                set groups to the bim manager groups of family stateValue's family
                set chipCount to (the length of groups) + 1
                free groups
                if chipCount > 1:
                    set indexValue to ((px - 12.0) / (290.0 / (chipCount as a 64 bit floating-point number))) as an integer
                    if indexValue < chipCount:
                        return 300 + indexValue
            if (py >= 146.0) and (py < 170.0):
                return 310
            set listTop to the bim manager list top
            if (py >= listTop) and (py < panelGeometry's bodyBottom):
                set rowIndex to ((py - listTop) / 24.0) as an integer
                if (rowIndex < (the bim manager visible lines in panelGeometry)) and (py < ((listTop + ((rowIndex as a 64 bit floating-point number) * 24.0)) + 23.0)):
                    return 1000 + rowIndex
            return 0
        if (((px < 320.0) or (px >= (boxWidth - 20.0))) or (py < panelGeometry's bodyTop)) or (py >= panelGeometry's bodyBottom):
            return 0
        if stateValue's picking >= 0:
            if py >= 150.0:
                set columns to the bim manager picker columns across boxWidth
                set tileWidth to ((boxWidth - 20.0) - 320.0) / (columns as a 64 bit floating-point number)
                set tileColumn to the minimum of (columns - 1) and (((px - 320.0) / tileWidth) as an integer)
                set tileLine to ((py - 150.0) / 26.0) as an integer
                return 6000 + ((tileLine * columns) + tileColumn)
            return 5999
        if row's id = the bim refused id:
            return 0
        set detailY to py + panelGeometry's detailShift
        set codes to the bim manager fields of row
        set found to 0
        loop fieldSlot from 0 to the length of codes:
            set fieldOrigin to the bim manager field top of slot fieldSlot of row
            if ((detailY >= fieldOrigin) and (detailY < (fieldOrigin + 28.0))) and (px >= 440.0):
                if bim manager detail band at (fieldOrigin - panelGeometry's detailShift) tall 28.0 is visible in panelGeometry:
                    set found to 200 + (the item at fieldSlot in codes)
        free codes
        if found != 0:
            return found
        if row's family = 0:
            loop layerIndex from 0 to row's layerCount:
                set layerOrigin to the bim manager layer top of layerIndex
                if ((detailY >= layerOrigin) and (detailY < (layerOrigin + 28.0))) and (bim manager detail band at (layerOrigin - panelGeometry's detailShift) tall 28.0 is visible in panelGeometry):
                    loop cellColumn from 0 to 7:
                        set columnLeft to the bim manager column left of cellColumn
                        if (px >= columnLeft) and (px < (columnLeft + (the bim manager column width of cellColumn))):
                            set found to (5000 + (layerIndex * 10)) + cellColumn
            if found != 0:
                return found
            set addOrigin to (the bim manager layer top of row's layerCount) + 6.0
            if ((detailY >= addOrigin) and (detailY < (addOrigin + 28.0))) and ((px >= 320.0) and (px < 420.0)):
                if bim manager detail band at (addOrigin - panelGeometry's detailShift) tall 28.0 is visible in panelGeometry:
                    return -22
        return 0

# What a click on the role field does: an opening switches between window
# and door; another type takes its next role when its uses allow one.
local function click bim managed role of {bim managed type record:row} in {a pointer to a bim type manager record:state} for {a pointer to a bim editor record:editor}:
    execute:
        if row's family = 2:
            toggle bim managed type row's id on tab 7 in editor
            set state's message to the string form of "Opening kind changed"
        else:
            set nextRole to the bim managed next role of row in editor's documentValue's current
            if nextRole < 0:
                set state's message to the string form of "Role kept: the elements using this type need it (a wall stays a wall, a used profile keeps its role)"
                return nothing
            if set bim managed type row's id role to nextRole in editor:
                set state's message to the string form of "Role changed; the type keeps its build-up, settings and properties"
        if state's roleFilter >= 0:
            set changed to the bim managed type row's id in family state's family in editor's documentValue's current
            if (the bim manager group of changed) != state's roleFilter:
                set state's roleFilter to -1
        refresh bim type manager state for (@intrinsic("dereference", editor))
        bring bim manager choice into view in state for (@intrinsic("dereference", editor))

# A click in layer `layerIndex`'s column `columnIndex` of the layer table.
local function click bim manager layer {integer:layerIndex} column {integer:columnIndex} of {bim managed type record:row} in {a pointer to a bim type manager record:state} for {a pointer to a bim editor record:editor}:
    execute:
        set state's layer to layerIndex
        set modelValue to editor's documentValue's current
        if columnIndex = 0:
            set current to the bim function of layer layerIndex of type row's id in modelValue
            ignore set bim type row's id layer layerIndex function to (the bim layer function after current) in editor
        if columnIndex = 1:
            set state's picking to layerIndex
        if columnIndex = 2:
            begin bim type manager field 2 with (the bim managed field 2 of row layer layerIndex in (@intrinsic("dereference", editor))) in state
        if columnIndex = 3:
            ignore set bim type row's id layer layerIndex core to ((bim layer layerIndex of type row's id is core in modelValue) = false) in editor
        if columnIndex = 4:
            if move bim type row's id layer layerIndex by -1 in editor:
                set state's layer to layerIndex - 1
        if columnIndex = 5:
            if move bim type row's id layer layerIndex by 1 in editor:
                set state's layer to layerIndex + 1
        if columnIndex = 6:
            if remove bim type row's id layer layerIndex in editor:
                set state's layer to the maximum of 0 and (layerIndex - 1)
                set state's message to the string form of "Layer removed"
            else:
                set state's message to the string form of "A type keeps at least one layer"

# A click on tile `choice` of the material picker.
local function pick bim manager material {integer:choice} of {bim managed type record:row} in {a pointer to a bim type manager record:state} for {a pointer to a bim editor record:editor}:
    execute:
        set choices to the bim material choices of (editor's documentValue's current) at most 40
        set picked to state's picking
        if choice < (the length of choices):
            set materialName to the item at choice in choices
            set state's picking to -1
            if picked = bim manager linear material:
                ignore set bim managed type row's id on tab state's tab layer 0 field 1 to materialName in editor
            else:
                ignore set bim type row's id layer picked material to materialName in editor
            set state's message to (the string form of "Material: ") + materialName
        else if choice = (the length of choices):
            set state's picking to -1
            set layerIndex to 0
            if picked != bim manager linear material:
                set layerIndex to picked
                set state's layer to picked
            begin bim type manager field 1 with (the bim managed field 1 of row layer layerIndex in (@intrinsic("dereference", editor))) in state
            set state's replaceText to false
        free choices

function click bim type manager at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} across {a 64 bit floating-point number:screenWidth} by {a 64 bit floating-point number:screenHeight} in {a pointer to a bim type manager record:state} for {a pointer to a bim editor record:editor}:
    execute:
        refresh bim type manager state for (@intrinsic("dereference", editor))
        set row to the bim managed type state's chosenId in family state's family in editor's documentValue's current
        set actionValue to the bim type manager action at x and y across screenWidth by screenHeight for (@intrinsic("dereference", state)) showing row
        if actionValue = -1:
            set state's open to false
            set state's field to -1
            set state's picking to -1
            return nothing
        if actionValue != 0:
            # Any click elsewhere leaves the value being typed unsaved.
            set state's field to -1
            set state's text to the string form of ""
            set state's replaceText to false
        if (actionValue >= 100) and (actionValue < 104):
            set state's family to actionValue - 100
            set state's roleFilter to -1
            set state's chosenId to the bim refused id
            set state's scroll to 0
            set state's detailScroll to 0
            set state's picking to -1
        if (actionValue >= 300) and (actionValue < 310):
            set groups to the bim manager groups of family state's family
            set chipIndex to actionValue - 300
            set state's roleFilter to -1
            if (chipIndex >= 1) and (chipIndex <= (the length of groups)):
                set state's roleFilter to the item at (chipIndex - 1) in groups
            free groups
            set state's scroll to 0
            set state's picking to -1
        if actionValue = 310:
            set state's field to bim manager search field
            set state's picking to -1
        if (actionValue >= 1000) and (actionValue < 5000):
            set entries to the bim type manager entries of (@intrinsic("dereference", state)) in editor's documentValue's current
            set indexValue to (actionValue - 1000) + state's scroll
            if (indexValue >= 0) and (indexValue < (the length of entries)):
                set entry to the item at indexValue in entries
                if entry < (0 as a 64 bit integer):
                    fold bim manager group ((((0 as a 64 bit integer) - entry) - (1 as a 64 bit integer)) as an integer) in state
                else:
                    set state's chosenId to entry
                    set state's layer to 0
                    set state's picking to -1
                    set state's detailScroll to 0
            free entries
        if (actionValue >= 200) and (actionValue < 209):
            set fieldCode to actionValue - 200
            set state's picking to -1
            if fieldCode = 7:
                click bim managed role of row in state for editor
            else if fieldCode = 8:
                toggle bim managed type row's id on tab state's tab in editor
            else if (fieldCode = 1) and (row's family = 1):
                set state's picking to bim manager linear material
            else if bim managed field fieldCode is editable for row:
                begin bim type manager field fieldCode with (the bim managed field fieldCode of row layer state's layer in (@intrinsic("dereference", editor))) in state
        if (actionValue >= 5000) and (actionValue < 5999):
            set state's picking to -1
            set layerIndex to (actionValue - 5000) / 10
            click bim manager layer layerIndex column (the remainder of (actionValue - 5000) divided by 10) of row in state for editor
        if actionValue = 5999:
            set state's picking to -1
        if actionValue >= 6000:
            pick bim manager material (actionValue - 6000) of row in state for editor
        if actionValue = -22:
            if insert bim type row's id layer of (the string form of "insulation") 0.1 after state's layer in editor:
                set state's layer to state's layer + 1
                set state's message to the string form of "Layer added under the chosen one"
        if actionValue = -10:
            set addingTab to the bim manager adding tab of (@intrinsic("dereference", state))
            set state's chosenId to add bim managed type on tab addingTab in editor
            set state's family to the bim family of manager tab addingTab
            if addingTab = 8:
                set state's family to bim profiled family
            set state's search to the string form of ""
            set state's message to the string form of "Type added without creating an instance"
            refresh bim type manager state for (@intrinsic("dereference", editor))
            bring bim manager choice into view in state for (@intrinsic("dereference", editor))
        if actionValue = -11:
            set state's chosenId to duplicate bim managed type state's chosenId on tab state's tab in editor
            set state's message to the string form of "Independent type copied, including properties and profile settings"
            refresh bim type manager state for (@intrinsic("dereference", editor))
            bring bim manager choice into view in state for (@intrinsic("dereference", editor))
        if actionValue = -12:
            if delete bim managed type state's chosenId on tab state's tab in editor:
                set state's chosenId to the bim refused id
                set state's message to the string form of "Unused type deleted"
            else:
                set state's message to the string form of "Not deleted: this type is used by model elements or panels"
        if actionValue = -13:
            ignore apply bim managed type state's chosenId on tab state's tab in editor
            set state's message to editor's message
        refresh bim type manager state for (@intrinsic("dereference", editor))

# ---------------------------------------------------------------- drawing

local function draw bim manager label {a string:textValue} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} ending {a 64 bit floating-point number:rightEdge} using {bim text atlas record:atlas} painted {bim ui colour record:ink} in {graphics frame:frame}:
    execute:
        draw bim text textValue at x and y in face (bim text small) with atlas coloured ink's red, ink's green and ink's blue cut at rightEdge in frame

local function draw bim manager text {a string:textValue} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} ending {a 64 bit floating-point number:rightEdge} in face {integer:faceIndex} using {bim text atlas record:atlas} painted {bim ui colour record:ink} in {graphics frame:frame}:
    execute:
        draw bim text textValue at x and y in face faceIndex with atlas coloured ink's red, ink's green and ink's blue cut at rightEdge in frame

# `textValue` ending at `rightEdge`.
local function draw bim manager label {a string:textValue} right at {a 64 bit floating-point number:rightEdge} and {a 64 bit floating-point number:y} using {bim text atlas record:atlas} painted {bim ui colour record:ink} in {graphics frame:frame}:
    execute:
        set widthValue to the bim text width of textValue in face (bim text small) of atlas
        draw bim manager label textValue at (rightEdge - widthValue) and y ending (rightEdge + 1.0) using atlas painted ink in frame

local function draw bim manager button {a string:labelValue} at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:top} across {a 64 bit floating-point number:widthValue} active {boolean:enabled} hovered {boolean:underPointer} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set palette to the bim ui palette
        set paint to palette's raised
        if underPointer and enabled:
            set paint to palette's hover
        draw bim ui rounded rectangle left top widthValue 28.0 radius 4.0 painted paint in frame
        draw bim ui frame left top widthValue 28.0 coloured palette's border's red, palette's border's green and palette's border's blue in frame
        set ink to palette's inkDisabled
        if enabled:
            set ink to palette's ink
        set labelWidth to the bim text width of labelValue in face (bim text small) of atlas
        set labelLeft to the maximum of (left + 6.0) and (left + ((widthValue - labelWidth) * 0.5))
        draw bim manager label labelValue at labelLeft and (top + 18.0) ending ((left + widthValue) - 4.0) using atlas painted ink in frame

local function draw bim manager swatch of {a string:materialName} at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:top} sized {a 64 bit floating-point number:size} in {graphics frame:frame}:
    execute:
        set palette to the bim ui palette
        set colour to the bim material colour of materialName
        draw bim ui rectangle left top size size coloured (colour's x as an integer), (colour's y as an integer) and (colour's z as an integer) in frame
        draw bim ui frame left top size size coloured palette's strong's red, palette's strong's green and palette's strong's blue in frame

# The IFC type class of group `groupCode` in family `familyCode`.
function the bim manager ifc class of group {integer:groupCode} in family {integer:familyCode}:
    execute:
        if familyCode = bim layered family:
            return (the bim ifc class of planar role groupCode) + (the string form of "Type")
        if familyCode = bim opening family:
            if groupCode = 1:
                return the string form of "IfcDoorType"
            return the string form of "IfcWindowType"
        return (the bim ifc class of linear role groupCode) + (the string form of "Type")

# What the role field of `row` shows: its role with its IFC class.
function the bim managed role text of {bim managed type record:row}:
    execute:
        if row's family = 0:
            return (((the bim name of planar role row's role) + (the string form of "   ")) + row's ifcClass) + ((the string form of " ") + (the bim ifc predefined type of planar role row's role))
        if row's family = 2:
            if row's round:
                return the string form of "Door   IfcDoorType"
            return the string form of "Window   IfcWindowType"
        return ((the bim name of linear role row's role) + (the string form of "   ")) + row's ifcClass

local function the bim manager field label {integer:fieldCode} of {bim managed type record:row}:
    execute:
        if fieldCode = 0:
            return the string form of "Name"
        if fieldCode = 7:
            if row's family = 2:
                return the string form of "Kind"
            return the string form of "Role"
        if fieldCode = 1:
            return the string form of "Material"
        if fieldCode = 2:
            if (row's family = 1) and row's round:
                return the string form of "Diameter"
            return the string form of "Width"
        if fieldCode = 3:
            if row's family = 2:
                return the string form of "Height"
            return the string form of "Depth"
        if fieldCode = 4:
            return the string form of "Sill"
        if fieldCode = 8:
            return the string form of "Shape"
        if fieldCode = 5:
            return the string form of "NL-SfB"
        return the string form of "OmniClass"

# The small picture at the start of a line of the list: a layered type's
# build-up in its materials' colours, a profile's outline, an opening.
local function draw bim managed glyph of {bim managed type record:row} in {bim model record:modelValue} at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:top} in {graphics frame:frame}:
    execute:
        set palette to the bim ui palette
        if row's family = 0:
            set found to the bim wall type index of row's id in modelValue
            if found's valid:
                set planarType to the item at found's position in (modelValue's wallTypes's values)
                set total to the maximum of 0.0001 and row's width
                set reached to 0.0
                loop cursor from 0 to the length of (planarType's layers's values):
                    set layerValue to the item at cursor in (planarType's layers's values)
                    set colour to the bim material colour of layerValue's material
                    set bandWidth to (layerValue's thickness / total) * 40.0
                    draw bim ui rectangle (left + reached) top (the maximum of 1.0 and bandWidth) 12.0 coloured (colour's x as an integer), (colour's y as an integer) and (colour's z as an integer) in frame
                    set reached to reached + bandWidth
                draw bim ui frame left top 40.0 12.0 coloured palette's strong's red, palette's strong's green and palette's strong's blue in frame
            return nothing
        set scaleValue to 14.0 / (the maximum of 0.0001 and (the maximum of row's width and row's depth))
        set shapeWidth to the maximum of 3.0 and (row's width * scaleValue)
        set shapeHeight to the maximum of 3.0 and (row's depth * scaleValue)
        set middleX to left + 20.0
        set middleY to top + 6.0
        if row's family = 1:
            set colour to the bim material colour of row's material
            if row's round:
                set radius to shapeWidth * 0.5
                loop cursor from 0 to 8:
                    set fromAngle to ((cursor as a 64 bit floating-point number) * 0.7853981633974483)
                    set toAngle to (((cursor + 1) as a 64 bit floating-point number) * 0.7853981633974483)
                    draw bim ui line from (middleX + (radius * (the cosine of fromAngle))) (middleY + (radius * (the sine of fromAngle))) to (middleX + (radius * (the cosine of toAngle))) (middleY + (radius * (the sine of toAngle))) wide 2.0 coloured (colour's x as an integer), (colour's y as an integer) and (colour's z as an integer) in frame
            else:
                draw bim ui rectangle (middleX - (shapeWidth * 0.5)) (middleY - (shapeHeight * 0.5)) shapeWidth shapeHeight coloured (colour's x as an integer), (colour's y as an integer) and (colour's z as an integer) in frame
                draw bim ui frame (middleX - (shapeWidth * 0.5)) (middleY - (shapeHeight * 0.5)) shapeWidth shapeHeight coloured palette's strong's red, palette's strong's green and palette's strong's blue in frame
            return nothing
        draw bim ui frame (middleX - (shapeWidth * 0.5)) (middleY - (shapeHeight * 0.5)) shapeWidth shapeHeight coloured palette's accentInk's red, palette's accentInk's green and palette's accentInk's blue in frame
        if row's round:
            draw bim ui line from (middleX + (shapeWidth * 0.2)) middleY to (middleX + (shapeWidth * 0.4)) middleY wide 1.5 coloured palette's ink's red, palette's ink's green and palette's ink's blue in frame
        else:
            draw bim ui line from middleX (middleY - (shapeHeight * 0.5)) to middleX (middleY + (shapeHeight * 0.5)) wide 1.0 coloured palette's accentInk's red, palette's accentInk's green and palette's accentInk's blue in frame

# The size a line of the list shows: a layered type's thickness, a profile's
# or an opening's width by depth, in the project's length unit.
local function the bim managed size text of {bim managed type record:row} in {bim editor record:editor}:
    execute:
        if row's family = 0:
            return the bim length row's width in units editor's lengthUnit
        set widthText to the bim number row's width in units editor's lengthUnit
        if (row's family = 1) and row's round:
            return (the string form of "D ") + widthText
        return (widthText + (the string form of "x")) + (the bim number row's depth in units editor's lengthUnit)

local function draw bim managed preview {bim managed type record:row} in {bim model record:modelValue} from {a 64 bit floating-point number:left} and {a 64 bit floating-point number:top} across {a 64 bit floating-point number:widthValue} in {graphics frame:frame}:
    execute:
        set palette to the bim ui palette
        draw bim ui rectangle left top widthValue 88.0 painted palette's raised in frame
        if row's family = 1:
            set found to the bim linear type index of row's id in modelValue
            if found's valid:
                set linearType to the item at found's position in (modelValue's linearTypes's values)
                set profile to the bim profile of linear type linearType in modelValue
                set rings to the bim rings of profile profile at 32 round corners
                if profile's kind = bim arbitrary profile:
                    loop ringCursor from 0 to the length of rings:
                        free (the item at ringCursor in rings)
                    clear rings
                    append (the bim profile outline of type row's id in modelValue) to rings
                set scaleValue to the minimum of ((widthValue - 36.0) / (the maximum of 0.0001 and row's width)) and (64.0 / (the maximum of 0.0001 and row's depth))
                set middleX to left + (widthValue * 0.5)
                set middleY to top + 44.0
                loop ringCursor from 0 to the length of rings:
                    set ring to the item at ringCursor in rings
                    loop cursor from 0 to the length of ring:
                        set next to cursor + 1
                        if next >= (the length of ring):
                            set next to 0
                        set a to the item at cursor in ring
                        set b to the item at next in ring
                        draw bim ui line from (middleX + (a's x * scaleValue)) (middleY - (a's y * scaleValue)) to (middleX + (b's x * scaleValue)) (middleY - (b's y * scaleValue)) wide 2.0 coloured palette's accentInk's red, palette's accentInk's green and palette's accentInk's blue in frame
                    free ring
                free rings
        if row's family = 2:
            set scaleValue to the minimum of ((widthValue - 36.0) / (the maximum of 0.0001 and row's width)) and (66.0 / (the maximum of 0.0001 and row's depth))
            set shapeWidth to row's width * scaleValue
            set tall to row's depth * scaleValue
            set x to left + ((widthValue - shapeWidth) * 0.5)
            draw bim ui rectangle x (top + 11.0) shapeWidth tall painted palette's strong in frame
            draw bim ui rectangle (x + 3.0) (top + 14.0) (the maximum of 1.0 and (shapeWidth - 6.0)) (the maximum of 1.0 and (tall - 6.0)) painted palette's selected in frame
            if row's round:
                draw bim ui line from (x + (shapeWidth * 0.75)) (top + (tall * 0.6)) to (x + (shapeWidth * 0.9)) (top + (tall * 0.6)) wide 2.0 coloured palette's ink's red, palette's ink's green and palette's ink's blue in frame

# The layered type's section beside its layer table, to scale: its layers
# side by side in their materials' colours, the chosen layer outlined, the
# core between two marks, and the total thickness under it. A thickness
# being typed shows at once.
local function draw bim layered section of {bim managed type record:row} for {bim type manager record:stateValue} in {bim editor record:editor} from {a 64 bit floating-point number:left} and {a 64 bit floating-point number:top} across {a 64 bit floating-point number:widthValue} tall {a 64 bit floating-point number:heightValue} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set palette to the bim ui palette
        set modelValue to editor's documentValue's current
        set found to the bim wall type index of row's id in modelValue
        if (found's valid = false) or (widthValue < 40.0):
            return nothing
        set planarType to the item at found's position in (modelValue's wallTypes's values)
        set thicknesses to an empty list of a 64 bit floating-point number
        set total to 0.0
        loop cursor from 0 to the length of (planarType's layers's values):
            set thickness to (the item at cursor in (planarType's layers's values))'s thickness
            if ((stateValue's field = 2) and (stateValue's layer = cursor)) and ((the length of stateValue's text) > 0):
                set typed to the bim real reading of stateValue's text
                if typed's valid and (typed's value > 0.0):
                    set thickness to typed's value * (the bim metres per editor's lengthUnit)
            append thickness to thicknesses
            set total to total + thickness
        draw bim ui rectangle left top widthValue heightValue painted palette's raised in frame
        set drawnWidth to widthValue - 16.0
        set scaleValue to drawnWidth / (the maximum of 0.0001 and total)
        set bandTop to top + 14.0
        set bandHeight to heightValue - 44.0
        set reached to left + 8.0
        set coreStart to -1.0
        set coreEnd to -1.0
        loop cursor from 0 to the length of thicknesses:
            set layerValue to the item at cursor in (planarType's layers's values)
            set bandWidth to (the item at cursor in thicknesses) * scaleValue
            set colour to the bim material colour of layerValue's material
            draw bim ui rectangle reached bandTop (the maximum of 1.0 and bandWidth) bandHeight coloured (colour's x as an integer), (colour's y as an integer) and (colour's z as an integer) in frame
            draw bim ui line from reached bandTop to reached (bandTop + bandHeight) wide 1.0 coloured palette's strong's red, palette's strong's green and palette's strong's blue in frame
            if bim layer cursor of type row's id is core in modelValue:
                if coreStart < 0.0:
                    set coreStart to reached
                set coreEnd to reached + bandWidth
            if cursor = stateValue's layer:
                draw bim ui frame (reached + 1.0) (bandTop + 1.0) (the maximum of 1.0 and (bandWidth - 2.0)) (bandHeight - 2.0) coloured palette's accent's red, palette's accent's green and palette's accent's blue in frame
            set reached to reached + bandWidth
        draw bim ui frame (left + 8.0) bandTop drawnWidth bandHeight coloured palette's strong's red, palette's strong's green and palette's strong's blue in frame
        if coreStart >= 0.0:
            draw bim ui line from coreStart (top + 4.0) to coreStart ((bandTop + bandHeight) + 4.0) wide 2.0 coloured palette's accentInk's red, palette's accentInk's green and palette's accentInk's blue in frame
            draw bim ui line from coreEnd (top + 4.0) to coreEnd ((bandTop + bandHeight) + 4.0) wide 2.0 coloured palette's accentInk's red, palette's accentInk's green and palette's accentInk's blue in frame
            draw bim manager label (the string form of "core") at (coreStart + 3.0) and (top + 11.0) ending ((left + widthValue) - 4.0) using atlas painted palette's accentInk in frame
        set totalText to (the string form of "Total ") + (the bim length total in units editor's lengthUnit)
        draw bim manager label totalText at (left + 8.0) and ((top + heightValue) - 10.0) ending ((left + widthValue) - 4.0) using atlas painted palette's ink in frame
        free thicknesses

# The layer table of a layered type: one line per layer with its function,
# material, thickness, core flag and the buttons that move or remove it.
local function draw bim layer table of {bim managed type record:row} for {bim type manager record:stateValue} in {bim editor record:editor} within {bim type manager layout record:panelGeometry} hovering {integer:hovered} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set palette to the bim ui palette
        set modelValue to editor's documentValue's current
        set found to the bim wall type index of row's id in modelValue
        if found's valid = false:
            return nothing
        set planarType to the item at found's position in (modelValue's wallTypes's values)
        set left to panelGeometry's left
        set top to panelGeometry's top
        set boxWidth to panelGeometry's width
        set shift to panelGeometry's detailShift
        set headerOrigin to (the bim manager table top) - shift
        if bim manager detail band at headerOrigin tall 20.0 is visible in panelGeometry:
            set headerTop to top + headerOrigin
            draw bim manager label (the string form of "#") at (left + 322.0) and (headerTop + 15.0) ending (left + 340.0) using atlas painted palette's inkSecondary in frame
            set headers to [the string form of "Function", the string form of "Material", the string form of "Thickness", the string form of "Core"]
            loop headerColumn from 0 to 4:
                draw bim manager label (the item at headerColumn in headers) at (left + (the bim manager column left of headerColumn)) and (headerTop + 15.0) ending (left + ((the bim manager column left of headerColumn) + 90.0)) using atlas painted palette's inkSecondary in frame
            draw bim ui line from (left + 320.0) (headerTop + 20.0) to (left + ((the bim manager section left) - 8.0)) (headerTop + 20.0) wide 1.0 coloured palette's border's red, palette's border's green and palette's border's blue in frame
        set countValue to the length of (planarType's layers's values)
        loop layerIndex from 0 to countValue:
            set layerValue to the item at layerIndex in (planarType's layers's values)
            set lineOrigin to (the bim manager layer top of layerIndex) - shift
            if bim manager detail band at lineOrigin tall 28.0 is visible in panelGeometry:
                set lineTop to top + lineOrigin
                if layerIndex = stateValue's layer:
                    draw bim ui rectangle (left + 318.0) (lineTop - 1.0) (((the bim manager section left) - 8.0) - 318.0) 30.0 painted palette's selected in frame
                draw bim manager label (the string form of (layerIndex + 1)) at (left + 324.0) and (lineTop + 19.0) ending (left + 342.0) using atlas painted palette's inkSecondary in frame
                loop cellColumn from 0 to 7:
                    set cellLeft to left + (the bim manager column left of cellColumn)
                    set cellWidth to the bim manager column width of cellColumn
                    set paint to palette's raised
                    if hovered = ((5000 + (layerIndex * 10)) + cellColumn):
                        set paint to palette's hover
                    draw bim ui rounded rectangle cellLeft lineTop cellWidth 28.0 radius 3.0 painted paint in frame
                set functionCode to the bim function of layer layerIndex of type row's id in modelValue
                draw bim manager label (the bim name of layer function functionCode) at (left + 352.0) and (lineTop + 19.0) ending (left + 440.0) using atlas painted palette's ink in frame
                set materialLeft to left + (the bim manager column left of 1)
                draw bim manager swatch of layerValue's material at (materialLeft + 6.0) and (lineTop + 8.0) sized 12.0 in frame
                set materialText to layerValue's material
                if (stateValue's field = 1) and (stateValue's layer = layerIndex):
                    set materialText to stateValue's text + (the string form of "|")
                    draw bim ui frame materialLeft lineTop (the bim manager column width of 1) 28.0 coloured palette's accent's red, palette's accent's green and palette's accent's blue in frame
                draw bim manager label materialText at (materialLeft + 24.0) and (lineTop + 19.0) ending (materialLeft + 160.0) using atlas painted palette's ink in frame
                set thicknessLeft to left + (the bim manager column left of 2)
                set thicknessText to the bim number layerValue's thickness in units editor's lengthUnit
                if (stateValue's field = 2) and (stateValue's layer = layerIndex):
                    set thicknessText to stateValue's text + (the string form of "|")
                    draw bim ui frame thicknessLeft lineTop (the bim manager column width of 2) 28.0 coloured palette's accent's red, palette's accent's green and palette's accent's blue in frame
                draw bim manager label thicknessText right at (thicknessLeft + 72.0) and (lineTop + 19.0) using atlas painted palette's ink in frame
                set coreLeft to left + (the bim manager column left of 3)
                draw bim ui frame (coreLeft + 4.0) (lineTop + 7.0) 14.0 14.0 coloured palette's strong's red, palette's strong's green and palette's strong's blue in frame
                if bim layer layerIndex of type row's id is core in modelValue:
                    draw bim ui rectangle (coreLeft + 7.0) (lineTop + 10.0) 8.0 8.0 painted palette's accent in frame
                set upInk to palette's inkDisabled
                if layerIndex > 0:
                    set upInk to palette's ink
                set downInk to palette's inkDisabled
                if layerIndex < (countValue - 1):
                    set downInk to palette's ink
                set removeInk to palette's inkDisabled
                if countValue > 1:
                    set removeInk to palette's ink
                draw bim manager label (the string form of "^") at ((left + (the bim manager column left of 4)) + 7.0) and (lineTop + 20.0) ending ((left + (the bim manager column left of 4)) + 22.0) using atlas painted upInk in frame
                draw bim manager label (the string form of "v") at ((left + (the bim manager column left of 5)) + 7.0) and (lineTop + 18.0) ending ((left + (the bim manager column left of 5)) + 22.0) using atlas painted downInk in frame
                draw bim manager label (the string form of "x") at ((left + (the bim manager column left of 6)) + 7.0) and (lineTop + 18.0) ending ((left + (the bim manager column left of 6)) + 22.0) using atlas painted removeInk in frame
        set addOrigin to ((the bim manager layer top of countValue) + 6.0) - shift
        if bim manager detail band at addOrigin tall 28.0 is visible in panelGeometry:
            draw bim manager button (the string form of "+ Layer") at (left + 320.0) and (top + addOrigin) across 100.0 active (countValue < (bim layer setting span)) hovered (hovered = -22) using atlas in frame
            set coreText to (the string form of "Core ") + (the bim length (the bim core thickness of type row's id in modelValue) in units editor's lengthUnit)
            set summary to (((the string form of (countValue)) + (the string form of " layers, total ")) + (the bim length row's width in units editor's lengthUnit)) + ((the string form of ", ") + coreText)
            draw bim manager label summary at (left + 432.0) and ((top + addOrigin) + 18.0) ending (left + ((the bim manager section left) - 8.0)) using atlas painted palette's inkSecondary in frame
        set sectionTop to (the bim manager table top) - shift
        set sectionHeight to the maximum of 150.0 and (((the bim manager layer top of countValue) + 34.0) - (the bim manager table top))
        if bim manager detail band at sectionTop tall sectionHeight is visible in panelGeometry:
            draw bim layered section of row for stateValue in editor from (left + (the bim manager section left)) and (top + sectionTop) across ((boxWidth - 20.0) - (the bim manager section left)) tall sectionHeight using atlas in frame

# The material picker over the detail pane: the library's materials and the
# model's, each with its colour, and a last tile to type another name.
local function draw bim manager picker for {bim type manager record:stateValue} showing {bim managed type record:row} in {bim editor record:editor} within {bim type manager layout record:panelGeometry} hovering {integer:hovered} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set palette to the bim ui palette
        set left to panelGeometry's left
        set top to panelGeometry's top
        set paneWidth to (panelGeometry's width - 20.0) - 320.0
        set paneHeight to panelGeometry's bodyBottom - panelGeometry's bodyTop
        draw bim ui rectangle (left + 320.0) (top + panelGeometry's bodyTop) paneWidth paneHeight painted palette's panel in frame
        draw bim ui frame (left + 320.0) (top + panelGeometry's bodyTop) paneWidth paneHeight coloured palette's accent's red, palette's accent's green and palette's accent's blue in frame
        set current to the bim managed field 1 of row layer stateValue's picking in editor
        set heading to the string form of "Material"
        if stateValue's picking != bim manager linear material:
            set heading to (the string form of "Material of layer ") + (the string form of (stateValue's picking + 1))
            set current to the bim managed field 1 of row layer stateValue's picking in editor
        else:
            set current to the bim managed field 1 of row layer 0 in editor
        draw bim manager text heading at (left + 330.0) and (top + 138.0) ending (((left + 320.0) + paneWidth) - 8.0) in face (bim text semibold) using atlas painted palette's ink in frame
        draw bim manager label (the string form of "From the material library and the model; Esc closes") right at (((left + 320.0) + paneWidth) - 10.0) and (top + 138.0) using atlas painted palette's inkSecondary in frame
        set choices to the bim material choices of (editor's documentValue's current) at most 40
        append (the string form of "Other name...") to choices
        set columns to the bim manager picker columns across panelGeometry's width
        set tileWidth to paneWidth / (columns as a 64 bit floating-point number)
        loop choice from 0 to the length of choices:
            set tileLine to choice / columns
            set tileColumn to the remainder of choice divided by columns
            set tileLeft to (left + 320.0) + ((tileColumn as a 64 bit floating-point number) * tileWidth)
            set tileTop to (top + 150.0) + ((tileLine as a 64 bit floating-point number) * 26.0)
            if (tileTop + 24.0) <= (top + panelGeometry's bodyBottom):
                set materialName to the item at choice in choices
                set paint to palette's raised
                if materialName = current:
                    set paint to palette's selected
                if hovered = (6000 + choice):
                    set paint to palette's hover
                draw bim ui rounded rectangle (tileLeft + 4.0) tileTop (tileWidth - 8.0) 24.0 radius 3.0 painted paint in frame
                if choice < ((the length of choices) - 1):
                    draw bim manager swatch of materialName at (tileLeft + 10.0) and (tileTop + 6.0) sized 12.0 in frame
                draw bim manager label materialName at (tileLeft + 28.0) and (tileTop + 17.0) ending ((tileLeft + tileWidth) - 8.0) using atlas painted palette's ink in frame
        free choices

function draw bim type manager {bim type manager record:stateValue} for {bim editor record:editor} across {a 64 bit floating-point number:screenWidth} by {a 64 bit floating-point number:screenHeight} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        if stateValue's open = false:
            return nothing
        set state to stateValue
        refresh bim type manager (the address of state) for editor
        set palette to the bim ui palette
        set panelGeometry to the bim type manager layout of state across screenWidth by screenHeight
        set boxWidth to panelGeometry's width
        set boxHeight to panelGeometry's height
        set left to panelGeometry's left
        set top to panelGeometry's top
        set modelValue to editor's documentValue's current
        set row to the bim managed type state's chosenId in family state's family in modelValue
        set hovered to the bim type manager action at pointerX and pointerY across screenWidth by screenHeight for state showing row
        draw bim ui rectangle (left + 5.0) (top + 5.0) boxWidth boxHeight painted palette's strong in frame
        draw bim ui rectangle left top boxWidth boxHeight painted palette's panel in frame
        draw bim ui frame left top boxWidth boxHeight coloured palette's border's red, palette's border's green and palette's border's blue in frame
        draw bim ui rectangle left top boxWidth 32.0 painted palette's chrome in frame
        draw bim manager text (the string form of "IfcTypes") at (left + 12.0) and (top + 21.0) ending (left + 120.0) in face (bim text semibold) using atlas painted palette's ink in frame
        set libraryCount to ((the length of (modelValue's wallTypes's values)) + (the length of (modelValue's linearTypes's values))) + (the length of (modelValue's openingTypes's values))
        draw bim manager label ((the string form of libraryCount) + (the string form of " types in the project library")) at (left + 96.0) and (top + 21.0) ending ((left + boxWidth) - 50.0) using atlas painted palette's inkSecondary in frame
        if hovered = -1:
            draw bim ui rectangle ((left + boxWidth) - 34.0) (top + 2.0) 30.0 28.0 painted palette's hover in frame
        draw bim manager label (the string form of "x") at ((left + boxWidth) - 24.0) and (top + 21.0) ending ((left + boxWidth) - 5.0) using atlas painted palette's ink in frame
        # The families, one tab each, with how many types each holds.
        set families to the bim type manager family names
        loop familyCursor from 0 to 4:
            set tabLeft to (left + 12.0) + ((familyCursor as a 64 bit floating-point number) * 150.0)
            set familyRows to the bim managed types in family familyCursor in modelValue
            set familyCount to the length of familyRows
            free familyRows
            if familyCursor = state's family:
                draw bim ui top rounded rectangle tabLeft (top + 38.0) 146.0 30.0 radius 4.0 painted palette's selected in frame
                draw bim ui rectangle tabLeft (top + 66.0) 146.0 2.0 painted palette's accent in frame
            else if hovered = (100 + familyCursor):
                draw bim ui top rounded rectangle tabLeft (top + 38.0) 146.0 30.0 radius 4.0 painted palette's hover in frame
            draw bim manager text (the item at familyCursor in families) at (tabLeft + 10.0) and (top + 58.0) ending (tabLeft + 110.0) in face (bim text semibold) using atlas painted palette's ink in frame
            draw bim manager label (the string form of familyCount) right at (tabLeft + 138.0) and (top + 58.0) using atlas painted palette's inkSecondary in frame
        draw bim ui line from (left + 10.0) (top + 68.0) to ((left + boxWidth) - 10.0) (top + 68.0) wide 1.0 coloured palette's border's red, palette's border's green and palette's border's blue in frame
        draw bim manager button (the string form of "Add") at (left + 12.0) and (top + 78.0) across 100.0 active true hovered (hovered = -10) using atlas in frame
        draw bim manager button (the string form of "Duplicate") at (left + 118.0) and (top + 78.0) across 100.0 active (row's id != the bim refused id) hovered (hovered = -11) using atlas in frame
        set canDelete to (row's id != the bim refused id) and ((the bim managed type use count of row's id in modelValue) = 0)
        draw bim manager button (the string form of "Delete") at (left + 224.0) and (top + 78.0) across 100.0 active canDelete hovered (hovered = -12) using atlas in frame
        draw bim manager button (the string form of "Apply") at (left + 330.0) and (top + 78.0) across 100.0 active (row's id != the bim refused id) hovered (hovered = -13) using atlas in frame
        set familyNote to the string form of "Planar build-ups with a role: IfcWallType, IfcSlabType (FLOOR, ROOF), IfcCoveringType (CEILING)"
        if state's family = bim profiled family:
            set familyNote to the string form of "Profiled members with a role: IfcColumnType, IfcBeamType, IfcPileType"
        if state's family = bim opening family:
            set familyNote to the string form of "Windows and doors: IfcWindowType, IfcDoorType"
        if state's family = bim profile family:
            set familyNote to the string form of "Profiled types with a catalogue steel profile"
        draw bim manager label familyNote at (left + 444.0) and (top + 97.0) ending ((left + boxWidth) - 20.0) using atlas painted palette's inkSecondary in frame
        # The role chips, the filter and the list.
        set groups to the bim manager groups of family state's family
        set chipCount to (the length of groups) + 1
        if chipCount > 1:
            set chipWidth to 290.0 / (chipCount as a 64 bit floating-point number)
            loop chip from 0 to chipCount:
                set chipLeft to (left + 12.0) + ((chip as a 64 bit floating-point number) * chipWidth)
                set chipName to the string form of "All"
                set chosenChip to state's roleFilter < 0
                if chip > 0:
                    set chipName to the bim manager name of group (the item at (chip - 1) in groups) in family state's family
                    set chosenChip to state's roleFilter = (the item at (chip - 1) in groups)
                set paint to palette's raised
                set ink to palette's ink
                if chosenChip:
                    set paint to palette's accent
                    set ink to palette's onAccent
                else if hovered = (300 + chip):
                    set paint to palette's hover
                draw bim ui rounded rectangle (chipLeft + 2.0) (top + 118.0) (chipWidth - 4.0) 22.0 radius 11.0 painted paint in frame
                set chipTextWidth to the bim text width of chipName in face (bim text small) of atlas
                draw bim manager label chipName at (the maximum of (chipLeft + 8.0) and (chipLeft + ((chipWidth - chipTextWidth) * 0.5))) and (top + 134.0) ending ((chipLeft + chipWidth) - 4.0) using atlas painted ink in frame
        else:
            draw bim manager label (the string form of "Steel series from the profile catalogue") at (left + 14.0) and (top + 134.0) ending (left + 300.0) using atlas painted palette's inkSecondary in frame
        draw bim ui rounded rectangle (left + 12.0) (top + 146.0) 290.0 24.0 radius 4.0 painted palette's raised in frame
        if state's field = bim manager search field:
            draw bim ui frame (left + 12.0) (top + 146.0) 290.0 24.0 coloured palette's accent's red, palette's accent's green and palette's accent's blue in frame
            draw bim manager label (state's search + (the string form of "|")) at (left + 20.0) and (top + 162.0) ending (left + 296.0) using atlas painted palette's ink in frame
        else if (the length of state's search) > 0:
            draw bim manager label ((the string form of "Filter: ") + state's search) at (left + 20.0) and (top + 162.0) ending (left + 296.0) using atlas painted palette's ink in frame
        else:
            draw bim manager label (the string form of "Type to filter by name or material") at (left + 20.0) and (top + 162.0) ending (left + 296.0) using atlas painted palette's inkDisabled in frame
        set listTop to the bim manager list top
        draw bim ui rectangle (left + 12.0) ((top + listTop) - 2.0) 290.0 ((panelGeometry's bodyBottom - listTop) + 2.0) painted palette's raised in frame
        set entries to the bim type manager entries of state in modelValue
        set visibleCount to the bim manager visible lines in panelGeometry
        set countValue to the minimum of visibleCount and ((the length of entries) - state's scroll)
        set shownIds to an empty list of a 64 bit integer
        loop cursor from 0 to countValue:
            append (the item at (state's scroll + cursor) in entries) to shownIds
        set useCounts to the bim managed use counts of shownIds in modelValue
        loop cursor from 0 to countValue:
            set entry to the item at cursor in shownIds
            set lineTop to (top + listTop) + ((cursor as a 64 bit floating-point number) * 24.0)
            if entry < (0 as a 64 bit integer):
                set groupCode to ((((0 as a 64 bit integer) - entry) - (1 as a 64 bit integer)) as an integer)
                draw bim ui rectangle (left + 14.0) lineTop 286.0 23.0 painted palette's panel in frame
                set foldSign to the string form of "-"
                if bim manager group groupCode is folded in state:
                    set foldSign to the string form of "+"
                draw bim manager label foldSign at (left + 20.0) and (lineTop + 16.0) ending (left + 32.0) using atlas painted palette's accentInk in frame
                draw bim manager text (the bim manager name of group groupCode in family state's family) at (left + 34.0) and (lineTop + 16.0) ending (left + 130.0) in face (bim text semibold) using atlas painted palette's ink in frame
                draw bim manager label (the bim manager ifc class of group groupCode in family state's family) at (left + 120.0) and (lineTop + 16.0) ending (left + 262.0) using atlas painted palette's inkSecondary in frame
                draw bim manager label (the string form of (the bim manager count of group groupCode in state in modelValue)) right at (left + 294.0) and (lineTop + 16.0) using atlas painted palette's inkSecondary in frame
            else:
                set itemValue to the bim managed type entry in family state's family in modelValue
                if entry = state's chosenId:
                    draw bim ui rectangle (left + 14.0) lineTop 286.0 23.0 painted palette's selected in frame
                    draw bim ui rectangle (left + 14.0) lineTop 3.0 23.0 painted palette's selectedBar in frame
                else if hovered = (1000 + cursor):
                    draw bim ui rectangle (left + 14.0) lineTop 286.0 23.0 painted palette's hover in frame
                draw bim managed glyph of itemValue in modelValue at (left + 20.0) and (lineTop + 6.0) in frame
                set uses to the item at cursor in useCounts
                set rightEdge to left + 294.0
                if uses > 0:
                    set usesText to (the string form of uses) + (the string form of "x")
                    draw bim manager label usesText right at rightEdge and (lineTop + 16.0) using atlas painted palette's accentInk in frame
                set rightEdge to left + 266.0
                set sizeText to the bim managed size text of itemValue in editor
                set sizeWidth to the bim text width of sizeText in face (bim text small) of atlas
                draw bim manager label sizeText right at rightEdge and (lineTop + 16.0) using atlas painted palette's inkSecondary in frame
                draw bim manager label itemValue's name at (left + 66.0) and (lineTop + 16.0) ending ((rightEdge - sizeWidth) - 6.0) using atlas painted palette's ink in frame
        if (the length of entries) = 0:
            set emptyNote to the string form of "No types in this family. Add creates one."
            if ((the length of state's search) > 0) or (state's roleFilter >= 0):
                set emptyNote to the string form of "No types match the filter."
            draw bim manager label emptyNote at (left + 22.0) and ((top + listTop) + 18.0) ending (left + 296.0) using atlas painted palette's inkSecondary in frame
        if (the length of entries) > visibleCount:
            set trackHeight to panelGeometry's bodyBottom - listTop
            set thumbHeight to the maximum of 20.0 and ((trackHeight * (visibleCount as a 64 bit floating-point number)) / ((the length of entries) as a 64 bit floating-point number))
            set thumbTop to (top + listTop) + (((trackHeight - thumbHeight) * (state's scroll as a 64 bit floating-point number)) / (the maximum of 1.0 and (((the length of entries) - visibleCount) as a 64 bit floating-point number)))
            draw bim ui rectangle (left + 304.0) thumbTop 3.0 thumbHeight painted palette's selectedBar in frame
        free useCounts
        free shownIds
        free entries
        free groups
        # The detail pane.
        if row's id = the bim refused id:
            draw bim manager label (the string form of "No type chosen. Add creates a definition of this family.") at (left + 320.0) and (top + 150.0) ending ((left + boxWidth) - 20.0) using atlas painted palette's inkSecondary in frame
        else if state's picking >= 0:
            draw bim manager picker for state showing row in editor within panelGeometry hovering hovered using atlas in frame
        else:
            set shift to panelGeometry's detailShift
            set summaryOrigin to 118.0 - shift
            if bim manager detail band at summaryOrigin tall 40.0 is visible in panelGeometry:
                draw bim manager text row's name at (left + 320.0) and ((top + summaryOrigin) + 16.0) ending ((left + boxWidth) - 20.0) in face (bim text semibold) using atlas painted palette's ink in frame
                set uses to the bim managed type use count of row's id in modelValue
                set summary to row's ifcClass
                if row's family = 0:
                    set summary to ((summary + (the string form of "   ")) + (the string form of row's layerCount)) + (the string form of " layers")
                set summary to ((summary + (the string form of "   ")) + (the bim managed size text of row in editor)) + (((the string form of "   used by ") + (the string form of uses)) + (the string form of " model references"))
                draw bim manager label summary at (left + 320.0) and ((top + summaryOrigin) + 34.0) ending ((left + boxWidth) - 20.0) using atlas painted palette's inkSecondary in frame
            if row's family != 0:
                set previewOrigin to 164.0 - shift
                if bim manager detail band at previewOrigin tall 88.0 is visible in panelGeometry:
                    draw bim managed preview row in modelValue from (left + 320.0) and (top + previewOrigin) across (boxWidth - 340.0) in frame
            set codes to the bim manager fields of row
            loop slot from 0 to the length of codes:
                set fieldCode to the item at slot in codes
                set fieldOrigin to (the bim manager field top of slot slot of row) - shift
                if bim manager detail band at fieldOrigin tall 28.0 is visible in panelGeometry:
                    set fieldTop to top + fieldOrigin
                    draw bim manager label (the bim manager field label fieldCode of row) at (left + 320.0) and (fieldTop + 19.0) ending (left + 435.0) using atlas painted palette's inkSecondary in frame
                    set chooser to ((fieldCode = 7) or (fieldCode = 8)) or ((fieldCode = 1) and (row's family = 1))
                    set editable to (bim managed field fieldCode is editable for row) or chooser
                    if (fieldCode = 7) and (row's family != 2):
                        set editable to (the bim managed next role of row in modelValue) >= 0
                    set valueText to the string form of ""
                    if fieldCode = 7:
                        set valueText to the bim managed role text of row
                    else if fieldCode = 8:
                        set valueText to the string form of "Rectangle"
                        if row's round:
                            set valueText to the string form of "Round"
                    else:
                        set valueText to the bim managed field fieldCode of row layer state's layer in editor
                    set ink to palette's inkDisabled
                    if editable:
                        set ink to palette's ink
                    set paint to palette's raised
                    if editable and (hovered = (200 + fieldCode)):
                        set paint to palette's hover
                    draw bim ui rounded rectangle (left + 440.0) fieldTop (boxWidth - 460.0) 28.0 radius 3.0 painted paint in frame
                    set textLeft to left + 448.0
                    if (fieldCode = 1) and (row's family = 1):
                        draw bim manager swatch of valueText at (left + 448.0) and (fieldTop + 8.0) sized 12.0 in frame
                        set textLeft to left + 466.0
                    if state's field = fieldCode:
                        draw bim ui frame (left + 440.0) fieldTop (boxWidth - 460.0) 28.0 coloured palette's accent's red, palette's accent's green and palette's accent's blue in frame
                        set valueText to state's text + (the string form of "|")
                    draw bim manager label valueText at textLeft and (fieldTop + 19.0) ending ((left + boxWidth) - 44.0) using atlas painted ink in frame
                    if chooser and editable:
                        draw bim manager label (the string form of ">") at ((left + boxWidth) - 36.0) and (fieldTop + 19.0) ending ((left + boxWidth) - 24.0) using atlas painted palette's inkSecondary in frame
            free codes
            if row's family = 0:
