# SPDX-License-Identifier: MPL-2.0
# Compact picker labels; the model and API retain the full recipe names.
import lib/std.dl
import lib/text.dl
function the bim compact type label of {a string:nameValue}:
    execute:
        set labelValue to nameValue
        set patioPrefix to the string form of "Reynaers ConceptPatio 130 - "
        set masterPrefix to the string form of "Reynaers MasterPatio - "
        set slimPrefix to the string form of "Reynaers SlimPatio 68 - "
        if nameValue starts with patioPrefix:
            set labelValue to (the string form of "CP130 ") + (the substring of nameValue from (the length of patioPrefix) spanning ((the length of nameValue) - (the length of patioPrefix)) bytes)
        else if nameValue starts with masterPrefix:
            set labelValue to (the string form of "MasterPatio ") + (the substring of nameValue from (the length of masterPrefix) spanning ((the length of nameValue) - (the length of masterPrefix)) bytes)
        else if nameValue starts with slimPrefix:
            set labelValue to (the string form of "SlimPatio 68 ") + (the substring of nameValue from (the length of slimPrefix) spanning ((the length of nameValue) - (the length of slimPrefix)) bytes)
        if labelValue ends with " layout":
            set labelValue to the substring of labelValue from 0 spanning ((the length of labelValue) - 7) bytes
        return labelValue
