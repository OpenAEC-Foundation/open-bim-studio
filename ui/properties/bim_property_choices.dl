# SPDX-License-Identifier: MPL-2.0
# Included by bim_editor_properties: choice menus for property rows (#99).
#
# A row whose value is one of a few choices (a view's phase, drawing type,
# display and hatch, the project's units and drawing standard, a building
# system's pattern and openings, a grid's heads, an element's phases, a
# sheet's paper and orientation) opens
# a list of its options in the properties panel instead of taking the next
# value on every click. The panel sends `bim browser property` with one of
# two codes: `the bim menu toggle of property` opens or shuts the menu of
# a row, `the bim menu option … of property` chooses an option. A row's own
# code still takes the next value, as before, for the context menu and the
# automation API. A sheet's number and name are typed (`apply bim editor
# typed sheet field`); every change to a sheet is one edit.
#
# While a menu is open the row's code is the editor's `propertyCode`, so the
# keys come here as they come to a typed value; `propertyText` then holds
# the number of the option the arrow keys reach. The values stored and
# their meaning are those of the stepping in `start bim editor property`.
import ui/editor/bim_editor_core.dl

# The codes a click in the panel sends: the menu of row `c` opened or shut
# (`bim property menu base` + c), and its option `n` chosen
# (`bim property option base` + c * `bim property option stride` + n).
function bim property menu base:
    replacement:
        70000000
function bim property option base:
    replacement:
        80000000
function bim property option stride:
    replacement:
        100

function bim arrow down key code:
    replacement:
        264
function bim arrow up key code:
    replacement:
        265

function the bim menu toggle of property {integer:rowCode}:
    execute:
        return (bim property menu base) + rowCode

function the bim menu option {integer:optionIndex} of property {integer:rowCode}:
    execute:
        return ((bim property option base) + (rowCode * (bim property option stride))) + optionIndex

# True for the rows that choose among a few values.
function bim property {integer:rowCode} opens a menu:
    execute:
        if (rowCode >= bim phase created property) and (rowCode <= bim view drawing type property):
            return true
        if ((rowCode = bim view display property) or (rowCode = bim view hatch property)) or (rowCode = bim plan presentation property):
            return true
        if (rowCode = bim drawing standard property) or (rowCode = bim grid head property):
            return true
        if (rowCode = bim opening rule property) or (rowCode = bim system pattern property):
            return true
        if (rowCode = bim sheet paper property) or (rowCode = bim sheet orientation property):
            return true
        return (((rowCode = bim project length unit property) or (rowCode = bim project area unit property)) or (rowCode = bim project angle unit property)) or (rowCode = bim project currency property)

# A row's name as the panel shows it beside a drop-down: without the
# " (click)" that tells the context menu a click takes the next value.
function the bim unhinted form of {a string:rowLabel}:
    execute:
        set hintText to the string form of " (click)"
        set labelLength to the length of rowLabel
        set hintLength to the length of hintText
        if labelLength <= hintLength:
            return rowLabel
        if (the substring of rowLabel from (labelLength - hintLength) spanning hintLength bytes) = hintText:
            return the substring of rowLabel from 0 spanning (labelLength - hintLength) bytes
        return rowLabel

# The view whose properties show: its place among the model's views.
local function the bim menu view of {bim editor record:editor}:
    execute:
        return the bim view index of (the bim properties view of editor) in editor's documentValue's current

# The sheet whose properties show: its place among the model's sheets.
local function the bim menu sheet of {bim editor record:editor}:
    execute:
        set sheetFound to the bim sheet index of editor's sheetId in editor's documentValue's current
        if editor's propertiesViewId != bim sheet properties context:
            set sheetFound's valid to false
        return sheetFound

local function the bim project setting code of property {integer:rowCode}:
    execute:
        if rowCode = bim project area unit property:
            return bim project area unit setting
        if rowCode = bim project angle unit property:
            return bim project angle unit setting
        if rowCode = bim project currency property:
            return bim project currency setting
        return bim project length unit setting

# The options of row `rowCode` for what `editor` shows, in order, as the
# row shows them; empty when the row is no choice there. The last phase
# stands for "the last" (the refused id), as the stepping keeps it; the
# phase demolished ends with "Never".
function the bim menu offering of property {integer:rowCode} for {bim editor record:editor}:
    execute:
        set offeredNames to an empty list of a string
        set modelValue to editor's documentValue's current
        set phaseList to modelValue's phases's values
        if (rowCode = bim phase created property) or (rowCode = bim phase demolished property):
            if editor's selectionKind = bim nothing picked:
                return offeredNames
            set phaseTotal to the length of phaseList
            if rowCode = bim phase demolished property:
                set phaseTotal to phaseTotal - 1
            loop phaseCursor from 0 to phaseTotal:
                append (the item at phaseCursor in phaseList)'s name to offeredNames
            if rowCode = bim phase demolished property:
                append (the string form of "Never") to offeredNames
            return offeredNames
        if (rowCode = bim view phase property) or (rowCode = bim view drawing type property):
            if (the bim menu view of editor)'s valid = false:
                return offeredNames
            if rowCode = bim view phase property:
                loop phaseCursor from 0 to the length of phaseList:
                    append (the item at phaseCursor in phaseList)'s name to offeredNames
                return offeredNames
            set typeList to modelValue's drawingTypes's values
            loop typeCursor from 0 to the length of typeList:
                set drawingTypeValue to the item at typeCursor in typeList
                # A type under another is indented, as in the rules window.
                if drawingTypeValue's parentId = the bim refused id:
                    append drawingTypeValue's name to offeredNames
                else:
                    append ((the string form of "  ") + drawingTypeValue's name) to offeredNames
            return offeredNames
        if (rowCode = bim view display property) or ((rowCode = bim view hatch property) or (rowCode = bim plan presentation property)):
            if (the bim menu view of editor)'s valid = false:
                return offeredNames
            if rowCode = bim view display property:
                loop displayCursor from 0 to 3:
                    append (the bim name of display displayCursor) to offeredNames
            if rowCode = bim view hatch property:
                append (the string form of "World") to offeredNames
                append (the string form of "Along objects") to offeredNames
            if rowCode = bim plan presentation property:
                append (the string form of "Model review") to offeredNames
                append (the string form of "Technical drawing") to offeredNames
            return offeredNames
        if (rowCode = bim sheet paper property) or (rowCode = bim sheet orientation property):
            if (the bim menu sheet of editor)'s valid = false:
                return offeredNames
            if rowCode = bim sheet paper property:
                loop paperCursor from (bim a0 paper) to ((bim a4 paper) + 1):
                    append (the bim format name of paperCursor) to offeredNames
            else:
                append (the string form of "Portrait") to offeredNames
                append (the string form of "Landscape") to offeredNames
            return offeredNames
        if rowCode = bim drawing standard property:
            loop standardCursor from 0 to (bim standard count):
                append (the bim name of standard standardCursor) to offeredNames
            return offeredNames
        if rowCode = bim project length unit property:
            loop unitCursor from 0 to 3:
                append (the bim name of length unit unitCursor) to offeredNames
            return offeredNames
        if rowCode = bim project area unit property:
            loop unitCursor from 0 to 2:
                append (the bim name of area unit unitCursor) to offeredNames
            return offeredNames
        if rowCode = bim project angle unit property:
            loop unitCursor from 0 to 2:
                append (the bim name of angle unit unitCursor) to offeredNames
            return offeredNames
        if rowCode = bim project currency property:
            loop unitCursor from 0 to 3:
                append (the bim name of currency unitCursor) to offeredNames
            return offeredNames
        if rowCode = bim grid head property:
            if editor's selectionKind = bim grid picked:
                loop maskCursor from 0 to 4:
                    append (the bim name of grid head mask maskCursor) to offeredNames
            return offeredNames
        if editor's selectionKind != bim curtain picked:
            return offeredNames
        if rowCode = bim opening rule property:
            loop ruleCursor from 0 to 3:
                append (the bim name of opening rule ruleCursor) to offeredNames
        if rowCode = bim system pattern property:
            loop patternCursor from 0 to (bim pattern count):
                append (the bim name of pattern patternCursor) to offeredNames
        return offeredNames

# The option row `rowCode` holds now, numbered as in its offering; -1 when
# it holds none of them (a view without a drawing type).
function the bim standing menu option of property {integer:rowCode} for {bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        set phaseTotal to the length of (modelValue's phases's values)
        if (rowCode = bim phase created property) or (rowCode = bim phase demolished property):
            if (editor's selectionKind = bim nothing picked) or (phaseTotal = 0):
                return -1
            set elementPhasing to the bim phasing of element editor's selectionId in modelValue
            if rowCode = bim phase created property:
                return the bim phase order of elementPhasing's createdId in modelValue
            if elementPhasing's demolishedId = the bim refused id:
                return phaseTotal - 1
            return the minimum of (phaseTotal - 1) and (the bim phase order of elementPhasing's demolishedId in modelValue)
        if rowCode = bim drawing standard property:
            return the bim drawing standard of modelValue
        if (rowCode = bim sheet paper property) or (rowCode = bim sheet orientation property):
            set sheetFound to the bim menu sheet of editor
            if sheetFound's valid = false:
                return -1
            set sheetValue to the item at sheetFound's position in (modelValue's sheets's values)
            if rowCode = bim sheet paper property:
                return sheetValue's paper - (bim a0 paper)
            if sheetValue's landscape:
                return 1
            return 0
        if (((rowCode = bim project length unit property) or (rowCode = bim project area unit property)) or (rowCode = bim project angle unit property)) or (rowCode = bim project currency property):
            set settingCode to the bim project setting code of property rowCode
            return (the bim project setting settingCode in modelValue or (0 as a 64 bit integer)) as an integer
        if rowCode = bim grid head property:
            if editor's selectionKind != bim grid picked:
                return -1
            return the bim head mask of grid editor's selectionId in modelValue
        if (rowCode = bim opening rule property) or (rowCode = bim system pattern property):
            if editor's selectionKind != bim curtain picked:
                return -1
            if rowCode = bim opening rule property:
                return the bim opening rule of system editor's selectionId in modelValue
            return the bim pattern of system editor's selectionId in modelValue
        set viewFound to the bim menu view of editor
        if viewFound's valid = false:
            return -1
        set viewValue to the item at viewFound's position in (modelValue's views's values)
        if rowCode = bim view phase property:
            if phaseTotal = 0:
                return -1
            return the bim phase order of viewValue's phaseId in modelValue
        if rowCode = bim view drawing type property:
            set typeList to modelValue's drawingTypes's values
            loop typeCursor from 0 to the length of typeList:
                if (the item at typeCursor in typeList)'s id = viewValue's drawingTypeId:
                    return typeCursor
            return -1
        if rowCode = bim view display property:
            return viewValue's displayMode
        if rowCode = bim view hatch property:
            if bim view viewValue's id hatches along objects in modelValue:
                return 1
            return 0
        if rowCode = bim plan presentation property:
            if bim view viewValue's id uses a technical palette in modelValue:
                return 1
            return 0
        return -1

# True while a choice row's menu is open.
function bim editor shows a property menu {bim editor record:editor}:
    execute:
        if editor's propertyCode < 0:
            return false
        return bim property (editor's propertyCode) opens a menu

# The option the arrow keys reach in the open menu (`propertyText` read as
# a whole number; 0 when it holds none).
function the bim highlighted menu option of {bim editor record:editor}:
    execute:
        set keyedText to editor's propertyText
        set keyedValue to 0
        set digitCursor to 0
        set reading to true
        loop while reading and (digitCursor < (the length of keyedText)):
            set digitByte to (((the character at digitCursor in keyedText) as a 32 bit integer) bitwise and 255) as an integer
            if (digitByte >= 48) and (digitByte <= 57):
                set keyedValue to (keyedValue * 10) + (digitByte - 48)
                set digitCursor to digitCursor + 1
            else:
                set reading to false
        return keyedValue

# Opens the menu of row `rowCode`, the option it holds reached by the keys.
# The phases and drawing types are added first when the model lacks them,
# as a click on the row always did.
function open bim editor property menu {integer:rowCode} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set lacksPhases to ((rowCode >= bim phase created property) and (rowCode <= bim view phase property)) and ((the length of (target's phases's values)) = 0)
        set lacksTypes to false
        if rowCode = bim view drawing type property:
            set lacksTypes to ((the length of (target's drawingTypes's values)) = 0) or ((the bim drawing type named (the string form of "Area plan") in (@intrinsic("dereference", target))) = the bim refused id)
        if lacksPhases or lacksTypes:
            begin bim transaction in (the address of (editor's documentValue))
            if lacksPhases:
                ensure bim phases in target
            if lacksTypes:
                ensure bim drawing types in target
            commit bim transaction in (the address of (editor's documentValue))
        set editor's propertyCode to rowCode
        set standingOption to the bim standing menu option of property rowCode for (@intrinsic("dereference", editor))
        set editor's propertyText to the string form of (the maximum of standingOption and 0)
        set editor's message to the string form of "Choose an option, or use the arrow keys and Enter (Esc closes)"

# Sets row `rowCode` to its option `optionIndex`, as one edit, and closes
# its menu; an option it does not offer changes nothing.
function choose bim editor menu option {integer:optionIndex} of property {integer:rowCode} in {a pointer to a bim editor record:editor}:
    execute:
        set editor's propertyCode to -1
        set offeredNames to the bim menu offering of property rowCode for (@intrinsic("dereference", editor))
        set offeredTotal to the length of offeredNames
        free offeredNames
        if (optionIndex < 0) or (optionIndex >= offeredTotal):
            return nothing
        set target to the address of (editor's documentValue's current)
        set lastOption to (optionIndex = (offeredTotal - 1))
        if (rowCode = bim phase created property) or (rowCode = bim phase demolished property):
            set phaseList to target's phases's values
            set chosenPhase to the bim refused id
            if lastOption = false:
                set chosenPhase to (the item at optionIndex in phaseList)'s id
            begin bim transaction in (the address of (editor's documentValue))
            set chosenIds to the bim selected ids of (@intrinsic("dereference", editor))
            loop elementCursor from 0 to the length of chosenIds:
                set elementId to the item at elementCursor in chosenIds
                set elementPhasing to the bim phasing of element elementId in (@intrinsic("dereference", target))
                set builtPhase to elementPhasing's createdId
                set gonePhase to elementPhasing's demolishedId
                if rowCode = bim phase created property:
                    set builtPhase to chosenPhase
                else:
                    set gonePhase to chosenPhase
                set bim element elementId built in builtPhase demolished in gonePhase in target
            free chosenIds
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Phase changed"
            show bim editor plan view editor's planViewId in editor
            set editor's viewsDirty to true
            return nothing
        if (((rowCode = bim project length unit property) or (rowCode = bim project area unit property)) or (rowCode = bim project angle unit property)) or (rowCode = bim project currency property):
            begin bim transaction in (the address of (editor's documentValue))
            set settingCode to the bim project setting code of property rowCode
            set bim project setting settingCode to (optionIndex as a 64 bit integer) unless (0 as a 64 bit integer) in target
            commit bim transaction in (the address of (editor's documentValue))
            if rowCode = bim project length unit property:
                set editor's lengthUnit to optionIndex
            set editor's message to the string form of "Project units changed"
            return nothing
        if (rowCode = bim sheet paper property) or (rowCode = bim sheet orientation property):
            set sheetFound to the bim menu sheet of (@intrinsic("dereference", editor))
            set sheetValue to the item at sheetFound's position in (target's sheets's values)
            set paperCode to sheetValue's paper
            set turnedWide to sheetValue's landscape
            if rowCode = bim sheet paper property:
                set paperCode to (bim a0 paper) + optionIndex
            else:
                set turnedWide to (optionIndex = 1)
            ignore change bim editor sheet number sheetValue's number name sheetValue's name paper paperCode landscape turnedWide in editor
            return nothing
        if rowCode = bim drawing standard property:
            begin bim transaction in (the address of (editor's documentValue))
            set bim setting (bim drawing standard setting) of (0 as a 64 bit integer) to (optionIndex as a 64 bit integer) keeping (optionIndex != bim nen standard) in target
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to (the string form of "Drawing standard: ") + (the bim name of standard optionIndex)
            return nothing
        if rowCode = bim grid head property:
            begin bim transaction in (the address of (editor's documentValue))
            set bim setting (bim grid head setting) of editor's selectionId to (optionIndex as a 64 bit integer) keeping (optionIndex != 3) in target
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to (the string form of "Grid heads: ") + (the bim name of grid head mask optionIndex)
            return nothing
        if rowCode = bim opening rule property:
            begin bim transaction in (the address of (editor's documentValue))
            set bim setting (bim opening rule setting) of editor's selectionId to (optionIndex as a 64 bit integer) keeping (optionIndex != bim cut and frame rule) in target
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to (the string form of "Openings: ") + (the bim name of opening rule optionIndex)
            return nothing
        if rowCode = bim system pattern property:
            begin bim transaction in (the address of (editor's documentValue))
            set bim setting (bim system pattern setting) of editor's selectionId to (optionIndex as a 64 bit integer) keeping (optionIndex != bim grid pattern) in target
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to (the string form of "Pattern: ") + (the bim name of pattern optionIndex)
            return nothing
        # The rows of the view whose properties show.
        set chosenView to the bim properties view of (@intrinsic("dereference", editor))
        set viewFound to the bim view index of chosenView in (@intrinsic("dereference", target))
        if viewFound's valid = false:
            return nothing
        set viewValue to the item at viewFound's position in (target's views's values)
        if rowCode = bim view display property:
            begin bim transaction in (the address of (editor's documentValue))
            if set bim view chosenView scale to viewValue's scale and display to optionIndex in target:
                commit bim transaction in (the address of (editor's documentValue))
                set editor's message to (viewValue's name + (the string form of ": ")) + (the bim name of display optionIndex)
            else:
                roll back bim transaction in (the address of (editor's documentValue))
            return nothing
        if rowCode = bim view hatch property:
            begin bim transaction in (the address of (editor's documentValue))
            set bim setting (bim view hatch setting) of chosenView to (1 as a 64 bit integer) keeping (optionIndex = 1) in target
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Hatches fixed in the world"
            if optionIndex = 1:
                set editor's message to the string form of "Hatches along the elements"
            return nothing
        if rowCode = bim plan presentation property:
            begin bim transaction in (the address of (editor's documentValue))
            set bim setting (bim technical plan setting) of chosenView to (1 as a 64 bit integer) keeping (optionIndex = 1) in target
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Drawing palette changed"
            return nothing
        begin bim transaction in (the address of (editor's documentValue))
        if rowCode = bim view phase property:
            set viewValue's phaseId to the bim refused id
            if lastOption = false:
                set viewValue's phaseId to (the item at optionIndex in (target's phases's values))'s id
            set editor's message to (the string form of "View phase: ") + (the bim phase name of viewValue's phaseId in (@intrinsic("dereference", target)))
        else:
            set viewValue's drawingTypeId to (the item at optionIndex in (target's drawingTypes's values))'s id
            set viewValue's automatic to true
            set editor's message to the string form of "View follows its drawing type (Automatic)"
        store bim view viewValue in target
        commit bim transaction in (the address of (editor's documentValue))
        show bim editor plan view editor's planViewId in editor
        set editor's viewsDirty to true

# A click the panel sent with code `clickCode`: true when it opened or shut
# a menu or chose an option (`start bim editor property` passes it here
# first).
function take bim editor menu click {integer:clickCode} in {a pointer to a bim editor record:editor}:
    execute:
        if clickCode >= bim property option base:
            set optionCode to clickCode - (bim property option base)
            set rowCode to optionCode / (bim property option stride)
            set optionIndex to the remainder of optionCode divided by (bim property option stride)
            choose bim editor menu option optionIndex of property rowCode in editor
            return true
        if clickCode >= bim property menu base:
            set rowCode to clickCode - (bim property menu base)
            if editor's propertyCode = rowCode:
                set editor's propertyCode to -1
                set editor's message to the string form of ""
            else if bim property rowCode opens a menu:
                open bim editor property menu rowCode in editor
            return true
        return false

# A key while a menu is open: the arrows move through the options, Enter
# chooses, Esc closes; the others are passed over. False when no menu is
# open (`type bim editor property key` passes keys here first).
function take bim editor menu key {integer:keyCode} in {a pointer to a bim editor record:editor}:
    execute:
        if (bim editor shows a property menu (@intrinsic("dereference", editor))) = false:
            return false
        set rowCode to editor's propertyCode
        set offeredNames to the bim menu offering of property rowCode for (@intrinsic("dereference", editor))
        set offeredTotal to the length of offeredNames
        free offeredNames
        set keyedOption to the minimum of (the bim highlighted menu option of (@intrinsic("dereference", editor))) and (offeredTotal - 1)
        if keyCode = bim arrow down key code:
            set keyedOption to the minimum of (keyedOption + 1) and (offeredTotal - 1)
        if keyCode = bim arrow up key code:
            set keyedOption to keyedOption - 1
        set editor's propertyText to the string form of (the maximum of keyedOption and 0)
        if keyCode = bim enter key code:
            choose bim editor menu option keyedOption of property rowCode in editor
        if keyCode = bim escape key code:
            set editor's propertyCode to -1
            set editor's message to the string form of "Cancelled"
        return true

# A click on a choice row outside the panel (the context menu, the
# automation API): the option after the one it holds, wrapping round.
function step bim editor property menu {integer:rowCode} in {a pointer to a bim editor record:editor}:
    execute:
        set offeredNames to the bim menu offering of property rowCode for (@intrinsic("dereference", editor))
        set offeredTotal to the length of offeredNames
        free offeredNames
        if offeredTotal = 0:
            set editor's propertyCode to -1
            return nothing
        set standingOption to the bim standing menu option of property rowCode for (@intrinsic("dereference", editor))
        choose bim editor menu option (the remainder of (standingOption + 1) divided by offeredTotal) of property rowCode in editor

# The sheet whose properties show renumbered, renamed, on another paper or
# turned, as one edit; false, and the sheet unchanged, when refused (an
# empty number, or one another sheet has).
function change bim editor sheet number {a string:sheetNumber} name {a string:sheetTitle} paper {integer:paperCode} landscape {boolean:sheetWide} in {a pointer to a bim editor record:editor}:
    execute:
        set sheetFound to the bim menu sheet of (@intrinsic("dereference", editor))
        if sheetFound's valid = false:
            set editor's message to the string form of "Open a sheet to change its properties"
            return false
        begin bim transaction in (the address of (editor's documentValue))
        if set bim sheet (editor's sheetId) number sheetNumber name sheetTitle paper paperCode landscape sheetWide in (the address of (editor's documentValue's current)):
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to (the string form of "Sheet ") + sheetNumber
            return true
        roll back bim transaction in (the address of (editor's documentValue))
        set editor's message to the string form of "Sheet unchanged: give a number no other sheet has"
        return false

# The typed number or name (`propertyCode` `code`) given to the sheet whose
# properties show, its spaces at either end left out.
function apply bim editor typed sheet field {integer:code} in {a pointer to a bim editor record:editor}:
    execute:
        set sheetFound to the bim menu sheet of (@intrinsic("dereference", editor))
        if sheetFound's valid = false:
            return nothing
        set sheetValue to the item at sheetFound's position in (editor's documentValue's current's sheets's values)
        set typedText to the bim trimmed grid label of editor's propertyText
        set sheetNumber to sheetValue's number
        set sheetTitle to sheetValue's name
        if code = bim sheet number property:
            set sheetNumber to typedText
        else:
            set sheetTitle to typedText
        ignore change bim editor sheet number sheetNumber name sheetTitle paper sheetValue's paper landscape sheetValue's landscape in editor
