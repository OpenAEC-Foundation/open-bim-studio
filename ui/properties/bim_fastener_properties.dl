# SPDX-License-Identifier: MPL-2.0
# Included by bim_editor_properties: native fastener type and group fields.
import ui/editor/bim_editor_core.dl
import elements/connection/bim_fastener_components.dl
import exchange/ifcx/bim_readings.dl

class:
    patterns:
        [a|] bim fastener edit result
    members:
        valid as a boolean
        parameters as a connection fastener parameters
        message as a string

function append bim fastener rows of {connection fastener parameters:parameters} diameter {a 64 bit floating-point number:diameterValue} length {a 64 bit floating-point number:lengthValue} kind {integer:familyValue} starting {integer:baseCode} in units {integer:unitCode} into {a pointer to a list:rows}:
    execute:
        set sizeValue to the connection metric fastener size of diameterValue
        set geometryLabel to the string form of "Parametric CSG"
        set geometryCode to 0
        if parameters's catalogue = false:
            set geometryLabel to the string form of "Legacy preview; enter Yes to upgrade"
            set geometryCode to baseCode
        append bim property (the string form of "Fastener geometry") showing geometryLabel as geometryCode to rows
        if familyValue != 7:
            set pitchLabel to the bim length (the connection thread pitch of parameters at diameter diameterValue) in units unitCode
            if parameters's pitch = 0.0:
                set pitchLabel to (the string form of "Auto (") + (pitchLabel + (the string form of ")"))
            append bim property (the string form of "Thread pitch") showing pitchLabel as (baseCode + 1) to rows
        if (familyValue = 1) or (familyValue = 3):
            set threadLabel to the string form of "Auto"
            if parameters's threadLength > 0.0:
                set threadLabel to the bim length parameters's threadLength in units unitCode
            append bim property (the string form of "Threaded length") showing threadLabel as (baseCode + 2) to rows
            append bim property (the string form of "Strength class") showing (the connection grade name of parameters's grade) as (baseCode + 3) to rows
        append bim property (the string form of "Finish") showing (the connection coating name of parameters's coating) as (baseCode + 4) to rows
        if (familyValue = 1) or (familyValue = 3):
            append bim property (the string form of "Washers") showing (the connection washer name of parameters's washers) as (baseCode + 5) to rows
            append bim property (the string form of "Number of nuts") showing (the string form of parameters's nuts) as (baseCode + 6) to rows
        if familyValue != 7:
            append bim property (the string form of "Nut class") showing (the string form of parameters's nutClass) as (baseCode + 7) to rows
        if (familyValue = 1) or (familyValue = 3):
            set gripLabel to the string form of "Auto"
            if parameters's grip > 0.0:
                set gripLabel to the bim length parameters's grip in units unitCode
            append bim property (the string form of "Grip length") showing gripLabel as (baseCode + 8) to rows
        if familyValue = 3:
            append bim property (the string form of "Anchor shape") showing (the bim fastener family name of 3 shaped parameters's anchorShape) as (baseCode + 9) to rows
            append bim property (the string form of "Bend radius (0 Auto)") showing (the bim length parameters's bendRadius in units unitCode) as (baseCode + 10) to rows
            append bim property (the string form of "Tail length (0 Auto)") showing (the bim length parameters's tailLength in units unitCode) as (baseCode + 11) to rows
        if familyValue != 7:
            set shownLabel to the string form of "No"
            if parameters's showThread:
                set shownLabel to the string form of "Yes"
            append bim property (the string form of "3D thread lines") showing shownLabel as (baseCode + 12) to rows
            set seriesLabel to the string form of "ISO"
            if parameters's headSeries = 1:
                set seriesLabel to the string form of "DIN"
            append bim property (the string form of "Spanner widths") showing seriesLabel as (baseCode + 13) to rows
        if sizeValue's commercial:
            append bim property (the string form of "Dimension reference") showing (the string form of "Commercial M40; supplier dimensions") as 0 to rows
        if familyValue = 7:
            append bim property (the string form of "Bore") showing (the bim length sizeValue's washerInner in units unitCode) as 0 to rows
            append bim property (the string form of "Outside diameter") showing (the bim length sizeValue's washerOuter in units unitCode) as 0 to rows
            append bim property (the string form of "Hardness") showing (the string form of "200 HV") as 0 to rows

function the bim fastener parameter edit of {connection fastener parameters:originalValue} field {integer:fieldValue} text {a string:rawText} units {integer:unitCode}:
    execute:
        set parameters to originalValue
        set parameters's catalogue to true
        set lowerText to the lowercase form of rawText
        set acceptedValue to false
        set numberValue to the bim real reading of rawText
        if lowerText = (the string form of "auto"):
            set numberValue to @intrinsic("construct", a bim real reading record, true, 0.0)
        if ((((fieldValue = 1) or (fieldValue = 2)) or (fieldValue = 8)) or ((fieldValue = 10) or (fieldValue = 11))) and numberValue's valid:
            set lengthValue to numberValue's value * (the bim metres per unitCode)
            if fieldValue = 1:
                set parameters's pitch to lengthValue
            if fieldValue = 2:
                set parameters's threadLength to lengthValue
            if fieldValue = 8:
                set parameters's grip to lengthValue
            if fieldValue = 10:
                set parameters's bendRadius to lengthValue
            if fieldValue = 11:
                set parameters's tailLength to lengthValue
            set acceptedValue to true
        if fieldValue = 3:
            if (rawText = (the string form of "4.6")) or (rawText = (the string form of "46")):
                set parameters's grade to 46
                set acceptedValue to true
            if (rawText = (the string form of "8.8")) or (rawText = (the string form of "88")):
                set parameters's grade to 88
                set parameters's nutClass to 8
                set acceptedValue to true
        if fieldValue = 4:
            if (lowerText = (the string form of "uncoated")) or (rawText = (the string form of "0")):
                set parameters's coating to 0
                set acceptedValue to true
            if (((lowerText = (the string form of "hot-dip")) or (lowerText = (the string form of "hot-dip galvanized"))) or (lowerText = (the string form of "hdg"))) or (rawText = (the string form of "1")):
                set parameters's coating to 1
                set acceptedValue to true
            if (((lowerText = (the string form of "electrolytic")) or (lowerText = (the string form of "electrolytically zinc-plated"))) or (lowerText = (the string form of "zinc-plated"))) or (rawText = (the string form of "2")):
                set parameters's coating to 2
                set acceptedValue to true
        if fieldValue = 5:
            if (lowerText = (the string form of "none")) or (rawText = (the string form of "0")):
                set parameters's washers to 0
                set acceptedValue to true
            if ((lowerText = (the string form of "head")) or (lowerText = (the string form of "under head"))) or (rawText = (the string form of "1")):
                set parameters's washers to 1
                set acceptedValue to true
            if ((lowerText = (the string form of "nut")) or (lowerText = (the string form of "under nut"))) or (rawText = (the string form of "2")):
                set parameters's washers to 2
                set acceptedValue to true
            if ((lowerText = (the string form of "both")) or (lowerText = (the string form of "under head and nut"))) or (rawText = (the string form of "3")):
                set parameters's washers to 3
                set acceptedValue to true
        if (fieldValue = 6) or (fieldValue = 7):
            set wholeValue to the bim whole reading of rawText
            if wholeValue's valid and ((wholeValue's value >= 0) and (wholeValue's value <= 8)):
                if fieldValue = 6:
                    set parameters's nuts to wholeValue's value as an integer
                else:
                    set parameters's nutClass to wholeValue's value as an integer
                set acceptedValue to true
        if (fieldValue = 0) or (fieldValue = 12):
            if ((lowerText = (the string form of "yes")) or (lowerText = (the string form of "true"))) or (rawText = (the string form of "1")):
                if fieldValue = 12:
                    set parameters's showThread to true
                set acceptedValue to true
            if (fieldValue = 12) and (((lowerText = (the string form of "no")) or (lowerText = (the string form of "false"))) or (rawText = (the string form of "0"))):
                set parameters's showThread to false
                set acceptedValue to true
        if fieldValue = 9:
            if ((lowerText = (the string form of "straight")) or (lowerText = (the string form of "straight anchor"))) or (rawText = (the string form of "0")):
                set parameters's anchorShape to 0
                set acceptedValue to true
            if ((lowerText = (the string form of "l")) or (lowerText = (the string form of "l anchor"))) or (rawText = (the string form of "1")):
                set parameters's anchorShape to 1
                set acceptedValue to true
            if ((lowerText = (the string form of "j")) or (lowerText = (the string form of "j anchor"))) or (rawText = (the string form of "2")):
                set parameters's anchorShape to 2
                set acceptedValue to true
            if ((lowerText = (the string form of "plate")) or (lowerText = (the string form of "plate-ended anchor"))) or (rawText = (the string form of "3")):
                set parameters's anchorShape to 3
                set acceptedValue to true
        if fieldValue = 13:
            if (lowerText = (the string form of "iso")) or (rawText = (the string form of "0")):
                set parameters's headSeries to 0
                set acceptedValue to true
            if (lowerText = (the string form of "din")) or (rawText = (the string form of "1")):
                set parameters's headSeries to 1
                set acceptedValue to true
        return @intrinsic("construct", a bim fastener edit result, acceptedValue, parameters, the string form of "Enter one of the shown fastener choices, or a valid length in project units")

function start bim editor fastener property {integer:code} in {a pointer to a bim editor record:editor}:
    execute:
        if (code < 60000) or (code > 62079):
            return false
        set editor's propertyCode to code
        set editor's propertyText to the string form of ""
        set fieldValue to the remainder of (code - 60000) divided by 16
        if code >= 62048:
            set fieldValue to code - 62048
        set hintValue to the string form of "Type a length in project units; 0 or Auto selects the default"
        if fieldValue = 3:
            set hintValue to the string form of "Strength class: type 4.6 or 8.8"
        if fieldValue = 4:
            set hintValue to the string form of "Finish: type hot-dip, electrolytic or uncoated"
        if fieldValue = 5:
            set hintValue to the string form of "Washers: type none, head, nut or both"
        if fieldValue = 6:
            set hintValue to the string form of "Number of nuts: type 0, 1 or 2"
        if fieldValue = 7:
            set hintValue to the string form of "Nut class: type 5 or 8"
        if fieldValue = 9:
            set hintValue to the string form of "Anchor: type straight, L, J or plate"
        if (fieldValue = 0) or (fieldValue = 12):
            set hintValue to the string form of "Type Yes or No and press Enter"
        if fieldValue = 0:
            set hintValue to the string form of "Type Yes to upgrade this legacy fastener group"
        if fieldValue = 13:
            set hintValue to the string form of "Spanner widths: type ISO or DIN"
        if fieldValue = 18:
            set hintValue to the string form of "Type Yes to make a separate fastener type for this placement"
        set editor's message to hintValue
        return true

function apply bim editor fastener property {integer:code} in {a pointer to a bim editor record:editor}:
    execute:
        if (code < 60000) or (code > 62079):
            return false
        set target to the address of (editor's documentValue's current)
        if code >= 62048:
            set placementFound to the bim instance index of editor's selectionId in (@intrinsic("dereference", target))
            if placementFound's valid = false:
                set editor's message to the string form of "Select a fastener component first"
                return true
            set placement to the item at placementFound's position in (target's instances's values)
            set bindingFound to the bim fastener component index of placement's componentId in (@intrinsic("dereference", target))
            if bindingFound's valid = false:
                set editor's message to the string form of "The selected component is not a fastener"
                return true
            set bindingValue to the item at bindingFound's position in (target's fastenerComponents's values)
            set fieldValue to code - 62048
            set acceptedValue to false
            if (fieldValue = 14) or (fieldValue = 15):
                set lengthReading to the bim real reading of editor's propertyText
                if lengthReading's valid:
                    set lengthValue to lengthReading's value * (the bim metres per editor's lengthUnit)
                    if fieldValue = 14:
                        set bindingValue's diameter to lengthValue
                        if bindingValue's kind = 6:
                            set bindingValue's length to (the connection metric fastener size of lengthValue)'s nutHeight
                        if bindingValue's kind = 7:
                            set bindingValue's length to (the connection metric fastener size of lengthValue)'s washerThickness
                    else:
                        set bindingValue's length to lengthValue
                    set acceptedValue to true
            else if fieldValue = 18:
                if (the lowercase form of editor's propertyText) = (the string form of "yes"):
                    begin bim transaction in (the address of (editor's documentValue))
                    set uniqueId to add bim fastener component of kind bindingValue's kind sized bindingValue's diameter by bindingValue's length configured bindingValue's parameters library slot -1 in target
                    if uniqueId != the bim refused id:
                        set placement's componentId to uniqueId
                        replace item at index placementFound's position in (target's instances's values) with placement
                        note bim change of placement's id in target
                        commit bim transaction in (the address of (editor's documentValue))
                        set editor's message to the string form of "This placement now has its own fastener type"
                    else:
                        roll back bim transaction in (the address of (editor's documentValue))
                    return true
            else:
                set editedValue to the bim fastener parameter edit of bindingValue's parameters field fieldValue text editor's propertyText units editor's lengthUnit
                set acceptedValue to editedValue's valid
                set bindingValue's parameters to editedValue's parameters
            if acceptedValue = false:
                set editor's message to the string form of "Invalid fastener property value"
                return true
            set issueValue to the bim fastener component issue of bindingValue
            if issueValue != (the string form of ""):
                set editor's message to issueValue
                return true
            begin bim transaction in (the address of (editor's documentValue))
            ignore store bim fastener component bindingValue in target
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Fastener type updated; all its placements follow"
            return true
        set nodeFound to the bim connection index of editor's selectionId in (@intrinsic("dereference", target))
        if nodeFound's valid = false:
            set editor's message to the string form of "Select a connection first"
            return true
        set nodeValue to the item at nodeFound's position in (target's connections's values)
        set partCursor to (code - 60000) / 16
        set fieldValue to the remainder of (code - 60000) divided by 16
        if partCursor >= (the length of (nodeValue's additions's values)):
            set editor's message to the string form of "The fastener group is no longer present"
            return true
        set partValue to the item at partCursor in (nodeValue's additions's values)
        if (partValue's kind != 1) and (partValue's kind != 3):
            set editor's message to the string form of "Select a bolt or anchor group"
            return true
        set editedValue to the bim fastener parameter edit of partValue's parameters field fieldValue text editor's propertyText units editor's lengthUnit
        if editedValue's valid = false:
            set editor's message to editedValue's message
            return true
        set partValue's parameters to editedValue's parameters
        set nodeValue's additions to the cad clone of nodeValue's additions
        replace item at index partCursor in (nodeValue's additions's values) with partValue
        set evaluatedValue to the bim connection evaluation of nodeValue in (@intrinsic("dereference", target))
        if evaluatedValue's valid = false:
            set editor's message to evaluatedValue's message
            return true
        begin bim transaction in (the address of (editor's documentValue))
        ignore store bim connection nodeValue in target
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to the string form of "Connection fastener group updated"
        return true
