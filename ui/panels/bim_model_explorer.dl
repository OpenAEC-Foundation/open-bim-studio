# SPDX-License-Identifier: MPL-2.0
# The Model Explorer: the whole model at a glance, above the properties
# (the rail's Props). As a tree: the project, its storeys with their elements
# by category, the grids, the types, the views and sheets, and the imported
# IFC by storey and class; or as a graph of the same nodes, laid out by depth
# from left to right over the workspace, with the relations of the node under
# the pointer or selected (its type, its host) drawn across. A click on a
# branch opens or closes it; a click on an element selects it, so that the
# properties below show it.
import ui/panels/bim_ui.dl
import ifc/bim_ifc_promote.dl

# One row of the explorer: its depth, what it shows, its key (which keeps it
# open), whether it has rows under it and shows them, what a click selects
# (`pickKind`, a `bim ... picked`, -1 for none), the row it hangs under, and
# the key of a row it relates to otherwise (its type, or its host).
class:
    patterns:
        [a|] bim model explorer row record
    members:
        depth as an integer
        label as a string
        detail as a string
        rowKey as a string
        branch as a boolean
        opened as a boolean
        pickKind as an integer
        elementId as a 64 bit integer
        parentRow as an integer
        relatedKey as a string

# How many rows one branch lists before "... more".
function the bim explorer branch limit:
    replacement:
        400

# The explorer's own click actions (`bim ui hit record`'s action, beside the
# project browser's): a row (its index in `actionId`), and the switch
# between the tree and the graph.
function bim explorer row action:
    replacement:
        40
function bim explorer mode action:
    replacement:
        41

# The keys open when the explorer first shows: the project and its storeys.
function the bim explorer first open keys:
    execute:
        set firstKeys to an empty list of a string
        append (the string form of "p") to firstKeys
        append (the string form of "p/s") to firstKeys
        return firstKeys

function bim explorer key {a string:wantedKey} is among {a pointer to a list:openKeys}:
    execute:
        loop keyCursor from 0 to the length of openKeys:
            if (the item at keyCursor in openKeys) = wantedKey:
                return true
        return false

# Opens key `toggledKey` when closed and closes it when open.
function toggle bim explorer key {a string:toggledKey} in {a pointer to a list:openKeys}:
    execute:
        set foundAt to -1
        loop keyCursor from 0 to the length of openKeys:
            if (the item at keyCursor in openKeys) = toggledKey:
                set foundAt to keyCursor
        if foundAt >= 0:
            remove item foundAt from openKeys
        else:
            append toggledKey to openKeys

local function the bim explorer row at {integer:depthLevel} showing {a string:shownLabel} and {a string:shownDetail} keyed {a string:keyText} branching {boolean:hasRows} picking {integer:kindCode} of {a 64 bit integer:pickedId} under {integer:parentIndex} related to {a string:linkText} among {a pointer to a list:openKeys}:
    execute:
        set isOpen to false
        if hasRows:
            set isOpen to bim explorer key keyText is among openKeys
        return @intrinsic("construct", a bim model explorer row record, depthLevel, shownLabel, shownDetail, keyText, hasRows, isOpen, kindCode, pickedId, parentIndex, linkText)

local function the bim id key of {a 64 bit integer:elementId} prefixed {a string:prefix}:
    execute:
        return prefix + (the string form of elementId)

# ---------------------------------------------------------------- names

# The element's IFC name when it has one (`the bim property value`), or
# `fallback`.
local function the bim explorer name of {a 64 bit integer:elementId} in {bim model record:modelValue} or {a string:fallback}:
    execute:
        set nameText to the bim property value (the string form of "Name") of set (the bim ifc attribute set name) of elementId in modelValue
        if (the length of nameText) > 0:
            return nameText
        return fallback

local function the bim wall type name of {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        loop typeCursor from 0 to the length of (modelValue's wallTypes's values):
            if (the item at typeCursor in (modelValue's wallTypes's values))'s id = typeId:
                return (the item at typeCursor in (modelValue's wallTypes's values))'s name
        return the string form of "Wall"

local function the bim opening type name of {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        loop typeCursor from 0 to the length of (modelValue's openingTypes's values):
            if (the item at typeCursor in (modelValue's openingTypes's values))'s id = typeId:
                return (the item at typeCursor in (modelValue's openingTypes's values))'s name
        return the string form of "Opening"

local function the bim linear type name of {a 64 bit integer:typeId} in {bim model record:modelValue}:
    execute:
        loop typeCursor from 0 to the length of (modelValue's linearTypes's values):
            if (the item at typeCursor in (modelValue's linearTypes's values))'s id = typeId:
                return (the item at typeCursor in (modelValue's linearTypes's values))'s name
        return the string form of "Column or beam"

local function the bim component name of {a 64 bit integer:componentId} in {bim model record:modelValue}:
    execute:
        loop typeCursor from 0 to the length of (modelValue's components's values):
            if (the item at typeCursor in (modelValue's components's values))'s id = componentId:
                return (the item at typeCursor in (modelValue's components's values))'s name
        return the string form of "Component"

# The level element `elementId` (an opening: its host wall) stands on.
local function the bim explorer level of opening host {a 64 bit integer:hostId} in {bim model record:modelValue}:
    execute:
        loop wallCursor from 0 to the length of (modelValue's walls's values):
            if (the item at wallCursor in (modelValue's walls's values))'s id = hostId:
                return (the item at wallCursor in (modelValue's walls's values))'s levelId
        return the bim refused id

# ---------------------------------------------------------------- categories

function the bim explorer category count:
    replacement:
        10

local function the bim explorer category name {integer:categoryIndex}:
    execute:
        if categoryIndex = 0:
            return the string form of "Walls"
        if categoryIndex = 1:
            return the string form of "Floors and roofs"
        if categoryIndex = 2:
            return the string form of "Windows and doors"
        if categoryIndex = 3:
            return the string form of "Columns and beams"
        if categoryIndex = 4:
            return the string form of "Stairs"
        if categoryIndex = 5:
            return the string form of "Railings"
        if categoryIndex = 6:
            return the string form of "Curtain walls"
        if categoryIndex = 7:
            return the string form of "Components"
        if categoryIndex = 9:
            return the string form of "Spaces"
        return the string form of "Free shapes (meshes)"

# The rows of the elements of `category` on level `levelId` (or, with
# `countOnly`, none: only how many there are, in the first row's detail).
# Each element's row hangs under row `parentIndex` at depth `depthLevel`.
local function append bim explorer elements of category {integer:categoryIndex} on {a 64 bit integer:levelId} in {bim model record:modelValue} at {integer:depthLevel} under {integer:parentIndex} to {a pointer to a list:rowList} among {a pointer to a list:openKeys}:
    execute:
        set emptyText to the string form of ""
        if categoryIndex = 0:
            loop itemCursor from 0 to the length of (modelValue's walls's values):
                set wallValue to the item at itemCursor in (modelValue's walls's values)
                if wallValue's levelId = levelId:
                    append (the bim explorer row at depthLevel showing (the bim explorer name of wallValue's id in modelValue or (the bim wall type name of wallValue's typeId in modelValue)) and (the bim id key of wallValue's id prefixed (the string form of "#")) keyed (the bim id key of wallValue's id prefixed (the string form of "e/")) branching false picking (bim wall picked) of wallValue's id under parentIndex related to (the bim id key of wallValue's typeId prefixed (the string form of "t/")) among openKeys) to rowList
        else if categoryIndex = 1:
            loop itemCursor from 0 to the length of (modelValue's slabs's values):
                set slabValue to the item at itemCursor in (modelValue's slabs's values)
                if slabValue's levelId = levelId:
                    append (the bim explorer row at depthLevel showing (the bim explorer name of slabValue's id in modelValue or (the string form of "Floor")) and (the bim id key of slabValue's id prefixed (the string form of "#")) keyed (the bim id key of slabValue's id prefixed (the string form of "e/")) branching false picking (bim slab picked) of slabValue's id under parentIndex related to emptyText among openKeys) to rowList
        else if categoryIndex = 2:
            loop itemCursor from 0 to the length of (modelValue's openings's values):
                set openingValue to the item at itemCursor in (modelValue's openings's values)
                if (the bim explorer level of opening host openingValue's hostId in modelValue) = levelId:
                    append (the bim explorer row at depthLevel showing (the bim explorer name of openingValue's id in modelValue or (the bim opening type name of openingValue's typeId in modelValue)) and (the bim id key of openingValue's id prefixed (the string form of "#")) keyed (the bim id key of openingValue's id prefixed (the string form of "e/")) branching false picking (bim opening picked) of openingValue's id under parentIndex related to (the bim id key of openingValue's hostId prefixed (the string form of "e/")) among openKeys) to rowList
        else if categoryIndex = 3:
            loop itemCursor from 0 to the length of (modelValue's linears's values):
                set linearValue to the item at itemCursor in (modelValue's linears's values)
                if linearValue's levelId = levelId:
                    append (the bim explorer row at depthLevel showing (the bim explorer name of linearValue's id in modelValue or (the bim linear type name of linearValue's typeId in modelValue)) and (the bim id key of linearValue's id prefixed (the string form of "#")) keyed (the bim id key of linearValue's id prefixed (the string form of "e/")) branching false picking (bim linear picked) of linearValue's id under parentIndex related to (the bim id key of linearValue's typeId prefixed (the string form of "t/")) among openKeys) to rowList
        else if categoryIndex = 4:
            loop itemCursor from 0 to the length of (modelValue's stairs's values):
                set stairValue to the item at itemCursor in (modelValue's stairs's values)
                if stairValue's levelId = levelId:
                    append (the bim explorer row at depthLevel showing (the bim explorer name of stairValue's id in modelValue or (the string form of "Stair")) and (the bim id key of stairValue's id prefixed (the string form of "#")) keyed (the bim id key of stairValue's id prefixed (the string form of "e/")) branching false picking (bim stair picked) of stairValue's id under parentIndex related to emptyText among openKeys) to rowList
        else if categoryIndex = 5:
            loop itemCursor from 0 to the length of (modelValue's railings's values):
                set railingValue to the item at itemCursor in (modelValue's railings's values)
                if railingValue's levelId = levelId:
                    append (the bim explorer row at depthLevel showing (the bim explorer name of railingValue's id in modelValue or (the string form of "Railing")) and (the bim id key of railingValue's id prefixed (the string form of "#")) keyed (the bim id key of railingValue's id prefixed (the string form of "e/")) branching false picking (bim railing picked) of railingValue's id under parentIndex related to (the bim id key of railingValue's hostId prefixed (the string form of "e/")) among openKeys) to rowList
        else if categoryIndex = 6:
            loop itemCursor from 0 to the length of (modelValue's curtains's values):
                set curtainValue to the item at itemCursor in (modelValue's curtains's values)
                if curtainValue's levelId = levelId:
                    append (the bim explorer row at depthLevel showing (the bim explorer name of curtainValue's id in modelValue or (the string form of "Curtain wall")) and (the bim id key of curtainValue's id prefixed (the string form of "#")) keyed (the bim id key of curtainValue's id prefixed (the string form of "e/")) branching false picking (bim curtain picked) of curtainValue's id under parentIndex related to emptyText among openKeys) to rowList
        else if categoryIndex = 7:
            loop itemCursor from 0 to the length of (modelValue's instances's values):
                set instanceValue to the item at itemCursor in (modelValue's instances's values)
                if (instanceValue's levelId = levelId) and (instanceValue's viewId = the bim refused id):
                    append (the bim explorer row at depthLevel showing (the bim explorer name of instanceValue's id in modelValue or (the bim component name of instanceValue's componentId in modelValue)) and (the bim id key of instanceValue's id prefixed (the string form of "#")) keyed (the bim id key of instanceValue's id prefixed (the string form of "e/")) branching false picking (bim instance picked) of instanceValue's id under parentIndex related to (the bim id key of instanceValue's componentId prefixed (the string form of "t/")) among openKeys) to rowList
        else if categoryIndex = 8:
            loop itemCursor from 0 to the length of (modelValue's meshes's values):
                set meshValue to the item at itemCursor in (modelValue's meshes's values)
                if meshValue's levelId = levelId:
                    set classText to the bim property value (the string form of "Class") of set (the bim ifc attribute set name) of meshValue's id in modelValue
                    if (the length of classText) = 0:
                        set classText to the bim id key of meshValue's id prefixed (the string form of "#")
                    append (the bim explorer row at depthLevel showing (the bim explorer name of meshValue's id in modelValue or (the string form of "Mesh")) and classText keyed (the bim id key of meshValue's id prefixed (the string form of "e/")) branching false picking (bim mesh picked) of meshValue's id under parentIndex related to emptyText among openKeys) to rowList
        else if categoryIndex = 9:
            loop itemCursor from 0 to the length of (modelValue's spaceObjects's values):
                set spaceValue to the item at itemCursor in (modelValue's spaceObjects's values)
                if spaceValue's levelId = levelId:
                    set spaceLabel to spaceValue's name
                    if (the length of spaceLabel) = 0:
                        set spaceLabel to the string form of "Space"
                    set spaceDetail to spaceValue's number
                    if (the length of spaceDetail) = 0:
                        set spaceDetail to the bim id key of spaceValue's id prefixed (the string form of "#")
                    append (the bim explorer row at depthLevel showing spaceLabel and spaceDetail keyed (the bim id key of spaceValue's id prefixed (the string form of "e/")) branching false picking (bim space object picked) of spaceValue's id under parentIndex related to emptyText among openKeys) to rowList

# How many elements of `category` stand on level `levelId`.
local function the bim explorer count of category {integer:categoryIndex} on {a 64 bit integer:levelId} in {bim model record:modelValue}:
    execute:
        set counted to an empty list of a bim model explorer row record
        set noKeys to an empty list of a string
        append bim explorer elements of category categoryIndex on levelId in modelValue at 0 under -1 to counted among noKeys
        set total to the length of counted
        free counted
        free noKeys
        return total

# Keeps at most `the bim explorer branch limit` rows after row `firstRow`,
# with a row saying how many more there are.
local function limit bim explorer rows after {integer:firstRow} at {integer:depthLevel} under {integer:parentIndex} in {a pointer to a list:rowList}:
    execute:
        set extra to ((the length of rowList) - firstRow) - (the bim explorer branch limit)
        if extra <= 0:
            return nothing
        loop while (the length of rowList) > (firstRow + (the bim explorer branch limit)):
            remove item ((the length of rowList) - 1) from rowList
        append (@intrinsic("construct", a bim model explorer row record, depthLevel, (the string form of "... ") + ((the string form of extra) + (the string form of " more")), the string form of "", the string form of "", false, false, -1, the bim refused id, parentIndex, the string form of "")) to rowList

# ---------------------------------------------------------------- the tree

# The rows of the explorer as shown: those under open rows only, in order.
# The caller frees the list.
function the bim model explorer rows of {bim model record:modelValue} with {bim import record:importValue} opening {a pointer to a list:openKeys}:
    execute:
        set rowList to an empty list of a bim model explorer row record
        set emptyText to the string form of ""
        set noId to the bim refused id
        append (the bim explorer row at 0 showing (the string form of "Project") and emptyText keyed (the string form of "p") branching true picking -1 of noId under -1 related to emptyText among openKeys) to rowList
        if ((the item at 0 in rowList)'s opened) = false:
            return rowList
        # The storeys, lowest first, each with its elements by category.
        set levelCount to the length of (modelValue's levels's values)
        append (the bim explorer row at 1 showing (the string form of "Storeys") and (the string form of levelCount) keyed (the string form of "p/s") branching (levelCount > 0) picking -1 of noId under 0 related to emptyText among openKeys) to rowList
        set storeysRow to (the length of rowList) - 1
        if (the item at storeysRow in rowList)'s opened:
            set placed to an empty list of a boolean
            loop levelCursor from 0 to levelCount:
                append false to placed
            loop orderCursor from 0 to levelCount:
                set lowest to -1
                loop levelCursor from 0 to levelCount:
                    if (the item at levelCursor in placed) = false:
                        if lowest < 0:
                            set lowest to levelCursor
                        else if (the item at levelCursor in (modelValue's levels's values))'s elevation < (the item at lowest in (modelValue's levels's values))'s elevation:
                            set lowest to levelCursor
                replace item at index lowest in placed with true
                set levelValue to the item at lowest in (modelValue's levels's values)
                set levelKey to the bim id key of levelValue's id prefixed (the string form of "p/s/")
                append (the bim explorer row at 2 showing levelValue's name and (the bim metres text of levelValue's elevation) keyed levelKey branching true picking (bim level picked) of levelValue's id under storeysRow related to emptyText among openKeys) to rowList
                set levelRow to (the length of rowList) - 1
                if (the item at levelRow in rowList)'s opened:
                    loop categoryCursor from 0 to the bim explorer category count:
                        set inCategory to the bim explorer count of category categoryCursor on levelValue's id in modelValue
                        if inCategory > 0:
                            set categoryKey to (levelKey + (the string form of "/")) + (the string form of categoryCursor)
                            append (the bim explorer row at 3 showing (the bim explorer category name categoryCursor) and (the string form of inCategory) keyed categoryKey branching true picking -1 of noId under levelRow related to emptyText among openKeys) to rowList
                            set categoryRow to (the length of rowList) - 1
                            if (the item at categoryRow in rowList)'s opened:
                                append bim explorer elements of category categoryCursor on levelValue's id in modelValue at 4 under categoryRow to rowList among openKeys
                                limit bim explorer rows after (categoryRow + 1) at 4 under categoryRow in rowList
            free placed
        # The grids.
        set gridCount to the length of (modelValue's grids's values)
        if gridCount > 0:
            append (the bim explorer row at 1 showing (the string form of "Grids") and (the string form of gridCount) keyed (the string form of "p/g") branching true picking -1 of noId under 0 related to emptyText among openKeys) to rowList
            set gridsRow to (the length of rowList) - 1
            if (the item at gridsRow in rowList)'s opened:
                loop gridCursor from 0 to gridCount:
                    set gridValue to the item at gridCursor in (modelValue's grids's values)
                    append (the bim explorer row at 2 showing gridValue's name and (the bim id key of gridValue's id prefixed (the string form of "#")) keyed (the bim id key of gridValue's id prefixed (the string form of "e/")) branching false picking (bim grid picked) of gridValue's id under gridsRow related to emptyText among openKeys) to rowList
        # The types, which elements relate to.
        append (the bim explorer row at 1 showing (the string form of "Types") and emptyText keyed (the string form of "p/t") branching true picking -1 of noId under 0 related to emptyText among openKeys) to rowList
        set typesRow to (the length of rowList) - 1
        if (the item at typesRow in rowList)'s opened:
            set wallTypeCount to the length of (modelValue's wallTypes's values)
            append (the bim explorer row at 2 showing (the string form of "Wall types") and (the string form of wallTypeCount) keyed (the string form of "p/t/w") branching (wallTypeCount > 0) picking -1 of noId under typesRow related to emptyText among openKeys) to rowList
            set groupRow to (the length of rowList) - 1
            if (the item at groupRow in rowList)'s opened:
                loop typeCursor from 0 to wallTypeCount:
                    set wallType to the item at typeCursor in (modelValue's wallTypes's values)
                    append (the bim explorer row at 3 showing wallType's name and emptyText keyed (the bim id key of wallType's id prefixed (the string form of "t/")) branching false picking -1 of noId under groupRow related to emptyText among openKeys) to rowList
                limit bim explorer rows after (groupRow + 1) at 3 under groupRow in rowList
            set openingTypeCount to the length of (modelValue's openingTypes's values)
            append (the bim explorer row at 2 showing (the string form of "Window and door types") and (the string form of openingTypeCount) keyed (the string form of "p/t/o") branching (openingTypeCount > 0) picking -1 of noId under typesRow related to emptyText among openKeys) to rowList
            set groupRow to (the length of rowList) - 1
            if (the item at groupRow in rowList)'s opened:
                loop typeCursor from 0 to openingTypeCount:
                    set openingType to the item at typeCursor in (modelValue's openingTypes's values)
                    set doorText to the string form of "window"
                    if openingType's isDoor:
                        set doorText to the string form of "door"
                    append (the bim explorer row at 3 showing openingType's name and doorText keyed (the bim id key of openingType's id prefixed (the string form of "t/")) branching false picking -1 of noId under groupRow related to emptyText among openKeys) to rowList
                limit bim explorer rows after (groupRow + 1) at 3 under groupRow in rowList
            set linearTypeCount to the length of (modelValue's linearTypes's values)
            append (the bim explorer row at 2 showing (the string form of "Column and beam types") and (the string form of linearTypeCount) keyed (the string form of "p/t/l") branching (linearTypeCount > 0) picking -1 of noId under typesRow related to emptyText among openKeys) to rowList
            set groupRow to (the length of rowList) - 1
            if (the item at groupRow in rowList)'s opened:
                loop typeCursor from 0 to linearTypeCount:
                    set linearType to the item at typeCursor in (modelValue's linearTypes's values)
                    append (the bim explorer row at 3 showing linearType's name and emptyText keyed (the bim id key of linearType's id prefixed (the string form of "t/")) branching false picking -1 of noId under groupRow related to emptyText among openKeys) to rowList
                limit bim explorer rows after (groupRow + 1) at 3 under groupRow in rowList
            set componentCount to the length of (modelValue's components's values)
            append (the bim explorer row at 2 showing (the string form of "Components") and (the string form of componentCount) keyed (the string form of "p/t/c") branching (componentCount > 0) picking -1 of noId under typesRow related to emptyText among openKeys) to rowList
            set groupRow to (the length of rowList) - 1
            if (the item at groupRow in rowList)'s opened:
                loop typeCursor from 0 to componentCount:
                    set componentValue to the item at typeCursor in (modelValue's components's values)
                    append (the bim explorer row at 3 showing componentValue's name and emptyText keyed (the bim id key of componentValue's id prefixed (the string form of "t/")) branching false picking -1 of noId under groupRow related to emptyText among openKeys) to rowList
                limit bim explorer rows after (groupRow + 1) at 3 under groupRow in rowList
        # The views and sheets.
        set viewCount to the length of (modelValue's views's values)
        set sheetCount to the length of (modelValue's sheets's values)
        append (the bim explorer row at 1 showing (the string form of "Views and sheets") and (the string form of (viewCount + sheetCount)) keyed (the string form of "p/v") branching ((viewCount + sheetCount) > 0) picking -1 of noId under 0 related to emptyText among openKeys) to rowList
        set viewsRow to (the length of rowList) - 1
        if (the item at viewsRow in rowList)'s opened:
            loop viewCursor from 0 to viewCount:
                set viewValue to the item at viewCursor in (modelValue's views's values)
                append (the bim explorer row at 2 showing viewValue's name and (the string form of "view") keyed (the bim id key of viewValue's id prefixed (the string form of "v/")) branching false picking -1 of noId under viewsRow related to (the bim id key of viewValue's levelId prefixed (the string form of "p/s/")) among openKeys) to rowList
            loop sheetCursor from 0 to sheetCount:
                set sheetValue to the item at sheetCursor in (modelValue's sheets's values)
                append (the bim explorer row at 2 showing ((sheetValue's number + (the string form of " ")) + sheetValue's name) and (the string form of "sheet") keyed (the bim id key of sheetValue's id prefixed (the string form of "v/")) branching false picking -1 of noId under viewsRow related to emptyText among openKeys) to rowList
            limit bim explorer rows after (viewsRow + 1) at 2 under viewsRow in rowList
        # The imported IFC, by storey and class.
        if importValue's valid:
            append bim explorer import of importValue at 1 under 0 to rowList among openKeys
        return rowList

# The imported elements' rows: one row for the import, under it its
# storeys (and "No storey"), under each the IFC classes found there, under
# each class its elements (named, or by GlobalId).
local function append bim explorer import of {bim import record:importValue} at {integer:depthLevel} under {integer:parentIndex} to {a pointer to a list:rowList} among {a pointer to a list:openKeys}:
    execute:
        set emptyText to the string form of ""
        set noId to the bim refused id
        set elementCount to the length of (importValue's labels's values)
        if elementCount = 0:
            return nothing
        append (the bim explorer row at depthLevel showing (the string form of "Imported IFC") and (the string form of elementCount) keyed (the string form of "p/i") branching true picking -1 of noId under parentIndex related to emptyText among openKeys) to rowList
        set importRow to (the length of rowList) - 1
        if ((the item at importRow in rowList)'s opened) = false:
            return nothing
        set storeyOf to importValue's storeys's ofElements's values
        set storeyCount to the length of (importValue's storeys's names's values)
        loop storeyCursor from -1 to storeyCount:
            # The elements on this storey (-1: on none).
            set onStorey to an empty list of an integer
            loop elementCursor from 0 to elementCount:
                set storeyIndex to -1
                if elementCursor < (the length of storeyOf):
                    set storeyIndex to the item at elementCursor in storeyOf
                if storeyIndex = storeyCursor:
                    append elementCursor to onStorey
            if (the length of onStorey) > 0:
                set storeyName to the string form of "No storey"
                set storeyHeight to emptyText
                if storeyCursor >= 0:
                    set storeyName to the item at storeyCursor in (importValue's storeys's names's values)
                    set storeyHeight to the bim metres text of (the item at storeyCursor in (importValue's storeys's elevations's values))
                set storeyKey to (the string form of "p/i/") + (the string form of storeyCursor)
                append (the bim explorer row at (depthLevel + 1) showing storeyName and storeyHeight keyed storeyKey branching true picking -1 of noId under importRow related to emptyText among openKeys) to rowList
                set storeyRow to (the length of rowList) - 1
                if (the item at storeyRow in rowList)'s opened:
                    # The classes on the storey, in the order first met.
                    set classNames to an empty list of a string
                    set classCounts to an empty list of an integer
                    loop onCursor from 0 to the length of onStorey:
                        set labelValue to the bim imported label of (the item at (the item at onCursor in onStorey) in (importValue's labels's values))
                        set classAt to -1
                        loop classCursor from 0 to the length of classNames:
                            if (the item at classCursor in classNames) = labelValue's className:
                                set classAt to classCursor
                        if classAt < 0:
                            append labelValue's className to classNames
                            append 1 to classCounts
                        else:
                            replace item at index classAt in classCounts with ((the item at classAt in classCounts) + 1)
                    loop classCursor from 0 to the length of classNames:
                        set className to the item at classCursor in classNames
                        set classKey to (storeyKey + (the string form of "/")) + className
                        append (the bim explorer row at (depthLevel + 2) showing className and (the string form of (the item at classCursor in classCounts)) keyed classKey branching true picking -1 of noId under storeyRow related to emptyText among openKeys) to rowList
                        set classRow to (the length of rowList) - 1
                        if (the item at classRow in rowList)'s opened:
                            loop onCursor from 0 to the length of onStorey:
                                set elementIndex to the item at onCursor in onStorey
                                set labelValue to the bim imported label of (the item at elementIndex in (importValue's labels's values))
                                if labelValue's className = className:
                                    set shownName to labelValue's name
                                    if (the length of shownName) = 0:
                                        set shownName to labelValue's globalId
                                    set importedId to (the bim imported id base) + (elementIndex as a 64 bit integer)
                                    append (the bim explorer row at (depthLevel + 3) showing shownName and (the string form of "IFC") keyed (the bim id key of importedId prefixed (the string form of "e/")) branching false picking (bim imported picked) of importedId under classRow related to emptyText among openKeys) to rowList
                            limit bim explorer rows after (classRow + 1) at (depthLevel + 3) under classRow in rowList
                    free classNames
                    free classCounts
            free onStorey

# The index of the row that selects element `elementId` among `rowList`, or
# -1.
function the bim explorer row of element {a 64 bit integer:elementId} among {a pointer to a list:rowList}:
    execute:
        if elementId = the bim refused id:
            return -1
        loop rowCursor from 0 to the length of rowList:
            if ((the item at rowCursor in rowList)'s pickKind >= 0) and ((the item at rowCursor in rowList)'s elementId = elementId):
                return rowCursor
        return -1

# ---------------------------------------------------------------- drawing

# The height of one row of the tree, and of the explorer's head.
function the bim explorer row height:
    replacement:
        22.0

# How far the tree's rows reach below its head, unscrolled.
function the bim explorer content height of {a pointer to a list:rowList}:
    execute:
        return ((the length of rowList) as a 64 bit floating-point number) * (the bim explorer row height)

local function the bim explorer click for {integer:actionCode} on {integer:target}:
    execute:
        return @intrinsic("construct", a bim ui hit record, -1, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, actionCode, target as a 64 bit integer)

# The two buttons of the head, Tree and Graph, with their right edge at
# `rightEdge`; the hit of the one under the pointer, or `hit`.
local function draw bim explorer modes right of {a 64 bit floating-point number:rightEdge} at {a 64 bit floating-point number:top} graph {boolean:graphShown} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} keeping {bim ui hit record:hit} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        set result to hit
        set buttonLeft to rightEdge - 104.0
        loop modeCursor from 0 to 2:
            set modeLabel to the string form of "Tree"
            set modeChosen to graphShown = false
            if modeCursor = 1:
                set modeLabel to the string form of "Graph"
                set modeChosen to graphShown
            set left to buttonLeft + ((modeCursor as a 64 bit floating-point number) * 52.0)
            set over to ((pointerX >= left) and (pointerX < (left + 50.0))) and ((pointerY >= (top + 3.0)) and (pointerY < (top + 21.0)))
            set modeInk to scheme's inkSecondary
            if modeChosen:
                draw bim ui rounded rectangle left (top + 3.0) 50.0 18.0 radius 3.0 painted scheme's selected in frame
                set modeInk to scheme's accentInk
            else if over:
                draw bim ui rounded rectangle left (top + 3.0) 50.0 18.0 radius 3.0 painted scheme's hover in frame
                set modeInk to scheme's ink
            set labelWidth to the bim text width of modeLabel in face (bim text small) of atlas
            draw bim ui text modeLabel at (left + ((50.0 - labelWidth) * 0.5)) and (top + 16.0) in face (bim text small) with atlas painted modeInk in frame
            if over:
                set result to the bim explorer click for (bim explorer mode action) on modeCursor
        return result

# The explorer at the top of the properties' panel, from `top` down to
# `bottom` at `panelLeft`: its head (the name, Tree and Graph) and, as a tree,
# `rowList` scrolled up by `scrollOffset`, the row selecting `selectedId`
# marked. What a click there hits (the whole panel part is chrome).
function draw bim model explorer {a pointer to a list:rowList} scrolled {a 64 bit floating-point number:scrollOffset} marking {a 64 bit integer:selectedId} graph {boolean:graphShown} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} from {a 64 bit floating-point number:panelLeft} below {a 64 bit floating-point number:top} down to {a 64 bit floating-point number:bottom} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set hit to no bim ui hit
        set scheme to the bim ui palette
        set panelWidth to bim ui properties width
        draw bim ui rectangle panelLeft top panelWidth (bottom - top) painted scheme's panel in frame
        draw bim ui rectangle panelLeft top 1.0 (bottom - top) painted scheme's border in frame
        draw bim ui rectangle (panelLeft + 1.0) (bottom - 1.0) (panelWidth - 1.0) 1.0 painted scheme's border in frame
        if ((pointerX >= panelLeft) and (pointerX < (panelLeft + panelWidth))) and ((pointerY >= top) and (pointerY < bottom)):
            set hit's inChrome to true
        draw bim ui rectangle (panelLeft + 1.0) (top + 23.0) (panelWidth - 1.0) 1.0 painted scheme's border in frame
        draw bim ui caps (the string form of "Model explorer") at (panelLeft + 10.0) and (top + 16.0) with atlas painted scheme's inkSecondary in frame
        set hit to draw bim explorer modes right of ((panelLeft + panelWidth) - 6.0) at top graph graphShown pointing at pointerX and pointerY keeping hit using atlas in frame
        if graphShown:
            draw bim ui text (the string form of "The graph fills the workspace.") at (panelLeft + 12.0) and (top + 44.0) in face (bim text small) with atlas painted scheme's inkSecondary in frame
            return hit
        set rowTop to top + 24.0
        set rowHeight to the bim explorer row height
        set markedRow to the bim explorer row of element selectedId among rowList
        loop rowCursor from 0 to the length of rowList:
            set y to (rowTop + ((rowCursor as a 64 bit floating-point number) * rowHeight)) - scrollOffset
            if (y >= (rowTop - rowHeight)) and (y < bottom):
                set entry to the item at rowCursor in rowList
                set over to ((pointerX >= panelLeft) and (pointerX < (panelLeft + panelWidth))) and (((pointerY >= y) and (pointerY < (y + rowHeight))) and (pointerY >= rowTop))
                if (rowCursor = markedRow) and (y >= rowTop):
                    draw bim ui rectangle (panelLeft + 1.0) y (panelWidth - 1.0) rowHeight painted scheme's selected in frame
                    draw bim ui rectangle (panelLeft + 1.0) y 3.0 rowHeight painted scheme's selectedBar in frame
                else if over:
                    draw bim ui rectangle (panelLeft + 1.0) y (panelWidth - 1.0) rowHeight painted scheme's hover in frame
                if y >= rowTop:
                    set indent to (panelLeft + 8.0) + ((entry's depth as a 64 bit floating-point number) * 12.0)
                    if entry's branch:
                        draw bim ui chevron at (indent + 4.0) and (y + 11.0) open entry's opened painted scheme's inkSecondary in frame
                    set detailWidth to 0.0
                    if (the length of entry's detail) > 0:
                        set detailWidth to the bim text width of entry's detail in face (bim text mono label) of atlas
                        draw bim ui text entry's detail at (((panelLeft + panelWidth) - 8.0) - detailWidth) and (y + 15.0) in face (bim text mono label) with atlas painted scheme's inkSecondary in frame
                    set labelInk to scheme's ink
                    if (entry's pickKind < 0) and (entry's branch = false):
                        set labelInk to scheme's inkSecondary
                    set room to ((((panelLeft + panelWidth) - 8.0) - detailWidth) - 8.0) - (indent + 14.0)
                    draw bim ui text (the bim fitted form of entry's label in room pixels of face (bim text small) with atlas) at (indent + 14.0) and (y + 15.0) in face (bim text small) with atlas painted labelInk in frame
                    if over and ((entry's branch) or (entry's pickKind >= 0)):
                        set hit to the bim explorer click for (bim explorer row action) on rowCursor
        return hit

# ---------------------------------------------------------------- graph

# Where each row stands in the graph, before scrolling: x by its depth, y
# so that each row with rows under it stands midway between its first and
# its last, and the others one slot below the one before.
class:
    patterns:
        [a|] bim explorer graph layout record
    members:
        xs as the type of (a cad topology list of a 64 bit floating-point number)
        ys as the type of (a cad topology list of a 64 bit floating-point number)
        tall as a 64 bit floating-point number

function the bim explorer graph column width:
    replacement:
        210.0

function the bim explorer graph slot:
    replacement:
        30.0

function the bim explorer graph layout of {a pointer to a list:rowList}:
    execute:
        set rowCount to the length of rowList
        set xs to a cad topology list of a 64 bit floating-point number
        set ys to a cad topology list of a 64 bit floating-point number
        set hasRows to an empty list of a boolean
        set lowestY to an empty list of a 64 bit floating-point number
        set highestY to an empty list of a 64 bit floating-point number
        loop rowCursor from 0 to rowCount:
            append false to hasRows
            append 1000000000.0 to lowestY
            append -1000000000.0 to highestY
            append (((the item at rowCursor in rowList)'s depth as a 64 bit floating-point number) * (the bim explorer graph column width)) to (xs's values)
            append 0.0 to (ys's values)
        loop rowCursor from 0 to rowCount:
            set parentIndex to (the item at rowCursor in rowList)'s parentRow
            if parentIndex >= 0:
                replace item at index parentIndex in hasRows with true
        set slotCount to 0
        loop rowCursor from 0 to rowCount:
            if (the item at rowCursor in hasRows) = false:
                replace item at index rowCursor in (ys's values) with ((slotCount as a 64 bit floating-point number) * (the bim explorer graph slot))
                set slotCount to slotCount + 1
        loop reverseCursor from 0 to rowCount:
            set rowIndex to (rowCount - 1) - reverseCursor
            if (the item at rowIndex in hasRows):
                replace item at index rowIndex in (ys's values) with (((the item at rowIndex in lowestY) + (the item at rowIndex in highestY)) * 0.5)
            set parentIndex to (the item at rowIndex in rowList)'s parentRow
            if parentIndex >= 0:
                set placedY to the item at rowIndex in (ys's values)
                replace item at index parentIndex in lowestY with (the minimum of placedY and (the item at parentIndex in lowestY))
                replace item at index parentIndex in highestY with (the maximum of placedY and (the item at parentIndex in highestY))
        free hasRows
        free lowestY
        free highestY
        return @intrinsic("construct", a bim explorer graph layout record, xs, ys, (slotCount as a 64 bit floating-point number) * (the bim explorer graph slot))

# The index of the row whose key is `wantedKey`, or -1.
local function the bim explorer row keyed {a string:wantedKey} among {a pointer to a list:rowList}:
    execute:
        if (the length of wantedKey) = 0:
            return -1
        loop rowCursor from 0 to the length of rowList:
            if (the item at rowCursor in rowList)'s rowKey = wantedKey:
                return rowCursor
        return -1

# The graph of `rowList` over the workspace, from `left`, `top` across
# `areaWidth` by `areaHeight`, scrolled up by `scrollOffset`: a node per row, a line
# from each to the rows under it, and for the node under the pointer or
# selected (`selectedId`) a line to what it relates to (its type, its host),
# in the accent colour. What a click hits (the whole area is chrome).
function draw bim model graph of {a pointer to a list:rowList} scrolled {a 64 bit floating-point number:scrollOffset} marking {a 64 bit integer:selectedId} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} from {a 64 bit floating-point number:areaLeft} and {a 64 bit floating-point number:areaTop} across {a 64 bit floating-point number:areaWidth} by {a 64 bit floating-point number:areaHeight} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set hit to no bim ui hit
        set scheme to the bim ui palette
        draw bim ui rectangle areaLeft areaTop areaWidth areaHeight painted scheme's workspace in frame
        if ((pointerX >= areaLeft) and (pointerX < (areaLeft + areaWidth))) and ((pointerY >= areaTop) and (pointerY < (areaTop + areaHeight))):
            set hit's inChrome to true
        set placement to the bim explorer graph layout of rowList
        set nodeWidth to 172.0
        set nodeHeight to 22.0
        set originX to areaLeft + 24.0
        set originY to (areaTop + 40.0) - scrollOffset
        if placement's tall < (areaHeight - 60.0):
            set originY to areaTop + ((areaHeight - placement's tall) * 0.5)
        draw bim ui caps (the string form of "Model graph") at (areaLeft + 16.0) and (areaTop + 22.0) with atlas painted scheme's inkSecondary in frame
        set markedRow to the bim explorer row of element selectedId among rowList
        set overRow to -1
        loop rowCursor from 0 to the length of rowList:
            set nodeX to originX + (the item at rowCursor in (placement's xs's values))
            set nodeY to originY + (the item at rowCursor in (placement's ys's values))
            if ((pointerX >= nodeX) and (pointerX < (nodeX + nodeWidth))) and ((pointerY >= nodeY) and (pointerY < (nodeY + nodeHeight))):
                set overRow to rowCursor
        # The lines from each node to the nodes under it.
        set lineInk to scheme's border
        loop rowCursor from 0 to the length of rowList:
            set parentIndex to (the item at rowCursor in rowList)'s parentRow
            if parentIndex >= 0:
                set fromX to (originX + (the item at parentIndex in (placement's xs's values))) + nodeWidth
                set fromY to (originY + (the item at parentIndex in (placement's ys's values))) + (nodeHeight * 0.5)
                set toX to originX + (the item at rowCursor in (placement's xs's values))
                set toY to (originY + (the item at rowCursor in (placement's ys's values))) + (nodeHeight * 0.5)
                set middleX to (fromX + toX) * 0.5
                if ((the maximum of fromY and toY) >= areaTop) and ((the minimum of fromY and toY) < (areaTop + areaHeight)):
                    draw bim ui line from fromX fromY to middleX fromY wide 1.0 coloured lineInk's red, lineInk's green and lineInk's blue in frame
                    draw bim ui line from middleX fromY to middleX toY wide 1.0 coloured lineInk's red, lineInk's green and lineInk's blue in frame
                    draw bim ui line from middleX toY to toX toY wide 1.0 coloured lineInk's red, lineInk's green and lineInk's blue in frame
        # The relations of the node under the pointer, or else the selected.
        set focusRow to overRow
        if focusRow < 0:
            set focusRow to markedRow
        if focusRow >= 0:
            set relatedRow to the bim explorer row keyed ((the item at focusRow in rowList)'s relatedKey) among rowList
            if relatedRow >= 0:
                set accentInk to scheme's accent
                set fromX to (originX + (the item at focusRow in (placement's xs's values))) + (nodeWidth * 0.5)
                set fromY to originY + (the item at focusRow in (placement's ys's values))
                set toX to (originX + (the item at relatedRow in (placement's xs's values))) + (nodeWidth * 0.5)
                set toY to (originY + (the item at relatedRow in (placement's ys's values))) + nodeHeight
                draw bim ui line from fromX fromY to toX toY wide 2.0 coloured accentInk's red, accentInk's green and accentInk's blue in frame
        # The nodes.
        loop rowCursor from 0 to the length of rowList:
            set nodeX to originX + (the item at rowCursor in (placement's xs's values))
            set nodeY to originY + (the item at rowCursor in (placement's ys's values))
            if ((nodeY + nodeHeight) >= areaTop) and (nodeY < (areaTop + areaHeight)):
                set entry to the item at rowCursor in rowList
                set fill to scheme's raised
                set edge to scheme's border
                if rowCursor = markedRow:
                    set fill to scheme's selected
                    set edge to scheme's selectedBar
                else if rowCursor = overRow:
                    set fill to scheme's hover
                    set edge to scheme's accent
                draw bim ui box nodeX nodeY nodeWidth nodeHeight radius 6.0 painted fill edged edge wide 1.0 in frame
                set labelInk to scheme's ink
                if (entry's pickKind < 0) and (entry's branch = false):
                    set labelInk to scheme's inkSecondary
                set detailWidth to 0.0
                if (the length of entry's detail) > 0:
                    set detailWidth to the bim text width of entry's detail in face (bim text mono label) of atlas
                    draw bim ui text entry's detail at (((nodeX + nodeWidth) - 8.0) - detailWidth) and (nodeY + 15.0) in face (bim text mono label) with atlas painted scheme's inkSecondary in frame
                set textLeft to nodeX + 8.0
                if entry's branch:
                    draw bim ui chevron at (nodeX + 10.0) and (nodeY + 11.0) open entry's opened painted scheme's inkSecondary in frame
                    set textLeft to nodeX + 18.0
                set room to (((nodeX + nodeWidth) - 8.0) - detailWidth) - (textLeft + 6.0)
                draw bim ui text (the bim fitted form of entry's label in room pixels of face (bim text small) with atlas) at textLeft and (nodeY + 15.0) in face (bim text small) with atlas painted labelInk in frame
        if overRow >= 0:
            set overEntry to the item at overRow in rowList
            if (overEntry's branch) or (overEntry's pickKind >= 0):
                set hit to the bim explorer click for (bim explorer row action) on overRow
        return hit
