# SPDX-License-Identifier: MPL-2.0
# The plan panel of the editor: the screen layout, strokes and fills, grids,
# the visibility panel and everything the plan draws (split from `main.dl`).
import ui/editor/bim_editor.dl
import viewer/vulkan/graphics.dl
import exchange/ifcx/bim_ifcx_read.dl
import views/drawings/bim_text.dl
import materials/bim_hatch.dl
import exchange/import/bim_import.dl
import viewer/bim_canvas.dl
import views/schedules/bim_schedule.dl
import structural/rebar/bim_bending_schedule.dl
import ui/panels/bim_ui.dl
import views/export/bim_pdf.dl
import views/export/bim_svg.dl
import views/drawings/bim_drawing_standard.dl
import structural/rebar/bim_reinforcement_drawing.dl
import exchange/import/bim_vector_reference.dl
import views/common/bim_crop.dl
import views/drawings/bim_plan_presentation.dl
import architectural/openings/bim_window_actions.dl
import kernel/planar/triangulate2.dl


class:
    patterns:
        [a|] bim screen layout record
    members:
        width as a 64 bit floating-point number
        height as a 64 bit floating-point number
        planLeft as a 64 bit floating-point number
        planRight as a 64 bit floating-point number
        top as a 64 bit floating-point number
        bottom as a 64 bit floating-point number

class:
    patterns:
        [a|] bim camera record
    members:
        centre as a cad vector2
        scale as a 64 bit floating-point number
        yaw as a 64 bit floating-point number
        pitch as a 64 bit floating-point number
        target as a cad vector3
        viewScale as a 64 bit floating-point number

# The panels of the window's framebuffer, inside the application chrome
# (`bim_ui.dl`): the project explorer on the left, then the plan, then the 3D
# view or the section, then the properties panel (its width is not part of
# the layout's).
# The window's layout, canvas first: the rail on the left edge, the browser
# beside it only while `browsing`, the properties panel on the right edge
# only while `propertiesShown`, the ribbon above unless `ribbonFolded`; the
# canvas takes the rest.
function the bim screen layout of {pointer:window} browsing {boolean:browsing} folded {boolean:ribbonFolded} with properties {boolean:propertiesShown}:
    execute:
        set horizontal to 0
        set vertical to 0
        set horizontal to the framebuffer width of window
        set vertical to the framebuffer height of window
        set width to horizontal as a 64 bit floating-point number
        set height to vertical as a 64 bit floating-point number
        if propertiesShown:
            set width to width - (bim ui properties width)
        set planLeft to bim ui rail width
        if browsing:
            set planLeft to planLeft + (bim ui explorer width)
        set planRight to planLeft + ((width - planLeft) * 0.55)
        return @intrinsic("construct", a bim screen layout record, width, height, planLeft, planRight, the bim ui canvas top folded ribbonFolded, the bim ui canvas bottom in height)

function the bim plan transform of {bim screen layout record:layout} with {bim camera record:camera}:
    execute:
        set middle to a cad vector2 with x ((layout's planLeft + layout's planRight) * 0.5) and y ((layout's top + layout's bottom) * 0.5)
        return @intrinsic("construct", a bim drawing transform record, middle, camera's centre, camera's scale)

function the bim plan pixel of {cad vector2:location} in {bim screen layout record:layout} with {bim camera record:camera}:
    execute:
        return the bim pixel of location through (the bim plan transform of layout with camera)

function the bim model point of {cad vector2:pixel} in {bim screen layout record:layout} with {bim camera record:camera}:
    execute:
        set middleX to (layout's planLeft + layout's planRight) * 0.5
        set middleY to (layout's top + layout's bottom) * 0.5
        return a cad vector2 with x (camera's centre's x + ((pixel's x - middleX) / camera's scale)) and y (camera's centre's y - ((pixel's y - middleY) / camera's scale))

# ---------------------------------------------------------------- strokes and fills

function add bim stroke from {cad vector2:first} to {cad vector2:second} wide {a 64 bit floating-point number:breadth} in {graphics frame:frame}:
    execute:
        set quad to an empty list of a cad vector2
        append bim stroke quad from first to second wide breadth into quad
        loop cursor from 0 to the length of quad:
            add a vertex at x (the item at cursor in quad)'s x and y (the item at cursor in quad)'s y to frame
        free quad

function draw bim label {a string:message} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} using {bim text atlas record:typeface} in {graphics frame:frame}:
    execute:
        draw bim text message at x and y with typeface coloured 35, 48 and 70 in frame

# Draws text right-aligned to `right`, for numbers in a table column.
function draw bim label {a string:message} ending at {a 64 bit floating-point number:right} and {a 64 bit floating-point number:y} using {bim text atlas record:typeface} in {graphics frame:frame}:
    execute:
        set offset to the bim text width of message in typeface
        draw bim text message at (right - offset) and y with typeface coloured 35, 48 and 70 in frame

# The quantity schedule in the right panel: a table of `rows` with a header,
# the group named once above its rows, and the quantities right-aligned.
function draw bim schedule {a pointer to a list:rows} in {bim screen layout record:layout} using {bim text atlas record:typeface} in {graphics frame:frame}:
    execute:
        set left to layout's planRight + 16.0
        set y to layout's top + 20.0
        draw bim label (the string form of "Schedule  (T: 3D, E: export CSV)") at left and y using typeface in frame
        set y to y + 34.0
        # Columns share the panel's width.
        set span to (layout's width - left) - 16.0
        set typeColumn to left + (span * 0.17)
        set countRight to left + (span * 0.58)
        set lengthRight to left + (span * 0.72)
        set areaRight to left + (span * 0.86)
        set volumeRight to left + span
        draw bim label (the string form of "Element") at left and y using typeface in frame
        draw bim label (the string form of "Type") at typeColumn and y using typeface in frame
        draw bim label (the string form of "Count") ending at countRight and y using typeface in frame
        draw bim label (the string form of "m") ending at lengthRight and y using typeface in frame
        draw bim label (the string form of "m2") ending at areaRight and y using typeface in frame
        draw bim label (the string form of "m3") ending at volumeRight and y using typeface in frame
        draw a rectangle at x left and y (y + 8.0) with width (volumeRight - left) and height 2 in color red 60, green 70 and blue 90 in frame
        set y to y + 30.0
        set previousGroup to the string form of ""
        loop cursor from 0 to the length of rows:
            set row to the item at cursor in rows
            if row's group != previousGroup:
                if cursor > 0:
                    draw a rectangle at x left and y (y - 18.0) with width (volumeRight - left) and height 1 in color red 200, green 205 and blue 215 in frame
                draw bim label row's group at left and y using typeface in frame
                set previousGroup to row's group
            draw bim label row's name at typeColumn and y using typeface in frame
            draw bim label (the string form of row's count) ending at countRight and y using typeface in frame
            draw bim label (the bim schedule text of row's length) ending at lengthRight and y using typeface in frame
            draw bim label (the bim schedule text of row's area) ending at areaRight and y using typeface in frame
            draw bim label (the bim schedule text of row's volume) ending at volumeRight and y using typeface in frame
            set y to y + 24.0

# Regions are filled through the kernel's triangulation, so concave regions
# and regions with holes are filled correctly. Triangles collect as pixels
# first; an empty batch is never started.
function append bim fill of {a pointer to a list:boundaries} through {bim drawing transform record:transform} to {a pointer to a list:pixels}:
    execute:
        set mesh to the cad triangulation of rings boundaries
        loop cursor from 0 to the length of (the triangles of mesh):
            set face to the item at cursor in (the triangles of mesh)
            append (the bim pixel of (the item at (the first of face) in (the points of mesh)) through transform) to pixels
            append (the bim pixel of (the item at (the second of face) in (the points of mesh)) through transform) to pixels
            append (the bim pixel of (the item at (the third of face) in (the points of mesh)) through transform) to pixels
        free cad triangulation mesh

# Fills one ring: cleaned, a convex ring as a fan from its first corner (it
# cannot fail), any other through the kernel's triangulation.
function append bim fill of ring {a pointer to a list:ring} through {bim drawing transform record:transform} to {a pointer to a list:pixels}:
    execute:
        set cleaned to the bim cleaned ring of ring
        set corners to cleaned's values
        set count to the length of corners
        if count < 3:
            return nothing
        set turnsLeft to 0
        set turnsRight to 0
        loop cursor from 0 to count:
            set here to the item at cursor in corners
            set after to the item at (the remainder of (cursor + 1) divided by count) in corners
            set beyond to the item at (the remainder of (cursor + 2) divided by count) in corners
            set turning to ((after's x - here's x) * (beyond's y - after's y)) - ((after's y - here's y) * (beyond's x - after's x))
            if turning > 0.0:
                set turnsLeft to turnsLeft + 1
            if turning < 0.0:
                set turnsRight to turnsRight + 1
        if (turnsLeft = 0) or (turnsRight = 0):
            set first to the bim pixel of (the item at 0 in corners) through transform
            loop cursor from 1 to (count - 1):
                append first to pixels
                append (the bim pixel of (the item at cursor in corners) through transform) to pixels
                append (the bim pixel of (the item at (cursor + 1) in corners) through transform) to pixels
            return nothing
        set plainRing to an empty list of a cad vector2
        loop cursor from 0 to count:
            append (the item at cursor in corners) to plainRing
        set rings to an empty list of the type of (an empty list of a cad vector2)
        append plainRing to rings
        append bim fill of rings through transform to pixels
        free rings
        free plainRing

function draw bim triangles {a pointer to a list:pixels} coloured {integer:red}, {integer:green} and {integer:blue} in {graphics frame:frame}:
    execute:
        if (the length of pixels) = 0:
            return nothing
        start triangles in frame
        use vertex color red red, green green and blue blue in frame
        loop cursor from 0 to the length of pixels:
            add a vertex at x (the item at cursor in pixels)'s x and y (the item at cursor in pixels)'s y to frame
        finish triangles in frame

# The layer bands of the element cut by `source`: a wall's layers in plan, or
# where the section crosses them; one band of its material for a slab; one plain
# band for anything else.
function the bim hatch bands of {bim cut source record:source} for {bim editor record:editor} as section {boolean:asSection}:
    execute:
        set modelValue to editor's documentValue's current
        set wallFound to the bim wall index of source's id in modelValue
        if wallFound's valid:
            set wallValue to the item at wallFound's position in (modelValue's walls's values)
            if asSection:
                set layered to the bim section hatch bands of wallValue in modelValue from editor's sectionFirst to editor's sectionSecond
            else:
                set layered to the bim plan hatch bands of wallValue in modelValue
            if (the length of (layered's values)) > 0:
                return layered
        set single to a cad topology list of a bim hatch band record
        set slabFound to the bim slab index of source's id in modelValue
        if slabFound's valid:
            append (the bim whole hatch band of (the bim material of plate (the item at slabFound's position in (modelValue's slabs's values)) in modelValue)) to (single's values)
        else:
            append (the bim whole hatch band of (the string form of "")) to (single's values)
        return single

# Fills and hatches one band's part of a cut, `piece` in drawing coordinates.
# In black and white (`plain`), the fill is white and the lines black.
function draw bim hatch of {a pointer to a list:piece} in {bim hatch band record:band} through {bim drawing transform record:transform} faint {boolean:isFaint} plain {boolean:isPlain} on {a pointer to a bim canvas record:canvas}:
    execute:
        draw bim hatch of piece in band through transform faint isFaint plain isPlain along false under (bim nen standard) on canvas

# The same, its lines turned with the element (`alongObject`: parallel to a
# wall's layers) rather than fixed in the world.
function draw bim hatch of {a pointer to a list:piece} in {bim hatch band record:band} through {bim drawing transform record:transform} faint {boolean:isFaint} plain {boolean:isPlain} along {boolean:alongObject} under {integer:standardCode} on {a pointer to a bim canvas record:canvas}:
    execute:
        set pattern to the bim hatch pattern of material band's material under standardCode
        if alongObject and (((band's normal's x * band's normal's x) + (band's normal's y * band's normal's y)) > 1e-12):
            # The band's normal is square to the layers; the layers run a
            # quarter turn from it.
            set pattern's angle to pattern's angle + ((@intrinsic("atan2", band's normal's y, band's normal's x) * (180.0 / 3.141592653589793)) - 90.0)
        if isPlain:
            set pattern's fillRed to 255
            set pattern's fillGreen to 255
            set pattern's fillBlue to 255
            set pattern's lineRed to 0
            set pattern's lineGreen to 0
            set pattern's lineBlue to 0
        set fills to an empty list of a cad vector2
        append bim fill of ring piece through transform to fills
        record bim triangles fills coloured (the bim halftone of channel pattern's fillRed when isFaint), (the bim halftone of channel pattern's fillGreen when isFaint) and (the bim halftone of channel pattern's fillBlue when isFaint) on canvas
        free fills
        set corners to an empty list of a cad vector2
        loop cursor from 0 to the length of piece:
            append (the bim pixel of (the item at cursor in piece) through transform) to corners
        set segments to an empty list of a cad vector2
        set anchor to the bim pixel of (a cad vector2 with x 0.0 and y 0.0) through transform
        set bounded to (band's low > (0.0 - (1.0 / 0.0))) and (band's high < (1.0 / 0.0))
        if pattern's zigzag and bounded:
            set middle to the item at 0 in piece
            set reach to (middle's x * band's normal's x) + (middle's y * band's normal's y)
            set nearPoint to a cad vector2 with x (middle's x + (band's normal's x * (band's low - reach))) and y (middle's y + (band's normal's y * (band's low - reach)))
            set farPoint to a cad vector2 with x (middle's x + (band's normal's x * (band's high - reach))) and y (middle's y + (band's normal's y * (band's high - reach)))
            set bandDirection to a cad vector2 with x (0.0 - band's normal's y) and y (0.0 - band's normal's x)
            append bim zigzag of corners across (the bim pixel of nearPoint through transform) to (the bim pixel of farPoint through transform) along bandDirection into segments
        else:
            # The spacing is on the model, so the hatch scales with the
            # drawing; too dense to read, only the background is shown.
            set spacing to pattern's spacing * transform's scale
            if spacing >= 2.5:
                append bim hatch lines of corners at pattern's angle every spacing from anchor into segments
                if pattern's crossed:
                    append bim hatch lines of corners at (pattern's angle + 90.0) every spacing from anchor into segments
        record bim strokes segments coloured (the bim halftone of channel pattern's lineRed when isFaint), (the bim halftone of channel pattern's lineGreen when isFaint) and (the bim halftone of channel pattern's lineBlue when isFaint) wide 0.5 on canvas
        free segments
        free corners

# Cut faces as a drawing shows them, following `viewRules`: each visible
# element's cut divided into its layers, filled and hatched by material, and
# outlined; halftone categories drawn faint.
function draw bim hatched cut faces of {bim view record:viewValue} for {bim editor record:editor} through {bim drawing transform record:transform} as section {boolean:asSection} following {bim view rules record:viewRules} on {a pointer to a bim canvas record:canvas}:
    execute:
        set modelValue to editor's documentValue's current
        set outlines to an empty list of a cad vector2
        set faintOutlines to an empty list of a cad vector2
        # The view's display: colour fills and hatches, hidden line hatches
        # in black on white, a wireframe only outlines.
        set shownViewId to editor's planViewId
        if asSection:
            set shownViewId to editor's sectionViewId
        set shownDisplay to the bim display of view shownViewId in modelValue
        set hatchAlong to bim view shownViewId hatches along objects in modelValue
        set drawingStandard to the bim drawing standard of modelValue
        # Where walls meet, their cut faces share an edge (a mitre or a butt
        # joint): it is left out, so that joined walls read as one.
        set wallEdges to an empty list of a cad vector2
        set wallEdgeOwners to an empty list of an integer
        loop sourceCursor from 0 to the length of (viewValue's sources's values):
            set source to the item at sourceCursor in (viewValue's sources's values)
            if (the bim category of element source's id in modelValue) = bim wall category:
                loop polygonCursor from 0 to the length of (source's polygons's values):
                    set ring to (the item at polygonCursor in (source's polygons's values))'s points's values
                    set count to the length of ring
                    loop corner from 0 to count:
                        append (the item at corner in ring) to wallEdges
                        append (the item at (the remainder of (corner + 1) divided by count) in ring) to wallEdges
                        append sourceCursor to wallEdgeOwners
        loop sourceCursor from 0 to the length of (viewValue's sources's values):
            set source to the item at sourceCursor in (viewValue's sources's values)
            set elementCategory to the bim category of element source's id in modelValue
            set shown to true
            set isFaint to false
            if elementCategory >= 0:
                set shown to bim category elementCategory is visible in viewRules
                set isFaint to bim category elementCategory is halftone in viewRules
            # Its phase: hidden, or existing and demolished work in halftone.
            set phaseLook to the bim phase look of element source's id in plan of editor
            if asSection:
                set phaseLook to the bim phase look of element source's id in section of editor
            if phaseLook = bim phase hidden look:
                set shown to false
            if phaseLook >= bim phase faint look:
                set isFaint to true
            if shown:
                set bands to the bim hatch bands of source for editor as section asSection
                loop polygonCursor from 0 to the length of (source's polygons's values):
                    set ring to (the item at polygonCursor in (source's polygons's values))'s points's values
                    loop bandCursor from 0 to the length of (bands's values):
                        set band to the item at bandCursor in (bands's values)
                        set piece to the bim ring ring within band
                        if (((the length of piece) >= 3) and (phaseLook != bim phase demolished look)) and (shownDisplay != bim wireframe display):
                            draw bim hatch of piece in band through transform faint isFaint plain (shownDisplay = bim hidden line display) along hatchAlong under drawingStandard on canvas
                        free piece
                    set count to the length of ring
                    loop corner from 0 to count:
                        set edgeStart to the bim pixel of (the item at corner in ring) through transform
                        set edgeEnd to the bim pixel of (the item at (the remainder of (corner + 1) divided by count) in ring) through transform
                        set joined to false
                        if elementCategory = bim wall category:
                            set joined to bim edge from (the item at corner in ring) to (the item at (the remainder of (corner + 1) divided by count) in ring) is shared in wallEdges by wallEdgeOwners apart from sourceCursor
                        if joined:
                            # A joint between walls: no line there.
                            set joined to true
                        else if phaseLook = bim phase demolished look:
                            # Demolished work: dashed, unhatched.
                            set total to the cad distance from edgeStart to edgeEnd
                            set position to 0.0
                            loop while (total > 0.0) and (position < total):
                                set ending to the minimum of (position + 6.0) and total
                                append (a cad vector2 with x (edgeStart's x + (((edgeEnd's x - edgeStart's x) * position) / total)) and y (edgeStart's y + (((edgeEnd's y - edgeStart's y) * position) / total))) to faintOutlines
                                append (a cad vector2 with x (edgeStart's x + (((edgeEnd's x - edgeStart's x) * ending) / total)) and y (edgeStart's y + (((edgeEnd's y - edgeStart's y) * ending) / total))) to faintOutlines
                                set position to ending + 4.0
                        else if isFaint:
                            append edgeStart to faintOutlines
                            append edgeEnd to faintOutlines
                        else:
                            append edgeStart to outlines
                            append edgeEnd to outlines
        record bim strokes outlines coloured 0, 0 and 0 wide (the bim cut line width under drawingStandard) on canvas
        record bim strokes faintOutlines coloured 150, 150 and 150 wide 1.0 on canvas
        free outlines
        free faintOutlines
        free wallEdges
        free wallEdgeOwners

# Whether the edge from `first` to `second` is also an edge (either way
# round, within 0.1 mm) of a source other than `owner` among `edgeList`
# (edge ends in pairs, `ownerList` naming each edge's source).
function bim edge from {cad vector2:first} to {cad vector2:second} is shared in {a pointer to a list:edgeList} by {a pointer to a list:ownerList} apart from {integer:owner}:
    execute:
        loop edgeCursor from 0 to the length of ownerList:
            if (the item at edgeCursor in ownerList) != owner:
                set otherStart to the item at (edgeCursor * 2) in edgeList
                set otherEnd to the item at ((edgeCursor * 2) + 1) in edgeList
                if ((the cad distance from first to otherEnd) < 0.0001) and ((the cad distance from second to otherStart) < 0.0001):
                    return true
                if ((the cad distance from first to otherStart) < 0.0001) and ((the cad distance from second to otherEnd) < 0.0001):
                    return true
        return false

# The scene meshes of the elements whose category `viewRules` shows.
# What the recorded plan depends on, as text: the document revision, the
# plan's evaluation generation (it advances during a drag too), the storey,
# the zoom and the plan's view rules. Selection, hover and the gesture are
# drawn live and are not part of it.
function the bim plan key of {bim editor record:editor} at {a 64 bit floating-point number:scale}:
    execute:
        set written to (the string form of editor's documentValue's revision) + (the string form of " ")
        set written to (written + (the string form of editor's planViewId)) + (the string form of " ")
        set written to (written + (the string form of editor's plan's generation)) + (the string form of " ")
        set written to (written + (the string form of editor's levelId)) + (the string form of " ")
        set written to (written + (the bim exact text of scale)) + (the string form of " ")
        loop code from 0 to the bim category count:
            set rule to the item at code in (editor's planRules's rules's values)
            if rule's visible:
                set written to written + (the string form of "v")
            else:
                set written to written + (the string form of "-")
            if rule's halftone:
                set written to written + (the string form of "h")
        return written

# The visibility and halftone of every category in `viewRules`, as text.
function the bim rule text of {bim view rules record:viewRules}:
    execute:
        set written to the string form of " "
        loop code from 0 to the bim category count:
            set entry to the item at code in (viewRules's rules's values)
            if entry's visible:
                set written to written + (the string form of "v")
            else:
                set written to written + (the string form of "-")
            if entry's halftone:
                set written to written + (the string form of "h")
        return written

# What the recorded 3D view depends on, as text: the camera's orbit, the
# panel's size, the scene meshes' revision and count, the selection and the
# 3D view's rules.
function the bim view key of {bim editor record:editor} with {bim camera record:camera} in {bim screen layout record:layout} at {a 64 bit integer:meshRevision} showing {integer:meshCount}:
    execute:
        set written to (the string form of meshRevision) + (the string form of " ")
        set written to (written + (the string form of meshCount)) + (the string form of " ")
        set written to (written + (the bim exact text of camera's yaw)) + (the string form of " ")
        set written to (written + (the bim exact text of camera's pitch)) + (the string form of " ")
        set written to (written + (the bim exact text of camera's viewScale)) + (the string form of " ")
        set written to (written + (the bim exact text of camera's target's x)) + (the string form of " ")
        set written to (written + (the bim exact text of camera's target's y)) + (the string form of " ")
        set written to (written + (the bim exact text of camera's target's z)) + (the string form of " ")
        set written to (written + (the bim exact text of layout's width)) + (the string form of " ")
        set written to (written + (the bim exact text of layout's height)) + (the string form of " ")
        # The panel's edges: tiled or not, and where the dividers are.
        set written to (written + (the bim exact text of layout's planRight)) + (the string form of " ")
        set written to (written + (the bim exact text of layout's top)) + (the string form of " ")
        set written to (written + (the bim exact text of layout's bottom)) + (the string form of " ")
        set written to (written + (the string form of editor's selectionKind)) + (the string form of " ")
        set written to (written + (the string form of editor's selectionId)) + (the string form of " ")
        loop code from 0 to the bim category count:
            set rule to the item at code in (editor's modelRules's rules's values)
            if rule's visible:
                set written to written + (the string form of "v")
            else:
                set written to written + (the string form of "-")
            if rule's halftone:
                set written to written + (the string form of "h")
        return written

# The scene meshes of `sceneMeshes` the 3D view's phase shows.
function the bim meshes of {a pointer to a list:sceneMeshes} kept by phase of {bim editor record:editor}:
    execute:
        set phased to a cad topology list of a bim scene mesh record
        loop cursor from 0 to the length of sceneMeshes:
            set entry to the item at cursor in sceneMeshes
            if (the bim phase look of element entry's elementId in model view of editor) != bim phase hidden look:
                append entry to (phased's values)
        return phased

# The scene meshes of `meshes` and of the imported `extras` whose category
# `viewRules` shows.
function the bim meshes of {a pointer to a list:meshes} and {a pointer to a list:extras} shown by {bim view rules record:viewRules}:
    execute:
        set visibleMeshes to a cad topology list of a bim scene mesh record
        loop cursor from 0 to the length of meshes:
            set entry to the item at cursor in meshes
            set code to entry's category
            set admitted to true
            if code >= 0:
                set admitted to bim category code is visible in viewRules
            if admitted:
                append entry to (visibleMeshes's values)
        loop cursor from 0 to the length of extras:
            set entry to the item at cursor in extras
            set code to entry's category
            if bim category code is visible in viewRules:
                append entry to (visibleMeshes's values)
        return visibleMeshes

# Appends, as pixel pairs, a door leaf hinged at `hinge` (drawing
# coordinates) standing open along `openDirection` (a unit vector into the
# room) for `reach` metres, and its quarter swing toward `shutDirection`, the
# wall's direction.
function append bim door leaf at {cad vector2:hinge} opening {cad vector2:openDirection} closing {cad vector2:shutDirection} reaching {a 64 bit floating-point number:reach} through {bim drawing transform record:transform} into {a pointer to a list:pairs}:
    execute:
        set tip to a cad vector2 with x (hinge's x + (reach * openDirection's x)) and y (hinge's y + (reach * openDirection's y))
        append (the bim pixel of hinge through transform) to pairs
        append (the bim pixel of tip through transform) to pairs
        set previous to tip
        loop step from 1 to 13:
            set angle to (1.5707963267948966 * (step as a 64 bit floating-point number)) / 12.0
            set swing to a cad vector2 with x (hinge's x + (reach * (((the cosine of angle) * openDirection's x) + ((the sine of angle) * shutDirection's x)))) and y (hinge's y + (reach * (((the cosine of angle) * openDirection's y) + ((the sine of angle) * shutDirection's y))))
            append (the bim pixel of previous through transform) to pairs
            append (the bim pixel of swing through transform) to pairs
            set previous to swing

# Appends, as pixel pairs, a window's three lines from `leftPoint` to
# `rightPoint` on the centreline: the exterior face, the glass and the
# interior face, `half` metres either side along `normal`.
function append bim window panes from {cad vector2:leftPoint} to {cad vector2:rightPoint} across {cad vector2:normal} by {a 64 bit floating-point number:half} through {bim drawing transform record:transform} into {a pointer to a list:pairs}:
    execute:
        loop line from 0 to 3:
            set offset to half
            if line = 1:
                set offset to half * 0.1
            if line = 2:
                set offset to 0.0 - half
            append (the bim pixel of (a cad vector2 with x (leftPoint's x + (offset * normal's x)) and y (leftPoint's y + (offset * normal's y))) through transform) to pairs
            append (the bim pixel of (a cad vector2 with x (rightPoint's x + (offset * normal's x)) and y (rightPoint's y + (offset * normal's y))) through transform) to pairs

# Door and window symbols in the plan, on the walls of the active storey: a
# door's leaf standing open into the room with its swing, a window's glass
# between the wall faces. Each follows its category's rule.
function draw bim openings in plan of {bim editor record:editor} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        set modelValue to editor's documentValue's current
        set leaves to an empty list of a cad vector2
        set faintLeaves to an empty list of a cad vector2
        set panes to an empty list of a cad vector2
        set faintPanes to an empty list of a cad vector2
        loop cursor from 0 to the length of (modelValue's openings's values):
            set openingValue to the item at cursor in (modelValue's openings's values)
            set hostFound to the bim wall index of openingValue's hostId in modelValue
            set typeFound to the bim opening type index of openingValue's typeId in modelValue
            set openingCategory to the bim category of element openingValue's id in modelValue
            set openingShown to (the bim phase look of element openingValue's id in plan of editor) != bim phase hidden look
            # An opening goes with its wall when that is hidden (HH).
            if bim editor hides (openingValue's hostId) in plan of editor:
                set openingShown to false
            if ((hostFound's valid and typeFound's valid) and (bim category openingCategory is visible in editor's planRules)) and openingShown:
                set host to the item at hostFound's position in (modelValue's walls's values)
                set openingType to the item at typeFound's position in (modelValue's openingTypes's values)
                if host's levelId = editor's levelId:
                    set half to (the bim wall thickness of host in modelValue) * 0.5
                    set halfWidth to (the bim rough width of openingType) * 0.5
                    set span to the bim span of host at openingValue's offset reaching halfWidth
                    set direction to span's direction
                    set normal to span's normal
                    set leftPoint to span's left
                    set rightPoint to span's right
                    set isFaint to bim category openingCategory is halftone in editor's planRules
                    if openingType's isDoor:
                        # Hinged at the left jamb on the interior face.
                        set hinge to a cad vector2 with x (leftPoint's x - (half * normal's x)) and y (leftPoint's y - (half * normal's y))
                        set inward to a cad vector2 with x (0.0 - normal's x) and y (0.0 - normal's y)
                        if isFaint:
                            append bim door leaf at hinge opening inward closing direction reaching (halfWidth * 2.0) through transform into faintLeaves
                        else:
                            append bim door leaf at hinge opening inward closing direction reaching (halfWidth * 2.0) through transform into leaves
                    else:
                        # A hosted frame is already drawn from its 3D parts.
                        # The three-line placeholder must not run over the
                        # frame/glass or fill the entire wall thickness.
                        set showPlaceholder to true
                        set hostedId to the bim window system in opening openingValue's id in modelValue
                        if hostedId != the bim refused id:
                            set hostedCategory to the bim category of element hostedId in modelValue
                            set hostedShown to (the bim phase look of element hostedId in plan of editor) != bim phase hidden look
                            set hostedShown to hostedShown and (bim category hostedCategory is visible in editor's planRules)
                            if bim editor hides hostedId in plan of editor:
                                set hostedShown to false
                            set showPlaceholder to hostedShown = false
                        if showPlaceholder:
                            if isFaint:
                                append bim window panes from leftPoint to rightPoint across normal by half through transform into faintPanes
                            else:
                                append bim window panes from leftPoint to rightPoint across normal by half through transform into panes
        record bim strokes leaves coloured 70, 74 and 90 wide 1.0 on canvas
        record bim strokes faintLeaves coloured 165, 168 and 178 wide 1.0 on canvas
        record bim strokes panes coloured 50, 110 and 190 wide 1.0 on canvas
        record bim strokes faintPanes coloured 160, 185 and 225 wide 1.0 on canvas
        free leaves
        free faintLeaves
        free panes
        free faintPanes

# ---------------------------------------------------------------- grids

# Grid bubbles are screen symbols; camera zoom changes their position only.
function bim grid screen head radius:
    replacement:
        11.0

# Appends, as pixel pairs, a dash-dot line from `first` to `second`: dashes
# of 14 pixels and dots of 2, with gaps of 4.
function append bim dash dot from {cad vector2:first} to {cad vector2:second} into {a pointer to a list:pairs}:
    execute:
        set total to the cad distance from first to second
        if total <= 0.0:
            return nothing
        set ux to (second's x - first's x) / total
        set uy to (second's y - first's y) / total
        set position to 0.0
        set onDash to true
        loop while position < total:
            set piece to 2.0
            if onDash:
                set piece to 14.0
            set ending to the minimum of (position + piece) and total
            append (a cad vector2 with x (first's x + (ux * position)) and y (first's y + (uy * position))) to pairs
            append (a cad vector2 with x (first's x + (ux * ending)) and y (first's y + (uy * ending))) to pairs
            set position to ending + 4.0
            set onDash to onDash = false

# Appends, as pixel pairs, the dash-dot of Open 2D Studio's grid lines from
# `first` to `second` at `scale` pixels per metre: dashes of 0.5 m and dots of
# 0.1 m with gaps of 0.15 m, as at 1:100, never shorter than 6, 1.5 and 3
# pixels.
function append bim scaled dash dot from {cad vector2:first} to {cad vector2:second} at {a 64 bit floating-point number:scale} into {a pointer to a list:pairs}:
    execute:
        set total to the cad distance from first to second
        if total <= 0.0:
            return nothing
        set dashLength to the maximum of 6.0 and (0.5 * scale)
        set dotLength to the maximum of 1.5 and (0.1 * scale)
        set gapLength to the maximum of 3.0 and (0.15 * scale)
        set ux to (second's x - first's x) / total
        set uy to (second's y - first's y) / total
        set position to 0.0
        set onDash to true
        loop while position < total:
            set piece to dotLength
            if onDash:
                set piece to dashLength
            set ending to the minimum of (position + piece) and total
            append (a cad vector2 with x (first's x + (ux * position)) and y (first's y + (uy * position))) to pairs
            append (a cad vector2 with x (first's x + (ux * ending)) and y (first's y + (uy * ending))) to pairs
            set position to ending + gapLength
            set onDash to onDash = false

function append bim paper dash dot from {cad vector2:first} to {cad vector2:second} at {a 64 bit floating-point number:perMillimetre} into {a pointer to a list:pairs}:
    execute:
        set total to the cad distance from first to second
        if total <= 0.0:
            return nothing
        set dashLength to 4.5 * perMillimetre
        set dotLength to 0.5 * perMillimetre
        set gapLength to 4.0 * perMillimetre
        set ux to (second's x - first's x) / total
        set uy to (second's y - first's y) / total
        set position to 0.0
        set onDash to true
        loop while position < total:
            set piece to dotLength
            if onDash:
                set piece to dashLength
            set ending to the minimum of (position + piece) and total
            append (a cad vector2 with x (first's x + (ux * position)) and y (first's y + (uy * position))) to pairs
            append (a cad vector2 with x (first's x + (ux * ending)) and y (first's y + (uy * ending))) to pairs
            set position to ending + gapLength
            set onDash to onDash = false

# Appends, as pixel pairs, a circle of `radius` pixels around `centre`.
function append bim circle at {cad vector2:centre} radius {a 64 bit floating-point number:circleRadius} into {a pointer to a list:pairs}:
    execute:
        loop step from 0 to 24:
            set fromAngle to (6.283185307179586 * (step as a 64 bit floating-point number)) / 24.0
            set toAngle to (6.283185307179586 * ((step + 1) as a 64 bit floating-point number)) / 24.0
            append (a cad vector2 with x (centre's x + (circleRadius * (the cosine of fromAngle))) and y (centre's y + (circleRadius * (the sine of fromAngle)))) to pairs
            append (a cad vector2 with x (centre's x + (circleRadius * (the cosine of toAngle))) and y (centre's y + (circleRadius * (the sine of toAngle)))) to pairs

# A grid head: a circle with the grid's name, at `centre` in pixels.
function draw bim grid head {a string:name} at {cad vector2:centre} faint {boolean:faded} on {a pointer to a bim canvas record:canvas}:
    execute:
        draw bim grid head name at centre faint faded blue false on canvas

function draw bim grid head {a string:name} at {cad vector2:centre} faint {boolean:faded} blue {boolean:technical} on {a pointer to a bim canvas record:canvas}:
    execute:
        set ring to an empty list of a cad vector2
        set symbolScale to the bim symbol scale of (@intrinsic("dereference", canvas))
        set headRadius to bim grid screen head radius
        if canvas's paperScale > 0.0:
            set headRadius to 12.0
        append bim circle at centre radius (headRadius * symbolScale) into ring
        set blueChannel to 0
        if technical:
            set blueChannel to 255
        record bim strokes ring coloured (the bim halftone of channel 0 when faded), (the bim halftone of channel 0 when faded) and (the bim halftone of channel blueChannel when faded) wide 1.0 on canvas
        free ring
        record bim centred text name at (centre's x) and (centre's y + (5.0 * symbolScale)) coloured (the bim halftone of channel 0 when faded), (the bim halftone of channel 0 when faded) and (the bim halftone of channel blueChannel when faded) on canvas

function draw bim grid lines {a pointer to a list:pairs} faint {boolean:faded} on {a pointer to a bim canvas record:canvas}:
    execute:
        draw bim grid lines pairs faint faded blue false on canvas

function draw bim grid lines {a pointer to a list:pairs} faint {boolean:faded} blue {boolean:technical} on {a pointer to a bim canvas record:canvas}:
    execute:
        set blueChannel to 0
        if technical:
            set blueChannel to 255
        set breadth to 1.0
        if canvas's paperScale > 0.0:
            set breadth to 0.7
        record bim strokes pairs coloured (the bim halftone of channel 0 when faded), (the bim halftone of channel 0 when faded) and (the bim halftone of channel blueChannel when faded) wide breadth on canvas

# The grids in the plan: dash-dot lines with a head at each end.
function draw bim grids in plan of {bim editor record:editor} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        if (bim category bim grid category is visible in editor's planRules) = false:
            return nothing
        set faded to bim category bim grid category is halftone in editor's planRules
        set technical to bim view editor's planViewId uses a technical palette in editor's documentValue's current
        set headRadius to bim grid screen head radius
        if canvas's paperScale > 0.0:
            set headRadius to 3.0 * canvas's paperScale
        set pairs to an empty list of a cad vector2
        set gridValues to editor's documentValue's current's grids's values
        loop cursor from 0 to the length of gridValues:
            set gridValue to the item at cursor in gridValues
            set first to the bim pixel of gridValue's start through transform
            set second to the bim pixel of gridValue's finish through transform
            set span to the cad distance from first to second
            if (span > (headRadius * 2.0)) and ((bim editor hides (gridValue's id) in plan of editor) = false):
                set ux to (second's x - first's x) / span
                set uy to (second's y - first's y) / span
                set mask to the bim head mask of grid gridValue's id in editor's documentValue's current
                set startRadius to 0.0
                set finishRadius to 0.0
                if (mask = 1) or (mask = 3):
                    set startRadius to headRadius
                if (mask = 2) or (mask = 3):
                    set finishRadius to headRadius
                set dashStart to a cad vector2 with x (first's x + (ux * startRadius)) and y (first's y + (uy * startRadius))
                set dashFinish to a cad vector2 with x (second's x - (ux * finishRadius)) and y (second's y - (uy * finishRadius))
                if canvas's paperScale > 0.0:
                    append bim paper dash dot from dashStart to dashFinish at canvas's paperScale into pairs
                else:
                    append bim scaled dash dot from dashStart to dashFinish at transform's scale into pairs
        draw bim grid lines pairs faint faded blue technical on canvas
        free pairs
        loop cursor from 0 to the length of gridValues:
            set gridValue to the item at cursor in gridValues
            if ((bim editor hides (gridValue's id) in plan of editor) = false):
                set mask to the bim head mask of grid gridValue's id in editor's documentValue's current
                if (mask = 1) or (mask = 3):
                    draw bim grid head gridValue's name at (the bim pixel of gridValue's start through transform) faint faded blue technical on canvas
                if (mask = 2) or (mask = 3):
                    draw bim grid head gridValue's name at (the bim pixel of gridValue's finish through transform) faint faded blue technical on canvas

# Appends, as pixel triangles, a circled section head at `endPixel` of a
# section line running outward along `outward`, looking along `lookUnit`
# (unit vectors): the filled arrow on the looking side of the circle beyond
# the end (BS / ISO and NCS; the circle itself is stroked by the caller).
function append bim section head at {cad vector2:endPixel} outward {cad vector2:outward} looking {cad vector2:lookUnit} into {a pointer to a list:pixels}:
    execute:
        append bim section head at endPixel outward outward looking lookUnit scaled 1.0 into pixels

function append bim section head at {cad vector2:endPixel} outward {cad vector2:outward} looking {cad vector2:lookUnit} scaled {a 64 bit floating-point number:symbolScale} into {a pointer to a list:pixels}:
    execute:
        set headRadius to 10.0 * symbolScale
        set centre to a cad vector2 with x (endPixel's x + (outward's x * headRadius)) and y (endPixel's y + (outward's y * headRadius))
        set apex to a cad vector2 with x (centre's x + (lookUnit's x * (headRadius * 2.0))) and y (centre's y + (lookUnit's y * (headRadius * 2.0)))
        append apex to pixels
        set baseX to centre's x + (lookUnit's x * (headRadius * 0.7))
        set baseY to centre's y + (lookUnit's y * (headRadius * 0.7))
        append (a cad vector2 with x (baseX + (outward's x * (headRadius * 0.75))) and y (baseY + (outward's y * (headRadius * 0.75)))) to pixels
        append (a cad vector2 with x (baseX - (outward's x * (headRadius * 0.75))) and y (baseY - (outward's y * (headRadius * 0.75)))) to pixels

# The way section `sectionView` looks, the left of its line in the model,
# as a unit vector in the pixels of `transform`; zero for a line of no length.
local function the bim section look of {bim view definition record:sectionView} through {bim drawing transform record:transform}:
    execute:
        set modelRun to the cad distance from sectionView's lineStart to sectionView's lineFinish
        if modelRun <= 1e-9:
            return a cad vector2 with x 0.0 and y 0.0
        set leftModel to a cad vector2 with x (sectionView's lineStart's x - ((sectionView's lineFinish's y - sectionView's lineStart's y) / modelRun)) and y (sectionView's lineStart's y + ((sectionView's lineFinish's x - sectionView's lineStart's x) / modelRun))
        set startPixel to the bim pixel of sectionView's lineStart through transform
        set leftPixel to the bim pixel of leftModel through transform
        set leftSpan to the cad distance from startPixel to leftPixel
        return a cad vector2 with x ((leftPixel's x - startPixel's x) / leftSpan) and y ((leftPixel's y - startPixel's y) / leftSpan)

# The section lines in the plan: a dash-dot line with a heavy piece at each
# end and a head at each end pointing the way the section looks (to the left
# of its line). Under NEN and DIN the head is the INB template's section
# arrow (`append bim section arrow at`), 6 by 4 paper millimetres with its
# base centred on the line's end, and the markText stands beside it, beyond
# the end on the looking side; under BS / ISO and NCS an arrow on a circle
# beyond the end, the markText in the circle. Everything is sized in paper
# millimetres through the symbol scale (four pixels to the millimetre on
# screen), so the marks read the same at 1:50 and 1:100.
function draw bim section marks in plan of {bim editor record:editor} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        set symbolScale to the bim symbol scale of (@intrinsic("dereference", canvas))
        set perMillimetre to 4.0 * symbolScale
        set thin to an empty list of a cad vector2
        set heavy to an empty list of a cad vector2
        set arrows to an empty list of a cad vector2
        set rings to an empty list of a cad vector2
        set viewValues to editor's documentValue's current's views's values
        set headKind to the bim section head under (the bim drawing standard of editor's documentValue's current)
        loop cursor from 0 to the length of viewValues:
            set sectionView to the item at cursor in viewValues
            if sectionView's kind = bim section view:
                set first to the bim pixel of sectionView's lineStart through transform
                set second to the bim pixel of sectionView's lineFinish through transform
                set span to the cad distance from first to second
                set modelRun to the cad distance from sectionView's lineStart to sectionView's lineFinish
                if (span > 1.0) and (modelRun > 1e-9):
                    set ux to (second's x - first's x) / span
                    set uy to (second's y - first's y) / span
                    set lookUnit to the bim section look of sectionView through transform
                    set heavyLength to the minimum of (18.0 * symbolScale) and (span * 0.3)
                    set innerStart to a cad vector2 with x (first's x + (ux * heavyLength)) and y (first's y + (uy * heavyLength))
                    set innerFinish to a cad vector2 with x (second's x - (ux * heavyLength)) and y (second's y - (uy * heavyLength))
                    append first to heavy
                    append innerStart to heavy
                    append innerFinish to heavy
                    append second to heavy
                    append bim scaled dash dot from innerStart to innerFinish at transform's scale into thin
                    if headKind = bim arrow section head:
                        set lineUnit to a cad vector2 with x ux and y uy
                        append bim section arrow at first on lineUnit looking lookUnit with perMillimetre units per millimetre into arrows
                        append bim section arrow at second on lineUnit looking lookUnit with perMillimetre units per millimetre into arrows
                    else:
                        append bim section head at first outward (a cad vector2 with x (0.0 - ux) and y (0.0 - uy)) looking lookUnit scaled symbolScale into arrows
                        append bim section head at second outward (a cad vector2 with x ux and y uy) looking lookUnit scaled symbolScale into arrows
                        # The head's circle, divided across under NCS.
                        set firstRing to a cad vector2 with x (first's x - (ux * (10.0 * symbolScale))) and y (first's y - (uy * (10.0 * symbolScale)))
                        set secondRing to a cad vector2 with x (second's x + (ux * (10.0 * symbolScale))) and y (second's y + (uy * (10.0 * symbolScale)))
                        append bim circle at firstRing radius (10.0 * symbolScale) into rings
                        append bim circle at secondRing radius (10.0 * symbolScale) into rings
                        if headKind = bim divided section head:
                            append (a cad vector2 with x (firstRing's x - (10.0 * symbolScale)) and y firstRing's y) to rings
                            append (a cad vector2 with x (firstRing's x + (10.0 * symbolScale)) and y firstRing's y) to rings
                            append (a cad vector2 with x (secondRing's x - (10.0 * symbolScale)) and y secondRing's y) to rings
                            append (a cad vector2 with x (secondRing's x + (10.0 * symbolScale)) and y secondRing's y) to rings
        record bim strokes thin coloured 0, 0 and 0 wide 1.0 on canvas
        record bim strokes heavy coloured 0, 0 and 0 wide 3.0 on canvas
        record bim triangles arrows coloured 0, 0 and 0 on canvas
        record bim strokes rings coloured 0, 0 and 0 wide 1.0 on canvas
        free thin
        free heavy
        free arrows
        free rings
        loop cursor from 0 to the length of viewValues:
            set sectionView to the item at cursor in viewValues
            if sectionView's kind = bim section view:
                set first to the bim pixel of sectionView's lineStart through transform
                set second to the bim pixel of sectionView's lineFinish through transform
                set span to the cad distance from first to second
                if span > 1.0:
                    set ux to (second's x - first's x) / span
                    set uy to (second's y - first's y) / span
                    set markText to the string form of sectionView's detail
                    if headKind = bim arrow section head:
                        # Beside the arrow: 5 mm beyond the line's end (the
                        # arrow's base reaches 3), 2 mm to the looking side.
                        set markLook to the bim section look of sectionView through transform
                        set markBeyond to 5.0 * perMillimetre
                        set markAside to 2.0 * perMillimetre
                        record bim centred text markText at ((first's x - (ux * markBeyond)) + (markLook's x * markAside)) and (((first's y - (uy * markBeyond)) + (markLook's y * markAside)) + (5.0 * symbolScale)) coloured 0, 0 and 0 on canvas
                        record bim centred text markText at ((second's x + (ux * markBeyond)) + (markLook's x * markAside)) and (((second's y + (uy * markBeyond)) + (markLook's y * markAside)) + (5.0 * symbolScale)) coloured 0, 0 and 0 on canvas
                    else:
                        record bim centred text markText at (first's x - (ux * (10.0 * symbolScale))) and ((first's y - (uy * (10.0 * symbolScale))) + (5.0 * symbolScale)) coloured 0, 0 and 0 on canvas
                        record bim centred text markText at (second's x + (ux * (10.0 * symbolScale))) and ((second's y + (uy * (10.0 * symbolScale))) + (5.0 * symbolScale)) coloured 0, 0 and 0 on canvas
        # The elevation marks, 3 m outside each side of the building (they
        # move with it): a circle with a filled arrow toward the building and
        # the side's letter.
        set planExtent to the bim plan extent of editor's documentValue's current
        if planExtent's valid:
            set middlePixel to the bim pixel of (a cad vector2 with x ((planExtent's low's x + planExtent's high's x) * 0.5) and y ((planExtent's low's y + planExtent's high's y) * 0.5)) through transform
            set markArrows to an empty list of a cad vector2
            set markRings to an empty list of a cad vector2
            loop cursor from 0 to the length of viewValues:
                set elevationView to the item at cursor in viewValues
                if (elevationView's kind = bim model view) and (elevationView's detail > (0 as a 64 bit integer)):
                    set markPixel to the bim pixel of (the bim elevation mark of (elevationView's detail as an integer) around planExtent) through transform
                    set toward to the cad distance from markPixel to middlePixel
                    if toward > 1.0:
                        set lx to (middlePixel's x - markPixel's x) / toward
                        set ly to (middlePixel's y - markPixel's y) / toward
                        append (a cad vector2 with x (markPixel's x + (lx * (20.0 * symbolScale))) and y (markPixel's y + (ly * (20.0 * symbolScale)))) to markArrows
                        append (a cad vector2 with x ((markPixel's x + (lx * (7.0 * symbolScale))) - (ly * (7.5 * symbolScale))) and y ((markPixel's y + (ly * (7.0 * symbolScale))) + (lx * (7.5 * symbolScale)))) to markArrows
                        append (a cad vector2 with x ((markPixel's x + (lx * (7.0 * symbolScale))) + (ly * (7.5 * symbolScale))) and y ((markPixel's y + (ly * (7.0 * symbolScale))) - (lx * (7.5 * symbolScale)))) to markArrows
                        append bim circle at markPixel radius (10.0 * symbolScale) into markRings
            record bim triangles markArrows coloured 0, 0 and 0 on canvas
            record bim strokes markRings coloured 0, 0 and 0 wide 1.0 on canvas
            free markArrows
            free markRings
            loop cursor from 0 to the length of viewValues:
                set elevationView to the item at cursor in viewValues
                if (elevationView's kind = bim model view) and (elevationView's detail > (0 as a 64 bit integer)):
                    set markPixel to the bim pixel of (the bim elevation mark of (elevationView's detail as an integer) around planExtent) through transform
                    record bim centred text (the substring of elevationView's name from 0 spanning 1 bytes) at markPixel's x and (markPixel's y + (5.0 * symbolScale)) coloured 0, 0 and 0 on canvas

# The grids the section crosses: a vertical dash-dot line where the section
# line meets each grid line, from the grid's low to its high elevation, with
# its head on top.
function draw bim grids in section of {bim editor record:editor} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        if (bim category bim grid category is visible in editor's sectionRules) = false:
            return nothing
        set faded to bim category bim grid category is halftone in editor's sectionRules
        set first to editor's sectionFirst
        set run to the cad distance from editor's sectionFirst to editor's sectionSecond
        set dx to (editor's sectionSecond's x - first's x) / run
        set dy to (editor's sectionSecond's y - first's y) / run
        set gridValues to editor's documentValue's current's grids's values
        loop cursor from 0 to the length of gridValues:
            set gridValue to the item at cursor in gridValues
            set gx to gridValue's finish's x - gridValue's start's x
            set gy to gridValue's finish's y - gridValue's start's y
            set denominator to (dx * gy) - (dy * gx)
            if (the absolute value of denominator) > 1e-12:
                set ox to gridValue's start's x - first's x
                set oy to gridValue's start's y - first's y
                set along to ((ox * gy) - (oy * gx)) / denominator
                set onGrid to ((ox * dy) - (oy * dx)) / denominator
                if (onGrid >= 0.0) and (onGrid <= 1.0):
                    set top to the bim pixel of (a cad vector2 with x along and y gridValue's high) through transform
                    set bottom to the bim pixel of (a cad vector2 with x along and y gridValue's low) through transform
                    set pairs to an empty list of a cad vector2
                    append bim scaled dash dot from (a cad vector2 with x top's x and y (top's y + (bim grid screen head radius))) to bottom at transform's scale into pairs
                    draw bim grid lines pairs faint faded on canvas
                    free pairs
                    draw bim grid head gridValue's name at top faint faded on canvas

# The grids in the 3D view: drawn flat at datum level (peil 0), dash-dot,
# with a head at each end. The selected grid shows its plane, from its low to
# its high elevation (drawn with the selection).
function draw bim grids in view of {bim editor record:editor} among {a pointer to a list:sceneMeshes} remembering {a pointer to a list:covers} afresh {boolean:refresh} in {bim screen layout record:layout} with {bim camera record:camera} on {a pointer to a bim canvas record:canvas}:
    execute:
        if (bim category bim grid category is visible in editor's modelRules) = false:
            return nothing
        set faded to bim category bim grid category is halftone in editor's modelRules
        # The lines themselves are drawn depth tested with the model's
        # edges (`draw bim grid lines in view of …`); here only the heads,
        # each left out when an element of `sceneMeshes` stands in front of it.
        # Which heads are covered is found again only when `refresh` is set
        # (the camera or the model changed) and kept in `covers`.
        if refresh:
            clear covers
        set headCursor to 0
        set gridValues to editor's documentValue's current's grids's values
        loop cursor from 0 to the length of gridValues:
            set gridValue to the item at cursor in gridValues
            set gridHidden to bim editor hides (gridValue's id) in model view of editor
            loop endIndex from 0 to 2:
                set place to gridValue's start
                if endIndex = 1:
                    set place to gridValue's finish
                set head to the bim view point (place's x) (place's y) 0.0 in layout with camera
                set inside to ((head's x > (layout's planRight + 12.0)) and (head's x < (layout's width - 12.0))) and ((head's y > (layout's top + 12.0)) and (head's y < (layout's bottom - 12.0)))
                if refresh:
                    set covered to false
                    if inside:
                        set sight to the bim view ray through head in layout with camera
                        set headOffset to the cad difference of (a cad vector3 with x place's x, y place's y and z 0.0) and sight's origin
                        set headDistance to the cad dot of headOffset and sight's direction
                        set blocker to the bim pick along sight among sceneMeshes in editor's documentValue's current with (editor's spaces's values)
                        set covered to (blocker's kind != bim nothing picked) and (blocker's distance < (headDistance - 0.05))
                    append covered to covers
                set hidden to true
                if headCursor < the length of covers:
                    set hidden to the item at headCursor in covers
                set headCursor to headCursor + 1
                if inside:
                    if (hidden = false) and (gridHidden = false):
                        draw bim grid head gridValue's name at head faint faded on canvas

# ---------------------------------------------------------------- visibility panel
# Opened with L over the plan: one row per category, with check boxes for its
# visibility in the plan, the section and the 3D view, and for halftone in
# the plan. Clicking a box toggles it.

function the bim panel left:
    replacement:
        12.0

function the bim panel row height:
    replacement:
        24.0

function the bim panel top of {bim screen layout record:layout}:
    execute:
        return layout's top + 8.0

# The x of the box in column `columnIndex` (plan, section, 3D, plan
# halftone) of the panel whose left edge is `panelX`.
function the bim panel column {integer:columnIndex} from {a 64 bit floating-point number:panelX}:
    execute:
        return (panelX + 180.0) + (64.0 * (columnIndex as a 64 bit floating-point number))

function draw bim check box at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} ticked {boolean:isTicked} in {graphics frame:frame}:
    execute:
        draw a rectangle at x x and y y with width 14 and height 14 in color red 90, green 96 and blue 112 in frame
        draw a rectangle at x (x + 1.0) and y (y + 1.0) with width 12 and height 12 in color red 255, green 255 and blue 255 in frame
        if isTicked:
            draw a rectangle at x (x + 3.0) and y (y + 3.0) with width 8 and height 8 in color red 36, green 120 and blue 220 in frame

function draw bim visibility panel of {bim editor record:editor} in {bim screen layout record:layout} using {bim text atlas record:typeface} in {graphics frame:frame}:
    execute:
        set left to layout's planLeft + (the bim panel left)
        set top to the bim panel top of layout
        set rows to (the bim category count) + 1
        set height to ((rows as a 64 bit floating-point number) * (the bim panel row height)) + 12.0
        draw a rectangle at x left and y top with width 450 and height height in color red 200, green 206 and blue 216 in frame
        draw a rectangle at x (left + 1.0) and y (top + 1.0) with width 448 and height (height - 2.0) in color red 252, green 252 and blue 254 in frame
        draw bim label (the string form of "Visibility (L)") at (left + 10.0) and (top + 20.0) using typeface in frame
        draw bim label (the string form of "Plan") at ((the bim panel column 0 from left) - 8.0) and (top + 20.0) using typeface in frame
        draw bim label (the string form of "Sect") at ((the bim panel column 1 from left) - 8.0) and (top + 20.0) using typeface in frame
        draw bim label (the string form of "3D") at ((the bim panel column 2 from left) - 2.0) and (top + 20.0) using typeface in frame
        draw bim label (the string form of "Half") at ((the bim panel column 3 from left) - 8.0) and (top + 20.0) using typeface in frame
        loop code from 0 to the bim category count:
            set rowTop to top + ((((code + 1) as a 64 bit floating-point number)) * (the bim panel row height))
            draw bim label (the bim name of category code) at (left + 10.0) and (rowTop + 20.0) using typeface in frame
            draw bim check box at (the bim panel column 0 from left) and (rowTop + 8.0) ticked (bim category code is visible in editor's planRules) in frame
            draw bim check box at (the bim panel column 1 from left) and (rowTop + 8.0) ticked (bim category code is visible in editor's sectionRules) in frame
            draw bim check box at (the bim panel column 2 from left) and (rowTop + 8.0) ticked (bim category code is visible in editor's modelRules) in frame
            draw bim check box at (the bim panel column 3 from left) and (rowTop + 8.0) ticked (bim category code is halftone in editor's planRules) in frame

# Toggles the box under `pixel`; true when `pixel` lies on the panel, so the
# click goes no further.
function click bim visibility panel at {cad vector2:pixel} of {a pointer to a bim editor record:editor} in {bim screen layout record:layout}:
    execute:
        set left to layout's planLeft + (the bim panel left)
        set top to the bim panel top of layout
        set height to ((((the bim category count) + 1) as a 64 bit floating-point number) * (the bim panel row height)) + 12.0
        if ((pixel's x < left) or (pixel's x > (left + 450.0))) or ((pixel's y < top) or (pixel's y > (top + height))):
            return false
        set row to (((pixel's y - top) / (the bim panel row height)) as an integer) - 1
        if (row < 0) or (row >= (the bim category count)):
            return true
        loop slot from 0 to 4:
            set boxLeft to the bim panel column slot from left
            if (pixel's x >= (boxLeft - 4.0)) and (pixel's x <= (boxLeft + 18.0)):
                if slot = 0:
                    toggle bim category row visibility in (the address of (editor's planRules))
                    keep bim editor plan rules in editor
                else if slot = 1:
                    toggle bim category row visibility in (the address of (editor's sectionRules))
                    keep bim editor section rules in editor
                else if slot = 2:
                    toggle bim category row visibility in (the address of (editor's modelRules))
                else:
                    toggle bim category row halftone in (the address of (editor's planRules))
                    keep bim editor plan rules in editor
        return true

# The outline of sketch element `sketch` drawn as selected.
function highlight bim sketch {bim sketch record:element} through {bim drawing transform record:transform} in {graphics frame:frame}:
    execute:
        set selectedSketch to element
        set ring to selectedSketch's points's values
        start triangles in frame
        use vertex color red 0, green 120 and blue 215 in frame
        if selectedSketch's kind = bim text sketch:
            set anchor to the bim pixel of (the item at 0 in ring) through transform
            add bim stroke from (a cad vector2 with x anchor's x and y (anchor's y + 3.0)) to (a cad vector2 with x (anchor's x + 80.0) and y (anchor's y + 3.0)) wide 2.0 in frame
        else if selectedSketch's kind = bim line sketch:
            add bim stroke from (the bim pixel of (the item at 0 in ring) through transform) to (the bim pixel of (the item at 1 in ring) through transform) wide 1.5 in frame
        else:
            loop corner from 0 to the length of ring:
                add bim stroke from (the bim pixel of (the item at corner in ring) through transform) to (the bim pixel of (the item at (the remainder of (corner + 1) divided by (the length of ring)) in ring) through transform) wide 1.5 in frame
        finish triangles in frame

# The selected wall outlined, the selected opening marked on its wall's
# centreline, and the selected space filled, in the plan.
# Whether `elementId` is among the elements chosen together (Shift, or a
# selection box).
function bim element {a 64 bit integer:elementId} is chosen by {bim editor record:editor}:
    execute:
        if editor's selectionKind = bim nothing picked:
            return false
        loop cursor from 0 to the length of (editor's chosenSketches's values):
            if (the item at cursor in (editor's chosenSketches's values)) = elementId:
                return true
        return false

# A selection box from `corner` to `opposite` (pixels), as Open 2D Studio
# draws it: to the right a window, filled blue at 15% with a solid border at
# 80%; to the left a crossing, filled green with a dashed border (6 on, 3
# off), one pixel wide.
function draw bim selection box from {cad vector2:corner} to {cad vector2:opposite} in {graphics frame:frame}:
    execute:
        set crossing to opposite's x < corner's x
        set boxRed to 0
        set boxGreen to 120
        set boxBlue to 215
        if crossing:
            set boxGreen to 180
            set boxBlue to 0
        start triangles in frame
        use vertex color red boxRed, green boxGreen, blue boxBlue and alpha 38 in frame
        add a vertex at x corner's x and y corner's y to frame
        add a vertex at x opposite's x and y corner's y to frame
        add a vertex at x opposite's x and y opposite's y to frame
        add a vertex at x corner's x and y corner's y to frame
        add a vertex at x opposite's x and y opposite's y to frame
        add a vertex at x corner's x and y opposite's y to frame
        set corners to an empty list of a cad vector2
        append corner to corners
        append (a cad vector2 with x opposite's x and y corner's y) to corners
        append opposite to corners
        append (a cad vector2 with x corner's x and y opposite's y) to corners
        use vertex color red boxRed, green boxGreen, blue boxBlue and alpha 204 in frame
        loop side from 0 to 4:
            set sideStart to the item at side in corners
            set sideEnd to the item at (the remainder of (side + 1) divided by 4) in corners
            set run to the cad distance from sideStart to sideEnd
            if crossing and (run > 0.0):
                set position to 0.0
                loop while position < run:
                    set ending to the minimum of (position + 6.0) and run
                    add bim stroke from (a cad vector2 with x (sideStart's x + (((sideEnd's x - sideStart's x) * position) / run)) and y (sideStart's y + (((sideEnd's y - sideStart's y) * position) / run))) to (a cad vector2 with x (sideStart's x + (((sideEnd's x - sideStart's x) * ending) / run)) and y (sideStart's y + (((sideEnd's y - sideStart's y) * ending) / run))) wide 1.0 in frame
                    set position to ending + 3.0
            else:
                add bim stroke from sideStart to sideEnd wide 1.0 in frame
        finish triangles in frame
        free corners

# `outlineRing` (model coordinates, in plan) filled in the selection colour,
# see-through, so that the whole selected element shows selected.
function shade bim selection {a pointer to a list:outlineRing} through {bim drawing transform record:transform} in {graphics frame:frame}:
    execute:
        if (the length of outlineRing) < 3:
            return nothing
        set pixels to an empty list of a cad vector2
        set rings to an empty list of the type of (an empty list of a cad vector2)
        append outlineRing to rings
        append bim fill of rings through transform to pixels
        free rings
        start triangles in frame
        use vertex color red 0, green 120, blue 215 and alpha 95 in frame
        loop cursor from 0 to the length of pixels:
            add a vertex at x (the item at cursor in pixels)'s x and y (the item at cursor in pixels)'s y to frame
        finish triangles in frame
        free pixels

function draw bim selection in plan of {bim editor record:editor} through {bim drawing transform record:transform} in {graphics frame:frame}:
    execute:
        set modelValue to editor's documentValue's current
        # A section chosen in the plan or the browser (its properties
        # shown, nothing else selected): its line in the selection colour.
        if editor's selectionKind = bim nothing picked:
            set shownFound to the bim view index of (the bim properties view of editor) in modelValue
            if shownFound's valid:
                set shownSection to the item at shownFound's position in (modelValue's views's values)
                if (shownSection's kind = bim section view) and ((the cad distance from shownSection's lineStart to shownSection's lineFinish) > 1e-9):
                    start triangles in frame
                    use vertex color red 0, green 120 and blue 215 in frame
                    add bim stroke from (the bim pixel of shownSection's lineStart through transform) to (the bim pixel of shownSection's lineFinish through transform) wide 3.0 in frame
                    finish triangles in frame
        if bim category bim grid category is visible in editor's planRules:
            start triangles in frame
            use vertex color red 0, green 120 and blue 215 in frame
            loop gridCursor from 0 to the length of (modelValue's grids's values):
                set gridValue to the item at gridCursor in (modelValue's grids's values)
                set chosenGrid to ((editor's selectionKind = bim grid picked) and (editor's selectionId = gridValue's id)) or (bim element gridValue's id is chosen by editor)
                if chosenGrid and ((bim editor hides (gridValue's id) in plan of editor) = false):
                    set firstPixel to the bim pixel of gridValue's start through transform
                    set secondPixel to the bim pixel of gridValue's finish through transform
                    set span to the cad distance from firstPixel to secondPixel
                    if span > ((bim grid screen head radius) * 2.0):
                        set ux to (secondPixel's x - firstPixel's x) / span
                        set uy to (secondPixel's y - firstPixel's y) / span
                        set mask to the bim head mask of grid gridValue's id in modelValue
                        set startRadius to 0.0
                        set finishRadius to 0.0
                        if (mask = 1) or (mask = 3):
                            set startRadius to bim grid screen head radius
                        if (mask = 2) or (mask = 3):
                            set finishRadius to bim grid screen head radius
                        set dashes to an empty list of a cad vector2
                        append bim scaled dash dot from (a cad vector2 with x (firstPixel's x + (ux * startRadius)) and y (firstPixel's y + (uy * startRadius))) to (a cad vector2 with x (secondPixel's x - (ux * finishRadius)) and y (secondPixel's y - (uy * finishRadius))) at transform's scale into dashes
                        set dashCursor to 0
                        loop while (dashCursor + 1) < the length of dashes:
                            add bim stroke from (the item at dashCursor in dashes) to (the item at (dashCursor + 1) in dashes) wide 1.5 in frame
                            set dashCursor to dashCursor + 2
                        free dashes
            finish triangles in frame
        # Walls, slabs and grid lines chosen together (sketches and meshes
        # show their own).
        if (the length of (editor's chosenSketches's values)) > 0:
            set chosenOutlines to the bim selection outlines of editor in plan true within (the bim lod tolerance at transform's scale)
            loop outlineCursor from 0 to the length of chosenOutlines:
                set chosenOutline to the item at outlineCursor in chosenOutlines
                if bim element chosenOutline's id is chosen by editor:
                    if chosenOutline's kind = bim wall picked:
                        set wallFound to the bim wall index of chosenOutline's id in modelValue
                        if wallFound's valid:
                            set chosenWall to the item at wallFound's position in (modelValue's walls's values)
                            set wallFootprint to the bim footprint of chosenWall in modelValue using editor's evaluation's index
                            set wallRing to the bim outline of chosenWall with wallFootprint wide (the bim wall thickness of chosenWall in modelValue)
                            shade bim selection wallRing through transform in frame
                            free wallRing
                    if chosenOutline's kind = bim slab picked:
                        set slabFound to the bim slab index of chosenOutline's id in modelValue
                        if slabFound's valid:
                            shade bim selection ((the item at slabFound's position in (modelValue's slabs's values))'s outline's values) through transform in frame
                    if chosenOutline's kind = bim linear picked:
                        set linearFound to the bim linear index of chosenOutline's id in modelValue
                        if linearFound's valid:
                            set linearRing to the bim plan outline of linear (the item at linearFound's position in (modelValue's linears's values)) in modelValue
                            shade bim selection linearRing through transform in frame
                            free linearRing
            start triangles in frame
            use vertex color red 0, green 120 and blue 215 in frame
            loop outlineCursor from 0 to the length of chosenOutlines:
                set chosenOutline to the item at outlineCursor in chosenOutlines
                set flatKind to ((chosenOutline's kind = bim wall picked) or (chosenOutline's kind = bim slab picked)) or (chosenOutline's kind = bim linear picked)
                if flatKind and (bim element chosenOutline's id is chosen by editor):
                    set edgeCursor to 0
                    loop while (edgeCursor + 1) < the length of (chosenOutline's segments's values):
                        set edgeFrom to the item at edgeCursor in (chosenOutline's segments's values)
                        set edgeTo to the item at (edgeCursor + 1) in (chosenOutline's segments's values)
                        add bim stroke from (the bim pixel of (a cad vector2 with x edgeFrom's x and y edgeFrom's y) through transform) to (the bim pixel of (a cad vector2 with x edgeTo's x and y edgeTo's y) through transform) wide 1.5 in frame
                        set edgeCursor to edgeCursor + 2
            finish triangles in frame
        if editor's selectionKind = bim wall picked:
            set found to the bim wall index of editor's selectionId in modelValue
            if found's valid = false:
                return nothing
            set selectedWall to the item at found's position in (modelValue's walls's values)
            set footprint to the bim footprint of selectedWall in modelValue using editor's evaluation's index
            set outline to the bim outline of selectedWall with footprint wide (the bim wall thickness of selectedWall in modelValue)
            shade bim selection outline through transform in frame
            set corners to an empty list of a cad vector2
            loop cursor from 0 to the length of outline:
                append (the bim pixel of (the item at cursor in outline) through transform) to corners
            free outline
            set sides to the length of corners
            start triangles in frame
            use vertex color red 0, green 120 and blue 215 in frame
            loop side from 0 to sides:
                add bim stroke from (the item at side in corners) to (the item at (the remainder of (side + 1) divided by sides) in corners) wide 1.5 in frame
            # Handles: the ends move, the middle (orange) bends the wall.
            set startPixel to the bim pixel of selectedWall's start through transform
            set finishPixel to the bim pixel of selectedWall's finish through transform
            set middlePixel to the bim pixel of (the bim middle of wall selectedWall) through transform
            use vertex color red 255, green 255 and blue 255 in frame
            add bim square at startPixel sized 8.0 in frame
            add bim square at finishPixel sized 8.0 in frame
            add bim square at middlePixel sized 8.0 in frame
            use vertex color red 0, green 120 and blue 215 in frame
            add bim square at startPixel sized 6.0 in frame
            add bim square at finishPixel sized 6.0 in frame
            use vertex color red 235, green 140 and blue 30 in frame
            add bim square at middlePixel sized 6.0 in frame
            finish triangles in frame
            free corners
        # Every selected sketch element and every part of a selected
        # instance.
        if (editor's selectionKind = bim sketch picked) or (editor's selectionKind = bim instance picked):
            set drawn to the bim drawn sketches of modelValue
            loop drawnCursor from 0 to the length of (drawn's values):
                set sketch to the item at drawnCursor in (drawn's values)
                set chosen to sketch's id = editor's selectionId
                loop chosenCursor from 0 to the length of (editor's chosenSketches's values):
                    if (the item at chosenCursor in (editor's chosenSketches's values)) = sketch's id:
                        set chosen to true
                if chosen:
                    highlight bim sketch sketch through transform in frame
        loop meshCursor from 0 to the length of (modelValue's meshes's values):
            set meshValue to the item at meshCursor in (modelValue's meshes's values)
            set meshChosen to (editor's selectionKind = bim mesh picked) and (meshValue's id = editor's selectionId)
            loop chosenCursor from 0 to the length of (editor's chosenSketches's values):
                if (the item at chosenCursor in (editor's chosenSketches's values)) = meshValue's id:
                    set meshChosen to true
            if meshChosen:
                start triangles in frame
                use vertex color red 0, green 120 and blue 215 in frame
                set start to 0
                loop while start < the length of (meshValue's faces's values):
                    set faceRing to the bim plan outline of mesh face start of meshValue
                    loop corner from 0 to the length of faceRing:
                        add bim stroke from (the bim pixel of (the item at corner in faceRing) through transform) to (the bim pixel of (the item at (the remainder of (corner + 1) divided by (the length of faceRing)) in faceRing) through transform) wide 1.5 in frame
                    free faceRing
                    set start to start + ((the item at start in (meshValue's faces's values)) + 1)
                finish triangles in frame

        if editor's selectionKind = bim opening picked:
            set found to the bim opening index of editor's selectionId in modelValue
            if found's valid = false:
                return nothing
            set openingValue to the item at found's position in (modelValue's openings's values)
            set hostFound to the bim wall index of openingValue's hostId in modelValue
            set typeFound to the bim opening type index of openingValue's typeId in modelValue
            if (hostFound's valid and typeFound's valid) = false:
                return nothing
            set host to the item at hostFound's position in (modelValue's walls's values)
            set halfWidth to (the bim rough width of (the item at typeFound's position in (modelValue's openingTypes's values))) * 0.5
            set span to the bim span of host at openingValue's offset reaching halfWidth
            set leftPoint to span's left
            set rightPoint to span's right
            start triangles in frame
            use vertex color red 0, green 120 and blue 215 in frame
            add bim stroke from (the bim pixel of leftPoint through transform) to (the bim pixel of rightPoint through transform) wide 6.0 in frame
            finish triangles in frame
        if editor's selectionKind = bim space object picked:
            set found to the bim space object index of editor's selectionId in editor's documentValue's current
            if found's valid:
                set spaceValue to the item at found's position in (editor's documentValue's current's spaceObjects's values)
                set pixels to an empty list of a cad vector2
                set rings to an empty list of the type of (an empty list of a cad vector2)
                append (spaceValue's outline's values) to rings
                append bim fill of rings through transform to pixels
                free rings
                draw bim triangles pixels coloured 190, 215 and 245 in frame
                free pixels
        if editor's selectionKind = bim space picked:
            set chosen to the bim selected space of editor
            if chosen's valid = false:
                return nothing
            if bim region chosen's space has an explicit space in editor's documentValue's current:
                return nothing
            set pixels to an empty list of a cad vector2
            set rings to an empty list of the type of (an empty list of a cad vector2)
            append (chosen's space's outline's values) to rings
            append bim fill of rings through transform to pixels
            free rings
            draw bim triangles pixels coloured 190, 215 and 245 in frame
            free pixels

# The walls of the storey below the active one, outlined faintly as an
# underlay to draw over.
function draw bim storey below of {bim editor record:editor} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        set modelValue to editor's documentValue's current
        set lower to the bim level next to editor's levelId going up false in modelValue
        if lower's valid = false:
            return nothing
        set lowerId to (the item at lower's position in (modelValue's levels's values))'s id
        set outlines to an empty list of a cad vector2
        loop cursor from 0 to the length of (modelValue's walls's values):
            set wallValue to the item at cursor in (modelValue's walls's values)
            if wallValue's levelId = lowerId:
                set footprint to the bim footprint of wallValue in modelValue using editor's evaluation's index
                set ring to the bim outline of wallValue with footprint wide (the bim wall thickness of wallValue in modelValue)
                set sides to the length of ring
                loop side from 0 to sides:
                    append (the bim pixel of (the item at side in ring) through transform) to outlines
                    append (the bim pixel of (the item at (the remainder of (side + 1) divided by sides) in ring) through transform) to outlines
                free ring
        if (the length of outlines) = 0:
            free outlines
            return nothing
        record bim strokes outlines coloured 178, 186 and 200 wide 1.0 on canvas
        free outlines

# A filled square of `size` pixels centred on `pixel`.
function add bim square at {cad vector2:pixel} sized {a 64 bit floating-point number:size} in {graphics frame:frame}:
    execute:
        set half to size * 0.5
        add a vertex at x (pixel's x - half) and y (pixel's y - half) to frame
        add a vertex at x (pixel's x + half) and y (pixel's y - half) to frame
        add a vertex at x (pixel's x + half) and y (pixel's y + half) to frame
        add a vertex at x (pixel's x - half) and y (pixel's y - half) to frame
        add a vertex at x (pixel's x + half) and y (pixel's y + half) to frame
        add a vertex at x (pixel's x - half) and y (pixel's y + half) to frame

# A shape handle that drags an edge across itself: two triangles on `pixel`
# pointing both ways along the edge's normal, `size` pixels from the middle
# to each tip, for the edge from `here` to `following` (pixels).
function add bim edge arrows at {cad vector2:pixel} across {cad vector2:here} to {cad vector2:following} sized {a 64 bit floating-point number:size} in {graphics frame:frame}:
    execute:
        set run to the cad distance from here to following
        if run <= 1e-9:
            return nothing
        set ux to (following's x - here's x) / run
        set uy to (following's y - here's y) / run
        set nx to 0.0 - uy
        set ny to ux
        set half to size * 0.6
        set gap to size * 0.2
        loop side from 0 to 2:
            set sign to 1.0
            if side = 1:
                set sign to -1.0
            add a vertex at x (pixel's x + ((sign * size) * nx)) and y (pixel's y + ((sign * size) * ny)) to frame
            add a vertex at x ((pixel's x + ((sign * gap) * nx)) + (half * ux)) and y ((pixel's y + ((sign * gap) * ny)) + (half * uy)) to frame
            add a vertex at x ((pixel's x + ((sign * gap) * nx)) - (half * ux)) and y ((pixel's y + ((sign * gap) * ny)) - (half * uy)) to frame

# The outlines of the active storey's slabs, faintly; the selected slab's
# outline strongly, with a handle on every corner to drag and arrows on
# every edge's middle that push that side across itself.
function draw bim slabs of {bim editor record:editor} through {bim drawing transform record:transform} in {graphics frame:frame}:
    execute:
        set modelValue to editor's documentValue's current
        set chosen to the bim selected slab of editor
        set anyEdge to false
        loop cursor from 0 to the length of (modelValue's slabs's values):
            if (the item at cursor in (modelValue's slabs's values))'s levelId = editor's levelId:
                set anyEdge to true
        if anyEdge:
            # Floors as their edges; a roof, above the cut, dashed; a
            # ceiling only where its category is shown.
            start triangles in frame
            use vertex color red 196, green 170 and blue 120 in frame
            loop cursor from 0 to the length of (modelValue's slabs's values):
                set slabValue to the item at cursor in (modelValue's slabs's values)
                set plateCategory to the bim category of element slabValue's id in modelValue
                set slabShown to (the bim phase look of element slabValue's id in plan of editor) != bim phase hidden look
                if ((slabValue's levelId = editor's levelId) and (bim category plateCategory is visible in editor's planRules)) and slabShown:
                    set dashed to (the bim role of plate slabValue in modelValue) != bim floor planar role
                    set holeRings to the bim plate holes of slabValue's id in modelValue
                    loop holeCursor from 0 to the length of holeRings:
                        set holeRing to the item at holeCursor in holeRings
                        loop holeCorner from 0 to 4:
                            set holeHere to the bim pixel of (the item at holeCorner in holeRing) through transform
                            set holeNext to the bim pixel of (the item at (the remainder of (holeCorner + 1) divided by 4) in holeRing) through transform
                            add bim stroke from holeHere to holeNext wide 1.0 in frame
                    free bim plate holes holeRings
                    set count to the length of (slabValue's outline's values)
                    loop corner from 0 to count:
                        set here to the bim pixel of (the item at corner in (slabValue's outline's values)) through transform
                        set following to the bim pixel of (the item at (the remainder of (corner + 1) divided by count) in (slabValue's outline's values)) through transform
                        if dashed:
                            set total to the cad distance from here to following
                            set position to 0.0
                            loop while (total > 0.0) and (position < total):
                                set ending to the minimum of (position + 8.0) and total
                                add bim stroke from (a cad vector2 with x (here's x + (((following's x - here's x) * position) / total)) and y (here's y + (((following's y - here's y) * position) / total))) to (a cad vector2 with x (here's x + (((following's x - here's x) * ending) / total)) and y (here's y + (((following's y - here's y) * ending) / total))) wide 1.0 in frame
                                set position to ending + 4.0
                        else:
                            add bim stroke from here to following wide 1.0 in frame
            finish triangles in frame
        if chosen's valid = false:
            return nothing
        set points to chosen's slab's outline's values
        set count to the length of points
        shade bim selection points through transform in frame
        start triangles in frame
        use vertex color red 0, green 120 and blue 215 in frame
        loop corner from 0 to count:
            set here to the bim pixel of (the item at corner in points) through transform
            set following to the bim pixel of (the item at (the remainder of (corner + 1) divided by count) in points) through transform
            add bim stroke from here to following wide 1.5 in frame
        loop corner from 0 to count:
            set here to the bim pixel of (the item at corner in points) through transform
            use vertex color red 255, green 255 and blue 255 in frame
            add bim square at here sized 8.0 in frame
            use vertex color red 0, green 120 and blue 215 in frame
            add bim square at here sized 6.0 in frame
        # Each edge's middle drags that side across itself.
        loop corner from 0 to count:
            set here to the bim pixel of (the item at corner in points) through transform
            set following to the bim pixel of (the item at (the remainder of (corner + 1) divided by count) in points) through transform
            # Edges too short to hold the arrows (an arc's pieces) get none.
            if (the cad distance from here to following) >= 28.0:
                set middlePixel to the bim pixel of (the bim middle of slab edge corner of chosen's slab) through transform
                use vertex color red 255, green 255 and blue 255 in frame
                add bim edge arrows at middlePixel across here to following sized 10.0 in frame
                use vertex color red 0, green 120 and blue 215 in frame
                add bim edge arrows at middlePixel across here to following sized 8.0 in frame
        finish triangles in frame

# Spaces are filled lightly and labelled with their area.
function draw bim spaces of {bim editor record:editor} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        draw bim spaces of editor through transform lettered at 13.0 on canvas

function draw bim spaces of {bim editor record:editor} through {bim drawing transform record:transform} lettered at {a 64 bit floating-point number:textHeight} on {a pointer to a bim canvas record:canvas}:
    execute:
        set technical to bim view editor's planViewId uses a technical palette in editor's documentValue's current
        set roomRed to 35
        set roomGreen to 48
        set roomBlue to 70
        if technical:
            set roomRed to 0
            set roomGreen to 0
            set roomBlue to 0
        set pixels to an empty list of a cad vector2
        loop cursor from 0 to the length of (editor's spaces's values):
            set regionValue to the item at cursor in (editor's spaces's values)
            if (bim region regionValue has an explicit space in editor's documentValue's current) = false:
                set rings to an empty list of the type of (an empty list of a cad vector2)
                append (regionValue's outline's values) to rings
                append bim fill of rings through transform to pixels
                free rings
        if technical = false:
            record bim triangles pixels coloured 226, 236 and 248 on canvas
        free pixels
        # A label is drawn only where the room is wide enough on screen for it.
        set metre to the cad distance from (the bim pixel of (a cad vector2 with x 0.0 and y 0.0) through transform) to (the bim pixel of (a cad vector2 with x 1.0 and y 0.0) through transform)
        loop cursor from 0 to the length of (editor's spaces's values):
            set regionValue to the item at cursor in (editor's spaces's values)
            if (((the square root of regionValue's area) * metre) >= (7.0 * textHeight)) and ((bim region regionValue has an explicit space in editor's documentValue's current) = false):
                set anchor to the bim pixel of (a bim point inside (regionValue's outline's values)) through transform
                record bim centred text ((the bim area text of regionValue's area) + (the string form of " m2")) at anchor's x and (anchor's y + (0.4 * textHeight)) coloured roomRed, roomGreen and roomBlue on canvas

        # Explicit spaces also work without any surrounding wall region.
        loop cursor from 0 to the length of (editor's documentValue's current's spaceObjects's values):
            set spaceValue to the item at cursor in (editor's documentValue's current's spaceObjects's values)
            if spaceValue's levelId = editor's levelId:
                set rings to an empty list of the type of (an empty list of a cad vector2)
                set pixels to an empty list of a cad vector2
                append (spaceValue's outline's values) to rings
                append bim fill of rings through transform to pixels
                free rings
                if technical = false:
                    record bim triangles pixels coloured 222, 239 and 231 on canvas
                free pixels
                set anchor to the bim pixel of (a bim point inside (spaceValue's outline's values)) through transform
                record bim centred text (the bim tag text of spaceValue's id in editor's documentValue's current) at anchor's x and (anchor's y - (0.5 * textHeight)) coloured roomRed, roomGreen and roomBlue on canvas
                set areaValue to the absolute value of (the cad signed area of (spaceValue's outline's values))
                record bim centred text ((the bim area text of areaValue) + (the string form of " m2")) at anchor's x and (anchor's y + (0.8 * textHeight)) coloured roomRed, roomGreen and roomBlue on canvas

# The plan's grid as Open 2D Studio draws it: minor lines every 0.1 m,
# coarsened by five while closer than 10 pixels and refined by five while
# wider than 100; every fifth line major. Minor lines #d0d0d0 at half a
# pixel, major #b0b0b0 at one.
function draw bim grid in {bim screen layout record:layout} with {bim camera record:camera} in {graphics frame:frame}:
    execute:
        set low to the bim model point of (a cad vector2 with x layout's planLeft and y layout's bottom) in layout with camera
        set high to the bim model point of (a cad vector2 with x layout's planRight and y layout's top) in layout with camera
        set step to 0.1
        loop while (step * camera's scale) < 10.0:
            set step to step * 5.0
        loop while (step * camera's scale) > 100.0:
            set step to step / 5.0
        set major to step * 5.0
        loop pass from 0 to 2:
            start triangles in frame
            set breadth to 0.5
            if pass = 0:
                use vertex color red 208, green 208 and blue 208 in frame
            else:
                use vertex color red 176, green 176 and blue 176 in frame
                set breadth to 1.0
            set column to (the floor of (low's x / step)) * step
            loop while column <= high's x:
                set onMajor to (the absolute value of ((column / major) - (the floor of ((column / major) + 0.5)))) < 1e-6
                if onMajor = (pass = 1):
                    add bim stroke from (the bim plan pixel of (a cad vector2 with x column and y low's y) in layout with camera) to (the bim plan pixel of (a cad vector2 with x column and y high's y) in layout with camera) wide breadth in frame
                set column to column + step
            set row to (the floor of (low's y / step)) * step
            loop while row <= high's y:
                set onMajor to (the absolute value of ((row / major) - (the floor of ((row / major) + 0.5)))) < 1e-6
                if onMajor = (pass = 1):
                    add bim stroke from (the bim plan pixel of (a cad vector2 with x low's x and y row) in layout with camera) to (the bim plan pixel of (a cad vector2 with x high's x and y row) in layout with camera) wide breadth in frame
                set row to row + step
            finish triangles in frame

# The linear elements of the active storey in the plan, as Open 2D Studio
# and Revit draw them: one the cut plane (1.2 m up) passes through upright,
# a column say, is cut: filled and hatched by its material, outlined black;
# one above the cut, a beam say, is dashed; one below, a skirting say, is a
# thin line.
function draw bim linears in plan of {bim editor record:editor} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        draw bim linears in plan of editor through transform with all reinforcement true on canvas

# The same; with `everyBar` false (a sheet), only the reinforcement that is
# tagged, one bar per bar mark (`draw bim tagged reinforcement in plan`).
function draw bim linears in plan of {bim editor record:editor} through {bim drawing transform record:transform} with all reinforcement {boolean:everyBar} on {a pointer to a bim canvas record:canvas}:
    execute:
        set modelValue to editor's documentValue's current
        set cutHeight to (the bim storey elevation of editor) + (the bim plan cut height of editor)
        set cutEdges to an empty list of a cad vector2
        set aboveEdges to an empty list of a cad vector2
        set belowEdges to an empty list of a cad vector2
        set planParts to the bim linear parts of modelValue
        set planCuts to the bim end cuts of parts (planParts's values) in modelValue
        loop cursor from 0 to the length of (modelValue's linears's values):
            set linearValue to the item at cursor in (modelValue's linears's values)
            set linearType to the bim type of linear linearValue in modelValue
            set linearCategory to the bim category of linear role linearType's role
            set linearShown to (the bim phase look of element linearValue's id in plan of editor) != bim phase hidden look
            if ((linearValue's levelId = editor's levelId) and (bim category linearCategory is visible in editor's planRules)) and linearShown:
                set heights to the bim height range of linear linearValue in modelValue
                set ringValue to the bim plan outline of linear linearValue typed linearType in modelValue cut by (the item at cursor in (planCuts's values))
                set run to the cad difference of linearValue's finish and linearValue's start
                set levelRun to the square root of ((run's x * run's x) + (run's y * run's y))
                set upright to (the absolute value of run's z) > levelRun
                if (upright and (heights's x <= cutHeight)) and (heights's y >= cutHeight):
                    draw bim hatch of ringValue in (the bim whole hatch band of linearType's material) through transform faint false plain false on canvas
                    loop corner from 0 to the length of ringValue:
                        append (the bim pixel of (the item at corner in ringValue) through transform) to cutEdges
                        append (the bim pixel of (the item at (the remainder of (corner + 1) divided by (the length of ringValue)) in ringValue) through transform) to cutEdges
                else if linearType's role = bim pile role:
                    # A pile, seen from above under its storey: its outline
                    # and a cross through it, as pile plans draw them.
                    loop corner from 0 to the length of ringValue:
                        append (the bim pixel of (the item at corner in ringValue) through transform) to cutEdges
                        append (the bim pixel of (the item at (the remainder of (corner + 1) divided by (the length of ringValue)) in ringValue) through transform) to cutEdges
                    set pileCentre to a cad vector2 with x linearValue's start's x and y linearValue's start's y
                    set pileReach to 0.5 * linearType's width
                    append (the bim pixel of (a cad vector2 with x (pileCentre's x - pileReach) and y (pileCentre's y - pileReach)) through transform) to cutEdges
                    append (the bim pixel of (a cad vector2 with x (pileCentre's x + pileReach) and y (pileCentre's y + pileReach)) through transform) to cutEdges
                    append (the bim pixel of (a cad vector2 with x (pileCentre's x - pileReach) and y (pileCentre's y + pileReach)) through transform) to cutEdges
                    append (the bim pixel of (a cad vector2 with x (pileCentre's x + pileReach) and y (pileCentre's y - pileReach)) through transform) to cutEdges
                else:
                    loop corner from 0 to the length of ringValue:
                        set edgeFrom to the bim pixel of (the item at corner in ringValue) through transform
                        set edgeTo to the bim pixel of (the item at (the remainder of (corner + 1) divided by (the length of ringValue)) in ringValue) through transform
                        if heights's x > cutHeight:
                            # Dashes of 6 pixels with gaps of 3.
                            set total to the cad distance from edgeFrom to edgeTo
                            set position to 0.0
                            loop while (total > 0.0) and (position < total):
                                set ending to the minimum of (position + 6.0) and total
                                append (a cad vector2 with x (edgeFrom's x + (((edgeTo's x - edgeFrom's x) * position) / total)) and y (edgeFrom's y + (((edgeTo's y - edgeFrom's y) * position) / total))) to aboveEdges
                                append (a cad vector2 with x (edgeFrom's x + (((edgeTo's x - edgeFrom's x) * ending) / total)) and y (edgeFrom's y + (((edgeTo's y - edgeFrom's y) * ending) / total))) to aboveEdges
                                set position to ending + 3.0
                        else:
                            append edgeFrom to belowEdges
                            append edgeTo to belowEdges
                free ringValue
        record bim strokes cutEdges coloured 0, 0 and 0 wide 1.0 on canvas
        record bim strokes aboveEdges coloured 0, 0 and 0 wide 1.0 on canvas
        record bim strokes belowEdges coloured 80, 80 and 80 wide 0.7 on canvas
        free cutEdges
        free aboveEdges
        free belowEdges
        loop nodeCursor from 0 to the length of (modelValue's connections's values):
            set nodeValue to the item at nodeCursor in (modelValue's connections's values)
            if (nodeValue's levelId = editor's levelId) and ((bim editor hides (nodeValue's id) in plan of editor) = false):
                set primary to the item at 0 in (nodeValue's members's values)
                set memberFound to the bim linear index of primary's elementId in modelValue
                if memberFound's valid:
                    set memberValue to the item at memberFound's position in (modelValue's linears's values)
                    set anchor to memberValue's start
                    if primary's end = 1:
                        set anchor to memberValue's finish
                    if primary's end = 2:
                        set anchor to the cad sum of memberValue's start and ((the cad difference of memberValue's finish and memberValue's start) scaled by primary's position)
                    set anchorPixel to the bim pixel of (a cad vector2 with x anchor's x and y anchor's y) through transform
                    set glyph to an empty list of a cad vector2
                    append (a cad vector2 with x (anchorPixel's x - 6.0) and y anchorPixel's y) to glyph
                    append (a cad vector2 with x (anchorPixel's x + 6.0) and y anchorPixel's y) to glyph
                    append (a cad vector2 with x anchorPixel's x and y (anchorPixel's y - 6.0)) to glyph
                    append (a cad vector2 with x anchorPixel's x and y (anchorPixel's y + 6.0)) to glyph
                    record bim strokes glyph coloured 150, 45 and 170 wide 2.0 on canvas
                    free glyph
        if everyBar = false:
            draw bim tagged reinforcement in plan of editor through transform on canvas
            return nothing
        loop reinforcementCursor from 0 to the length of (modelValue's reinforcements's values):
            set spec to the bim hostbound reinforcement (the item at reinforcementCursor in (modelValue's reinforcements's values)) in modelValue
            if (spec's levelId = editor's levelId) and ((bim editor hides (spec's id) in plan of editor) = false):
                set generated to the bim reinforcement paths of spec in modelValue
                set rebarInk to an empty list of a cad vector2
                loop barCursor from 0 to the length of (generated's bars's values):
                    set itemValue to the item at barCursor in (generated's bars's values)
                    loop edge from 0 to ((the length of (itemValue's points's values)) - 1):
                        set firstPoint to the item at edge in (itemValue's points's values)
                        set lastPoint to the item at (edge + 1) in (itemValue's points's values)
                        append (the bim pixel of (a cad vector2 with x firstPoint's x and y firstPoint's y) through transform) to rebarInk
                        append (the bim pixel of (a cad vector2 with x lastPoint's x and y lastPoint's y) through transform) to rebarInk
                if spec's id = editor's selectionId:
                    record bim strokes rebarInk coloured 0, 120 and 215 wide 1.5 on canvas
                else:
                    record bim strokes rebarInk coloured 100, 65 and 35 wide 1.0 on canvas
                free rebarInk

# The reinforcement a sheet's plan shows: only what is tagged, and of each
# bar mark one bar, thin and grey, so that the elements and the labels (whose
# leaders point at those same bars, `bim_reinforcement_drawing.dl`) stay
# readable; a floor's mesh is one bar each way instead of a dense grid.
function draw bim tagged reinforcement in plan of {bim editor record:editor} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        set modelValue to editor's documentValue's current
        set rebarInk to an empty list of a cad vector2
        loop tagCursor from 0 to the length of (modelValue's tags's values):
            set tagValue to the item at tagCursor in (modelValue's tags's values)
            set rebarFound to the bim reinforcement index of (tagValue's elementId) in modelValue
            if rebarFound's valid:
                set spec to the bim hostbound reinforcement (the item at (rebarFound's position) in (modelValue's reinforcements's values)) in modelValue
                if (spec's levelId = editor's levelId) and ((bim editor hides (spec's id) in plan of editor) = false):
                    set generated to the bim reinforcement paths of spec in modelValue
                    set drawnMarks to an empty list of a string
                    loop barCursor from 0 to the length of (generated's bars's values):
                        set barValue to the item at barCursor in (generated's bars's values)
                        set seen to false
                        loop markCursor from 0 to the length of drawnMarks:
                            if (the item at markCursor in drawnMarks) = barValue's mark:
                                set seen to true
                        if seen = false:
                            append (barValue's mark) to drawnMarks
                            loop edge from 0 to ((the length of (barValue's points's values)) - 1):
                                set firstPoint to the item at edge in (barValue's points's values)
                                set lastPoint to the item at (edge + 1) in (barValue's points's values)
                                append (the bim pixel of (a cad vector2 with x (firstPoint's x) and y (firstPoint's y)) through transform) to rebarInk
                                append (the bim pixel of (a cad vector2 with x (lastPoint's x) and y (lastPoint's y)) through transform) to rebarInk
                    free drawnMarks
        record bim strokes rebarInk coloured 125, 125 and 125 wide 0.6 on canvas
        free rebarInk

# The drawing type of the plan shown, or the refused id.
function the bim plan drawing type of {bim editor record:editor}:
    execute:
        set found to the bim view index of editor's planViewId in editor's documentValue's current
        if found's valid = false:
            return the bim refused id
        return (the item at found's position in (editor's documentValue's current's views's values))'s drawingTypeId

function the bim height text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.2f", value)
        return the substring of buffer from 0 spanning written bytes

# The annotations the plan's drawing type applies (Drawing Rules), drawn in
# the plan: pile numbers (P1, P2 … in reading order: rows from the top, each
# from the left) and the pile table beside the piles, and beam labels (the
# beam's type at its middle).
function draw bim annotations in plan of {bim editor record:editor} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        set modelValue to editor's documentValue's current
        set typeId to the bim plan drawing type of editor
        if typeId = the bim refused id:
            return nothing
        set numbering to bim annotation bim pile numbers annotation applies to drawing type typeId in modelValue
        set tabling to bim annotation bim pile table annotation applies to drawing type typeId in modelValue
        set labelling to bim annotation bim beam labels annotation applies to drawing type typeId in modelValue
        if ((numbering or tabling) or labelling) = false:
            return nothing
        set storeyLevel to the bim storey elevation of editor
        set pileIds to an empty list of a 64 bit integer
        set pileSpots to an empty list of a cad vector2
        loop cursor from 0 to the length of (modelValue's linears's values):
            set linearValue to the item at cursor in (modelValue's linears's values)
            if linearValue's levelId = editor's levelId:
                set linearType to the bim type of linear linearValue in modelValue
                if linearType's role = bim pile role:
                    append linearValue's id to pileIds
                    append (a cad vector2 with x linearValue's start's x and y linearValue's start's y) to pileSpots
                if labelling and (linearType's role = bim beam role):
                    set middle to a cad vector2 with x ((linearValue's start's x + linearValue's finish's x) * 0.5) and y ((linearValue's start's y + linearValue's finish's y) * 0.5)
                    set labelPixel to the bim pixel of middle through transform
                    set firstPixel to the bim pixel of (a cad vector2 with x linearValue's start's x and y linearValue's start's y) through transform
                    set lastPixel to the bim pixel of (a cad vector2 with x linearValue's finish's x and y linearValue's finish's y) through transform
                    set labelTurn to the bim readable text angle from firstPixel to lastPixel
                    append (@intrinsic("construct", a bim canvas text record, linearType's name, labelPixel's x + (6.0 * (the sine of labelTurn)), labelPixel's y - (6.0 * (the cosine of labelTurn)), 20, 60, 140, true, labelTurn)) to (canvas's texts's values)
        set count to the length of pileIds
        if count = 0:
            free pileIds
            free pileSpots
            return nothing
        # Each pile's number: one more than the piles before it in reading
        # order.
        set numbers to an empty list of an integer
        set highX to -1.0e30
        set highY to -1.0e30
        loop cursor from 0 to count:
            set here to the item at cursor in pileSpots
            set before to 0
            loop otherCursor from 0 to count:
                set there to the item at otherCursor in pileSpots
                set above to there's y > (here's y + 0.001)
                set sameRow to (the absolute value of (there's y - here's y)) <= 0.001
                if above or (sameRow and ((there's x < (here's x - 0.001)) or (((the absolute value of (there's x - here's x)) <= 0.001) and (otherCursor < cursor)))):
                    set before to before + 1
            append (before + 1) to numbers
            set highX to the maximum of highX and here's x
            set highY to the maximum of highY and here's y
        if numbering:
            loop cursor from 0 to count:
                set spot to the bim pixel of (the item at cursor in pileSpots) through transform
                record bim text ((the string form of "P") + (the string form of (the item at cursor in numbers))) at (spot's x + 8.0) and (spot's y - 8.0) coloured 180, 20 and 20 on canvas
        if tabling:
            # The table to the right of the piles, its rows in number order.
            set corner to the bim pixel of (a cad vector2 with x (highX + 2.0) and y highY) through transform
            set rowY to corner's y
            record bim text (the string form of "Pile   Type                    Top      Tip     Length") at corner's x and rowY coloured 0, 0 and 0 on canvas
            loop rank from 1 to count + 1:
                loop cursor from 0 to count:
                    if (the item at cursor in numbers) = rank:
                        set pileFound to the bim linear index of (the item at cursor in pileIds) in modelValue
                        set pileValue to the item at pileFound's position in (modelValue's linears's values)
                        set pileType to the bim type of linear pileValue in modelValue
                        set topLevel to storeyLevel + (the maximum of pileValue's start's z and pileValue's finish's z)
                        set tipLevel to storeyLevel + (the minimum of pileValue's start's z and pileValue's finish's z)
                        set rowY to rowY + 16.0
                        set row to (the string form of "P") + (the string form of rank)
                        record bim text row at corner's x and rowY coloured 0, 0 and 0 on canvas
                        record bim text pileType's name at (corner's x + 42.0) and rowY coloured 0, 0 and 0 on canvas
                        record bim text (the bim height text of topLevel) at (corner's x + 210.0) and rowY coloured 0, 0 and 0 on canvas
                        record bim text (the bim height text of tipLevel) at (corner's x + 265.0) and rowY coloured 0, 0 and 0 on canvas
                        record bim text (the bim height text of (topLevel - tipLevel)) at (corner's x + 320.0) and rowY coloured 0, 0 and 0 on canvas
        free numbers
        free pileIds
        free pileSpots

# Appends, as pixel pairs, the plan pairs `points` (two per segment) dashed
# in pieces of `dash` pixels with gaps as long.
function append bim dashes of {a pointer to a list:points} through {bim drawing transform record:transform} dashing {a 64 bit floating-point number:dash} into {a pointer to a list:pairs}:
    execute:
        set cursor to 0
        loop while (cursor + 1) < the length of points:
            set first to the bim pixel of (the item at cursor in points) through transform
            set second to the bim pixel of (the item at (cursor + 1) in points) through transform
            set total to the cad distance from first to second
            if total > 0.0:
                set ux to (second's x - first's x) / total
                set uy to (second's y - first's y) / total
                set position to 0.0
                loop while position < total:
                    set ending to the minimum of (position + dash) and total
                    append (a cad vector2 with x (first's x + (ux * position)) and y (first's y + (uy * position))) to pairs
                    append (a cad vector2 with x (first's x + (ux * ending)) and y (first's y + (uy * ending))) to pairs
                    set position to ending + dash
            set cursor to cursor + 2

# A NEN 2580 area in square metres with its unit, to two decimals.
function the bim square metres text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%10.2f m2", value)
        return the substring of buffer from 0 spanning written bytes

# The NEN 2580 areas in an area plan (its drawing type's "Areas (NEN 2580)"
# rule): the gross area's bound (BVO, the outer faces) as a heavy red line,
# the usable area's (GO, the outer walls' inner faces) dashed green, and
# beside the storey a table of BVO, GO, NVO and VVO for the storey and for
# the whole building.
function draw bim area measures in plan of {bim editor record:editor} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        set modelValue to editor's documentValue's current
        set areaStandard to the bim drawing standard of modelValue
        set typeId to the bim plan drawing type of editor
        if typeId = the bim refused id:
            return nothing
        if (bim annotation bim area measures annotation applies to drawing type typeId in modelValue) = false:
            return nothing
        set storeyAreas to the bim area measures of modelValue on level editor's levelId using editor's evaluation's index
        set heavy to an empty list of a cad vector2
        set cursor to 0
        loop while (cursor + 1) < the length of (storeyAreas's grossPairs's values):
            append (the bim pixel of (the item at cursor in (storeyAreas's grossPairs's values)) through transform) to heavy
            append (the bim pixel of (the item at (cursor + 1) in (storeyAreas's grossPairs's values)) through transform) to heavy
            set cursor to cursor + 2
        record bim strokes heavy coloured 200, 30 and 30 wide 3.0 on canvas
        free heavy
        set dashLines to an empty list of a cad vector2
        append bim dashes of (storeyAreas's usablePairs's values) through transform dashing 6.0 into dashLines
        record bim strokes dashLines coloured 20, 150 and 60 wide 2.0 on canvas
        free dashLines
        # The building's totals over every storey.
        set totalGross to 0.0
        set totalUsable to 0.0
        set totalNet to 0.0
        set totalLettable to 0.0
        loop levelCursor from 0 to the length of (modelValue's levels's values):
            set storeyMeasures to the bim area measures of modelValue on level (the item at levelCursor in (modelValue's levels's values))'s id using editor's evaluation's index
            set totalGross to totalGross + storeyMeasures's gross
            set totalUsable to totalUsable + storeyMeasures's usable
            set totalNet to totalNet + storeyMeasures's net
            set totalLettable to totalLettable + storeyMeasures's lettable
        # The table above the left of the storey's bound.
        set lowX to 1.0e30
        set highY to -1.0e30
        loop cursor from 0 to the length of (storeyAreas's grossPairs's values):
            set spot to the item at cursor in (storeyAreas's grossPairs's values)
            set lowX to the minimum of lowX and spot's x
            set highY to the maximum of highY and spot's y
        if lowX > 1.0e29:
            return nothing
        set corner to the bim pixel of (a cad vector2 with x lowX and y highY) through transform
        set rowY to corner's y - 110.0
        set storeyName to the string form of ""
        set levelFound to the bim level index of editor's levelId in modelValue
        if levelFound's valid:
            set storeyName to (the item at levelFound's position in (modelValue's levels's values))'s name
        record bim text ((the string form of "NEN 2580  ") + storeyName) at corner's x and rowY coloured 0, 0 and 0 on canvas
        record bim text (the string form of "gebouw") at (corner's x + 300.0) and rowY coloured 0, 0 and 0 on canvas
        set rowY to rowY + 18.0
        record bim text (the string form of "BVO  bruto vloeroppervlakte") at corner's x and rowY coloured 200, 30 and 30 on canvas
        record bim text (the bim decimal text (the bim square metres text of storeyAreas's gross) under areaStandard) at (corner's x + 190.0) and rowY coloured 0, 0 and 0 on canvas
        record bim text (the bim decimal text (the bim square metres text of totalGross) under areaStandard) at (corner's x + 300.0) and rowY coloured 0, 0 and 0 on canvas
        set rowY to rowY + 18.0
        record bim text (the string form of "GO   gebruiksoppervlakte") at corner's x and rowY coloured 20, 150 and 60 on canvas
        record bim text (the bim decimal text (the bim square metres text of storeyAreas's usable) under areaStandard) at (corner's x + 190.0) and rowY coloured 0, 0 and 0 on canvas
        record bim text (the bim decimal text (the bim square metres text of totalUsable) under areaStandard) at (corner's x + 300.0) and rowY coloured 0, 0 and 0 on canvas
        set rowY to rowY + 18.0
        record bim text (the string form of "NVO  netto vloeroppervlakte") at corner's x and rowY coloured 35, 48 and 70 on canvas
        record bim text (the bim decimal text (the bim square metres text of storeyAreas's net) under areaStandard) at (corner's x + 190.0) and rowY coloured 0, 0 and 0 on canvas
        record bim text (the bim decimal text (the bim square metres text of totalNet) under areaStandard) at (corner's x + 300.0) and rowY coloured 0, 0 and 0 on canvas
        set rowY to rowY + 18.0
        record bim text (the string form of "VVO  verhuurbaar vloeropp.") at corner's x and rowY coloured 120, 60 and 160 on canvas
        record bim text (the bim decimal text (the bim square metres text of storeyAreas's lettable) under areaStandard) at (corner's x + 190.0) and rowY coloured 0, 0 and 0 on canvas
        record bim text (the bim decimal text (the bim square metres text of totalLettable) under areaStandard) at (corner's x + 300.0) and rowY coloured 0, 0 and 0 on canvas

# Model-space outlines, not a scaled screenshot/canvas. Reprojecting them
# retains the original pixel widths, dashes, text and screen-size detail.
class:
    patterns:
        [a|] bim curtain plan outline record
    members:
        points as the type of (a cad topology list of a cad vector2)
        high as a 64 bit floating-point number

class:
    patterns:
        [a|] bim curtain plan cache record
    members:
        key as a string
        outlines as the type of (a cad topology list of a bim curtain plan outline record)
        builds as an integer

function an empty bim curtain plan cache:
    execute:
        return @intrinsic("construct", a bim curtain plan cache record, (the string form of "unrecorded"), (a cad topology list of a bim curtain plan outline record), 0)

function the bim curtain plan key of {bim editor record:editor} at {a 64 bit floating-point number:scale}:
    execute:
        set cacheKey to the bim plan key of editor at 1.0
        set cacheKey to (cacheKey + (the string form of " hidden ")) + (the bim hidden key in view editor's planViewId among (editor's hiddenElements's values))
        return (cacheKey + (the string form of " trim ")) + (the string form of (bim window detail (the string form of "Glazing bead") is resolved at scale))

function the bim curtain plan outlines of {bim editor record:editor} at {a 64 bit floating-point number:scale}:
    execute:
        set modelValue to editor's documentValue's current
        set planOutlines to a cad topology list of a bim curtain plan outline record
        if (bim category bim wall category is visible in editor's planRules) = false:
            return planOutlines
        loop systemCursor from 0 to the length of (modelValue's curtains's values):
            set systemValue to the item at systemCursor in (modelValue's curtains's values)
            if ((the bim placed system systemValue in modelValue)'s curtain's levelId = editor's levelId) and ((bim editor hides systemValue's id in plan of editor) = false):
                set glazingDetail to bim window detail (the string form of "Glazing bead") is resolved at scale
                set systemParts to the bim parts of curtain wall systemValue in modelValue with glazing detail glazingDetail
                set visibleParts to a cad topology list of a bim stair part record
                loop partCursor from 0 to the length of (systemParts's values):
                    set systemPart to the item at partCursor in (systemParts's values)
                    if bim window detail systemPart's kind's name is resolved at scale:
                        append systemPart to (visibleParts's values)
                set partCuts to the bim end cuts of parts (visibleParts's values) in modelValue
                loop partCursor from 0 to the length of (visibleParts's values):
                    set systemPart to the item at partCursor in (visibleParts's values)
                    set outlineValue to the bim plan outline of linear systemPart's element typed systemPart's kind in modelValue cut by (the item at partCursor in (partCuts's values))
                    set points to a cad topology list of a cad vector2
                    loop cornerCursor from 0 to the length of outlineValue:
                        append (the item at cornerCursor in outlineValue) to (points's values)
                    set heights to the bim height range of linear systemPart's element typed systemPart's kind in modelValue
                    append (@intrinsic("construct", a bim curtain plan outline record, points, heights's y)) to (planOutlines's values)
                    free outlineValue
        return planOutlines

# Projection stays live: line widths and dash lengths are still in pixels.
function append bim plan ring {a pointer to a list:ringValue} high {a 64 bit floating-point number:highValue} cut at {a 64 bit floating-point number:cutHeight} through {bim drawing transform record:transform} into {a pointer to a list:solid} and {a pointer to a list:dashed}:
    execute:
        loop corner from 0 to the length of ringValue:
            set edgeFrom to the bim pixel of (the item at corner in ringValue) through transform
            set edgeTo to the bim pixel of (the item at (the remainder of (corner + 1) divided by (the length of ringValue)) in ringValue) through transform
            if highValue <= cutHeight:
                append edgeFrom to solid
                append edgeTo to solid
            else:
                set total to the cad distance from edgeFrom to edgeTo
                set position to 0.0
                loop while (total > 0.0) and (position < total):
                    set ending to the minimum of (position + 5.0) and total
                    append (a cad vector2 with x (edgeFrom's x + (((edgeTo's x - edgeFrom's x) * position) / total)) and y (edgeFrom's y + (((edgeTo's y - edgeFrom's y) * position) / total))) to dashed
                    append (a cad vector2 with x (edgeFrom's x + (((edgeTo's x - edgeFrom's x) * ending) / total)) and y (edgeFrom's y + (((edgeTo's y - edgeFrom's y) * ending) / total))) to dashed
                    set position to ending + 3.0

# The outlines of derived linear parts in plan: those wholly under the cut
# into `solid`, the others dashed into `dashed`.
function append bim plan edges of parts {a pointer to a list:partList} in {bim model record:modelValue} cut at {a 64 bit floating-point number:cutHeight} through {bim drawing transform record:transform} into {a pointer to a list:solid} and {a pointer to a list:dashed}:
    execute:
        # Tiny glazing trim is invisible at overview scales, but feeding it
        # into the all-pairs join solver makes every wheel event expensive.
        set visibleParts to a cad topology list of a bim stair part record
        loop partCursor from 0 to the length of partList:
            set part to the item at partCursor in partList
            if bim window detail part's kind's name is resolved at transform's scale:
                append part to (visibleParts's values)
        set partCuts to the bim end cuts of parts (visibleParts's values) in modelValue
        loop partCursor from 0 to the length of (visibleParts's values):
            set part to the item at partCursor in (visibleParts's values)
            set ringValue to the bim plan outline of linear part's element typed part's kind in modelValue cut by (the item at partCursor in (partCuts's values))
            set heights to the bim height range of linear part's element typed part's kind in modelValue
            append bim plan ring ringValue high heights's y cut at cutHeight through transform into solid and dashed
            free ringValue

# The stairs of the active storey in plan, from their derived parts: treads
# under the cut drawn, treads above it dashed, the stringers thin, and the
# walking line from the foot with an arrow at the head.
function draw bim stairs in plan of {bim editor record:editor} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        set cache to an empty bim curtain plan cache
        draw bim stairs in plan of editor through transform on canvas keeping (the address of cache)

# The native plan owns a persistent cache; sheet/export and inset callers
# keep the original entry point and its fresh, independent lifetime.
function draw bim stairs in plan of {bim editor record:editor} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas} keeping {a pointer to a bim curtain plan cache record:cache}:
    execute:
        set modelValue to editor's documentValue's current
        if (bim category bim stair category is visible in editor's planRules) = false:
            return nothing
        set cutHeight to (the bim storey elevation of editor) + (the bim plan cut height of editor)
        set solidEdges to an empty list of a cad vector2
        set dashedEdges to an empty list of a cad vector2
        set walkEdges to an empty list of a cad vector2
        loop cursor from 0 to the length of (modelValue's stairs's values):
            set stairValue to the item at cursor in (modelValue's stairs's values)
            if (stairValue's levelId = editor's levelId) and ((bim editor hides (stairValue's id) in plan of editor) = false):
                set stairParts to the bim parts of stair stairValue in modelValue
                append bim plan edges of parts (stairParts's values) in modelValue cut at cutHeight through transform into solidEdges and dashedEdges
                # The walking line, its arrow at the head of the run.
                set footPixel to the bim pixel of stairValue's start through transform
                set headPixel to the bim pixel of stairValue's finish through transform
                append footPixel to walkEdges
                append headPixel to walkEdges
                set span to the cad distance from footPixel to headPixel
                if span > 12.0:
                    set ux to (headPixel's x - footPixel's x) / span
                    set uy to (headPixel's y - footPixel's y) / span
                    append headPixel to walkEdges
                    append (a cad vector2 with x ((headPixel's x - (ux * 10.0)) - (uy * 5.0)) and y ((headPixel's y - (uy * 10.0)) + (ux * 5.0))) to walkEdges
                    append headPixel to walkEdges
                    append (a cad vector2 with x ((headPixel's x - (ux * 10.0)) + (uy * 5.0)) and y ((headPixel's y - (uy * 10.0)) - (ux * 5.0))) to walkEdges
        # Rebuild model-space system outlines only for a model/view change
        # or the existing subpixel glazing-detail threshold, not every wheel.
        set cacheKey to the bim curtain plan key of editor at transform's scale
        if cacheKey != cache's key:
            set cache's outlines to the bim curtain plan outlines of editor at transform's scale
            set cache's key to cacheKey
            set cache's builds to cache's builds + 1
        loop outlineCursor from 0 to the length of (cache's outlines's values):
            set cachedOutline to the item at outlineCursor in (cache's outlines's values)
            append bim plan ring (cachedOutline's points's values) high cachedOutline's high cut at cutHeight through transform into solidEdges and dashedEdges
        # Railings: their posts and rails, in the same way.
        if bim category bim railing category is visible in editor's planRules:
            loop cursor from 0 to the length of (modelValue's railings's values):
                set railingValue to the item at cursor in (modelValue's railings's values)
                if (railingValue's levelId = editor's levelId) and ((bim editor hides (railingValue's id) in plan of editor) = false):
                    set railingParts to the bim parts of railing railingValue in modelValue
                    append bim plan edges of parts (railingParts's values) in modelValue cut at cutHeight through transform into solidEdges and dashedEdges
        record bim strokes solidEdges coloured 0, 0 and 0 wide 0.7 on canvas
        record bim strokes dashedEdges coloured 0, 0 and 0 wide 0.7 on canvas
        record bim strokes walkEdges coloured 0, 0 and 0 wide 1.0 on canvas
        free solidEdges
        free dashedEdges
        free walkEdges

# The associative dimensions of the active storey in the plan, as in Open 2D
# Studio: the dimension line, extension lines from the measured features, a
# 45-degree tick at each end and the value in millimetres over the middle.
function draw bim dimensions in plan of {bim editor record:editor} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        set modelValue to editor's documentValue's current
        if (the length of (modelValue's dimensions's values)) = 0:
            return nothing
        set index to the bim join index of modelValue
        set drawingStandard to the bim drawing standard of modelValue
        set dimensionLines to an empty list of a cad vector2
        set dimensionTicks to an empty list of a cad vector2
        loop cursor from 0 to the length of (modelValue's dimensions's values):
            set dimensionValue to the item at cursor in (modelValue's dimensions's values)
            set onStorey to false
            set wallFound to the bim wall index of dimensionValue's first's elementId in modelValue
            if wallFound's valid:
                set onStorey to (the item at wallFound's position in (modelValue's walls's values))'s levelId = editor's levelId
            set openingFound to the bim opening index of dimensionValue's first's elementId in modelValue
            if openingFound's valid:
                set hostFound to the bim wall index of (the item at openingFound's position in (modelValue's openings's values))'s hostId in modelValue
                if hostFound's valid:
                    set onStorey to (the item at hostFound's position in (modelValue's walls's values))'s levelId = editor's levelId
            # Grids run through every storey.
            if dimensionValue's first's feature = bim grid line feature:
                set onStorey to (the bim grid index of dimensionValue's first's elementId in modelValue)'s valid
            if onStorey:
                set shape to the bim dimension line of dimensionValue in modelValue using index
                if shape's valid:
                    append bim dimension shape shape through transform into dimensionLines and dimensionTicks under drawingStandard scaled (the bim symbol scale of (@intrinsic("dereference", canvas)))
                    set middle to the bim pixel of (a cad vector2 with x ((shape's start's x + shape's finish's x) * 0.5) and y ((shape's start's y + shape's finish's y) * 0.5)) through transform
                    record bim dimension text (the bim decimal text (the bim millimetre text of shape's value) under drawingStandard) between (the bim pixel of shape's start through transform) and (the bim pixel of shape's finish through transform) on canvas
        record bim strokes dimensionLines coloured 0, 0 and 0 wide 0.7 on canvas
        record bim strokes dimensionTicks coloured 0, 0 and 0 wide 1.4 on canvas
        free dimensionLines
        free dimensionTicks

# The tags of the active storey: the type's name centred at the tag's place,
# with a thin leader to the element when the tag stands more than 0.9 m away.
function draw bim tags in plan of {bim editor record:editor} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        set modelValue to editor's documentValue's current
        set leaders to an empty list of a cad vector2
        set reinforcementLabels to the bim reinforcement plan labels of modelValue ascii false
        loop labelIndex from 0 to the length of (reinforcementLabels's labels's values):
            set labelValue to the item at labelIndex in (reinforcementLabels's labels's values)
            if labelValue's levelId = editor's levelId:
                set placePixel to the bim pixel of labelValue's place through transform
                set textPixel to a cad vector2 with x placePixel's x and y (placePixel's y + ((labelValue's lineIndex as a 64 bit floating-point number) * 16.0))
                record bim centred text labelValue's text at textPixel's x and (textPixel's y + 4.0) coloured 0, 0 and 0 on canvas
                set fromPixel to the bim pixel of (a cad vector2 with x labelValue's anchor's x and y labelValue's anchor's y) through transform
                set gap to the cad distance from fromPixel to textPixel
                if gap > 14.0:
                    append fromPixel to leaders
                    append (a cad vector2 with x (textPixel's x + (((fromPixel's x - textPixel's x) / gap) * 10.0)) and y (textPixel's y + (((fromPixel's y - textPixel's y) / gap) * 10.0))) to leaders
        loop cursor from 0 to the length of (modelValue's tags's values):
            set tagValue to the item at cursor in (modelValue's tags's values)
            set target to the bim tag anchor of tagValue's elementId in modelValue
            set isReinforcement to (the bim reinforcement index of tagValue's elementId in modelValue)'s valid
            if (target's valid and (target's levelId = editor's levelId)) and ((isReinforcement = false) or (reinforcementLabels's valid = false)):
                set textPixel to the bim pixel of tagValue's place through transform
                set tagText to the bim tag text of tagValue's elementId in modelValue
                if isReinforcement:
                    set tagText to the string form of "Reinforcement labels unavailable: invalid geometry"
                # Only the anchor and direction follow model coordinates.
                # Canvas text retains its fixed screen/export text height.
                set tagFirst to a cad vector2 with x 0.0 and y 0.0
                set tagLast to a cad vector2 with x 1.0 and y 0.0
                set linearFound to the bim linear index of tagValue's elementId in modelValue
                if linearFound's valid:
                    set taggedLinear to the item at linearFound's position in (modelValue's linears's values)
                    if (the bim type of linear taggedLinear in modelValue)'s role = bim beam role:
                        set firstPixel to the bim pixel of (a cad vector2 with x taggedLinear's start's x and y taggedLinear's start's y) through transform
                        set lastPixel to the bim pixel of (a cad vector2 with x taggedLinear's finish's x and y taggedLinear's finish's y) through transform
                        set tagFirst to firstPixel
                        set tagLast to lastPixel
                record bim member tag tagText at (a cad vector2 with x textPixel's x and y (textPixel's y + 4.0)) along tagFirst to tagLast on canvas
                if (the cad distance from target's origin to tagValue's place) > 0.9:
                    set fromPixel to the bim pixel of target's origin through transform
                    set gap to the cad distance from fromPixel to textPixel
                    if gap > 14.0:
                        append fromPixel to leaders
                        append (a cad vector2 with x (textPixel's x + (((fromPixel's x - textPixel's x) / gap) * 10.0)) and y (textPixel's y + (((fromPixel's y - textPixel's y) / gap) * 10.0))) to leaders
        record bim strokes leaders coloured 0, 0 and 0 wide 0.5 on canvas
        free leaders

# The strokes of one dimension in pixels: its line and extension lines into
# `lines`, its two ticks into `ticks`.
function append bim dimension shape {bim dimension line record:shape} through {bim drawing transform record:transform} into {a pointer to a list:lines} and {a pointer to a list:ticks}:
    execute:
        append bim dimension shape shape through transform into lines and ticks under (bim nen standard)

# The same, its ends as drawing standard `standardCode` draws them.
function append bim dimension shape {bim dimension line record:shape} through {bim drawing transform record:transform} into {a pointer to a list:lines} and {a pointer to a list:ticks} under {integer:standardCode}:
    execute:
        append bim dimension shape shape through transform into lines and ticks under standardCode scaled 1.0

function append bim dimension shape {bim dimension line record:shape} through {bim drawing transform record:transform} into {a pointer to a list:lines} and {a pointer to a list:ticks} under {integer:standardCode} scaled {a 64 bit floating-point number:symbolScale}:
    execute:
        set startPixel to the bim pixel of shape's start through transform
        set finishPixel to the bim pixel of shape's finish through transform
        append startPixel to lines
        append finishPixel to lines
        set startFootPixel to the bim pixel of shape's startFoot through transform
        set finishFootPixel to the bim pixel of shape's finishFoot through transform
        if (the cad distance from startFootPixel to startPixel) > (4.0 * symbolScale):
            append startFootPixel to lines
            append startPixel to lines
        if (the cad distance from finishFootPixel to finishPixel) > (4.0 * symbolScale):
            append finishFootPixel to lines
            append finishPixel to lines
        set span to the cad distance from startPixel to finishPixel
        if span > 0.5:
            append bim dimension ends at startPixel and finishPixel along ((finishPixel's x - startPixel's x) / span) and ((finishPixel's y - startPixel's y) / span) under standardCode scaled symbolScale into ticks

# The instances of components with solid parts on the active storey, in the
# plan from their placed meshes (`sceneMeshes`), as `append bim plan lines of`
# draws meshes.
function draw bim folded components in plan of {bim editor record:editor} among {a pointer to a list:sceneMeshes} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        set modelValue to editor's documentValue's current
        set foldedMeshes to a cad topology list of a bim scene mesh record
        loop cursor from 0 to the length of sceneMeshes:
            set entry to the item at cursor in sceneMeshes
            set placementFound to the bim instance index of entry's elementId in modelValue
            if placementFound's valid and ((bim editor hides (entry's elementId) in plan of editor) = false):
                set placement to the item at placementFound's position in (modelValue's instances's values)
                set definitionFound to the bim component index of placement's componentId in modelValue
                if (placement's levelId = editor's levelId) and definitionFound's valid:
                    if bim component (the item at definitionFound's position in (modelValue's components's values)) is folded:
                        append entry to (foldedMeshes's values)
        set cutLines to an empty list of a cad vector2
        set belowLines to an empty list of a cad vector2
        append bim plan lines of (foldedMeshes's values) cut at ((the bim storey elevation of editor) + (the bim plan cut height of editor)) into cutLines and belowLines
        record bim plan lines cutLines and belowLines through transform on canvas
        free belowLines
        free cutLines

# Appends, as pairs of plan points, where the horizontal plane at `cutHeight`
# passes through the scene meshes `sceneMeshes` (each triangle it crosses
# gives one segment) to `cutLines`, and their feature edges below it to
# `belowLines`. The plan draws meshes this way, components and imported
# elements alike.
function append bim plan lines of {a pointer to a list:sceneMeshes} cut at {a 64 bit floating-point number:cutHeight} into {a pointer to a list:cutLines} and {a pointer to a list:belowLines}:
    execute:
        loop cursor from 0 to the length of sceneMeshes:
            set entry to the item at cursor in sceneMeshes
            set points to entry's shape's positions's values
            set triangleCorners to entry's shape's triangles's values
            set triangle to 0
            loop while (triangle + 2) < the length of triangleCorners:
                set crossings to an empty list of a cad vector2
                loop side from 0 to 3:
                    set from to the item at (the item at (triangle + side) in triangleCorners) in points
                    set onto to the item at (the item at (triangle + (the remainder of (side + 1) divided by 3)) in triangleCorners) in points
                    if ((from's z - cutHeight) * (onto's z - cutHeight)) < 0.0:
                        set fraction to (cutHeight - from's z) / (onto's z - from's z)
                        append (a cad vector2 with x (from's x + ((onto's x - from's x) * fraction)) and y (from's y + ((onto's y - from's y) * fraction))) to crossings
                if (the length of crossings) = 2:
                    append (the item at 0 in crossings) to cutLines
                    append (the item at 1 in crossings) to cutLines
                free crossings
                set triangle to triangle + 3
            set features to an empty list of a cad vector3
            append bim feature edges of entry's shape to features
            set featureCursor to 0
            loop while (featureCursor + 1) < the length of features:
                set from to the item at featureCursor in features
                set onto to the item at (featureCursor + 1) in features
                if (from's z <= cutHeight) or (onto's z <= cutHeight):
                    if from's z > cutHeight:
                        set from to the cad sum of onto and ((the cad difference of from and onto) scaled by ((cutHeight - onto's z) / (from's z - onto's z)))
                    if onto's z > cutHeight:
                        set onto to the cad sum of from and ((the cad difference of onto and from) scaled by ((cutHeight - from's z) / (onto's z - from's z)))
                    append (a cad vector2 with x from's x and y from's y) to belowLines
                    append (a cad vector2 with x onto's x and y onto's y) to belowLines
                set featureCursor to featureCursor + 2
            free features

# Records the plan lines of `append bim plan lines of`: the cut black, the
# edges below it thin and grey, as the plan shows linear elements.
function record bim plan lines {a pointer to a list:cutLines} and {a pointer to a list:belowLines} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        set belowPixels to an empty list of a cad vector2
        loop cursor from 0 to the length of belowLines:
            append (the bim pixel of (the item at cursor in belowLines) through transform) to belowPixels
        set cutPixels to an empty list of a cad vector2
        loop cursor from 0 to the length of cutLines:
            append (the bim pixel of (the item at cursor in cutLines) through transform) to cutPixels
        record bim strokes belowPixels coloured 80, 80 and 80 wide 0.7 on canvas
        record bim strokes cutPixels coloured 0, 0 and 0 wide 1.4 on canvas
        free belowPixels
        free cutPixels

# The sketch elements of the active storey in the plan: faces filled (masses
# a shade darker), with their outlines, lines, and texts; following the plan's
# rules for lines, texts and masses.
function draw bim sketches of {bim editor record:editor} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas} using {bim text atlas record:typeface}:
    execute:
        draw bim sketches of editor through transform on canvas using typeface referencing true

function draw bim sketches of {bim editor record:editor} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas} using {bim text atlas record:typeface} referencing {boolean:includeReferences}:
    execute:
        if includeReferences:
            record cached bim vectors of view editor's planViewId in editor's vectorCache through transform on canvas
        set drawn to the bim drawn sketches of editor's documentValue's current seen from view editor's planViewId
        set elements to drawn's values
        set flatFill to an empty list of a cad vector2
        set massFill to an empty list of a cad vector2
        set edges to an empty list of a cad vector2
        set strokes to an empty list of a cad vector2
        loop cursor from 0 to the length of elements:
            set element to the item at cursor in elements
            if (element's levelId = editor's levelId) and ((bim editor hides (element's id) in plan of editor) = false):
                set ring to element's points's values
                if (element's kind = bim image sketch) and (bim category bim mass category is visible in editor's planRules):
                    set corners to a cad topology list of a cad vector2
                    loop imageCorner from 0 to 4:
                        append (the bim pixel of (the item at (3 - imageCorner) in ring) through transform) to (corners's values)
                    append (@intrinsic("construct", a bim canvas image record, element's content, corners)) to (canvas's images's values)
                if (element's kind = bim face sketch) and (bim category bim mass category is visible in editor's planRules):
                    set rings to an empty list of the type of (an empty list of a cad vector2)
                    append ring to rings
                    if element's height > 0.0:
                        append bim fill of rings through transform to massFill
                    else:
                        append bim fill of rings through transform to flatFill
                    free rings
                    loop corner from 0 to the length of ring:
                        append (the bim pixel of (the item at corner in ring) through transform) to edges
                        append (the bim pixel of (the item at (the remainder of (corner + 1) divided by (the length of ring)) in ring) through transform) to edges
                if (element's kind = bim line sketch) and (bim category bim line category is visible in editor's planRules):
                    append (the bim pixel of (the item at 0 in ring) through transform) to strokes
                    append (the bim pixel of (the item at 1 in ring) through transform) to strokes
        # Free meshes, seen from above: their faces turned up filled as
        # masses, and every edge.
        if bim category bim mass category is visible in editor's planRules:
            loop cursor from 0 to the length of (editor's documentValue's current's meshes's values):
                set meshValue to the item at cursor in (editor's documentValue's current's meshes's values)
                if (meshValue's levelId = editor's levelId) and ((bim editor hides (meshValue's id) in plan of editor) = false):
                    set start to 0
                    loop while start < the length of (meshValue's faces's values):
                        set faceRing to the bim plan outline of mesh face start of meshValue
                        if (the bim normal of mesh face start of meshValue)'s z > 1e-6:
                            set rings to an empty list of the type of (an empty list of a cad vector2)
                            append faceRing to rings
                            append bim fill of rings through transform to massFill
                            free rings
                        loop corner from 0 to the length of faceRing:
                            append (the bim pixel of (the item at corner in faceRing) through transform) to edges
                            append (the bim pixel of (the item at (the remainder of (corner + 1) divided by (the length of faceRing)) in faceRing) through transform) to edges
                        free faceRing
                        set start to start + ((the item at start in (meshValue's faces's values)) + 1)
        record bim triangles flatFill coloured 232, 234 and 238 on canvas
        record bim triangles massFill coloured 206, 210 and 218 on canvas
        record bim strokes edges coloured 120, 126 and 140 wide 1.0 on canvas
        record bim strokes strokes coloured 30, 34 and 44 wide 1.5 on canvas
        free flatFill
        free massFill
        free edges
        free strokes
        if bim category bim text category is visible in editor's planRules:
            loop cursor from 0 to the length of elements:
                set element to the item at cursor in elements
                if (element's levelId = editor's levelId) and (element's kind = bim text sketch):
                    set anchor to the bim pixel of (the item at 0 in (element's points's values)) through transform
                    record bim text element's content at anchor's x and anchor's y coloured 20, 24 and 34 on canvas

# The glyph of a snap kind, in the colours of Open 2D Studio: end point a
# green square, mid point a cyan triangle, intersection a yellow cross,
# perpendicular an orange foot, nearest a pink diamond; tracking (horizontal,
# vertical, polar) a dashed ray from where it tracks from.
# The colour of a snap kind, as Open 2D Studio marks it (`SnapLayer.ts`):
# end point green, mid point cyan, intersection yellow, perpendicular and
# parallel orange, nearest pink; tracking (horizontal, vertical, polar) green
# and extension yellow, as their tracking lines.
function the bim snap colour of {a string:label}:
    execute:
        if label = "End point":
            return a cad vector3 with x 0.0, y 255.0 and z 0.0
        if label = "Mid point":
            return a cad vector3 with x 0.0, y 255.0 and z 255.0
        if label = "Intersection":
            return a cad vector3 with x 255.0, y 255.0 and z 0.0
        if (label = "Perpendicular") or (label = "Parallel"):
            return a cad vector3 with x 255.0, y 136.0 and z 0.0
        if label = "Nearest":
            return a cad vector3 with x 255.0, y 136.0 and z 255.0
        if label = "Extension":
            return a cad vector3 with x 255.0, y 255.0 and z 0.0
        return a cad vector3 with x 0.0, y 255.0 and z 136.0

function append bim glyph edge from {a 64 bit floating-point number:x1} {a 64 bit floating-point number:y1} to {a 64 bit floating-point number:x2} {a 64 bit floating-point number:y2} into {a pointer to a list:pairs}:
    execute:
        append (a cad vector2 with x x1 and y y1) to pairs
        append (a cad vector2 with x x2 and y y2) to pairs

# Strokes `pairs` three times, as Open 2D Studio draws a snap marker: a soft
# dark halo 5.5 pixels wide, a black outline of 3.5 and the colour at 1.8.
function draw bim marker strokes {a pointer to a list:pairs} coloured {cad vector3:colour} in {graphics frame:frame}:
    execute:
        start triangles in frame
        loop pass from 0 to 3:
            set breadth to 1.8
            if pass = 0:
                use vertex color red 0, green 0, blue 0 and alpha 89 in frame
                set breadth to 5.5
            else if pass = 1:
                use vertex color red 0, green 0 and blue 0 in frame
                set breadth to 3.5
            else:
                use vertex color red (colour's x as an integer), green (colour's y as an integer) and blue (colour's z as an integer) in frame
            set cursor to 0
            loop while (cursor + 1) < the length of pairs:
                set edgeFrom to the item at cursor in pairs
                set edgeTo to the item at (cursor + 1) in pairs
                # Each piece reaches half a width past its ends, so that the
                # corners close as round caps would.
                set run to the cad distance from edgeFrom to edgeTo
                if run > 1e-9:
                    set reachX to ((edgeTo's x - edgeFrom's x) / run) * (breadth * 0.5)
                    set reachY to ((edgeTo's y - edgeFrom's y) / run) * (breadth * 0.5)
                    add bim stroke from (a cad vector2 with x (edgeFrom's x - reachX) and y (edgeFrom's y - reachY)) to (a cad vector2 with x (edgeTo's x + reachX) and y (edgeTo's y + reachY)) wide breadth in frame
                set cursor to cursor + 2
        finish triangles in frame

# A dashed line of 6 pixels with gaps of 4, one pixel wide.
function draw bim tracking line from {cad vector2:first} to {cad vector2:second} coloured {cad vector3:colour} in {graphics frame:frame}:
    execute:
        set total to the cad distance from first to second
        if total <= 0.0:
            return nothing
        set ux to (second's x - first's x) / total
        set uy to (second's y - first's y) / total
        start triangles in frame
        use vertex color red (colour's x as an integer), green (colour's y as an integer), blue (colour's z as an integer) and alpha 230 in frame
        set position to 0.0
        loop while position < total:
            set ending to the minimum of (position + 6.0) and total
            add bim stroke from (a cad vector2 with x (first's x + (ux * position)) and y (first's y + (uy * position))) to (a cad vector2 with x (first's x + (ux * ending)) and y (first's y + (uy * ending))) wide 1.0 in frame
            set position to ending + 4.0
        set ring to an empty list of a cad vector2
        append bim circle at first radius 3.0 into ring
        set cursor to 0
        loop while (cursor + 1) < the length of ring:
            add bim stroke from (the item at cursor in ring) to (the item at (cursor + 1) in ring) wide 1.0 in frame
            set cursor to cursor + 2
        free ring
        finish triangles in frame

# The marker of snap `label` at `spot` (pixels), 12 pixels across, with a
# tracking line from `tracker` for tracking, extension and parallel snaps,
# and its name in a dark box beside it, as in Open 2D Studio.
function draw bim snap glyph {a string:label} at {cad vector2:spot} from {bim snap candidate record:tracker} in {bim screen layout record:layout} with {bim camera record:camera} using {bim text atlas record:typeface} in {graphics frame:frame}:
    execute:
        set x to spot's x
        set y to spot's y
        set half to 6.0
        set colour to the bim snap colour of label
        set pairs to an empty list of a cad vector2
        set tracking to ((label = "Horizontal") or (label = "Vertical")) or (((label = "Polar 45") or (label = "Extension")) or (label = "Parallel"))
        if tracking and tracker's found:
            draw bim tracking line from (the bim plan pixel of tracker's point in layout with camera) to spot coloured colour in frame
        if label = "End point":
            append bim glyph edge from (x - half) (y - half) to (x + half) (y - half) into pairs
            append bim glyph edge from (x + half) (y - half) to (x + half) (y + half) into pairs
            append bim glyph edge from (x + half) (y + half) to (x - half) (y + half) into pairs
            append bim glyph edge from (x - half) (y + half) to (x - half) (y - half) into pairs
        else if label = "Mid point":
            append bim glyph edge from (x) (y - half) to (x + half) (y + half) into pairs
            append bim glyph edge from (x + half) (y + half) to (x - half) (y + half) into pairs
            append bim glyph edge from (x - half) (y + half) to (x) (y - half) into pairs
        else if label = "Intersection":
            append bim glyph edge from (x - half) (y - half) to (x + half) (y + half) into pairs
            append bim glyph edge from (x + half) (y - half) to (x - half) (y + half) into pairs
        else if label = "Perpendicular":
            append bim glyph edge from (x - half) (y + half) to (x + half) (y + half) into pairs
            append bim glyph edge from (x - half) (y + half) to (x - half) (y - half) into pairs
            append bim glyph edge from (x - half) (y) to (x - (half * 0.5)) (y) into pairs
            append bim glyph edge from (x - (half * 0.5)) (y) to (x - (half * 0.5)) (y + half) into pairs
        else if label = "Parallel":
            append bim glyph edge from (x - half) (y + (half * 0.4)) to (x + (half * 0.4)) (y - half) into pairs
            append bim glyph edge from (x - (half * 0.4)) (y + half) to (x + half) (y - (half * 0.4)) into pairs
        else if label = "Nearest":
            append bim glyph edge from (x - half) (y) to (x) (y - half) into pairs
            append bim glyph edge from (x) (y - half) to (x + half) (y) into pairs
            append bim glyph edge from (x + half) (y) to (x) (y + half) into pairs
            append bim glyph edge from (x) (y + half) to (x - half) (y) into pairs
        else:
            # A tracking point: a cross with a ring.
            set colour to a cad vector3 with x 0.0, y 255.0 and z 255.0
            append bim glyph edge from (x - 8.0) (y) to (x + 8.0) (y) into pairs
            append bim glyph edge from (x) (y - 8.0) to (x) (y + 8.0) into pairs
            append bim circle at spot radius 4.0 into pairs
        draw bim marker strokes pairs coloured colour in frame
        free pairs
        # The name, in the snap's colour on a dark box at (+12, -12).
        set textWidth to the bim text width of label in face (bim text caption) of typeface
        set boxLeft to x + 12.0
        set boxTop to (y - 12.0) - 14.0
        start triangles in frame
        use vertex color red 0, green 0, blue 0 and alpha 204 in frame
        add a vertex at x boxLeft and y boxTop to frame
        add a vertex at x ((boxLeft + textWidth) + 8.0) and y boxTop to frame
        add a vertex at x ((boxLeft + textWidth) + 8.0) and y (boxTop + 18.0) to frame
        add a vertex at x boxLeft and y boxTop to frame
        add a vertex at x ((boxLeft + textWidth) + 8.0) and y (boxTop + 18.0) to frame
        add a vertex at x boxLeft and y (boxTop + 18.0) to frame
        finish triangles in frame
        draw bim text label at (boxLeft + 4.0) and (boxTop + 13.0) in face (bim text caption) with typeface coloured (colour's x as an integer), (colour's y as an integer) and (colour's z as an integer) in frame

# The chosen part of the selected building system, or not valid: the system
# and the part's box along its line and above its storey.
class:
    patterns:
        [a|] bim chosen part record
    members:
        valid as a boolean
        curtain as a bim curtain record
        box as a bim system part box record
        elevation as a 64 bit floating-point number

function the bim chosen part of {bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        set zero to a cad vector2 with x 0.0 and y 0.0
        set nothingBox to @intrinsic("construct", a bim system part box record, zero, zero)
        set found to the bim curtain index of editor's selectionId in modelValue
        if ((editor's selectionKind != bim curtain picked) or (editor's partCode < 0)) or (found's valid = false):
            set noCurtain to @intrinsic("construct", a bim curtain record, the bim refused id, the bim refused id, zero, zero, 0.0, 1.0, 1.0, the string form of "", 0.0)
            return @intrinsic("construct", a bim chosen part record, false, noCurtain, nothingBox, 0.0)
        # Where the system stands (in a wall's opening, nested, a layer):
        # its line, storey and foot as placed.
        set placement to the bim placed system (the item at found's position in (modelValue's curtains's values)) in modelValue
        set curtainValue to placement's curtain
        set storeyLevel to placement's lift
        set levelFound to the bim level index of curtainValue's levelId in modelValue
        if levelFound's valid:
            set storeyLevel to (the item at levelFound's position in (modelValue's levels's values))'s elevation + placement's lift
        return @intrinsic("construct", a bim chosen part record, true, curtainValue, the bim system part box of curtainValue coded editor's partCode in editor's documentValue's current, storeyLevel)

# The four corners of the chosen part in the model, in the order low-along
# low-up, high-along low-up, high-along high-up, low-along high-up: along
# the system's line and up its face for an upright system; across its plane
# to the left of the line, at its height, for one lying level — the same
# placement the scene gives the system's meshes (`the bim face mesh of`).
function the bim chosen part corners of {bim chosen part record:chosenPart} in {bim model record:modelValue}:
    execute:
        set found to an empty list of a cad vector3
        set curtainValue to chosenPart's curtain
        set lowAlong to chosenPart's box's low's x
        set highAlong to chosenPart's box's high's x
        set lowUp to chosenPart's box's low's y
        set highUp to chosenPart's box's high's y
        set level to the bim setting (bim system level setting) of curtainValue's id in modelValue
        if level's found:
            set run to the maximum of 1e-9 and (the bim system length of curtainValue)
            set ux to (curtainValue's finish's x - curtainValue's start's x) / run
            set uy to (curtainValue's finish's y - curtainValue's start's y) / run
            set height to chosenPart's elevation + ((level's value as a 64 bit floating-point number) / 1000.0)
            append (a cad vector3 with x ((curtainValue's start's x + (ux * lowAlong)) - (uy * lowUp)), y ((curtainValue's start's y + (uy * lowAlong)) + (ux * lowUp)) and z height) to found
            append (a cad vector3 with x ((curtainValue's start's x + (ux * highAlong)) - (uy * lowUp)), y ((curtainValue's start's y + (uy * highAlong)) + (ux * lowUp)) and z height) to found
            append (a cad vector3 with x ((curtainValue's start's x + (ux * highAlong)) - (uy * highUp)), y ((curtainValue's start's y + (uy * highAlong)) + (ux * highUp)) and z height) to found
            append (a cad vector3 with x ((curtainValue's start's x + (ux * lowAlong)) - (uy * highUp)), y ((curtainValue's start's y + (uy * lowAlong)) + (ux * highUp)) and z height) to found
            return found
        set lowSpot to the bim point lowAlong metres along curtainValue
        set highSpot to the bim point highAlong metres along curtainValue
        set bottom to chosenPart's elevation + lowUp
        set top to chosenPart's elevation + highUp
        append (a cad vector3 with x lowSpot's x, y lowSpot's y and z bottom) to found
        append (a cad vector3 with x highSpot's x, y highSpot's y and z bottom) to found
        append (a cad vector3 with x highSpot's x, y highSpot's y and z top) to found
        append (a cad vector3 with x lowSpot's x, y lowSpot's y and z top) to found
        return found

# The point `along` metres along building system `curtainValue`'s line.
function the bim point {a 64 bit floating-point number:stationValue} metres along {bim curtain record:curtainValue}:
    execute:
        return the bim system point at stationValue of curtainValue

function draw bim gesture of {bim editor record:editor} in {bim screen layout record:layout} with {bim camera record:camera} using {bim text atlas record:typeface} showing the pointer {boolean:pointerShown} in {graphics frame:frame}:
    execute:
        if (editor's tool = bim vertical opening tool) and (editor's moveStage = 1):
            set corners to an empty list of a cad vector2
            append editor's moveBase to corners
            append (a cad vector2 with x editor's snap's point's x and y editor's moveBase's y) to corners
            append editor's snap's point to corners
            append (a cad vector2 with x editor's moveBase's x and y editor's snap's point's y) to corners
            start triangles in frame
            use vertex color red 0, green 160 and blue 230 in frame
            loop corner from 0 to 4:
                set cornerA to the item at corner in corners
                set cornerB to the item at (the remainder of (corner + 1) divided by 4) in corners
                add bim stroke from (the bim plan pixel of cornerA in layout with camera) to (the bim plan pixel of cornerB in layout with camera) wide 2.0 in frame
            finish triangles in frame
            free corners
        # The zoom region (ZR) being dragged out, corner to pointer.
        if (editor's tool = bim zoom region tool) and (editor's moveStage = 1):
            set regionCorner to the bim plan pixel of editor's zoomFrom in layout with camera
            set regionPointer to the bim plan pixel of editor's snap's point in layout with camera
            start triangles in frame
            use vertex color red 0, green 120 and blue 215 in frame
            add bim stroke from regionCorner to (a cad vector2 with x regionPointer's x and y regionCorner's y) wide 1.5 in frame
            add bim stroke from (a cad vector2 with x regionPointer's x and y regionCorner's y) to regionPointer wide 1.5 in frame
            add bim stroke from regionPointer to (a cad vector2 with x regionCorner's x and y regionPointer's y) wide 1.5 in frame
            add bim stroke from (a cad vector2 with x regionCorner's x and y regionPointer's y) to regionCorner wide 1.5 in frame
            finish triangles in frame
        # The building system being placed: its line and a mark at every
        # mullion.
        if (editor's tool = bim curtain tool) and (editor's moveStage = 1):
            set planPreview to the bim system preview of editor to editor's snap's point
            start triangles in frame
            use vertex color red 0, green 120 and blue 215 in frame
            add bim stroke from (the bim plan pixel of editor's solidCorner in layout with camera) to (the bim plan pixel of editor's snap's point in layout with camera) wide 2.0 in frame
            set previewCursor to 0
            loop while (previewCursor + 1) < the length of (planPreview's values):
                set mullionFoot to the item at previewCursor in (planPreview's values)
                set mullionTop to the item at (previewCursor + 1) in (planPreview's values)
                if (the absolute value of (mullionTop's z - mullionFoot's z)) > 0.01:
                    add bim square at (the bim plan pixel of (a cad vector2 with x mullionFoot's x and y mullionFoot's y) in layout with camera) sized 6.0 in frame
                set previewCursor to previewCursor + 2
            finish triangles in frame
        # The chosen part of a building system: its stretch along the line,
        # and a mullion or transom as its whole body seen from above (every
        # piece of it, its profile's outline).
        set chosenPart to the bim chosen part of editor
        if chosenPart's valid:
            start triangles in frame
            use vertex color red 255, green 140 and blue 0 in frame
            # The part's outline in plan: a line on an upright system, the
            # cell's rectangle on one lying level.
            set partPoints to the bim chosen part corners of chosenPart in editor's documentValue's current
            loop side from 0 to 4:
                set fromPoint to the item at side in partPoints
                set toPoint to the item at (the remainder of (side + 1) divided by 4) in partPoints
                add bim stroke from (the bim plan pixel of (a cad vector2 with x fromPoint's x and y fromPoint's y) in layout with camera) to (the bim plan pixel of (a cad vector2 with x toPoint's x and y toPoint's y) in layout with camera) wide 6.0 in frame
            free partPoints
            set chosenJointEdges to the bim chosen joint edges of editor
            set chosenEdgeCursor to 0
            loop while (chosenEdgeCursor + 1) < the length of (chosenJointEdges's values):
                set chosenSpotFrom to the item at chosenEdgeCursor in (chosenJointEdges's values)
                set chosenSpotTo to the item at (chosenEdgeCursor + 1) in (chosenJointEdges's values)
                set chosenEdgeFrom to the bim plan pixel of (a cad vector2 with x chosenSpotFrom's x and y chosenSpotFrom's y) in layout with camera
                set chosenEdgeTo to the bim plan pixel of (a cad vector2 with x chosenSpotTo's x and y chosenSpotTo's y) in layout with camera
                if (the cad distance from chosenEdgeFrom to chosenEdgeTo) > 0.5:
                    add bim stroke from chosenEdgeFrom to chosenEdgeTo wide 2.0 in frame
                set chosenEdgeCursor to chosenEdgeCursor + 2
            finish triangles in frame
        set snapPixel to the bim plan pixel of editor's snap's point in layout with camera
        start triangles in frame
        use vertex color red 196, green 44 and blue 44 in frame
        if (editor's tool = bim arc wall tool) and (editor's moveStage > 0):
            set previewEnd to editor's snap's point
            set previewBulge to 0.0
            if editor's moveStage = 2:
                set previewEnd to editor's solidReach
                set previewBulge to the bim boundary bulge from editor's solidCorner to previewEnd through editor's snap's point
            set previewArc to the bim boundary arc from editor's solidCorner to previewEnd bulging previewBulge
            set previewPoints to the bim drawn points of boundary segment previewArc
            loop previewCursor from 1 to the length of previewPoints:
                add bim stroke from (the bim plan pixel of (the item at (previewCursor - 1) in previewPoints) in layout with camera) to (the bim plan pixel of (the item at previewCursor in previewPoints) in layout with camera) wide 2.0 in frame
            free previewPoints
        if (editor's tool = bim section tool) and editor's sectionActive:
            add bim stroke from (the bim plan pixel of editor's sectionStart in layout with camera) to snapPixel wide 2.0 in frame
        # The section shown in the section panel, marked over its line (the
        # plan drawing draws every section's line and heads).
        loop sectionCursor from 0 to the length of (editor's documentValue's current's views's values):
            set sectionView to the item at sectionCursor in (editor's documentValue's current's views's values)
            if (sectionView's kind = bim section view) and (sectionView's id = editor's sectionViewId):
                add bim stroke from (the bim plan pixel of sectionView's lineStart in layout with camera) to (the bim plan pixel of sectionView's lineFinish in layout with camera) wide 1.5 in frame
        if editor's hoverWall != the bim refused id:
            set found to the bim wall index of editor's hoverWall in editor's documentValue's current
            if found's valid:
                set wallValue to the item at found's position in (editor's documentValue's current's walls's values)
                use vertex color red 0, green 191 and blue 255 in frame
                add bim stroke from (the bim plan pixel of wallValue's start in layout with camera) to (the bim plan pixel of wallValue's finish in layout with camera) wide 3.0 in frame
        if editor's tool = bim trim tool:
            set trimCandidate to the bim trim candidate at editor's pointerLocation for editor
            set trimAxis to the bim segment of trimCandidate in editor's documentValue's current
            if trimAxis's valid:
                use vertex color red 0, green 191 and blue 255 in frame
                add bim stroke from (the bim plan pixel of trimAxis's start in layout with camera) to (the bim plan pixel of trimAxis's finish in layout with camera) wide 3.0 in frame
        if (editor's tool = bim wall tool) and editor's chainActive:
            use vertex color red 220, green 120 and blue 36 in frame
            add bim stroke from (the bim plan pixel of editor's chainStart in layout with camera) to snapPixel wide 2.0 in frame
            # Drawn on a face, the wall's centreline runs beside the drawn line.
            set lineShift to the bim editor wall line shift in (the address of editor)
            if lineShift != 0.0:
                set drawnRun to a cad vector2 with x (editor's snap's point's x - editor's chainStart's x) and y (editor's snap's point's y - editor's chainStart's y)
                set drawnLength to the square root of ((drawnRun's x * drawnRun's x) + (drawnRun's y * drawnRun's y))
                if drawnLength > 1e-6:
                    set lineOutward to a cad vector2 with x ((drawnRun's y / drawnLength) * lineShift) and y ((0.0 - (drawnRun's x / drawnLength)) * lineShift)
                    add bim stroke from (the bim plan pixel of (a cad vector2 with x (editor's chainStart's x + lineOutward's x) and y (editor's chainStart's y + lineOutward's y)) in layout with camera) to (the bim plan pixel of (a cad vector2 with x (editor's snap's point's x + lineOutward's x) and y (editor's snap's point's y + lineOutward's y)) in layout with camera) wide 1.0 in frame
        # The linear element being placed: a beam's outline from its first
        # click and its axis, or a column's footprint under the pointer.
        if editor's tool = bim linear tool:
            set linearCorners to the bim linear preview of editor to editor's snap's point
            set ringCount to (the length of (linearCorners's values)) / 2
            use vertex color red 220, green 120 and blue 36 in frame
            loop ringCursor from 0 to ringCount:
                set ringFrom to the item at ringCursor in (linearCorners's values)
                set ringTo to the item at (the remainder of (ringCursor + 1) divided by ringCount) in (linearCorners's values)
                add bim stroke from (the bim plan pixel of (a cad vector2 with x ringFrom's x and y ringFrom's y) in layout with camera) to (the bim plan pixel of (a cad vector2 with x ringTo's x and y ringTo's y) in layout with camera) wide 1.5 in frame
            if editor's chainActive:
                add bim stroke from (the bim plan pixel of editor's chainStart in layout with camera) to snapPixel wide 1.0 in frame
        # The sketch tools' rubber bands: the line chain, the rectangle, and a
        # move from its base point.
        set chain to editor's sketchChain's values
        if (((editor's tool = bim line tool) or (editor's tool = bim rectangle tool)) or (editor's tool = bim railing tool)) and ((the length of chain) > 0):
            use vertex color red 30, green 34 and blue 44 in frame
            loop corner from 1 to the length of chain:
                add bim stroke from (the bim plan pixel of (the item at (corner - 1) in chain) in layout with camera) to (the bim plan pixel of (the item at corner in chain) in layout with camera) wide 1.5 in frame
            set last to the item at ((the length of chain) - 1) in chain
            use vertex color red 220, green 120 and blue 36 in frame
            if (editor's tool = bim line tool) or (editor's tool = bim railing tool):
                add bim stroke from (the bim plan pixel of last in layout with camera) to snapPixel wide 1.5 in frame
            else:
                set firstPixel to the bim plan pixel of (the item at 0 in chain) in layout with camera
                add bim stroke from firstPixel to (a cad vector2 with x snapPixel's x and y firstPixel's y) wide 1.5 in frame
                add bim stroke from (a cad vector2 with x snapPixel's x and y firstPixel's y) to snapPixel wide 1.5 in frame
                add bim stroke from snapPixel to (a cad vector2 with x firstPixel's x and y snapPixel's y) wide 1.5 in frame
                add bim stroke from (a cad vector2 with x firstPixel's x and y snapPixel's y) to firstPixel wide 1.5 in frame
        # A solid part being drawn: its base (a rectangle, or a circle about
        # its centre), then the height as a line from its second click.
        if (editor's tool = bim solid tool) and (editor's moveStage >= 1):
            set solidFirst to the bim plan pixel of editor's solidCorner in layout with camera
            set solidSecond to snapPixel
            if editor's moveStage = 2:
                set solidSecond to the bim plan pixel of editor's solidReach in layout with camera
            use vertex color red 220, green 120 and blue 36 in frame
            if editor's solidKind = bim box solid:
                add bim stroke from solidFirst to (a cad vector2 with x solidSecond's x and y solidFirst's y) wide 1.5 in frame
                add bim stroke from (a cad vector2 with x solidSecond's x and y solidFirst's y) to solidSecond wide 1.5 in frame
                add bim stroke from solidSecond to (a cad vector2 with x solidFirst's x and y solidSecond's y) wide 1.5 in frame
                add bim stroke from (a cad vector2 with x solidFirst's x and y solidSecond's y) to solidFirst wide 1.5 in frame
            else:
                set rim to an empty list of a cad vector2
                append bim circle at solidFirst radius (the cad distance from solidFirst to solidSecond) into rim
                set rimCursor to 0
                loop while (rimCursor + 1) < the length of rim:
                    add bim stroke from (the item at rimCursor in rim) to (the item at (rimCursor + 1) in rim) wide 1.5 in frame
                    set rimCursor to rimCursor + 2
                free rim
            if editor's moveStage = 2:
                add bim stroke from solidSecond to snapPixel wide 1.0 in frame
        # A dimension being placed: its line through the pointer, as it will
        # be drawn.
        if (editor's tool = bim dimension tool) and (editor's moveStage = 2):
            set trial to @intrinsic("construct", a bim dimension record, the bim refused id, editor's dimensionFirst, editor's dimensionSecond, true, editor's snap's point)
            set trialShape to the bim dimension line of trial in editor's documentValue's current using editor's evaluation's index
            if trialShape's valid:
                set trialLines to an empty list of a cad vector2
                set trialTicks to an empty list of a cad vector2
                append bim dimension shape trialShape through (the bim plan transform of layout with camera) into trialLines and trialTicks under (the bim drawing standard of editor's documentValue's current)
                use vertex color red 220, green 120 and blue 36 in frame
                set trialCursor to 0
                loop while (trialCursor + 1) < the length of trialLines:
                    add bim stroke from (the item at trialCursor in trialLines) to (the item at (trialCursor + 1) in trialLines) wide 1.0 in frame
                    set trialCursor to trialCursor + 2
                set trialCursor to 0
                loop while (trialCursor + 1) < the length of trialTicks:
                    add bim stroke from (the item at trialCursor in trialTicks) to (the item at (trialCursor + 1) in trialTicks) wide 1.5 in frame
                    set trialCursor to trialCursor + 2
                free trialLines
                free trialTicks
        # A grid being drawn: its line and its heads, as it will be.
        if (editor's tool = bim grid tool) and editor's gridActive:
            set startPixel to the bim plan pixel of editor's gridStart in layout with camera
            use vertex color red 60, green 100 and blue 165 in frame
            set gap to the cad distance from startPixel to snapPixel
            if gap > 30.0:
                set gx to (snapPixel's x - startPixel's x) / gap
                set gy to (snapPixel's y - startPixel's y) / gap
                set dashes to an empty list of a cad vector2
                append bim dash dot from (a cad vector2 with x (startPixel's x + (gx * (bim grid screen head radius))) and y (startPixel's y + (gy * (bim grid screen head radius)))) to (a cad vector2 with x (snapPixel's x - (gx * (bim grid screen head radius))) and y (snapPixel's y - (gy * (bim grid screen head radius)))) into dashes
                set dashCursor to 0
                loop while (dashCursor + 1) < the length of dashes:
                    add bim stroke from (the item at dashCursor in dashes) to (the item at (dashCursor + 1) in dashes) wide 1.2 in frame
                    set dashCursor to dashCursor + 2
                free dashes
            set heads to an empty list of a cad vector2
            append bim circle at startPixel radius (bim grid screen head radius) into heads
            append bim circle at snapPixel radius (bim grid screen head radius) into heads
            set headCursor to 0
            loop while (headCursor + 1) < the length of heads:
                add bim stroke from (the item at headCursor in heads) to (the item at (headCursor + 1) in heads) wide 1.4 in frame
                set headCursor to headCursor + 2
            free heads
        # Rotate: the centre, the reference ray and the turning ray; mirror:
        # the mirror line, run on past both points.
        if (editor's tool = bim rotate tool) and (editor's moveStage >= 2):
            set centrePixel to the bim plan pixel of editor's moveBase in layout with camera
            use vertex color red 220, green 120 and blue 36 in frame
            add bim stroke from centrePixel to snapPixel wide 1.5 in frame
            if editor's moveStage = 3:
                set referenceEnd to a cad vector2 with x (editor's moveBase's x + (the cosine of editor's turnStart)) and y (editor's moveBase's y + (the sine of editor's turnStart))
                use vertex color red 120, green 126 and blue 140 in frame
                add bim stroke from centrePixel to (the bim plan pixel of referenceEnd in layout with camera) wide 1.0 in frame
        if (editor's tool = bim mirror tool) and (editor's moveStage = 2):
            set axisStart to the bim plan pixel of editor's moveBase in layout with camera
            set axisLength to the cad distance from axisStart to snapPixel
            if axisLength > 1.0:
                set ax to (snapPixel's x - axisStart's x) / axisLength
                set ay to (snapPixel's y - axisStart's y) / axisLength
                set axisDashes to an empty list of a cad vector2
                append bim dash dot from (a cad vector2 with x (axisStart's x - (ax * 2000.0)) and y (axisStart's y - (ay * 2000.0))) to (a cad vector2 with x (snapPixel's x + (ax * 2000.0)) and y (snapPixel's y + (ay * 2000.0))) into axisDashes
                use vertex color red 196, green 44 and blue 44 in frame
                set axisCursor to 0
                loop while (axisCursor + 1) < the length of axisDashes:
                    add bim stroke from (the item at axisCursor in axisDashes) to (the item at (axisCursor + 1) in axisDashes) wide 1.2 in frame
                    set axisCursor to axisCursor + 2
                free axisDashes
        if ((editor's tool = bim move tool) or (editor's tool = bim copy tool)) and (editor's moveStage = 2):
            use vertex color red 220, green 120 and blue 36 in frame
            add bim stroke from (the bim plan pixel of editor's moveBase in layout with camera) to snapPixel wide 1.5 in frame
        # Edit mode: the edited element's points, picked ones filled.
        if editor's editMode:
            draw bim edit points of editor in layout with camera in view false in frame
        finish triangles in frame
        # The pointer is the system's (see the main loop); an object snap is
        # marked where it snaps.
        set objectSnap to ((editor's snap's label != "Grid") and (editor's snap's label != "Free")) and ((the length of editor's snap's label) > 0)
        if objectSnap:
            set glyphTracker to the bim tracking origin of editor
            # An extension or a parallel is drawn from where it runs from.
            if (editor's snap's label = "Extension") or (editor's snap's label = "Parallel"):
                set glyphTracker to @intrinsic("construct", a bim snap candidate record, editor's snap's origin, the string form of "", 0, 0.0, true, 0)
            draw bim snap glyph editor's snap's label at snapPixel from glyphTracker in layout with camera using typeface in frame
        if (editor's tool = bim text tool) and editor's textActive:
            set anchorPixel to the bim plan pixel of editor's textAnchor in layout with camera
            set typedWidth to the bim text width of editor's textBuffer in typeface
            draw bim text editor's textBuffer at anchorPixel's x and anchorPixel's y with typeface coloured 20, 24 and 34 in frame
            draw a rectangle at x ((anchorPixel's x + typedWidth) + 1.0) and y (anchorPixel's y - 13.0) with width 2 and height 16 in color red 6, green 150 and blue 215 in frame
        if (editor's tool = bim push tool) and (editor's pushId != the bim refused id):
            set pushed to the bim sketch index of editor's pushId in editor's documentValue's current
            if pushed's valid:
                set heightText to (the string form of "height ") + (the bim length (the item at pushed's position in (editor's documentValue's current's sketches's values))'s height in units editor's lengthUnit)
                if (the length of editor's numeric) > 0:
                    set heightText to (the string form of "height ") + ((editor's numeric + (the string form of " ")) + ((the bim name of unit editor's lengthUnit) + (the string form of " (typed)")))
                draw bim label heightText at (snapPixel's x + 8.0) and (snapPixel's y + 22.0) using typeface in frame
        if ((editor's tool = bim wall tool) or (editor's tool = bim linear tool)) and editor's chainActive:
            set run to the cad distance from editor's chainStart to editor's snap's point
            set lengthText to the bim length run in units editor's lengthUnit
            if (the length of editor's numeric) > 0:
                set lengthText to (editor's numeric + (the string form of " ")) + ((the bim name of unit editor's lengthUnit) + (the string form of " (typed)"))
            draw bim label lengthText at (snapPixel's x + 8.0) and (snapPixel's y + 22.0) using typeface in frame
            # The wall tool's line, when it is not the centreline.
            if (editor's tool = bim wall tool) and (editor's wallLine != bim wall centre line):
                draw bim label ((the string form of "on the ") + (the bim wall line name of editor's wallLine)) at (snapPixel's x + 8.0) and (snapPixel's y + 36.0) using typeface in frame
        if editor's hoverWall != the bim refused id:
            set measured to @intrinsic("construct", a bim dimension record, the bim refused id, a bim reference to editor's hoverWall feature bim wall start feature, a bim reference to editor's hoverWall feature bim wall finish feature, false, a cad vector2 with x 0.0 and y 0.0)
            set measure to the bim measure of measured in editor's documentValue's current using editor's evaluation's index
            if measure's valid:
                draw bim label ((the string form of "length ") + (the bim length measure's value in units editor's lengthUnit)) at (snapPixel's x + 8.0) and (snapPixel's y - 14.0) using typeface in frame

# The ray through a pixel of the 3D panel, starting well in front of the
# model and running away from the viewer.
function the bim view ray through {cad vector2:pixel} in {bim screen layout record:layout} with {bim camera record:camera}:
    execute:
        set axes to the bim view axes of camera
        set middle to the bim view middle of layout
        set viewScale to camera's viewScale
        set acrossDistance to (pixel's x - middle's x) / viewScale
        set upDistance to (middle's y - pixel's y) / viewScale
        set onScreen to the cad sum of axes's centre and (the cad sum of (axes's across scaled by acrossDistance) and (axes's up scaled by upDistance))
        return @intrinsic("construct", a bim ray record, (the cad difference of onScreen and (axes's depth scaled by 10000.0)), axes's depth)

# Records the triangle `first`, `second`, `third` (pixel x and y, depth z) in
# the colour `packed`, cut to the right panel of `layout`.
function record bim triangle {cad vector3:first}, {cad vector3:second} and {cad vector3:third} within the view of {bim screen layout record:layout} coloured {integer:packed} on {a pointer to a bim depth recording record:recording}:
    execute:
        set inside to (((the minimum of first's x and (the minimum of second's x and third's x)) >= layout's planRight) and ((the maximum of first's x and (the maximum of second's x and third's x)) <= layout's width))
        set inside to inside and (((the minimum of first's y and (the minimum of second's y and third's y)) >= layout's top) and ((the maximum of first's y and (the maximum of second's y and third's y)) <= layout's bottom))
        if inside:
            record bim depth triangle first, second and third coloured packed on recording
            return nothing
        set outline to an empty list of a cad vector3
        append first to outline
        append second to outline
        append third to outline
        set limits to an empty list of a 64 bit floating-point number
        append layout's planRight to limits
        append layout's width to limits
        append layout's top to limits
        append layout's bottom to limits
        loop edge from 0 to 4:
            set cut to the bim polygon outline clipped at (the item at edge in limits) vertical (edge < 2) keeping above ((the remainder of edge divided by 2) = 0)
            free outline
            set outline to cut
        free limits
        loop cursor from 1 to (the length of outline) - 1:
            set anchor to the item at 0 in outline
            set middle to the item at cursor in outline
            set last to the item at (cursor + 1) in outline
            record bim depth triangle anchor, middle and last coloured packed on recording
        free outline

# A mesh's points welded by position: `spots` its distinct positions,
# `remap` for each point the spot it lies on, and `corners` its triangles'
# corners as spots.
class:
    patterns:
        [a|] bim welding record
    members:
        spots as the type of (an empty list of a cad vector3)
        remap as the type of (an empty list of an integer)
        corners as the type of (an empty list of an integer)

function the bim welding of {fast mesh record:shape}:
    execute:
        set points to shape's positions's values
        set sorted to an empty list of a bim gpu corner record
        loop point from 0 to the length of points:
            set spot to the item at point in points
            append (@intrinsic("construct", a bim gpu corner record, spot's x, spot's y, spot's z, point)) to sorted
        set comparator to the function named "bim gpu corner ordering $ and $"
        sort native array at ((the data of sorted) as a pointer) with ((the length of sorted) as a word sized unsigned integer) items of ((the size of a bim gpu corner record) as a word sized unsigned integer) bytes using comparator
        set remapped to an empty list of an integer
        loop point from 0 to the length of sorted:
            append 0 to remapped
        set distinctSpots to an empty list of a cad vector3
        loop point from 0 to the length of sorted:
            set here to the item at point in sorted
            set fresh to true
            if point > 0:
                set before to the item at (point - 1) in sorted
                set fresh to ((here's x != before's x) or (here's y != before's y)) or (here's z != before's z)
            if fresh:
                append (a cad vector3 with x here's x, y here's y and z here's z) to distinctSpots
            replace item at index here's index in remapped with ((the length of distinctSpots) - 1)
        free sorted
        set spotCorners to an empty list of an integer
        loop corner from 0 to the length of (shape's triangles's values):
            append (the item at (the item at corner in (shape's triangles's values)) in remapped) to spotCorners
        return @intrinsic("construct", a bim welding record, distinctSpots, remapped, spotCorners)

function free bim welding {a pointer to a bim welding record:welded}:
    execute:
        free (welded's spots)
        free (welded's remap)
        free (welded's corners)

# Appends to `edges` the feature edges of `shape`, as pairs of points.
function append bim feature edges of {fast mesh record:shape} to {a pointer to a list:edges}:
    execute:
        set welds to the bim welding of shape
        set pairs to an empty list of an integer
        append bim feature edge pairs of (welds's spots) and (welds's corners) to pairs
        loop cursor from 0 to the length of pairs:
            append (the item at (the item at cursor in pairs) in (welds's spots)) to edges
        free pairs
        free bim welding (the address of welds)

# Appends to `pairs` the feature edges of one element's welded corners
# `points` and triangles `corners`, as pairs of corner numbers: an edge used
# by one triangle, or between two whose faces turn by more than 15 degrees.
function append bim feature edge pairs of {a pointer to a list:points} and {a pointer to a list:corners} to {a pointer to a list:pairs}:
    execute:
        set records to an empty list of a bim gpu edge record
        set normals to an empty list of a cad vector3
        set triangleCount to (the length of corners) / 3
        loop face from 0 to triangleCount:
            set ia to the item at (face * 3) in corners
            set ib to the item at ((face * 3) + 1) in corners
            set ic to the item at ((face * 3) + 2) in corners
            set pa to the item at ia in points
            set turned to the cad cross of (the cad difference of (the item at ib in points) and pa) and (the cad difference of (the item at ic in points) and pa)
            set size to the cad length of turned
            if size > 0.0:
                set turned to turned scaled by (1.0 / size)
            append turned to normals
            append (@intrinsic("construct", a bim gpu edge record, the minimum of ia and ib, the maximum of ia and ib, face)) to records
            append (@intrinsic("construct", a bim gpu edge record, the minimum of ib and ic, the maximum of ib and ic, face)) to records
            append (@intrinsic("construct", a bim gpu edge record, the minimum of ic and ia, the maximum of ic and ia, face)) to records
        set comparator to the function named "bim gpu edge ordering $ and $"
        sort native array at ((the data of records) as a pointer) with ((the length of records) as a word sized unsigned integer) items of ((the size of a bim gpu edge record) as a word sized unsigned integer) bytes using comparator
        set cursor to 0
        loop while cursor < the length of records:
            set here to the item at cursor in records
            set groupEnd to cursor + 1
            set scanning to true
            loop while scanning:
                if groupEnd >= the length of records:
                    set scanning to false
                else:
                    set candidate to the item at groupEnd in records
                    if (candidate's first = here's first) and (candidate's second = here's second):
                        set groupEnd to groupEnd + 1
                    else:
                        set scanning to false
            set keep to (groupEnd - cursor) != 2
            if keep = false:
                set other to the item at (cursor + 1) in records
                set keep to (the cad dot of (the item at here's triangle in normals) and (the item at other's triangle in normals)) < 0.966
            if keep:
                append here's first to pairs
                append here's second to pairs
            set cursor to groupEnd
        free records
        free normals

class:
    patterns:
        [a|] bim gpu corner record
    members:
        x as a 64 bit floating-point number
        y as a 64 bit floating-point number
        z as a 64 bit floating-point number
        index as an integer

function bim gpu corner ordering {pointer:left} and {pointer:right}:
    execute:
        set first to @intrinsic("dereference", left as a pointer to a bim gpu corner record)
        set second to @intrinsic("dereference", right as a pointer to a bim gpu corner record)
        if first's x < second's x:
            return -1
        if first's x > second's x:
            return 1
        if first's y < second's y:
            return -1
        if first's y > second's y:
            return 1
        if first's z < second's z:
            return -1
        if first's z > second's z:
            return 1
        return 0

# The points of the element in edit mode, in the plan or (`inView`) in the 3D
# panel, where a mass shows them at its foot and its top: squares, the picked
# ones filled orange, with the element's edges.
function draw bim edit points of {bim editor record:editor} in {bim screen layout record:layout} with {bim camera record:camera} in view {boolean:inView} in {graphics frame:frame}:
    execute:
        if bim editor sketches a boundary editor:
            draw bim boundary sketch of editor in layout with camera in view inView in frame
            return nothing
        if editor's editMesh:
            draw bim mesh edit points of editor in layout with camera in view inView in frame
            return nothing
        # An element edited by its control points: each a square, the picked
        # ones filled (a level's height is edited in the section, not drawn).
        if bim kind (editor's editKind) has handles:
            if editor's editKind = bim level picked:
                return nothing
            set controlList to an empty list of a cad vector3
            set foundControls to the bim handles of editor's editKind numbered editor's editSketchId in editor's documentValue's current
            loop foundCursor from 0 to the length of (foundControls's values):
                append (the item at foundCursor in (foundControls's values)) to controlList
            set lift to the bim storey elevation of editor
            start triangles in frame
            loop cursor from 0 to the length of controlList:
                set controlPoint to the item at cursor in controlList
                set spot to the bim plan pixel of (a cad vector2 with x controlPoint's x and y controlPoint's y) in layout with camera
                if inView:
                    set spot to the bim view point (controlPoint's x) (controlPoint's y) (controlPoint's z + lift) in layout with camera
                use vertex color red 30, green 34 and blue 44 in frame
                add bim square at spot sized 9.0 in frame
                if bim edit point cursor is picked in editor:
                    use vertex color red 255, green 140 and blue 0 in frame
                else:
                    use vertex color red 255, green 255 and blue 255 in frame
                add bim square at spot sized 6.0 in frame
            finish triangles in frame
            free controlList
            return nothing
        set found to the bim sketch index of editor's editSketchId in editor's documentValue's current
        if found's valid = false:
            return nothing
        set element to the item at found's position in (editor's documentValue's current's sketches's values)
        set ring to element's points's values
        set base to the bim storey elevation of editor
        set tiers to 1
        if inView and (element's height > 0.0):
            set tiers to 2
        start triangles in frame
        loop tier from 0 to tiers:
            set z to base + ((tier as a 64 bit floating-point number) * element's height)
            set pixels to an empty list of a cad vector2
            loop cursor from 0 to the length of ring:
                set point to the item at cursor in ring
                if inView:
                    append (the bim view point (point's x) (point's y) z in layout with camera) to pixels
                else:
                    append (the bim plan pixel of point in layout with camera) to pixels
            use vertex color red 255, green 140 and blue 0 in frame
            set edgeCount to the length of pixels
            if element's kind = bim line sketch:
                set edgeCount to 1
            loop cursor from 0 to edgeCount:
                add bim stroke from (the item at cursor in pixels) to (the item at (the remainder of (cursor + 1) divided by (the length of pixels)) in pixels) wide 1.5 in frame
            loop cursor from 0 to the length of pixels:
                set spot to the item at cursor in pixels
                set picked to false
                loop pickCursor from 0 to the length of (editor's editPicked's values):
                    if (the item at pickCursor in (editor's editPicked's values)) = cursor:
                        set picked to true
                use vertex color red 30, green 34 and blue 44 in frame
                add bim square at spot sized 9.0 in frame
                if picked:
                    use vertex color red 255, green 140 and blue 0 in frame
                else:
                    use vertex color red 255, green 255 and blue 255 in frame
                add bim square at spot sized 6.0 in frame
            free pixels
        finish triangles in frame

# A point of the sketch open (in its own coordinates) as a pixel of the plan
# or (`inView`) of the 3D panel.
function the bim sketch pixel of {cad vector2:spot} for {bim editor record:editor} in {bim screen layout record:layout} with {bim camera record:camera} in view {boolean:inView}:
    execute:
        set placed to the bim sketch world point of spot for editor
        if inView:
            return the bim view point (placed's x) (placed's y) (placed's z) in layout with camera
        return the bim plan pixel of (a cad vector2 with x placed's x and y placed's y) in layout with camera

# Strokes through `points` of the sketch open; on a building system's face
# in steps of at most 0.2 m, so that they follow a curved face.
function add bim sketch strokes through {a pointer to a list:points} for {bim editor record:editor} in {bim screen layout record:layout} with {bim camera record:camera} in view {boolean:inView} wide {a 64 bit floating-point number:breadth} in {graphics frame:frame}:
    execute:
        loop corner from 0 to (the length of points) - 1:
            set fromSpot to the item at corner in points
            set toSpot to the item at (corner + 1) in points
            set steps to 1
            if editor's sketchHostKind = bim curtain picked:
                set steps to the maximum of 1 and ((@intrinsic("ceil", (the cad distance from fromSpot to toSpot) / 0.2)) as an integer)
            set previous to the bim sketch pixel of fromSpot for editor in layout with camera in view inView
            loop step from 1 to steps + 1:
                set share to (step as a 64 bit floating-point number) / (steps as a 64 bit floating-point number)
                set between to a cad vector2 with x (fromSpot's x + ((toSpot's x - fromSpot's x) * share)) and y (fromSpot's y + ((toSpot's y - fromSpot's y) * share))
                set current to the bim sketch pixel of between for editor in layout with camera in view inView
                add bim stroke from previous to current wide breadth in frame
                set previous to current

# The boundary sketch open, on the plate's top or the building system's
# face: its lines and arcs in magenta, as Revit's sketch lines, the picked
# one orange, their ends as squares; and the line or arc being drawn, to
# where a click would land.
function draw bim boundary sketch of {bim editor record:editor} in {bim screen layout record:layout} with {bim camera record:camera} in view {boolean:inView} in {graphics frame:frame}:
    execute:
        start triangles in frame
        loop cursor from 0 to the length of (editor's sketchSegments's values):
            set piece to the bim displayed boundary segment at cursor of editor
            set drawn to the bim drawn points of boundary segment piece
            if cursor = editor's sketchPicked:
                use vertex color red 255, green 140 and blue 0 in frame
            else:
                use vertex color red 200, green 30 and blue 190 in frame
            add bim sketch strokes through drawn for editor in layout with camera in view inView wide 2.0 in frame
            free drawn
        loop cursor from 0 to the length of (editor's sketchSegments's values):
            set piece to the bim displayed boundary segment at cursor of editor
            use vertex color red 120, green 20 and blue 110 in frame
            add bim square at (the bim sketch pixel of piece's start for editor in layout with camera in view inView) sized 6.0 in frame
            add bim square at (the bim sketch pixel of piece's finish for editor in layout with camera in view inView) sized 6.0 in frame
        if bim boundary point selected in editor:
            use vertex color red 255, green 140 and blue 0 in frame
            set vertexCode to the item at 0 in (editor's editPicked's values)
            set shownPiece to the bim displayed boundary segment at (vertexCode / 2) of editor
            set shownPoint to shownPiece's start
            if (the remainder of vertexCode divided by 2) = 1:
                set shownPoint to shownPiece's finish
            add bim square at (the bim sketch pixel of shownPoint for editor in layout with camera in view inView) sized 10.0 in frame
        set clicked to the length of (editor's sketchPending's values)
        if clicked > 0:
            set reach to the bim sketch point at (the bim sketch location of editor) of editor
            set lastClicked to the item at (clicked - 1) in (editor's sketchPending's values)
            use vertex color red 230, green 90 and blue 220 in frame
            set rubber to an empty list of a cad vector2
            if (editor's sketchTool = bim sketch line tool) or (clicked = 1):
                append lastClicked to rubber
                append reach to rubber
            if (editor's sketchTool = bim sketch arc tool) and (clicked = 2):
                set fromPoint to the item at 0 in (editor's sketchPending's values)
                set preview to the bim boundary arc from fromPoint to lastClicked bulging (the bim boundary bulge from fromPoint to lastClicked through reach)
                free rubber
                set rubber to the bim drawn points of boundary segment preview
            add bim sketch strokes through rubber for editor in layout with camera in view inView wide 1.5 in frame
            free rubber
            loop cursor from 0 to clicked:
                use vertex color red 30, green 34 and blue 44 in frame
                add bim square at (the bim sketch pixel of (the item at cursor in (editor's sketchPending's values)) for editor in layout with camera in view inView) sized 8.0 in frame
        if editor's sketchTool != bim sketch pick tool:
            set sketchSnap to the bim sketch snap at (the bim sketch location of editor) of editor
            set snapPixel to the bim sketch pixel of sketchSnap's point for editor in layout with camera in view inView
            use vertex color red 45, green 210 and blue 220 in frame
            add bim square at snapPixel sized 10.0 in frame
            use vertex color red 30, green 34 and blue 44 in frame
            add bim square at snapPixel sized 6.0 in frame
            if (sketchSnap's label = (the string form of "Horizontal")) or (sketchSnap's label = (the string form of "Vertical")):
                use vertex color red 45, green 210 and blue 220 in frame
                add bim stroke from (the bim sketch pixel of sketchSnap's origin for editor in layout with camera in view inView) to snapPixel wide 1.0 in frame
        finish triangles in frame

# The elevation of the active storey.
function the bim storey elevation of {bim editor record:editor}:
    execute:
        set found to the bim level index of editor's levelId in editor's documentValue's current
        if found's valid:
            return (the item at found's position in (editor's documentValue's current's levels's values))'s elevation
        return 0.0

# The gesture of a drawing tool in the 3D view: the snapped point and the
# rubber bands of the line chain, the rectangle, the wall chain or the grid,
# on the active storey's plane.
# The building system the curtain tool would place from its first click to
# `finishPoint`, as model line pairs: its mullions, transoms and outline in
# the bays (1.2 m) and rows (1.5 m) the tool uses, the storey's height high.
function the bim system preview of {bim editor record:editor} to {cad vector2:finishPoint}:
    execute:
        set pairs to a cad topology list of a cad vector3
        set startPoint to editor's solidCorner
        set run to the cad distance from startPoint to finishPoint
        if run < 0.05:
            return pairs
        set base to the bim storey elevation of editor
        set rise to 3.0
        set levelFound to the bim level index of editor's levelId in editor's documentValue's current
        if levelFound's valid:
            set rise to (the item at levelFound's position in (editor's documentValue's current's levels's values))'s height
        set bays to the bim divisions of run at most 1.2
        set rows to the bim divisions of rise at most 1.5
        set ux to (finishPoint's x - startPoint's x) / run
        set uy to (finishPoint's y - startPoint's y) / run
        loop bayCursor from 0 to (bays + 1):
            set along to (run * (bayCursor as a 64 bit floating-point number)) / (bays as a 64 bit floating-point number)
            set px to startPoint's x + (ux * along)
            set py to startPoint's y + (uy * along)
            append (a cad vector3 with x px, y py and z base) to (pairs's values)
            append (a cad vector3 with x px, y py and z (base + rise)) to (pairs's values)
        loop rowCursor from 0 to (rows + 1):
            set rowLevel to base + ((rise * (rowCursor as a 64 bit floating-point number)) / (rows as a 64 bit floating-point number))
            append (a cad vector3 with x startPoint's x, y startPoint's y and z rowLevel) to (pairs's values)
            append (a cad vector3 with x finishPoint's x, y finishPoint's y and z rowLevel) to (pairs's values)
        return pairs

function the bim view point {a 64 bit floating-point number:x} {a 64 bit floating-point number:y} {a 64 bit floating-point number:z} in {bim screen layout record:layout} with {bim camera record:camera}:
    execute:
        set placed to the bim view pixel of (a cad vector3 with x x, y y and z z) in layout with camera
        return a cad vector2 with x placed's x and y placed's y

# ---------------------------------------------------------------- 3D cursor and gizmo

function the bim view axes of {bim camera record:camera}:
    execute:
        set cosYaw to the cosine of camera's yaw
        set sinYaw to the sine of camera's yaw
        set cosPitch to the cosine of camera's pitch
        set sinPitch to the sine of camera's pitch
        set across to a cad vector3 with x cosYaw, y (0.0 - sinYaw) and z 0.0
        set up to a cad vector3 with x (sinPitch * sinYaw), y (sinPitch * cosYaw) and z cosPitch
        set depth to a cad vector3 with x (cosPitch * sinYaw), y (cosPitch * cosYaw) and z (0.0 - sinPitch)
        return @intrinsic("construct", a bim view axes record, across, up, depth, camera's target)

function the bim view middle of {bim screen layout record:layout}:
    execute:
        return a cad vector2 with x ((layout's planRight + layout's width) * 0.5) and y ((layout's top + layout's bottom) * 0.5)

function the bim view pixel of {cad vector3:location} in {bim screen layout record:layout} with {bim camera record:camera}:
    execute:
        set axes to the bim view axes of camera
        set offset to the cad difference of location and axes's centre
        set middle to the bim view middle of layout
        set viewScale to camera's viewScale
        return a cad vector3 with x (middle's x + ((the cad dot of offset and axes's across) * viewScale)), y (middle's y - ((the cad dot of offset and axes's up) * viewScale)) and z (0.0 - ((the cad dot of offset and axes's depth) * 0.02))

# The part of the screen polygon `corners` (pixel x and y, depth z) on the
# kept side of a panel edge: x (when `alongX`) or y at `limit`, keeping
# larger values when `keepAbove`. Edges crossing the limit are cut there,
# with the depth interpolated.
function the bim polygon {a pointer to a list:corners} clipped at {a 64 bit floating-point number:limit} vertical {boolean:alongX} keeping above {boolean:keepAbove}:
    execute:
        set kept to an empty list of a cad vector3
        set count to the length of corners
        loop cursor from 0 to count:
            set here to the item at cursor in corners
            set following to the item at (the remainder of (cursor + 1) divided by count) in corners
            set hereValue to here's y
            set followingValue to following's y
            if alongX:
                set hereValue to here's x
                set followingValue to following's x
            set hereInside to hereValue <= limit
            set followingInside to followingValue <= limit
            if keepAbove:
                set hereInside to hereValue >= limit
                set followingInside to followingValue >= limit
            if hereInside:
                append here to kept
            if hereInside != followingInside:
                set fraction to (limit - hereValue) / (followingValue - hereValue)
                append (a cad vector3 with x (here's x + (fraction * (following's x - here's x))), y (here's y + (fraction * (following's y - here's y))) and z (here's z + (fraction * (following's z - here's z)))) to kept
        return kept

# One triangle edge between welded corners, for finding feature edges.
class:
    patterns:
        [a|] bim gpu edge record
    members:
        first as an integer
        second as an integer
        triangle as an integer

function bim gpu edge ordering {pointer:left} and {pointer:right}:
    execute:
        set one to @intrinsic("dereference", left as a pointer to a bim gpu edge record)
        set other to @intrinsic("dereference", right as a pointer to a bim gpu edge record)
        if one's first < other's first:
            return -1
        if one's first > other's first:
            return 1
        if one's second < other's second:
            return -1
        if one's second > other's second:
            return 1
        return 0

# ---------------------------------------------------------------- view bar

# The mesh in edit mode: its edges and its points, the picked ones filled.
function draw bim mesh edit points of {bim editor record:editor} in {bim screen layout record:layout} with {bim camera record:camera} in view {boolean:inView} in {graphics frame:frame}:
    execute:
        set found to the bim mesh index of editor's editSketchId in editor's documentValue's current
        if found's valid = false:
            return nothing
        set meshValue to the item at found's position in (editor's documentValue's current's meshes's values)
        set entries to meshValue's faces's values
        set spots to meshValue's vertices's values
        start triangles in frame
        use vertex color red 255, green 140 and blue 0 in frame
        set start to 0
        loop while start < the length of entries:
            set count to the item at start in entries
            loop corner from 0 to count:
                set here to the item at (the item at ((start + 1) + corner) in entries) in spots
                set following to the item at (the item at ((start + 1) + (the remainder of (corner + 1) divided by count)) in entries) in spots
                add bim stroke from (the bim pixel of mesh point here of editor in layout with camera in view inView) to (the bim pixel of mesh point following of editor in layout with camera in view inView) wide 1.5 in frame
            set start to start + (count + 1)
        loop cursor from 0 to the length of spots:
            set spot to the bim pixel of mesh point (the item at cursor in spots) of editor in layout with camera in view inView
            set picked to false
            loop pickCursor from 0 to the length of (editor's editPicked's values):
                if (the item at pickCursor in (editor's editPicked's values)) = cursor:
                    set picked to true
            use vertex color red 30, green 34 and blue 44 in frame
            add bim square at spot sized 9.0 in frame
            if picked:
                use vertex color red 255, green 140 and blue 0 in frame
            else:
                use vertex color red 255, green 255 and blue 255 in frame
            add bim square at spot sized 6.0 in frame
        finish triangles in frame

# The orthographic 3D view: turned by the camera's yaw about the vertical,
# tilted by its pitch (from below the horizon to straight down), centred on
# the camera's target, which it orbits, at `viewScale` pixels per metre.
# Plan and 3D view have their own centre and zoom. Offsets from the
# camera centre are taken in binary64 before the graphics pipeline's single
# precision, so the view stays exact far from the origin.
class:
    patterns:
        [a|] bim view axes record
    members:
        across as a cad vector3
        up as a cad vector3
        depth as a cad vector3
        centre as a cad vector3

# The pixel of `meshPoint` of the mesh in edit mode, in the plan or
# (`inView`) in the 3D panel.
function the bim pixel of mesh point {cad vector3:meshPoint} of {bim editor record:editor} in {bim screen layout record:layout} with {bim camera record:camera} in view {boolean:inView}:
    execute:
        if inView:
            return the bim view point (meshPoint's x) (meshPoint's y) (meshPoint's z + (the bim storey elevation of editor)) in layout with camera
        return the bim plan pixel of (a cad vector2 with x meshPoint's x and y meshPoint's y) in layout with camera

function draw bim bending schedule {bim reinforcing schedule result:scheduled} in {bim screen layout record:layout} using {bim text atlas record:typeface} in {graphics frame:frame}:
    execute:
        set left to layout's planRight + 16.0
        set y to layout's top + 28.0
        draw bim label (the string form of "Bending schedule — E exports HTML + TSV") at left and y using typeface in frame
        if scheduled's valid = false:
            draw bim label scheduled's message at left and (y + 28.0) using typeface in frame
            return nothing
        set y to y + 28.0
        draw bim label (the string form of "Mark / count / diameter / shape / length mm / total m / mass kg") at left and y using typeface in frame
        loop rowIndex from 0 to the length of (scheduled's rows's values):
            set rowValue to the item at rowIndex in (scheduled's rows's values)
            set y to y + 24.0
            if y < (layout's bottom - 48.0):
                set textValue to rowValue's mark + ((the string form of " / ") + (the string form of rowValue's count))
                set textValue to textValue + ((the string form of " / D") + (the string form of (the reinforcement millimetres of rowValue's diameter)))
                set textValue to textValue + ((the string form of " / ") + rowValue's shape)
                set textValue to textValue + ((the string form of " / ") + (the bim schedule text of (rowValue's length * 1000.0)))
                set textValue to textValue + ((the string form of " / ") + (the bim schedule text of (the bim reinforcing total length of rowValue)))
                set textValue to textValue + ((the string form of " / ") + (the bim schedule text of (the bim reinforcing mass of rowValue)))
                draw bim label textValue at left and y using typeface in frame
        if y >= (layout's bottom - 48.0):
            draw bim label (the string form of "More rows: export the complete schedule with E") at left and (layout's bottom - 24.0) using typeface in frame

function draw bim opening details of {bim editor record:editor} through {bim drawing transform record:transform} on {a pointer to a bim canvas record:canvas}:
    execute:
        set modelValue to editor's documentValue's current
        set cutHeight to (the bim storey elevation of editor) + (the bim plan cut height of editor)
        set solidEdges to an empty list of a cad vector2
        set dashedEdges to an empty list of a cad vector2
        loop openingCursor from 0 to the length of (modelValue's openings's values):
            set openingValue to the item at openingCursor in (modelValue's openings's values)
            set wallFound to the bim wall index of openingValue's hostId in modelValue
            set typeFound to the bim opening type index of openingValue's typeId in modelValue
            if wallFound's valid and typeFound's valid:
                set wallValue to the item at wallFound's position in (modelValue's walls's values)
                set openingType to the item at typeFound's position in (modelValue's openingTypes's values)
                set category to bim window category
                if openingType's isDoor:
                    set category to bim door category
                set visible to (wallValue's levelId = editor's levelId) and (bim category category is visible in editor's planRules)
                if visible and ((bim editor hides openingValue's id in plan of editor) = false):
                    set parts to the bim opening detail parts of openingValue's id in modelValue
                    append bim plan edges of parts (parts's values) in modelValue cut at cutHeight through transform into solidEdges and dashedEdges
        record bim strokes solidEdges coloured 65, 74 and 80 wide 1.0 on canvas
        record bim strokes dashedEdges coloured 125, 132 and 138 wide 0.7 on canvas
        free solidEdges
        free dashedEdges
