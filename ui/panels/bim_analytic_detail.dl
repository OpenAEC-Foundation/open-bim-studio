import ui/editor/bim_editor_core.dl
import elements/connection/bim_fastener_components.dl
import elements/connection/fastener_detail.dl
import elements/connection/connection_detail.dl
import viewer/vulkan/graphics.dl
import ui/panels/bim_ui.dl

function draw bim analytic detail of {bim editor record:editor} at {a 64 bit floating-point number:left} {a 64 bit floating-point number:top} sized {a 64 bit floating-point number:width} {a 64 bit floating-point number:height} yaw {a 64 bit floating-point number:yaw} elevation {a 64 bit floating-point number:elevation} zoom {a 64 bit floating-point number:zoom} using {bim text atlas record:typeface} in {graphics frame:frame}:
    execute:
        if (width < 100.0) or (height < 100.0):
            return nothing
        draw a rectangle at x left and y top with width width and height height in color red 235, green 240 and blue 245 in frame
        set message to the string form of "Select a fastener or connection; use Properties to edit it"
        set found to @intrinsic("construct", a bim index result record, false, 0)
        if editor's selectionKind = bim instance picked:
            set placed to the bim instance index of editor's selectionId in editor's documentValue's current
            if placed's valid:
                set instance to the item at placed's position in (editor's documentValue's current's instances's values)
                set found to the bim fastener component index of instance's componentId in editor's documentValue's current
        set parameters to an empty list of a 64 bit floating-point number
        if found's valid:
            set binding to the item at found's position in (editor's documentValue's current's fastenerComponents's values)
            set fastener to @intrinsic("construct", a connection fastener, 1, binding's componentId, binding's kind, the cad zero vector3, the cad z axis, binding's diameter, binding's length, binding's parameters)
            set message to the connection analytic detail issue of fastener
            if message = (the string form of ""):
                free parameters
                set parameters to the connection analytic detail parameters of fastener
                # Clear the whole header when switching away from an assembly.
                loop slot from 32 to 64:
                    append 0.0 to parameters
                set message to the bim fastener component name of binding
        else:
            set joint to the bim connection index of editor's selectionId in editor's documentValue's current
            if joint's valid:
                set spec to the item at joint's position in (editor's documentValue's current's connections's values)
                free parameters
                set parameters to the analytic assembly of connection spec in editor's documentValue's current
                if (the item at 31 in parameters) < 0.5:
                    clear parameters
                    set message to the string form of "Assembly unavailable: unsupported profile/fastener or more than 128 parts"
                else:
                    set message to spec's name + (the string form of " | Technical Colors")
        if (the length of parameters) > 0:
            set context to the gpu context of frame's window
            set scale to the ui scale of frame's window
            replace item at index 11 in parameters with (yaw)
            replace item at index 12 in parameters with (elevation)
            replace item at index 13 in parameters with (width * scale)
            replace item at index 14 in parameters with ((height - 76.0) * scale)
            replace item at index 15 in parameters with ((the item at 25 in parameters) * zoom)
            replace item at index 23 in parameters with (left * scale)
            replace item at index 24 in parameters with ((top + 42.0) * scale)
            loop slot from 0 to the length of parameters:
                set gpu parameter ((gpu analytic detail parameters start) + slot) to (the item at slot in parameters) in (@intrinsic("dereference", context))
            start gpu analytic detail in context
            set gpu colour to 255, 255, 255 and 255 in context
            add gpu vertex at left, (top + 42.0) and 0.0 in context
            add gpu vertex at (left + width), (top + 42.0) and 0.0 in context
            add gpu vertex at (left + width), (top + height - 34.0) and 0.0 in context
            add gpu vertex at left, (top + 42.0) and 0.0 in context
            add gpu vertex at (left + width), (top + height - 34.0) and 0.0 in context
            add gpu vertex at left, (top + height - 34.0) and 0.0 in context
            finish gpu batch in context
        free parameters
        draw bim text (the bim fitted form of ((the string form of "CSG detail | ") + message) in (width - 24.0) pixels of face (bim text body) with typeface) at (left + 12.0) and (top + 26.0) with typeface coloured 30, 45 and 60 in frame
        draw bim text (the bim fitted form of (the string form of "Orbit: right drag | Zoom: wheel | Close: Esc | Export pending") in (width - 24.0) pixels of face (bim text body) with typeface) at (left + 12.0) and (top + height - 12.0) with typeface coloured 45, 60 and 75 in frame
