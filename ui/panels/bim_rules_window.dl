# SPDX-License-Identifier: MPL-2.0
# The Drawing Rules window: every drawing type of the model in a tree on the
# left (each beneath the type it inherits from), and on the right the chosen
# type's rules in three tabs:
# - Visibility/Graphics, as Revit's: the category tree
#   (`views/common/bim_category_tree.dl`), each category opening into its
#   parts (structural and non-structural walls and floors), and per node
#   shown or hidden, halftone, and the colour and weight of its projection
#   and cut lines;
# - Annotation: which annotations its drawings get automatically;
# - Phasing: its phase filter.
# A cell shows what the type sets, or "Inherit" with the value it inherits;
# a click goes from inherit to on to off and back. In Visibility/Graphics a
# value set here is bright with a blue mark, an inherited one grey, and the
# clicks run through the choices back to inherited. New makes a child of the
# chosen type, Duplicate a sibling with its settings, Rename types a name,
# Delete refuses a type a view follows or another type inherits from.
import ui/editor/bim_editor.dl
import views/drawings/bim_text.dl
import views/common/bim_category_tree.dl

# What a click in the window does: `action` (`bim rules …`), the type it is
# about, and for a cell which setting (0 shown, 1 halftone, 2 annotation,
# 3 phase filter) at which slot; 10 and up a category tree field (`which`
# - 10, `bim node visible field` …) of node `slot`. Opening a category
# names it in `slot`.
class:
    patterns:
        [a|] bim rules hit record
    members:
        action as an integer
        typeId as a 64 bit integer
        which as an integer
        slot as an integer

function bim rules outside:
    replacement:
        -1
function bim rules inside:
    replacement:
        0
function bim rules choose type:
    replacement:
        1
function bim rules choose tab:
    replacement:
        2
function bim rules cycle cell:
    replacement:
        3
function bim rules new type:
    replacement:
        4
function bim rules duplicate type:
    replacement:
        5
function bim rules delete type:
    replacement:
        6
function bim rules rename type:
    replacement:
        7
function bim rules close:
    replacement:
        8
function bim rules toggle node:
    replacement:
        9
# Which settings are category tree fields: `which` minus this.
function bim rules tree field base:
    replacement:
        10

function a bim rules hit {integer:actionCode} on {a 64 bit integer:typeId} at {integer:which} and {integer:slot}:
    execute:
        return @intrinsic("construct", a bim rules hit record, actionCode, typeId, which, slot)

function the bim rules window width:
    replacement:
        980.0
function the bim rules window height:
    replacement:
        640.0

# ---------------------------------------------------------------- editing

# The drawing type a change applies to; after it, the plan shown takes its
# rules again when it follows a type.
local function refresh bim editor plan rules in {a pointer to a bim editor record:editor}:
    execute:
        show bim editor plan view editor's planViewId in editor
        set editor's viewsDirty to true

# A new drawing type beneath `parentId` (or a root for the refused id),
# inheriting everything; its id.
function add bim editor drawing type under {a 64 bit integer:parentId} in {a pointer to a bim editor record:editor}:
    execute:
        begin bim transaction in (the address of (editor's documentValue))
        set fresh to add bim drawing type named (the string form of "New drawing type") under parentId to (the address of (editor's documentValue's current))
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to the string form of "Drawing type added: Rename gives it a name"
        return fresh

# A copy of drawing type `typeId` beside it, with its settings; its id, or
# the refused id.
function duplicate bim editor drawing type {a 64 bit integer:typeId} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set found to the bim drawing type index of typeId in (@intrinsic("dereference", target))
        if found's valid = false:
            return the bim refused id
        set original to the item at found's position in (target's drawingTypes's values)
        begin bim transaction in (the address of (editor's documentValue))
        set fresh to the bim new id in target
        append (@intrinsic("construct", a bim drawing type record, fresh, original's name + (the string form of " (copy)"), original's parentId, the cad clone of original's shown, the cad clone of original's faint, the cad clone of original's annotations, original's phaseFilter)) to (target's drawingTypes's values)
        copy bim overrides of typeId to fresh in target
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to (the string form of "Duplicated ") + original's name
        return fresh

# Drawing type `typeId` named `title`.
function rename bim editor drawing type {a 64 bit integer:typeId} to {a string:title} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set found to the bim drawing type index of typeId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((the length of title) = 0):
            return nothing
        set original to the item at found's position in (target's drawingTypes's values)
        begin bim transaction in (the address of (editor's documentValue))
        replace item at index found's position in (target's drawingTypes's values) with (@intrinsic("construct", a bim drawing type record, original's id, title, original's parentId, original's shown, original's faint, original's annotations, original's phaseFilter))
        note bim change of typeId in target
        commit bim transaction in (the address of (editor's documentValue))

# Removes drawing type `typeId` unless a view follows it or a type inherits
# from it; whether it went.
function delete bim editor drawing type {a 64 bit integer:typeId} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set found to the bim drawing type index of typeId in (@intrinsic("dereference", target))
        if found's valid = false:
            return false
        loop cursor from 0 to the length of (target's views's values):
            if (the item at cursor in (target's views's values))'s drawingTypeId = typeId:
                set editor's message to (the string form of "Not deleted: view ") + ((the item at cursor in (target's views's values))'s name + (the string form of " follows it"))
                return false
        loop cursor from 0 to the length of (target's drawingTypes's values):
            if (the item at cursor in (target's drawingTypes's values))'s parentId = typeId:
                set editor's message to (the string form of "Not deleted: ") + ((the item at cursor in (target's drawingTypes's values))'s name + (the string form of " inherits from it"))
                return false
        begin bim transaction in (the address of (editor's documentValue))
        remove item found's position from (target's drawingTypes's values)
        drop bim settings of typeId in target
        note bim change of typeId in target
        commit bim transaction in (the address of (editor's documentValue))
        set editor's message to the string form of "Drawing type deleted"
        return true

# The next value of a setting a click gives: inherit, then on (1), then off
# (0), then inherit again; a phase filter runs through the filters.
function the bim next setting after {integer:value} for {integer:which}:
    execute:
        if which = 3:
            if value >= ((the bim phase filter count) - 1):
                return -1
            return value + 1
        if value < 0:
            return 1
        if value = 1:
            return 0
        return -1

# One click on a cell of drawing type `typeId`.
function cycle bim editor drawing type {a 64 bit integer:typeId} setting {integer:which} at {integer:slot} in {a pointer to a bim editor record:editor}:
    execute:
        set target to the address of (editor's documentValue's current)
        set found to the bim drawing type index of typeId in (@intrinsic("dereference", target))
        if found's valid = false:
            return nothing
        if which >= bim rules tree field base:
            begin bim transaction in (the address of (editor's documentValue))
            cycle bim override (which - (bim rules tree field base)) of node slot on typeId in target
            commit bim transaction in (the address of (editor's documentValue))
            refresh bim editor plan rules in editor
            return nothing
        set original to the item at found's position in (target's drawingTypes's values)
        set value to -1
        if which = 0:
            if slot < (the length of (original's shown's values)):
                set value to the item at slot in (original's shown's values)
        if which = 1:
            if slot < (the length of (original's faint's values)):
                set value to the item at slot in (original's faint's values)
        if which = 2:
            if slot < (the length of (original's annotations's values)):
                set value to the item at slot in (original's annotations's values)
        if which = 3:
            set value to original's phaseFilter
        begin bim transaction in (the address of (editor's documentValue))
        ignore set bim drawing type typeId setting which at slot to (the bim next setting after value for which) in target
        commit bim transaction in (the address of (editor's documentValue))
        refresh bim editor plan rules in editor

# Runs what a click hit; the type chosen afterwards.
function apply bim rules hit {bim rules hit record:hit} choosing {a 64 bit integer:chosenId} in {a pointer to a bim editor record:editor}:
    execute:
        if hit's action = bim rules choose type:
            return hit's typeId
        if hit's action = bim rules cycle cell:
            cycle bim editor drawing type chosenId setting hit's which at hit's slot in editor
            return chosenId
        if hit's action = bim rules new type:
            return add bim editor drawing type under chosenId in editor
        if hit's action = bim rules duplicate type:
            set copied to duplicate bim editor drawing type chosenId in editor
            if copied = the bim refused id:
                return chosenId
            return copied
        if hit's action = bim rules delete type:
            if delete bim editor drawing type chosenId in editor:
                return the bim refused id
        return chosenId

# Whether category `categoryCode` is opened in the tree, its parts shown.
function bim rules category {integer:categoryCode} is open in {a pointer to a list:openCategories}:
    execute:
        loop cursor from 0 to the length of openCategories:
            if (the item at cursor in openCategories) = categoryCode:
                return true
        return false

# Opens category `categoryCode` in the tree, or closes it when open.
function toggle bim rules category {integer:categoryCode} in {a pointer to a list:openCategories}:
    execute:
        loop cursor from 0 to the length of openCategories:
            if (the item at cursor in openCategories) = categoryCode:
                remove item cursor from openCategories
                return nothing
        append categoryCode to openCategories

# ---------------------------------------------------------------- drawing

local function fill bim rules box {a 64 bit floating-point number:left} {a 64 bit floating-point number:top} {a 64 bit floating-point number:across} {a 64 bit floating-point number:tall} coloured {integer:red}, {integer:green} and {integer:blue} in {graphics frame:frame}:
    execute:
        draw a rectangle at x left and y top with width across and height tall in color red red, green green and blue blue in frame

# The drawing types in tree order, each after its parent and before its
# siblings' trees, with how deep it lies.
local function the bim drawing type order of {bim model record:modelValue} noting {a pointer to a list:depthList}:
    execute:
        set ordered to an empty list of a 64 bit integer
        set stack to an empty list of a 64 bit integer
        set stackDepths to an empty list of an integer
        set typeList to modelValue's drawingTypes's values
        set rootCursor to (the length of typeList) - 1
        loop while rootCursor >= 0:
            set candidate to the item at rootCursor in typeList
            if (the bim drawing type index of candidate's parentId in modelValue)'s valid = false:
                append candidate's id to stack
                append 0 to stackDepths
            set rootCursor to rootCursor - 1
        loop while ((the length of stack) > 0) and ((the length of ordered) <= (the length of typeList)):
            set last to (the length of stack) - 1
            set current to the item at last in stack
            set currentDepth to the item at last in stackDepths
            remove item last from stack
            remove item last from stackDepths
            append current to ordered
            append currentDepth to depthList
            set childCursor to (the length of typeList) - 1
            loop while childCursor >= 0:
                set child to the item at childCursor in typeList
                if child's parentId = current:
                    append child's id to stack
                    append (currentDepth + 1) to stackDepths
                set childCursor to childCursor - 1
        free stack
        free stackDepths
        return ordered

# The text of a cell: what the type sets, or "Inherit (…)" with what it
# inherits; `onWord` and `offWord` name the two values.
local function the bim rules cell text of {integer:own} resolving {integer:inherited} saying {a string:onWord} or {a string:offWord}:
    execute:
        set resolvedWord to offWord
        if inherited = 1:
            set resolvedWord to onWord
        if own < 0:
            return ((the string form of "Inherit (") + resolvedWord) + (the string form of ")")
        if own = 1:
            return onWord
        return offWord

# Where column `fieldCode` of the Visibility/Graphics table starts, from the
# pane's left: shown, halftone, then the projection lines' colour and
# weight and the cut lines' colour and weight (the tree's fields in order).
local function the bim tree column {integer:fieldCode} offset:
    execute:
        if fieldCode = 0:
            return 220.0
        if fieldCode = 1:
            return 294.0
        if fieldCode = 2:
            return 368.0
        if fieldCode = 3:
            return 464.0
        if fieldCode = 4:
            return 528.0
        return 624.0

local function the bim tree column {integer:fieldCode} width:
    execute:
        if (fieldCode = 2) or (fieldCode = 4):
            return 96.0
        if (fieldCode = 3) or (fieldCode = 5):
            return 64.0
        return 74.0

# The text of a tree cell of column `fieldCode` showing `value` (-1 the
# drawing's own).
local function the bim tree cell text of {a 64 bit integer:value} in column {integer:fieldCode}:
    execute:
        set on to value = (1 as a 64 bit integer)
        if fieldCode = bim node visible field:
            if on:
                return the string form of "Shown"
            return the string form of "Hidden"
        if fieldCode = bim node halftone field:
            if on:
                return the string form of "Halftone"
            return the string form of "Normal"
        if (fieldCode = bim projection colour field) or (fieldCode = bim cut colour field):
            return the bim name of colour value
        return the bim name of weight value

# The Visibility/Graphics tab of drawing type `chosenId`: the category tree
# with `openCategories` opened, from `paneLeft` and `tableTop`. A row's
# cells show what the type sets (bright, with a blue mark) or what it
# inherits from the category or its parent types (grey). Writes what a
# click at the pointer would hit into `result`.
function draw bim visibility tree of {a 64 bit integer:chosenId} in {bim model record:modelValue} opening {a pointer to a list:openCategories} from {a 64 bit floating-point number:paneLeft} and {a 64 bit floating-point number:tableTop} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} into {a pointer to a bim rules hit record:result} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set fallback to the bim template rules of view kind bim plan view kind
        set entries to the bim tree settings of modelValue
        set chain to the bim rule chain of chosenId in modelValue
        draw bim text (the string form of "Projection lines") at (paneLeft + (the bim tree column 2 offset)) and (tableTop + 10.0) in face (bim text caption) with atlas coloured 150, 150 and 150 in frame
        draw bim text (the string form of "Cut lines") at (paneLeft + (the bim tree column 4 offset)) and (tableTop + 10.0) in face (bim text caption) with atlas coloured 150, 150 and 150 in frame
        set headings to [the string form of "Visible", the string form of "Halftone", the string form of "Colour", the string form of "Weight", the string form of "Colour", the string form of "Weight"]
        draw bim text (the string form of "Category") at paneLeft and (tableTop + 24.0) in face (bim text caption) with atlas coloured 150, 150 and 150 in frame
        loop field from 0 to the bim node field count:
            draw bim text (the item at field in headings) at (paneLeft + (the bim tree column field offset)) and (tableTop + 24.0) in face (bim text caption) with atlas coloured 150, 150 and 150 in frame
        free headings
        set row to 0
        loop categoryCode from 0 to the bim category count:
            set partCount to the bim part count of category categoryCode
            set opened to bim rules category categoryCode is open in openCategories
            set partsShown to 1
            if opened:
                set partsShown to partCount
            loop part from 0 to partsShown:
                set key to the bim node key of category categoryCode part part
                set rowTop to (tableTop + 30.0) + ((row as a 64 bit floating-point number) * 20.0)
                set row to row + 1
                # The node's name; a category with parts opens and closes.
                set nameLeft to paneLeft + 16.0
                if part > 0:
                    set nameLeft to paneLeft + 32.0
                if (part = 0) and (partCount > 1):
                    set overName to (((pointerX >= paneLeft) and (pointerX < (paneLeft + 210.0))) and (pointerY >= rowTop)) and (pointerY < (rowTop + 20.0))
                    if overName:
                        fill bim rules box paneLeft (rowTop + 1.0) 210.0 19.0 coloured 52, 52 and 56 in frame
                        set result's action to bim rules toggle node
                        set result's typeId to chosenId
                        set result's which to -1
                        set result's slot to categoryCode
                    set sign to the string form of "+"
                    if opened:
                        set sign to the string form of "-"
                    fill bim rules box (paneLeft + 2.0) (rowTop + 5.0) 11.0 11.0 coloured 70, 70 and 76 in frame
                    draw bim text sign at (paneLeft + 4.0) and (rowTop + 14.0) in face (bim text small) with atlas coloured 235, 235 and 235 in frame
                draw bim text (the bim name of node key) at nameLeft and (rowTop + 14.0) in face (bim text small) with atlas coloured 220, 220 and 220 in frame
                loop field from 0 to the bim node field count:
                    set own to the bim own override field of node key on chosenId among entries in modelValue
                    set inherited to the bim resolved override field of node key along chain skipping own true among entries in modelValue
                    if (field <= bim node halftone field) and (inherited < (0 as a 64 bit integer)):
                        set inherited to 0 as a 64 bit integer
                        if (field = bim node visible field) and (bim category categoryCode is visible in fallback):
                            set inherited to 1 as a 64 bit integer
                    set value to inherited
                    if own >= (0 as a 64 bit integer):
                        set value to own
                    set cellLeft to paneLeft + (the bim tree column field offset)
                    set cellWidth to the bim tree column field width
                    set over to (((pointerX >= cellLeft) and (pointerX < ((cellLeft + cellWidth) - 4.0))) and (pointerY >= rowTop)) and (pointerY < (rowTop + 20.0))
                    set shade to 46
                    if over:
                        set shade to 64
                        set result's action to bim rules cycle cell
                        set result's typeId to chosenId
                        if (part = 0) and (field <= bim node halftone field):
                            set result's which to field
                            set result's slot to categoryCode
                        else:
                            set result's which to (bim rules tree field base) + field
                            set result's slot to key
                    fill bim rules box cellLeft (rowTop + 1.0) (cellWidth - 4.0) 19.0 coloured shade, shade and (shade + 6) in frame
                    set textLeft to cellLeft + 6.0
                    if own >= (0 as a 64 bit integer):
                        fill bim rules box cellLeft (rowTop + 1.0) 3.0 19.0 coloured 6, 150 and 215 in frame
                    if ((field = bim projection colour field) or (field = bim cut colour field)) and (value >= (0 as a 64 bit integer)):
                        fill bim rules box (cellLeft + 6.0) (rowTop + 5.0) 11.0 11.0 coloured (the bim red of colour value), (the bim green of colour value) and (the bim blue of colour value) in frame
                        set textLeft to cellLeft + 21.0
                    set ink to 242
                    if own < (0 as a 64 bit integer):
                        set ink to 150
                    draw bim text (the bim tree cell text of value in column field) at textLeft and (rowTop + 14.0) in face (bim text small) with atlas coloured ink, ink and ink in frame
        set noteTop to (tableTop + 30.0) + (((row as a 64 bit floating-point number) * 20.0) + 16.0)
        draw bim text (the string form of "Bright with a blue mark: set on this type. Grey: inherited. A click runs through the choices back to inherited.") at paneLeft and noteTop in face (bim text caption) with atlas coloured 150, 150 and 150 in frame

# Draws the window centred in the `width` by `height` window, the type
# `chosenId` chosen and tab `tabIndex` open (0 visibility, 1 annotation,
# 2 phasing) with the categories `openCategories` opened in the tree, its
# name being typed as `typed` when `renaming`; returns what
# a click at the pointer would hit.
function draw bim drawing rules of {bim editor record:editor} choosing {a 64 bit integer:chosenId} on tab {integer:tabIndex} opening {a pointer to a list:openCategories} renaming {boolean:renaming} as {a string:typed} across {a 64 bit floating-point number:screenWidth} by {a 64 bit floating-point number:screenHeight} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set modelValue to editor's documentValue's current
        set boxWidth to the bim rules window width
        set boxHeight to the bim rules window height
        set left to the maximum of 8.0 and ((screenWidth - boxWidth) * 0.5)
        set top to the maximum of 8.0 and ((screenHeight - boxHeight) * 0.5)
        set result to a bim rules hit (bim rules outside) on (the bim refused id) at (-1) and (-1)
        if (((pointerX >= left) and (pointerX < (left + boxWidth))) and (pointerY >= top)) and (pointerY < (top + boxHeight)):
            set result to a bim rules hit (bim rules inside) on (the bim refused id) at (-1) and (-1)
        fill bim rules box (left + 4.0) (top + 4.0) boxWidth boxHeight coloured 12, 12 and 12 in frame
        fill bim rules box left top boxWidth boxHeight coloured 38, 38 and 40 in frame
        fill bim rules box left top boxWidth 30.0 coloured 22, 74 and 104 in frame
        draw bim text (the string form of "Drawing Rules") at (left + 12.0) and (top + 20.0) in face (bim text bold) with atlas coloured 242, 242 and 242 in frame
        set closeLeft to (left + boxWidth) - 30.0
        if (((pointerX >= closeLeft) and (pointerX < (left + boxWidth))) and (pointerY >= top)) and (pointerY < (top + 30.0)):
            fill bim rules box closeLeft top 30.0 30.0 coloured 200, 60 and 50 in frame
            set result to a bim rules hit (bim rules close) on (the bim refused id) at (-1) and (-1)
        draw bim text (the string form of "x") at (closeLeft + 11.0) and (top + 20.0) in face (bim text bold) with atlas coloured 242, 242 and 242 in frame
        # The tree of drawing types.
        set typeDepths to an empty list of an integer
        set ordered to the bim drawing type order of modelValue noting typeDepths
        set listTop to top + 40.0
        set listLeft to left + 10.0
        set listWidth to 250.0
        fill bim rules box listLeft listTop listWidth (boxHeight - 90.0) coloured 30, 30 and 32 in frame
        loop rowCursor from 0 to the length of ordered:
            set rowId to the item at rowCursor in ordered
            set rowTop to (listTop + 4.0) + ((rowCursor as a 64 bit floating-point number) * 22.0)
            if (rowTop + 22.0) < ((top + boxHeight) - 50.0):
                set found to the bim drawing type index of rowId in modelValue
                set rowName to (the item at found's position in (modelValue's drawingTypes's values))'s name
                set over to (((pointerX >= listLeft) and (pointerX < (listLeft + listWidth))) and (pointerY >= rowTop)) and (pointerY < (rowTop + 22.0))
                if rowId = chosenId:
                    fill bim rules box (listLeft + 2.0) rowTop (listWidth - 4.0) 22.0 coloured 22, 74 and 104 in frame
                else if over:
                    fill bim rules box (listLeft + 2.0) rowTop (listWidth - 4.0) 22.0 coloured 52, 52 and 56 in frame
                if over:
                    set result to a bim rules hit (bim rules choose type) on rowId at (-1) and (-1)
                set indent to 10.0 + (((the item at rowCursor in typeDepths) as a 64 bit floating-point number) * 16.0)
                set rowFace to bim text small
                if (the item at rowCursor in typeDepths) = 0:
                    set rowFace to bim text bold
                draw bim text rowName at (listLeft + indent) and (rowTop + 15.0) in face rowFace with atlas coloured 235, 235 and 235 in frame
        free ordered
        free typeDepths
        # The buttons under the tree.
        set buttonTop to (top + boxHeight) - 40.0
        set buttonNames to [the string form of "New", the string form of "Duplicate", the string form of "Rename", the string form of "Delete"]
        set buttonActions to [bim rules new type, bim rules duplicate type, bim rules rename type, bim rules delete type]
        loop buttonCursor from 0 to 4:
            set buttonLeft to listLeft + ((buttonCursor as a 64 bit floating-point number) * 63.0)
            set over to (((pointerX >= buttonLeft) and (pointerX < (buttonLeft + 59.0))) and (pointerY >= buttonTop)) and (pointerY < (buttonTop + 26.0))
            set shade to 58
            if over:
                set shade to 6
                set result to a bim rules hit (the item at buttonCursor in buttonActions) on chosenId at (-1) and (-1)
            if over:
                fill bim rules box buttonLeft buttonTop 59.0 26.0 coloured 6, 120 and 190 in frame
            else:
                fill bim rules box buttonLeft buttonTop 59.0 26.0 coloured shade, shade and shade in frame
            draw bim text (the item at buttonCursor in buttonNames) at (buttonLeft + 6.0) and (buttonTop + 17.0) in face (bim text small) with atlas coloured 242, 242 and 242 in frame
        # The chosen type's rules.
        set paneLeft to (listLeft + listWidth) + 16.0
        set chosenFound to the bim drawing type index of chosenId in modelValue
        if chosenFound's valid = false:
            draw bim text (the string form of "Choose a drawing type, or New for one") at paneLeft and (top + 60.0) with atlas coloured 200, 200 and 200 in frame
            return result
        set chosenType to the item at chosenFound's position in (modelValue's drawingTypes's values)
        set heading to chosenType's name
        if renaming:
            set heading to typed + (the string form of "_")
            fill bim rules box (paneLeft - 4.0) (top + 38.0) 360.0 24.0 coloured 50, 50 and 56 in frame
        draw bim text heading at paneLeft and (top + 56.0) in face (bim text bold) with atlas coloured 242, 242 and 242 in frame
        set parentLine to the string form of "A root: what it leaves open follows the floor plan default"
        set parentFound to the bim drawing type index of chosenType's parentId in modelValue
        if parentFound's valid:
            set parentLine to (the string form of "Inherits from ") + (the item at parentFound's position in (modelValue's drawingTypes's values))'s name
        draw bim text parentLine at paneLeft and (top + 76.0) in face (bim text small) with atlas coloured 170, 170 and 170 in frame
        # The tabs.
        set tabNames to [the string form of "Visibility/Graphics", the string form of "Annotation", the string form of "Phasing"]
        set tabLeft to paneLeft
        loop tabCursor from 0 to 3:
            set tabWidth to (the bim text width of (the item at tabCursor in tabNames) in face (bim text small) of atlas) + 24.0
            set over to (((pointerX >= tabLeft) and (pointerX < (tabLeft + tabWidth))) and (pointerY >= (top + 88.0))) and (pointerY < (top + 112.0))
            if tabCursor = tabIndex:
                fill bim rules box tabLeft (top + 88.0) tabWidth 24.0 coloured 58, 58 and 62 in frame
                fill bim rules box tabLeft (top + 110.0) tabWidth 2.0 coloured 6, 150 and 215 in frame
            else if over:
                fill bim rules box tabLeft (top + 88.0) tabWidth 24.0 coloured 48, 48 and 52 in frame
            if over:
                set result to a bim rules hit (bim rules choose tab) on chosenId at (-1) and tabCursor
            draw bim text (the item at tabCursor in tabNames) at (tabLeft + 12.0) and (top + 105.0) in face (bim text small) with atlas coloured 235, 235 and 235 in frame
            set tabLeft to (tabLeft + tabWidth) + 4.0
        set tableTop to top + 122.0
        set firstCell to paneLeft + 190.0
        set cellWidth to 190.0
        if tabIndex = 0:
            draw bim visibility tree of chosenId in modelValue opening openCategories from paneLeft and tableTop pointing at pointerX and pointerY into (the address of result) using atlas in frame
        if tabIndex = 1:
            draw bim text (the string form of "Annotation") at paneLeft and (tableTop + 14.0) in face (bim text caption) with atlas coloured 150, 150 and 150 in frame
            draw bim text (the string form of "Applied") at firstCell and (tableTop + 14.0) in face (bim text caption) with atlas coloured 150, 150 and 150 in frame
            loop ruleCode from 0 to the bim annotation count:
                set rowTop to (tableTop + 20.0) + ((ruleCode as a 64 bit floating-point number) * 21.0)
                draw bim text (the bim name of annotation ruleCode) at paneLeft and (rowTop + 14.0) in face (bim text small) with atlas coloured 220, 220 and 220 in frame
                set own to -1
                if ruleCode < (the length of (chosenType's annotations's values)):
                    set own to the item at ruleCode in (chosenType's annotations's values)
                set inherited to 0
                if parentFound's valid:
                    set inherited to the maximum of 0 and (the bim resolved setting 2 at ruleCode of drawing type chosenType's parentId in modelValue)
                set cellText to the bim rules cell text of own resolving inherited saying (the string form of "On") or (the string form of "Off")
                set over to (((pointerX >= firstCell) and (pointerX < (firstCell + cellWidth))) and (pointerY >= rowTop)) and (pointerY < (rowTop + 20.0))
                set shade to 46
                if over:
                    set shade to 64
                    set result to a bim rules hit (bim rules cycle cell) on chosenId at 2 and ruleCode
                fill bim rules box firstCell (rowTop + 1.0) (cellWidth - 6.0) 19.0 coloured shade, shade and (shade + 6) in frame
                set ink to 242
                if own < 0:
                    set ink to 150
                draw bim text cellText at (firstCell + 6.0) and (rowTop + 14.0) in face (bim text small) with atlas coloured ink, ink and ink in frame
        if tabIndex = 2:
            set rowTop to tableTop + 20.0
            draw bim text (the string form of "Phase filter") at paneLeft and (rowTop + 14.0) in face (bim text small) with atlas coloured 220, 220 and 220 in frame
            set own to chosenType's phaseFilter
            set inheritedFilter to bim show all phases
            if parentFound's valid:
                set inheritedFilter to the bim phase filter of drawing type chosenType's parentId in modelValue
            set cellText to the bim name of phase filter own
            if own < 0:
                set cellText to ((the string form of "Inherit (") + (the bim name of phase filter inheritedFilter)) + (the string form of ")")
            set over to (((pointerX >= firstCell) and (pointerX < (firstCell + cellWidth))) and (pointerY >= rowTop)) and (pointerY < (rowTop + 20.0))
            set shade to 46
            if over:
                set shade to 64
                set result to a bim rules hit (bim rules cycle cell) on chosenId at 3 and 0
            fill bim rules box firstCell (rowTop + 1.0) (cellWidth - 6.0) 19.0 coloured shade, shade and (shade + 6) in frame
            set ink to 242
            if own < 0:
                set ink to 150
            draw bim text cellText at (firstCell + 6.0) and (rowTop + 14.0) in face (bim text small) with atlas coloured ink, ink and ink in frame
            draw bim text (the string form of "Phases themselves (and elements' phases) arrive with plan step 35.") at paneLeft and (rowTop + 50.0) in face (bim text small) with atlas coloured 150, 150 and 150 in frame
        return result
