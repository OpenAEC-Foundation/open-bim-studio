# SPDX-License-Identifier: MPL-2.0
# The command line at the bottom left of the window: an input box for the
# sentences of `automation/bim_sentences.dl`, with the suggestions (or, on
# an empty line, the sentences run before and their answers) in a list just
# above it. The snap toggles keep the right of the strip, the status bar
# stays below. Without the keys the box shows the editor's prompt, as the
# command line always did; `:` or Ctrl+L (or a click in the box) gives it
# the keys.
import ui/panels/bim_ui.dl
import automation/bim_sentences.dl

function bim command box left:
    replacement:
        84.0

# The box's right edge: half the window or so, short of the snap toggles.
function the bim command box right in {a 64 bit floating-point number:screenWidth}:
    execute:
        return the maximum of 320.0 and (the minimum of (screenWidth * 0.55) and (screenWidth - 560.0))

function bim command box holds {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} in {a 64 bit floating-point number:screenWidth} by {a 64 bit floating-point number:screenHeight}:
    execute:
        set lineTop to the bim ui canvas bottom in screenHeight
        set withinWidth to (pointerX >= (bim command box left)) and (pointerX < (the bim command box right in screenWidth))
        return withinWidth and ((pointerY >= lineTop) and (pointerY < (lineTop + (bim ui command line height))))

# The end of `spelled` that fits in `room` pixels, cut at a character.
local function the bim command tail of {a string:spelled} in {a 64 bit floating-point number:room} pixels using {bim text atlas record:atlas}:
    execute:
        set startIndex to 0
        set tailText to spelled
        loop while ((the bim text width of tailText in face (bim text body) of atlas) > room) and (startIndex < (the length of spelled)):
            set startIndex to startIndex + 1
            set skipping to true
            loop while skipping and (startIndex < (the length of spelled)):
                if ((the bim sentence byte at startIndex in spelled) bitwise and 192) = 128:
                    set startIndex to startIndex + 1
                else:
                    set skipping to false
            set tailText to the substring of spelled from startIndex spanning ((the length of spelled) - startIndex) bytes
        return tailText

# The command line (`prompter`), the editor's `prompt` and the status bar.
function draw bim sentence line {bim command line record:prompter} saying {a string:prompt} and status {a string:statusText} in {a 64 bit floating-point number:screenWidth} by {a 64 bit floating-point number:screenHeight} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        set lineTop to the bim ui canvas bottom in screenHeight
        set boxLeft to bim command box left
        set boxRight to the bim command box right in screenWidth
        set boxWidth to boxRight - boxLeft
        draw bim ui rectangle 0.0 lineTop screenWidth (bim ui command line height) painted scheme's panel in frame
        draw bim ui rectangle 0.0 lineTop screenWidth 1.0 painted scheme's border in frame
        draw bim ui text (the string form of "Command:") at 10.0 and (lineTop + 17.0) in face (bim text bold) with atlas painted scheme's accentInk in frame
        if prompter's focused:
            draw bim ui box boxLeft (lineTop + 2.0) boxWidth 20.0 radius 3.0 painted scheme's raised edged scheme's focus wide 1.0 in frame
            set shownTyped to the bim command tail of prompter's typed in (boxWidth - 120.0) pixels using atlas
            draw bim ui text shownTyped at (boxLeft + 6.0) and (lineTop + 17.0) in face (bim text body) with atlas painted scheme's ink in frame
            set caretX to (boxLeft + 7.0) + (the bim text width of shownTyped in face (bim text body) of atlas)
            draw bim ui rectangle caretX (lineTop + 5.0) 1.5 14.0 painted scheme's accentInk in frame
            set ghostText to the bim command line ghost of prompter
            if (the length of ghostText) > 0:
                set fittedGhost to the bim fitted form of ghostText in ((boxRight - caretX) - 8.0) pixels of face (bim text body) with atlas
                draw bim ui text fittedGhost at (caretX + 2.0) and (lineTop + 17.0) in face (bim text body) with atlas painted scheme's inkDisabled in frame
            # Just above the box: what the editor asks (a tool's prompt), then
            # the suggestions, or on an empty line the sentences run before.
            set rowTexts to an empty list of a string
            set rowAnswers to an empty list of a string
            set rowFlags to an empty list of an integer
            if (the length of prompt) > 0:
                append prompt to rowTexts
                append (the string form of "") to rowAnswers
                append 2 to rowFlags
            if (the length of prompter's typed) = 0:
                set historyCount to the length of (prompter's sentences's values)
                set firstShown to historyCount - (bim command line shown rows)
                if firstShown < 0:
                    set firstShown to 0
                loop historyCursor from firstShown to historyCount:
                    append (the item at historyCursor in (prompter's sentences's values)) to rowTexts
                    append (the item at historyCursor in (prompter's answers's values)) to rowAnswers
                    set historyFlag to 0
                    if (the item at historyCursor in (prompter's failures's values)) = true:
                        set historyFlag to 3
                    if historyCursor = prompter's recalled:
                        set historyFlag to 1
                    append historyFlag to rowFlags
                if historyCount = 0:
                    append (the string form of "Type a sentence: draw a wall from (0, 0) to (5, 0), select the wall 12, open the sheet \"A-101\", undo") to rowTexts
                    append (the string form of "") to rowAnswers
                    append 2 to rowFlags
            else:
                set offered to the bim command line suggestions of prompter
                set chosenRow to prompter's choice
                if (chosenRow < 0) or (chosenRow >= (the length of offered)):
                    set chosenRow to 0
                loop offerCursor from 0 to the length of offered:
                    append (the item at offerCursor in offered) to rowTexts
                    append (the string form of "") to rowAnswers
                    if offerCursor = chosenRow:
                        append 1 to rowFlags
                    else:
                        append 0 to rowFlags
                free offered
            set rowCount to the length of rowTexts
            if rowCount > 0:
                set listHeight to ((rowCount as a 64 bit floating-point number) * 22.0) + 8.0
                set listTop to (lineTop - listHeight) - 2.0
                draw bim ui box boxLeft listTop boxWidth listHeight radius 3.0 painted scheme's raised edged scheme's border wide 1.0 in frame
                set rowTop to listTop + 4.0
                loop rowCursor from 0 to rowCount:
                    set rowFlag to the item at rowCursor in rowFlags
                    set rowAnswer to the item at rowCursor in rowAnswers
                    if rowFlag = 1:
                        draw bim ui rounded rectangle (boxLeft + 4.0) rowTop (boxWidth - 8.0) 22.0 radius 3.0 painted scheme's selected in frame
                        draw bim ui rectangle (boxLeft + 4.0) (rowTop + 4.0) 2.0 14.0 painted scheme's selectedBar in frame
                    set textRoom to boxWidth - 24.0
                    if (the length of rowAnswer) > 0:
                        set textRoom to (boxWidth * 0.5) - 16.0
                    set fittedRow to the bim fitted form of (the item at rowCursor in rowTexts) in textRoom pixels of face (bim text small) with atlas
                    if rowFlag = 2:
                        draw bim ui text fittedRow at (boxLeft + 12.0) and (rowTop + 15.0) in face (bim text small) with atlas painted scheme's inkSecondary in frame
                    else:
                        draw bim ui text fittedRow at (boxLeft + 12.0) and (rowTop + 15.0) in face (bim text small) with atlas painted scheme's ink in frame
                    if (the length of rowAnswer) > 0:
                        set fittedAnswer to the bim fitted form of rowAnswer in ((boxWidth * 0.5) - 16.0) pixels of face (bim text small) with atlas
                        if rowFlag = 3:
                            draw bim ui text fittedAnswer at ((boxLeft + (boxWidth * 0.5)) + 4.0) and (rowTop + 15.0) in face (bim text small) with atlas painted scheme's accentInk in frame
                        else:
                            draw bim ui text fittedAnswer at ((boxLeft + (boxWidth * 0.5)) + 4.0) and (rowTop + 15.0) in face (bim text small) with atlas painted scheme's inkSecondary in frame
                    set rowTop to rowTop + 22.0
            free rowTexts
            free rowAnswers
            free rowFlags
        else:
            set fittedPrompt to the bim fitted form of prompt in (boxWidth - 6.0) pixels of face (bim text body) with atlas
            draw bim ui text fittedPrompt at 90.0 and (lineTop + 17.0) in face (bim text body) with atlas painted scheme's ink in frame
            if (the length of prompt) = 0:
                draw bim ui text (the string form of "Press : or Ctrl+L to type a sentence") at 90.0 and (lineTop + 17.0) in face (bim text body) with atlas painted scheme's inkDisabled in frame
        # The status bar follows the theme, with a line above it.
        set barTop to lineTop + (bim ui command line height)
        draw bim ui rectangle 0.0 barTop screenWidth (bim ui status bar height) painted scheme's statusbar in frame
        draw bim ui rectangle 0.0 barTop screenWidth 1.0 painted scheme's border in frame
        draw bim ui text statusText at 10.0 and (barTop + 18.0) in face (bim text small) with atlas painted scheme's statusbarInk in frame
