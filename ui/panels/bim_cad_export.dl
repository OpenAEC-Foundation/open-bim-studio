# SPDX-License-Identifier: MPL-2.0
# The model as a CAD drawing for DWG and DXF (Collaborate > Export):
#
# - 2D: the plan of the active storey as the editor cuts it. Each element's
#   cut is a closed polyline on its category's layer; the grids are lines
#   with their names at both ends; the storey's sketch lines, faces and
#   texts follow; each room is its outline with its area in its middle.
# - 3D: every element shown in the 3D view, in metres. An element the fast
#   kernel built as a closed planar polyhedron is a 3DSOLID (ACIS); any
#   other shape, and a polyhedron the SAT writer refuses, is a polyface
#   mesh of its scene triangles. Elements are on their category's layer.
#
# Both are written as `<stem>-plan` or `<stem>-3d` with `.dxf` and `.dwg`
# (`exchange/dxf_dwg`) into the working directory, beside the IFC export.
import exchange/dxf_dwg/bim_dxf_write.dl
import exchange/dxf_dwg/bim_dwg_write.dl
import exchange/ifcx/bim_file.dl
import ui/editor/bim_editor.dl
import viewer/bim_scene.dl
import views/common/bim_view.dl

# The layer of a view category: its name and an AutoCAD colour index.
function the bim cad layer of category {integer:categoryCode} in {a pointer to a bim cad drawing record:drawing}:
    execute:
        if categoryCode = bim wall category:
            return the bim cad layer (the string form of "Walls") coloured 7 in drawing
        if categoryCode = bim slab category:
            return the bim cad layer (the string form of "Floors") coloured 8 in drawing
        if categoryCode = bim door category:
            return the bim cad layer (the string form of "Doors") coloured 3 in drawing
        if categoryCode = bim window category:
            return the bim cad layer (the string form of "Windows") coloured 4 in drawing
        if categoryCode = bim space category:
            return the bim cad layer (the string form of "Spaces") coloured 9 in drawing
        if categoryCode = bim grid category:
            return the bim cad layer (the string form of "Grids") coloured 1 in drawing
        if categoryCode = bim dimension category:
            return the bim cad layer (the string form of "Dimensions") coloured 2 in drawing
        if categoryCode = bim column category:
            return the bim cad layer (the string form of "Columns") coloured 6 in drawing
        if categoryCode = bim beam category:
            return the bim cad layer (the string form of "Beams") coloured 5 in drawing
        if categoryCode = bim roof category:
            return the bim cad layer (the string form of "Roofs") coloured 30 in drawing
        if categoryCode = bim stair category:
            return the bim cad layer (the string form of "Stairs") coloured 40 in drawing
        if categoryCode = bim railing category:
            return the bim cad layer (the string form of "Railings") coloured 140 in drawing
        if categoryCode = bim furniture category:
            return the bim cad layer (the string form of "Furniture") coloured 200 in drawing
        if categoryCode = bim line category:
            return the bim cad layer (the string form of "Lines") coloured 7 in drawing
        if categoryCode = bim text category:
            return the bim cad layer (the string form of "Text") coloured 7 in drawing
        if categoryCode = bim mass category:
            return the bim cad layer (the string form of "Mass") coloured 9 in drawing
        if categoryCode = bim ceiling category:
            return the bim cad layer (the string form of "Ceilings") coloured 9 in drawing
        if categoryCode = bim pile category:
            return the bim cad layer (the string form of "Piles") coloured 6 in drawing
        return the bim cad layer (the string form of "Other") coloured 8 in drawing

local function the bim cad point {cad vector2:value} at {a 64 bit floating-point number:height}:
    execute:
        return a cad vector3 with x (value's x), y (value's y) and z height

# The drawing of the active storey's plan.
function the bim cad plan drawing of {bim editor record:editor}:
    execute:
        set made to a new bim cad drawing
        set modelValue to editor's documentValue's current
        set points to an empty list of a cad vector3
        # The cut of each element.
        loop sourceCursor from 0 to the length of (editor's plan's sources's values):
            set source to the item at sourceCursor in (editor's plan's sources's values)
            loop polygonCursor from 0 to the length of (source's polygons's values):
                set polygon to the item at polygonCursor in (source's polygons's values)
                set layer to the bim cad layer of category (the bim category of element (polygon's elementId) in modelValue) in (the address of made)
                clear points
                loop corner from 0 to the length of (polygon's points's values):
                    append (the bim cad point (the item at corner in (polygon's points's values)) at 0.0) to points
                add bim cad polyline through points closed true on layer to (the address of made)
        # Grids, named at both ends.
        set gridLayer to the bim cad layer of category (bim grid category) in (the address of made)
        loop gridCursor from 0 to the length of (modelValue's grids's values):
            set grid to the item at gridCursor in (modelValue's grids's values)
            add bim cad line from (the bim cad point (grid's start) at 0.0) to (the bim cad point (grid's finish) at 0.0) on gridLayer to (the address of made)
            add bim cad text (grid's name) at (the bim cad point (grid's start) at 0.0) high 0.5 turned 0.0 centred true on gridLayer to (the address of made)
            add bim cad text (grid's name) at (the bim cad point (grid's finish) at 0.0) high 0.5 turned 0.0 centred true on gridLayer to (the address of made)
        # The storey's sketches.
        set lineLayer to the bim cad layer of category (bim line category) in (the address of made)
        set textLayer to the bim cad layer of category (bim text category) in (the address of made)
        loop sketchCursor from 0 to the length of (modelValue's sketches's values):
            set sketch to the item at sketchCursor in (modelValue's sketches's values)
            if (sketch's levelId = editor's levelId) and ((the length of (sketch's points's values)) > 0):
                if sketch's kind = bim text sketch:
                    set height to sketch's height
                    if height <= 0.0:
                        set height to 0.25
                    add bim cad text (sketch's content) at (the bim cad point (the item at 0 in (sketch's points's values)) at 0.0) high height turned 0.0 centred false on textLayer to (the address of made)
                else if (sketch's kind = bim line sketch) or (sketch's kind = bim face sketch):
                    clear points
                    loop corner from 0 to the length of (sketch's points's values):
                        append (the bim cad point (the item at corner in (sketch's points's values)) at 0.0) to points
                    add bim cad polyline through points closed (sketch's kind = bim face sketch) on lineLayer to (the address of made)
        # Rooms: their outline, their area at their middle.
        set spaceLayer to the bim cad layer of category (bim space category) in (the address of made)
        loop spaceCursor from 0 to the length of (editor's spaces's values):
            set room to the item at spaceCursor in (editor's spaces's values)
            set outline to room's outline's values
            if (the length of outline) >= 3:
                clear points
                set sumX to 0.0
                set sumY to 0.0
                loop corner from 0 to the length of outline:
                    set corner2 to the item at corner in outline
                    append (the bim cad point corner2 at 0.0) to points
                    set sumX to sumX + corner2's x
                    set sumY to sumY + corner2's y
                add bim cad polyline through points closed true on spaceLayer to (the address of made)
                set middle to a cad vector3 with x (sumX / ((the length of outline) as a 64 bit floating-point number)), y (sumY / ((the length of outline) as a 64 bit floating-point number)) and z 0.0
                add bim cad text ((the bim cad area text of (room's area)) + (the string form of " m²")) at middle high 0.25 turned 0.0 centred true on spaceLayer to (the address of made)
        free points
        return made

# `area` in square metres with two decimals.
local function the bim cad area text of {a 64 bit floating-point number:area}:
    execute:
        set buffer to a new string buffer containing 32 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 33 as a word sized unsigned integer, "%.2f", area)
        return the substring of buffer from 0 spanning written bytes

# Adds `shape` as a solid of its planar faces, each face's loops turned to
# run anticlockwise about its outward normal; false when the SAT writer
# refuses it.
local function add bim cad solid of polyhedron {fast polyhedron record:shape} on {integer:layer} to {a pointer to a bim cad drawing record:drawing}:
    execute:
        set positions to an empty list of a cad vector3
        loop cursor from 0 to the length of (shape's positions's values):
            append (the item at cursor in (shape's positions's values)) to positions
        set loops to an empty list of an integer
        loop faceCursor from 0 to the length of (shape's faces's values):
            set face to the item at faceCursor in (shape's faces's values)
            append face's loopCount to loops
            # Newell's normal of the outer loop against the stored one.
            set outerStart to the item at face's firstLoop in (shape's loopStarts's values)
            set outerEnd to the item at (face's firstLoop + 1) in (shape's loopStarts's values)
            set nx to 0.0
            set ny to 0.0
            set nz to 0.0
            loop corner from outerStart to outerEnd:
                set here to the item at (the item at corner in (shape's indices's values)) in positions
                set nextCorner to corner + 1
                if nextCorner = outerEnd:
                    set nextCorner to outerStart
                set there to the item at (the item at nextCorner in (shape's indices's values)) in positions
                set nx to nx + ((here's y - there's y) * (here's z + there's z))
                set ny to ny + ((here's z - there's z) * (here's x + there's x))
                set nz to nz + ((here's x - there's x) * (here's y + there's y))
            set reversed to (((nx * face's normal's x) + (ny * face's normal's y)) + (nz * face's normal's z)) < 0.0
            loop loopCursor from face's firstLoop to (face's firstLoop + face's loopCount):
                set loopStart to the item at loopCursor in (shape's loopStarts's values)
                set loopEnd to the item at (loopCursor + 1) in (shape's loopStarts's values)
                append (loopEnd - loopStart) to loops
                loop corner from 0 to (loopEnd - loopStart):
                    if reversed:
                        append (the item at ((loopEnd - 1) - corner) in (shape's indices's values)) to loops
                    else:
                        append (the item at (loopStart + corner) in (shape's indices's values)) to loops
        set accepted to add bim cad checked solid of positions with loops loops on layer to drawing
        free positions
        free loops
        return accepted

# The drawing of the model in 3D from the meshes the 3D view shows
# (`meshes`, `others` and the imported elements' `imports`, lists of bim
# scene mesh records).
function the bim cad model drawing of {bim editor record:editor} with {a pointer to a list:meshes} and {a pointer to a list:others} and {a pointer to a list:imports}:
    execute:
        set made to a new bim cad drawing
        # The elements written as solids, by id.
        set solidIds to an empty list of a 64 bit integer
        loop cursor from 0 to the length of (editor's evaluation's elements's values):
            set geometry to the item at cursor in (editor's evaluation's elements's values)
            if (geometry's status = 0) and geometry's fast:
                set layer to the bim cad layer of category (the bim category of element (geometry's id) in (editor's documentValue's current)) in (the address of made)
                if add bim cad solid of polyhedron (geometry's shape) on layer to (the address of made):
                    append (geometry's id) to solidIds
        add bim cad meshes of meshes leaving out solidIds to (the address of made)
        add bim cad meshes of others leaving out solidIds to (the address of made)
        add bim cad meshes of imports leaving out solidIds to (the address of made)
        free solidIds
        return made

local function add bim cad meshes of {a pointer to a list:sceneMeshes} leaving out {a pointer to a list:solidIds} to {a pointer to a bim cad drawing record:drawing}:
    execute:
        loop cursor from 0 to the length of sceneMeshes:
            set sceneMesh to the item at cursor in sceneMeshes
            set written to false
            loop idCursor from 0 to the length of solidIds:
                if (the item at idCursor in solidIds) = sceneMesh's elementId:
                    set written to true
            if written = false:
                set layer to the bim cad layer of category (sceneMesh's category) in drawing
                add bim cad mesh of (sceneMesh's shape's positions's values) with triangles (sceneMesh's shape's triangles's values) on layer to drawing

# Writes `drawing` as `stem.dxf` and `stem.dwg`; the message to show.
function the bim cad export of {bim cad drawing record:drawing} as {a string:stem}:
    execute:
        set dxfPath to stem + (the string form of ".dxf")
        set dwgPath to stem + (the string form of ".dwg")
        set dxfWritten to write bim text (the bim dxf of drawing) to file dxfPath
        set dwgWritten to write bim text (the bim dwg of drawing) to file dwgPath
        if dxfWritten and dwgWritten:
            return ((the string form of "Exported ") + dwgPath) + ((the string form of " and ") + (dxfPath + ((the string form of " (") + ((the string form of (the bim cad entity count of drawing)) + (the string form of " entities)")))))
        return (the string form of "Could not write ") + stem
