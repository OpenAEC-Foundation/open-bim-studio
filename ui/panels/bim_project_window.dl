# SPDX-License-Identifier: MPL-2.0
# The Project settings window (issue #119), opened by the Model tab's
# Settings and Levels buttons, over the model as the IfcTypes window is.
# Two pages:
# - Settings: the project's settings as the properties panel shows them in
#   the project's context (`append bim project settings rows of`): the
#   drawing standard, the units, the decimals and the georeferencing. A
#   choice shows all its options side by side, a click takes one; a value
#   is typed (Enter applies, Esc cancels).
# - Levels: every level, highest first, with its name, elevation, storey
#   height and extent (locked to all levels or its own). A click on a
#   value selects the level and starts typing it, a click on the extent
#   turns it over; Add level adds one above the highest.
# Every change goes through the editor's own property rows and commands, so
# each is one undoable edit and the properties panel shows the same.
#
# The window's layout is a list of cells (`the bim project window cells
# of`), the same for drawing and for a click, so that what a click hits
# does not depend on the frame drawn before it.
import ui/panels/bim_ui.dl

class:
    patterns:
        [a|] bim project window record
    members:
        open as a boolean
        # `bim project settings page` or `bim project levels page`.
        page as an integer
        # The first level shown on the levels page.
        scroll as an integer

function bim project settings page:
    replacement:
        0
function bim project levels page:
    replacement:
        1

# The command the Model tab's Levels button sends: the window on its levels
# page (the shell handles it, as 3901 opens the IfcTypes window).
function bim project levels command:
    replacement:
        3902

function a new bim project window:
    execute:
        return @intrinsic("construct", a bim project window record, false, 0, 0)

# What a cell of the window is. Only the last six take a click.
function bim project title cell:
    replacement:
        0
function bim project heading cell:
    replacement:
        1
function bim project label cell:
    replacement:
        2
function bim project value cell:
    replacement:
        3
function bim project band cell:
    replacement:
        4
function bim project close cell:
    replacement:
        10
function bim project page cell:
    replacement:
        11
function bim project field cell:
    replacement:
        12
function bim project option cell:
    replacement:
        13
function bim project level field cell:
    replacement:
        14
function bim project add level cell:
    replacement:
        15

# One cell: what it is, where, the property row it edits (`code`), the
# option or page it chooses (`option`), the level it belongs to, its text,
# and whether it is the chosen one (the page shown, the option the project
# holds, the selected level) or the value being typed (`typing`).
class:
    patterns:
        [a|] bim project window cell record
    members:
        action as an integer
        left as a 64 bit floating-point number
        top as a 64 bit floating-point number
        across as a 64 bit floating-point number
        tall as a 64 bit floating-point number
        code as an integer
        option as an integer
        levelId as a 64 bit integer
        shown as a string
        chosen as a boolean
        typing as a boolean

local function a bim project cell {integer:actionCode} at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} sized {a 64 bit floating-point number:width} by {a 64 bit floating-point number:height} saying {a string:message}:
    execute:
        return @intrinsic("construct", a bim project window cell record, actionCode, x, y, width, height, 0, -1, the bim refused id, message, false, false)

function the bim project window width:
    replacement:
        640.0

# The window's place, centred in a `screenWidth` by `screenHeight` window:
# a cell of its size.
function the bim project window box across {a 64 bit floating-point number:screenWidth} by {a 64 bit floating-point number:screenHeight}:
    execute:
        set boxWidth to the minimum of (the bim project window width) and (screenWidth - 16.0)
        set boxHeight to the minimum of 580.0 and (screenHeight - 16.0)
        set boxLeft to the maximum of 8.0 and ((screenWidth - boxWidth) * 0.5)
        set boxTop to the maximum of 8.0 and ((screenHeight - boxHeight) * 0.5)
        return a bim project cell (bim project band cell) at boxLeft and boxTop sized boxWidth by boxHeight saying (the string form of "")

# The model's levels, highest first: their places among the model's levels.
function the bim project level order of {bim model record:modelValue}:
    execute:
        set levelList to modelValue's levels's values
        set ordered to an empty list of an integer
        set taken to an empty list of a boolean
        loop cursor from 0 to the length of levelList:
            append false to taken
        loop orderCursor from 0 to the length of levelList:
            set best to -1
            loop cursor from 0 to the length of levelList:
                if (the item at cursor in taken) = false:
                    if best < 0:
                        set best to cursor
                    else if (the item at cursor in levelList)'s elevation > (the item at best in levelList)'s elevation:
                        set best to cursor
            append best to ordered
            replace item at index best in taken with true
        free taken
        return ordered

# How many level rows the levels page has room for.
local function the bim project level rows within {bim project window cell record:box}:
    execute:
        set room to (box's tall - 132.0) - 56.0
        return the maximum of 1 and ((room / 30.0) as an integer)

# Whether the value being typed is property `code`, of level `levelId`
# when it is a level's.
local function bim project typing {integer:code} of {a 64 bit integer:levelId} in {bim editor record:editor}:
    execute:
        if editor's propertyCode != code:
            return false
        if levelId = the bim refused id:
            return true
        return (editor's selectionKind = bim level picked) and (editor's selectionId = levelId)

# The cells of the window as it shows `editor`'s model in a `screenWidth`
# by `screenHeight` window.
function the bim project window cells of {bim project window record:windowState} for {bim editor record:editor} across {a 64 bit floating-point number:screenWidth} by {a 64 bit floating-point number:screenHeight}:
    execute:
        set modelValue to editor's documentValue's current
        set box to the bim project window box across screenWidth by screenHeight
        set left to box's left
        set top to box's top
        set right to box's left + box's across
        set bottom to box's top + box's tall
        set windowCells to an empty list of a bim project window cell record
        append (a bim project cell (bim project title cell) at (left + 14.0) and top sized (box's across - 60.0) by 34.0 saying (the string form of "Project settings")) to windowCells
        append (a bim project cell (bim project close cell) at (right - 34.0) and (top + 4.0) sized 26.0 by 26.0 saying (the string form of "")) to windowCells
        set pageNames to [the string form of "Settings", the string form of "Levels"]
        loop pageCursor from 0 to 2:
            set pageCell to a bim project cell (bim project page cell) at ((left + 14.0) + ((pageCursor as a 64 bit floating-point number) * 104.0)) and (top + 42.0) sized 100.0 by 28.0 saying (the item at pageCursor in pageNames)
            set pageCell's option to pageCursor
            set pageCell's chosen to pageCursor = windowState's page
            append pageCell to windowCells
        set labelLeft to left + 26.0
        set valueLeft to left + 236.0
        set valueRoom to (right - 20.0) - valueLeft
        set rowTop to top + 86.0
        if windowState's page = bim project settings page:
            set settingRows to an empty list of a bim property row record
            append bim project settings rows of modelValue to settingRows
            loop rowCursor from 0 to the length of settingRows:
                set settingRow to the item at rowCursor in settingRows
                if settingRow's code < 0:
                    if rowCursor > 0:
                        set rowTop to rowTop + 8.0
                    append (a bim project cell (bim project heading cell) at (left + 16.0) and rowTop sized (box's across - 32.0) by 24.0 saying settingRow's label) to windowCells
                    set rowTop to rowTop + 28.0
                else:
                    append (a bim project cell (bim project label cell) at labelLeft and rowTop sized 200.0 by 26.0 saying (the bim unhinted form of settingRow's label)) to windowCells
                    if bim property (settingRow's code) opens a menu:
                        set offered to the bim menu offering of property settingRow's code for editor
                        set standing to the bim standing menu option of property settingRow's code for editor
                        set offeredCount to the length of offered
                        set optionWidth to the minimum of 120.0 and (valueRoom / ((the maximum of 1 and offeredCount) as a 64 bit floating-point number))
                        loop optionCursor from 0 to offeredCount:
                            set optionCell to a bim project cell (bim project option cell) at (valueLeft + ((optionCursor as a 64 bit floating-point number) * optionWidth)) and rowTop sized (optionWidth - 4.0) by 26.0 saying (the item at optionCursor in offered)
                            set optionCell's code to settingRow's code
                            set optionCell's option to optionCursor
                            set optionCell's chosen to optionCursor = standing
                            append optionCell to windowCells
                        free offered
                    else if settingRow's code > 0:
                        set fieldCell to a bim project cell (bim project field cell) at valueLeft and rowTop sized 220.0 by 26.0 saying settingRow's value
                        set fieldCell's code to settingRow's code
                        set fieldCell's typing to bim project typing settingRow's code of (the bim refused id) in editor
                        if fieldCell's typing:
                            set fieldCell's shown to editor's propertyText + (the string form of "_")
                        append fieldCell to windowCells
                    else:
                        append (a bim project cell (bim project value cell) at valueLeft and rowTop sized valueRoom by 26.0 saying settingRow's value) to windowCells
                    set rowTop to rowTop + 30.0
            free settingRows
            append (a bim project cell (bim project label cell) at (left + 16.0) and (bottom - 30.0) sized (box's across - 32.0) by 20.0 saying (the string form of "A click on a value types it: Enter applies, Esc cancels. Map positions are in metres.")) to windowCells
            return windowCells
        # The levels page: a head over the columns, a row per level.
        set columnLefts to [left + 26.0, left + 236.0, left + 360.0, left + 484.0]
        set columnNames to [the string form of "Name", the string form of "Elevation", the string form of "Storey height", the string form of "Extent"]
        loop columnCursor from 0 to 4:
            append (a bim project cell (bim project heading cell) at (the item at columnCursor in columnLefts) and rowTop sized 118.0 by 24.0 saying (the item at columnCursor in columnNames)) to windowCells
        set rowTop to rowTop + 30.0
        set unitCode to editor's lengthUnit
        set ordered to the bim project level order of modelValue
        set rowsRoom to the bim project level rows within box
        set firstShown to the maximum of 0 and (the minimum of windowState's scroll and ((the length of ordered) - rowsRoom))
        set shownCount to the minimum of rowsRoom and ((the length of ordered) - firstShown)
        loop shownCursor from 0 to shownCount:
            set levelValue to the item at (the item at (firstShown + shownCursor) in ordered) in (modelValue's levels's values)
            set chosenLevel to (editor's selectionKind = bim level picked) and (editor's selectionId = levelValue's id)
            if chosenLevel:
                set bandCell to a bim project cell (bim project band cell) at (left + 14.0) and (rowTop - 2.0) sized (box's across - 28.0) by 30.0 saying (the string form of "")
                set bandCell's chosen to true
                append bandCell to windowCells
            set levelCodes to [bim level name property, bim level elevation property, bim level height property]
            set levelTexts to [levelValue's name, the bim length levelValue's elevation in units unitCode, the bim length levelValue's height in units unitCode]
            loop columnCursor from 0 to 3:
                set columnWidth to 118.0
                if columnCursor = 0:
                    set columnWidth to 200.0
                set levelCell to a bim project cell (bim project level field cell) at (the item at columnCursor in columnLefts) and rowTop sized columnWidth by 26.0 saying (the item at columnCursor in levelTexts)
                set levelCell's code to the item at columnCursor in levelCodes
                set levelCell's levelId to levelValue's id
                set levelCell's chosen to chosenLevel
                set levelCell's typing to bim project typing levelCell's code of levelValue's id in editor
                if levelCell's typing:
                    set levelCell's shown to editor's propertyText + (the string form of "_")
                append levelCell to windowCells
            set extentText to the string form of "All levels"
            if bim level levelValue's id is unlocked in modelValue:
                set extentText to the string form of "Its own"
            set extentCell to a bim project cell (bim project level field cell) at (the item at 3 in columnLefts) and rowTop sized 118.0 by 26.0 saying extentText
            set extentCell's code to bim level extent property
            set extentCell's levelId to levelValue's id
            set extentCell's chosen to chosenLevel
            append extentCell to windowCells
            set rowTop to rowTop + 30.0
        if shownCount < (the length of ordered):
            set rangeText to ((the string form of "Levels ") + (the string form of (firstShown + 1))) + (((the string form of " to ") + (the string form of (firstShown + shownCount))) + (((the string form of " of ") + (the string form of (the length of ordered))) + (the string form of ": the wheel scrolls")))
            append (a bim project cell (bim project label cell) at (left + 26.0) and rowTop sized 300.0 by 24.0 saying rangeText) to windowCells
        free ordered
        append (a bim project cell (bim project add level cell) at (left + 16.0) and (bottom - 44.0) sized 110.0 by 28.0 saying (the string form of "Add level")) to windowCells
        append (a bim project cell (bim project label cell) at (left + 140.0) and (bottom - 40.0) sized (box's across - 156.0) by 20.0 saying (the string form of "Adds one above the highest. Extent: a plan's crop for all levels, or its own.")) to windowCells
        return windowCells

# The window opened on page `pageIndex`, nothing being typed.
function open bim project window on page {integer:pageIndex} in {a pointer to a bim project window record:windowState} for {a pointer to a bim editor record:editor}:
    execute:
        set windowState's open to true
        set windowState's page to pageIndex
        set windowState's scroll to 0
        set editor's propertyCode to -1
        if pageIndex = bim project levels page:
            set editor's message to the string form of "Levels: click a value to type it, Esc closes"
        else:
            set editor's message to the string form of "Project settings: click a value to change it, Esc closes"

function close bim project window in {a pointer to a bim project window record:windowState} for {a pointer to a bim editor record:editor}:
    execute:
        set windowState's open to false
        set editor's propertyCode to -1
        set editor's message to the string form of ""

# The levels page scrolled by `steps` rows (the wheel).
function scroll bim project window by {integer:steps} in {a pointer to a bim project window record:windowState}:
    execute:
        set windowState's scroll to the maximum of 0 and (windowState's scroll + steps)

# Whether a click on a cell of kind `actionCode` does something.
local function bim project cell {integer:actionCode} takes a click:
    execute:
        return actionCode >= bim project close cell

# A click at (`pointerX`, `pointerY`): what it hits is done. A value being
# typed elsewhere is applied first (or dropped when nothing was typed).
function click bim project window at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} across {a 64 bit floating-point number:screenWidth} by {a 64 bit floating-point number:screenHeight} in {a pointer to a bim project window record:windowState} for {a pointer to a bim editor record:editor}:
    execute:
        if windowState's open = false:
            return nothing
        set windowCells to the bim project window cells of (@intrinsic("dereference", windowState)) for (@intrinsic("dereference", editor)) across screenWidth by screenHeight
        set hitIndex to -1
        loop cursor from 0 to the length of windowCells:
            set cell to the item at cursor in windowCells
            if bim project cell (cell's action) takes a click:
                if ((pointerX >= cell's left) and (pointerX < (cell's left + cell's across))) and ((pointerY >= cell's top) and (pointerY < (cell's top + cell's tall))):
                    set hitIndex to cursor
        if hitIndex < 0:
            free windowCells
            return nothing
        set hit to the item at hitIndex in windowCells
        free windowCells
        if hit's typing:
            return nothing
        if editor's propertyCode >= 0:
            if ((the length of editor's propertyText) > 0) and ((bim editor shows a property menu (@intrinsic("dereference", editor))) = false):
                apply bim editor property in editor
            else:
                set editor's propertyCode to -1
        if hit's action = bim project close cell:
            close bim project window in windowState for editor
        else if hit's action = bim project page cell:
            set windowState's page to hit's option
            set windowState's scroll to 0
        else if hit's action = bim project field cell:
            start bim editor property hit's code in editor
        else if hit's action = bim project option cell:
            start bim editor property (the bim menu option (hit's option) of property (hit's code)) in editor
        else if hit's action = bim project level field cell:
            if (editor's selectionKind != bim level picked) or (editor's selectionId != hit's levelId):
                select bim editor bim level picked numbered hit's levelId in editor
            start bim editor property hit's code in editor
        else if hit's action = bim project add level cell:
            add bim editor level above the highest in editor

# A key while the window is open: Enter, Backspace and Esc go to the value
# being typed; without one Esc closes the window. Other keys stay with the
# window (the characters come through `type bim project window character`).
function type bim project window key {integer:code} in {a pointer to a bim project window record:windowState} for {a pointer to a bim editor record:editor}:
    execute:
        if windowState's open = false:
            return nothing
        if editor's propertyCode >= 0:
            if ((code = bim enter key code) or (code = bim escape key code)) or (code = bim backspace key code):
                type bim editor property key code in editor
            return nothing
        if code = bim escape key code:
            close bim project window in windowState for editor

# A character typed while the window is open: into the value being typed
# (a number takes digits, a point and a minus; a name any printable one).
function type bim project window character {integer:code} in {a pointer to a bim project window record:windowState} for {a pointer to a bim editor record:editor}:
    execute:
        if (windowState's open = false) or (editor's propertyCode < 0):
            return nothing
        if (code >= 32) and (code < 127):
            type bim editor property key code in editor

# Draws the window over everything but the file screens.
function draw bim project window {bim project window record:windowState} for {bim editor record:editor} across {a 64 bit floating-point number:screenWidth} by {a 64 bit floating-point number:screenHeight} pointing at {a 64 bit floating-point number:pointerX} and {a 64 bit floating-point number:pointerY} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        if windowState's open = false:
            return nothing
        set palette to the bim ui palette
        set box to the bim project window box across screenWidth by screenHeight
        draw bim ui rectangle (box's left + 5.0) (box's top + 5.0) box's across box's tall painted palette's strong in frame
        draw bim ui rectangle box's left box's top box's across box's tall painted palette's border in frame
        draw bim ui rectangle (box's left + 1.0) (box's top + 1.0) (box's across - 2.0) (box's tall - 2.0) painted palette's panel in frame
        draw bim ui rectangle (box's left + 1.0) (box's top + 1.0) (box's across - 2.0) 33.0 painted palette's chrome in frame
        draw bim ui rectangle (box's left + 1.0) (box's top + 70.0) (box's across - 2.0) 1.0 painted palette's border in frame
        set windowCells to the bim project window cells of windowState for editor across screenWidth by screenHeight
        loop cursor from 0 to the length of windowCells:
            set cell to the item at cursor in windowCells
            set over to (((pointerX >= cell's left) and (pointerX < (cell's left + cell's across))) and ((pointerY >= cell's top) and (pointerY < (cell's top + cell's tall)))) and (bim project cell (cell's action) takes a click)
            set baseline to cell's top + ((cell's tall * 0.5) + 4.0)
            set room to cell's across - 16.0
            if cell's action = bim project title cell:
                draw bim ui text cell's shown at cell's left and (cell's top + 22.0) in face (bim text bold) with atlas painted palette's ink in frame
            else if cell's action = bim project heading cell:
                draw bim ui caps (the bim fitted form of cell's shown in cell's across pixels of face (bim text caption) with atlas) at cell's left and baseline with atlas painted palette's inkSecondary in frame
            else if cell's action = bim project label cell:
                draw bim ui text (the bim fitted form of cell's shown in cell's across pixels of face (bim text small) with atlas) at cell's left and baseline in face (bim text small) with atlas painted palette's ink in frame
            else if cell's action = bim project value cell:
                draw bim ui text (the bim fitted form of cell's shown in cell's across pixels of face (bim text small) with atlas) at cell's left and baseline in face (bim text small) with atlas painted palette's inkSecondary in frame
            else if cell's action = bim project band cell:
                draw bim ui rectangle cell's left cell's top cell's across cell's tall painted palette's selected in frame
            else if cell's action = bim project close cell:
                set closeInk to palette's inkSecondary
                if over:
                    draw bim ui rounded rectangle cell's left cell's top cell's across cell's tall radius 3.0 painted palette's hover in frame
                    set closeInk to palette's ink
                draw bim ui line from (cell's left + 8.5) (cell's top + 8.5) to (cell's left + 17.5) (cell's top + 17.5) wide 1.5 coloured closeInk's red, closeInk's green and closeInk's blue in frame
                draw bim ui line from (cell's left + 17.5) (cell's top + 8.5) to (cell's left + 8.5) (cell's top + 17.5) wide 1.5 coloured closeInk's red, closeInk's green and closeInk's blue in frame
            else if cell's action = bim project page cell:
                if cell's chosen:
                    draw bim ui rectangle cell's left cell's top cell's across cell's tall painted palette's selected in frame
                    draw bim ui rectangle cell's left ((cell's top + cell's tall) - 2.0) cell's across 2.0 painted palette's accent in frame
                else if over:
                    draw bim ui rectangle cell's left cell's top cell's across cell's tall painted palette's hover in frame
                draw bim ui text cell's shown at (cell's left + 12.0) and baseline in face (bim text small) with atlas painted palette's ink in frame
            else if cell's action = bim project option cell:
                set optionInk to palette's ink
                if cell's chosen:
                    draw bim ui rounded rectangle cell's left cell's top cell's across cell's tall radius 3.0 painted palette's accent in frame
                    set optionInk to palette's onAccent
                else if over:
                    draw bim ui box cell's left cell's top cell's across cell's tall radius 3.0 painted palette's hover edged palette's strong wide 1.0 in frame
                else:
                    draw bim ui box cell's left cell's top cell's across cell's tall radius 3.0 painted palette's raised edged palette's border wide 1.0 in frame
                draw bim ui text (the bim fitted form of cell's shown in room pixels of face (bim text small) with atlas) at (cell's left + 8.0) and baseline in face (bim text small) with atlas painted optionInk in frame
            else:
                # A value to type or turn over, and the Add level button.
                set fillPaint to palette's raised
                set edgePaint to palette's border
                set edgeWidth to 1.0
                if over:
                    set fillPaint to palette's hover
                    set edgePaint to palette's strong
                if cell's typing:
                    set fillPaint to palette's raised
                    set edgePaint to palette's focus
                    set edgeWidth to 2.0
                draw bim ui box cell's left cell's top cell's across cell's tall radius 3.0 painted fillPaint edged edgePaint wide edgeWidth in frame
                draw bim ui text (the bim fitted form of cell's shown in room pixels of face (bim text small) with atlas) at (cell's left + 8.0) and baseline in face (bim text small) with atlas painted palette's ink in frame
        free windowCells
