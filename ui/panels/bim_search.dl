# SPDX-License-Identifier: MPL-2.0
# The search of the command line: what is typed there is also looked up
# among every command of the program (the ribbon's buttons on every tab,
# the choosers' rows, the quick actions and the two-letter commands, by
# name, by key and by tab) and among the model's objects (views and sheets,
# storeys, grids, elements and types). The rows found show above the
# sentence suggestions; Up and Down move through them, Enter or a click runs
# one: a command as a ribbon click sends it, a view or sheet opens, a storey
# becomes the active one, a grid or element is selected, a type becomes the
# one drawn next. A line the sentences understand in full runs as a
# sentence, as it always did, unless a row was chosen with the arrows.
# The command list is built once; the objects are collected when the typed
# text changes after the model did, and filtered when the text changes.
import lib/text.dl
import ui/panels/bim_ui.dl
import ui/panels/bim_model_explorer.dl
import automation/bim_sentences.dl

# What a row stands for.
function bim search command row:
    replacement:
        0
function bim search view row:
    replacement:
        1
function bim search sheet row:
    replacement:
        2
function bim search storey row:
    replacement:
        3
function bim search pick row:
    replacement:
        4
function bim search wall type row:
    replacement:
        5
function bim search opening type row:
    replacement:
        6
function bim search linear type row:
    replacement:
        7
function bim search system type row:
    replacement:
        8

# Ctrl+F (`bim ui control command` plus F) puts the keys on the command
# line, as Ctrl+L does.
function bim search focus command:
    replacement:
        1070
# How many rows the list above the command line shows at most, the sentence
# suggestions included, and how many of them the objects keep when more
# commands match than fit.
function bim search shown rows:
    replacement:
        12
function bim search object share:
    replacement:
        4

# One row: what it stands for (`family`), its name, a note (a command's key,
# an object's kind) and a place (a command's tab and group, an object's
# number), the command sent or the kind picked (`code`), the object's id,
# and the three texts in lower case, which the typed words are matched in.
class:
    patterns:
        [a|] bim search row record
    members:
        family as an integer
        label as a string
        detail as a string
        place as a string
        code as an integer
        targetId as a 64 bit integer
        foldedLabel as a string
        foldedDetail as a string
        folded as a string

# The search's state: every command, the model's objects as last collected
# (for the model `stamp` names), the rows shown for the line `query`, the
# row the arrows chose (-1: none, the first runs), whether the arrows stand
# on the sentence suggestions below the rows, how many suggestions show
# below them, and whether the line is a whole sentence.
class:
    patterns:
        [a|] bim command search record
    members:
        commands as the type of (an empty list of a bim search row record)
        objects as the type of (an empty list of a bim search row record)
        shown as the type of (an empty list of a bim search row record)
        query as a string
        stamp as a string
        highlight as an integer
        onSentences as a boolean
        sentenceRows as an integer
        sentenceFull as a boolean

local function a bim search row of {integer:familyCode} called {a string:shownName} noted {a string:noteText} placed {a string:placeText} sending {integer:sentCode} aimed at {a 64 bit integer:aimedId}:
    execute:
        set foldedName to the lowercase form of shownName
        set foldedNote to the lowercase form of noteText
        set foldedWhole to ((foldedName + (the string form of " ")) + foldedNote) + ((the string form of " ") + (the lowercase form of placeText))
        return @intrinsic("construct", a bim search row record, familyCode, shownName, noteText, placeText, sentCode, aimedId, foldedName, foldedNote, foldedWhole)

# ---------------------------------------------------------------- commands

# Adds the command `sentCode` named `buttonName` to `commandRows`, once per
# name and code; a button without a command or one that only opens a
# chooser (whose rows are listed themselves) is left out. A button without
# letters of its own shows the two-letter command that sends its code, or
# Ctrl with its letter.
local function note bim search command {a string:buttonName} keyed {a string:letters} sending {integer:sentCode} found on {a string:placeText} among {a pointer to a list:pairCodes} and {a pointer to a list:pairLetters} into {a pointer to a list:commandRows}:
    execute:
        if sentCode < 0:
            return nothing
        if (the bim chooser of command sentCode) > 0:
            return nothing
        loop seenCursor from 0 to the length of commandRows:
            set seenEntry to the item at seenCursor in commandRows
            if (seenEntry's code = sentCode) and (seenEntry's label = buttonName):
                return nothing
        set hotkey to letters
        if (the length of hotkey) = 0:
            loop pairCursor from 0 to the length of pairCodes:
                if ((the length of hotkey) = 0) and ((the item at pairCursor in pairCodes) = sentCode):
                    set hotkey to the item at pairCursor in pairLetters
        if ((the length of hotkey) = 0) and ((sentCode > ((bim ui control command) + 64)) and (sentCode <= ((bim ui control command) + 90))):
            set hotkey to (the string form of "Ctrl+") + (the bim sentence utf8 of (sentCode - (bim ui control command)))
        append (a bim search row of (bim search command row) called buttonName noted hotkey placed placeText sending sentCode aimed at (the bim refused id)) to commandRows

# Every command of the program: the quick actions, then each ribbon tab's
# buttons with its choosers' rows, in the tabs' order, then the two-letter
# commands no button sends. The caller frees the list.
function the bim search commands:
    execute:
        set commandRows to an empty list of a bim search row record
        set pairCodes to an empty list of an integer
        set pairLetters to an empty list of a string
        loop firstLetter from 65 to 91:
            loop secondLetter from 65 to 91:
                set pairCode to the bim two letter command of firstLetter then secondLetter
                if pairCode >= 0:
                    append pairCode to pairCodes
                    append ((the bim sentence utf8 of firstLetter) + (the bim sentence utf8 of secondLetter)) to pairLetters
        set quickButtons to the bim header buttons
        loop quickCursor from 0 to the length of quickButtons:
            set quickButton to the item at quickCursor in quickButtons
            note bim search command quickButton's label keyed quickButton's key sending quickButton's command found on (the string form of "Quick access") among pairCodes and pairLetters into commandRows
        free quickButtons
        set tabNames to the bim ribbon tab names
        loop tabCursor from 0 to the length of tabNames:
            set tabGroups to the bim ribbon groups of tab tabCursor with choosers
            loop groupCursor from 0 to the length of tabGroups:
                set tabGroup to the item at groupCursor in tabGroups
                set groupPlace to ((the item at tabCursor in tabNames) + (the string form of " / ")) + tabGroup's title
                loop buttonCursor from 0 to the length of (tabGroup's buttons):
                    set tabButton to the item at buttonCursor in (tabGroup's buttons)
                    note bim search command tabButton's label keyed tabButton's key sending tabButton's command found on groupPlace among pairCodes and pairLetters into commandRows
            free tabGroups
        free tabNames
        loop pairCursor from 0 to the length of pairCodes:
            set pairCode to the item at pairCursor in pairCodes
            set listed to false
            loop seenCursor from 0 to the length of commandRows:
                if (the item at seenCursor in commandRows)'s code = pairCode:
                    set listed to true
            if listed = false:
                # "Array (AY)": the name stands before the bracket.
                set fullName to the bim name of command pairCode
                if (fullName = (the string form of "This command")) = false:
                    set nameParts to fullName split at " ("
                    append (a bim search row of (bim search command row) called (the item at 0 in nameParts) noted (the item at pairCursor in pairLetters) placed (the string form of "Keyboard") sending pairCode aimed at (the bim refused id)) to commandRows
                    free nameParts
        free pairCodes
        free pairLetters
        return commandRows

function a new bim command search:
    execute:
        return @intrinsic("construct", a bim command search record, the bim search commands, an empty list of a bim search row record, an empty list of a bim search row record, the string form of "", the string form of "", -1, false, 0, false)

# ---------------------------------------------------------------- objects

# The model's objects: the plans, sections and elevations, the sheets, the
# storeys, grids and elements as the Model Explorer names them (every
# branch open, so with its limit per branch), and the wall, window and
# door, column and beam and building system types. The caller frees the
# list.
function the bim search objects of {bim model record:modelValue} with {bim import record:importValue}:
    execute:
        set objectRows to an empty list of a bim search row record
        set emptyText to the string form of ""
        set noId to the bim refused id
        loop viewCursor from 0 to the length of (modelValue's views's values):
            set viewValue to the item at viewCursor in (modelValue's views's values)
            set viewNote to the string form of ""
            if viewValue's kind = bim plan view:
                set viewNote to the string form of "Plan"
            else if viewValue's kind = bim section view:
                set viewNote to the string form of "Section"
            else if (bim view viewValue is an elevation):
                set viewNote to the string form of "Elevation"
            if ((the length of viewNote) > 0) and ((the length of viewValue's name) > 0):
                append (a bim search row of (bim search view row) called viewValue's name noted viewNote placed emptyText sending 0 aimed at viewValue's id) to objectRows
        loop sheetCursor from 0 to the length of (modelValue's sheets's values):
            set sheetValue to the item at sheetCursor in (modelValue's sheets's values)
            append (a bim search row of (bim search sheet row) called ((sheetValue's number + (the string form of " ")) + sheetValue's name) noted (the string form of "Sheet") placed emptyText sending 0 aimed at sheetValue's id) to objectRows
        # The explorer's rows with every branch open but the types and the
        # views, which are listed here with what a row of theirs runs.
        set openKeys to an empty list of a string
        set explorerRows to the bim model explorer rows of modelValue with importValue opening openKeys
        set passes to 0
        set growing to true
        loop while growing and (passes < 8):
            set growing to false
            loop rowCursor from 0 to the length of explorerRows:
                set shownEntry to the item at rowCursor in explorerRows
                if shownEntry's branch and (shownEntry's opened = false):
                    if ((shownEntry's rowKey = (the string form of "p/t")) or (shownEntry's rowKey = (the string form of "p/v"))) = false:
                        append shownEntry's rowKey to openKeys
                        set growing to true
            if growing:
                free explorerRows
                set explorerRows to the bim model explorer rows of modelValue with importValue opening openKeys
            set passes to passes + 1
        loop rowCursor from 0 to the length of explorerRows:
            set shownEntry to the item at rowCursor in explorerRows
            if shownEntry's pickKind >= 0:
                if shownEntry's pickKind = bim level picked:
                    append (a bim search row of (bim search storey row) called shownEntry's label noted (the string form of "Storey") placed shownEntry's detail sending 0 aimed at shownEntry's elementId) to objectRows
                else:
                    # An element's kind is the branch it hangs under: its
                    # category, or its IFC class.
                    set parentName to the string form of "Element"
                    if (shownEntry's parentRow >= 0) and (shownEntry's parentRow < (the length of explorerRows)):
                        set parentName to (the item at shownEntry's parentRow in explorerRows)'s label
                    append (a bim search row of (bim search pick row) called shownEntry's label noted parentName placed shownEntry's detail sending shownEntry's pickKind aimed at shownEntry's elementId) to objectRows
        free explorerRows
        free openKeys
        loop typeCursor from 0 to the length of (modelValue's wallTypes's values):
            set wallType to the item at typeCursor in (modelValue's wallTypes's values)
            append (a bim search row of (bim search wall type row) called wallType's name noted (the string form of "Wall type") placed emptyText sending 0 aimed at wallType's id) to objectRows
        loop typeCursor from 0 to the length of (modelValue's openingTypes's values):
            set openingType to the item at typeCursor in (modelValue's openingTypes's values)
            set openingNote to the string form of "Window type"
            if openingType's isDoor:
                set openingNote to the string form of "Door type"
            append (a bim search row of (bim search opening type row) called openingType's name noted openingNote placed emptyText sending 0 aimed at openingType's id) to objectRows
        loop typeCursor from 0 to the length of (modelValue's linearTypes's values):
            set linearType to the item at typeCursor in (modelValue's linearTypes's values)
            append (a bim search row of (bim search linear type row) called linearType's name noted (the string form of "Column or beam type") placed emptyText sending 0 aimed at linearType's id) to objectRows
        set library to the bim system types
        loop typeCursor from 0 to the length of library:
            set systemType to the item at typeCursor in library
            append (a bim search row of (bim search system type row) called systemType's name noted (the string form of "System type") placed systemType's group sending typeCursor aimed at noId) to objectRows
        free library
        return objectRows

# ---------------------------------------------------------------- matching

# How well `candidate` answers the typed line `wanted` (lower case, its
# words in `wordList`): -1 when a word is in none of its texts, 0 when its
# name or note is the line, 1 when its name starts with it, else 2.
local function the bim search rank of {bim search row record:candidate} answering {a string:wanted} worded {a pointer to a list:wordList}:
    execute:
        loop wordCursor from 0 to the length of wordList:
            if ((candidate's folded) contains (the item at wordCursor in wordList)) = false:
                return -1
        if (candidate's foldedLabel = wanted) or (candidate's foldedDetail = wanted):
            return 0
        if ((candidate's foldedLabel) has wanted at offset 0):
            return 1
        return 2

# Appends the rows of `sourceRows` that answer `wanted` to `foundRows`, the
# best first and otherwise in their own order, at most `roomLeft` of them.
local function append bim search matches among {a pointer to a list:sourceRows} answering {a string:wanted} worded {a pointer to a list:wordList} at most {integer:roomLeft} to {a pointer to a list:foundRows}:
    execute:
        set ranks to an empty list of an integer
        loop sourceCursor from 0 to the length of sourceRows:
            append (the bim search rank of (the item at sourceCursor in sourceRows) answering wanted worded wordList) to ranks
        set taken to 0
        loop wantedRank from 0 to 3:
            loop sourceCursor from 0 to the length of sourceRows:
                if (taken < roomLeft) and ((the item at sourceCursor in ranks) = wantedRank):
                    append (the item at sourceCursor in sourceRows) to foundRows
                    set taken to taken + 1
        free ranks

# Works out the rows shown for the line `typedLine` from the commands and
# the objects as collected: the commands first, then the objects, which
# keep a few rows when more commands match than fit. The sentence
# suggestions keep their rows below when the line may become a sentence;
# when it cannot and rows are found, the rows stand alone.
local function fill bim search {a pointer to a bim command search record:finder} typing {a string:typedLine}:
    execute:
        set finder's query to typedLine
        set finder's highlight to -1
        set finder's onSentences to false
        set finder's sentenceRows to 0
        set finder's sentenceFull to false
        set foundRows to an empty list of a bim search row record
        set staleRows to finder's shown
        free staleRows
        set finder's shown to foundRows
        set trimmedLine to the bim sentence trimmed form of typedLine
        if (the length of trimmedLine) = 0:
            return nothing
        # A line starting with ">" is kept for DynLex code.
        if (the bim sentence byte at 0 in trimmedLine) = 62:
            set finder's sentenceFull to true
            return nothing
        set ruleList to the bim sentence rules
        set slotValues to an empty list of a bim sentence slot record
        set fitting to 0
        loop ruleCursor from 0 to the length of ruleList:
            clear slotValues
            set prefixFit to the bim sentence fit of typedLine to rule (the item at ruleCursor in ruleList) typing true into slotValues
            if prefixFit's fits:
                set fitting to fitting + 1
            clear slotValues
            set wholeFit to the bim sentence fit of trimmedLine to rule (the item at ruleCursor in ruleList) typing false into slotValues
            if wholeFit's full:
                set finder's sentenceFull to true
        free slotValues
        free ruleList
        set suggestionCount to fitting
        if suggestionCount > (bim command line shown rows):
            set suggestionCount to bim command line shown rows
        set wanted to the lowercase form of trimmedLine
        set wordList to wanted split at " "
        set wordCursor to 0
        loop while wordCursor < (the length of wordList):
            if (the length of (the item at wordCursor in wordList)) = 0:
                remove item wordCursor from wordList
            else:
                set wordCursor to wordCursor + 1
        set roomLeft to (bim search shown rows) - suggestionCount
        set objectSource to finder's objects
        set objectMatches to an empty list of a bim search row record
        append bim search matches among objectSource answering wanted worded wordList at most roomLeft to objectMatches
        set objectShare to the length of objectMatches
        if objectShare > (bim search object share):
            set objectShare to bim search object share
        set commandSource to finder's commands
        append bim search matches among commandSource answering wanted worded wordList at most (roomLeft - objectShare) to foundRows
        loop objectCursor from 0 to the length of objectMatches:
            if (the length of foundRows) < roomLeft:
                append (the item at objectCursor in objectMatches) to foundRows
        free objectMatches
        free wordList
        set finder's shown to foundRows
        # With no row found the sentences show their closest suggestions, as
        # they did.
        if (suggestionCount = 0) and ((the length of foundRows) = 0):
            set suggestionCount to bim command line shown rows
        set finder's sentenceRows to suggestionCount

# Brings the search up to date with the line `typedLine`: the objects are
# collected again when the model changed since (`stampText` names its
# state), the rows worked out again when the line or the objects changed.
# Called each frame the command line has the keys; it does nothing while
# neither changes.
function refresh bim search {a pointer to a bim command search record:finder} typing {a string:typedLine} of {a pointer to a bim editor record:editor} with {bim import record:importValue} stamped {a string:stampText}:
    execute:
        set outdated to ((the length of typedLine) > 0) and ((stampText = finder's stamp) = false)
        if (typedLine = finder's query) and (outdated = false):
            return nothing
        if outdated:
            set staleObjects to finder's objects
            free staleObjects
            set finder's objects to the bim search objects of (editor's documentValue's current) with importValue
            set finder's stamp to stampText
        fill bim search finder typing typedLine

# The row Enter runs: the one the arrows chose, else the first, or -1 when
# the line is a whole sentence, the arrows stand on the suggestions or no
# row shows (Enter then runs the line as a sentence).
function the bim search highlighted row of {bim command search record:finder}:
    execute:
        set shownCount to the length of (finder's shown)
        if (finder's highlight >= 0) and (finder's highlight < shownCount):
            return finder's highlight
        if (finder's onSentences or finder's sentenceFull) or (shownCount = 0):
            return -1
        return 0

# What a row shows right of its name: its note and its place.
function the bim search note of {bim search row record:shownEntry}:
    execute:
        if (the length of shownEntry's detail) = 0:
            return shownEntry's place
        if (the length of shownEntry's place) = 0:
            return shownEntry's detail
        return (shownEntry's detail + (the string form of "   ")) + shownEntry's place

# ---------------------------------------------------------------- running

local function the idle bim search result:
    execute:
        return @intrinsic("construct", a bim sentence result record, true, the string form of "", no bim api window)

# Runs what `chosenEntry` stands for. A command and a view or sheet are the
# window's to carry out (the result's window part: `press` with the
# command's code, as a click on its ribbon button, or `open` with the
# name); the others are done here.
function the bim search outcome of {bim search row record:chosenEntry} for {a pointer to a bim editor record:editor}:
    execute:
        set windowValue to no bim api window
        set targetId to chosenEntry's targetId
        if chosenEntry's family = bim search command row:
            set windowValue to @intrinsic("construct", a bim api window record, the string form of "press", chosenEntry's code, the string form of "")
        else if chosenEntry's family = bim search view row:
            set windowValue to @intrinsic("construct", a bim api window record, the string form of "open", 0, chosenEntry's label)
            set editor's message to (the string form of "Opening ") + chosenEntry's label
        else if chosenEntry's family = bim search sheet row:
            # A sheet opens by its number, or by its name without one.
            loop sheetCursor from 0 to the length of (editor's documentValue's current's sheets's values):
                set sheetValue to the item at sheetCursor in (editor's documentValue's current's sheets's values)
                if sheetValue's id = targetId:
                    set sheetCalled to sheetValue's number
                    if (the length of sheetCalled) = 0:
                        set sheetCalled to sheetValue's name
                    set windowValue to @intrinsic("construct", a bim api window record, the string form of "open", 0, sheetCalled)
            set editor's message to (the string form of "Opening ") + chosenEntry's label
        else if chosenEntry's family = bim search storey row:
            set editor's levelId to targetId
            set editor's viewsDirty to true
            set editor's message to (the string form of "Active storey: ") + chosenEntry's label
        else if chosenEntry's family = bim search pick row:
            select bim editor (chosenEntry's code) numbered targetId in editor
        else:
            # A type becomes the one drawn next, as a click on it in the
            # project browser makes it; nothing stays selected, so that no
            # element takes the type.
            select bim editor (bim nothing picked) numbered (the bim refused id) in editor
            if chosenEntry's family = bim search wall type row:
                choose bim editor wall type targetId in editor
            else if chosenEntry's family = bim search opening type row:
                set editor's openingTypeId to targetId
                set editor's tool to bim opening tool
                set editor's chainActive to false
                set editor's message to the string form of "Opening: click a wall"
            else if chosenEntry's family = bim search linear type row:
                choose bim editor linear type targetId in editor
            else if chosenEntry's family = bim search system type row:
                choose bim editor system type (chosenEntry's code) in editor
        return @intrinsic("construct", a bim sentence result record, true, editor's message, windowValue)

# Runs row `rowIndex` of the rows shown (Enter, or a click on it): the line
# is cleared and the keys go back to the window, where the command or the
# selection goes on.
function run bim search row {integer:rowIndex} of {a pointer to a bim command search record:finder} on {a pointer to a bim command line record:prompter} for {a pointer to a bim editor record:editor}:
    execute:
        if (rowIndex < 0) or (rowIndex >= (the length of (finder's shown))):
            return the idle bim search result
        set chosenEntry to the item at rowIndex in (finder's shown)
        set outcome to the bim search outcome of chosenEntry for editor
        set prompter's typed to the string form of ""
        set prompter's choice to -1
        set prompter's recalled to -1
        set prompter's focused to false
        fill bim search finder typing (the string form of "")
        return outcome

# A key pressed while the command line has the keys. Enter runs the row
# highlighted, and Up and Down move through the rows and on into the
# sentence suggestions below them; every other key, and Enter and the
# arrows without rows, is the command line's own (`press bim command line
# key`), so a sentence, Tab, Escape and the history work as they did.
function press bim search key {integer:keyCode} in {a pointer to a bim command search record:finder} on {a pointer to a bim command line record:prompter} for {a pointer to a bim editor record:editor}:
    execute:
        set lineBefore to prompter's typed
        if (lineBefore = finder's query) = false:
            fill bim search finder typing lineBefore
        set shownCount to the length of (finder's shown)
        set pickedRow to the bim search highlighted row of (@intrinsic("dereference", finder))
        if (keyCode = bim enter key code) and (pickedRow >= 0):
            return run bim search row pickedRow of finder on prompter for editor
        set arrowKey to (keyCode = bim sentence up key code) or (keyCode = bim sentence down key code)
        if arrowKey and ((shownCount > 0) and (prompter's recalled < 0)):
            set suggestionCount to finder's sentenceRows
            set total to shownCount + suggestionCount
            set spot to pickedRow
            if (spot < 0) and (suggestionCount > 0):
                set sentenceChoice to prompter's choice
                if (sentenceChoice < 0) or (sentenceChoice >= suggestionCount):
                    set sentenceChoice to 0
                set spot to shownCount + sentenceChoice
            if spot < 0:
                # No row and no suggestion stands chosen: Down takes the
                # first row, Up the last.
                if keyCode = bim sentence down key code:
                    set spot to 0
                else:
                    set spot to total - 1
            else if keyCode = bim sentence down key code:
                set spot to the remainder of (spot + 1) divided by total
            else if spot = 0:
                set spot to total - 1
            else:
                set spot to spot - 1
            if spot < shownCount:
                set finder's highlight to spot
                set finder's onSentences to false
            else:
                set finder's highlight to -1
                set finder's onSentences to true
                set prompter's choice to spot - shownCount
            return the idle bim search result
        set ownOutcome to press bim command line key keyCode in prompter for editor
        set lineAfter to prompter's typed
        if (lineAfter = finder's query) = false:
            fill bim search finder typing lineAfter
        return ownOutcome
