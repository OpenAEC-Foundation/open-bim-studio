# SPDX-License-Identifier: MPL-2.0
# A room label keeps clear of its door's swing (drawing quality plan, items
# 9 and 14). A bathroom of 3.0 by 2.4 m inside four 100 mm walls, with a
# door of 1.2 m centred under the room's inside point in the nearer wall,
# so that the leaf standing open and its swing lie on the label's usual
# place. On screen (100 pixels to the metre, 13 pixel lettering) and on
# paper at 1:100 (2.5 mm lettering): the label moves to a place in the room
# whose block clears the swing's box, the walls and the room's outline;
# with the drawing type's level marks on, the peil mark moves with it,
# centred under the label and clear of the swing as well.
import ui/panels/bim_plan_panel.dl

function check room label clearance {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# `amount` to hundredths, as "18.75".
function the clearance test text of {a 64 bit floating-point number:amount}:
    execute:
        set hundredths to (the floor of (((the absolute value of amount) * 100.0) + 0.5)) as a 64 bit integer
        set sign to the string form of ""
        if (amount < 0.0) and (hundredths > (0 as a 64 bit integer)):
            set sign to the string form of "-"
        set fraction to the string form of (the remainder of hundredths divided by (100 as a 64 bit integer))
        if (the length of fraction) < 2:
            set fraction to (the string form of "0") + fraction
        return ((sign + (the string form of (hundredths / (100 as a 64 bit integer)))) + (the string form of ".")) + fraction

# The box around the swings of opening `openingId`, in the pixels of
# `transform`.
function the clearance test swing box of {a 64 bit integer:openingId} in {bim model record:modelValue} through {bim drawing transform record:transform}:
    execute:
        set openingValue to the item at (the bim opening index of openingId in modelValue)'s position in (modelValue's openings's values)
        set drawnSymbol to the bim plan symbol of opening openingValue in modelValue cut at 1.2 framed true
        set swingLow to the bim pixel of (the item at 0 in (drawnSymbol's swings's values)) through transform
        set swingHigh to swingLow
        loop swingCursor from 1 to the length of (drawnSymbol's swings's values):
            set swingPixel to the bim pixel of (the item at swingCursor in (drawnSymbol's swings's values)) through transform
            set swingLow to a cad vector2 with x (the minimum of swingLow's x and swingPixel's x) and y (the minimum of swingLow's y and swingPixel's y)
            set swingHigh to a cad vector2 with x (the maximum of swingHigh's x and swingPixel's x) and y (the maximum of swingHigh's y and swingPixel's y)
        return a bim lettering box around (a cad vector2 with x ((swingLow's x + swingHigh's x) * 0.5) and y ((swingLow's y + swingHigh's y) * 0.5)) turned 0.0 reaching ((swingHigh's x - swingLow's x) * 0.5) by ((swingHigh's y - swingLow's y) * 0.5)

# Whether `testSpot` lies in `swingBox` (turned 0).
function clearance test {cad vector2:testSpot} lies in {bim lettering box record:swingBox}:
    execute:
        return ((the absolute value of (testSpot's x - swingBox's centre's x)) <= swingBox's halfAlong) and ((the absolute value of (testSpot's y - swingBox's centre's y)) <= swingBox's halfAcross)

# How many of the labels on `canvas` from `firstLabel` on overlap `swingBox`.
function the clearance test overlaps on {bim canvas record:canvas} from {integer:firstLabel} with {bim lettering box record:swingBox}:
    execute:
        set overlapCount to 0
        loop cursor from firstLabel to the length of (canvas's texts's values):
            set shownLabel to the item at cursor in (canvas's texts's values)
            if bim lettering box (the bim lettering box of shownLabel on canvas) overlaps swingBox:
                print ((the string form of "  over the swing: ") + shownLabel's message) as a line
                set overlapCount to overlapCount + 1
        return overlapCount

# How many corners of the labels on `canvas` from `firstLabel` on lie
# outside `ringPixels`.
function the clearance test corners outside {a pointer to a list:ringPixels} on {bim canvas record:canvas} from {integer:firstLabel}:
    execute:
        set outsideCount to 0
        loop cursor from firstLabel to the length of (canvas's texts's values):
            set labelBox to the bim lettering box of (the item at cursor in (canvas's texts's values)) on canvas
            loop cornerCursor from 0 to 4:
                set cornerX to labelBox's centre's x - labelBox's halfAlong
                if cornerCursor >= 2:
                    set cornerX to labelBox's centre's x + labelBox's halfAlong
                set cornerY to labelBox's centre's y - labelBox's halfAcross
                if (the remainder of cornerCursor divided by 2) = 1:
                    set cornerY to labelBox's centre's y + labelBox's halfAcross
                if (bim ring ringPixels encloses (a cad vector2 with x cornerX and y cornerY)) = false:
                    set outsideCount to outsideCount + 1
        return outsideCount

function show clearance test labels of {bim canvas record:canvas} titled {a string:title}:
    execute:
        print title as a line
        loop cursor from 0 to the length of (canvas's texts's values):
            set shownLabel to the item at cursor in (canvas's texts's values)
            print ((((the string form of "  ") + shownLabel's message) + (the string form of " at ")) + (((the clearance test text of shownLabel's x) + (the string form of ", ")) + (the clearance test text of shownLabel's y))) as a line

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set planView to add bim view of kind (bim plan view) named (the string form of "Plan") on editor's levelId to target
set editor's planViewId to planView
set wallLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.1)) to wallLayers
set wallType to add bim wall type named (the string form of "Wall 100") with wallLayers to target
free wallLayers
# Counterclockwise, so that each wall's exterior side faces out.
set southWall to add bim wall typed wallType on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 3.1 and y 0.0) to target
ignore add bim wall typed wallType on editor's levelId from (a cad vector2 with x 3.1 and y 0.0) to (a cad vector2 with x 3.1 and y 2.5) to target
set northWall to add bim wall typed wallType on editor's levelId from (a cad vector2 with x 3.1 and y 2.5) to (a cad vector2 with x 0.0 and y 2.5) to target
ignore add bim wall typed wallType on editor's levelId from (a cad vector2 with x 0.0 and y 2.5) to (a cad vector2 with x 0.0 and y 0.0) to target
set roomRing to an empty list of a cad vector2
append (a cad vector2 with x 0.05 and y 0.05) to roomRing
append (a cad vector2 with x 3.05 and y 0.05) to roomRing
append (a cad vector2 with x 3.05 and y 2.45) to roomRing
append (a cad vector2 with x 0.05 and y 2.45) to roomRing
ignore add bim space object named (the string form of "Bathroom") numbered (the string form of "0.03") on editor's levelId around roomRing high 2.6 to target

# The door goes in the wall nearer the room's inside point, centred under
# it, so that its swing (1.1 m into the room) holds the point.
set insidePoint to a bim point inside roomRing
set doorType to add bim door type named (the string form of "Door 1200") sized 1.2 by 2.1 with frame 0.05 to target
set doorHost to southWall
set doorOffset to insidePoint's x
if insidePoint's y > 1.25:
    set doorHost to northWall
    set doorOffset to 3.1 - insidePoint's x
set doorId to add bim opening typed doorType in doorHost at doorOffset to target

set screenTransform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 100.0)
set paperTransform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 10.0)

# ---------------------------------------------------------------- on screen
set screenSwing to the clearance test swing box of doorId in (editor's documentValue's current) through screenTransform
set screenInside to the bim pixel of insidePoint through screenTransform
check room label clearance (clearance test screenInside lies in screenSwing) named (the string form of "the door's swing lies on the room's inside point")
set screenRing to an empty list of a cad vector2
loop corner from 0 to the length of roomRing:
    append (the bim pixel of (the item at corner in roomRing) through screenTransform) to screenRing
set screenCanvas to a new bim canvas
draw bim space labels of editor through screenTransform lettered at 13.0 on (the address of screenCanvas)
show clearance test labels of screenCanvas titled (the string form of "on screen:")
check room label clearance ((the length of (screenCanvas's texts's values)) = 3) named (the string form of "the bathroom keeps name, number and area")
check room label clearance ((the clearance test overlaps on screenCanvas from 0 with screenSwing) = 0) named (the string form of "on screen the label's box clears the swing's box")
check room label clearance ((the clearance test corners outside screenRing on screenCanvas from 0) = 0) named (the string form of "on screen the label stays in the room")
set screenName to the item at 0 in (screenCanvas's texts's values)
check room label clearance ((screenName's anchor's x = screenName's x) and (screenName's centred)) named (the string form of "the moved label is centred on its own anchor")

# ---------------------------------------------------------------- on paper
set paperSwing to the clearance test swing box of doorId in (editor's documentValue's current) through paperTransform
check room label clearance (clearance test (the bim pixel of insidePoint through paperTransform) lies in paperSwing) named (the string form of "on paper too the swing lies on the inside point")
set paperRing to an empty list of a cad vector2
loop corner from 0 to the length of roomRing:
    append (the bim pixel of (the item at corner in roomRing) through paperTransform) to paperRing
set paperCanvas to a new bim canvas
set paperCanvas's paperScale to 1.0
draw bim space labels of editor through paperTransform lettered at 2.5 on (the address of paperCanvas)
show clearance test labels of paperCanvas titled (the string form of "on paper at 1:100 (mm):")
check room label clearance ((the clearance test overlaps on paperCanvas from 0 with paperSwing) = 0) named (the string form of "on paper the label's box clears the swing's box")
check room label clearance ((the clearance test corners outside paperRing on paperCanvas from 0) = 0) named (the string form of "on paper the label stays in the room")

# ------------------------------------------------- with the peil mark under it
ensure bim drawing types in target
set floorPlan to the bim drawing type named (the string form of "Floor plan") in editor's documentValue's current
set viewValue to the item at (the bim view index of planView in editor's documentValue's current)'s position in (target's views's values)
set viewValue's drawingTypeId to floorPlan
store bim view viewValue in target
ignore set bim drawing type floorPlan setting 2 at bim level marks annotation to 1 in target
set markedCanvas to a new bim canvas
set markedCanvas's paperScale to 1.0
draw bim space labels of editor through paperTransform lettered at 2.5 on (the address of markedCanvas)
set firstMark to the length of (markedCanvas's texts's values)
draw bim level marks in plan of editor through paperTransform lettered at 2.5 on (the address of markedCanvas)
show clearance test labels of markedCanvas titled (the string form of "with the level mark (mm):")
check room label clearance ((the length of (markedCanvas's texts's values)) = (firstMark + 1)) named (the string form of "the bathroom gets one level mark")
check room label clearance ((the clearance test overlaps on markedCanvas from 0 with paperSwing) = 0) named (the string form of "label and mark clear the swing's box")
check room label clearance ((the clearance test corners outside paperRing on markedCanvas from 0) = 0) named (the string form of "label and mark stay in the room")
set markedArea to the item at (firstMark - 1) in (markedCanvas's texts's values)
set markValue to the item at firstMark in (markedCanvas's texts's values)
set markKept to the item at 0 in (markedCanvas's keepClear's values)
check room label clearance ((the absolute value of (markKept's centre's x - markedArea's x)) < 1e-9) named (the string form of "the mark is centred under the label")
check room label clearance ((markValue's y > markedArea's y) and ((markValue's y - markedArea's y) < 6.0)) named (the string form of "the mark stands just under the label's last line")
check room label clearance ((bim lettering box markKept overlaps paperSwing) = false) named (the string form of "the mark's box clears the swing's box")

free roomRing
free screenRing
free paperRing
