# SPDX-License-Identifier: MPL-2.0
# The ribbon's choosers (issues #110 and #120): the View tab has one Create
# view button and Collaborate one Import and one Export button; each opens a
# list drawn as the context menu. Every command the separate buttons sent
# stays in a list, and the automation API still finds it by its label. The
# Create view list offers a plan of each of the model's drawing types.
import ui/panels/bim_ui.dl

function check ribbon choosers {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The titles of `groups`, each with its buttons' labels and commands.
function show ribbon chooser groups {a pointer to a list:groups}:
    execute:
        loop groupCursor from 0 to the length of groups:
            set ribbonGroup to the item at groupCursor in groups
            set shown to ribbonGroup's title + (the string form of ":")
            loop buttonCursor from 0 to the length of (ribbonGroup's buttons):
                set ribbonButton to the item at buttonCursor in (ribbonGroup's buttons)
                set shown to (((shown + (the string form of " ")) + ribbonButton's label) + (the string form of "=")) + (the string form of ribbonButton's command)
            print shown as a line

# The rows of a menu: headings in brackets, commands with what they send.
function show ribbon chooser rows {a pointer to a list:rows}:
    execute:
        loop rowCursor from 0 to the length of rows:
            set row to the item at rowCursor in rows
            if row's kind = bim context heading:
                print (((the string form of "[") + row's label) + (the string form of "]")) as a line
            else if row's kind = bim context command:
                print ((((the string form of "  ") + row's label) + (the string form of " = ")) + (the string form of row's command)) as a line

# Whether chooser `chooser` lists a row sending `wanted`.
function the ribbon chooser {integer:chooser} sends {integer:wanted}:
    execute:
        set found to false
        set groups to the bim chooser groups of chooser
        loop groupCursor from 0 to the length of groups:
            set ribbonGroup to the item at groupCursor in groups
            loop buttonCursor from 0 to the length of (ribbonGroup's buttons):
                if (the item at buttonCursor in (ribbonGroup's buttons))'s command = wanted:
                    set found to true
        free groups
        return found

# The ribbon itself: one button per chooser.
print (the string form of "View tab, Create group:") as a line
set viewGroups to the bim ribbon groups of tab 4
loop groupCursor from 0 to the length of viewGroups:
    if (the item at groupCursor in viewGroups)'s title = (the string form of "Create"):
        set createGroup to the item at groupCursor in viewGroups
        check ribbon choosers ((the length of (createGroup's buttons)) = 1) named (the string form of "Create holds one button")
        set createButton to the item at 0 in (createGroup's buttons)
        check ribbon choosers (createButton's label = (the string form of "Create view")) named (the string form of "labelled Create view")
        check ribbon choosers ((the bim chooser of command createButton's command) = bim view chooser) named (the string form of "it opens the view chooser")
free viewGroups
set collaborateGroups to the bim ribbon groups of tab 6
show ribbon chooser groups collaborateGroups
check ribbon choosers ((the bim chooser of command (the item at 0 in ((the item at 0 in collaborateGroups)'s buttons))'s command) = bim import chooser) named (the string form of "Import opens the import chooser")
check ribbon choosers ((the bim chooser of command (the item at 0 in ((the item at 1 in collaborateGroups)'s buttons))'s command) = bim export chooser) named (the string form of "Export opens the export chooser")
free collaborateGroups
check ribbon choosers ((the bim chooser of command 2127) = 0) named (the string form of "an ordinary command opens no chooser")

# Every command the separate buttons sent stays reachable.
set viewCodes to [67, 2122, 2117, 2118, 86, 84, 2092]
set viewKept to true
loop codeCursor from 0 to the length of viewCodes:
    if (the ribbon chooser (bim view chooser) sends (the item at codeCursor in viewCodes)) = false:
        set viewKept to false
check ribbon choosers viewKept named (the string form of "Create view keeps Section, the plans, 3D, Schedule and Duplicate")
set importCodes to [2127, 2270, 2128, 2132, 1079]
set importKept to true
loop codeCursor from 0 to the length of importCodes:
    if (the ribbon chooser (bim import chooser) sends (the item at codeCursor in importCodes)) = false:
        set importKept to false
check ribbon choosers importKept named (the string form of "Import keeps DWG/DXF, PDF, Image, IFC, Storeys from IFC and IfcX")
set exportCodes to [2442, 2443, 88, 2383, 1088, 2098, 2115, 2288]
set exportKept to true
loop codeCursor from 0 to the length of exportCodes:
    if (the ribbon chooser (bim export chooser) sends (the item at codeCursor in exportCodes)) = false:
        set exportKept to false
check ribbon choosers exportKept named (the string form of "Export keeps DWG/DXF 2D and 3D, IFC, IFC 4.3, IFC5, PDF and SVG, and offers the PDF book")

# What the automation API searches: each chooser's groups after the group
# of its button.
print (the string form of "Collaborate with its choosers:") as a line
set reached to the bim ribbon groups of tab 6 with choosers
show ribbon chooser groups reached
free reached

# The windows' rows. A new model has no drawing types until Create view
# opens: then the fixed plans show.
set editor to a new bim editor
set e to the address of editor
set before to the bim chooser entries of (bim view chooser) for editor
print (the string form of "Create view, before the drawing types:") as a line
show ribbon chooser rows before
free before
prepare bim chooser (bim view chooser) for e
set typeCount to the length of (editor's documentValue's current's drawingTypes's values)
check ribbon choosers (typeCount > 0) named (the string form of "opening Create view adds the drawing types")
prepare bim chooser (bim view chooser) for e
check ribbon choosers ((the length of (editor's documentValue's current's drawingTypes's values)) = typeCount) named (the string form of "and only once")
set listed to the bim context entries of editor in chooser (bim view chooser)
print (the string form of "Create view:") as a line
show ribbon chooser rows listed
set floorCommand to -1
loop rowCursor from 0 to the length of listed:
    if (the item at rowCursor in listed)'s label = (the string form of "Floor plan"):
        set floorCommand to (the item at rowCursor in listed)'s command
free listed
set importRows to the bim context entries of editor in chooser (bim import chooser)
print (the string form of "Import:") as a line
show ribbon chooser rows importRows
free importRows
set exportRows to the bim context entries of editor in chooser (bim export chooser)
print (the string form of "Export:") as a line
show ribbon chooser rows exportRows
free exportRows
set plainRows to the bim context entries of editor in chooser 0
check ribbon choosers ((the item at 0 in plainRows)'s label = (the string form of "View")) named (the string form of "chooser 0 is the context menu of the selection")
free plainRows

# A drawing type's row makes a plan following that type, and shows it.
set viewCount to the length of (editor's documentValue's current's views's values)
check ribbon choosers (floorCommand >= (bim plan of drawing type command)) named (the string form of "Floor plan is offered")
type bim editor key floorCommand in e
check ribbon choosers ((the length of (editor's documentValue's current's views's values)) = (viewCount + 1)) named (the string form of "its row adds a plan view")
set made to the last item of (editor's documentValue's current's views's values)
print ((the string form of "made: ") + made's name) as a line
check ribbon choosers (editor's planViewId = made's id) named (the string form of "and shows it")
check ribbon choosers ((the bim drawing type named (the string form of "Floor plan") in (editor's documentValue's current)) = made's drawingTypeId) named (the string form of "following Floor plan")
type bim editor key ((bim plan of drawing type command) + 399) in e
check ribbon choosers ((the length of (editor's documentValue's current's views's values)) = (viewCount + 1)) named (the string form of "a place past the types adds nothing")
print ((the string form of "message: ") + editor's message) as a line
