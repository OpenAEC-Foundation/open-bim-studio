# SPDX-License-Identifier: MPL-2.0
# A viewport chosen on a sheet carries its own title type and actions
# (#112), instead of ribbon buttons: the properties show its view, scale and
# title type (a menu), the context menu and the floating toolbar offer
# Activate, Open view, the title types, Move, Copy and Delete; an activated
# viewport offers Deactivate. The View tab's Viewport chooser keeps only the
# sheet overview and the sheet's fit.
import ui/panels/bim_ui.dl

function check viewport actions {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The context menu as lines: a heading in brackets, a property with its
# value, a command with its code, a separator as a dash.
function show context menu of {bim editor record:editor}:
    execute:
        set rows to the bim context entries of editor
        loop rowCursor from 0 to the length of rows:
            set row to the item at rowCursor in rows
            if row's kind = bim context heading:
                print ((the string form of "[") + (row's label + (the string form of "]"))) as a line
            else if row's kind = bim context separator:
                print (the string form of "  -") as a line
            else if row's kind = bim context command:
                print (((the string form of "  ") + row's label) + ((the string form of " = ") + (the string form of row's command))) as a line
            else:
                print (((the string form of "  ") + row's label) + ((the string form of ": ") + row's value)) as a line
        free rows

# Whether the context menu offers a command sending `wanted`.
function the context menu of {bim editor record:editor} sends {integer:wanted}:
    execute:
        set offered to false
        set rows to the bim context entries of editor
        loop rowCursor from 0 to the length of rows:
            set row to the item at rowCursor in rows
            if (row's kind = bim context command) and (row's command = wanted):
                set offered to true
        free rows
        return offered

# The floating toolbar as one line: its title, its buttons (the lit one
# starred).
function show floating toolbar of {bim editor record:editor}:
    execute:
        set buttons to the bim floating toolbar buttons of editor
        set chosen to the bim floating toolbar choice of editor
        set shown to (the bim floating toolbar title of editor) + (the string form of ":")
        if (the length of buttons) = 0:
            set shown to the string form of "(hidden)"
        loop cursor from 0 to the length of buttons:
            set button to the item at cursor in buttons
            set shown to (shown + (the string form of " ")) + button's label
            if button's command = chosen:
                set shown to shown + (the string form of "*")
        free buttons
        print shown as a line

# Whether chooser `chooser` lists a row sending `wanted`.
function the chooser {integer:chooser} sends {integer:wanted}:
    execute:
        set offered to false
        set groups to the bim chooser groups of chooser
        loop groupCursor from 0 to the length of groups:
            set ribbonGroup to the item at groupCursor in groups
            loop buttonCursor from 0 to the length of (ribbonGroup's buttons):
                if (the item at buttonCursor in (ribbonGroup's buttons))'s command = wanted:
                    set offered to true
        free groups
        return offered

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set planId to add bim view of kind bim plan view named (the string form of "Ground floor plan") on editor's levelId to target
set sheetId to add bim sheet numbered (the string form of "A101") named (the string form of "Plans") on paper 3 landscape true to target
ignore (place bim view planId on sheet sheetId at (a cad vector2 with x 100.0 and y 120.0) looking at (a cad vector2 with x 0.0 and y 0.0) in target)
commit bim transaction in (the address of (editor's documentValue))
set editor's sheetId to sheetId
set editor's propertiesViewId to bim sheet properties context

print (the string form of "The sheet, nothing chosen:") as a line
show context menu of editor
show floating toolbar of editor
check viewport actions ((the context menu of editor sends 2280) = false) named (the string form of "no viewport actions without a viewport chosen")

print (the string form of "A viewport chosen:") as a line
set editor's sheetViewport to 0
show context menu of editor
show floating toolbar of editor
check viewport actions ((the context menu of editor sends 2280) and (the context menu of editor sends 2272)) named (the string form of "its menu offers Activate and the title types")
check viewport actions ((the bim floating toolbar choice of editor) = 2272) named (the string form of "its toolbar lights its title type")

# The title type from its menu in the properties, then stepped from the
# context menu.
start bim editor property (the bim menu option 1 of property (bim viewport title property)) in e
check viewport actions ((the bim viewport title type of 0 on sheetId in editor's documentValue's current) = 1) named (the string form of "the properties' menu sets Title + line")
check viewport actions ((the bim floating toolbar choice of editor) = 2273) named (the string form of "the toolbar follows")
start bim editor property (bim viewport title property) in e
check viewport actions ((the bim viewport title type of 0 on sheetId in editor's documentValue's current) = 2) named (the string form of "the context menu's row steps to No title")
ignore (undo bim transaction in (the address of (editor's documentValue)))
check viewport actions ((the bim viewport title type of 0 on sheetId in editor's documentValue's current) = 1) named (the string form of "each change is one undoable edit")

print (the string form of "The viewport activated:") as a line
set editor's sheetViewportActive to true
set editor's propertiesViewId to planId
show floating toolbar of editor
check viewport actions (the context menu of editor sends 2278) named (the string form of "an activated viewport's menu offers Deactivate")
set offeredStyles to the bim menu offering of property (bim viewport title property) for editor
check viewport actions ((the length of offeredStyles) = 0) named (the string form of "and no title type while it is edited")
free offeredStyles

check viewport actions ((the chooser (bim viewport chooser) sends 2272) = false) named (the string form of "the Viewport chooser no longer holds the title types")
check viewport actions ((the chooser (bim viewport chooser) sends 2278) = false) named (the string form of "nor Deactivate")
check viewport actions ((the chooser (bim viewport chooser) sends 2279) and (the chooser (bim viewport chooser) sends 2271)) named (the string form of "it keeps Fit sheet and All sheets")
