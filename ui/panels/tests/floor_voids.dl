# SPDX-License-Identifier: MPL-2.0
# An opening in a floor shows in the plan of its storey.
#
# A floor 10 by 8 m with a stairwell opening 1.2 by 3 m at (7.4, 1.6). The
# plan records the opening's four edges as visible lines and its two
# diagonals thin (`draw bim floor voids in plan of`), over the room fills,
# which hid the edges the screen draws under them. A room label keeps
# clear of the opening: its box is among the label obstacles. A roof with
# the same opening, above the cut, records nothing here: its dashed edges
# carry the opening.
import ui/panels/bim_plan_panel.dl

function check floor void {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
        else:
            print ((the string form of "PASS: ") + label) as a line

function the void test rectangle at {a 64 bit floating-point number:originX} and {a 64 bit floating-point number:originY} wide {a 64 bit floating-point number:width} deep {a 64 bit floating-point number:depth}:
    execute:
        set corners to an empty list of a cad vector2
        append (a cad vector2 with x originX and y originY) to corners
        append (a cad vector2 with x (originX + width) and y originY) to corners
        append (a cad vector2 with x (originX + width) and y (originY + depth)) to corners
        append (a cad vector2 with x originX and y (originY + depth)) to corners
        return corners

# How many points the strokes of `batch` hold.
function the void point count of {bim canvas batch record:batch}:
    execute:
        set runPoints to an empty list of a cad vector2
        set runCounts to an empty list of an integer
        set runClosed to an empty list of a boolean
        append bim stroke runs of batch into runPoints counting runCounts closing runClosed
        set total to the length of runPoints
        free runPoints
        free runCounts
        free runClosed
        return total

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to layers
set floorType to add bim planar type named (the string form of "Floor") as role bim floor planar role with layers to target
set floorId to add bim plate typed floorType on editor's levelId around (the void test rectangle at 0.0 and 0.0 wide 10.0 deep 8.0) at top 0.0 to target
set wellId to add bim plate opening on floorId around (the void test rectangle at 7.4 and 1.6 wide 1.2 deep 3.0) in target
refresh bim editor (the address of editor)
check floor void (wellId = 1) named (the string form of "the opening is in the floor")
set screenTransform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 100.0)
set floorCanvas to a new bim canvas
draw bim floor voids in plan of editor through screenTransform on (the address of floorCanvas)
set batchCount to the length of (floorCanvas's batches's values)
print ((the string form of "batches: ") + (the string form of batchCount)) as a line
check floor void (batchCount = 2) named (the string form of "the edges and the diagonals are recorded")
if batchCount = 2:
    print ((the string form of "edge points: ") + (the string form of (the void point count of (the item at 0 in (floorCanvas's batches's values))))) as a line
    print ((the string form of "diagonal points: ") + (the string form of (the void point count of (the item at 1 in (floorCanvas's batches's values))))) as a line
    check floor void ((the item at 1 in (floorCanvas's batches's values))'s breadth < (the item at 0 in (floorCanvas's batches's values))'s breadth) named (the string form of "the diagonals are thinner than the edges")
set pairs to an empty list of a cad vector2
set swept to an empty list of a bim lettering box record
append bim room label obstacles of editor through screenTransform lettered at 10.0 with symbols of 0.25 into pairs and swept
print ((the string form of "label obstacle boxes: ") + (the string form of (the length of swept))) as a line
check floor void ((the length of swept) = 1) named (the string form of "the opening is a room label obstacle")
# A roof with the same opening records nothing.
set roofEditor to a new bim editor
set roofTarget to the address of (roofEditor's documentValue's current)
set roofType to add bim planar type named (the string form of "Roof") as role bim roof planar role with layers to roofTarget
set roofId to add bim plate typed roofType on roofEditor's levelId around (the void test rectangle at 0.0 and 0.0 wide 10.0 deep 8.0) at top 3.0 to roofTarget
ignore (add bim plate opening on roofId around (the void test rectangle at 7.4 and 1.6 wide 1.2 deep 3.0) in roofTarget)
refresh bim editor (the address of roofEditor)
set roofCanvas to a new bim canvas
draw bim floor voids in plan of roofEditor through screenTransform on (the address of roofCanvas)
check floor void ((the length of (roofCanvas's batches's values)) = 0) named (the string form of "a roof's opening stays with its dashed edges")
# A stair of the storey below shows through the opening in the plan of the
# storey it arrives at: a flight along x 8 from y 0.8 to 4.4, 1 m wide,
# under a floor with an opening 1.2 by 3 m at (7.4, 1.6). The plan of the
# upper storey draws the treads and the walking line inside the opening
# only (y 1.6 to 4.6, pixels 160 to 460 at 100 pixels to the metre);
# without the opening it draws nothing of the stair.
function the void stroke points of {bim canvas record:canvas}:
    execute:
        set total to 0
        loop batchCursor from 0 to the length of (canvas's batches's values):
            set total to total + (the void point count of (the item at batchCursor in (canvas's batches's values)))
        return total

# Whether every stroke point of `canvas` lies within the pixels `lowX` to
# `highX` and `lowY` to `highY` (the plan's y may run either way).
function void strokes of {bim canvas record:canvas} stay between {a 64 bit floating-point number:lowX} and {a 64 bit floating-point number:highX} across {a 64 bit floating-point number:lowY} and {a 64 bit floating-point number:highY}:
    execute:
        set inside to true
        loop batchCursor from 0 to the length of (canvas's batches's values):
            set runPoints to an empty list of a cad vector2
            set runCounts to an empty list of an integer
            set runClosed to an empty list of a boolean
            append bim stroke runs of (the item at batchCursor in (canvas's batches's values)) into runPoints counting runCounts closing runClosed
            loop pointCursor from 0 to the length of runPoints:
                set spot to the item at pointCursor in runPoints
                set reachY to the absolute value of spot's y
                if ((spot's x < (lowX - 0.01)) or (spot's x > (highX + 0.01))) or ((reachY < (lowY - 0.01)) or (reachY > (highY + 0.01))):
                    set inside to false
            free runPoints
            free runCounts
            free runClosed
        return inside

loop wellCase from 0 to 2:
    set house to a new bim editor
    set houseTarget to the address of (house's documentValue's current)
    set groundLevel to the item at 0 in (houseTarget's levels's values)
    set upperId to add bim level named (the string form of "First floor") at (groundLevel's elevation + groundLevel's height) with height 3.0 to houseTarget
    set upperType to add bim planar type named (the string form of "Floor") as role bim floor planar role with layers to houseTarget
    set upperFloor to add bim plate typed upperType on upperId around (the void test rectangle at 0.0 and 0.0 wide 10.0 deep 8.0) at top 0.0 to houseTarget
    if wellCase = 1:
        ignore (add bim plate opening on upperFloor around (the void test rectangle at 7.4 and 1.6 wide 1.2 deep 3.0) in houseTarget)
    ignore (add bim stair on groundLevel's id from (a cad vector2 with x 8.0 and y 0.8) to (a cad vector2 with x 8.0 and y 4.4) wide 1.0 in 17 risers of (the string form of "timber") to houseTarget)
    set house's levelId to upperId
    refresh bim editor (the address of house)
    set stairCanvas to a new bim canvas
    draw bim stairs in plan of house through screenTransform on (the address of stairCanvas)
    set stairPoints to the void stroke points of stairCanvas
    if wellCase = 0:
        print ((the string form of "without an opening, stair points: ") + (the string form of stairPoints)) as a line
        check floor void (stairPoints = 0) named (the string form of "a closed floor hides the stair below")
    else:
        print ((the string form of "with the opening, stair points: ") + (the string form of stairPoints)) as a line
        check floor void (stairPoints > 20) named (the string form of "the stair below shows through the opening")
        check floor void (void strokes of stairCanvas stay between 740.0 and 860.0 across 160.0 and 460.0) named (the string form of "and only inside it")
# A room's fill leaves the voids in its floor out: a room 6 by 5 m between
# the axes of 200 mm walls (27.84 m2 inside) with an opening of 2 by 2.5 m
# in its floor is filled over 22.84 m2 (at 100 pixels to the metre, 10,000
# square pixels to the square metre).
function the void fill area of {bim canvas record:canvas}:
    execute:
        set total to 0.0
        loop batchCursor from 0 to the length of (canvas's batches's values):
            set fillBatch to the item at batchCursor in (canvas's batches's values)
            if fillBatch's stroked = false:
                set fillCorners to fillBatch's pixels's values
                set cornerCursor to 0
                loop while (cornerCursor + 2) < (the length of fillCorners):
                    set cornerA to the item at cornerCursor in fillCorners
                    set cornerB to the item at (cornerCursor + 1) in fillCorners
                    set cornerC to the item at (cornerCursor + 2) in fillCorners
                    set total to total + ((the absolute value of (((cornerB's x - cornerA's x) * (cornerC's y - cornerA's y)) - ((cornerC's x - cornerA's x) * (cornerB's y - cornerA's y)))) * 0.5)
                    set cornerCursor to cornerCursor + 3
        return total

loop fillCase from 0 to 2:
    set roomEditor to a new bim editor
    set roomTarget to the address of (roomEditor's documentValue's current)
    set roomLayers to an empty list of a bim layer record
    append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.2)) to roomLayers
    set roomWallType to add bim wall type named (the string form of "CLT 200") with roomLayers to roomTarget
    ignore add bim wall typed roomWallType on roomEditor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to roomTarget
    ignore add bim wall typed roomWallType on roomEditor's levelId from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 6.0 and y 5.0) to roomTarget
    ignore add bim wall typed roomWallType on roomEditor's levelId from (a cad vector2 with x 6.0 and y 5.0) to (a cad vector2 with x 0.0 and y 5.0) to roomTarget
    ignore add bim wall typed roomWallType on roomEditor's levelId from (a cad vector2 with x 0.0 and y 5.0) to (a cad vector2 with x 0.0 and y 0.0) to roomTarget
    set roomFloorType to add bim planar type named (the string form of "Floor") as role bim floor planar role with layers to roomTarget
    set roomFloor to add bim plate typed roomFloorType on roomEditor's levelId around (the void test rectangle at 0.0 and 0.0 wide 6.0 deep 5.0) at top 0.0 to roomTarget
    if fillCase = 1:
        ignore (add bim plate opening on roomFloor around (the void test rectangle at 3.0 and 1.5 wide 2.0 deep 2.5) in roomTarget)
    refresh bim editor (the address of roomEditor)
    set fillCanvas to a new bim canvas
    draw bim space fills of roomEditor through screenTransform on (the address of fillCanvas)
    set filledMetres to (the rounded value of ((the void fill area of fillCanvas) / 100.0)) as an integer
    if fillCase = 0:
        print ((the string form of "closed floor, room fill (0.01 m2): ") + (the string form of filledMetres)) as a line
        check floor void (filledMetres = 2784) named (the string form of "a room on a closed floor is filled whole")
    else:
        print ((the string form of "floor with a void, room fill (0.01 m2): ") + (the string form of filledMetres)) as a line
        check floor void (filledMetres = 2284) named (the string form of "the void takes no fill")
