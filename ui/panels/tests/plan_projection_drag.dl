# SPDX-License-Identifier: MPL-2.0
# A plan's projection while walls are dragged (drawing quality plan, item
# 15; ui/panels/bim_plan_projection.dl): the edges are not worked out whole
# on every frame of a drag, only those of the elements changed and of the
# elements whose boxes in plan touch theirs, and they equal the edges a
# fresh projection works out, on every frame and once the drag ends (when
# they are worked out whole again).
#
# A ground floor (cut at 1.2 m, a roof level at 3 m) of four 200 mm walls
# around 6 by 4 m with a window in the front wall and a flat roof on the
# roof level overhanging them; inside, a knee wall 0.8 m high from x 1 to 3
# at y 2, a lower one 0.5 m high across it from y 1 to 3 at x 2 (the higher
# one hides part of it), a knee wall 0.8 m high far off at x 5.2, and a
# free-standing wall of full height from y 1.5 to 3 at x 4. First the knee
# wall at y 2 is dragged over three frames to y 2.3, then the full wall
# over three frames to x 4.6 (its cut and the roof's edges above change)
# and the drag cancelled; then the front wall with its window (the rough
# opening's cut moves with it) over three frames to y 0.3, cancelled; then
# the far knee wall, curved, over three frames to x 4.9, cancelled.
import ui/panels/bim_plan_projection.dl

function check plan drag {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
        else:
            print ((the string form of "PASS: ") + label) as a line

# Whether edges `keptEdges` and `freshEdges` are the same, in the same
# order, to the last bit.
function plan drag edges {a pointer to a list:keptEdges} equal {a pointer to a list:freshEdges}:
    execute:
        if (the length of keptEdges) != (the length of freshEdges):
            return false
        loop edgeCursor from 0 to the length of keptEdges:
            set keptEdge to the item at edgeCursor in keptEdges
            set freshEdge to the item at edgeCursor in freshEdges
            if keptEdge's elementId != freshEdge's elementId:
                return false
            if (keptEdge's start's x != freshEdge's start's x) or (keptEdge's start's y != freshEdge's start's y):
                return false
            if (keptEdge's finish's x != freshEdge's finish's x) or (keptEdge's finish's y != freshEdge's finish's y):
                return false
            if keptEdge's depth != freshEdge's depth:
                return false
        return true

# How much of the segment from (`ax`, `ay`) to (`bx`, `by`) the edges lying
# on it cover together, in metres (overlaps counted twice: the segments
# checked here are covered once).
function the plan drag cover of {a pointer to a list:edges} from {a 64 bit floating-point number:ax} {a 64 bit floating-point number:ay} to {a 64 bit floating-point number:bx} {a 64 bit floating-point number:by}:
    execute:
        set runX to bx - ax
        set runY to by - ay
        set runLength to the square root of ((runX * runX) + (runY * runY))
        set unitX to runX / runLength
        set unitY to runY / runLength
        set covered to 0.0
        loop edgeCursor from 0 to the length of edges:
            set edge to the item at edgeCursor in edges
            set startOff to ((edge's start's x - ax) * (0.0 - unitY)) + ((edge's start's y - ay) * unitX)
            set finishOff to ((edge's finish's x - ax) * (0.0 - unitY)) + ((edge's finish's y - ay) * unitX)
            if ((the absolute value of startOff) < 0.0001) and ((the absolute value of finishOff) < 0.0001):
                set startAlong to ((edge's start's x - ax) * unitX) + ((edge's start's y - ay) * unitY)
                set finishAlong to ((edge's finish's x - ax) * unitX) + ((edge's finish's y - ay) * unitY)
                set lowAlong to the maximum of 0.0 and (the minimum of startAlong and finishAlong)
                set highAlong to the minimum of runLength and (the maximum of startAlong and finishAlong)
                if highAlong > lowAlong:
                    set covered to covered + (highAlong - lowAlong)
        return covered

# Whether `idList` holds `wantedId`.
function plan drag ids {a pointer to a list:idList} hold {a 64 bit integer:wantedId}:
    execute:
        loop idCursor from 0 to the length of idList:
            if (the item at idCursor in idList) = wantedId:
                return true
        return false

# The edges `planProjection` holds against a projection of the same plan
# worked out afresh, with the frame's numbers.
function check plan drag frame {a string:label} of {a pointer to a bim plan projection record:planProjection} for {bim editor record:planEditor} among {a pointer to a list:sceneEntries}:
    execute:
        set freshProjection to an empty bim plan projection
        refresh bim plan projection in (the address of freshProjection) of planEditor among sceneEntries cut as planEditor's plan
        print ((label + (the string form of ": below ")) + ((the string form of (the length of (planProjection's below's values))) + ((the string form of ", above ") + (the string form of (the length of (planProjection's above's values)))))) as a line
        print ((the string form of "  builds ") + ((the string form of planProjection's builds) + ((the string form of ", updates ") + ((the string form of planProjection's partials) + ((the string form of ", meshes worked out ") + (the string form of planProjection's redrawn)))))) as a line
        check plan drag (plan drag edges (planProjection's below's values) equal (freshProjection's below's values)) named (label + (the string form of ": below the cut as a fresh projection"))
        check plan drag (plan drag edges (planProjection's above's values) equal (freshProjection's above's values)) named (label + (the string form of ": above it as a fresh projection"))

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set ground to editor's levelId
set roofLevel to add bim level named (the string form of "Roof") at 3.0 with height 3.0 to target
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to layerValues
set brickType to add bim wall type named (the string form of "Brick 200") with layerValues to target
free layerValues
set frontWall to add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set rightWall to add bim wall typed brickType on ground from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 6.0 and y 4.0) to target
set backWall to add bim wall typed brickType on ground from (a cad vector2 with x 6.0 and y 4.0) to (a cad vector2 with x 0.0 and y 4.0) to target
set leftWall to add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 4.0) to (a cad vector2 with x 0.0 and y 0.0) to target
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
set windowId to add bim opening typed windowType in frontWall at 3.0 to target
set kneeWall to add bim wall typed brickType on ground from (a cad vector2 with x 1.0 and y 2.0) to (a cad vector2 with x 3.0 and y 2.0) to target
ignore (set bim wall kneeWall height to 0.8 in target)
set lowWall to add bim wall typed brickType on ground from (a cad vector2 with x 2.0 and y 1.0) to (a cad vector2 with x 2.0 and y 3.0) to target
ignore (set bim wall lowWall height to 0.5 in target)
set farWall to add bim wall typed brickType on ground from (a cad vector2 with x 5.2 and y 1.0) to (a cad vector2 with x 5.2 and y 3.0) to target
ignore (set bim wall farWall height to 0.8 in target)
set fullWall to add bim wall typed brickType on ground from (a cad vector2 with x 4.0 and y 1.5) to (a cad vector2 with x 4.0 and y 3.0) to target
set roofLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.2)) to roofLayers
set roofType to add bim planar type named (the string form of "Flat roof") as role bim roof planar role with roofLayers to target
free roofLayers
set roofOutline to an empty list of a cad vector2
append (a cad vector2 with x -0.5 and y -0.5) to roofOutline
append (a cad vector2 with x 6.5 and y -0.5) to roofOutline
append (a cad vector2 with x 6.5 and y 4.5) to roofOutline
append (a cad vector2 with x -0.5 and y 4.5) to roofOutline
set roofId to add bim plate typed roofType on roofLevel around roofOutline at top 0.2 to target
set groundPlan to add bim view of kind bim plan view named (the string form of "Ground floor") on ground to target
set editor's planViewId to groundPlan
refresh bim editor (the address of editor)
set sceneList to the bim sketch meshes of editor's documentValue's current

set planProjection to an empty bim plan projection
refresh bim plan projection in (the address of planProjection) of editor among (sceneList's values) cut as editor's plan
check plan drag frame (the string form of "before the drag") of (the address of planProjection) for editor among (sceneList's values)
print ((the string form of "  knee wall ") + ((the string form of kneeWall) + ((the string form of ", low wall ") + ((the string form of lowWall) + ((the string form of ", far wall ") + (the string form of farWall)))))) as a line
check plan drag ((the plan drag cover of (planProjection's below's values) from 1.0 1.9 to 3.0 1.9) > 1.99) named (the string form of "the knee wall's top seen below the cut")
check plan drag (planProjection's exact and (planProjection's builds = 1)) named (the string form of "worked out whole")
set buildsBefore to planProjection's builds

# The knee wall dragged, frame by frame, as the editor drags it: the
# transaction open, the model changed in it, the editor refreshed.
begin bim transaction in (the address of (editor's documentValue))
set editor's dragging to true
set editor's dragMoved to true
check plan drag (bim editor editor edits continuously) named (the string form of "a drag is a continuous edit")
loop frameCursor from 1 to 4:
    set rise to 0.1 * (frameCursor as a 64 bit floating-point number)
    ignore (move bim wall kneeWall to (a cad vector2 with x 1.0 and y (2.0 + rise)) and (a cad vector2 with x 3.0 and y (2.0 + rise)) in target)
    refresh bim editor (the address of editor)
    set sceneList to the bim sketch meshes of editor's documentValue's current
    refresh bim plan projection in (the address of planProjection) of editor among (sceneList's values) cut as editor's plan
    check plan drag frame ((the string form of "knee wall drag, frame ") + (the string form of frameCursor)) of (the address of planProjection) for editor among (sceneList's values)
    check plan drag ((planProjection's builds = buildsBefore) and (planProjection's partials = frameCursor)) named (the string form of "  not worked out whole, the edges kept updated")
    check plan drag (planProjection's redrawn < 4) named (the string form of "  the edges of the dragged wall and the one it crosses only")
    check plan drag (planProjection's keptBelow's partial and planProjection's keptAbove's partial) named (the string form of "  below and above updated, not worked out whole")
    check plan drag (plan drag ids (planProjection's keptBelow's redrawnIds's values) hold kneeWall) named (the string form of "  the dragged wall's edges worked out again")
    set farRedrawn to (plan drag ids (planProjection's keptBelow's redrawnIds's values) hold farWall) or (plan drag ids (planProjection's keptAbove's redrawnIds's values) hold farWall)
    check plan drag (farRedrawn = false) named (the string form of "  the far knee wall's edges kept, not worked out again")
check plan drag ((the plan drag cover of (planProjection's below's values) from 1.0 2.4 to 3.0 2.4) > 1.99) named (the string form of "the knee wall's top seen where it was dragged")
check plan drag ((the plan drag cover of (planProjection's below's values) from 1.0 1.9 to 3.0 1.9) < 0.001) named (the string form of "and nothing left where it was")
check plan drag ((the plan drag cover of (planProjection's below's values) from 5.1 1.0 to 5.1 3.0) > 1.99) named (the string form of "the far knee wall still drawn")

# Let go: the drag committed, the edges worked out whole again.
commit bim transaction in (the address of (editor's documentValue))
set editor's dragging to false
set editor's dragMoved to false
refresh bim editor (the address of editor)
set sceneList to the bim sketch meshes of editor's documentValue's current
refresh bim plan projection in (the address of planProjection) of editor among (sceneList's values) cut as editor's plan
check plan drag frame (the string form of "knee wall let go") of (the address of planProjection) for editor among (sceneList's values)
check plan drag (planProjection's exact and (planProjection's builds = (buildsBefore + 1))) named (the string form of "brought up to date once the drag ends")

# The full wall dragged: its cut moves, and the roof's edges above.
set buildsBefore to planProjection's builds
set updatesBefore to planProjection's partials
begin bim transaction in (the address of (editor's documentValue))
set editor's dragging to true
set editor's dragMoved to true
loop frameCursor from 1 to 4:
    set sideStep to 0.2 * (frameCursor as a 64 bit floating-point number)
    ignore (move bim wall fullWall to (a cad vector2 with x (4.0 + sideStep) and y 1.5) and (a cad vector2 with x (4.0 + sideStep) and y 3.0) in target)
    refresh bim editor (the address of editor)
    set sceneList to the bim sketch meshes of editor's documentValue's current
    refresh bim plan projection in (the address of planProjection) of editor among (sceneList's values) cut as editor's plan
    check plan drag frame ((the string form of "full wall drag, frame ") + (the string form of frameCursor)) of (the address of planProjection) for editor among (sceneList's values)
    check plan drag ((planProjection's builds = buildsBefore) and (planProjection's partials = (updatesBefore + frameCursor))) named (the string form of "  not worked out whole, the edges kept updated")
# Cancelled: the model as it was, the edges worked out whole again.
roll back bim transaction in (the address of (editor's documentValue))
set editor's dragging to false
set editor's dragMoved to false
refresh bim editor (the address of editor)
set sceneList to the bim sketch meshes of editor's documentValue's current
refresh bim plan projection in (the address of planProjection) of editor among (sceneList's values) cut as editor's plan
check plan drag frame (the string form of "full wall drag cancelled") of (the address of planProjection) for editor among (sceneList's values)
check plan drag (planProjection's exact and (planProjection's builds = (buildsBefore + 1))) named (the string form of "brought up to date once the drag ends")

# The front wall dragged inwards with its window: the window's rough
# opening is a cut polygon that moves with it.
set buildsBefore to planProjection's builds
set updatesBefore to planProjection's partials
begin bim transaction in (the address of (editor's documentValue))
set editor's dragging to true
set editor's dragMoved to true
loop frameCursor from 1 to 4:
    set inStep to 0.1 * (frameCursor as a 64 bit floating-point number)
    ignore (move bim wall frontWall to (a cad vector2 with x 0.0 and y inStep) and (a cad vector2 with x 6.0 and y inStep) in target)
    refresh bim editor (the address of editor)
    set sceneList to the bim sketch meshes of editor's documentValue's current
    refresh bim plan projection in (the address of planProjection) of editor among (sceneList's values) cut as editor's plan
    check plan drag frame ((the string form of "front wall drag, frame ") + (the string form of frameCursor)) of (the address of planProjection) for editor among (sceneList's values)
    check plan drag ((planProjection's builds = buildsBefore) and (planProjection's partials = (updatesBefore + frameCursor))) named (the string form of "  not worked out whole, the edges kept updated")
    check plan drag ((plan drag ids (planProjection's keptBelow's redrawnIds's values) hold kneeWall) = false) named (the string form of "  the knee wall's edges kept, not worked out again")
    check plan drag ((plan drag ids (planProjection's keptBelow's redrawnIds's values) hold farWall) = false) named (the string form of "  the far knee wall's edges kept, not worked out again")
roll back bim transaction in (the address of (editor's documentValue))
set editor's dragging to false
set editor's dragMoved to false
refresh bim editor (the address of editor)
set sceneList to the bim sketch meshes of editor's documentValue's current
refresh bim plan projection in (the address of planProjection) of editor among (sceneList's values) cut as editor's plan
check plan drag frame (the string form of "front wall drag cancelled") of (the address of planProjection) for editor among (sceneList's values)
check plan drag (planProjection's exact and (planProjection's builds = (buildsBefore + 1))) named (the string form of "brought up to date once the drag ends")

# The far knee wall curved (bulging 0.3 m towards the right wall), then
# dragged towards the full wall.
begin bim transaction in (the address of (editor's documentValue))
ignore (bend bim wall farWall by 0.3 in target)
commit bim transaction in (the address of (editor's documentValue))
refresh bim editor (the address of editor)
set sceneList to the bim sketch meshes of editor's documentValue's current
refresh bim plan projection in (the address of planProjection) of editor among (sceneList's values) cut as editor's plan
check plan drag frame (the string form of "far knee wall curved") of (the address of planProjection) for editor among (sceneList's values)
set buildsBefore to planProjection's builds
set updatesBefore to planProjection's partials
begin bim transaction in (the address of (editor's documentValue))
set editor's dragging to true
set editor's dragMoved to true
loop frameCursor from 1 to 4:
    set leftStep to 0.1 * (frameCursor as a 64 bit floating-point number)
    ignore (move bim wall farWall to (a cad vector2 with x (5.2 - leftStep) and y 1.0) and (a cad vector2 with x (5.2 - leftStep) and y 3.0) in target)
    refresh bim editor (the address of editor)
    set sceneList to the bim sketch meshes of editor's documentValue's current
    refresh bim plan projection in (the address of planProjection) of editor among (sceneList's values) cut as editor's plan
    check plan drag frame ((the string form of "curved wall drag, frame ") + (the string form of frameCursor)) of (the address of planProjection) for editor among (sceneList's values)
    check plan drag ((planProjection's builds = buildsBefore) and (planProjection's partials = (updatesBefore + frameCursor))) named (the string form of "  not worked out whole, the edges kept updated")
    check plan drag (plan drag ids (planProjection's keptBelow's redrawnIds's values) hold farWall) named (the string form of "  the curved wall's edges worked out again")
    check plan drag ((plan drag ids (planProjection's keptBelow's redrawnIds's values) hold kneeWall) = false) named (the string form of "  the knee wall's edges kept, not worked out again")
roll back bim transaction in (the address of (editor's documentValue))
set editor's dragging to false
set editor's dragMoved to false
refresh bim editor (the address of editor)
set sceneList to the bim sketch meshes of editor's documentValue's current
refresh bim plan projection in (the address of planProjection) of editor among (sceneList's values) cut as editor's plan
check plan drag frame (the string form of "curved wall drag cancelled") of (the address of planProjection) for editor among (sceneList's values)
check plan drag (planProjection's exact and (planProjection's builds = (buildsBefore + 1))) named (the string form of "brought up to date once the drag ends")
