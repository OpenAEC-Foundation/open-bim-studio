# SPDX-License-Identifier: MPL-2.0
# The two-letter commands of Open 2D Studio, copying and create similar,
# driven by simulated events.
import editor/bim_editor.dl

function show bim codes {a pointer to a list:codes} labelled {a string:label}:
    execute:
        set line to label
        loop cursor from 0 to the length of codes:
            set line to (line + (the string form of " ")) + (the string form of (the item at cursor in codes))
        print line as a line

function click bim command test at {a 64 bit floating-point number:x} and {a 64 bit floating-point number:y} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to (a cad vector2 with x x and y y) within 0.1 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

set editor to a new bim editor
set e to the address of editor
show bim codes (resolve bim editor letter 87 at (0 as a 64 bit integer) in e) labelled (the string form of "W:")
show bim codes (resolve bim editor letter 65 at (100000 as a 64 bit integer) in e) labelled (the string form of "then A:")
show bim codes (resolve bim editor letter 87 at (200000 as a 64 bit integer) in e) labelled (the string form of "W:")
show bim codes (the bim letters timed out at (600000 as a 64 bit integer) in e) labelled (the string form of "at 0.6 s:")
show bim codes (the bim letters timed out at (950000 as a 64 bit integer) in e) labelled (the string form of "at 0.95 s:")
show bim codes (resolve bim editor letter 78 at (1000000 as a 64 bit integer) in e) labelled (the string form of "N:")
show bim codes (resolve bim editor letter 67 at (1100000 as a 64 bit integer) in e) labelled (the string form of "C:")
show bim codes (resolve bim editor letter 83 at (1200000 as a 64 bit integer) in e) labelled (the string form of "then S:")
show bim codes (resolve bim editor letter 84 at (1300000 as a 64 bit integer) in e) labelled (the string form of "T:")
show bim codes (resolve bim editor letter 78 at (1400000 as a 64 bit integer) in e) labelled (the string form of "then N:")
type bim editor key 2016 in e
print editor's message as a line

# Copy a pushed face twice.
type bim editor key 82 in e
click bim command test at 0.0 and 0.0 in e
click bim command test at 2.0 and 1.0 in e
type bim editor key 80 in e
click bim command test at 1.0 and 0.5 in e
type bim editor key 51 in e
type bim editor key bim enter key code in e
type bim editor key 83 in e
click bim command test at 1.0 and 0.5 in e
type bim editor key 2002 in e
click bim command test at 0.0 and 0.0 in e
click bim command test at 4.0 and 0.0 in e
click bim command test at 8.0 and 0.0 in e
print editor's message as a line
set masses to 0
loop cursor from 0 to the length of (editor's documentValue's current's sketches's values):
    set element to the item at cursor in (editor's documentValue's current's sketches's values)
    if (element's kind = bim face sketch) and (element's height = 3.0):
        set masses to masses + 1
print ((the string form of "masses 3 m high ") + (the string form of masses)) as a line

# Copy a wall with its window, and create a similar wall.
type bim editor key bim escape key code in e
type bim editor key 87 in e
click bim command test at 0.0 and 10.0 in e
click bim command test at 6.0 and 10.0 in e
type bim editor key bim escape key code in e
type bim editor key 79 in e
click bim command test at 3.0 and 10.0 in e
refresh bim editor e
type bim editor key 83 in e
click bim command test at 1.0 and 10.0 in e
print editor's message as a line
type bim editor key 2002 in e
click bim command test at 0.0 and 10.0 in e
click bim command test at 0.0 and 14.0 in e
print ((the string form of "walls ") + (the string form of (the length of (editor's documentValue's current's walls's values)))) as a line
print ((the string form of "openings ") + (the string form of (the length of (editor's documentValue's current's openings's values)))) as a line
type bim editor key bim escape key code in e
refresh bim editor e
type bim editor key 83 in e
click bim command test at 1.0 and 14.0 in e
print editor's message as a line
type bim editor key 2001 in e
print editor's message as a line
print ((the string form of "wall tool ") + (the string form of (editor's tool = bim wall tool))) as a line
type bim editor key 90 in e
print ((the string form of "after undo walls ") + (the string form of (the length of (editor's documentValue's current's walls's values)))) as a line
