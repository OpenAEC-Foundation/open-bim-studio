# SPDX-License-Identifier: MPL-2.0
# Room labels in plan: an explicit space shows its name, number and area, a
# detected room its area, the area with the drawing standard's decimal sign
# and 'm²'; a small room keeps its label beside it on a leader; the plan's
# drawing type can switch the 'Room labels' rule off.
import ui/panels/bim_plan_panel.dl

function check room labels {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function show room labels of {bim canvas record:canvas} titled {a string:title}:
    execute:
        set line to title + (the string form of ":")
        loop cursor from 0 to the length of (canvas's texts's values):
            set label to the item at cursor in (canvas's texts's values)
            set line to ((line + (the string form of " [")) + label's message) + (the string form of "]")
        print line as a line

function the stroked batch count of {bim canvas record:canvas}:
    execute:
        set count to 0
        loop cursor from 0 to the length of (canvas's batches's values):
            if (the item at cursor in (canvas's batches's values))'s stroked:
                set count to count + 1
        return count

function a room outline from {a 64 bit floating-point number:leftX} to {a 64 bit floating-point number:rightX} by {a 64 bit floating-point number:lowY} to {a 64 bit floating-point number:highY}:
    execute:
        set outlineList to a cad topology list of a cad vector2
        append (a cad vector2 with x leftX and y lowY) to (outlineList's values)
        append (a cad vector2 with x rightX and y lowY) to (outlineList's values)
        append (a cad vector2 with x rightX and y highY) to (outlineList's values)
        append (a cad vector2 with x leftX and y highY) to (outlineList's values)
        return outlineList

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set planView to add bim view of kind (bim plan view) named (the string form of "Plan") on editor's levelId to target
set editor's planViewId to planView
set transform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 100.0)

# A kitchen of 4 by 3 m and a meter cupboard of 0.8 by 0.8 m, which at 100
# pixels per metre is narrower than seven text heights.
set kitchenRing to a room outline from 0.0 to 4.0 by 0.0 to 3.0
ignore add bim space object named (the string form of "Kitchen") numbered (the string form of "0.01") on editor's levelId around (kitchenRing's values) high 2.7 to target
set cupboardRing to a room outline from 6.0 to 6.8 by 0.0 to 0.8
ignore add bim space object named (the string form of "Meter cupboard") numbered (the string form of "0.02") on editor's levelId around (cupboardRing's values) high 2.7 to target

set nenCanvas to a new bim canvas
draw bim space labels of editor through transform lettered at 13.0 on (the address of nenCanvas)
show room labels of nenCanvas titled (the string form of "NEN")
check room labels ((the length of (nenCanvas's texts's values)) = 6) named (the string form of "both rooms keep name, number and area")
set kitchenName to the item at 0 in (nenCanvas's texts's values)
check room labels kitchenName's centred named (the string form of "a large room's label is centred in it")
set cupboardName to the item at 3 in (nenCanvas's texts's values)
set cupboardRight to (the bim pixel of (a cad vector2 with x 6.8 and y 0.0) through transform)'s x
check room labels ((cupboardName's centred = false) and (cupboardName's x > cupboardRight)) named (the string form of "a small room's label stands beside it")
check room labels ((the stroked batch count of nenCanvas) = 1) named (the string form of "a small room's label has a leader")
set cupboardInside to the bim pixel of (a bim point inside (cupboardRing's values)) through transform
check room labels ((cupboardName's anchor's x = cupboardInside's x) and (cupboardName's anchor's y = cupboardInside's y)) named (the string form of "the small room's label follows the room")

# Under ISO 128 the area takes a decimal point.
set bim setting (bim drawing standard setting) of (0 as a 64 bit integer) to ((bim iso standard) as a 64 bit integer) keeping true in target
set isoCanvas to a new bim canvas
draw bim space labels of editor through transform lettered at 13.0 on (the address of isoCanvas)
show room labels of isoCanvas titled (the string form of "ISO")
set bim setting (bim drawing standard setting) of (0 as a 64 bit integer) to ((bim nen standard) as a 64 bit integer) keeping true in target

# A detected room without a space shows its area; one a space covers, and a
# sliver between two walls, show nothing of their own.
set hallRing to a room outline from 10.0 to 13.0 by 0.0 to 2.0
append (@intrinsic("construct", a bim space record, editor's levelId, a cad topology list of a 64 bit integer, hallRing, 6.0)) to (editor's spaces's values)
set coveredRing to a room outline from 0.0 to 4.0 by 0.0 to 3.0
append (@intrinsic("construct", a bim space record, editor's levelId, a cad topology list of a 64 bit integer, coveredRing, 12.0)) to (editor's spaces's values)
set sliverRing to a room outline from 20.0 to 20.04 by 0.0 to 3.0
append (@intrinsic("construct", a bim space record, editor's levelId, a cad topology list of a 64 bit integer, sliverRing, 0.12)) to (editor's spaces's values)
set regionCanvas to a new bim canvas
draw bim space labels of editor through transform lettered at 13.0 on (the address of regionCanvas)
show room labels of regionCanvas titled (the string form of "regions")
check room labels ((the length of (regionCanvas's texts's values)) = 7) named (the string form of "a detected room adds only its area")

# The drawing type's 'Room labels' rule: on for Floor plan (inherited from
# Architectural), off for Structural, and switchable per type.
ensure bim drawing types in target
set floorPlan to the bim drawing type named (the string form of "Floor plan") in editor's documentValue's current
set structural to the bim drawing type named (the string form of "Structural") in editor's documentValue's current
set viewValue to the item at (the bim view index of planView in editor's documentValue's current)'s position in (editor's documentValue's current's views's values)
set viewValue's drawingTypeId to floorPlan
store bim view viewValue in target
set floorCanvas to a new bim canvas
draw bim space labels of editor through transform lettered at 13.0 on (the address of floorCanvas)
check room labels ((the length of (floorCanvas's texts's values)) = 7) named (the string form of "Floor plan draws room labels")
set viewValue's drawingTypeId to structural
store bim view viewValue in target
set structuralCanvas to a new bim canvas
draw bim space labels of editor through transform lettered at 13.0 on (the address of structuralCanvas)
check room labels ((the length of (structuralCanvas's texts's values)) = 0) named (the string form of "Structural leaves room labels off")
set viewValue's drawingTypeId to floorPlan
store bim view viewValue in target
ignore set bim drawing type floorPlan setting 2 at bim room labels annotation to 0 in target
set offCanvas to a new bim canvas
draw bim space labels of editor through transform lettered at 13.0 on (the address of offCanvas)
check room labels ((the length of (offCanvas's texts's values)) = 0) named (the string form of "switching the rule off removes room labels")
