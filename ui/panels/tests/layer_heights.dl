# SPDX-License-Identifier: MPL-2.0
# Layers of a wall with a foot or top of their own (`set bim wall ... layer
# ... foot to ... and top to ...`): the outer leaf of a cavity wall runs 0.3 m
# below the wall's foot and 0.5 m above its top, reads back to the
# millimetre, and a layer the type has not or one left no height is refused.
# The layer solids and the wall's own solid (its layers in one polyhedron)
# are checked by volume and closedness; a section and plans above, through
# and below the storey meet the layers standing there; the properties window
# shows the reaches and takes a typed one, which one undo takes back; the
# masonry follows its layer; the IFC body goes out as a triangulated face
# set; and 0 and 0 build the wall whole again.
import ui/editor/bim_editor.dl

function check layer height {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# Whether `measured` is `wanted` to a micrometre.
function layer height measure {a 64 bit floating-point number:measured} is {a 64 bit floating-point number:wanted}:
    execute:
        return (the absolute value of (measured - wanted)) < 1e-6

function type layer height keys {a string:keys} in {a pointer to a bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of keys:
            type bim editor key ((the character at cursor in keys) as an integer) in editor
        type bim editor key bim enter key code in editor

# The code of the property row labelled `label` in the window, or -1.
function the layer height row code of {a string:label} in {a pointer to a bim editor record:editor}:
    execute:
        set propertyRows to the bim property rows of (@intrinsic("dereference", editor))
        set found to -1
        loop cursor from 0 to the length of propertyRows:
            set propertyRow to the item at cursor in propertyRows
            if propertyRow's label = label:
                set found to propertyRow's code
        free propertyRows
        return found

# What the window shows for the property row labelled `label`, or "".
function the layer height row value of {a string:label} in {a pointer to a bim editor record:editor}:
    execute:
        set propertyRows to the bim property rows of (@intrinsic("dereference", editor))
        set found to the string form of ""
        loop cursor from 0 to the length of propertyRows:
            set propertyRow to the item at cursor in propertyRows
            if propertyRow's label = label:
                set found to propertyRow's value
        free propertyRows
        return found

# The layer solids of wall `wallId` as the editor builds them.
function the layer height solids of wall {a 64 bit integer:wallId} in {a pointer to a bim editor record:editor}:
    execute:
        set found to the bim wall index of wallId in editor's documentValue's current
        return the bim layer solids of (the item at found's position in (editor's documentValue's current's walls's values)) in editor's documentValue's current using editor's evaluation's index

# The volume of layer solid `layerIndex` of wall `wallId`, or -1 when there
# is no such solid.
function the layer height volume {integer:layerIndex} of wall {a 64 bit integer:wallId} in {a pointer to a bim editor record:editor}:
    execute:
        set layered to the layer height solids of wall wallId in editor
        if layerIndex >= (the length of (layered's values)):
            return 0.0 - 1.0
        return the fast volume of (the item at layerIndex in (layered's values))'s shape

# Whether every layer solid of wall `wallId` is a closed polyhedron.
function layer height solids of wall {a 64 bit integer:wallId} are closed in {a pointer to a bim editor record:editor}:
    execute:
        set layered to the layer height solids of wall wallId in editor
        loop cursor from 0 to the length of (layered's values):
            if (the fast flaw of (the item at cursor in (layered's values))'s shape within 1e-9) != 0:
                return false
        return true

# The evaluated geometry of wall `wallId`.
function the layer height geometry of wall {a 64 bit integer:wallId} in {a pointer to a bim editor record:editor}:
    execute:
        set found to the bim position of wallId among (editor's evaluation's elements's values)
        return the item at found's position in (editor's evaluation's elements's values)

# The cut polygons of wall `wallId` in `viewValue`, summed up: their count,
# their total area, and the lowest and highest y (up, in a section) among
# their corners, as the list [count, area, lowest, highest].
function the layer height cut of wall {a 64 bit integer:wallId} in {bim view record:viewValue}:
    execute:
        set summary to an empty list of a 64 bit floating-point number
        set count to 0
        set total to 0.0
        set lowest to 1.0 / 0.0
        set highest to 0.0 - (1.0 / 0.0)
        loop sourceCursor from 0 to the length of (viewValue's sources's values):
            set sourcePolygons to (the item at sourceCursor in (viewValue's sources's values))'s polygons's values
            loop cursor from 0 to the length of sourcePolygons:
                set polygon to the item at cursor in sourcePolygons
                if polygon's elementId = wallId:
                    set count to count + 1
                    set total to total + (the absolute value of (the bim area of polygon))
                    loop corner from 0 to the length of (polygon's points's values):
                        set spot to the item at corner in (polygon's points's values)
                        set lowest to the minimum of lowest and spot's y
                        set highest to the maximum of highest and spot's y
        append (count as a 64 bit floating-point number) to summary
        append total to summary
        append lowest to summary
        append highest to summary
        return summary

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set host to add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
ignore add bim opening typed (editor's doorTypeId) in host at 2.0 to target
ignore add bim opening typed (editor's windowTypeId) in host at 4.5 to target
commit bim transaction in (the address of (editor's documentValue))
refresh bim editor e
# The rough openings, cut through every layer: the door 1.0 by 2.15 on the
# foot, the window 1.3 by 1.55 with its head at 2.45.
set doorFound to the bim opening type index of (editor's doorTypeId) in editor's documentValue's current
set doorType to the item at doorFound's position in (editor's documentValue's current's openingTypes's values)
set windowFound to the bim opening type index of (editor's windowTypeId) in editor's documentValue's current
set windowType to the item at windowFound's position in (editor's documentValue's current's openingTypes's values)
set openingArea to ((the bim rough width of doorType) * (the bim rough height of doorType)) + ((the bim rough width of windowType) * (the bim rough height of windowType))

# The cavity wall type: brick 0.1, insulation 0.12, concrete 0.1, on a
# storey 3.0 m high.
check layer height ((bim wall host has layers of their own height in editor's documentValue's current) = false) named (the string form of "a new wall's layers run its height")
begin bim transaction in (the address of (editor's documentValue))
check layer height (set bim wall host layer 0 foot to 0.3 and top to 0.5 in target) named (the string form of "the outer leaf reaches 0.3 below the foot and 0.5 above the top")
check layer height ((set bim wall host layer 3 foot to 0.1 and top to 0.0 in target) = false) named (the string form of "a layer the type has not is refused")
check layer height ((set bim wall host layer 2 foot to (0.0 - 2.0) and top to (0.0 - 1.5) in target) = false) named (the string form of "a layer left no height is refused")
commit bim transaction in (the address of (editor's documentValue))
set outerReach to the bim layer reach of layer 0 of wall host in editor's documentValue's current
set innerReach to the bim layer reach of layer 2 of wall host in editor's documentValue's current
check layer height ((((layer height measure (outerReach's x) is 0.3) and (layer height measure (outerReach's y) is 0.5)) and (layer height measure (innerReach's x) is 0.0)) and (layer height measure (innerReach's y) is 0.0)) named (the string form of "the reach reads back to the millimetre")
check layer height (bim wall host has layers of their own height in editor's documentValue's current) named (the string form of "the wall has layers of their own height")

# The layer solids: the outer leaf 3.8 m high, the others 3.0 m, every one
# closed; the wall's own solid is the three in one polyhedron.
refresh bim editor e
set layerSolids to the layer height solids of wall host in e
check layer height ((the length of (layerSolids's values)) = 3) named (the string form of "three layer solids")
check layer height (layer height solids of wall host are closed in e) named (the string form of "every layer is a closed polyhedron")
set outerVolume to the layer height volume 0 of wall host in e
set middleVolume to the layer height volume 1 of wall host in e
set innerVolume to the layer height volume 2 of wall host in e
check layer height (layer height measure outerVolume is (0.1 * ((6.0 * 3.8) - openingArea))) named (the string form of "the outer leaf's solid is 3.8 m high with its openings")
check layer height ((layer height measure middleVolume is (0.12 * ((6.0 * 3.0) - openingArea))) and (layer height measure innerVolume is (0.1 * ((6.0 * 3.0) - openingArea)))) named (the string form of "the other layers keep the wall's height")
set layeredGeometry to the layer height geometry of wall host in e
check layer height (layeredGeometry's fast and (layer height measure (the bim volume of layeredGeometry) is ((outerVolume + middleVolume) + innerVolume))) named (the string form of "the wall's solid is its layers in one polyhedron")
check layer height ((the fast flaw of layeredGeometry's shape within 1e-9) = 0) named (the string form of "the shells make a closed polyhedron")

# A section across the wall at x = 1.0 and plans through, above and below
# the storey.
set sectionCut to the layer height cut of wall host in (the bim section of (editor's evaluation) from (a cad vector2 with x 1.0 and y (0.0 - 1.0)) to (a cad vector2 with x 1.0 and y 1.0))
check layer height (((the item at 0 in sectionCut) = 3.0) and (layer height measure (the item at 1 in sectionCut) is ((0.1 * 3.8) + ((0.12 * 3.0) + (0.1 * 3.0))))) named (the string form of "a section meets the three layers, the outer one 3.8 m high")
check layer height ((layer height measure (the item at 2 in sectionCut) is (0.0 - 0.3)) and (layer height measure (the item at 3 in sectionCut) is 3.5)) named (the string form of "the outer leaf stands from 0.3 below the foot to 0.5 above the top")
set throughCut to the layer height cut of wall host in (the bim plan of (editor's evaluation) at 0.0 cut at 2.9)
check layer height (((the item at 0 in throughCut) = 3.0) and (layer height measure (the item at 1 in throughCut) is (0.32 * 6.0))) named (the string form of "a plan through the storey meets three layers")
set aboveCut to the layer height cut of wall host in (the bim plan of (editor's evaluation) at 0.0 cut at 3.2)
check layer height (((the item at 0 in aboveCut) = 1.0) and (layer height measure (the item at 1 in aboveCut) is (0.1 * 6.0))) named (the string form of "a plan above the storey meets the outer leaf alone")
set belowCut to the layer height cut of wall host in (the bim plan of (editor's evaluation) at 0.0 cut at (0.0 - 0.1))
check layer height (((the item at 0 in belowCut) = 1.0) and (layer height measure (the item at 1 in belowCut) is (0.1 * 6.0))) named (the string form of "a plan below the storey meets the outer leaf alone")

# The properties window: the reaches as rows, one typed, one undo.
select bim editor bim wall picked numbered host in e
check layer height ((((the layer height row value of (the string form of "Layer 1 foot +/-") in e) = (the string form of "0.30 m")) and ((the layer height row value of (the string form of "Layer 1 top +/-") in e) = (the string form of "0.50 m"))) and ((the layer height row value of (the string form of "Layer 3 top +/-") in e) = (the string form of "0.00 m"))) named (the string form of "the window shows the layers' feet and tops")
start bim editor property (the layer height row code of (the string form of "Layer 3 top +/-") in e) in e
type layer height keys (the string form of "-0.4") in e
check layer height (editor's message = (the string form of "Property changed")) named (the string form of "a typed top is taken")
set typedReach to the bim layer reach of layer 2 of wall host in editor's documentValue's current
check layer height ((layer height measure (typedReach's x) is 0.0) and (layer height measure (typedReach's y) is (0.0 - 0.4))) named (the string form of "typing a top stops the inner leaf 0.4 m short")
refresh bim editor e
check layer height (layer height measure (the layer height volume 2 of wall host in e) is (0.1 * ((6.0 * 2.6) - openingArea))) named (the string form of "the inner leaf's solid is 2.6 m high")
check layer height (undo bim transaction in (the address of (editor's documentValue))) named (the string form of "undo takes the typed top back")
set undoneReach to the bim layer reach of layer 2 of wall host in editor's documentValue's current
check layer height ((layer height measure (undoneReach's x) is 0.0) and (layer height measure (undoneReach's y) is 0.0)) named (the string form of "the inner leaf runs the wall's height again")

# The masonry on the outer leaf stands on the leaf's own foot and height.
begin bim transaction in (the address of (editor's documentValue))
ignore give bim wall host masonry module (2100 as a 64 bit integer) on layer 0 from finish false offset (0 as a 64 bit integer) in target
commit bim transaction in (the address of (editor's documentValue))
set hostFound to the bim wall index of host in editor's documentValue's current
set masonryValue to the bim masonry of wall (the item at hostFound's position in (editor's documentValue's current's walls's values)) in editor's documentValue's current
check layer height (((masonryValue's status = (bim masonry measured)) and (layer height measure (masonryValue's foot) is (0.0 - 0.3))) and (layer height measure (masonryValue's height) is 3.8)) named (the string form of "the masonry follows its layer's foot and top")

# IFC: the wall goes out as its layers, triangulated.
set layeredIfc to the bim ifc text of editor's documentValue's current
check layer height (layeredIfc contains "IFCTRIANGULATEDFACESET") named (the string form of "the IFC body of the wall is a triangulated face set")

# 0 and 0: the wall is built whole again, and goes out as an extrusion.
begin bim transaction in (the address of (editor's documentValue))
check layer height (set bim wall host layer 0 foot to 0.0 and top to 0.0 in target) named (the string form of "0 and 0 make the outer leaf run the wall's height again")
commit bim transaction in (the address of (editor's documentValue))
check layer height ((bim wall host has layers of their own height in editor's documentValue's current) = false) named (the string form of "the wall has no layers of their own height")
refresh bim editor e
set wholeGeometry to the layer height geometry of wall host in e
check layer height (layer height measure (the bim volume of wholeGeometry) is (0.32 * ((6.0 * 3.0) - openingArea))) named (the string form of "the wall is built whole again")
set wholeIfc to the bim ifc text of editor's documentValue's current
check layer height ((wholeIfc contains "IFCTRIANGULATEDFACESET") = false) named (the string form of "a wall built whole goes out as an extrusion")
