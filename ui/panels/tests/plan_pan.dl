# SPDX-License-Identifier: MPL-2.0
# The plan kept on the GPU while it is panned. It is drawn shifted by
# parameters 37 and 38, and the 3D view's hidden line light model, set later
# in the same frame, has a parameter of its own; sharing 37 kept the plan
# where it was recorded while it was panned across with the 3D view beside
# it. The recording's key changes with the window's size (its batches keep
# the size they were recorded at), not with the pan.
import viewer/bim_canvas.dl

set shiftAcross to the bim gpu canvas shift parameter
set lightFlag to the bim gpu light model parameter
print ((the string form of "shift: ") + ((the string form of shiftAcross) + ((the string form of " ") + (the string form of (shiftAcross + 1))))) as a line
print ((the string form of "light model: ") + (the string form of lightFlag)) as a line
print ((the string form of "light model apart from the shift: ") + (the string form of ((lightFlag != shiftAcross) and (lightFlag != (shiftAcross + 1))))) as a line
set shownKey to the string form of "12 3 7 50 vvv import 0"
set recorded to the bim gpu plan key of shownKey sized 1600 by 900
print recorded as a line
print ((the string form of "panned, same size: kept ") + (the string form of (recorded = (the bim gpu plan key of shownKey sized 1600 by 900)))) as a line
print ((the string form of "resized: recorded again ") + (the string form of (recorded != (the bim gpu plan key of shownKey sized 1920 by 1080)))) as a line
print ((the string form of "rotated size: recorded again ") + (the string form of (recorded != (the bim gpu plan key of shownKey sized 900 by 1600)))) as a line
