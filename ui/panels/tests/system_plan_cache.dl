# SPDX-License-Identifier: MPL-2.0
# Compare the retained model-space outline path to fresh part generation.
import ui/panels/bim_plan_panel.dl
import pattern/common/bim_system_types.dl

function require system plan cache {boolean:ok} named {a string:caption}:
    execute:
        if ok = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function system plan canvas {bim canvas record:firstCanvas} equals {bim canvas record:secondCanvas}:
    execute:
        if (the length of (firstCanvas's batches's values)) != (the length of (secondCanvas's batches's values)):
            return false
        loop batchCursor from 0 to the length of (firstCanvas's batches's values):
            set firstBatch to the item at batchCursor in (firstCanvas's batches's values)
            set secondBatch to the item at batchCursor in (secondCanvas's batches's values)
            if ((firstBatch's red != secondBatch's red) or (firstBatch's green != secondBatch's green)) or (firstBatch's blue != secondBatch's blue):
                return false
            if (the length of (firstBatch's pixels's values)) != (the length of (secondBatch's pixels's values)):
                return false
            loop pixelCursor from 0 to the length of (firstBatch's pixels's values):
                set firstPixel to the item at pixelCursor in (firstBatch's pixels's values)
                set secondPixel to the item at pixelCursor in (secondBatch's pixels's values)
                if ((the absolute value of (firstPixel's x - secondPixel's x)) > 1e-9) or ((the absolute value of (firstPixel's y - secondPixel's y)) > 1e-9):
                    return false
        return true

# The previous curtain path, independent of the new cache and cache key.
function the fresh system plan canvas of {bim editor record:editor} through {bim drawing transform record:transform}:
    execute:
        set drawnCanvas to a new bim canvas
        set solid to an empty list of a cad vector2
        set dashed to an empty list of a cad vector2
        set modelValue to editor's documentValue's current
        set cutHeight to (the bim storey elevation of editor) + (the bim plan cut height of editor)
        loop cursor from 0 to the length of (modelValue's curtains's values):
            set systemValue to the item at cursor in (modelValue's curtains's values)
            if (the bim placed system systemValue in modelValue)'s curtain's levelId = editor's levelId:
                set detail to bim window detail (the string form of "Glazing bead") is resolved at transform's scale
                set parts to the bim parts of curtain wall systemValue in modelValue with glazing detail detail
                append bim plan edges of parts (parts's values) in modelValue cut at cutHeight through transform into solid and dashed
        record bim strokes solid coloured 0, 0 and 0 wide 0.7 on (the address of drawnCanvas)
        record bim strokes dashed coloured 0, 0 and 0 wide 0.7 on (the address of drawnCanvas)
        free solid
        free dashed
        return drawnCanvas

function the retained system plan canvas of {bim editor record:editor} through {bim drawing transform record:transform} keeping {a pointer to a bim curtain plan cache record:cache}:
    execute:
        set drawnCanvas to a new bim canvas
        draw bim stairs in plan of editor through transform on (the address of drawnCanvas) keeping cache
        return drawnCanvas

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set levelId to add bim level named (the string form of "Cache level") at 0.0 with height 3.0 to target
set planViewId to add bim view of kind (bim plan view kind) named (the string form of "Cache plan") on levelId to target
set otherLevel to add bim level named (the string form of "Empty level") at 3.0 with height 3.0 to target
set systemId to add bim curtain wall on levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 3.0 and y 0.0) rising 3.0 in bays of 1.0 by 1.5 of (the string form of "steel") to target
ignore give bim system systemId type 3 in target
ignore set bim curtain wall systemId bulge to 0.3 in target
commit bim transaction in (the address of (editor's documentValue))
set editor's levelId to levelId
set editor's planViewId to planViewId
refresh bim editor (the address of editor)
set undoCount to the length of (editor's documentValue's undoStack's values)
set cache to an empty bim curtain plan cache
set transform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 200.0 and y 350.0), (a cad vector2 with x 1.0 and y 0.0), 80.0)
set original to the fresh system plan canvas of editor through transform
set retained to the retained system plan canvas of editor through transform keeping (the address of cache)
require system plan cache (system plan canvas retained equals original) named (the string form of "cold cache matches fresh curved system outlines exactly")
set transform's scale to 120.0
set transform's centre to a cad vector2 with x 400.0 and y 450.0
set retained to the retained system plan canvas of editor through transform keeping (the address of cache)
require system plan cache ((cache's builds = 1) and (system plan canvas retained equals (the fresh system plan canvas of editor through transform))) named (the string form of "zoom and pan reuse outlines with exact pixel strokes and dashes")
set transform's scale to 500.0
set retained to the retained system plan canvas of editor through transform keeping (the address of cache)
require system plan cache ((cache's builds = 2) and (system plan canvas retained equals (the fresh system plan canvas of editor through transform))) named (the string form of "glazing detail threshold rebuilds with exact closeup output")
set transform's scale to 80.0
set transform's centre to a cad vector2 with x 200.0 and y 350.0
set retained to the retained system plan canvas of editor through transform keeping (the address of cache)
require system plan cache ((cache's builds = 3) and (system plan canvas retained equals original)) named (the string form of "zooming out restores original overview detail")
require system plan cache ((the length of (editor's documentValue's undoStack's values)) = undoCount) named (the string form of "view cache adds no undo transaction")
begin bim transaction in (the address of (editor's documentValue))
ignore set bim curtain wall systemId bulge to 0.0 in (the address of (editor's documentValue's current))
commit bim transaction in (the address of (editor's documentValue))
refresh bim editor (the address of editor)
set retained to the retained system plan canvas of editor through transform keeping (the address of cache)
require system plan cache ((cache's builds = 4) and (system plan canvas retained equals (the fresh system plan canvas of editor through transform))) named (the string form of "model commit invalidates cached geometry")
ignore undo bim transaction in (the address of (editor's documentValue))
refresh bim editor (the address of editor)
set retained to the retained system plan canvas of editor through transform keeping (the address of cache)
require system plan cache ((cache's builds = 5) and (system plan canvas retained equals original)) named (the string form of "undo restores the original contour without stale outlines")
set editor's levelId to otherLevel
refresh bim editor (the address of editor)
set retained to the retained system plan canvas of editor through transform keeping (the address of cache)
require system plan cache ((cache's builds = 6) and ((the length of (cache's outlines's values)) = 0)) named (the string form of "storey change discards outlines from the previous level")

# Use real committed view/level edits, rather than a manufactured cache key.
set editor's levelId to levelId
refresh bim editor (the address of editor)
set beforeCut to the retained system plan canvas of editor through transform keeping (the address of cache)
set beforeCutBuilds to cache's builds
begin bim transaction in (the address of (editor's documentValue))
set viewFound to the bim view index of planViewId in editor's documentValue's current
set planView to the item at viewFound's position in (editor's documentValue's current's views's values)
set planView's cutHeight to 4.0
store bim view planView in (the address of (editor's documentValue's current))
commit bim transaction in (the address of (editor's documentValue))
refresh bim editor (the address of editor)
set retained to the retained system plan canvas of editor through transform keeping (the address of cache)
require system plan cache (((cache's builds = (beforeCutBuilds + 1)) and (system plan canvas retained equals (the fresh system plan canvas of editor through transform))) and ((system plan canvas retained equals beforeCut) = false)) named (the string form of "committed cut height invalidates outlines and updates solid versus dashed output")
set beforeLiftBuilds to cache's builds
begin bim transaction in (the address of (editor's documentValue))
ignore set bim level levelId at 5.0 with height 3.0 in (the address of (editor's documentValue's current))
commit bim transaction in (the address of (editor's documentValue))
refresh bim editor (the address of editor)
set retained to the retained system plan canvas of editor through transform keeping (the address of cache)
require system plan cache (((cache's builds = (beforeLiftBuilds + 1)) and ((the bim storey elevation of editor) = 5.0)) and (system plan canvas retained equals (the fresh system plan canvas of editor through transform))) named (the string form of "committed active storey elevation invalidates cached world heights")
