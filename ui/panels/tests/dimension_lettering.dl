# SPDX-License-Identifier: MPL-2.0
# Dimension values lettered on paper without collisions (drawing quality
# plan, item 14). An 8 x 10 m box of 300 mm walls whose west facade has two
# 100 mm inner walls meeting it 300 mm apart and a window across them
# (1200 mm with its frame), so that its openings chain (8 mm off the face) and its walls chain
# (14 mm) have short segments side by side: the walls chain's 100, 200 and
# 100 (1, 2 and 1 mm at 1:100) must stand outside their segments, and on
# the west facade, whose values read bottom to top with the reading side
# outward, the old stagger to the other side put them on the openings
# chain's values. Drawn on paper at 1:100 and 1:50: no value's box overlaps
# another's, none crosses a dimension or extension line; then again with a
# room label and an elevation mark where values stood, which they leave.
# Last, three chains of short adjacent segments (240, 895, 2100, 240, 1460
# at 1:100) lettered directly: values keep a millimetre clear along their
# lines, never stand stacked, and never nearer another chain's line.
# Values are measured from the glyphs: the wider of osifont and Helvetica.
import ui/panels/bim_plan_panel.dl

function check dimension lettering {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# `amount` to hundredths, as "18.75".
function the lettering test text of {a 64 bit floating-point number:amount}:
    execute:
        set hundredths to (the floor of (((the absolute value of amount) * 100.0) + 0.5)) as a 64 bit integer
        set sign to the string form of ""
        if (amount < 0.0) and (hundredths > (0 as a 64 bit integer)):
            set sign to the string form of "-"
        set fraction to the string form of (the remainder of hundredths divided by (100 as a 64 bit integer))
        if (the length of fraction) < 2:
            set fraction to (the string form of "0") + fraction
        return ((sign + (the string form of (hundredths / (100 as a 64 bit integer)))) + (the string form of ".")) + fraction

function the lettering test transform at {a 64 bit floating-point number:denominator}:
    execute:
        return @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 1000.0 / denominator)

# The plan's dimensions drawn on `sheet` (a canvas unit a millimetre)
# through plan view `viewId` at 1:`denominator`, the model origin at the
# paper origin; the index of the first value lettered.
function draw lettering test dimensions of {bim editor record:editor} through view {a 64 bit integer:viewId} at {a 64 bit floating-point number:denominator} on {a pointer to a bim canvas record:sheet}:
    execute:
        set shown to editor
        set shown's planViewId to viewId
        set firstValue to the length of (sheet's texts's values)
        draw bim dimensions in plan of shown through (the lettering test transform at denominator) on sheet
        return firstValue

# The dimension and extension lines of the plan's dimensions on paper at
# 1:`denominator`, as stroke pairs, drawn as the plan draws them.
function the lettering test strokes of {bim editor record:editor} at {a 64 bit floating-point number:denominator}:
    execute:
        set modelValue to editor's documentValue's current
        set index to the bim join index of modelValue
        set lines to an empty list of a cad vector2
        set ticks to an empty list of a cad vector2
        loop cursor from 0 to the length of (modelValue's dimensions's values):
            set shape to the bim dimension line of (the item at cursor in (modelValue's dimensions's values)) in modelValue using index at drawing scale denominator
            if shape's valid:
                append bim dimension shape shape through (the lettering test transform at denominator) into lines and ticks under (the bim drawing standard of modelValue) scaled 0.25
        free ticks
        return lines

# How many pairs of values from `firstValue` on overlap, how many of them
# cross a line of `strokes`, and how many overlap a box of `others`.
function the lettering test collisions on {bim canvas record:sheet} from {integer:firstValue} with {a pointer to a list:strokes} and {a pointer to a list:others}:
    execute:
        set clashCount to 0
        set valueCount to the length of (sheet's texts's values)
        loop cursor from firstValue to valueCount:
            set placedBox to the bim lettering box of (the item at cursor in (sheet's texts's values)) on sheet
            loop otherCursor from (cursor + 1) to valueCount:
                if bim lettering box placedBox overlaps (the bim lettering box of (the item at otherCursor in (sheet's texts's values)) on sheet):
                    print ((the string form of "  overlap: ") + (((the item at cursor in (sheet's texts's values))'s message + (the string form of " and ")) + (the item at otherCursor in (sheet's texts's values))'s message)) as a line
                    set clashCount to clashCount + 1
            loop pairCursor from 0 to ((the length of strokes) / 2):
                if bim lettering box placedBox meets the segment from (the item at (pairCursor * 2) in strokes) to (the item at ((pairCursor * 2) + 1) in strokes):
                    print ((the string form of "  crossed by a line: ") + (the item at cursor in (sheet's texts's values))'s message) as a line
                    set clashCount to clashCount + 1
            loop boxCursor from 0 to the length of others:
                if bim lettering box placedBox overlaps (the item at boxCursor in others):
                    print ((the string form of "  over a label or mark: ") + (the item at cursor in (sheet's texts's values))'s message) as a line
                    set clashCount to clashCount + 1
        return clashCount

# The values west of the plan (paper x below -5 mm), in the order drawn,
# with where their baselines' middles stand.
function show lettering test west values of {bim canvas record:sheet} from {integer:firstValue} titled {a string:title}:
    execute:
        print title as a line
        loop cursor from firstValue to the length of (sheet's texts's values):
            set shownValue to the item at cursor in (sheet's texts's values)
            if shownValue's x < -5.0:
                print ((((the string form of "  ") + shownValue's message) + (the string form of " at ")) + (((the lettering test text of shownValue's x) + (the string form of ", ")) + (the lettering test text of shownValue's y))) as a line

# The axis-aligned reach of `placedBox` from its centre: x, then y.
function the lettering test reach of {bim lettering box record:placedBox}:
    execute:
        set cosPart to the absolute value of (the cosine of placedBox's angle)
        set sinPart to the absolute value of (the sine of placedBox's angle)
        return a cad vector2 with x ((cosPart * placedBox's halfAlong) + (sinPart * placedBox's halfAcross)) and y ((sinPart * placedBox's halfAlong) + (cosPart * placedBox's halfAcross))

# Appends a west facade dimension from paper y `fromY` to `toY` (north is
# up: y falls) on the line at paper x `lineX`, its value `message`, to
# `pending`, and its line and two extension lines (from 1.5 mm off the face
# at x 0 to 2 mm past the line) to `strokes`.
function append lettering test segment {a string:message} from {a 64 bit floating-point number:fromY} to {a 64 bit floating-point number:toY} at {a 64 bit floating-point number:lineX} into {a pointer to a list:pending} and {a pointer to a list:strokes}:
    execute:
        set lineStart to a cad vector2 with x lineX and y fromY
        set lineEnd to a cad vector2 with x lineX and y toY
        append (a bim dimension value message between lineStart and lineEnd outward (a cad vector2 with x -1.0 and y 0.0)) to pending
        append lineStart to strokes
        append lineEnd to strokes
        append (a cad vector2 with x -1.5 and y fromY) to strokes
        append (a cad vector2 with x (lineX - 2.0) and y fromY) to strokes
        append (a cad vector2 with x -1.5 and y toY) to strokes
        append (a cad vector2 with x (lineX - 2.0) and y toY) to strokes

# The paper x of the dimension line value `message` belongs to in the short
# chains test: the openings chain (-9.5), the walls chain (-15.5) or the
# overall one (-21.5).
function the lettering test line of {a string:message}:
    execute:
        if (message = (the string form of "3410")) or (message = (the string form of "1525")):
            return -15.5
        if message = (the string form of "4935"):
            return -21.5
        return -9.5

# The first label lettered `message` from `firstValue` on.
function the lettering test value {a string:message} on {bim canvas record:sheet} from {integer:firstValue}:
    execute:
        set found to the item at firstValue in (sheet's texts's values)
        loop cursor from firstValue to the length of (sheet's texts's values):
            if (the item at cursor in (sheet's texts's values))'s message = message:
                set found to the item at cursor in (sheet's texts's values)
        return found

# Glyph widths: "4030" in osifont (513 + 468 + 480 + 468 thousandths of
# an em) and in Helvetica (four times 556); a layout takes the wider.
print ((the string form of "4030 in osifont, Helvetica, widest (em): ") + (((the lettering test text of (the bim lettering width of (the string form of "4030") in face (bim osifont lettering))) + (the string form of ", ")) + (((the lettering test text of (the bim lettering width of (the string form of "4030") in face (bim helvetica lettering))) + (the string form of ", ")) + (the lettering test text of (the bim lettering width of (the string form of "4030") in face (bim widest lettering)))))) as a line
check dimension lettering ((the absolute value of ((the bim lettering width of (the string form of "4030") in face (bim widest lettering)) - 2.224)) < 1e-9) named (the string form of "a value is as wide as its glyphs in the wider face")
check dimension lettering ((the bim lettering depth of (the string form of "4030")) = 0.0) named (the string form of "digits reach nothing below the baseline")

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.3)) to layers
set outerType to add bim wall type named (the string form of "Outer 300") with layers to target
free layers
set innerLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.1)) to innerLayers
set innerType to add bim wall type named (the string form of "Inner 100") with innerLayers to target
free innerLayers
set westWall to add bim wall typed outerType on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 10.0) to target
ignore add bim wall typed outerType on editor's levelId from (a cad vector2 with x 0.0 and y 10.0) to (a cad vector2 with x 8.0 and y 10.0) to target
ignore add bim wall typed outerType on editor's levelId from (a cad vector2 with x 8.0 and y 10.0) to (a cad vector2 with x 8.0 and y 0.0) to target
ignore add bim wall typed outerType on editor's levelId from (a cad vector2 with x 8.0 and y 0.0) to (a cad vector2 with x 0.0 and y 0.0) to target
ignore add bim wall typed innerType on editor's levelId from (a cad vector2 with x 0.0 and y 5.0) to (a cad vector2 with x 4.0 and y 5.0) to target
ignore add bim wall typed innerType on editor's levelId from (a cad vector2 with x 0.0 and y 5.3) to (a cad vector2 with x 4.0 and y 5.3) to target
set windowType to add bim opening type named (the string form of "Window 1100") sized 1.1 by 1.5 with sill 0.9 and frame 0.05 to target
ignore add bim opening typed windowType in westWall at 5.15 to target
set hundredView to add bim view of kind (bim plan view) named (the string form of "Plan 1:100") on editor's levelId to target
set fiftyView to add bim view of kind (bim plan view) named (the string form of "Plan 1:50") on editor's levelId to target
ignore set bim view hundredView scale to 100 and display to 0 in target
ignore set bim view fiftyView scale to 50 and display to 0 in target
commit bim transaction in (the address of (editor's documentValue))
type bim editor key 2461 in e
print editor's message as a line

set noBoxes to an empty list of a bim lettering box record
set hundredStrokes to the lettering test strokes of editor at 100.0
set fiftyStrokes to the lettering test strokes of editor at 50.0

# At 1:100 on an empty sheet.
set hundredSheet to a new bim canvas
set hundredSheet's paperScale to 1.0
set hundredFirst to draw lettering test dimensions of editor through view hundredView at 100.0 on (the address of hundredSheet)
show lettering test west values of hundredSheet from hundredFirst titled (the string form of "west values at 1:100 (x, y on paper):")
set hundredCollisions to the lettering test collisions on hundredSheet from hundredFirst with hundredStrokes and noBoxes
check dimension lettering (hundredCollisions = 0) named (the string form of "at 1:100 no value overlaps another or crosses a dimension or extension line")

# The walls chain's short steps on the west facade (100, 200 and 100 at
# paper y -49.5 to -53.5) stand outside their segments, and no value of the
# walls chain (5100, 100, 200, 100, 4800) inward of its line (paper x
# -15.5) beside a value of the openings chain (4400, 4700, 1200), less than
# a millimetre from it along the line (one moved in on a leader stands
# clear of them). Every west value reads bottom
# to top: a line a rounding error off vertical read top to bottom, its
# value on the inner side.
set shortOutside to 0
set wallsInward to 0
set upsideDown to 0
loop cursor from hundredFirst to the length of (hundredSheet's texts's values):
    set stepValue to the item at cursor in (hundredSheet's texts's values)
    set shortStep to (stepValue's message = (the string form of "100")) or (stepValue's message = (the string form of "200"))
    set wallsStep to shortStep or ((stepValue's message = (the string form of "5100")) or (stepValue's message = (the string form of "4800")))
    if (stepValue's x < -5.0) and shortStep:
        if (stepValue's y > -49.5) or (stepValue's y < -53.5):
            set shortOutside to shortOutside + 1
    if (stepValue's x < -5.0) and wallsStep:
        if stepValue's x > -15.5:
            set stepBox to the bim lettering box of stepValue on hundredSheet
            loop openingsCursor from hundredFirst to the length of (hundredSheet's texts's values):
                set openingsValue to the item at openingsCursor in (hundredSheet's texts's values)
                set openingsStep to (openingsValue's message = (the string form of "4400")) or ((openingsValue's message = (the string form of "4700")) or (openingsValue's message = (the string form of "1200")))
                if openingsStep and (openingsValue's x < -5.0):
                    set openingsBox to the bim lettering box of openingsValue on hundredSheet
                    if ((the absolute value of (stepBox's centre's y - openingsBox's centre's y)) - ((the lettering test reach of stepBox)'s y + (the lettering test reach of openingsBox)'s y)) < 0.999:
                        print ((the string form of "  walls value beside an openings value: ") + stepValue's message) as a line
                        set wallsInward to wallsInward + 1
    if stepValue's x < -5.0:
        if (the absolute value of (stepValue's angle + 1.5707963267948966)) > 1e-9:
            set upsideDown to upsideDown + 1
check dimension lettering (shortOutside = 3) named (the string form of "the walls chain's short steps have their values beside them")
check dimension lettering (wallsInward = 0) named (the string form of "no value of the walls chain stands beside the openings chain's values")
check dimension lettering (upsideDown = 0) named (the string form of "every west value reads bottom to top")

# At 1:50, where more values fit their segments.
set fiftySheet to a new bim canvas
set fiftySheet's paperScale to 1.0
set fiftyFirst to draw lettering test dimensions of editor through view fiftyView at 50.0 on (the address of fiftySheet)
show lettering test west values of fiftySheet from fiftyFirst titled (the string form of "west values at 1:50 (x, y on paper):")
check dimension lettering ((the lettering test collisions on fiftySheet from fiftyFirst with fiftyStrokes and noBoxes) = 0) named (the string form of "at 1:50 no value overlaps another or crosses a line")

# Again at 1:100 with a room label over the openings chain's 1200 (the
# window with its frame) and an elevation mark's ring kept clear over its
# 4400, where they stood.
set windowValue to the lettering test value (the string form of "1200") on hundredSheet from hundredFirst
set northValue to the lettering test value (the string form of "4400") on hundredSheet from hundredFirst
check dimension lettering ((windowValue's message = (the string form of "1200")) and (northValue's message = (the string form of "4400"))) named (the string form of "the window's value and the one north of it are found")
set crowdedSheet to a new bim canvas
set crowdedSheet's paperScale to 1.0
record bim text (the string form of "Kitchen") at (windowValue's x - 1.0) and (windowValue's y + 3.0) coloured 0, 0 and 0 on (the address of crowdedSheet)
set markBox to a bim lettering box around (a cad vector2 with x (northValue's x - 1.0) and y northValue's y) turned 0.0 reaching 2.5 by 2.5
keep bim lettering out of markBox on (the address of crowdedSheet)
set obstacleBoxes to an empty list of a bim lettering box record
append (the bim lettering box of (the item at 0 in (crowdedSheet's texts's values)) on crowdedSheet) to obstacleBoxes
append markBox to obstacleBoxes
set crowdedFirst to draw lettering test dimensions of editor through view hundredView at 100.0 on (the address of crowdedSheet)
show lettering test west values of crowdedSheet from crowdedFirst titled (the string form of "west values at 1:100 beside a room label and an elevation mark:")
check dimension lettering ((the lettering test collisions on crowdedSheet from crowdedFirst with hundredStrokes and obstacleBoxes) = 0) named (the string form of "values keep clear of a room label and an elevation mark")
set movedWindow to the lettering test value (the string form of "1200") on crowdedSheet from crowdedFirst
set movedNorth to the lettering test value (the string form of "4400") on crowdedSheet from crowdedFirst
check dimension lettering (((movedWindow's x != windowValue's x) or (movedWindow's y != windowValue's y)) and ((movedNorth's x != northValue's x) or (movedNorth's y != northValue's y))) named (the string form of "the values under the label and the mark moved")

# Short adjacent segments at 1:100 on a west facade: an openings chain of
# 240, 895, 2100, 240 and 1460 (2.4 to 21 mm on paper) 8 mm off the face, a
# walls chain of 3410 and 1525 at 14 mm and the overall 4935 at 20 mm.
# Every two values keep a millimetre clear along their lines and, where
# they overlap along, two millimetres across: none reads as one number with
# its neighbour, beside it ('895 2100') or stacked over it ('240' over
# '1460'). A value without a leader stands at least a millimetre nearer its
# own line than any other chain's line it lies beside; one that cannot is
# on a leader.
set shortSheet to a new bim canvas
set shortSheet's paperScale to 1.0
set shortValues to an empty list of a bim dimension value record
set shortStrokes to an empty list of a cad vector2
append lettering test segment (the string form of "240") from 0.0 to -2.4 at -9.5 into shortValues and shortStrokes
append lettering test segment (the string form of "895") from -2.4 to -11.35 at -9.5 into shortValues and shortStrokes
append lettering test segment (the string form of "2100") from -11.35 to -32.35 at -9.5 into shortValues and shortStrokes
append lettering test segment (the string form of "240") from -32.35 to -34.75 at -9.5 into shortValues and shortStrokes
append lettering test segment (the string form of "1460") from -34.75 to -49.35 at -9.5 into shortValues and shortStrokes
append lettering test segment (the string form of "3410") from 0.0 to -34.1 at -15.5 into shortValues and shortStrokes
append lettering test segment (the string form of "1525") from -34.1 to -49.35 at -15.5 into shortValues and shortStrokes
append lettering test segment (the string form of "4935") from 0.0 to -49.35 at -21.5 into shortValues and shortStrokes
set shortLines to an empty list of a cad vector2
loop cursor from 0 to the length of shortStrokes:
    append (the item at cursor in shortStrokes) to shortLines
set shortCrowded to letter bim dimension values shortValues among shortStrokes on (the address of shortSheet)
show lettering test west values of shortSheet from 0 titled (the string form of "short segments at 1:100 (x, y on paper):")
check dimension lettering (shortCrowded = 0) named (the string form of "every value of the short segments finds a clear place")
check dimension lettering ((the length of (shortSheet's texts's values)) = 8) named (the string form of "all eight values are lettered")
check dimension lettering ((the lettering test collisions on shortSheet from 0 with shortLines and noBoxes) = 0) named (the string form of "no short segment's value overlaps another or crosses a line")
set leaderCount to ((the length of shortStrokes) - (the length of shortLines)) / 2
print ((the string form of "leaders: ") + (the string form of leaderCount)) as a line
set tightAlong to 0
set stackedPairs to 0
set strayValues to 0
loop cursor from 0 to the length of (shortSheet's texts's values):
    set placedValue to the item at cursor in (shortSheet's texts's values)
    set placedBox to the bim lettering box of placedValue on shortSheet
    set placedReach to the lettering test reach of placedBox
    loop otherCursor from (cursor + 1) to the length of (shortSheet's texts's values):
        set otherValue to the item at otherCursor in (shortSheet's texts's values)
        set otherBox to the bim lettering box of otherValue on shortSheet
        set otherReach to the lettering test reach of otherBox
        # Along the lines is y, across them x.
        set gapAlong to (the absolute value of (placedBox's centre's y - otherBox's centre's y)) - (placedReach's y + otherReach's y)
        set gapAcross to (the absolute value of (placedBox's centre's x - otherBox's centre's x)) - (placedReach's x + otherReach's x)
        if (gapAcross < 0.0) and (gapAlong < 0.999):
            print ((the string form of "  closer than a millimetre along: ") + ((placedValue's message + (the string form of " and ")) + otherValue's message)) as a line
            set tightAlong to tightAlong + 1
        if (gapAlong < 0.999) and ((gapAcross >= 0.0) and (gapAcross < 1.999)):
            print ((the string form of "  stacked: ") + ((placedValue's message + (the string form of " and ")) + otherValue's message)) as a line
            set stackedPairs to stackedPairs + 1
    # Its own line's distance against every other chain's line beside it,
    # unless a leader ends by it.
    set ownLine to the lettering test line of placedValue's message
    set ownGap to (the absolute value of (placedBox's centre's x - ownLine)) - placedReach's x
    set onLeader to false
    loop leaderCursor from 0 to leaderCount:
        set leaderEnd to the item at ((the length of shortLines) + ((leaderCursor * 2) + 1)) in shortStrokes
        if ((the absolute value of (leaderEnd's x - placedBox's centre's x)) <= (placedReach's x + 0.5)) and ((the absolute value of (leaderEnd's y - placedBox's centre's y)) <= (placedReach's y + 0.5)):
            set onLeader to true
    loop lineCursor from 0 to 3:
        set otherLine to -9.5 - (6.0 * (lineCursor as a 64 bit floating-point number))
        if (the absolute value of (otherLine - ownLine)) > 0.001:
            set otherGap to (the absolute value of (placedBox's centre's x - otherLine)) - placedReach's x
            set besideLine to ((placedBox's centre's y + placedReach's y) > -49.35) and ((placedBox's centre's y - placedReach's y) < 0.0)
            if (besideLine and (onLeader = false)) and (otherGap < (ownGap + 0.999)):
                print ((the string form of "  nearer another chain's line: ") + placedValue's message) as a line
                set strayValues to strayValues + 1
check dimension lettering (tightAlong = 0) named (the string form of "values side by side keep a millimetre clear")
check dimension lettering (stackedPairs = 0) named (the string form of "no value stands stacked over another")
check dimension lettering (strayValues = 0) named (the string form of "every value without a leader stands nearer its own line than another chain's")
free shortValues
free shortStrokes
free shortLines

free noBoxes
free obstacleBoxes
free hundredStrokes
free fiftyStrokes
