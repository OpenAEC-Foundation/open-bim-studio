# SPDX-License-Identifier: MPL-2.0
# Camera-only reuse must preserve exact geometry and keep curved profiles adaptive.
import ui/panels/bim_view_panel.dl
import pattern/facade/scene.dl

function require zoom cache {boolean:ok} named {a string:caption}:
    execute:
        if ok = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground") at 0.0 with height 3.0 to target
set plainId to add bim curtain wall on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 3.0 and y 0.0) rising 3.0 in bays of 1.0 by 1.5 of (the string form of "steel") to target
set curvedId to add bim curtain wall on ground from (a cad vector2 with x 5.0 and y 0.0) to (a cad vector2 with x 8.0 and y 0.0) rising 3.0 in bays of 1.0 by 1.5 of (the string form of "steel") to target
ignore set bim curtain wall curvedId bulge to 0.5 in target
set fixedIds to the bim zoom fixed system ids of modelValue
require zoom cache ((the length of fixedIds) = 2) named (the string form of "polygonal straight and curved carriers are zoom fixed")
set coarse to the bim sketch meshes of modelValue within 0.02
set fine to the bim sketch meshes of modelValue within 0.0001
require zoom cache (bim scene meshes (coarse's values) repeat (fine's values)) named (the string form of "fixed systems have identical coarse and fine geometry")
set layout to @intrinsic("construct", a bim screen layout record, 1280.0, 900.0, 40.0, 200.0, 180.0, 860.0)
set camera to @intrinsic("construct", a bim camera record, (a cad vector2 with x 4.0 and y 0.0), 50.0, 0.5, 0.6, (a cad vector3 with x 4.0, y 0.0 and z 1.5), 50.0)
set originalQueue to the bim zoom queue of (coarse's values) in layout with camera
set fixedQueue to the bim zoom queue of (coarse's values) in layout with camera keeping fixedIds
require zoom cache (((the length of originalQueue) > 0) and ((the length of fixedQueue) = 0)) named (the string form of "fixed systems bypass zoom work before mesh scanning")
set roundType to add bim linear type named (the string form of "Round frame") as role (bim mullion role) sized 0.08 by 0.08 round true of (the string form of "steel") to target
set bim setting ((bim part type setting) + (bim frame part)) of plainId to roundType keeping true in target
free fixedIds
set fixedIds to the bim zoom fixed system ids of modelValue
require zoom cache (((the length of fixedIds) = 1) and ((the item at 0 in fixedIds) = curvedId)) named (the string form of "a profile edit invalidates fixed classification")
set roundCoarse to the bim sketch meshes of modelValue within 0.02
set roundFine to the bim sketch meshes of modelValue within 0.0001
require zoom cache ((bim scene meshes (roundCoarse's values) repeat (roundFine's values)) = false) named (the string form of "round frames still refine their actual geometry")
set roundQueue to the bim zoom queue of (roundCoarse's values) in layout with camera keeping fixedIds
set onlyRound to (the length of roundQueue) > 0
loop cursor from 0 to the length of roundQueue:
    if (the item at (the item at cursor in roundQueue) in (roundCoarse's values))'s elementId != plainId:
        set onlyRound to false
require zoom cache onlyRound named (the string form of "mixed scene keeps adaptive frames in the zoom queue")
give bim linear type roundType profile (bim ellipse profile) web 0.0 flange 0.0 fillet 0.0 fourth 0.0 series 0 in target
set ellipseFixed to the bim zoom fixed system ids of modelValue
require zoom cache ((the length of ellipseFixed) = 1) named (the string form of "elliptical frames remain adaptive")
set bim setting ((bim part type setting) + (bim frame part)) of plainId to roundType keeping false in target
set editedFixed to the bim zoom fixed system ids of modelValue
require zoom cache ((the length of editedFixed) = 2) named (the string form of "restoring polygonal frames restores camera-only reuse")
