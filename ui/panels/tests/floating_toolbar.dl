# SPDX-License-Identifier: MPL-2.0
# The floating toolbar serves three states (#101): an active creation tool
# shows its draw options (Wall: line, arcs, rectangle, circle, pick lines),
# a sketch its Finish and draw tools (a new floor's also Pick walls and From
# space), a selection its actions. The chosen draw option is lit; with
# nothing to offer the toolbar hides.
import ui/panels/bim_ui.dl

function check floating toolbar {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The toolbar as one line: its title, its buttons (the lit one starred).
function show floating toolbar of {bim editor record:editor}:
    execute:
        set buttons to the bim floating toolbar buttons of editor
        set chosen to the bim floating toolbar choice of editor
        set shown to (the bim floating toolbar title of editor) + (the string form of ":")
        if (the length of buttons) = 0:
            set shown to the string form of "(hidden)"
        loop cursor from 0 to the length of buttons:
            set button to the item at cursor in buttons
            set shown to (shown + (the string form of " ")) + button's label
            if button's command = chosen:
                set shown to shown + (the string form of "*")
        free buttons
        print shown as a line

set editor to a new bim editor
set e to the address of editor
show floating toolbar of editor
check floating toolbar ((the length of (the bim floating toolbar buttons of editor)) = 0) named (the string form of "hidden with no tool and nothing selected")
type bim editor key 87 in e
show floating toolbar of editor
check floating toolbar ((the bim floating toolbar choice of editor) = 87) named (the string form of "Wall shows its draw options, Line chosen")
type bim editor key 2396 in e
show floating toolbar of editor
check floating toolbar ((the bim floating toolbar choice of editor) = 2396) named (the string form of "choosing Rectangle lights it")
type bim editor key 2384 in e
check floating toolbar ((the bim floating toolbar choice of editor) = 2384) named (the string form of "the three-point arc is the same tool")
type bim editor key (bim escape key code) in e
check floating toolbar ((the length of (the bim floating toolbar buttons of editor)) = 0) named (the string form of "Esc closes the tool and the toolbar")
type bim editor key 66 in e
show floating toolbar of editor
check floating toolbar ((the bim floating toolbar choice of editor) = 76) named (the string form of "a new floor's sketch offers its shapes, Line chosen")
type bim editor key 87 in e
check floating toolbar ((the bim floating toolbar choice of editor) = 87) named (the string form of "W in the sketch chooses Pick walls")
type bim editor key 83 in e
show floating toolbar of editor
check floating toolbar ((the bim floating toolbar choice of editor) = 83) named (the string form of "S chooses From space")
