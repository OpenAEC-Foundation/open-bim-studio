# SPDX-License-Identifier: MPL-2.0
# The example house exported as a CAD drawing: the ground floor's plan in
# 2D and the model in 3D, their layers and entities counted, written as DXF
# and DWG into build/tests/ (`exchange/dxf_dwg/tests/verify_dxf_dwg.py`
# reads them back).
import ui/panels/bim_cad_export.dl

function report bim cad drawing {bim cad drawing record:drawing} labelled {a string:label}:
    execute:
        print ((label + (the string form of ": layers")) + (the string form of (the length of (drawing's layers's values)))) as a line
        loop cursor from 0 to the length of (drawing's layers's values):
            set layer to the item at cursor in (drawing's layers's values)
            set polylines to 0
            loop item from 0 to the length of (drawing's polylines's values):
                if ((the item at item in (drawing's polylines's values))'s layer) = cursor:
                    set polylines to polylines + 1
            set texts to 0
            loop item from 0 to the length of (drawing's texts's values):
                if ((the item at item in (drawing's texts's values))'s layer) = cursor:
                    set texts to texts + 1
            set solids to 0
            loop item from 0 to the length of (drawing's solids's values):
                if ((the item at item in (drawing's solids's values))'s layer) = cursor:
                    set solids to solids + 1
            set meshCount to 0
            loop item from 0 to the length of (drawing's meshes's values):
                if ((the item at item in (drawing's meshes's values))'s layer) = cursor:
                    set meshCount to meshCount + 1
            print (((the string form of "  ") + (layer's name)) + ((((the string form of " polylines ") + (the string form of polylines)) + ((the string form of " texts ") + (the string form of texts))) + (((the string form of " solids ") + (the string form of solids)) + ((the string form of " meshes ") + (the string form of meshCount))))) as a line

set editor to a new bim editor
add bim example building to (the address of editor) at (a cad vector2 with x 0.0 and y 0.0)
refresh bim editor (the address of editor)
set plan to the bim cad plan drawing of editor
report bim cad drawing plan labelled (the string form of "plan")
print (the bim cad export of plan as (the string form of "build/tests/cad_export_plan")) as a line
set meshes to the bim scene meshes of editor's evaluation after (a cad topology list of a bim scene mesh record)'s values
set none to a cad topology list of a bim scene mesh record
set model to the bim cad model drawing of editor with (meshes's values) and (none's values) and (none's values)
report bim cad drawing model labelled (the string form of "model")
print (the bim cad export of model as (the string form of "build/tests/cad_export_model")) as a line
