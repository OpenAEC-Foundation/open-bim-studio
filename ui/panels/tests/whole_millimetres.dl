# SPDX-License-Identifier: MPL-2.0
# A dimension's figure is in whole millimetres.
#
# A wall 3.0125 m long with a 12.5 mm board in its build-up (0.1525 m
# thick) gets its exterior dimension chains. The chain along it measures
# lengths that end in tenths of a millimetre; drawn in plan, every figure is
# a whole number, without a decimal sign.
import ui/panels/bim_plan_panel.dl

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.14)) to layerValues
append (@intrinsic("construct", a bim layer record, the string form of "gypsum", 0.0125)) to layerValues
set wallType to add bim wall type named (the string form of "Frame with board") with layerValues to target
ignore (add bim wall typed wallType on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 3.0125 and y 0.0) to target)
ignore (add bim wall typed wallType on editor's levelId from (a cad vector2 with x 3.0125 and y 0.0) to (a cad vector2 with x 3.0125 and y 2.0) to target)
refresh bim editor (the address of editor)
add bim editor exterior dimensions in (the address of editor)
print editor's message as a line
set modelValue to editor's documentValue's current
set withTenths to 0
loop cursor from 0 to the length of (modelValue's dimensions's values):
    set measured to (the bim measure of (the item at cursor in (modelValue's dimensions's values)) in modelValue)'s value * 10000.0
    if (the absolute value of (measured - (the rounded value of (measured / 10.0)) * 10.0)) > 0.5:
        set withTenths to withTenths + 1
print ((the string form of "measures with tenths of a millimetre: ") + (the string form of (withTenths > 0))) as a line
set sheet to a new bim canvas
set sheet's paperScale to 1.0
draw bim dimensions in plan of editor through (@intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 10.0)) on (the address of sheet)
set figures to the string form of ""
set decimalSigns to 0
loop cursor from 0 to the length of (sheet's texts's values):
    set figure to (the item at cursor in (sheet's texts's values))'s message
    set figures to (figures + (the string form of " ")) + figure
    loop letterCursor from 0 to the length of figure:
        set letter to the substring of figure from letterCursor spanning 1 bytes
        if (letter = (the string form of ",")) or (letter = (the string form of ".")):
            set decimalSigns to decimalSigns + 1
print ((the string form of "figures:") + figures) as a line
print ((the string form of "decimal signs in the figures: ") + (the string form of decimalSigns)) as a line
