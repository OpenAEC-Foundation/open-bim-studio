# SPDX-License-Identifier: MPL-2.0
import ui/panels/bim_plan_panel.dl

function check plan presentation {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set firstView to add bim view of kind (bim plan view) named (the string form of "Review") on editor's levelId to target
set secondView to add bim view of kind (bim plan view) named (the string form of "Drawing") on editor's levelId to target
set corners to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to corners
append (a cad vector2 with x 4.0 and y 0.0) to corners
append (a cad vector2 with x 4.0 and y 3.0) to corners
append (a cad vector2 with x 0.0 and y 3.0) to corners
ignore add bim space object named (the string form of "Room") numbered (the string form of "01") on editor's levelId around corners high 2.7 to target
set transform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 100.0)
set editor's planViewId to firstView
set review to a new bim canvas
draw bim spaces of editor through transform on (the address of review)
check plan presentation ((the length of (review's batches's values)) > 0) named (the string form of "review retains room fills")
set reviewKey to the bim plan key of editor at 100.0
set bim setting (bim technical plan setting) of secondView to (1 as a 64 bit integer) keeping true in target
set editor's planViewId to secondView
set technical to a new bim canvas
draw bim spaces of editor through transform on (the address of technical)
check plan presentation ((the length of (technical's batches's values)) = 0) named (the string form of "technical plan has white room interiors")
check plan presentation ((the length of (technical's texts's values)) = 2) named (the string form of "room name and area remain model annotations")
set label to the item at 0 in (technical's texts's values)
check plan presentation (((label's red = 0) and (label's green = 0)) and (label's blue = 0)) named (the string form of "technical room labels are black")
check plan presentation ((the bim plan key of editor at 100.0) != reviewKey) named (the string form of "switching views invalidates plan recording")
set gridCanvas to a new bim canvas
draw bim grid head (the string form of "A") at (a cad vector2 with x 0.0 and y 0.0) faint false on (the address of gridCanvas)
set batch to the item at 0 in (gridCanvas's batches's values)
check plan presentation (((batch's red = 0) and (batch's green = 0)) and (batch's blue = 0)) named (the string form of "grid linework is black, as NEN draws it")

# Sheet output is technical whatever the view's palette on screen.
set editor's planViewId to firstView
set sheetCanvas to a new bim canvas
set sheetCanvas's paperScale to 2.0
draw bim space fills of editor through transform on (the address of sheetCanvas)
check plan presentation ((the length of (sheetCanvas's batches's values)) = 0) named (the string form of "a review plan on a sheet has white room interiors")
check plan presentation (bim view firstView draws technically on (the address of sheetCanvas) in editor's documentValue's current) named (the string form of "a sheet canvas draws technically")
check plan presentation ((bim view firstView draws technically on (the address of review) in editor's documentValue's current) = false) named (the string form of "a review plan on screen keeps its colours")

# A plan with a drawing type is a drawing: technical until set otherwise.
ensure bim drawing types in target
set floorPlan to the bim drawing type named (the string form of "Floor plan") in editor's documentValue's current
set typedView to add bim view of kind (bim plan view) named (the string form of "Typed") on editor's levelId to target
set typedValue to the item at (the bim view index of typedView in editor's documentValue's current)'s position in (target's views's values)
set typedValue's drawingTypeId to floorPlan
store bim view typedValue in target
check plan presentation (bim view typedView uses a technical palette in editor's documentValue's current) named (the string form of "a plan with a drawing type defaults to technical")
set bim setting (bim technical plan setting) of typedView to (0 as a 64 bit integer) keeping true in target
check plan presentation ((bim view typedView uses a technical palette in editor's documentValue's current) = false) named (the string form of "its palette can still be set to the model review")

# Black and white hatches: steel stays solid black, concrete a grey, a
# hatched material white with black lines.
set steelPlain to the bim plain form of hatch (the bim hatch pattern of material (the string form of "Steel S235"))
check plan presentation ((steelPlain's fillRed = 0) and (steelPlain's fillBlue = 0)) named (the string form of "plain steel is solid black")
set concretePlain to the bim plain form of hatch (the bim hatch pattern of material (the string form of "Beton C30/37"))
check plan presentation ((concretePlain's fillRed = 192) and (concretePlain's fillGreen = 192)) named (the string form of "plain concrete is grey, not white")
set brickPlain to the bim plain form of hatch (the bim hatch pattern of material (the string form of "brick"))
check plan presentation (((brickPlain's fillRed = 255) and (brickPlain's fillGreen = 255)) and (brickPlain's lineRed = 0)) named (the string form of "plain brick is white with black lines")
set unitSquare to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to unitSquare
append (a cad vector2 with x 1.0 and y 0.0) to unitSquare
append (a cad vector2 with x 1.0 and y 1.0) to unitSquare
append (a cad vector2 with x 0.0 and y 1.0) to unitSquare
set concreteCanvas to a new bim canvas
draw bim hatch of unitSquare in (the bim whole hatch band of (the string form of "concrete")) through transform faint false plain true on (the address of concreteCanvas)
set concreteFill to the item at 0 in (concreteCanvas's batches's values)
check plan presentation ((concreteFill's red = 192) and (concreteFill's blue = 192)) named (the string form of "a technical concrete cut fills grey")

# Hatch density is decided in paper millimetres: at 1:100 brick's 80 mm is
# 0.8 mm on paper and drawn in the PDF (2.835 units per mm) and the SVG (1
# unit per mm) alike; gypsum's 30 mm (0.3 mm) is not.
set pdfTransform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 28.35)
set pdfCanvas to a new bim canvas
set pdfCanvas's paperScale to 2.835
draw bim hatch of unitSquare in (the bim whole hatch band of (the string form of "brick")) through pdfTransform faint false plain false on (the address of pdfCanvas)
check plan presentation ((the length of (pdfCanvas's batches's values)) = 2) named (the string form of "brick at 1:100 is hatched in the PDF")
set svgTransform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 10.0)
set svgCanvas to a new bim canvas
set svgCanvas's paperScale to 1.0
draw bim hatch of unitSquare in (the bim whole hatch band of (the string form of "brick")) through svgTransform faint false plain false on (the address of svgCanvas)
check plan presentation ((the length of (svgCanvas's batches's values)) = 2) named (the string form of "brick at 1:100 is hatched in the SVG")
set gypsumCanvas to a new bim canvas
set gypsumCanvas's paperScale to 2.835
draw bim hatch of unitSquare in (the bim whole hatch band of (the string form of "gypsum")) through pdfTransform faint false plain false on (the address of gypsumCanvas)
check plan presentation ((the length of (gypsumCanvas's batches's values)) = 1) named (the string form of "gypsum at 1:100 is too dense to hatch")
set screenCanvas to a new bim canvas
draw bim hatch of unitSquare in (the bim whole hatch band of (the string form of "brick")) through pdfTransform faint false plain false on (the address of screenCanvas)
check plan presentation ((the length of (screenCanvas's batches's values)) = 1) named (the string form of "on screen the pixel threshold still holds")
# A 60 mm insulation layer at 1:100 is 0.6 mm on paper: zigzagged there.
set strip to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to strip
append (a cad vector2 with x 20.0 and y 0.0) to strip
append (a cad vector2 with x 20.0 and y 1.7) to strip
append (a cad vector2 with x 0.0 and y 1.7) to strip
set paperZigzag to an empty list of a cad vector2
append bim zigzag of strip across (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 1.7) along (a cad vector2 with x 1.0 and y 0.0) no narrower than (the bim narrowest zigzag width at 2.835 per paper millimetre) into paperZigzag
check plan presentation ((the length of paperZigzag) > 0) named (the string form of "a 0.6 mm band is zigzagged on paper")
set screenZigzag to an empty list of a cad vector2
append bim zigzag of strip across (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 1.7) along (a cad vector2 with x 1.0 and y 0.0) no narrower than (the bim narrowest zigzag width at 0.0 per paper millimetre) into screenZigzag
check plan presentation ((the length of screenZigzag) = 0) named (the string form of "the same band is too narrow on screen")

# The north arrow points to the project's true north.
set northTransform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 100.0)
set northCanvas to a new bim canvas
draw bim north arrow of editor at (a cad vector2 with x 0.0 and y 0.0) through northTransform on (the address of northCanvas)
set northTip to the item at 0 in ((the item at 0 in (northCanvas's batches's values))'s pixels's values)
check plan presentation ((northTip's y < -14.0) and ((the absolute value of northTip's x) < 1e-9)) named (the string form of "north arrow points up without a true north")
set northLetter to the item at 0 in (northCanvas's texts's values)
check plan presentation (northLetter's message = (the string form of "N")) named (the string form of "north arrow is lettered N")
set bim setting (bim project north setting) of (0 as a 64 bit integer) to (90000 as a 64 bit integer) keeping true in target
set turnedCanvas to a new bim canvas
draw bim north arrow of editor at (a cad vector2 with x 0.0 and y 0.0) through northTransform on (the address of turnedCanvas)
set turnedTip to the item at 0 in ((the item at 0 in (turnedCanvas's batches's values))'s pixels's values)
check plan presentation ((turnedTip's x < -14.0) and ((the absolute value of turnedTip's y) < 1e-9)) named (the string form of "north 90 degrees anticlockwise points left")

# Level marks in plan follow the drawing type's Level marks rule.
set editor's planViewId to typedView
set unmarked to a new bim canvas
draw bim level marks in plan of editor through transform lettered at 13.0 on (the address of unmarked)
check plan presentation ((the length of (unmarked's texts's values)) = 0) named (the string form of "no level marks without the rule")
ignore set bim drawing type floorPlan setting 2 at bim level marks annotation to 1 in target
set marked to a new bim canvas
draw bim level marks in plan of editor through transform lettered at 13.0 on (the address of marked)
check plan presentation ((the length of (marked's texts's values)) = 1) named (the string form of "a level mark in the room with the rule")
set markText to the item at 0 in (marked's texts's values)
check plan presentation (markText's message = (the string form of "P")) named (the string form of "the ground floor is marked P")
check plan presentation ((the length of (marked's batches's values)) = 2) named (the string form of "the mark has its half-filled triangle and its line")
