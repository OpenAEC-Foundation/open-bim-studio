# SPDX-License-Identifier: MPL-2.0
import materials/bim_hatch.dl

function check plan ring {boolean:condition} named {string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set ring to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to ring
append (a cad vector2 with x 2.0 and y 0.0) to ring
append (a cad vector2 with x 2.0 and y 0.0) to ring
append (a cad vector2 with x 2.0 and y 1.0) to ring
append (a cad vector2 with x 1.0 and y 1.0) to ring
append (a cad vector2 with x 0.0 and y 1.0) to ring
append (a cad vector2 with x 0.0 and y 0.0) to ring
set cleaned to the bim cleaned ring of ring
check plan ring ((the length of (cleaned's values)) = 4) named (the string form of "clipped duplicate corners retain all rectangle corners")
set area to 0.0
loop cursor from 0 to the length of (cleaned's values):
    set here to the item at cursor in (cleaned's values)
    set there to the item at (the remainder of (cursor + 1) divided by (the length of (cleaned's values))) in (cleaned's values)
    set area to area + ((here's x * there's y) - (here's y * there's x))
check plan ring ((the absolute value of (area - 4.0)) < 1e-9) named (the string form of "cleaning preserves complete hatch area")
clear ring
append (a cad vector2 with x 0.0 and y 0.0) to ring
append (a cad vector2 with x 0.0 and y 0.0) to ring
set collapsed to the bim cleaned ring of ring
check plan ring ((the length of (collapsed's values)) = 0) named (the string form of "collapsed clipping remains empty")
