# SPDX-License-Identifier: MPL-2.0
# The 3D view's status indicator and display drop-down (issue #113): the
# frame meter leaves the window's sleep out of the rate, the renderer is
# the CPU only for a software device, and the display menu maps its rows.
import ui/panels/bim_view_status.dl

function check view status {boolean:passed} named {a string:caption}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set meter to a new bim frame meter
set zero to 0 as a 64 bit integer
check view status ((the bim frames per second of meter) = 0) named (the string form of "an empty meter has no rate")
check view status ((the bim view status caption of meter at zero on device kind (bim discrete gpu kind)) = (the string form of "GPU idle")) named (the string form of "an empty meter reads idle")
# Ten frames 16 667 microseconds apart: 60 frames per second.
set now to 1000000 as a 64 bit integer
loop frameCursor from 0 to 10:
    note bim frame at now working (4000 as a 64 bit integer) gpu (2000 as a 64 bit integer) in (the address of meter)
    set now to now + (16667 as a 64 bit integer)
set lastFrame to the last item of (meter's stamps)
check view status ((the bim frames per second of meter) = 60) named (the string form of "frames 16.7 ms apart read 60 per second")
check view status ((the bim view status caption of meter at lastFrame on device kind (bim discrete gpu kind)) = (the string form of "GPU 60 fps")) named (the string form of "the caption names the GPU and the rate")
check view status ((the bim view status caption of meter at lastFrame on device kind (bim cpu device kind)) = (the string form of "CPU 60 fps")) named (the string form of "a software device renders on the CPU")
# Asleep for three seconds, then two frames: the gap is no frame time.
set now to lastFrame + (3000000 as a 64 bit integer)
note bim frame at now working (4000 as a 64 bit integer) gpu (2000 as a 64 bit integer) in (the address of meter)
check view status ((the bim frames per second of meter) = 60) named (the string form of "the window asleep is left out of the rate")
check view status ((the bim view status caption of meter at (now + (1000000 as a 64 bit integer)) on device kind (bim integrated gpu kind)) = (the string form of "GPU idle")) named (the string form of "a second without frames reads idle")
# The meter keeps its span of frames.
loop frameCursor from 0 to 100:
    set now to now + (8333 as a 64 bit integer)
    note bim frame at now working (1000 as a 64 bit integer) gpu zero in (the address of meter)
check view status ((the length of (meter's stamps)) = (the bim frame meter span)) named (the string form of "the meter keeps its span")
check view status ((the bim frames per second of meter) = 120) named (the string form of "frames 8.3 ms apart read 120 per second")
check view status ((the bim frame work time of meter) = (1000 as a 64 bit integer)) named (the string form of "the work time is the mean of the kept frames")
check view status ((the bim renderer of device kind (bim virtual gpu kind)) = (the string form of "GPU")) named (the string form of "a virtual GPU still renders on a GPU")
check view status ((the bim memory text of (8589934592 as a 64 bit integer)) = (the string form of "8.0 GB")) named (the string form of "eight gigabytes of device memory")
check view status ((the bim memory text of (536870912 as a 64 bit integer)) = (the string form of "512 MB")) named (the string form of "half a gigabyte in megabytes")
check view status ((the bim memory text of zero) = (the string form of "not reported")) named (the string form of "no memory is not reported")
set statusLines to the bim view status lines of meter at now device (the string form of "llvmpipe (LLVM 17.0.6, 256 bits)") kind (bim cpu device kind) memory (2147483648 as a 64 bit integer) startup (the string form of "Ready in 812 ms (window 120, fonts 40, editor 300, first frame 352 ms)")
loop lineCursor from 0 to the length of statusLines:
    print (the item at lineCursor in statusLines) as a line
free statusLines
check view status ((the bim view status caption of meter at now on device kind (bim discrete gpu kind) sleeping true) = (the string form of "GPU idle")) named (the string form of "the window about to sleep reads idle")
set sleepingLines to the bim view status lines of meter at now sleeping true device (the string form of "") kind (bim discrete gpu kind) memory zero startup (the string form of "")
loop lineCursor from 0 to the length of sleepingLines:
    print (the item at lineCursor in sleepingLines) as a line
free sleepingLines
# The display drop-down: three displays in a plan, four modes in 3D.
check view status ((the bim display choice count flat true) = 3) named (the string form of "a plan offers three displays")
check view status ((the bim display choice count flat false) = 4) named (the string form of "the 3D view offers four modes")
check view status ((the bim display choice caption 1 flat false) = (the string form of "Edges")) named (the string form of "mode 1 is shaded with edges")
set foot to 600.0
set menuTop to the bim display menu top above foot flat false
check view status (menuTop = 400.0) named (the string form of "the 3D display menu stands on the bar")
check view status ((the bim display choice at (a cad vector2 with x 410.0 and y 410.0) from 400.0 above foot flat false) = -1) named (the string form of "the menu's heading is no choice")
check view status ((the bim display choice at (a cad vector2 with x 410.0 and y 440.0) from 400.0 above foot flat false) = 0) named (the string form of "the first row is shaded")
check view status ((the bim display choice at (a cad vector2 with x 630.0 and y 599.0) from 400.0 above foot flat false) = 3) named (the string form of "the last row is wireframe")
check view status ((the bim display choice at (a cad vector2 with x 641.0 and y 500.0) from 400.0 above foot flat false) = -1) named (the string form of "right of the menu is no choice")
check view status ((the bim display choice at (a cad vector2 with x 410.0 and y 600.0) from 400.0 above foot flat false) = -1) named (the string form of "the bar below is no choice")
check view status ((the bim display choice at (a cad vector2 with x 410.0 and y 599.0) from 400.0 above foot flat true) = 2) named (the string form of "a plan's last row is wire")
# The sun panel: fixed, two rows of steps; by place and time, six.
set sunTop to the bim sun panel top above 600.0 by location false
check view status (sunTop = 404.0) named (the string form of "the fixed sun panel stands on the bar")
check view status ((the bim sun panel hit at (a cad vector2 with x 410.0 and y 460.0) from 400.0 above 600.0 by location false) = (bim sun panel fixed hit)) named (the string form of "the mode's left half is the fixed angle")
check view status ((the bim sun panel hit at (a cad vector2 with x 600.0 and y 460.0) from 400.0 above 600.0 by location false) = (bim sun panel location hit)) named (the string form of "the mode's right half is place and time")
check view status ((the bim sun panel hit at (a cad vector2 with x 670.0 and y 500.0) from 400.0 above 600.0 by location false) = 101) named (the string form of "the first row's plus turns the azimuth up")
check view status ((the bim sun panel hit at (a cad vector2 with x 630.0 and y 530.0) from 400.0 above 600.0 by location false) = 102) named (the string form of "the second row's minus lowers the altitude")
check view status ((the bim sun panel hit at (a cad vector2 with x 450.0 and y 530.0) from 400.0 above 600.0 by location false) = 0) named (the string form of "a row's label is inside but no control")
check view status ((the bim sun panel hit at (a cad vector2 with x 450.0 and y 580.0) from 400.0 above 600.0 by location false) = 0) named (the string form of "the foot is inside but no control")
check view status ((the bim sun panel hit at (a cad vector2 with x 450.0 and y 600.0) from 400.0 above 600.0 by location false) = -1) named (the string form of "the bar below is outside")
check view status ((the bim sun panel hit at (a cad vector2 with x 670.0 and y 730.0) from 400.0 above 800.0 by location true) = 115) named (the string form of "by place and time the last row steps the offset")
