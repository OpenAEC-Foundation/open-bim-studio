# SPDX-License-Identifier: MPL-2.0
# Floors and roofs are hatched per layer where a view cuts them (drawing
# quality plan, item 13): one bounded band per layer of the plate's type,
# parallel to the plate. A roof of 50 mm timber over 200 mm insulation,
# pitched 1 in 2 toward +x, crosses the plan's cut plane in a timber band
# 100 mm wide and an insulation band 400 mm wide (each layer's thickness over
# the slope); a section along its heading crosses it in bands parallel to the
# roof, as thick as the layers measured square to it (cos 26.57 degrees). A
# floor of screed, concrete and insulation is cut by the same section in
# three horizontal bands. On paper both are drawn as a technical drawing:
# every layer filled and hatched by its NEN 47 pattern in black, with the
# pen table's hatch pen (0.13 mm), and the insulation, thickest in the roof,
# with its zigzag running from one face of the layer to the other.
import ui/panels/bim_plan_panel.dl

function check plate hatch {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the plate hatch test whole of {a 64 bit floating-point number:amount}:
    execute:
        return (@intrinsic("call", "libc", "round", a 64 bit floating-point number, amount)) as a 64 bit integer

# The position of the cut of element `elementId` among the sources of
# `viewValue`, or -1.
function the plate hatch test source position of {a 64 bit integer:elementId} in {bim view record:viewValue}:
    execute:
        set sourcePosition to -1
        loop sourceCursor from 0 to the length of (viewValue's sources's values):
            if (the item at sourceCursor in (viewValue's sources's values))'s id = elementId:
                set sourcePosition to sourceCursor
        return sourcePosition

# Prints each band: its material, and where it is bounded its two faces in
# millimetres along its normal (in thousandths).
function show plate hatch test bands {a pointer to a list:bandList} named {a string:label}:
    execute:
        loop bandCursor from 0 to the length of bandList:
            set shownBand to the item at bandCursor in bandList
            if shownBand's low < (0.0 - 1e300):
                print ((((the string form of "  ") + label) + (the string form of ": ")) + (shownBand's material + (the string form of " over the whole cut"))) as a line
            else:
                set faces to ((the string form of (the plate hatch test whole of (shownBand's low * 1000.0))) + (the string form of " to ")) + (the string form of (the plate hatch test whole of (shownBand's high * 1000.0)))
                set direction to ((the string form of (the plate hatch test whole of (shownBand's normal's x * 1000.0))) + (the string form of ", ")) + (the string form of (the plate hatch test whole of (shownBand's normal's y * 1000.0)))
                print ((((the string form of "  ") + label) + (the string form of ": ")) + ((shownBand's material + (the string form of " from ")) + ((faces + (the string form of " mm along (")) + (direction + (the string form of ")/1000"))))) as a line

# Prints the canvas's batches in order: fills with their colour, strokes
# with their colour, their width in paper millimetres and their count.
function show plate hatch test batches of {bim canvas record:drawn} named {a string:label}:
    execute:
        print label as a line
        loop batchCursor from 0 to the length of (drawn's batches's values):
            set shownBatch to the item at batchCursor in (drawn's batches's values)
            set colourText to ((the string form of shownBatch's red) + (the string form of ",")) + ((the string form of shownBatch's green) + ((the string form of ",") + (the string form of shownBatch's blue)))
            if shownBatch's stroked:
                set widthText to the string form of ((the plate hatch test whole of ((shownBatch's breadth / drawn's paperScale) * 100.0)) as an integer)
                print ((((the string form of "  strokes ") + colourText) + (the string form of " width/100 mm ")) + (widthText + ((the string form of " count ") + (the string form of ((the length of (shownBatch's pixels's values)) / 6))))) as a line
            else:
                print ((the string form of "  fill ") + colourText) as a line

# How many strokes of the hatch pen on `drawn` run from one face of `layerBand`
# to the other, a zigzag's strokes, with `perMetre` canvas units to the metre
# about the canvas origin, y up.
function the plate hatch test zigzag count of {bim canvas record:drawn} across {bim hatch band record:layerBand} at {a 64 bit floating-point number:perMetre}:
    execute:
        set total to 0
        set hatchBreadth to (the bim paper width of pen (bim hatch pen)) * drawn's paperScale
        loop batchCursor from 0 to the length of (drawn's batches's values):
            set shownBatch to the item at batchCursor in (drawn's batches's values)
            if shownBatch's stroked and ((the absolute value of (shownBatch's breadth - hatchBreadth)) < 1e-9):
                set quadCorners to shownBatch's pixels's values
                set quadCursor to 0
                loop while quadCursor < the length of quadCorners:
                    set startX to ((the item at quadCursor in quadCorners)'s x + (the item at (quadCursor + 1) in quadCorners)'s x) * 0.5
                    set startY to ((the item at quadCursor in quadCorners)'s y + (the item at (quadCursor + 1) in quadCorners)'s y) * 0.5
                    set endX to ((the item at (quadCursor + 2) in quadCorners)'s x + (the item at (quadCursor + 5) in quadCorners)'s x) * 0.5
                    set endY to ((the item at (quadCursor + 2) in quadCorners)'s y + (the item at (quadCursor + 5) in quadCorners)'s y) * 0.5
                    set startDepth to ((startX / perMetre) * layerBand's normal's x) - ((startY / perMetre) * layerBand's normal's y)
                    set endDepth to ((endX / perMetre) * layerBand's normal's x) - ((endY / perMetre) * layerBand's normal's y)
                    set onNear to ((the absolute value of (startDepth - layerBand's low)) < 1e-6) and ((the absolute value of (endDepth - layerBand's high)) < 1e-6)
                    set onFar to ((the absolute value of (startDepth - layerBand's high)) < 1e-6) and ((the absolute value of (endDepth - layerBand's low)) < 1e-6)
                    if onNear or onFar:
                        set total to total + 1
                    set quadCursor to quadCursor + 6
        return total

set editor to a new bim editor
set modelTarget to the address of (editor's documentValue's current)
set levelFound to the bim level index of editor's levelId in editor's documentValue's current
set elevation to (the item at levelFound's position in (editor's documentValue's current's levels's values))'s elevation
set cutHeight to the bim plan cut height of editor
set roofLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.05)) to roofLayers
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.2)) to roofLayers
set roofType to add bim planar type named (the string form of "Roof 250") as role bim roof planar role with roofLayers to modelTarget
free roofLayers
set floorLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "screed", 0.05)) to floorLayers
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to floorLayers
append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.1)) to floorLayers
set floorType to add bim planar type named (the string form of "Floor 350") as role bim floor planar role with floorLayers to modelTarget
free floorLayers
# The roof over 0..4 by 0..4, its top 1 m below the cut plane at x = 0 and
# rising 1 in 2 toward +x, so that its top crosses the cut plane at x = 2.
set roofOutline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to roofOutline
append (a cad vector2 with x 4.0 and y 0.0) to roofOutline
append (a cad vector2 with x 4.0 and y 4.0) to roofOutline
append (a cad vector2 with x 0.0 and y 4.0) to roofOutline
set roofId to add bim plate typed roofType on editor's levelId around roofOutline at top (cutHeight - 1.0) to modelTarget
ignore (set bim plate roofId top to (cutHeight - 1.0) pitch (@intrinsic("atan2", 0.5, 1.0)) heading 0.0 in modelTarget)
# The floor over 6..10 by 0..4, its top on the storey.
set floorOutline to an empty list of a cad vector2
append (a cad vector2 with x 6.0 and y 0.0) to floorOutline
append (a cad vector2 with x 10.0 and y 0.0) to floorOutline
append (a cad vector2 with x 10.0 and y 4.0) to floorOutline
append (a cad vector2 with x 6.0 and y 4.0) to floorOutline
set floorId to add bim plate typed floorType on editor's levelId around floorOutline at top 0.0 to modelTarget
free roofOutline
free floorOutline
refresh bim editor (the address of editor)
set modelValue to editor's documentValue's current
set roofValue to the item at (the bim slab index of roofId in modelValue)'s position in (modelValue's slabs's values)
set floorValue to the item at (the bim slab index of floorId in modelValue)'s position in (modelValue's slabs's values)

# The plan: the roof is cut, the floor below the cut plane is not.
set roofPlanAt to the plate hatch test source position of roofId in editor's plan
set floorPlanAt to the plate hatch test source position of floorId in editor's plan
check plate hatch (roofPlanAt >= 0) named (the string form of "the plan cuts the roof")
set floorPlanPolygons to 0
if floorPlanAt >= 0:
    set floorPlanPolygons to the length of ((the item at floorPlanAt in (editor's plan's sources's values))'s polygons's values)
check plate hatch (floorPlanPolygons = 0) named (the string form of "the plan does not cut the floor below it")
set roofPlanSource to the item at roofPlanAt in (editor's plan's sources's values)
set planBands to the bim hatch bands of roofPlanSource for editor as section false cut by editor's plan's viewPlane
print (the string form of "plan bands:") as a line
show plate hatch test bands (planBands's values) named (the string form of "roof")
check plate hatch ((the length of (planBands's values)) = 2) named (the string form of "the roof is cut in one band per layer")
set planTimber to the item at 0 in (planBands's values)
set planInsulation to the item at 1 in (planBands's values)
check plate hatch (((the plate hatch test whole of (planTimber's low * 1000.0)) = (2000 as a 64 bit integer)) and ((the plate hatch test whole of (planTimber's high * 1000.0)) = (2100 as a 64 bit integer))) named (the string form of "timber from where the top crosses the cut, 50 mm over a slope of 1 in 2 wide")
check plate hatch (((the plate hatch test whole of (planInsulation's low * 1000.0)) = (2100 as a 64 bit integer)) and ((the plate hatch test whole of (planInsulation's high * 1000.0)) = (2500 as a 64 bit integer))) named (the string form of "insulation bounded below it, 400 mm wide")
check plate hatch ((planTimber's normal's x = 1.0) and (planTimber's normal's y = 0.0)) named (the string form of "plan bands run across the heading")

# A plane parallel to a flat floor lies in one layer: the concrete, 100 mm
# below the floor's top.
set flatBands to the bim plate hatch bands of floorValue in modelValue cut by (the bim plan plane at elevation cut at -0.1)
print (the string form of "flat floor cut 100 mm below its top:") as a line
show plate hatch test bands (flatBands's values) named (the string form of "floor")
check plate hatch (((the length of (flatBands's values)) = 1) and ((the item at 0 in (flatBands's values))'s material = (the string form of "concrete"))) named (the string form of "a plane within a flat plate's layer covers the cut with that layer")

# The section from (-1, 2) to (11, 2): x along it from -1, y up.
set sectionFirst to a cad vector2 with x -1.0 and y 2.0
set sectionSecond to a cad vector2 with x 11.0 and y 2.0
set sectionShown to editor
set sectionShown's hasSection to true
set sectionShown's sectionFirst to sectionFirst
set sectionShown's sectionSecond to sectionSecond
set sectionCut to the bim section of (editor's evaluation) from sectionFirst to sectionSecond
set roofSectionAt to the plate hatch test source position of roofId in sectionCut
set floorSectionAt to the plate hatch test source position of floorId in sectionCut
check plate hatch ((roofSectionAt >= 0) and (floorSectionAt >= 0)) named (the string form of "the section cuts the roof and the floor")
set roofSectionBands to the bim hatch bands of (the item at roofSectionAt in (sectionCut's sources's values)) for sectionShown as section true cut by sectionCut's viewPlane
set floorSectionBands to the bim hatch bands of (the item at floorSectionAt in (sectionCut's sources's values)) for sectionShown as section true cut by sectionCut's viewPlane
print (the string form of "section bands:") as a line
show plate hatch test bands (roofSectionBands's values) named (the string form of "roof")
show plate hatch test bands (floorSectionBands's values) named (the string form of "floor")
check plate hatch ((the length of (roofSectionBands's values)) = 2) named (the string form of "the section cuts the roof in one band per layer")
set sectionTimber to the item at 0 in (roofSectionBands's values)
set sectionInsulation to the item at 1 in (roofSectionBands's values)
# Parallel to the roof: the normal is square to its slope (1, 0.5).
check plate hatch ((the absolute value of ((sectionTimber's normal's x * 1.0) + (sectionTimber's normal's y * 0.5))) < 1e-12) named (the string form of "roof bands lie parallel to the pitched roof")
check plate hatch ((the plate hatch test whole of ((sectionTimber's high - sectionTimber's low) * 100000.0)) = (4472 as a 64 bit integer)) named (the string form of "the timber band 50 mm thick vertically, 44.72 mm square to the roof")
check plate hatch ((the plate hatch test whole of ((sectionInsulation's high - sectionInsulation's low) * 100000.0)) = (17889 as a 64 bit integer)) named (the string form of "the insulation band 178.89 mm square to the roof")
check plate hatch ((the absolute value of (sectionTimber's high - sectionInsulation's low)) < 1e-12) named (the string form of "the layers meet")
check plate hatch ((the length of (floorSectionBands's values)) = 3) named (the string form of "the section cuts the floor in one band per layer")
set floorScreed to the item at 0 in (floorSectionBands's values)
set floorInsulation to the item at 2 in (floorSectionBands's values)
check plate hatch (((floorScreed's normal's x = 0.0) and (floorScreed's normal's y = -1.0)) and ((the plate hatch test whole of (floorInsulation's high * 1000.0)) = (350 as a 64 bit integer))) named (the string form of "floor bands horizontal, down to its underside 350 mm below its top")

# On paper at 1:50, ten canvas units to the millimetre: 200 to the metre.
set perMetre to 200.0
set transform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), perMetre)
set planCanvas to a new bim canvas
set planCanvas's paperScale to 10.0
draw bim hatched cut faces of editor's plan for editor through transform as section false following editor's planRules on (the address of planCanvas)
show plate hatch test batches of planCanvas named (the string form of "plan on paper:")
set planZigzag to the plate hatch test zigzag count of planCanvas across planInsulation at perMetre
print ((the string form of "plan zigzag strokes across the roof insulation: ") + (the string form of planZigzag)) as a line
check plate hatch (planZigzag >= 8) named (the string form of "the roof's insulation gets its zigzag in plan")
set sectionCanvas to a new bim canvas
set sectionCanvas's paperScale to 10.0
draw bim hatched cut faces of sectionCut for sectionShown through transform as section true following editor's sectionRules on (the address of sectionCanvas)
show plate hatch test batches of sectionCanvas named (the string form of "section on paper:")
set roofZigzag to the plate hatch test zigzag count of sectionCanvas across sectionInsulation at perMetre
set floorZigzag to the plate hatch test zigzag count of sectionCanvas across floorInsulation at perMetre
print ((the string form of "section zigzag strokes across the roof insulation: ") + ((the string form of roofZigzag) + ((the string form of ", the floor insulation: ") + (the string form of floorZigzag)))) as a line
check plate hatch ((roofZigzag >= 8) and (floorZigzag >= 8)) named (the string form of "both insulation layers get their zigzag in section")
