# SPDX-License-Identifier: MPL-2.0
# The command line's search (`bim_search.dl`): the command list built from
# the ribbon and the two-letter table (Array with AY, Wall), a command found
# by its name and by its key, a view, a storey and a grid found by name, a wall by its kind and number,
# commands ranked before objects, the row under the pointer, and what
# running a row does: a command's code for the window to press, a view for
# it to open, the active storey, the selection; a whole sentence still runs
# as a sentence, and the arrows move through the rows.
import ui/panels/bim_command_line.dl

function check search {boolean:passed} named {a string:caption}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

# The position of the command named `wantedName` sending `wantedCode`, or -1.
function the place of command {a string:wantedName} sending {integer:wantedCode} among {a pointer to a list:listedRows}:
    execute:
        loop listedCursor from 0 to the length of listedRows:
            set listedEntry to the item at listedCursor in listedRows
            if (listedEntry's label = wantedName) and (listedEntry's code = wantedCode):
                return listedCursor
        return -1

# Types `spelled` (ASCII) on the command line and brings the search up to
# date, as the window does each frame.
function spell {a string:spelled} into {a pointer to a bim command line record:prompter} searched by {a pointer to a bim command search record:finder} of {a pointer to a bim editor record:editor} with {bim import record:importValue}:
    execute:
        loop spellCursor from 0 to the length of spelled:
            type bim command line character (the bim sentence byte at spellCursor in spelled) in prompter
        set spelledLine to prompter's typed
        refresh bim search finder typing spelledLine of editor with importValue stamped (the string form of "1")

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set atticId to add bim level named (the string form of "Attic K8") at 3.0 with height 3.0 to target
set overviewId to add bim view of kind (bim plan view) named (the string form of "Overview K7") on editor's levelId to target
set sheetId to add bim sheet numbered (the string form of "K6-01") named (the string form of "Plans") on paper 1 landscape true to target
set gridId to add bim grid named (the string form of "Axis K9") from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 8.0) reaching 0.0 to 3.0 to target
set wallId to add bim wall typed editor's wallTypeId on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 5.0 and y 0.0) to target
set importValue to the bim import of (the string form of "")

set finder to a new bim command search
set f to the address of finder
set prompter to a new bim command line
set p to the address of prompter
set prompter's focused to true

# The command list.
set listedRows to finder's commands
set arrayAt to the place of command (the string form of "Array") sending 2025 among listedRows
check search (arrayAt >= 0) named (the string form of "the commands hold Array")
check search ((the item at arrayAt in listedRows)'s detail = (the string form of "AY")) named (the string form of "Array shows its key AY")
check search ((the item at arrayAt in listedRows)'s place = (the string form of "Modify / Modify")) named (the string form of "Array lives on the Modify tab")
check search ((the place of command (the string form of "Wall") sending 87 among listedRows) >= 0) named (the string form of "the commands hold Wall")
check search ((the place of command (the string form of "Save") sending 1083 among listedRows) >= 0) named (the string form of "the commands hold the quick action Save")
check search ((the length of listedRows) > 100) named (the string form of "every tab's buttons are listed")

# A command by its name and by its key.
spell (the string form of "Array") into p searched by f of e with importValue
check search ((the length of (finder's shown)) > 0) named (the string form of "'Array' finds rows")
check search ((the item at 0 in (finder's shown))'s code = 2025) named (the string form of "'Array' finds the Array command first")
check search ((the bim search highlighted row of finder) = 0) named (the string form of "the first row is the one Enter runs")
check search ((the bim search note of (the item at 0 in (finder's shown))) = (the string form of "AY   Modify / Modify")) named (the string form of "its row shows the key and the tab")
# The row under the pointer: the rows end six pixels above the strip.
set stripTop to the bim ui canvas bottom in 900.0
set firstRowY to ((stripTop - 6.0) - (22.0 * ((finder's sentenceRows + (the length of (finder's shown))) as a 64 bit floating-point number))) + 11.0
check search ((the bim search row under 200.0 and firstRowY of finder in 1600.0 by 900.0) = 0) named (the string form of "the pointer on the first row finds it")
check search ((the bim search row under 40.0 and firstRowY of finder in 1600.0 by 900.0) = -1) named (the string form of "left of the box is no row")
check search ((the bim search row under 200.0 and (stripTop + 4.0) of finder in 1600.0 by 900.0) = -1) named (the string form of "the box itself is no row")
set outcome to press bim search key (bim enter key code) in f on p for e
check search ((outcome's windowPart's verb = (the string form of "press")) and (outcome's windowPart's number = 2025)) named (the string form of "Enter sends Array's code as a ribbon click")
check search (((the length of prompter's typed) = 0) and (prompter's focused = false)) named (the string form of "the line is cleared and the keys go back")
check search ((the length of (finder's shown)) = 0) named (the string form of "the list closes")
set prompter's focused to true
spell (the string form of "ay") into p searched by f of e with importValue
check search ((the item at 0 in (finder's shown))'s code = 2025) named (the string form of "'ay' finds Array by its key")
set outcome to press bim search key (bim escape key code) in f on p for e
check search (((the length of prompter's typed) = 0) and ((the length of (finder's shown)) = 0)) named (the string form of "Escape clears the line and closes the list")
check search (prompter's focused) named (the string form of "Escape on a typed line keeps the keys")

# Commands before objects.
spell (the string form of "wall") into p searched by f of e with importValue
set shownCount to the length of (finder's shown)
check search ((shownCount >= 3) and (shownCount <= (bim search shown rows))) named (the string form of "'wall' shows several rows, no more than the list holds")
check search ((the item at 0 in (finder's shown))'s family = bim search command row) named (the string form of "'wall' shows a command first")
check search ((the item at 0 in (finder's shown))'s label = (the string form of "Wall")) named (the string form of "the command named Wall leads")
check search (((the item at (shownCount - 1) in (finder's shown))'s family = bim search command row) = false) named (the string form of "objects keep the last rows")
set objectSeen to false
loop shownCursor from 0 to shownCount:
    if ((the item at shownCursor in (finder's shown))'s family) != (bim search command row):
        set objectSeen to true
    else:
        check search (objectSeen = false) named (the string form of "no command stands below an object")
# The arrows.
set outcome to press bim search key (bim sentence down key code) in f on p for e
check search ((the bim search highlighted row of finder) = 1) named (the string form of "Down moves to the second row")
set outcome to press bim search key (bim sentence up key code) in f on p for e
set outcome to press bim search key (bim sentence up key code) in f on p for e
check search ((the bim search highlighted row of finder) = (shownCount - 1)) named (the string form of "Up from the first row goes round to the last")
set outcome to press bim search key (bim escape key code) in f on p for e

# The model's objects.
spell (the string form of "overview k7") into p searched by f of e with importValue
check search ((the length of (finder's shown)) = 1) named (the string form of "'overview k7' finds one row")
check search (((the item at 0 in (finder's shown))'s family = bim search view row) and ((the item at 0 in (finder's shown))'s targetId = overviewId)) named (the string form of "it is the view")
check search ((the item at 0 in (finder's shown))'s detail = (the string form of "Plan")) named (the string form of "the view shows its kind")
set outcome to press bim search key (bim enter key code) in f on p for e
check search ((outcome's windowPart's verb = (the string form of "open")) and (outcome's windowPart's text = (the string form of "Overview K7"))) named (the string form of "Enter opens the view")
set prompter's focused to true
spell (the string form of "k6") into p searched by f of e with importValue
check search ((the item at 0 in (finder's shown))'s family = bim search sheet row) named (the string form of "'k6' finds the sheet")
set outcome to press bim search key (bim enter key code) in f on p for e
check search ((outcome's windowPart's verb = (the string form of "open")) and (outcome's windowPart's text = (the string form of "K6-01"))) named (the string form of "Enter opens the sheet by its number")
set prompter's focused to true
spell (the string form of "attic") into p searched by f of e with importValue
check search ((the item at 0 in (finder's shown))'s family = bim search storey row) named (the string form of "'attic' finds the storey")
set outcome to press bim search key (bim enter key code) in f on p for e
check search (editor's levelId = atticId) named (the string form of "Enter makes it the active storey")
set prompter's focused to true
spell (the string form of "axis k9") into p searched by f of e with importValue
check search ((the item at 0 in (finder's shown))'s detail = (the string form of "Grids")) named (the string form of "'axis k9' finds the grid")
set clicked to run bim search row 0 of f on p for e
check search ((editor's selectionKind = bim grid picked) and (editor's selectionId = gridId)) named (the string form of "a click on its row selects the grid")
set prompter's focused to true
spell ((the string form of "walls #") + (the string form of wallId)) into p searched by f of e with importValue
check search ((the length of (finder's shown)) > 0) named (the string form of "the wall is found by its kind and number")
check search (((the item at 0 in (finder's shown))'s family = bim search pick row) and ((the item at 0 in (finder's shown))'s targetId = wallId)) named (the string form of "its row is the wall's")
set outcome to press bim search key (bim enter key code) in f on p for e
check search ((editor's selectionKind = bim wall picked) and (editor's selectionId = wallId)) named (the string form of "Enter selects the wall")
set prompter's focused to true
spell (the string form of "window 1200") into p searched by f of e with importValue
check search ((the item at 0 in (finder's shown))'s family = bim search opening type row) named (the string form of "'window 1200' finds the window type")
set outcome to press bim search key (bim escape key code) in f on p for e

# A whole sentence runs as a sentence, as before.
set wallsBefore to the length of (editor's documentValue's current's walls's values)
spell (the string form of "draw a wall from (0, 4) to (5, 4)") into p searched by f of e with importValue
check search ((the bim search highlighted row of finder) = -1) named (the string form of "a whole sentence leaves the rows unmarked")
set outcome to press bim search key (bim enter key code) in f on p for e
check search ((the length of (editor's documentValue's current's walls's values)) = (wallsBefore + 1)) named (the string form of "Enter runs the sentence")
check search ((the length of (prompter's sentences's values)) = 1) named (the string form of "the sentence enters the history")
check search (prompter's focused) named (the string form of "the command line keeps the keys after a sentence")
# A sentence the search also finds as a command stays a sentence.
spell (the string form of "redo") into p searched by f of e with importValue
check search ((the length of (finder's shown)) > 0) named (the string form of "'redo' also finds the Redo command")
check search ((the bim search highlighted row of finder) = -1) named (the string form of "its row is not the one Enter runs")
set outcome to press bim search key (bim enter key code) in f on p for e
check search ((the length of (prompter's sentences's values)) = 2) named (the string form of "Enter runs 'redo' as the sentence")
check search ((outcome's windowPart's verb = (the string form of "press")) = false) named (the string form of "no ribbon click is sent for it")
# A line nothing answers is the sentences' to refuse.
spell (the string form of "zzqx") into p searched by f of e with importValue
check search ((the length of (finder's shown)) = 0) named (the string form of "'zzqx' finds nothing")
set outcome to press bim search key (bim enter key code) in f on p for e
check search (outcome's ok = false) named (the string form of "Enter then refuses it as a sentence")
