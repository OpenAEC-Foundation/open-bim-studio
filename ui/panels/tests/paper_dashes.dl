# SPDX-License-Identifier: MPL-2.0
# Dashes in paper millimetres (drawing quality plan, item 8). Recorded on a
# sheet (a canvas in paper millimetres, and one in the points a sheet
# records in), a roof's edges, a beam above the cut and a stair's treads
# above the cut are dashed by the dash table of bim/bim_pens.dl, 3 mm dashes
# with 1.5 mm gaps, and a section line is the chain line, 12 mm dashes and
# 0.5 mm dots 1.5 mm apart, at 1:50 and at 1:100 alike; the ridge two roof
# planes share still takes the same dashes from both planes, and on screen
# the dashes stay in pixels.
import ui/panels/bim_plan_panel.dl

function check paper dashes {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the paper dash text of {a 64 bit floating-point number:value}:
    execute:
        set buffer to a new string buffer containing 40 bytes
        set written to @intrinsic("variadic call", "libc", "snprintf", integer, 3, the data of buffer, 41 as a word sized unsigned integer, "%.2f", value)
        return the substring of buffer from 0 spanning written bytes

# The pieces of the stroked `batch`, two points each: each segment of its
# stroke runs (a dash ending on a corner where the next edge's first dash
# starts is joined with it into one run).
function the paper segments of {bim canvas batch record:batch}:
    execute:
        set runPoints to an empty list of a cad vector2
        set runCounts to an empty list of an integer
        set runClosed to an empty list of a boolean
        append bim stroke runs of batch into runPoints counting runCounts closing runClosed
        set pieceList to an empty list of a cad vector2
        set pointCursor to 0
        loop runCursor from 0 to the length of runCounts:
            set runLength to the item at runCursor in runCounts
            loop segmentCursor from 1 to runLength:
                append (the item at ((pointCursor + segmentCursor) - 1) in runPoints) to pieceList
                append (the item at (pointCursor + segmentCursor) in runPoints) to pieceList
            set pointCursor to pointCursor + runLength
        free runPoints
        free runCounts
        free runClosed
        return pieceList

# The pieces of the stroked `batch` that lie on the horizontal line at
# `lineY`, as " low-high" along x, in millimetres (`unitsPerMm` canvas
# units to the millimetre).
function the paper pieces of {bim canvas batch record:batch} on y {a 64 bit floating-point number:lineY} per {a 64 bit floating-point number:unitsPerMm}:
    execute:
        set pieceList to the paper segments of batch
        set summary to the string form of ""
        set segmentCursor to 0
        loop while (segmentCursor + 1) < the length of pieceList:
            set pieceStart to the item at segmentCursor in pieceList
            set pieceEnd to the item at (segmentCursor + 1) in pieceList
            if ((the absolute value of (pieceStart's y - lineY)) < 0.001) and ((the absolute value of (pieceEnd's y - lineY)) < 0.001):
                set low to (the minimum of pieceStart's x and pieceEnd's x) / unitsPerMm
                set high to (the maximum of pieceStart's x and pieceEnd's x) / unitsPerMm
                set summary to (summary + (the string form of " ")) + ((the paper dash text of low) + ((the string form of "-") + (the paper dash text of high)))
            set segmentCursor to segmentCursor + 2
        free pieceList
        return summary

# The longest piece of the stroked `batch`, in the canvas's units.
function the longest paper piece of {bim canvas batch record:batch}:
    execute:
        set pieceList to the paper segments of batch
        set longestPiece to 0.0
        set segmentCursor to 0
        loop while (segmentCursor + 1) < the length of pieceList:
            set longestPiece to the maximum of longestPiece and (the cad distance from (the item at segmentCursor in pieceList) to (the item at (segmentCursor + 1) in pieceList))
            set segmentCursor to segmentCursor + 2
        free pieceList
        return longestPiece

# The shortest piece of the stroked `batch`, in the canvas's units.
function the shortest paper piece of {bim canvas batch record:batch}:
    execute:
        set pieceList to the paper segments of batch
        set shortestPiece to 1000000.0
        set segmentCursor to 0
        loop while (segmentCursor + 1) < the length of pieceList:
            set shortestPiece to the minimum of shortestPiece and (the cad distance from (the item at segmentCursor in pieceList) to (the item at (segmentCursor + 1) in pieceList))
            set segmentCursor to segmentCursor + 2
        free pieceList
        return shortestPiece

# The gaps of the stroked `batch`: between each piece and the next where the
# next goes on along the same line, as "smallest-largest" in millimetres
# (`unitsPerMm` canvas units to the millimetre); "none" without any.
function the paper gaps of {bim canvas batch record:batch} per {a 64 bit floating-point number:unitsPerMm}:
    execute:
        set pieceList to the paper segments of batch
        set smallestGap to 1000000.0
        set largestGap to 0.0
        set segmentCursor to 0
        loop while (segmentCursor + 3) < the length of pieceList:
            set pieceStart to the item at segmentCursor in pieceList
            set pieceEnd to the item at (segmentCursor + 1) in pieceList
            set nextStart to the item at (segmentCursor + 2) in pieceList
            set pieceLength to the cad distance from pieceStart to pieceEnd
            set gapLength to the cad distance from pieceEnd to nextStart
            if (pieceLength > 0.000001) and (gapLength > 0.000001):
                set alongX to (pieceEnd's x - pieceStart's x) / pieceLength
                set alongY to (pieceEnd's y - pieceStart's y) / pieceLength
                set acrossGap to (alongX * (nextStart's y - pieceEnd's y)) - (alongY * (nextStart's x - pieceEnd's x))
                set forwardGap to (alongX * (nextStart's x - pieceEnd's x)) + (alongY * (nextStart's y - pieceEnd's y))
                if ((the absolute value of acrossGap) < (0.0001 * unitsPerMm)) and (forwardGap > 0.0):
                    set smallestGap to the minimum of smallestGap and (gapLength / unitsPerMm)
                    set largestGap to the maximum of largestGap and (gapLength / unitsPerMm)
            set segmentCursor to segmentCursor + 2
        free pieceList
        if largestGap <= 0.0:
            return the string form of "none"
        return ((the paper dash text of smallestGap) + (the string form of "-")) + (the paper dash text of largestGap)

# The first batch of `canvas` stroked `wantedBreadth` wide (the hidden pen's on
# paper), else its last batch.
function the paper batch of {bim canvas record:canvas} wide {a 64 bit floating-point number:wantedBreadth}:
    execute:
        set batchCount to the length of (canvas's batches's values)
        set chosen to batchCount - 1
        loop batchCursor from 0 to batchCount:
            set backwards to (batchCount - 1) - batchCursor
            set candidate to the item at backwards in (canvas's batches's values)
            if (candidate's stroked) and ((the absolute value of (candidate's breadth - wantedBreadth)) < 0.000001):
                set chosen to backwards
        return the item at chosen in (canvas's batches's values)

# A canvas on paper, `unitsPerMm` units to the paper millimetre, or (0) on
# screen.
function a new paper dash canvas of {a 64 bit floating-point number:unitsPerMm} units to the millimetre:
    execute:
        set made to a new bim canvas
        if unitsPerMm > 0.0:
            set made's paperScale to unitsPerMm
        return made

set editor to a new bim editor
set modelTarget to the address of (editor's documentValue's current)
# Two roof planes meeting at a ridge 5 m up the plan, 1 m long; south runs
# the ridge +x, north -x.
set roofLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.2)) to roofLayers
set roofType to add bim planar type named (the string form of "Roof 200") as role bim roof planar role with roofLayers to modelTarget
free roofLayers
set southOutline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to southOutline
append (a cad vector2 with x 1.0 and y 0.0) to southOutline
append (a cad vector2 with x 1.0 and y 5.0) to southOutline
append (a cad vector2 with x 0.0 and y 5.0) to southOutline
set southId to add bim plate typed roofType on editor's levelId around southOutline at top 3.0 to modelTarget
set northOutline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 5.0) to northOutline
append (a cad vector2 with x 1.0 and y 5.0) to northOutline
append (a cad vector2 with x 1.0 and y 10.0) to northOutline
append (a cad vector2 with x 0.0 and y 10.0) to northOutline
set northId to add bim plate typed roofType on editor's levelId around northOutline at top 3.0 to modelTarget
free southOutline
free northOutline
# A beam 2.8 m up, above the cut, along y = -3 m from x = 3 to 7 m.
set beamType to add bim linear type named (the string form of "Beam") as role (bim beam role) sized 0.2 by 0.4 round false of (the string form of "steel") to modelTarget
set beamId to add bim linear typed beamType on editor's levelId from (a cad vector3 with x 3.0, y -3.0 and z 2.8) to (a cad vector3 with x 7.0, y -3.0 and z 2.8) turned 0.0 to modelTarget
# A stair, its upper treads above the cut.
set stairId to add bim stair on editor's levelId from (a cad vector2 with x 10.0 and y 0.0) to (a cad vector2 with x 13.5 and y 0.0) wide 1.0 in 16 risers of (the string form of "timber") to modelTarget
# A section 6 m along y = -6 m.
set sectionId to add bim section view from (a cad vector2 with x 0.0 and y -6.0) to (a cad vector2 with x 6.0 and y -6.0) to modelTarget
refresh bim editor (the address of editor)

# The hidden pen on paper: 0.18 mm.
set hiddenBreadth to (the bim paper width of pen (bim hidden pen))
# 1:50 and 1:100 on a canvas in millimetres, and 1:100 again in the points
# (72 to the inch) a sheet records in, read back in millimetres.
set scales to [50.0, 100.0, 100.0]
set unitScales to an empty list of a 64 bit floating-point number
append 1.0 to unitScales
append 1.0 to unitScales
append (72.0 / 25.4) to unitScales
loop scaleCursor from 0 to 3:
    set drawingScale to the item at scaleCursor in scales
    set unitsPerMm to the item at scaleCursor in unitScales
    set scaleName to (the string form of "1:") + (the string form of (drawingScale as an integer))
    if scaleCursor = 2:
        set scaleName to scaleName + (the string form of " in points")
    # Model metres to paper units at the drawing scale.
    set transform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), (1000.0 / drawingScale) * unitsPerMm)
    set ridgeY to 0.0 - ((5000.0 / drawingScale) * unitsPerMm)
    set roofCanvas to a new paper dash canvas of unitsPerMm units to the millimetre
    record bim slab edges of editor through transform on (the address of roofCanvas)
    set southPieces to the paper pieces of (the item at 0 in (roofCanvas's batches's values)) on y ridgeY per unitsPerMm
    set northPieces to the paper pieces of (the item at 1 in (roofCanvas's batches's values)) on y ridgeY per unitsPerMm
    print ((scaleName + (the string form of " south ridge (mm):")) + southPieces) as a line
    print ((scaleName + (the string form of " north ridge (mm):")) + northPieces) as a line
    check paper dashes (southPieces = northPieces) named (scaleName + (the string form of ": both planes lay the ridge's dashes in phase"))
    check paper dashes ((the paper gaps of (the item at 0 in (roofCanvas's batches's values)) per unitsPerMm) = (the string form of "1.50-1.50")) named (scaleName + (the string form of ": the roof's edges have 1.5 mm gaps"))
    set beamCanvas to a new paper dash canvas of unitsPerMm units to the millimetre
    draw bim linears in plan of editor through transform on (the address of beamCanvas)
    set beamBatch to the paper batch of beamCanvas wide (hiddenBreadth * unitsPerMm)
    # Its northern edge, at y = -2.9 m (canvas y runs down).
    set beamPieces to the paper pieces of beamBatch on y ((2.9 * (1000.0 / drawingScale)) * unitsPerMm) per unitsPerMm
    print ((scaleName + (the string form of " beam edge (mm):")) + beamPieces) as a line
    check paper dashes ((the absolute value of (((the longest paper piece of beamBatch) / unitsPerMm) - 3.0)) < 0.0001) named (scaleName + (the string form of ": the beam above the cut is dashed 3 mm"))
    check paper dashes ((the paper gaps of beamBatch per unitsPerMm) = (the string form of "1.50-1.50")) named (scaleName + (the string form of ": the beam's dashes have 1.5 mm gaps"))
    set stairCanvas to a new paper dash canvas of unitsPerMm units to the millimetre
    draw bim stairs in plan of editor through transform on (the address of stairCanvas)
    set stairBatch to the paper batch of stairCanvas wide (hiddenBreadth * unitsPerMm)
    set stairGaps to the paper gaps of stairBatch per unitsPerMm
    print ((scaleName + (the string form of " longest stair dash (mm): ")) + ((the paper dash text of ((the longest paper piece of stairBatch) / unitsPerMm)) + ((the string form of ", gaps ") + stairGaps))) as a line
    check paper dashes ((the absolute value of (((the longest paper piece of stairBatch) / unitsPerMm) - 3.0)) < 0.0001) named (scaleName + (the string form of ": the treads above the cut are dashed 3 mm"))
    check paper dashes (stairGaps = (the string form of "1.50-1.50")) named (scaleName + (the string form of ": the treads' dashes have 1.5 mm gaps"))
    # The section line between its heavy ends: the chain line.
    set sectionCanvas to a new paper dash canvas of unitsPerMm units to the millimetre
    draw bim section marks in plan of editor through transform on (the address of sectionCanvas)
    set chainBatch to the item at 0 in (sectionCanvas's batches's values)
    print ((scaleName + (the string form of " section line (mm):")) + (the paper pieces of chainBatch on y ((6.0 * (1000.0 / drawingScale)) * unitsPerMm) per unitsPerMm)) as a line
    check paper dashes ((the absolute value of (((the longest paper piece of chainBatch) / unitsPerMm) - 12.0)) < 0.0001) named (scaleName + (the string form of ": the section line's long dashes are 12 mm"))
    check paper dashes ((the absolute value of (((the shortest paper piece of chainBatch) / unitsPerMm) - 0.5)) < 0.0001) named (scaleName + (the string form of ": its dots are 0.5 mm"))
    check paper dashes ((the paper gaps of chainBatch per unitsPerMm) = (the string form of "1.50-1.50")) named (scaleName + (the string form of ": its gaps are 1.5 mm"))

# On screen the dashes keep their pixels: 8 for a roof, 6 for a beam, 5 for
# a stair (100 pixels to the metre).
set screenTransform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 100.0)
set screenRoof to a new paper dash canvas of 0.0 units to the millimetre
record bim slab edges of editor through screenTransform on (the address of screenRoof)
print ((the string form of "screen south ridge (pixels):") + (the paper pieces of (the item at 0 in (screenRoof's batches's values)) on y -500.0 per 1.0)) as a line
set screenBeam to a new paper dash canvas of 0.0 units to the millimetre
draw bim linears in plan of editor through screenTransform on (the address of screenBeam)
set screenBeamBatch to the paper batch of screenBeam wide 1.0
check paper dashes ((the absolute value of ((the longest paper piece of screenBeamBatch) - 6.0)) < 0.0001) named (the string form of "on screen the beam keeps 6 pixel dashes")
set screenStair to a new paper dash canvas of 0.0 units to the millimetre
draw bim stairs in plan of editor through screenTransform on (the address of screenStair)
set screenStairBatch to the item at 1 in (screenStair's batches's values)
check paper dashes ((the absolute value of ((the longest paper piece of screenStairBatch) - 5.0)) < 0.0001) named (the string form of "on screen the treads keep 5 pixel dashes")
free unitScales
