# SPDX-License-Identifier: MPL-2.0
# An area plan leaves door and window tags and the building's dimensions
# out.
#
# A wall with a window, the window tagged, and one dimension from the
# wall's start to the window's left edge. A plan of the Floor plan type
# shows the tag and the dimension. The same plan given the Area plan type,
# which draws the NEN 2580 areas and switches door and window tags off,
# shows neither; a chain between two grids stays in both.
import ui/panels/bim_plan_panel.dl

function check area plan {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
        else:
            print ((the string form of "PASS: ") + label) as a line

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.16)) to layerValues
set wallType to add bim wall type named (the string form of "CLT 160") with layerValues to target
set southWall to add bim wall typed wallType on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
set windowId to add bim opening typed windowType in southWall at 3.0 to target
ignore (add bim tag of windowId at (a cad vector2 with x 3.0 and y 0.6) to target)
ignore (add bim dimension from (@intrinsic("construct", a bim reference record, southWall, bim wall start feature)) to (@intrinsic("construct", a bim reference record, windowId, bim opening left feature)) to target)
set firstGrid to add bim grid named (the string form of "1") from (a cad vector2 with x 0.0 and y -1.0) to (a cad vector2 with x 0.0 and y 1.0) reaching 0.0 to 3.0 to target
set secondGrid to add bim grid named (the string form of "2") from (a cad vector2 with x 6.0 and y -1.0) to (a cad vector2 with x 6.0 and y 1.0) reaching 0.0 to 3.0 to target
ignore (add bim dimension from (@intrinsic("construct", a bim reference record, firstGrid, bim grid line feature)) to (@intrinsic("construct", a bim reference record, secondGrid, bim grid line feature)) to target)
set planView to add bim view of kind (bim plan view) named (the string form of "Plan") on editor's levelId to target
set editor's planViewId to planView
refresh bim editor (the address of editor)
set transform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 100.0)
ensure bim drawing types in target
set typeNames to [the string form of "Floor plan", the string form of "Area plan"]
loop typeCursor from 0 to 2:
    set planType to the bim drawing type named (the item at typeCursor in typeNames) in editor's documentValue's current
    set viewValue to the item at (the bim view index of planView in editor's documentValue's current)'s position in (editor's documentValue's current's views's values)
    set viewValue's drawingTypeId to planType
    store bim view viewValue in target
    set shownDimensions to the bim storey dimensions of editor
    set tagCanvas to a new bim canvas
    draw bim tags in plan of editor through transform on (the address of tagCanvas)
    set summary to (the item at typeCursor in typeNames) + (the string form of ": dimensions ")
    set summary to (summary + (the string form of (the length of shownDimensions))) + (the string form of ", tag texts ")
    print (summary + (the string form of (the length of (tagCanvas's texts's values)))) as a line
    if typeCursor = 0:
        check area plan ((the length of shownDimensions) = 2) named (the string form of "a floor plan shows the wall's dimension and the grids'")
        check area plan ((the length of (tagCanvas's texts's values)) = 1) named (the string form of "a floor plan shows the window's tag")
    else:
        check area plan ((the length of shownDimensions) = 1) named (the string form of "an area plan keeps only the chain between the grids")
        check area plan ((the length of (tagCanvas's texts's values)) = 0) named (the string form of "an area plan shows no window tag")
    free shownDimensions
