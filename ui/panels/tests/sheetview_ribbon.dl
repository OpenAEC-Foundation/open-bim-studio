# SPDX-License-Identifier: MPL-2.0
# Sheetviews in the editor (#135): the View tab's Sheets group is called
# Sheetviews and holds a Sheetview chooser (a new book, its contents page,
# its PDF, and Add page, Page earlier, Page later, Remove page); Export
# offers the open sheetview as one PDF book. New sheetview makes a book with
# its first page and opens it; the pages are added, moved and removed from
# the commands, each one undoable edit, and a page's context menu offers
# them. A sheet in no book keeps its menu as before.
import ui/panels/bim_ui.dl

function check sheetview ribbon {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The titles of `groups`, each with its buttons' labels and commands.
function show sheetview ribbon groups {a pointer to a list:groups}:
    execute:
        loop groupCursor from 0 to the length of groups:
            set ribbonGroup to the item at groupCursor in groups
            set shown to ribbonGroup's title + (the string form of ":")
            loop buttonCursor from 0 to the length of (ribbonGroup's buttons):
                set ribbonButton to the item at buttonCursor in (ribbonGroup's buttons)
                set shown to (((shown + (the string form of " ")) + ribbonButton's label) + (the string form of "=")) + (the string form of ribbonButton's command)
            print shown as a line

# Whether the context menu offers a command sending `wanted`.
function the sheetview menu of {bim editor record:editor} sends {integer:wanted}:
    execute:
        set offered to false
        set rows to the bim context entries of editor
        loop rowCursor from 0 to the length of rows:
            set row to the item at rowCursor in rows
            if (row's kind = bim context command) and (row's command = wanted):
                set offered to true
        free rows
        return offered

# The pages of the book of the open sheet, by number and name.
function show sheetview pages of {bim editor record:editor}:
    execute:
        set modelValue to editor's documentValue's current
        set pageIds to the bim book pages of sheet editor's sheetId in modelValue
        set shown to the string form of "pages:"
        loop pageCursor from 0 to the length of pageIds:
            set pageFound to the bim sheet index of (the item at pageCursor in pageIds) in modelValue
            set pageSheet to the item at pageFound's position in (modelValue's sheets's values)
            set shown to (shown + (the string form of " ")) + pageSheet's number
            if pageSheet's id = editor's sheetId:
                set shown to shown + (the string form of "*")
        free pageIds
        print shown as a line

# The View tab's Sheetviews group, and what its chooser and Export hold.
set viewGroups to the bim ribbon groups of tab 4
loop groupCursor from 0 to the length of viewGroups:
    set viewGroup to the item at groupCursor in viewGroups
    if viewGroup's title = (the string form of "Sheetviews"):
        set oneGroup to an empty list of a bim ribbon group record
        append viewGroup to oneGroup
        show sheetview ribbon groups oneGroup
        free oneGroup
check sheetview ribbon ((the bim chooser of command ((bim ui chooser command) + (bim sheetview chooser))) = bim sheetview chooser) named (the string form of "Sheetview opens its chooser")
check sheetview ribbon ((the bim chooser (bim sheetview chooser) is a family) = false) named (the string form of "which is no family menu")
free viewGroups
set chooserGroups to the bim chooser groups of (bim sheetview chooser)
show sheetview ribbon groups chooserGroups
free chooserGroups
set exportGroups to the bim chooser groups of (bim export chooser)
show sheetview ribbon groups exportGroups
free exportGroups

set editor to a new bim editor
set e to the address of editor

# A page command with no book open says how to make one.
type bim editor key 2283 in e
print ((the string form of "message: ") + editor's message) as a line

type bim editor key 2282 in e
show sheetview pages of editor
print ((the string form of "message: ") + editor's message) as a line
set bookId to the bim sheetview of sheet editor's sheetId in editor's documentValue's current
check sheetview ribbon (bookId != the bim refused id) named (the string form of "New sheetview opens the first page of a new book")
set firstPage to editor's sheetId
type bim editor key 2283 in e
type bim editor key 2283 in e
show sheetview pages of editor
type bim editor key 2284 in e
show sheetview pages of editor
check sheetview ribbon (undo bim transaction in (the address of (editor's documentValue))) named (the string form of "moving a page is one undoable edit")
set editor's sheetId to firstPage
show sheetview pages of editor
type bim editor key 2284 in e
print ((the string form of "message: ") + editor's message) as a line
type bim editor key 2287 in e
show sheetview pages of editor
type bim editor key 2287 in e
print ((the string form of "message: ") + editor's message) as a line

# The page's context menu offers the page commands; a sheet alone does not.
set editor's propertiesViewId to bim sheet properties context
check sheetview ribbon ((the sheetview menu of editor sends 2283) and (the sheetview menu of editor sends 2286)) named (the string form of "a page's menu offers Add page and Remove page")
check sheetview ribbon (the sheetview menu of editor sends 2288) named (the string form of "and the PDF book")

# Remove page opens the next page; undo brings it back.
set editor's sheetId to firstPage
type bim editor key 2286 in e
show sheetview pages of editor
check sheetview ribbon ((the bim sheet index of firstPage in editor's documentValue's current)'s valid = false) named (the string form of "Remove page deletes the page")
check sheetview ribbon (undo bim transaction in (the address of (editor's documentValue))) named (the string form of "removing is one undoable edit")
set editor's sheetId to firstPage
show sheetview pages of editor

type bim editor key 2095 in e
show sheetview pages of editor
check sheetview ribbon ((the sheetview menu of editor sends 2283) = false) named (the string form of "a sheet alone offers no page commands")
check sheetview ribbon ((the length of (the bim sheetview fault in editor's documentValue's current)) = 0) named (the string form of "the books stay sound")
