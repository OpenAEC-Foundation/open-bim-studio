# SPDX-License-Identifier: MPL-2.0
# Exterior dimension chains per facade (2461), drawn on paper. A 9 x 6 m box
# of 300 mm walls on their centrelines whose south facade is two walls in
# line, split at x = 4 where an inner wall meets it, with a second inner
# wall at x = 4.5 (200 mm). The south facade gets one walls chain and one
# overall dimension corner to corner (9300), not one per wall. On paper the
# chains lie 8, 14 and 20 mm off the outer face at 1:100 and at 1:50 alike,
# the extension lines starting 1.5 mm off the face and running 2 mm past
# the outermost line; the short steps at the inner walls (300, 250 and 200:
# 3, 2.5 and 2 mm at 1:100) have their values beside the line (past the
# end, before the start) or, with no room there, on a leader (on the
# inner side when the outer one would put them by the overall chain's
# line), no two overlapping. The paper offsets survive .bim and IfcX.
import ui/panels/bim_plan_panel.dl

function check facade dimensions {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# `amount` to hundredths, as "18.75".
function the facade test text of {a 64 bit floating-point number:amount}:
    execute:
        set hundredths to (the floor of (((the absolute value of amount) * 100.0) + 0.5)) as a 64 bit integer
        set sign to the string form of ""
        if (amount < 0.0) and (hundredths > (0 as a 64 bit integer)):
            set sign to the string form of "-"
        set fraction to the string form of (the remainder of hundredths divided by (100 as a 64 bit integer))
        if (the length of fraction) < 2:
            set fraction to (the string form of "0") + fraction
        return ((sign + (the string form of (hundredths / (100 as a 64 bit integer)))) + (the string form of ".")) + fraction

function the facade test measures of {bim model record:modelValue}:
    execute:
        set index to the bim join index of modelValue
        set measureLine to the string form of "measures:"
        loop cursor from 0 to the length of (modelValue's dimensions's values):
            set measured to the bim measure of (the item at cursor in (modelValue's dimensions's values)) in modelValue using index
            if measured's valid:
                set measureLine to (measureLine + (the string form of " ")) + (the bim millimetre text of measured's value)
            else:
                set measureLine to measureLine + (the string form of " invalid")
        return measureLine

function the facade test offsets of {bim model record:modelValue}:
    execute:
        set offsetLine to the string form of "paper offsets:"
        loop cursor from 0 to the length of (modelValue's dimensions's values):
            set offsetLine to (offsetLine + (the string form of " ")) + (the facade test text of ((the item at cursor in (modelValue's dimensions's values))'s paperOffset))
        return offsetLine

# The plan's dimensions drawn on paper (a canvas unit a millimetre) through
# plan view `viewId`, the model origin at the paper origin.
function the facade test drawing of {bim editor record:editor} through view {a 64 bit integer:viewId} at {a 64 bit floating-point number:denominator}:
    execute:
        set shown to editor
        set shown's planViewId to viewId
        set sheet to a new bim canvas
        set sheet's paperScale to 1.0
        set transform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 1000.0 / denominator)
        draw bim dimensions in plan of shown through transform on (the address of sheet)
        return sheet

# How far below the south face (paper y 0.15 m down) the extension lines
# at the outer corners (x = -0.15 and 9.15 m; the first batch, which also
# holds the dimension lines and any value's leader) reach: nearest and
# furthest.
function the facade test reach of {bim canvas record:sheet} at {a 64 bit floating-point number:denominator} furthest {boolean:wantFurthest}:
    execute:
        set facePaper to 150.0 / denominator
        set westPaper to 0.0 - (150.0 / denominator)
        set eastPaper to 9150.0 / denominator
        set nearestSoFar to 1000.0
        set furthestSoFar to 0.0
        set batch to the item at 0 in (sheet's batches's values)
        loop cornerCursor from 0 to the length of (batch's pixels's values):
            set corner to the item at cornerCursor in (batch's pixels's values)
            if (((the absolute value of (corner's x - westPaper)) < 0.5) or ((the absolute value of (corner's x - eastPaper)) < 0.5)) and (corner's y > facePaper):
                set nearestSoFar to the minimum of nearestSoFar and (corner's y - facePaper)
                set furthestSoFar to the maximum of furthestSoFar and (corner's y - facePaper)
        if wantFurthest:
            return furthestSoFar
        return nearestSoFar

# The values lettered south of the plan, in the order drawn, with where
# they stand on paper.
function show facade test south values of {bim canvas record:sheet} titled {a string:title}:
    execute:
        print title as a line
        loop cursor from 0 to the length of (sheet's texts's values):
            set label to the item at cursor in (sheet's texts's values)
            if (label's y > 0.0) and (label's x < 90.0):
                print ((((the string form of "  ") + label's message) + (the string form of " at ")) + (((the facade test text of label's x) + (the string form of ", ")) + (the facade test text of label's y))) as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
begin bim transaction in (the address of (editor's documentValue))
set layers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.3)) to layers
set outerType to add bim wall type named (the string form of "Outer 300") with layers to target
free layers
set innerLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "sand-lime", 0.2)) to innerLayers
set innerType to add bim wall type named (the string form of "Inner 200") with innerLayers to target
free innerLayers
ignore add bim wall typed outerType on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to target
ignore add bim wall typed outerType on editor's levelId from (a cad vector2 with x 4.0 and y 0.0) to (a cad vector2 with x 9.0 and y 0.0) to target
ignore add bim wall typed outerType on editor's levelId from (a cad vector2 with x 9.0 and y 0.0) to (a cad vector2 with x 9.0 and y 6.0) to target
ignore add bim wall typed outerType on editor's levelId from (a cad vector2 with x 9.0 and y 6.0) to (a cad vector2 with x 0.0 and y 6.0) to target
ignore add bim wall typed outerType on editor's levelId from (a cad vector2 with x 0.0 and y 6.0) to (a cad vector2 with x 0.0 and y 0.0) to target
ignore add bim wall typed outerType on editor's levelId from (a cad vector2 with x 4.0 and y 0.0) to (a cad vector2 with x 4.0 and y 6.0) to target
ignore add bim wall typed innerType on editor's levelId from (a cad vector2 with x 4.5 and y 0.0) to (a cad vector2 with x 4.5 and y 3.0) to target
set hundredView to add bim view of kind (bim plan view) named (the string form of "Plan 1:100") on editor's levelId to target
set fiftyView to add bim view of kind (bim plan view) named (the string form of "Plan 1:50") on editor's levelId to target
ignore set bim view hundredView scale to 100 and display to 0 in target
ignore set bim view fiftyView scale to 50 and display to 0 in target
commit bim transaction in (the address of (editor's documentValue))
type bim editor key 2461 in e
print editor's message as a line
set modelValue to editor's documentValue's current
print (the facade test measures of modelValue) as a line
print (the facade test offsets of modelValue) as a line

# One overall dimension per facade: 9300 twice (south and north), 6300
# twice (east and west), no 4150 or 5150 of a south wall on its own.
set wholeCount to 0
set partCount to 0
set index to the bim join index of modelValue
loop cursor from 0 to the length of (modelValue's dimensions's values):
    set measured to the bim measure of (the item at cursor in (modelValue's dimensions's values)) in modelValue using index
    if (the absolute value of (measured's value - 9.3)) < 1e-6:
        set wholeCount to wholeCount + 1
    if ((the absolute value of (measured's value - 4.15)) < 1e-6) or ((the absolute value of (measured's value - 5.15)) < 1e-6):
        set partCount to partCount + 1
check facade dimensions ((wholeCount = 2) and (partCount = 0)) named (the string form of "the south facade of two walls in line has one overall dimension")

# The chains in the model at 1:100 and at 1:50: the same 20 mm on paper.
set southWhole to the item at 0 in (modelValue's dimensions's values)
loop cursor from 0 to the length of (modelValue's dimensions's values):
    set candidate to the item at cursor in (modelValue's dimensions's values)
    if (candidate's paperOffset = 20.0) and (candidate's place's y < 0.0):
        set southWhole to candidate
set atHundred to the bim dimension line of southWhole in modelValue using index at drawing scale 100.0
set atFifty to the bim dimension line of southWhole in modelValue using index at drawing scale 50.0
print ((the string form of "south overall line in the model: ") + (((the facade test text of (0.0 - (atHundred's start's y + 0.15))) + (the string form of " m off the face at 1:100, ")) + ((the facade test text of (0.0 - (atFifty's start's y + 0.15))) + (the string form of " m at 1:50")))) as a line
print ((the string form of "south overall extension feet: ") + ((the facade test text of atHundred's startFoot's y) + ((the string form of ", ") + (the facade test text of atFifty's finishFoot's y)))) as a line

set hundredSheet to the facade test drawing of editor through view hundredView at 100.0
set fiftySheet to the facade test drawing of editor through view fiftyView at 50.0
set hundredNear to the facade test reach of hundredSheet at 100.0 furthest false
set hundredFar to the facade test reach of hundredSheet at 100.0 furthest true
set fiftyNear to the facade test reach of fiftySheet at 50.0 furthest false
set fiftyFar to the facade test reach of fiftySheet at 50.0 furthest true
print ((the string form of "on paper at 1:100: strokes from ") + (((the facade test text of hundredNear) + (the string form of " to ")) + ((the facade test text of hundredFar) + (the string form of " mm off the face")))) as a line
print ((the string form of "on paper at 1:50: strokes from ") + (((the facade test text of fiftyNear) + (the string form of " to ")) + ((the facade test text of fiftyFar) + (the string form of " mm off the face")))) as a line
check facade dimensions (((the absolute value of (hundredFar - fiftyFar)) < 1e-6) and ((the absolute value of (hundredFar - 22.0)) < 1e-6)) named (the string form of "the outer chain lies 20 mm off the face on paper at 1:100 and 1:50, its extension lines 2 mm past it")
check facade dimensions (((the absolute value of (hundredNear - 1.5)) < 1e-6) and ((the absolute value of (fiftyNear - 1.5)) < 1e-6)) named (the string form of "extension lines start 1.5 mm off the face")
show facade test south values of hundredSheet titled (the string form of "south values at 1:100 (x, y on paper):")

# The walls chain's short steps at 1:100: 300 (38.5 to 41.5 mm on paper),
# 250 (to 44) and 200 (to 46). Each value stands outside its segment; the
# last finds both ends taken, and the overall 9300 over its outer side, and
# stands further out with a leader. No two values overlap.
set movedCount to 0
loop cursor from 0 to the length of (hundredSheet's texts's values):
    set label to the item at cursor in (hundredSheet's texts's values)
    if (label's y > 0.0) and (label's x < 90.0):
        set shortStep to false
        set stepLow to 0.0
        set stepHigh to 0.0
        if label's message = (the string form of "300"):
            set shortStep to true
            set stepLow to 38.5
            set stepHigh to 41.5
        if label's message = (the string form of "250"):
            set shortStep to true
            set stepLow to 41.5
            set stepHigh to 44.0
        if label's message = (the string form of "200"):
            set shortStep to true
            set stepLow to 44.0
            set stepHigh to 46.0
        if shortStep:
            if (label's x < stepLow) or (label's x > stepHigh):
                set movedCount to movedCount + 1
check facade dimensions (movedCount = 3) named (the string form of "short segments have their values beside them")
set overlapCount to 0
loop cursor from 0 to the length of (hundredSheet's texts's values):
    loop otherCursor from (cursor + 1) to the length of (hundredSheet's texts's values):
        if bim lettering box (the bim lettering box of (the item at cursor in (hundredSheet's texts's values)) on hundredSheet) overlaps (the bim lettering box of (the item at otherCursor in (hundredSheet's texts's values)) on hundredSheet):
            set overlapCount to overlapCount + 1
check facade dimensions (overlapCount = 0) named (the string form of "no two values overlap")

# Kept through .bim and IfcX.
set native to the bim model parsed from (the bim file text of modelValue)
print ((the string form of "from .bim: ") + (the facade test offsets of native's modelValue)) as a line
save bim editor to (the string form of "build/facade-dimensions-test.ifcxb") in e
set other to a new bim editor
open bim editor from (the string form of "build/facade-dimensions-test.ifcxb") in (the address of other)
print ((the string form of "from .ifcxb: ") + (the facade test offsets of other's documentValue's current)) as a line
