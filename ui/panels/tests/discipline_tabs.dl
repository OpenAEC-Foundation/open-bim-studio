# SPDX-License-Identifier: MPL-2.0
# The ribbon follows a discipline: Common 3D shows the tabs every discipline
# uses, MEP adds the MEP tab, Structural adds Concrete+Rebar, Structural
# Steel, Wood/Steel Framing and Fabrication. The Discipline menu lists the
# five disciplines; each row sends its command.
import ui/panels/bim_ui.dl

function check discipline tabs {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The names of the tabs `discipline` shows, joined by commas.
function the discipline tab list of {integer:discipline}:
    execute:
        set names to the bim ribbon tab names
        set listed to the string form of ""
        loop tabCursor from 0 to the length of names:
            if the bim ribbon tab tabCursor shows under discipline:
                if (the length of listed) > 0:
                    set listed to listed + (the string form of ", ")
                set listed to listed + (the item at tabCursor in names)
        free names
        return listed

loop disciplineCursor from 0 to bim discipline count:
    print (((the bim name of ribbon discipline disciplineCursor) + (the string form of ": ")) + (the discipline tab list of disciplineCursor)) as a line

check discipline tabs ((the bim ribbon tab 0 shows under (bim common discipline)) and (the bim ribbon tab 4 shows under (bim civil discipline))) named (the string form of "Home and View show under every discipline")
check discipline tabs (((the bim ribbon tab 1 shows under (bim mep discipline)) and ((the bim ribbon tab 1 shows under (bim structural discipline)) = false))) named (the string form of "MEP shows under MEP only")
check discipline tabs ((the bim ribbon tab 7 shows under (bim structural discipline)) and ((the bim ribbon tab 10 shows under (bim architectural discipline)) = false)) named (the string form of "Concrete+Rebar to Fabrication show under Structural only")
check discipline tabs ((the bim chooser of command ((bim ui chooser command) + (bim discipline chooser))) = bim discipline chooser) named (the string form of "The Discipline menu is a chooser")

set menuGroups to the bim chooser groups of (bim discipline chooser)
set menuButtons to (the item at 0 in menuGroups)'s buttons
check discipline tabs ((the length of menuButtons) = bim discipline count) named (the string form of "The menu lists five disciplines")
check discipline tabs ((the item at 2 in menuButtons)'s command = ((bim discipline command) + (bim structural discipline))) named (the string form of "Structural sends its command")
check discipline tabs (((the item at 2 in menuButtons)'s label) = (the string form of "Structural")) named (the string form of "Structural is named")

set fabrication to the bim ribbon groups of tab 10
check discipline tabs ((the length of fabrication) = 3) named (the string form of "Fabrication holds schedules, fasteners and production")
