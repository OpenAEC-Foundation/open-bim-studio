# SPDX-License-Identifier: MPL-2.0
# Walls that meet read as one mass in the cut: where one wall's cut touches
# another's along a line, neither outline draws it (drawing-quality plan,
# item 11). At a T junction the through-wall's inner face line stops at the
# branch's faces and the branch's end line is gone; at an L corner made as a
# butt the through-wall's inner face starts past the other wall; at a mitred
# L corner the mitre line is gone. Each wall's drawn edge pieces are counted
# and measured, and the plan's outline strokes counted on a canvas.
import ui/panels/bim_plan_panel.dl

function check junction {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The drawn pieces of wall `wallId`'s cut in `viewValue`, in pairs, as `draw
# bim hatched cut faces of` draws them.
function the junction test drawing of {a 64 bit integer:wallId} in {bim view record:viewValue} among {a pointer to a list:edgeList} by {a pointer to a list:ownerList}:
    execute:
        set drawn to an empty list of a cad vector2
        loop sourceCursor from 0 to the length of (viewValue's sources's values):
            set source to the item at sourceCursor in (viewValue's sources's values)
            if source's id = wallId:
                loop polygonCursor from 0 to the length of (source's polygons's values):
                    set ringCorners to (the item at polygonCursor in (source's polygons's values))'s points's values
                    set cornerCount to the length of ringCorners
                    set leftward to bim corners ringCorners turn anticlockwise
                    loop cornerCursor from 0 to cornerCount:
                        set cornerHere to the item at cornerCursor in ringCorners
                        set cornerNext to the item at (the remainder of (cornerCursor + 1) divided by cornerCount) in ringCorners
                        append bim uncovered parts of wall edge from cornerHere to cornerNext walled left leftward of owner sourceCursor among edgeList by ownerList into drawn
        return drawn

function the junction test count of {a pointer to a list:drawnPairs}:
    execute:
        return (the length of drawnPairs) / 2

# How many of the drawn pieces lie on the line y = `lineY`, and their total
# length in millimetres.
function the junction test count of {a pointer to a list:drawnPairs} along y {a 64 bit floating-point number:lineY}:
    execute:
        set found to 0
        set pairCursor to 0
        loop while pairCursor < the length of drawnPairs:
            set pieceStart to the item at pairCursor in drawnPairs
            set pieceEnd to the item at (pairCursor + 1) in drawnPairs
            if ((the absolute value of (pieceStart's y - lineY)) < 0.0001) and ((the absolute value of (pieceEnd's y - lineY)) < 0.0001):
                set found to found + 1
            set pairCursor to pairCursor + 2
        return found

function the junction test millimetres of {a pointer to a list:drawnPairs} along y {a 64 bit floating-point number:lineY}:
    execute:
        set total to 0.0
        set pairCursor to 0
        loop while pairCursor < the length of drawnPairs:
            set pieceStart to the item at pairCursor in drawnPairs
            set pieceEnd to the item at (pairCursor + 1) in drawnPairs
            if ((the absolute value of (pieceStart's y - lineY)) < 0.0001) and ((the absolute value of (pieceEnd's y - lineY)) < 0.0001):
                set total to total + (the cad distance from pieceStart to pieceEnd)
            set pairCursor to pairCursor + 2
        return (@intrinsic("call", "libc", "round", a 64 bit floating-point number, total * 1000.0)) as a 64 bit integer

# Whether a piece on the line y = `lineY` runs over x = `crossX`.
function the junction test drawing {a pointer to a list:drawnPairs} passes x {a 64 bit floating-point number:crossX} along y {a 64 bit floating-point number:lineY}:
    execute:
        set passing to false
        set pairCursor to 0
        loop while pairCursor < the length of drawnPairs:
            set pieceStart to the item at pairCursor in drawnPairs
            set pieceEnd to the item at (pairCursor + 1) in drawnPairs
            if ((the absolute value of (pieceStart's y - lineY)) < 0.0001) and ((the absolute value of (pieceEnd's y - lineY)) < 0.0001):
                set lowX to the minimum of pieceStart's x and pieceEnd's x
                set highX to the maximum of pieceStart's x and pieceEnd's x
                if (lowX < crossX) and (highX > crossX):
                    set passing to true
            set pairCursor to pairCursor + 2
        return passing

# The covering rule on its own: an edge along x from 0 to 10 with its wall
# on its left (above), against edges of other walls on the same line.
set lineEdges to an empty list of a cad vector2
set lineOwners to an empty list of an integer
# Another wall below, over 2 to 4: covers.
append (a cad vector2 with x 4.0 and y 0.0) to lineEdges
append (a cad vector2 with x 2.0 and y 0.0) to lineEdges
append 1 to lineOwners
# Another wall below, over 8 to 12: covers 8 to 10.
append (a cad vector2 with x 12.0 and y 0.0) to lineEdges
append (a cad vector2 with x 8.0 and y 0.0) to lineEdges
append 1 to lineOwners
# Another wall above, on the same side, over 5 to 6: does not cover.
append (a cad vector2 with x 5.0 and y 0.0) to lineEdges
append (a cad vector2 with x 6.0 and y 0.0) to lineEdges
append 2 to lineOwners
# The wall's own edge below, over 6 to 7: does not cover.
append (a cad vector2 with x 7.0 and y 0.0) to lineEdges
append (a cad vector2 with x 6.0 and y 0.0) to lineEdges
append 0 to lineOwners
# Another wall below, a millimetre off the line: does not cover.
append (a cad vector2 with x 1.5 and y 0.001) to lineEdges
append (a cad vector2 with x 0.5 and y 0.001) to lineEdges
append 3 to lineOwners
set lineDrawn to an empty list of a cad vector2
append bim uncovered parts of wall edge from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 10.0 and y 0.0) walled left true of owner 0 among lineEdges by lineOwners into lineDrawn
check junction ((the junction test count of lineDrawn) = 2) named (the string form of "an edge covered twice from below is drawn in two pieces")
check junction (((the item at 0 in lineDrawn)'s x = 0.0) and ((the item at 1 in lineDrawn)'s x = 2.0)) named (the string form of "the first piece runs from 0 to 2")
check junction (((the item at 2 in lineDrawn)'s x = 4.0) and ((the item at 3 in lineDrawn)'s x = 8.0)) named (the string form of "the second from 4 to 8, the cover past its end clipped")
set flippedDrawn to an empty list of a cad vector2
append bim uncovered parts of wall edge from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 10.0 and y 0.0) walled left false of owner 0 among lineEdges by lineOwners into flippedDrawn
check junction ((the junction test count of flippedDrawn) = 2) named (the string form of "the same edge with its wall below is covered only from above")
check junction (((the item at 1 in flippedDrawn)'s x = 5.0) and ((the item at 2 in flippedDrawn)'s x = 6.0)) named (the string form of "it is drawn but for 5 to 6")
set wholeEdges to an empty list of a cad vector2
set wholeOwners to an empty list of an integer
append (a cad vector2 with x 10.0 and y 0.0) to wholeEdges
append (a cad vector2 with x 0.0 and y 0.0) to wholeEdges
append 1 to wholeOwners
set wholeDrawn to an empty list of a cad vector2
append bim uncovered parts of wall edge from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 10.0 and y 0.0) walled left true of owner 0 among wholeEdges by wholeOwners into wholeDrawn
check junction ((the junction test count of wholeDrawn) = 0) named (the string form of "an edge two walls share exactly is not drawn")
free lineEdges
free lineOwners
free lineDrawn
free flippedDrawn
free wholeEdges
free wholeOwners
free wholeDrawn

# Walls of 200 mm, their cut faces 100 mm either side of their lines.
set editor to a new bim editor
set modelTarget to the address of (editor's documentValue's current)
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to layerValues
set brickType to add bim wall type named (the string form of "Brick 200") with layerValues to modelTarget
free layerValues
# A T junction: the branch stands on the through-wall's line at x = 3 and
# is cut back to its face at y = 0.1.
set throughId to add bim wall typed brickType on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to modelTarget
set branchId to add bim wall typed brickType on editor's levelId from (a cad vector2 with x 3.0 and y 0.0) to (a cad vector2 with x 3.0 and y 4.0) to modelTarget
# An L corner made as a butt: the other wall stands flush with the
# through-wall's end, its outer face on x = 0.
set buttThroughId to add bim wall typed brickType on editor's levelId from (a cad vector2 with x 0.0 and y 10.0) to (a cad vector2 with x 6.0 and y 10.0) to modelTarget
set buttBranchId to add bim wall typed brickType on editor's levelId from (a cad vector2 with x 0.1 and y 10.0) to (a cad vector2 with x 0.1 and y 14.0) to modelTarget
# A mitred L corner: two walls ending at one point.
set mitreFirstId to add bim wall typed brickType on editor's levelId from (a cad vector2 with x 10.0 and y 0.0) to (a cad vector2 with x 14.0 and y 0.0) to modelTarget
set mitreSecondId to add bim wall typed brickType on editor's levelId from (a cad vector2 with x 14.0 and y 0.0) to (a cad vector2 with x 14.0 and y 4.0) to modelTarget
refresh bim editor (the address of editor)
check junction ((the length of (editor's plan's sources's values)) = 6) named (the string form of "the plan cuts the six walls")

set planEdges to an empty list of a cad vector2
set planOwners to an empty list of an integer
collect bim wall edges of editor's plan in editor's documentValue's current into planEdges owned by planOwners
set throughDrawn to the junction test drawing of throughId in editor's plan among planEdges by planOwners
set branchDrawn to the junction test drawing of branchId in editor's plan among planEdges by planOwners
print (((the string form of "T junction: through-wall pieces ") + (the string form of (the junction test count of throughDrawn))) + ((the string form of ", branch pieces ") + (the string form of (the junction test count of branchDrawn)))) as a line
print (((the string form of "  inner face y = 0.1: pieces ") + (the string form of (the junction test count of throughDrawn along y 0.1))) + ((the string form of ", drawn mm ") + (the string form of (the junction test millimetres of throughDrawn along y 0.1)))) as a line
print (((the string form of "  outer face y = -0.1: pieces ") + (the string form of (the junction test count of throughDrawn along y -0.1))) + ((the string form of ", drawn mm ") + (the string form of (the junction test millimetres of throughDrawn along y -0.1)))) as a line
check junction ((the junction test count of throughDrawn along y 0.1) = 2) named (the string form of "the through-wall's inner face is interrupted at the T")
check junction ((the junction test millimetres of throughDrawn along y 0.1) = (5800 as a 64 bit integer)) named (the string form of "it stops at the branch's two faces, 200 mm apart")
check junction ((the junction test drawing throughDrawn passes x 3.0 along y 0.1) = false) named (the string form of "no line runs across the branch")
check junction ((the junction test count of throughDrawn along y -0.1) = 1) named (the string form of "the outer face runs through")
check junction ((the junction test count of branchDrawn along y 0.1) = 0) named (the string form of "the branch draws no end line on the through-wall's face")
check junction ((the junction test count of branchDrawn) = 3) named (the string form of "the branch keeps its two faces and its free end")

set buttThroughDrawn to the junction test drawing of buttThroughId in editor's plan among planEdges by planOwners
set buttBranchDrawn to the junction test drawing of buttBranchId in editor's plan among planEdges by planOwners
print (((the string form of "butt L: through-wall pieces ") + (the string form of (the junction test count of buttThroughDrawn))) + ((the string form of ", other wall pieces ") + (the string form of (the junction test count of buttBranchDrawn)))) as a line
print (((the string form of "  inner face y = 10.1: pieces ") + (the string form of (the junction test count of buttThroughDrawn along y 10.1))) + ((the string form of ", drawn mm ") + (the string form of (the junction test millimetres of buttThroughDrawn along y 10.1)))) as a line
check junction ((the junction test millimetres of buttThroughDrawn along y 10.1) = (5800 as a 64 bit integer)) named (the string form of "the through-wall's inner face starts past the other wall")
check junction ((the junction test drawing buttThroughDrawn passes x 0.1 along y 10.1) = false) named (the string form of "no line runs across the other wall's end")
check junction ((the junction test count of buttBranchDrawn along y 10.1) = 0) named (the string form of "the other wall draws no end line on the through-wall's face")

set mitreFirstDrawn to the junction test drawing of mitreFirstId in editor's plan among planEdges by planOwners
set mitreSecondDrawn to the junction test drawing of mitreSecondId in editor's plan among planEdges by planOwners
print (((the string form of "mitred L: first wall pieces ") + (the string form of (the junction test count of mitreFirstDrawn))) + ((the string form of ", second wall pieces ") + (the string form of (the junction test count of mitreSecondDrawn)))) as a line
check junction (((the junction test count of mitreFirstDrawn) = 3) and ((the junction test count of mitreSecondDrawn) = 3)) named (the string form of "the mitre line is drawn by neither wall")

# The plan as drawn: its cut outlines are the last batch, six corners per
# stroke, one stroke per piece counted above.
set expectedStrokes to ((the junction test count of throughDrawn) + (the junction test count of branchDrawn)) + ((the junction test count of buttThroughDrawn) + (the junction test count of buttBranchDrawn))
set expectedStrokes to expectedStrokes + ((the junction test count of mitreFirstDrawn) + (the junction test count of mitreSecondDrawn))
set transform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 100.0)
set planCanvas to a new bim canvas
draw bim hatched cut faces of editor's plan for editor through transform as section false following editor's planRules on (the address of planCanvas)
set outlineBatch to the last item of (planCanvas's batches's values)
print ((the string form of "outline strokes drawn: ") + (the string form of ((the length of (outlineBatch's pixels's values)) / 6))) as a line
check junction (((the length of (outlineBatch's pixels's values)) / 6) = expectedStrokes) named (the string form of "the plan draws exactly those pieces")
check junction (expectedStrokes = 21) named (the string form of "21 strokes where the walls' own rings have 24 edges")
free planEdges
free planOwners
free throughDrawn
free branchDrawn
free buttThroughDrawn
free buttBranchDrawn
free mitreFirstDrawn
free mitreSecondDrawn
