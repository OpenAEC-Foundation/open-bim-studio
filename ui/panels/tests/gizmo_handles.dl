# SPDX-License-Identifier: MPL-2.0
# The gizmo's settings (#137) as the view panel draws and picks it: a larger
# size reaches farther; a hidden group of handles is neither drawn nor
# picked (a hidden arrow keeps its tip for the square's drag); the model's
# axes keep the origin and drop a wall's own tilt ring; and a drag snaps to
# the move and turn steps (unsnapped for a step of 0). The 3D view bar
# offers the axes button left of the section box.
import ui/panels/bim_view_panel.dl

function check gizmo handles {boolean:passed} named {a string:caption}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set layout to @intrinsic("construct", a bim screen layout record, 1280.0, 900.0, 40.0, 200.0, 180.0, 860.0)
set camera to @intrinsic("construct", a bim camera record, (a cad vector2 with x 0.0 and y 0.0), 50.0, 0.5, 0.6, (a cad vector3 with x 0.0, y 0.0 and z 0.0), 50.0)
set basis to no bim object frame
set basis's origin to a cad vector3 with x 1.0, y 2.0 and z 0.5
set basis's found to true

set normal to the bim gizmo for frame basis tilting 3 in layout with camera
set large to the bim gizmo for frame basis tilting 3 sized 1.4 showing (bim gizmo all shown) in layout with camera
set normalReach to the cad distance from normal's middle to normal's xTip
set largeReach to the cad distance from large's middle to large's xTip
print ((the string form of "arrow reach, large over normal (x100): ") + (the string form of ((the floor of (((largeReach / normalReach) * 100.0) + 0.5)) as an integer))) as a line
check gizmo handles ((the bim gizmo handle of normal at normal's xTip) = bim gizmo x handle) named (the string form of "an arrow is picked at its tip")

set noArrows to the bim gizmo for frame basis tilting 3 sized 1.0 showing ((bim gizmo all shown) - (bim gizmo arrows shown)) in layout with camera
check gizmo handles ((the bim gizmo handle of noArrows at noArrows's xTip) != bim gizmo x handle) named (the string form of "a hidden arrow is not picked")
check gizmo handles ((the cad distance from noArrows's middle to noArrows's xTip) > 8.0) named (the string form of "a hidden arrow keeps its tip")
set squareNear to the item at 0 in (normal's square's values)
set squareFar to the item at 2 in (normal's square's values)
set squareMiddle to a cad vector2 with x ((squareNear's x + squareFar's x) * 0.5) and y ((squareNear's y + squareFar's y) * 0.5)
check gizmo handles ((the bim gizmo handle of normal at squareMiddle) = bim gizmo plane handle) named (the string form of "the square is picked inside it")
set noSquare to the bim gizmo for frame basis tilting 3 sized 1.0 showing ((bim gizmo all shown) - (bim gizmo square shown)) in layout with camera
check gizmo handles ((the bim gizmo handle of noSquare at squareMiddle) != bim gizmo plane handle) named (the string form of "a hidden square is not picked")
set noRings to the bim gizmo for frame basis tilting 3 sized 1.0 showing ((bim gizmo arrows shown) + (bim gizmo square shown)) in layout with camera
print ((the string form of "rings without the ring groups: turning ") + ((the string form of (the length of (noRings's ring's values))) + ((the string form of ", tilting ") + (the string form of ((the length of (noRings's xRing's values)) + (the length of (noRings's yRing's values))))))) as a line
print ((the string form of "rings with them: turning ") + ((the string form of (the length of (normal's ring's values))) + ((the string form of ", tilting ") + (the string form of ((the length of (normal's xRing's values)) + (the length of (normal's yRing's values))))))) as a line

# The model's axes: a frame turned a quarter about Z comes back square.
set turned to basis
set turned's xAxis to a cad vector3 with x 0.0, y 1.0 and z 0.0
set turned's yAxis to a cad vector3 with x -1.0, y 0.0 and z 0.0
set world to the bim gizmo frame of turned in world axes true
check gizmo handles (((world's xAxis's x = 1.0) and (world's yAxis's y = 1.0)) and ((world's origin's x = 1.0) and world's found)) named (the string form of "the model's axes keep the origin")
set kept to the bim gizmo frame of turned in world axes false
check gizmo handles (kept's xAxis's y = 1.0) named (the string form of "the selection's axes are its own")
print ((the string form of "tilt rings in the model's axes: wall ") + ((the string form of (the bim gizmo tilt axes 1 in world axes true)) + ((the string form of ", plate ") + ((the string form of (the bim gizmo tilt axes 3 in world axes true)) + ((the string form of ", wall in its own ") + (the string form of (the bim gizmo tilt axes 1 in world axes false))))))) as a line

# The steps.
print ((the string form of "0.137 m in 50 mm steps (mm): ") + (the string form of ((the floor of (((the bim gizmo value 0.137 snapped to 0.05) * 1000.0) + 0.5)) as an integer))) as a line
print ((the string form of "0.137 m unsnapped (mm): ") + (the string form of ((the floor of (((the bim gizmo value 0.137 snapped to 0.0) * 1000.0) + 0.5)) as an integer))) as a line
set someTurn to (37.0 * 3.141592653589793) / 180.0
print ((the string form of "37 deg in 15 deg steps: ") + (the string form of ((the floor of ((((the bim gizmo angle someTurn snapped to 15.0 degrees) * 180.0) / 3.141592653589793) + 0.5)) as an integer))) as a line
print ((the string form of "37 deg in 45 deg steps: ") + (the string form of ((the floor of ((((the bim gizmo angle someTurn snapped to 45.0 degrees) * 180.0) / 3.141592653589793) + 0.5)) as an integer))) as a line

# A tilt drag of 30 degrees on the X ring, in 45 degree steps and unsnapped.
set reach to 60.0 / camera's viewScale
set xStart to the bim gizmo pixel of (a cad vector3 with x 0.0, y (reach * (the cosine of 0.7)) and z (reach * (the sine of 0.7))) in frame basis in layout with camera
set xTurned to the bim gizmo pixel of (a cad vector3 with x 0.0, y (reach * (the cosine of (0.7 + (3.141592653589793 / 6.0)))) and z (reach * (the sine of (0.7 + (3.141592653589793 / 6.0))))) in frame basis in layout with camera
set coarse to the bim gizmo tilt of basis on handle (bim gizmo x ring handle) from xStart to xTurned snapped to 45.0 in layout with camera
set fine to the bim gizmo tilt of basis on handle (bim gizmo x ring handle) from xStart to xTurned snapped to 0.0 in layout with camera
print ((the string form of "tilt of 30 deg in 45 deg steps: ") + (the string form of ((the floor of (((coarse * 180.0) / 3.141592653589793) + 0.5)) as an integer))) as a line
print ((the string form of "tilt of 30 deg unsnapped (x10): ") + (the string form of ((the floor of (((fine * 1800.0) / 3.141592653589793) + 0.5)) as an integer))) as a line

# The 3D view bar's axes button.
set barRight to 1272.0
set barTop to 800.0
set axesPixel to a cad vector2 with x ((the bim view bar axes left from barRight) + 10.0) and y (barTop + 10.0)
set boxPixel to a cad vector2 with x (barRight - 400.0) and y (barTop + 10.0)
print ((the string form of "bar: axes ") + ((the string form of (the bim view bar hit at axesPixel ending at barRight and barTop scaled false)) + ((the string form of ", section box ") + (the string form of (the bim view bar hit at boxPixel ending at barRight and barTop scaled false))))) as a line
