# SPDX-License-Identifier: MPL-2.0
# The Project settings window (issue #119): its two pages as cells, and
# clicks and keys on them changing the project's settings and levels
# through the editor, as one undoable edit each; the Model tab's Levels
# button opens it on its levels page.
import ui/panels/bim_project_window.dl

function check project window {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the project window test name of {integer:actionCode}:
    execute:
        if actionCode = bim project title cell:
            return the string form of "title"
        if actionCode = bim project heading cell:
            return the string form of "heading"
        if actionCode = bim project label cell:
            return the string form of "label"
        if actionCode = bim project value cell:
            return the string form of "value"
        if actionCode = bim project band cell:
            return the string form of "band"
        if actionCode = bim project close cell:
            return the string form of "close"
        if actionCode = bim project page cell:
            return the string form of "page"
        if actionCode = bim project field cell:
            return the string form of "field"
        if actionCode = bim project option cell:
            return the string form of "option"
        if actionCode = bim project level field cell:
            return the string form of "level"
        return the string form of "add"

# The window's cells, a line per row of cells at the same height.
function show project window {bim project window record:windowState} of {bim editor record:editor} across {a 64 bit floating-point number:screenWidth} by {a 64 bit floating-point number:screenHeight}:
    execute:
        set windowCells to the bim project window cells of windowState for editor across screenWidth by screenHeight
        set line to the string form of ""
        set lineTop to -1.0
        loop cursor from 0 to the length of windowCells:
            set cell to the item at cursor in windowCells
            if (cell's top != lineTop) and ((the length of line) > 0):
                print line as a line
                set line to the string form of ""
            set lineTop to cell's top
            set shown to ((the project window test name of cell's action) + (the string form of " ")) + cell's shown
            if cell's chosen:
                set shown to shown + (the string form of "*")
            if cell's typing:
                set shown to shown + (the string form of " (typing)")
            if (the length of line) > 0:
                set line to line + (the string form of " | ")
            set line to line + shown
        print line as a line
        free windowCells

# A click on the middle of the first cell of kind `actionCode` with
# property `code` (any for -1) and option `optionIndex` (any for -1), on
# level `levelId` (any for the refused id); false when there is none.
function click project window {a pointer to a bim project window record:windowState} on {integer:actionCode} code {integer:code} option {integer:optionIndex} level {a 64 bit integer:levelId} in {a pointer to a bim editor record:editor} across {a 64 bit floating-point number:screenWidth} by {a 64 bit floating-point number:screenHeight}:
    execute:
        set windowCells to the bim project window cells of (@intrinsic("dereference", windowState)) for (@intrinsic("dereference", editor)) across screenWidth by screenHeight
        set found to -1
        loop cursor from 0 to the length of windowCells:
            set cell to the item at cursor in windowCells
            if (found < 0) and (cell's action = actionCode):
                if ((code < 0) or (cell's code = code)) and ((optionIndex < 0) or (cell's option = optionIndex)):
                    if (levelId = the bim refused id) or (cell's levelId = levelId):
                        set found to cursor
        if found < 0:
            free windowCells
            return false
        set cell to the item at found in windowCells
        free windowCells
        click bim project window at (cell's left + (cell's across * 0.5)) and (cell's top + (cell's tall * 0.5)) across screenWidth by screenHeight in windowState for editor
        return true

function type project window {a string:typed} in {a pointer to a bim project window record:windowState} for {a pointer to a bim editor record:editor}:
    execute:
        loop cursor from 0 to the length of typed:
            type bim project window character ((the character at cursor in typed) as an integer) in windowState for editor

set width to 1280.0
set height to 800.0
set editor to a new bim editor
set e to the address of editor
set projectWindow to a new bim project window
set w to the address of projectWindow
check project window (projectWindow's open = false) named (the string form of "the window starts shut")
open bim project window on page (bim project settings page) in w for e
check project window projectWindow's open named (the string form of "Settings opens it")
show project window projectWindow of editor across width by height

# A unit and the drawing standard: a click on an option.
check project window (click project window w on (bim project option cell) code (bim project length unit property) option 2 level (the bim refused id) in e across width by height) named (the string form of "the length unit's options are cells")
check project window (((the bim project length unit of editor's documentValue's current) = 2) and (editor's lengthUnit = 2)) named (the string form of "a click on m makes metres the project's length unit")
ignore click project window w on (bim project option cell) code (bim drawing standard property) option 1 level (the bim refused id) in e across width by height
check project window ((the bim drawing standard of editor's documentValue's current) = 1) named (the string form of "a click on DIN 1356 makes it the drawing standard")

# Typed values: decimals with Enter, the EPSG code applied by a click on
# the next field, which Esc then cancels; Esc again closes the window.
ignore click project window w on (bim project field cell) code (bim project decimals property) option (-1) level (the bim refused id) in e across width by height
type project window (the string form of "3x") in w for e
type bim project window key (bim enter key code) in w for e
check project window ((the bim project decimals of editor's documentValue's current) = 3) named (the string form of "decimals typed and Enter: three")
ignore click project window w on (bim project field cell) code (bim project crs property) option (-1) level (the bim refused id) in e across width by height
type project window (the string form of "28992") in w for e
show project window projectWindow of editor across width by height
ignore click project window w on (bim project field cell) code (bim project northings property) option (-1) level (the bim refused id) in e across width by height
check project window ((the bim project crs of editor's documentValue's current) = (28992 as a 64 bit integer)) named (the string form of "a click on another field applies the EPSG code typed")
check project window (editor's propertyCode = bim project northings property) named (the string form of "and starts typing that field")
type bim project window key (bim escape key code) in w for e
check project window ((editor's propertyCode < 0) and projectWindow's open) named (the string form of "Esc cancels the typing and leaves the window open")
type bim project window key (bim escape key code) in w for e
check project window (projectWindow's open = false) named (the string form of "Esc again closes the window")
ignore undo bim transaction in (the address of (editor's documentValue))
check project window ((the bim project crs of editor's documentValue's current) = (0 as a 64 bit integer)) named (the string form of "each change is one undoable edit")

# The levels page.
set levelsBefore to the length of (editor's documentValue's current's levels's values)
open bim project window on page (bim project levels page) in w for e
show project window projectWindow of editor across width by height
ignore click project window w on (bim project add level cell) code (-1) option (-1) level (the bim refused id) in e across width by height
check project window ((the length of (editor's documentValue's current's levels's values)) = (levelsBefore + 1)) named (the string form of "Add level adds a level")
set baseId to (the item at 0 in (editor's documentValue's current's levels's values))'s id
ignore click project window w on (bim project level field cell) code (bim level name property) option (-1) level baseId in e across width by height
check project window ((editor's selectionKind = bim level picked) and (editor's selectionId = baseId)) named (the string form of "a click on a level's name selects the level")
type project window (the string form of "Ground floor") in w for e
type bim project window key (bim enter key code) in w for e
check project window ((the item at 0 in (editor's documentValue's current's levels's values))'s name = (the string form of "Ground floor")) named (the string form of "and its name is typed")
ignore click project window w on (bim project level field cell) code (bim level extent property) option (-1) level baseId in e across width by height
check project window (bim level baseId is unlocked in editor's documentValue's current) named (the string form of "a click on its extent gives it its own")
show project window projectWindow of editor across width by height

# A short window: the levels beyond its room are scrolled to.
loop added from 0 to 8:
    add bim editor level above the highest in e
show project window projectWindow of editor across width by 420.0
scroll bim project window by 3 in w
show project window projectWindow of editor across width by 420.0

# The Model tab's Levels button opens the window on its levels page.
set modelGroups to the bim ribbon groups of tab 5
set levelsButton to false
loop groupCursor from 0 to the length of modelGroups:
    set ribbonGroup to the item at groupCursor in modelGroups
    loop buttonCursor from 0 to the length of (ribbonGroup's buttons):
        set ribbonButton to the item at buttonCursor in (ribbonGroup's buttons)
        if (ribbonButton's label = (the string form of "Levels")) and (ribbonButton's command = bim project levels command):
            set levelsButton to true
free modelGroups
check project window levelsButton named (the string form of "the Model tab has a Levels button for the window")

# The drawing compiles with the rest; it is not run (no window to draw in).
set emptyAtlas to @intrinsic("construct", a bim text atlas record, @intrinsic("construct", a graphics texture, 0 as a pointer to a byte, 0, 0), an empty list of a bim text face record, 0, 0, an empty list of a bim icon cell record, an empty bim message catalogue, an empty list of a pointer, -1)
set noFrame to @intrinsic("construct", a graphics frame, 0 as a pointer, false)
if width < 0.0:
    draw bim project window projectWindow for editor across width by height pointing at 0.0 and 0.0 using emptyAtlas in noFrame
