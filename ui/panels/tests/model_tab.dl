# The ribbon's Model tab (issue #119): the project's settings, its levels,
# its checks and its library in one tab after View; no units buttons and no
# Save or Open on the ribbon (the document bar and the File menu hold them);
# Settings shows the project's settings in the properties.
import ui/panels/bim_ui.dl

function check model tab {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The titles of tab `chosenTab`'s groups, each with its buttons' labels.
function show model tab groups of tab {integer:chosenTab}:
    execute:
        set tabGroups to the bim ribbon groups of tab chosenTab
        loop groupCursor from 0 to the length of tabGroups:
            set ribbonGroup to the item at groupCursor in tabGroups
            set shown to ribbonGroup's title + (the string form of ":")
            loop buttonCursor from 0 to the length of (ribbonGroup's buttons):
                set shown to (shown + (the string form of " ")) + (the item at buttonCursor in (ribbonGroup's buttons))'s label
            print shown as a line
        free tabGroups

# Whether any tab has a group titled `wanted`, or a button labelled
# `wanted`.
function the model tab ribbon holds {a string:wanted}:
    execute:
        set found to false
        set tabNames to the bim ribbon tab names
        loop tabIndex from 0 to the length of tabNames:
            set tabGroups to the bim ribbon groups of tab tabIndex
            loop groupCursor from 0 to the length of tabGroups:
                set ribbonGroup to the item at groupCursor in tabGroups
                if ribbonGroup's title = wanted:
                    set found to true
                loop buttonCursor from 0 to the length of (ribbonGroup's buttons):
                    if (the item at buttonCursor in (ribbonGroup's buttons))'s label = wanted:
                        set found to true
            free tabGroups
        free tabNames
        return found

set tabNames to the bim ribbon tab names
set namesShown to the string form of "tabs:"
loop tabIndex from 0 to the length of tabNames:
    set namesShown to (namesShown + (the string form of " ")) + (the item at tabIndex in tabNames)
print namesShown as a line
check model tab ((the item at 5 in tabNames) = (the string form of "Model")) named (the string form of "Model follows View")
check model tab ((the item at 7 in tabNames) = (the string form of "Concrete+Rebar")) named (the string form of "the tabs after it keep their places")
show model tab groups of tab 5
check model tab ((the model tab ribbon holds (the string form of "Units")) = false) named (the string form of "no units group: the units are a project setting")
check model tab ((the model tab ribbon holds (the string form of "Save")) = false) named (the string form of "no Save on the ribbon")
check model tab ((the model tab ribbon holds (the string form of "Open")) = false) named (the string form of "no Open on the ribbon")
set modelGroups to the bim ribbon groups of tab 5
check model tab (((the item at 0 in ((the item at 0 in modelGroups)'s buttons))'s command) = (bim project settings command)) named (the string form of "Settings sends the project settings command")
free modelGroups

# Settings, from a plan with nothing selected: the properties show the
# project's settings.
set editor to a new bim editor
set e to the address of editor
type bim editor key (bim project settings command) in e
check model tab (editor's propertiesViewId = (bim project properties context)) named (the string form of "Settings shows the project's properties")
set settingsRows to the bim property rows of editor
set unitsShown to false
loop rowCursor from 0 to the length of settingsRows:
    if (the item at rowCursor in settingsRows)'s label = (the string form of "Units"):
        set unitsShown to true
free settingsRows
check model tab unitsShown named (the string form of "the project's properties hold the units")
