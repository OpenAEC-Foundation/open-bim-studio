# SPDX-License-Identifier: MPL-2.0
# The panel rail's icons (Views, Parts, Tables, Sheets, Props) as one set:
# each has lines in pairs, a quiet body and one or more accent patches, all
# inside the same box of the 32-pixel grid, and no two alike; any other
# glyph has no panel drawing.
import ui/panels/bim_ui.dl

function check panel icons {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# Whether every point of `points` lies within 4 to 28 on both axes.
function all panel points of {a pointer to a list:points} lie inside:
    execute:
        loop cursor from 0 to the length of points:
            set spot to the item at cursor in points
            if ((spot's x < 4.0) or (spot's x > 28.0)) or ((spot's y < 4.0) or (spot's y > 28.0)):
                return false
        return true

# Whether the lines of `firstGlyph` and `secondGlyph` are the same.
function panel glyphs {integer:firstGlyph} and {integer:secondGlyph} draw alike:
    execute:
        set firstDrawing to the bim panel icon drawing of firstGlyph
        set secondDrawing to the bim panel icon drawing of secondGlyph
        if (the length of (firstDrawing's lines)) != (the length of (secondDrawing's lines)):
            return false
        loop cursor from 0 to the length of (firstDrawing's lines):
            set firstSpot to the item at cursor in (firstDrawing's lines)
            set secondSpot to the item at cursor in (secondDrawing's lines)
            if (firstSpot's x != secondSpot's x) or (firstSpot's y != secondSpot's y):
                return false
        return true

set glyphs to an empty list of an integer
append (bim icon views panel) to glyphs
append (bim icon parts panel) to glyphs
append (bim icon tables panel) to glyphs
append (bim icon sheets panel) to glyphs
append (bim icon properties panel) to glyphs
set wellFormed to true
set boxed to true
set accentedEach to true
loop glyphCursor from 0 to the length of glyphs:
    set iconParts to the bim panel icon drawing of (the item at glyphCursor in glyphs)
    set lineCount to the length of (iconParts's lines)
    set patchCount to the length of (iconParts's accented)
    if ((lineCount < 8) or ((the remainder of lineCount divided by 2) != 0)) or ((the length of (iconParts's patches)) != (patchCount * 4)):
        set wellFormed to false
    if ((all panel points of (the address of (iconParts's lines)) lie inside) = false) or ((all panel points of (the address of (iconParts's patches)) lie inside) = false):
        set boxed to false
    set accents to 0
    set bodies to 0
    loop patchCursor from 0 to patchCount:
        if (the item at patchCursor in (iconParts's accented)) = true:
            set accents to accents + 1
        else:
            set bodies to bodies + 1
    if (accents = 0) or (bodies = 0):
        set accentedEach to false
check panel icons wellFormed named (the string form of "each panel icon has lines in pairs and four corners a patch")
check panel icons boxed named (the string form of "each panel icon stays inside the 4 to 28 box")
check panel icons accentedEach named (the string form of "each panel icon has a body and an accent")
set distinct to true
loop firstCursor from 0 to the length of glyphs:
    loop secondCursor from 0 to the length of glyphs:
        if (firstCursor != secondCursor) and (panel glyphs (the item at firstCursor in glyphs) and (the item at secondCursor in glyphs) draw alike):
            set distinct to false
check panel icons distinct named (the string form of "no two panel icons are alike")
check panel icons ((the length of ((the bim panel icon drawing of (bim icon eye))'s lines)) = 0) named (the string form of "other glyphs have no panel drawing")
