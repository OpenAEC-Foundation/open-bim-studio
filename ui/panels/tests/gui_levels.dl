# SPDX-License-Identifier: MPL-2.0
# The same command and property actions used by the BIM Level button.
import ui/editor/bim_editor.dl

function check gui level {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

set editor to a new bim editor
set e to the address of editor
set originalCount to the length of (editor's documentValue's current's levels's values)
set originalViews to the length of (editor's documentValue's current's views's values)
set baseLevel to the item at 0 in (editor's documentValue's current's levels's values)
type bim editor key 2194 in e
set freshId to editor's selectionId
set made to the item at (the bim level index of freshId in editor's documentValue's current)'s position in (editor's documentValue's current's levels's values)
check gui level ((editor's selectionKind = bim level picked) and (made's elevation = (baseLevel's elevation + baseLevel's height))) named (the string form of "Level command adds and selects above the highest")
check gui level (((the length of (editor's documentValue's current's levels's values)) = (originalCount + 1)) and ((the length of (editor's documentValue's current's views's values)) = (originalViews + 1))) named (the string form of "new level has its own plan")
ignore undo bim transaction in (the address of (editor's documentValue))
check gui level (((the length of (editor's documentValue's current's levels's values)) = originalCount) and ((the length of (editor's documentValue's current's views's values)) = originalViews)) named (the string form of "level and plan undo together")
ignore redo bim transaction in (the address of (editor's documentValue))
select bim editor bim level picked numbered freshId in e
start bim editor property bim level name property in e
type bim editor property key 70 in e
type bim editor property key 49 in e
apply bim editor property in e
set renamed to the item at (the bim level index of freshId in editor's documentValue's current)'s position in (editor's documentValue's current's levels's values)
set plan to the item at (the bim view index of editor's planViewId in editor's documentValue's current)'s position in (editor's documentValue's current's views's values)
check gui level ((renamed's name = (the string form of "F1")) and (plan's name = (the string form of "F1"))) named (the string form of "typed name updates the level and generated plan")
ignore undo bim transaction in (the address of (editor's documentValue))
set restored to the item at (the bim level index of freshId in editor's documentValue's current)'s position in (editor's documentValue's current's levels's values)
check gui level (restored's name = made's name) named (the string form of "rename undo restores the name")
start bim editor property bim level name property in e
set editor's propertyText to the string form of "   "
apply bim editor property in e
set unchanged to the item at (the bim level index of freshId in editor's documentValue's current)'s position in (editor's documentValue's current's levels's values)
check gui level (unchanged's name = restored's name) named (the string form of "blank name is refused")

# Section Copy uses an absolute snapped height and keeps the active section.
select bim editor bim level picked numbered baseLevel's id in e
set beforeCopyLevels to the length of (editor's documentValue's current's levels's values)
set beforeCopyViews to the length of (editor's documentValue's current's views's values)
set beforeCopyWalls to the length of (editor's documentValue's current's walls's values)
set beforeCopyPlan to editor's planViewId
type bim editor key 2002 in e
check gui level ((editor's tool = bim copy tool) and (editor's selectionId = baseLevel's id)) named (the string form of "Copy retains the selected section level")
copy bim editor selected level to height baseLevel's elevation in e
check gui level ((the length of (editor's documentValue's current's levels's values)) = beforeCopyLevels) named (the string form of "copying a level onto itself makes no duplicate")
copy bim editor selected level to height (baseLevel's elevation - 2.5) in e
set copiedLevel to the item at (the bim level index of editor's selectionId in editor's documentValue's current)'s position in (editor's documentValue's current's levels's values)
check gui level (((copiedLevel's id != baseLevel's id) and (copiedLevel's elevation = (baseLevel's elevation - 2.5))) and (copiedLevel's height = baseLevel's height)) named (the string form of "level copy uses the target height and preserves storey height")
check gui level (((the length of (editor's documentValue's current's views's values)) = (beforeCopyViews + 1)) and (editor's planViewId = beforeCopyPlan)) named (the string form of "copied level gets a plan without changing the active plan")
check gui level ((the length of (editor's documentValue's current's walls's values)) = beforeCopyWalls) named (the string form of "level copy does not duplicate hosted building elements")
ignore undo bim transaction in (the address of (editor's documentValue))
check gui level (((the length of (editor's documentValue's current's levels's values)) = beforeCopyLevels) and ((the length of (editor's documentValue's current's views's values)) = beforeCopyViews)) named (the string form of "copied level and its plan undo together")
