# SPDX-License-Identifier: MPL-2.0
# The command line's box (`bim_command_line.dl`): which clicks are its own.
# The box lies in the command strip, right of the "Command:" label and left
# of the snap toggles; the canvas above and the status bar below keep their
# clicks. The drawing code compiles with the rest.
import ui/panels/bim_command_line.dl

function check command box {boolean:passed} named {a string:caption}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

set stripTop to the bim ui canvas bottom in 900.0
set stripMiddle to stripTop + ((bim ui command line height) * 0.5)
check command box (bim command box holds 200.0 and stripMiddle in 1600.0 by 900.0) named (the string form of "a click in the box is the command line's")
check command box ((bim command box holds 40.0 and stripMiddle in 1600.0 by 900.0) = false) named (the string form of "the label left of the box is not")
check command box ((the absolute value of ((the bim command box right in 1600.0) - 880.0)) < 0.000001) named (the string form of "the box ends at 0.55 of a wide window")
check command box ((bim command box holds 900.0 and stripMiddle in 1600.0 by 900.0) = false) named (the string form of "the snap toggles to its right keep their clicks")
check command box ((bim command box holds 200.0 and (stripTop - 2.0) in 1600.0 by 900.0) = false) named (the string form of "the canvas above keeps its clicks")
check command box ((bim command box holds 200.0 and ((stripTop + (bim ui command line height)) + 2.0) in 1600.0 by 900.0) = false) named (the string form of "the status bar below keeps its clicks")
check command box ((the absolute value of ((the bim command box right in 1000.0) - 440.0)) < 0.000001) named (the string form of "a 1000 wide window leaves the toggles 560")
check command box ((the absolute value of ((the bim command box right in 700.0) - 320.0)) < 0.000001) named (the string form of "a narrow window keeps the box 320 wide")

# The drawing code compiles with the rest; it runs only in the application.
set prompter to a new bim command line
if (the length of (prompter's sentences's values)) > 100000:
    set atlas to @intrinsic("construct", a bim text atlas record, @intrinsic("construct", a graphics texture, 0 as a pointer to a byte, 0, 0), an empty list of a bim text face record, 0, 0, an empty list of a bim icon cell record, an empty bim message catalogue, an empty list of a pointer, -1)
    set frame to @intrinsic("construct", a graphics frame, 0 as a pointer, false)
    draw bim sentence line prompter saying (the string form of "Pick the first point") and status (the string form of "Ready") in 1600.0 by 900.0 using atlas in frame
