# SPDX-License-Identifier: MPL-2.0
# The gizmo's rings about its X and Y axes (#137): drawn only for the axes
# the selection tilts about, picked under the pointer, and a drag along one
# read as a tilt by the right hand about its axis, in whole degrees, seen
# from either side; the pointer is read back into the ring's plane.
import ui/panels/bim_view_panel.dl

function check gizmo rings {boolean:passed} named {a string:caption}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + caption) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + caption) as a line

function the gizmo ring degrees of {a 64 bit floating-point number:radians}:
    execute:
        return (the floor of (((radians * 180.0) / 3.141592653589793) + 0.5)) as an integer

set layout to @intrinsic("construct", a bim screen layout record, 1280.0, 900.0, 40.0, 200.0, 180.0, 860.0)
set camera to @intrinsic("construct", a bim camera record, (a cad vector2 with x 0.0 and y 0.0), 50.0, 0.5, 0.6, (a cad vector3 with x 0.0, y 0.0 and z 0.0), 50.0)
set basis to no bim object frame
set basis's origin to a cad vector3 with x 1.0, y 2.0 and z 0.5
set basis's found to true
set plain to the bim gizmo for frame basis in layout with camera
check gizmo rings (((the length of (plain's xRing's values)) = 0) and ((the length of (plain's yRing's values)) = 0)) named (the string form of "no tilting rings when the selection takes no tilt")
set wallLike to the bim gizmo for frame basis tilting 1 in layout with camera
check gizmo rings (((the length of (wallLike's xRing's values)) = 33) and ((the length of (wallLike's yRing's values)) = 0)) named (the string form of "a wall shows its X ring only")
set full to the bim gizmo for frame basis tilting 3 in layout with camera
check gizmo rings (((the length of (full's xRing's values)) = 33) and ((the length of (full's yRing's values)) = 33)) named (the string form of "a plate shows both tilting rings")
set reach to 60.0 / camera's viewScale
# Points on the X ring at a quarter turn from its start (local Y), and 30
# degrees on toward local Z.
set xStart to the bim gizmo pixel of (a cad vector3 with x 0.0, y (reach * (the cosine of 0.7)) and z (reach * (the sine of 0.7))) in frame basis in layout with camera
set xTurned to the bim gizmo pixel of (a cad vector3 with x 0.0, y (reach * (the cosine of (0.7 + (3.141592653589793 / 6.0)))) and z (reach * (the sine of (0.7 + (3.141592653589793 / 6.0))))) in frame basis in layout with camera
check gizmo rings ((the bim gizmo handle of full at xStart) = bim gizmo x ring handle) named (the string form of "the X ring is picked under the pointer")
set xTilt to the bim gizmo tilt of basis on handle (bim gizmo x ring handle) from xStart to xTurned in layout with camera
print ((the string form of "X ring dragged 30 deg from Y toward Z: ") + (the string form of (the gizmo ring degrees of xTilt))) as a line
set xBack to the bim gizmo tilt of basis on handle (bim gizmo x ring handle) from xTurned to xStart in layout with camera
print ((the string form of "and back: ") + (the string form of (the gizmo ring degrees of xBack))) as a line
# The Y ring: from local Z toward local X is a positive turn about Y.
set yStart to the bim gizmo pixel of (a cad vector3 with x (reach * (the sine of 0.4)), y 0.0 and z (reach * (the cosine of 0.4))) in frame basis in layout with camera
set yTurned to the bim gizmo pixel of (a cad vector3 with x (reach * (the sine of (0.4 + (3.141592653589793 / 6.0)))), y 0.0 and z (reach * (the cosine of (0.4 + (3.141592653589793 / 6.0))))) in frame basis in layout with camera
set yTilt to the bim gizmo tilt of basis on handle (bim gizmo y ring handle) from yStart to yTurned in layout with camera
print ((the string form of "Y ring dragged 30 deg from Z toward X: ") + (the string form of (the gizmo ring degrees of yTilt))) as a line
# Seen from the other side (the camera turned half round), the same drag in
# the model is still the same tilt.
set behind to @intrinsic("construct", a bim camera record, (a cad vector2 with x 0.0 and y 0.0), 50.0, 0.5 + 3.141592653589793, 0.6, (a cad vector3 with x 0.0, y 0.0 and z 0.0), 50.0)
set xStartBehind to the bim gizmo pixel of (a cad vector3 with x 0.0, y (reach * (the cosine of 0.7)) and z (reach * (the sine of 0.7))) in frame basis in layout with behind
set xTurnedBehind to the bim gizmo pixel of (a cad vector3 with x 0.0, y (reach * (the cosine of (0.7 + (3.141592653589793 / 6.0)))) and z (reach * (the sine of (0.7 + (3.141592653589793 / 6.0))))) in frame basis in layout with behind
set behindTilt to the bim gizmo tilt of basis on handle (bim gizmo x ring handle) from xStartBehind to xTurnedBehind in layout with behind
print ((the string form of "X ring seen from behind: ") + (the string form of (the gizmo ring degrees of behindTilt))) as a line
