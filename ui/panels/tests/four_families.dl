# SPDX-License-Identifier: MPL-2.0
# The four families as the modeller's base (issue #105): the Home tab holds
# Select, one Build group of four split buttons (Point, Line, Plane and
# System), Openings, Grid and Circulation, and no sub-tabs. Each family
# button opens its menu of the family's functions; its icon starts the one
# chosen last, the menu's first until one is chosen. The System menu lists
# the building system recipes from their data, by group; a recipe's row
# draws a new building system of it.
import ui/panels/bim_ui.dl

function check four families {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The groups `groups` as lines: a title, then its buttons' labels.
function show four families groups {a pointer to a list:groups}:
    execute:
        loop groupCursor from 0 to the length of groups:
            set shownGroup to the item at groupCursor in groups
            set shown to shownGroup's title + (the string form of ":")
            loop buttonCursor from 0 to the length of (shownGroup's buttons):
                set shown to (shown + (the string form of " ")) + (the item at buttonCursor in (shownGroup's buttons))'s label
            print shown as a line

# How often a button of `groups` sends `wanted`.
function the four families count of {integer:wanted} in {a pointer to a list:groups}:
    execute:
        set sends to 0
        loop groupCursor from 0 to the length of groups:
            set countedGroup to the item at groupCursor in groups
            loop buttonCursor from 0 to the length of (countedGroup's buttons):
                if (the item at buttonCursor in (countedGroup's buttons))'s command = wanted:
                    set sends to sends + 1
        return sends

# The Home tab.
set homeGroups to the bim ribbon groups of tab 0
show four families groups homeGroups
set buildGroup to the item at 1 in homeGroups
check four families ((the length of (buildGroup's buttons)) = 4) named (the string form of "Build holds four family buttons")
set familyLabels to an empty list of a string
append (the string form of "Point") to familyLabels
append (the string form of "Line") to familyLabels
append (the string form of "Plane") to familyLabels
append (the string form of "System") to familyLabels
set familiesOpen to true
loop familyCursor from 0 to 4:
    set familyButton to the item at familyCursor in (buildGroup's buttons)
    set opened to the bim chooser of command familyButton's command
    if (familyButton's label != (the item at familyCursor in familyLabels)) or (opened != ((bim point chooser) + familyCursor)):
        set familiesOpen to false
    if (the bim chooser opened is a family) = false:
        set familiesOpen to false
check four families familiesOpen named (the string form of "Point, Line, Plane and System open their family's menu")
check four families ((the bim chooser (bim view chooser) is a family) = false) named (the string form of "Create view is no family")
set homeSubtabs to the bim ribbon subtab names of tab 0
check four families ((the length of homeSubtabs) = 0) named (the string form of "the Home tab has no sub-tabs")

# The menus.
loop familyCursor from 0 to 4:
    print ((the string form of "menu of ") + (the item at familyCursor in familyLabels)) as a line
    set menuGroups to the bim chooser groups of ((bim point chooser) + familyCursor)
    show four families groups menuGroups
    free menuGroups

# Home with its menus reaches each command once: none shown twice.
set reached to the bim ribbon groups of tab 0 with choosers
set reachedCodes to an empty list of an integer
append 87 to reachedCodes
append 66 to reachedCodes
append 2080 to reachedCodes
append 2081 to reachedCodes
append 2139 to reachedCodes
append 2070 to reachedCodes
append 2071 to reachedCodes
append 2077 to reachedCodes
append 2072 to reachedCodes
append 2074 to reachedCodes
append 2075 to reachedCodes
append 2076 to reachedCodes
append 2112 to reachedCodes
append 73 to reachedCodes
append ((bim ui control command) + 73) to reachedCodes
append ((bim ui control command) + 71) to reachedCodes
set onceEach to true
loop codeCursor from 0 to the length of reachedCodes:
    if (the four families count of (the item at codeCursor in reachedCodes) in reached) != 1:
        print ((the string form of "not once: ") + (the string form of (the item at codeCursor in reachedCodes))) as a line
        set onceEach to false
check four families onceEach named (the string form of "Home reaches every family function exactly once")
check four families ((the four families count of 2207 in reached) = 0) named (the string form of "the wall line moved to the wall tool's toolbar")

# The System menu's recipes come from the recipe data.
set library to the bim system types
set ceilingPlace to -1
set framesListed to 0
loop recipeCursor from 0 to the length of library:
    if (the item at recipeCursor in library)'s name = (the string form of "Systeemplafond 600x600"):
        set ceilingPlace to recipeCursor
set systemGroups to the bim chooser groups of (bim system chooser)
loop groupCursor from 0 to the length of systemGroups:
    if (the item at groupCursor in systemGroups)'s title = (the string form of "Window frames"):
        set framesListed to framesListed + 1
check four families (ceilingPlace >= 0) named (the string form of "the library has the suspended ceiling recipe")
check four families ((the four families count of ((bim system recipe command) + ceilingPlace) in systemGroups) = 1) named (the string form of "the System menu lists it")
check four families (framesListed = 0) named (the string form of "window frames are not drawn as a system")
set ceilingRow to the bim family row sending ((bim system recipe command) + ceilingPlace) in chooser (bim system chooser)
check four families (ceilingRow's label = (the string form of "Systeemplafond 600x600")) named (the string form of "its row carries the recipe's name")

# A click on a family's icon: the menu's first, then the one chosen last.
check four families ((the bim family command of chooser (bim point chooser)) = ((bim ui control command) + 73)) named (the string form of "Point starts Place at first")
check four families ((the bim family command of chooser (bim line chooser)) = 2070) named (the string form of "Line starts Column at first")
check four families ((the bim family command of chooser (bim plane chooser)) = 87) named (the string form of "Plane starts Wall at first")
check four families ((the bim family command of chooser (bim system chooser)) = 2112) named (the string form of "System starts Building System at first")
note bim chooser (bim plane chooser) choosing 2080
check four families ((the bim family command of chooser (bim plane chooser)) = 2080) named (the string form of "after Roof from its menu Plane starts Roof")
check four families ((the bim family command of chooser (bim line chooser)) = 2070) named (the string form of "and Line keeps its own")
check four families ((the bim family row sending 2080 in chooser (bim plane chooser))'s icon = bim icon roof) named (the string form of "Roof's row has Roof's icon")
set planeShown to the bim family button of chooser (bim plane chooser)
check four families ((planeShown's label = (the string form of "Roof")) and (planeShown's icon = bim icon roof)) named (the string form of "Plane's button shows Roof")
note bim chooser (bim line chooser) choosing 87
check four families ((the bim family command of chooser (bim line chooser)) = 2070) named (the string form of "a command not in Line's menu leaves Column")
note bim chooser (bim view chooser) choosing 2071
check four families ((the bim family command of chooser (bim line chooser)) = 2070) named (the string form of "another menu's choice remembers nothing")
note bim chooser (bim system chooser) choosing ((bim system recipe command) + ceilingPlace)
check four families ((the bim family command of chooser (bim system chooser)) = ((bim system recipe command) + ceilingPlace)) named (the string form of "System starts the recipe chosen last")

# The functions run in the editor.
set editor to a new bim editor
set e to the address of editor
type bim editor key 2071 in e
check four families ((editor's tool = bim linear tool) and (editor's linearRole = 1)) named (the string form of "Beam starts the linear tool as a beam")
type bim editor key ((bim system recipe command) + ceilingPlace) in e
check four families ((editor's tool = bim curtain tool) and (editor's systemTypeIndex = ceilingPlace)) named (the string form of "a recipe's row draws a building system of that recipe")
check four families ((the length of editor's message) > 0) named (the string form of "and says so")
print editor's message as a line
type bim editor key ((bim system recipe command) + (bim system recipe commands available)) in e
check four families (editor's systemTypeIndex = ceilingPlace) named (the string form of "a command past the recipes changes nothing")
free reachedCodes
free familyLabels
free homeSubtabs
free systemGroups
free library
free reached
free homeGroups
