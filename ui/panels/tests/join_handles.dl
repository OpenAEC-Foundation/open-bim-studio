# Join handles (ui/editor/bim_join_handles.dl): with the Select tool the
# plan shows an icon at each join of the storey, a click on it selects the
# join (before the walls under it), its properties read its kind, walls and
# style, and their rows change the style as one undoable edit each; Delete
# leaves a join alone. A join set to Not joined no longer merges its walls'
# cut outlines (ui/panels/bim_plan_panel.dl).
import ui/panels/bim_plan_panel.dl

function check join handle {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function print join handle rows of {bim editor record:editor}:
    execute:
        set rowList to the bim property rows of editor
        loop rowCursor from 0 to the length of rowList:
            set rowValue to the item at rowCursor in rowList
            print ((((the string form of "  ") + rowValue's label) + ((the string form of ": ") + rowValue's value)) + ((the string form of " [") + ((the string form of rowValue's code) + (the string form of "]")))) as a line
        free rowList

# The value of the row coded `rowCode`, or "none".
function the join handle row {integer:rowCode} of {bim editor record:editor}:
    execute:
        set shown to the string form of "none"
        set rowList to the bim property rows of editor
        loop rowCursor from 0 to the length of rowList:
            set rowValue to the item at rowCursor in rowList
            if rowValue's code = rowCode:
                set shown to rowValue's value
        free rowList
        return shown

function the join handle millimetres of {a 64 bit floating-point number:value}:
    execute:
        set scaled to @intrinsic("call", "libc", "round", a 64 bit floating-point number, value * 1000.0)
        return the string form of (scaled as a 64 bit integer)

function the join handle text of {cad vector2:corner}:
    execute:
        return (((the string form of "(") + (the join handle millimetres of corner's x)) + ((the string form of ", ") + (the join handle millimetres of corner's y))) + (the string form of ")")

function the join handle end of {a 64 bit integer:wallId} at finish {boolean:atFinish} in {bim model record:modelValue}:
    execute:
        set found to the bim wall index of wallId in modelValue
        set footprint to the bim footprint of (the item at found's position in (modelValue's walls's values)) in modelValue
        if atFinish:
            return ((the join handle text of footprint's finishExterior) + (the string form of " ")) + (the join handle text of footprint's finishInterior)
        return ((the join handle text of footprint's startExterior) + (the string form of " ")) + (the join handle text of footprint's startInterior)

# A click at `location` with the select tool, the pointer's tolerance 80 mm
# (8 pixels at 100 pixels a metre).
function click join handle at {cad vector2:location} in {a pointer to a bim editor record:editor}:
    execute:
        move bim editor pointer to location within 0.08 in editor
        press bim editor pointer in editor
        release bim editor pointer in editor

# The cut edges the plan draws of wall `wallId`, in pairs, with the walls
# that stand apart (`collect bim unjoined wall pairs of`) not merging.
function the join handle drawing of {a 64 bit integer:wallId} in {bim editor record:editor}:
    execute:
        set viewValue to editor's plan
        set modelValue to editor's documentValue's current
        set edgeList to an empty list of a cad vector2
        set ownerList to an empty list of an integer
        collect bim wall edges of viewValue in modelValue into edgeList owned by ownerList
        set apartPairs to an empty list of an integer
        collect bim unjoined wall pairs of viewValue in modelValue using editor's evaluation's index into apartPairs
        set drawn to an empty list of a cad vector2
        loop sourceCursor from 0 to the length of (viewValue's sources's values):
            set source to the item at sourceCursor in (viewValue's sources's values)
            if source's id = wallId:
                loop polygonCursor from 0 to the length of (source's polygons's values):
                    set ringCorners to (the item at polygonCursor in (source's polygons's values))'s points's values
                    set cornerCount to the length of ringCorners
                    set leftward to bim corners ringCorners turn anticlockwise
                    loop cornerCursor from 0 to cornerCount:
                        set cornerHere to the item at cornerCursor in ringCorners
                        set cornerNext to the item at (the remainder of (cornerCursor + 1) divided by cornerCount) in ringCorners
                        append bim uncovered parts of wall edge from cornerHere to cornerNext walled left leftward of owner sourceCursor among edgeList by ownerList unjoined apartPairs into drawn
        free edgeList
        free ownerList
        free apartPairs
        return drawn

# Walls of 200 mm: an L corner at (4, 0), a T join at (13, 0) and two walls
# in line meeting at (3, 10).
set editor to a new bim editor
set e to the address of editor
set modelTarget to the address of (editor's documentValue's current)
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to layerValues
set brickType to add bim wall type named (the string form of "Brick 200") with layerValues to modelTarget
free layerValues
set firstLeg to add bim wall typed brickType on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to modelTarget
set secondLeg to add bim wall typed brickType on editor's levelId from (a cad vector2 with x 4.0 and y 0.0) to (a cad vector2 with x 4.0 and y 3.0) to modelTarget
set hostWall to add bim wall typed brickType on editor's levelId from (a cad vector2 with x 10.0 and y 0.0) to (a cad vector2 with x 16.0 and y 0.0) to modelTarget
set branchWall to add bim wall typed brickType on editor's levelId from (a cad vector2 with x 13.0 and y 0.0) to (a cad vector2 with x 13.0 and y 3.0) to modelTarget
set westRun to add bim wall typed brickType on editor's levelId from (a cad vector2 with x 0.0 and y 10.0) to (a cad vector2 with x 3.0 and y 10.0) to modelTarget
set eastRun to add bim wall typed brickType on editor's levelId from (a cad vector2 with x 3.0 and y 10.0) to (a cad vector2 with x 6.0 and y 10.0) to modelTarget
refresh bim editor e
set editor's tool to bim select tool

# The icons: one per join, 180 mm (18 pixels) into each corner.
check join handle (bim editor shows joins editor) named (the string form of "the Select tool shows join icons")
set shownJoins to the bim shown joins of editor
print ((the string form of "joins shown: ") + (the string form of (the length of shownJoins))) as a line
set iconReach to the bim join icon reach at tolerance 0.08
loop joinCursor from 0 to the length of shownJoins:
    set shownJoin to the item at joinCursor in shownJoins
    print ((((the string form of "  ") + (the bim join kind name of shownJoin's kind)) + (the string form of " icon at ")) + (the join handle text of (the bim join icon point of shownJoin reaching iconReach in editor's documentValue's current))) as a line
check join handle ((the length of shownJoins) = 3) named (the string form of "an L, a T and the walls in line")
# The drawing compiles with the rest; it is not run (no window to draw in).
set noFrame to @intrinsic("construct", a graphics frame, 0 as a pointer, false)
set noTransform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 100.0)
if (the length of shownJoins) < 0:
    draw bim join icons shownJoins of editor through noTransform in noFrame
free shownJoins
set editor's tool to bim wall tool
check join handle ((bim editor shows joins editor) = false) named (the string form of "the wall tool shows none")
set editor's tool to bim select tool

# A click on the L's icon selects the join, not a wall.
click join handle at (a cad vector2 with x 3.88 and y 0.12) in e
print editor's message as a line
check join handle (((editor's selectionKind = bim join picked) and (editor's selectionId = firstLeg)) and (editor's partCode = 1)) named (the string form of "the L's icon selects its join, named from the first wall's finish")
print join handle rows of editor
check join handle ((the join handle row (bim join style property) of editor) = (the string form of "Automatic")) named (the string form of "its style reads Automatic")
check join handle ((the join handle row (bim join runner property) of editor) = (the string form of "none")) named (the string form of "no Runs through row for a mitre")
check join handle ((the join handle row (bim join apart property) of editor) = (the string form of "No")) named (the string form of "Not joined reads No")
set automaticCorner to the join handle end of firstLeg at finish true in editor's documentValue's current

# Clicking the Join style row takes the next style, one undo step each.
start bim editor property (bim join style property) in e
refresh bim editor e
check join handle ((the join handle row (bim join style property) of editor) = (the string form of "Mitre")) named (the string form of "a click makes it Mitre")
start bim editor property (bim join style property) in e
refresh bim editor e
print editor's message as a line
check join handle ((the join handle row (bim join style property) of editor) = (the string form of "Butt")) named (the string form of "the next makes it Butt")
check join handle ((the join handle row (bim join runner property) of editor) = (the bim join wall text of firstLeg in editor's documentValue's current)) named (the string form of "the first wall runs through")
print ((the string form of "  butt: first wall finish ") + (the join handle end of firstLeg at finish true in editor's documentValue's current)) as a line
check join handle ((the join handle end of firstLeg at finish true in editor's documentValue's current) = (the string form of "(4100, -100) (4100, 100)")) named (the string form of "the first wall reaches the far face")
start bim editor property (bim join runner property) in e
refresh bim editor e
check join handle ((the join handle row (bim join runner property) of editor) = (the bim join wall text of secondLeg in editor's documentValue's current)) named (the string form of "Runs through swaps to the second wall")
check join handle ((the join handle end of firstLeg at finish true in editor's documentValue's current) = (the string form of "(3900, -100) (3900, 100)")) named (the string form of "and the first wall stops at its near face")
check join handle (undo bim transaction in (the address of (editor's documentValue))) named (the string form of "undo")
refresh bim editor e
check join handle ((the join handle row (bim join runner property) of editor) = (the bim join wall text of firstLeg in editor's documentValue's current)) named (the string form of "one undo gives the first wall back")
start bim editor property (bim join apart property) in e
refresh bim editor e
print join handle rows of editor
check join handle ((the join handle row (bim join apart property) of editor) = (the string form of "Yes")) named (the string form of "Not joined reads Yes")
check join handle ((the join handle end of firstLeg at finish true in editor's documentValue's current) = (the string form of "(4000, -100) (4000, 100)")) named (the string form of "and the end stays square")
start bim editor property (bim join apart property) in e
refresh bim editor e
check join handle (((the join handle row (bim join style property) of editor) = (the string form of "Automatic")) and ((the join handle end of firstLeg at finish true in editor's documentValue's current) = automaticCorner)) named (the string form of "toggled back it is Automatic, mitred as before")

# Delete leaves a join alone.
set wallsBefore to the length of (editor's documentValue's current's walls's values)
type bim editor key bim delete key code in e
print editor's message as a line
check join handle ((the length of (editor's documentValue's current's walls's values)) = wallsBefore) named (the string form of "Delete removes no wall while a join is selected")

# The T's icon selects the T join; its host runs through, shown only.
click join handle at (a cad vector2 with x 13.12 and y 0.12) in e
print editor's message as a line
check join handle (((editor's selectionKind = bim join picked) and (editor's selectionId = branchWall)) and (editor's partCode = 0)) named (the string form of "the T's icon selects its join")
start bim editor property (bim join style property) in e
refresh bim editor e
print join handle rows of editor
check join handle ((the join handle row (bim join style property) of editor) = (the string form of "Butt")) named (the string form of "a T goes from Automatic to Butt")
check join handle ((the join handle row (bim join runner property) of editor) = (the string form of "none")) named (the string form of "its Runs through is not clickable")

# A click on a wall away from the icons still selects the wall.
click join handle at (a cad vector2 with x 2.0 and y 0.05) in e
check join handle ((editor's selectionKind = bim wall picked) and (editor's selectionId = firstLeg)) named (the string form of "a wall away from the icons still selects")

# Walls in line merge where they meet; set Not joined, a line parts them.
set mergedWest to the join handle drawing of westRun in editor
print ((the string form of "in line, joined: west wall pieces ") + (the string form of ((the length of mergedWest) / 2))) as a line
set inlineJoin to the bim join of wall westRun at finish true in editor's documentValue's current using editor's evaluation's index
check join handle (inlineJoin's kind = bim l join kind) named (the string form of "walls in line join as an L")
select bim editor join inlineJoin in e
start bim editor property (bim join apart property) in e
refresh bim editor e
set partedWest to the join handle drawing of westRun in editor
print ((the string form of "in line, not joined: west wall pieces ") + (the string form of ((the length of partedWest) / 2))) as a line
check join handle (((the length of partedWest) / 2) = (((the length of mergedWest) / 2) + 1)) named (the string form of "Not joined draws the end line between them")
free mergedWest
free partedWest
