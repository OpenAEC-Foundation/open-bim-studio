# SPDX-License-Identifier: MPL-2.0
# Horizontal and vertical interface lines land on whole pixels (issue 42:
# the ribbon's icons, drawn at half or two-thirds of their size, put
# one-pixel lines on pixel edges, which the multisampling drew grey).
import ui/panels/bim_ui.dl

function check crisp {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

check crisp ((the bim ui pixel breadth of 1.0) = 1.0) named (the string form of "a one-pixel line stays one pixel")
check crisp ((the bim ui pixel breadth of 1.5) = 2.0) named (the string form of "a line one and a half wide draws two pixels")
check crisp ((the bim ui pixel breadth of 0.6) = 1.0) named (the string form of "a thinner line still draws one pixel")
check crisp ((the bim ui pixel breadth of 2.0) = 2.0) named (the string form of "a two-pixel line stays two pixels")
check crisp ((the bim ui pixel edge of 4.8 wide 1.0) = 4.0) named (the string form of "a one-pixel line at 4.8 fills pixel 4")
check crisp ((the bim ui pixel edge of 4.3 wide 1.0) = 4.0) named (the string form of "a one-pixel line at 4.3 fills pixel 4")
check crisp ((the bim ui pixel edge of 10.0 wide 2.0) = 9.0) named (the string form of "a two-pixel line at 10 fills pixels 9 and 10")
check crisp ((the bim ui pixel edge of 10.0 wide 1.5) = 9.0) named (the string form of "a line one and a half wide at 10 fills pixels 9 and 10")
