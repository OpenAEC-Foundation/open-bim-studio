# SPDX-License-Identifier: MPL-2.0
# Two roof planes meeting at a ridge share an edge, each running it the
# other way round. Dashed from the same end, they lay the same dashes on it,
# so the ridge reads as one dashed line rather than a solid one (two sets of
# dashes out of step fill each other's gaps).
import ui/panels/bim_plan_panel.dl

function the bim ridge dashes of {a 64 bit integer:plateId} in {bim model record:modelValue} through {bim drawing transform record:transform}:
    execute:
        set found to the bim slab index of plateId in modelValue
        set pairs to an empty list of a cad vector2
        append bim edges of slab (the item at found's position in (modelValue's slabs's values)) in modelValue through transform dashing 8.0 into pairs
        # Only the pieces on the ridge, y = 5 m (pixel y -500 at 100 pixels a metre).
        set summary to the string form of ""
        set cursor to 0
        loop while (cursor + 1) < the length of pairs:
            set first to the item at cursor in pairs
            set second to the item at (cursor + 1) in pairs
            if ((the absolute value of (first's y + 500.0)) < 0.01) and ((the absolute value of (second's y + 500.0)) < 0.01):
                set low to the minimum of first's x and second's x
                set high to the maximum of first's x and second's x
                set summary to ((summary + (the string form of " ")) + (the string form of (low as an integer))) + ((the string form of "-") + (the string form of (high as an integer)))
            set cursor to cursor + 2
        free pairs
        return summary

set editor to a new bim editor
set modelTarget to the address of (editor's documentValue's current)
set roofLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.2)) to roofLayers
set roofType to add bim planar type named (the string form of "Roof 200") as role bim roof planar role with roofLayers to modelTarget
free roofLayers
# South plane 0..1 by 0..5 anticlockwise from its eave; north plane 0..1 by
# 5..10 starting on the ridge: the ridge runs +x in one and -x in the other.
set southOutline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to southOutline
append (a cad vector2 with x 1.0 and y 0.0) to southOutline
append (a cad vector2 with x 1.0 and y 5.0) to southOutline
append (a cad vector2 with x 0.0 and y 5.0) to southOutline
set southId to add bim plate typed roofType on editor's levelId around southOutline at top 3.0 to modelTarget
set northOutline to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 5.0) to northOutline
append (a cad vector2 with x 1.0 and y 5.0) to northOutline
append (a cad vector2 with x 1.0 and y 10.0) to northOutline
append (a cad vector2 with x 0.0 and y 10.0) to northOutline
set northId to add bim plate typed roofType on editor's levelId around northOutline at top 3.0 to modelTarget
free southOutline
free northOutline
set transform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 100.0)
set southDashes to the bim ridge dashes of southId in editor's documentValue's current through transform
set northDashes to the bim ridge dashes of northId in editor's documentValue's current through transform
print ((the string form of "south ridge:") + southDashes) as a line
print ((the string form of "north ridge:") + northDashes) as a line
print ((the string form of "same dashes: ") + (the string form of (southDashes = northDashes))) as a line
