# SPDX-License-Identifier: MPL-2.0
# The section marks in the plan (issue #106). Under NEN the head is the INB
# template's section arrow: 6 mm wide at its base and 4 mm deep in paper
# millimetres, its base centred on the line's end and its apex the way the
# section looks, the mark's number beside it, the same at 1:50 and 1:100 on a
# sheet. Under BS / ISO the head keeps its circle. A click on a section's line
# or in its arrow selects the section view (its properties shown); a click
# beside it does not.
import ui/panels/bim_plan_panel.dl

# `value` in hundredths, rounded, as text.
function the section test hundredths of {a 64 bit floating-point number:value}:
    execute:
        set sign to the string form of ""
        set magnitude to value
        if value < 0.0:
            set sign to the string form of "-"
            set magnitude to 0.0 - value
        return sign + (the string form of (((magnitude * 100.0) + 0.5) as an integer))

function show section test marks of {bim editor record:editor} at scale {a 64 bit floating-point number:denominator}:
    execute:
        # Two canvas units to the paper millimetre, as on a sheet.
        set paper to 2.0
        set sheet to a new bim canvas
        set sheet's paperScale to paper
        set transform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 100.0 and y 100.0), (a cad vector2 with x 0.0 and y 0.0), (paper * 1000.0) / denominator)
        draw bim section marks in plan of editor through transform on (the address of sheet)
        set startPixel to the bim pixel of (a cad vector2 with x 0.0 and y 0.0) through transform
        set arrows to the item at 2 in (sheet's batches's values)
        set corners to arrows's pixels's values
        print ((the string form of "1:") + (the string form of (denominator as an integer))) as a line
        print (((the string form of "  batches ") + (the string form of (the length of (sheet's batches's values)))) + ((the string form of ", arrow corners ") + (the string form of (the length of corners)))) as a line
        set baseLeft to the item at 0 in corners
        set apex to the item at 1 in corners
        set baseRight to the item at 2 in corners
        set baseMiddle to a cad vector2 with x ((baseLeft's x + baseRight's x) * 0.5) and y ((baseLeft's y + baseRight's y) * 0.5)
        print (((the string form of "  base (mm/100) ") + (the section test hundredths of ((the cad distance from baseLeft to baseRight) / paper))) + ((the string form of ", depth ") + (the section test hundredths of ((the cad distance from baseMiddle to apex) / paper)))) as a line
        print ((the string form of "  base middle off the line's end (mm/100) ") + (the section test hundredths of ((the cad distance from baseMiddle to startPixel) / paper))) as a line
        print ((the string form of "  apex up the sheet (looking left of the line): ") + (the string form of (apex's y < baseMiddle's y))) as a line
        set firstText to the item at 0 in (sheet's texts's values)
        print (((the string form of "  mark ") + firstText's message) + ((the string form of " at (mm/100) ") + ((the section test hundredths of ((firstText's x - startPixel's x) / paper)) + ((the string form of ", ") + (the section test hundredths of ((firstText's y - startPixel's y) / paper)))))) as a line

function show section test pick at {a 64 bit floating-point number:pickX} and {a 64 bit floating-point number:pickY} of {a 64 bit integer:sectionId} in {a pointer to a bim editor record:editor} labelled {a string:caption}:
    execute:
        set editor's propertiesViewId to the bim refused id
        select bim editor element at (a cad vector2 with x pickX and y pickY) in editor
        set chosen to (editor's propertiesViewId = sectionId) and (editor's selectionKind = bim nothing picked)
        print ((caption + (the string form of ": section selected ")) + (the string form of chosen)) as a line

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
# A section 4 m along x, looking left of its line (up, +y).
set sectionId to add bim section view from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 4.0 and y 0.0) to target
print ((the string form of "standard: ") + (the bim name of standard (the bim drawing standard of editor's documentValue's current))) as a line
show section test marks of editor at scale 50.0
show section test marks of editor at scale 100.0
set bim setting (bim drawing standard setting) of (0 as a 64 bit integer) to ((bim iso standard) as a 64 bit integer) keeping true in target
set circledCanvas to a new bim canvas
set circledCanvas's paperScale to 2.0
draw bim section marks in plan of editor through (@intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 100.0 and y 100.0), (a cad vector2 with x 0.0 and y 0.0), 40.0)) on (the address of circledCanvas)
print (((the string form of "BS / ISO: batches ") + (the string form of (the length of (circledCanvas's batches's values)))) + ((the string form of ", arrow corners ") + (the string form of (the length of ((the item at 2 in (circledCanvas's batches's values))'s pixels's values))))) as a line
set bim setting (bim drawing standard setting) of (0 as a 64 bit integer) to ((bim nen standard) as a 64 bit integer) keeping true in target
# Eight pixels at 100 pixels to the metre: a screen millimetre is 4 cm.
set editor's pickTolerance to 0.08
show section test pick at 2.0 and 0.05 of sectionId in e labelled (the string form of "on the line")
print editor's message as a line
set propertyRows to the bim property rows of editor
loop cursor from 0 to the length of propertyRows:
    set propertyRow to the item at cursor in propertyRows
    if (propertyRow's label = "Name") or (propertyRow's label = "Kind"):
        print ((the string form of "  ") + ((propertyRow's label + (the string form of ": ")) + propertyRow's value)) as a line
show section test pick at 2.0 and 0.5 of sectionId in e labelled (the string form of "half a metre beside")
show section test pick at 0.0 and 0.12 of sectionId in e labelled (the string form of "in the start's arrow")
show section test pick at 4.0 and 0.12 of sectionId in e labelled (the string form of "in the finish's arrow")
show section test pick at 0.0 and -0.12 of sectionId in e labelled (the string form of "behind the start's arrow")
show section test pick at 4.6 and 0.0 of sectionId in e labelled (the string form of "beyond the finish")
