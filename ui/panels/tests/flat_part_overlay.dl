# SPDX-License-Identifier: MPL-2.0
# The outline of a picked system part (`the bim chosen part corners of`):
# on an upright system the part's box stands on the line, up the face; on
# a system lying level (a ceiling) it lies across the line at the system's
# height — not up from the carrier, which is what the 3D view drew before
# (issue 22). The systems come from the type gallery, which places every
# recipe, the ceilings lying level.
import ui/editor/bim_editor.dl
import ui/panels/bim_plan_panel.dl
import pattern/common/bim_system_types.dl

function check flat part overlay {boolean:condition} named {a string:label}:
    execute:
        if condition = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# The corners of cell 0 of system `systemId` as the panels outline it.
function the overlay test corners of {a 64 bit integer:systemId} in {a pointer to a bim editor record:editor}:
    execute:
        select bim editor bim curtain picked numbered systemId in editor
        set editor's partCode to 2000
        set chosenPart to the bim chosen part of (@intrinsic("dereference", editor))
        return the bim chosen part corners of chosenPart in editor's documentValue's current

set editor to a new bim editor
set e to the address of editor
set target to the address of (editor's documentValue's current)
set levelId to add bim level named (the string form of "Ground floor") at 1.0 with height 3.0 to target
set gallery to add bim system type gallery at (a cad vector2 with x 0.0 and y 0.0) on levelId in target
set modelValue to editor's documentValue's current
set flatId to the bim refused id
set uprightId to the bim refused id
loop cursor from 0 to the length of (gallery's values):
    set systemId to the item at cursor in (gallery's values)
    if bim system systemId lies level in modelValue:
        if flatId = the bim refused id:
            set flatId to systemId
    else if uprightId = the bim refused id:
        set uprightId to systemId
check flat part overlay ((flatId != the bim refused id) and (uprightId != the bim refused id)) named (the string form of "the gallery holds a system lying level and one upright")

set flatCorners to the overlay test corners of flatId in e
set flatSystem to the item at (the bim curtain index of flatId in modelValue)'s position in (modelValue's curtains's values)
set flatHeight to 1.0 + (((the bim setting (bim system level setting) of flatId in modelValue)'s value as a 64 bit floating-point number) / 1000.0)
set oneHeight to true
set spansAcross to false
loop cursor from 0 to the length of flatCorners:
    set corner to the item at cursor in flatCorners
    if (the absolute value of (corner's z - flatHeight)) > 0.000001:
        set oneHeight to false
    if (the absolute value of (corner's y - flatSystem's start's y)) > 0.01:
        set spansAcross to true
check flat part overlay ((the length of flatCorners) = 4) named (the string form of "four corners for a cell")
check flat part overlay oneHeight named (the string form of "lying level: every corner at the storey's height plus the system's level")
check flat part overlay spansAcross named (the string form of "lying level: the cell lies across the line, not on it")

set uprightCorners to the overlay test corners of uprightId in e
set uprightSystem to the item at (the bim curtain index of uprightId in modelValue)'s position in (modelValue's curtains's values)
set onLine to true
set standsUp to false
loop cursor from 0 to the length of uprightCorners:
    set corner to the item at cursor in uprightCorners
    if (the absolute value of (corner's y - uprightSystem's start's y)) > 0.000001:
        set onLine to false
    if corner's z > (1.0 + 0.01):
        set standsUp to true
check flat part overlay onLine named (the string form of "upright: every corner on the system's line")
check flat part overlay standsUp named (the string form of "upright: the cell stands up the face")
free flatCorners
free uprightCorners
