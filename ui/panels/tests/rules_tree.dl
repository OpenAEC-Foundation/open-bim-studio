# SPDX-License-Identifier: MPL-2.0
# The Drawing Rules window's Visibility/Graphics tree (issue #124): opening
# a category, a click on a part's or a line cell setting an override on the
# drawing type, Duplicate copying the overrides and Delete dropping them; a
# plan's overrides change its drawing's key, and styled cut lines are
# recorded one batch per colour and width.
import ui/panels/bim_rules_window.dl
import ui/panels/bim_plan_panel.dl

function check rules tree {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the owned tree settings of {a 64 bit integer:ownerId} in {bim model record:modelValue}:
    execute:
        set entries to the bim tree settings of modelValue
        set count to 0
        loop cursor from 0 to the length of (entries's values):
            if (the item at cursor in (entries's values))'s elementId = ownerId:
                set count to count + 1
        return count

set editor to a new bim editor
set e to the address of editor
ensure bim drawing types in (the address of (editor's documentValue's current))
set pilePlan to the bim drawing type named (the string form of "Pile plan") in editor's documentValue's current
set opened to an empty list of an integer
toggle bim rules category bim slab category in opened
check rules tree (bim rules category bim slab category is open in opened) named (the string form of "a click on Floors opens it")
toggle bim rules category bim slab category in opened
check rules tree ((bim rules category bim slab category is open in opened) = false) named (the string form of "a second click closes it")

set structuralFloors to the bim node key of category bim slab category part bim structural part
set otherFloors to the bim node key of category bim slab category part bim non structural part
set cutClick to a bim rules hit (bim rules cycle cell) on pilePlan at ((bim rules tree field base) + (bim cut colour field)) and structuralFloors
ignore apply bim rules hit cutClick choosing pilePlan in e
ignore apply bim rules hit cutClick choosing pilePlan in e
set entries to the bim tree settings of editor's documentValue's current
check rules tree ((the bim own override (bim cut colour field) of node structuralFloors on pilePlan among entries in editor's documentValue's current) = (the bim override colour 1)) named (the string form of "two clicks colour structural floors' cut lines red")
set hideClick to a bim rules hit (bim rules cycle cell) on pilePlan at ((bim rules tree field base) + (bim node visible field)) and otherFloors
ignore apply bim rules hit hideClick choosing pilePlan in e
ignore apply bim rules hit hideClick choosing pilePlan in e
set pileRules to the bim rules of drawing type pilePlan in editor's documentValue's current
check rules tree (((the bim tree node otherFloors in pileRules)'s visible = false) and (the bim tree node structuralFloors in pileRules)'s visible) named (the string form of "non-structural floors hidden, structural ones still shown")
check rules tree (bim category bim slab category is split in pileRules) named (the string form of "the floors are drawn split")
set undone to the length of (editor's documentValue's undoStack's values)
check rules tree (undone > 0) named (the string form of "each click is a step to undo")

set copied to duplicate bim editor drawing type pilePlan in e
check rules tree ((the owned tree settings of copied in editor's documentValue's current) = 2) named (the string form of "Duplicate copies the overrides")
check rules tree (delete bim editor drawing type copied in e) named (the string form of "the copy can be deleted")
check rules tree ((the owned tree settings of copied in editor's documentValue's current) = 0) named (the string form of "Delete drops its overrides")

set target to the address of (editor's documentValue's current)
set planView to add bim view of kind (bim plan view) named (the string form of "Review") on editor's levelId to target
show bim editor plan view planView in e
set plainKey to the bim plan key of editor at 100.0
set floorsKey to the bim node key of category bim slab category part bim whole category part
set bim override (bim cut weight field) of node floorsKey on planView to (50 as a 64 bit integer) in target
show bim editor plan view planView in e
check rules tree ((the bim plan key of editor at 100.0) != plainKey) named (the string form of "a view's own override changes its drawing")
check rules tree (((the bim tree node floorsKey in editor's planRules)'s cutWeight) = (50 as a 64 bit integer)) named (the string form of "the plan's rules carry the view's override")

set canvas to a new bim canvas
set pairs to an empty list of a cad vector2
set colours to an empty list of a 64 bit integer
set widths to an empty list of a 64 bit floating-point number
loop index from 0 to 3:
    append (a cad vector2 with x 0.0 and y (index as a 64 bit floating-point number)) to pairs
    append (a cad vector2 with x 10.0 and y (index as a 64 bit floating-point number)) to pairs
    append (the bim override colour 1) to colours
    append 1.0 to widths
replace item at index 1 in colours with (the bim override colour 2)
record bim styled strokes pairs coloured colours wide widths on (the address of canvas)
check rules tree ((the length of (canvas's batches's values)) = 2) named (the string form of "red and blue cut lines are two batches")
print ((the string form of "weights: ") + ((the bim name of weight (13 as a 64 bit integer)) + ((the string form of " ") + (the bim name of weight (100 as a 64 bit integer))))) as a line
