# Reordering tabs preserves identities used by active and tiled panes.
import lib/std.dl
import lib/list.dl

# A new document starts with its actual plan and one 3D pane, never old
# sheet/view identities that happen to reuse IDs in another project.
function reset bim workspace tabs for plan {a 64 bit integer:viewId} among {a pointer to a list:kinds} and {a pointer to a list:details}:
    execute:
        clear kinds
        clear details
        append 0 to kinds
        append viewId to details
        append 1 to kinds
        append (0 as a 64 bit integer) to details

# Bounded labels leave room for neighbouring views and a separate close hit.
function the bim workspace tab width for {a 64 bit floating-point number:textWidth}:
    execute:
        return the maximum of 88.0 and (the minimum of 180.0 and (textWidth + 38.0))

function the bim workspace scroll {a 64 bit floating-point number:offset} limited across {a 64 bit floating-point number:room} of {a 64 bit floating-point number:contentWidth}:
    execute:
        return the maximum of 0.0 and (the minimum of offset and (the maximum of 0.0 and (contentWidth - room)))

function the bim workspace scroll {a 64 bit floating-point number:offset} revealing {a 64 bit floating-point number:first} to {a 64 bit floating-point number:last} across {a 64 bit floating-point number:room} of {a 64 bit floating-point number:contentWidth}:
    execute:
        set moved to offset
        if first < moved:
            set moved to first
        else if last > (moved + room):
            set moved to last - room
        return the bim workspace scroll moved limited across room of contentWidth

# Whether a press at `pointerX`, `pointerY` lands on the workspace's tab
# bar: from `barTop` down `barHeight`, across the workspace between
# `barLeft` and `barRight` only. The Model Explorer's head (its Tree and
# Graph buttons) stands right of the workspace in the same band, and a press
# there belongs to the explorer.
function the bim workspace tab bar holds {a 64 bit floating-point number:pointerX} by {a 64 bit floating-point number:pointerY} between {a 64 bit floating-point number:barLeft} and {a 64 bit floating-point number:barRight} below {a 64 bit floating-point number:barTop} down {a 64 bit floating-point number:barHeight}:
    execute:
        if (pointerY < barTop) or (pointerY >= (barTop + barHeight)):
            return false
        return (pointerX > barLeft) and (pointerX < barRight)

function the bim tab index {integer:currentIndex} after moving {integer:sourceIndex} to {integer:destinationIndex}:
    execute:
        if currentIndex = sourceIndex:
            return destinationIndex
        if (sourceIndex < destinationIndex) and ((currentIndex > sourceIndex) and (currentIndex <= destinationIndex)):
            return currentIndex - 1
        if (destinationIndex < sourceIndex) and ((currentIndex >= destinationIndex) and (currentIndex < sourceIndex)):
            return currentIndex + 1
        return currentIndex

function move bim workspace tab {integer:sourceIndex} to {integer:destinationIndex} among {a pointer to a list:kinds} and {a pointer to a list:details}:
    execute:
        set count to the length of kinds
        if (the length of details) != count:
            return false
        if ((sourceIndex < 0) or (sourceIndex >= count)) or ((destinationIndex < 0) or (destinationIndex >= count)):
            return false
        if sourceIndex = destinationIndex:
            return false
        set movedKind to the item at sourceIndex in kinds
        set movedDetail to the item at sourceIndex in details
        remove item sourceIndex from kinds
        remove item sourceIndex from details
        insert movedKind into kinds at index destinationIndex
        insert movedDetail into details at index destinationIndex
        return true
