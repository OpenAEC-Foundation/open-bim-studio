# SPDX-License-Identifier: MPL-2.0
# The chrome's sizes and where its parts stand (`bim_ui.dl` draws them),
# without anything to draw with, so that a test can check the layout alone.
#
# The heights after the OpenAEC style's ribbon app (Style Repo 0.4,
# design/ontwerp-0.4/05-layouts.md): the ribbon's tabs 28 (and, at their
# right end, the active tab's sub-tabs), the ribbon 94, the document tabs
# 30. The window's own title bar (the system's) names the application and
# holds its buttons, so the chrome has no title row of its own (height 0):
# the top bar is the tabs alone, and the quick actions (Save, Undo, Redo)
# stand in the document bar beside the open model's name.
function bim ui title bar height:
    replacement:
        0.0
function bim ui top bar height:
    replacement:
        28.0
function bim ui ribbon height:
    replacement:
        94.0
function bim ui document bar height:
    replacement:
        30.0
function bim ui explorer width:
    replacement:
        244.0
# The rail of section buttons on the window's left edge (canvas first: the
# browser opens beside it only when asked).
function bim ui rail width:
    replacement:
        52.0
# The row of sub-tabs at the ribbon's top.
function bim ui subtab height:
    replacement:
        22.0
function bim ui command line height:
    replacement:
        24.0
function bim ui status bar height:
    replacement:
        28.0

# Where the canvas starts below the chrome: under the ribbon, or, the
# ribbon folded, under the tabs; the document bar between.
function the bim ui canvas top folded {boolean:isFolded}:
    execute:
        if isFolded:
            return (bim ui top bar height) + (bim ui document bar height)
        return ((bim ui top bar height) + (bim ui ribbon height)) + (bim ui document bar height)

# The document bar's top edge: right above the canvas.
function the bim ui document bar top folded {boolean:isFolded}:
    execute:
        return (the bim ui canvas top folded isFolded) - (bim ui document bar height)

# The document bar's quick actions (Save, Undo, Redo), square buttons 24
# pixels a side, 2 apart, the first 8 after the open model's name tab
# (`tabWidth` wide from 8): button `index`'s left edge, and their top edge
# 3 below the bar's `barTop`.
function bim ui document button size:
    replacement:
        24.0
function the bim ui document button {integer:index} left after a tab {a 64 bit floating-point number:tabWidth}:
    execute:
        return ((8.0 + tabWidth) + 8.0) + (26.0 * (index as a 64 bit floating-point number))
function the bim ui document button top below {a 64 bit floating-point number:barTop}:
    execute:
        return barTop + 3.0

# The width of the open model's tab round its name, `nameWidth` pixels
# wide, with room for the dot of unsaved changes (`hasChanges`).
function the bim ui document tab width around {a 64 bit floating-point number:nameWidth} changed {boolean:hasChanges}:
    execute:
        if hasChanges:
            return nameWidth + 38.0
        return nameWidth + 24.0
