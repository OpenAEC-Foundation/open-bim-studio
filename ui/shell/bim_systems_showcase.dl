# SPDX-License-Identifier: MPL-2.0
# A reproducible mixed-construction building, with explicit assembly specimens.
import pattern/common/bim_masonry_gallery.dl
import pattern/common/bim_system_types.dl
import views/common/bim_view.dl

function the bim showcase point {a 64 bit floating-point number:x} {a 64 bit floating-point number:y}:
    execute:
        return a cad vector2 with x x and y y

function add bim showcase box to {a 64 bit integer:definitionId} from {a 64 bit floating-point number:x} {a 64 bit floating-point number:y} {a 64 bit floating-point number:z} sized {a 64 bit floating-point number:dx} {a 64 bit floating-point number:dy} {a 64 bit floating-point number:dz} of {a string:materialName} in {a pointer to a bim model record:target}:
    execute:
        add bim gallery box to definitionId at (a cad vector3 with x x, y y and z z) sized (a cad vector3 with x dx, y dy and z dz) of materialName in target

function add bim showcase system {integer:recipe} on {a 64 bit integer:levelId} from {cad vector2:start} to {cad vector2:finish} spanning {a 64 bit floating-point number:height} in {a pointer to a bim model record:target}:
    execute:
        set made to add bim curtain wall on levelId from start to finish rising height in bays of 1.2 by 3.2 of (the string form of "aluminium") to target
        ignore give bim system made type recipe in target
        return made

function the bim systems showcase:
    execute:
        set modelValue to an empty bim model
        set target to the address of modelValue
        set levels to an empty list of a 64 bit integer
        loop storey from 0 to 4:
            set title to the string form of "Ground - PS beam and EPS floor"
            if storey = 1:
                set title to the string form of "First - lattice girder precast floor"
            if storey = 2:
                set title to the string form of "Second - timber joist floor"
            if storey = 3:
                set title to the string form of "Roof - hollow core floor"
            append (add bim level named title at ((storey as a 64 bit floating-point number) * 3.2) with height 3.2 to target) to levels
        set ground to the item at 0 in levels
        set wallLayers to an empty list of a bim layer record
        append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.2)) to wallLayers
        ignore add bim wall type named (the string form of "Concrete core 200") with wallLayers to target
        free wallLayers
        ignore add bim opening type named (the string form of "Window 1200x1500") sized 1.2 by 1.5 with sill 0.9 and frame 0.06 to target
        ignore add bim door type named (the string form of "Door 1000x2300") sized 1.0 by 2.3 with frame 0.06 to target
        set pileType to add bim linear type named (the string form of "Pile 300") as role bim pile role sized 0.3 by 0.3 round true of (the string form of "concrete") to target
        set columnType to add bim linear type named (the string form of "Column 300") as role bim column role sized 0.3 by 0.3 round false of (the string form of "concrete") to target
        set beamType to add bim linear type named (the string form of "Beam 300x500") as role bim beam role sized 0.3 by 0.5 round false of (the string form of "concrete") to target
        set cap to add bim component named (the string form of "Three-pile cap 1600") to target
        add bim showcase box to cap from -0.8 -0.8 -0.9 sized 1.6 1.6 0.5 of (the string form of "concrete") in target
        loop row from 0 to 3:
            set y to (row as a 64 bit floating-point number) * 6.0
            ignore add bim grid named ((the string form of "Y") + (the string form of row)) from (the bim showcase point -2.0 y) to (the bim showcase point 20.0 y) reaching -6.0 to 11.0 to target
            loop column from 0 to 4:
                set x to (column as a 64 bit floating-point number) * 6.0
                ignore place bim component cap on ground at (the bim showcase point x y) turned 0.0 to target
                loop pile from 0 to 3:
                    set px to (x - 0.45) + ((pile as a 64 bit floating-point number) * 0.45)
                    set py to y - 0.35
                    if pile = 1:
                        set py to y + 0.35
                    ignore add bim linear typed pileType on ground from (a cad vector3 with x px, y py and z -6.0) to (a cad vector3 with x px, y py and z -0.65) turned 0.0 to target
                loop storey from 0 to 3:
                    set levelId to the item at storey in levels
                    ignore add bim linear typed columnType on levelId from (a cad vector3 with x x, y y and z 0.0) to (a cad vector3 with x x, y y and z 3.2) turned 0.0 to target
                    if column < 3:
                        ignore add bim linear typed beamType on levelId from (a cad vector3 with x x, y y and z 2.95) to (a cad vector3 with x (x + 6.0), y y and z 2.95) turned 0.0 to target
                    if row < 2:
                        ignore add bim linear typed beamType on levelId from (a cad vector3 with x x, y y and z 2.95) to (a cad vector3 with x x, y (y + 6.0) and z 2.95) turned 0.0 to target
        loop column from 0 to 4:
            set x to (column as a 64 bit floating-point number) * 6.0
            ignore add bim grid named ((the string form of "X") + (the string form of column)) from (the bim showcase point x -2.0) to (the bim showcase point x 14.0) reaching -6.0 to 11.0 to target
        # Shared 600 mm floor units, with explicit ribs, infill and deck layers.
        set ps to add bim component named (the string form of "PS combination floor 600 module") to target
        add bim showcase box to ps from 0.0 0.0 -0.22 sized 0.1 5.98 0.22 of (the string form of "concrete") in target
        add bim showcase box to ps from 0.1 0.0 -0.2 sized 0.49 5.98 0.18 of (the string form of "insulation") in target
        add bim showcase box to ps from 0.0 0.0 0.0 sized 0.59 5.98 0.05 of (the string form of "concrete") in target
        set precast to add bim component named (the string form of "Precast lattice girder floor 600 module") to target
        add bim showcase box to precast from 0.0 0.0 -0.06 sized 0.59 5.98 0.06 of (the string form of "concrete") in target
        add bim showcase box to precast from 0.0 0.0 0.0 sized 0.59 5.98 0.14 of (the string form of "concrete") in target
        # Exposed edge specimen shows lattice geometry alongside the building.
        set truss to add bim component named (the string form of "Precast floor exposed reinforcement specimen") to target
        add bim showcase box to truss from 0.0 0.0 -0.06 sized 1.19 5.98 0.06 of (the string form of "concrete") in target
        loop rib from 0 to 3:
            set x to 0.15 + ((rib as a 64 bit floating-point number) * 0.4)
            add bim showcase box to truss from x 0.0 0.12 sized 0.012 5.98 0.012 of (the string form of "steel") in target
            loop link from 0 to 20:
                add bim showcase box to truss from x ((link as a 64 bit floating-point number) * 0.3) 0.0 sized 0.012 0.012 0.12 of (the string form of "steel") in target
        ignore place bim component truss on ground at (the bim showcase point 22.0 0.0) turned 0.0 to target
        set timber to add bim component named (the string form of "Timber joist and OSB 600 module") to target
        add bim showcase box to timber from 0.0 0.0 -0.225 sized 0.063 5.98 0.225 of (the string form of "timber") in target
        add bim showcase box to timber from 0.0 0.0 0.0 sized 0.59 5.98 0.022 of (the string form of "timber") in target
        loop storey from 0 to 3:
            set definitionId to ps
            if storey = 1:
                set definitionId to precast
            if storey = 2:
                set definitionId to timber
            loop bay from 0 to 6:
                # A 6 x 6 m stair reservation remains open at the rear right.
                if bay != 5:
                    set x to ((the remainder of bay divided by 3) as a 64 bit floating-point number) * 6.0
                    set y to ((bay / 3) as a 64 bit floating-point number) * 6.0
                    loop panel from 0 to 10:
                        ignore place bim component definitionId on (the item at storey in levels) at (the bim showcase point (x + ((panel as a 64 bit floating-point number) * 0.6)) y) turned 0.0 to target
            ignore add bim stair on (the item at storey in levels) from (the bim showcase point 12.5 7.0) to (the bim showcase point 17.5 7.0) wide 1.2 in 18 risers of (the string form of "concrete") to target
            # Three native systems per floor: curtain wall, HSB and masonry.
            ignore add bim showcase system 0 on (the item at storey in levels) from (the bim showcase point 0.0 0.0) to (the bim showcase point 18.0 0.0) spanning 3.2 in target
            ignore add bim showcase system 6 on (the item at storey in levels) from (the bim showcase point 0.0 0.0) to (the bim showcase point 0.0 12.0) spanning 3.2 in target
            ignore add bim showcase system 8 on (the item at storey in levels) from (the bim showcase point 0.0 12.0) to (the bim showcase point 12.0 12.0) spanning 3.2 in target
        loop bay from 0 to 3:
            set x to (bay as a 64 bit floating-point number) * 6.0
            set roofSystem to add bim showcase system 16 on (the item at 3 in levels) from (the bim showcase point x 0.0) to (the bim showcase point (x + 6.0) 0.0) spanning 12.0 in target
            set bim setting (bim system level setting) of roofSystem to (0 as a 64 bit integer) keeping true in target
        # Independent cladding and ceiling assemblies at the east side.
        ignore add bim showcase system 12 on ground from (the bim showcase point 18.0 0.0) to (the bim showcase point 18.0 4.0) spanning 3.2 in target
        ignore add bim showcase system 13 on (the item at 1 in levels) from (the bim showcase point 18.0 0.0) to (the bim showcase point 18.0 4.0) spanning 3.2 in target
        ignore add bim showcase system 14 on (the item at 2 in levels) from (the bim showcase point 18.0 0.0) to (the bim showcase point 18.0 4.0) spanning 3.2 in target
        ignore add bim showcase system 20 on ground from (the bim showcase point 0.0 0.0) to (the bim showcase point 6.0 0.0) spanning 6.0 in target
        add bim masonry gallery on ground in target
        set defaultViews to ensure bim default views in target
        free defaultViews
        ignore add bim section view from (the bim showcase point -2.0 3.0) to (the bim showcase point 20.0 3.0) to target
        ignore add bim section view from (the bim showcase point 9.0 -2.0) to (the bim showcase point 9.0 14.0) to target
        set sheetId to add bim sheet numbered (the string form of "A-001") named (the string form of "Mixed construction - plans") on paper 1 landscape true to target
        loop viewCursor from 0 to 4:
            set viewValue to the item at viewCursor in modelValue's views's values
            set px to 220.0 + ((the remainder of viewCursor divided by 2) as a 64 bit floating-point number) * 400.0
            set py to 170.0 + ((viewCursor / 2) as a 64 bit floating-point number) * 270.0
            ignore place bim view viewValue's id on sheet sheetId at (the bim showcase point px py) looking at (the bim showcase point 9.0 6.0) in target
        free levels
        return modelValue
