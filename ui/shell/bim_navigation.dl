# SPDX-License-Identifier: MPL-2.0
# Navigation styles and the gizmo's choices, as the application's settings
# keep them (`bim_app_files.dl`) and the Settings window offers them
# (`bim_ui_files.dl`, #137). A navigation style maps the right and the middle
# mouse button, with Shift, Ctrl or Alt held, to orbiting, panning, zooming
# or placing the 3D cursor; the window (`main.dl`) moves the camera by it.
# The left button always picks and drags a selection box, and the wheel
# always zooms about the pointer.
import lib/std.dl
import lib/string.dl
import kernel/core/core.dl

# ------------------------------------------------------------ navigation

# The styles: the application's own (the right button orbits, the middle
# pans, Shift and the middle orbit), Revit and AutoCAD (the middle pans,
# Shift and the middle orbit), Blender (the middle orbits, Shift and the
# middle pan, Ctrl and the middle zoom, the numeric keypad's views),
# SketchUp (the middle orbits, Shift and the middle pan) and Rhino (the right
# button orbits, Shift and the right pan, Ctrl and the right zoom).
function bim own navigation style:
    replacement:
        0
function bim revit navigation style:
    replacement:
        1
function bim blender navigation style:
    replacement:
        2
function bim sketchup navigation style:
    replacement:
        3
function bim rhino navigation style:
    replacement:
        4

function the bim navigation style count:
    replacement:
        5

# A style's name, as the Settings window lists it.
function the bim name of navigation style {integer:styleCode}:
    execute:
        if styleCode = bim revit navigation style:
            return the string form of "Revit / AutoCAD"
        if styleCode = bim blender navigation style:
            return the string form of "Blender"
        if styleCode = bim sketchup navigation style:
            return the string form of "SketchUp"
        if styleCode = bim rhino navigation style:
            return the string form of "Rhino"
        return the string form of "Open BIM Studio"

# The buttons a style maps.
function bim right navigation button:
    replacement:
        1
function bim middle navigation button:
    replacement:
        2

# The key held with a button: none, Shift, Ctrl or Alt (in that order of
# precedence when several are held, `the bim navigation modifier with`).
function bim plain navigation modifier:
    replacement:
        0
function bim shift navigation modifier:
    replacement:
        1
function bim control navigation modifier:
    replacement:
        2
function bim alt navigation modifier:
    replacement:
        3

function the bim navigation modifier with shift {boolean:shiftHeld} control {boolean:controlHeld} alt {boolean:altHeld}:
    execute:
        if shiftHeld:
            return bim shift navigation modifier
        if controlHeld:
            return bim control navigation modifier
        if altHeld:
            return bim alt navigation modifier
        return bim plain navigation modifier

# What a drag does: nothing, orbit (in a plan or section: pan), pan, zoom
# (dragging up zooms in), or place the 3D cursor under the pointer.
function bim no navigation:
    replacement:
        0
function bim orbit navigation:
    replacement:
        1
function bim pan navigation:
    replacement:
        2
function bim zoom navigation:
    replacement:
        3
function bim cursor navigation:
    replacement:
        4

# What dragging with button `buttonCode` and key `modifierCode` held does in
# style `styleCode`. Shift and the right button place the 3D cursor in every
# style but Rhino's, where they pan and Alt and the right button place it.
function the bim navigation of style {integer:styleCode} dragging button {integer:buttonCode} holding {integer:modifierCode}:
    execute:
        if buttonCode = bim right navigation button:
            if styleCode = bim rhino navigation style:
                if modifierCode = bim shift navigation modifier:
                    return bim pan navigation
                if modifierCode = bim control navigation modifier:
                    return bim zoom navigation
                if modifierCode = bim alt navigation modifier:
                    return bim cursor navigation
                return bim orbit navigation
            if modifierCode = bim shift navigation modifier:
                return bim cursor navigation
            if styleCode = bim own navigation style:
                return bim orbit navigation
            return bim no navigation
        if buttonCode != bim middle navigation button:
            return bim no navigation
        if (styleCode = bim blender navigation style) or (styleCode = bim sketchup navigation style):
            if modifierCode = bim shift navigation modifier:
                return bim pan navigation
            if (modifierCode = bim control navigation modifier) and (styleCode = bim blender navigation style):
                return bim zoom navigation
            return bim orbit navigation
        if (modifierCode = bim shift navigation modifier) and (styleCode != bim rhino navigation style):
            return bim orbit navigation
        return bim pan navigation

# The buttons and keys that do `actionCode` in style `styleCode`, as the
# Settings window lists them ("Shift+Middle, Right"): a button with a key
# held is left out where the button alone does the same; zooming always
# lists the wheel first; "-" for none.
function the bim navigation summary of style {integer:styleCode} doing {integer:actionCode}:
    execute:
        set listed to the string form of ""
        if actionCode = bim zoom navigation:
            set listed to the string form of "Wheel"
        loop buttonCursor from 1 to 3:
            set plainAction to the bim navigation of style styleCode dragging button buttonCursor holding (bim plain navigation modifier)
            loop modifierCursor from 0 to 4:
                set found to the bim navigation of style styleCode dragging button buttonCursor holding modifierCursor
                set implied to (modifierCursor != (bim plain navigation modifier)) and (plainAction = actionCode)
                if (found = actionCode) and (implied = false):
                    set named to the string form of "Middle"
                    if buttonCursor = bim right navigation button:
                        set named to the string form of "Right"
                    if modifierCursor = bim shift navigation modifier:
                        set named to (the string form of "Shift+") + named
                    else if modifierCursor = bim control navigation modifier:
                        set named to (the string form of "Ctrl+") + named
                    else if modifierCursor = bim alt navigation modifier:
                        set named to (the string form of "Alt+") + named
                    if (the length of listed) > 0:
                        set listed to listed + (the string form of ", ")
                    set listed to listed + named
        if (the length of listed) = 0:
            return the string form of "-"
        return listed

# Whether style `styleCode` turns the 3D view with the numeric keypad (1
# front, 3 right, 7 top; with Ctrl the opposite side), as Blender does.
function bim navigation style {integer:styleCode} has keypad views:
    execute:
        return styleCode = bim blender navigation style

# The side the 3D view looks from for keypad key `keyCode` (GLFW 321, 323,
# 327), toward the camera; nothing (all zero) for another key.
function the bim keypad view direction of key {integer:keyCode} opposite {boolean:reversed}:
    execute:
        set side to 1.0
        if reversed:
            set side to -1.0
        set eastward to 0.0
        set northward to 0.0
        set upward to 0.0
        if keyCode = 321:
            set northward to 0.0 - side
        else if keyCode = 323:
            set eastward to side
        else if keyCode = 327:
            set upward to side
        return a cad vector3 with x eastward, y northward and z upward

# ------------------------------------------------------------ gizmo

# The gizmo's axes: the selection's own, or the model's.
function bim local gizmo axes:
    replacement:
        0
function bim global gizmo axes:
    replacement:
        1

# The gizmo's sizes: small, normal (70 pixels to an arrow's tip), large; as
# a factor on its normal size.
function the bim gizmo size count:
    replacement:
        3

function the bim gizmo scale of size {integer:sizeCode}:
    execute:
        if sizeCode = 0:
            return 0.7
        if sizeCode = 2:
            return 1.4
        return 1.0

function the bim name of gizmo size {integer:sizeCode}:
    execute:
        if sizeCode = 0:
            return the string form of "Small"
        if sizeCode = 2:
            return the string form of "Large"
        return the string form of "Normal"

# The steps a gizmo drag snaps to: moving off, 1, 10 (the default), 50 or
# 100 mm; turning off, 1 (the default), 5, 15 or 45 degrees.
function the bim gizmo step count:
    replacement:
        5

function the bim gizmo move step of choice {integer:choiceCode}:
    execute:
        if choiceCode = 0:
            return 0.0
        if choiceCode = 1:
            return 0.001
        if choiceCode = 3:
            return 0.05
        if choiceCode = 4:
            return 0.1
        return 0.01

function the bim gizmo turn step of choice {integer:choiceCode}:
    execute:
        if choiceCode = 0:
            return 0.0
        if choiceCode = 2:
            return 5.0
        if choiceCode = 3:
            return 15.0
        if choiceCode = 4:
            return 45.0
        return 1.0

function the bim name of gizmo move step {integer:choiceCode}:
    execute:
        if choiceCode = 0:
            return the string form of "Off"
        if choiceCode = 1:
            return the string form of "1 mm"
        if choiceCode = 3:
            return the string form of "50 mm"
        if choiceCode = 4:
            return the string form of "100 mm"
        return the string form of "10 mm"

function the bim name of gizmo turn step {integer:choiceCode}:
    execute:
        if choiceCode = 0:
            return the string form of "Off"
        if choiceCode = 2:
            return the string form of "5 deg"
        if choiceCode = 3:
            return the string form of "15 deg"
        if choiceCode = 4:
            return the string form of "45 deg"
        return the string form of "1 deg"

# The gizmo's handles that can be hidden, as bits (`the bim gizmo for frame
# ... showing ...` in `bim_view_panel.dl` reads the same bits): the arrows,
# the plane square, the turning ring, the tilting rings. All show by
# default.
function the bim gizmo handle group count:
    replacement:
        4

function the bim all gizmo handles:
    replacement:
        15

function the bim name of gizmo handle group {integer:groupCode}:
    execute:
        if groupCode = 0:
            return the string form of "Arrows"
        if groupCode = 1:
            return the string form of "Plane square"
        if groupCode = 2:
            return the string form of "Turning ring"
        return the string form of "Tilting rings"
