                        set onMassCap to ((the absolute value of (hitZ - massBaseZ)) < 1e-6) or ((the absolute value of (hitZ - (massBaseZ + massElement's height))) < 1e-6)
                        if ((the absolute value of massElement's height) < 1e-8) and ((the absolute value of (hitZ - massBaseZ)) < 0.0021):
