                else:
                    append 2406 to pressedCodes
            else if (((code = 67) and ((key 340 is down in window) or (key 344 is down in window))) and (editor's textActive = false)) and ((bim editor edits reinforcement text editor) = false):
                # Shift+C takes the 3D cursor home, as in Blender.
                home bim editor cursor in (the address of editor)
            else if ((code >= 65) and (code <= 90)) and ((editor's textActive and (editor's tool = bim text tool)) = false):
                # Letters go through the two-letter commands of Open 2D
                # Studio first.
                set resolved to resolve bim editor letter code at (the bim microseconds now) in (the address of editor)
                loop resolvedCursor from 0 to the length of resolved:
                    append (the item at resolvedCursor in resolved) to pressedCodes
                free resolved
            else if (bim editor takes a typed value editor) and (((code = 61) or ((code >= 48) and (code <= 57))) and ((key 340 is down in window) or (key 344 is down in window))):
                # While a value is typed, a shifted digit or = is an
                # operator or bracket (+ * ( )), which comes as a character.
                set code to code
            else if (bim editor takes a typed value editor) and (code = 61):
                set code to code
            else:
                append code to pressedCodes
        replace item at index cursor in previousKeys with down
    set expired to the bim letters timed out at (the bim microseconds now) in (the address of editor)
    loop expiredCursor from 0 to the length of expired:
        append (the item at expiredCursor in expired) to pressedCodes
    free expired
    if uiCommand = 2351:
        set analyticDetailOpen to analyticDetailOpen = false
        set analyticDetailCamera to the fitted analytic camera analyticDetailCamera
        set analyticDetailDrag to 0
        set uiCommand to -1
    if uiCommand >= 0:
        append uiCommand to pressedCodes
        set uiCommand to -1
    set typedNow to the characters typed into window
    if typeManagerOwnsFrame:
        loop managerCharacterCursor from 0 to the length of typedNow:
            type bim type manager character (the item at managerCharacterCursor in typedNow) in (the address of typeManager)
        loop managerKeyCursor from 0 to the length of pressedCodes:
            type bim type manager key (the item at managerKeyCursor in pressedCodes) in (the address of typeManager) for (the address of editor)
        clear typedNow
        clear pressedCodes
    else if gridAddOwnsFrame:
        if gridAddOpen:
            loop gridCharacterCursor from 0 to the length of typedNow:
                set gridTyped to the item at gridCharacterCursor in typedNow
                if ((gridTyped >= 32) and (gridTyped < 127)) and (((key 341 is down in window) or (key 345 is down in window)) = false):
                    if gridAddReplace:
                        set gridAddText to the string form of ""
                        set gridAddReplace to false
                    if (the length of gridAddText) < 4096:
                        set gridLetter to a new string buffer containing 1 bytes
                        store (gridTyped as a byte) into the data of gridLetter at 0
                        set gridAddText to gridAddText + gridLetter
                        set gridAddInvalid to false
        clear typedNow
        loop gridKeyCursor from 0 to the length of pressedCodes:
            set gridKey to the item at gridKeyCursor in pressedCodes
            if gridKey = bim enter key code:
                set gridAddApply to true
            else if gridKey = bim escape key code:
                set gridAddOpen to false
            else if gridKey = bim backspace key code:
                if gridAddReplace:
                    set gridAddText to the string form of ""
                else if (the length of gridAddText) > 0:
                    set gridAddText to the substring of gridAddText from 0 spanning ((the length of gridAddText) - 1) bytes
                set gridAddReplace to false
                set gridAddInvalid to false
            else if (gridKey = 65) and ((key 341 is down in window) or (key 345 is down in window)):
                set gridAddReplace to true
        clear pressedCodes
    else if canvasTextEntry:
        # Apply every character before Enter/Tab can confirm this frame.
        loop pointCharacterCursor from 0 to the length of typedNow:
            type bim editor character (the item at pointCharacterCursor in typedNow) in (the address of editor)
        clear typedNow
    if gridAddOpen and gridAddApply:
        # Prepare the full batch before beginning an undo step: invalid input
        # must not modify the model or discard an existing redo history.
        set gridCopiesModel to the bim snapshot of editor's documentValue's current
        set gridCopiesAdded to add bim grid copies of gridAddId spaced gridAddText metres per unit (the bim metres per editor's lengthUnit) in (the address of gridCopiesModel)
        if gridCopiesAdded > 0:
            begin bim transaction in (the address of (editor's documentValue))
            set editor's documentValue's current to gridCopiesModel
            commit bim transaction in (the address of (editor's documentValue))
            set gridAddOpen to false
            set editor's message to (the string form of "Added parallel grids: ") + (the string form of gridCopiesAdded)
        else:
            set gridAddInvalid to true
            set editor's message to the string form of "Use positive spacings such as 5000 3000 3x5400 in the displayed units"
    # Escape closes the context menu first, unless a property in it is
    # being typed (then it cancels the typing).
    if contextOpen and (editor's propertyCode < 0):
        set escaping to -1
        loop escapeCursor from 0 to the length of pressedCodes:
            if (the item at escapeCursor in pressedCodes) = bim escape key code:
                set escaping to escapeCursor
        if escaping >= 0:
            remove item escaping from pressedCodes
            set contextOpen to false
    # 2170 makes the selected imported element editable (a mesh of the
    # model's own, one undoable step); 2171 makes every imported element so.
    loop promoteCursor from 0 to the length of pressedCodes:
        set promoteCode to the item at promoteCursor in pressedCodes
        if (promoteCode = 2170) or (promoteCode = 2171):
            if (importedFull's valid) = false:
                set editor's message to the string form of "Nothing imported to make editable"
            else if promoteCode = 2170:
                if editor's selectionKind = bim imported picked:
                    set promoteIndex to (editor's selectionId - (the bim imported id base)) as an integer
                    begin bim transaction in (the address of (editor's documentValue))
                    set promotedId to promote bim import element promoteIndex of imported into (the address of (editor's documentValue's current))
                    commit bim transaction in (the address of (editor's documentValue))
                    if promotedId != the bim refused id:
                        select bim editor (the bim kind picked for element promotedId in editor's documentValue's current) numbered promotedId in (the address of editor)
                        set editor's message to the string form of "Made editable: a mesh of its own, with its IFC class, GlobalId and properties"
                    else:
                        set editor's message to the string form of "This element has no geometry to edit"
                else:
                    set editor's message to the string form of "Select an imported element to make it editable"
            else:
                begin bim transaction in (the address of (editor's documentValue))
                set promotedMade to promote every bim import element of importedFull into (the address of (editor's documentValue's current))
                commit bim transaction in (the address of (editor's documentValue))
                set editor's message to ((the string form of "Made editable: ") + (the string form of promotedMade)) + (the string form of " imported elements")
    # While the start screen, the File menu, the Settings window or the
    # unsaved-changes dialog shows, keys do not reach the model under them:
    # Ctrl+S, Ctrl+O and the commands of clicks stay, Enter and Escape answer
    # the dialog; without it Escape closes the open list, the Settings window
    # or the File menu, or leaves the start screen for the model shown.
    if (startScreen or (pendingFileAction != 0)) or (fileScreens's menuOpen or fileScreens's settingsOpen):
        set screenKeys to an empty list of an integer
        loop screenKeyCursor from 0 to the length of pressedCodes:
            set screenKey to the item at screenKeyCursor in pressedCodes
            if ((screenKey >= 2140) and (screenKey < 2200)) or ((screenKey = ((bim ui control command) + 83)) or (screenKey = ((bim ui control command) + 79))):
                append screenKey to screenKeys
            else if ((screenKey = bim escape key code) or (screenKey = bim enter key code)) and (pendingFileAction != 0):
                append screenKey to screenKeys
            else if screenKey = bim escape key code:
                if fileScreens's settingsOpen:
                    if fileScreens's listOpen > 0:
                        set screenCode to bim settings list command
                    else:
                        set screenCode to bim settings close command
                else if fileScreens's menuOpen:
                    set screenCode to bim file menu close command
                else if startScreen:
                    set screenCode to bim start continue command
        clear pressedCodes
        loop screenKeyCursor from 0 to the length of screenKeys:
            append (the item at screenKeyCursor in screenKeys) to pressedCodes
        free screenKeys
    # The file screens' own commands (`bim_ui_files.dl`): what shows, and a
    # setting chosen, which takes effect at once and is kept.
    if screenCode >= 0:
        apply bim file screen command screenCode to (the address of fileScreens)
        if bim command screenCode sets a setting:
            set appSettings to the bim choices appSettings after setting screenCode
            ignore (keep bim app settings appSettings)
        if screenCode = (bim start continue command):
            set startScreen to false
        set screenCode to -1
    # File commands (`bim_app_files.dl`): 2173 a new model, 2190 to 2193 a
    # new model from template 0 to 3, 2174 (Ctrl+O) opens a model picked in
    # a dialog, 2180 to 2189 recent file 0 to 9, 2175 (Ctrl+S) saves, 2176
    # saves as. A new or opened model in place of one with unsaved changes
    # asks first: 2177 (Enter) saves and goes on, 2178 goes on without
    # saving, 2179 (Escape) keeps the model. The commands are taken out of
    # `pressedCodes` (-1), so that no key handling below sees them.
    set fileSave to 0
    set fileNext to 0
    set fileAnswered to false
    loop fileCursor from 0 to the length of pressedCodes:
        set fileCode to the item at fileCursor in pressedCodes
        set fileTaken to true
        if fileCode = ((bim ui control command) + 83):
            set fileSave to 2175
        else if fileCode = ((bim ui control command) + 79):
            set fileNext to 2174
        else if (fileCode = 2175) or (fileCode = 2176):
            set fileSave to fileCode
        else if ((fileCode = 2173) or (fileCode = 2174)) or ((fileCode >= 2180) and (fileCode <= 2193)):
            set fileNext to fileCode
        else if ((fileCode = 2177) or (fileCode = 257)) and (pendingFileAction != 0):
            set fileSave to 2175
            set fileNext to pendingFileAction
            set fileAnswered to true
            set pendingFileAction to 0
        else if (fileCode = 2178) and (pendingFileAction != 0):
            set fileNext to pendingFileAction
            set fileAnswered to true
            set pendingFileAction to 0
        else if ((fileCode = 2179) or (fileCode = bim escape key code)) and (pendingFileAction != 0):
            set pendingFileAction to 0
            set editor's message to the string form of "Kept the model"
        else:
            set fileTaken to false
        if fileTaken:
            replace item at index fileCursor in pressedCodes with -1
    set modelUnsaved to (editor's documentValue's revision != savedRevision)
    if ((fileNext != 0) and (fileAnswered = false)) and (modelUnsaved and (fileSave = 0)):
        set pendingFileAction to fileNext
        set fileNext to 0
        set editor's message to (the string form of "Unsaved changes in ") + (the bim document title of filePath)
    set fileSaved to true
    if fileSave != 0:
        set saveTarget to filePath
        if (fileSave = 2176) or ((the length of filePath) = 0):
            set saveTarget to the bim save path picked from filePath
        set fileSaved to false
        if (the length of saveTarget) > 0:
            if save bim model file saveTarget in (the address of editor):
                set filePath to saveTarget
                set savedRevision to editor's documentValue's revision
                set fileSaved to true
                set recentFiles to the bim recent files
    if fileSaved = false:
        set fileNext to 0
    if fileNext != 0:
        set nextPath to the string form of ""
        set nextOpened to false
        if fileNext = 2174:
            set nextPath to the bim model file picked
        else if (fileNext >= 2180) and (fileNext <= 2189):
            set nextPath to the bim recent path at (fileNext - 2180)
        if (fileNext = 2173) or (fileNext >= 2190):
            set templateWanted to 0
            if fileNext >= 2190:
                set templateWanted to fileNext - 2190
            make new bim model from template templateWanted in (the address of editor)
            set filePath to the string form of ""
            set nextOpened to true
        else if (the length of nextPath) > 0:
            if open bim model file nextPath in (the address of editor):
                set filePath to nextPath
                set nextOpened to true
        if nextOpened:
            reset bim workspace tabs for plan editor's planViewId among tabKinds and tabDetails
            set activeTab to 0
            set sideTab to 1
            set lowerTab to -1
            set tabScroll to 0.0
            set tabScrollActive to -1
            set sheetWorkspace to a new bim sheet workspace
            set savedRevision to editor's documentValue's revision
            set modelUnsaved to false
            set startScreen to false
            set fitting to true
            set recentFiles to the bim recent files
            # A model linked to no IFC file shows no import.
            if (the length of (the bim linked ifc of editor's documentValue's current)) = 0:
                if ((the length of linkedLoaded) > 0) or ((the length of (imported's labels's values)) > 0):
                    set imported to the bim import of (the string form of "")
                    set importedFull to imported
                    set linkedLoaded to the string form of ""
                    set promotedSeen to 0
                    set importGeneration to importGeneration + 1
    # A model linked to an IFC file other than the one shown (just opened)
    # has it read, on the import's thread.
    ignore refresh bim import metadata of editor's documentValue in (the address of importMetadata)
    set linkWanted to importMetadata's linkedPath
    if ((the length of linkWanted) > 0) and ((linkWanted != linkedLoaded) and (importRunning = false)):
        set linkedLoaded to linkWanted
        set linkPaths to an empty list of a string
        append linkWanted to linkPaths
        set importJob to a bim import job of linkPaths on gpuDevice
        free linkPaths
        if start bim import job (the address of importJob):
            set importRunning to true
            set importLanding to false
            set importAfterSteps to 0
    set promotedNow to importMetadata's promotedCount
    # The section box the model keeps, when that changed (opened, undone).
    set boxKeyNow to the bim stored section box key of editor's documentValue's current
    if boxKeyNow != boxKeySeen:
        set storedBox to the bim stored section box of editor's documentValue's current
        set sectionBoxOn to storedBox's shown
        if storedBox's shown:
            set sectionBoxLow to storedBox's low
            set sectionBoxHigh to storedBox's high
        set boxKeySeen to boxKeyNow
    if promotedNow != promotedSeen:
        set imported to the bim import of importedFull without promoted in editor's documentValue's current
        set promotedSeen to promotedNow
        set importGeneration to importGeneration + 1
    # 2129 turns the section box on (around the whole model) or off.
    loop boxCursor from 0 to the length of pressedCodes:
        if (the item at boxCursor in pressedCodes) = 2129:
            set sectionBoxOn to sectionBoxOn = false
            if sectionBoxOn:
                set sectionBoxLow to the cad difference of gpuScene's low and (a cad vector3 with x 0.5, y 0.5 and z 0.5)
                set sectionBoxHigh to the cad sum of gpuScene's high and (a cad vector3 with x 0.5, y 0.5 and z 0.5)
                set editor's message to the string form of "Section box: drag a face's handle to cut the model"
            else:
                set editor's message to the string form of "Section box off"
            begin bim transaction in (the address of (editor's documentValue))
            keep bim section box sectionBoxOn from sectionBoxLow to sectionBoxHigh in (the address of (editor's documentValue's current))
            commit bim transaction in (the address of (editor's documentValue))
            set boxKeySeen to the bim stored section box key of editor's documentValue's current
        # 2172 fits the section box round the selection (30 cm wider).
        if (the item at boxCursor in pressedCodes) = 2172:
            set boxChosen to the bim selected ids of editor
            set fitted to the bim fitted section box around boxChosen among (meshes's values) and (imported's meshes's values) widened by 0.3
            free boxChosen
            if fitted's shown:
                set sectionBoxOn to true
                set sectionBoxLow to fitted's low
                set sectionBoxHigh to fitted's high
                begin bim transaction in (the address of (editor's documentValue))
                keep bim section box sectionBoxOn from sectionBoxLow to sectionBoxHigh in (the address of (editor's documentValue's current))
                commit bim transaction in (the address of (editor's documentValue))
                set boxKeySeen to the bim stored section box key of editor's documentValue's current
                set editor's message to the string form of "Section box round the selection"
            else:
                set editor's message to the string form of "Select something to fit the section box round"
    # 2131 isolates a storey in the 3D view, or shows all again: first the
    # storey nearest the active level; with it isolated, Page Up and Page
    # Down over the 3D view step to the storey above or below.
    set storeyStep to 0
    loop isolateCursor from 0 to the length of pressedCodes:
        if (the item at isolateCursor in pressedCodes) = 2131:
            set storeyIsolated to storeyIsolated = false
            if storeyIsolated:
                set isolatedStorey to the bim storey elevation of editor
                set storeyStep to 2
            else:
                set editor's message to the string form of "All storeys shown"
    # ZP: the view before the last zoom or pan (a view counts once the
    # camera has stood still for a quarter of a second).
    set cameraMoved to (((camera's centre's x != lastFrameCamera's centre's x) or (camera's centre's y != lastFrameCamera's centre's y)) or ((camera's scale != lastFrameCamera's scale) or (camera's viewScale != lastFrameCamera's viewScale))) or ((camera's yaw != lastFrameCamera's yaw) or (camera's pitch != lastFrameCamera's pitch))
    set cameraUnsettled to (((camera's centre's x != settledCamera's centre's x) or (camera's centre's y != settledCamera's centre's y)) or ((camera's scale != settledCamera's scale) or (camera's viewScale != settledCamera's viewScale))) or ((camera's yaw != settledCamera's yaw) or (camera's pitch != settledCamera's pitch))
    if cameraMoved:
        set cameraQuiet to 0
    else if cameraUnsettled:
        set cameraQuiet to cameraQuiet + 1
        if cameraQuiet >= 15:
            append settledCamera to zoomHistory
            if (the length of zoomHistory) > 50:
                remove item 0 from zoomHistory
            set settledCamera to camera
    set lastFrameCamera to camera
    loop zoomCursor from 0 to the length of pressedCodes:
        if (the item at zoomCursor in pressedCodes) = 2138:
            if cameraUnsettled:
                set camera to settledCamera
            else if (the length of zoomHistory) > 0:
                set camera to the item at ((the length of zoomHistory) - 1) in zoomHistory
                remove item ((the length of zoomHistory) - 1) from zoomHistory
            else:
                set editor's message to the string form of "Zoom previous: no earlier view"
            set settledCamera to camera
            set lastFrameCamera to camera
            set cameraQuiet to 0
    if storeyIsolated and overView:
        set pageCursor to 0
        loop while pageCursor < the length of pressedCodes:
            set pageCode to the item at pageCursor in pressedCodes
            if (pageCode = bim page up key code) or (pageCode = bim page down key code):
                set storeyStep to 1
                if pageCode = bim page down key code:
                    set storeyStep to -1
                remove item pageCursor from pressedCodes
            else:
                set pageCursor to pageCursor + 1
    if storeyIsolated and (storeyStep != 0):
        set storeyChoices to the bim storeys of editor's documentValue's current with imported
        set choiceCount to the length of (storeyChoices's elevations)
        if choiceCount > 0:
            # The storey nearest the isolated elevation, then the step.
            set nearest to 0
            loop choiceCursor from 1 to choiceCount:
                if (the absolute value of ((the item at choiceCursor in (storeyChoices's elevations)) - isolatedStorey)) < (the absolute value of ((the item at nearest in (storeyChoices's elevations)) - isolatedStorey)):
                    set nearest to choiceCursor
            if storeyStep != 2:
                set nearest to the maximum of 0 and (the minimum of (nearest + storeyStep) and (choiceCount - 1))
            set isolatedStorey to the item at nearest in (storeyChoices's elevations)
            set editor's message to ((the string form of "Storey isolated: ") + (the item at nearest in (storeyChoices's names))) + (the string form of " (Page Up / Page Down over the 3D view: the storey above / below)")
        free (storeyChoices's elevations)
        free (storeyChoices's names)
    loop imageCommandCursor from 0 to the length of pressedCodes:
        if (the item at imageCommandCursor in pressedCodes) = 2270:
            set pickedImage to the bim file picked titled (the string form of "Import linked image") among (the string form of "PNG image|*.png *.PNG") saving false from (the string form of "")
            if (the length of pickedImage) > 0:
                ignore (import bim png image at (the bim absolute path of pickedImage) centred on camera's centre in (the address of editor) for window)
    # 2127 imports a 2D drawing (DXF, DWG or PDF) picked in a file dialog.
    loop drawingCursor from 0 to the length of pressedCodes:
        if (the item at drawingCursor in pressedCodes) = 2127:
            set pickedDrawing to the bim drawing picked
            if (the length of pickedDrawing) > 0:
                ignore (import bim drawing at pickedDrawing through drawingScript in (the address of editor))
                set fitting to true
    # 2128 imports an IFC file picked in a file dialog as read-only elements,
    # in place of those imported before.
    loop ifcCursor from 0 to the length of pressedCodes:
        if (the item at ifcCursor in pressedCodes) = 2128:
            set pickedIfc to the bim ifc file picked
            if (the length of pickedIfc) > 0:
                # Read on the import's thread, as --import is.
                if importRunning:
                    set editor's message to the string form of "An import is still being read"
                else:
                    set pickedPaths to an empty list of a string
                    append pickedIfc to pickedPaths
                    set importJob to a bim import job of pickedPaths on gpuDevice
                    free pickedPaths
                    if start bim import job (the address of importJob):
                        set importRunning to true
                        set importLanding to false
                        set importAfterSteps to 0
                    else:
                        set editor's message to the string form of "Import refused: no thread could be started for it"
    # 2132 gives each imported storey a storey in the model, and so a plan.
    loop storeysCursor from 0 to the length of pressedCodes:
        if (the item at storeysCursor in pressedCodes) = 2132:
            if imported's valid and ((the length of (imported's storeys's names's values)) > 0):
                add bim editor storeys of imported in (the address of editor)
            else:
                set editor's message to the string form of "The import has no storeys"
    # 2120 opens the Drawing Rules window, on the plan's drawing type (the
    # library added when the model has none). While it is open it takes the
    # keys: Escape closes it, and a name being typed takes Enter, Backspace
    # and Escape.
    set opensRules to false
    loop rulesCursor from 0 to the length of pressedCodes:
        if (the item at rulesCursor in pressedCodes) = 2120:
            set opensRules to true
    if opensRules:
        set rulesTarget to the address of (editor's documentValue's current)
        if (the length of (rulesTarget's drawingTypes's values)) = 0:
            begin bim transaction in (the address of (editor's documentValue))
            ensure bim drawing types in rulesTarget
            commit bim transaction in (the address of (editor's documentValue))
        set rulesOpen to true
        set rulesRenaming to false
        set rulesTypeId to the bim plan drawing type of editor
        if (the bim drawing type index of rulesTypeId in editor's documentValue's current)'s valid = false:
            set rulesTypeId to (the item at 0 in (editor's documentValue's current's drawingTypes's values))'s id
        set editor's message to the string form of "Drawing Rules: click a cell to set or inherit it"
        clear pressedCodes
    if rulesOpen:
        loop rulesCursor from 0 to the length of pressedCodes:
            set rulesKey to the item at rulesCursor in pressedCodes
            if rulesRenaming:
                if rulesKey = bim enter key code:
                    rename bim editor drawing type rulesTypeId to rulesText in (the address of editor)
                    set rulesRenaming to false
                else if rulesKey = bim escape key code:
                    set rulesRenaming to false
                else if (rulesKey = bim backspace key code) and ((the length of rulesText) > 0):
                    set rulesText to the substring of rulesText from 0 spanning ((the length of rulesText) - 1) bytes
            else if rulesKey = bim escape key code:
                set rulesOpen to false
        clear pressedCodes
    loop boardCommandCursor from 0 to the length of pressedCodes:
        if (the item at boardCommandCursor in pressedCodes) = 2271:
            set boardTab to the bim tab of kind (bim sheet board tab) detail (0 as a 64 bit integer) among tabKinds and tabDetails
            if boardTab < 0:
                append bim sheet board tab to tabKinds
                append (0 as a 64 bit integer) to tabDetails
                set boardTab to (the length of tabKinds) - 1
            set activeTab to boardTab
            replace item at index boardCommandCursor in pressedCodes with -1
        else if showSheetBoard and ((the item at boardCommandCursor in pressedCodes) = 2279):
            set sheetBoardCamera to a new bim sheet camera
            replace item at index boardCommandCursor in pressedCodes with -1
    if showSheet:
        loop sheetCommandCursor from 0 to the length of pressedCodes:
            set sheetCode to the item at sheetCommandCursor in pressedCodes
            if take bim sheet command sheetCode at pixel in (the address of sheetWorkspace) for (the address of editor):
                replace item at index sheetCommandCursor in pressedCodes with -1
    loop pressedCursor from 0 to the length of pressedCodes:
        set entry to the item at pressedCursor in pressedCodes
        set control to entry >= (bim ui control command)
        set code to the remainder of entry divided by (bim ui control command)
        # Reinforcement text fields own letters which would otherwise fit/change a view.
        if (bim editor edits reinforcement text editor) and (entry < 1000):
            type bim editor key entry in (the address of editor)
            set code to -1
        # While a text is written, keys only edit it.
        if editor's textActive and (editor's tool = bim text tool):
            set code to -1
            if ((entry = 257) or (entry = 259)) or (entry = 256):
                type bim editor key entry in (the address of editor)
        # F7 shows and hides the plan's grid, as in CAD.
        if entry = 296:
            set gridShown to gridShown = false
            set code to -1
            if gridShown:
                set editor's message to the string form of "Grid on (F7)"
            else:
                set editor's message to the string form of "Grid off (F7)"
        # WT tiles the views, TW shows them as tabs.
        if (entry = 2090) or (entry = 2091):
            set tiledViews to entry = 2090
            set code to -1
            if tiledViews:
                set editor's message to the string form of "Views tiled (TW: tabs)"
            else:
                set editor's message to the string form of "Views as tabs (WT: tiled)"
        # ES: the sheet open written as SVG, in millimetres.
        else if entry = 2115:
            set code to -1
            set svgFound to the bim sheet index of editor's sheetId in editor's documentValue's current
            if svgFound's valid:
                set svgSheet to the item at svgFound's position in (editor's documentValue's current's sheets's values)
                set svgSize to the bim size of sheet svgSheet
                set svgCanvas to a new bim canvas
                record bim sheet svgSheet of editor among (sketchMeshes's values) from (a cad vector2 with x 0.0 and y (svgSize's y)) at 1.0 using typeface on (the address of svgCanvas)
                set svgPath to ((svgSheet's number with " " replaced by "_") with "/" replaced by "_") + (the string form of ".svg")
                if write bim text (the bim svg of svgCanvas sized svgSize's x by svgSize's y with text 2.5 high) to file svgPath:
                    set editor's message to (the string form of "Sheet exported to ") + svgPath
                else:
                    set editor's message to (the string form of "Could not write ") + svgPath
            else:
                set editor's message to the string form of "Export SVG: open a sheet first"
        # Collaborate > Export > DWG/DXF 2D and 3D: the active plan, and the
        # model as the 3D view holds it, as DWG and DXF (`bim_cad_export.dl`).
        else if entry = 2442:
            set code to -1
            set editor's message to the bim cad export of (the bim cad plan drawing of editor) as (the string form of "open-bim-studio-plan")
        else if entry = 2443:
            set code to -1
            set editor's message to the bim cad export of (the bim cad model drawing of editor with (meshes's values) and (sketchMeshes's values) and (imported's meshes's values)) as (the string form of "open-bim-studio-3d")
        # EP: the sheet open written as a PDF, in points, next to the model.
        else if entry = 2098:
            set code to -1
            set exportFound to the bim sheet index of editor's sheetId in editor's documentValue's current
            if exportFound's valid:
                set exportSheet to the item at exportFound's position in (editor's documentValue's current's sheets's values)
                set exportSize to the bim size of sheet exportSheet
                set pointsPerMillimetre to 72.0 / 25.4
                set exportCanvas to a new bim canvas
                record bim sheet exportSheet of editor among (sketchMeshes's values) from (a cad vector2 with x 0.0 and y (exportSize's y * pointsPerMillimetre)) at pointsPerMillimetre using typeface on (the address of exportCanvas)
                set exportText to the bim pdf of exportCanvas sized (exportSize's x * pointsPerMillimetre) by (exportSize's y * pointsPerMillimetre) with text 7.0 high
                set exportPath to ((exportSheet's number with " " replaced by "_") with "/" replaced by "_") + (the string form of ".pdf")
                if write bim text exportText to file exportPath:
                    set editor's message to (the string form of "Sheet exported to ") + exportPath
                else:
                    set editor's message to (the string form of "Could not write ") + exportPath
            else:
                set editor's message to the string form of "Export PDF: open a sheet first"
        # HH and HR act on the view under the pointer (or where the context
        # menu opened); over the chrome, on the active tab's view.
        else if (entry = 2123) or (entry = 2124):
            set onPlan to ((commandPixel's x > layout's planLeft) and (commandPixel's x < layout's planRight)) and ((commandPixel's y > layout's top) and (commandPixel's y < layout's bottom))
            set onModel to ((commandPixel's x > layout's planRight) and ((commandPixel's y > viewLayout's top) and (commandPixel's y < viewLayout's bottom))) and drawModel
            set onSection to ((commandPixel's x > layout's planRight) and ((commandPixel's y > lowerLayout's top) and (commandPixel's y < lowerLayout's bottom))) and (showSection and editor's hasSection)
            set targetView to the bim refused id
            if onPlan:
                set targetView to editor's planViewId
            else if onSection:
                set targetView to editor's sectionViewId
            else if onModel:
                set targetView to the bim model view id of editor
            else if activeKind = bim plan tab:
                set targetView to editor's planViewId
            else if activeKind = bim section tab:
                set targetView to editor's sectionViewId
            else if activeKind = bim model tab:
                set targetView to the bim model view id of editor
            if entry = 2123:
                hide bim editor selection in view numbered targetView in (the address of editor)
            else:
                restore bim editor hidden elements in view numbered targetView in (the address of editor)
        else if entry = 2228:
            set existing to the bim tab of kind bim schedule tab detail (8 as a 64 bit integer) among tabKinds and tabDetails
            if existing < 0:
                append bim schedule tab to tabKinds
                append (8 as a 64 bit integer) to tabDetails
                set existing to (the length of tabKinds) - 1
            set activeTab to existing
        else if entry = 2229:
            set rebarDetail to rebarDetail = false
            if rebarDetail:
                set editor's message to the string form of "3D reinforcement: bar diameters and modelled bends"
            else:
                set editor's message to the string form of "3D reinforcement: fast centre lines"
        # Create view, Import and Export open their chooser below the
        # pointer, drawn as the context menu.
        else if (the bim chooser of command entry) > 0:
            set code to -1
            set contextChooser to the bim chooser of command entry
            prepare bim chooser contextChooser for (the address of editor)
            set contextOpen to true
            set contextAt to a cad vector2 with x pixel's x and y (the maximum of pixel's y and layout's top)
            set contextHover to -1
        # Commands of their own (two-letter commands) go to the editor.
        else if entry = 3901:
            open bim type manager in (the address of typeManager) for (the address of editor)
            set gridAddOpen to false
            set contextOpen to false
            set rulesOpen to false
            set typeSelectorOpen to false
            set typeManagerOwnsFrame to true
            set gridAddOwnsFrame to true
            clear typedNow
        else if entry >= 2000:
            type bim editor key entry in (the address of editor)
            # Settings shows the project's settings in the properties panel:
            # the panel opens when it was closed, at its top.
            if entry = bim project settings command:
                set propertiesShown to true
                set propertiesScroll to 0.0
            if (entry = 2388) and ((editor's selectionKind = bim wall picked) or (editor's selectionKind = bim linear picked)):
                set typeSelectorOpen to true
                set typeSelectorScroll to -1
        else if (code = 256) and analyticDetailOpen:
            set analyticDetailOpen to false
        else if code = 256:
            # Escape cancels what is under way and clears the selection;
            # it never closes the window.
            set showVisibility to false
            set meshLineActive to false
            set meshLineHover to false
            type bim editor key code in (the address of editor)
        else if (bim editor sketches a boundary editor) and ((code >= 0) and (code < 1000)):
            # Contextual toolbar buttons and keyboard shortcuts share this
            # dispatcher. While sketching, L means Line, not Visibility;
            # likewise other unmodified keys belong to the sketch editor.
            type bim editor key code in (the address of editor)
        else if (analyticDetailOpen and (editor's propertyCode < 0)) and ((code = 70) or ((code = 45) or (code = 61))):
            if code = 70:
                set analyticDetailCamera to the fitted analytic camera analyticDetailCamera
            else:
                set steps to 1.0
                if code = 45:
                    set steps to -1.0
                set analyticDetailCamera to the analytic camera analyticDetailCamera scrolled by steps at 0.0 0.0 over height analyticDetailHeight
        else if (code = 45) and ((editor's grabbing = false) and (editor's propertyCode < 0)):
            set camera's scale to camera's scale / 1.2
        else if code = 61:
            set camera's scale to camera's scale * 1.2
        else if (code = 86) and editor's hasSection:
            set existing to the bim tab of kind bim section tab detail editor's sectionViewId among tabKinds and tabDetails
            if existing < 0:
                append bim section tab to tabKinds
                append editor's sectionViewId to tabDetails
                set existing to (the length of tabKinds) - 1
            set activeTab to existing
        else if code = 70:
            set fitting to true
            set editor's sectionZoom to 1.0
            set editor's sectionPanX to 0.0
            set editor's sectionPanY to 0.0
        else if code = 76:
            set showVisibility to showVisibility = false
        else if code = 75:
            set fineDetail to fineDetail = false
            set meshes to a cad topology list of a bim scene mesh record
            set meshedRevision to (-1) as a 64 bit integer
            if fineDetail:
                set editor's message to the string form of "3D detail: fine (wall layers)"
            else:
                set editor's message to the string form of "3D detail: coarse"
        else if code = 84:
            set existing to the bim tab of kind bim schedule tab detail (0 as a 64 bit integer) among tabKinds and tabDetails
            if existing < 0:
                append bim schedule tab to tabKinds
                append (0 as a 64 bit integer) to tabDetails
                set existing to (the length of tabKinds) - 1
            set activeTab to existing
        else if control and ((code >= 49) and (code <= 52)):
            set viewMode to code - 49
            set editor's message to (the string form of "3D view: ") + (the bim name of view mode viewMode)
        else if control and (((((code = 71) or (code = 73)) or (code = 69)) or (code = 85)) or (code = 88)):
            type bim editor key (code + (bim ui control command)) in (the address of editor)
        else if ((code = 69) and showSchedule) and (scheduleCode = 8):
            set bendingResult to the bim reinforcing schedule of editor's documentValue's current
            if bendingResult's valid:
                set htmlSaved to write bim text (the bim bending html of editor's documentValue's current) to file (the string form of "bim-bending-schedule.html")
                set tableSaved to write bim text (the bim reinforcing table of editor's documentValue's current) to file (the string form of "bim-bending-schedule.tsv")
                if htmlSaved and tableSaved:
                    set editor's message to the string form of "Exported bim-bending-schedule.html and .tsv in the working folder"
                else:
                    set editor's message to the string form of "Could not write both bending schedule files"
            else:
                set editor's message to bendingResult's message
        else if (code = 69) and showSchedule:
            if write bim text (the bim schedule csv of (scheduleRows's values)) to file (the string form of "bim-schedule.csv"):
                set editor's message to the string form of "Schedule exported to bim-schedule.csv"
            else:
                set editor's message to the string form of "Could not write bim-schedule.csv"
        else if control and (code = 81):
            request that window close
        else if control and (code = 84):
            type bim editor key 1084 in (the address of editor)
        else if code < 0:
            set code to -1
        else:
            type bim editor key code in (the address of editor)
    free pressedCodes
    # Characters typed go to the text being written.
    loop cursor from 0 to the length of typedNow:
        if rulesOpen:
            set typedCode to the item at cursor in typedNow
            if rulesRenaming and ((typedCode >= 32) and (typedCode < 127)):
                set typedLetter to a new string buffer containing 1 bytes
                store (typedCode as a byte) into the data of typedLetter at 0
                set rulesText to rulesText + typedLetter
        else:
            type bim editor character (the item at cursor in typedNow) in (the address of editor)
    free typedNow
    if (activeTab >= 0) and (activeTab < (the length of tabKinds)):
        if (the item at activeTab in tabKinds) = bim plan tab:
            if (the item at activeTab in tabDetails) != editor's planViewId:
                set matchingPlan to the bim tab of kind (bim plan tab) detail editor's planViewId among tabKinds and tabDetails
                if matchingPlan < 0:
                    append bim plan tab to tabKinds
                    append editor's planViewId to tabDetails
                    set matchingPlan to (the length of tabKinds) - 1
                set activeTab to matchingPlan
    set previousLeft to physicalLeftDown
    set previousRight to rightDown
    set previousCursor to cursorPosition
    # A request of the automation API, one a frame.
    if apiOn:
        set apiWindow to serve bim api in apiFolder for (the address of editor)
        if apiWindow's verb = (the string form of "fit"):
            set fitting to true
        if (apiWindow's verb = (the string form of "tab")) and ((apiWindow's number >= 0) and (apiWindow's number <= 10)):
            set ribbonTab to apiWindow's number
        # `ribbon LABEL`: the button's command, next frame, as a click.
        if apiWindow's verb = (the string form of "press"):
            set uiCommand to apiWindow's number
    refresh bim editor (the address of editor)
    set meshingStarted to 0 as a 64 bit integer
    if profileFrames:
        set meshingStarted to the bim microseconds now
    # Round shapes are meshed for the 3D view's zoom: a chord leaves the
    # true surface by at most half a pixel, in steps of a factor of 2, so
    # zooming in adds segments and zooming out drops them.
    set lodTier to 0
    set lodTolerance to 1.0
    set halfPixel to 0.5 / (the maximum of camera's viewScale and 1e-6)
    loop while (lodTier < 24) and (lodTolerance > halfPixel):
        set lodTolerance to lodTolerance * 0.5
        set lodTier to lodTier + 1
    # An edit or a drag meshes the model again at once. Zooming past a tier
    # queues the round shapes to be meshed again (`the bim zoom queue of …`):
    # each frame takes from the queue for at most 6 ms, those covering the
    # most of the 3D view first, and the view shows what is made so far.
    # Only meshes that come out different count as a change.
    set modelChanged to ((editor's documentValue's revision != meshedRevision) or editor's dragging) or (rebarDetail != meshedRebarDetail)
    if modelChanged:
        set meshes to the bim scene meshes of editor's evaluation after (meshes's values) layered fineDetail
        set keptConnections to the bim connection cache of editor's documentValue's current following connectionSceneJournal since connectionSceneSeen among (sketchMeshes's values)
        set sketchMeshes to the bim sketch meshes of editor's documentValue's current within lodTolerance reusing (keptConnections's values) with reinforcement detail rebarDetail
        set connectionSceneJournal to editor's documentValue's current's journal
        set connectionSceneSeen to the length of (connectionSceneJournal's values)
        # Drag previews and display-detail changes keep the same revision.
        # Classifying all system parts belongs to a committed model change.
        if zoomFixedRevision != editor's documentValue's revision:
            free zoomFixedIds
            set zoomFixedIds to the bim zoom fixed system ids of editor's documentValue's current
            set zoomFixedRevision to editor's documentValue's revision
        set meshedRebarDetail to rebarDetail
        set meshedTier to lodTier
        clear lodQueue
        set lodQueueNext to 0
        loop cursor from 0 to the length of (sketchMeshes's values):
            append (the item at cursor in (sketchMeshes's values)) to (meshes's values)
        set meshedRevision to editor's documentValue's revision
        set meshGeneration to meshGeneration + (1 as a 64 bit integer)
        # --export-sheets: the sheets once the model is evaluated and meshed.
        if exportSheetsPending:
            set exportSheetsPending to false
            # Deliver the same model, including its views and sheets, beside
            # the drawings in both supported IFCX representations.
            save bim editor to (the string form of "demo-pavilion.ifcxb") in (the address of editor)
            print editor's message as a line
            save bim editor to (the string form of "demo-pavilion.ifcx") in (the address of editor)
            print editor's message as a line
            set sheetFiles to export bim sheets of editor among (sketchMeshes's values) using typeface
            print ((the string form of "sheet files written: ") + (the string form of sheetFiles)) as a line
            request that window close
    else if lodTier != meshedTier:
        free lodQueue
        set lodQueue to the bim zoom queue of (sketchMeshes's values) in viewLayout with camera keeping zoomFixedIds
        set lodQueueNext to 0
        set meshedTier to lodTier
    if (modelChanged = false) and (lodQueueNext < (the length of lodQueue)):
        set queueStarted to the bim microseconds now
        set remade to an empty list of a 64 bit integer
        set changedAny to false
        loop while (lodQueueNext < (the length of lodQueue)) and (((the bim microseconds now) - queueStarted) < (6000 as a 64 bit integer)):
            set chunkStarted to the bim microseconds now
            set chunkEnd to the minimum of (lodQueueNext + lodChunk) and (the length of lodQueue)
            loop queueCursor from lodQueueNext to chunkEnd:
                append (the item at (the item at queueCursor in lodQueue) in (sketchMeshes's values))'s elementId to remade
            set refreshed to the bim sketch meshes of editor's documentValue's current within lodTolerance reusing (sketchMeshes's values) refreshing remade with reinforcement detail meshedRebarDetail
            loop queueCursor from lodQueueNext to chunkEnd:
                set queued to the item at queueCursor in lodQueue
                if (bim scene mesh (the item at queued in (refreshed's values)) repeats (the item at queued in (sketchMeshes's values))) = false:
                    set changedAny to true
            clear remade
            set sketchMeshes to refreshed
            set lodQueueNext to chunkEnd
            # A chunk as large as about a quarter of the budget takes.
            set chunkTook to (the bim microseconds now) - chunkStarted
            if (chunkTook < (1500 as a 64 bit integer)) and (lodChunk < 256):
                set lodChunk to lodChunk * 2
            else if (chunkTook > (3000 as a 64 bit integer)) and (lodChunk > 1):
                set lodChunk to lodChunk / 2
        free remade
        if changedAny:
            set meshes to the bim scene meshes of editor's evaluation after (meshes's values) layered fineDetail
            loop cursor from 0 to the length of (sketchMeshes's values):
                append (the item at cursor in (sketchMeshes's values)) to (meshes's values)
            set meshGeneration to meshGeneration + (1 as a 64 bit integer)
    set meshingMicros to 0 as a 64 bit integer
    if profileFrames:
        set meshingMicros to (the bim microseconds now) - meshingStarted
    # The meshes of the categories the 3D view shows; picking sees only these.
    # They are filtered again only when the meshes or the 3D view's rules
    # change, and not while the zoom queue or a section box drag is under
    # way (the GPU shows those through flags and the shaders' cut).
    set shownKey to ((the string form of meshGeneration) + (the string form of " import ")) + ((the string form of importGeneration) + (the bim rule text of editor's modelRules))
    if storeyIsolated:
        set shownKey to (shownKey + (the string form of " storey ")) + (the bim exact text of isolatedStorey)
    # What leaves reinforcement inside its host out: the view mode, the
    # selection and whether the section box cuts.
    set chosenText to (the string form of " chosen ") + (the string form of editor's selectionId)
    loop chosenCursor from 0 to the length of (editor's chosenSketches's values):
        set chosenText to (chosenText + (the string form of ",")) + (the string form of (the item at chosenCursor in (editor's chosenSketches's values)))
    set shownKey to ((shownKey + (the string form of " mode ")) + (the string form of viewMode)) + chosenText
    set shownKey to (shownKey + (the string form of " boxed ")) + (the string form of sectionBoxOn)
    # What the 3D view hides (HH), by the ids hidden.
    set shownKey to (shownKey + (the string form of " ")) + (the bim hidden key in view (the bim model view id of editor) among (editor's hiddenElements's values))
    set flagsWanted to shownKey
    # Caps follow the current box independently of the frozen picking meshes.
    # Delimit coordinates so distinct bounds cannot share a cache key.
    set wantedCutGeometry to shownKey + (the string form of " cut ")
    set wantedCutGeometry to (wantedCutGeometry + (the bim exact text of sectionBoxLow's x)) + (the string form of ",")
    set wantedCutGeometry to (wantedCutGeometry + (the bim exact text of sectionBoxLow's y)) + (the string form of ",")
    set wantedCutGeometry to (wantedCutGeometry + (the bim exact text of sectionBoxLow's z)) + (the string form of ",")
    set wantedCutGeometry to (wantedCutGeometry + (the bim exact text of sectionBoxHigh's x)) + (the string form of ",")
    set wantedCutGeometry to (wantedCutGeometry + (the bim exact text of sectionBoxHigh's y)) + (the string form of ",")
    set wantedCutGeometry to wantedCutGeometry + (the bim exact text of sectionBoxHigh's z)
    if (lodQueueNext < (the length of lodQueue)) or (boxDragFace >= 0):
        set shownKey to shownMeshesKey
    else if sectionBoxOn:
        set shownKey to ((shownKey + (the string form of " box ")) + ((the string form of sectionBoxLow's x) + (the string form of sectionBoxLow's y))) + (((the string form of sectionBoxLow's z) + (the string form of sectionBoxHigh's x)) + ((the string form of sectionBoxHigh's y) + (the string form of sectionBoxHigh's z)))
    if shownKey != shownMeshesKey:
        set shownMeshes to the bim meshes of (meshes's values) and (imported's meshes's values) shown by editor's modelRules
        if (the length of (editor's documentValue's current's phases's values)) > 0:
            set shownMeshes to the bim meshes of (shownMeshes's values) kept by phase of editor
        # An isolated storey keeps what belongs to it.
        if storeyIsolated:
            set shownMeshes to the bim meshes of (shownMeshes's values) on storey at isolatedStorey of editor's documentValue's current with imported
        # The section box cuts away what lies outside it.
        set cutSourceMeshes to shownMeshes
        set cutMeshes to a cad topology list of a bim scene mesh record
        if sectionBoxOn:
            set cutMeshes to the bim cap meshes among (shownMeshes's values) from sectionBoxLow to sectionBoxHigh for editor's evaluation
            set cutGeometryKey to wantedCutGeometry
            set cutUploadKey to the string form of ""
            set shownMeshes to the bim scene meshes of (shownMeshes's values) clipped to box from sectionBoxLow to sectionBoxHigh
            loop cutCursor from 0 to the length of (cutMeshes's values):
                append (the item at cutCursor in (cutMeshes's values)) to (shownMeshes's values)
        # Reinforcement wholly inside a shown, opaque, level floor is left
        # out, unless it or its floor is selected, the section box cuts or
        # the view is wireframe; in doubt it shows.
        # Hidden in the 3D view (HH): not picked; a hidden floor then hides
        # none of the reinforcement inside it.
        set hiddenInModel to the bim hidden ids in model view of editor
        if (the length of (hiddenInModel's values)) > 0:
            set shownMeshes to the bim meshes among (shownMeshes's values) leaving out (hiddenInModel's values)
        set keptIds to an empty list of a 64 bit integer
        if editor's selectionKind != bim nothing picked:
            append editor's selectionId to keptIds
        loop keptCursor from 0 to the length of (editor's chosenSketches's values):
            append (the item at keptCursor in (editor's chosenSketches's values)) to keptIds
        set occludedRebar to the bim reinforcement hidden in hosts among (shownMeshes's values) of editor's documentValue's current following editor's modelRules boxed sectionBoxOn wired (viewMode = bim wireframe view mode) keeping keptIds
        free keptIds
        if (the length of (occludedRebar's values)) > 0:
            set shownMeshes to the bim meshes among (shownMeshes's values) leaving out (occludedRebar's values)
        # The GPU upload leaves them out too: written again when they change.
        set occludedText to the string form of " occluded"
        loop occludedCursor from 0 to the length of (occludedRebar's values):
            set occludedText to (occludedText + (the string form of ",")) + (the string form of (the item at occludedCursor in (occludedRebar's values)))
        set shownMeshesKey to shownKey
    # Recut the original solids, never the previously clipped result. This also
    # restores material and openings when a dragged face moves outward again.
    if sectionBoxOn and (wantedCutGeometry != cutGeometryKey):
        set cutMeshes to the bim cap meshes among (cutSourceMeshes's values) from sectionBoxLow to sectionBoxHigh for editor's evaluation
        set cutGeometryKey to wantedCutGeometry
        set cutUploadKey to the string form of ""
    refresh bim images of editor's documentValue in (the address of imageCache) for window
    set frame to a new graphics frame in window with background red 1.0, green 1.0, blue 1.0 and alpha 1.0
    use screen coordinates in frame
    # A section drawn opens its tab.
    # A sheet made (NS) opens its tab.
    if ((the bim sheet index of editor's sheetId in editor's documentValue's current)'s valid) and ((the bim tab of kind bim sheet tab detail editor's sheetId among tabKinds and tabDetails) < 0):
        append bim sheet tab to tabKinds
        append editor's sheetId to tabDetails
        set activeTab to (the length of tabKinds) - 1
    if editor's hasSection and ((the bim tab of kind bim section tab detail editor's sectionViewId among tabKinds and tabDetails) < 0):
        append bim section tab to tabKinds
        append editor's sectionViewId to tabDetails
        set activeTab to (the length of tabKinds) - 1
    select gpu canvas slot 0 in (the gpu context of window)
    set planTransform to the bim plan transform of layout with camera
    if gridShown:
        draw bim grid in layout with camera in frame
    # The plan is recorded again only when what it shows changes; panning
    # replays the recording shifted. The window resized records it again:
    # its batches keep the size they were recorded at.
    set planKey to ((the bim plan key of editor at camera's scale) + (the string form of " import ")) + (the string form of importGeneration)
    set planKey to the bim gpu plan key of planKey sized (the framebuffer width of window) by (the framebuffer height of window)
    # What the plan hides (HH), by the ids hidden.
    set planKey to (planKey + (the string form of " ")) + (the bim hidden key in view (editor's planViewId) among (editor's hiddenElements's values))
    set originPixel to the bim pixel of (a cad vector2 with x 0.0 and y 0.0) through planTransform
    set planStarted to 0 as a 64 bit integer
    if profileFrames:
        set planStarted to the bim microseconds now
    set planRerecorded to false
    if (sheetOwnsCanvas = false) and (planKey != recordedPlanKey):
        set planRerecorded to true
        set planCanvas to a new bim canvas
        set planCanvas's sketchy to bim view editor's planViewId is sketchy in editor's documentValue's current
        if bim category bim space category is visible in editor's planRules:
            draw bim spaces of editor through planTransform on (the address of planCanvas)
        if bim category bim wall category is visible in editor's planRules:
            draw bim storey below of editor through planTransform on (the address of planCanvas)
        draw bim hatched cut faces of editor's plan for editor through planTransform as section false following editor's planRules on (the address of planCanvas)
        draw bim openings in plan of editor through planTransform on (the address of planCanvas)
        draw bim grids in plan of editor through planTransform on (the address of planCanvas)
        draw bim section marks in plan of editor through planTransform on (the address of planCanvas)
        draw bim sketches of editor through planTransform on (the address of planCanvas) using typeface referencing false
        draw bim linears in plan of editor through planTransform on (the address of planCanvas)
        draw bim annotations in plan of editor through planTransform on (the address of planCanvas)
        draw bim area measures in plan of editor through planTransform on (the address of planCanvas)
        draw bim stairs in plan of editor through planTransform on (the address of planCanvas) keeping (the address of planSystemCache)
        draw bim opening details of editor through planTransform on (the address of planCanvas)
        draw bim folded components in plan of editor among (sketchMeshes's values) through planTransform on (the address of planCanvas)
        if imported's valid:
            set storeyCut to (the bim storey elevation of editor) + (the bim plan cut height of editor)
            set wantedImportKey to (((the string form of importGeneration) + (the string form of " ")) + ((the bim exact text of (the bim storey elevation of editor)) + (the string form of " "))) + ((the bim exact text of storeyCut) + (the bim rule text of editor's planRules))
            if wantedImportKey != importPlanKey:
                free importCutLines
                free importBelowLines
                set importCutLines to an empty list of a cad vector2
                set importBelowLines to an empty list of a cad vector2
                set storeyMeshes to the bim meshes of (imported's meshes's values) on storey at (the bim storey elevation of editor) of editor's documentValue's current with imported
                set noMeshes to a cad topology list of a bim scene mesh record
                set planMeshes to the bim meshes of (noMeshes's values) and (storeyMeshes's values) shown by editor's planRules
                append bim plan lines of (planMeshes's values) cut at storeyCut into importCutLines and importBelowLines
                set importPlanKey to wantedImportKey
            record bim plan lines importCutLines and importBelowLines through planTransform on (the address of planCanvas)
        draw bim dimensions in plan of editor through planTransform on (the address of planCanvas)
        draw bim tags in plan of editor through planTransform on (the address of planCanvas)
        set recordedPlanKey to planKey
        set recordedOrigin to originPixel
    # The recorded plan is kept on the GPU and drawn shifted; it is written
    # there again only when it was recorded again.
    set wantedPlanUpload to (the string form of "plan ") + recordedPlanKey
    if ((sheetOwnsCanvas = false) and frame's drawable) and (uploadedCanvasKey != wantedPlanUpload):
        begin gpu canvas recording in (the gpu context of window)
        replay bim canvas planCanvas shifted by 0.0 and 0.0 with typeface in frame
        end gpu canvas recording in (the gpu context of window)
        set uploadedCanvasKey to wantedPlanUpload
    # Slab edges first, so that the cut outlines over them stay black.
    if sheetOwnsCanvas = false:
        draw bim slabs of editor through planTransform in frame
        set vectorBatchStart to the length of ((the gpu context of window)'s batches)
        draw retained bim vectors of view editor's planViewId from editor's vectorCache through planTransform in (the address of vectorGpuCache) for frame
        clip gpu overlays since vectorBatchStart within layout's planLeft, layout's top, layout's planRight and layout's bottom in (the gpu context of window)
        select gpu canvas slot 0 in (the gpu context of window)
        draw gpu canvas shifted by (originPixel's x - recordedOrigin's x) and (originPixel's y - recordedOrigin's y) in (the gpu context of window)
    set planMicros to 0 as a 64 bit integer
    if profileFrames:
        set planMicros to (the bim microseconds now) - planStarted
    draw bim selection in plan of editor through planTransform in frame
    # A cropped plan view shows only its crop: the plan outside is covered,
    # and the crop drawn as a thin frame.
    set cropFound to the bim view index of editor's planViewId in editor's documentValue's current
    if cropFound's valid:
        set cropView to the item at cropFound's position in (editor's documentValue's current's views's values)
        if (cropDragHandle >= 0) and (cropView's id = cropDragView):
            set cropPointer to the bim model point of pixel in layout with camera
            set cropDelta to a cad vector2 with x (cropPointer's x - cropDragStart's x) and y (cropPointer's y - cropDragStart's y)
            set cropView to the bim crop cropView dragged at handle cropDragHandle by cropDelta
        if cropView's cropped:
            set cropTopLeft to the bim pixel of (a cad vector2 with x cropView's cropLow's x and y cropView's cropHigh's y) through planTransform
            set cropBottomRight to the bim pixel of (a cad vector2 with x cropView's cropHigh's x and y cropView's cropLow's y) through planTransform
            set cropLeft to the maximum of layout's planLeft and cropTopLeft's x
            set cropRight to the minimum of layout's planRight and cropBottomRight's x
            set cropTop to the maximum of layout's top and cropTopLeft's y
            set cropBottom to the minimum of layout's bottom and cropBottomRight's y
            draw a rectangle at x layout's planLeft and y layout's top with width (layout's planRight - layout's planLeft) and height (the maximum of 0.0 and (cropTop - layout's top)) in color red 255, green 255 and blue 255 in frame
            draw a rectangle at x layout's planLeft and y cropBottom with width (layout's planRight - layout's planLeft) and height (the maximum of 0.0 and (layout's bottom - cropBottom)) in color red 255, green 255 and blue 255 in frame
            draw a rectangle at x layout's planLeft and y cropTop with width (the maximum of 0.0 and (cropLeft - layout's planLeft)) and height (the maximum of 0.0 and (cropBottom - cropTop)) in color red 255, green 255 and blue 255 in frame
            draw a rectangle at x cropRight and y cropTop with width (the maximum of 0.0 and (layout's planRight - cropRight)) and height (the maximum of 0.0 and (cropBottom - cropTop)) in color red 255, green 255 and blue 255 in frame
            start triangles in frame
            use vertex color red 150, green 150 and blue 150 in frame
            add bim stroke from cropTopLeft to (a cad vector2 with x (cropBottomRight's x) and y (cropTopLeft's y)) wide 1.0 in frame
            add bim stroke from (a cad vector2 with x (cropBottomRight's x) and y (cropTopLeft's y)) to cropBottomRight wide 1.0 in frame
            add bim stroke from cropBottomRight to (a cad vector2 with x (cropTopLeft's x) and y (cropBottomRight's y)) wide 1.0 in frame
            add bim stroke from (a cad vector2 with x (cropTopLeft's x) and y (cropBottomRight's y)) to cropTopLeft wide 1.0 in frame
            if editor's tool = bim select tool:
                use vertex color red 30, green 125 and blue 210 in frame
                loop handle from 0 to 8:
                    set handlePixel to the bim pixel of (the bim crop handle handle from cropView's cropLow to cropView's cropHigh) through planTransform
                    add bim square at handlePixel sized 7.0 in frame
                if cropSelected:
                    set handlePixel to the bim pixel of (the bim crop handle 8 from cropView's cropLow to cropView's cropHigh) through planTransform
                    add bim square at handlePixel sized 9.0 in frame
            finish triangles in frame
        else:
            # Not cropped, the view's extent still shows as its outline: the
            # building with 3 m around it, where the elevation marks stand.
            set planExtent to the bim plan extent of editor's documentValue's current
            if planExtent's valid:
                set outlineTopLeft to the bim pixel of (a cad vector2 with x (planExtent's low's x - 3.0) and y (planExtent's high's y + 3.0)) through planTransform
                set outlineBottomRight to the bim pixel of (a cad vector2 with x (planExtent's high's x + 3.0) and y (planExtent's low's y - 3.0)) through planTransform
                start triangles in frame
                use vertex color red 185, green 190 and blue 200 in frame
                add bim stroke from outlineTopLeft to (a cad vector2 with x (outlineBottomRight's x) and y (outlineTopLeft's y)) wide 1.0 in frame
                add bim stroke from (a cad vector2 with x (outlineBottomRight's x) and y (outlineTopLeft's y)) to outlineBottomRight wide 1.0 in frame
                add bim stroke from outlineBottomRight to (a cad vector2 with x (outlineTopLeft's x) and y (outlineBottomRight's y)) wide 1.0 in frame
                add bim stroke from (a cad vector2 with x (outlineTopLeft's x) and y (outlineBottomRight's y)) to outlineTopLeft wide 1.0 in frame
                finish triangles in frame
    if planBoxActive and planBoxDragged:
        draw bim selection box from planBoxPixel to pixel in frame
    draw bim gesture of editor in layout with camera using typeface showing the pointer pointerHidden in frame
    draw bim modification preview of editor in view false in layout with camera in frame
    set planBarView to the bim view index of editor's planViewId in editor's documentValue's current
    if planBarView's valid:
        set planBarValue to the item at planBarView's position in (editor's documentValue's current's views's values)
        draw bim view bar ending at (layout's planRight - 8.0) and (layout's bottom - 38.0) scale planBarValue's scale display planBarValue's displayMode scaled true sketchy (bim view editor's planViewId is sketchy in editor's documentValue's current) shadows false boxed false using typeface in frame
    draw bim cursor mark at (the bim plan pixel of (a cad vector2 with x editor's cursorPoint's x and y editor's cursorPoint's y) in layout with camera) in frame
    # Each panel keeps to its area: the right panel is cleared over whatever
    # the plan drew into it, and the bars over whatever either panel drew.
    draw a rectangle at x layout's planRight and y 0 with width (layout's width - layout's planRight) and height layout's height in color red 247, green 249 and blue 252 in frame
    if drawModel:
        set overlayBatchStart to the length of ((the gpu context of window)'s batches)
        # The model lives on the GPU in slots (`bim gpu ground slot` and on),
        # each written again only when what it holds changes: the imported
        # elements with the import or their colours, the native ones with
        # the meshes, the ground and shadows after either. Which elements
        # show is a flag each, the section box a cut in the shaders; each
        # frame sets them and the camera and draws.
        # The colours of the hidden line view and the rules' halftone are the
        # shaders' (parameter 42, the elements' flags); only the native
        # elements' edges depend on the view mode.
        set edgesWanted to viewMode != bim shaded view mode
        set importKey to the string form of importGeneration
        set nativeKey to ((the string form of meshGeneration) + (the string form of edgesWanted)) + occludedText
        set bim gpu light model (viewMode = bim hidden line view mode) on window
        set uploadStarted to the bim microseconds now
        set uploadedAny to false
        if importKey != importUploadKey:
            upload bim gpu import of imported into (the address of gpuScene) on window
            set importUploadKey to importKey
            # The native ordinals follow the imported ones.
            set nativeUploadKey to the string form of "stale"
            set uploadedAny to true
        if nativeKey != nativeUploadKey:
            if (the length of (imported's meshes's values)) = 0:
                set gpuScene's origin to the bim gpu origin for imported and (meshes's values)
            upload bim gpu native of (meshes's values) for editor in mode viewMode leaving out (occludedRebar's values) into (the address of gpuScene) on window
            set nativeUploadKey to nativeKey
            set uploadedAny to true
        set groundKey to (importUploadKey + (the string form of " native ")) + nativeUploadKey
        set sunCasting to shadowsOn and (the bim sun of sunSetting is up)
        set towardSun to the bim direction toward the sun of sunSetting
        if sunCasting:
            set groundKey to (groundKey + (the string form of " shadows ")) + (the bim sun key of sunSetting)
        if groundKey != groundUploadKey:
            upload bim gpu ground of (imported's meshes's values) and (meshes's values) shadowed sunCasting toward towardSun into (the address of gpuScene) on window
            set groundUploadKey to groundKey
            set uploadedAny to true
        if uploadedAny:
            set uploadMilliseconds to ((the bim microseconds now) - uploadStarted) / (1000 as a 64 bit integer)
            set uploadCount to uploadCount + 1
        set flagsWanted to (flagsWanted + (the string form of " native ")) + nativeUploadKey
        if flagsWanted != flagsKey:
            show bim gpu elements of (imported's meshes's values) and (meshes's values) in gpuScene for editor isolating storeyIsolated at isolatedStorey with imported leaving out (occludedRebar's values) on window
            set flagsKey to flagsWanted
        set bim gpu section box from sectionBoxLow to sectionBoxHigh boxed sectionBoxOn for gpuScene on window
        # Source uploads establish the origin and element ordinals first.
        # The cap cache follows geometry/rules/box bounds, never camera motion.
        set wantedCutUpload to (cutGeometryKey + nativeUploadKey) + (the string form of importGeneration)
        set wantedCutUpload to wantedCutUpload + (the string form of (the bim drawing standard of editor's documentValue's current))
        if sectionBoxOn:
            if wantedCutUpload != cutUploadKey:
                set cutGpuCounts to upload bim cut faces (cutMeshes's values) for gpuScene under (the bim drawing standard of editor's documentValue's current) on window
                set cutUploadKey to wantedCutUpload
        set viewKey to the bim view key of editor with camera in viewLayout at meshGeneration showing (the length of (shownMeshes's values))
        set viewKey to (viewKey + (the string form of " ")) + (the bim hidden key in view (the bim model view id of editor) among (editor's hiddenElements's values))
        set selectedForGpu to an empty list of a 64 bit integer
        # A building system with one part chosen lights only that part
        # (`draw bim selection in view`), not the whole system.
        set partChosen to (editor's selectionKind = bim curtain picked) and (editor's partCode >= 0)
        if (editor's selectionKind != bim nothing picked) and (partChosen = false):
            append editor's selectionId to selectedForGpu
            loop gpuChosenCursor from 0 to the length of (editor's chosenSketches's values):
                append (the item at gpuChosenCursor in (editor's chosenSketches's values)) to selectedForGpu
        set bim gpu camera camera in viewLayout for gpuScene selecting selectedForGpu lit from towardSun on window
        free selectedForGpu
        draw bim model of gpuScene in viewLayout with camera mode viewMode on window
        if sectionBoxOn:
            draw bim cut faces cutGpuCounts in viewLayout mode viewMode on window
        if viewMode != bim shaded view mode:
            draw bim edges of gpuScene in viewLayout hidden (viewMode != bim wireframe view mode) on window
        else:
            # The edges hold the reinforcement's lines too; shaded, they
            # are drawn alone.
            draw bim lines of gpuScene in viewLayout on window
        draw bim grid lines in view of editor around gpuScene in viewLayout with camera in frame
        if sectionBoxOn:
            draw bim cut edges cutGpuCounts in viewLayout mode viewMode on window
        if elevationLocked = false:
            draw bim view cube in viewLayout with camera at pixel using typeface in frame
        # The window sleeps after this frame when nothing changed for twenty
        # and no zoom work waits (the loop's head): the indicator then reads
        # idle.
        set barOpen to -1
        if graphicsMenu = 6:
            set barOpen to bim view bar display hit
        if graphicsMenu = 7:
            set barOpen to bim view bar status hit
        set statusCaption to the bim view status caption of frameMeter at (the bim microseconds now) on device kind gpuDeviceKind sleeping ((quietFrames >= 19) and (lodQueueNext >= (the length of lodQueue)))
        draw bim view bar ending at (layout's width - 8.0) and (viewLayout's bottom - 38.0) mode viewMode shadows shadowsOn boxed sectionBoxOn status statusCaption on device kind gpuDeviceKind open barOpen using typeface in frame
        if bim category bim space category is visible in editor's modelRules:
            if editor's documentValue's revision != roomRevision:
                set roomSpaces to the bim rooms of editor's documentValue's current using editor's evaluation's index
                set roomRevision to editor's documentValue's revision
            draw bim rooms (roomSpaces's values) of editor in viewLayout with camera in frame
            draw bim space objects of editor on level spaceViewLevel clipped sectionBoxOn from sectionBoxLow to sectionBoxHigh in viewLayout with camera in frame
        if sectionBoxOn:
            draw bim boxed selection of editor from sectionBoxLow to sectionBoxHigh in viewLayout with camera in frame
        else:
            draw bim selection in view of editor in viewLayout with camera in frame
        draw bim chosen lines of editor among (shownMeshes's values) in viewLayout with camera in frame
        if editor's tool = bim trim tool:
            set trimCandidate to the bim trim candidate at editor's pointerLocation for editor
            if trimCandidate != the bim refused id:
                set previewEditor to editor
                set previewEditor's selectionId to trimCandidate
                set previewEditor's selectionKind to the bim kind of trim candidate trimCandidate in editor's documentValue's current
                draw bim chosen lines of previewEditor among (shownMeshes's values) in viewLayout with camera in frame
        # The 3D cursor, and the gizmo on the selection.
        set storeyLift to the bim storey elevation of editor
        draw bim cursor mark in view at (a cad vector3 with x editor's cursorPoint's x, y editor's cursorPoint's y and z (editor's cursorPoint's z + storeyLift)) in viewLayout with camera in frame
        draw bim modification preview of editor in view true in viewLayout with camera in frame
        set gizmoCentre to the bim object frame of editor
        if (gizmoCentre's found and (editor's tool = bim select tool)) and (editor's editMode = false):
            # The handle being dragged, else the one under the pointer, lights up.
            set shownGizmo to the bim gizmo for frame gizmoCentre tilting (the bim tilt axes of editor) in viewLayout with camera
            set litHandle to gizmoAxis
            if (litHandle = 0) and overView:
                set litHandle to the bim gizmo handle of shownGizmo at pixel
            draw bim gizmo shownGizmo active litHandle in frame
            draw bim text (the string form of "X") at (shownGizmo's xTip's x + 6.0) and (shownGizmo's xTip's y) in face (bim text small) with typeface coloured 225, 55 and 55 in frame
            draw bim text (the string form of "Y") at (shownGizmo's yTip's x + 6.0) and (shownGizmo's yTip's y) in face (bim text small) with typeface coloured 70, 190 and 70 in frame
            draw bim text (the string form of "Z") at (shownGizmo's zTip's x + 6.0) and (shownGizmo's zTip's y) in face (bim text small) with typeface coloured 70, 120 and 235 in frame
            draw bim text (the string form of "0, 0, 0 (local)") at (shownGizmo's middle's x + 8.0) and (shownGizmo's middle's y + 16.0) in face (bim text small) with typeface coloured 70, 75 and 85 in frame
        # Canvas first: the active storey's plan at the 3D view's lower left,
        # with an arrow where the camera looks from and to.
        set insetExtent to the bim plan extent of editor's documentValue's current
        set insetLeft to layout's planRight + 12.0
        set insetTop to viewLayout's bottom - 212.0
        set insetWidth to 260.0
        set insetHeight to 200.0
        if insetFolded:
            set insetTop to viewLayout's bottom - 38.0
            set insetHeight to 26.0
        if ((tiledViews = false) and (activeKind = bim model tab)) and insetExtent's valid:
            draw a rectangle at x insetLeft and y insetTop with width insetWidth and height insetHeight in color red 34, green 36 and blue 40 in frame
            draw bim label (the bim storey name of editor) at (insetLeft + 10.0) and (insetTop + 18.0) using typeface in frame
            # The fold button: a bar to fold, a square to unfold.
            set foldLeft to (insetLeft + insetWidth) - 20.0
            set foldOver to ((pixel's x >= (foldLeft - 6.0)) and (pixel's x < (insetLeft + insetWidth))) and ((pixel's y >= insetTop) and (pixel's y < (insetTop + 26.0)))
            set foldShade to 170
            if foldOver:
                set foldShade to 255
            if insetFolded:
                draw a rectangle at x foldLeft and y (insetTop + 8.0) with width 10.0 and height 10.0 in color red foldShade, green foldShade and blue foldShade in frame
                draw a rectangle at x (foldLeft + 1.5) and y (insetTop + 9.5) with width 7.0 and height 7.0 in color red 34, green 36 and blue 40 in frame
            else:
                draw a rectangle at x foldLeft and y (insetTop + 12.0) with width 10.0 and height 2.0 in color red foldShade, green foldShade and blue foldShade in frame
        if (((tiledViews = false) and (activeKind = bim model tab)) and insetExtent's valid) and (insetFolded = false):
            draw a rectangle at x (insetLeft + 6.0) and y (insetTop + 26.0) with width (insetWidth - 12.0) and height (insetHeight - 32.0) in color red 255, green 255 and blue 255 in frame
            set insetTransform to the bim inset transform at insetLeft and insetTop over insetExtent
            set wantedInset to (((the string form of editor's documentValue's revision) + (the string form of " ")) + ((the string form of editor's levelId) + (the string form of " "))) + ((the string form of insetLeft) + ((the string form of " ") + (the string form of insetTop)))
            if wantedInset != insetKey:
                set insetCanvas to a new bim canvas
                # The storey's plan as the plan panel draws it, without its
                # lettering: the cut faces, then the openings, the sketches,
                # the linears, the stairs and the components (issue 47: a
                # storey of columns and a stair showed an empty inset).
                draw bim hatched cut faces of editor's plan for editor through insetTransform as section false following editor's planRules on (the address of insetCanvas)
                draw bim openings in plan of editor through insetTransform on (the address of insetCanvas)
                draw bim sketches of editor through insetTransform on (the address of insetCanvas) using typeface referencing false
                draw bim linears in plan of editor through insetTransform on (the address of insetCanvas)
                draw bim stairs in plan of editor through insetTransform on (the address of insetCanvas)
                draw bim folded components in plan of editor among (sketchMeshes's values) through insetTransform on (the address of insetCanvas)
                set insetKey to wantedInset
            replay bim canvas insetCanvas shifted by 0.0 and 0.0 with typeface in frame
            # The camera: an arrow at its target, along the line of sight.
            set sightRay to the bim view ray through (a cad vector2 with x ((layout's planRight + layout's width) * 0.5) and y ((viewLayout's top + viewLayout's bottom) * 0.5)) in viewLayout with camera
            set sightRun to the square root of ((sightRay's direction's x * sightRay's direction's x) + (sightRay's direction's y * sightRay's direction's y))
            if sightRun > 1e-6:
                set lookX to sightRay's direction's x / sightRun
                set lookY to (0.0 - sightRay's direction's y) / sightRun
                set eyeSpot to the bim pixel of (a cad vector2 with x camera's target's x and y camera's target's y) through insetTransform
                start triangles in frame
                use vertex color red 0, green 120 and blue 215 in frame
                add a vertex at x (eyeSpot's x + (lookX * 14.0)) and y (eyeSpot's y + (lookY * 14.0)) to frame
                add a vertex at x ((eyeSpot's x - (lookX * 8.0)) - (lookY * 8.0)) and y ((eyeSpot's y - (lookY * 8.0)) + (lookX * 8.0)) to frame
                add a vertex at x ((eyeSpot's x - (lookX * 8.0)) + (lookY * 8.0)) and y ((eyeSpot's y - (lookY * 8.0)) - (lookX * 8.0)) to frame
                finish triangles in frame
        if sectionBoxOn:
            set litFace to boxDragFace
            if (litFace < 0) and overView:
                set litFace to the bim box face at pixel from sectionBoxLow to sectionBoxHigh in viewLayout with camera
            draw bim section box from sectionBoxLow to sectionBoxHigh lit litFace in viewLayout with camera in frame
        set viewCanvas to a new bim canvas
        draw bim levels of editor around gpuScene in viewLayout with camera on (the address of viewCanvas)
        draw bim grids in view of editor among (shownMeshes's values) remembering headCovers afresh (viewKey != headCoversKey) in viewLayout with camera on (the address of viewCanvas)
        set headCoversKey to viewKey
        if imported's valid:
            draw bim curves (imported's curves's values) in viewLayout with camera on (the address of viewCanvas)
        replay bim canvas viewCanvas shifted by 0.0 and 0.0 with typeface in frame
        set handles to the bim grips of editor
        draw bim grips (handles's values) in view of viewLayout with camera in frame
        if drawingInView:
            draw bim gesture in view of editor in viewLayout with camera in frame
        if viewPressActive and viewDragged:
            draw bim selection box from viewPressPixel to viewSelectionPixel in frame
        if drawingInView:
            # A line across a mesh face: its first point, the outline point
            # under the pointer, and the line between them.
            if (editor's tool = bim line tool) or (editor's tool = bim split tool):
                start triangles in frame
                if meshLineActive:
                    set lineStartPixel to the bim view point (meshLineSpot's x) (meshLineSpot's y) (meshLineSpot's z + meshLineZ) in viewLayout with camera
                    use vertex color red 255, green 140 and blue 0 in frame
                    add bim square at lineStartPixel sized 8.0 in frame
                    if (meshLineHover and (meshLineHoverId = meshLineId)) and (meshLineHoverFace = meshLineFace):
                        add bim stroke from lineStartPixel to (the bim view point (meshLineHoverSpot's x) (meshLineHoverSpot's y) (meshLineHoverSpot's z + meshLineHoverZ) in viewLayout with camera) wide 2.0 in frame
                if meshLineHover:
                    use vertex color red 40, green 160 and blue 60 in frame
                    add bim square at (the bim view point (meshLineHoverSpot's x) (meshLineHoverSpot's y) (meshLineHoverSpot's z + meshLineHoverZ) in viewLayout with camera) sized 9.0 in frame
                finish triangles in frame
        clip gpu overlays since overlayBatchStart within viewLayout's planRight, viewLayout's top, viewLayout's width and viewLayout's bottom in (the gpu context of window)
    # The section or schedule: after the 3D view, so that in a split column
    # it is drawn over its own cleared lower half.
    if splitViews:
        draw a rectangle at x layout's planRight and y splitAt with width (layout's width - layout's planRight) and height (layout's height - splitAt) in color red 247, green 249 and blue 252 in frame
    if showSection and editor's hasSection:
        if ((editor's tool = bim copy tool) and (editor's selectionKind = bim level picked)) and overSection:
            draw bim section of editor in lowerLayout dragging (bim level handle) of editor's selectionId at pixel's x and pixel's y using typeface in frame
        else:
            draw bim section of editor in lowerLayout dragging sectionDragKind of sectionDragId at sectionDragX and sectionDragY using typeface in frame
        set sectionBarView to the bim view index of editor's sectionViewId in editor's documentValue's current
        if sectionBarView's valid:
            set sectionBarValue to the item at sectionBarView's position in (editor's documentValue's current's views's values)
            draw bim view bar ending at (layout's width - 8.0) and (lowerLayout's bottom - 38.0) scale sectionBarValue's scale display sectionBarValue's displayMode scaled true sketchy (bim view editor's sectionViewId is sketchy in editor's documentValue's current) shadows false boxed false using typeface in frame
    else if showSchedule:
        if editor's evaluation's generation != scheduleGeneration:
            set scheduleRows to the bim schedule of editor's documentValue's current with editor's evaluation and (editor's spaces's values)
            set scheduleGeneration to editor's evaluation's generation
        set chosenRows to the bim rows of (scheduleRows's values) in schedule scheduleCode
        if scheduleCode = 8:
            if bendingGeneration != editor's documentValue's revision:
                set bendingRows to the bim reinforcing schedule of editor's documentValue's current
                set bendingGeneration to editor's documentValue's revision
            draw bim bending schedule bendingRows in lowerLayout using typeface in frame
        else:
            draw bim schedule (chosenRows's values) in lowerLayout using typeface in frame
    if splitViews:
        draw a rectangle at x layout's planRight and y splitAt with width (layout's width - layout's planRight) and height 3 in color red 200, green 206 and blue 216 in frame
    # A sheet: fitted into the pane on a grey ground, recorded again when the
    # model or the pane changes.
    set sheetStarted to 0 as a 64 bit integer
    if profileFrames:
        set sheetStarted to the bim microseconds now
    if showSheet:
        set sheetFound to the bim sheet index of editor's sheetId in editor's documentValue's current
        draw a rectangle at x layout's planRight and y layout's top with width (layout's width - layout's planRight) and height (layout's bottom - layout's top) in color red 200, green 203 and blue 208 in frame
        if sheetFound's valid:
            set openSheet to the item at sheetFound's position in (editor's documentValue's current's sheets's values)
            set entry to the retained bim sheet openSheet of editor among (sketchMeshes's values) using typeface in (the address of sheetGpuCache) for frame
            set sheetWorkspace's frames to entry's frames
            set scale to sheetWorkspace's density * sheetWorkspace's camera's zoom
            set shift to a cad vector2 with x ((sheetWorkspace's corner's x * sheetWorkspace's camera's zoom) + sheetWorkspace's camera's pan's x) and y (((sheetWorkspace's corner's y - (sheetWorkspace's size's y * sheetWorkspace's density)) * sheetWorkspace's camera's zoom) + sheetWorkspace's camera's pan's y)
            set moving to -1
            set delta to a cad vector2 with x 0.0 and y 0.0
            if sheetWorkspace's dragging:
                set moving to sheetWorkspace's selected
                set delta to sheetWorkspace's delta
                if sheetWorkspace's copying:
                    set moving to -1
            set sheetBatchStart to the length of ((the gpu context of window)'s batches)
            draw retained bim sheet entry scaled by scale at shift moving moving by delta in frame
            if (sheetWorkspace's dragging and sheetWorkspace's copying) and (sheetWorkspace's selected >= 0):
                select gpu canvas slot (entry's firstSlot + 2 + sheetWorkspace's selected) in (the gpu context of window)
                draw gpu canvas scaled by scale shifted by (shift's x + (delta's x * scale)) and (shift's y - (delta's y * scale)) in (the gpu context of window)
            if (sheetWorkspace's selected >= 0) and (sheetWorkspace's selected < (the length of (entry's frames's values))):
                outline bim sheet viewport (the item at sheetWorkspace's selected in (entry's frames's values)) on paper high sheetWorkspace's size's y scaled by scale at shift moving by delta in frame
            if editingSheet:
                draw bim selection in plan of editor through sheetEditingTransform in frame
            clip gpu overlays since sheetBatchStart within layout's planRight, layout's top, layout's width and layout's bottom in (the gpu context of window)
    if showSheetBoard:
        draw a rectangle at x layout's planRight and y layout's top with width (layout's width - layout's planRight) and height (layout's bottom - layout's top) in color red 200, green 203 and blue 208 in frame
        set boardColumns to the maximum of 1 and (the minimum of 3 and ((((layout's width - layout's planRight) - 40.0) / 320.0) as an integer))
        set boardBatchStart to the length of ((the gpu context of window)'s batches)
        loop boardIndex from 0 to the length of (editor's documentValue's current's sheets's values):
            set boardSheet to the item at boardIndex in (editor's documentValue's current's sheets's values)
            set boardSize to the bim size of sheet boardSheet
            set column to the remainder of boardIndex divided by boardColumns
            set row to (boardIndex / boardColumns) as an integer
            set baseX to (layout's planRight + 20.0) + ((column as a 64 bit floating-point number) * 320.0)
            set baseY to (layout's top + 38.0) + ((row as a 64 bit floating-point number) * 280.0)
            set shift to a cad vector2 with x ((baseX * sheetBoardCamera's zoom) + sheetBoardCamera's pan's x) and y ((baseY * sheetBoardCamera's zoom) + sheetBoardCamera's pan's y)
            set scale to (the minimum of (280.0 / boardSize's x) and (220.0 / boardSize's y)) * sheetBoardCamera's zoom
            if ((shift's x < layout's width) and ((shift's x + (boardSize's x * scale)) > layout's planRight)) and ((shift's y < layout's bottom) and ((shift's y + (boardSize's y * scale)) > layout's top)):
