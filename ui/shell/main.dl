        if uiHit's action = bim browser linear type:
            choose bim editor linear type uiHit's actionId in (the address of editor)
        if uiHit's action = bim browser component:
            set editor's placeComponentId to uiHit's actionId
            set editor's tool to bim place tool
            set editor's message to the string form of "Place component: click where"
        if uiHit's action = bim browser plate type:
            choose bim editor plate type uiHit's actionId in (the address of editor)
        if uiHit's action = bim browser building system:
            select bim editor (bim curtain picked) numbered uiHit's actionId in (the address of editor)
        if uiHit's action = bim browser system type:
            choose bim editor system type (uiHit's actionId as an integer) in (the address of editor)
        if uiHit's action = bim browser stair type:
            choose bim editor stair type (uiHit's actionId as an integer) in (the address of editor)
        if uiHit's wallType >= (0 as a 64 bit integer):
