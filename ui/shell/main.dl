    set closedMenu to 0
    if ((leftDown and (previousLeft = false)) and (panelClicked = false)) and (graphicsMenu > 0):
        set menuChoice to -1
        if graphicsMenu = 4:
            set menuChoice to the bim display choice at pixel from ((layout's planRight - 8.0) - (the bim display menu width)) above (layout's bottom - 38.0) flat true
            if menuChoice >= 0:
                apply bim view bar menuChoice to view editor's planViewId in (the address of editor)
        if graphicsMenu = 5:
            set menuChoice to the bim display choice at pixel from ((layout's width - 8.0) - (the bim display menu width)) above (lowerLayout's bottom - 38.0) flat true
            if menuChoice >= 0:
                apply bim view bar menuChoice to view editor's sectionViewId in (the address of editor)
        if graphicsMenu = 6:
            set menuChoice to the bim display choice at pixel from ((layout's width - 8.0) - (the bim display menu width)) above (viewLayout's bottom - 38.0) flat false
            if menuChoice >= 0:
                set viewMode to menuChoice
                set editor's message to (the string form of "3D view: ") + (the bim name of view mode viewMode)
        if graphicsMenu = 7:
            set menuChoice to 0
        # The sun panel stays open while it is clicked.
        if graphicsMenu = 8:
            set menuChoice to the bim sun panel hit at pixel from ((layout's width - 8.0) - (the bim sun panel width)) above (viewLayout's bottom - 38.0) by location sunSetting's byLocation
            if menuChoice = bim sun panel fixed hit:
                set sunSetting's byLocation to false
            if menuChoice = bim sun panel location hit:
                set sunSetting's byLocation to true
            if menuChoice >= bim sun panel step hit:
                step bim sun ((menuChoice - (bim sun panel step hit)) / 2) up ((the remainder of (menuChoice - (bim sun panel step hit)) divided by 2) = 1) in (the address of sunSetting)
            if menuChoice > 0:
                set editor's message to (the string form of "3D view sun: ") + (the bim sun summary of sunSetting)
        if graphicsMenu = 1:
            set menuChoice to the bim graphics choice at pixel from (layout's planRight - 334.0) above (layout's bottom - 38.0) flat true
            if menuChoice >= 0:
                apply bim view bar menuChoice to view editor's planViewId in (the address of editor)
        if graphicsMenu = 2:
            set menuChoice to the bim graphics choice at pixel from (layout's width - 334.0) above (lowerLayout's bottom - 38.0) flat true
            if menuChoice >= 0:
                apply bim view bar menuChoice to view editor's sectionViewId in (the address of editor)
        if graphicsMenu = 3:
            set menuChoice to the bim graphics choice at pixel from (layout's width - 294.0) above (viewLayout's bottom - 38.0) flat false
            if menuChoice = 13:
                set shadowsOn to shadowsOn = false
            # Edges turns shaded with edges on, or back to shaded.
            if menuChoice = 15:
                if viewMode = bim shaded edges view mode:
                    set viewMode to bim shaded view mode
                else:
                    set viewMode to bim shaded edges view mode
                set editor's message to (the string form of "3D view: ") + (the bim name of view mode viewMode)
            # Reinforcement with its diameter, or as its centre lines.
            if menuChoice = 16:
                set rebarDetail to rebarDetail = false
                if rebarDetail:
