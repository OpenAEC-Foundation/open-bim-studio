                else:
                    set editor's message to the string form of "3D view: reinforcement as centre lines"
        if menuChoice >= 0:
            set panelClicked to true
        set closedMenu to graphicsMenu
        set graphicsMenu to 0
        if ((closedMenu = 3) and (menuChoice = 17)) or ((closedMenu = 8) and (menuChoice >= 0)):
            set graphicsMenu to 8
    # A click on a view's bar sets its display or steps its scale.
    if (leftDown and (previousLeft = false)) and (panelClicked = false):
        if overPlan:
            set barHit to the bim view bar hit at pixel ending at (layout's planRight - 8.0) and (layout's bottom - 38.0) scaled true
            if barHit = 20:
                set panelClicked to true
                set graphicsMenu to 1
            else if barHit = bim view bar display hit:
                set panelClicked to true
                if closedMenu != 4:
                    set graphicsMenu to 4
            else if barHit >= 0:
                set panelClicked to true
                apply bim view bar barHit to view editor's planViewId in (the address of editor)
        else if ((pixel's x > layout's planRight) and ((pixel's y > lowerLayout's top) and (pixel's y < lowerLayout's bottom))) and (showSection and editor's hasSection):
            set barHit to the bim view bar hit at pixel ending at (layout's width - 8.0) and (lowerLayout's bottom - 38.0) scaled true
            if barHit = 20:
                set panelClicked to true
                set graphicsMenu to 2
            else if barHit = bim view bar display hit:
                set panelClicked to true
                if closedMenu != 5:
                    set graphicsMenu to 5
            else if barHit >= 0:
                set panelClicked to true
                apply bim view bar barHit to view editor's sectionViewId in (the address of editor)
        else if overView:
            set barHit to the bim view bar hit at pixel ending at (layout's width - 8.0) and (viewLayout's bottom - 38.0) scaled false
            if barHit = 20:
                set panelClicked to true
                set graphicsMenu to 3
            else if barHit = 21:
                set panelClicked to true
                set uiCommand to 2129
            else if barHit = 13:
                set panelClicked to true
                set shadowsOn to shadowsOn = false
                if shadowsOn:
                    set editor's message to the string form of "3D view: shadows on"
                else:
                    set editor's message to the string form of "3D view: shadows off"
            else if barHit = bim view bar display hit:
                set panelClicked to true
                if closedMenu != 6:
                    set graphicsMenu to 6
            else if barHit = bim view bar status hit:
                set panelClicked to true
                set graphicsMenu to 7
    if ((leftDown and (previousLeft = false)) and showVisibility) and (panelClicked = false):
        set panelClicked to click bim visibility panel at pixel of (the address of editor) in layout
    if showSheet:
        update bim sheet drag at pixel in (the address of sheetWorkspace)
        if ((leftDown and (previousLeft = false)) and overPlan) and (editingSheet = false):
            set sheetWorkspace's selected to -1
        if ((leftDown and (previousLeft = false)) and overSheet) and (panelClicked = false):
            set sheetCopyHeld to (key 341 is down in window) or (key 345 is down in window)
            set panelClicked to press bim sheet at pixel copying sheetCopyHeld in (the address of sheetWorkspace) for (the address of editor)
        if (leftDown = false) and previousLeft:
            release bim sheet pointer in (the address of sheetWorkspace) for (the address of editor)
    if ((leftDown and (previousLeft = false)) and overSheetBoard) and (panelClicked = false):
        set panelClicked to true
        set boardPoint to the bim unprojected sheet pixel pixel through sheetBoardCamera
        set boardColumns to the maximum of 1 and (the minimum of 3 and ((((layout's width - layout's planRight) - 40.0) / 320.0) as an integer))
        set boardColumn to (the floor of ((boardPoint's x - (layout's planRight + 20.0)) / 320.0)) as an integer
        set boardRow to (the floor of ((boardPoint's y - (layout's top + 38.0)) / 280.0)) as an integer
        set boardHit to (boardRow * boardColumns) + boardColumn
        if (((boardColumn >= 0) and (boardColumn < boardColumns)) and (boardRow >= 0)) and ((boardHit >= 0) and (boardHit < (the length of (editor's documentValue's current's sheets's values)))):
            set boardNow to the bim microseconds now
            if (sheetBoardLastHit = boardHit) and ((boardNow - sheetBoardLastClick) < (400000 as a 64 bit integer)):
                set chosenSheet to the item at boardHit in (editor's documentValue's current's sheets's values)
                set editor's sheetId to chosenSheet's id
                set foundTab to the bim tab of kind (bim sheet tab) detail chosenSheet's id among tabKinds and tabDetails
                if foundTab < 0:
                    append bim sheet tab to tabKinds
                    append chosenSheet's id to tabDetails
                    set foundTab to (the length of tabKinds) - 1
                set activeTab to foundTab
            set sheetBoardLastHit to boardHit
            set sheetBoardLastClick to boardNow
    # Crop handles operate on the view, independently of model selection.
    if (((leftDown and (previousLeft = false)) and overPlan) and (panelClicked = false)) and (editor's tool = bim select tool):
        set showCropCentre to cropSelected
        set cropSelected to false
        set dragCropFound to the bim view index of editor's planViewId in editor's documentValue's current
        if dragCropFound's valid:
            set dragCrop to the item at dragCropFound's position in (editor's documentValue's current's views's values)
            if dragCrop's cropped:
                set cropDragHandle to the bim crop handle near pixel of dragCrop through (the bim plan transform of layout with camera) with centre showCropCentre
                if cropDragHandle >= 0:
                    set cropDragView to dragCrop's id
                    set cropDragStart to the bim model point of pixel in layout with camera
                    set cropSelected to true
                    set panelClicked to true
                    set editor's propertiesViewId to dragCrop's id
                    set editor's message to the string form of "Crop region: drag a handle; Esc cancels"
    if cropDragHandle >= 0:
        if (key 256 is down in window) or (editor's planViewId != cropDragView):
