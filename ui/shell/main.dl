            if set bim opening editor's selectionId type to uiHit's actionId in (the address of (editor's documentValue's current)):
                commit bim transaction in (the address of (editor's documentValue))
                set editor's openingTypeId to uiHit's actionId
                set editor's message to (the string form of "Opening ") + ((the string form of editor's selectionId) + (the string form of ": type changed"))
            else:
                roll back bim transaction in (the address of (editor's documentValue))
        else if uiHit's action = bim browser opening type:
            set editor's openingTypeId to uiHit's actionId
            set editor's tool to bim opening tool
            set editor's chainActive to false
