            set clickHandled to true
            set editor's message to the string form of "Push/pull: click a Sketch mass or editable mesh face"
        if clickHandled = false:
            press bim editor pointer in (the address of editor)
    set overSection to ((pixel's x > layout's planRight) and ((pixel's y > lowerLayout's top) and (pixel's y < lowerLayout's bottom))) and (showSection and editor's hasSection)
    if analyticDetailOwnsPointer:
        set overSection to false
    if ((leftDown and (previousLeft = false)) and overSection) and (panelClicked = false):
