                set editor's message to the string form of "Crop region updated"
            set cropDragHandle to -1
    if ((leftDown and (previousLeft = false)) and overPlan) and (panelClicked = false):
        set editor's extending to (key 340 is down in window) or (key 344 is down in window)
        set pushInView to false
        press bim editor pointer in (the address of editor)
        set editor's extending to false
