# SPDX-License-Identifier: MPL-2.0
# Imported through generated/platform.dl on Windows builds (build.sh generate).
# Keeps native caption/buttons and respects High Contrast at startup.
# HWND is a pointer; BOOL, DWORD and HRESULT are 32 bits on Win32 and Win64.
# https://learn.microsoft.com/en-us/windows/win32/api/dwmapi/nf-dwmapi-dwmsetwindowattribute
# https://learn.microsoft.com/en-us/windows/win32/api/winuser/ns-winuser-highcontrasta
import viewer/vulkan/graphics.dl

class:
    patterns:
        [a|] bim native high contrast record
    members:
        byteCount as a 32 bit unsigned integer
        flags as a 32 bit unsigned integer
        schemeName as a pointer

function use bim window frame dark {boolean:darkChoice} on {pointer:windowValue}:
    execute:
        if windowValue = (0 as a pointer):
            return nothing
        set gpuState to the gpu context of windowValue
        if gpuState's window = (0 as a pointer):
            return nothing
        set nativeHandle to @intrinsic("call", "glfw", "glfwGetWin32Window", a pointer, gpuState's window)
        if nativeHandle = (0 as a pointer):
            return nothing
        set contrastState to @intrinsic("construct", a bim native high contrast record, 0 as a 32 bit unsigned integer, 0 as a 32 bit unsigned integer, 0 as a pointer)
        set contrastState's byteCount to (the size of the type of contrastState) as a 32 bit unsigned integer
        # SPI_GETHIGHCONTRAST=0x42: read only, no broadcast or system mutation.
        set contrastRead to @intrinsic("call", "user32", "SystemParametersInfoA", a 32 bit integer, 66 as a 32 bit unsigned integer, contrastState's byteCount, the address of contrastState, 0 as a 32 bit unsigned integer)
        if contrastRead = 0:
            return nothing
        if (the remainder of contrastState's flags divided by (2 as a 32 bit unsigned integer)) != (0 as a 32 bit unsigned integer):
            return nothing
        # A real 32-bit BOOL, never the language's one-byte boolean.
        set enabledValue to 1 as a 32 bit unsigned integer
        if darkChoice = false:
            set enabledValue to 0 as a 32 bit unsigned integer
        set appliedStatus to @intrinsic("call", "dwmapi", "DwmSetWindowAttribute", a 32 bit integer, nativeHandle, 20 as a 32 bit unsigned integer, the address of enabledValue, 4 as a 32 bit unsigned integer)
        if appliedStatus < 0:
            # Older Windows 10 used attribute 19; unsupported versions simply
            # leave their normal caption unchanged. No custom caption colours.
            ignore @intrinsic("call", "dwmapi", "DwmSetWindowAttribute", a 32 bit integer, nativeHandle, 19 as a 32 bit unsigned integer, the address of enabledValue, 4 as a 32 bit unsigned integer)
