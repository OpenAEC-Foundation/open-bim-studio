# SPDX-License-Identifier: MPL-2.0
# The screens round the application's files, after the OpenAEC Style Repo
# 0.4 (design/ontwerp-0.4: 05-layouts.md core screens 2, 3 and 6,
# 03-tegels.md, 04-componenten.md):
#
# - the start screen, when the window opens without a file: New on the left
#   as task tiles, the recent files on the right, the first ones as project
#   cards and the others as a list;
# - the File menu (File before the ribbon's tabs): a column of 260 pixels
#   with rows of 40 (the active one tinted, with a stripe of 3), the page's
#   task tiles and the recent files beside it;
# - the Settings window: Appearance (theme, workspace, status bar) and
#   General (opening the last file at start, the units of a new model);
# - the dialog that asks about unsaved changes, 420 pixels wide over the
#   dimmed window.
#
# They draw and say what a click hits. Their own commands (2140 to 2163)
# change a `bim file screens record` or the settings; the file commands they
# send (2173 to 2193) are the application's (`bim_app_files.dl`, run in
# `main.dl`).
import ui/panels/bim_ui.dl
import ui/shell/bim_app_files.dl
import generated/version.dl

# ---------------------------------------------------------------- commands

# The File button: the File menu opened or closed.
function bim file menu toggle command:
    replacement:
        2140
function bim file menu close command:
    replacement:
        2141
# A page of the File menu, plus 0 New or 1 Open.
function bim file page command:
    replacement:
        2142
function bim settings open command:
    replacement:
        2144
function bim settings close command:
    replacement:
        2145
# A page of the Settings window, plus 0 Appearance or 1 General.
function bim settings page command:
    replacement:
        2146
# A list in the Settings window opened, plus 1 Workspace, 2 Status bar or 3
# Default units; plus 0 closes the open one.
function bim settings list command:
    replacement:
        2148
# A setting chosen, plus the value: the theme (0 Light, 1 Dark), the
# workspace (0 follows the theme, 1 always light, 2 always dark), the status
# bar (0 follows the theme, 1 always dark), the units (0 mm, 1 cm, 2 m);
# opening the last file at start switched over.
function bim theme setting command:
    replacement:
        2152
function bim workspace setting command:
    replacement:
        2154
function bim status bar setting command:
    replacement:
        2157
function bim open last setting command:
    replacement:
        2159
function bim units setting command:
    replacement:
        2160
# The start screen left for the model shown under it.
function bim start continue command:
    replacement:
        2163

# What of the screens shows: the File menu and its page (0 New, 1 Open),
# the Settings window, its page (0 Appearance, 1 General) and its open list
# (0 none, 1 Workspace, 2 Status bar, 3 Default units).
class:
    patterns:
        [a|] bim file screens record
    members:
        menuOpen as a boolean
        page as an integer
        settingsOpen as a boolean
        settingsPage as an integer
        listOpen as an integer

function the bim file screens at rest:
    execute:
        return @intrinsic("construct", a bim file screens record, false, 1, false, 0, 0)

# What one of the screens' own commands does to them. A setting's command
# closes the open list; the setting itself is `the bim choices ... after
# setting ...`.
function apply bim file screen command {integer:sent} to {a pointer to a bim file screens record:screens}:
    execute:
        if sent = (bim file menu toggle command):
            set screens's menuOpen to (screens's menuOpen = false)
            set screens's page to 1
        else if sent = (bim file menu close command):
            set screens's menuOpen to false
        else if (sent >= (bim file page command)) and (sent < ((bim file page command) + 2)):
            set screens's page to sent - (bim file page command)
        else if sent = (bim settings open command):
            set screens's settingsOpen to true
            set screens's listOpen to 0
        else if sent = (bim settings close command):
            set screens's settingsOpen to false
            set screens's listOpen to 0
        else if (sent >= (bim settings page command)) and (sent < ((bim settings page command) + 2)):
            set screens's settingsPage to sent - (bim settings page command)
            set screens's listOpen to 0
        else if (sent >= (bim settings list command)) and (sent < ((bim settings list command) + 4)):
            set wanted to sent - (bim settings list command)
            if wanted = screens's listOpen:
                set screens's listOpen to 0
            else:
                set screens's listOpen to wanted
        else if (sent >= (bim theme setting command)) and (sent < ((bim units setting command) + 3)):
            set screens's listOpen to 0

# Whether `sent` chooses a setting.
function bim command {integer:sent} sets a setting:
    execute:
        if (sent >= (bim theme setting command)) and (sent < ((bim units setting command) + 3)):
            return true
        return false

# The settings `chosen` with the setting command `sent` applied.
function the bim choices {bim app settings record:chosen} after setting {integer:sent}:
    execute:
        set revised to chosen
        if (sent >= (bim theme setting command)) and (sent < (bim workspace setting command)):
            set revised's theme to sent - (bim theme setting command)
        else if (sent >= (bim workspace setting command)) and (sent < (bim status bar setting command)):
            set revised's workspace to sent - (bim workspace setting command)
        else if (sent >= (bim status bar setting command)) and (sent < (bim open last setting command)):
            set revised's statusbar to sent - (bim status bar setting command)
        else if sent = (bim open last setting command):
            set revised's openLast to (revised's openLast = false)
        else if (sent >= (bim units setting command)) and (sent < ((bim units setting command) + 3)):
            set revised's units to sent - (bim units setting command)
        return revised

# ------------------------------------------------------------- components

# Whether (`px`, `py`) lies in the rectangle at `left`, `upperEdge`.
local function the bim spot {a 64 bit floating-point number:px} {a 64 bit floating-point number:py} lies within {a 64 bit floating-point number:left} {a 64 bit floating-point number:upperEdge} {a 64 bit floating-point number:across} {a 64 bit floating-point number:tall}:
    execute:
        if (px >= left) and (px < (left + across)):
            if (py >= upperEdge) and (py < (upperEdge + tall)):
                return true
        return false

# A click on the screens: command `sent` (-1 for none, the click only kept
# from what lies under them).
local function a bim screen hit sending {integer:sent}:
    execute:
        return @intrinsic("construct", a bim ui hit record, sent, -1, (-1) as a 64 bit integer, true, (-1) as a 64 bit integer, -1, 0, (-1) as a 64 bit integer)

# The theme's overlay over the whole window, behind a dialog: Light
# rgba(42, 42, 50, 0.35), Dark rgba(0, 0, 0, 0.45).
local function veil bim window {a 64 bit floating-point number:across} by {a 64 bit floating-point number:tall} in {graphics frame:frame}:
    execute:
        set veilRed to 0
        set veilGreen to 0
        set veilBlue to 0
        set veilAlpha to 115
        if (bim ui theme) = 0:
            set veilRed to 42
            set veilGreen to 42
            set veilBlue to 50
            set veilAlpha to 89
        if frame's drawable:
            ignore @intrinsic("call", "dynlex_graphics", "dynlex_graphics_draw_rectangle", an integer, frame's window, 0.0 as a floating-point number, 0.0 as a floating-point number, across as a floating-point number, tall as a floating-point number, veilRed, veilGreen, veilBlue, veilAlpha)

# `base` moved `share` of the way to `tint`, as the style mixes a colour
# from its tokens.
local function the bim blend of {bim ui colour record:base} toward {bim ui colour record:tint} by {a 64 bit floating-point number:share}:
    execute:
        set mixedRed to (((base's red as a 64 bit floating-point number) + (((tint's red - base's red) as a 64 bit floating-point number) * share)) + 0.5) as an integer
        set mixedGreen to (((base's green as a 64 bit floating-point number) + (((tint's green - base's green) as a 64 bit floating-point number) * share)) + 0.5) as an integer
        set mixedBlue to (((base's blue as a 64 bit floating-point number) + (((tint's blue - base's blue) as a 64 bit floating-point number) * share)) + 0.5) as an integer
        return the bim ui colour mixedRed mixedGreen mixedBlue

# How wide a button with `buttonText` is: 12 pixels each side, at least 80.
local function the bim style button width of {a string:buttonText} with {bim text atlas record:atlas}:
    execute:
        return the maximum of 80.0 and ((the bim text width of buttonText in face (bim text semibold) of atlas) + 24.0)

# A button 28 pixels high, `across` wide: `buttonKind` 0 primary (accent),
# 1 secondary (raised, a strong border), 2 quiet (filled only under the
# pointer). Returns whether the pointer is over it.
local function draw bim style button {a string:buttonText} kind {integer:buttonKind} at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:upperEdge} wide {a 64 bit floating-point number:across} pointing at {a 64 bit floating-point number:px} and {a 64 bit floating-point number:py} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        set hovered to the bim spot px py lies within left upperEdge across 28.0
        set ink to scheme's ink
        set fill to scheme's raised
        if buttonKind = 0:
            set fill to scheme's accent
            if hovered:
                set fill to scheme's accentHover
            draw bim ui rounded rectangle left upperEdge across 28.0 radius 6.0 painted fill in frame
            set ink to scheme's onAccent
        else if buttonKind = 1:
            if hovered:
                set fill to scheme's hover
            draw bim ui box left upperEdge across 28.0 radius 6.0 painted fill edged scheme's strong wide 1.0 in frame
        else if hovered:
            draw bim ui rounded rectangle left upperEdge across 28.0 radius 6.0 painted scheme's hover in frame
        set textWidth to the bim text width of buttonText in face (bim text semibold) of atlas
        draw bim ui text buttonText at (the floor of (left + ((across - textWidth) * 0.5))) and (upperEdge + 18.0) in face (bim text semibold) with atlas painted ink in frame
        return hovered

# A dialog's close button, 28 pixels square with an x. Returns whether the
# pointer is over it.
local function draw bim close mark at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:upperEdge} pointing at {a 64 bit floating-point number:px} and {a 64 bit floating-point number:py} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        set hovered to the bim spot px py lies within left upperEdge 28.0 28.0
        set markInk to scheme's inkSecondary
        if hovered:
            draw bim ui rounded rectangle left upperEdge 28.0 28.0 radius 3.0 painted scheme's hover in frame
            set markInk to scheme's ink
        draw bim ui line from (left + 9.0) (upperEdge + 9.0) to (left + 19.0) (upperEdge + 19.0) wide 1.5 coloured markInk's red, markInk's green and markInk's blue in frame
        draw bim ui line from (left + 19.0) (upperEdge + 9.0) to (left + 9.0) (upperEdge + 19.0) wide 1.5 coloured markInk's red, markInk's green and markInk's blue in frame
        return hovered

# The icon tile (03-tegels.md): `tileSize` pixels square, the light accent
# tint with a border of the accent mixed 35% into `raised`, the 22-pixel
# icon in `accent-text`.
local function paint bim icon square {integer:glyph} at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:upperEdge} sized {a 64 bit floating-point number:tileSize} with {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        draw bim ui box left upperEdge tileSize tileSize radius 6.0 painted scheme's selected edged (the bim blend of scheme's raised toward scheme's accent by 0.35) wide 1.0 in frame
        set inset to the floor of ((tileSize - 22.0) * 0.5)
        draw bim ui icon glyph sized 22 at (left + inset) and (upperEdge + inset) painted scheme's accentInk accented scheme's accentInk with atlas in frame

# A theme in small, in the place of an icon tile: its frame, a panel and the
# accent.
local function paint bim theme swatch {integer:themeChoice} at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:upperEdge} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        set outer to the bim ui colour 241 238 234
        set inner to the bim ui colour 255 255 255
        if themeChoice = 1:
            set outer to the bim ui colour 42 42 50
            set inner to the bim ui colour 59 59 69
        draw bim ui box left upperEdge 40.0 40.0 radius 6.0 painted outer edged scheme's strong wide 1.0 in frame
        draw bim ui rectangle (left + 8.0) (upperEdge + 8.0) 14.0 3.0 painted scheme's accent in frame
        draw bim ui rounded rectangle (left + 8.0) (upperEdge + 15.0) 24.0 17.0 radius 3.0 painted inner in frame

# A task tile (03-tegels.md, variant B), 64 pixels high and `across` wide:
# an icon tile, a title and a line about the task; under the pointer its
# border is the accent. Returns whether the pointer is over it.
local function draw bim task tile {integer:glyph} titled {a string:tileTitle} saying {a string:about} at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:upperEdge} wide {a 64 bit floating-point number:across} pointing at {a 64 bit floating-point number:px} and {a 64 bit floating-point number:py} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        set hovered to the bim spot px py lies within left upperEdge across 64.0
        set edge to scheme's border
        if hovered:
            set edge to scheme's accent
        draw bim ui box left upperEdge across 64.0 radius 10.0 painted scheme's raised edged edge wide 1.0 in frame
        paint bim icon square glyph at (left + 16.0) and (upperEdge + 12.0) sized 40.0 with atlas in frame
        set textLeft to left + 68.0
        set room to (across - 68.0) - 16.0
        draw bim ui text (the bim fitted form of tileTitle in room pixels of face (bim text bold) with atlas) at textLeft and (upperEdge + 29.0) in face (bim text bold) with atlas painted scheme's ink in frame
        draw bim ui text (the bim fitted form of about in room pixels of face (bim text small) with atlas) at textLeft and (upperEdge + 47.0) in face (bim text small) with atlas painted scheme's inkSecondary in frame
        return hovered

# A choice tile (03-tegels.md): a task tile with a radio button at its top
# right; the chosen one has a border of 2 pixels in `selected-bar` and a
# filled radio button. No icon tile for a `glyph` below 0 (the caller draws
# one). Returns whether the pointer is over it.
local function draw bim choice tile {integer:glyph} titled {a string:tileTitle} saying {a string:about} chosen {boolean:isChosen} at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:upperEdge} wide {a 64 bit floating-point number:across} pointing at {a 64 bit floating-point number:px} and {a 64 bit floating-point number:py} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        set hovered to the bim spot px py lies within left upperEdge across 64.0
        set edge to scheme's border
        set edgeWidth to 1.0
        if hovered:
            set edge to scheme's accent
        if isChosen:
            set edge to scheme's selectedBar
            set edgeWidth to 2.0
        draw bim ui box left upperEdge across 64.0 radius 10.0 painted scheme's raised edged edge wide edgeWidth in frame
        if glyph >= 0:
            paint bim icon square glyph at (left + 16.0) and (upperEdge + 12.0) sized 40.0 with atlas in frame
        set textLeft to left + 68.0
        set room to (across - 68.0) - 40.0
        draw bim ui text (the bim fitted form of tileTitle in room pixels of face (bim text bold) with atlas) at textLeft and (upperEdge + 29.0) in face (bim text bold) with atlas painted scheme's ink in frame
        draw bim ui text (the bim fitted form of about in room pixels of face (bim text small) with atlas) at textLeft and (upperEdge + 47.0) in face (bim text small) with atlas painted scheme's inkSecondary in frame
        set radioLeft to (left + across) - 28.0
        draw bim ui box radioLeft (upperEdge + 12.0) 16.0 16.0 radius 8.0 painted scheme's raised edged scheme's strong wide 1.5 in frame
        if isChosen:
            draw bim ui rounded rectangle (radioLeft + 4.0) (upperEdge + 16.0) 8.0 8.0 radius 4.0 painted scheme's selectedBar in frame
        return hovered

# A row of a navigation column, `across` wide and `tall` high: an optional
# 16-pixel icon and its text; the active row tinted, with a stripe of 3
# pixels in `selected-bar` and its text in `accent-text`. Returns whether
# the pointer is over it.
local function draw bim navigation row {a string:rowText} with icon {integer:glyph} at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:upperEdge} wide {a 64 bit floating-point number:across} tall {a 64 bit floating-point number:rowHeight} active {boolean:isActive} pointing at {a 64 bit floating-point number:px} and {a 64 bit floating-point number:py} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        set hovered to the bim spot px py lies within left upperEdge across rowHeight
        set rowInk to scheme's ink
        if isActive:
            draw bim ui rectangle left upperEdge across rowHeight painted scheme's selected in frame
            draw bim ui rectangle left upperEdge 3.0 rowHeight painted scheme's selectedBar in frame
            set rowInk to scheme's accentInk
        else if hovered:
            draw bim ui rectangle left upperEdge across rowHeight painted scheme's hover in frame
        set textLeft to left + 18.0
        if glyph >= 0:
            draw bim ui icon glyph sized 16 at (left + 18.0) and (the floor of (upperEdge + ((rowHeight - 16.0) * 0.5))) painted rowInk accented scheme's accentInk with atlas in frame
            set textLeft to left + 44.0
        draw bim ui text rowText at textLeft and (the floor of (upperEdge + ((rowHeight * 0.5) + 5.0))) in face (bim text body) with atlas painted rowInk in frame
        return hovered

# A list field 28 pixels high (04-componenten.md): `shownText` with an arrow
# on the right; the border `text` under the pointer, the accent 2 pixels
# wide while its list is open. Returns whether the pointer is over it.
local function draw bim style list field showing {a string:shownText} at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:upperEdge} wide {a 64 bit floating-point number:across} open {boolean:isOpen} pointing at {a 64 bit floating-point number:px} and {a 64 bit floating-point number:py} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        set hovered to the bim spot px py lies within left upperEdge across 28.0
        set edge to scheme's strong
        set edgeWidth to 1.0
        if isOpen:
            set edge to scheme's accent
            set edgeWidth to 2.0
        else if hovered:
            set edge to scheme's ink
        draw bim ui box left upperEdge across 28.0 radius 6.0 painted scheme's raised edged edge wide edgeWidth in frame
        draw bim ui text shownText at (left + 10.0) and (upperEdge + 18.0) in face (bim text small) with atlas painted scheme's ink in frame
        draw bim ui chevron at ((left + across) - 14.0) and (upperEdge + 14.0) open true painted scheme's inkSecondary in frame
        return hovered

# A switch, 32 by 18 pixels: on, the accent with a white knob on the right.
local function draw bim style switch on {boolean:isOn} at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:upperEdge} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        if isOn:
            draw bim ui rounded rectangle left upperEdge 32.0 18.0 radius 9.0 painted scheme's accent in frame
            draw bim ui rounded rectangle (left + 16.0) (upperEdge + 2.0) 14.0 14.0 radius 7.0 painted (the bim ui colour 255 255 255) in frame
        else:
            draw bim ui box left upperEdge 32.0 18.0 radius 9.0 painted scheme's raised edged scheme's strong wide 1.0 in frame
            draw bim ui rounded rectangle (left + 3.0) (upperEdge + 3.0) 12.0 12.0 radius 6.0 painted scheme's strong in frame

# A setting's name and, below it, what it does.
local function draw bim setting name {a string:nameText} hint {a string:hintText} at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:upperEdge} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        draw bim ui text nameText at left and (upperEdge + 18.0) in face (bim text small) with atlas painted scheme's ink in frame
        draw bim ui text hintText at left and (upperEdge + 40.0) in face (bim text caption) with atlas painted scheme's inkSecondary in frame

# The choices of the Settings window's lists (1 Workspace, 2 Status bar, 3
# Default units) by name, and how many each has.
local function the bim choice {integer:choiceIndex} of list {integer:listKind}:
    execute:
        if listKind = 3:
            if choiceIndex = 0:
                return the string form of "Millimetres (mm)"
            if choiceIndex = 1:
                return the string form of "Centimetres (cm)"
            return the string form of "Metres (m)"
        if choiceIndex = 0:
            return the string form of "Follows theme"
        if (choiceIndex = 1) and (listKind = 1):
            return the string form of "Always light"
        return the string form of "Always dark"

local function the bim list {integer:listKind} choice count:
    execute:
        if listKind = 2:
            return 2
        return 3

# The recent files from `firstShown` on as one framed list of rows 40 pixels
# high (03-tegels.md): an icon, the name, the full path, the date in mono on
# the right; as many as fit above `bottom`. Returns the index of the file
# under the pointer, or -1.
local function draw bim recent list {a pointer to a list:recentEntries} from {integer:firstShown} at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:upperEdge} wide {a 64 bit floating-point number:across} above {a 64 bit floating-point number:bottom} pointing at {a 64 bit floating-point number:px} and {a 64 bit floating-point number:py} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        set fits to ((bottom - upperEdge) / 40.0) as an integer
        set shownCount to (the length of recentEntries) - firstShown
        if shownCount > fits:
            set shownCount to fits
        if shownCount <= 0:
            return -1
        set listHeight to ((shownCount as a 64 bit floating-point number) * 40.0) + 2.0
        draw bim ui box left upperEdge across listHeight radius 10.0 painted scheme's raised edged scheme's border wide 1.0 in frame
        set pointed to -1
        loop rowCursor from 0 to shownCount:
            set entryIndex to firstShown + rowCursor
            set entry to the item at entryIndex in recentEntries
            set rowTop to (upperEdge + 1.0) + ((rowCursor as a 64 bit floating-point number) * 40.0)
            if rowCursor > 0:
                draw bim ui rectangle (left + 1.0) rowTop (across - 2.0) 1.0 painted scheme's border in frame
            if the bim spot px py lies within left rowTop across 40.0:
                set pointed to entryIndex
                draw bim ui rounded rectangle (left + 4.0) (rowTop + 3.0) (across - 8.0) 34.0 radius 6.0 painted scheme's hover in frame
            draw bim ui icon (bim icon open) sized 16 at (left + 14.0) and (rowTop + 12.0) painted scheme's inkSecondary accented scheme's accentInk with atlas in frame
            set stampText to entry's stamp
            set stampWidth to the bim text width of stampText in face (bim text mono label) of atlas
            set textRoom to ((across - 42.0) - stampWidth) - 24.0
            set nameText to entry's name
            set pathText to entry's path
            draw bim ui text (the bim fitted form of nameText in textRoom pixels of face (bim text medium) with atlas) at (left + 42.0) and (rowTop + 17.0) in face (bim text medium) with atlas painted scheme's ink in frame
            draw bim ui text (the bim fitted form of pathText in textRoom pixels of face (bim text caption) with atlas) at (left + 42.0) and (rowTop + 32.0) in face (bim text caption) with atlas painted scheme's inkSecondary in frame
            draw bim ui text stampText at (((left + across) - 14.0) - stampWidth) and (rowTop + 25.0) in face (bim text mono label) with atlas painted scheme's inkSecondary in frame
        return pointed

# A project card (03-tegels.md) for a recent file, 150 pixels high: a
# preview 96 high in the workspace's colour with the application's icon (no
# picture of the model yet), the name and the date in mono. Returns whether
# the pointer is over it.
local function draw bim project card {bim recent file record:entry} at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:upperEdge} wide {a 64 bit floating-point number:across} pointing at {a 64 bit floating-point number:px} and {a 64 bit floating-point number:py} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        set hovered to the bim spot px py lies within left upperEdge across 150.0
        set edge to scheme's border
        if hovered:
            set edge to scheme's accent
        draw bim ui box left upperEdge across 150.0 radius 10.0 painted scheme's raised edged edge wide 1.0 in frame
        draw bim ui top rounded rectangle (left + 1.0) (upperEdge + 1.0) (across - 2.0) 95.0 radius 9.0 painted scheme's workspace in frame
        draw bim ui rectangle (left + 1.0) (upperEdge + 96.0) (across - 2.0) 1.0 painted scheme's border in frame
        draw bim ui icon (bim icon cube) sized 22 at (the floor of (left + ((across - 22.0) * 0.5))) and (upperEdge + 37.0) painted scheme's workspaceInk accented scheme's accent with atlas in frame
        set nameText to entry's name
        set stampText to entry's stamp
        draw bim ui text (the bim fitted form of nameText in (across - 28.0) pixels of face (bim text bold) with atlas) at (left + 14.0) and (upperEdge + 120.0) in face (bim text bold) with atlas painted scheme's ink in frame
        draw bim ui text stampText at (left + 14.0) and (upperEdge + 139.0) in face (bim text mono label) with atlas painted scheme's inkSecondary in frame
        return hovered

# The empty state (04-componenten.md), 152 pixels high: an icon, a title
# and a line about it, centred on the panel's colour; room at the bottom
# for one button.
local function draw bim empty state titled {a string:stateTitle} saying {a string:about} at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:upperEdge} wide {a 64 bit floating-point number:across} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        draw bim ui box left upperEdge across 152.0 radius 10.0 painted scheme's panel edged scheme's border wide 1.0 in frame
        set middle to left + (across * 0.5)
        draw bim ui icon (bim icon open) sized 22 at (the floor of (middle - 11.0)) and (upperEdge + 20.0) painted scheme's accentInk accented scheme's accentInk with atlas in frame
        set titleWidth to the bim text width of stateTitle in face (bim text bold) of atlas
        draw bim ui text stateTitle at (the floor of (middle - (titleWidth * 0.5))) and (upperEdge + 64.0) in face (bim text bold) with atlas painted scheme's ink in frame
        set aboutWidth to the bim text width of about in face (bim text small) of atlas
        draw bim ui text about at (the floor of (middle - (aboutWidth * 0.5))) and (upperEdge + 84.0) in face (bim text small) with atlas painted scheme's inkSecondary in frame

# A screen's heading and the line below it.
local function draw bim screen heading {a string:headingText} saying {a string:about} at {a 64 bit floating-point number:left} and {a 64 bit floating-point number:upperEdge} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        draw bim ui text headingText at left and (upperEdge + 16.0) in face (bim text heading) with atlas painted scheme's ink in frame
        draw bim ui text about at left and (upperEdge + 38.0) in face (bim text small) with atlas painted scheme's inkSecondary in frame

# ---------------------------------------------------------------- screens

# The start screen (05-layouts.md, core screen 2) from the title bar down to
# the status bar of a window `width` by `height`, without the ribbon or the
# panels: New on the left (the templates, opening a file, going on with the
# model shown), the recent files on the right, the first as project cards
# and the others as a list; an empty state when there are none. Returns what
# a click hits; it covers all of that area.
function draw bim start screen recent {a pointer to a list:recentEntries} templates {a pointer to a list:templateEntries} across {a 64 bit floating-point number:width} by {a 64 bit floating-point number:height} pointing at {a 64 bit floating-point number:px} and {a 64 bit floating-point number:py} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        set areaTop to bim ui title bar height
        set areaBottom to height - (bim ui status bar height)
        set struck to no bim ui hit
        if (py >= areaTop) and (py < areaBottom):
            set struck to a bim screen hit sending (-1)
        draw bim ui rectangle 0.0 areaTop width (areaBottom - areaTop) painted scheme's chrome in frame
        draw bim ui rectangle 0.0 areaTop width 1.0 painted scheme's border in frame
        # Two columns side by side, centred; the recent files left out in a
        # window too narrow for them.
        set leftWidth to 380.0
        set rightWidth to the minimum of 620.0 and ((width - leftWidth) - 112.0)
        set showsRecent to rightWidth >= 240.0
        set together to leftWidth
        if showsRecent:
            set together to (leftWidth + 48.0) + rightWidth
        set columnLeft to the maximum of 32.0 and (the floor of ((width - together) * 0.5))
        draw bim screen heading (the string form of "New") saying (the string form of "Start a model, open one, or go on with the one shown.") at columnLeft and (areaTop + 40.0) using atlas in frame
        set y to areaTop + 96.0
        loop templateCursor from 0 to the length of templateEntries:
            set templateEntry to the item at templateCursor in templateEntries
            set tileTitle to templateEntry's title
            set tileAbout to templateEntry's description
            set tileOver to draw bim task tile (bim icon new) titled tileTitle saying tileAbout at columnLeft and y wide leftWidth pointing at px and py using atlas in frame
            if tileOver:
                set struck to a bim screen hit sending (2190 + templateCursor)
            set y to y + 72.0
        set openOver to draw bim task tile (bim icon open) titled (the string form of "Open...") saying (the string form of "A model file: .ifcxb, .ifcx or .bim") at columnLeft and y wide leftWidth pointing at px and py using atlas in frame
        if openOver:
            set struck to a bim screen hit sending 2174
        set y to y + 72.0
        set goOnOver to draw bim task tile (bim icon cube) titled (the string form of "Continue") saying (the string form of "Go on with the model shown") at columnLeft and y wide leftWidth pointing at px and py using atlas in frame
        if goOnOver:
            set struck to a bim screen hit sending (bim start continue command)
        # The version and source commit, to quote in a bug report.
        set versionLine to (((the string form of "Open BIM Studio ") + (the bim app version)) + (the string form of "  ")) + (the bim app commit)
        draw bim ui text versionLine at columnLeft and (areaBottom - 16.0) in face (bim text caption) with atlas painted scheme's inkSecondary in frame
        if showsRecent:
            set rightLeft to (columnLeft + leftWidth) + 48.0
            draw bim screen heading (the string form of "Recent") saying (the string form of "Models opened or saved here, the last first.") at rightLeft and (areaTop + 40.0) using atlas in frame
            set y to areaTop + 96.0
            set recentCount to the length of recentEntries
            if recentCount = 0:
                draw bim empty state titled (the string form of "No recent files") saying (the string form of "Models you open or save appear here.") at rightLeft and y wide rightWidth using atlas in frame
                set buttonText to the string form of "Open..."
                set buttonWidth to the bim style button width of buttonText with atlas
                set buttonOver to draw bim style button buttonText kind 0 at (the floor of (rightLeft + ((rightWidth - buttonWidth) * 0.5))) and (y + 104.0) wide buttonWidth pointing at px and py using atlas in frame
                if buttonOver:
                    set struck to a bim screen hit sending 2174
            else:
                # Up to three cards in a row, each at least 200 pixels wide.
                set perRow to the minimum of 3 and recentCount
                loop while (perRow > 1) and ((((rightWidth + 12.0) / (perRow as a 64 bit floating-point number)) - 12.0) < 200.0):
                    set perRow to perRow - 1
                set cardWidth to the floor of (((rightWidth + 12.0) / (perRow as a 64 bit floating-point number)) - 12.0)
                loop cardCursor from 0 to perRow:
                    set cardLeft to rightLeft + ((cardCursor as a 64 bit floating-point number) * (cardWidth + 12.0))
                    set cardOver to draw bim project card (the item at cardCursor in recentEntries) at cardLeft and y wide cardWidth pointing at px and py using atlas in frame
                    if cardOver:
                        set struck to a bim screen hit sending (2180 + cardCursor)
                set y to y + 166.0
                if recentCount > perRow:
                    draw bim ui caps (the string form of "Recent files") at rightLeft and (y + 12.0) with atlas painted scheme's inkSecondary in frame
                    set rowPointed to draw bim recent list recentEntries from perRow at rightLeft and (y + 24.0) wide rightWidth above (areaBottom - 24.0) pointing at px and py using atlas in frame
                    if rowPointed >= 0:
                        set struck to a bim screen hit sending (2180 + rowPointed)
        return struck

# The File menu (05-layouts.md, core screen 3) in place of the ribbon, the
# document tabs and the panels, from below the ribbon's tabs down to the
# status bar: a column of 260 pixels with the pages New and Open, Save, Save
# as, Settings and the way back; the page beside it (New: a new model, the
# templates as choice tiles, the standard one chosen; Open: a file, the
# recent files). Returns what a click hits; it covers all of that area.
function draw bim file menu of {bim file screens record:screens} recent {a pointer to a list:recentEntries} templates {a pointer to a list:templateEntries} across {a 64 bit floating-point number:width} by {a 64 bit floating-point number:height} pointing at {a 64 bit floating-point number:px} and {a 64 bit floating-point number:py} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        set areaTop to bim ui top bar height
        set areaBottom to height - (bim ui status bar height)
        set struck to no bim ui hit
        if (py >= areaTop) and (py < areaBottom):
            set struck to a bim screen hit sending (-1)
        # The column.
        draw bim ui rectangle 0.0 areaTop 260.0 (areaBottom - areaTop) painted scheme's panel in frame
        draw bim ui rectangle 259.0 areaTop 1.0 (areaBottom - areaTop) painted scheme's border in frame
        draw bim ui rectangle 260.0 areaTop (width - 260.0) (areaBottom - areaTop) painted scheme's chrome in frame
        draw bim ui rectangle 0.0 areaTop width 1.0 painted scheme's border in frame
        set rowTop to areaTop + 8.0
        if draw bim navigation row (the string form of "New") with icon (bim icon new) at 0.0 and rowTop wide 259.0 tall 40.0 active (screens's page = 0) pointing at px and py using atlas in frame:
            set struck to a bim screen hit sending (bim file page command)
        set rowTop to rowTop + 40.0
        if draw bim navigation row (the string form of "Open") with icon (bim icon open) at 0.0 and rowTop wide 259.0 tall 40.0 active (screens's page = 1) pointing at px and py using atlas in frame:
            set struck to a bim screen hit sending ((bim file page command) + 1)
        set rowTop to rowTop + 40.0
        if draw bim navigation row (the string form of "Save") with icon (bim icon save) at 0.0 and rowTop wide 259.0 tall 40.0 active false pointing at px and py using atlas in frame:
            set struck to a bim screen hit sending 2175
        set rowTop to rowTop + 40.0
        if draw bim navigation row (the string form of "Save as...") with icon (bim icon save) at 0.0 and rowTop wide 259.0 tall 40.0 active false pointing at px and py using atlas in frame:
            set struck to a bim screen hit sending 2176
        set rowTop to rowTop + 48.0
        draw bim ui rectangle 16.0 (rowTop - 4.0) 227.0 1.0 painted scheme's border in frame
        if draw bim navigation row (the string form of "Settings...") with icon (bim icon settings) at 0.0 and rowTop wide 259.0 tall 40.0 active false pointing at px and py using atlas in frame:
            set struck to a bim screen hit sending (bim settings open command)
        draw bim ui rectangle 0.0 (areaBottom - 49.0) 259.0 1.0 painted scheme's border in frame
        if draw bim navigation row (the string form of "Return to model") with icon (bim icon back) at 0.0 and (areaBottom - 48.0) wide 259.0 tall 40.0 active false pointing at px and py using atlas in frame:
            set struck to a bim screen hit sending (bim file menu close command)
        # The page.
        set contentLeft to 300.0
        set tilesWidth to the minimum of 620.0 and ((width - contentLeft) - 40.0)
        set y to areaTop + 32.0
        if screens's page = 0:
            draw bim screen heading (the string form of "New") saying (the string form of "A new model in place of this one; changes not saved are asked about first.") at contentLeft and y using atlas in frame
            set y to y + 56.0
            set newOver to draw bim task tile (bim icon new) titled (the string form of "New model") saying (the string form of "From the standard template") at contentLeft and y wide tilesWidth pointing at px and py using atlas in frame
            if newOver:
                set struck to a bim screen hit sending 2173
            set y to y + 88.0
            draw bim ui caps (the string form of "Templates") at contentLeft and y with atlas painted scheme's inkSecondary in frame
            set y to y + 12.0
            loop templateCursor from 0 to the length of templateEntries:
                set templateEntry to the item at templateCursor in templateEntries
                set tileTitle to templateEntry's title
                set tileAbout to templateEntry's description
                set tileOver to draw bim choice tile (bim icon new) titled tileTitle saying tileAbout chosen (templateCursor = 0) at contentLeft and y wide tilesWidth pointing at px and py using atlas in frame
                if tileOver:
                    set struck to a bim screen hit sending (2190 + templateCursor)
                set y to y + 72.0
        else:
            draw bim screen heading (the string form of "Open") saying (the string form of "A model file, or one used recently.") at contentLeft and y using atlas in frame
            set y to y + 56.0
            set openOver to draw bim task tile (bim icon open) titled (the string form of "Open...") saying (the string form of "A model file: .ifcxb, .ifcx or .bim") at contentLeft and y wide tilesWidth pointing at px and py using atlas in frame
            if openOver:
                set struck to a bim screen hit sending 2174
            set y to y + 88.0
            draw bim ui caps (the string form of "Recent files") at contentLeft and y with atlas painted scheme's inkSecondary in frame
            set y to y + 12.0
            if (the length of recentEntries) = 0:
                draw bim ui text (the string form of "No recent files yet: models you open or save appear here.") at contentLeft and (y + 18.0) in face (bim text small) with atlas painted scheme's inkSecondary in frame
            else:
                set rowPointed to draw bim recent list recentEntries from 0 at contentLeft and y wide tilesWidth above (areaBottom - 24.0) pointing at px and py using atlas in frame
                if rowPointed >= 0:
                    set struck to a bim screen hit sending (2180 + rowPointed)
        return struck

# The Settings window (04-componenten.md, Dialog and "Instellingen voor
# weergave"), 560 by 420 pixels over the dimmed window: Appearance (the theme
# as choice tiles, the workspace and the status bar as lists) and General
# (opening the last file at start, the units of a new model), with the
# settings `chosen`. A setting takes effect when chosen. While a list is
# open a click beside its choices closes it. Returns what a click hits; it
# covers the whole window.
function draw bim settings dialog of {bim file screens record:screens} with {bim app settings record:chosen} across {a 64 bit floating-point number:width} by {a 64 bit floating-point number:height} pointing at {a 64 bit floating-point number:px} and {a 64 bit floating-point number:py} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        veil bim window width by height in frame
        set struck to a bim screen hit sending (-1)
        set boxWidth to 560.0
        set boxHeight to 420.0
        set boxLeft to the maximum of 8.0 and (the floor of ((width - boxWidth) * 0.5))
        set boxTop to the maximum of 8.0 and (the floor of ((height - boxHeight) * 0.5))
        draw bim ui box boxLeft boxTop boxWidth boxHeight radius 10.0 painted scheme's raised edged scheme's border wide 1.0 in frame
        draw bim ui text (the string form of "Settings") at (boxLeft + 20.0) and (boxTop + 33.0) in face (bim text heading) with atlas painted scheme's ink in frame
        if draw bim close mark at ((boxLeft + boxWidth) - 40.0) and (boxTop + 12.0) pointing at px and py in frame:
            set struck to a bim screen hit sending (bim settings close command)
        set bodyTop to boxTop + 52.0
        set footTop to (boxTop + boxHeight) - 52.0
        draw bim ui rectangle (boxLeft + 1.0) bodyTop (boxWidth - 2.0) 1.0 painted scheme's border in frame
        draw bim ui rectangle (boxLeft + 1.0) footTop (boxWidth - 2.0) 1.0 painted scheme's border in frame
        # The pages.
        draw bim ui rectangle (boxLeft + 1.0) (bodyTop + 1.0) 149.0 ((footTop - bodyTop) - 1.0) painted scheme's panel in frame
        draw bim ui rectangle (boxLeft + 150.0) (bodyTop + 1.0) 1.0 ((footTop - bodyTop) - 1.0) painted scheme's border in frame
        if draw bim navigation row (the string form of "Appearance") with icon (-1) at (boxLeft + 1.0) and (bodyTop + 8.0) wide 149.0 tall 36.0 active (screens's settingsPage = 0) pointing at px and py using atlas in frame:
            set struck to a bim screen hit sending (bim settings page command)
        if draw bim navigation row (the string form of "General") with icon (-1) at (boxLeft + 1.0) and (bodyTop + 44.0) wide 149.0 tall 36.0 active (screens's settingsPage = 1) pointing at px and py using atlas in frame:
            set struck to a bim screen hit sending ((bim settings page command) + 1)
        # The foot: settings take effect at once, so one button closes.
        draw bim ui text (the string form of "Changes take effect at once.") at (boxLeft + 20.0) and (footTop + 31.0) in face (bim text caption) with atlas painted scheme's inkSecondary in frame
        set closeText to the string form of "Close"
        set closeWidth to the bim style button width of closeText with atlas
        if draw bim style button closeText kind 0 at (((boxLeft + boxWidth) - 20.0) - closeWidth) and (footTop + 12.0) wide closeWidth pointing at px and py using atlas in frame:
            set struck to a bim screen hit sending (bim settings close command)
        # The page's settings: names on the left, their controls on the
        # right.
        set contentLeft to boxLeft + 174.0
        set contentWidth to (boxWidth - 150.0) - 48.0
        set fieldLeft to (contentLeft + contentWidth) - 180.0
        set y to bodyTop + 20.0
        set listShown to 0
        set listTop to 0.0
        set listValue to 0
        if screens's settingsPage = 0:
            draw bim ui caps (the string form of "Theme") at contentLeft and (y + 10.0) with atlas painted scheme's inkSecondary in frame
            set y to y + 20.0
            set tileWidth to the floor of ((contentWidth - 8.0) * 0.5)
            if draw bim choice tile (-1) titled (the string form of "Dark") saying (the string form of "The default") chosen (chosen's theme = 1) at contentLeft and y wide tileWidth pointing at px and py using atlas in frame:
                set struck to a bim screen hit sending ((bim theme setting command) + 1)
            paint bim theme swatch 1 at (contentLeft + 16.0) and (y + 12.0) in frame
            if draw bim choice tile (-1) titled (the string form of "Light") saying (the string form of "Light panels") chosen (chosen's theme = 0) at ((contentLeft + tileWidth) + 8.0) and y wide tileWidth pointing at px and py using atlas in frame:
                set struck to a bim screen hit sending (bim theme setting command)
            paint bim theme swatch 0 at (((contentLeft + tileWidth) + 8.0) + 16.0) and (y + 12.0) in frame
            set y to y + 88.0
            draw bim setting name (the string form of "Workspace") hint (the string form of "Colour of the area your document sits in.") at contentLeft and y using atlas in frame
            if draw bim style list field showing (the bim choice (chosen's workspace) of list 1) at fieldLeft and y wide 180.0 open (screens's listOpen = 1) pointing at px and py using atlas in frame:
                set struck to a bim screen hit sending ((bim settings list command) + 1)
            if screens's listOpen = 1:
                set listShown to 1
                set listTop to y + 32.0
                set listValue to chosen's workspace
            set y to y + 64.0
            draw bim setting name (the string form of "Status bar") hint (the string form of "Follows the theme, or stays dark.") at contentLeft and y using atlas in frame
            if draw bim style list field showing (the bim choice (chosen's statusbar) of list 2) at fieldLeft and y wide 180.0 open (screens's listOpen = 2) pointing at px and py using atlas in frame:
                set struck to a bim screen hit sending ((bim settings list command) + 2)
            if screens's listOpen = 2:
                set listShown to 2
                set listTop to y + 32.0
                set listValue to chosen's statusbar
        else:
            draw bim setting name (the string form of "Open last project directly") hint (the string form of "Skip the start screen and open the last file used.") at contentLeft and y using atlas in frame
            set switchLeft to (contentLeft + contentWidth) - 32.0
            draw bim style switch on (chosen's openLast) at switchLeft and (y + 5.0) in frame
            if the bim spot px py lies within (switchLeft - 4.0) y 40.0 28.0:
                set struck to a bim screen hit sending (bim open last setting command)
            set y to y + 64.0
            draw bim setting name (the string form of "Default units") hint (the string form of "The length unit a new model starts in.") at contentLeft and y using atlas in frame
            if draw bim style list field showing (the bim choice (chosen's units) of list 3) at fieldLeft and y wide 180.0 open (screens's listOpen = 3) pointing at px and py using atlas in frame:
                set struck to a bim screen hit sending ((bim settings list command) + 3)
            if screens's listOpen = 3:
                set listShown to 3
                set listTop to y + 32.0
                set listValue to chosen's units
        # The open list, over the rest (04-componenten.md, Menu): rows of 28
        # pixels, the current choice tinted with a stripe.
        if listShown > 0:
            set struck to a bim screen hit sending (bim settings list command)
            set firstCommand to bim workspace setting command
            if listShown = 2:
                set firstCommand to bim status bar setting command
            if listShown = 3:
                set firstCommand to bim units setting command
            set choiceCount to the bim list listShown choice count
            set listHeight to ((choiceCount as a 64 bit floating-point number) * 28.0) + 8.0
            draw bim ui box fieldLeft listTop 180.0 listHeight radius 10.0 painted scheme's raised edged scheme's border wide 1.0 in frame
            loop choiceCursor from 0 to choiceCount:
                set rowTop to (listTop + 4.0) + ((choiceCursor as a 64 bit floating-point number) * 28.0)
                set rowOver to the bim spot px py lies within fieldLeft rowTop 180.0 28.0
                if choiceCursor = listValue:
                    draw bim ui rounded rectangle (fieldLeft + 4.0) rowTop 172.0 28.0 radius 6.0 painted scheme's selected in frame
                    draw bim ui rectangle (fieldLeft + 4.0) (rowTop + 6.0) 2.0 16.0 painted scheme's selectedBar in frame
                else if rowOver:
                    draw bim ui rounded rectangle (fieldLeft + 4.0) rowTop 172.0 28.0 radius 6.0 painted scheme's hover in frame
                if rowOver:
                    set struck to a bim screen hit sending (firstCommand + choiceCursor)
                draw bim ui text (the bim choice choiceCursor of list listShown) at (fieldLeft + 14.0) and (rowTop + 18.0) in face (bim text small) with atlas painted scheme's ink in frame
        return struck

# The dialog that asks about changes not saved (05-layouts.md, core screen
# 6), 420 pixels wide over the dimmed window, for the model titled
# `documentTitle`: Save (primary, on the right, also Enter), Cancel (also
# Escape) and, quiet on the left, Don't save. Returns what a click hits; it
# covers the whole window.
function draw bim unsaved dialog titled {a string:documentTitle} across {a 64 bit floating-point number:width} by {a 64 bit floating-point number:height} pointing at {a 64 bit floating-point number:px} and {a 64 bit floating-point number:py} using {bim text atlas record:atlas} in {graphics frame:frame}:
    execute:
        set scheme to the bim ui palette
        veil bim window width by height in frame
        set struck to a bim screen hit sending (-1)
        set boxWidth to 420.0
        set boxHeight to 172.0
        set boxLeft to the maximum of 8.0 and (the floor of ((width - boxWidth) * 0.5))
        set boxTop to the maximum of 8.0 and (the floor of ((height - boxHeight) * 0.5))
        draw bim ui box boxLeft boxTop boxWidth boxHeight radius 10.0 painted scheme's raised edged scheme's border wide 1.0 in frame
        draw bim ui text (the string form of "Save changes?") at (boxLeft + 20.0) and (boxTop + 34.0) in face (bim text heading) with atlas painted scheme's ink in frame
        if draw bim close mark at ((boxLeft + boxWidth) - 40.0) and (boxTop + 12.0) pointing at px and py in frame:
            set struck to a bim screen hit sending 2179
        set shownTitle to the bim fitted form of documentTitle in 220.0 pixels of face (bim text small) with atlas
        set message to ((the string form of "\"") + shownTitle) + (the string form of "\" has changes that are not saved.")
        draw bim ui text message at (boxLeft + 20.0) and (boxTop + 70.0) in face (bim text small) with atlas painted scheme's ink in frame
        draw bim ui text (the string form of "Save them before you go on?") at (boxLeft + 20.0) and (boxTop + 90.0) in face (bim text small) with atlas painted scheme's inkSecondary in frame
        set buttonTop to (boxTop + boxHeight) - 48.0
        set quietText to the string form of "Don't save"
        set quietWidth to the bim style button width of quietText with atlas
        if draw bim style button quietText kind 2 at (boxLeft + 12.0) and buttonTop wide quietWidth pointing at px and py using atlas in frame:
            set struck to a bim screen hit sending 2178
        set saveText to the string form of "Save"
        set saveWidth to the bim style button width of saveText with atlas
        set saveLeft to ((boxLeft + boxWidth) - 20.0) - saveWidth
        if draw bim style button saveText kind 0 at saveLeft and buttonTop wide saveWidth pointing at px and py using atlas in frame:
            set struck to a bim screen hit sending 2177
        set cancelText to the string form of "Cancel"
        set cancelWidth to the bim style button width of cancelText with atlas
        if draw bim style button cancelText kind 1 at ((saveLeft - 8.0) - cancelWidth) and buttonTop wide cancelWidth pointing at px and py using atlas in frame:
            set struck to a bim screen hit sending 2179
        return struck
