# SPDX-License-Identifier: MPL-2.0
# The grid plus popup (#59) always accepts millimetres, independently of the
# project's display unit. Its complete batch is one atomic editor undo step.
import ui/editor/bim_editor.dl
import pattern/grids/bim_grid_pattern.dl

function bim grid spacing popup unit:
    replacement:
        bim millimetre unit

function add bim grids from spacing popup for {a 64 bit integer:sourceId} toward {a 64 bit floating-point number:sideSign} using {a string:patternText} in {a pointer to a bim editor record:editTarget}:
    execute:
        set proposedModel to the bim snapshot of editTarget's documentValue's current
        set added to add bim grid copies of sourceId toward side sideSign spaced patternText metres per unit (the bim metres per (bim grid spacing popup unit)) in (the address of proposedModel)
        if added <= 0:
            return 0
        begin bim transaction in (the address of (editTarget's documentValue))
        set editTarget's documentValue's current to proposedModel
        commit bim transaction in (the address of (editTarget's documentValue))
        return added
