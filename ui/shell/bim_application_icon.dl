# GLFW copies the RGBA pixels when setting the window icon.
# https://www.glfw.org/docs/3.3/group__window.html
import viewer/vulkan/graphics.dl

class:
    patterns:
        [a|] bim window icon image
    members:
        width as a 32 bit integer
        height as a 32 bit integer
        pixels as a pointer

function prepare bim application identity:
    execute:
        if (@intrinsic("call", "glfw", "glfwInit", an integer)) != 0:
            @intrinsic("call", "glfw", "glfwWindowHintString", nothing, 147457, "open-bim-studio")
            @intrinsic("call", "glfw", "glfwWindowHintString", nothing, 147458, "open-bim-studio")

function set bim application icon from {a string:path} on {pointer:windowValue}:
    execute:
        set handle to @intrinsic("call", "libc", "fopen", a pointer to a byte, the data of path, "rb")
        if handle = (0 as a pointer to a byte):
            return false
        # Fixed-size shipped asset: 48 by 48, four unpremultiplied channels.
        set pixels to a new string buffer containing 9216 bytes
        set got to @intrinsic("call", "libc", "fread", a word sized integer, the data of pixels, 1 as a word sized integer, 9216 as a word sized integer, handle)
        ignore @intrinsic("call", "libc", "fclose", integer, handle)
        if got != (9216 as a word sized integer):
            return false
        set iconValue to @intrinsic("construct", a bim window icon image, 48 as a 32 bit integer, 48 as a 32 bit integer, (the data of pixels) as a pointer)
        set context to the gpu context of windowValue
        @intrinsic("call", "glfw", "glfwSetWindowIcon", nothing, context's window, 1, the address of iconValue)
        return true
