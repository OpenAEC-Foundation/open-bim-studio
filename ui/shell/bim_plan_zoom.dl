# SPDX-License-Identifier: MPL-2.0
# Camera motion replays one retained vector drawing, including after input
# stops. The short settling deadline only keeps the event loop awake;
# document/view keys, rather than the camera scale, invalidate the content.
import lib/std.dl

class:
    patterns:
        [a|] bim plan zoom record
    members:
        recordedScale as a 64 bit floating-point number
        latestScale as a 64 bit floating-point number
        settleAt as a 64 bit integer

function a bim plan zoom starting at {a 64 bit floating-point number:scaleValue}:
    execute:
        return @intrinsic("construct", a bim plan zoom record, scaleValue, scaleValue, 0 as a 64 bit integer)

function the bim plan zoom {bim plan zoom record:previous} following {a 64 bit floating-point number:scaleValue} at {a 64 bit integer:now}:
    execute:
        set result to previous
        if scaleValue != previous's latestScale:
            set result's latestScale to scaleValue
            set result's settleAt to now + (150000 as a 64 bit integer)
        return result

function the bim plan recording scale of {bim plan zoom record:state} at {a 64 bit integer:now}:
    execute:
        return state's recordedScale

function the bim plan replay offset of {a 64 bit floating-point number:currentOrigin} from {a 64 bit floating-point number:recordedOrigin} scaled by {a 64 bit floating-point number:factor}:
    execute:
        return currentOrigin - (recordedOrigin * factor)
