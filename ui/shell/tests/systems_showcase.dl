# SPDX-License-Identifier: MPL-2.0
import ui/shell/bim_systems_showcase.dl
import exchange/ifcx/bim_file.dl
set modelValue to the bim systems showcase
set reread to the bim model parsed from (the bim file text of modelValue)
set valid to reread's valid
if ((the length of modelValue's levels's values) != 4) or ((the length of modelValue's stairs's values) != 3):
    set valid to false
if ((the length of modelValue's curtains's values) != 22) or ((the length of modelValue's components's values) != 23):
    set valid to false
set corners to 0
loop cursor from 0 to the length of modelValue's instances's values:
    set instance to the item at cursor in modelValue's instances's values
    if (the bim property value (the string form of "ObjectRole") of set (the string form of "OpenAEC_Masonry") of instance's id in modelValue) = (the string form of "MasonryCorner"):
        set corners to corners + 1
if corners != 14:
    set valid to false
if reread's valid:
    if (the length of reread's modelValue's instances's values) != (the length of modelValue's instances's values):
        set valid to false
if valid = false:
    print "FAIL: mixed systems showcase identity" as a line
    @intrinsic("call", "libc", "exit", nothing, 1)
print "PASS: four storeys, three stairs, 22 systems and 14 separate masonry corner objects" as a line
print "PASS: native round trip preserves all showcase component placements" as a line
