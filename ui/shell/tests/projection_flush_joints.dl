# SPDX-License-Identifier: MPL-2.0
# Flush faces draw no joint in an elevation (drawing quality plan, item 15;
# docs/notes/section-projection.md, *Flush edges*).
#
# A house 8 by 6 m of cavity walls (100 mm brick, 120 mm insulation, 100 mm
# sand-lime), with an interior wall meeting the south and north walls at a
# T (x 4), and in the south wall, as on the FZK-Haus, a window 2000 by 1200
# on an 800 sill, one 1000 by 1000 on the same sill, a door 1010 by 2010 and
# a window 2000 by 1200 on a 950 sill. The fast wall's outer face is
# triangulated with T-vertices: a triangle below the first two windows has
# one side from the first window's sill corner to the second's, along the
# first window's sill, where the triangles above the sill line meet it in
# two pieces. Before, that side was taken as an open border and drew a line
# between the windows at sill height. In the south elevation (drawing x is
# model x + 1) the wall draws its outline and the openings, and nothing
# between them at sill or head height.
#
# A section across the house looking south sees the south wall's inner
# face, which the interior wall meets at a T; between the openings and
# beside the T that face draws nothing either.
#
# A first floor of the same walls stacked flush on it draws no joint at the
# floor (3 m) across the facade; nor does one whose walls have the same
# brick outside and a timber frame inside (the faces' finish is the outer
# layer's material); a first floor whose walls are rendered outside keeps
# the joint, the whole width of the facade; so do one of the same walls set
# back 3 mm, and one turned a little (its east end 40 mm further north),
# which do not lie in the ground floor's plane.
import ui/shell/bim_app_parts.dl

function check joint {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
        else:
            print ((the string form of "PASS: ") + label) as a line

function the joint millimetre text of {a 64 bit floating-point number:metres}:
    execute:
        return the string form of ((the rounded value of (metres * 1000.0)) as an integer)

# Prints each edge of element `elementId`, its ends in millimetres.
function print joint edges of element {a 64 bit integer:elementId} in {a pointer to a list:edges}:
    execute:
        loop cursor from 0 to the length of edges:
            set edge to the item at cursor in edges
            if edge's elementId = elementId:
                set fromText to ((the joint millimetre text of edge's start's x) + (the string form of ",")) + (the joint millimetre text of edge's start's y)
                set toText to ((the joint millimetre text of edge's finish's x) + (the string form of ",")) + (the joint millimetre text of edge's finish's y)
                print ((the string form of "    ") + ((fromText + (the string form of " - ")) + toText)) as a line

# How much of the horizontal stretch at height `lineHeight` from `fromX` to
# `toX` the edges lying on it cover together, in millimetres (coincident
# edges counted once).
function the joint cover of {a pointer to a list:edges} at {a 64 bit floating-point number:lineHeight} from {a 64 bit floating-point number:fromX} to {a 64 bit floating-point number:toX}:
    execute:
        set starts to an empty list of a 64 bit floating-point number
        set ends to an empty list of a 64 bit floating-point number
        loop cursor from 0 to the length of edges:
            set edge to the item at cursor in edges
            if ((the absolute value of (edge's start's y - lineHeight)) < 0.0001) and ((the absolute value of (edge's finish's y - lineHeight)) < 0.0001):
                set lowX to the maximum of fromX and (the minimum of edge's start's x and edge's finish's x)
                set highX to the minimum of toX and (the maximum of edge's start's x and edge's finish's x)
                if highX > lowX:
                    set slot to the length of starts
                    append lowX to starts
                    append highX to ends
                    set shifting to true
                    loop while shifting:
                        if slot = 0:
                            set shifting to false
                        else if (the item at (slot - 1) in starts) > lowX:
                            replace item at index slot in starts with (the item at (slot - 1) in starts)
                            replace item at index slot in ends with (the item at (slot - 1) in ends)
                            set slot to slot - 1
                        else:
                            set shifting to false
                    replace item at index slot in starts with lowX
                    replace item at index slot in ends with highX
        set covered to 0.0
        set reach to fromX
        loop cursor from 0 to the length of starts:
            set pieceStart to the maximum of reach and (the item at cursor in starts)
            set pieceEnd to the item at cursor in ends
            if pieceEnd > pieceStart:
                set covered to covered + (pieceEnd - pieceStart)
            set reach to the maximum of reach and pieceEnd
        free starts
        free ends
        return (the rounded value of (covered * 1000.0)) as an integer

# A cavity wall type, 320 mm: `outerMaterial` 100 mm outside, 120 mm
# insulation, `innerMaterial` 100 mm inside.
function the joint wall type of {a string:outerMaterial} and {a string:innerMaterial} named {a string:typeName} in {a pointer to a bim model record:target}:
    execute:
        set layerValues to an empty list of a bim layer record
        append (@intrinsic("construct", a bim layer record, outerMaterial, 0.1)) to layerValues
        append (@intrinsic("construct", a bim layer record, the string form of "insulation", 0.12)) to layerValues
        append (@intrinsic("construct", a bim layer record, innerMaterial, 0.1)) to layerValues
        set made to add bim wall type named typeName with layerValues to target
        free layerValues
        return made

# Four walls of type `typeId` around 8 by 6 m on storey `levelId`,
# anticlockwise (exterior outside); the south wall's id.
function add joint box typed {a 64 bit integer:typeId} on {a 64 bit integer:levelId} to {a pointer to a bim model record:target}:
    execute:
        set southId to add bim wall typed typeId on levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 8.0 and y 0.0) to target
        ignore add bim wall typed typeId on levelId from (a cad vector2 with x 8.0 and y 0.0) to (a cad vector2 with x 8.0 and y 6.0) to target
        ignore add bim wall typed typeId on levelId from (a cad vector2 with x 8.0 and y 6.0) to (a cad vector2 with x 0.0 and y 6.0) to target
        ignore add bim wall typed typeId on levelId from (a cad vector2 with x 0.0 and y 6.0) to (a cad vector2 with x 0.0 and y 0.0) to target
        return southId

# The south elevation's edges of `homeEditor`.
function the joint south edges of {bim editor record:homeEditor} among {a pointer to a list:scene}:
    execute:
        set southId to the bim refused id
        loop cursor from 0 to the length of (homeEditor's documentValue's current's views's values):
            set viewValue to the item at cursor in (homeEditor's documentValue's current's views's values)
            if (bim view viewValue is an elevation) and (viewValue's detail = (3 as a 64 bit integer)):
                set southId to viewValue's id
        set southView to the item at (the bim view index of southId in homeEditor's documentValue's current)'s position in (homeEditor's documentValue's current's views's values)
        return the bim elevation projection of homeEditor among scene for southView

# The ground floor of the house on `groundLevel` of `homeTarget`: its walls
# of type "Cavity 320", the interior wall at the T and the south wall's
# openings; the wall type's id.
function add joint ground floor on {a 64 bit integer:groundLevel} to {a pointer to a bim model record:homeTarget}:
    execute:
        set groundType to the joint wall type of (the string form of "brick") and (the string form of "sand-lime") named (the string form of "Cavity 320") in homeTarget
        set southWall to add joint box typed groundType on groundLevel to homeTarget
        ignore add bim wall typed groundType on groundLevel from (a cad vector2 with x 4.0 and y 0.0) to (a cad vector2 with x 4.0 and y 6.0) to homeTarget
        set wideType to add bim opening type named (the string form of "Window 2000") sized 2.0 by 1.2 with sill 0.8 and frame 0.05 to homeTarget
        set highType to add bim opening type named (the string form of "Window 2000 B950") sized 2.0 by 1.2 with sill 0.95 and frame 0.05 to homeTarget
        set smallType to add bim opening type named (the string form of "Window 1000") sized 1.0 by 1.0 with sill 0.8 and frame 0.05 to homeTarget
        set doorType to add bim opening type named (the string form of "Door 1010") sized 1.01 by 2.01 with sill 0.0 and frame 0.05 to homeTarget
        ignore add bim opening typed wideType in southWall at 1.3 to homeTarget
        ignore add bim opening typed smallType in southWall at 3.3 to homeTarget
        ignore add bim opening typed doorType in southWall at 4.9 to homeTarget
        ignore add bim opening typed highType in southWall at 6.6 to homeTarget
        return groundType

# The house with, when `upperOuter` is not empty, a first floor of walls
# with `upperOuter` outside and `upperInner` inside stacked on it.
function the joint building with first floor of {a string:upperOuter} and {a string:upperInner}:
    execute:
        set homeEditor to a new bim editor
        set homeTarget to the address of (homeEditor's documentValue's current)
        set groundType to add joint ground floor on homeEditor's levelId to homeTarget
        if upperOuter != (the string form of ""):
            set upperLevel to add bim level named (the string form of "First floor") at 3.0 with height 3.0 to homeTarget
            set upperType to groundType
            if (upperOuter != (the string form of "brick")) or (upperInner != (the string form of "sand-lime")):
                set upperType to the joint wall type of upperOuter and upperInner named (the string form of "Upper 320") in homeTarget
            ignore add joint box typed upperType on upperLevel to homeTarget
        set madeViews to ensure bim default views in homeTarget
        free madeViews
        refresh bim editor (the address of homeEditor)
        return homeEditor

# The house with a first floor of the same walls whose south wall stands
# `setBack` north of the ground floor's and whose east end lies `turnBy`
# further north still, the rest of its box following.
function the joint building with a first floor set back {a 64 bit floating-point number:setBack} and turned {a 64 bit floating-point number:turnBy}:
    execute:
        set homeEditor to a new bim editor
        set homeTarget to the address of (homeEditor's documentValue's current)
        set groundType to add joint ground floor on homeEditor's levelId to homeTarget
        set upperLevel to add bim level named (the string form of "First floor") at 3.0 with height 3.0 to homeTarget
        ignore add bim wall typed groundType on upperLevel from (a cad vector2 with x 0.0 and y setBack) to (a cad vector2 with x 8.0 and y (setBack + turnBy)) to homeTarget
        ignore add bim wall typed groundType on upperLevel from (a cad vector2 with x 8.0 and y (setBack + turnBy)) to (a cad vector2 with x 8.0 and y 6.0) to homeTarget
        ignore add bim wall typed groundType on upperLevel from (a cad vector2 with x 8.0 and y 6.0) to (a cad vector2 with x 0.0 and y 6.0) to homeTarget
        ignore add bim wall typed groundType on upperLevel from (a cad vector2 with x 0.0 and y 6.0) to (a cad vector2 with x 0.0 and y setBack) to homeTarget
        set madeViews to ensure bim default views in homeTarget
        free madeViews
        refresh bim editor (the address of homeEditor)
        return homeEditor

# How many of `edges` have their middle strictly inside the drawing's
# rectangle from (`lowX`, `lowY`) to (`highX`, `highY`).
function the joint edges among {a pointer to a list:edges} inside {a 64 bit floating-point number:lowX} by {a 64 bit floating-point number:lowY} until {a 64 bit floating-point number:highX} by {a 64 bit floating-point number:highY}:
    execute:
        set found to 0
        loop cursor from 0 to the length of edges:
            set edge to the item at cursor in edges
            set middleX to (edge's start's x + edge's finish's x) / 2.0
            set middleY to (edge's start's y + edge's finish's y) / 2.0
            if ((middleX > lowX) and (middleX < highX)) and ((middleY > lowY) and (middleY < highY)):
                set found to found + 1
        return found

# What the edges on the sill and head heights of the openings (0.8, 0.95,
# 1.85, 2.05, 2.06 and 2.2 m) cover from `fromX` to `toX`, in millimetres.
function the joint opening line cover of {a pointer to a list:edges} from {a 64 bit floating-point number:fromX} to {a 64 bit floating-point number:toX}:
    execute:
        set covered to (the joint cover of edges at 0.8 from fromX to toX) + (the joint cover of edges at 0.95 from fromX to toX)
        set covered to covered + ((the joint cover of edges at 1.85 from fromX to toX) + (the joint cover of edges at 2.05 from fromX to toX))
        set covered to covered + ((the joint cover of edges at 2.06 from fromX to toX) + (the joint cover of edges at 2.2 from fromX to toX))
        return covered

set scene to an empty list of a bim scene mesh record

# ------------------------------------------- (a) openings and a T-junction
set oneStorey to the joint building with first floor of (the string form of "") and (the string form of "")
set southWall to (the item at 0 in (oneStorey's documentValue's current's walls's values))'s id
set oneEdges to the joint south edges of oneStorey among scene
set facade to oneEdges's values
print (the string form of "south wall's edges:") as a line
print joint edges of element southWall in facade
check joint ((the joint cover of facade at 0.8 from 3.35 to 3.75) = 0) named (the string form of "no line between the two windows at sill height")
check joint ((the joint cover of facade at 0.8 from 4.85 to 5.345) = 0) named (the string form of "nor between the small window and the door")
check joint ((the joint cover of facade at 1.85 from 4.85 to 5.345) = 0) named (the string form of "nor at the small window's head")
check joint ((the joint cover of facade at 0.95 from 6.455 to 6.55) = 0) named (the string form of "nor between the door and the last window")
check joint ((the joint cover of facade at 0.8 from 1.25 to 3.35) = 2100) named (the string form of "the first window's sill is drawn")
check joint ((the joint cover of facade at 0.8 from 3.75 to 4.85) = 1100) named (the string form of "and the small window's")
check joint ((the joint cover of facade at 0.95 from 6.55 to 8.65) = 2100) named (the string form of "and the last window's")
check joint ((the joint cover of facade at 2.05 from 1.25 to 3.35) = 2100) named (the string form of "the first window's head")
check joint ((the joint cover of facade at 2.06 from 5.345 to 6.455) = 1110) named (the string form of "the door's head")
check joint ((the joint cover of facade at 0.0 from 0.84 to 9.16) = 8320) named (the string form of "the facade's foot runs its whole width")
check joint ((the joint cover of facade at 3.0 from 0.84 to 9.16) = 8320) named (the string form of "and its top")

# ------------------------------------------- (a) the T-junction from inside
# A section across the house at y 3 looking south (its line from x 9 to
# x -1; drawing x is 9 - x): it cuts the interior wall, whose part beyond
# the cut meets the south wall's inner face at a T (x 3.84 to 4.16, drawing
# x 4.84 to 5.16), and sees that face with the openings in it: the first
# window at drawing x 6.65 to 8.75, the small one 5.15 to 6.25, the door
# 3.545 to 4.655, the last window 1.35 to 3.45, the east wall's inner face
# at 1.16.
set insideTarget to the address of (oneStorey's documentValue's current)
set insideId to add bim section view from (a cad vector2 with x 9.0 and y 3.0) to (a cad vector2 with x -1.0 and y 3.0) to insideTarget
refresh bim editor (the address of oneStorey)
set insideView to the item at (the bim view index of insideId in oneStorey's documentValue's current)'s position in (oneStorey's documentValue's current's views's values)
set insideCut to the bim section of (oneStorey's evaluation) from (insideView's lineStart) to (insideView's lineFinish)
set insideEdges to the bim section projection of oneStorey among scene for insideView cut as insideCut
set innerFace to insideEdges's values
print (the string form of "south wall's edges seen from inside:") as a line
print joint edges of element southWall in innerFace
check joint ((the joint edges among innerFace inside 6.26 by 0.01 until 6.64 by 2.99) = 0) named (the string form of "inside, nothing between the first and the small window")
check joint ((the joint edges among innerFace inside 4.665 by 0.01 until 4.83 by 2.99) = 0) named (the string form of "nor between the T and the door")
check joint ((the joint edges among innerFace inside 3.46 by 0.01 until 3.535 by 2.99) = 0) named (the string form of "nor between the door and the last window")
check joint ((the joint edges among innerFace inside 1.17 by 0.01 until 1.34 by 2.99) = 0) named (the string form of "nor between the last window and the east wall")
check joint ((the joint opening line cover of innerFace from 6.25 to 6.65) = 0) named (the string form of "no sill or head line runs on between the first and the small window")
check joint ((the joint opening line cover of innerFace from 4.655 to 4.84) = 0) named (the string form of "nor between the door and the T")
check joint ((the joint opening line cover of innerFace from 3.45 to 3.545) = 0) named (the string form of "nor between the last window and the door")
check joint ((the joint opening line cover of innerFace from 1.16 to 1.35) = 0) named (the string form of "nor beyond the last window")
check joint ((the joint cover of innerFace at 0.8 from 6.65 to 8.75) = 2100) named (the string form of "inside, the first window's sill is drawn")
check joint ((the joint cover of innerFace at 0.95 from 1.35 to 3.45) = 2100) named (the string form of "and the last window's")

# ------------------------------------------- (b) the same walls stacked flush
set sameStack to the joint building with first floor of (the string form of "brick") and (the string form of "sand-lime")
set sameEdges to the joint south edges of sameStack among scene
print ((the string form of "same walls, joint at 3 m (mm): ") + (the string form of (the joint cover of (sameEdges's values) at 3.0 from 0.84 to 9.16))) as a line
check joint ((the joint cover of (sameEdges's values) at 3.0 from 0.84 to 9.16) = 0) named (the string form of "no joint at the floor between flush walls of one type")
check joint ((the joint cover of (sameEdges's values) at 6.0 from 0.84 to 9.16) = 8320) named (the string form of "the facade's top is drawn")
check joint ((the joint cover of (sameEdges's values) at 0.8 from 3.35 to 3.75) = 0) named (the string form of "still no line between the windows")
set timberStack to the joint building with first floor of (the string form of "brick") and (the string form of "timber")
set timberEdges to the joint south edges of timberStack among scene
check joint ((the joint cover of (timberEdges's values) at 3.0 from 0.84 to 9.16) = 0) named (the string form of "nor between walls of the same brick outside and another inner leaf")

# ------------------------------------------- (c) render on brick
set otherStack to the joint building with first floor of (the string form of "render") and (the string form of "sand-lime")
set otherEdges to the joint south edges of otherStack among scene
print ((the string form of "render on brick, joint at 3 m (mm): ") + (the string form of (the joint cover of (otherEdges's values) at 3.0 from 0.84 to 9.16))) as a line
check joint ((the joint cover of (otherEdges's values) at 3.0 from 0.84 to 9.16) = 8320) named (the string form of "a joint the whole width between brick and render")

# ------------------------------------------- (c) faces out of plane keep it
set backStack to the joint building with a first floor set back 0.003 and turned 0.0
set backEdges to the joint south edges of backStack among scene
print ((the string form of "set back 3 mm, joint at 3 m (mm): ") + (the string form of (the joint cover of (backEdges's values) at 3.0 from 0.84 to 9.16))) as a line
check joint ((the joint cover of (backEdges's values) at 3.0 from 0.84 to 9.16) = 8320) named (the string form of "a joint the whole width under walls of one type set back 3 mm")
set turnedStack to the joint building with a first floor set back 0.0 and turned 0.04
set turnedEdges to the joint south edges of turnedStack among scene
print ((the string form of "turned 40 mm, joint at 3 m (mm): ") + (the string form of (the joint cover of (turnedEdges's values) at 3.0 from 0.84 to 9.16))) as a line
check joint ((the joint cover of (turnedEdges's values) at 3.0 from 0.84 to 9.16) = 8320) named (the string form of "a joint the whole width under walls of one type turned a little")
