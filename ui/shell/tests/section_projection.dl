# SPDX-License-Identifier: MPL-2.0
# Sections and elevations draw what lies beyond their plane (drawing quality
# plan, item 15): the visible edges of the model seen square onto the plane,
# hidden where something stands in front.
#
# A section across a room of four 200 mm walls (6 by 4 m) looks at the back
# wall: beyond the cut of the side walls it draws the back wall's top and
# foot, the window's rough opening in it and the inner outline of the
# window's 50 mm frame; a low wall standing in front hides what lies behind
# it; nothing of the wall behind the section line is drawn; a view depth
# short of the back wall leaves it out, and hiding the windows' category
# leaves out the frame but not the opening in the wall.
#
# The south elevation of a two-storey box (8 by 6 m, storeys of 3 m) with a
# window in its ground floor draws both storeys' south walls, the window, and
# nothing of the north walls behind them; on a sheet it is 100 by 80 mm at
# 1:100, black, with a ground line at peil and its levels named.
import ui/shell/bim_app_parts.dl

function check projection {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
        else:
            print ((the string form of "PASS: ") + label) as a line

function projection {a 64 bit floating-point number:value} is near {a 64 bit floating-point number:wanted}:
    execute:
        return (the absolute value of (value - wanted)) < 0.001

# How many of `edges` belong to element `elementId`.
function the projection count of element {a 64 bit integer:elementId} in {a pointer to a list:edges}:
    execute:
        set total to 0
        loop cursor from 0 to the length of edges:
            if (the item at cursor in edges)'s elementId = elementId:
                set total to total + 1
        return total

# The edges of element `elementId` among `edges`.
function the projection edges of element {a 64 bit integer:elementId} in {a pointer to a list:edges}:
    execute:
        set chosen to an empty list of a bim projected edge record
        loop cursor from 0 to the length of edges:
            if (the item at cursor in edges)'s elementId = elementId:
                append (the item at cursor in edges) to chosen
        return chosen

# How much of the segment from (`ax`, `ay`) to (`bx`, `by`) the edges lying
# on it cover together, in metres (overlapping edges counted once).
function the projection cover of {a pointer to a list:edges} from {a 64 bit floating-point number:ax} {a 64 bit floating-point number:ay} to {a 64 bit floating-point number:bx} {a 64 bit floating-point number:by}:
    execute:
        set runX to bx - ax
        set runY to by - ay
        set runLength to the square root of ((runX * runX) + (runY * runY))
        set unitX to runX / runLength
        set unitY to runY / runLength
        set starts to an empty list of a 64 bit floating-point number
        set ends to an empty list of a 64 bit floating-point number
        loop cursor from 0 to the length of edges:
            set edge to the item at cursor in edges
            set startOff to ((edge's start's x - ax) * (0.0 - unitY)) + ((edge's start's y - ay) * unitX)
            set finishOff to ((edge's finish's x - ax) * (0.0 - unitY)) + ((edge's finish's y - ay) * unitX)
            if ((the absolute value of startOff) < 0.0001) and ((the absolute value of finishOff) < 0.0001):
                set startAlong to ((edge's start's x - ax) * unitX) + ((edge's start's y - ay) * unitY)
                set finishAlong to ((edge's finish's x - ax) * unitX) + ((edge's finish's y - ay) * unitY)
                set lowAlong to the maximum of 0.0 and (the minimum of startAlong and finishAlong)
                set highAlong to the minimum of runLength and (the maximum of startAlong and finishAlong)
                if highAlong > lowAlong:
                    set slot to the length of starts
                    append lowAlong to starts
                    append highAlong to ends
                    set shifting to true
                    loop while shifting:
                        if slot = 0:
                            set shifting to false
                        else if (the item at (slot - 1) in starts) > lowAlong:
                            replace item at index slot in starts with (the item at (slot - 1) in starts)
                            replace item at index slot in ends with (the item at (slot - 1) in ends)
                            set slot to slot - 1
                        else:
                            set shifting to false
                    replace item at index slot in starts with lowAlong
                    replace item at index slot in ends with highAlong
        set covered to 0.0
        set reach to 0.0
        loop cursor from 0 to the length of starts:
            set pieceStart to the maximum of reach and (the item at cursor in starts)
            set pieceEnd to the item at cursor in ends
            if pieceEnd > pieceStart:
                set covered to covered + (pieceEnd - pieceStart)
            set reach to the maximum of reach and pieceEnd
        free starts
        free ends
        return covered

# The cover in millimetres, for printing.
function the projection millimetres of {a pointer to a list:edges} from {a 64 bit floating-point number:ax} {a 64 bit floating-point number:ay} to {a 64 bit floating-point number:bx} {a 64 bit floating-point number:by}:
    execute:
        return (the rounded value of ((the projection cover of edges from ax ay to bx by) * 1000.0)) as an integer

function the projection millimetre text of {a 64 bit floating-point number:metres}:
    execute:
        return the string form of ((the rounded value of (metres * 1000.0)) as an integer)

# Prints each edge of element `elementId`, its ends in millimetres.
function print projection edges of element {a 64 bit integer:elementId} in {a pointer to a list:edges}:
    execute:
        loop cursor from 0 to the length of edges:
            set edge to the item at cursor in edges
            if edge's elementId = elementId:
                set fromText to ((the projection millimetre text of edge's start's x) + (the string form of ",")) + (the projection millimetre text of edge's start's y)
                set toText to ((the projection millimetre text of edge's finish's x) + (the string form of ",")) + (the projection millimetre text of edge's finish's y)
                print ((the string form of "    ") + ((fromText + (the string form of " - ")) + toText)) as a line

# Checks that the edges cover `wanted` metres of the segment, saying how
# many millimetres they cover when they do not.
function check projection cover of {a pointer to a list:edges} from {a 64 bit floating-point number:ax} {a 64 bit floating-point number:ay} to {a 64 bit floating-point number:bx} {a 64 bit floating-point number:by} near {a 64 bit floating-point number:wanted} named {a string:label}:
    execute:
        set measured to the projection cover of edges from ax ay to bx by
        if projection measured is near wanted:
            print ((the string form of "PASS: ") + label) as a line
        else:
            print ((the string form of "FAIL: ") + (label + ((the string form of " (covers mm: ") + ((the string form of ((the rounded value of (measured * 1000.0)) as an integer)) + (the string form of ")"))))) as a line

# The lowest and highest point of the edges of element `elementId`.
function the projection bounds of element {a 64 bit integer:elementId} in {a pointer to a list:edges}:
    execute:
        set low to a cad vector2 with x 1e300 and y 1e300
        set high to a cad vector2 with x -1e300 and y -1e300
        loop cursor from 0 to the length of edges:
            set edge to the item at cursor in edges
            if edge's elementId = elementId:
                set low to a cad vector2 with x (the minimum of low's x and (the minimum of edge's start's x and edge's finish's x)) and y (the minimum of low's y and (the minimum of edge's start's y and edge's finish's y))
                set high to a cad vector2 with x (the maximum of high's x and (the maximum of edge's start's x and edge's finish's x)) and y (the maximum of high's y and (the maximum of edge's start's y and edge's finish's y))
        return @intrinsic("construct", a bim sheet frame record, high's x >= low's x, low, high)

function the projection view {a 64 bit integer:viewId} in {bim model record:modelValue}:
    execute:
        return the item at (the bim view index of viewId in modelValue)'s position in (modelValue's views's values)

# How many texts on `canvas` read `wanted`.
function the projection count of text {a string:wanted} on {bim canvas record:canvas}:
    execute:
        set found to 0
        loop cursor from 0 to the length of (canvas's texts's values):
            if (the item at cursor in (canvas's texts's values))'s message = wanted:
                set found to found + 1
        return found

set scene to an empty list of a bim scene mesh record
set emptyAtlas to @intrinsic("construct", a bim text atlas record, @intrinsic("construct", a graphics texture, 0 as a pointer to a byte, 0, 0), an empty list of a bim text face record, 0, 0, an empty list of a bim icon cell record, an empty bim message catalogue, an empty list of a pointer, -1)

# ------------------------------------------------------------ the section
set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set ground to editor's levelId
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to layerValues
set brickType to add bim wall type named (the string form of "Brick 200") with layerValues to target
free layerValues
# Anticlockwise, the exterior outside.
set frontWall to add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set rightWall to add bim wall typed brickType on ground from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 6.0 and y 4.0) to target
set backWall to add bim wall typed brickType on ground from (a cad vector2 with x 6.0 and y 4.0) to (a cad vector2 with x 0.0 and y 4.0) to target
set leftWall to add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 4.0) to (a cad vector2 with x 0.0 and y 0.0) to target
# 1200 by 1500 on a 900 sill with a 50 mm frame, in the middle of the back
# wall: its rough opening from x 2.35 to 3.65 and z 0.9 to 2.45, the
# frame's inside from x 2.40 to 3.60 and z 0.95 to 2.40.
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
set windowId to add bim opening typed windowType in backWall at 3.0 to target
# A low wall 1.5 m high in front of the window's left part, x 2 to 3 at
# y 3 (its face toward the section at y 2.9).
set lowWall to add bim wall typed brickType on ground from (a cad vector2 with x 2.0 and y 3.0) to (a cad vector2 with x 3.0 and y 3.0) to target
ignore (set bim wall lowWall height to 1.5 in target)
# The section across the room at y 2 looking at the back wall (to the
# line's left): drawing x is x + 1, drawing y is height.
set sectionId to add bim section view from (a cad vector2 with x -1.0 and y 2.0) to (a cad vector2 with x 7.0 and y 2.0) to target
refresh bim editor (the address of editor)
set sectionView to the projection view sectionId in editor's documentValue's current
set sectionCut to the bim section of (editor's evaluation) from (sectionView's lineStart) to (sectionView's lineFinish)
set sectionEdges to the bim section projection of editor among scene for sectionView cut as sectionCut
set edges to sectionEdges's values
print (the string form of "section edges:") as a line
print ((the string form of "  window ") + (the string form of (the projection count of element windowId in edges))) as a line
print projection edges of element windowId in edges
print ((the string form of "  low wall ") + (the string form of (the projection count of element lowWall in edges))) as a line
print ((the string form of "  side walls ") + (the string form of ((the projection count of element leftWall in edges) + (the projection count of element rightWall in edges)))) as a line
check projection ((the projection count of element frontWall in edges) = 0) named (the string form of "nothing of the wall behind the section line")
# The back wall's top and foot between the side walls' cuts (x 0.1 to 5.9).
print ((the string form of "back wall top (mm): ") + (the string form of (the projection millimetres of edges from 1.1 3.0 to 6.9 3.0))) as a line
check projection cover of edges from 1.1 3.0 to 6.9 3.0 near 5.8 named (the string form of "the back wall's top runs between the side walls' cuts")
check projection cover of edges from 0.9 3.0 to 1.1 3.0 near 0.0 named (the string form of "and not through the cut")
set backEdges to the projection edges of element backWall in edges
set lowEdges to the projection edges of element lowWall in edges
check projection cover of backEdges from 1.1 0.0 to 6.9 0.0 near 4.8 named (the string form of "its foot, less the metre the low wall hides")
check projection cover of backEdges from 3.0 0.0 to 4.0 0.0 near 0.0 named (the string form of "none of it behind the low wall")
check projection cover of lowEdges from 3.0 0.0 to 4.0 0.0 near 1.0 named (the string form of "where the low wall's own foot is drawn")
# The rough opening: its head whole, its sill and left jamb partly behind
# the low wall (up to drawing x 4 and height 1.5).
check projection cover of edges from 3.35 2.45 to 4.65 2.45 near 1.3 named (the string form of "the opening's head")
check projection cover of edges from 3.35 0.9 to 4.65 0.9 near 0.65 named (the string form of "its sill, right of the low wall")
check projection cover of edges from 4.65 0.9 to 4.65 2.45 near 1.55 named (the string form of "its right jamb")
check projection cover of edges from 3.35 0.9 to 3.35 2.45 near 0.95 named (the string form of "its left jamb above the low wall")
# The frame's inside, 50 mm in from the opening.
check projection cover of edges from 3.4 2.4 to 4.6 2.4 near 1.2 named (the string form of "the frame's inside at its head")
check projection cover of edges from 3.4 0.95 to 4.6 0.95 near 0.6 named (the string form of "and at its bottom rail, right of the low wall")
check projection cover of edges from 4.6 0.95 to 4.6 2.4 near 1.45 named (the string form of "and at its right jamb")
check projection cover of edges from 3.0 1.5 to 4.0 1.5 near 1.0 named (the string form of "the low wall's top")
set windowBounds to the projection bounds of element windowId in edges
check projection ((windowBounds's low's x >= 3.349) and (windowBounds's high's x <= 4.651)) named (the string form of "the frame stays in the opening")
# A view depth of 1.5 m stops short of the back wall (1.9 m beyond).
set shallowView to sectionView
set shallowView's depth to 1.5
set shallowEdges to the bim section projection of editor among scene for shallowView cut as sectionCut
check projection (((the projection count of element backWall in (shallowEdges's values)) = 0) and ((the projection count of element windowId in (shallowEdges's values)) = 0)) named (the string form of "a view depth of 1.5 m leaves out the back wall and its window")
check projection ((the projection count of element lowWall in (shallowEdges's values)) = (the projection count of element lowWall in edges)) named (the string form of "and keeps the low wall")
# Without windows the frame goes, the opening in the wall stays.
set noWindows to the bim rules of view sectionView in editor's documentValue's current
toggle bim category (bim window category) visibility in (the address of noWindows)
set unframedEdges to the bim projected edges of editor among scene in view sectionId under noWindows from (sectionView's lineStart) to (sectionView's lineFinish) within 0.0 behind sectionCut
check projection ((the projection count of element windowId in (unframedEdges's values)) = 0) named (the string form of "hiding windows leaves out the frame")
check projection cover of (unframedEdges's values) from 3.35 2.45 to 4.65 2.45 near 1.3 named (the string form of "but not the opening in the wall")
# On a sheet: the section's projected edges in the visible pen, black.
set sheetId to add bim sheet numbered (the string form of "A-301") named (the string form of "Section") on paper 2 landscape true to target
ignore place bim view sectionId on sheet sheetId at (a cad vector2 with x 200.0 and y 200.0) looking at (the bim model centre of view sectionId in editor's documentValue's current) in target
set sheetValue to the item at (the bim sheet index of sheetId in editor's documentValue's current)'s position in (target's sheets's values)
set sheetCanvas to a new bim canvas
record bim sheet viewport 0 of sheetValue of editor among scene from (a cad vector2 with x 0.0 and y 420.0) at 1.0 using emptyAtlas on (the address of sheetCanvas)
set visibleBatches to 0
loop cursor from 0 to the length of (sheetCanvas's batches's values):
    set recorded to the item at cursor in (sheetCanvas's batches's values)
    if ((recorded's stroked and (projection recorded's breadth is near 0.25)) and ((recorded's red = 0) and (recorded's green = 0))) and ((recorded's blue = 0) and ((the length of (recorded's pixels's values)) = (6 * (the length of edges)))):
        set visibleBatches to visibleBatches + 1
check projection (visibleBatches = 1) named (the string form of "the sheet draws every edge, black in the 0.25 mm pen (a quarter unit at a unit per mm)")

# ------------------------------------------------------------ the elevation
set house to a new bim editor
set houseTarget to the address of (house's documentValue's current)
set houseGround to house's levelId
set houseUpper to add bim level named (the string form of "First floor") at 3.0 with height 3.0 to houseTarget
set houseLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to houseLayers
set houseType to add bim wall type named (the string form of "Brick 200") with houseLayers to houseTarget
free houseLayers
set southGround to add bim wall typed houseType on houseGround from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 8.0 and y 0.0) to houseTarget
ignore add bim wall typed houseType on houseGround from (a cad vector2 with x 8.0 and y 0.0) to (a cad vector2 with x 8.0 and y 6.0) to houseTarget
set northGround to add bim wall typed houseType on houseGround from (a cad vector2 with x 8.0 and y 6.0) to (a cad vector2 with x 0.0 and y 6.0) to houseTarget
ignore add bim wall typed houseType on houseGround from (a cad vector2 with x 0.0 and y 6.0) to (a cad vector2 with x 0.0 and y 0.0) to houseTarget
set southUpper to add bim wall typed houseType on houseUpper from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 8.0 and y 0.0) to houseTarget
ignore add bim wall typed houseType on houseUpper from (a cad vector2 with x 8.0 and y 0.0) to (a cad vector2 with x 8.0 and y 6.0) to houseTarget
set northUpper to add bim wall typed houseType on houseUpper from (a cad vector2 with x 8.0 and y 6.0) to (a cad vector2 with x 0.0 and y 6.0) to houseTarget
ignore add bim wall typed houseType on houseUpper from (a cad vector2 with x 0.0 and y 6.0) to (a cad vector2 with x 0.0 and y 0.0) to houseTarget
# The same window in the middle of the ground floor's south wall: its rough
# opening from x 3.35 to 4.65.
set houseWindowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to houseTarget
set houseWindow to add bim opening typed houseWindowType in southGround at 4.0 to houseTarget
set madeViews to ensure bim default views in houseTarget
free madeViews
refresh bim editor (the address of house)
set southId to the bim refused id
loop cursor from 0 to the length of (house's documentValue's current's views's values):
    set viewValue to the item at cursor in (house's documentValue's current's views's values)
    if (bim view viewValue is an elevation) and (viewValue's detail = (3 as a 64 bit integer)):
        set southId to viewValue's id
set southView to the projection view southId in house's documentValue's current
print ((the string form of "elevation: ") + southView's name) as a line
# Its line runs a metre outside the walls' lines, from x -1 to 9 at y -1,
# looking north: drawing x is x + 1.
set southLine to the bim elevation line of 3 in house's documentValue's current
check projection ((projection southLine's lineStart's x is near -1.0) and (projection southLine's lineFinish's x is near 9.0)) named (the string form of "the south elevation's line runs west to east")
check projection ((projection southLine's lineStart's y is near -1.0) and (projection southLine's lineFinish's y is near -1.0)) named (the string form of "a metre south of the walls")
set southEdges to the bim elevation projection of house among scene for southView
set facade to southEdges's values
print (the string form of "elevation edges:") as a line
print ((the string form of "  window ") + (the string form of (the projection count of element houseWindow in facade))) as a line
print projection edges of element houseWindow in facade
check projection (((the projection count of element northGround in facade) = 0) and ((the projection count of element northUpper in facade) = 0)) named (the string form of "nothing of the north walls behind")
set groundBounds to the projection bounds of element southGround in facade
set upperBounds to the projection bounds of element southUpper in facade
print ((the string form of "ground floor wall from ") + ((the string form of ((the rounded value of (groundBounds's low's x * 1000.0)) as an integer)) + ((the string form of " to ") + (the string form of ((the rounded value of (groundBounds's high's x * 1000.0)) as an integer))))) as a line
check projection ((projection groundBounds's low's y is near 0.0) and (projection groundBounds's high's y is near 3.0)) named (the string form of "the ground floor's wall stands from 0 to 3 m")
check projection ((projection upperBounds's low's y is near 3.0) and (projection upperBounds's high's y is near 6.0)) named (the string form of "the first floor's from 3 to 6 m")
check projection (projection (the projection cover of facade from groundBounds's low's x 6.0 to groundBounds's high's x 6.0) is near (groundBounds's high's x - groundBounds's low's x)) named (the string form of "the top of the facade runs its whole width")
check projection cover of facade from 4.35 0.9 to 5.65 0.9 near 1.3 named (the string form of "the window's opening in the facade")
check projection cover of facade from 4.35 0.9 to 4.35 2.45 near 1.55 named (the string form of "its left jamb")
check projection cover of facade from 4.4 0.95 to 5.6 0.95 near 1.2 named (the string form of "and the frame's inside")
# On a sheet at 1:100: its frame, black edges, the ground line and levels.
set elevationExtent to the bim model extent of view southId in house's documentValue's current
check projection ((projection elevationExtent's low's x is near 0.0) and (projection elevationExtent's high's x is near 10.0)) named (the string form of "the elevation's extent is its line")
check projection ((projection elevationExtent's low's y is near -1.0) and (projection elevationExtent's high's y is near 7.0)) named (the string form of "and its heights with a metre around")
set houseSheet to add bim sheet numbered (the string form of "A-401") named (the string form of "Elevations") on paper 2 landscape true to houseTarget
ignore place bim view southId on sheet houseSheet at (a cad vector2 with x 200.0 and y 200.0) looking at (the bim model centre of view southId in house's documentValue's current) in houseTarget
set houseSheetValue to the item at (the bim sheet index of houseSheet in house's documentValue's current)'s position in (houseTarget's sheets's values)
set elevationFrame to the bim frame of viewport (the item at 0 in (houseSheetValue's viewports's values)) in house's documentValue's current
print ((the string form of "elevation frame (mm): ") + ((the string form of ((elevationFrame's high's x - elevationFrame's low's x) as an integer)) + ((the string form of " by ") + (the string form of ((elevationFrame's high's y - elevationFrame's low's y) as an integer))))) as a line
set elevationCanvas to a new bim canvas
record bim sheet viewport 0 of houseSheetValue of house among scene from (a cad vector2 with x 0.0 and y 420.0) at 1.0 using emptyAtlas on (the address of elevationCanvas)
set edgeBatches to 0
set groundBatches to 0
set allBlack to true
loop cursor from 0 to the length of (elevationCanvas's batches's values):
    set recorded to the item at cursor in (elevationCanvas's batches's values)
    if ((recorded's red != 0) or (recorded's green != 0)) or (recorded's blue != 0):
        if (recorded's red != 255) or ((recorded's green != 255) or (recorded's blue != 255)):
            set allBlack to false
    if (recorded's stroked and (projection recorded's breadth is near 0.25)) and ((the length of (recorded's pixels's values)) = (6 * (the length of facade))):
        set edgeBatches to edgeBatches + 1
    if (recorded's stroked and (projection recorded's breadth is near 0.5)) and ((the length of (recorded's pixels's values)) = 6):
        set groundBatches to groundBatches + 1
check projection allBlack named (the string form of "the elevation is black on the sheet")
check projection (edgeBatches = 1) named (the string form of "every edge in the 0.25 mm pen")
check projection (groundBatches = 1) named (the string form of "its ground line in the 0.5 mm pen")
check projection (((the projection count of text (the string form of "Ground floor") on elevationCanvas) = 1) and ((the projection count of text (the string form of "First floor") on elevationCanvas) = 1)) named (the string form of "its levels named beside it")
check projection ((the projection count of text (the string form of "South  1:100") on elevationCanvas) = 1) named (the string form of "its title under it")
