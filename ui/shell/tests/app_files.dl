# SPDX-License-Identifier: MPL-2.0
# The application's files (bim_app_files.dl), with HOME in a folder of the
# test's own: the settings read back as written (defaults without a file);
# the recent files keep the last used first, once each, at most ten; the two
# templates open as new models with their storeys, types and units; a model
# saved under a name opens again; and the document's title.
import ui/shell/bim_app_files.dl

ignore @intrinsic("call", "libc", "mkdir", integer, "app-files-home", 493)
ignore @intrinsic("call", "libc", "setenv", integer, "HOME", "app-files-home", 1)
ignore (write bim text (the string form of "") to file (the string form of "app-files-home/.config/open-bim-studio/settings.txt"))
ignore (write bim text (the string form of "") to file (the string form of "app-files-home/.config/open-bim-studio/recent.txt"))

set firstSettings to the bim stored app settings
print ((the string form of "defaults: theme ") + ((the string form of (firstSettings's theme)) + ((the string form of ", workspace ") + ((the string form of (firstSettings's workspace)) + ((the string form of ", open last ") + (the string form of (firstSettings's openLast))))))) as a line
set changedSettings to firstSettings
set changedSettings's theme to 0
set changedSettings's workspace to 2
set changedSettings's statusbar to 1
set changedSettings's openLast to true
set changedSettings's units to bim metre unit
print ((the string form of "kept: ") + (the string form of (keep bim app settings changedSettings))) as a line
set readSettings to the bim stored app settings
print ((the string form of "read: theme ") + ((the string form of (readSettings's theme)) + ((the string form of ", workspace ") + ((the string form of (readSettings's workspace)) + ((the string form of ", status bar ") + ((the string form of (readSettings's statusbar)) + ((the string form of ", open last ") + ((the string form of (readSettings's openLast)) + ((the string form of ", units ") + (the bim name of unit (readSettings's units))))))))))) as a line

loop noteCursor from 0 to 12:
    note bim recent file ((the string form of "model-") + ((the string form of noteCursor) + (the string form of ".ifcxb")))
note bim recent file (the string form of "model-5.ifcxb")
set listed to the bim recent files
print ((the string form of "recent: ") + (the string form of (the length of (listed's values)))) as a line
loop listedCursor from 0 to 3:
    set entry to the item at listedCursor in (listed's values)
    print ((the string form of "  ") + (entry's name + ((the string form of ", stamp of ") + (the string form of (the length of entry's stamp))))) as a line
print ((the string form of "slot 1: ") + (the bim base name of (the bim recent path at 1))) as a line
print ((the string form of "slot 10: [") + ((the bim recent path at 10) + (the string form of "]"))) as a line

set offered to the bim model templates
loop templateCursor from 0 to the length of (offered's values):
    set editor to a new bim editor
    make new bim model from template templateCursor in (the address of editor)
    set modelValue to editor's documentValue's current
    set storeyNames to the string form of ""
    loop levelCursor from 0 to the length of (modelValue's levels's values):
        set storeyNames to (storeyNames + (the string form of " | ")) + ((the item at levelCursor in (modelValue's levels's values))'s name)
    print ((the string form of "template ") + ((the string form of templateCursor) + ((the string form of ": ") + editor's message))) as a line
    print ((the string form of "  storeys") + storeyNames) as a line
    print ((the string form of "  units ") + ((the bim name of unit editor's lengthUnit) + ((the string form of ", several wall types ") + ((the string form of ((the length of (modelValue's wallTypes's values)) > 1)) + ((the string form of ", undo ") + (the string form of (the length of (editor's documentValue's undoStack's values)))))))) as a line

set editor to a new bim editor
make new bim model from template 1 in (the address of editor)
ignore (add bim level named (the string form of "Roof") at 6.0 with height 1.0 to (the address of (editor's documentValue's current)))
print ((the string form of "saved: ") + (the string form of (save bim model file (the string form of "app-files-home/saved.bim") in (the address of editor)))) as a line
set reopened to a new bim editor
print ((the string form of "opened: ") + (the string form of (open bim model file (the string form of "app-files-home/saved.bim") in (the address of reopened)))) as a line
print ((the string form of "  levels ") + ((the string form of (the length of (reopened's documentValue's current's levels's values))) + ((the string form of ", units ") + (the bim name of unit reopened's lengthUnit)))) as a line
print ((the string form of "missing: ") + ((the string form of (open bim model file (the string form of "app-files-home/none.bim") in (the address of reopened))) + ((the string form of ", ") + reopened's message))) as a line
print ((the string form of "recent first: ") + (the bim base name of (the bim recent path at 0))) as a line
print ((the string form of "titles: ") + ((the bim document title of (the string form of "")) + ((the string form of ", ") + (the bim document title of (the string form of "/a/b/Huis.ifcxb"))))) as a line
