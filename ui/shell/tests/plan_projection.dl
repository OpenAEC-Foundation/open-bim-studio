# SPDX-License-Identifier: MPL-2.0
# Plans draw what they see beyond their cut (drawing quality plan, item 15),
# as NEN plans do: below the cut thin in the visible pen, above it dashed
# in the hidden pen.
#
# A ground floor (cut at 1.2 m, a roof level at 3 m) of four 200 mm walls
# around 6 by 4 m with a window in the front wall, a knee wall 0.8 m high
# inside and a flat roof on the roof level overhanging the walls by 0.4 m.
# Below the cut it draws the knee wall's top and nothing of the walls cut
# normally, nor anything in the window's rough opening (its symbol draws
# that); above it the roof's overhang, whole, and nothing else. On a sheet
# and on screen the same edges are recorded, the sheet's black in the
# 0.25 mm and 0.18 mm pens; the edges are worked out again only when the
# model changes.
import ui/shell/bim_app_parts.dl

function check plan projection {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
        else:
            print ((the string form of "PASS: ") + label) as a line

function plan projection {a 64 bit floating-point number:value} is near {a 64 bit floating-point number:wanted}:
    execute:
        return (the absolute value of (value - wanted)) < 0.001

# How many of `edges` belong to element `elementId`.
function the plan projection count of element {a 64 bit integer:elementId} in {a pointer to a list:edges}:
    execute:
        set total to 0
        loop cursor from 0 to the length of edges:
            if (the item at cursor in edges)'s elementId = elementId:
                set total to total + 1
        return total

# How much of the segment from (`ax`, `ay`) to (`bx`, `by`) the edges lying
# on it cover together, in metres (overlapping edges counted once).
function the plan projection cover of {a pointer to a list:edges} from {a 64 bit floating-point number:ax} {a 64 bit floating-point number:ay} to {a 64 bit floating-point number:bx} {a 64 bit floating-point number:by}:
    execute:
        set runX to bx - ax
        set runY to by - ay
        set runLength to the square root of ((runX * runX) + (runY * runY))
        set unitX to runX / runLength
        set unitY to runY / runLength
        set starts to an empty list of a 64 bit floating-point number
        set ends to an empty list of a 64 bit floating-point number
        loop cursor from 0 to the length of edges:
            set edge to the item at cursor in edges
            set startOff to ((edge's start's x - ax) * (0.0 - unitY)) + ((edge's start's y - ay) * unitX)
            set finishOff to ((edge's finish's x - ax) * (0.0 - unitY)) + ((edge's finish's y - ay) * unitX)
            if ((the absolute value of startOff) < 0.0001) and ((the absolute value of finishOff) < 0.0001):
                set startAlong to ((edge's start's x - ax) * unitX) + ((edge's start's y - ay) * unitY)
                set finishAlong to ((edge's finish's x - ax) * unitX) + ((edge's finish's y - ay) * unitY)
                set lowAlong to the maximum of 0.0 and (the minimum of startAlong and finishAlong)
                set highAlong to the minimum of runLength and (the maximum of startAlong and finishAlong)
                if highAlong > lowAlong:
                    set slot to the length of starts
                    append lowAlong to starts
                    append highAlong to ends
                    set shifting to true
                    loop while shifting:
                        if slot = 0:
                            set shifting to false
                        else if (the item at (slot - 1) in starts) > lowAlong:
                            replace item at index slot in starts with (the item at (slot - 1) in starts)
                            replace item at index slot in ends with (the item at (slot - 1) in ends)
                            set slot to slot - 1
                        else:
                            set shifting to false
                    replace item at index slot in starts with lowAlong
                    replace item at index slot in ends with highAlong
        set covered to 0.0
        set reach to 0.0
        loop cursor from 0 to the length of starts:
            set pieceStart to the maximum of reach and (the item at cursor in starts)
            set pieceEnd to the item at cursor in ends
            if pieceEnd > pieceStart:
                set covered to covered + (pieceEnd - pieceStart)
            set reach to the maximum of reach and pieceEnd
        free starts
        free ends
        return covered

# Checks that the edges cover `wanted` metres of the segment, saying how
# many millimetres they cover when they do not.
function check plan projection cover of {a pointer to a list:edges} from {a 64 bit floating-point number:ax} {a 64 bit floating-point number:ay} to {a 64 bit floating-point number:bx} {a 64 bit floating-point number:by} near {a 64 bit floating-point number:wanted} named {a string:label}:
    execute:
        set measured to the plan projection cover of edges from ax ay to bx by
        if plan projection measured is near wanted:
            print ((the string form of "PASS: ") + label) as a line
        else:
            print ((the string form of "FAIL: ") + (label + ((the string form of " (covers mm: ") + ((the string form of ((the rounded value of (measured * 1000.0)) as an integer)) + (the string form of ")"))))) as a line

# How many stroked batches of `canvas` are black, `breadth` wide and hold
# `corners` corners.
function the plan projection batches of {bim canvas record:canvas} wide {a 64 bit floating-point number:breadth} holding {integer:cornerTotal}:
    execute:
        set found to 0
        loop cursor from 0 to the length of (canvas's batches's values):
            set recorded to the item at cursor in (canvas's batches's values)
            set black to ((recorded's red = 0) and (recorded's green = 0)) and (recorded's blue = 0)
            if ((recorded's stroked and black) and (plan projection recorded's breadth is near breadth)) and ((the length of (recorded's pixels's values)) = cornerTotal):
                set found to found + 1
        return found

set scene to an empty list of a bim scene mesh record
set emptyAtlas to @intrinsic("construct", a bim text atlas record, @intrinsic("construct", a graphics texture, 0 as a pointer to a byte, 0, 0), an empty list of a bim text face record, 0, 0, an empty list of a bim icon cell record, an empty bim message catalogue, an empty list of a pointer, -1)

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set ground to editor's levelId
set roofLevel to add bim level named (the string form of "Roof") at 3.0 with height 3.0 to target
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to layerValues
set brickType to add bim wall type named (the string form of "Brick 200") with layerValues to target
free layerValues
# Anticlockwise, the exterior outside; their faces 0.1 m off their lines.
set frontWall to add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) to target
set rightWall to add bim wall typed brickType on ground from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 6.0 and y 4.0) to target
set backWall to add bim wall typed brickType on ground from (a cad vector2 with x 6.0 and y 4.0) to (a cad vector2 with x 0.0 and y 4.0) to target
set leftWall to add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 4.0) to (a cad vector2 with x 0.0 and y 0.0) to target
# 1200 by 1500 on a 900 sill with a 50 mm frame in the middle of the front
# wall: its rough opening from x 2.35 to 3.65, from 0.9 to 2.45 m high.
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
set windowId to add bim opening typed windowType in frontWall at 3.0 to target
# A knee wall 0.8 m high, below the cut: x 1 to 3 at y 2.
set kneeWall to add bim wall typed brickType on ground from (a cad vector2 with x 1.0 and y 2.0) to (a cad vector2 with x 3.0 and y 2.0) to target
ignore (set bim wall kneeWall height to 0.8 in target)
# A flat roof 0.2 m thick on the roof level, its top 0.2 m above it, from
# -0.5 to 6.5 by -0.5 to 4.5: 0.4 m past the walls' outer faces.
set roofLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.2)) to roofLayers
set roofType to add bim planar type named (the string form of "Flat roof") as role bim roof planar role with roofLayers to target
free roofLayers
set roofOutline to an empty list of a cad vector2
append (a cad vector2 with x -0.5 and y -0.5) to roofOutline
append (a cad vector2 with x 6.5 and y -0.5) to roofOutline
append (a cad vector2 with x 6.5 and y 4.5) to roofOutline
append (a cad vector2 with x -0.5 and y 4.5) to roofOutline
set roofId to add bim plate typed roofType on roofLevel around roofOutline at top 0.2 to target
set groundPlan to add bim view of kind bim plan view named (the string form of "Ground floor") on ground to target
set editor's planViewId to groundPlan
refresh bim editor (the address of editor)
print ((the string form of "plan cut height: ") + (the bim exact text of (the bim plan cut height of editor))) as a line
print ((the string form of "looks down (m): ") + ((the bim exact text of (the bim plan depth of editor)) + ((the string form of ", up to (m): ") + (the bim exact text of (the bim plan top of editor))))) as a line

set planProjection to an empty bim plan projection
refresh bim plan projection in (the address of planProjection) of editor among scene cut as editor's plan
set belowEdges to planProjection's below's values
set aboveEdges to planProjection's above's values
print ((the string form of "below the cut: ") + (the string form of (the length of belowEdges))) as a line
print ((the string form of "above the cut: ") + (the string form of (the length of aboveEdges))) as a line

# Below: the knee wall's top, its faces at y 1.9 and 2.1 and its ends.
print ((the string form of "  knee wall ") + (the string form of (the plan projection count of element kneeWall in belowEdges))) as a line
check plan projection cover of belowEdges from 1.0 1.9 to 3.0 1.9 near 2.0 named (the string form of "the knee wall's top, one face")
check plan projection cover of belowEdges from 1.0 2.1 to 3.0 2.1 near 2.0 named (the string form of "and the other")
check plan projection cover of belowEdges from 1.0 1.9 to 1.0 2.1 near 0.2 named (the string form of "and its end")
set cutWallsBelow to ((the plan projection count of element frontWall in belowEdges) + (the plan projection count of element rightWall in belowEdges)) + ((the plan projection count of element backWall in belowEdges) + (the plan projection count of element leftWall in belowEdges))
check plan projection (cutWallsBelow = 0) named (the string form of "nothing below of the walls cut normally")
check plan projection ((the plan projection count of element kneeWall in belowEdges) = (the length of belowEdges)) named (the string form of "nothing else below the cut")
# The window's symbol draws its sills and jambs: the projection leaves the
# rough opening's sill in the wall alone.
check plan projection cover of belowEdges from 2.35 -0.1 to 3.65 -0.1 near 0.0 named (the string form of "nothing in the window's rough opening, outer face")
check plan projection cover of belowEdges from 2.35 0.1 to 3.65 0.1 near 0.0 named (the string form of "nor its inner face")

# Above: the roof's overhang, all four sides whole.
print ((the string form of "  roof ") + (the string form of (the plan projection count of element roofId in aboveEdges))) as a line
check plan projection cover of aboveEdges from -0.5 -0.5 to 6.5 -0.5 near 7.0 named (the string form of "the roof's overhang above, front")
check plan projection cover of aboveEdges from 6.5 -0.5 to 6.5 4.5 near 5.0 named (the string form of "right")
check plan projection cover of aboveEdges from 6.5 4.5 to -0.5 4.5 near 7.0 named (the string form of "back")
check plan projection cover of aboveEdges from -0.5 4.5 to -0.5 -0.5 near 5.0 named (the string form of "and left")
check plan projection ((the plan projection count of element roofId in aboveEdges) = (the length of aboveEdges)) named (the string form of "nothing else above the cut")
check plan projection ((the plan projection count of element roofId in belowEdges) = 0) named (the string form of "and the roof not below it")

# On paper (a unit per millimetre at 1:100): below in the visible pen, one
# stroke per edge; above dashed in the hidden pen.
set paperTransform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 10.0)
set paperCanvas to a new bim canvas
set paperCanvas's paperScale to 1.0
record bim plan projection (the address of planProjection) of editor through paperTransform on (the address of paperCanvas)
print ((the string form of "paper batches: ") + (the string form of (the length of (paperCanvas's batches's values)))) as a line
set belowBatch to the item at 0 in (paperCanvas's batches's values)
set aboveBatch to the item at 1 in (paperCanvas's batches's values)
print ((the string form of "  roof dashes: ") + (the string form of ((the length of (aboveBatch's pixels's values)) / 6))) as a line
check plan projection ((plan projection belowBatch's breadth is near 0.25) and ((the length of (belowBatch's pixels's values)) = (6 * (the length of belowEdges)))) named (the string form of "below the cut in the visible pen (0.25 mm), a stroke an edge")
check plan projection ((plan projection aboveBatch's breadth is near 0.18) and ((the length of (aboveBatch's pixels's values)) > (6 * (the length of aboveEdges)))) named (the string form of "above it dashed in the hidden pen (0.18 mm)")
check plan projection ((((belowBatch's red + belowBatch's green) + (belowBatch's blue + aboveBatch's red)) + (aboveBatch's green + aboveBatch's blue)) = 0) named (the string form of "black on paper")

# A sheet's viewport of the plan (1:100, a unit per millimetre) records the
# same batches, and so does the live plan through the shared functions.
set sheetId to add bim sheet numbered (the string form of "A-101") named (the string form of "Ground floor") on paper 3 landscape true to target
ignore place bim view groundPlan on sheet sheetId at (a cad vector2 with x 150.0 and y 150.0) looking at (the bim model centre of view groundPlan in editor's documentValue's current) in target
set sheetValue to the item at (the bim sheet index of sheetId in editor's documentValue's current)'s position in (target's sheets's values)
set sheetCanvas to a new bim canvas
record bim sheet viewport 0 of sheetValue of editor among scene from (a cad vector2 with x 0.0 and y 297.0) at 1.0 using emptyAtlas on (the address of sheetCanvas)
check plan projection ((the plan projection batches of sheetCanvas wide 0.25 holding (the length of (belowBatch's pixels's values))) >= 1) named (the string form of "the sheet draws the edges below the cut")
check plan projection ((the plan projection batches of sheetCanvas wide 0.18 holding (the length of (aboveBatch's pixels's values))) = 1) named (the string form of "and those above it, dashed")
set screenCanvas to a new bim canvas
set screenCanvas's paperScale to 1.0
set noLines to an empty list of a cad vector2
set screenStairs to an empty bim curtain plan cache
set livePlan to editor's plan
record bim plan of editor cut as livePlan among scene with linked noLines and noLines keeping (the address of screenStairs) projecting (the address of planProjection) through paperTransform using emptyAtlas on (the address of screenCanvas)
check plan projection ((the plan projection batches of screenCanvas wide 0.18 holding (the length of (aboveBatch's pixels's values))) = 1) named (the string form of "the live plan records the same")
check plan projection (planProjection's builds = 1) named (the string form of "from the edges kept, not worked out again")

# A change to the model works them out again: the knee wall raised past
# the cut is cut, and leaves nothing below it.
begin bim transaction in (the address of (editor's documentValue))
ignore (set bim wall kneeWall height to 2.0 in (the address of (editor's documentValue's current)))
commit bim transaction in (the address of (editor's documentValue))
refresh bim editor (the address of editor)
print ((the string form of "builds after the change: ") + (the string form of planProjection's builds)) as a line
refresh bim plan projection in (the address of planProjection) of editor among scene cut as editor's plan
print ((the string form of "knee wall below after the change: ") + (the string form of (the plan projection count of element kneeWall in (planProjection's below's values)))) as a line
check plan projection (planProjection's builds = 2) named (the string form of "a changed model works the edges out again")
check plan projection ((the plan projection count of element kneeWall in (planProjection's below's values)) = 0) named (the string form of "the raised wall is cut, nothing of it below")
