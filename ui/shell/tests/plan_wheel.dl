# SPDX-License-Identifier: MPL-2.0
import ui/shell/bim_app_parts.dl

function require plan wheel {boolean:condition}:
    execute:
        if condition = false:
            print "FAIL: plan wheel navigation" as a line
            @intrinsic("call", "libc", "exit", nothing, 1)

set layout to @intrinsic("construct", a bim screen layout record, 1440.0, 900.0, 52.0, 1000.0, 178.0, 848.0)
set camera to @intrinsic("construct", a bim camera record, (a cad vector2 with x 17.0 and y -13.0), 40.0, 0.5, 0.5, (a cad vector3 with x 10.0, y 20.0 and z 30.0), 15.0)
set pointerPixel to a cad vector2 with x 725.0 and y 384.0
set anchor to the bim model point of pointerPixel in layout with camera
set closer to the bim camera camera scrolled by 1.0 in plan at pointerPixel in layout
set held to the bim model point of pointerPixel in layout with closer
require plan wheel (closer's scale > (camera's scale * 1.4))
require plan wheel (((the absolute value of (anchor's x - held's x)) < 1e-9) and ((the absolute value of (anchor's y - held's y)) < 1e-9))
require plan wheel (closer's viewScale = camera's viewScale)
set back to the bim camera closer scrolled by -1.0 in plan at pointerPixel in layout
require plan wheel ((the absolute value of (back's scale - camera's scale)) < 1e-9)
require plan wheel (((the absolute value of (back's centre's x - camera's centre's x)) < 1e-9) and ((the absolute value of (back's centre's y - camera's centre's y)) < 1e-9))
set smooth to camera
loop step from 0 to 4:
    set smooth to the bim camera smooth scrolled by 0.25 in plan at pointerPixel in layout
require plan wheel ((the absolute value of (smooth's scale - closer's scale)) < 1e-9)
print "PASS: responsive plan wheel preserves cursor anchor, fractional input and inverse zoom" as a line

set editor to a new bim editor
set first to resolve bim editor letter 90 at (0 as a 64 bit integer) in (the address of editor)
set second to resolve bim editor letter 65 at (100000 as a 64 bit integer) in (the address of editor)
require plan wheel ((the length of first) = 0)
require plan wheel (((the length of second) = 1) and ((the item at 0 in second) = 70))
require plan wheel (editor's pendingLetter = 0)
free first
free second
print "PASS: ZA resolves once to Zoom All without leftover tool keys" as a line
