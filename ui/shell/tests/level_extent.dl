# SPDX-License-Identifier: MPL-2.0
# The levels' extent: unset, every level shows the automatic one; set on one
# locked level, every locked level follows; an unlocked level keeps its own.
# A handle moves its sides: a corner two, a side's middle one. The extent and
# the lock survive the file.
import editor/bim_editor.dl
import formats/bim_file.dl

function the extent test text of {bim plan extent record:extent}:
    execute:
        return ((the string form of extent's low's x) + ((the string form of ",") + (the string form of extent's low's y))) + ((the string form of " to ") + ((the string form of extent's high's x) + ((the string form of ",") + (the string form of extent's high's y))))

set modelValue to an empty bim model
set target to the address of modelValue
set ground to add bim level named (the string form of "Ground floor") at 0.0 with height 3.0 to target
set upper to add bim level named (the string form of "First floor") at 3.0 with height 3.0 to target
set automatic to @intrinsic("construct", a bim plan extent record, true, (a cad vector2 with x -1.5 and y -1.5), (a cad vector2 with x 11.5 and y 6.5))
print ((the string form of "unset: ") + (the extent test text of (the bim level extent of upper in modelValue around automatic))) as a line
print ((the string form of "set on the ground floor: ") + (the string form of (set bim level extent of ground from (a cad vector2 with x -2.0 and y -2.0) to (a cad vector2 with x 12.0 and y 8.0) in target))) as a line
print ((the string form of "first floor follows: ") + (the extent test text of (the bim level extent of upper in modelValue around automatic))) as a line
print ((the string form of "no area refused: ") + (the string form of ((set bim level extent of ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 5.0) in target) = false))) as a line
set bim level upper unlocked true from (the bim level extent of upper in modelValue around automatic) in target
ignore (set bim level extent of ground from (a cad vector2 with x -4.0 and y -2.0) to (a cad vector2 with x 12.0 and y 8.0) in target)
print ((the string form of "ground floor moved: ") + (the extent test text of (the bim level extent of ground in modelValue around automatic))) as a line
print ((the string form of "unlocked first floor kept: ") + (the extent test text of (the bim level extent of upper in modelValue around automatic))) as a line
# Handles: the high corner moves the high x and y, the low x side's middle
# only the low x.
set shared to the bim level extent of ground in modelValue around automatic
print ((the string form of "corner: ") + (the extent test text of (the bim level extent shared with sides (the bim sides moved by level handle 2) at (a cad vector2 with x 15.0 and y 9.0)))) as a line
print ((the string form of "side: ") + (the extent test text of (the bim level extent shared with sides (the bim sides moved by level handle 4) at (a cad vector2 with x -6.0 and y 3.0)))) as a line
set reread to the bim model parsed from (the bim file text of modelValue)
print ((the string form of ".bim read: ") + (the string form of reread's valid)) as a line
print ((the string form of "from .bim: ") + ((the extent test text of (the bim level extent of ground in reread's modelValue around automatic)) + ((the string form of "; ") + (the extent test text of (the bim level extent of upper in reread's modelValue around automatic))))) as a line
set bim level upper unlocked false from automatic in target
print ((the string form of "locked again: ") + (the extent test text of (the bim level extent of upper in modelValue around automatic))) as a line
