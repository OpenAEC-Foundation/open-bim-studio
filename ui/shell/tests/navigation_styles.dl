# SPDX-License-Identifier: MPL-2.0
# Navigation styles and the gizmo's settings (#137): what each style does
# with the right and the middle button and the keys held, as the Settings
# window lists it; the Settings window's Navigation and Gizmo commands
# applied to the settings; and the settings kept and read back (with HOME
# in a folder of the test's own; defaults without a file).
import ui/shell/bim_ui_files.dl
import ui/shell/bim_navigation.dl

function the action word of {integer:actionCode}:
    execute:
        if actionCode = bim orbit navigation:
            return the string form of "orbit"
        if actionCode = bim pan navigation:
            return the string form of "pan"
        if actionCode = bim zoom navigation:
            return the string form of "zoom"
        if actionCode = bim cursor navigation:
            return the string form of "cursor"
        return the string form of "-"

function show settings {bim app settings record:chosen} as {a string:caption}:
    execute:
        set described to (caption + (the string form of ": navigation ")) + (the bim name of navigation style (chosen's navigation))
        set described to (described + (the string form of ", axes ")) + (the bim choice (chosen's gizmoAxes) of list 5)
        set described to (described + (the string form of ", size ")) + (the bim choice (chosen's gizmoSize) of list 6)
        set described to (described + (the string form of ", handles ")) + (the string form of (chosen's gizmoHandles))
        set described to (described + (the string form of ", move ")) + (the bim choice (chosen's moveStep) of list 7)
        set described to (described + (the string form of ", turn ")) + (the bim choice (chosen's turnStep) of list 8)
        set described to (described + (the string form of ", theme ")) + (the string form of (chosen's theme))
        print described as a line

loop styleCursor from 0 to the bim navigation style count:
    set mapped to the string form of ""
    loop buttonCursor from 1 to 3:
        loop modifierCursor from 0 to 4:
            set mapped to (mapped + (the string form of " ")) + (the action word of (the bim navigation of style styleCursor dragging button buttonCursor holding modifierCursor))
    print ((the bim name of navigation style styleCursor) + ((the string form of ": right/middle x plain shift ctrl alt:") + mapped)) as a line
    print ((the string form of "  orbit ") + ((the bim navigation summary of style styleCursor doing (bim orbit navigation)) + ((the string form of "; pan ") + ((the bim navigation summary of style styleCursor doing (bim pan navigation)) + ((the string form of "; zoom ") + ((the bim navigation summary of style styleCursor doing (bim zoom navigation)) + ((the string form of "; cursor ") + (the bim navigation summary of style styleCursor doing (bim cursor navigation))))))))) as a line
print ((the string form of "keypad views: Blender ") + ((the string form of (bim navigation style (bim blender navigation style) has keypad views)) + ((the string form of ", Revit ") + (the string form of (bim navigation style (bim revit navigation style) has keypad views))))) as a line
set frontSide to the bim keypad view direction of key 321 opposite false
set backSide to the bim keypad view direction of key 321 opposite true
set topSide to the bim keypad view direction of key 327 opposite false
print ((the string form of "keypad 1 from y ") + ((the string form of frontSide's y) + ((the string form of ", Ctrl+1 from y ") + ((the string form of backSide's y) + ((the string form of ", 7 from z ") + (the string form of topSide's z)))))) as a line
print ((the string form of "modifier with shift and ctrl: ") + (the string form of (the bim navigation modifier with shift true control true alt false))) as a line

ignore @intrinsic("call", "libc", "mkdir", integer, "navigation-home", 493)
ignore @intrinsic("call", "libc", "setenv", integer, "HOME", "navigation-home", 1)
ignore (write bim text (the string form of "") to file (the string form of "navigation-home/.config/open-bim-studio/settings.txt"))

set testSettings to the bim stored app settings
show settings testSettings as (the string form of "defaults")
print ((the string form of "default steps: ") + ((the string form of (the bim gizmo move step of choice (testSettings's moveStep))) + ((the string form of " m, ") + ((the string form of (the bim gizmo turn step of choice (testSettings's turnStep))) + (the string form of " deg"))))) as a line

# The Settings window's pages and lists.
set settingsScreens to the bim file screens at rest
apply bim file screen command (bim settings open command) to (the address of settingsScreens)
apply bim file screen command (the bim settings page command for 3) to (the address of settingsScreens)
apply bim file screen command (the bim settings list command for 7) to (the address of settingsScreens)
print ((the string form of "page ") + ((the string form of (settingsScreens's settingsPage)) + ((the string form of ", list ") + (the string form of (settingsScreens's listOpen))))) as a line
set pickedCommand to (the bim first setting command of list 7) + 3
print ((the string form of "a choice sets a setting: ") + (the string form of (bim command pickedCommand sets a setting))) as a line
apply bim file screen command pickedCommand to (the address of settingsScreens)
print ((the string form of "list after the choice: ") + (the string form of (settingsScreens's listOpen))) as a line
set testSettings to the bim choices testSettings after setting pickedCommand
set testSettings to the bim choices testSettings after setting ((bim navigation setting command) + (bim blender navigation style))
set testSettings to the bim choices testSettings after setting ((bim gizmo axes setting command) + (bim global gizmo axes))
set testSettings to the bim choices testSettings after setting ((bim gizmo size setting command) + 2)
set testSettings to the bim choices testSettings after setting ((bim turn step setting command) + 3)
set testSettings to the bim choices testSettings after setting ((bim gizmo handle setting command) + 1)
set testSettings to the bim choices testSettings after setting ((bim gizmo handle setting command) + 3)
set testSettings to the bim choices testSettings after setting ((bim gizmo handle setting command) + 3)
show settings testSettings as (the string form of "chosen")
apply bim file screen command (the bim settings page command for 2) to (the address of settingsScreens)
print ((the string form of "navigation page: ") + (the string form of (settingsScreens's settingsPage))) as a line
apply bim file screen command (the bim settings page command for 1) to (the address of settingsScreens)
print ((the string form of "general page: ") + (the string form of (settingsScreens's settingsPage))) as a line

print ((the string form of "kept: ") + (the string form of (keep bim app settings testSettings))) as a line
show settings (the bim stored app settings) as (the string form of "read")
# A file from before these settings, and one out of range.
ignore (write bim text (the string form of "theme 0\nnavigation 9\ngizmohandles 99\nmovestep x1\n") to file (the string form of "navigation-home/.config/open-bim-studio/settings.txt"))
show settings (the bim stored app settings) as (the string form of "older")
