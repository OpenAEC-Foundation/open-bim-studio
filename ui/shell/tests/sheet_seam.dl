# SPDX-License-Identifier: MPL-2.0
# The seam between a building system's whole panels and the panels its
# contour cuts leaves no marks in a projected view.
#
# A system 6 m long in bays of 1.2 by 3 m without joints, 5 m high under a
# contour that rises from 4 m to 5 m: its lower row is whole panels, its
# upper row panels cut to the contour. Seen square from in front, the
# panels lie flush: the view draws the outline, the upright joints left of
# it and no pieces along the row's seam at 2.5 m. (The touching ends of a
# lower and an upper panel share their corners; their diagonal, seen on
# edge, was drawn and showed for 5 mm at each panel's end.)
import ui/shell/bim_app_parts.dl

function the seam test millimetres of {a 64 bit floating-point number:metres}:
    execute:
        return the string form of ((the rounded value of (metres * 1000.0)) as an integer)

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set systemId to add bim curtain wall on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) rising 5.0 in bays of 1.2 by 3.0 of (the string form of "timber") to target
set bim setting (bim joint width setting) of systemId to (0 as a 64 bit integer) keeping true in target
set cornerList to an empty list of a cad vector2
append (a cad vector2 with x 0.0 and y 0.0) to cornerList
append (a cad vector2 with x 6.0 and y 0.0) to cornerList
append (a cad vector2 with x 6.0 and y 5.0) to cornerList
append (a cad vector2 with x 0.0 and y 4.0) to cornerList
keep bim face contour cornerList of systemId in target
set sectionId to add bim section view from (a cad vector2 with x -1.0 and y -1.0) to (a cad vector2 with x 7.0 and y -1.0) to target
refresh bim editor (the address of editor)
set sceneList to the bim sketch meshes of editor's documentValue's current
set sectionView to the item at (the bim view index of sectionId in editor's documentValue's current)'s position in (editor's documentValue's current's views's values)
set sectionCut to the bim section of (editor's evaluation) from (sectionView's lineStart) to (sectionView's lineFinish)
set shownEdges to the bim section projection of editor among (sceneList's values) for sectionView cut as sectionCut
set seamPieces to 0
loop edgeCursor from 0 to the length of (shownEdges's values):
    set shownEdge to the item at edgeCursor in (shownEdges's values)
    if ((the absolute value of (shownEdge's start's y - 2.5)) < 0.001) and ((the absolute value of (shownEdge's finish's y - 2.5)) < 0.001):
        set seamPieces to seamPieces + 1
    print ((the string form of "  ") + ((the seam test millimetres of shownEdge's start's x) + ((the string form of ", ") + ((the seam test millimetres of shownEdge's start's y) + ((the string form of " to ") + ((the seam test millimetres of shownEdge's finish's x) + ((the string form of ", ") + (the seam test millimetres of shownEdge's finish's y)))))))) as a line
print ((the string form of "edges: ") + (the string form of (the length of (shownEdges's values)))) as a line
print ((the string form of "pieces along the seam: ") + (the string form of seamPieces)) as a line
