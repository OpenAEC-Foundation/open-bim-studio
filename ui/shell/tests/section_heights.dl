# SPDX-License-Identifier: MPL-2.0
# Height dimensions and peil marks in sections (drawing quality plan, item
# 14, section part). A two-storey house, 8 m deep, with a 300 mm floor on
# each storey, a window on each side and a gable roof of two plates meeting
# in a ridge at 8 m, cut by a section across it. A window's head is its
# rough opening's (1500 high, a 50 mm frame above). Height dimensions (2462)
# put chains beside the section, kept in its view: the openings on the side
# of their facade (floors, sill and head; not an interior door the section
# also cuts), floor to floor up to the ridge,
# and the whole; made again they replace the old ones, a plan leaves them
# out, and .bim and IfcX keep their view. On its sheet, at 1:100, the
# chains are lettered upright and the section carries peil marks on each
# floor's top, on the ridge and on the ground (maaiveld) the project sets.
# Place view (PV) places the section whose tab was made active last, also
# once a sheet's tab is active, and the plan when a plan's tab was.
import ui/shell/bim_app_parts.dl

function check section heights {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function the section heights whole of {a 64 bit floating-point number:amount}:
    execute:
        return (@intrinsic("call", "libc", "round", a 64 bit floating-point number, amount)) as a 64 bit integer

# How many texts on `canvas` read `wanted`.
function the section heights count of text {a string:wanted} on {bim canvas record:canvas}:
    execute:
        set found to 0
        loop cursor from 0 to the length of (canvas's texts's values):
            if (the item at cursor in (canvas's texts's values))'s message = wanted:
                set found to found + 1
        return found

# The dimension values lettered on `canvas` (its texts that start with a
# figure; the peil marks' start with a P, their names with a letter), in
# the order recorded.
function the section heights values on {bim canvas record:canvas}:
    execute:
        set found to an empty list of a bim canvas text record
        loop cursor from 0 to the length of (canvas's texts's values):
            set label to the item at cursor in (canvas's texts's values)
            if (the length of label's message) > 0:
                set leading to (the character at 0 in label's message) as an integer
                if (leading >= 48) and (leading <= 57):
                    append label to found
        return found

# The dimensions of view `viewId`, each as "offset side: value" (paper
# millimetres off, l or r, millimetres measured), in the model's order.
function show section heights dimensions of view {a 64 bit integer:viewId} in {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's dimensions's values):
            set dimensionValue to the item at cursor in (modelValue's dimensions's values)
            if dimensionValue's viewId = viewId:
                set measured to the bim measure of dimensionValue in modelValue
                set sideText to the string form of "r"
                if dimensionValue's outward's x < 0.0:
                    set sideText to the string form of "l"
                set offsetText to the string form of (the section heights whole of dimensionValue's paperOffset)
                print ((((the string form of "  ") + offsetText) + ((the string form of " mm ") + sideText)) + ((the string form of ": ") + (the string form of (the section heights whole of (measured's value * 1000.0))))) as a line

# The values in millimetres of view `viewId`'s dimensions `paperOffset`
# millimetres off, joined by spaces.
function the section heights chain of view {a 64 bit integer:viewId} at {a 64 bit floating-point number:offset} in {bim model record:modelValue}:
    execute:
        set joined to the string form of ""
        loop cursor from 0 to the length of (modelValue's dimensions's values):
            set dimensionValue to the item at cursor in (modelValue's dimensions's values)
            if (dimensionValue's viewId = viewId) and ((the absolute value of (dimensionValue's paperOffset - offset)) < 0.001):
                set measured to the bim measure of dimensionValue in modelValue
                if (the length of joined) > 0:
                    set joined to joined + (the string form of " ")
                set joined to joined + (the string form of (the section heights whole of (measured's value * 1000.0)))
        return joined

# How many of `modelValue`'s dimensions are in view `viewId`.
function the section heights count in view {a 64 bit integer:viewId} of {bim model record:modelValue}:
    execute:
        set counted to 0
        loop cursor from 0 to the length of (modelValue's dimensions's values):
            if (the item at cursor in (modelValue's dimensions's values))'s viewId = viewId:
                set counted to counted + 1
        return counted

function the section heights rectangle from {a 64 bit floating-point number:lowX} and {a 64 bit floating-point number:lowY} to {a 64 bit floating-point number:highX} and {a 64 bit floating-point number:highY}:
    execute:
        set corners to an empty list of a cad vector2
        append (a cad vector2 with x lowX and y lowY) to corners
        append (a cad vector2 with x highX and y lowY) to corners
        append (a cad vector2 with x highX and y highY) to corners
        append (a cad vector2 with x lowX and y highY) to corners
        return corners

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set ground to editor's levelId
set upper to add bim level named (the string form of "First floor") at 3.0 with height 3.0 to target
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to layerValues
set brickType to add bim wall type named (the string form of "Brick 200") with layerValues to target
free layerValues
set leftGround to add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 6.0) to target
ignore add bim wall typed brickType on ground from (a cad vector2 with x 8.0 and y 0.0) to (a cad vector2 with x 8.0 and y 6.0) to target
ignore add bim wall typed brickType on upper from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 6.0) to target
set rightUpper to add bim wall typed brickType on upper from (a cad vector2 with x 8.0 and y 0.0) to (a cad vector2 with x 8.0 and y 6.0) to target
set windowType to add bim opening type named (the string form of "Window 1200") sized 1.2 by 1.5 with sill 0.9 and frame 0.05 to target
set lowWindow to add bim opening typed windowType in leftGround at 3.0 to target
ignore add bim opening typed windowType in rightUpper at 3.0 to target
# An interior wall at x = 6 with a door the section also cuts: its head
# (2150) stays out of the facade's chain.
set innerWall to add bim wall typed brickType on ground from (a cad vector2 with x 6.0 and y 0.0) to (a cad vector2 with x 6.0 and y 6.0) to target
set doorType to add bim opening type named (the string form of "Door 900") sized 0.9 by 2.1 with sill 0.0 and frame 0.05 to target
ignore add bim opening typed doorType in innerWall at 3.0 to target
set floorLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "concrete", 0.3)) to floorLayers
set floorType to add bim planar type named (the string form of "Floor 300") as role bim floor planar role with floorLayers to target
free floorLayers
set roofLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.2)) to roofLayers
set roofType to add bim planar type named (the string form of "Roof 200") as role bim roof planar role with roofLayers to target
free roofLayers
set house to the section heights rectangle from 0.0 and 0.0 to 8.0 and 6.0
ignore add bim plate typed floorType on ground around house at top 0.0 to target
ignore add bim plate typed floorType on upper around house at top 0.0 to target
free house
# The gable: each half rises 1 in 2 from its eaves (6 m) to the ridge at
# x = 4 (8 m), its top 3 m above the upper storey at its first corner.
set leftHalf to the section heights rectangle from 0.0 and 0.0 to 4.0 and 6.0
set leftRoof to add bim plate typed roofType on upper around leftHalf at top 3.0 to target
ignore (set bim plate leftRoof top to 3.0 pitch (@intrinsic("atan2", 0.5, 1.0)) heading 0.0 in target)
free leftHalf
set rightHalf to an empty list of a cad vector2
append (a cad vector2 with x 8.0 and y 0.0) to rightHalf
append (a cad vector2 with x 8.0 and y 6.0) to rightHalf
append (a cad vector2 with x 4.0 and y 6.0) to rightHalf
append (a cad vector2 with x 4.0 and y 0.0) to rightHalf
set rightRoof to add bim plate typed roofType on upper around rightHalf at top 3.0 to target
ignore (set bim plate rightRoof top to 3.0 pitch (@intrinsic("atan2", 0.5, 1.0)) heading 3.141592653589793 in target)
free rightHalf
prepare bim editor views in (the address of editor)
set sectionId to add bim section view from (a cad vector2 with x -1.0 and y 3.0) to (a cad vector2 with x 9.0 and y 3.0) to target
refresh bim editor (the address of editor)

# 2462 needs a section shown.
type bim editor key 2462 in (the address of editor)
print editor's message as a line
show bim editor section view sectionId in (the address of editor)
type bim editor key 2462 in (the address of editor)
print editor's message as a line
show section heights dimensions of view sectionId in editor's documentValue's current
set modelNow to editor's documentValue's current
check section heights ((the section heights chain of view sectionId at 14.0 in modelNow) = (the string form of "3000 5000")) named (the string form of "floor to floor: 3000, then 5000 to the ridge")
check section heights ((the section heights chain of view sectionId at 20.0 in modelNow) = (the string form of "8000")) named (the string form of "the whole: 8000 from the ground floor to the ridge")
check section heights ((the section heights chain of view sectionId at 8.0 in modelNow) = (the string form of "900 1550 550 3000 900 1550")) named (the string form of "openings: floor, sill and head on each side")
set madeFirst to the section heights count in view sectionId of modelNow
type bim editor key 2462 in (the address of editor)
check section heights ((the section heights count in view sectionId of (editor's documentValue's current)) = madeFirst) named (the string form of "made again, the chains replace the old ones")

# The ground floor's peil mark stands in the widest stretch no wall stands
# on: between the outer wall at x = 0 and the interior wall at x = 6, 1 and
# 7 m along the section line (it starts at x = -1), so at 4 m.
set markCut to the bim section of (editor's evaluation) from (a cad vector2 with x -1.0 and y 3.0) to (a cad vector2 with x 9.0 and y 3.0)
set markPlace to the bim floor mark place from 1.0 to 9.0 at 0.0 in markCut of modelNow
print ((the string form of "  peil mark at mm ") + (the string form of (the section heights whole of (markPlace * 1000.0)))) as a line
check section heights ((the absolute value of (markPlace - 4.0)) < 0.001) named (the string form of "the floor's peil mark keeps clear of the interior wall")

# Its name, typed in its properties (a plan's is its level's).
set editor's propertiesViewId to sectionId
set editor's propertyCode to 12841
set editor's propertyText to the string form of " A-A "
apply bim editor property in (the address of editor)
set renamed to the item at (the bim view index of sectionId in editor's documentValue's current)'s position in (editor's documentValue's current's views's values)
check section heights (renamed's name = (the string form of "A-A")) named (the string form of "the section is renamed A-A, its spaces left out")
set editor's propertiesViewId to editor's planViewId

# A plan leaves a section's dimensions out: at 100 pixels to the metre,
# where the plan's 1:100 letters a value 25 pixels high (at 10 a value's
# 2.5 pixels are too small to letter on screen at all), neither their
# values nor their lines.
set planCanvas to a new bim canvas
draw bim dimensions in plan of editor through (@intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 100.0)) on (the address of planCanvas)
check section heights (((the length of (planCanvas's texts's values)) = 0) and ((the length of (planCanvas's batches's values)) = 0)) named (the string form of "the plan draws none of them")

# .bim and IfcX keep them in their view.
set reread to the bim model parsed from (the bim file text of editor's documentValue's current)
check section heights (reread's valid and ((the section heights count in view sectionId of (reread's modelValue)) = madeFirst)) named (the string form of ".bim keeps the section's dimensions")
check section heights ((the section heights chain of view sectionId at 14.0 in (reread's modelValue)) = (the string form of "3000 5000")) named (the string form of ".bim keeps their references")
set ifcxText to the bim ifcx text of (editor's documentValue's current) identified as (the string form of "heights.ifcx") for project (the string form of "Heights") by (the string form of "test") at (the string form of "2026-11-06T00:00:00Z")
set nativeText to the bim native text of ifcx ifcxText
set fromIfcx to the bim model parsed from nativeText's text
check section heights (fromIfcx's valid and ((the section heights count in view sectionId of (fromIfcx's modelValue)) = madeFirst)) named (the string form of "IfcX keeps the section's dimensions")

# Deleting the window drops the dimensions to its sill and head.
begin bim transaction in (the address of (editor's documentValue))
ignore delete bim opening lowWindow from target
commit bim transaction in (the address of (editor's documentValue))
check section heights ((the section heights chain of view sectionId at 8.0 in (editor's documentValue's current)) = (the string form of "3000 900 1550")) named (the string form of "a deleted window's heights go with it")
type bim editor key 2462 in (the address of editor)

# Place view: the tab made active last decides.
set sheetId to add bim sheet numbered (the string form of "A-301") named (the string form of "Sections") on paper 2 landscape true to target
set editor's sheetId to sheetId
set modelNow to editor's documentValue's current
set editor's placeViewId to the bim view to place for tab (bim plan tab) showing (editor's planViewId) keeping (editor's placeViewId) in modelNow
set editor's placeViewId to the bim view to place for tab (bim section tab) showing sectionId keeping (editor's placeViewId) in modelNow
set editor's placeViewId to the bim view to place for tab (bim sheet tab) showing sheetId keeping (editor's placeViewId) in modelNow
type bim editor key 2096 in (the address of editor)
print editor's message as a line
set sheetValue to the item at (the bim sheet index of sheetId in editor's documentValue's current)'s position in (editor's documentValue's current's sheets's values)
check section heights (((the length of (sheetValue's viewports's values)) = 1) and ((the item at 0 in (sheetValue's viewports's values))'s viewId = sectionId)) named (the string form of "PV with the section's tab active, then the sheet's, places the section")
set editor's placeViewId to the bim view to place for tab (bim plan tab) showing (editor's planViewId) keeping (editor's placeViewId) in (editor's documentValue's current)
type bim editor key 2096 in (the address of editor)
set sheetValue to the item at (the bim sheet index of sheetId in editor's documentValue's current)'s position in (editor's documentValue's current's sheets's values)
check section heights (((the length of (sheetValue's viewports's values)) = 2) and ((the item at 1 in (sheetValue's viewports's values))'s viewId = editor's planViewId)) named (the string form of "PV with a plan's tab active places the plan")

# The section on its sheet, at 1:100 and one unit to the millimetre, the
# ground 450 mm below peil.
set bim setting (bim project ground level setting) of (0 as a 64 bit integer) to ((-450) as a 64 bit integer) keeping true in target
set sheetValue to the item at (the bim sheet index of sheetId in editor's documentValue's current)'s position in (editor's documentValue's current's sheets's values)
set emptyAtlas to @intrinsic("construct", a bim text atlas record, @intrinsic("construct", a graphics texture, 0 as a pointer to a byte, 0, 0), an empty list of a bim text face record, 0, 0, an empty list of a bim icon cell record, an empty bim message catalogue, an empty list of a pointer, -1)
set scene to an empty list of a bim scene mesh record
set sheetCanvas to a new bim canvas
record bim sheet viewport 0 of sheetValue of editor among scene from (a cad vector2 with x 0.0 and y 420.0) at 1.0 using emptyAtlas on (the address of sheetCanvas)
loop cursor from 0 to the length of (sheetCanvas's texts's values):
    set label to the item at cursor in (sheetCanvas's texts's values)
    if (label's message = "3000") or (label's message = "5000"):
        print ((label's message + (the string form of " lettered at degrees ")) + (the string form of (the section heights whole of (label's angle * (180.0 / 3.141592653589793))))) as a line
check section heights (((the section heights count of text (the string form of "3000") on sheetCanvas) = 2) and ((the section heights count of text (the string form of "8000") on sheetCanvas) = 1)) named (the string form of "the chains are on the sheet")
check section heights ((the section heights count of text (the string form of "P") on sheetCanvas) = 2) named (the string form of "peil mark on the ground floor, beside its level's")
check section heights ((the section heights count of text (the string form of "P +3,000") on sheetCanvas) = 2) named (the string form of "peil mark on the upper floor, beside its level's")
check section heights (((the section heights count of text (the string form of "Ridge") on sheetCanvas) = 1) and ((the section heights count of text (the string form of "P +8,000") on sheetCanvas) = 1)) named (the string form of "the ridge is marked at 8 m")
check section heights (((the section heights count of text (the string form of "Ground level") on sheetCanvas) = 1) and ((the section heights count of text (the string form of "P -0,450") on sheetCanvas) = 1)) named (the string form of "the ground (maaiveld) is marked at -0.45 m")
set allBlack to true
loop cursor from 0 to the length of (sheetCanvas's batches's values):
    set recorded to the item at cursor in (sheetCanvas's batches's values)
    if ((recorded's red = 40) and (recorded's green = 60)) and (recorded's blue = 120):
        set allBlack to false
check section heights allBlack named (the string form of "marks are black on paper")

# On screen the section's chains have their paper sizes at its 1:100 as
# well (`record bim dimensions`): drawn at 40 and at 100 pixels to the
# metre (4 and 10 to the paper millimetre), centred elsewhere, every value
# stands where the sheet letters it and is lettered 2.5 mm high at that
# scale, 10 and 25 pixels.
set editor's sectionViewId to sectionId
set heightsCut to the bim section of (editor's evaluation) from (a cad vector2 with x -1.0 and y 3.0) to (a cad vector2 with x 9.0 and y 3.0)
set paperHeightsTransform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 10.0)
set paperHeights to a new bim canvas
set paperHeights's paperScale to 1.0
draw bim heights in section of editor cut heightsCut spanning -1.0 until 9.0 through paperHeightsTransform using (an empty bim message catalogue) on (the address of paperHeights)
set paperValues to the section heights values on paperHeights
set screenZooms to an empty list of a 64 bit floating-point number
append 40.0 to screenZooms
append 100.0 to screenZooms
set screenLettered to an empty list of a 64 bit floating-point number
loop zoomCursor from 0 to the length of screenZooms:
    set zoomScale to the item at zoomCursor in screenZooms
    set screenTransform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 400.0 and y 300.0), (a cad vector2 with x 4.0 and y 4.0), zoomScale)
    set screenHeights to a new bim canvas
    draw bim heights in section of editor cut heightsCut spanning -1.0 until 9.0 through screenTransform using (an empty bim message catalogue) on (the address of screenHeights)
    set screenValues to the section heights values on screenHeights
    set perMillimetre to zoomScale / 10.0
    set worst to 0.0
    if (the length of screenValues) != (the length of paperValues):
        set worst to 1000.0
    else:
        loop valueCursor from 0 to the length of paperValues:
            set paperLabel to the item at valueCursor in paperValues
            set screenLabel to the item at valueCursor in screenValues
            if (paperLabel's message != screenLabel's message) or ((the absolute value of (paperLabel's angle - screenLabel's angle)) > 1e-9):
                set worst to 1000.0
            set modelX to screenTransform's origin's x + ((screenLabel's x - screenTransform's centre's x) / zoomScale)
            set modelY to screenTransform's origin's y - ((screenLabel's y - screenTransform's centre's y) / zoomScale)
            set onPaper to the bim pixel of (a cad vector2 with x modelX and y modelY) through paperHeightsTransform
            set worst to the maximum of worst and (the cad distance from onPaper to (a cad vector2 with x paperLabel's x and y paperLabel's y))
            set screenSize to (the bim lettering size of screenHeights) * (the bim lettering factor of screenLabel)
            set paperSize to (the bim lettering size of paperHeights) * (the bim lettering factor of paperLabel)
            set worst to the maximum of worst and (the absolute value of ((screenSize / perMillimetre) - paperSize))
            if valueCursor = 0:
                append screenSize to screenLettered
    print (((the string form of "section values at ") + (the string form of (the section heights whole of zoomScale))) + ((the string form of " px/m: ") + (the string form of (the length of screenValues)))) as a line
    check section heights ((worst < 1e-6) and ((the length of paperValues) > 0)) named ((the string form of "on screen at ") + ((the string form of (the section heights whole of zoomScale)) + (the string form of " px/m the section's values stand as on its sheet, 2.5 mm high")))
    free screenValues
print (((the string form of "section value lettered at ") + (the string form of (the section heights whole of (the item at 0 in screenLettered)))) + ((the string form of " and ") + ((the string form of (the section heights whole of (the item at 1 in screenLettered))) + (the string form of " px")))) as a line
free screenZooms
free screenLettered
free paperValues
