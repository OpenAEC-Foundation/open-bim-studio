# SPDX-License-Identifier: MPL-2.0
# Sections on sheets (drawing quality plan, item 3). An uncropped section's
# extent is its line and its heights in section coordinates, not the plan's
# footprint. Its levels are black on paper, run across that extent, leave
# out what lies outside it, and carry a peil mark of 3 by 2 paper
# millimetres at any sheet units. A grid's line in a section starts at its
# head's circle. Sections are numbered one above the highest number, also
# after a delete and for a copy; a divided (NCS) head names the sheet that
# places the section; title style 1 writes the section's own number.
import ui/shell/bim_app_parts.dl

function check section sheet {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function section sheet {a 64 bit floating-point number:value} is near {a 64 bit floating-point number:wanted}:
    execute:
        return (the absolute value of (value - wanted)) < 0.001

# The lowest and highest x and y of the first `limit` corners of batch
# `index` of `canvas`.
function the section sheet bounds over {integer:limit} corners of batch {integer:index} on {bim canvas record:canvas}:
    execute:
        set cornerList to (the item at index in (canvas's batches's values))'s pixels's values
        set low to a cad vector2 with x 1e300 and y 1e300
        set high to a cad vector2 with x -1e300 and y -1e300
        loop cursor from 0 to the minimum of limit and (the length of cornerList):
            set point to the item at cursor in cornerList
            set low to a cad vector2 with x (the minimum of low's x and point's x) and y (the minimum of low's y and point's y)
            set high to a cad vector2 with x (the maximum of high's x and point's x) and y (the maximum of high's y and point's y)
        return @intrinsic("construct", a bim sheet frame record, true, low, high)

# How many texts on `canvas` read `wanted`.
function the section sheet count of text {a string:wanted} on {bim canvas record:canvas}:
    execute:
        set found to 0
        loop cursor from 0 to the length of (canvas's texts's values):
            if (the item at cursor in (canvas's texts's values))'s message = wanted:
                set found to found + 1
        return found

# The detail and name of view `viewId`.
function the section sheet label of view {a 64 bit integer:viewId} in {bim model record:modelValue}:
    execute:
        set viewValue to the item at (the bim view index of viewId in modelValue)'s position in (modelValue's views's values)
        return ((the string form of viewValue's detail) + (the string form of " ")) + viewValue's name

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set ground to editor's levelId
set upper to add bim level named (the string form of "First floor") at 3.0 with height 3.0 to target
set roof to add bim level named (the string form of "Roof") at 9.0 with height 3.0 to target
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to layerValues
set brickType to add bim wall type named (the string form of "Brick 200") with layerValues to target
ignore add bim wall typed brickType on ground from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 8.0 and y 0.0) to target
ignore add bim wall typed brickType on upper from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 8.0 and y 0.0) to target
ignore add bim grid named (the string form of "B") from (a cad vector2 with x 5.0 and y -5.0) to (a cad vector2 with x 5.0 and y 5.0) reaching -1.0 to 3.0 to target

# Numbering: one above the highest, also after a delete and for a copy.
set firstSection to add bim section view from (a cad vector2 with x -1.0 and y 2.0) to (a cad vector2 with x 9.0 and y 2.0) to target
ignore add bim section view from (a cad vector2 with x -1.0 and y 3.0) to (a cad vector2 with x 9.0 and y 3.0) to target
ignore add bim section view from (a cad vector2 with x -1.0 and y 4.0) to (a cad vector2 with x 9.0 and y 4.0) to target
ignore delete bim view firstSection from target
set sectionId to add bim section view from (a cad vector2 with x -1.0 and y 2.0) to (a cad vector2 with x 9.0 and y 2.0) to target
print ((the string form of "after a delete: ") + (the section sheet label of view sectionId in editor's documentValue's current)) as a line
set copiedSection to duplicate bim view sectionId named (the string form of "Section 4 (copy)") in target
print ((the string form of "copied: ") + (the section sheet label of view copiedSection in editor's documentValue's current)) as a line
set planId to add bim view of kind bim plan view named (the string form of "Ground floor") on ground to target
set copiedPlan to duplicate bim view planId named (the string form of "Ground floor (copy)") in target
print ((the string form of "copied plan: ") + (the section sheet label of view copiedPlan in editor's documentValue's current)) as a line

# The extent: 1.5 m beyond the line's ends (10 m), from the lowest level
# (0) to the highest level (9; the walls reach 6) with a metre around.
set shownExtent to the bim model extent of view sectionId in editor's documentValue's current
print ((the string form of "extent valid: ") + (the string form of shownExtent's valid)) as a line
check section sheet ((section sheet shownExtent's low's x is near -1.5) and (section sheet shownExtent's high's x is near 11.5)) named (the string form of "section extent runs along its line")
check section sheet ((section sheet shownExtent's low's y is near -1.0) and (section sheet shownExtent's high's y is near 10.0)) named (the string form of "section extent spans the heights")

# The levels on paper at two canvas units to the millimetre, 1:100.
set perMm to 2.0
set levelCanvas to a new bim canvas
set levelCanvas's paperScale to perMm
set levelTransform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), (perMm * 1000.0) / 100.0)
draw bim levels in section of editor spanning -1.5 until 11.5 between -1.0 and 7.0 through levelTransform on (the address of levelCanvas)
print ((the string form of "level batches ") + (the string form of (the length of (levelCanvas's batches's values)))) as a line
set allBlack to true
loop cursor from 0 to the length of (levelCanvas's batches's values):
    set recorded to the item at cursor in (levelCanvas's batches's values)
    if ((recorded's red != 0) or (recorded's green != 0)) or (recorded's blue != 0):
        set allBlack to false
loop cursor from 0 to the length of (levelCanvas's texts's values):
    set label to the item at cursor in (levelCanvas's texts's values)
    if ((label's red != 0) or (label's green != 0)) or (label's blue != 0):
        set allBlack to false
check section sheet allBlack named (the string form of "levels on paper are black")
check section sheet ((the section sheet count of text (the string form of "Roof") on levelCanvas) = 0) named (the string form of "a level above the extent is left out")
check section sheet ((the section sheet count of text (the string form of "First floor") on levelCanvas) = 1) named (the string form of "a level within it is drawn")
set lineBounds to the section sheet bounds over 100000 corners of batch 0 on levelCanvas
check section sheet ((section sheet lineBounds's low's x is near -30.0) and (section sheet lineBounds's high's x is near 230.0)) named (the string form of "level lines span the extent")
# Under NEN the peil mark's filled half (the first level's, three corners)
# is half its 3 mm width and 2 mm high.
set markBounds to the section sheet bounds over 3 corners of batch 1 on levelCanvas
check section sheet (section sheet ((markBounds's high's x - markBounds's low's x) / perMm) is near 1.5) named (the string form of "peil mark half 1.5 mm wide on paper")
check section sheet (section sheet ((markBounds's high's y - markBounds's low's y) / perMm) is near 2.0) named (the string form of "peil mark 2 mm high on paper")
set markLeft to markBounds's low's x
check section sheet (section sheet ((markLeft - lineBounds's high's x) / perMm) is near 0.5) named (the string form of "peil mark beside the line's end, spaced in paper mm")

# A grid in the section, on paper at one unit to the millimetre: its line
# starts at its head's circle, 3 mm below the head's centre.
set shown to editor
set shown's hasSection to true
set shown's sectionViewId to sectionId
set shown's sectionFirst to a cad vector2 with x -1.0 and y 2.0
set shown's sectionSecond to a cad vector2 with x 9.0 and y 2.0
set gridCanvas to a new bim canvas
set gridCanvas's paperScale to 1.0
draw bim grids in section of shown through (@intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 10.0)) on (the address of gridCanvas)
set gridBounds to the section sheet bounds over 100000 corners of batch 0 on gridCanvas
set headBounds to the section sheet bounds over 100000 corners of batch 1 on gridCanvas
print ((the string form of "grid line top below the head's centre (mm/100): ") + (the string form of (((gridBounds's low's y + 30.0) * 100.0) as an integer))) as a line
check section sheet (gridBounds's low's y >= (headBounds's high's y - 0.5)) named (the string form of "grid line starts at its head's circle")

# On sheet A-201, its title with its line, then the sheet's recording.
set sheetId to add bim sheet numbered (the string form of "A-201") named (the string form of "Sections") on paper 2 landscape true to target
ignore place bim view sectionId on sheet sheetId at (a cad vector2 with x 200.0 and y 200.0) looking at (the bim model centre of view sectionId in editor's documentValue's current) in target
ignore place bim view planId on sheet sheetId at (a cad vector2 with x 450.0 and y 200.0) looking at (the bim model centre of view planId in editor's documentValue's current) in target
ignore (set bim viewport 0 on sheet sheetId title type to 1 in target)
ignore (set bim viewport 1 on sheet sheetId title type to 1 in target)
set sheetValue to the item at (the bim sheet index of sheetId in editor's documentValue's current)'s position in (target's sheets's values)
set placedFrame to the bim frame of viewport (the item at 0 in (sheetValue's viewports's values)) in editor's documentValue's current
print ((the string form of "section frame (mm): ") + ((the string form of ((placedFrame's high's x - placedFrame's low's x) as an integer)) + ((the string form of " by ") + (the string form of ((placedFrame's high's y - placedFrame's low's y) as an integer))))) as a line
set emptyAtlas to @intrinsic("construct", a bim text atlas record, @intrinsic("construct", a graphics texture, 0 as a pointer to a byte, 0, 0), an empty list of a bim text face record, 0, 0, an empty list of a bim icon cell record, an empty bim message catalogue, an empty list of a pointer, -1)
set scene to an empty list of a bim scene mesh record
set sheetCanvas to a new bim canvas
record bim sheet viewport 0 of sheetValue of editor among scene from (a cad vector2 with x 0.0 and y 420.0) at 1.0 using emptyAtlas on (the address of sheetCanvas)
record bim sheet viewport 1 of sheetValue of editor among scene from (a cad vector2 with x 0.0 and y 420.0) at 1.0 using emptyAtlas on (the address of sheetCanvas)
check section sheet ((the section sheet count of text (the string form of "4  Section 4  1:100") on sheetCanvas) = 1) named (the string form of "title style 1 writes the section's number")
check section sheet ((the section sheet count of text (the string form of "2  Ground floor  1:100") on sheetCanvas) = 1) named (the string form of "a plan's title keeps its place on the sheet")
set noBlue to true
loop cursor from 0 to the length of (sheetCanvas's batches's values):
    set recorded to the item at cursor in (sheetCanvas's batches's values)
    if ((recorded's red = 40) and (recorded's green = 60)) and (recorded's blue = 120):
        set noBlue to false
check section sheet noBlue named (the string form of "no blue levels on the sheet")
set levelX to 0.0
loop cursor from 0 to the length of (sheetCanvas's texts's values):
    set label to the item at cursor in (sheetCanvas's texts's values)
    if label's message = "First floor":
        set levelX to label's x
check section sheet (section sheet levelX is near (placedFrame's high's x + 4.5)) named (the string form of "level names stand just right of the frame")
check section sheet ((the section sheet count of text (the string form of "Roof") on sheetCanvas) = 1) named (the string form of "every level within the extent is on the sheet")

# The NCS head: the section's number above its divider, the sheet below.
set bim setting (bim drawing standard setting) of (0 as a 64 bit integer) to ((bim ansi standard) as a 64 bit integer) keeping true in target
set marksCanvas to a new bim canvas
set marksCanvas's paperScale to 1.0
draw bim section marks in plan of editor through (@intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 10.0)) on (the address of marksCanvas)
print ((the string form of "head texts naming A-201: ") + (the string form of (the section sheet count of text (the string form of "A-201") on marksCanvas))) as a line
print ((the string form of "head texts numbered 4: ") + (the string form of (the section sheet count of text (the string form of "4") on marksCanvas))) as a line
