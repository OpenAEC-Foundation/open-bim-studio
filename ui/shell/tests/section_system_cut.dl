# SPDX-License-Identifier: MPL-2.0
# A section's plane cuts the parts of a building system, and hatches them.
#
# A curtain wall 6 m long along y 0, 3 m high, in bays of 1.2 by 1.5 m, and
# a section across it at x 3.3, between two mullions. The plane cuts its
# transoms (50 mm high, 150 mm across the wall) and the glass between them
# (24 mm): each is a cut face in section coordinates, the wall's line 1 m
# along the section line. On a canvas each face is filled or hatched as its
# material and outlined in the cut pen. A section beside the wall (x 7)
# cuts nothing.
import ui/shell/bim_app_parts.dl

function check system cut {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
        else:
            print ((the string form of "PASS: ") + label) as a line

function the system cut millimetres of {a 64 bit floating-point number:metres}:
    execute:
        return the string form of ((the rounded value of (metres * 1000.0)) as an integer)

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set systemId to add bim curtain wall on editor's levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 6.0 and y 0.0) rising 3.0 in bays of 1.2 by 1.5 of (the string form of "steel") to target
set sectionId to add bim section view from (a cad vector2 with x 3.3 and y -1.0) to (a cad vector2 with x 3.3 and y 1.0) to target
refresh bim editor (the address of editor)
set sceneList to the bim sketch meshes of editor's documentValue's current
set sectionView to the item at (the bim view index of sectionId in editor's documentValue's current)'s position in (editor's documentValue's current's views's values)
set sectionRules to the bim rules of view sectionView in editor's documentValue's current
set cutFaces to the bim section cut faces of editor among (sceneList's values) in view sectionId under sectionRules from sectionView's lineStart to sectionView's lineFinish
print ((the string form of "cut faces: ") + (the string form of (the length of (cutFaces's values)))) as a line
set widest to 0.0
set narrowest to 1e300
loop faceCursor from 0 to the length of (cutFaces's values):
    set cutFace to the item at faceCursor in (cutFaces's values)
    set lowSpot to the item at 0 in (cutFace's points's values)
    set highSpot to lowSpot
    loop spotCursor from 1 to the length of (cutFace's points's values):
        set spot to the item at spotCursor in (cutFace's points's values)
        set lowSpot to a cad vector2 with x (the minimum of lowSpot's x and spot's x) and y (the minimum of lowSpot's y and spot's y)
        set highSpot to a cad vector2 with x (the maximum of highSpot's x and spot's x) and y (the maximum of highSpot's y and spot's y)
    set widest to the maximum of widest and (highSpot's x - lowSpot's x)
    set narrowest to the minimum of narrowest and (highSpot's x - lowSpot's x)
    set faceLine to ((the string form of "  ") + cutFace's material) + (the string form of ": along ")
    set faceLine to (faceLine + (the system cut millimetres of lowSpot's x)) + (the string form of " to ")
    set faceLine to (faceLine + (the system cut millimetres of highSpot's x)) + (the string form of ", height ")
    set faceLine to (faceLine + (the system cut millimetres of lowSpot's y)) + (the string form of " to ")
    print (faceLine + (the system cut millimetres of highSpot's y)) as a line
check system cut ((the length of (cutFaces's values)) >= 5) named (the string form of "the plane cuts transoms and glass")
check system cut ((the absolute value of (widest - 0.15)) < 0.0001) named (the string form of "a transom is cut 150 mm across the wall")
check system cut ((the absolute value of (narrowest - 0.024)) < 0.0001) named (the string form of "the glass is cut 24 mm thick")
set screenTransform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 100.0)
set cutCanvas to a new bim canvas
draw bim system cut faces (cutFaces's values) of view sectionId in editor's documentValue's current through screenTransform on (the address of cutCanvas)
check system cut ((the length of (cutCanvas's batches's values)) >= 2) named (the string form of "the faces are filled and outlined on the canvas")
set besideFaces to the bim section cut faces of editor among (sceneList's values) in view sectionId under sectionRules from (a cad vector2 with x 7.0 and y -1.0) to (a cad vector2 with x 7.0 and y 1.0)
check system cut ((the length of (besideFaces's values)) = 0) named (the string form of "a section beside the wall cuts nothing")
