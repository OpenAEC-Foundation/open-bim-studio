# SPDX-License-Identifier: MPL-2.0
import ui/shell/bim_plan_zoom.dl
import lib/string.dl
function require plan replay {boolean:condition}:
    execute:
        if condition = false:
            print "FAIL: retained plan zoom" as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
set state to a bim plan zoom starting at 40.0
set state to the bim plan zoom state following 60.0 at (1000 as a 64 bit integer)
require plan replay ((the bim plan recording scale of state at (100000 as a 64 bit integer)) = 40.0)
set state to the bim plan zoom state following 90.0 at (100000 as a 64 bit integer)
require plan replay ((the bim plan recording scale of state at (200000 as a 64 bit integer)) = 40.0)
require plan replay ((the bim plan recording scale of state at (250001 as a 64 bit integer)) = 40.0)
set state's recordedScale to 90.0
require plan replay ((the bim plan recording scale of state at (260000 as a 64 bit integer)) = 90.0)
# A forced content rebuild during motion becomes the retained scale at once.
set state to the bim plan zoom state following 135.0 at (300000 as a 64 bit integer)
set state's recordedScale to 135.0
require plan replay ((the bim plan recording scale of state at (310000 as a 64 bit integer)) = 135.0)
print "PASS: wheel bursts and idle reuse the recording while content updates establish a new scale" as a line
# A model point at 2 m was pixel 180 in a 40 px/m recording with origin 100.
# At 90 px/m and current origin -80 it must land at pixel 100.
set shift to the bim plan replay offset of -80.0 from 100.0 scaled by 2.25
require plan replay ((the absolute value of (((180.0 * 2.25) + shift) - 100.0)) < 1e-10)
print "PASS: scaled replay follows the current model origin while panning and zooming" as a line
