# SPDX-License-Identifier: MPL-2.0
# Where an export is written (`the bim export path of`): in the folder of
# the model's file, whichever way its path is written, and in the working
# folder while the model has no file.
import ui/shell/bim_app_parts.dl

print (the bim export path of (the string form of "A-101.pdf") beside (the string form of "/home/someone/projects/house/house.ifcx")) as a line
print (the bim export path of (the string form of "A-101.pdf") beside (the string form of "C:\\projects\\house\\house.ifcx")) as a line
print (the bim export path of (the string form of "A-101.pdf") beside (the string form of "house.ifcx")) as a line
print (the bim export path of (the string form of "A-101.pdf") beside (the string form of "")) as a line

# A sheet's export carries the model file's name.
print (the bim export name of (the string form of "A-101.pdf") for model (the string form of "/home/someone/projects/house/house.ifcx")) as a line
print (the bim export name of (the string form of "A-101.pdf") for model (the string form of "C:\\projects\\house\\villa.v2.ifcx")) as a line
print (the bim export name of (the string form of "A-101.pdf") for model (the string form of "house")) as a line
print (the bim export name of (the string form of "A-101.pdf") for model (the string form of "")) as a line

# The stem the editor's own exports (IFC) are named with.
print (the bim export stem of (the string form of "/home/someone/projects/house/house.ifcx")) as a line
print (the bim export stem of (the string form of "/home/someone/projects.v2/house")) as a line
print ((the string form of "[") + ((the bim export stem of (the string form of "")) + (the string form of "]"))) as a line
