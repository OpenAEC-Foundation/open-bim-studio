# SPDX-License-Identifier: MPL-2.0
# A sheet's plan viewport draws the plan the live plan draws, for its view's
# own storey (drawing quality plan, item 6): an upper storey's sheet
# recorded while the editor shows the ground floor shows the upper storey's
# rooms, its slab and roof edges (the roof dashed as a hidden line), the
# NEN 2580 area measures its drawing type asks for, and the imported
# elements of its storey only. The live plan records through the same
# functions. A plan view placed on a sheet (PV) lands in the sheet's clear
# area, clear of the title block and the legend.
import ui/shell/bim_app_parts.dl

function check sheet parity {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

# How many texts on `canvas` read `wanted`.
function the parity count of text {a string:wanted} on {bim canvas record:canvas}:
    execute:
        set found to 0
        loop cursor from 0 to the length of (canvas's texts's values):
            if (the item at cursor in (canvas's texts's values))'s message = wanted:
                set found to found + 1
        return found

# How many corners the batches of `canvas` hold together.
function the parity corner sum of {bim canvas record:canvas}:
    execute:
        set cornerSum to 0
        loop cursor from 0 to the length of (canvas's batches's values):
            set cornerSum to cornerSum + (the length of ((the item at cursor in (canvas's batches's values))'s pixels's values))
        return cornerSum

# How many batches of `canvas` hold exactly `wanted` corners.
function the parity batches of {integer:wanted} corners on {bim canvas record:canvas}:
    execute:
        set found to 0
        loop cursor from 0 to the length of (canvas's batches's values):
            if (the length of ((the item at cursor in (canvas's batches's values))'s pixels's values)) = wanted:
                set found to found + 1
        return found

# Four walls of `typeId` on `levelId` around the rectangle from the origin
# to `across`, `deep`, on their centre lines.
function add parity rectangle typed {a 64 bit integer:typeId} on {a 64 bit integer:levelId} spanning {a 64 bit floating-point number:across} by {a 64 bit floating-point number:deep} to {a pointer to a bim model record:target}:
    execute:
        ignore add bim wall typed typeId on levelId from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x across and y 0.0) to target
        ignore add bim wall typed typeId on levelId from (a cad vector2 with x across and y 0.0) to (a cad vector2 with x across and y deep) to target
        ignore add bim wall typed typeId on levelId from (a cad vector2 with x across and y deep) to (a cad vector2 with x 0.0 and y deep) to target
        ignore add bim wall typed typeId on levelId from (a cad vector2 with x 0.0 and y deep) to (a cad vector2 with x 0.0 and y 0.0) to target

# The square from `low` to `high` on both axes, as a plan outline.
function the parity square from {a 64 bit floating-point number:low} to {a 64 bit floating-point number:high}:
    execute:
        set squareCorners to an empty list of a cad vector2
        append (a cad vector2 with x low and y low) to squareCorners
        append (a cad vector2 with x high and y low) to squareCorners
        append (a cad vector2 with x high and y high) to squareCorners
        append (a cad vector2 with x low and y high) to squareCorners
        return squareCorners

# An imported element (a wall) of one upright triangle that rises from
# `base` 0.2 m above to 2 m above it, so that a plan cut 1.2 m above `base`
# crosses it once.
function the parity imported element {integer:ordinal} standing at {a 64 bit floating-point number:base}:
    execute:
        set shape to an empty fast mesh
        append (a cad vector3 with x 1.0, y 1.0 and z (base + 0.2)) to (shape's positions's values)
        append (a cad vector3 with x 3.0, y 1.0 and z (base + 0.2)) to (shape's positions's values)
        append (a cad vector3 with x 2.0, y 1.0 and z (base + 2.0)) to (shape's positions's values)
        loop corner from 0 to 3:
            append (a cad vector3 with x 0.0, y -1.0 and z 0.0) to (shape's normals's values)
            append corner to (shape's triangles's values)
        return @intrinsic("construct", a bim scene mesh record, (the bim imported id base) + (ordinal as a 64 bit integer), 0 as a 64 bit integer, 0, shape, bim wall category, the bim category colouring, the string form of "")

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set ground to editor's levelId
set upper to add bim level named (the string form of "First floor") at 3.0 with height 3.0 to target
set layerValues to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "brick", 0.2)) to layerValues
set brickType to add bim wall type named (the string form of "Brick 200") with layerValues to target
free layerValues
# The ground floor 11 by 13 m (a room of 10.8 by 12.8 m), the first floor
# 4 by 4 m (3.8 by 3.8 m).
add parity rectangle typed brickType on ground spanning 11.0 by 13.0 to target
add parity rectangle typed brickType on upper spanning 4.0 by 4.0 to target
# The first floor's floor slab and a roof over it, both 5 by 5 m.
set floorOutline to the parity square from -0.5 to 4.5
set floorId to add bim slab on upper around floorOutline thick 0.2 to target
set roofLayers to an empty list of a bim layer record
append (@intrinsic("construct", a bim layer record, the string form of "timber", 0.2)) to roofLayers
set roofType to add bim planar type named (the string form of "Flat roof") as role bim roof planar role with roofLayers to target
free roofLayers
set roofId to add bim plate typed roofType on upper around floorOutline at top 6.0 to target
print ((the string form of "slab and roof made: ") + (the string form of ((floorId != the bim refused id) and (roofId != the bim refused id)))) as a line
set groundPlan to add bim view of kind bim plan view named (the string form of "Ground floor") on ground to target
set upperPlan to add bim view of kind bim plan view named (the string form of "First floor") on upper to target
set editor's planViewId to groundPlan
refresh bim editor (the address of editor)
set standardCode to the bim drawing standard of editor's documentValue's current
set groundRoom to the bim room area text of (10.8 * 12.8) under standardCode
set upperRoom to the bim room area text of (3.8 * 3.8) under standardCode
print ((the string form of "editor on the ground floor: ") + (the string form of (editor's levelId = ground))) as a line

# The live plan of the ground floor, recorded on screen by the shared
# functions, labels the ground floor's room.
set screenTransform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 40.0)
set screenCanvas to a new bim canvas
set noLines to an empty list of a cad vector2
set screenStairs to an empty bim curtain plan cache
set scene to an empty list of a bim scene mesh record
set emptyAtlas to @intrinsic("construct", a bim text atlas record, @intrinsic("construct", a graphics texture, 0 as a pointer to a byte, 0, 0), an empty list of a bim text face record, 0, 0, an empty list of a bim icon cell record, an empty bim message catalogue, an empty list of a pointer, -1)
record bim plan of editor cut as editor's plan among scene with linked noLines and noLines keeping (the address of screenStairs) through screenTransform using emptyAtlas on (the address of screenCanvas)
record bim plan symbols of editor through screenTransform lettered at 13.0 on (the address of screenCanvas)
check sheet parity ((the parity count of text groundRoom on screenCanvas) = 1) named (the string form of "the live plan labels the ground floor's room")

# The first floor on sheet A-102, recorded while the editor stays on the
# ground floor.
set upperSheetId to add bim sheet numbered (the string form of "A-102") named (the string form of "First floor") on paper 3 landscape true to target
ignore place bim view upperPlan on sheet upperSheetId at (a cad vector2 with x 120.0 and y 170.0) looking at (the bim model centre of view upperPlan in editor's documentValue's current) in target
set upperSheet to the item at (the bim sheet index of upperSheetId in editor's documentValue's current)'s position in (target's sheets's values)
set upperCanvas to a new bim canvas
record bim sheet viewport 0 of upperSheet of editor among scene from (a cad vector2 with x 0.0 and y 297.0) at 1.0 using emptyAtlas on (the address of upperCanvas)
print ((the string form of "first floor sheet rooms: ") + (the string form of (the parity count of text upperRoom on upperCanvas))) as a line
check sheet parity ((the parity count of text upperRoom on upperCanvas) = 1) named (the string form of "the sheet shows the first floor's room")
check sheet parity ((the parity count of text groundRoom on upperCanvas) = 0) named (the string form of "and not the ground floor's, which the editor shows")
check sheet parity (editor's levelId = ground) named (the string form of "the editor stays on the ground floor")

# Its slab and roof edges, as the sheet records them: the floor's in the
# visible pen (0.25 mm), the roof's dashed in the hidden pen (0.18 mm), 2 mm
# dashes with 1 mm gaps, black.
set shown to editor
set shown's levelId to upper
set shown's planViewId to upperPlan
set upperView to the item at (the bim view index of upperPlan in editor's documentValue's current)'s position in (editor's documentValue's current's views's values)
set shown's planRules to the bim rules of view upperView in editor's documentValue's current
set paperTransform to @intrinsic("construct", a bim drawing transform record, (a cad vector2 with x 0.0 and y 0.0), (a cad vector2 with x 0.0 and y 0.0), 10.0)
set edgeCanvas to a new bim canvas
set edgeCanvas's paperScale to 1.0
record bim slab edges of shown through paperTransform on (the address of edgeCanvas)
print ((the string form of "slab edge batches: ") + (the string form of (the length of (edgeCanvas's batches's values)))) as a line
set floorEdges to the item at 0 in (edgeCanvas's batches's values)
set roofEdges to the item at 1 in (edgeCanvas's batches's values)
print ((the string form of "floor edge segments: ") + (the string form of ((the length of (floorEdges's pixels's values)) / 6))) as a line
print ((the string form of "roof edge dashes: ") + (the string form of ((the length of (roofEdges's pixels's values)) / 6))) as a line
check sheet parity (((the absolute value of (floorEdges's breadth - 0.25)) < 1e-9) and ((the absolute value of (roofEdges's breadth - 0.18)) < 1e-9)) named (the string form of "floor edges in the visible pen, the roof's in the hidden pen")
check sheet parity ((((floorEdges's red + floorEdges's green) + floorEdges's blue) + ((roofEdges's red + roofEdges's green) + roofEdges's blue)) = 0) named (the string form of "slab and roof edges are black on paper")
check sheet parity ((the parity batches of (the length of (roofEdges's pixels's values)) corners on upperCanvas) = 1) named (the string form of "the sheet records the roof's dashed edges")
check sheet parity ((the parity batches of (the length of (floorEdges's pixels's values)) corners on upperCanvas) >= 1) named (the string form of "the sheet records the floor's edges")

# The imported elements of its storey only: one on the first floor, one on
# the ground floor.
set elementsBefore to the parity corner sum of upperCanvas
set importedList to a cad topology list of a bim scene mesh record
append (the parity imported element 0 standing at 3.0) to (importedList's values)
append (the parity imported element 1 standing at 0.0) to (importedList's values)
set storeyList to a cad topology list of a 64 bit floating-point number
append 3.0 to (storeyList's values)
append 0.0 to (storeyList's values)
set editor's importedMeshes to importedList
set editor's importedStoreys to storeyList
set shown to editor
set shown's levelId to upper
set shown's planViewId to upperPlan
set shown's planRules to the bim rules of view upperView in editor's documentValue's current
set upperCut to an empty list of a cad vector2
set upperBelow to an empty list of a cad vector2
append bim linked element lines of shown into upperCut and upperBelow
print ((the string form of "first floor imported cut points: ") + (the string form of (the length of upperCut))) as a line
if (the length of upperCut) = 2:
    print ((the string form of "cut across (cm): ") + ((the string form of (((the item at 0 in upperCut)'s x * 100.0) as an integer)) + ((the string form of " to ") + (the string form of (((the item at 1 in upperCut)'s x * 100.0) as an integer))))) as a line
set linkedCanvas to a new bim canvas
record bim sheet viewport 0 of upperSheet of editor among scene from (a cad vector2 with x 0.0 and y 297.0) at 1.0 using emptyAtlas on (the address of linkedCanvas)
check sheet parity ((the parity corner sum of linkedCanvas) > elementsBefore) named (the string form of "the sheet draws the imported element of its storey")
set groundOnly to a cad topology list of a bim scene mesh record
append (the item at 1 in (importedList's values)) to (groundOnly's values)
set groundStorey to a cad topology list of a 64 bit floating-point number
append 0.0 to (groundStorey's values)
set editor's importedMeshes to groundOnly
set editor's importedStoreys to groundStorey
set otherCanvas to a new bim canvas
record bim sheet viewport 0 of upperSheet of editor among scene from (a cad vector2 with x 0.0 and y 297.0) at 1.0 using emptyAtlas on (the address of otherCanvas)
check sheet parity ((the parity corner sum of otherCanvas) = elementsBefore) named (the string form of "and none of another storey")
set editor's importedMeshes to a cad topology list of a bim scene mesh record
set editor's importedStoreys to a cad topology list of a 64 bit floating-point number

# The NEN 2580 area measures where the plan's drawing type asks for them.
ensure bim drawing types in target
set areaType to the bim drawing type named (the string form of "Area plan") in editor's documentValue's current
set upperView to the item at (the bim view index of upperPlan in editor's documentValue's current)'s position in (editor's documentValue's current's views's values)
set upperView's drawingTypeId to areaType
store bim view upperView in target
set areaSheet to the item at (the bim sheet index of upperSheetId in editor's documentValue's current)'s position in (target's sheets's values)
set areaCanvas to a new bim canvas
record bim sheet viewport 0 of areaSheet of editor among scene from (a cad vector2 with x 0.0 and y 297.0) at 1.0 using emptyAtlas on (the address of areaCanvas)
check sheet parity ((the parity count of text (the string form of "NEN 2580  First floor") on areaCanvas) = 1) named (the string form of "an area plan's sheet carries its NEN 2580 table")
check sheet parity ((the parity count of text (the string form of "NEN 2580  First floor") on upperCanvas) = 0) named (the string form of "a plain plan's sheet does not")

# The ground floor placed on sheet A-101 (A3 landscape) by PV: its frame
# (180 by 200 mm at 1:100) in the clear area left of the title block,
# clear of the title block and the legend.
set groundSheetId to add bim sheet numbered (the string form of "A-101") named (the string form of "Ground floor") on paper 3 landscape true to target
set editor's sheetId to groundSheetId
place bim editor view on sheet in (the address of editor)
set groundSheet to the item at (the bim sheet index of groundSheetId in editor's documentValue's current)'s position in (editor's documentValue's current's sheets's values)
print ((the string form of "viewports on A-101: ") + (the string form of (the length of (groundSheet's viewports's values)))) as a line
set placedFrame to the bim frame of viewport (the item at 0 in (groundSheet's viewports's values)) in editor's documentValue's current
print ((the string form of "placed frame (mm): ") + ((((the string form of (placedFrame's low's x as an integer)) + (the string form of ",")) + (the string form of (placedFrame's low's y as an integer))) + ((the string form of " to ") + (((the string form of (placedFrame's high's x as an integer)) + (the string form of ",")) + (the string form of (placedFrame's high's y as an integer)))))) as a line
set titleFrame to the bim title block of sheet groundSheet in editor's documentValue's current
set legendFrame to the bim legend block of sheet groundSheet in editor's documentValue's current
check sheet parity ((bim frame placedFrame overlaps frame titleFrame) = false) named (the string form of "the placed plan lies clear of the title block")
check sheet parity (legendFrame's valid and ((bim frame placedFrame overlaps frame legendFrame) = false)) named (the string form of "and of the legend")
set placementFault to the bim placement fault of sheet groundSheet in editor's documentValue's current
print ((the string form of "placement fault: [") + (placementFault + (the string form of "]"))) as a line
# The sheet's middle, where PV used to put it, would cover the legend.
set oldMiddle to a cad vector2 with x 210.0 and y ((297.0 + 50.0) * 0.5)
set oldFrame to the bim frame of viewport (@intrinsic("construct", a bim viewport record, groundPlan, oldMiddle, the bim model centre of view groundPlan in editor's documentValue's current)) in editor's documentValue's current
print ((the string form of "the sheet's middle would cover the legend: ") + (the string form of (bim frame oldFrame overlaps frame legendFrame))) as a line
