# SPDX-License-Identifier: MPL-2.0
# The project's settings (`bim_project_settings.dl`): units, decimals,
# georeferencing and true north set from the properties panel (nothing
# selected), kept as the project's settings, and written to IFC: the
# currency in the unit assignment, the context's true north, IfcProjectedCRS
# and IfcMapConversion, and the OBS_ProjectSettings property set.
import editor/bim_editor.dl

function show settings test rows of {bim editor record:editor}:
    execute:
        set propertyRows to the bim property rows of editor
        set shown to false
        loop cursor from 0 to the length of propertyRows:
            set propertyRow to the item at cursor in propertyRows
            if propertyRow's label = (the string form of "Units"):
                set shown to true
            if shown:
                print ((the string form of "  ") + ((propertyRow's label + (the string form of ": ")) + propertyRow's value)) as a line
        free propertyRows

function type settings test {integer:code} as {a string:typedText} in {a pointer to a bim editor record:editor}:
    execute:
        start bim editor property code in editor
        set editor's propertyText to typedText
        apply bim editor property in editor

set editor to a new bim editor
set e to the address of editor
print (the string form of "defaults:") as a line
show settings test rows of editor
# Metres (two clicks: mm, cm, m), US dollars, RD New with the origin in Delft,
# north 12.5 degrees, three decimals (metres show two unless set).
start bim editor property (bim project length unit property) in e
start bim editor property (bim project length unit property) in e
start bim editor property (bim project currency property) in e
type settings test (bim project crs property) as (the string form of "28992") in e
type settings test (bim project eastings property) as (the string form of "84500") in e
type settings test (bim project northings property) as (the string form of "447000.25") in e
type settings test (bim project north property) as (the string form of "12.5") in e
type settings test (bim project decimals property) as (the string form of "3") in e
print (the string form of "set:") as a line
show settings test rows of editor
print ((the string form of "editor shows lengths in ") + (the bim name of unit editor's lengthUnit)) as a line
set ifcText to the bim ifc text of editor's documentValue's current
set lines to ifcText split at "\n"
loop cursor from 0 to the length of lines:
    set line to the item at cursor in lines
    if ((((the index of (the string form of "IFCMONETARYUNIT") in line) >= 0) or ((the index of (the string form of "IFCPROJECTEDCRS") in line) >= 0)) or (((the index of (the string form of "IFCMAPCONVERSION") in line) >= 0) or ((the index of (the string form of "OBS_ProjectSettings") in line) >= 0))) or ((the index of (the string form of "IFCPROPERTYSINGLEVALUE") in line) >= 0):
        set equals to the index of (the string form of "=") in line
        print (the substring of line from (equals + 1) spanning ((the length of line) - (equals + 1)) bytes) as a line
free lines
# Undone one by one: the decimals go first.
ignore undo bim transaction in (the address of (editor's documentValue))
print ((the string form of "after one undo, decimals ") + (the string form of (the bim project decimals of editor's documentValue's current))) as a line
