# SPDX-License-Identifier: MPL-2.0
# Height dimensions (2462) in a section of a steel frame: two columns 12 m
# apart from the ground floor to the roof level at 6 m, and a beam on them.
# The section cuts no wall and no plate, yet its chains see the columns and
# the beam: floor to floor, 6000 from the ground floor to the roof level. A
# section that looks away from the frame (it lies behind its line) and one
# beside it, past its ends, make none.
import ui/shell/bim_app_parts.dl

function the frame heights whole of {a 64 bit floating-point number:amount}:
    execute:
        return (@intrinsic("call", "libc", "round", a 64 bit floating-point number, amount)) as a 64 bit integer

function show frame heights of view {a 64 bit integer:viewId} in {bim model record:modelValue}:
    execute:
        loop cursor from 0 to the length of (modelValue's dimensions's values):
            set dimensionValue to the item at cursor in (modelValue's dimensions's values)
            if dimensionValue's viewId = viewId:
                set measured to the bim measure of dimensionValue in modelValue
                print ((((the string form of "  ") + (the string form of (the frame heights whole of dimensionValue's paperOffset))) + (the string form of " mm off: ")) + (the string form of (the frame heights whole of (measured's value * 1000.0)))) as a line

set editor to a new bim editor
set target to the address of (editor's documentValue's current)
set ground to editor's levelId
ignore add bim level named (the string form of "Roof") at 6.0 with height 3.0 to target
set columnType to add bim linear type named (the string form of "Column 200") as role bim column role sized 0.2 by 0.2 round false of (the string form of "steel") to target
set beamType to add bim linear type named (the string form of "Beam 330") as role bim beam role sized 0.16 by 0.33 round false of (the string form of "steel") to target
ignore add bim linear typed columnType on ground from (a cad vector3 with x 0.0, y 0.0 and z 0.0) to (a cad vector3 with x 0.0, y 0.0 and z 6.0) turned 0.0 to target
ignore add bim linear typed columnType on ground from (a cad vector3 with x 0.0, y 12.0 and z 0.0) to (a cad vector3 with x 0.0, y 12.0 and z 6.0) turned 0.0 to target
ignore add bim linear typed beamType on ground from (a cad vector3 with x 0.0, y 0.0 and z 6.0) to (a cad vector3 with x 0.0, y 12.0 and z 6.0) turned 0.0 to target
prepare bim editor views in (the address of editor)
# Along the frame, 1 m in front of it and looking at it: a section looks to
# the left of its line, so this one runs down the y axis at x = -1.
set facingId to add bim section view from (a cad vector2 with x -1.0 and y 13.0) to (a cad vector2 with x -1.0 and y -1.0) to target
# The same line the other way looks away from the frame.
set awayId to add bim section view from (a cad vector2 with x -1.0 and y -1.0) to (a cad vector2 with x -1.0 and y 13.0) to target
# And one past the frame's end.
set pastId to add bim section view from (a cad vector2 with x -1.0 and y 30.0) to (a cad vector2 with x -1.0 and y 20.0) to target
refresh bim editor (the address of editor)

show bim editor section view facingId in (the address of editor)
type bim editor key 2462 in (the address of editor)
print editor's message as a line
show frame heights of view facingId in editor's documentValue's current
show bim editor section view awayId in (the address of editor)
type bim editor key 2462 in (the address of editor)
print editor's message as a line
show bim editor section view pastId in (the address of editor)
type bim editor key 2462 in (the address of editor)
print editor's message as a line
