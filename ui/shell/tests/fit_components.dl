# SPDX-License-Identifier: MPL-2.0
import ui/shell/bim_app_parts.dl
import elements/object/bim_component_benchmark.dl
import exchange/ifcx/bim_ifcx.dl
import exchange/ifcx/bim_file.dl
set editor to a new bim editor
set editor's documentValue's current to the bim component benchmark with 1 placements
set target to the address of editor's documentValue's current
set instance to the item at 0 in target's instances's values
set instance's origin to a cad vector2 with x 100.0 and y 200.0
set instance's angle to 1.5707963267948966
replace item at index 0 in target's instances's values with instance
ignore set bim instance instance's id rise to 12.0 in target
set layout to @intrinsic("construct", a bim screen layout record, 1200.0, 800.0, 0.0, 600.0, 100.0, 750.0)
set camera to @intrinsic("construct", a bim camera record, (a cad vector2 with x 0.0 and y 0.0), 1.0, 0.5, 0.5, (a cad vector3 with x 0.0, y 0.0 and z 0.0), 1.0)
set fitted to the bim camera fitting editor in layout keeping camera
if ((the absolute value of (fitted's target's x - 99.5)) > 1e-6) or (((the absolute value of (fitted's target's y - 200.5)) > 1e-6) or ((the absolute value of (fitted's target's z - 12.5)) > 1e-6)):
    print "FAIL: rotated raised component-only document fit" as a line
    @intrinsic("call", "libc", "exit", nothing, 1)
print "PASS: fit includes rotated shared solid components and instance rise" as a line

set exported to the bim ifcx text of editor's documentValue's current identified as (the string form of "component-rise") for project (the string form of "component-rise") by (the string form of "OpenAEC") at (the string form of "2026-11-02T00:00:00Z")
if (write bim text exported to file (the string form of "build/component-rise.ifcx")) = false:
    @intrinsic("call", "libc", "exit", nothing, 1)
