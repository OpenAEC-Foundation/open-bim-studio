# SPDX-License-Identifier: MPL-2.0
# The actual popup controller always reads millimetres, in projects displayed
# in mm, cm or m; it keeps the selected plus side and atomic undo/redo.
import ui/shell/bim_grid_spacing.dl

function require grid popup {boolean:passed} named {a string:label}:
    execute:
        if passed = false:
            print ((the string form of "FAIL: ") + label) as a line
            @intrinsic("call", "libc", "exit", nothing, 1)
        print ((the string form of "PASS: ") + label) as a line

function check grid popup in project unit {integer:unitCode}:
    execute:
        set editor to a new bim editor
        set editor's lengthUnit to unitCode
        set target to the address of (editor's documentValue's current)
        set sourceId to add bim grid named (the string form of "1") from (a cad vector2 with x 0.0 and y 0.0) to (a cad vector2 with x 0.0 and y 10.0) reaching -2.0 to 12.0 to target
        set beforeUndo to the length of (editor's documentValue's undoStack's values)
        set added to add bim grids from spacing popup for sourceId toward 1.0 using (the string form of "4 x 5400") in (the address of editor)
        require grid popup (added = 4) named ((the string form of "four copies in project unit ") + (the string form of unitCode))
        set lastGrid to the last item of (editor's documentValue's current's grids's values)
        require grid popup ((the absolute value of (lastGrid's start's x - 21.6)) < 0.000000001) named (the string form of "5400 always means 5.4 metres")
        require grid popup ((lastGrid's low = -2.0) and (lastGrid's high = 12.0)) named (the string form of "copies retain the vertical extent")
        require grid popup ((the length of (editor's documentValue's undoStack's values)) = (beforeUndo + 1)) named (the string form of "the batch is one undo step")
        ignore undo bim transaction in (the address of (editor's documentValue))
        set beforeId to editor's documentValue's current's nextId
        set beforeRedo to the length of (editor's documentValue's redoStack's values)
        set refused to add bim grids from spacing popup for sourceId toward 1.0 using (the string form of "5400 junk") in (the address of editor)
        require grid popup ((refused = 0) and ((editor's documentValue's current's nextId = beforeId) and ((the length of (editor's documentValue's redoStack's values)) = beforeRedo))) named (the string form of "invalid input keeps redo and element IDs")
        ignore redo bim transaction in (the address of (editor's documentValue))
        require grid popup ((the length of (editor's documentValue's current's grids's values)) = 5) named (the string form of "redo restores every copy")
        set opposite to add bim grids from spacing popup for sourceId toward -1.0 using (the string form of "2*1000") in (the address of editor)
        set lastOpposite to the last item of (editor's documentValue's current's grids's values)
        require grid popup ((opposite = 2) and ((the absolute value of (lastOpposite's start's x + 2.0)) < 0.000000001)) named (the string form of "the other plus adds on the opposite side")

require grid popup ((bim grid spacing popup unit) = bim millimetre unit) named (the string form of "the popup labels its input as millimetres")
check grid popup in project unit 0
check grid popup in project unit 1
check grid popup in project unit 2
