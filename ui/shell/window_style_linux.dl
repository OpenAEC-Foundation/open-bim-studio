# SPDX-License-Identifier: MPL-2.0
# Linux/X11 per-window decoration preference. The desktop remains untouched;
# a window manager may ignore this hint. This module targets the shipped
# GLFW X11 backend, not a Wayland-only GLFW library.
# ABI: Display* and GLFWwindow* are pointers; Window/Atom are unsigned long.
# Link the shipped X11 ABI directly; its runtime library is already needed
# by GLFW, while the unversioned libX11.so requires a development package.
# https://www.glfw.org/docs/3.3/group__native.html
# https://xorg.freedesktop.org/archive/current/doc/libX11/libX11/libX11.html
import viewer/vulkan/graphics.dl

function use bim window frame dark {boolean:darkChoice} on {pointer:windowValue}:
    execute:
        if windowValue = (0 as a pointer):
            return nothing
        set gpuState to the gpu context of windowValue
        if gpuState's window = (0 as a pointer):
            return nothing
        set xDisplay to @intrinsic("call", "glfw", "glfwGetX11Display", a pointer)
        if xDisplay = (0 as a pointer):
            return nothing
        set xWindow to @intrinsic("call", "glfw", "glfwGetX11Window", a word sized unsigned integer, gpuState's window)
        if xWindow = (0 as a word sized unsigned integer):
            return nothing
        set hintName to the string form of "_GTK_THEME_VARIANT"
        set typeName to the string form of "UTF8_STRING"
        set hintAtom to @intrinsic("call", ":libX11.so.6", "XInternAtom", a word sized unsigned integer, xDisplay, the data of hintName, 0)
        set typeAtom to @intrinsic("call", ":libX11.so.6", "XInternAtom", a word sized unsigned integer, xDisplay, the data of typeName, 0)
        if (hintAtom = (0 as a word sized unsigned integer)) or (typeAtom = (0 as a word sized unsigned integer)):
            return nothing
        if darkChoice = false:
            # Removing the override restores the window manager's default
            # decoration; GTK does not promise a variant named "light".
            ignore @intrinsic("call", ":libX11.so.6", "XDeleteProperty", a 32 bit integer, xDisplay, xWindow, hintAtom)
            ignore @intrinsic("call", ":libX11.so.6", "XFlush", a 32 bit integer, xDisplay)
            return nothing
        set darkValue to the string form of "dark"
        # format=8, PropModeReplace=0; no terminating NUL in the property.
        ignore @intrinsic("call", ":libX11.so.6", "XChangeProperty", a 32 bit integer, xDisplay, xWindow, hintAtom, typeAtom, 8, 0, the data of darkValue, 4)
        ignore @intrinsic("call", ":libX11.so.6", "XFlush", a 32 bit integer, xDisplay)
