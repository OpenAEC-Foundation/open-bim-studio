# SPDX-License-Identifier: MPL-2.0
# A common grid height, with explicit per-line overrides (#62). Existing
# line ranges survive loading; an unmarked line shares the default only
# when its range matches it. Settings store common heights in micrometres.
import bim/bim_model.dl

function bim grid common base setting:
    replacement:
        2400421
function bim grid common top setting:
    replacement:
        2400422
function bim grid height mode setting:
    replacement:
        2400423

function bim grid height from {a 64 bit floating-point number:lowValue} to {a 64 bit floating-point number:highValue} is valid:
    execute:
        return ((the absolute value of lowValue) < 1000000000.0) and (((the absolute value of highValue) < 1000000000.0) and (highValue > lowValue))

function the bim common grid height of {bim model record:modelValue}:
    execute:
        set lowest to 0.0
        set highest to 3.0
        loop cursor from 0 to the length of (modelValue's levels's values):
            set levelValue to the item at cursor in (modelValue's levels's values)
            if cursor = 0:
                set lowest to levelValue's elevation
                set highest to levelValue's elevation + levelValue's height
            set lowest to the minimum of lowest and levelValue's elevation
            set highest to the maximum of highest and (levelValue's elevation + levelValue's height)
        set baseReading to the bim setting (bim grid common base setting) of (0 as a 64 bit integer) in modelValue
        set topReading to the bim setting (bim grid common top setting) of (0 as a 64 bit integer) in modelValue
        if baseReading's found and topReading's found:
            set savedBase to (baseReading's value as a 64 bit floating-point number) / 1000000.0
            set savedTop to (topReading's value as a 64 bit floating-point number) / 1000000.0
            if bim grid height from savedBase to savedTop is valid:
                return a cad vector2 with x savedBase and y savedTop
        return a cad vector2 with x lowest and y highest

function bim grid {bim grid record:gridValue} shares the common height in {bim model record:modelValue}:
    execute:
        set mode to the bim setting (bim grid height mode setting) of gridValue's id in modelValue
        if mode's found:
            return mode's value = (0 as a 64 bit integer)
        set commonHeight to the bim common grid height of modelValue
        return ((the absolute value of (gridValue's low - commonHeight's x)) < 0.000001) and ((the absolute value of (gridValue's high - commonHeight's y)) < 0.000001)

function set bim grid {a 64 bit integer:gridId} height from {a 64 bit floating-point number:lowValue} to {a 64 bit floating-point number:highValue} sharing common {boolean:shared} in {a pointer to a bim model record:target}:
    execute:
        set found to the bim grid index of gridId in (@intrinsic("dereference", target))
        if (found's valid = false) or ((bim grid height from lowValue to highValue is valid) = false):
            return false
        set gridValue to the item at found's position in (target's grids's values)
        set gridValue's low to lowValue
        set gridValue's high to highValue
        replace item at index found's position in (target's grids's values) with gridValue
        set modeValue to 1 as a 64 bit integer
        if shared:
            set modeValue to 0 as a 64 bit integer
        set bim setting (bim grid height mode setting) of gridId to modeValue keeping true in target
        note bim change of gridId in target
        return true

function set bim common grid height from {a 64 bit floating-point number:lowValue} to {a 64 bit floating-point number:highValue} in {a pointer to a bim model record:target}:
    execute:
        if (bim grid height from lowValue to highValue is valid) = false:
            return false
        # Validate the quantized range too, before changing any line or setting.
        set savedBase to (the rounded value of (lowValue * 1000000.0)) as a 64 bit integer
        set savedTop to (the rounded value of (highValue * 1000000.0)) as a 64 bit integer
        if savedTop <= savedBase:
            return false
        set baseValue to (savedBase as a 64 bit floating-point number) / 1000000.0
        set topValue to (savedTop as a 64 bit floating-point number) / 1000000.0
        loop cursor from 0 to the length of (target's grids's values):
            set gridValue to the item at cursor in (target's grids's values)
            if bim grid gridValue shares the common height in (@intrinsic("dereference", target)):
                ignore set bim grid gridValue's id height from baseValue to topValue sharing common true in target
        set bim setting (bim grid common base setting) of (0 as a 64 bit integer) to savedBase keeping true in target
        set bim setting (bim grid common top setting) of (0 as a 64 bit integer) to savedTop keeping true in target
        return true

# Explicitly shared lines follow storey edits until a common height is set.
# Unmarked legacy lines are never silently reclassified after a level changes.
function refresh bim shared grid heights in {a pointer to a bim model record:target}:
    execute:
        set commonHeight to the bim common grid height of (@intrinsic("dereference", target))
        loop cursor from 0 to the length of (target's grids's values):
            set gridValue to the item at cursor in (target's grids's values)
            set mode to the bim setting (bim grid height mode setting) of gridValue's id in (@intrinsic("dereference", target))
            if mode's found and (mode's value = (0 as a 64 bit integer)):
                if (gridValue's low != commonHeight's x) or (gridValue's high != commonHeight's y):
                    ignore set bim grid gridValue's id height from commonHeight's x to commonHeight's y sharing common true in target
