# SPDX-License-Identifier: MPL-2.0
# The project's settings (`bim_project_settings.dl`): units, decimals,
# georeferencing and true north set from the properties panel (nothing
# selected), kept as the project's settings, and written to IFC: the
# currency in the unit assignment, the context's true north, IfcProjectedCRS
# and IfcMapConversion, and the OBS_ProjectSettings property set.
import ui/editor/bim_editor.dl

function show settings test rows of {bim editor record:editor}:
    execute:
        set propertyRows to the bim property rows of editor
        set shown to false
        loop cursor from 0 to the length of propertyRows:
            set propertyRow to the item at cursor in propertyRows
            if propertyRow's label = (the string form of "Units"):
                set shown to true
            if shown:
                print ((the string form of "  ") + ((propertyRow's label + (the string form of ": ")) + propertyRow's value)) as a line
        free propertyRows

function type settings test {integer:code} as {a string:typedText} in {a pointer to a bim editor record:editor}:
    execute:
        start bim editor property code in editor
        set editor's propertyText to typedText
        apply bim editor property in editor

set editor to a new bim editor
set e to the address of editor
# Model > Settings, as the user chooses it: the properties show the project.
type bim editor key (bim project settings command) in e
print (the string form of "defaults:") as a line
show settings test rows of editor
# Metres (two clicks: mm, cm, m), US dollars, RD New with the origin in Delft,
# north 12.5 degrees, three decimals (metres show two unless set).
start bim editor property (bim project length unit property) in e
start bim editor property (bim project length unit property) in e
start bim editor property (bim project currency property) in e
type settings test (bim project crs property) as (the string form of "28992") in e
type settings test (bim project eastings property) as (the string form of "84500") in e
type settings test (bim project northings property) as (the string form of "447000.25") in e
type settings test (bim project north property) as (the string form of "12.5") in e
type settings test (bim project decimals property) as (the string form of "3") in e
print (the string form of "set:") as a line
show settings test rows of editor
print ((the string form of "editor shows lengths in ") + (the bim name of unit editor's lengthUnit)) as a line
set ifcText to the bim ifc text of editor's documentValue's current
set lines to ifcText split at "\n"
loop cursor from 0 to the length of lines:
    set line to the item at cursor in lines
    if ((((the index of (the string form of "IFCMONETARYUNIT") in line) >= 0) or ((the index of (the string form of "IFCPROJECTEDCRS") in line) >= 0)) or (((the index of (the string form of "IFCMAPCONVERSION") in line) >= 0) or ((the index of (the string form of "OBS_ProjectSettings") in line) >= 0))) or ((the index of (the string form of "IFCPROPERTYSINGLEVALUE") in line) >= 0):
        set equals to the index of (the string form of "=") in line
        print (the substring of line from (equals + 1) spanning ((the length of line) - (equals + 1)) bytes) as a line
free lines
# Undone one by one: the decimals go first.
ignore undo bim transaction in (the address of (editor's documentValue))
print ((the string form of "after one undo, decimals ") + (the string form of (the bim project decimals of editor's documentValue's current))) as a line

# The project's data (drawing quality plan, item 10), typed as on the
# Project data page: the properties show it, IFC writes IfcProject's Name
# (the number), LongName and Phase and the client and architect as actors.
type settings test ((bim project data property) + (bim project name field)) as (the string form of "Pavilion Delft") in e
type settings test ((bim project data property) + (bim project number field)) as (the string form of " 2026-014 ") in e
type settings test ((bim project data property) + (bim project client field)) as (the string form of "Gemeente Delft") in e
type settings test ((bim project data property) + (bim project architect field)) as (the string form of "Bureau Ørsted") in e
type settings test ((bim project data property) + (bim project phase field)) as (the string form of "Definitief ontwerp") in e
print (the string form of "project data:") as a line
show settings test rows of editor
set dataLines to (the bim ifc text of editor's documentValue's current) split at "\n"
loop cursor from 0 to the length of dataLines:
    set dataLine to the item at cursor in dataLines
    if (((the index of "IFCPROJECT(" in dataLine) >= 0) or ((the index of "IFCACTOR" in dataLine) >= 0)) or (((the index of "IFCORGANIZATION(" in dataLine) >= 0) or ((the index of "IFCRELASSIGNSTOACTOR(" in dataLine) >= 0)):
        print dataLine as a line
free dataLines
ignore undo bim transaction in (the address of (editor's documentValue))
print ((the string form of "after one undo, phase '") + ((the bim project text (bim project phase field) of editor's documentValue's current) + (the string form of "'"))) as a line

# A sheet's title block fields and a revision, typed in its properties.
set sheetId to add bim sheet numbered (the string form of "A-101") named (the string form of "Plan") on paper 2 landscape true to (the address of (editor's documentValue's current))
set editor's sheetId to sheetId
set editor's propertiesViewId to bim sheet properties context
type settings test (bim sheet date property) as (the string form of "2026-11-06") in e
type settings test (bim sheet drawn property) as (the string form of "EV") in e
type settings test (bim sheet revision property) as (the string form of "First issue") in e
type settings test (bim sheet revision property) as (the string form of "Windows changed") in e
set sheetRows to the bim property rows of editor
set titleRows to false
loop cursor from 0 to the length of sheetRows:
    set sheetRow to the item at cursor in sheetRows
    if sheetRow's label = (the string form of "Title block"):
        set titleRows to true
    if titleRows and (sheetRow's code != -1):
        print ((the string form of "  ") + ((sheetRow's label + (the string form of ": ")) + sheetRow's value)) as a line
    if titleRows and ((sheetRow's code = -1) and (sheetRow's label != (the string form of "Title block"))):
        set titleRows to false
free sheetRows
set revisionList to the bim revisions of sheet sheetId in editor's documentValue's current
loop cursor from 0 to the length of revisionList:
    set listedRevision to the item at cursor in revisionList
    print ((the string form of "revision ") + ((listedRevision's code + (the string form of " ")) + ((listedRevision's date + (the string form of " ")) + ((listedRevision's description + (the string form of " ")) + ((listedRevision's drawnBy + (the string form of " /")) + listedRevision's checkedBy))))) as a line
free revisionList
ignore undo bim transaction in (the address of (editor's documentValue))
print ((the string form of "after one undo, revisions ") + (the string form of (the bim revision count of sheet sheetId in editor's documentValue's current))) as a line
