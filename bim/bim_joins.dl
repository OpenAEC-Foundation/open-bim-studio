# SPDX-License-Identifier: MPL-2.0
# Joins between elements with two ends, and how each end joins.
#
# Joins are found, not stored: two ends that meet are an L join, an end on
# another element's axis a T join (`the bim end corners of`,
# elements/planar/bim_evaluate.dl, for walls). What is stored is the style
# of each end, as an element setting: `bim join style start setting` for the
# start, `bim join style finish setting` for the finish. Absent, an end is
# Automatic and joins as it always did. The codes are the element's own, so
# that a linear element (a beam or column, elements/linear) can carry the
# same two settings on its ends when its joins become editable; the join
# record below names its two elements and ends without saying what they are.
#
# An end's style is read from the end itself and, at an L join, else from
# the partner's end, mirrored (`the bim joined style of end`): the editor
# writes both ends of an L join, so that the two agree, and a file that
# gives only one of them still reads the same at both.
import bim/bim_model.dl

function bim join style start setting:
    replacement:
        2402600
function bim join style finish setting:
    replacement:
        2402601

# The gap an end keeps at its join, in micrometres (absent: none): the end
# stops that far short of the face it butts against, and the two ends of a
# mitre stand that far apart (a movement or assembly joint of, say, 25 mm).
function bim join gap start setting:
    replacement:
        2402602
function bim join gap finish setting:
    replacement:
        2402603

# The styles, as the settings store them.
# Automatic: today's rule (an L join mitres, a T join butts against the
# host's face).
function bim automatic join style:
    replacement:
        0
# Mitre: both ends are cut on the line through the crossings of their sides.
function bim mitre join style:
    replacement:
        1
# Butt, this element running through: its end reaches the other's far face,
# and the other stops at its near face.
function bim butt through join style:
    replacement:
        2
# Butt, the other running through: this end stops at the other's near face.
function bim butt stopped join style:
    replacement:
        3
# Square off: as the butts, but the stopped (or running) end is cut square
# across its own axis, where its farther corner reached.
function bim square through join style:
    replacement:
        4
function bim square stopped join style:
    replacement:
        5
# Not joined: the end stays square and free, and cuts nothing.
function bim not joined style:
    replacement:
        6

# The kinds of join.
function bim no join kind:
    replacement:
        0
# Two ends meeting at one point.
function bim l join kind:
    replacement:
        1
# An end on another element's axis, away from its ends.
function bim t join kind:
    replacement:
        2

# A join: its kind, its first element and end (at a T join the end that
# meets the other's side), its second element and end (unused at a T join)
# and the point where they meet.
class:
    patterns:
        [a|] bim join record
    members:
        kind as an integer
        firstId as a 64 bit integer
        firstAtFinish as a boolean
        secondId as a 64 bit integer
        secondAtFinish as a boolean
        place as a cad vector2

function the bim join style setting at finish {boolean:atFinish}:
    execute:
        if atFinish:
            return bim join style finish setting
        return bim join style start setting

# The style end `elementId` (its finish or its start) gives itself, or -1
# when it gives none.
function the bim own join style of end {a 64 bit integer:elementId} at finish {boolean:atFinish} in {bim model record:modelValue}:
    execute:
        set styleReading to the bim setting (the bim join style setting at finish atFinish) of elementId in modelValue
        if styleReading's found:
            set styleValue to styleReading's value as an integer
            if (styleValue >= bim automatic join style) and (styleValue <= bim not joined style):
                return styleValue
        return -1

# A style as the other end of the same join sees it: who runs through
# changes side, the rest stays.
function the bim mirrored join style of {integer:styleCode}:
    execute:
        if styleCode = bim butt through join style:
            return bim butt stopped join style
        if styleCode = bim butt stopped join style:
            return bim butt through join style
        if styleCode = bim square through join style:
            return bim square stopped join style
        if styleCode = bim square stopped join style:
            return bim square through join style
        return styleCode

# The style of end `elementId` at an L join with end `partnerId`: its own,
# else its partner's mirrored, else Automatic.
function the bim joined style of end {a 64 bit integer:elementId} at finish {boolean:atFinish} beside {a 64 bit integer:partnerId} finishing {boolean:partnerAtFinish} in {bim model record:modelValue}:
    execute:
        set ownStyle to the bim own join style of end elementId at finish atFinish in modelValue
        if ownStyle >= 0:
            return ownStyle
        set partnerStyle to the bim own join style of end partnerId at finish partnerAtFinish in modelValue
        if partnerStyle >= 0:
            return the bim mirrored join style of partnerStyle
        return bim automatic join style

# The style of end `elementId` at a T join: its own, else Automatic.
function the bim joined style of end {a 64 bit integer:elementId} at finish {boolean:atFinish} in {bim model record:modelValue}:
    execute:
        set ownStyle to the bim own join style of end elementId at finish atFinish in modelValue
        if ownStyle >= 0:
            return ownStyle
        return bim automatic join style

# The style of `joinValue` as its first end has it.
function the bim style of join {bim join record:joinValue} in {bim model record:modelValue}:
    execute:
        if joinValue's kind = bim l join kind:
            return the bim joined style of end joinValue's firstId at finish joinValue's firstAtFinish beside joinValue's secondId finishing joinValue's secondAtFinish in modelValue
        return the bim joined style of end joinValue's firstId at finish joinValue's firstAtFinish in modelValue

# Join `joinValue` given style `styleCode` as its first end has it: at an
# L join the second end the mirror of it; Automatic removes the settings.
# Each changed setting is journalled; the caller holds the transaction.
function give bim join {bim join record:joinValue} style {integer:styleCode} in {a pointer to a bim model record:target}:
    execute:
        set kept to styleCode != bim automatic join style
        set firstCode to the bim join style setting at finish joinValue's firstAtFinish
        set bim setting firstCode of joinValue's firstId to (styleCode as a 64 bit integer) keeping kept in target
        if joinValue's kind = bim l join kind:
            set secondCode to the bim join style setting at finish joinValue's secondAtFinish
            set bim setting secondCode of joinValue's secondId to ((the bim mirrored join style of styleCode) as a 64 bit integer) keeping kept in target

# The name of a style as the properties show it, without who runs through.
function the bim join style name of {integer:styleCode}:
    execute:
        if styleCode = bim mitre join style:
            return the string form of "Mitre"
        if (styleCode = bim butt through join style) or (styleCode = bim butt stopped join style):
            return the string form of "Butt"
        if (styleCode = bim square through join style) or (styleCode = bim square stopped join style):
            return the string form of "Square off"
        if styleCode = bim not joined style:
            return the string form of "Not joined"
        return the string form of "Automatic"

function the bim join kind name of {integer:kindCode}:
    execute:
        if kindCode = bim l join kind:
            return the string form of "L"
        if kindCode = bim t join kind:
            return the string form of "T"
        return the string form of "none"

# Whether a style lets the end it is read at run through.
function bim join style {integer:styleCode} runs through:
    execute:
        return (styleCode = bim butt through join style) or (styleCode = bim square through join style)

# The next style a click on the Join style row gives: Automatic, Mitre,
# Butt, Square off and round again (no Mitre at a T join). A butt or square
# off keeps who runs through; it starts with the first element running
# through at an L join and the host at a T join. Not joined goes to
# Automatic.
function the bim join style after {integer:styleCode} at kind {integer:kindCode}:
    execute:
        set throughFirst to bim butt through join style
        set squareFirst to bim square through join style
        if kindCode = bim t join kind:
            set throughFirst to bim butt stopped join style
            set squareFirst to bim square stopped join style
        if styleCode = bim automatic join style:
            if kindCode = bim t join kind:
                return throughFirst
            return bim mitre join style
        if styleCode = bim mitre join style:
            return throughFirst
        if styleCode = bim butt through join style:
            return bim square through join style
        if styleCode = bim butt stopped join style:
            return bim square stopped join style
        return bim automatic join style

function the bim join gap setting at finish {boolean:atFinish}:
    execute:
        if atFinish:
            return bim join gap finish setting
        return bim join gap start setting

# The gap end `elementId` gives itself, in metres, or -1.0 when it gives none.
function the bim own join gap of end {a 64 bit integer:elementId} at finish {boolean:atFinish} in {bim model record:modelValue}:
    execute:
        set gapReading to the bim setting (the bim join gap setting at finish atFinish) of elementId in modelValue
        if gapReading's found:
            if gapReading's value > (0 as a 64 bit integer):
                return (gapReading's value as a 64 bit floating-point number) / 1000000.0
        return -1.0

# The gap of end `elementId` at an L join with end `partnerId`: its own,
# else its partner's, else none.
function the bim join gap of end {a 64 bit integer:elementId} at finish {boolean:atFinish} beside {a 64 bit integer:partnerId} finishing {boolean:partnerAtFinish} in {bim model record:modelValue}:
    execute:
        set ownGap to the bim own join gap of end elementId at finish atFinish in modelValue
        if ownGap >= 0.0:
            return ownGap
        set partnerGap to the bim own join gap of end partnerId at finish partnerAtFinish in modelValue
        if partnerGap >= 0.0:
            return partnerGap
        return 0.0

# The gap of end `elementId` at a T join: its own, else none.
function the bim join gap of end {a 64 bit integer:elementId} at finish {boolean:atFinish} in {bim model record:modelValue}:
    execute:
        set ownGap to the bim own join gap of end elementId at finish atFinish in modelValue
        if ownGap >= 0.0:
            return ownGap
        return 0.0

# The gap of `joinValue`, in metres.
function the bim gap of join {bim join record:joinValue} in {bim model record:modelValue}:
    execute:
        if joinValue's kind = bim l join kind:
            return the bim join gap of end joinValue's firstId at finish joinValue's firstAtFinish beside joinValue's secondId finishing joinValue's secondAtFinish in modelValue
        return the bim join gap of end joinValue's firstId at finish joinValue's firstAtFinish in modelValue

# Join `joinValue` given the gap `gapMetres` (none at zero): at an L join
# both ends carry it. Each changed setting is journalled; the caller holds
# the transaction.
function give bim join {bim join record:joinValue} gap {a 64 bit floating-point number:gapMetres} in {a pointer to a bim model record:target}:
    execute:
        set gapMicrometres to (the floor of ((gapMetres * 1000000.0) + 0.5)) as a 64 bit integer
        set gapKept to gapMicrometres > (0 as a 64 bit integer)
        set bim setting (the bim join gap setting at finish joinValue's firstAtFinish) of joinValue's firstId to gapMicrometres keeping gapKept in target
        if joinValue's kind = bim l join kind:
            set bim setting (the bim join gap setting at finish joinValue's secondAtFinish) of joinValue's secondId to gapMicrometres keeping gapKept in target

# The next gap a click on the Gap row gives: none, 5, 10, 15, 20, 25 and
# 50 mm, and round again.
function the bim join gap after {a 64 bit floating-point number:gapMetres}:
    execute:
        set gapMillimetres to (the floor of ((gapMetres * 1000.0) + 0.5)) as an integer
        if gapMillimetres < 5:
            return 0.005
        if gapMillimetres < 10:
            return 0.010
        if gapMillimetres < 15:
            return 0.015
        if gapMillimetres < 20:
            return 0.020
        if gapMillimetres < 25:
            return 0.025
        if gapMillimetres < 50:
            return 0.050
        return 0.0

# ---------------------------------------------------------------- profiles
#
# The profile of a join: how the two ends meet across their thickness, as
# a library of stepped shapes (a half lap, a lip, a stepped lap), for
# panels such as cross-laminated timber. A profile shapes a butt join at an
# L corner: the end that runs through and the end that stops each follow
# their half of it, so that the two fill the corner between them without
# overlap. An end stores the profile's code; absent, the join is straight.
#
# A half of a profile is a list of steps across the end's thickness, from
# the corner's outer side (0) to its inner side (1): each step reaches
# across to `across` and stands `depth` into the other wall's thickness
# (0 at its near face, 1 at its far face).
function bim join profile start setting:
    replacement:
        2402604
function bim join profile finish setting:
    replacement:
        2402605

function bim straight join profile:
    replacement:
        0
# Half lap: each end keeps half its thickness over the other's half.
function bim half lap join profile:
    replacement:
        1
# Lip: the end that runs through keeps a lip of a third of its thickness
# over the end that stops, which is rebated for it.
function bim lip join profile:
    replacement:
        2
# Stepped lap: two steps of a third each.
function bim stepped lap join profile:
    replacement:
        3

function the bim join profile count:
    replacement:
        4

class:
    patterns:
        [a|] bim join step record
    members:
        across as a 64 bit floating-point number
        depth as a 64 bit floating-point number

function the bim join profile name of {integer:profileCode}:
    execute:
        if profileCode = bim half lap join profile:
            return the string form of "Half lap"
        if profileCode = bim lip join profile:
            return the string form of "Lip (one third)"
        if profileCode = bim stepped lap join profile:
            return the string form of "Stepped lap"
        return the string form of "Straight"

# The steps of profile `profileCode` for the end that runs through
# (`runsThrough`) or the end that stops; empty for a straight join. The
# caller frees the list.
function the bim join profile steps of {integer:profileCode} running through {boolean:runsThrough}:
    execute:
        set stepList to an empty list of a bim join step record
        set oneThird to 1.0 / 3.0
        if profileCode = bim half lap join profile:
            if runsThrough:
                append (@intrinsic("construct", a bim join step record, 0.5, 1.0)) to stepList
                append (@intrinsic("construct", a bim join step record, 1.0, 0.5)) to stepList
            else:
                append (@intrinsic("construct", a bim join step record, 0.5, 0.5)) to stepList
                append (@intrinsic("construct", a bim join step record, 1.0, 0.0)) to stepList
        if profileCode = bim lip join profile:
            if runsThrough:
                append (@intrinsic("construct", a bim join step record, 2.0 * oneThird, 1.0)) to stepList
                append (@intrinsic("construct", a bim join step record, 1.0, 2.0 * oneThird)) to stepList
            else:
                append (@intrinsic("construct", a bim join step record, oneThird, oneThird)) to stepList
                append (@intrinsic("construct", a bim join step record, 1.0, 0.0)) to stepList
        if profileCode = bim stepped lap join profile:
            if runsThrough:
                append (@intrinsic("construct", a bim join step record, oneThird, 1.0)) to stepList
                append (@intrinsic("construct", a bim join step record, 2.0 * oneThird, 2.0 * oneThird)) to stepList
                append (@intrinsic("construct", a bim join step record, 1.0, oneThird)) to stepList
            else:
                append (@intrinsic("construct", a bim join step record, oneThird, 2.0 * oneThird)) to stepList
                append (@intrinsic("construct", a bim join step record, 2.0 * oneThird, oneThird)) to stepList
                append (@intrinsic("construct", a bim join step record, 1.0, 0.0)) to stepList
        return stepList

function the bim join profile setting at finish {boolean:atFinish}:
    execute:
        if atFinish:
            return bim join profile finish setting
        return bim join profile start setting

# The profile end `elementId` gives itself, or -1 when it gives none.
function the bim own join profile of end {a 64 bit integer:elementId} at finish {boolean:atFinish} in {bim model record:modelValue}:
    execute:
        set profileReading to the bim setting (the bim join profile setting at finish atFinish) of elementId in modelValue
        if profileReading's found:
            set profileValue to profileReading's value as an integer
            if (profileValue > bim straight join profile) and (profileValue < (the bim join profile count)):
                return profileValue
        return -1

# The profile of end `elementId` at an L join with end `partnerId`: its
# own, else its partner's, else straight.
function the bim join profile of end {a 64 bit integer:elementId} at finish {boolean:atFinish} beside {a 64 bit integer:partnerId} finishing {boolean:partnerAtFinish} in {bim model record:modelValue}:
    execute:
        set ownProfile to the bim own join profile of end elementId at finish atFinish in modelValue
        if ownProfile >= 0:
            return ownProfile
        set partnerProfile to the bim own join profile of end partnerId at finish partnerAtFinish in modelValue
        if partnerProfile >= 0:
            return partnerProfile
        return bim straight join profile

# The profile of `joinValue`: straight at any join but an L join.
function the bim profile of join {bim join record:joinValue} in {bim model record:modelValue}:
    execute:
        if joinValue's kind != bim l join kind:
            return bim straight join profile
        return the bim join profile of end joinValue's firstId at finish joinValue's firstAtFinish beside joinValue's secondId finishing joinValue's secondAtFinish in modelValue

# L join `joinValue` given profile `profileCode` on both its ends
# (straight removes it). A profile shapes a butt: a join that is no butt
# yet becomes one, its first wall running through. Each changed setting is
# journalled; the caller holds the transaction.
function give bim join {bim join record:joinValue} profile {integer:profileCode} in {a pointer to a bim model record:target}:
    execute:
        if joinValue's kind != bim l join kind:
            return nothing
        set profileKept to profileCode != bim straight join profile
        set bim setting (the bim join profile setting at finish joinValue's firstAtFinish) of joinValue's firstId to (profileCode as a 64 bit integer) keeping profileKept in target
        set bim setting (the bim join profile setting at finish joinValue's secondAtFinish) of joinValue's secondId to (profileCode as a 64 bit integer) keeping profileKept in target
        if profileKept:
            set styleNow to the bim style of join joinValue in (@intrinsic("dereference", target))
            if (styleNow != bim butt through join style) and (styleNow != bim butt stopped join style):
                give bim join joinValue style (bim butt through join style) in target

# The next profile a click on the Profile row gives: Straight, Half lap,
# Lip, Stepped lap and round again.
function the bim join profile after {integer:profileCode}:
    execute:
        if (profileCode + 1) >= (the bim join profile count):
            return bim straight join profile
        return profileCode + 1
