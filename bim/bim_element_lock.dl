# SPDX-License-Identifier: MPL-2.0
# A lock on an element, as a pin in Revit: a locked element keeps its place.
# The editor moves, turns, mirrors, scales, lifts, drags and deletes none
# (PN locks the selection, UP unlocks it); its properties and its type stay
# free, and a copy of it is not locked. The lock is a setting of the
# element, so it is saved with the model and undone with the edit.
import bim/bim_model.dl

function bim element lock setting:
    replacement:
        2400450

function bim element {a 64 bit integer:elementId} is locked in {bim model record:modelValue}:
    execute:
        set reading to the bim setting (bim element lock setting) of elementId in modelValue
        return reading's found and (reading's value != (0 as a 64 bit integer))

# Locks element `elementId`, or with `fastened` false unlocks it.
function keep bim element {a 64 bit integer:elementId} locked {boolean:fastened} in {a pointer to a bim model record:target}:
    execute:
        set bim setting (bim element lock setting) of elementId to (1 as a 64 bit integer) keeping fastened in target
