# SPDX-License-Identifier: MPL-2.0
# The pen table of paper output: the width of each line role on paper, in
# millimetres, after NEN-ISO 128 (NEN-ISO 128-20 and -23, line group 0.5
# with the 4:2:1 widths 0.50, 0.25 and 0.13, plus 0.18 for the fine lines
# between them). Sheets, their PDF and SVG files and the plan and section
# drawings recorded on paper (a canvas with a paper scale) take their widths
# from here; drawings on screen keep their pixel widths. The roles are values
# in a drawing, never stored in a model.
import lib/std.dl

# What a line is in the drawing.
function bim cut pen:
    replacement:
        1

# A visible edge beyond the cut, a door leaf, a stair seen from above.
function bim visible pen:
    replacement:
        2

# An edge hidden or above the cut, drawn dashed.
function bim hidden pen:
    replacement:
        3

# Hatching inside a cut.
function bim hatch pen:
    replacement:
        4

# Dimension lines, extension lines and leaders.
function bim dimension pen:
    replacement:
        5

# The border of a sheet.
function bim border pen:
    replacement:
        6

# Fine detail: window panes, a stair's walking line, the dividers of a title
# block, a room separation line.
function bim thin pen:
    replacement:
        7

# The frame of a title block, a legend or a schedule.
function bim frame pen:
    replacement:
        8

# How wide a line of `role` is on paper, in millimetres.
function the bim paper width of pen {integer:role}:
    execute:
        if role = bim cut pen:
            return 0.5
        if role = bim visible pen:
            return 0.25
        if role = bim hidden pen:
            return 0.18
        if role = bim hatch pen:
            return 0.13
        if role = bim dimension pen:
            return 0.18
        if role = bim border pen:
            return 0.7
        if role = bim thin pen:
            return 0.18
        if role = bim frame pen:
            return 0.35
        return 0.25

# A line weight of `hundredths` of a millimetre on paper (an override of a
# view's rules), in millimetres.
function the bim paper width of weight {a 64 bit integer:hundredths}:
    execute:
        return (hundredths as a 64 bit floating-point number) / 100.0

# The dash table of paper output, beside the pen table: how a dashed line is
# broken on paper, in millimetres, whatever the drawing's scale. NEN-ISO
# 128-20 sizes the pieces in multiples of the line width d: line type 02
# (dashed) a dash of 12d and a gap of 3d, line type 04 (long dash dotted) a
# long dash of 24d, a gap of 3d and a dot of at most 0.5d. On a drawing of
# the 0.25 and 0.5 line group that gives:
#   dashed line (02): dash 3.0, gap 1.5 (12d of the 0.25 line, the gap at
#     6d so that it stays open on a halved print): hidden edges, edges above
#     the cut (beams, treads, roof and ceiling edges, door and window parts),
#     demolished work;
#   chain line (04): long dash 12.0, gap 1.5, dot 0.5 (24d and 3d of the
#     0.5 line, the dot at 1d of it so that it prints): section lines;
#   grid line: dash 4.5, gap 4.0, dot 0.5, the grid's own dash-dot, kept as
#     the grid heads were drawn for it.
# On sheets and in their PDF and SVG files the plan's dashed and chain lines
# (`the bim dash of line`, viewer/bim_canvas.dl), its grid lines and the
# legend's grid sample take their dashes from here; drawings on screen keep
# their pixel dashes. Not yet from here: the section's level lines and the
# legend's level sample (2.5 mm dashes in symbol units) and the plan's
# usable-area outline.
function bim dashed line:
    replacement:
        1

function bim chain line:
    replacement:
        2

function bim grid line:
    replacement:
        3

# How long a dash of `lineType` is on paper, in millimetres (the long dash
# of a chain line).
function the bim paper dash of line {integer:lineType}:
    execute:
        if lineType = bim chain line:
            return 12.0
        if lineType = bim grid line:
            return 4.5
        return 3.0

# How long a gap of `lineType` is on paper, in millimetres.
function the bim paper gap of line {integer:lineType}:
    execute:
        if lineType = bim grid line:
            return 4.0
        return 1.5

# How long the dot between two dashes of `lineType` is on paper, in
# millimetres; none for a dashed line.
function the bim paper dot of line {integer:lineType}:
    execute:
        if lineType = bim dashed line:
            return 0.0
        return 0.5
