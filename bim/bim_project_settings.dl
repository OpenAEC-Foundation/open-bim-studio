# SPDX-License-Identifier: MPL-2.0
# The project's settings, structured after Bonsai's project setup: its
# units (length, area, angle, currency, decimals), its georeferencing (a
# projected coordinate system by EPSG code, the map position of the model's
# origin, true north). They are settings of element 0, the project (as the
# drawing standard is), so that the native IfcX file keeps them; the IFC4
# export writes them as IFC does: the unit assignment of IfcProject (with
# IfcMonetaryUnit), IfcProjectedCRS and IfcMapConversion, the context's
# TrueNorth, and a property set on IfcProject for what IFC has no entity for
# (the length unit shown, decimals).
import bim/bim_model.dl

function bim project length unit setting:
    replacement:
        1800000
function bim project area unit setting:
    replacement:
        1800001
function bim project angle unit setting:
    replacement:
        1800002
function bim project currency setting:
    replacement:
        1800003
function bim project decimals setting:
    replacement:
        1800004
# True north: the angle from the model's y axis to north, anticlockwise, in
# thousandths of a degree.
function bim project north setting:
    replacement:
        1800005
function bim project crs setting:
    replacement:
        1800006
# The map position (eastings, northings, height) of the model's origin, in
# millimetres.
function bim project eastings setting:
    replacement:
        1800007
function bim project northings setting:
    replacement:
        1800008
function bim project height setting:
    replacement:
        1800009

# Setting `code` of the project, or `fallback` when it has none.
function the bim project setting {integer:code} in {bim model record:modelValue} or {a 64 bit integer:fallback}:
    execute:
        set reading to the bim setting code of (0 as a 64 bit integer) in modelValue
        if reading's found:
            return reading's value
        return fallback

# The project's length unit (`bim millimetre unit` and so on in
# `bim_editor_core.dl`: 0 mm, 1 cm, 2 m), millimetres unless set.
function the bim project length unit of {bim model record:modelValue}:
    execute:
        return (the bim project setting (bim project length unit setting) in modelValue or (0 as a 64 bit integer)) as an integer

function the bim name of length unit {integer:unitCode}:
    execute:
        if unitCode = 1:
            return the string form of "cm"
        if unitCode = 2:
            return the string form of "m"
        return the string form of "mm"

# Areas: 0 square metres, 1 square millimetres. Angles: 0 degrees, 1
# radians. Currencies: 0 EUR, 1 USD, 2 GBP.
function the bim name of area unit {integer:unitCode}:
    execute:
        if unitCode = 1:
            return the string form of "mm2"
        return the string form of "m2"

function the bim name of angle unit {integer:unitCode}:
    execute:
        if unitCode = 1:
            return the string form of "radian"
        return the string form of "degree"

function the bim name of currency {integer:currencyCode}:
    execute:
        if currencyCode = 1:
            return the string form of "USD"
        if currencyCode = 2:
            return the string form of "GBP"
        return the string form of "EUR"

# Decimals shown for lengths: as the unit has them (mm 0, cm 1, m 2) unless
# set.
function the bim project decimals of {bim model record:modelValue}:
    execute:
        set unitCode to the bim project length unit of modelValue
        set fallback to 0
        if unitCode = 1:
            set fallback to 1
        if unitCode = 2:
            set fallback to 2
        return (the bim project setting (bim project decimals setting) in modelValue or (fallback as a 64 bit integer)) as an integer

# True north in radians from the model's y axis, anticlockwise.
function the bim project north of {bim model record:modelValue}:
    execute:
        set thousandths to the bim project setting (bim project north setting) in modelValue or (0 as a 64 bit integer)
        return ((thousandths as a 64 bit floating-point number) / 1000.0) * (3.141592653589793 / 180.0)

# The EPSG code of the projected coordinate system, 0 for none (28992 is
# the Dutch RD New).
function the bim project crs of {bim model record:modelValue}:
    execute:
        return (the bim project setting (bim project crs setting) in modelValue or (0 as a 64 bit integer)) as an integer

# Whether the project is georeferenced: it has a coordinate system.
function bim project {bim model record:modelValue} is georeferenced:
    execute:
        return (the bim project crs of modelValue) > 0

# The map position of the model's origin, in metres.
function the bim project origin of {bim model record:modelValue}:
    execute:
        set eastings to ((the bim project setting (bim project eastings setting) in modelValue or (0 as a 64 bit integer)) as a 64 bit floating-point number) / 1000.0
        set northings to ((the bim project setting (bim project northings setting) in modelValue or (0 as a 64 bit integer)) as a 64 bit floating-point number) / 1000.0
        set height to ((the bim project setting (bim project height setting) in modelValue or (0 as a 64 bit integer)) as a 64 bit floating-point number) / 1000.0
        return a cad vector3 with x eastings, y northings and z height

# Project setting `code` set to `value` (kept unless it is the default
# `fallback`, so that a project left as it was keeps no settings).
function set bim project setting {integer:code} to {a 64 bit integer:value} unless {a 64 bit integer:fallback} in {a pointer to a bim model record:target}:
    execute:
        set bim setting code of (0 as a 64 bit integer) to value keeping (value != fallback) in target
        note bim change of (0 as a 64 bit integer) in target

# ---------------------------------------------------------------- project data

# The project's data for title blocks and exports: its name and number,
# the client (opdrachtgever), the architect and the design phase. They are
# text, which settings do not hold, so they are properties of element 0,
# the project, in the set "Project data"; the native file and IfcX keep
# them as they keep every property. The IFC4 export writes them as
# IfcProject's Name, LongName and Phase and the client and architect as
# actors of the project (`bim_ifc.dl`).
function bim project name field:
    replacement:
        0
function bim project number field:
    replacement:
        1
function bim project client field:
    replacement:
        2
function bim project architect field:
    replacement:
        3
function bim project phase field:
    replacement:
        4
function bim project field count:
    replacement:
        5

function the bim project data set:
    execute:
        return the string form of "Project data"

# The property that holds project field `fieldCode`.
function the bim project field name of {integer:fieldCode}:
    execute:
        if fieldCode = bim project number field:
            return the string form of "ProjectNumber"
        if fieldCode = bim project client field:
            return the string form of "Client"
        if fieldCode = bim project architect field:
            return the string form of "Architect"
        if fieldCode = bim project phase field:
            return the string form of "Phase"
        return the string form of "ProjectName"

# Project field `fieldCode`, "" when the project has none.
function the bim project text {integer:fieldCode} of {bim model record:modelValue}:
    execute:
        return the bim property value (the bim project field name of fieldCode) of set (the bim project data set) of (0 as a 64 bit integer) in modelValue

# Project field `fieldCode` set to `fieldValue`, or removed when that is
# empty.
function set bim project text {integer:fieldCode} to {a string:fieldValue} in {a pointer to a bim model record:target}:
    execute:
        set wantedName to the bim project field name of fieldCode
        set wantedSet to the bim project data set
        if (the length of fieldValue) > 0:
            set bim property wantedName of set wantedSet of (0 as a 64 bit integer) to fieldValue typed (the string form of "IFCLABEL") in target
            return nothing
        set cursor to (the length of (target's properties's values)) - 1
        loop while cursor >= 0:
            set entry to the item at cursor in (target's properties's values)
            if ((entry's elementId = (0 as a 64 bit integer)) and (entry's setName = wantedSet)) and (entry's name = wantedName):
                remove item cursor from (target's properties's values)
            set cursor to cursor - 1
        note bim change of (0 as a 64 bit integer) in target
