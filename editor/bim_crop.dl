# SPDX-License-Identifier: MPL-2.0
# A plan crop's eight resize handles and centre translation handle.
import model/bim_view.dl

function the bim crop handle {integer:handle} from {cad vector2:low} to {cad vector2:high}:
    execute:
        set x to (low's x + high's x) * 0.5
        set y to (low's y + high's y) * 0.5
        if ((handle = 0) or (handle = 3)) or (handle = 4):
            set x to low's x
        if ((handle = 1) or (handle = 2)) or (handle = 6):
            set x to high's x
        if ((handle = 0) or (handle = 1)) or (handle = 5):
            set y to low's y
        if ((handle = 2) or (handle = 3)) or (handle = 7):
            set y to high's y
        return a cad vector2 with x x and y y

function the bim crop handle near {cad vector2:pixel} of {bim view definition record:viewValue} through {bim drawing transform record:transform} with centre {boolean:includeCentre}:
    execute:
        set count to 8
        if includeCentre:
            set count to 9
        loop candidateIndex from 0 to count:
            set spot to the bim pixel of (the bim crop handle candidateIndex from viewValue's cropLow to viewValue's cropHigh) through transform
            if (the cad distance from pixel to spot) <= 7.0:
                return candidateIndex
        return -1

function the bim crop {bim view definition record:viewValue} dragged at handle {integer:handle} by {cad vector2:delta}:
    execute:
        set updated to viewValue
        set low to viewValue's cropLow
        set high to viewValue's cropHigh
        if handle = 8:
            set low to a cad vector2 with x (low's x + delta's x) and y (low's y + delta's y)
            set high to a cad vector2 with x (high's x + delta's x) and y (high's y + delta's y)
        else:
            if ((handle = 0) or (handle = 3)) or (handle = 4):
                set low's x to the minimum of (low's x + delta's x) and (high's x - 0.01)
            if ((handle = 1) or (handle = 2)) or (handle = 6):
                set high's x to the maximum of (high's x + delta's x) and (low's x + 0.01)
            if ((handle = 0) or (handle = 1)) or (handle = 5):
                set low's y to the minimum of (low's y + delta's y) and (high's y - 0.01)
            if ((handle = 2) or (handle = 3)) or (handle = 7):
                set high's y to the maximum of (high's y + delta's y) and (low's y + 0.01)
        set updated's cropLow to low
        set updated's cropHigh to high
        return updated
