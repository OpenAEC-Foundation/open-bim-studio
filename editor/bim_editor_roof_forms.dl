import editor/bim_editor_core.dl
import editor/bim_roof_edit.dl

function bim roof profile property:
    replacement:
        2210
function bim roof path property:
    replacement:
        2211
function bim roof hip property:
    replacement:
        2212
function bim round roof property:
    replacement:
        2213

function start bim editor roof property {integer:code} in {a pointer to a bim editor record:editor}:
    execute:
        if code != bim round roof property:
            return false
        set editor's propertyCode to -1
        if editor's selectionKind != bim slab picked:
            set editor's message to the string form of "Select a native roof"
            return true
        set previousRedo to editor's documentValue's redoStack
        begin bim transaction in (the address of (editor's documentValue))
        set changed to round bim roof editor's selectionId in (the address of (editor's documentValue's current))
        if changed = 1:
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Round roof created; edit its section, path and hip in metres"
        else:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's documentValue's redoStack to previousRedo
            set editor's message to the string form of "Select a roof with a valid footprint at least 0.5 m wide"
            if changed = 2:
                set editor's message to the string form of "Roof is already round"
        return true

function apply bim editor roof property {integer:code} in {a pointer to a bim editor record:editor}:
    execute:
        if (code < bim roof profile property) or (code > bim roof hip property):
            return false
        set editor's propertyCode to -1
        if editor's selectionKind != bim slab picked:
            set editor's message to the string form of "Select a native roof"
            return true
        set reading to the bim roof points parsed from editor's propertyText
        if reading's valid = false:
            set editor's message to the string form of "Use a,b; a,b in metres (2 to 64 finite point pairs)"
            return true
        set previousRedo to editor's documentValue's redoStack
        begin bim transaction in (the address of (editor's documentValue))
        set changed to set bim roof editor's selectionId curve (code - (bim roof profile property)) to (reading's points's values) in (the address of (editor's documentValue's current))
        if changed = 1:
            commit bim transaction in (the address of (editor's documentValue))
            set editor's message to the string form of "Roof profile changed"
        else:
            roll back bim transaction in (the address of (editor's documentValue))
            set editor's documentValue's redoStack to previousRedo
            set editor's message to the string form of "Roof profile unchanged"
            if changed = 0:
                set editor's message to the string form of "Refused: section offsets must increase; path segments must have length"
        return true
