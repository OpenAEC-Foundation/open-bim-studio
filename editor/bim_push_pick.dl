# Geometry-only helpers for 3D Push/Pull. A hit is resolved against its
# actual object/storey, never a second plan pick on the active storey.
import graphics/bim_scene.dl

function the bim side of mass {bim sketch record:massValue} at {cad vector3:worldSpot} in {bim model record:modelValue}:
    execute:
        if (massValue's kind != bim face sketch) or ((the absolute value of massValue's height) <= 1e-8):
            return -1
        set levelFound to the bim level index of massValue's levelId in modelValue
        if levelFound's valid = false:
            return -1
        set baseHeight to (the item at levelFound's position in (modelValue's levels's values))'s elevation
        set lowerHeight to the minimum of baseHeight and (baseHeight + massValue's height)
        set upperHeight to the maximum of baseHeight and (baseHeight + massValue's height)
        if (worldSpot's z <= (lowerHeight + 1e-7)) or (worldSpot's z >= (upperHeight - 1e-7)):
            return -1
        set outlineValues to massValue's points's values
        set closestEdge to -1
        set closestGap to 1e-5
        set planSpot to a cad vector2 with x worldSpot's x and y worldSpot's y
        loop edgeCursor from 0 to the length of outlineValues:
            set candidateGap to the cad distance from planSpot to the segment from (the item at edgeCursor in outlineValues) to (the item at (the remainder of (edgeCursor + 1) divided by (the length of outlineValues)) in outlineValues)
            if candidateGap < closestGap:
                set closestGap to candidateGap
                set closestEdge to edgeCursor
        return closestEdge

# Project one metre of the outward normal into the screen. Near head-on
# views have no reliable projected axis: upward mouse travel then means
# outward extrusion, at the view's ordinary pixels-per-metre scale.
function the bim push travel from {cad vector2:startPixel} to {cad vector2:endPixel} along {cad vector2:normalStep} scaled {a 64 bit floating-point number:viewScale}:
    execute:
        set squaredStep to (normalStep's x * normalStep's x) + (normalStep's y * normalStep's y)
        set safeScale to the maximum of 1e-6 and viewScale
        if squaredStep < ((safeScale * safeScale) * 0.0004):
            return (startPixel's y - endPixel's y) / safeScale
        return (((endPixel's x - startPixel's x) * normalStep's x) + ((endPixel's y - startPixel's y) * normalStep's y)) / squaredStep
